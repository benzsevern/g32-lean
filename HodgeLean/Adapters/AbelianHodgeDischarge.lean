/-! ### The two unconditional milestones -/

/-- **The abelian package is the exterior power of its weight-one part, unconditionally.** For
every abelian `X`, the package `abelianVarietyCohomologyOf` at `cupProductOf X`, with C1, C2, C4
and C7 supplied, satisfies `IsExteriorOfWeightOne`: `isExteriorOfWeightOne_of_cupFiltered` (and
its twin `harvestBetti_isExteriorOfWeightOne_of_cupFiltered`) with `hF`, `hB`, `hD`, `hT` and `hC`
supplied.
Source: Birkenhake–Lange, *Complex Abelian Varieties*, 2nd ed., Grundlehren 302, Lemma 1.3.1, with
Voisin, *Hodge Theory and Complex Algebraic Geometry I*, §7.1, as for
`isExteriorOfWeightOne_of_cupFiltered`; the inputs through `finbetti_finiteBetti`,
`spec_bettiDeRhamIso_abelian`, `torusCohomology_cupProductOf` and the two named theorems above.
Relation to the goal: HC no distance; AV milestone no distance. -/
@[hodge_milestone] theorem abelian_isExteriorOfWeightOne :
    letI := (torusCohomology_cupProductOf X).finite
    AbelianVarietyCohomology.IsExteriorOfWeightOne
      (abelianVarietyCohomologyOf (finbetti_finiteBetti X) (spec_bettiDeRhamIso_abelian X)
        (hodgeDecomposition_of_abelian X) (torusCohomology_cupProductOf X)) :=
  abelian_isExteriorOfWeightOne_aux X

/-- The `harvestBetti_` twin gives the same statement. -/
example :
    letI := (torusCohomology_cupProductOf X).finite
    AbelianVarietyCohomology.IsExteriorOfWeightOne
      (abelianVarietyCohomologyOf (finbetti_finiteBetti X) (spec_bettiDeRhamIso_abelian X)
        (hodgeDecomposition_of_abelian X) (torusCohomology_cupProductOf X)) :=
  harvestBetti_isExteriorOfWeightOne_of_cupFiltered _ _ _ (cupFiltered_cupProductOf_of_abelian X)

/-- **Weil classes are Hodge classes, unconditionally.** For every abelian `X` and every Weil-type
action `A` on the weight-one part of the package at `cupProductOf X`, every rational Weil class
lies in `Hdg^k(X; ℚ)`, `k = finrank ℂ (Vs ⊓ H^{1,0})`: `weilClassOf_le_hdg` (and its twin
`harvestBetti_weilClassOf_le_hdg`) with `hF`, `hB`, `hD`, `hT` and `hC` supplied. `A` and `hW` are
data of the statement, not hypotheses on `X`.
Source: Weil, "Abelian varieties and the Hodge ring" (1977), as for `weilClassOf_le_hdg`; the
inputs through `finbetti_finiteBetti`, `spec_bettiDeRhamIso_abelian`,
`torusCohomology_cupProductOf` and the two named theorems above.
Relation to the goal: HC no distance; AV milestone no distance. -/
@[hodge_milestone] theorem abelian_weilClassOf_le_hdg {d : ℚ}
    (A : letI := (torusCohomology_cupProductOf X).finite
      HodgeBlocks.WeilAction
        (abelianVarietyCohomologyOf (finbetti_finiteBetti X) (spec_bettiDeRhamIso_abelian X)
          (hodgeDecomposition_of_abelian X) (torusCohomology_cupProductOf X)).weight1 d)
    (hW : letI := (torusCohomology_cupProductOf X).finite; A.IsWeilType) :
    letI := (torusCohomology_cupProductOf X).finite
    weilClassOf (finbetti_finiteBetti X) (spec_bettiDeRhamIso_abelian X)
        (hodgeDecomposition_of_abelian X) (torusCohomology_cupProductOf X) A hW ≤
      Hdg^(Module.finrank ℂ ↥(A.Vs ⊓
        (abelianVarietyCohomologyOf (finbetti_finiteBetti X) (spec_bettiDeRhamIso_abelian X)
          (hodgeDecomposition_of_abelian X) (torusCohomology_cupProductOf X)).weight1.H
          (1, 0)))(X; ℚ) :=
  abelian_weilClassOf_le_hdg_aux X A hW

/-- The `harvestBetti_` twin gives the same statement. -/
example {d : ℚ}
    (A : letI := (torusCohomology_cupProductOf X).finite
      HodgeBlocks.WeilAction
        (abelianVarietyCohomologyOf (finbetti_finiteBetti X) (spec_bettiDeRhamIso_abelian X)
          (hodgeDecomposition_of_abelian X) (torusCohomology_cupProductOf X)).weight1 d)
    (hW : letI := (torusCohomology_cupProductOf X).finite; A.IsWeilType) :
    letI := (torusCohomology_cupProductOf X).finite
    weilClassOf (finbetti_finiteBetti X) (spec_bettiDeRhamIso_abelian X)
        (hodgeDecomposition_of_abelian X) (torusCohomology_cupProductOf X) A hW ≤
      Hdg^(Module.finrank ℂ ↥(A.Vs ⊓
        (abelianVarietyCohomologyOf (finbetti_finiteBetti X) (spec_bettiDeRhamIso_abelian X)
          (hodgeDecomposition_of_abelian X) (torusCohomology_cupProductOf X)).weight1.H
          (1, 0)))(X; ℚ) :=
  harvestBetti_weilClassOf_le_hdg _ _ _ (cupFiltered_cupProductOf_of_abelian X) A hW

