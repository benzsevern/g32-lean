import HodgeLean.Adapters.ChowCorrespondenceProofs

/-!
# Rational equivalence, Chow groups and graph correspondences (FROZEN SPEC)

Track A2. The objects are constructed in `HodgeLean.Adapters.ChowCorrespondenceDefs` from A1's
quasi-compact cycle pushforward `a1p_pushforward`, Mathlib's order of vanishing, upstream's
integral subscheme `cycleComponent X w`, the flat pullback `ccm3_flatPullback` and the
scheme-theoretic intersection cycle `ccm11_intersectionCycle`:
* `a2_ratEquivDim X R k`, the `k`-cycles rationally equivalent to zero, is generated by the
  `R`-multiples of the principal cycles `[div φ]` of nonzero rational functions on subvarieties
  of dimension `k + 1`;
* `a2_Chow X R k = Z_k X / Rat_k X`. This file defines the proper pushforward
  `a2_chowPushforward f`, for `f` proper between schemes of finite type over `ℂ`, as the induced
  map `a2_chowMap` of `a1p_pushforward f`, with the preservation proofs
  `a2_pushforward_mem_dimCycles` and `a2_pushforward_ratEquiv`;
* a correspondence is a rational cycle on `gagam_product X Y`. The proxies `a2_naiveCorrAction`,
  `α ↦ p₂_*(Γ ·ₙ p₁^* α)`, and `a2_naiveCorrComp`, `p₁₃_*(p₁₂^* Γ ·ₙ p₂₃^* Γ')`, use the
  fundamental cycle `·ₙ` of the scheme-theoretic intersection. They are not the action and the
  composition of general correspondences; on graph correspondences and their transposes they
  agree with them, and the statements below are about graphs only.

Claimed, for schemes of finite type over `ℂ`: rationally equivalent cycles have the stated
dimension; proper pushforward preserves rational equivalence (Fulton, Theorem 1.4), so it
descends to Chow groups functorially; the degree of a `0`-cycle rationally equivalent to zero on
a proper scheme is `0`; on a point nothing nonzero is rationally equivalent to zero; on `𝔸¹` the
origin is. For varieties: the transpose is an involution; through the naive proxies, the graph
correspondence `Γ_f` acts as `f_*`, its transpose acts as the flat-pullback cycle
`ccm3_flatPullback f`, and `Γ_g ∘ Γ_f = Γ_{f ≫ g}` with the composite acting as the composite; for a smooth morphism of
smooth projective varieties the transposed graph action matches `homPullback` on cycle classes,
as an implication from `ccm6_homPullback_cycleClass`.

Not claimed: the action and the composition of general correspondences (`·ₙ` is Fulton's
intersection product only for proper, Cohen–Macaulay intersections); these are deferred to track
A3, the intersection product; descent of correspondence actions to Chow groups;
compatibility of the cycle class with pushforward (no cohomological pushforward exists in the
repository); vanishing of cycle classes on `Rat_k`. HC no distance; AV milestone no distance.
-/

noncomputable section
open CategoryTheory AlgebraicGeometry Polynomial HodgeLean.Foundations.Curves
open HodgeLean.RealDefs
open scoped MonoidalCategory

namespace HodgeLean.Adapters

universe u

/-! ## Rational equivalence -/

/-- A cycle rationally equivalent to zero in dimension `k` has pure dimension `k`: a
codimension-one point of a `(k + 1)`-dimensional subvariety of a scheme of finite type over `ℂ`
has a `k`-dimensional closure.
Source: Fulton, *Intersection Theory*, second edition, §1.3 (`[div(r)]` is a `k`-cycle);
Hartshorne, *Algebraic Geometry*, II, Exercise 3.20 (`dim Z + codim(Z, W) = dim W`). -/
theorem a2_ratEquivDim_le_dimCycles (X : Over (Spec ↧ℂ)) [LocallyOfFiniteType X.hom]
    [QuasiCompact X.hom] (R : Type*) [Ring R] (k : ℕ) :
    a2_ratEquivDim X.left R k ≤ a2_dimCycles X.left R k :=
  a2_ratEquivDim_le_dimCycles_aux X R k

example (X : Over (Spec ↧ℂ)) [LocallyOfFiniteType X.hom] [QuasiCompact X.hom] (k : ℕ)
    (c : AlgebraicCycle X.left ℤ) (hc : c ∈ a2_ratEquivDim X.left ℤ k) (x : X.left)
    (hx : c x ≠ 0) : Order.height x = k :=
  a2_ratEquivDim_le_dimCycles X ℤ k hc x hx

/-- Proper pushforward preserves rational equivalence: `f_*` sends `Rat_k X` into `Rat_k Y`.
On a generator, `f_*[div φ]` is `0` when `f` drops the dimension of `W = closure {w}` and
`[div N(φ)]` on `f(W)` otherwise, `N` the norm of `K(W)` over `K(f(W))`.
Source: Fulton, *Intersection Theory*, second edition, §1.4, Theorem 1.4 and Proposition 1.4. -/
theorem a2_pushforward_ratEquiv {X Y : Over (Spec ↧ℂ)} [LocallyOfFiniteType X.hom]
    [QuasiCompact X.hom] [LocallyOfFiniteType Y.hom] [QuasiCompact Y.hom] (f : X ⟶ Y)
    [IsProper f.left] (R : Type*) [Ring R] (k : ℕ) (c : AlgebraicCycle X.left R)
    (hc : c ∈ a2_ratEquivDim X.left R k) :
    a1p_pushforward f.left c ∈ a2_ratEquivDim Y.left R k :=
  a2_pushforward_ratEquiv_aux f R k c hc

/-- Rationally equivalent cycles have rationally equivalent pushforwards. -/
example {X Y : Over (Spec ↧ℂ)} [LocallyOfFiniteType X.hom] [QuasiCompact X.hom]
    [LocallyOfFiniteType Y.hom] [QuasiCompact Y.hom] (f : X ⟶ Y) [IsProper f.left] (k : ℕ)
    (α β : AlgebraicCycle X.left ℤ) (h : a2_RatEquiv X.left k α β) :
    a2_RatEquiv Y.left k (a1p_pushforward f.left α) (a1p_pushforward f.left β) := by
  have := a2_pushforward_ratEquiv f ℤ k (α - β) h
  rwa [show α - β = α + -β from sub_eq_add_neg α β, a1p_pushforward_add,
    show a1p_pushforward f.left (-β) = -a1p_pushforward f.left β from
      map_neg (a2_pushforwardHom f.left ℤ) β, ← sub_eq_add_neg] at this

/-- On a point nothing nonzero is rationally equivalent to zero: `Spec ℂ` has no subvariety of
positive dimension.
Source: Fulton, *Intersection Theory*, second edition, §1.3, definition of `Rat_k X`;
Hartshorne, *Algebraic Geometry*, II.2 (`Spec` of a field is a point). -/
theorem a2_ratEquivDim_point (R : Type*) [Ring R] (k : ℕ) :
    a2_ratEquivDim (Spec ↧ℂ) R k = ⊥ :=
  a2_ratEquivDim_point_aux R k

example [DecidableEq (Spec ↧ℂ)] (p : Spec ↧ℂ) :
    Function.locallyFinsuppWithin.single p (1 : ℤ) ∉ a2_ratEquivDim (Spec ↧ℂ) ℤ 0 := by
  rw [a2_ratEquivDim_point, AddSubgroup.mem_bot]
  intro h
  have := congrArg (fun c : AlgebraicCycle (Spec ↧ℂ) ℤ => c p) h
  simp at this

/-- On a proper scheme over `ℂ`, a `0`-cycle rationally equivalent to zero has degree `0`.
Source: Fulton, *Intersection Theory*, second edition, §1.4, Definition 1.4 (the degree is
defined on `A_0 X` for proper `X`); Mathlib, `AlgebraicGeometry.AlgebraicCycle.degree`. -/
theorem a2_degree_ratEquiv (X : Over (Spec ↧ℂ)) [IsProper X.hom] (R : Type*) [CommRing R]
    (c : AlgebraicCycle X.left R)
    (hc : c ∈ a2_ratEquivDim X.left R 0) :
    AlgebraicCycle.degree X.hom c = 0 :=
  a2_degree_ratEquiv_aux X R c hc

example (X : Over (Spec ↧ℂ)) [IsProper X.hom]
    (α β : AlgebraicCycle X.left ℤ) (h : a2_RatEquiv X.left 0 α β) :
    AlgebraicCycle.degree X.hom α = AlgebraicCycle.degree X.hom β := by
  have := a2_degree_ratEquiv X ℤ (α - β) h
  rwa [map_sub, sub_eq_zero] at this

/-- Witness: on the affine line the origin is rationally equivalent to zero; it is the
principal cycle `[div x]` of the coordinate function on `𝔸¹`.
Source: Fulton, *Intersection Theory*, second edition, §1.3, definition of `Rat_k X`;
Hartshorne, *Algebraic Geometry*, II.6, Example 6.2.1 (`Cl 𝔸ⁿ = 0`). -/
theorem a2_affineLineOrigin_mem_ratEquivDim [DecidableEq a1p_affineLine.left] :
    Function.locallyFinsuppWithin.single a2_affineLineOrigin (1 : ℤ) ∈
      a2_ratEquivDim a1p_affineLine.left ℤ 0 :=
  a2_affineLineOrigin_mem_ratEquivDim_aux

/-- The properness in `a2_degree_ratEquiv` is needed: on `𝔸¹` the origin has degree `1` over
`ℂ`, yet it is rationally equivalent to zero. -/
example [DecidableEq a1p_affineLine.left] :
    a2_RatEquiv a1p_affineLine.left 0
      (Function.locallyFinsuppWithin.single a2_affineLineOrigin (1 : ℤ)) 0 := by
  simpa [a2_RatEquiv] using a2_affineLineOrigin_mem_ratEquivDim

/-! ## Chow groups -/

/-- The proper pushforward `f_* : A_k X → A_k Y` for a proper morphism `f` of schemes of finite
type over `ℂ`: the map `a2_chowMap` induced by `a1p_pushforward f`, which preserves cycles of
pure dimension `k` (`a2_pushforward_mem_dimCycles`) and `Rat_k` (`a2_pushforward_ratEquiv`).
Source: Fulton, *Intersection Theory*, second edition, §1.4, Theorem 1.4 and the induced
`f_* : A_k X → A_k Y`. -/
def a2_chowPushforward {X Y : Over (Spec ↧ℂ)} [LocallyOfFiniteType X.hom]
    [QuasiCompact X.hom] [LocallyOfFiniteType Y.hom] [QuasiCompact Y.hom] (f : X ⟶ Y)
    [IsProper f.left] (R : Type*) [Ring R] (k : ℕ) :
    a2_Chow X.left R k →+ a2_Chow Y.left R k :=
  a2_chowMap (a2_pushforwardHom f.left R) (a2_pushforward_mem_dimCycles f R k)
    (a2_pushforward_ratEquiv f R k)

example {X : Over (Spec ↧ℂ)} [LocallyOfFiniteType X.hom] [QuasiCompact X.hom] (k : ℕ) :
    a2_Chow X.left ℤ k →+ a2_Chow X.left ℤ k := a2_chowPushforward (𝟙 X) ℤ k

/-- On classes, the proper pushforward is induced by `a1p_pushforward`.
Source: Fulton, *Intersection Theory*, second edition, §1.4, Theorem 1.4 and the induced
`f_* : A_k X → A_k Y`. -/
theorem a2_chowPushforward_mk {X Y : Over (Spec ↧ℂ)} [LocallyOfFiniteType X.hom]
    [QuasiCompact X.hom] [LocallyOfFiniteType Y.hom] [QuasiCompact Y.hom] (f : X ⟶ Y)
    [IsProper f.left] (R : Type*) [Ring R] (k : ℕ) (c : AlgebraicCycle X.left R)
    (hc : c ∈ a2_dimCycles X.left R k) :
    a2_chowPushforward f R k (a2_chowMk X.left c hc) =
      a2_chowMk Y.left (a1p_pushforward f.left c) (a2_pushforward_mem_dimCycles f R k c hc) :=
  a2_chowPushforward_mk_aux f R k c hc

/-- `id_* = id` on Chow groups.
Source: Fulton, *Intersection Theory*, second edition, §1.4. -/
theorem a2_chowPushforward_id (X : Over (Spec ↧ℂ)) [LocallyOfFiniteType X.hom]
    [QuasiCompact X.hom] (R : Type*) [Ring R] (k : ℕ) :
    a2_chowPushforward (𝟙 X) R k = AddMonoidHom.id _ :=
  a2_chowPushforward_id_aux X R k

example (X : Over (Spec ↧ℂ)) [LocallyOfFiniteType X.hom] [QuasiCompact X.hom] (k : ℕ)
    (a : a2_Chow X.left ℤ k) :
    a2_chowPushforward (𝟙 X) ℤ k a = a := by
  rw [a2_chowPushforward_id]
  rfl

/-- `(f ≫ g)_* = g_* ∘ f_*` on Chow groups, for proper morphisms.
Source: Fulton, *Intersection Theory*, second edition, §1.4, Theorem 1.4 (functoriality). -/
theorem a2_chowPushforward_comp {X Y Z : Over (Spec ↧ℂ)} [LocallyOfFiniteType X.hom]
    [QuasiCompact X.hom] [LocallyOfFiniteType Y.hom] [QuasiCompact Y.hom]
    [LocallyOfFiniteType Z.hom] [QuasiCompact Z.hom] (f : X ⟶ Y) (g : Y ⟶ Z)
    [IsProper f.left] [IsProper g.left] (R : Type*) [Ring R] (k : ℕ) :
    a2_chowPushforward (f ≫ g) R k =
      (a2_chowPushforward g R k).comp (a2_chowPushforward f R k) :=
  a2_chowPushforward_comp_aux f g R k

/-- Witness: the class of the point in `A_0(Spec ℂ)` is nonzero, so the Chow group of a point
does not collapse. -/
example [DecidableEq (Spec ↧ℂ)] (p : Spec ↧ℂ)
    (h : Function.locallyFinsuppWithin.single p (1 : ℤ) ∈ a2_dimCycles (Spec ↧ℂ) ℤ 0) :
    a2_chowMk (Spec ↧ℂ) _ h ≠ 0 := by
  unfold a2_chowMk
  rw [Ne, QuotientAddGroup.eq_zero_iff, AddSubgroup.mem_addSubgroupOf, a2_ratEquivDim_point,
    AddSubgroup.mem_bot]
  intro h0
  have := congrArg (fun c : AlgebraicCycle (Spec ↧ℂ) ℤ => c p) h0
  simp at this

/-! ## Correspondences -/

/-- The transpose is an involution.
Source: Fulton, *Intersection Theory*, second edition, §16.1, the transpose of a correspondence;
A1, `a1p_pushforward_comp` and `a1p_pushforward_id`. -/
theorem a2_transpose_transpose {X Y : Over (Spec ↧ℂ)} (Γ : a2_Corr X Y) :
    a2_transpose (a2_transpose Γ) = Γ :=
  a2_transpose_transpose_aux Γ

example {X Y : Over (Spec ↧ℂ)} : Function.Injective (a2_transpose (X := X) (Y := Y)) :=
  fun Γ Γ' h => by rw [← a2_transpose_transpose Γ, h, a2_transpose_transpose]

/-- The graph correspondence acts as pushforward: `p₂_*([Γ_f] ·ₙ p₁^* α) = f_* α`. The
intersection of `Γ_f` with `p₁⁻¹(V) = V × Y` is the graph of `f|_V`, reduced and isomorphic to
`V`, so `·ₙ` is the intersection product here.
Source: Fulton, *Intersection Theory*, second edition, §16.1 (for a morphism `f`, the graph
correspondence acts as `f_*`); Hartshorne, *Algebraic Geometry*, II, Exercise 4.8 (the graph of a
morphism to a separated scheme is a closed immersion). -/
theorem a2_naiveCorrAction_graph {X Y : Over (Spec ↧ℂ)} [LocallyOfFiniteType X.hom]
    [QuasiCompact X.hom] [LocallyOfFiniteType Y.hom] [QuasiCompact Y.hom]
    [IsIntegral X.left] [IsIntegral Y.left] [IsSeparated Y.hom] (f : X ⟶ Y)
    (α : AlgebraicCycle X.left ℚ) :
    a2_naiveCorrAction (a2_graphCorr f) α = a1p_pushforward f.left α :=
  a2_naiveCorrAction_graph_aux f α

/-- The graph of the identity, the diagonal, acts as the identity. -/
example {X : Over (Spec ↧ℂ)} [LocallyOfFiniteType X.hom] [QuasiCompact X.hom]
    [IsIntegral X.left] [IsSeparated X.hom] (α : AlgebraicCycle X.left ℚ) :
    a2_naiveCorrAction (a2_graphCorr (𝟙 X)) α = α := by
  rw [a2_naiveCorrAction_graph]
  exact a1p_pushforward_id α

/-- The transposed graph correspondence acts as the inverse-image cycle: the intersection of
`Γ_fᵗ` with `p₁⁻¹(W) = W × X` is the scheme-theoretic inverse image `f⁻¹(W)`, and
`ccm3_flatPullback` records its components with their generic lengths. For flat `f` this is
Fulton's flat pullback.
Source: Fulton, *Intersection Theory*, second edition, §16.1 (the transpose of a graph acts as
`f^*`) and §1.7 (flat pullback); Hartshorne, *Algebraic Geometry*, II, Exercise 4.8. -/
theorem a2_naiveCorrAction_transpose_graph {X Y : Over (Spec ↧ℂ)} [LocallyOfFiniteType X.hom]
    [QuasiCompact X.hom] [LocallyOfFiniteType Y.hom] [QuasiCompact Y.hom]
    [IsIntegral X.left] [IsIntegral Y.left] [IsSeparated Y.hom] (f : X ⟶ Y)
    (β : AlgebraicCycle Y.left ℚ) :
    a2_naiveCorrAction (a2_transpose (a2_graphCorr f)) β = ccm3_flatPullback f.left β :=
  a2_naiveCorrAction_transpose_graph_aux f β

/-- The transposed diagonal acts as the identity, through `ccm3_flatPullback_id`. -/
example {X : Over (Spec ↧ℂ)} [LocallyOfFiniteType X.hom] [QuasiCompact X.hom]
    [IsIntegral X.left] [IsSeparated X.hom] (β : AlgebraicCycle X.left ℚ) :
    a2_naiveCorrAction (a2_transpose (a2_graphCorr (𝟙 X))) β = β := by
  rw [a2_naiveCorrAction_transpose_graph]
  exact ccm3_flatPullback_id β

/-- Graph correspondences compose as their morphisms: `Γ_g ∘ Γ_f = Γ_{f ≫ g}`. The
intersection of `Γ_f × Z` and `X × Γ_g` in `X × Y × Z` is `{(x, f x, g (f x))}`, reduced and
isomorphic to `X`, and `p₁₃` maps it isomorphically onto `Γ_{f ≫ g}`.
Source: Fulton, *Intersection Theory*, second edition, §16.1, composition of correspondences
and of graphs. -/
theorem a2_naiveCorrComp_graph {X Y Z : Over (Spec ↧ℂ)} [LocallyOfFiniteType X.hom]
    [QuasiCompact X.hom] [LocallyOfFiniteType Y.hom] [QuasiCompact Y.hom]
    [LocallyOfFiniteType Z.hom] [QuasiCompact Z.hom] [IsIntegral X.left] [IsIntegral Y.left]
    [IsIntegral Z.left] [IsSeparated Y.hom] [IsSeparated Z.hom] (f : X ⟶ Y) (g : Y ⟶ Z) :
    a2_naiveCorrComp (a2_graphCorr f) (a2_graphCorr g) = a2_graphCorr (f ≫ g) :=
  a2_naiveCorrComp_graph_aux f g

/-- The composite of two graph correspondences acts as the composite of their actions:
`a2_naiveCorrComp_graph`, `a2_naiveCorrAction_graph` and `a1p_pushforward_comp`.
Source: Fulton, *Intersection Theory*, second edition, §16.1, `(c' ∘ c)_* = c'_* ∘ c_*`. -/
theorem a2_naiveCorrAction_naiveCorrComp_graph {X Y Z : Over (Spec ↧ℂ)} [LocallyOfFiniteType X.hom]
    [QuasiCompact X.hom] [LocallyOfFiniteType Y.hom] [QuasiCompact Y.hom]
    [LocallyOfFiniteType Z.hom] [QuasiCompact Z.hom] [IsIntegral X.left] [IsIntegral Y.left]
    [IsIntegral Z.left] [IsSeparated Y.hom] [IsSeparated Z.hom] (f : X ⟶ Y) (g : Y ⟶ Z)
    (α : AlgebraicCycle X.left ℚ) :
    a2_naiveCorrAction (a2_naiveCorrComp (a2_graphCorr f) (a2_graphCorr g)) α =
      a2_naiveCorrAction (a2_graphCorr g) (a2_naiveCorrAction (a2_graphCorr f) α) :=
  a2_naiveCorrAction_naiveCorrComp_graph_aux f g α

example {X Y : Over (Spec ↧ℂ)} [LocallyOfFiniteType X.hom] [QuasiCompact X.hom]
    [LocallyOfFiniteType Y.hom] [QuasiCompact Y.hom] [IsIntegral X.left] [IsIntegral Y.left]
    [IsSeparated X.hom] [IsSeparated Y.hom] (f : X ⟶ Y) :
    a2_naiveCorrComp (a2_graphCorr (𝟙 X)) (a2_graphCorr f) = a2_graphCorr f := by
  rw [a2_naiveCorrComp_graph, Category.id_comp]

/-! ## Cycle classes -/

/-- For a smooth morphism of smooth projective varieties, the transposed graph action matches
`homPullback` on cycle classes, for a cycle pure of codimension `q`: an implication from
`ccm6_homPullback_cycleClass` through `a2_naiveCorrAction_transpose_graph`.
Source: Fulton, *Intersection Theory*, second edition, §16.1 and §19.1; Voisin, *Hodge Theory
and Complex Algebraic Geometry I*, §11. -/
theorem a2_cycleClass_transpose_graph {X Z : Over (Spec ↧ℂ)}
    [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom]
    [IsIntegral Z.left] [Smooth Z.hom] [IsProjective Z.hom]
    (f : X ⟶ Z) [Smooth f.left] (q : ℕ) (c : AlgebraicCycle Z.left ℚ)
    (hc : ∀ x : Z.left, c x ≠ 0 → Order.coheight x = q) :
    homPullback f (2 * q) (ccm3_cycleClass Z q c) =
      ccm3_cycleClass X q (a2_naiveCorrAction (a2_transpose (a2_graphCorr f)) c) :=
  a2_cycleClass_transpose_graph_aux f q c hc

example {X : Over (Spec ↧ℂ)} [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom] (q : ℕ)
    (c : AlgebraicCycle X.left ℚ) (hc : ∀ x : X.left, c x ≠ 0 → Order.coheight x = q) :
    homPullback (𝟙 X) (2 * q) (ccm3_cycleClass X q c) =
      ccm3_cycleClass X q (a2_naiveCorrAction (a2_transpose (a2_graphCorr (𝟙 X))) c) :=
  a2_cycleClass_transpose_graph (𝟙 X) q c hc

end HodgeLean.Adapters
