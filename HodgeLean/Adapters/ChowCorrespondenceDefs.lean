import HodgeLean.Adapters.CyclePushforward
import HodgeLean.Adapters.CycleClassDivisorIntersectionDefs
import HodgeLean.Foundations.Curves.CurveDivisorClassesDefs

/-! # Rational equivalence, Chow groups and graph correspondences, by construction

Track A2. Every object here is built from existing data:
* the principal cycle `a2_principalCycle X R w φ` is the principal divisor of a nonzero rational
  function `φ` on the integral closed subscheme `cycleComponent X w` (upstream's reduced
  `closure {w}`), with Mathlib's order of vanishing `Scheme.ord`, pushed into `X` by A1's
  `a1p_pushforward` along `cycleComponentι X w`;
* `a2_ratEquivDim X R k` is the subgroup generated by the `R`-multiples of the principal cycles of
  subvarieties of dimension `k + 1`, and `a2_Chow X R k` is the quotient of the dimension-`k`
  cycles `a2_dimCycles X R k` by it;
* `a2_chowMap` is the map of Chow groups induced by a map of cycles, given explicit proofs that it
  preserves `Z_k` and `Rat_k`; the frozen spec defines the proper pushforward through it;
* a correspondence is a cycle on `gagam_product X Y` with rational coefficients. The proxies
  `a2_naiveCorrAction`, `α ↦ p₂_*(Γ ·ₙ p₁^* α)`, and `a2_naiveCorrComp`,
  `p₁₃_*(p₁₂^* Γ ·ₙ p₂₃^* Γ')`, use the flat pullback `ccm3_flatPullback` and the scheme-theoretic
  intersection cycle `ccm11_intersectionCycle`, written `·ₙ`.

The intersection `·ₙ` is the fundamental cycle of the scheme-theoretic intersection of the
prime components. It is not Fulton's intersection product for general cycles, so the naive
operations are not the action and composition of correspondences in general; they agree with
them on graph correspondences and their transposes, and the spec states them there only. The
general action and composition need an intersection product and are deferred to track A3. The
statements are in `HodgeLean.Adapters.ChowCorrespondence`.
HC no distance; AV milestone no distance.
-/

noncomputable section
open CategoryTheory AlgebraicGeometry Polynomial HodgeLean.Foundations.Curves
open scoped MonoidalCategory

namespace HodgeLean.Adapters

universe u

/-! ## Rational equivalence and the Chow group -/

/-- A closed subscheme of a locally Noetherian scheme is locally Noetherian; in particular the
integral subscheme `cycleComponent X w` is.
Source: Mathlib, `LocallyOfFiniteType.isLocallyNoetherian` (closed immersions are of finite
type); Hartshorne, *Algebraic Geometry*, II, Exercise 3.13. -/
instance a2_cycleComponent_isLocallyNoetherian (X : Scheme.{u}) [IsLocallyNoetherian X]
    (w : X) : IsLocallyNoetherian (cycleComponent X w) :=
  LocallyOfFiniteType.isLocallyNoetherian (cycleComponentι X w)

example (X : Scheme.{u}) [IsLocallyNoetherian X] (w : X) :
    IsIntegral (cycleComponent X w) := inferInstance

/-- The principal cycle `[div φ]` of a rational function `φ` on the subvariety
`W = closure {w}`, as a cycle on `X` with coefficients in `R`: the principal divisor
`principalDivisor (cycleComponent X w) φ` (orders of vanishing at the codimension-one points of
`W`), pushed forward along the closed immersion `cycleComponentι X w`.
Source: Fulton, *Intersection Theory*, second edition, §1.3, definition of `[div(r)]` on a
subvariety `W` of `X`; Mathlib, `AlgebraicGeometry.Scheme.ord`. -/
def a2_principalCycle (X : Scheme.{u}) [IsLocallyNoetherian X] (R : Type*) [Ring R] (w : X)
    (φ : (cycleComponent X w).functionField) : AlgebraicCycle X R :=
  (a1p_pushforward (cycleComponentι X w)
    (principalDivisor (cycleComponent X w) φ : AlgebraicCycle (cycleComponent X w) ℤ)).mapRange
    (Int.cast : ℤ → R) Int.cast_zero

example (X : Scheme.{u}) [IsLocallyNoetherian X] (w : X) :
    a2_principalCycle X ℤ w 0 = 0 := by
  classical
  have : (principalDivisor (cycleComponent X w) 0 : AlgebraicCycle (cycleComponent X w) ℤ) = 0 := by
    ext P
    simp only [principalDivisor]
    split_ifs
    · change ordAt (cycleComponent X w) 0 P = 0
      simp [ordAt, Scheme.ord_zero]
    · rfl
  rw [a2_principalCycle, this]
  ext y
  simp [a1p_pushforward, Function.locallyFinsupp.map]

/-- The cycles of pure dimension `k`: every point with a nonzero coefficient has
`Order.height = k`. On a scheme of finite type over a field the height of a point is the
dimension of its closure, and this is Fulton's group of `k`-cycles.
Source: Fulton, *Intersection Theory*, second edition, §1.3, the group `Z_k X` of `k`-cycles. -/
def a2_dimCycles (X : Scheme.{u}) (R : Type*) [Ring R] (k : ℕ) :
    AddSubgroup (AlgebraicCycle X R) where
  carrier := {c | ∀ x, c x ≠ 0 → Order.height x = k}
  add_mem' {c d} hc hd x hx := by
    by_cases h : c x = 0
    · exact hd x (by simpa [h] using hx)
    · exact hc x h
  zero_mem' x hx := (hx rfl).elim
  neg_mem' {c} hc x hx := hc x (by simpa using hx)

example (X : Scheme.{u}) (k : ℕ) : (0 : AlgebraicCycle X ℤ) ∈ a2_dimCycles X ℤ k :=
  (a2_dimCycles X ℤ k).zero_mem

/-- The `k`-cycles rationally equivalent to zero: the subgroup generated by the cycles
`r • [div φ]`, for `r ∈ R`, `φ` a nonzero rational function on a subvariety `closure {w}` of
dimension `k + 1`, the dimension measured by `Order.height`. On a scheme of finite type over a
field this is Fulton's `Rat_k X`.
Source: Fulton, *Intersection Theory*, second edition, §1.3, definition of `Rat_k X`; §1.6
(the equivalent description through `X × ℙ¹`). -/
def a2_ratEquivDim (X : Scheme.{u}) [IsLocallyNoetherian X] (R : Type*) [Ring R] (k : ℕ) :
    AddSubgroup (AlgebraicCycle X R) :=
  AddSubgroup.closure {c | ∃ (w : X) (φ : (cycleComponent X w).functionField) (r : R),
    Order.height w = (k + 1 : ℕ) ∧ φ ≠ 0 ∧
      c = (a2_principalCycle X R w φ).mapRange (r * ·) (mul_zero r)}

example (X : Scheme.{u}) [IsLocallyNoetherian X] (k : ℕ) (w : X)
    (φ : (cycleComponent X w).functionField) (hw : Order.height w = (k + 1 : ℕ)) (hφ : φ ≠ 0) :
    a2_principalCycle X ℤ w φ ∈ a2_ratEquivDim X ℤ k :=
  AddSubgroup.subset_closure ⟨w, φ, 1, hw, hφ, by ext; simp⟩

/-- Two cycles are rationally equivalent in dimension `k` when their difference lies in
`a2_ratEquivDim X R k`.
Source: Fulton, *Intersection Theory*, second edition, §1.3, `α ~ α'`. -/
def a2_RatEquiv (X : Scheme.{u}) [IsLocallyNoetherian X] {R : Type*} [Ring R] (k : ℕ)
    (α β : AlgebraicCycle X R) : Prop :=
  α - β ∈ a2_ratEquivDim X R k

example (X : Scheme.{u}) [IsLocallyNoetherian X] (k : ℕ) (α : AlgebraicCycle X ℤ) :
    a2_RatEquiv X k α α := by
  simp [a2_RatEquiv, (a2_ratEquivDim X ℤ k).zero_mem]

/-- The Chow group `A_k X = Z_k X / Rat_k X`: dimension-`k` cycles modulo those rationally
equivalent to zero. On a scheme of finite type over a field this is Fulton's Chow group.
Source: Fulton, *Intersection Theory*, second edition, §1.3, definition of `A_k X`. -/
abbrev a2_Chow (X : Scheme.{u}) [IsLocallyNoetherian X] (R : Type*) [Ring R] (k : ℕ) :=
  a2_dimCycles X R k ⧸ (a2_ratEquivDim X R k).addSubgroupOf (a2_dimCycles X R k)

example (X : Scheme.{u}) [IsLocallyNoetherian X] (k : ℕ) : AddCommGroup (a2_Chow X ℤ k) :=
  inferInstance

/-- The class in `A_k X` of a cycle of pure dimension `k`.
Source: Fulton, *Intersection Theory*, second edition, §1.3; Mathlib, `QuotientAddGroup.mk`. -/
def a2_chowMk (X : Scheme.{u}) [IsLocallyNoetherian X] {R : Type*} [Ring R] {k : ℕ}
    (c : AlgebraicCycle X R) (hc : c ∈ a2_dimCycles X R k) : a2_Chow X R k :=
  QuotientAddGroup.mk ⟨c, hc⟩

example (X : Scheme.{u}) [IsLocallyNoetherian X] (k : ℕ) :
    a2_chowMk X (0 : AlgebraicCycle X ℤ) (a2_dimCycles X ℤ k).zero_mem = 0 :=
  rfl

/-- A1's quasi-compact pushforward `a1p_pushforward f` as an additive map. For proper `f` it is
Fulton's `f_*` on cycles.
Source: A1, `a1p_pushforward` and `a1p_pushforward_add`; Fulton, *Intersection Theory*, second
edition, §1.4 (the proper case). -/
def a2_pushforwardHom {X Y : Scheme.{u}} (f : X ⟶ Y) [QuasiCompact f] (R : Type*) [Ring R] :
    AlgebraicCycle X R →+ AlgebraicCycle Y R :=
  AddMonoidHom.mk' (a1p_pushforward f) (a1p_pushforward_add f)

example {X Y : Scheme.{u}} (f : X ⟶ Y) [QuasiCompact f] (c : AlgebraicCycle X ℤ) :
    a2_pushforwardHom f ℤ c = a1p_pushforward f c := rfl

/-- Over `ℂ`, `f_*` sends cycles of pure dimension `k` to cycles of pure dimension `k`: A1's
`a1p_pushforward_preserves_dimension`, in the language of `a2_dimCycles`.
Source: Fulton, *Intersection Theory*, second edition, §1.4, `f_* : Z_k X → Z_k Y`. -/
theorem a2_pushforward_mem_dimCycles {X Y : Over (Spec ↧ℂ)} [LocallyOfFiniteType X.hom]
    [LocallyOfFiniteType Y.hom] (f : X ⟶ Y) [QuasiCompact f.left] (R : Type*) [Ring R] (k : ℕ)
    (c : AlgebraicCycle X.left R) (hc : c ∈ a2_dimCycles X.left R k) :
    a1p_pushforward f.left c ∈ a2_dimCycles Y.left R k :=
  fun y hy => a1p_pushforward_preserves_dimension f k c hc y hy

example {X : Over (Spec ↧ℂ)} [LocallyOfFiniteType X.hom] (k : ℕ) (c : AlgebraicCycle X.left ℤ)
    (hc : c ∈ a2_dimCycles X.left ℤ k) :
    a1p_pushforward (Over.Hom.left (𝟙 X)) c ∈ a2_dimCycles X.left ℤ k :=
  a2_pushforward_mem_dimCycles (𝟙 X) ℤ k c hc

/-- The map `A_k X → A_k Y` induced by an additive map of cycles `φ`, given proofs that `φ` sends
cycles of pure dimension `k` to cycles of pure dimension `k` and `Rat_k X` into `Rat_k Y`. The
proper pushforward `a2_chowPushforward` of the frozen spec is this map for `φ = f_*`.
Source: Mathlib, `QuotientAddGroup.map` and `AddMonoidHom.codRestrict` (the map of quotients
induced by a map of groups preserving the subgroups). -/
def a2_chowMap {X Y : Scheme.{u}} [IsLocallyNoetherian X] [IsLocallyNoetherian Y] {R : Type*}
    [Ring R] {k : ℕ} (φ : AlgebraicCycle X R →+ AlgebraicCycle Y R)
    (hdim : ∀ c ∈ a2_dimCycles X R k, φ c ∈ a2_dimCycles Y R k)
    (hrat : ∀ c ∈ a2_ratEquivDim X R k, φ c ∈ a2_ratEquivDim Y R k) :
    a2_Chow X R k →+ a2_Chow Y R k :=
  QuotientAddGroup.map _ _
    ((φ.comp (a2_dimCycles X R k).subtype).codRestrict (a2_dimCycles Y R k)
      fun c => hdim c.1 c.2)
    (fun c hc => by
      rw [AddSubgroup.mem_comap, AddSubgroup.mem_addSubgroupOf]
      exact hrat c.1 (AddSubgroup.mem_addSubgroupOf.1 hc))

example {X Y : Scheme.{u}} [IsLocallyNoetherian X] [IsLocallyNoetherian Y] {k : ℕ}
    (φ : AlgebraicCycle X ℤ →+ AlgebraicCycle Y ℤ)
    (hdim : ∀ c ∈ a2_dimCycles X ℤ k, φ c ∈ a2_dimCycles Y ℤ k)
    (hrat : ∀ c ∈ a2_ratEquivDim X ℤ k, φ c ∈ a2_ratEquivDim Y ℤ k)
    (c : AlgebraicCycle X ℤ) (hc : c ∈ a2_dimCycles X ℤ k) :
    a2_chowMap φ hdim hrat (a2_chowMk X c hc) = a2_chowMk Y (φ c) (hdim c hc) :=
  rfl

/-- The identity of a scheme over `ℂ` is proper.
Source: Mathlib, `IsProper` holds for isomorphisms; Hartshorne, *Algebraic Geometry*, II,
Corollary 4.8 (a). -/
instance a2_isProper_id_left (X : Over (Spec ↧ℂ)) : IsProper (𝟙 X : X ⟶ X).left :=
  inferInstanceAs (IsProper (𝟙 X.left))

/-- A composite of proper morphisms of schemes over `ℂ` is proper.
Source: Mathlib, `IsProper` is stable under composition; Hartshorne, *Algebraic Geometry*, II,
Corollary 4.8 (b). -/
instance a2_isProper_comp_left {X Y Z : Over (Spec ↧ℂ)} (f : X ⟶ Y) (g : Y ⟶ Z)
    [IsProper f.left] [IsProper g.left] : IsProper (f ≫ g).left :=
  inferInstanceAs (IsProper (f.left ≫ g.left))

example {X Y Z : Over (Spec ↧ℂ)} (f : X ⟶ Y) (g : Y ⟶ Z) [IsProper f.left]
    [IsProper g.left] : QuasiCompact (f ≫ g).left := inferInstance

/-- The origin `0 ∈ 𝔸¹`, the prime ideal `(X)` of `ℂ[X]`.
Source: Hartshorne, *Algebraic Geometry*, II.2, the points of `Spec k[x]`. -/
def a2_affineLineOrigin : a1p_affineLine.left :=
  (⟨Ideal.span {(X : ℂ[X])}, (Ideal.span_singleton_prime X_ne_zero).2 prime_X⟩ :
    PrimeSpectrum ℂ[X])

example : (show PrimeSpectrum ℂ[X] from a2_affineLineOrigin).asIdeal = Ideal.span {X} := rfl

/-! ## Correspondences -/

/-- A scheme of finite type over `ℂ` is Noetherian.
Source: Hartshorne, *Algebraic Geometry*, II.3.2; Mathlib,
`LocallyOfFiniteType.isLocallyNoetherian` and `QuasiCompact.compactSpace_of_compactSpace`. -/
instance a2_isNoetherian_of_finiteType (X : Over (Spec ↧ℂ)) [LocallyOfFiniteType X.hom]
    [QuasiCompact X.hom] : IsNoetherian X.left :=
  haveI := LocallyOfFiniteType.isLocallyNoetherian X.hom
  have := QuasiCompact.compactSpace_of_compactSpace X.hom
  {}

/-- The affine line is quasi-compact over `ℂ`: its structure map is a morphism of affine schemes.
Source: Mathlib, `IsAffineHom` of `Spec.map` and `QuasiCompact` of affine morphisms. -/
instance a2_affineLine_quasiCompact : QuasiCompact a1p_affineLine.hom :=
  inferInstanceAs (QuasiCompact (Spec.map (CommRingCat.ofHom (algebraMap ℂ ℂ[X]))))

example : IsNoetherian a1p_affineLine.left := inferInstance

/-- The product of two schemes of finite type over `ℂ` is of finite type over `ℂ`.
Source: Mathlib, `LocallyOfFiniteType` is stable under base change and composition;
Hartshorne, *Algebraic Geometry*, II, Exercise 3.13. -/
instance a2_product_locallyOfFiniteType (X Y : Over (Spec ↧ℂ)) [LocallyOfFiniteType X.hom]
    [LocallyOfFiniteType Y.hom] : LocallyOfFiniteType (gagam_product X Y).hom := by
  change LocallyOfFiniteType (Limits.pullback.fst X.hom Y.hom ≫ X.hom)
  infer_instance

/-- The product of two quasi-compact schemes over `ℂ` is quasi-compact over `ℂ`.
Source: Mathlib, `QuasiCompact` is stable under base change and composition. -/
instance a2_product_quasiCompact (X Y : Over (Spec ↧ℂ)) [QuasiCompact X.hom]
    [QuasiCompact Y.hom] : QuasiCompact (gagam_product X Y).hom := by
  change QuasiCompact (Limits.pullback.fst X.hom Y.hom ≫ X.hom)
  infer_instance

example (X Y : Over (Spec ↧ℂ)) [LocallyOfFiniteType X.hom] [QuasiCompact X.hom]
    [LocallyOfFiniteType Y.hom] [QuasiCompact Y.hom] :
    IsNoetherian (gagam_product X Y).left := inferInstance

/-- The second projection `X ×_ℂ Y → Y` is quasi-compact when `X` is quasi-compact over `ℂ`.
Source: Mathlib, `QuasiCompact` is stable under base change. -/
instance a2_snd_quasiCompact (X Y : Over (Spec ↧ℂ)) [QuasiCompact X.hom] :
    QuasiCompact (CartesianMonoidalCategory.snd X Y).left := by
  change QuasiCompact (Limits.pullback.snd X.hom Y.hom)
  infer_instance

example (X Y : Over (Spec ↧ℂ)) [QuasiCompact X.hom] [LocallyOfFiniteType Y.hom]
    [QuasiCompact Y.hom] :
    QuasiCompact (CartesianMonoidalCategory.snd X Y).left := inferInstance

/-- The projection `p₁₃ : (X ×_ℂ Y) ×_ℂ Z → X ×_ℂ Z`.
Source: Fulton, *Intersection Theory*, second edition, §16.1, the projections of `X × Y × Z`. -/
def a2_p13 (X Y Z : Over (Spec ↧ℂ)) : gagam_product (gagam_product X Y) Z ⟶ gagam_product X Z :=
  CartesianMonoidalCategory.lift
    (CartesianMonoidalCategory.fst (gagam_product X Y) Z ≫ CartesianMonoidalCategory.fst X Y)
    (CartesianMonoidalCategory.snd (gagam_product X Y) Z)

/-- The projection `p₂₃ : (X ×_ℂ Y) ×_ℂ Z → Y ×_ℂ Z`.
Source: Fulton, *Intersection Theory*, second edition, §16.1, the projections of `X × Y × Z`. -/
def a2_p23 (X Y Z : Over (Spec ↧ℂ)) : gagam_product (gagam_product X Y) Z ⟶ gagam_product Y Z :=
  CartesianMonoidalCategory.lift
    (CartesianMonoidalCategory.fst (gagam_product X Y) Z ≫ CartesianMonoidalCategory.snd X Y)
    (CartesianMonoidalCategory.snd (gagam_product X Y) Z)

/-- Any morphism out of a scheme of finite type over `ℂ` into a locally Noetherian scheme is
quasi-compact; in particular `p₁₃`.
Source: Mathlib, `quasiCompact_of_compactSpace` (a quasi-compact source and a quasi-separated
target). -/
instance a2_p13_quasiCompact (X Y Z : Over (Spec ↧ℂ)) [LocallyOfFiniteType X.hom]
    [QuasiCompact X.hom] [LocallyOfFiniteType Y.hom] [QuasiCompact Y.hom]
    [LocallyOfFiniteType Z.hom] [QuasiCompact Z.hom] : QuasiCompact (a2_p13 X Y Z).left :=
  quasiCompact_of_compactSpace _

example (X Y Z : Over (Spec ↧ℂ)) :
    a2_p13 X Y Z ≫ CartesianMonoidalCategory.snd X Z =
      CartesianMonoidalCategory.snd (gagam_product X Y) Z :=
  CartesianMonoidalCategory.lift_snd _ _

/-- A correspondence from `X` to `Y`: a cycle with rational coefficients on `X ×_ℂ Y`.
Source: Fulton, *Intersection Theory*, second edition, §16.1, definition of a correspondence. -/
abbrev a2_Corr (X Y : Over (Spec ↧ℂ)) := AlgebraicCycle (gagam_product X Y).left ℚ

example (X Y : Over (Spec ↧ℂ)) : AddCommGroup (a2_Corr X Y) := inferInstance

/-- The graph morphism `(id, f) : X → X ×_ℂ Y`.
Source: Hartshorne, *Algebraic Geometry*, II, Exercise 4.8 (the graph morphism). -/
def a2_graph {X Y : Over (Spec ↧ℂ)} (f : X ⟶ Y) : X ⟶ gagam_product X Y :=
  CartesianMonoidalCategory.lift (𝟙 X) f

example {X Y : Over (Spec ↧ℂ)} (f : X ⟶ Y) :
    a2_graph f ≫ CartesianMonoidalCategory.snd X Y = f :=
  CartesianMonoidalCategory.lift_snd _ _

/-- The graph correspondence `[Γ_f]`: the prime cycle with generic point the image of the
generic point of an irreducible `X` under `(id, f)`, coefficient `1`.
Source: Fulton, *Intersection Theory*, second edition, §16.1, the graph `Γ_f` of a morphism. -/
def a2_graphCorr {X Y : Over (Spec ↧ℂ)} [IrreducibleSpace X.left] (f : X ⟶ Y) : a2_Corr X Y := by
  classical
  exact Function.locallyFinsuppWithin.single ((a2_graph f).left (genericPoint X.left)) 1

example {X Y : Over (Spec ↧ℂ)} [IrreducibleSpace X.left] (f : X ⟶ Y) :
    a2_graphCorr f ((a2_graph f).left (genericPoint X.left)) = 1 := by
  classical
  simp [a2_graphCorr]

/-- The swap `X ×_ℂ Y → Y ×_ℂ X`.
Source: Mathlib, `CartesianMonoidalCategory.lift` of the two projections. -/
def a2_swap (X Y : Over (Spec ↧ℂ)) : gagam_product X Y ⟶ gagam_product Y X :=
  CartesianMonoidalCategory.lift (CartesianMonoidalCategory.snd X Y)
    (CartesianMonoidalCategory.fst X Y)

/-- The swap is an involution.
Source: Mathlib, `CartesianMonoidalCategory.hom_ext`. -/
theorem a2_swap_swap (X Y : Over (Spec ↧ℂ)) : a2_swap X Y ≫ a2_swap Y X = 𝟙 _ := by
  unfold a2_swap gagam_product
  apply CartesianMonoidalCategory.hom_ext <;> simp

/-- The swap is an isomorphism, its own inverse.
Source: Mathlib, `CartesianMonoidalCategory.hom_ext`. -/
instance a2_swap_isIso (X Y : Over (Spec ↧ℂ)) : IsIso (a2_swap X Y).left :=
  ⟨(a2_swap Y X).left, by
    rw [← Over.comp_left, a2_swap_swap, ← Over.comp_left, a2_swap_swap]
    exact ⟨rfl, rfl⟩⟩

example (X Y : Over (Spec ↧ℂ)) : QuasiCompact (a2_swap X Y).left := inferInstance

/-- The transpose `Γᵗ` of a correspondence, its pushforward along the swap.
Source: Fulton, *Intersection Theory*, second edition, §16.1, the transpose of a correspondence. -/
def a2_transpose {X Y : Over (Spec ↧ℂ)} (Γ : a2_Corr X Y) : a2_Corr Y X :=
  a1p_pushforward (a2_swap X Y).left Γ

example {X Y : Over (Spec ↧ℂ)} : a2_transpose (0 : a2_Corr X Y) = 0 := by
  ext p
  simp [a2_transpose, a1p_pushforward, Function.locallyFinsupp.map]

/-- The scheme-theoretic intersection cycle `c ·ₙ d` on a Noetherian scheme: the bilinear
extension of `[closure {u}] ·ₙ [closure {v}] = ccm11_intersectionCycle` of the two reduced prime
subschemes, the fundamental cycle of their scheme-theoretic intersection. This is not Fulton's
intersection product: it has the wrong dimension for excess intersections, for instance
`[V] ·ₙ [V] = [V]`. It agrees with the intersection product when the intersection is proper and
its local rings are Cohen–Macaulay, as for graph correspondences.
Source: construction from `ccm11_intersectionCycle` (Fulton, *Intersection Theory*, second
edition, §1.5, the cycle `[Z]` of a scheme); comparison: Fulton, Proposition 7.1
(intersection multiplicity is the length in the Cohen–Macaulay case). -/
def a2_naiveIntersect (Z : Scheme.{0}) [IsNoetherian Z] (c d : AlgebraicCycle Z ℚ) :
    AlgebraicCycle Z ℚ :=
  ∑ᶠ u : Z, ∑ᶠ v : Z, (ccm11_intersectionCycle Z (ccm3_primeIdeal Z u)
    (ccm3_primeIdeal Z v)).mapRange (c u * d v * ·) (mul_zero _)

example (Z : Scheme.{0}) [IsNoetherian Z] (c d : AlgebraicCycle Z ℚ) :
    a2_naiveIntersect Z c d = ∑ᶠ u : Z, ∑ᶠ v : Z, (ccm11_intersectionCycle Z
      (ccm3_primeIdeal Z u) (ccm3_primeIdeal Z v)).mapRange (c u * d v * ·) (mul_zero _) :=
  rfl

/-- A scheme-intersection proxy for the action of a correspondence on cycles,
`α ↦ p₂_*(Γ ·ₙ p₁^* α)`, with the flat pullback `ccm3_flatPullback` along the first projection and
the naive intersection `a2_naiveIntersect`. It is not the action of a general correspondence; it
agrees with the true action `p₂_*(Γ · p₁^* α)` on graph correspondences and their transposes. The
general action is deferred to track A3, the intersection product.
Source: construction from `a1p_pushforward`, `ccm3_flatPullback` and `a2_naiveIntersect`,
modelled on Fulton, *Intersection Theory*, second edition, §16.1, `c_*(α) = p₂_*(c · p₁^* α)`. -/
def a2_naiveCorrAction {X Y : Over (Spec ↧ℂ)} [LocallyOfFiniteType X.hom] [QuasiCompact X.hom]
    [LocallyOfFiniteType Y.hom] [QuasiCompact Y.hom] (Γ : a2_Corr X Y)
    (α : AlgebraicCycle X.left ℚ) : AlgebraicCycle Y.left ℚ :=
  a1p_pushforward (CartesianMonoidalCategory.snd X Y).left
    (a2_naiveIntersect (gagam_product X Y).left Γ
      (ccm3_flatPullback (CartesianMonoidalCategory.fst X Y).left α))

example {X Y : Over (Spec ↧ℂ)} [LocallyOfFiniteType X.hom] [QuasiCompact X.hom]
    [LocallyOfFiniteType Y.hom] [QuasiCompact Y.hom] (α : AlgebraicCycle X.left ℚ) :
    a2_naiveCorrAction (0 : a2_Corr X Y) α = a1p_pushforward (CartesianMonoidalCategory.snd X Y).left
      (a2_naiveIntersect (gagam_product X Y).left 0
        (ccm3_flatPullback (CartesianMonoidalCategory.fst X Y).left α)) :=
  rfl

/-- A scheme-intersection proxy for the composite of correspondences,
`p₁₃_*(p₁₂^* Γ ·ₙ p₂₃^* Γ')` on `X ×_ℂ Z`, computed on `(X ×_ℂ Y) ×_ℂ Z` with the naive
intersection `a2_naiveIntersect`. It is not the composition of general correspondences; it agrees
with the true composite `p₁₃_*(p₁₂^* Γ · p₂₃^* Γ')` on graph correspondences. The general
composition is deferred to track A3, the intersection product.
Source: construction from `a1p_pushforward`, `ccm3_flatPullback` and `a2_naiveIntersect`,
modelled on Fulton, *Intersection Theory*, second edition, §16.1, composition of
correspondences. -/
def a2_naiveCorrComp {X Y Z : Over (Spec ↧ℂ)} [LocallyOfFiniteType X.hom] [QuasiCompact X.hom]
    [LocallyOfFiniteType Y.hom] [QuasiCompact Y.hom] [LocallyOfFiniteType Z.hom]
    [QuasiCompact Z.hom] (Γ : a2_Corr X Y) (Γ' : a2_Corr Y Z) : a2_Corr X Z :=
  a1p_pushforward (a2_p13 X Y Z).left
    (a2_naiveIntersect (gagam_product (gagam_product X Y) Z).left
      (ccm3_flatPullback (CartesianMonoidalCategory.fst (gagam_product X Y) Z).left Γ)
      (ccm3_flatPullback (a2_p23 X Y Z).left Γ'))

example {X Y Z : Over (Spec ↧ℂ)} [LocallyOfFiniteType X.hom] [QuasiCompact X.hom]
    [LocallyOfFiniteType Y.hom] [QuasiCompact Y.hom] [LocallyOfFiniteType Z.hom]
    [QuasiCompact Z.hom] (Γ : a2_Corr X Y) (Γ' : a2_Corr Y Z) : a2_Corr X Z :=
  a2_naiveCorrComp Γ Γ'

end HodgeLean.Adapters
