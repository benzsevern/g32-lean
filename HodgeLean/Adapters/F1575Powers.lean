import HodgeLean.Adapters.F1575
import HodgeLean.Foundations.WeilPowerSpan

/-! # The rational generating span for powers of a member of M

This specializes the abstract closure construction to the actual rational
Weil classes of the original member. It is an exterior-algebra definition;
no scheme representing the power or comparison with its cohomology is assumed.
-/

noncomputable section
open CategoryTheory AlgebraicGeometry ComplexPoint
open scoped TensorProduct

namespace HodgeLean.Adapters
open RealDefs Foundations Foundations.WeilPower

variable {X : Over (Spec ↧ℂ)} [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom]
  {μ : CupProduct X} [GrpObj X]
  {hF : FiniteBetti X} {hB : BettiDeRhamIso X} {hD : HodgeDecomposition X}
  {hT : TorusCohomology μ}
  {A : letI := hT.finite
    HodgeBlocks.WeilAction (abelianVarietyCohomologyOf hF hB hD hT).weight1 3}
  {η : HQ X 2}

/-- The exterior-algebra span of a member's `m`-th power generated by the rational degree-two
Hodge classes and the pulled-back Weil classes. The degree-two generators are the whole rational
degree-two Hodge space of the power; they are divisor classes under Lefschetz (1,1), which is not
assumed here; the
Weil space is `A.weilClasses` of the original member, not that of the power.
`k` is the cohomological degree. This definition asserts no generation result.
Source: F-1575 / TR54 §3; van Geemen, *An introduction to the Hodge conjecture
for abelian varieties*, §§5–6. -/
def f1575PowerHodgeTwoPulledWeilSpan (hM : IsMemberOfM hF hB hD hT A η) (m k : ℕ) :
    letI := hT.finite
    Submodule ℚ (⋀[ℚ]^k (HQ X 1 ⊗[ℚ] (Fin m → ℚ))) :=
  letI := hT.finite
  let S := abelianVarietyCohomologyOf hF hB hD hT
  divisorPulledWeilSpan A.J (rationalExteriorHodge S.weight1.H S.weight1.isInternal m 2)
    (A.weilClasses (h10_sup_h01_eq_top hF hB hD hT) hM.isWeilType) k

example (hM : IsMemberOfM hF hB hD hT A η) (m k : ℕ) :
    letI := hT.finite
    Submodule ℚ (⋀[ℚ]^k (HQ X 1 ⊗[ℚ] (Fin m → ℚ))) :=
  f1575PowerHodgeTwoPulledWeilSpan hM m k

/-- Every original rational Weil class pulled back to a power is a generator.
For a member of `M` the degree `n` below is six, independently of the power. -/
theorem f1575Power_weil_pullback_mem (hM : IsMemberOfM hF hB hD hT A η)
    (m : ℕ) (r s : Fin m → ℚ) :
    letI := hT.finite
    let S := abelianVarietyCohomologyOf hF hB hD hT
    let n := Module.finrank ℂ ↥(A.Vs ⊓ S.weight1.H (1, 0)) +
      Module.finrank ℂ ↥(A.Vs ⊓ S.weight1.H (1, 0))
    ∀ w ∈ A.weilClasses (h10_sup_h01_eq_top hF hB hD hT) hM.isWeilType,
      exteriorPower.map n (weilPowerPullback A.J r s) w ∈
        f1575PowerHodgeTwoPulledWeilSpan hM m n := by
  letI := hT.finite
  exact (isDivisorPulledWeilClosed_span _ _ _).pullback_mem r s

/-- The original Weil degree used in every power is six. -/
theorem f1575Power_weil_degree (hM : IsMemberOfM hF hB hD hT A η) :
    letI := hT.finite
    let S := abelianVarietyCohomologyOf hF hB hD hT
    Module.finrank ℂ ↥(A.Vs ⊓ S.weight1.H (1, 0)) +
      Module.finrank ℂ ↥(A.Vs ⊓ S.weight1.H (1, 0)) = 6 := by
  letI := hT.finite
  dsimp only
  rw [hM.finrank_eq_three]

example (hM : IsMemberOfM hF hB hD hT A η) :
    letI := hT.finite
    let S := abelianVarietyCohomologyOf hF hB hD hT
    let n := Module.finrank ℂ ↥(A.Vs ⊓ S.weight1.H (1, 0)) +
      Module.finrank ℂ ↥(A.Vs ⊓ S.weight1.H (1, 0))
    ∀ w ∈ A.weilClasses (h10_sup_h01_eq_top hF hB hD hT) hM.isWeilType,
      exteriorPower.map n (weilPowerPullback A.J (Pi.single 0 1 : Fin 2 → ℚ) 0) w ∈
        f1575PowerHodgeTwoPulledWeilSpan hM 2 n :=
  f1575Power_weil_pullback_mem hM 2 _ _

end HodgeLean.Adapters
