import HodgeLean.Adapters.F1575PowersFixProofs

/-! # F-1575 on every power: the span, the multiplicity-one identification, equality (FROZEN SPEC)

This file is the frozen spec for `docs/briefs/f1575-powers-fix.md`. Do not edit it. Each theorem
is proved by the matching `_aux` theorem in `F1575PowersFixProofs.lean`.

The span `f1575PowerHodgeTwoPulledWeilSpan hM m k` is generated by the unit, the rational
degree-two Hodge classes of the `m`-th power, and the pullbacks of the original member's rational
Weil classes along `x ↦ x ⊗ r + Jx ⊗ s`. The degree-two generators are the rational degree-two
Hodge classes; identifying them with divisor classes would need Lefschetz (1,1), which is neither
assumed nor used here. Everything is at the level of `⋀ H¹(V^m)`: no scheme
power, no `HQ(A^m)`, no C7 for `A^m`, no algebraicity.
HC no distance; AV milestone no distance.
-/

noncomputable section
open CategoryTheory AlgebraicGeometry ComplexPoint
open scoped TensorProduct
namespace HodgeLean.Adapters
open RealDefs Foundations Foundations.WeilPower InvariantsExterior

variable {X : Over (Spec ↧ℂ)} [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom]
  {μ : CupProduct X} [GrpObj X]
  {hF : FiniteBetti X} {hB : BettiDeRhamIso X} {hD : HodgeDecomposition X}
  {hT : TorusCohomology μ}
  {A : letI := hT.finite
    HodgeBlocks.WeilAction (abelianVarietyCohomologyOf hF hB hD hT).weight1 3}
  {η : HQ X 2}

/-- **Multiplicity one.** Flattening `⋀^{2p}(H¹ ⊗ ℚ¹)` to `⋀^{2p} H¹` and applying the torus
isomorphism carries the span onto the geometric `divisorWeilSpan` (generated by `1`, `Hdg¹` and
the Weil classes under cup product). No `hSU`. `CupFiltered` (O5) is needed: C7 alone is a
vector-space isomorphism, and O5 makes it match the exterior Hodge classes with `Hdg`.
Source: `divisorWeilSpan` (`RealDefs/WeilClasses.lean`), C7 (`TorusCohomology.cupWedgeEquiv`). -/
theorem f1575PowerOne_map_eq_divisorWeilSpan (hM : IsMemberOfM hF hB hD hT A η)
    (hC : CupFiltered X μ) (p : ℕ) :
    letI := hT.finite
    (f1575PowerHodgeTwoPulledWeilSpan hM 1 (2 * p)).map
      ((hT.cupWedgeEquiv (2 * p)).toLinearMap ∘ₗ exteriorPower.map (2 * p) (powerOneFlatten X)) =
      divisorWeilSpan hF hB hD hT A hM.isWeilType p :=
  f1575PowerOne_map_eq_divisorWeilSpan_aux hM hC p

/-- **The reverse inclusion.** Every element of the span is a rational Hodge class of the power.
No `hSU`.
Source: Weil classes are Hodge (Blocks `isHodgeClass_of_mem_weilClasses`); the pullbacks commute
with the Hodge grading; wedges of Hodge classes are Hodge. -/
theorem f1575PowerHodgeTwoPulledWeilSpan_le_rationalExteriorHodge
    (hM : IsMemberOfM hF hB hD hT A η) (m k : ℕ) :
    letI := hT.finite
    let S := abelianVarietyCohomologyOf hF hB hD hT
    f1575PowerHodgeTwoPulledWeilSpan hM m k ≤
      rationalExteriorHodge S.weight1.H S.weight1.isInternal m k :=
  f1575PowerHodgeTwoPulledWeilSpan_le_rationalExteriorHodge_aux hM m k

/-- **Generation on every power, as an equality**, an implication from `hSU`: the complex Hodge
classes of `⋀^k H¹(V^m)` are exactly the complexified span.
Source: F-1575 / TR54 §3; van Geemen, *An introduction to the Hodge conjecture for abelian
varieties*, §§5–6, with the Hodge-group equality explicit. -/
theorem f1575Power_hodgeClasses_eq_hodgeTwoPulledWeilSpan
    (hM : IsMemberOfM hF hB hD hT A η)
    (hSU : F1575MemberHodgeGroupIsSU hF hB hD hT A hM) (m k : ℕ) :
    letI := hT.finite
    let S := abelianVarietyCohomologyOf hF hB hD hT
    exteriorHodgeClasses S.weight1.H S.weight1.isInternal m k =
      ((f1575PowerHodgeTwoPulledWeilSpan hM m k).baseChange ℂ).map
        (exteriorBaseChange k).toLinearMap :=
  f1575Power_hodgeClasses_eq_hodgeTwoPulledWeilSpan_aux hM hSU m k

/-- **The rational form**, an implication from `hSU`: the rational Hodge classes of
`⋀^k H¹(V^m)` are exactly the span.
Source: as `f1575Power_hodgeClasses_eq_hodgeTwoPulledWeilSpan`. -/
theorem f1575Power_rationalExteriorHodge_eq_hodgeTwoPulledWeilSpan
    (hM : IsMemberOfM hF hB hD hT A η)
    (hSU : F1575MemberHodgeGroupIsSU hF hB hD hT A hM) (m k : ℕ) :
    letI := hT.finite
    let S := abelianVarietyCohomologyOf hF hB hD hT
    rationalExteriorHodge S.weight1.H S.weight1.isInternal m k =
      f1575PowerHodgeTwoPulledWeilSpan hM m k :=
  f1575Power_rationalExteriorHodge_eq_hodgeTwoPulledWeilSpan_aux hM hSU m k

end HodgeLean.Adapters
