import HodgeLean.Adapters.IntersectionProductRatEquivMoving

/-! # Chains on `X × ℙ¹` and their boundaries

Stage A3.3, the degree-one moving lemma. A chain is a rational cycle `Z` on `T = X × ℙ¹`; its
boundary `a3k_bd X Z = Σ_y Z(y) q_*[div (t|_Y)]` (`Y = closure {y}`) sums the cycles
`[Y(0)] − [Y(1)]` of the members dominating `ℙ¹`, the others contributing `0`. The subgroup
`a3k_G X β` is generated by the rational multiples of `q_*[div (t|_Y)]` for the members `Y` in
good position with respect to `β` (`a3o_Good`); `a3o_MovingRatEquiv X` says that every cycle
rationally equivalent to zero that meets `β` properly lies in `a3k_G X β`
(`a3k_movingRatEquiv_iff`).

This file proves the linear algebra: the boundary is additive and `ℚ`-linear, `a3k_G X β` is
stable under rational multiples, and the boundary of a chain whose members are all in good
position lies in `a3k_G X β` (`a3k_bd_mem_G`).

Source: S. Bloch, *The moving lemma for higher Chow groups*, J. Algebraic Geom. 3 (1994),
537–568, §1 (the complex `z^p(X, •)` and its subcomplex `z^p_W(X, •)` in degree one); Fulton,
*Intersection Theory*, second edition, §1.6. HC no distance; AV milestone no distance.
-/

noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Order
open AlgebraicGeometry.ComplexProjectiveSpace HodgeLean.Foundations
open scoped MonoidalCategory

namespace HodgeLean.Adapters

section chain
variable (X : Over (Spec ↧ℂ)) [IsProper X.hom]

open Classical in
/-- The boundary of one member: `q_*[div (t|_Y)] = [Y(0)] − [Y(1)]` for `Y = closure {y}`
dominating `ℙ¹`, and `0` otherwise.
Source: Fulton, *Intersection Theory*, second edition, §1.6; S. Bloch, *The moving lemma for
higher Chow groups* (1994), §1 (the boundary of `z^p(X, 1)`). -/
def a3k_piece (y : (a3n_T X).left) : AlgebraicCycle X.left ℚ :=
  if hy : a3n_h X y = genericPoint (g3c_P 1) then
    a1p_pushforward (a3n_q X).left (a3o_cyc X y hy)
  else 0

example (y : (a3n_T X).left) (hy : a3n_h X y = genericPoint (g3c_P 1)) :
    a3k_piece X y = a1p_pushforward (a3n_q X).left (a3o_cyc X y hy) := by
  unfold a3k_piece
  split_ifs with h
  · rfl
  · exact absurd hy h

theorem a3k_piece_of_dom (y : (a3n_T X).left) (hy : a3n_h X y = genericPoint (g3c_P 1)) :
    a3k_piece X y = a1p_pushforward (a3n_q X).left (a3o_cyc X y hy) := by
  unfold a3k_piece
  split_ifs with h
  · rfl
  · exact absurd hy h

/-- The boundary of a chain `Z` on `X × ℙ¹`: `Σ_y Z(y) q_*[div (t|_Y)]` over the members
dominating `ℙ¹`.
Source: Fulton, *Intersection Theory*, second edition, §1.6 (`Rat_k X` through `X × ℙ¹`);
S. Bloch, *The moving lemma for higher Chow groups* (1994), §1. -/
def a3k_bd (Z : AlgebraicCycle (a3n_T X).left ℚ) : AlgebraicCycle X.left ℚ :=
  ∑ y ∈ (a3m_support_finite Z).toFinset, a3m_smul (Z y) (a3k_piece X y)

example : a3k_bd X 0 = 0 := by
  simp [a3k_bd]

/-- The boundary is a sum over any finite set containing the support. -/
theorem a3k_bd_eq_sum (Z : AlgebraicCycle (a3n_T X).left ℚ) (s : Finset (a3n_T X).left)
    (hs : ∀ y ∉ s, Z y = 0) :
    a3k_bd X Z = ∑ y ∈ s, a3m_smul (Z y) (a3k_piece X y) := by
  classical
  have h0 : ∀ y, a3m_smul 0 (a3k_piece X y) = 0 := fun y => by ext; simp
  rw [a3k_bd, ← Finset.sum_subset (s₁ := (a3m_support_finite Z).toFinset ∩ s)
      Finset.inter_subset_left, ← Finset.sum_subset (s₁ := (a3m_support_finite Z).toFinset ∩ s)
      Finset.inter_subset_right]
  · intro y _ hy
    rw [Finset.mem_inter, not_and_or] at hy
    rcases hy with hy | hy
    · rw [show Z y = 0 by simpa using hy, h0]
    · exact absurd ‹y ∈ s› hy
  · intro y hy hy'
    rw [Finset.mem_inter, not_and_or] at hy'
    rcases hy' with hy' | hy'
    · exact absurd hy hy'
    · rw [hs y hy', h0]

theorem a3k_bd_add (Z Z' : AlgebraicCycle (a3n_T X).left ℚ) :
    a3k_bd X (Z + Z') = a3k_bd X Z + a3k_bd X Z' := by
  classical
  set s := (a3m_support_finite Z).toFinset ∪ (a3m_support_finite Z').toFinset
  have hZ : ∀ y ∉ s, Z y = 0 := fun y hy => by
    simp only [s, Finset.mem_union, Set.Finite.mem_toFinset, Function.mem_support, not_or,
      not_not] at hy
    exact hy.1
  have hZ' : ∀ y ∉ s, Z' y = 0 := fun y hy => by
    simp only [s, Finset.mem_union, Set.Finite.mem_toFinset, Function.mem_support, not_or,
      not_not] at hy
    exact hy.2
  have hZZ : ∀ y ∉ s, (Z + Z') y = 0 := fun y hy => by
    rw [Function.locallyFinsuppWithin.coe_add, Pi.add_apply, hZ y hy, hZ' y hy, add_zero]
  rw [a3k_bd_eq_sum X _ s hZZ, a3k_bd_eq_sum X _ s hZ, a3k_bd_eq_sum X _ s hZ',
    ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun y _ => ?_
  ext x
  simp [add_mul]

theorem a3k_bd_zero : a3k_bd X 0 = 0 := by
  simp [a3k_bd]

theorem a3k_bd_neg (Z : AlgebraicCycle (a3n_T X).left ℚ) : a3k_bd X (-Z) = -a3k_bd X Z := by
  have h := a3k_bd_add X Z (-Z)
  rw [add_neg_cancel, a3k_bd_zero] at h
  exact (neg_eq_of_add_eq_zero_right h.symm).symm

theorem a3k_bd_sub (Z Z' : AlgebraicCycle (a3n_T X).left ℚ) :
    a3k_bd X (Z - Z') = a3k_bd X Z - a3k_bd X Z' := by
  rw [sub_eq_add_neg, a3k_bd_add, a3k_bd_neg, ← sub_eq_add_neg]

theorem a3k_bd_smul (r : ℚ) (Z : AlgebraicCycle (a3n_T X).left ℚ) :
    a3k_bd X (a3m_smul r Z) = a3m_smul r (a3k_bd X Z) := by
  classical
  set s := (a3m_support_finite Z).toFinset
  have hs : ∀ y ∉ s, Z y = 0 := fun y hy => by simpa [s] using hy
  have hs' : ∀ y ∉ s, a3m_smul r Z y = 0 := fun y hy => by rw [a3m_smul_apply, hs y hy, mul_zero]
  rw [a3k_bd_eq_sum X _ s hs', a3k_bd_eq_sum X _ s hs, a3m_smul_sum]
  refine Finset.sum_congr rfl fun y _ => ?_
  ext x
  simp [mul_assoc]

open Classical in
theorem a3k_bd_single (y : (a3n_T X).left) :
    a3k_bd X (Function.locallyFinsuppWithin.single y 1) = a3k_piece X y := by
  classical
  rw [a3k_bd_eq_sum X _ {y} (fun y' hy' => by
    rw [Finset.mem_singleton] at hy'
    simp only [Function.locallyFinsuppWithin.single_apply, ite_eq_right_iff]
    exact fun h => absurd h hy'), Finset.sum_singleton]
  ext x
  simp [Function.locallyFinsuppWithin.single_apply]

end chain

section good
variable (X : Over (Spec ↧ℂ)) [Smooth X.hom] [IsProjective X.hom]

/-- The subgroup generated by the rational multiples of `q_*[div (t|_Y)]` for the members `Y` of
`X × ℙ¹` dominating `ℙ¹` in good position with respect to `β` (`a3o_Good`): the image of
`z^p_W(X, 1)` under the boundary.
Source: S. Bloch, *The moving lemma for higher Chow groups*, J. Algebraic Geom. 3 (1994), §1
(the subcomplex `z^p_W(X, •)`). -/
def a3k_G (β : AlgebraicCycle X.left ℚ) : AddSubgroup (AlgebraicCycle X.left ℚ) :=
  AddSubgroup.closure {c | ∃ (y : (a3n_T X).left)
    (hy : a3n_h X y = genericPoint (g3c_P 1)) (r : ℚ), a3o_Good X β y hy ∧
      c = a3m_smul r (a1p_pushforward (a3n_q X).left (a3o_cyc X y hy))}

example (β : AlgebraicCycle X.left ℚ) : (0 : AlgebraicCycle X.left ℚ) ∈ a3k_G X β :=
  zero_mem _

theorem a3k_movingRatEquiv_iff : a3o_MovingRatEquiv X ↔
    ∀ γ β : AlgebraicCycle X.left ℚ, γ ∈ a3i_ratAll X.left →
      a3i_CyclesMeetProperly X.left γ β → γ ∈ a3k_G X β :=
  Iff.rfl

/-- `a3k_G X β` is stable under rational multiples. -/
theorem a3k_smul_mem_G (β : AlgebraicCycle X.left ℚ) (r : ℚ) {c : AlgebraicCycle X.left ℚ}
    (hc : c ∈ a3k_G X β) : a3m_smul r c ∈ a3k_G X β := by
  change c ∈ (a3k_G X β).comap (a3m_smulHom X.left r)
  refine (AddSubgroup.closure_le _).2 ?_ hc
  rintro _ ⟨y, hy, r', hgood, rfl⟩
  refine AddSubgroup.subset_closure ⟨y, hy, r * r', hgood, ?_⟩
  ext x
  simp [a3m_smulHom, mul_assoc]

theorem a3k_piece_mem_G (β : AlgebraicCycle X.left ℚ) (y : (a3n_T X).left)
    (hgood : ∀ hy : a3n_h X y = genericPoint (g3c_P 1), a3o_Good X β y hy) :
    a3k_piece X y ∈ a3k_G X β := by
  by_cases hy : a3n_h X y = genericPoint (g3c_P 1)
  · rw [a3k_piece_of_dom X y hy]
    refine AddSubgroup.subset_closure ⟨y, hy, 1, hgood hy, ?_⟩
    ext x
    simp
  · simp only [a3k_piece, hy, dite_false]
    exact zero_mem _

/-- The boundary of a chain whose members are in good position lies in `a3k_G X β`. -/
theorem a3k_bd_mem_G (β : AlgebraicCycle X.left ℚ) (Z : AlgebraicCycle (a3n_T X).left ℚ)
    (hZ : ∀ y, Z y ≠ 0 → ∀ hy : a3n_h X y = genericPoint (g3c_P 1), a3o_Good X β y hy) :
    a3k_bd X Z ∈ a3k_G X β := by
  refine AddSubgroup.sum_mem _ fun y hy => a3k_smul_mem_G X β _ (a3k_piece_mem_G X β y ?_)
  exact hZ y (by simpa using hy)

end good

end HodgeLean.Adapters
