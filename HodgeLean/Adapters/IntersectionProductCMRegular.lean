import Mathlib.RingTheory.RegularLocalRing.Defs
import Mathlib.RingTheory.Regular.RegularSequence
import Mathlib.RingTheory.Ideal.MinimalPrime.Noetherian
import Mathlib.RingTheory.Ideal.KrullsHeightTheorem
import Mathlib.Algebra.Module.SpanRankOperations

/-! # Regular local rings: regular systems of parameters are regular sequences

For a Noetherian local ring `R` of dimension `n` whose maximal ideal is generated by a list `ys`
of `n` elements, this file shows that `R` is a domain and that `ys` is a weakly regular sequence
(`a3c_isDomain_isWeaklyRegular`). The proof is the induction of Matsumura, Theorem 14.3: prime
avoidance gives `x ∈ 𝔪 \ 𝔪²` outside every minimal prime; `R ⧸ (x)` is again regular of dimension
`n - 1`, hence a domain, and Nakayama's lemma kills the minimal prime contained in `(x)`. The
cotangent space `𝔪/𝔪²` is used to produce generators (`a3c_exists_list_sup_eq`).

Source: Matsumura, *Commutative Ring Theory*, Theorem 14.3 (a regular local ring is a domain)
and Theorem 17.8 (a regular system of parameters is a regular sequence); Serre,
*Algèbre locale, multiplicités*, Chapitre IV, D. HC no distance; AV milestone no distance.
-/

noncomputable section
open IsLocalRing

namespace HodgeLean.Adapters
universe u

section gen
variable {R : Type u} [CommRing R] [IsLocalRing R] [IsNoetherianRing R]

/-- The subspace of the cotangent space `𝔪/𝔪²` spanned by the classes of the elements of `I`. -/
def a3c_cotSub (I : Ideal R) : Submodule (ResidueField R) (CotangentSpace R) :=
  Submodule.span (ResidueField R)
    ((maximalIdeal R).toCotangent '' {x : maximalIdeal R | (x : R) ∈ I})

/-- Complementing an ideal `I ⊆ 𝔪` to the maximal ideal: `dim (𝔪/𝔪²)/P` further elements
suffice, where `P` is the span of the classes of `I`. -/
theorem a3c_exists_list_sup_eq (I : Ideal R) (hI : I ≤ maximalIdeal R) :
    ∃ zs : List R, zs.length =
        Module.finrank (ResidueField R) (CotangentSpace R ⧸ a3c_cotSub I) ∧
      (∀ z ∈ zs, z ∈ maximalIdeal R) ∧ I ⊔ Ideal.ofList zs = maximalIdeal R := by
  set k := ResidueField R
  set V := CotangentSpace R
  set P := a3c_cotSub I
  let b := Module.finBasis k (V ⧸ P)
  have hv : ∀ i, ∃ v : V, P.mkQ v = b i := fun i => P.mkQ_surjective _
  choose v hv using hv
  have hz : ∀ i, ∃ z : maximalIdeal R, (maximalIdeal R).toCotangent z = v i :=
    fun i => (maximalIdeal R).toCotangent_surjective _
  choose z hz using hz
  have hmem : ∀ w ∈ List.ofFn (fun i => (z i : R)), w ∈ maximalIdeal R := by
    intro w hw
    obtain ⟨i, rfl⟩ := List.mem_ofFn.mp hw
    exact (z i).2
  refine ⟨List.ofFn (fun i => (z i : R)), by rw [List.length_ofFn], hmem, ?_⟩
  refine le_antisymm (sup_le hI (Ideal.span_le.mpr hmem)) ?_
  let S : Set (maximalIdeal R) := {x | (x : R) ∈ I} ∪ Set.range z
  have hspan : Submodule.span k ((maximalIdeal R).toCotangent '' S) = ⊤ := by
    have h1 : P ≤ Submodule.span k ((maximalIdeal R).toCotangent '' S) :=
      Submodule.span_mono (Set.image_mono Set.subset_union_left)
    have h2 : Submodule.span k (Set.range v) ≤
        Submodule.span k ((maximalIdeal R).toCotangent '' S) := by
      rw [Submodule.span_le]
      rintro _ ⟨i, rfl⟩
      exact Submodule.subset_span ⟨z i, Or.inr ⟨i, rfl⟩, hz i⟩
    have h3 : P ⊔ Submodule.span k (Set.range v) = ⊤ := by
      rw [← Submodule.map_mkQ_eq_top, Submodule.map_span, ← Set.range_comp]
      have : (P.mkQ ∘ v) = b := funext hv
      rw [this, b.span_eq]
    exact eq_top_iff.mpr (h3 ▸ sup_le h1 h2)
  rw [IsLocalRing.CotangentSpace.span_image_eq_top_iff] at hspan
  intro m hm
  have hm' : (⟨m, hm⟩ : maximalIdeal R) ∈ Submodule.span R S := hspan ▸ Submodule.mem_top
  have hmap := Submodule.mem_map_of_mem (f := (maximalIdeal R).subtype) hm'
  rw [Submodule.map_span] at hmap
  refine (Submodule.span_le.mpr ?_) hmap
  rintro _ ⟨x, hx | ⟨i, rfl⟩, rfl⟩
  · exact Ideal.mem_sup_left hx
  · exact Ideal.mem_sup_right (Ideal.subset_span (List.mem_ofFn.mpr ⟨i, rfl⟩))

/-- The cotangent space has dimension at most the length of any generating list of `𝔪`. -/
theorem a3c_finrank_cotangentSpace_le (ys : List R) (hys : Ideal.ofList ys = maximalIdeal R) :
    Module.finrank (ResidueField R) (CotangentSpace R) ≤ ys.length := by
  classical
  rw [← spanFinrank_maximalIdeal_eq_finrank_cotangentSpace, ← hys]
  refine (Submodule.spanFinrank_span_le_ncard_of_finite (List.finite_toSet ys)).trans ?_
  have : {r | r ∈ ys} = (ys.toFinset : Set R) := by ext; simp
  rw [this, Set.ncard_coe_finset]
  exact List.toFinset_card_le ys

/-- `ringKrullDim R ≤ length ys` when `ys` generates the maximal ideal. -/
theorem a3c_ringKrullDim_le_length (ys : List R) (hys : Ideal.ofList ys = maximalIdeal R) :
    ringKrullDim R ≤ ys.length := by
  refine (ringKrullDim_le_spanFinrank_maximalIdeal R).trans ?_
  rw [spanFinrank_maximalIdeal_eq_finrank_cotangentSpace]
  exact_mod_cast a3c_finrank_cotangentSpace_le ys hys

omit [IsLocalRing R] [IsNoetherianRing R] in
lemma a3c_ofList_replicate_zero (m : ℕ) : Ideal.ofList (List.replicate m (0 : R)) = ⊥ := by
  rw [Ideal.ofList, Ideal.span_eq_bot]
  intro r hr
  exact List.eq_of_mem_replicate hr

/-- An element of `𝔪 \ 𝔪²` is part of a generating list of the maximal ideal of the minimal
length `n + 1`. -/
theorem a3c_exists_list_of_not_mem_sq (n : ℕ) (ys : List R) (hlen : ys.length = n + 1)
    (hys : Ideal.ofList ys = maximalIdeal R) (x : R) (hx : x ∈ maximalIdeal R)
    (hx2 : x ∉ maximalIdeal R ^ 2) :
    ∃ zs : List R, zs.length = n ∧ Ideal.span {x} ⊔ Ideal.ofList zs = maximalIdeal R := by
  obtain ⟨zs, hzlen, -, hzs⟩ := a3c_exists_list_sup_eq (Ideal.span {x})
    ((Ideal.span_singleton_le_iff_mem _).mpr hx)
  have hsum := Submodule.finrank_quotient_add_finrank (a3c_cotSub (Ideal.span {x}))
  have hV := a3c_finrank_cotangentSpace_le ys hys
  have hpos : 0 < Module.finrank (ResidueField R) (a3c_cotSub (Ideal.span {x})) := by
    refine Module.finrank_pos_iff_exists_ne_zero.mpr
      ⟨⟨(maximalIdeal R).toCotangent ⟨x, hx⟩, Submodule.subset_span
        ⟨⟨x, hx⟩, Ideal.mem_span_singleton_self x, rfl⟩⟩, ?_⟩
    intro h
    apply hx2
    rw [← (maximalIdeal R).toCotangent_eq_zero ⟨x, hx⟩]
    exact congrArg Subtype.val h
  refine ⟨zs ++ List.replicate (n - zs.length) 0, by simp; omega, ?_⟩
  rw [Ideal.ofList_append, a3c_ofList_replicate_zero, sup_bot_eq, hzs]

end gen

lemma a3c_le_of_succ_le {a : WithBot ℕ∞} {n : ℕ} (h : ((n + 1 : ℕ) : WithBot ℕ∞) ≤ a + 1) :
    (n : WithBot ℕ∞) ≤ a := by
  induction a using WithBot.recBotCoe with
  | bot => simp at h
  | coe d =>
    have h' : ((n + 1 : ℕ) : ℕ∞) ≤ d + 1 := by exact_mod_cast h
    have : (n : ℕ∞) ≤ d := by
      rw [Nat.cast_add, Nat.cast_one] at h'
      exact (ENat.add_le_add_iff_right ENat.one_ne_top).mp h'
    exact_mod_cast this

/-- In a Noetherian local ring of dimension `n` whose maximal ideal is generated by a list `ys` of
length `n`, the ring is a domain and `ys` is a weakly regular sequence.
Source: Matsumura, *Commutative Ring Theory*, Theorems 14.3 and 17.8. -/
theorem a3c_isDomain_isWeaklyRegular : ∀ (n : ℕ) (R : Type u) [CommRing R] [IsLocalRing R]
    [IsNoetherianRing R], ringKrullDim R = n → ∀ ys : List R, ys.length = n →
      Ideal.ofList ys = maximalIdeal R → IsDomain R ∧ RingTheory.Sequence.IsWeaklyRegular R ys
  | 0, R, _, _, _, _, ys, hlen, hys => by
    rw [List.length_eq_zero_iff] at hlen
    subst hlen
    rw [Ideal.ofList_nil, eq_comm, ← isField_iff_maximalIdeal_eq] at hys
    let := hys.toField
    exact ⟨inferInstance, RingTheory.Sequence.IsWeaklyRegular.nil R R⟩
  | n + 1, R, _, _, _, hdim, ys, hlen, hys => by
    -- the maximal ideal is not minimal and is not idempotent
    have hm2 : ¬ maximalIdeal R ≤ maximalIdeal R ^ 2 := by
      intro h
      have hbot : maximalIdeal R = ⊥ := Submodule.eq_bot_of_le_smul_of_le_jacobson_bot
        (maximalIdeal R) (maximalIdeal R) (maximalIdeal R).fg_of_isNoetherianRing
        (by rwa [smul_eq_mul, ← pow_two])
        (by rw [IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top])
      rw [ringKrullDim_eq_zero_of_isField ((isField_iff_maximalIdeal_eq).mpr hbot)] at hdim
      exact absurd hdim (by norm_cast)
    have hmin : ∀ p ∈ minimalPrimes R, ¬ maximalIdeal R ≤ p := by
      intro p hp h
      have hpm : p = maximalIdeal R := le_antisymm (IsLocalRing.le_maximalIdeal hp.1.1.ne_top) h
      have hh : (maximalIdeal R).height = 0 := by
        rw [← hpm]
        have : p.IsPrime := hp.1.1
        exact Ideal.height_eq_zero_iff.mpr hp
      rw [← IsLocalRing.maximalIdeal_height_eq_ringKrullDim, hh] at hdim
      exact absurd hdim (by norm_cast)
    -- prime avoidance
    obtain ⟨x, hxm, hx2, hxp⟩ : ∃ x ∈ maximalIdeal R, x ∉ maximalIdeal R ^ 2 ∧
        ∀ p ∈ minimalPrimes R, x ∉ p := by
      by_contra hcon
      push Not at hcon
      have hfin := minimalPrimes.finite_of_isNoetherianRing R
      have hsub : ((maximalIdeal R : Set R) ⊆ (fun I : Ideal R => I) (maximalIdeal R ^ 2) ∪
          (fun I : Ideal R => I) (maximalIdeal R ^ 2) ∪
          ⋃ i ∈ (↑hfin.toFinset : Set (Ideal R)), (fun I : Ideal R => I) i) := by
        intro x hx
        by_cases h2 : x ∈ maximalIdeal R ^ 2
        · exact Or.inl (Or.inl h2)
        · obtain ⟨p, hp, hxp⟩ := hcon x hx h2
          exact Or.inr (Set.mem_biUnion (by simpa using hp) hxp)
      rcases (Ideal.subset_union_prime' (fun i hi => (hfin.mem_toFinset.mp hi).1.1)).mp hsub with
        h | h | ⟨p, hp, h⟩
      · exact hm2 h
      · exact hm2 h
      · exact hmin p (hfin.mem_toFinset.mp hp) h
    -- the quotient by `x` is regular of dimension `n`
    obtain ⟨zs, hzlen, hzs⟩ := a3c_exists_list_of_not_mem_sq n ys hlen hys x hxm hx2
    have hxtop : Ideal.span {x} ≠ ⊤ := fun h => by
      rw [Ideal.span_singleton_eq_top] at h
      exact (IsLocalRing.mem_maximalIdeal x).mp hxm h
    have : Nontrivial (R ⧸ Ideal.span {x}) := Ideal.Quotient.nontrivial_iff.mpr hxtop
    have : IsLocalRing (R ⧸ Ideal.span {x}) := .of_surjective' _ Ideal.Quotient.mk_surjective
    have hmx : Ideal.ofList (zs.map (Ideal.Quotient.mk (Ideal.span {x}))) =
        maximalIdeal (R ⧸ Ideal.span {x}) := by
      rw [← Ideal.map_ofList, ← IsLocalRing.map_maximalIdeal_of_surjective _
        Ideal.Quotient.mk_surjective, ← hzs, Ideal.map_sup, Ideal.map_quotient_self, bot_sup_eq]
    have hdimx : ringKrullDim (R ⧸ Ideal.span {x}) = n := by
      refine le_antisymm ?_ ?_
      · simpa [hzlen] using a3c_ringKrullDim_le_length _ hmx
      · have h := ringKrullDim_le_ringKrullDim_quotient_add_spanFinrank (Ideal.span {x})
          (by rw [IsLocalRing.ringJacobson_eq_maximalIdeal]
              exact (Ideal.span_singleton_le_iff_mem _).mpr hxm)
        have h1 : (Ideal.span {x}).spanFinrank ≤ 1 := by
          simpa using Submodule.spanFinrank_span_le_ncard_of_finite (Set.finite_singleton x)
        rw [hdim] at h
        have h2 : ((n + 1 : ℕ) : WithBot ℕ∞) ≤ ringKrullDim (R ⧸ Ideal.span {x}) + 1 :=
          h.trans (by gcongr; exact_mod_cast h1)
        exact a3c_le_of_succ_le h2
    obtain ⟨hdomx, -⟩ := a3c_isDomain_isWeaklyRegular n (R ⧸ Ideal.span {x}) hdimx _
      (by simpa using hzlen) hmx
    have hxprime : (Ideal.span {x}).IsPrime := (Ideal.Quotient.isDomain_iff_prime _).mp hdomx
    -- `R` is a domain
    obtain ⟨p, hp, hpx⟩ := Ideal.exists_minimalPrimes_le (I := ⊥) (J := Ideal.span {x}) bot_le
    have hpbot : p = ⊥ := by
      have : p.IsPrime := hp.1.1
      refine Submodule.eq_bot_of_le_smul_of_le_jacobson_bot (maximalIdeal R) p
        p.fg_of_isNoetherianRing ?_
        (by rw [IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top])
      intro a ha
      obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp (hpx ha)
      have hc : c ∈ p := (Ideal.IsPrime.mem_or_mem ‹_› ha).resolve_right (hxp p hp)
      rw [mul_comm]
      exact Submodule.smul_mem_smul hxm hc
    have : (⊥ : Ideal R).IsPrime := hpbot ▸ hp.1.1
    have hdom : IsDomain R := IsDomain.of_bot_isPrime R
    refine ⟨hdom, ?_⟩
    -- `ys` is weakly regular
    obtain ⟨y, ys', rfl⟩ : ∃ y ys', ys = y :: ys' := List.exists_cons_of_length_eq_add_one hlen
    have hym : y ∈ maximalIdeal R := hys ▸ Ideal.subset_span (List.mem_cons_self)
    have hy0 : y ≠ 0 := by
      rintro rfl
      have h := a3c_ringKrullDim_le_length ys' (by
        rw [← hys, Ideal.ofList_cons, Ideal.span_singleton_eq_bot.mpr rfl, bot_sup_eq])
      rw [hdim] at h
      simp only [List.length_cons, add_left_inj] at hlen
      rw [hlen] at h
      exact absurd h (by norm_cast; omega)
    have hytop : Ideal.span {y} ≠ ⊤ := fun h => by
      rw [Ideal.span_singleton_eq_top] at h
      exact (IsLocalRing.mem_maximalIdeal y).mp hym h
    have : Nontrivial (R ⧸ Ideal.span {y}) := Ideal.Quotient.nontrivial_iff.mpr hytop
    have : IsLocalRing (R ⧸ Ideal.span {y}) := .of_surjective' _ Ideal.Quotient.mk_surjective
    have hmy : Ideal.ofList (ys'.map (Ideal.Quotient.mk (Ideal.span {y}))) =
        maximalIdeal (R ⧸ Ideal.span {y}) := by
      rw [← Ideal.map_ofList, ← IsLocalRing.map_maximalIdeal_of_surjective _
        Ideal.Quotient.mk_surjective, ← hys, Ideal.ofList_cons, Ideal.map_sup,
        Ideal.map_quotient_self, bot_sup_eq]
    have hlen' : ys'.length = n := by simpa using hlen
    have hdimy : ringKrullDim (R ⧸ Ideal.span {y}) = n := by
      refine le_antisymm ?_ ?_
      · simpa [hlen'] using a3c_ringKrullDim_le_length _ hmy
      · have h := ringKrullDim_le_ringKrullDim_quotient_add_spanFinrank (Ideal.span {y})
          (by rw [IsLocalRing.ringJacobson_eq_maximalIdeal]
              exact (Ideal.span_singleton_le_iff_mem _).mpr hym)
        have h1 : (Ideal.span {y}).spanFinrank ≤ 1 := by
          simpa using Submodule.spanFinrank_span_le_ncard_of_finite (Set.finite_singleton y)
        rw [hdim] at h
        have h2 : ((n + 1 : ℕ) : WithBot ℕ∞) ≤ ringKrullDim (R ⧸ Ideal.span {y}) + 1 :=
          h.trans (by gcongr; exact_mod_cast h1)
        exact a3c_le_of_succ_le h2
    obtain ⟨-, hregy⟩ := a3c_isDomain_isWeaklyRegular n (R ⧸ Ideal.span {y}) hdimy _
      (by simpa using hlen') hmy
    have hmap : ys'.map (Ideal.Quotient.mk (Ideal.span {y})) =
        ys'.map (algebraMap R (R ⧸ Ideal.span {y})) := rfl
    rw [hmap, RingTheory.Sequence.isWeaklyRegular_map_algebraMap_iff] at hregy
    rw [RingTheory.Sequence.isWeaklyRegular_cons_iff]
    refine ⟨(IsRegular.of_ne_zero hy0).isSMulRegular, ?_⟩
    have e : QuotSMulTop y R ≃ₗ[R] R ⧸ Ideal.span {y} :=
      Submodule.quotEquivOfEq _ _ (by
        ext a
        simp [Submodule.mem_smul_pointwise_iff_exists, Ideal.mem_span_singleton', mul_comm])
    exact (e.isWeaklyRegular_congr ys').mpr hregy

end HodgeLean.Adapters
