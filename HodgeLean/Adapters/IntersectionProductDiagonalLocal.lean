import HodgeLean.Adapters.IntersectionProductDiagonalTor
import HodgeLean.Adapters.IntersectionProductSerreVanishing
import HodgeLean.Adapters.IntersectionProductMovingDiagonal

/-! # The diagonal at a point: the local ring `B = (S ⊗_k S)_{μ⁻¹(R)}`

Let `k` be a field, `S` a `k`-algebra, `μ : S ⊗_k S → S` the multiplication and `R` a prime of
`S`. This file studies the local ring `B` of `S ⊗_k S` at the point `(R, R)` of the diagonal:
* `μ` induces a surjection `π : B → S_R` with kernel generated by `ker μ`
  (`a3v_pi_surjective`, `a3v_ker_pi`);
* a module over `S ⊗_k S` killed by `ker μ` has the same localized length at `μ⁻¹(R)` as its
  restriction to `S` has at `R` (`a3v_locLen_eq`);
* if `S` is étale over `k[x_1, …, x_d]`, the `d` elements `x_i ⊗ 1 - 1 ⊗ x_i` generate `ker μ` in
  `B` (`a3v_ofList_xs`); if moreover `k` is algebraically closed and `S` is a domain of finite type
  and dimension `d`, then `ht μ⁻¹(R) = d + ht R` (`a3v_height_M`) and the `x_i ⊗ 1 - 1 ⊗ x_i` form
  a weakly regular sequence in the maximal ideal of `B` (`a3v_xs_isWeaklyRegular`): with lifts of a
  regular system of parameters of the regular local ring `S_R` they generate the maximal ideal of
  `B`, and their number is `dim B`.

Source: Serre, *Algèbre locale, multiplicités*, Chapitre V, B.3 (réduction à la diagonale) and
Chapitre IV, D (regular local rings); Matsumura, *Commutative Ring Theory*, Theorem 14.2 and
Theorem 17.4. HC no distance; AV milestone no distance.
-/

open CategoryTheory CategoryTheory.Limits MonoidalCategory TensorProduct IsLocalRing

set_option backward.isDefEq.respectTransparency false

noncomputable section
namespace HodgeLean.Adapters

section diagLoc
variable (k : Type) [Field k] (S : Type) [CommRing S] [Algebra k S] (R : Ideal S) [R.IsPrime]

/-- The prime `μ⁻¹(R)` of `S ⊗_k S`: the point `(R, R)` of the diagonal. -/
abbrev a3v_M : Ideal (S ⊗[k] S) := R.comap (a3d_mu k S)

instance : (a3v_M k S R).IsPrime := Ideal.comap_isPrime _ _

/-- The local ring `B = (S ⊗_k S)_{μ⁻¹(R)}`. -/
abbrev a3v_B : Type := Localization.AtPrime (a3v_M k S R)

/-- `B → S_R`, induced by the multiplication. -/
abbrev a3v_pi : a3v_B k S R →+* Localization.AtPrime R :=
  Localization.localRingHom (a3v_M k S R) R (a3d_mu k S) rfl

theorem a3v_mu_inl (s : S) : a3d_mu k S (algebraMap S (S ⊗[k] S) s) = s := by
  simp

theorem a3v_pi_surjective : Function.Surjective (a3v_pi k S R) := by
  intro y
  obtain ⟨s, u, rfl⟩ := IsLocalization.exists_mk'_eq R.primeCompl y
  have hu : algebraMap S (S ⊗[k] S) u ∈ (a3v_M k S R).primeCompl := by
    change a3d_mu k S (algebraMap S (S ⊗[k] S) u) ∉ R
    rw [a3v_mu_inl]; exact u.2
  refine ⟨IsLocalization.mk' _ (algebraMap S (S ⊗[k] S) s) ⟨_, hu⟩, ?_⟩
  rw [Localization.localRingHom_mk']
  congr 1
  · exact a3v_mu_inl k S s
  · exact Subtype.ext (a3v_mu_inl k S u)

theorem a3v_ker_pi : RingHom.ker (a3v_pi k S R) =
    (RingHom.ker (a3d_mu k S)).map (algebraMap (S ⊗[k] S) (a3v_B k S R)) := by
  apply le_antisymm
  · intro b hb
    obtain ⟨a, v, rfl⟩ := IsLocalization.exists_mk'_eq (a3v_M k S R).primeCompl b
    rw [RingHom.mem_ker, Localization.localRingHom_mk', IsLocalization.mk'_eq_zero_iff] at hb
    obtain ⟨⟨u, hu⟩, hu0⟩ := hb
    have hmem : algebraMap S (S ⊗[k] S) u * a ∈ RingHom.ker (a3d_mu k S) := by
      rw [RingHom.mem_ker, map_mul, a3v_mu_inl]; exact hu0
    have hu' : algebraMap S (S ⊗[k] S) u ∈ (a3v_M k S R).primeCompl := by
      change a3d_mu k S (algebraMap S (S ⊗[k] S) u) ∉ R
      rw [a3v_mu_inl]; exact hu
    have : IsLocalization.mk' (a3v_B k S R) a v =
        algebraMap (S ⊗[k] S) (a3v_B k S R) (algebraMap S (S ⊗[k] S) u * a) *
          IsLocalization.mk' (a3v_B k S R) (1 : S ⊗[k] S) (⟨_, hu'⟩ * v) := by
      rw [← IsLocalization.mk'_one (M := (a3v_M k S R).primeCompl), ← IsLocalization.mk'_mul,
        one_mul, mul_one, IsLocalization.mk'_eq_iff_eq]
      simp only [Submonoid.coe_mul]
      ring_nf
    rw [this]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ hmem)
  · rw [Ideal.map_le_iff_le_comap]
    intro a ha
    rw [Ideal.mem_comap, RingHom.mem_ker, Localization.localRingHom_to_map, RingHom.mem_ker.1 ha,
      map_zero]

/-- A module over `S ⊗_k S` killed by the kernel of the multiplication has the same localized
length at `μ⁻¹(R)` as its restriction to `S` (through the left factor) has at `R`. -/
theorem a3v_locLen_eq (F : ModuleCat.{0} (S ⊗[k] S))
    (hF : ∀ a ∈ RingHom.ker (a3d_mu k S), ∀ f : F, a • f = 0) :
    a3e_locLen ⟨a3v_M k S R, inferInstance⟩ F =
      a3e_locLen ⟨R, inferInstance⟩ ((ModuleCat.restrictScalars (algebraMap S (S ⊗[k] S))).obj F) := by
  let G := (ModuleCat.restrictScalars (algebraMap S (S ⊗[k] S))).obj F
  let X := LocalizedModule R.primeCompl G
  let : Module (a3v_B k S R) X := Module.compHom X (a3v_pi k S R)
  let : Module (S ⊗[k] S) X :=
    Module.compHom X ((a3v_pi k S R).comp (algebraMap (S ⊗[k] S) (a3v_B k S R)))
  have : IsScalarTower (S ⊗[k] S) (a3v_B k S R) X := ⟨fun t b x => by
    change a3v_pi k S R (t • b) • x = a3v_pi k S R (algebraMap _ (a3v_B k S R) t) •
      a3v_pi k S R b • x
    rw [Algebra.smul_def, map_mul, mul_smul]⟩
  have hact : ∀ (t : S ⊗[k] S) (f : F), t • f = algebraMap S (S ⊗[k] S) (a3d_mu k S t) • f := by
    intro t f
    have h := hF (t - algebraMap S (S ⊗[k] S) (a3d_mu k S t)) (by
      rw [RingHom.mem_ker, map_sub, a3v_mu_inl, sub_self]) f
    rwa [sub_smul, sub_eq_zero] at h
  have hpi : ∀ t : S ⊗[k] S, a3v_pi k S R (algebraMap _ (a3v_B k S R) t) =
      algebraMap S (Localization.AtPrime R) (a3d_mu k S t) := fun t =>
    Localization.localRingHom_to_map _ _ _ _ t
  let g : F →ₗ[S ⊗[k] S] X :=
    { toFun := fun f => LocalizedModule.mkLinearMap R.primeCompl G f
      map_add' := fun f f' => map_add (LocalizedModule.mkLinearMap R.primeCompl G) f f'
      map_smul' := fun t f => by
        rw [RingHom.id_apply]
        calc LocalizedModule.mkLinearMap R.primeCompl G (t • f)
            = LocalizedModule.mkLinearMap R.primeCompl G
                (a3d_mu k S t • (show G from f)) := by rw [hact]; rfl
          _ = a3d_mu k S t • LocalizedModule.mkLinearMap R.primeCompl G f := map_smul _ _ _
          _ = _ := by
            change _ = a3v_pi k S R (algebraMap _ (a3v_B k S R) t) •
              (LocalizedModule.mkLinearMap R.primeCompl G f : X)
            rw [hpi, algebraMap_smul] }
  have hinl : ∀ u : R.primeCompl,
      algebraMap S (S ⊗[k] S) u ∈ (a3v_M k S R).primeCompl := fun u => by
    change a3d_mu k S (algebraMap S (S ⊗[k] S) u) ∉ R
    rw [a3v_mu_inl]; exact u.2
  have hsmulX : ∀ (t : S ⊗[k] S) (x : X), t • x = a3d_mu k S t • x := fun t x => by
    change a3v_pi k S R (algebraMap _ (a3v_B k S R) t) • x = _
    rw [hpi, algebraMap_smul]
  have : IsLocalizedModule (a3v_M k S R).primeCompl g := by
    constructor
    · rintro ⟨t, ht⟩
      have hu : a3d_mu k S t ∈ R.primeCompl := ht
      have hb := (Module.End.isUnit_iff _).1
        (IsLocalizedModule.map_units (LocalizedModule.mkLinearMap R.primeCompl G) ⟨_, hu⟩)
      rw [Module.End.isUnit_iff]
      convert hb using 1
      funext x
      exact hsmulX t x
    · intro y
      induction y using LocalizedModule.induction_on with
      | h m u =>
        refine ⟨(m, ⟨_, hinl u⟩), ?_⟩
        change algebraMap S (S ⊗[k] S) u • LocalizedModule.mk m u = LocalizedModule.mk m 1
        rw [hsmulX, a3v_mu_inl, LocalizedModule.smul'_mk, ← Submonoid.smul_def,
          LocalizedModule.mk_cancel]
    · intro f f' h
      obtain ⟨u, hu⟩ := LocalizedModule.mk_eq.1 h
      refine ⟨⟨_, hinl u⟩, ?_⟩
      simp only [one_smul] at hu
      change algebraMap S (S ⊗[k] S) u • f = algebraMap S (S ⊗[k] S) u • f'
      exact hu
  have h1 := a3q_locLen_eq_length (A := S ⊗[k] S) (B := a3v_B k S R)
    ⟨a3v_M k S R, inferInstance⟩ F X g
  rw [h1]
  let : Algebra (a3v_B k S R) (Localization.AtPrime R) := (a3v_pi k S R).toAlgebra
  have : IsScalarTower (a3v_B k S R) (Localization.AtPrime R) X := ⟨fun b r x => by
    change (a3v_pi k S R b * r) • x = a3v_pi k S R b • (r • x)
    rw [mul_smul]⟩
  exact Module.length_eq_of_surjective (a3v_pi_surjective k S R)

end diagLoc
section etale
variable (k : Type) [Field k] {S : Type} [CommRing S] [Algebra k S] (d : ℕ)
  [Algebra (MvPolynomial (Fin d) k) S] [IsScalarTower k (MvPolynomial (Fin d) k) S]
  [Algebra.Etale (MvPolynomial (Fin d) k) S] (R : Ideal S) [R.IsPrime]

/-- The coordinate differences `x_i ⊗ 1 - 1 ⊗ x_i` in `B`. -/
def a3v_xs : List (a3v_B k S R) :=
  List.ofFn fun i : Fin d => algebraMap (S ⊗[k] S) (a3v_B k S R)
    (algebraMap (MvPolynomial (Fin d) k) S (MvPolynomial.X i) ⊗ₜ[k] (1 : S) -
      (1 : S) ⊗ₜ[k] algebraMap (MvPolynomial (Fin d) k) S (MvPolynomial.X i))

omit [IsScalarTower k (MvPolynomial (Fin d) k) S] [Algebra.Etale (MvPolynomial (Fin d) k) S] in
theorem a3v_xs_length : (a3v_xs k d R).length = d := by simp [a3v_xs]

/-- The coordinate differences generate the diagonal ideal in `B`. -/
theorem a3v_ofList_xs : Ideal.ofList (a3v_xs k d R) =
    (RingHom.ker (a3d_mu k S)).map (algebraMap (S ⊗[k] S) (a3v_B k S R)) := by
  set J := a3m_diagIdeal k (MvPolynomial (Fin d) k) S (Set.range MvPolynomial.X)
  have hJ : Ideal.ofList (a3v_xs k d R) = J.map (algebraMap (S ⊗[k] S) (a3v_B k S R)) := by
    simp only [J, a3m_diagIdeal, Ideal.ofList, Ideal.map_span]
    congr 1
    ext b
    simp [a3v_xs, List.mem_ofFn]
  rw [hJ]
  obtain ⟨t, ht1, htJ⟩ := a3m_exists_diag_elem (k := k) (P := MvPolynomial (Fin d) k) (S := S)
    (MvPolynomial.adjoin_range_X (R := k) (σ := Fin d))
  apply le_antisymm
  · refine Ideal.map_mono (Ideal.span_le.2 ?_)
    rintro _ ⟨p, -, rfl⟩
    simp [RingHom.mem_ker, Algebra.TensorProduct.lmul'_apply_tmul]
  · rw [Ideal.map_le_iff_le_comap]
    intro a ha
    have htu : IsUnit (algebraMap (S ⊗[k] S) (a3v_B k S R) t) := by
      refine IsLocalization.map_units (a3v_B k S R) (⟨t, ?_⟩ : (a3v_M k S R).primeCompl)
      change a3d_mu k S t ∉ R
      rw [show a3d_mu k S t = 1 from ht1]
      exact R.ne_top_iff_one.1 (Ideal.IsPrime.ne_top ‹_›)
    rw [Ideal.mem_comap]
    obtain ⟨u, hu⟩ := htu.exists_right_inv
    have : algebraMap (S ⊗[k] S) (a3v_B k S R) a =
        algebraMap (S ⊗[k] S) (a3v_B k S R) (a * t) * u := by
      rw [map_mul, mul_assoc, hu, mul_one]
    rw [this]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ (htJ a ha))

omit [Algebra (MvPolynomial (Fin d) k) S] [IsScalarTower k (MvPolynomial (Fin d) k) S]
  [Algebra.Etale (MvPolynomial (Fin d) k) S] in
/-- `ht μ⁻¹(R) = d + ht R`. -/
theorem a3v_height_M [IsAlgClosed k] [IsDomain S] [Algebra.FiniteType k S]
    (hdim : ringKrullDim S = d) (a : ℕ) (ha : R.height = a) :
    (a3v_M k S R).height = (d + a : ℕ) := by
  have : Algebra.FiniteType k (S ⊗[k] S) := Algebra.FiniteType.trans (S := S) inferInstance
    inferInstance
  have : IsDomain (S ⊗[k] S) := hc9k8_isDomain_tensorProduct
  have hT := hc9k8_height_add_ringKrullDim_quotient (k := k) (a3v_M k S R)
  rw [hc9k8_ringKrullDim_tensorProduct, hdim] at hT
  have hS := hc9k8_height_add_ringKrullDim_quotient (k := k) R
  rw [hdim, ha] at hS
  have hq : ringKrullDim ((S ⊗[k] S) ⧸ a3v_M k S R) = ringKrullDim (S ⧸ R) := by
    have hsurj : Function.Surjective ((Ideal.Quotient.mk R).comp (a3d_mu k S)) :=
      (Ideal.Quotient.mk_surjective).comp (fun s => ⟨s ⊗ₜ[k] (1 : S), by simp⟩)
    have hker : RingHom.ker ((Ideal.Quotient.mk R).comp (a3d_mu k S)) = a3v_M k S R := by
      rw [← RingHom.comap_ker, Ideal.mk_ker]
    exact ringKrullDim_eq_of_ringEquiv
      ((Ideal.quotEquivOfEq hker.symm).trans (RingHom.quotientKerEquivOfSurjective hsurj))
  rw [hq] at hT
  obtain ⟨a', b, ha', hb, hab⟩ := a3m_withBot_add_eq_nat (x := (a : ℕ∞)) (y := ringKrullDim (S ⧸ R))
    (d := d) (by exact_mod_cast hS)
  rw [hb] at hT
  have hT' : ((a3v_M k S R).height : WithBot ℕ∞) + (b : ℕ) = ((d + d : ℕ) : WithBot ℕ∞) := by
    rw [hT]; push_cast; rfl
  obtain ⟨c, b', hc, hb', hcb⟩ := a3m_withBot_add_eq_nat hT'
  have hbb : b' = b := by exact_mod_cast hb'.symm
  have haa : a' = a := by exact_mod_cast ha'.symm
  rw [hc]
  congr 1
  omega

/-- The coordinate differences form a weakly regular sequence in the maximal ideal of `B`: with a
lift of a regular system of parameters of `S_R` they generate the maximal ideal of `B`, and their
number is `dim B = d + ht R`. -/
theorem a3v_xs_isWeaklyRegular [IsAlgClosed k] [IsDomain S] [Algebra.FiniteType k S]
    (hdim : ringKrullDim S = d) :
    RingTheory.Sequence.IsWeaklyRegular (a3v_B k S R) (a3v_xs k d R) ∧
      ∀ x ∈ a3v_xs k d R, x ∈ maximalIdeal (a3v_B k S R) := by
  have : IsRegularLocalRing (Localization.AtPrime R) :=
    a3c_isRegularLocalRing_atPrime_of_etale (R := MvPolynomial (Fin d) k) R
  obtain ⟨ys, hlen, hys, -, -⟩ := a3c_exists_regular_sop (Localization.AtPrime R)
  have hsurj := a3v_pi_surjective k S R
  let lift : Localization.AtPrime R → a3v_B k S R := fun y => Classical.choose (hsurj y)
  have hlift : ∀ y, a3v_pi k S R (lift y) = y := fun y => Classical.choose_spec (hsurj y)
  let zs := ys.map lift
  have hxsm : Ideal.ofList (a3v_xs k d R) ≤ maximalIdeal (a3v_B k S R) := by
    rw [a3v_ofList_xs, ← Localization.AtPrime.map_eq_maximalIdeal]
    refine Ideal.map_mono fun a ha => ?_
    change a3d_mu k S a ∈ R
    rw [RingHom.mem_ker.1 ha]; exact zero_mem _
  have hmax : Ideal.ofList (a3v_xs k d R ++ zs) = maximalIdeal (a3v_B k S R) := by
    apply le_antisymm
    · rw [Ideal.ofList_append]
      refine sup_le hxsm (Ideal.span_le.2 ?_)
      intro z hz
      obtain ⟨y, hy, rfl⟩ := List.mem_map.1 hz
      have hym : y ∈ maximalIdeal (Localization.AtPrime R) := hys ▸ Ideal.subset_span hy
      by_contra hn
      have hu : IsUnit (lift y) := by
        by_contra hu'; exact hn ((IsLocalRing.mem_maximalIdeal _).2 hu')
      have := hu.map (a3v_pi k S R)
      rw [hlift] at this
      exact (IsLocalRing.mem_maximalIdeal _).1 hym this
    · intro b hb
      have hpb : a3v_pi k S R b ∈ maximalIdeal (Localization.AtPrime R) :=
        (IsLocalRing.mem_maximalIdeal _).2 fun hu =>
          (IsLocalRing.mem_maximalIdeal _).1 hb (isUnit_of_map_unit (a3v_pi k S R) b hu)
      rw [← hys] at hpb
      have hmap : (Ideal.ofList zs).map (a3v_pi k S R) = Ideal.ofList ys := by
        rw [Ideal.map_ofList, List.map_map]
        congr 1
        conv_rhs => rw [← List.map_id ys]
        exact List.map_congr_left fun y _ => hlift y
      rw [← hmap, Ideal.mem_map_iff_of_surjective _ hsurj] at hpb
      obtain ⟨c, hc, hcb⟩ := hpb
      have hdiff : b - c ∈ Ideal.ofList (a3v_xs k d R) := by
        rw [a3v_ofList_xs, ← a3v_ker_pi, RingHom.mem_ker, map_sub, hcb, sub_self]
      rw [Ideal.ofList_append]
      have : b = (b - c) + c := by ring
      rw [this]
      exact add_mem (Ideal.mem_sup_left hdiff) (Ideal.mem_sup_right hc)
  -- dimensions
  have hRh : ringKrullDim (Localization.AtPrime R) = R.height :=
    IsLocalization.AtPrime.ringKrullDim_eq_height R _
  have ha : R.height = (ys.length : ℕ∞) := by
    have := hlen.trans hRh
    exact_mod_cast this.symm
  have hB : ringKrullDim (a3v_B k S R) = ((d + ys.length : ℕ) : WithBot ℕ∞) := by
    rw [IsLocalization.AtPrime.ringKrullDim_eq_height (a3v_M k S R),
      a3v_height_M k d R hdim ys.length ha]
    rfl
  have : Algebra.FiniteType k (S ⊗[k] S) := Algebra.FiniteType.trans (S := S) inferInstance
    inferInstance
  have : IsNoetherianRing (S ⊗[k] S) := Algebra.FiniteType.isNoetherianRing k _
  have hreg := (a3c_isDomain_isWeaklyRegular (d + ys.length) (a3v_B k S R) hB
    (a3v_xs k d R ++ zs) (by simp [zs, a3v_xs_length]) hmax).2
  refine ⟨((RingTheory.Sequence.isWeaklyRegular_append_iff _ _ _).1 hreg).1, fun x hx => ?_⟩
  exact hxsm (Ideal.subset_span hx)

end etale

end HodgeLean.Adapters
