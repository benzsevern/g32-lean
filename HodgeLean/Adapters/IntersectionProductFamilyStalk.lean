import HodgeLean.Adapters.IntersectionProductFamily

/-! # Local rings of `X × ℙ¹` along the sections `σ_c`

At `τ = σ_c(x)` the projection gives a flat local map `f : 𝒪_{X,x} → 𝒪_{X×ℙ¹,τ}` and the section
a retraction `g : 𝒪_{X×ℙ¹,τ} → 𝒪_{X,x}` (`a3n_g_f`). The kernel of `g` is generated by one
nonzerodivisor (`a3n_ker_g`), by the dimension count `codim τ = codim x + 1` and the structure of
regular quotients of regular local rings. Hence for `v ⤳ x` the prime of `V × ℙ¹` at `τ` is
`𝔭_v 𝒪_{X×ℙ¹,τ}` (`a3n_stalkIdeal_b`), and for `e ⤳ x` the prime of `σ_c(closure {e})` is
`g⁻¹(𝔭_e)`.

Source: Matsumura, *Commutative Ring Theory*, Theorem 21.2 and Exercise 9.11; Hartshorne,
*Algebraic Geometry*, II, Proposition 2.2 and Theorem II.8.15. HC no distance; AV milestone no
distance.
-/

noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry IsLocalRing Order
open scoped MonoidalCategory

set_option backward.isDefEq.respectTransparency false

namespace HodgeLean.Adapters

section congr
variable {Y : Scheme.{0}}

/-- Transport of `a3i_stalkIdeal` along equal points. -/
theorem a3n_comap_stalkCongr {a b : Y} (h : a = b) (u : Y) :
    (a3i_stalkIdeal Y a u).comap (Y.presheaf.stalkCongr (.of_eq h)).inv.hom =
      a3i_stalkIdeal Y b u := by
  subst h
  simp only [TopCat.Presheaf.stalkCongr_inv, TopCat.Presheaf.stalkSpecializes_refl]
  exact Ideal.comap_id _

end congr

section stalks
variable (X : Over (Spec ↧ℂ)) (c : ℂ) (x : X.left)

theorem a3n_qσ : (a3n_q X).left (a3n_σ X c x) = x := a3n_q_σ_apply X c x

/-- The stalk map of the projection at `σ_c(x)`, read from `𝒪_{X,x}`.
Source: Hartshorne, *Algebraic Geometry*, II, §2 (morphisms of locally ringed spaces). -/
def a3n_f : X.left.presheaf.stalk x ⟶ (a3n_T X).left.presheaf.stalk (a3n_σ X c x) :=
  (X.left.presheaf.stalkCongr (.of_eq (a3n_qσ X c x))).inv ≫
    (a3n_q X).left.stalkMap (a3n_σ X c x)

example : X.left.presheaf.stalk x ⟶ (a3n_T X).left.presheaf.stalk (a3n_σ X c x) := a3n_f X c x

/-- The stalk map of the section `σ_c` at `x`.
Source: Hartshorne, *Algebraic Geometry*, II, §2 (morphisms of locally ringed spaces). -/
abbrev a3n_g : (a3n_T X).left.presheaf.stalk (a3n_σ X c x) ⟶ X.left.presheaf.stalk x :=
  (a3n_σ X c).stalkMap x

example : a3n_g X c x = (a3n_σ X c).stalkMap x := rfl

theorem a3n_stalkMap_q_σ :
    (a3n_q X).left.stalkMap (a3n_σ X c x) ≫ a3n_g X c x =
      (X.left.presheaf.stalkCongr (.of_eq (a3n_qσ X c x))).hom := by
  rw [← Scheme.Hom.stalkMap_comp,
    Scheme.Hom.stalkMap_congr_hom (a3n_σ X c ≫ (a3n_q X).left) (𝟙 _) (a3n_σ_q X c) x,
    Scheme.Hom.stalkMap_id]
  erw [Category.comp_id]

theorem a3n_g_f (a : X.left.presheaf.stalk x) : a3n_g X c x (a3n_f X c x a) = a := by
  have h := a3n_stalkMap_q_σ X c x
  change ((a3n_f X c x) ≫ a3n_g X c x) a = a
  rw [a3n_f, Category.assoc, h, Iso.inv_hom_id]
  rfl

theorem a3n_f_flat : (a3n_f X c x).hom.Flat := by
  have h1 : ((a3n_q X).left.stalkMap (a3n_σ X c x)).hom.Flat := Flat.stalkMap _ _
  have h2 : (X.left.presheaf.stalkCongr (.of_eq (a3n_qσ X c x))).inv.hom.Flat :=
    RingHom.Flat.of_bijective (ConcreteCategory.bijective_of_isIso _)
  exact RingHom.Flat.comp h2 h1

/-- The prime of a point `σ_c(e)` at `σ_c(x)` is the preimage of the prime of `e`. -/
theorem a3n_stalkIdeal_σ (e : X.left) (he : e ⤳ x) :
    a3i_stalkIdeal (a3n_T X).left (a3n_σ X c x) (a3n_σ X c e) =
      (a3i_stalkIdeal X.left x e).comap (a3n_g X c x).hom :=
  (a3y_comap_stalkIdeal (a3n_σ X c) he).symm

/-- The preimage under `f` of the prime of a generization `u` of `σ_c(x)` is the prime of `q u`. -/
theorem a3n_comap_f (u : (a3n_T X).left) (hu : u ⤳ a3n_σ X c x) :
    (a3i_stalkIdeal (a3n_T X).left (a3n_σ X c x) u).comap (a3n_f X c x).hom =
      a3i_stalkIdeal X.left x ((a3n_q X).left u) := by
  rw [a3n_f, CommRingCat.hom_comp, ← Ideal.comap_comap, a3y_comap_stalkIdeal (a3n_q X).left hu,
    a3n_comap_stalkCongr (a3n_qσ X c x)]

end stalks

section ker
variable (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] (c : ℂ) (x : X.left)

omit [IsIntegral X.left] [Smooth X.hom] in
theorem a3n_g_surjective : Function.Surjective (a3n_g X c x).hom :=
  fun a => ⟨a3n_f X c x a, a3n_g_f X c x a⟩

/-- The kernel of the retraction `g` is generated by a nonzerodivisor of the maximal ideal. -/
theorem a3n_ker_g : ∃ x₁ : (a3n_T X).left.presheaf.stalk (a3n_σ X c x),
    x₁ ∈ maximalIdeal _ ∧ IsSMulRegular ((a3n_T X).left.presheaf.stalk (a3n_σ X c x)) x₁ ∧
      RingHom.ker (a3n_g X c x).hom = Ideal.span {x₁} := by
  have : IsLocallyNoetherian X.left := LocallyOfFiniteType.isLocallyNoetherian X.hom
  have hB := a3c_isRegularLocalRing_stalk (a3n_T X) (a3n_σ X c x)
  have hA := a3c_isRegularLocalRing_stalk X x
  set B := (a3n_T X).left.presheaf.stalk (a3n_σ X c x)
  set A := X.left.presheaf.stalk x
  let e : B ⧸ RingHom.ker (a3n_g X c x).hom ≃+* A :=
    RingHom.quotientKerEquivOfSurjective (a3n_g_surjective X c x)
  have : IsRegularLocalRing (B ⧸ RingHom.ker (a3n_g X c x).hom) :=
    IsRegularLocalRing.of_ringEquiv e.symm
  obtain ⟨k, hk⟩ := ENat.ne_top_iff_exists.1 (a3c_coheight_ne_top X.left x)
  have hdimA : ringKrullDim A = k := by
    rw [ringKrullDim_stalk_eq_coheight, ← hk]
    rfl
  have hdimB : ringKrullDim B = (k + 1 : ℕ) := by
    rw [ringKrullDim_stalk_eq_coheight, a3n_coheight_σ, ← hk]
    norm_cast
  have hdimQ : ringKrullDim (B ⧸ RingHom.ker (a3n_g X c x).hom) = k := by
    rw [ringKrullDim_eq_of_ringEquiv e, hdimA]
  obtain ⟨xs, hlen, hmem, hreg, hspan⟩ :=
    a3d_exists_regular_of_quotient B (RingHom.ker (a3n_g X c x).hom) (k + 1) k hdimB hdimQ
  obtain ⟨x₁, rfl⟩ : ∃ x₁, xs = [x₁] := by
    match xs, hlen with
    | [x₁], _ => exact ⟨x₁, rfl⟩
    | [], h => simp at h
    | _ :: _ :: _, h => simp at h; omega
  rw [RingTheory.Sequence.isWeaklyRegular_singleton_iff] at hreg
  refine ⟨x₁, hmem x₁ (by simp), hreg, ?_⟩
  rw [← hspan, Ideal.ofList_singleton]

end ker

section bprime
variable (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] (c : ℂ) (x : X.left)

omit [IsIntegral X.left] [Smooth X.hom] in
theorem a3n_comap_map_f (I : Ideal (X.left.presheaf.stalk x)) :
    (I.map (a3n_f X c x).hom).comap (a3n_f X c x).hom = I := by
  refine le_antisymm (fun a ha => ?_) Ideal.le_comap_map
  have hle : I.map (a3n_f X c x).hom ≤ I.comap (a3n_g X c x).hom :=
    Ideal.map_le_iff_le_comap.2 fun p hp => by
      rw [Ideal.mem_comap, Ideal.mem_comap]
      change (a3n_g X c x) ((a3n_f X c x) p) ∈ I
      rw [a3n_g_f]
      exact hp
  have := hle ha
  rw [Ideal.mem_comap] at this
  change (a3n_g X c x) ((a3n_f X c x) a) ∈ I at this
  rwa [a3n_g_f] at this

/-- The prime of `V × ℙ¹` at `σ_c(x)` is generated by the prime of `V` at `x`.
Source: Hartshorne, *Algebraic Geometry*, II, Proposition 2.2 and Exercise II.3.15. -/
theorem a3n_stalkIdeal_b [LocallyOfFiniteType X.hom] (v : X.left) (hv : v ⤳ x) :
    a3i_stalkIdeal (a3n_T X).left (a3n_σ X c x) (a3n_b X v) =
      (a3i_stalkIdeal X.left x v).map (a3n_f X c x).hom := by
  have : IsLocallyNoetherian X.left := LocallyOfFiniteType.isLocallyNoetherian X.hom
  have hB := a3c_isRegularLocalRing_stalk (a3n_T X) (a3n_σ X c x)
  have hbτ : a3n_b X v ⤳ a3n_σ X c x := by
    rw [a3n_b_specializes_iff, a3n_q_σ_apply]
    exact hv
  have hv' := a3q_stalkIdeal_isPrime X.left hv
  obtain ⟨x₁, hx₁, hreg, hker⟩ := a3n_ker_g X c x
  set J := (a3i_stalkIdeal X.left x v).map (a3n_f X c x).hom
  have hJ : J.IsPrime := a3f_isPrime_map (a3n_f X c x).hom (a3n_g X c x).hom (a3n_g_f X c x) x₁
    hreg hker hx₁ _
  refine le_antisymm ?_ ?_
  · -- the point of `J` lies over `v`, so it is a specialization of `b_v`
    let P : PrimeSpectrum ((a3n_T X).left.presheaf.stalk (a3n_σ X c x)) := ⟨J, hJ⟩
    set j := (a3n_T X).left.fromSpecStalk (a3n_σ X c x) P
    have hj : j ⤳ a3n_σ X c x := a3y_specializes_fromSpecStalk _ P
    have hJj : a3i_stalkIdeal (a3n_T X).left (a3n_σ X c x) j = J :=
      congrArg PrimeSpectrum.asIdeal (a3y_pt_fromSpecStalk _ P)
    have hqj : (a3n_q X).left j = v := by
      have h1 := a3n_comap_f X c x j hj
      rw [hJj, a3n_comap_map_f] at h1
      have hqjx : (a3n_q X).left j ⤳ x := by
        have := hj.map (a3n_q X).left.continuous
        rwa [a3n_q_σ_apply] at this
      exact a3y_pt_injective x _ v hqjx hv (PrimeSpectrum.ext h1.symm)
    have hbj : a3n_b X v ⤳ j := by
      rw [a3n_b_specializes_iff, hqj]
    have := (a3y_pt_le_iff (a3n_σ X c x) (a3n_b X v) j hbτ hj).2 hbj
    rw [← hJj]
    exact this
  · rw [Ideal.map_le_iff_le_comap, a3n_comap_f X c x _ hbτ, a3n_q_b]

end bprime

section serre
variable (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [LocallyOfFiniteType X.hom]
  (c : ℂ) (x : X.left)

/-- The lengths of the `Tor` modules in Serre's multiplicity agree along `σ_c`. -/
theorem a3n_length_tor_σ (e v : X.left) (he : e ⤳ x) (hv : v ⤳ x) (i : ℕ) :
    Module.length ((a3n_T X).left.presheaf.stalk (a3n_σ X c x))
        (a3i_torModule (a3n_T X).left (a3n_σ X c x) (a3n_σ X c e) (a3n_b X v) i) =
      Module.length (X.left.presheaf.stalk x) (a3i_torModule X.left x e v i) := by
  unfold a3i_torModule
  rw [a3n_stalkIdeal_σ X c x e he, a3n_stalkIdeal_b X c x v hv]
  have hP : RingHom.ker (a3n_g X c x).hom ≤ (a3i_stalkIdeal X.left x e).comap (a3n_g X c x).hom :=
    fun b hb => by
      rw [Ideal.mem_comap, RingHom.mem_ker.1 hb]
      exact Ideal.zero_mem _
  have h := a3f_length_tor (a3n_f X c x).hom (a3n_g X c x).hom (a3n_g_f X c x) (a3n_f_flat X c x)
    _ hP (a3i_stalkIdeal X.left x v) i
  rw [Ideal.map_comap_of_surjective _ (a3n_g_surjective X c x)] at h
  exact h

/-- Serre's multiplicity on `X × ℙ¹` along `σ_c`: `i((x, c); (e, c) · (V × ℙ¹)) = i(x; e · V)`.
Source: Serre, *Algèbre locale, multiplicités*, Chapitre V, C; Fulton, *Intersection Theory*,
second edition, Example 20.4.3. -/
theorem a3n_serreMult_σ (e v : X.left) (he : e ⤳ x) (hv : v ⤳ x) :
    a3i_serreMult (a3n_T X).left (a3n_σ X c x) (a3n_σ X c e) (a3n_b X v) =
      a3i_serreMult X.left x e v := by
  have : IsLocallyNoetherian X.left := LocallyOfFiniteType.isLocallyNoetherian X.hom
  have hA := a3c_isRegularLocalRing_stalk X x
  unfold a3i_serreMult
  rw [a3n_coheight_σ]
  obtain ⟨m, hm⟩ := ENat.ne_top_iff_exists.1 (a3c_coheight_ne_top X.left x)
  rw [← hm, show ((m : ℕ∞) + 1).toNat = m + 1 by norm_cast, ENat.toNat_natCast]
  simp only [a3n_length_tor_σ X c x e v he hv]
  rw [Finset.sum_range_succ (n := m + 1)]
  have hz : Module.length (X.left.presheaf.stalk x) (a3i_torModule X.left x e v (m + 1)) = 0 := by
    have hdim : ringKrullDim (X.left.presheaf.stalk x) < (m + 1 : ℕ) := by
      rw [ringKrullDim_stalk_eq_coheight, ← hm]
      exact_mod_cast Nat.lt_succ_self m
    have : Module.Finite (X.left.presheaf.stalk x)
        (ModuleCat.of (X.left.presheaf.stalk x)
          (X.left.presheaf.stalk x ⧸ a3i_stalkIdeal X.left x v)) :=
      (inferInstance : Module.Finite (X.left.presheaf.stalk x)
        (X.left.presheaf.stalk x ⧸ a3i_stalkIdeal X.left x v))
    exact Module.length_eq_zero_iff.mpr (ModuleCat.isZero_iff_subsingleton.mp
      (a3e_isZero_tor_regular _ _ (m + 1) hdim))
  rw [hz]
  simp

end serre

section comps
variable (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [LocallyOfFiniteType X.hom] (c : ℂ)

/-- Components of `σ_c(closure {e}) ∩ (V × ℙ¹)` are the images of the components of
`closure {e} ∩ V`. -/
theorem a3n_mem_comps_σ_iff (e v x : X.left) :
    a3n_σ X c x ∈ a3y_comps (a3n_σ X c e) (a3n_b X v) ↔ x ∈ a3y_comps e v := by
  constructor
  · intro h
    obtain ⟨he, hb, hmax⟩ := a3y_comps_spec _ _ h
    have he' : e ⤳ x := by
      have := he.map (a3n_q X).left.continuous
      rwa [a3n_q_σ_apply, a3n_q_σ_apply] at this
    have hv' : v ⤳ x := by
      rw [a3n_b_specializes_iff, a3n_q_σ_apply] at hb
      exact hb
    refine a3y_component_of_maximal e v x he' hv' fun q' heq hvq hqx => ?_
    have h1 : a3n_σ X c e ⤳ a3n_σ X c q' := heq.map (a3n_σ X c).continuous
    have h2 : a3n_b X v ⤳ a3n_σ X c q' := by
      rw [a3n_b_specializes_iff, a3n_q_σ_apply]
      exact hvq
    have h3 : a3n_σ X c q' ⤳ a3n_σ X c x := hqx.map (a3n_σ X c).continuous
    have := congrArg (a3n_q X).left (hmax _ h1 h2 h3)
    rwa [a3n_q_σ_apply, a3n_q_σ_apply] at this
  · intro h
    obtain ⟨he, hv, hmax⟩ := a3y_comps_spec _ _ h
    have he' : a3n_σ X c e ⤳ a3n_σ X c x := he.map (a3n_σ X c).continuous
    have hb : a3n_b X v ⤳ a3n_σ X c x := by
      rw [a3n_b_specializes_iff, a3n_q_σ_apply]
      exact hv
    refine a3y_component_of_maximal _ _ _ he' hb fun τ heτ hbτ hτx => ?_
    obtain ⟨y, rfl⟩ := a3n_mem_range_σ_of_specializes X c heτ
    have h1 : e ⤳ y := by
      have := heτ.map (a3n_q X).left.continuous
      rwa [a3n_q_σ_apply, a3n_q_σ_apply] at this
    have h2 : v ⤳ y := by
      rw [a3n_b_specializes_iff, a3n_q_σ_apply] at hbτ
      exact hbτ
    have h3 : y ⤳ x := by
      have := hτx.map (a3n_q X).left.continuous
      rwa [a3n_q_σ_apply, a3n_q_σ_apply] at this
    rw [hmax y h1 h2 h3]

end comps

section comps'
variable (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [IsProper X.hom] (c : ℂ)

/-- The coefficients of `σ_c(closure {e}) · (V × ℙ¹)` along `σ_c` are those of
`closure {e} · V`. -/
theorem a3n_intersectPrime_σ (e v x : X.left) :
    a3i_intersectPrime (a3n_T X).left (a3n_σ X c e) (a3n_b X v) (a3n_σ X c x) =
      a3i_intersectPrime X.left e v x := by
  classical
  have : IsNoetherian X.left := by
    have : IsLocallyNoetherian X.left := LocallyOfFiniteType.isLocallyNoetherian X.hom
    have : CompactSpace X.left := by
      have h := QuasiCompact.isCompact_preimage (f := X.hom) _ isOpen_univ isCompact_univ
      rw [Set.preimage_univ] at h
      exact isCompact_univ_iff.mp h
    exact ⟨⟩
  have hiff := a3n_mem_comps_σ_iff X c e v x
  rw [a3y_intersectPrime_apply, a3y_intersectPrime_apply]
  split_ifs with h1 h2 h2
  · obtain ⟨he, hv, -⟩ := a3y_comps_spec _ _ h2
    rw [a3n_serreMult_σ X c x e v he hv]
  · exact absurd (hiff.1 h1) h2
  · exact absurd (hiff.2 h2) h1
  · rfl

omit [IsIntegral X.left] in
/-- The intersection cycle `σ_c(closure {e}) · (V × ℙ¹)` lives on `σ_c(X)`. -/
theorem a3n_intersectPrime_σ_of_not_mem (e v : X.left) (τ : (a3n_T X).left)
    (hτ : τ ∉ Set.range (a3n_σ X c)) :
    a3i_intersectPrime (a3n_T X).left (a3n_σ X c e) (a3n_b X v) τ = 0 := by
  by_contra hne
  have hc := a3z_intersectPrime_ne_zero (a3n_T X).left _ _ τ hne
  exact hτ (a3n_mem_range_σ_of_specializes X c (a3y_comps_spec _ _ hc).1)

end comps'

