import HodgeLean.Adapters.IntersectionProductMovingSpecCharts
import HodgeLean.Adapters.IntersectionProductMovingCharts
import HodgeLean.Foundations.SegreProjectiveProofs

/-! # Projective charts on complex projective space

`ProjectiveSpace (Fin (N+1)) (Spec ℂ)` is the fibre product `Spec ℂ × ℙᴺ_ℤ` over the integers;
its standard charts are the product charts `Spec (ℂ ⊗[ℤ] ℤ[x/x_j]) ⟶ Spec ℂ × D₊(x_j)`, with the
dehomogenizations `ℂ[x] → ℂ ⊗[ℤ] ℤ[x/x_j]`, `x_k ↦ 1 ⊗ x_k/x_j`. They form projective
`Spec`-charts (`a3m_projCharts`), so the points of complex projective space are the relevant
homogeneous primes of `ℂ[x_0, …, x_N]`.

Source: Hartshorne, *Algebraic Geometry*, II, Proposition 2.5 and §II.7; Mathlib,
`AlgebraicGeometry.Proj.awayι`, `HomogeneousLocalization.Away.adjoin_mk_prod_pow_eq_top`.
HC no distance; AV milestone no distance.
-/

noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry MvPolynomial HomogeneousLocalization
open AlgebraicGeometry.ComplexProjectiveSpace HodgeLean.Foundations

namespace HodgeLean.Adapters

attribute [local instance] MvPolynomial.gradedAlgebra

/-- Twisting: if two ring maps agree on constants and differ by `u` on the variables, they differ
by `u^e` on homogeneous polynomials of degree `e`. -/
theorem a3m_twist {σ R A : Type} [Fintype σ] [CommRing R] [CommRing A]
    (φ ψ : MvPolynomial σ R →+* A) (u : A) (hC : ∀ r, φ (C r) = ψ (C r))
    (hX : ∀ k, φ (X k) = u * ψ (X k)) (F : MvPolynomial σ R) (e : ℕ) (hF : F.IsHomogeneous e) :
    φ F = u ^ e * ψ F := by
  have hφ : ∀ G, φ G = eval₂ (φ.comp C) (fun k => φ (X k)) G := fun G => by
    conv_lhs => rw [← MvPolynomial.eval₂_eta G]
    exact MvPolynomial.eval₂_comp_left _ _ _ _
  have hψ : ∀ G, ψ G = eval₂ (ψ.comp C) (fun k => ψ (X k)) G := fun G => by
    conv_lhs => rw [← MvPolynomial.eval₂_eta G]
    exact MvPolynomial.eval₂_comp_left _ _ _ _
  rw [hφ, hψ, eval₂_eq', eval₂_eq', Finset.mul_sum]
  refine Finset.sum_congr rfl fun m hm => ?_
  have hd : ∑ i, m i = e := by
    rw [← hF (MvPolynomial.mem_support_iff.mp hm)]
    simp only [Finsupp.weight_apply, smul_eq_mul, Pi.one_apply, mul_one]
    exact (Finsupp.sum_fintype m (fun _ x ↦ x) (fun _ ↦ rfl)).symm
  simp only [RingHom.comp_apply, hC, hX, mul_pow, Finset.prod_mul_distrib]
  rw [Finset.prod_pow_eq_pow_sum, hd]
  ring

set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
/-- The chart ring `ℤ[x/x_i]` of `D₊(x_i)` is generated by the coordinates `x_k/x_i`.
Source: Mathlib, `HomogeneousLocalization.Away.adjoin_mk_prod_pow_eq_top`. -/
theorem a3m_awayCoord_surj (n : ℕ) (i : Fin (n+1)) : Function.Surjective
    (eval₂Hom ((fromZeroRingHom (UniversalGrading n) (.powers (X i))).comp
      (ProjectiveSpace.degreeZeroEquiv (Fin (n+1)) (ULift.{0} ℤ)).symm.toRingHom)
      (chartCoordinate i) : UniversalRing n →+* Away (UniversalGrading n) (X i)) := by
  intro z
  let φ : UniversalRing n →+* Away (UniversalGrading n) (X i) :=
    eval₂Hom ((fromZeroRingHom (UniversalGrading n) (.powers (X i))).comp
      (ProjectiveSpace.degreeZeroEquiv (Fin (n+1)) (ULift.{0} ℤ)).symm.toRingHom)
      (chartCoordinate i)
  let S : Subring (Away (UniversalGrading n) (X i)) := φ.range
  have hbase : ∀ a : UniversalGrading n 0,
      fromZeroRingHom (UniversalGrading n) (.powers (X i)) a ∈ S := by
    intro a
    obtain ⟨c, rfl⟩ := (ProjectiveSpace.degreeZeroEquiv
      (Fin (n+1)) (ULift.{0} ℤ)).symm.surjective a
    exact ⟨C c, by simp [φ]⟩
  have hcoord : ∀ k, chartCoordinate i k ∈ S := by
    intro k
    exact ⟨X k, by simp [φ]⟩
  have htop := Away.adjoin_mk_prod_pow_eq_top (isHomogeneous_X (ULift.{0} ℤ) i)
    (Fin (n+1)) (fun k => X k) (adjoin_coordinates_eq_top n)
    (fun _ => (1 : ℕ)) (fun k => isHomogeneous_X (ULift.{0} ℤ) k)
  have hz : z ∈ Algebra.adjoin (UniversalGrading n 0)
      { Away.mk (UniversalGrading n) (isHomogeneous_X (ULift.{0} ℤ) i) a
        (∏ k, X k ^ ai k) (hai ▸ SetLike.prod_pow_mem_graded _ _ _ _
          (fun k _ => isHomogeneous_X (ULift.{0} ℤ) k)) |
        (a : ℕ) (ai : Fin (n+1) → ℕ) (hai : ∑ k, ai k • 1 = a • 1)
          (_ : ∀ k, ai k ≤ 1) } := by
    rw [htop]
    trivial
  refine Algebra.adjoin_induction (p := fun x _ => x ∈ S) ?_ hbase ?_ ?_ hz
  · intro x hx
    obtain ⟨a, ai, hai, _, rfl⟩ := hx
    have hai' : ∑ k, ai k = a := by simpa using hai
    rw [chartGenerator_eq_prod i ai hai']
    exact Subring.prod_mem S (fun k _ => S.pow_mem (hcoord k) _)
  · intro x y _ _ hx hy
    exact S.add_mem hx hy
  · intro x y _ _ hx hy
    exact S.mul_mem hx hy

section ProjCharts

variable (N : ℕ)

/-- Complex projective space `ℙᴺ_ℂ = Spec ℂ × ℙᴺ_ℤ`; it is definitionally the upstream
`ProjectiveSpace (Fin (N+1)) (Spec ℂ)` (`a3m_Pn_eq`). -/
abbrev a3m_Pn : Scheme.{0} := pullback (terminal.from (Spec ↧ℂ)) (terminal.from (g3c_P N))

theorem a3m_Pn_eq : ProjectiveSpace (Fin (N + 1)) (Spec ↧ℂ) = a3m_Pn N := rfl

/-- The chart ring `ℂ ⊗[ℤ] ℤ[x/x_j]`. -/
abbrev a3m_PnT (j : Fin (N + 1)) : CommRingCat.{0} :=
  .of (TensorProduct ℤ ℂ (Away (UniversalGrading N) (X j : UniversalRing N)))

/-- The standard chart `Spec (ℂ ⊗[ℤ] ℤ[x/x_j]) ⟶ ℙᴺ_ℂ`. -/
def a3m_Pnκ (j : Fin (N + 1)) : Spec (a3m_PnT N j) ⟶ a3m_Pn N :=
  a3m_prodChart (𝟙 (Spec ↧ℂ)) (g3c_chartι N j)

instance (j : Fin (N + 1)) : IsOpenImmersion (a3m_Pnκ N j) :=
  a3m_prodChart_isOpenImmersion _ _

/-- The dehomogenization `ℂ[x] → ℂ ⊗[ℤ] ℤ[x/x_j]`. -/
def a3m_Pnθ (j : Fin (N + 1)) : MvPolynomial (Fin (N + 1)) ℂ →+* a3m_PnT N j :=
  eval₂Hom (Algebra.TensorProduct.includeLeftRingHom (R := ℤ) (A := ℂ)
    (B := Away (UniversalGrading N) (X j : UniversalRing N)))
    (fun k => Algebra.TensorProduct.includeRight (R := ℤ) (A := ℂ) (chartCoordinate j k))

theorem a3m_Pnθ_X_self (j : Fin (N + 1)) : a3m_Pnθ N j (X j) = 1 := by
  simp [a3m_Pnθ]
  rfl

set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
theorem a3m_Pnθ_surj (j : Fin (N + 1)) : Function.Surjective (a3m_Pnθ N j) := by
  set S := (a3m_Pnθ N j).range
  have hR : ∀ P : UniversalRing N, Algebra.TensorProduct.includeRight (R := ℤ) (A := ℂ)
      (eval₂Hom ((fromZeroRingHom (UniversalGrading N) (.powers (X j))).comp
        (ProjectiveSpace.degreeZeroEquiv (Fin (N+1)) (ULift.{0} ℤ)).symm.toRingHom)
        (chartCoordinate j) P) ∈ S := by
    intro P
    induction P using MvPolynomial.induction_on with
    | C c =>
      have hc : (MvPolynomial.C c : UniversalRing N) = ((c.down : ℤ) : UniversalRing N) := by
        obtain ⟨c⟩ := c
        rw [← map_intCast (MvPolynomial.C (σ := Fin (N + 1)) (R := ULift.{0} ℤ)) c]
        rfl
      rw [hc, map_intCast, map_intCast]
      exact intCast_mem S _
    | add P Q hP hQ =>
      simp only [coe_eval₂Hom, eval₂_add] at hP hQ ⊢
      rw [map_add]
      exact S.add_mem hP hQ
    | mul_X P k hP =>
      simp only [coe_eval₂Hom, eval₂_mul, eval₂_X] at hP ⊢
      rw [map_mul]
      refine S.mul_mem hP ⟨X k, ?_⟩
      simp [a3m_Pnθ]
  intro t
  induction t using TensorProduct.inductionOn with
  | add x y hx hy =>
    obtain ⟨a, rfl⟩ := hx
    obtain ⟨b, rfl⟩ := hy
    exact ⟨a + b, map_add _ _ _⟩
  | tmul c a =>
    obtain ⟨P, rfl⟩ := a3m_awayCoord_surj N j a
    obtain ⟨G, hG⟩ := hR P
    refine ⟨MvPolynomial.C c * G, ?_⟩
    rw [map_mul, hG]
    simp [a3m_Pnθ, Algebra.TensorProduct.tmul_mul_tmul]

theorem a3m_Pn_cover (y : a3m_Pn N) : ∃ j, y ∈ Set.range (a3m_Pnκ N j) := by
  obtain ⟨j, hj⟩ := g3c_chartι_covers N (pullback.snd (terminal.from (Spec ↧ℂ))
    (terminal.from (g3c_P N)) y)
  refine ⟨j, ?_⟩
  have h := a3m_range_prodChart (𝟙 (Spec ↧ℂ)) (g3c_chartι N j)
  have hy : y ∈ pullback.fst (terminal.from (Spec ↧ℂ)) (terminal.from (g3c_P N)) ⁻¹'
      Set.range (𝟙 (Spec ↧ℂ)) ∩
      pullback.snd (terminal.from (Spec ↧ℂ)) (terminal.from (g3c_P N)) ⁻¹'
        Set.range (g3c_chartι N j) :=
    ⟨Set.mem_preimage.2 ⟨pullback.fst (terminal.from (Spec ↧ℂ)) (terminal.from (g3c_P N)) y,
      by simp⟩, hj⟩
  rw [← h] at hy
  exact hy

theorem a3m_Pn_inter (j l : Fin (N + 1)) (p : Spec (a3m_PnT N l)) :
    a3m_Pnκ N l p ∈ Set.range (a3m_Pnκ N j) ↔ a3m_Pnθ N l (X j) ∉ p.asIdeal := by
  have h := a3m_range_prodChart (𝟙 (Spec ↧ℂ)) (g3c_chartι N j)
  have hsnd : pullback.snd (terminal.from (Spec ↧ℂ)) (terminal.from (g3c_P N)) (a3m_Pnκ N l p) =
      g3c_chartι N l (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight
        (R := ℤ) (A := ℂ) (B := Away (UniversalGrading N) (X l : UniversalRing N))).toRingHom) p) := by
    rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply]
    exact congrArg (fun f => f p) (a3m_prodChart_snd (𝟙 (Spec ↧ℂ)) (g3c_chartι N l))
  have hmem : a3m_Pnκ N l p ∈ Set.range (a3m_Pnκ N j) ↔
      pullback.snd (terminal.from (Spec ↧ℂ)) (terminal.from (g3c_P N)) (a3m_Pnκ N l p) ∈
        Set.range (g3c_chartι N j) := by
    change a3m_Pnκ N l p ∈ Set.range (a3m_prodChart (𝟙 (Spec ↧ℂ)) (g3c_chartι N j)) ↔ _
    rw [h]
    exact ⟨fun h' => h'.2, fun h' => ⟨Set.mem_preimage.2
      ⟨pullback.fst (terminal.from (Spec ↧ℂ)) (terminal.from (g3c_P N)) (a3m_Pnκ N l p),
        by simp⟩, h'⟩⟩
  rw [hmem, hsnd]
  set q := Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight (R := ℤ) (A := ℂ)
    (B := Away (UniversalGrading N) (X l : UniversalRing N))).toRingHom) p
  have h2 : g3c_chartι N l q ∈ Set.range (g3c_chartι N j) ↔
      q ∈ (g3c_chartι N l ⁻¹ᵁ (g3c_chartι N j).opensRange : Set _) := Iff.rfl
  rw [h2, g3c_chartι_preimage_opensRange]
  have h3 : q ∈ ((Spec (.of (Away (UniversalGrading N) (X l : UniversalRing N)))).basicOpen
      ((Scheme.ΓSpecIso _).inv (chartCoordinate l j)) : Set _) ↔
      chartCoordinate l j ∉ q.asIdeal := by
    rw [basicOpen_eq_of_affine]
    exact PrimeSpectrum.mem_basicOpen _ _
  rw [h3]
  change chartCoordinate l j ∉ Ideal.comap (Algebra.TensorProduct.includeRight (R := ℤ) (A := ℂ)
    (B := Away (UniversalGrading N) (X l : UniversalRing N))).toRingHom p.asIdeal ↔ _
  rw [Ideal.mem_comap]
  simp [a3m_Pnθ]

theorem a3m_appTop_comp_apply {X Y Z : Scheme.{0}} (f : X ⟶ Y) (g : Y ⟶ Z) (x : Γ(Z, ⊤)) :
    (f ≫ g).appTop x = f.appTop (g.appTop x) := by
  rw [Scheme.Hom.comp_appTop]; rfl

/-- Pulling back a global section of `Spec S` along `f ≫ Spec.map φ`. -/
theorem a3m_appTop_comp_SpecMap {Z : Scheme.{0}} {R S : CommRingCat.{0}} (f : Z ⟶ Spec R)
    (φ : S ⟶ R) (c : S) :
    (f ≫ Spec.map φ).appTop ((Scheme.ΓSpecIso S).inv c) =
      f.appTop ((Scheme.ΓSpecIso R).inv (φ c)) := by
  rw [Scheme.Hom.comp_appTop, CommRingCat.comp_apply, g3c_SpecMap_appTop_ΓSpecIso_inv]

theorem a3m_Pn_hov (j l : Fin (N + 1)) (F : MvPolynomial (Fin (N + 1)) ℂ) (e : ℕ)
    (hF : F.IsHomogeneous e) :
    (pullback.snd (a3m_Pnκ N j) (a3m_Pnκ N l)).appTop
        ((Scheme.ΓSpecIso _).inv (a3m_Pnθ N l F)) =
      (pullback.snd (a3m_Pnκ N j) (a3m_Pnκ N l)).appTop
          ((Scheme.ΓSpecIso _).inv (a3m_Pnθ N l (X j))) ^ e *
        (pullback.fst (a3m_Pnκ N j) (a3m_Pnκ N l)).appTop
          ((Scheme.ΓSpecIso _).inv (a3m_Pnθ N j F)) := by
  set Z := pullback (a3m_Pnκ N j) (a3m_Pnκ N l)
  set f₁ := pullback.fst (a3m_Pnκ N j) (a3m_Pnκ N l)
  set f₂ := pullback.snd (a3m_Pnκ N j) (a3m_Pnκ N l)
  let φ : MvPolynomial (Fin (N + 1)) ℂ →+* Γ(Z, ⊤) :=
    f₂.appTop.hom.comp ((Scheme.ΓSpecIso _).inv.hom.comp (a3m_Pnθ N l))
  let ψ : MvPolynomial (Fin (N + 1)) ℂ →+* Γ(Z, ⊤) :=
    f₁.appTop.hom.comp ((Scheme.ΓSpecIso _).inv.hom.comp (a3m_Pnθ N j))
  have hcond : f₁ ≫ a3m_Pnκ N j = f₂ ≫ a3m_Pnκ N l := pullback.condition
  -- constants come from `Spec ℂ`
  have hL : f₁ ≫ Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom
      (R := ℤ) (A := ℂ) (B := Away (UniversalGrading N) (X j : UniversalRing N)))) =
      f₂ ≫ Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom
      (R := ℤ) (A := ℂ) (B := Away (UniversalGrading N) (X l : UniversalRing N)))) := by
    have h1 := a3m_prodChart_fst (𝟙 (Spec ↧ℂ)) (g3c_chartι N j)
    have h2 := a3m_prodChart_fst (𝟙 (Spec ↧ℂ)) (g3c_chartι N l)
    rw [Category.comp_id] at h1 h2
    change _ = _ at h1 h2
    rw [← h1, ← h2, ← Category.assoc, ← Category.assoc]
    exact congrArg (· ≫ pullback.fst _ _) hcond
  have hC : ∀ c : ℂ, φ (MvPolynomial.C c) = ψ (MvPolynomial.C c) := by
    intro c
    simp only [φ, ψ, RingHom.comp_apply, a3m_Pnθ, coe_eval₂Hom, eval₂_C]
    have e1 := a3m_appTop_comp_SpecMap f₁ (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom
      (R := ℤ) (A := ℂ) (B := Away (UniversalGrading N) (X j : UniversalRing N)))) c
    have e2 := a3m_appTop_comp_SpecMap f₂ (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom
      (R := ℤ) (A := ℂ) (B := Away (UniversalGrading N) (X l : UniversalRing N)))) c
    simp only [CommRingCat.hom_ofHom] at e1 e2
    rw [← e1, ← e2, hL]
  -- coordinates: the overlap relation of `ℙᴺ_ℤ`
  have hR : f₁ ≫ Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight
      (R := ℤ) (A := ℂ) (B := Away (UniversalGrading N) (X j : UniversalRing N))).toRingHom) ≫
      g3c_chartι N j =
      f₂ ≫ Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight
      (R := ℤ) (A := ℂ) (B := Away (UniversalGrading N) (X l : UniversalRing N))).toRingHom) ≫
      g3c_chartι N l := by
    rw [← a3m_prodChart_snd (𝟙 (Spec ↧ℂ)) (g3c_chartι N j),
      ← a3m_prodChart_snd (𝟙 (Spec ↧ℂ)) (g3c_chartι N l), ← Category.assoc, ← Category.assoc]
    exact congrArg (· ≫ pullback.snd _ _) hcond
  let w : Z ⟶ pullback (g3c_chartι N j) (g3c_chartι N l) :=
    pullback.lift (f₁ ≫ Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight
      (R := ℤ) (A := ℂ) (B := Away (UniversalGrading N) (X j : UniversalRing N))).toRingHom))
      (f₂ ≫ Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight
      (R := ℤ) (A := ℂ) (B := Away (UniversalGrading N) (X l : UniversalRing N))).toRingHom))
      (by rw [Category.assoc, Category.assoc]; exact hR)
  have hX : ∀ k, φ (X k) = φ (X j) * ψ (X k) := by
    intro k
    have hov := congrArg w.appTop.hom (g3c_overlap_coord N j l k)
    rw [map_mul, ← a3m_appTop_comp_apply, ← a3m_appTop_comp_apply, ← a3m_appTop_comp_apply,
      pullback.lift_fst, pullback.lift_snd, a3m_appTop_comp_SpecMap, a3m_appTop_comp_SpecMap,
      a3m_appTop_comp_SpecMap] at hov
    simp only [CommRingCat.hom_ofHom, AlgHom.toRingHom_eq_coe, RingHom.coe_coe] at hov
    simp only [φ, ψ, RingHom.comp_apply, a3m_Pnθ, coe_eval₂Hom, eval₂_X]
    exact hov
  exact a3m_twist φ ψ (φ (X j)) hC hX F e hF

/-- The standard projective charts of `ℙᴺ_ℂ`.
Source: Hartshorne, *Algebraic Geometry*, II, Proposition 2.5 and §II.7. -/
def a3m_projCharts : a3m_SpecCharts (a3m_Pn N) (Fin (N + 1)) ℂ where
  T := a3m_PnT N
  κ := a3m_Pnκ N
  cover := a3m_Pn_cover N
  θ := a3m_Pnθ N
  θ_X_self := a3m_Pnθ_X_self N
  θ_surj := a3m_Pnθ_surj N
  inter := a3m_Pn_inter N
  compat := a3m_compat_of_overlap (a3m_Pnκ N) (a3m_Pnθ N) (a3m_Pn_inter N) (a3m_Pn_hov N)

end ProjCharts

/-! ## Charts on a closed subscheme -/

section Closed

variable {X P : Scheme.{0}} {σ R : Type} [CommRing R] (C : a3m_SpecCharts P σ R) (i : X ⟶ P)
  [IsClosedImmersion i]

instance a3m_pullback_isAffine (j : σ) : IsAffine (pullback i (C.κ j)) :=
  isAffine_of_isAffineHom (pullback.snd i (C.κ j))

/-- The ring map `T_j → Γ(X ∩ chart)` of the restriction of a chart to a closed subscheme. -/
def a3m_restrictHom (j : σ) : C.T j ⟶ Γ(pullback i (C.κ j), ⊤) :=
  (Scheme.ΓSpecIso _).inv ≫ (pullback.snd i (C.κ j)).appTop

theorem a3m_restrictHom_surjective (j : σ) : Function.Surjective (a3m_restrictHom C i j) := by
  intro y
  obtain ⟨a, rfl⟩ := Scheme.Hom.app_surjective (pullback.snd i (C.κ j)) ⊤ (isAffineOpen_top _) y
  refine ⟨(Scheme.ΓSpecIso (C.T j)).hom a, ?_⟩
  rw [a3m_restrictHom, CommRingCat.comp_apply, Iso.hom_inv_id_apply]
  rfl

theorem a3m_isoSpec_inv_snd (j : σ) :
    (pullback i (C.κ j)).isoSpec.inv ≫ pullback.snd i (C.κ j) =
      Spec.map (a3m_restrictHom C i j) := by
  rw [← Scheme.isoSpec_inv_naturality, Scheme.isoSpec_Spec_inv, a3m_restrictHom, Spec.map_comp]

theorem a3m_i_restrict_κ (l : σ) (q : Spec Γ(pullback i (C.κ l), ⊤)) :
    i (((pullback i (C.κ l)).isoSpec.inv ≫ pullback.fst i (C.κ l)) q) =
      C.κ l (Spec.map (a3m_restrictHom C i l) q) := by
  rw [← Scheme.Hom.comp_apply, Category.assoc, pullback.condition, ← Category.assoc,
    a3m_isoSpec_inv_snd, Scheme.Hom.comp_apply]

theorem a3m_range_restrict_κ (j : σ) :
    Set.range ((pullback i (C.κ j)).isoSpec.inv ≫ pullback.fst i (C.κ j)) =
      i ⁻¹' Set.range (C.κ j) := by
  rw [Scheme.Hom.comp_base, TopCat.coe_comp, Set.range_comp,
    Set.range_eq_univ.2 (pullback i (C.κ j)).isoSpec.inv.surjective, Set.image_univ,
    Scheme.Pullback.range_fst]

/-- The restriction of projective `Spec`-charts to a closed subscheme. -/
def a3m_SpecCharts.restrict : a3m_SpecCharts X σ R where
  T j := Γ(pullback i (C.κ j), ⊤)
  κ j := (pullback i (C.κ j)).isoSpec.inv ≫ pullback.fst i (C.κ j)
  isOpenImmersion j := inferInstance
  cover x := by
    obtain ⟨j, p, hp⟩ := C.cover (i x)
    obtain ⟨z, hz, -⟩ := Scheme.Pullback.exists_preimage_pullback x p hp.symm
    refine ⟨j, (pullback i (C.κ j)).isoSpec.hom z, ?_⟩
    rw [← Scheme.Hom.comp_apply, ← Category.assoc, Iso.hom_inv_id, Category.id_comp, hz]
  θ j := (a3m_restrictHom C i j).hom.comp (C.θ j)
  θ_X_self j := by simp [C.θ_X_self]
  θ_surj j := (a3m_restrictHom_surjective C i j).comp (C.θ_surj j)
  inter j l q := by
    rw [a3m_range_restrict_κ, Set.mem_preimage, a3m_i_restrict_κ, C.inter]
    change C.θ l (MvPolynomial.X j) ∉ Ideal.comap (a3m_restrictHom C i l).hom q.asIdeal ↔ _
    rw [Ideal.mem_comap]
    rfl
  compat j l p p' h F e hF := by
    have h' := congrArg i h
    rw [a3m_i_restrict_κ, a3m_i_restrict_κ] at h'
    have := C.compat j l _ _ h' F e hF
    change C.θ j F ∈ Ideal.comap (a3m_restrictHom C i j).hom p.asIdeal ↔
      C.θ l F ∈ Ideal.comap (a3m_restrictHom C i l).hom p'.asIdeal at this
    rw [Ideal.mem_comap, Ideal.mem_comap] at this
    exact this

theorem a3m_SpecCharts.restrict_prime [Fintype σ] (x : X) :
    (C.restrict i).prime x = C.prime (i x) := by
  ext F
  obtain ⟨j, q, hq⟩ := (C.restrict i).cover x
  rw [a3m_SpecCharts.mem_prime_iff (C.restrict i) x j q hq,
    a3m_SpecCharts.mem_prime_iff C (i x) j (Spec.map (a3m_restrictHom C i j) q)
      (by rw [← hq]; exact (a3m_i_restrict_κ C i j q).symm)]
  rfl

theorem a3m_restrict_κ_comp (j : σ) :
    ((pullback i (C.κ j)).isoSpec.inv ≫ pullback.fst i (C.κ j)) ≫ i =
      Spec.map (a3m_restrictHom C i j) ≫ C.κ j := by
  rw [Category.assoc, pullback.condition, ← Category.assoc, a3m_isoSpec_inv_snd]

set_option maxHeartbeats 400000 in
/-- The overlap identity descends to the restriction to a closed subscheme. -/
theorem a3m_restrict_hov
    (hov : ∀ (j l : σ) (F : MvPolynomial σ R) (e : ℕ), F.IsHomogeneous e →
      (pullback.snd (C.κ j) (C.κ l)).appTop ((Scheme.ΓSpecIso _).inv (C.θ l F)) =
        (pullback.snd (C.κ j) (C.κ l)).appTop ((Scheme.ΓSpecIso _).inv (C.θ l (MvPolynomial.X j))) ^ e *
          (pullback.fst (C.κ j) (C.κ l)).appTop ((Scheme.ΓSpecIso _).inv (C.θ j F)))
    (j l : σ) (F : MvPolynomial σ R) (e : ℕ) (hF : F.IsHomogeneous e) :
    (pullback.snd ((C.restrict i).κ j) ((C.restrict i).κ l)).appTop
        ((Scheme.ΓSpecIso _).inv ((C.restrict i).θ l F)) =
      (pullback.snd ((C.restrict i).κ j) ((C.restrict i).κ l)).appTop
          ((Scheme.ΓSpecIso _).inv ((C.restrict i).θ l (MvPolynomial.X j))) ^ e *
        (pullback.fst ((C.restrict i).κ j) ((C.restrict i).κ l)).appTop
          ((Scheme.ΓSpecIso _).inv ((C.restrict i).θ j F)) := by
  set f₁ := pullback.fst ((C.restrict i).κ j) ((C.restrict i).κ l)
  set f₂ := pullback.snd ((C.restrict i).κ j) ((C.restrict i).κ l)
  have hcond : (f₁ ≫ Spec.map (a3m_restrictHom C i j)) ≫ C.κ j =
      (f₂ ≫ Spec.map (a3m_restrictHom C i l)) ≫ C.κ l := by
    have e1 := a3m_restrict_κ_comp C i j
    have e2 := a3m_restrict_κ_comp C i l
    rw [Category.assoc, Category.assoc]
    erw [← e1, ← e2]
    show f₁ ≫ (C.restrict i).κ j ≫ i = f₂ ≫ (C.restrict i).κ l ≫ i
    rw [← Category.assoc, pullback.condition, Category.assoc]
  let ρ := pullback.lift _ _ hcond
  have h := congrArg ρ.appTop.hom (hov j l F e hF)
  rw [map_mul, map_pow, ← a3m_appTop_comp_apply, ← a3m_appTop_comp_apply,
    ← a3m_appTop_comp_apply, pullback.lift_fst, pullback.lift_snd] at h
  have e : ∀ (m : σ) (f : pullback ((C.restrict i).κ j) ((C.restrict i).κ l) ⟶
      Spec ((C.restrict i).T m)) (G : MvPolynomial σ R),
      (f ≫ Spec.map (a3m_restrictHom C i m)).appTop ((Scheme.ΓSpecIso _).inv (C.θ m G)) =
        f.appTop ((Scheme.ΓSpecIso _).inv ((C.restrict i).θ m G)) :=
    fun m f G => a3m_appTop_comp_SpecMap f (a3m_restrictHom C i m) (C.θ m G)
  rw [e, e, e] at h
  exact h

end Closed

