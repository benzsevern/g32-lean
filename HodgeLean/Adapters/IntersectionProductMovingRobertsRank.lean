import HodgeLean.Adapters.IntersectionProductMovingRobertsSmooth

/-! # The rank of the differentials of the cone over a smooth projective variety

For an integral smooth projective `X ⊂ ℙᴺ` of dimension `n`, the cone ring `A = ℂ[x]/I_X` has
Kähler differentials of rank at most `n + 1` at every prime other than the vertex
(`a3t_rank`). Inverting a coordinate `x_j` outside the prime, the chart ring `T_j` of `X` maps to
`A_{x_j}` by `F ↦ F(x/x_j)` (`a3t_phi`, well defined by homogenization), and `A_{x_j}` is
generated by its image and `x_j^{±1}`, so the differentials of `A_{x_j}` are spanned by those of
`T_j` and `dx_j` (`a3t_span_D`). The chart `T_j` is a smooth domain of dimension `n`, whose
differentials have rank `n`.

Source: Hartshorne, *Algebraic Geometry*, II, Exercise 2.14, Theorem 8.15 and Exercise 8.4;
Stacks Project, Tag 00TT. HC no distance; AV milestone no distance.
-/

noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry MvPolynomial TensorProduct

namespace HodgeLean.Adapters

section Phi

attribute [local instance] MvPolynomial.gradedAlgebra

variable {Y : Scheme.{0}} {σ : Type} [Fintype σ] (C : a3m_SpecCharts Y σ ℂ) [IsIntegral Y] (j : σ)

/-- The cone ring `ℂ[x]/I`. -/
abbrev a3t_A := MvPolynomial σ ℂ ⧸ C.prime (genericPoint Y)

/-- The coordinate `x_j` in the cone ring. -/
abbrev a3t_x : a3t_A C := Ideal.Quotient.mk _ (X j)

/-- The cone ring with `x_j` inverted. -/
abbrev a3t_Ax := Localization.Away (a3t_x C j)

/-- `F ↦ F(x/x_j)` into the localized cone ring. -/
def a3t_phiT : MvPolynomial σ ℂ →+* a3t_Ax C j :=
  eval₂Hom (algebraMap ℂ _) fun k =>
    algebraMap (a3t_A C) _ (Ideal.Quotient.mk _ (X k)) * IsLocalization.Away.invSelf (a3t_x C j)

omit [Fintype σ] in
theorem a3t_phiT_X (k : σ) : a3t_phiT C j (X k) =
    algebraMap (a3t_A C) _ (Ideal.Quotient.mk _ (X k)) * IsLocalization.Away.invSelf (a3t_x C j) :=
  eval₂Hom_X' _ _ _

omit [Fintype σ] in
theorem a3t_phiT_X_self : a3t_phiT C j (X j) = 1 := by
  rw [a3t_phiT_X]
  exact IsLocalization.Away.mul_invSelf _

theorem a3t_phiT_of_isHomogeneous (G : MvPolynomial σ ℂ) (e : ℕ) (hG : G.IsHomogeneous e) :
    a3t_phiT C j G = IsLocalization.Away.invSelf (a3t_x C j) ^ e *
      algebraMap (a3t_A C) _ (Ideal.Quotient.mk _ G) := by
  refine a3m_twist (a3t_phiT C j) ((algebraMap (a3t_A C) (a3t_Ax C j)).comp (Ideal.Quotient.mk _))
    _ (fun r => ?_) (fun k => ?_) G e hG
  · simp only [a3t_phiT, coe_eval₂Hom, eval₂_C, RingHom.comp_apply]
    rw [← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap, ← IsScalarTower.algebraMap_apply]
  · rw [a3t_phiT_X, mul_comm]
    rfl

/-- `θ_j F = 0` forces `F(x/x_j) = 0`. -/
theorem a3t_phiT_eq_zero (hj : X j ∉ C.prime (genericPoint Y)) (F : MvPolynomial σ ℂ)
    (hF : C.θ j F = 0) : a3t_phiT C j F = 0 := by
  obtain ⟨p, hp⟩ : genericPoint Y ∈ Set.range (C.κ j) := by
    by_contra h
    exact hj ((C.X_mem_prime_iff _ j).2 h)
  have hmem : a3t_homog j F ∈ C.prime (genericPoint Y) := by
    rw [C.mem_prime_iff_of_isHomogeneous _ j p hp _ _ (a3t_homog_isHomogeneous j F),
      a3t_map_homog j (C.θ j) (C.θ_X_self j), hF]
    exact zero_mem _
  rw [← a3t_map_homog j (a3t_phiT C j) (a3t_phiT_X_self C j),
    a3t_phiT_of_isHomogeneous C j _ _ (a3t_homog_isHomogeneous j F),
    Ideal.Quotient.eq_zero_iff_mem.2 hmem, map_zero, mul_zero]

/-- The chart ring `T_j` maps to the localized cone ring. -/
def a3t_phi (hj : X j ∉ C.prime (genericPoint Y)) : C.T j →+* a3t_Ax C j :=
  (Ideal.Quotient.lift (RingHom.ker (C.θ j)) (a3t_phiT C j)
      (fun F hF => a3t_phiT_eq_zero C j hj F hF)).comp
    (RingHom.quotientKerEquivOfSurjective (C.θ_surj j)).symm.toRingHom

theorem a3t_phi_θ (hj : X j ∉ C.prime (genericPoint Y)) (F : MvPolynomial σ ℂ) :
    a3t_phi C j hj (C.θ j F) = a3t_phiT C j F := by
  have : (RingHom.quotientKerEquivOfSurjective (C.θ_surj j)).symm (C.θ j F) =
      Ideal.Quotient.mk _ F := by
    rw [RingEquiv.symm_apply_eq]
    rfl
  simp only [a3t_phi, RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom,
    this, Ideal.Quotient.lift_mk]

theorem a3t_phi_mul_x (hj : X j ∉ C.prime (genericPoint Y)) (k : σ) :
    a3t_phi C j hj (C.θ j (X k)) * algebraMap (a3t_A C) (a3t_Ax C j) (a3t_x C j) =
      algebraMap (a3t_A C) _ (Ideal.Quotient.mk _ (X k)) := by
  rw [a3t_phi_θ, a3t_phiT_X, mul_assoc, mul_comm (IsLocalization.Away.invSelf _),
    IsLocalization.Away.mul_invSelf, mul_one]

/-- The differentials of the localized cone ring are spanned by those of the chart ring and
`dx_j`. -/
theorem a3t_span_D (hj : X j ∉ C.prime (genericPoint Y)) :
    Submodule.span (a3t_Ax C j)
      (Set.range (fun t => KaehlerDifferential.D ℂ (a3t_Ax C j) (a3t_phi C j hj t)) ∪
        {KaehlerDifferential.D ℂ (a3t_Ax C j) (algebraMap (a3t_A C) _ (a3t_x C j))}) = ⊤ := by
  set A' := a3t_Ax C j
  set M := Submodule.span A'
    (Set.range (fun t => KaehlerDifferential.D ℂ A' (a3t_phi C j hj t)) ∪
      {KaehlerDifferential.D ℂ A' (algebraMap (a3t_A C) _ (a3t_x C j))})
  set D := KaehlerDifferential.D ℂ A'
  have hmul : ∀ a b : A', D a ∈ M → D b ∈ M → D (a * b) ∈ M := fun a b ha hb => by
    rw [Derivation.leibniz]; exact add_mem (M.smul_mem _ hb) (M.smul_mem _ ha)
  have hinv : ∀ b c : A', b * c = 1 → D b ∈ M → D c ∈ M := by
    intro b c hbc hb
    have h0 : b • D c + c • D b = 0 := by rw [← Derivation.leibniz, hbc, Derivation.map_one_eq_zero]
    have : D c = -(c • (c • D b)) := by
      calc D c = (c * b) • D c := by rw [mul_comm, hbc, one_smul]
        _ = c • (b • D c) := by rw [mul_smul]
        _ = c • (-(c • D b)) := by rw [eq_neg_of_add_eq_zero_left h0]
        _ = -(c • (c • D b)) := by rw [smul_neg]
    rw [this]
    exact neg_mem (M.smul_mem _ (M.smul_mem _ hb))
  have hA : ∀ F : MvPolynomial σ ℂ, D (algebraMap (a3t_A C) A' (Ideal.Quotient.mk _ F)) ∈ M := by
    intro F
    induction F using MvPolynomial.induction_on with
    | C c =>
      rw [← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap,
        ← IsScalarTower.algebraMap_apply, Derivation.map_algebraMap]
      exact zero_mem _
    | add F G hF hG =>
      rw [RingHom.map_add, RingHom.map_add, Derivation.map_add]; exact add_mem hF hG
    | mul_X F k hF =>
      rw [RingHom.map_mul, RingHom.map_mul]
      refine hmul _ _ hF ?_
      rw [← a3t_phi_mul_x C j hj k]
      exact hmul _ _ (Submodule.subset_span (Or.inl ⟨_, rfl⟩))
        (Submodule.subset_span (Or.inr rfl))
  rw [eq_top_iff, ← KaehlerDifferential.span_range_derivation ℂ A', Submodule.span_le]
  rintro _ ⟨a, rfl⟩
  obtain ⟨⟨y, s, hs⟩, rfl⟩ := IsLocalization.mk'_surjective (Submonoid.powers (a3t_x C j)) a
  obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective y
  obtain ⟨G, rfl⟩ := Ideal.Quotient.mk_surjective s
  have h1 : IsLocalization.mk' A' (Ideal.Quotient.mk _ F) ⟨Ideal.Quotient.mk _ G, hs⟩ =
      algebraMap (a3t_A C) A' (Ideal.Quotient.mk _ F) *
        IsLocalization.mk' A' (1 : a3t_A C) ⟨Ideal.Quotient.mk _ G, hs⟩ := by
    rw [← IsLocalization.mk'_one (M := Submonoid.powers (a3t_x C j)) A', ← IsLocalization.mk'_mul,
      mul_one, one_mul]
  change D (IsLocalization.mk' A' _ _) ∈ M
  rw [h1]
  refine hmul _ _ (hA F) (hinv _ _ ?_ (hA G))
  rw [mul_comm, IsLocalization.mk'_spec, map_one]

end Phi

/-- Over a field `K`, the tensors `1 ⊗ g` for `g` in an `S`-spanning set span `K ⊗_S M`. -/
theorem a3t_span_one_tmul {S M K : Type} [CommRing S] [AddCommGroup M] [Module S M] [Field K]
    [Algebra S K] (G : Set M) (hG : Submodule.span S G = ⊤) :
    Submodule.span K ((fun g => (1 : K) ⊗ₜ[S] g) '' G) = ⊤ := by
  have h1 : ∀ ω : M, (1 : K) ⊗ₜ[S] ω ∈ Submodule.span K ((fun g => (1 : K) ⊗ₜ[S] g) '' G) := by
    intro ω
    have hω : ω ∈ Submodule.span S G := hG ▸ Submodule.mem_top
    induction hω using Submodule.span_induction with
    | mem y hy => exact Submodule.subset_span ⟨y, hy, rfl⟩
    | zero => rw [tmul_zero]; exact zero_mem _
    | add y y' _ _ hy hy' => rw [tmul_add]; exact add_mem hy hy'
    | smul r y _ hy =>
      rw [← TensorProduct.smul_tmul, ← algebraMap_smul K r, smul_eq_mul, mul_one,
        show (algebraMap S K r) ⊗ₜ[S] y = (algebraMap S K r) • ((1 : K) ⊗ₜ[S] y) by
          rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]]
      exact Submodule.smul_mem _ _ hy
  refine eq_top_iff.2 fun z _ => ?_
  clear ‹z ∈ ⊤›
  induction z using TensorProduct.inductionOn with
  | tmul a ω =>
    have : a ⊗ₜ[S] ω = a • ((1 : K) ⊗ₜ[S] ω) := by
      rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
    rw [this]
    exact Submodule.smul_mem _ _ (h1 ω)
  | add y y' hy hy' => exact add_mem hy hy'

/-- The rank of the differentials of the affine cone over a smooth projective variety `X` of
dimension `n`, at a point other than the vertex, is at most `n + 1`. -/
theorem a3t_rank (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom]
    (n : ℕ) (hn : Order.height (genericPoint X.left) = n)
    (𝔶 : Ideal (MvPolynomial (Fin (a3s_N X + 1)) ℂ ⧸ a3s_IX X)) [𝔶.IsPrime]
    (hrel : ∃ j, Ideal.Quotient.mk (a3s_IX X) (MvPolynomial.X j) ∉ 𝔶) :
    Module.finrank 𝔶.ResidueField
      (𝔶.ResidueField ⊗[MvPolynomial (Fin (a3s_N X + 1)) ℂ ⧸ a3s_IX X]
        Ω[MvPolynomial (Fin (a3s_N X + 1)) ℂ ⧸ a3s_IX X⁄ℂ]) ≤ n + 1 := by
  classical
  set C := a3s_CX X
  obtain ⟨j, hj⟩ := hrel
  have hjX : MvPolynomial.X j ∉ C.prime (genericPoint X.left) := fun h => by
    have h0 : Ideal.Quotient.mk (a3s_IX X) (MvPolynomial.X j) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.2 h
    exact hj (h0 ▸ zero_mem _)
  set A := a3t_A C
  set A' := a3t_Ax C j
  set x := a3t_x C j
  set K := 𝔶.ResidueField
  have hxK : IsUnit (algebraMap A K x) :=
    isUnit_iff_ne_zero.2 fun h => hj (Ideal.algebraMap_residueField_eq_zero.1 h)
  let _ : Algebra A' K := (IsLocalization.Away.lift x hxK).toAlgebra
  have : IsScalarTower A A' K := IsScalarTower.of_algebraMap_eq fun a =>
    (IsLocalization.Away.lift_eq x hxK a).symm
  change Module.finrank K (K ⊗[A] Ω[A⁄ℂ]) ≤ n + 1
  rw [a3t_finrank_localization (S' := A') (Submonoid.powers x)]
  -- the chart ring
  set T := C.T j
  let _ : Algebra ℂ T := ((C.θ j).comp MvPolynomial.C).toAlgebra
  set φ := a3t_phi C j hjX
  let _ : Algebra T A' := φ.toAlgebra
  have : IsScalarTower ℂ T A' := IsScalarTower.of_algebraMap_eq fun c => by
    change _ = φ (C.θ j (MvPolynomial.C c))
    rw [a3t_phi_θ]
    simp [a3t_phiT]
    rfl
  let _ : Algebra T K := ((algebraMap A' K).comp φ).toAlgebra
  have : IsScalarTower T A' K := IsScalarTower.of_algebraMap_eq fun _ => rfl
  have hsm : Algebra.Smooth ℂ T := a3t_chart_smooth X j
  have : Algebra.FiniteType ℂ T := by
    let θa : MvPolynomial (Fin (a3s_N X + 1)) ℂ →ₐ[ℂ] T :=
      { C.θ j with commutes' := fun _ => rfl }
    exact Algebra.FiniteType.of_surjective θa (C.θ_surj j)
  -- `T` is a domain of dimension `n`
  obtain ⟨p₀, hp₀⟩ : genericPoint X.left ∈ Set.range (C.κ j) := by
    by_contra h
    exact hjX ((C.X_mem_prime_iff _ j).2 h)
  have : Nonempty (Spec T) := ⟨p₀⟩
  have : IsIntegral (Spec T) := isIntegral_of_isOpenImmersion (C.κ j)
  have : IsDomain T := (affine_isIntegral_iff T).1 inferInstance
  have hdimT : ringKrullDim T = n := by
    have h1 := a3m_height_openImmersion (Y := X) (C.κ j) (genericPoint (Spec T))
    rw [genericPoint_eq_of_isOpenImmersion, hn] at h1
    have h2 := hc9k8_height_spec T (genericPoint (Spec T))
    rw [← h1] at h2
    rw [genericPoint_eq_bot_of_affine] at h2
    rw [← ringKrullDim_eq_of_ringEquiv (RingEquiv.quotientBot T)]
    exact h2.symm
  have hTK : Module.finrank K (K ⊗[T] Ω[T⁄ℂ]) ≤ n := a3t_finrank_le_of_smooth n hdimT
  -- the map from the differentials of the chart
  let L : K ⊗[T] Ω[T⁄ℂ] →ₗ[K] K ⊗[A'] Ω[A'⁄ℂ] :=
    (LinearMap.baseChange K (KaehlerDifferential.mapBaseChange ℂ T A')) ∘ₗ
      (TensorProduct.AlgebraTensorModule.cancelBaseChange T A' K K Ω[T⁄ℂ]).symm.toLinearMap
  have hL : ∀ t : T, L ((1 : K) ⊗ₜ KaehlerDifferential.D ℂ T t) =
      (1 : K) ⊗ₜ KaehlerDifferential.D ℂ A' (φ t) := by
    intro t
    simp only [L, LinearMap.coe_comp, Function.comp_apply, LinearEquiv.coe_coe,
      TensorProduct.AlgebraTensorModule.cancelBaseChange_symm_tmul, LinearMap.baseChange_tmul,
      KaehlerDifferential.mapBaseChange_tmul, one_smul, KaehlerDifferential.map_D]
    rfl
  have : Algebra.FiniteType ℂ (MvPolynomial (Fin (a3s_N X + 1)) ℂ ⧸ a3s_IX X) :=
    Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ ℂ _) (Ideal.Quotient.mkₐ_surjective ℂ _)
  have : Algebra.FiniteType ℂ A' := Algebra.FiniteType.trans (S := A) inferInstance
    (IsLocalization.finiteType_of_monoid_fg (Submonoid.powers x) A')
  have : FiniteDimensional K (K ⊗[T] Ω[T⁄ℂ]) := inferInstance
  have : FiniteDimensional K (K ⊗[A'] Ω[A'⁄ℂ]) := inferInstance
  have hspan := a3t_span_one_tmul (K := K) _ (a3t_span_D C j hjX)
  set v := (1 : K) ⊗ₜ[A'] KaehlerDifferential.D ℂ A' (algebraMap A A' x)
  have hle : (⊤ : Submodule K (K ⊗[A'] Ω[A'⁄ℂ])) ≤ LinearMap.range L ⊔ Submodule.span K {v} := by
    rw [← hspan, Submodule.span_le]
    rintro _ ⟨g, hg, rfl⟩
    rcases hg with ⟨t, rfl⟩ | hg
    · exact Submodule.mem_sup_left ⟨_, hL t⟩
    · rw [Set.mem_singleton_iff] at hg
      subst hg
      exact Submodule.mem_sup_right (Submodule.subset_span rfl)
  calc Module.finrank K (K ⊗[A'] Ω[A'⁄ℂ])
      = Module.finrank K (⊤ : Submodule K (K ⊗[A'] Ω[A'⁄ℂ])) := (finrank_top K _).symm
    _ ≤ Module.finrank K (LinearMap.range L ⊔ Submodule.span K {v} : Submodule K _) :=
        Submodule.finrank_mono hle
    _ ≤ Module.finrank K (LinearMap.range L) + Module.finrank K (Submodule.span K {v}) :=
        Submodule.finrank_add_le_finrank_add_finrank _ _
    _ ≤ n + 1 := add_le_add ((LinearMap.finrank_range_le L).trans hTK)
        ((finrank_span_le_card ({v} : Set _)).trans (by simp))

end HodgeLean.Adapters
