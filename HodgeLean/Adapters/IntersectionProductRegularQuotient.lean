import HodgeLean.Adapters.IntersectionProductSerreVanishing

/-! # A regular quotient of a regular local ring

If `B` is a regular local ring of dimension `N` and `B ⧸ J` is a regular local ring of dimension
`c`, then `J` is generated by a weakly regular sequence of `N - c` elements of the maximal ideal
(`a3d_exists_regular_of_quotient`). Lift a basis of the span `P` of the classes of `J` in
`𝔪/𝔪²` to `xs ⊆ J` and a basis of `(𝔪/𝔪²)/P` to `zs`: `xs ++ zs` is a regular system of
parameters, so `xs` is weakly regular; `B ⧸ (xs)` is regular of dimension `c`, a domain, and the
prime `J ⧸ (xs)` has a quotient of the same dimension, so it is zero.

Source: Matsumura, *Commutative Ring Theory*, Theorem 14.2 and Theorem 21.2 (an ideal with
regular quotient in a regular local ring is generated by part of a regular system of
parameters). HC no distance; AV milestone no distance.
-/

open IsLocalRing

noncomputable section
namespace HodgeLean.Adapters
universe u

section cot
variable {B : Type u} [CommRing B] [IsLocalRing B] [IsNoetherianRing B]

omit [IsNoetherianRing B] in
/-- Every vector of `a3c_cotSub J` is the class of an element of `J`. -/
theorem a3d_exists_of_mem_cotSub (J : Ideal B) (v : CotangentSpace B)
    (hv : v ∈ a3c_cotSub J) :
    ∃ x : maximalIdeal B, (x : B) ∈ J ∧ (maximalIdeal B).toCotangent x = v := by
  induction hv using Submodule.span_induction with
  | mem v hv => exact hv
  | zero => exact ⟨0, J.zero_mem, map_zero _⟩
  | add v w _ _ hv hw =>
    obtain ⟨x, hx, rfl⟩ := hv
    obtain ⟨y, hy, rfl⟩ := hw
    exact ⟨x + y, J.add_mem hx hy, map_add _ _ _⟩
  | smul a v _ hv =>
    obtain ⟨x, hx, rfl⟩ := hv
    obtain ⟨b, rfl⟩ := IsLocalRing.residue_surjective a
    refine ⟨b • x, J.mul_mem_left b hx, ?_⟩
    rw [map_smul]
    exact (algebraMap_smul (ResidueField B) b _).symm

omit [IsNoetherianRing B] in
/-- The classes of the ideal generated by `ws` lie in the span of the classes of `ws`. -/
theorem a3d_cotSub_ofList_le (ws : List B) (hws : ∀ w ∈ ws, w ∈ maximalIdeal B) :
    a3c_cotSub (Ideal.ofList ws) ≤ Submodule.span (ResidueField B)
      ((maximalIdeal B).toCotangent '' {x : maximalIdeal B | (x : B) ∈ ws}) := by
  set W := Submodule.span (ResidueField B)
    ((maximalIdeal B).toCotangent '' {x : maximalIdeal B | (x : B) ∈ ws})
  have hle : Ideal.ofList ws ≤ maximalIdeal B := Ideal.span_le.mpr hws
  have key : ∀ x ∈ Ideal.ofList ws, ∀ h : x ∈ maximalIdeal B,
      (maximalIdeal B).toCotangent ⟨x, h⟩ ∈ W := by
    intro x hx
    induction hx using Submodule.span_induction with
    | mem x hx => exact fun h => Submodule.subset_span ⟨⟨x, h⟩, hx, rfl⟩
    | zero =>
      intro h
      have : (⟨0, h⟩ : maximalIdeal B) = 0 := rfl
      rw [this, map_zero]
      exact W.zero_mem
    | add x y hx hy ihx ihy =>
      intro h
      have : (⟨x + y, h⟩ : maximalIdeal B) = ⟨x, hle hx⟩ + ⟨y, hle hy⟩ := rfl
      rw [this, map_add]
      exact W.add_mem (ihx _) (ihy _)
    | smul b x hx ih =>
      intro h
      have : (⟨b • x, h⟩ : maximalIdeal B) = b • ⟨x, hle hx⟩ := rfl
      rw [this, map_smul, ← algebraMap_smul (ResidueField B) b]
      exact W.smul_mem _ (ih _)
  rw [a3c_cotSub, Submodule.span_le]
  rintro _ ⟨x, hx, rfl⟩
  exact key x hx x.2

/-- The span of the classes of `ws` has dimension at most the length of `ws`. -/
theorem a3d_finrank_cotSub_ofList_le (ws : List B) (hws : ∀ w ∈ ws, w ∈ maximalIdeal B) :
    Module.finrank (ResidueField B) (a3c_cotSub (Ideal.ofList ws)) ≤ ws.length := by
  classical
  have hsub : {x : maximalIdeal B | (x : B) ∈ ws} ⊆
      ((ws.attach.map fun w => (⟨w.1, hws w.1 w.2⟩ : maximalIdeal B)).toFinset : Set _) := by
    intro x hx
    simp only [List.coe_toFinset, Set.mem_ofPred_eq, List.mem_map, List.mem_attach, true_and,
      Subtype.exists] at hx ⊢
    exact ⟨x, hx, rfl⟩
  have himg : (maximalIdeal B).toCotangent '' {x : maximalIdeal B | (x : B) ∈ ws} ⊆
      (((ws.attach.map fun w => (⟨w.1, hws w.1 w.2⟩ : maximalIdeal B)).toFinset.image
        (maximalIdeal B).toCotangent : Finset _) : Set _) := by
    rw [Finset.coe_image]
    exact Set.image_mono hsub
  refine (Submodule.finrank_mono (a3d_cotSub_ofList_le ws hws)).trans <|
    (Submodule.finrank_mono (Submodule.span_mono himg)).trans <|
      (finrank_span_finset_le_card _).trans ?_
  refine Finset.card_image_le.trans ((List.toFinset_card_le _).trans ?_)
  simp

end cot

/-- A regular local quotient of a regular local ring is cut out by a weakly regular sequence:
if `B` is regular local of dimension `N` and `B ⧸ J` is regular local of dimension `c`, then
`J = (x₁, …, x_{N-c})` for a weakly regular sequence in the maximal ideal.
Source: Matsumura, *Commutative Ring Theory*, Theorem 14.2 and Theorem 21.2; Serre,
*Algèbre locale, multiplicités*, Chapitre IV, D, Proposition 22. -/
theorem a3d_exists_regular_of_quotient (B : Type u) [CommRing B] [IsRegularLocalRing B]
    (J : Ideal B) [IsRegularLocalRing (B ⧸ J)] (N c : ℕ) (hN : ringKrullDim B = N)
    (hc : ringKrullDim (B ⧸ J) = c) :
    ∃ xs : List B, xs.length + c = N ∧ (∀ x ∈ xs, x ∈ maximalIdeal B) ∧
      RingTheory.Sequence.IsWeaklyRegular B xs ∧ Ideal.ofList xs = J := by
  classical
  set k := ResidueField B
  set V := CotangentSpace B
  have hJtop : J ≠ ⊤ := fun h => by
    have : Nontrivial (B ⧸ J) := inferInstance
    rw [Ideal.Quotient.nontrivial_iff] at this
    exact this h
  have hJ : J ≤ maximalIdeal B := IsLocalRing.le_maximalIdeal hJtop
  -- the cotangent space has dimension `N`
  have hV : Module.finrank k V = N := by
    have h1 := IsRegularLocalRing.spanFinrank_maximalIdeal (R := B)
    rw [hN, spanFinrank_maximalIdeal_eq_finrank_cotangentSpace] at h1
    exact_mod_cast h1
  set P := a3c_cotSub J
  set r := Module.finrank k P
  -- lifts of a basis of `P` into `J`
  let bP := Module.finBasis k P
  have hx : ∀ i, ∃ x : maximalIdeal B, (x : B) ∈ J ∧
      (maximalIdeal B).toCotangent x = (bP i : V) :=
    fun i => a3d_exists_of_mem_cotSub J _ (bP i).2
  choose x hxJ hxv using hx
  -- lifts of a basis of `V ⧸ P`
  let bQ := Module.finBasis k (V ⧸ P)
  have hv : ∀ i, ∃ v : V, P.mkQ v = bQ i := fun i => P.mkQ_surjective _
  choose v hv using hv
  have hz : ∀ i, ∃ z : maximalIdeal B, (maximalIdeal B).toCotangent z = v i :=
    fun i => (maximalIdeal B).toCotangent_surjective _
  choose z hz using hz
  set xs := List.ofFn (fun i => (x i : B))
  set zs := List.ofFn (fun i => (z i : B))
  have hxs_len : xs.length = r := List.length_ofFn
  have hzs_len : zs.length = Module.finrank k (V ⧸ P) := List.length_ofFn
  have hsum : Module.finrank k (V ⧸ P) + r = N := by
    rw [← hV]
    exact Submodule.finrank_quotient_add_finrank P
  have hxs_m : ∀ w ∈ xs, w ∈ maximalIdeal B := by
    intro w hw
    obtain ⟨i, rfl⟩ := List.mem_ofFn.mp hw
    exact (x i).2
  have hzs_m : ∀ w ∈ zs, w ∈ maximalIdeal B := by
    intro w hw
    obtain ⟨i, rfl⟩ := List.mem_ofFn.mp hw
    exact (z i).2
  have hxs_J : Ideal.ofList xs ≤ J := by
    refine Ideal.span_le.mpr fun w hw => ?_
    obtain ⟨i, rfl⟩ := List.mem_ofFn.mp hw
    exact hxJ i
  -- `xs ++ zs` generates the maximal ideal
  have hgen : Ideal.ofList (xs ++ zs) = maximalIdeal B := by
    let S : Set (maximalIdeal B) := Set.range x ∪ Set.range z
    have hspan : Submodule.span k ((maximalIdeal B).toCotangent '' S) = ⊤ := by
      have h1 : P ≤ Submodule.span k ((maximalIdeal B).toCotangent '' S) := by
        have : P = Submodule.span k (Set.range fun i => (bP i : V)) := by
          have h := congrArg (Submodule.map P.subtype) bP.span_eq
          rw [Submodule.map_span, Submodule.map_top, Submodule.range_subtype,
            ← Set.range_comp] at h
          exact h.symm
        rw [this, Submodule.span_le]
        rintro _ ⟨i, rfl⟩
        exact Submodule.subset_span ⟨x i, Or.inl ⟨i, rfl⟩, hxv i⟩
      have h2 : Submodule.span k (Set.range v) ≤
          Submodule.span k ((maximalIdeal B).toCotangent '' S) := by
        rw [Submodule.span_le]
        rintro _ ⟨i, rfl⟩
        exact Submodule.subset_span ⟨z i, Or.inr ⟨i, rfl⟩, hz i⟩
      have h3 : P ⊔ Submodule.span k (Set.range v) = ⊤ := by
        rw [← Submodule.map_mkQ_eq_top, Submodule.map_span, ← Set.range_comp]
        have : (P.mkQ ∘ v) = bQ := funext hv
        rw [this, bQ.span_eq]
      exact eq_top_iff.mpr (h3 ▸ sup_le h1 h2)
    rw [IsLocalRing.CotangentSpace.span_image_eq_top_iff] at hspan
    refine le_antisymm (Ideal.span_le.mpr fun w hw => ?_) fun m hm => ?_
    · rcases List.mem_append.mp hw with h | h
      · exact hxs_m w h
      · exact hzs_m w h
    · have hm' : (⟨m, hm⟩ : maximalIdeal B) ∈ Submodule.span B S := hspan ▸ Submodule.mem_top
      have : Submodule.map (maximalIdeal B).subtype (Submodule.span B S) ≤
          Ideal.ofList (xs ++ zs) := by
        rw [Submodule.map_span, Submodule.span_le]
        rintro _ ⟨y, hy, rfl⟩
        refine Ideal.subset_span ?_
        rcases hy with ⟨i, rfl⟩ | ⟨i, rfl⟩
        · exact List.mem_append_left _ (List.mem_ofFn.mpr ⟨i, rfl⟩)
        · exact List.mem_append_right _ (List.mem_ofFn.mpr ⟨i, rfl⟩)
      exact this ⟨_, hm', rfl⟩
  have hlenN : (xs ++ zs).length = N := by
    rw [List.length_append, hxs_len, hzs_len]
    omega
  obtain ⟨-, hreg⟩ := a3c_isDomain_isWeaklyRegular N B hN (xs ++ zs) hlenN hgen
  rw [RingTheory.Sequence.isWeaklyRegular_append_iff] at hreg
  -- the dimension count `N ≤ r + c`
  have hc_le : N ≤ r + c := by
    obtain ⟨ws, hwlen, hws⟩ := a3c_exists_list_ofList_eq_maximalIdeal (B ⧸ J)
    have hwc : (maximalIdeal (B ⧸ J)).spanFinrank = c := by
      have h1 := IsRegularLocalRing.spanFinrank_maximalIdeal (R := B ⧸ J)
      rw [hc] at h1
      exact_mod_cast h1
    let s : B ⧸ J → B := Function.surjInv Ideal.Quotient.mk_surjective
    have hs : ∀ y, Ideal.Quotient.mk J (s y) = y :=
      Function.surjInv_eq Ideal.Quotient.mk_surjective
    have hlocal : IsLocalHom (Ideal.Quotient.mk J) :=
      IsLocalHom.of_surjective _ Ideal.Quotient.mk_surjective
    have hws_m : ∀ w ∈ ws.map s, w ∈ maximalIdeal B := by
      intro w hw
      obtain ⟨y, hy, rfl⟩ := List.mem_map.mp hw
      rw [← IsLocalRing.maximalIdeal_comap (Ideal.Quotient.mk J), Ideal.mem_comap, hs]
      exact hws ▸ Ideal.subset_span hy
    have hsup : J ⊔ Ideal.ofList (ws.map s) = maximalIdeal B := by
      have hmap : (Ideal.ofList (ws.map s)).map (Ideal.Quotient.mk J) = maximalIdeal (B ⧸ J) := by
        rw [Ideal.map_ofList, List.map_map]
        convert hws using 2
        conv_rhs => rw [← List.map_id ws]
        exact List.map_congr_left fun y _ => hs y
      have := congrArg (Ideal.comap (Ideal.Quotient.mk J)) hmap
      rw [Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective,
        IsLocalRing.maximalIdeal_comap, ← RingHom.ker_eq_comap_bot, Ideal.mk_ker] at this
      rw [sup_comm]
      exact this
    have h1 := a3c_finrank_le_cotSub_add J (Ideal.ofList (ws.map s)) hJ
      (Ideal.span_le.mpr hws_m) hsup
    have h2 := a3d_finrank_cotSub_ofList_le (ws.map s) hws_m
    rw [List.length_map, hwlen, hwc] at h2
    rw [hV] at h1
    have hr : Module.finrank (ResidueField B) (a3c_cotSub J) = r := rfl
    omega
  -- the quotient by `xs`
  set I := Ideal.ofList xs
  have hItop : I ≠ ⊤ := ne_top_of_le_ne_top hJtop hxs_J
  have : Nontrivial (B ⧸ I) := Ideal.Quotient.nontrivial_iff.mpr hItop
  have : IsLocalRing (B ⧸ I) := .of_surjective' _ Ideal.Quotient.mk_surjective
  have hmI : Ideal.ofList (zs.map (Ideal.Quotient.mk I)) = maximalIdeal (B ⧸ I) := by
    rw [← Ideal.map_ofList, ← IsLocalRing.map_maximalIdeal_of_surjective _
      Ideal.Quotient.mk_surjective, ← hgen, Ideal.ofList_append, Ideal.map_sup,
      Ideal.map_quotient_self, bot_sup_eq]
  have hdim_le : ringKrullDim (B ⧸ I) ≤ (N - r : ℕ) := by
    have := a3c_ringKrullDim_le_length _ hmI
    rw [List.length_map, hzs_len] at this
    convert this using 2
    omega
  have hdim_ge : (c : WithBot ℕ∞) ≤ ringKrullDim (B ⧸ I) := by
    rw [← hc]
    exact ringKrullDim_le_of_surjective (Ideal.Quotient.factor hxs_J)
      (Ideal.Quotient.factor_surjective hxs_J)
  have hdimI : ringKrullDim (B ⧸ I) = (N - r : ℕ) := by
    refine le_antisymm hdim_le (le_trans ?_ hdim_ge)
    exact_mod_cast (by omega : N - r ≤ c)
  obtain ⟨hdomI, -⟩ := a3c_isDomain_isWeaklyRegular (N - r) (B ⧸ I) hdimI
    (zs.map (Ideal.Quotient.mk I)) (by rw [List.length_map, hzs_len]; omega) hmI
  -- the prime `J ⧸ I` is zero
  have hJI : J ≤ I := by
    set J' := J.map (Ideal.Quotient.mk I)
    have e : (B ⧸ I) ⧸ J' ≃+* B ⧸ J := DoubleQuot.quotQuotEquivQuotOfLE hxs_J
    have hJ'prime : J'.IsPrime := by
      have : IsDomain (B ⧸ J) := (a3c_exists_regular_sop (B ⧸ J)).choose_spec.2.2.1
      rw [← Ideal.Quotient.isDomain_iff_prime]
      exact e.toMulEquiv.isDomain _
    have hJ'bot : J' = ⊥ := by
      by_contra hne
      have hlt : (⊥ : Ideal (B ⧸ I)) < J' := bot_lt_iff_ne_bot.mpr hne
      have h := a3s_ringKrullDim_quotient_add_one_le hlt
      rw [ringKrullDim_eq_of_ringEquiv e, hc,
        ringKrullDim_eq_of_ringEquiv (RingEquiv.quotientBot (B ⧸ I)), hdimI] at h
      have : c + 1 ≤ N - r := by exact_mod_cast h
      omega
    intro y hy
    have : Ideal.Quotient.mk I y ∈ J' := Ideal.mem_map_of_mem _ hy
    rw [hJ'bot, Ideal.mem_bot, Ideal.Quotient.eq_zero_iff_mem] at this
    exact this
  have hcr : c ≤ N - r := by
    have := hdimI ▸ hdim_ge
    exact_mod_cast this
  refine ⟨xs, by omega, hxs_m, hreg.1, le_antisymm hxs_J hJI⟩

end HodgeLean.Adapters
