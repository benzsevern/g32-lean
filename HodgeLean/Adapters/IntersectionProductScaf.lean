/-- Equal dimensions of all component fibres prevent non-generic contributions to the section. -/
theorem IntersectionProductScaf_section_components_of_equal_height
    (Y : Over (Spec ↧ℂ)) [LocallyOfFiniteType Y.hom] (J : Y.left.IdealSheafData)
    (d : ℕ∞)
    (hheight : ∀ z ∈ genericPoints Y.left,
      ∀ u ∈ genericPoints ((ccm3_primeIdeal Y.left z).comap J.subschemeι).subscheme,
        height (J.subschemeι (((ccm3_primeIdeal Y.left z).comap J.subschemeι).subschemeι u)) = d) :
    ∀ z ∈ genericPoints Y.left,
      ∀ u ∈ genericPoints ((ccm3_primeIdeal Y.left z).comap J.subschemeι).subscheme,
        ((ccm3_primeIdeal Y.left z).comap J.subschemeι).subschemeι u ∈ genericPoints J.subscheme := by
  intro z hz u hu
  let w := ((ccm3_primeIdeal Y.left z).comap J.subschemeι).subschemeι u
  obtain ⟨v, hv, hvw⟩ := IntersectionProductScaf_exists_component_generalization J.subscheme w
  obtain ⟨z', hz', hzv⟩ := IntersectionProductScaf_exists_component_generalization Y.left
    (J.subschemeι v)
  let P := (ccm3_primeIdeal Y.left z').comap J.subschemeι
  have hmem : v ∈ (P.support : Set J.subscheme) := by
    rw [Scheme.IdealSheafData.support_comap, TopologicalSpace.Closeds.coe_preimage]
    change J.subschemeι v ∈ ((ccm3_primeIdeal Y.left z').support : Set Y.left)
    simpa only [ccm3_primeIdeal, Scheme.IdealSheafData.coe_support_vanishingIdeal,
      TopologicalSpace.Closeds.coe_mk] using specializes_iff_mem_closure.mp hzv
  let t : P.subscheme := ⟨v, hmem⟩
  obtain ⟨t', ht', htt⟩ := IntersectionProductScaf_exists_component_generalization P.subscheme t
  have htv : P.subschemeι t' ⤳ v := htt.map P.subschemeι.continuous
  have htw : J.subschemeι (P.subschemeι t') ⤳ J.subschemeι w :=
    (htv.trans hvw).map J.subschemeι.continuous
  have he : J.subschemeι (P.subschemeι t') = J.subschemeι w :=
    IntersectionProductScaf_specialization_eq_of_height Y htw
      ((hheight z' hz' t' ht').trans (hheight z hz u hu).symm)
  have he' : P.subschemeι t' = w := J.subschemeι.isEmbedding.injective he
  have hwv : w ⤳ v := he' ▸ htv
  have hvw' : v = w := (hvw.antisymm hwv).eq
  change w ∈ genericPoints J.subscheme
  exact hvw' ▸ hv
#print axioms IntersectionProductScaf_section_components_of_equal_height

