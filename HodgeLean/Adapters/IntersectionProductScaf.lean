/-- Every scheme point has a component generic point as a generalization. -/
theorem IntersectionProductScaf_exists_component_generalization
    (Y : Scheme) (x : Y) : ∃ z ∈ genericPoints Y, z ⤳ x := by
  obtain ⟨C, hC, hsub⟩ := exists_mem_irreducibleComponents_subset_of_isIrreducible
    (closure ({x} : Set Y)) isIrreducible_singleton.closure
  let z := hC.1.genericPoint
  have hz : closure ({z} : Set Y) = C :=
    hC.1.isGenericPoint_genericPoint (isClosed_of_mem_irreducibleComponents C hC)
  refine ⟨z, ?_, ?_⟩
  · change closure ({z} : Set Y) ∈ irreducibleComponents Y
    rwa [hz]
  · apply specializes_iff_mem_closure.mpr
    rw [hz]
    exact hsub (subset_closure (Set.mem_singleton x))
#print axioms IntersectionProductScaf_exists_component_generalization


