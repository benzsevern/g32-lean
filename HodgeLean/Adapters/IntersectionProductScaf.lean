    a3n_T X ⟶ a3n_T (a3h_PnO n) :=
  IntersectionProductScaf_familyFibreMap (IntersectionProductScaf_retainedSquareMap X hfin M) c hc


/-- Evaluation of the retained map agrees with restriction of the square projection. -/
theorem IntersectionProductScaf_squareFibreMap_eq
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] {n : ℕ}
