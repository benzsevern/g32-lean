/-- Taking the product with the projective parameter preserves finiteness of the projection. -/
theorem IntersectionProductScaf_projectionProduct_finite
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] {n : ℕ}
    {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite) :
    IsFinite (a3h_G (a3h_πO X hfin)).left := by
  rw [Over.whiskerRight_left]
  exact MorphismProperty.pullbackMap (P := @IsFinite)
    (inferInstance : IsFinite (a3h_πO X hfin).left)
    (inferInstance : IsFinite (𝟙 a3n_P1.left))
    (Over.w (a3h_πO X hfin)).symm (Category.id_comp _).symm
#print axioms IntersectionProductScaf_projectionProduct_finite


/-- The finite projection still lifts generalizations after adjoining the original projective parameter. -/
theorem IntersectionProductScaf_projectionProduct_generalizing
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (hn : Order.height (genericPoint X.left) = n) :
    GeneralizingMap (a3h_G (a3h_πO X hfin)).left := by
  have : Smooth (a3h_PnO n).hom := IntersectionProductScaf_projective_smooth n
  have : IsIntegral (a3h_PnO n).left :=
    IntersectionProductScaf_projectionTarget_integral X hfin hn
  have : MorphismProperty.IsStableUnderComposition (@Surjective.{0}) :=
    ⟨fun f g hf hg => ⟨hg.1.comp hf.1⟩⟩
  have : Surjective (a3h_πO X hfin).left :=
    ⟨a3h_π_surjective X hfin (a3h_dim_cone X n hn)⟩
  have : IsFinite (a3h_G (a3h_πO X hfin)).left := by
    rw [Over.whiskerRight_left]
    exact MorphismProperty.pullbackMap (P := @IsFinite)
      (inferInstance : IsFinite (a3h_πO X hfin).left)
      (inferInstance : IsFinite (𝟙 a3n_P1.left))
      (Over.w (a3h_πO X hfin)).symm (Category.id_comp _).symm
  have : Surjective (a3h_G (a3h_πO X hfin)).left := by
    rw [Over.whiskerRight_left]
    exact MorphismProperty.pullbackMap (P := @Surjective)
      (inferInstance : Surjective (a3h_πO X hfin).left)
      (inferInstance : Surjective (𝟙 a3n_P1.left))
      (Over.w (a3h_πO X hfin)).symm (Category.id_comp _).symm
  exact IntersectionProductScaf_finite_normal_generalizing _
    (zmtiso_normal_of_smooth (a3n_T (a3h_PnO n)).left (a3n_T (a3h_PnO n)).hom)
#print axioms IntersectionProductScaf_projectionProduct_generalizing

/-- The prime pullback under the product projection has its support on the corresponding fibre. -/
theorem IntersectionProductScaf_projectionProduct_pullback_support
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom]
    {n : ℕ} {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (hn : Order.height (genericPoint X.left) = n)
    (z : (a3n_T (a3h_PnO n)).left) (y : (a3n_T X).left) :
    ccm3_flatPullbackPrime (a3h_G (a3h_πO X hfin)).left z y ≠ 0 ↔
      (a3h_G (a3h_πO X hfin)).left y = z := by
  have := IntersectionProductScaf_projectionProduct_finite X hfin
  exact IntersectionProductScaf_pullbackPrime_support_iff (a3h_G (a3h_πO X hfin))
    (IntersectionProductScaf_projectionProduct_generalizing (X := X) a hfin hn) z y
