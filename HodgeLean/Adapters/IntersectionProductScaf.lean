        (Function.locallyFinsuppWithin.single y 1)) w ≠ 0) :
    w ∈ a3h_U (a3n_T X) := by
  rw [IntersectionProductScaf_theta₁_push_single, a3m_smul_apply] at hw
  exact IntersectionProductScaf_theta₁_single_mem_U X hfin M _ w
    (mul_ne_zero_iff.mp hw).2

