/-- Base change of the invertible parameter ring is the determinant localization of the
polynomial ring over the chosen coefficient algebra. -/
def IntersectionProductScaf_parameterTensorEquiv
    (R : Type*) [CommRing R] [Algebra ℂ R] (M : σ × σ → ℂ) :
    TensorProduct ℂ R (IntersectionProductScaf_lineRing M) ≃+*
      Localization.Away ((IntersectionProductScaf_lineDet M).map (algebraMap ℂ R)) :=
  (IsLocalization.Away.tensorProductEquivTMulRight ℂ R
    (IntersectionProductScaf_lineDet M) (IntersectionProductScaf_lineRing M)).toRingEquiv.trans
    (IsLocalization.ringEquivOfRingEquiv
      (M := Submonoid.powers (TensorProduct.tmul ℂ (1 : R) (IntersectionProductScaf_lineDet M)))
      (T := Submonoid.powers ((IntersectionProductScaf_lineDet M).map (algebraMap ℂ R)))
      (Localization.Away (TensorProduct.tmul ℂ (1 : R) (IntersectionProductScaf_lineDet M)))
      (Localization.Away ((IntersectionProductScaf_lineDet M).map (algebraMap ℂ R)))
      (polyEquivTensor ℂ R).symm.toRingEquiv (by simp))

/-- Elementary tensors become coefficient multiples of parameter polynomials after localization. -/
theorem IntersectionProductScaf_parameterTensorEquiv_tmul
    (R : Type*) [CommRing R] [Algebra ℂ R] (M : σ × σ → ℂ)
    (r : R) (p : Polynomial ℂ) :
    IntersectionProductScaf_parameterTensorEquiv R M
      (TensorProduct.tmul ℂ r
        (algebraMap (Polynomial ℂ) (IntersectionProductScaf_lineRing M) p)) =
      algebraMap (Polynomial R)
        (Localization.Away ((IntersectionProductScaf_lineDet M).map (algebraMap ℂ R)))
        (r • p.map (algebraMap ℂ R)) := by
  simp [IntersectionProductScaf_parameterTensorEquiv,
    IsLocalization.ringEquivOfRingEquiv_eq]

#print axioms IntersectionProductScaf_parameterTensorEquiv_tmul

/-- Extend normalized cone coordinates by the translation parameter and invert its determinant. -/
def IntersectionProductScaf_familyChartConeMap
    (M : σ × σ → ℂ) (j : Fin (a3s_N X + 1))
    (hj : MvPolynomial.X j ∉ (a3s_CX X).prime (genericPoint X.left)) :
    letI : Algebra ℂ ((a3s_CX X).T j) :=
      (((a3s_CX X).θ j).comp MvPolynomial.C).toAlgebra
    Localization.Away ((IntersectionProductScaf_lineDet M).map
      (algebraMap ℂ ((a3s_CX X).T j))) →+*
      Localization.Away ((Polynomial.mapRingHom (a3t_phi (a3s_CX X) j hj))
        ((IntersectionProductScaf_lineDet M).map (algebraMap ℂ ((a3s_CX X).T j)))) := by
  letI : Algebra ℂ ((a3s_CX X).T j) :=
    (((a3s_CX X).θ j).comp MvPolynomial.C).toAlgebra
  exact IsLocalization.Away.map _ _ (Polynomial.mapRingHom (a3t_phi (a3s_CX X) j hj))
    ((IntersectionProductScaf_lineDet M).map (algebraMap ℂ ((a3s_CX X).T j)))

/-- Every component of the localized chart ideal lifts to its normalized cone ideal. -/
theorem IntersectionProductScaf_familyChartConeMap_minimalPrime
    (M : σ × σ → ℂ) (j : Fin (a3s_N X + 1))
    (hj : MvPolynomial.X j ∉ (a3s_CX X).prime (genericPoint X.left)) :
    letI : Algebra ℂ ((a3s_CX X).T j) :=
      (((a3s_CX X).θ j).comp MvPolynomial.C).toAlgebra
    ∀ I P : Ideal (Localization.Away ((IntersectionProductScaf_lineDet M).map
      (algebraMap ℂ ((a3s_CX X).T j)))), P ∈ I.minimalPrimes →
      ∃ Q ∈ (Ideal.map (IntersectionProductScaf_familyChartConeMap X M j hj) I).minimalPrimes,
        Q.comap (IntersectionProductScaf_familyChartConeMap X M j hj) = P := by
  letI : Algebra ℂ ((a3s_CX X).T j) :=
    (((a3s_CX X).θ j).comp MvPolynomial.C).toAlgebra
  intro I P hP
  exact IntersectionProductScaf_chart_polynomial_away_minimalPrime (a3s_CX X) j hj _ I P hP

#print axioms IntersectionProductScaf_familyChartConeMap_minimalPrime

/-- The family cone map applies normalized cone coordinates coefficientwise to parameter polynomials. -/
theorem IntersectionProductScaf_familyChartConeMap_algebraMap
    (M : σ × σ → ℂ) (j : Fin (a3s_N X + 1))
    (hj : MvPolynomial.X j ∉ (a3s_CX X).prime (genericPoint X.left))
    (F : Polynomial ((a3s_CX X).T j)) :
    letI : Algebra ℂ ((a3s_CX X).T j) :=
      (((a3s_CX X).θ j).comp MvPolynomial.C).toAlgebra
    IntersectionProductScaf_familyChartConeMap X M j hj (algebraMap _ _ F) =
      algebraMap _ _ ((Polynomial.mapRingHom (a3t_phi (a3s_CX X) j hj)) F) := by
  letI : Algebra ℂ ((a3s_CX X).T j) :=
    (((a3s_CX X).θ j).comp MvPolynomial.C).toAlgebra
  dsimp only [IntersectionProductScaf_familyChartConeMap]
  rw [IsLocalization.Away.map, IsLocalization.map_eq]

#print axioms IntersectionProductScaf_familyChartConeMap_algebraMap

attribute [local instance] MvPolynomial.gradedAlgebra in
/-- The actual family chart ideal extends to the homogeneous translated ideal on the localized cone. -/
theorem IntersectionProductScaf_familyChartConeMap_ideal
    (M : σ × σ → ℂ) (j : Fin (a3s_N X + 1))
    (hj : MvPolynomial.X j ∉ (a3s_CX X).prime (genericPoint X.left))
    (ℓ : Matrix σ (Fin (a3s_N X + 1)) ℂ)
    (I : Ideal (MvPolynomial σ ℂ))
    (hI : I.IsHomogeneous (MvPolynomial.homogeneousSubmodule σ ℂ)) :
    letI : Algebra ℂ ((a3s_CX X).T j) :=
      (((a3s_CX X).θ j).comp MvPolynomial.C).toAlgebra
    Ideal.map (IntersectionProductScaf_familyChartConeMap X M j hj)
      (Ideal.map (algebraMap _ _)
        (Ideal.map (Polynomial.mapRingHom (((a3s_CX X).θ j).comp (a3r_lin ℓ).toRingHom))
          (Ideal.map (IntersectionProductScaf_substLine0 M).toRingHom I))) =
      Ideal.map (algebraMap _ _)
        (Ideal.map (Polynomial.mapRingHom
          ((algebraMap (a3t_A (a3s_CX X)) (a3t_Ax (a3s_CX X) j)).comp
            ((Ideal.Quotient.mk _).comp (a3r_lin ℓ).toRingHom)))
          (Ideal.map (IntersectionProductScaf_substLine0 M).toRingHom I)) := by
  letI : Algebra ℂ ((a3s_CX X).T j) :=
    (((a3s_CX X).θ j).comp MvPolynomial.C).toAlgebra
  let L := Localization.Away ((Polynomial.mapRingHom (a3t_phi (a3s_CX X) j hj))
    ((IntersectionProductScaf_lineDet M).map (algebraMap ℂ ((a3s_CX X).T j))))
  calc
    _ = Ideal.map (algebraMap (Polynomial (a3t_Ax (a3s_CX X) j)) L)
        (Ideal.map ((Polynomial.mapRingHom
          ((a3t_phi (a3s_CX X) j hj).comp
            (((a3s_CX X).θ j).comp (a3r_lin ℓ).toRingHom))).comp
              (IntersectionProductScaf_substLine0 M).toRingHom) I) := by
      simp only [Ideal.map_map]
      apply congrArg (fun f : MvPolynomial σ ℂ →+* L => Ideal.map f I)
      apply RingHom.ext
      intro F
      simp only [RingHom.comp_apply]
      rw [IntersectionProductScaf_familyChartConeMap_algebraMap]
      change algebraMap _ _ (((IntersectionProductScaf_substLine0 M F).map
        (((a3s_CX X).θ j).comp (a3r_lin ℓ).toRingHom)).map
          (a3t_phi (a3s_CX X) j hj)) = _
      rw [Polynomial.map_map]
      rfl
    _ = _ := by
      rw [IntersectionProductScaf_chart_substLine0_ideal (a3s_CX X) j hj ℓ M I hI]
      simp only [Ideal.map_map]
      rfl

#print axioms IntersectionProductScaf_familyChartConeMap_ideal

/-- The normalized cone map preserves scalar polynomials in the family parameter. -/
theorem IntersectionProductScaf_familyChartConeMap_parameter
    (M : σ × σ → ℂ) (j : Fin (a3s_N X + 1))
    (hj : MvPolynomial.X j ∉ (a3s_CX X).prime (genericPoint X.left))
    (p : Polynomial ℂ) :
    letI : Algebra ℂ ((a3s_CX X).T j) :=
      (((a3s_CX X).θ j).comp MvPolynomial.C).toAlgebra
    IntersectionProductScaf_familyChartConeMap X M j hj
      (algebraMap _ _ (p.map (algebraMap ℂ ((a3s_CX X).T j)))) =
      algebraMap _ _ (p.map (algebraMap ℂ (a3t_Ax (a3s_CX X) j))) := by
  letI : Algebra ℂ ((a3s_CX X).T j) :=
    (((a3s_CX X).θ j).comp MvPolynomial.C).toAlgebra
  have hc : (a3t_phi (a3s_CX X) j hj).comp (algebraMap ℂ ((a3s_CX X).T j)) =
      algebraMap ℂ (a3t_Ax (a3s_CX X) j) := by
    apply RingHom.ext
    intro c
    change a3t_phi (a3s_CX X) j hj ((a3s_CX X).θ j (MvPolynomial.C c)) = _
    rw [a3t_phi_θ]
    simp only [a3t_phiT, MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_C]
  rw [IntersectionProductScaf_familyChartConeMap_algebraMap]
  change algebraMap _ _ ((p.map (algebraMap ℂ ((a3s_CX X).T j))).map
