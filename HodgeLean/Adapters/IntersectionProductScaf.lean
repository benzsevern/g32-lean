/-- Under projection flatness every original endpoint has a regular equation on the extended square family. -/
theorem IntersectionProductScaf_originalFibre_regular_equation_of_projection
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom]
    {n : ℕ} {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp (a3r_lin (a3r_mat a)).toRingHom).Finite)
    [Flat (a3h_πO X hfin).left] (hn : height (genericPoint X.left) = n)
    (M : Fin (n + 1) × Fin (n + 1) → ℂ)
    (y : (a3n_T X).left) (hy : a3n_h X y = genericPoint (g3c_P 1))
    (c : ℂ) (hc : c = 0 ∨ c = 1) :
    let I := IntersectionProductScaf_squarePrimeIdeal M a hfin y
    ∀ x : ((a3k_ι X c).ker.comap I.subschemeι).subscheme,
      ∃ r : I.subscheme.presheaf.stalk (((a3k_ι X c).ker.comap I.subschemeι).subschemeι x),
        IsSMulRegular (I.subscheme.presheaf.stalk
          (((a3k_ι X c).ker.comap I.subschemeι).subschemeι x)) r ∧
        RingHom.ker ((((a3k_ι X c).ker.comap I.subschemeι).subschemeι).stalkMap x).hom =
          Ideal.span {r} := by
  let I := ccm3_inverseIdeal (IntersectionProductScaf_familyMap₁ X hfin M).left
    ((a3h_G (a3h_πO X hfin)).left y)
  let j := (IntersectionProductScaf_familyInclusion (a3n_T X) M).left
  have : IsAffineHom j := IntersectionProductScaf_familyInclusion_affine (a3n_T X) M
  have hreg := IntersectionProductScaf_originalOpen_regular_equation_of_projection
    X hfin hn M y hy c hc
  have hk := IntersectionProductScaf_originalFace_restrict_ker X M c
  have H := IntersectionProductScaf_image_regular_equation j I (a3k_ι X c).ker
    (IntersectionProductScaf_originalSection_principal X c)
  apply H
  dsimp only
  dsimp only [j]
  rw [hk]
  exact hreg
