/-- Comparable points in a quasi-finite fibre are equal. -/
theorem IntersectionProductScaf_fibre_specializes_eq {U Z : Scheme}
    (f : U ⟶ Z) [LocallyQuasiFinite f] {u v : U}
    (huv : u ⤳ v) (he : f u = f v) : u = v := by
  let z := f v
  let u' : f ⁻¹' {z} := ⟨u, he⟩
  let v' : f ⁻¹' {z} := ⟨v, rfl⟩
  have : DiscreteTopology (f ⁻¹' {z}) :=
    isDiscrete_iff_discreteTopology.mp (f.isDiscrete_preimage_singleton z)
  have h : u' ⤳ v' := Topology.IsInducing.subtypeVal.specializes_iff.mp huv
  exact congrArg Subtype.val h.eq

#print axioms IntersectionProductScaf_fibre_specializes_eq
/-- A point above the input generic point is a component of its inverse image under a
quasi-finite map. -/
theorem IntersectionProductScaf_inverseIdeal_component_of_image {U Z : Scheme}
    (f : U ⟶ Z) [LocallyQuasiFinite f] (z : Z)
    (u : (ccm3_inverseIdeal f z).subscheme)
    (hu : f ((ccm3_inverseIdeal f z).subschemeι u) = z) :
    closure ({u} : Set (ccm3_inverseIdeal f z).subscheme) ∈
      irreducibleComponents (ccm3_inverseIdeal f z).subscheme := by
  let I := ccm3_inverseIdeal f z
  obtain ⟨C, hC, hsub⟩ := exists_mem_irreducibleComponents_subset_of_isIrreducible
    (closure ({u} : Set I.subscheme)) isIrreducible_singleton.closure
  let v := hC.1.genericPoint
  have hv : closure ({v} : Set I.subscheme) = C :=
    hC.1.isGenericPoint_genericPoint (isClosed_of_mem_irreducibleComponents C hC)
  have hvu : v ⤳ u := by
    apply specializes_iff_mem_closure.mpr
    rw [hv]
    exact hsub (subset_closure (Set.mem_singleton u))
  have hzv : z ⤳ f (I.subschemeι v) := specializes_iff_mem_closure.mpr
    (IntersectionProductScaf_inverseIdeal_image f z v)
  have hvz : f (I.subschemeι v) ⤳ z := by
    rw [← hu]
    exact (hvu.map I.subschemeι.continuous).map f.continuous
  have he : f (I.subschemeι v) = f (I.subschemeι u) :=
    (hvz.antisymm hzv).eq.trans hu.symm
  have he' : v = u := I.subschemeι.isClosedEmbedding.injective
    (IntersectionProductScaf_fibre_specializes_eq f (hvu.map I.subschemeι.continuous) he)
  rw [← he', hv]
  exact hC

#print axioms IntersectionProductScaf_inverseIdeal_component_of_image
/-- For a generalizing quasi-finite map, the prime pullback has exactly the points of the
fibre as its nonzero coefficients. -/
theorem IntersectionProductScaf_pullbackPrime_support_iff
    {U Z : Over (Spec ↧ℂ)}
    [LocallyOfFiniteType U.hom] [QuasiCompact U.hom]
    [LocallyOfFiniteType Z.hom] [QuasiCompact Z.hom]
    (f : U ⟶ Z) [LocallyQuasiFinite f.left] (hf : GeneralizingMap f.left)
    (z : Z.left) (u : U.left) :
    ccm3_flatPullbackPrime f.left z u ≠ 0 ↔ f.left u = z := by
  constructor
  · intro hu
    obtain ⟨v, hv, hc⟩ := (ccm3_flatPullbackPrime_support f z u).mp hu
    rw [← hv]
    exact IntersectionProductScaf_inverseIdeal_component_image f.left hf z v hc
  · intro hu
    let I := ccm3_inverseIdeal f.left z
    have huI : u ∈ I.support := by
      change u ∈ ((ccm3_primeIdeal Z.left z).comap f.left).support
      rw [Scheme.IdealSheafData.support_comap]
      change f.left u ∈ ((Scheme.IdealSheafData.vanishingIdeal
        ⟨closure ({z} : Set Z.left), isClosed_closure⟩).support : Set Z.left)
      rw [Scheme.IdealSheafData.coe_support_vanishingIdeal, hu]
      exact subset_closure (Set.mem_singleton z)
    obtain ⟨v, hv⟩ := Set.mem_range.mp (I.range_subschemeι.symm.subset huI)
    exact (ccm3_flatPullbackPrime_support f z u).mpr
      ⟨v, hv, IntersectionProductScaf_inverseIdeal_component_of_image f.left z v
        (by rw [hv]; exact hu)⟩

#print axioms IntersectionProductScaf_pullbackPrime_support_iff
/-- Prime inverse images under the finite projection have exactly its fibre points as
nonzero coefficients. -/
theorem IntersectionProductScaf_projection_pullback_support
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] {n : ℕ}
    {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
