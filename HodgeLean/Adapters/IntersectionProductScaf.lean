/-- Restriction of the extended square ideal to an invertible translation fibre is the evaluated inverse image. -/
theorem IntersectionProductScaf_squareIdeal_section
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] {n : ℕ}
    {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
