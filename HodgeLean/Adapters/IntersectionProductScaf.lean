/-- A prime intersection over a generic subscheme point has its localized quotient coefficient. -/
theorem IntersectionProductScaf_prime_subscheme_coefficient
    (Y : Scheme) [IsNoetherian Y] (J : Y.IdealSheafData) (z : Y)
    (y : (ccm3_primeIdeal Y z ⊔ J).subscheme)
    (hy : Scheme.IdealSheafData.inclusion
      (show J ≤ ccm3_primeIdeal Y z ⊔ J from le_sup_right) y ∈ genericPoints J.subscheme)
    (U : Y.affineOpens) (hU : (ccm3_primeIdeal Y z ⊔ J).subschemeι y ∈ U.1) :
    a2g_fundCycle (ccm3_primeIdeal Y z ⊔ J).subschemeι
      ((ccm3_primeIdeal Y z ⊔ J).subschemeι y) =
      ((Module.length (Y.presheaf.stalk ((ccm3_primeIdeal Y z ⊔ J).subschemeι y))
        ((Y.presheaf.stalk ((ccm3_primeIdeal Y z ⊔ J).subschemeι y)) ⧸
          (a3i_stalkIdeal Y ((ccm3_primeIdeal Y z ⊔ J).subschemeι y) z ⊔
            (J.ideal U).map (Y.presheaf.germ U.1 _ hU).hom))).toNat : ℚ) := by
  classical
  let K := ccm3_primeIdeal Y z ⊔ J
  let k := Scheme.IdealSheafData.inclusion (show J ≤ K from le_sup_right)
  have hk : Function.Injective k := by
    intro a b hab
    apply K.subschemeι.isEmbedding.injective
    have he := congrArg J.subschemeι hab
    simpa only [← Scheme.Hom.comp_apply, Scheme.IdealSheafData.inclusion_subschemeι, k] using he
  have hgen : y ∈ genericPoints K.subscheme :=
    IntersectionProductScaf_component_of_injective k hk y hy
  have hfinite : (genericPoints K.subscheme).Finite := by
    have := a2g_subscheme_noetherianSpace K
    exact genericPoints.finite TopologicalSpace.NoetherianSpace.finite_irreducibleComponents
  rw [IntersectionProductScaf_fundCycle_apply_embedded _ K.subschemeι.isEmbedding.injective
    hfinite y, ite_eq_left hgen]
  have hz : z ⤳ K.subschemeι y := by
    have hs : K.subschemeι y ∈ (K.support : Set Y) := by
      rw [← Scheme.IdealSheafData.range_subschemeι]
      exact ⟨y, rfl⟩
    simp only [K, Scheme.IdealSheafData.support_sup, TopologicalSpace.Closeds.coe_inf,
      ccm3_primeIdeal, Scheme.IdealSheafData.coe_support_vanishingIdeal,
      TopologicalSpace.Closeds.coe_mk, Set.mem_inter_iff] at hs
    exact specializes_iff_mem_closure.mpr hs.1
  have he := a3l_ker_stalkMap_subschemeι K y U hU
  rw [Scheme.IdealSheafData.ideal_sup, Pi.sup_apply, Ideal.map_sup,
    a3l_map_primeIdeal_eq_stalkIdeal hz] at he
  rw [← a3l_length_quot_ker _ (K.subschemeι.stalkMap_surjective y) _ he]
#print axioms IntersectionProductScaf_prime_subscheme_coefficient

