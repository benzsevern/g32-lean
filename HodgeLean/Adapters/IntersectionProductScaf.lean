/-- Contraction from the invertible locus preserves the fibre at parameter zero. -/
theorem IntersectionProductScaf_lineClosureIdeal_zero {σ τ : Type} [Fintype σ]
    (M : σ × σ → ℂ) (I : Ideal (MvPolynomial (σ ⊕ τ) ℂ)) :
    Ideal.map (Polynomial.evalRingHom 0) (IntersectionProductScaf_lineClosureIdeal M I) = I := by
  have hd : ((IntersectionProductScaf_lineDet M).map
      (MvPolynomial.C (σ := σ ⊕ τ))).eval 0 = 1 := by
    simpa only [map_zero, IntersectionProductScaf_lineDet_zero, map_one] using
      (Polynomial.eval_map_apply (f := MvPolynomial.C (σ := σ ⊕ τ))
        (p := IntersectionProductScaf_lineDet M) 0)
  rw [IntersectionProductScaf_lineClosureIdeal,
    IntersectionProductScaf_map_contractAway _ _ _ (by
      change IsUnit (((IntersectionProductScaf_lineDet M).map
        (MvPolynomial.C (σ := σ ⊕ τ))).eval 0)
      rw [hd]
      exact isUnit_one),
    IntersectionProductScaf_inverseLineIdeal_zero]

/-- For an invertible endpoint matrix, contraction preserves the inverse translate at one. -/
theorem IntersectionProductScaf_lineClosureIdeal_one {σ τ : Type} [Fintype σ]
    (M : σ × σ → ℂ) (I : Ideal (MvPolynomial (σ ⊕ τ) ℂ))
    (hM : IsUnit (a3r_mat M).det) :
    Ideal.map (Polynomial.evalRingHom 1) (IntersectionProductScaf_lineClosureIdeal M I) =
      I.map (a3h_substT M).toRingHom := by
  have hd : ((IntersectionProductScaf_lineDet M).map
      (MvPolynomial.C (σ := σ ⊕ τ))).eval 1 = MvPolynomial.C (a3r_mat M).det := by
    simpa only [map_one, IntersectionProductScaf_lineDet_one] using
      (Polynomial.eval_map_apply (f := MvPolynomial.C (σ := σ ⊕ τ))
        (p := IntersectionProductScaf_lineDet M) 1)
  rw [IntersectionProductScaf_lineClosureIdeal,
    IntersectionProductScaf_map_contractAway _ _ _
      (by
        change IsUnit (((IntersectionProductScaf_lineDet M).map
          (MvPolynomial.C (σ := σ ⊕ τ))).eval 1)
        rw [hd]
        exact hM.map MvPolynomial.C),
    IntersectionProductScaf_inverseLineIdeal_one]

#print axioms IntersectionProductScaf_lineClosureIdeal_zero
#print axioms IntersectionProductScaf_lineClosureIdeal_one

/-- Extending a point through an open immersion leaves its residue-field degree equal to one. -/
theorem IntersectionProductScaf_open_degree {U W : Scheme} (j : U ⟶ W)
    [IsOpenImmersion j] (u : U) : a1p_degree j u = 1 := by
  let _ := (j.residueFieldMap u).hom.toAlgebra
  let e := (asIso (j.residueFieldMap u)).commRingCatIsoToRingEquiv
  change Module.finrank (W.residueField (j u)) (U.residueField u) = 1
  rw [Algebra.finrank_eq_of_equiv_equiv e (RingEquiv.refl _)
    (S₁ := U.residueField u) (by ext; rfl)]
  exact Module.finrank_self _

/-- A component extended from an open subscheme retains its coefficient. -/
theorem IntersectionProductScaf_open_single {U W : Scheme} (j : U ⟶ W)
    [IsOpenImmersion j] [QuasiCompact j] (u : U) (r : ℚ) :
    a1p_pushforward j (Function.locallyFinsuppWithin.single u r) =
      Function.locallyFinsuppWithin.single (j u) r := by
  rw [a1p_pushforward_single, IntersectionProductScaf_open_degree]
  simp

#print axioms IntersectionProductScaf_open_degree
#print axioms IntersectionProductScaf_open_single

/-- Extension of an ideal through an open immersion restricts to the original ideal. -/
theorem IntersectionProductScaf_open_ideal_restrict
    {U W : Scheme} (j : U ⟶ W) [IsOpenImmersion j] [QuasiCompact j]
    (I : U.IdealSheafData) : (I.map j).comap j = I := by
  have hp : CategoryTheory.IsPullback I.subschemeι (𝟙 I.subscheme) j (I.subschemeι ≫ j) := by
    apply CategoryTheory.IsPullback.of_isLimit
      (c := CategoryTheory.Limits.PullbackCone.mk I.subschemeι (𝟙 I.subscheme) (by simp))
    refine CategoryTheory.Limits.PullbackCone.IsLimit.mk (by simp) (fun s => s.snd)
      ?_ (by simp) ?_
    · intro s
      apply (cancel_mono j).mp
      simpa only [Category.assoc] using s.condition.symm
    · intro s m _ hm
      simpa only [Category.comp_id] using hm
  ext V : 2
  rw [Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion]
  exact (Scheme.ker_ideal_of_isPullback_of_isOpenImmersion
    (I.subschemeι ≫ j) I.subschemeι (𝟙 I.subscheme) j hp V).symm.trans
      (congrArg (fun K : U.IdealSheafData => K.ideal V) I.ker_subschemeι)

#print axioms IntersectionProductScaf_open_ideal_restrict

/-- The subscheme of an extended ideal restricts to the original subscheme. -/
theorem IntersectionProductScaf_open_ideal_pullback
    {U W : Scheme} (j : U ⟶ W) [IsOpenImmersion j] [QuasiCompact j]
    (I : U.IdealSheafData) :
    IsPullback I.subschemeι (I.subschemeMap (I.map j) j le_rfl) j
      (I.map j).subschemeι := by
  apply isPullback_of_isClosedImmersion I.subschemeι (I.map j).subschemeι
    (I.subschemeMap (I.map j) j le_rfl) j
  · exact (I.subschemeMap_subschemeι (I.map j) j le_rfl).symm
  · rw [Scheme.IdealSheafData.ker_subschemeι,
      Scheme.IdealSheafData.ker_subschemeι, IntersectionProductScaf_open_ideal_restrict]

#print axioms IntersectionProductScaf_open_ideal_pullback

/-- Extension through an open immersion preserves every local ring length on the original subscheme. -/
theorem IntersectionProductScaf_open_ideal_length
    {U W : Scheme} (j : U ⟶ W) [IsOpenImmersion j] [QuasiCompact j]
    (I : U.IdealSheafData) (u : I.subscheme) :
    Module.length (I.subscheme.presheaf.stalk u) (I.subscheme.presheaf.stalk u) =
      Module.length ((I.map j).subscheme.presheaf.stalk
        (I.subschemeMap (I.map j) j le_rfl u))
        ((I.map j).subscheme.presheaf.stalk (I.subschemeMap (I.map j) j le_rfl u)) := by
  have : IsOpenImmersion (I.subschemeMap (I.map j) j le_rfl) :=
    MorphismProperty.of_isPullback (IntersectionProductScaf_open_ideal_pullback j I)
      (inferInstance : IsOpenImmersion j)
  exact (a2g_length_self_eq
    (asIso ((I.subschemeMap (I.map j) j le_rfl).stalkMap u)).commRingCatIsoToRingEquiv).symm

#print axioms IntersectionProductScaf_open_ideal_length

/-- A generic point of a component has no distinct generalization. -/
theorem IntersectionProductScaf_component_generalization {Y : Scheme}
    (y : Y) (hy : closure ({y} : Set Y) ∈ irreducibleComponents Y)
    (z : Y) (hz : z ⤳ y) : z = y := by
  have hsub : closure ({y} : Set Y) ⊆ closure ({z} : Set Y) :=
    closure_minimal (Set.singleton_subset_iff.mpr
      (specializes_iff_mem_closure.mp hz)) isClosed_closure
  have hrev := hy.2 isIrreducible_singleton.closure hsub
  exact (hz.antisymm (specializes_iff_mem_closure.mpr
    (hrev (subset_closure (Set.mem_singleton z))))).eq

#print axioms IntersectionProductScaf_component_generalization

/-- A generalizing map sends generic points of components to generic points of components. -/
theorem IntersectionProductScaf_generalizing_component {U W : Scheme}
    (f : U ⟶ W) (hf : GeneralizingMap f) (u : U)
    (hu : closure ({u} : Set U) ∈ irreducibleComponents U) :
    closure ({f u} : Set W) ∈ irreducibleComponents W := by
  obtain ⟨C, hC, hsub⟩ := exists_mem_irreducibleComponents_subset_of_isIrreducible
    (closure ({f u} : Set W)) isIrreducible_singleton.closure
  let v := hC.1.genericPoint
  have hv : closure ({v} : Set W) = C :=
    hC.1.isGenericPoint_genericPoint (isClosed_of_mem_irreducibleComponents C hC)
  have hsp : v ⤳ f u := by
    apply specializes_iff_mem_closure.mpr
    rw [hv]
    exact hsub (subset_closure (Set.mem_singleton (f u)))
  obtain ⟨u', hu', he⟩ := hf hsp
  have hue := IntersectionProductScaf_component_generalization u hu u' hu'
  have he' : f u = v := by simpa only [hue] using he
  rw [he', hv]
  exact hC

#print axioms IntersectionProductScaf_generalizing_component

/-- A generic point of the original subscheme remains generic after extension through an open immersion. -/
theorem IntersectionProductScaf_open_ideal_component
    {U W : Scheme} (j : U ⟶ W) [IsOpenImmersion j] [QuasiCompact j]
    (I : U.IdealSheafData) (u : I.subscheme)
    (hu : closure ({u} : Set I.subscheme) ∈ irreducibleComponents I.subscheme) :
    closure ({I.subschemeMap (I.map j) j le_rfl u} : Set (I.map j).subscheme) ∈
      irreducibleComponents (I.map j).subscheme := by
  have : IsOpenImmersion (I.subschemeMap (I.map j) j le_rfl) :=
    MorphismProperty.of_isPullback (IntersectionProductScaf_open_ideal_pullback j I)
      (inferInstance : IsOpenImmersion j)
  exact IntersectionProductScaf_generalizing_component _
    (I.subschemeMap (I.map j) j le_rfl).isOpenEmbedding.generalizingMap u hu

#print axioms IntersectionProductScaf_open_ideal_component

/-- A dense morphism from a scheme with finitely many component points covers every component point. -/
theorem IntersectionProductScaf_dense_component_preimage {U W : Scheme}
    (f : U ⟶ W) (hf : DenseRange f) (hfin : (genericPoints U).Finite)
    (v : W) (hv : closure ({v} : Set W) ∈ irreducibleComponents W) :
    ∃ u : U, closure ({u} : Set U) ∈ irreducibleComponents U ∧ f u = v := by
  have hd : Dense (f '' genericPoints U) :=
    hf.dense_image f.continuous (by rw [dense_iff_closure_eq, genericPoints.closure])
  have hmem := hd v
  rw [Set.image_eq_iUnion, hfin.closure_biUnion] at hmem
  obtain ⟨u, hu, huv⟩ := Set.mem_iUnion₂.mp hmem
  exact ⟨u, hu, IntersectionProductScaf_component_generalization v hv (f u)
    (specializes_iff_mem_closure.mpr huv)⟩

#print axioms IntersectionProductScaf_dense_component_preimage

/-- The original subscheme has dense image in the subscheme of its extended ideal. -/
theorem IntersectionProductScaf_open_ideal_dense
    {U W : Scheme} (j : U ⟶ W) [IsOpenImmersion j] [QuasiCompact j]
    (I : U.IdealSheafData) : DenseRange (I.subschemeMap (I.map j) j le_rfl) := by
  have he : I.subschemeMap (I.map j) j le_rfl = (I.subschemeι ≫ j).toImage := by
    apply (cancel_mono (I.map j).subschemeι).mp
    rw [I.subschemeMap_subschemeι]
    exact (I.subschemeι ≫ j).toImage_imageι.symm
  rw [he]
  exact (I.subschemeι ≫ j).toImage.denseRange

#print axioms IntersectionProductScaf_open_ideal_dense




/-- Extension through an open immersion preserves every coefficient on its image. -/
theorem IntersectionProductScaf_open_apply {U W : Scheme} (j : U ⟶ W)
    [IsOpenImmersion j] [QuasiCompact j] (c : AlgebraicCycle U ℚ) (u : U) :
    a1p_pushforward j c (j u) = c u := by
  rw [a1p_pushforward_apply_eq_sum j c (j u) {u}]
  · simp only [Finset.sum_singleton, IntersectionProductScaf_open_degree,
      Nat.cast_one, mul_one]
  · intro v hv
    exact Finset.mem_singleton.mpr (j.isOpenEmbedding.injective hv.1)
  · intro v hv
    have hvu := Finset.mem_singleton.mp hv
    subst v
    exact Set.mem_preimage.mpr rfl

/-- Extension through an open immersion has no coefficient outside its image. -/
theorem IntersectionProductScaf_open_apply_of_not_mem_range {U W : Scheme} (j : U ⟶ W)
    [IsOpenImmersion j] [QuasiCompact j] (c : AlgebraicCycle U ℚ) (w : W)
    (hw : w ∉ Set.range j) : a1p_pushforward j c w = 0 := by
  rw [a1p_pushforward_apply_eq_sum j c w ∅]
  · exact Finset.sum_empty
  · intro v hv
    exact (hw ⟨v, hv.1⟩).elim
  · simp only [Finset.coe_empty, Set.empty_subset]

/-- Restriction of a finite cycle to an open subscheme preserves its coefficients. -/
def IntersectionProductScaf_openCycleRestriction {U W : Scheme} (j : U ⟶ W)
    [IsOpenImmersion j] (c : AlgebraicCycle W ℚ) (hc : c.support.Finite) :
    AlgebraicCycle U ℚ where
  toFun u := c (j u)
  supportWithinDomain' := Set.subset_univ _
  supportLocallyFiniteWithinDomain' := by
    intro u _
    refine ⟨Set.univ, Filter.univ_mem, ?_⟩
    rw [Set.univ_inter]
    exact hc.preimage j.isOpenEmbedding.injective.injOn

/-- Extending a restricted cycle recovers it when every member lies in the open subscheme. -/
theorem IntersectionProductScaf_openCycleRestriction_push {U W : Scheme} (j : U ⟶ W)
    [IsOpenImmersion j] [QuasiCompact j] (c : AlgebraicCycle W ℚ)
    (hc : c.support.Finite) (hs : c.support ⊆ Set.range j) :
    a1p_pushforward j (IntersectionProductScaf_openCycleRestriction j c hc) = c := by
  ext w
  by_cases hw : w ∈ Set.range j
  · obtain ⟨u, rfl⟩ := hw
    rw [IntersectionProductScaf_open_apply]
    rfl
  · rw [IntersectionProductScaf_open_apply_of_not_mem_range j _ w hw]
    exact (not_not.mp fun h => hw (hs h)).symm

#print axioms IntersectionProductScaf_openCycleRestriction
#print axioms IntersectionProductScaf_openCycleRestriction_push

/-- Nonzero coefficients of extension are exactly the images of nonzero coefficients. -/
theorem IntersectionProductScaf_open_support {U W : Scheme} (j : U ⟶ W)
    [IsOpenImmersion j] [QuasiCompact j] (c : AlgebraicCycle U ℚ) (w : W) :
    a1p_pushforward j c w ≠ 0 ↔ ∃ u, j u = w ∧ c u ≠ 0 := by
  constructor
  · intro hw
    by_cases hr : w ∈ Set.range j
    · obtain ⟨u, rfl⟩ := hr
      exact ⟨u, rfl, by rwa [IntersectionProductScaf_open_apply] at hw⟩
    · exact (hw (IntersectionProductScaf_open_apply_of_not_mem_range j c w hr)).elim
  · rintro ⟨u, rfl, hu⟩
    rwa [IntersectionProductScaf_open_apply]

/-- Inverse image of a prime cycle is its scheme-theoretic fundamental cycle. -/
theorem IntersectionProductScaf_flatPullback_single {U Z : Scheme}
    (f : U ⟶ Z) (z : Z) :
    ccm3_flatPullback f (Function.locallyFinsuppWithin.single z 1) =
      ccm3_flatPullbackPrime f z := by
  unfold ccm3_flatPullback
  rw [finsum_eq_single _ z (fun x hx => ?_)]
  · ext u
    simp only [Function.locallyFinsuppWithin.mapRange_apply,
      Function.locallyFinsuppWithin.single_apply, ite_true, one_mul]
  · ext u
    simp only [Function.locallyFinsuppWithin.mapRange_apply,
      Function.locallyFinsuppWithin.single_apply, ite_eq_right hx, zero_mul]
    rfl

/-- The members of an open prime family are the images of the generic points of its
scheme-theoretic inverse image. -/
theorem IntersectionProductScaf_openFamilyCycle_single_support
    {U Z W : Over (Spec ↧ℂ)}
    [LocallyOfFiniteType U.hom] [QuasiCompact U.hom]
    [LocallyOfFiniteType Z.hom] [QuasiCompact Z.hom]
    (j : U ⟶ W) [IsOpenImmersion j.left] [QuasiCompact j.left]
    (f : U ⟶ Z) (z : Z.left) (w : W.left) :
    IntersectionProductScaf_openFamilyCycle j f
        (Function.locallyFinsuppWithin.single z 1) w ≠ 0 ↔
      ∃ u : (ccm3_inverseIdeal f.left z).subscheme,
        j.left ((ccm3_inverseIdeal f.left z).subschemeι u) = w ∧
        closure ({u} : Set (ccm3_inverseIdeal f.left z).subscheme) ∈
          irreducibleComponents (ccm3_inverseIdeal f.left z).subscheme := by
  rw [IntersectionProductScaf_openFamilyCycle,
    IntersectionProductScaf_flatPullback_single, IntersectionProductScaf_open_support]
  constructor
  · rintro ⟨v, hv, hc⟩
    obtain ⟨u, hu, hg⟩ := (ccm3_flatPullbackPrime_support f z v).mp hc
    exact ⟨u, hu ▸ hv, hg⟩
  · rintro ⟨u, hu, hg⟩
    exact ⟨_, hu, (ccm3_flatPullbackPrime_support f z _).mpr ⟨u, rfl, hg⟩⟩

/-- A nonzero member of an open prime family yields a component point and a minimal prime
on every specified affine source chart containing that point. -/
theorem IntersectionProductScaf_openFamilyCycle_component_on_affine
    {U Z W : Over (Spec ↧ℂ)}
    [LocallyOfFiniteType U.hom] [QuasiCompact U.hom]
    [LocallyOfFiniteType Z.hom] [QuasiCompact Z.hom]
    (j : U ⟶ W) [IsOpenImmersion j.left] [QuasiCompact j.left]
    (f : U ⟶ Z) (z : Z.left) (w : W.left)
    (hw : IntersectionProductScaf_openFamilyCycle j f
      (Function.locallyFinsuppWithin.single z 1) w ≠ 0)
    (V : U.left.affineOpens)
    (hV : ∀ u : (ccm3_inverseIdeal f.left z).subscheme,
      j.left ((ccm3_inverseIdeal f.left z).subschemeι u) = w →
        (ccm3_inverseIdeal f.left z).subschemeι u ∈ V.1) :
    ∃ (u : (ccm3_inverseIdeal f.left z).subscheme)
      (v : Spec (.of (Γ(U.left, V.1) ⧸
        (ccm3_inverseIdeal f.left z).ideal V))),
      j.left ((ccm3_inverseIdeal f.left z).subschemeι u) = w ∧
      (ccm3_inverseIdeal f.left z).subschemeCover.f V v = u ∧
      v.asIdeal.comap (Ideal.Quotient.mk
        ((ccm3_inverseIdeal f.left z).ideal V)) ∈
          ((ccm3_inverseIdeal f.left z).ideal V).minimalPrimes := by
  obtain ⟨u, huw, hu⟩ :=
    (IntersectionProductScaf_openFamilyCycle_single_support j f z w).mp hw
  obtain ⟨v, hvu, hv⟩ := IntersectionProductScaf_subscheme_component_on_affine
    (ccm3_inverseIdeal f.left z) V u hu (hV u huw)
  exact ⟨u, v, huw, hvu, hv⟩

