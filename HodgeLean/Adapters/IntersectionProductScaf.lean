/-- Changing coordinates in the target preserves lifting of generalizations. -/
theorem IntersectionProductScaf_generalizing_comp_equiv {R S : Type} [CommRing R] [CommRing S]
    (f : R →+* S) (hf : GeneralizingMap (PrimeSpectrum.comap f)) (e : R ≃+* R) :
    GeneralizingMap (PrimeSpectrum.comap (f.comp e.toRingHom)) := by
  have he : GeneralizingMap (PrimeSpectrum.comap e.toRingHom) :=
    (PrimeSpectrum.homeomorphOfRingEquiv e.symm).isOpenEmbedding.generalizingMap
  exact hf.comp he

