/-- A cycle pushforward has no coefficient outside the morphism's image. -/
theorem IntersectionProductScaf_pushforward_apply_of_not_mem_range
    {Y Z : Scheme} (f : Y ⟶ Z) [QuasiCompact f]
    (C : AlgebraicCycle Y ℚ) (z : Z) (hz : z ∉ Set.range f) :
    a1p_pushforward f C z = 0 := by
  rw [a1p_pushforward_apply_eq_sum f C z ∅]
  · exact Finset.sum_empty
  · intro y hy
    exact (hz ⟨y, hy.1⟩).elim
  · simp only [Finset.coe_empty, Set.empty_subset]
#print axioms IntersectionProductScaf_pushforward_apply_of_not_mem_range

/-- Cycle pushforward preserves subtraction. -/
theorem IntersectionProductScaf_pushforward_sub
    {Y Z : Scheme} (f : Y ⟶ Z) [QuasiCompact f]
    (C D : AlgebraicCycle Y ℚ) :
    a1p_pushforward f (C - D) = a1p_pushforward f C - a1p_pushforward f D :=
  map_sub (a2_pushforwardHom f ℚ) C D
