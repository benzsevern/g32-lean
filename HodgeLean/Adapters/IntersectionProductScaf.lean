/-- A component of an inverse-image cylinder contains no monic parameter equation. -/
theorem IntersectionProductScaf_component_monic_not_mem
    {R S : Type} [CommRing R] [CommRing S]
    (f : Polynomial R →+* S) (hf : GeneralizingMap (PrimeSpectrum.comap f))
    (I : Ideal R) [I.IsPrime] (Q : Ideal S)
    (hQ : Q ∈ ((I.map Polynomial.C).map f).minimalPrimes)
    (p : Polynomial R) (hp : p.Monic) : f p ∉ Q := by
  intro hpQ
  have hcon := IntersectionProductScaf_minimalPrime_comap f hf (I.map Polynomial.C) Q hQ
  have hpI : p ∈ I.map Polynomial.C := hcon ▸ hpQ
  have hc := (Ideal.mem_map_C_iff.mp hpI) p.natDegree
  rw [← Polynomial.leadingCoeff, hp] at hc
  exact (inferInstance : I.IsPrime).ne_top (Ideal.eq_top_of_isUnit_mem _ hc isUnit_one)
/-- A component of an inverse-image cylinder over the complex numbers contains no nonzero parameter equation. -/
theorem IntersectionProductScaf_component_parameter_not_mem
    {R S : Type} [CommRing R] [CommRing S] [Algebra ℂ R]
    (f : Polynomial R →+* S) (hf : GeneralizingMap (PrimeSpectrum.comap f))
    (I : Ideal R) [I.IsPrime] (Q : Ideal S)
    (hQ : Q ∈ ((I.map Polynomial.C).map f).minimalPrimes)
    (p : Polynomial ℂ) (hp : p ≠ 0) :
    f (p.map (algebraMap ℂ R)) ∉ Q := by
  intro hpQ
  have hcon := IntersectionProductScaf_minimalPrime_comap f hf (I.map Polynomial.C) Q hQ
  have hpI : p.map (algebraMap ℂ R) ∈ I.map Polynomial.C := hcon ▸ hpQ
  have hc := (Ideal.mem_map_C_iff.mp hpI) p.natDegree
  rw [Polynomial.coeff_map, ← Polynomial.leadingCoeff] at hc
  have hu : IsUnit (algebraMap ℂ R p.leadingCoeff) :=
    (isUnit_iff_ne_zero.mpr (Polynomial.leadingCoeff_ne_zero.mpr hp)).map _
  exact (inferInstance : I.IsPrime).ne_top (Ideal.eq_top_of_isUnit_mem _ hc hu)

/-- Parameter exclusion on minimal components gives regularity when no embedded associated
primes occur in the extended cylinder quotient. -/
theorem IntersectionProductScaf_component_parameter_regular
    {R S : Type} [CommRing R] [CommRing S] [IsNoetherianRing S] [Algebra ℂ R]
    (f : Polynomial R →+* S) (hf : GeneralizingMap (PrimeSpectrum.comap f))
    (I : Ideal R) [I.IsPrime] (p : Polynomial ℂ) (hp : p ≠ 0)
    (hAssoc : ∀ P ∈ associatedPrimes S (S ⧸ (I.map Polynomial.C).map f),
      P ∈ ((I.map Polynomial.C).map f).minimalPrimes) :
    IsSMulRegular (S ⧸ (I.map Polynomial.C).map f)
      (f (p.map (algebraMap ℂ R))) := by
  apply IntersectionProductScaf_regular_of_not_mem_associatedPrimes _ _
  intro P hP
  exact IntersectionProductScaf_component_parameter_not_mem f hf I P
    (hAssoc P hP) p hp

/-- Flatness of an extended cylinder quotient transports parameter regularity to its target. -/
theorem IntersectionProductScaf_component_parameter_regular_of_flat
    {R S : Type} [CommRing R] [CommRing S] [Algebra ℂ R]
    (f : Polynomial R →+* S) (I : Ideal R) [Nontrivial (R ⧸ I)]
    (p : Polynomial ℂ) (hp : p ≠ 0)
    (hflat : let q := Ideal.quotientMap ((I.map Polynomial.C).map f) f Ideal.le_comap_map
      letI : Algebra (Polynomial R ⧸ I.map Polynomial.C)
          (S ⧸ (I.map Polynomial.C).map f) := q.toAlgebra
      Module.Flat (Polynomial R ⧸ I.map Polynomial.C)
        (S ⧸ (I.map Polynomial.C).map f)) :
    IsSMulRegular (S ⧸ (I.map Polynomial.C).map f)
      (f (p.map (algebraMap ℂ R))) := by
  let q := Ideal.quotientMap ((I.map Polynomial.C).map f) f Ideal.le_comap_map
  letI : Algebra (Polynomial R ⧸ I.map Polynomial.C)
      (S ⧸ (I.map Polynomial.C).map f) := q.toAlgebra
  letI : Module.Flat (Polynomial R ⧸ I.map Polynomial.C)
      (S ⧸ (I.map Polynomial.C).map f) := hflat
  have hreg := (IntersectionProductScaf_complexPolynomial_regular_quotientCylinder I p hp).of_flat
    (S := S ⧸ (I.map Polynomial.C).map f)
  intro x y hxy
  apply hreg
  change Ideal.Quotient.mk ((I.map Polynomial.C).map f)
      (f (p.map (algebraMap ℂ R))) * x =
    Ideal.Quotient.mk ((I.map Polynomial.C).map f)
      (f (p.map (algebraMap ℂ R))) * y at hxy ⊢
  exact hxy

