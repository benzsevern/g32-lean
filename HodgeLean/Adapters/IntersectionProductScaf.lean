/-- An affine principal equation remains regular on the image subscheme when its inverse image has regular local equations. -/
theorem IntersectionProductScaf_image_regular_equation_on_chart
    {U V : Scheme} (j : U ⟶ V) [QuasiCompact j]
    (I : U.IdealSheafData) (K : V.IdealSheafData)
    (W : V.affineOpens) (hW : IsAffineOpen (j ⁻¹ᵁ W.1)) (r : Γ(V, W))
    (hK : K.ideal W = Ideal.span {r})
    (hreg : let J := (K.comap j).comap I.subschemeι
      ∀ z : J.subscheme, ∃ s : I.subscheme.presheaf.stalk (J.subschemeι z),
        IsSMulRegular (I.subscheme.presheaf.stalk (J.subschemeι z)) s ∧
        RingHom.ker (J.subschemeι.stalkMap z).hom = Ideal.span {s})
    (x : (K.comap (I.map j).subschemeι).subscheme)
    (hx : (I.map j).subschemeι ((K.comap (I.map j).subschemeι).subschemeι x) ∈ W.1) :
    ∃ s : (I.map j).subscheme.presheaf.stalk ((K.comap (I.map j).subschemeι).subschemeι x),
      IsSMulRegular ((I.map j).subscheme.presheaf.stalk
        ((K.comap (I.map j).subschemeι).subschemeι x)) s ∧
      RingHom.ker ((K.comap (I.map j).subschemeι).subschemeι.stalkMap x).hom = Ideal.span {s} := by
  let WU : U.affineOpens := ⟨j ⁻¹ᵁ W.1, hW⟩
  let WI : I.subscheme.affineOpens := ⟨I.subschemeι ⁻¹ᵁ WU.1, hW.preimage I.subschemeι⟩
  have hgen : ((K.comap j).comap I.subschemeι).ideal WI =
      Ideal.span {I.subschemeι.app WU (j.app W r)} := by
    rw [IntersectionProductScaf_closed_comap_ideal I.subschemeι (K.comap j) WU,
      IntersectionProductScaf_comap_ideal_affine_charts j K W WU le_rfl,
      Scheme.Hom.appLE_eq_app, hK, Ideal.map_span, Set.image_singleton,
      Ideal.map_span, Set.image_singleton]
  have hs := IntersectionProductScaf_affine_generator_regular _ hreg WI _ hgen
  have hquot : IsSMulRegular (Γ(U, WU) ⧸ I.ideal WU) (j.app W r) := by
    rw [← I.ker_subschemeι_app WU]
    let e := RingHom.quotientKerEquivOfSurjective (I.subschemeι_app_surjective WU)
    apply (Equiv.isSMulRegular_congr (e := e.toEquiv)
      (s := I.subschemeι.app WU (j.app W r)) ?_).mpr hs
    intro a
    change e (Ideal.Quotient.mk _ (j.app W r) * a) = _
    rw [map_mul]
    rfl
  refine ⟨(I.map j).subschemeι.stalkMap _ (V.presheaf.germ W.1 _ hx r),
    IntersectionProductScaf_extended_equation_stalk_regular j I W hW r hquot _ hx, ?_⟩
  rw [IntersectionProductScaf_closed_comap_stalk_kernel (I.map j).subschemeι K x W hx,
    hK, Ideal.map_span, Set.image_singleton, Ideal.map_span, Set.image_singleton]
#print axioms IntersectionProductScaf_image_regular_equation_on_chart

