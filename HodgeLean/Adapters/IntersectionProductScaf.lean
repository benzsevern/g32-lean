    (z : (a3h_PnO n).left) (x : X.left) :
    ccm3_flatPullbackPrime (a3h_π X hfin) z x ≠ 0 ↔ a3h_π X hfin x = z := by
  exact IntersectionProductScaf_pullbackPrime_support_iff (a3h_πO X hfin)
    (IntersectionProductScaf_projection_generalizing X hfin hn) z x

