/-- A finite projection preserves the dimension of the affine relative cone. -/
theorem IntersectionProductScaf_projected_affineCone_dimension
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom]
    {n : ℕ} (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (y : (a3n_T X).left) (hy : y ∈ a3h_U X) :
    ringKrullDim (Polynomial (MvPolynomial (Fin (n + 1)) ℂ) ⧸
      (((a3h_P X y hy).comap (a3r_lin (a3h_block a))).comap
        (a3h_eqT (Fin (n + 1))).symm.toRingHom)) =
      (height y : WithBot ℕ∞) + 1 := by
  let I := (a3h_P X y hy).comap (a3r_lin (a3h_block a))
  have hd := a3r_dim_eq_of_finite (a3h_IXr (a3s_IX X)) (a3h_block a)
    (a3h_finite_rel (a3s_IX X) a hfin) (a3h_P X y hy) (a3h_IXr_le_P X y hy)
  have he := ringKrullDim_eq_of_ringEquiv
    (Ideal.quotientEquiv _ _ (a3h_eqT (Fin (n + 1))).symm.toRingEquiv
      (Ideal.map_comap_of_surjective _ (a3h_eqT (Fin (n + 1))).symm.surjective I).symm)
  exact he.trans (hd.symm.trans (a3h_height_add_one X y hy).symm)
#print axioms IntersectionProductScaf_projected_affineCone_dimension
/-- Inputs over a nongeneric complex parameter satisfy the original-fibre identity at both endpoints. -/
theorem IntersectionProductScaf_originalFibre_projected_input_of_parameter
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom]
    {n : ℕ} (M : Fin (n + 1) × Fin (n + 1) → ℂ)
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (y : (a3n_T X).left) (hy : a3n_h X y = genericPoint (g3c_P 1))
    (hp : a3n_p X y ≠ genericPoint (a3m_Pn 1)) (c : ℂ) (hc : c = 0 ∨ c = 1) :
    IntersectionProductScaf_originalFibreCycle M a hfin y c =
      IntersectionProductScaf_theta₀ X hfin M
        (a1p_pushforward (a3h_πO X hfin).left
          (a2g_fundCycle (((ccm3_primeIdeal (a3n_T X).left y).comap
            (a3n_σ X c)).subschemeι))) := by
  have hs : ¬ a3n_p X y ⤳ a3n_pt c a3n_o := fun h =>
    hp (IntersectionProductScaf_parameter_generic_of_endpoint_specializes X y hy c hc h)
  rw [IntersectionProductScaf_originalFibre_zero_of_parameter X M a hfin y c hs,
    IntersectionProductScaf_inputFibre_zero_of_parameter X y c hs,
    a3k_pushforward_zero, IntersectionProductScaf_theta₀,
    IntersectionProductScaf_openFamilyCycle, IntersectionProductTrans_flatPullback_zero,
    a3k_pushforward_zero]
#print axioms IntersectionProductScaf_originalFibre_projected_input_of_parameter
/-- The projected relative cone excludes the two original endpoint equations. -/
theorem IntersectionProductScaf_projected_affineCone_endpoint_not_mem
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom]
    {n : ℕ} (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (y : (a3n_T X).left) (hy : y ∈ a3h_U X)
    (hdom : a3n_h X y = genericPoint (g3c_P 1))
    (c : ℂ) (hc : c = 0 ∨ c = 1) :
    Polynomial.X - Polynomial.C (MvPolynomial.C c) ∉
      (((a3h_P X y hy).comap (a3r_lin (a3h_block a))).comap
        (a3h_eqT (Fin (n + 1))).symm.toRingHom) := by
  intro h
  have he : (a3h_eqT (Fin (n + 1))).symm
      (Polynomial.X - Polynomial.C (MvPolynomial.C c)) =
      MvPolynomial.X (Sum.inr ()) - MvPolynomial.C c := by
    apply (a3h_eqT (Fin (n + 1))).injective
    rw [AlgEquiv.apply_symm_apply, map_sub, a3h_eqT_inr]
    exact congrArg (Polynomial.X - ·) ((a3h_eqT (Fin (n + 1))).commutes c).symm
  change a3r_lin (a3h_block a) ((a3h_eqT (Fin (n + 1))).symm
    (Polynomial.X - Polynomial.C (MvPolynomial.C c))) ∈ a3h_P X y hy at h
  rw [he, map_sub, a3h_lin_block_inr, a3r_lin_C] at h
  exact a3k_not_mem_range_σ X hdom c hc
    (IntersectionProductScaf_mem_section_of_parameter_mem X y hy c h)
#print axioms IntersectionProductScaf_projected_affineCone_endpoint_not_mem
/-- Endpoint pencil equations force a strict height bound on actual spatial scheme points. -/
theorem IntersectionProductScaf_generic_endpoint_pencil_height
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom]
    {n : ℕ} (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (y : (a3n_T X).left) (hy : y ∈ a3h_U X)
    (hdom : a3n_h X y = genericPoint (g3c_P 1)) (hdim : 1 ≤ height y)
    (c : ℂ) (hc : c = 0 ∨ c = 1) :
    a3r_Generic {M : Fin (n + 1) × Fin (n + 1) → ℂ |
      ∀ t : ℂ, ∀ x : X.left,
        let J := (((a3h_P X y hy).comap (a3r_lin (a3h_block a))).comap
          (a3h_eqT (Fin (n + 1))).symm.toRingHom)
        let A := (1 - t) • (1 : Matrix (Fin (n + 1)) (Fin (n + 1)) ℂ) +
          t • Matrix.of (fun i j => M (i, j))
        J.map (Polynomial.evalRingHom (MvPolynomial.C c)) ≤
          (((a3s_CX X).prime x).comap (a3r_lin (a3r_mat a))).comap
            (a3r_lin A).toRingHom → height x < height y} := by
  let J := (((a3h_P X y hy).comap (a3r_lin (a3h_block a))).comap
    (a3h_eqT (Fin (n + 1))).symm.toRingHom)
  have : J.IsPrime := Ideal.IsPrime.comap _
  have hdJ := IntersectionProductScaf_projected_affineCone_dimension X a hfin y hy
  obtain ⟨_, my, hmy, _⟩ := a1d_height_eq_trdeg (X := a3n_T X) y
  have hmy1 : 1 ≤ my := by exact_mod_cast (hmy ▸ hdim)
  have hd : 2 ≤ ringKrullDim (Polynomial (MvPolynomial (Fin (n + 1)) ℂ) ⧸ J) := by
    rw [hdJ, hmy]
    exact WithBot.coe_le_coe.mpr (show (2 : ℕ∞) ≤ (my : ℕ∞) + 1 by
      exact_mod_cast (show 2 ≤ my + 1 by omega))
  refine (IntersectionProductScaf_generic_endpoint_pencil_dimension J c
    (IntersectionProductScaf_projected_affineCone_endpoint_not_mem X a y hy hdom c hc) hd).mono ?_
  intro M hM t x J' A heq
  let Q := ((a3s_CX X).prime x).comap (a3r_lin (a3r_mat a))
  have : Q.IsPrime := Ideal.IsPrime.comap _
  have hb := hM t Q inferInstance heq
  have hx : ringKrullDim (MvPolynomial (Fin (n + 1)) ℂ ⧸ Q) =
      (height x : WithBot ℕ∞) + 1 := by
    rw [← a3r_dim_eq_of_finite (a3s_IX X) (a3r_mat a) hfin
      ((a3s_CX X).prime x) (a3s_IX_le X x)]
    exact (a3s_height_add_one X x).symm
  rw [hx, hdJ] at hb
  obtain ⟨_, mx, hmx, _⟩ := a1d_height_eq_trdeg (X := X) x
  rw [hmx, hmy] at hb ⊢
  have hb' : mx + 1 + 1 ≤ my + 1 := by exact_mod_cast hb
  exact_mod_cast (show mx < my by omega)
#print axioms IntersectionProductScaf_generic_endpoint_pencil_height
/-- A nonzero prime of the complex affine parameter line contains a scalar equation. -/
theorem IntersectionProductScaf_parameter_prime_scalar
    (P : Ideal (Polynomial ℂ)) [P.IsPrime] (hP : P ≠ ⊥) :
    ∃ c : ℂ, Polynomial.X - Polynomial.C c ∈ P := by
  let f := Submodule.IsPrincipal.generator P
  have hf := Submodule.IsPrincipal.prime_generator_of_isPrime P hP
  have hd := IsAlgClosed.degree_eq_one_of_irreducible ℂ hf.irreducible
  obtain ⟨c, hc⟩ := IsAlgClosed.exists_root f (by rw [hd]; exact one_ne_zero)
  have hdiv : f ∣ Polynomial.X - Polynomial.C c :=
    (Polynomial.irreducible_X_sub_C c).dvd_symm hf.irreducible
      (Polynomial.dvd_iff_isRoot.mpr hc)
  obtain ⟨r, hr⟩ := hdiv
  refine ⟨c, ?_⟩
  rw [hr]
  exact P.mul_mem_right r (Submodule.IsPrincipal.generator_mem P)
#print axioms IntersectionProductScaf_parameter_prime_scalar
set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
/-- The affine determinant chart consists exactly of primes avoiding its determinant. -/
theorem IntersectionProductScaf_parameterChart_mem_range_iff
    {σ : Type} [Fintype σ] [DecidableEq σ] (M : σ × σ → ℂ)
    (q : Spec (a3m_PnT 1 0)) :
    q ∈ Set.range (IntersectionProductScaf_parameterChart M) ↔
      IntersectionProductScaf_lineDet M ∉ q.asIdeal.comap (a3n_chartEquiv 0).toRingHom := by
  let r := PrimeSpectrum.comap (a3n_chartEquiv 0).toRingHom q
  have he : Function.Injective (PrimeSpectrum.comap (a3n_chartEquiv 0).toRingHom) :=
    PrimeSpectrum.comap_injective_of_surjective _ (a3n_chartEquiv 0).surjective
  have hmap (u : IntersectionProductScaf_parameterScheme M) :
      PrimeSpectrum.comap (a3n_chartEquiv 0).toRingHom
          (IntersectionProductScaf_parameterChart M u) =
        PrimeSpectrum.comap (algebraMap (Polynomial ℂ) (IntersectionProductScaf_lineRing M)) u := by
    apply PrimeSpectrum.ext
    ext p
    change algebraMap (Polynomial ℂ) (IntersectionProductScaf_lineRing M)
      ((a3n_chartEquiv 0).symm ((a3n_chartEquiv 0) p)) ∈ u.asIdeal ↔ _
    rw [AlgEquiv.symm_apply_apply]
    rfl
  have hr : q ∈ Set.range (IntersectionProductScaf_parameterChart M) ↔
      r ∈ Set.range (PrimeSpectrum.comap
        (algebraMap (Polynomial ℂ) (IntersectionProductScaf_lineRing M))) := by
    constructor
    · rintro ⟨u, rfl⟩
      exact ⟨u, (hmap u).symm⟩
    · rintro ⟨u, hu⟩
      exact ⟨u, he ((hmap u).trans hu)⟩
  rw [hr, PrimeSpectrum.localization_away_comap_range
    (IntersectionProductScaf_lineRing M) (IntersectionProductScaf_lineDet M)]
  rfl
#print axioms IntersectionProductScaf_parameterChart_mem_range_iff
set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
/-- Every affine point outside the family open lies on a singular scalar pencil fibre. -/
theorem IntersectionProductScaf_affine_boundary_section
    (X : Over (Spec ↧ℂ)) {σ : Type} [Fintype σ] [DecidableEq σ] (M : σ × σ → ℂ)
    (x : (a3n_T X).left) (hxU : x ∈ a3h_U X)
    (hx : x ∉ Set.range (IntersectionProductScaf_familyInclusion X M).left) :
    ∃ t : ℂ, x = a3n_σ X t ((a3n_q X).left x) ∧
      (IntersectionProductScaf_lineDet M).eval t = 0 := by
  have hp : a3n_p X x ∉ Set.range (IntersectionProductScaf_parameterInclusion M) := by
    rwa [IntersectionProductScaf_familyInclusion_range] at hx
  obtain ⟨q, hq⟩ := hxU
  let P := q.asIdeal.comap (a3n_chartEquiv 0).toRingHom
  have : P.IsPrime := Ideal.IsPrime.comap _
  have hd : IntersectionProductScaf_lineDet M ∈ P := by
    by_contra hn
    obtain ⟨u, hu⟩ := (IntersectionProductScaf_parameterChart_mem_range_iff M q).mpr hn
    apply hp
    refine ⟨u, ?_⟩
    change a3m_Pnκ 1 0 (IntersectionProductScaf_parameterChart M u) = _
    rw [hu]
    exact hq
  have hP : P ≠ ⊥ := by
    intro he
    rw [he, Ideal.mem_bot] at hd
    exact IntersectionProductScaf_lineDet_ne_zero M hd
  obtain ⟨t, ht⟩ := IntersectionProductScaf_parameter_prime_scalar P hP
  have hxsec : x ∈ Set.range (a3n_σ X t) := by
    rw [a3n_range_σ, Set.mem_preimage, ← hq]
    exact a3n_mem_range_pt t q ht
  obtain ⟨z, hz⟩ := hxsec
  refine ⟨t, ?_, ?_⟩
  · rw [← hz, a3n_q_σ_apply]
  · by_contra hd
    apply hx
    rw [← hz]
    exact IntersectionProductScaf_section_mem_familyOpen X M t (isUnit_iff_ne_zero.mpr hd) z
#print axioms IntersectionProductScaf_affine_boundary_section
open TopologicalSpace in
/-- Equations on an ideal support remain valid in every open chart after extension. -/
theorem IntersectionProductScaf_extendedIdeal_chart_vanishing
    {U V W : Scheme} (i : U ⟶ V) [QuasiCompact i] (I : U.IdealSheafData)
    (j : W ⟶ V) [IsOpenImmersion j] (s : Γ(W, ⊤))
    (hs : ∀ w : W, j w ∈ i '' I.support →
      ¬ IsUnit (W.presheaf.germ ⊤ w (by trivial) s))
    (w : W) (hw : j w ∈ (I.map i).support) :
    ¬ IsUnit (W.presheaf.germ ⊤ w (by trivial) s) := by
  rw [Scheme.IdealSheafData.support_map] at hw
  change w ∈ j ⁻¹' closure (i '' I.support) at hw
  rw [j.isOpenEmbedding.isOpenMap.preimage_closure_eq_closure_preimage j.continuous] at hw
  have hsub : j ⁻¹' (i '' I.support) ⊆ (W.basicOpen s : Set W)ᶜ := by
    intro x hx
    exact fun h => hs x hx ((W.mem_basicOpen_top s x).mp h)
  have hv := closure_minimal hsub (W.basicOpen s).isOpen.isClosed_compl hw
  exact fun h => hv ((W.mem_basicOpen_top s w).mpr h)
#print axioms IntersectionProductScaf_extendedIdeal_chart_vanishing
open MvPolynomial in
/-- A parameter equation in an ideal specializes every relative polynomial modulo that ideal. -/
theorem IntersectionProductScaf_relative_equation_specialization
    {R σ : Type} [CommRing R] (P : Ideal R) (s : ℂ →+* R) (t : R)
    (v : σ → R) (c : ℂ) (ht : t - s c ∈ P)
    (F : MvPolynomial σ (Polynomial ℂ)) :
    eval₂Hom (Polynomial.eval₂RingHom s t) v F ∈ P ↔
      eval₂Hom s v (MvPolynomial.map (Polynomial.evalRingHom c) F) ∈ P := by
  have he : (Ideal.Quotient.mk P).comp (eval₂Hom (Polynomial.eval₂RingHom s t) v) =
      ((Ideal.Quotient.mk P).comp (eval₂Hom s v)).comp
        (MvPolynomial.map (Polynomial.evalRingHom c)) := by
    apply MvPolynomial.ringHom_ext
    · intro r
      have ht' : Ideal.Quotient.mk P t = Ideal.Quotient.mk P (s c) :=
        Ideal.Quotient.eq.mpr ht
      induction r using Polynomial.induction_on' with
      | add p q hp hq => simp only [map_add, hp, hq]
      | monomial k a =>
        rw [← Polynomial.C_mul_X_pow_eq_monomial]
        simp [Polynomial.coe_eval₂RingHom, ht']
    · intro k
      simp
  rw [← Ideal.Quotient.eq_zero_iff_mem, ← Ideal.Quotient.eq_zero_iff_mem]
  exact Iff.of_eq (congrArg (· = 0) (congrArg (fun h : MvPolynomial σ (Polynomial ℂ) →+* R ⧸ P => h F) he))
#print axioms IntersectionProductScaf_relative_equation_specialization

section ClosedParameterHeight
open CategoryTheory.Limits TopologicalSpace
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
/-- A point over a closed complex parameter has the height of its spatial projection. -/
theorem IntersectionProductScaf_height_of_closed_parameter
    (X : Over (Spec ↧ℂ)) (x : (a3n_T X).left)
    (hx : IsClosed ({a3n_p X x} : Set (a3m_Pn 1))) :
    height x = height ((a3n_q X).left x) := by
  let p := a3n_p X x
  let i := (a3m_Pn 1).fromSpecResidueField p
  have : IsClosedImmersion i := isClosed_singleton_iff_isClosedImmersion.mp hx
  have : IsFinite (i ≫ a3n_P1.hom) :=
    isFinite_iff_locallyOfFiniteType_of_jacobsonSpace.mpr inferInstance
  let f := pullback.fst (a3n_p X) i
  let q := f ≫ (a3n_q X).left
  have ht := (IsPullback.of_hasPullback (a3n_p X) i).flip.paste_vert
    (IsPullback.of_hasPullback X.hom a3n_P1.hom).flip
  have : IsFinite q := MorphismProperty.of_isPullback ht inferInstance
  let r : Spec ((a3m_Pn 1).residueField p) := ⟨⊥, Ideal.isPrime_bot⟩
  obtain ⟨z, hzx, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := a3n_p X)
    (g := i) x r (by simp [i, p])
  have h₁ := IntersectionProductScaf_finite_height f z
  have h₂ := IntersectionProductScaf_finite_height q z
  rw [show f z = x from hzx] at h₁
  change height ((a3n_q X).left (f z)) = _ at h₂
  rw [hzx] at h₂
  exact h₁.trans h₂.symm
#print axioms IntersectionProductScaf_height_of_closed_parameter
/-- Every nongeneric point of the complex projective line is closed. -/
theorem IntersectionProductScaf_P1_isClosed_of_ne_generic
    (p : a3m_Pn 1) (hp : p ≠ genericPoint (a3m_Pn 1)) :
    IsClosed ({p} : Set (a3m_Pn 1)) := by
  apply isClosed_of_closure_subset
  intro q hq
  apply Set.mem_singleton_iff.mpr
  by_contra h
  exact hp (a3k_P1_eq_generic (specializes_iff_mem_closure.mpr hq) (Ne.symm h))
#print axioms IntersectionProductScaf_P1_isClosed_of_ne_generic

/-- Every point outside the translation open has the height of its spatial projection. -/
theorem IntersectionProductScaf_height_of_family_boundary
    (X : Over (Spec ↧ℂ)) {σ : Type} [Fintype σ] [DecidableEq σ]
    (M : σ × σ → ℂ) (x : (a3n_T X).left)
    (hx : x ∉ Set.range (IntersectionProductScaf_familyInclusion X M).left) :
    height x = height ((a3n_q X).left x) := by
  by_cases hU : x ∈ a3h_U X
  · obtain ⟨t, ht, -⟩ := IntersectionProductScaf_affine_boundary_section X M x hU hx
    exact (congrArg height ht).trans (a3n_height_σ X t ((a3n_q X).left x))
  · apply IntersectionProductScaf_height_of_closed_parameter X x
    apply IntersectionProductScaf_P1_isClosed_of_ne_generic
    intro hp
    apply hU
    change a3n_p X x ∈ Set.range (a3m_Pnκ 1 0)
    rw [hp, a3n_genericPoint_P1]
    exact ⟨a3n_bot 0, rfl⟩
#print axioms IntersectionProductScaf_height_of_family_boundary
end ClosedParameterHeight

section FamilyBoundaryParameter
open CategoryTheory.Limits
attribute [local instance] MvPolynomial.gradedAlgebra
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
variable {σ : Type} [Fintype σ] [DecidableEq σ]
/-- The family parameter as a morphism to the integral affine chart. -/
def IntersectionProductScaf_familyIntegralParameterChart
    (Y : Over (Spec ↧ℂ)) (M : σ × σ → ℂ) :
    (IntersectionProductScaf_familyOpen Y M).left ⟶ Spec (.of a3m_Away1) :=
  pullback.snd Y.hom (IntersectionProductScaf_parameterOver M).hom ≫
    IntersectionProductScaf_parameterChart M ≫
      Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight
        (R := ℤ) (A := ℂ) (B := a3m_Away1)).toRingHom)

/-- The integral parameter chart represents the translation parameter of the family inclusion. -/
theorem IntersectionProductScaf_familyIntegralParameterChart_inclusion
    (Y : Over (Spec ↧ℂ)) (M : σ × σ → ℂ) :
    IntersectionProductScaf_familyIntegralParameterChart Y M ≫ g3c_chartι 1 0 =
      (IntersectionProductScaf_familyInclusion Y M).left ≫ a3n_h Y := by
  change _ = (IntersectionProductScaf_familyInclusion Y M).left ≫ a3n_p Y ≫ a3n_π
  rw [← Category.assoc, IntersectionProductScaf_familyInclusion_parameter]
  simp only [IntersectionProductScaf_familyIntegralParameterChart, Category.assoc,
    IntersectionProductScaf_parameterOverInclusion, Over.homMk_left,
    IntersectionProductScaf_parameterInclusion, a3m_Pnκ, a3m_prodChart_snd]
#print axioms IntersectionProductScaf_familyIntegralParameterChart_inclusion
#print axioms IntersectionProductScaf_familyIntegralParameterChart

/-- Scalar sections commute with morphisms of complex schemes. -/
theorem IntersectionProductScaf_complexScalars_map
    {Y Z : Over (Spec ↧ℂ)} (f : Z ⟶ Y) (c : ℂ) :
    f.left.appTop (IntersectionProductScaf_complexScalars Y c) =
      IntersectionProductScaf_complexScalars Z c := by
  simp only [IntersectionProductScaf_complexScalars, RingHom.comp_apply]
  rw [← a3m_appTop_comp_apply, Over.w f]
#print axioms IntersectionProductScaf_complexScalars_map
/-- The family matrix is the scalar pencil evaluated in its parameter section. -/
theorem IntersectionProductScaf_familyMatrix_pencil
    (Y : Over (Spec ↧ℂ)) (M : σ × σ → ℂ) :
    IntersectionProductScaf_familyMatrix Y M =
      (1 - IntersectionProductScaf_familyParameterSections Y M Polynomial.X) • 1 +
      IntersectionProductScaf_familyParameterSections Y M Polynomial.X •
        (IntersectionProductScaf_complexScalars (IntersectionProductScaf_familyOpen Y M)).mapMatrix
          (a3r_mat M) := by
  ext i j
  change IntersectionProductScaf_familyParameterSections Y M
    (IntersectionProductScaf_lineMatrix M i j) = _
  simp only [IntersectionProductScaf_lineMatrix, map_add, map_mul, map_sub, map_one,
    IntersectionProductScaf_familyParameterSections_C]
  by_cases hij : i = j <;> simp [Matrix.one_apply, hij, a3r_mat, IntersectionProductScaf_complexScalars, CommRingCat.Hom.hom]
#print axioms IntersectionProductScaf_familyMatrix_pencil

/-- The integral affine parameter chart reads the family polynomial parameter. -/
theorem IntersectionProductScaf_familyParameterSections_chart
    (Y : Over (Spec ↧ℂ)) (M : σ × σ → ℂ) :
    (pullback.snd Y.hom (IntersectionProductScaf_parameterOver M).hom ≫
      IntersectionProductScaf_parameterChart M ≫
      Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight
        (R := ℤ) (A := ℂ) (B := a3m_Away1)).toRingHom)).appTop
      ((Scheme.ΓSpecIso _).inv a3m_t₁) =
        IntersectionProductScaf_familyParameterSections Y M Polynomial.X := by
  simp only [a3m_appTop_comp_apply, g3c_SpecMap_appTop_ΓSpecIso_inv,
    IntersectionProductScaf_parameterChart, IntersectionProductScaf_familyParameterSections,
    RingHom.comp_apply]
  apply congrArg (fun s => (pullback.snd Y.hom
    (IntersectionProductScaf_parameterOver M).hom).appTop s)
  erw [g3c_SpecMap_appTop_ΓSpecIso_inv, g3c_SpecMap_appTop_ΓSpecIso_inv]
  apply congrArg (fun c => (Scheme.ΓSpecIso (.of (IntersectionProductScaf_lineRing M))).inv
    (algebraMap (Polynomial ℂ) (IntersectionProductScaf_lineRing M) c))
  apply (a3n_chartEquiv 0).injective
  change (a3n_chartEquiv 0) ((a3n_chartEquiv 0).symm _) = _
  rw [AlgEquiv.apply_symm_apply]
  simp [a3n_chartEquiv, polyEquivTensor_apply, a3n_awayEquiv, a3n_ev, a3m_t₁]
#print axioms IntersectionProductScaf_familyParameterSections_chart

end FamilyBoundaryParameter

section TranslatedChartSections
open CategoryTheory.Limits MvPolynomial
attribute [local instance] MvPolynomial.gradedAlgebra
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
/-- Factoring through a spatial chart gives global homogeneous sections for the translated map. -/
theorem IntersectionProductScaf_translatedProjection_of_chart_sections
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] {n : ℕ}
    {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (Z : Over (Spec ↧ℂ)) (q : Z.left ⟶ X.left)
    (j : Fin (a3s_N X + 1)) (u : Z.left ⟶ Spec ((a3s_CX X).T j))
    (hu : u ≫ (a3s_CX X).κ j = q)
    (A : Matrix (Fin (n + 1)) (Fin (n + 1)) Γ(Z.left, ⊤)) (hA : IsUnit A.det) :
    IntersectionProductScaf_translatedProjection₀ X hfin Z q A hA =
      Proj.fromOfGlobalSections (UniversalGrading n)
        (IntersectionProductScaf_matrixSections A (u.appTop.hom.comp (a3h_sect X (a3r_mat a) j)))
        (by rw [IntersectionProductScaf_matrixSections_irrelevant A hA,
          ← Ideal.map_map, a3h_sect_irrelevant X hfin, Ideal.map_top]) := by
  let f := u.appTop.hom.comp (a3h_sect X (a3r_mat a) j)
  have hf : (HomogeneousIdeal.irrelevant (UniversalGrading n)).toIdeal.map f = ⊤ := by
    rw [← Ideal.map_map, a3h_sect_irrelevant X hfin, Ideal.map_top]
  rw [IntersectionProductScaf_translatedProjection₀_matrixMap]
  apply IntersectionProductScaf_projectiveMatrixMap_ofSections Z.left _ A hA f hf
  change q ≫ a3h_π X hfin ≫ pullback.snd _ _ = _
  rw [← hu, Category.assoc, a3h_π_snd, a3h_κ_π₀, a3h_chartMap,
    spec_g3c_comp_fromOfGlobalSections_aux _ u _ _ hf]
#print axioms IntersectionProductScaf_translatedProjection_of_chart_sections

/-- Reciprocal translation coordinates rescale the finite pencil to its regular infinity chart. -/
theorem IntersectionProductScaf_reciprocal_pencil_matrix
    {R σ : Type} [CommRing R] [Fintype σ] [DecidableEq σ]
    (M : Matrix σ σ R) (s u : R) (hu : u * s = 1) :
    (u - 1) • (1 : Matrix σ σ R) + M =
      u • ((1 - s) • (1 : Matrix σ σ R) + s • M) := by
  rw [smul_add, smul_smul, smul_smul, mul_sub, mul_one, hu, one_smul]
#print axioms IntersectionProductScaf_reciprocal_pencil_matrix

/-- Scalar rescaling of a matrix rescales homogeneous section evaluations by their degree. -/
theorem IntersectionProductScaf_matrixSections_smul_homogeneous
    {R B σ : Type} [CommRing R] [CommRing B] [Fintype σ]
    (A : Matrix σ σ B) (f : MvPolynomial σ R →+* B) (u : B)
    (F : MvPolynomial σ R) (d : ℕ) (hF : F.IsHomogeneous d) :
    IntersectionProductScaf_matrixSections (u • A) f F =
      u ^ d * IntersectionProductScaf_matrixSections A f F := by
  apply a3m_twist (IntersectionProductScaf_matrixSections (u • A) f)
    (IntersectionProductScaf_matrixSections A f) u _ _ F d hF
  · intro c
    simp [IntersectionProductScaf_matrixSections]
  · intro k
    simp [IntersectionProductScaf_matrixSections, Matrix.mulVec, dotProduct,
      Finset.mul_sum, mul_assoc]
#print axioms IntersectionProductScaf_matrixSections_smul_homogeneous
open HomogeneousLocalization in
/-- The two affine coordinate sections multiply to one on their common domain. -/
theorem IntersectionProductScaf_parameter_chart_reciprocal
    (W : Scheme.{0}) (u : W ⟶ Spec (.of (a3n_A 0)))
    (v : W ⟶ Spec (.of (a3n_A 1)))
    (h : u ≫ g3c_chartι 1 0 = v ≫ g3c_chartι 1 1) :
    v.appTop ((Scheme.ΓSpecIso _).inv (chartCoordinate (1 : Fin 2) 0)) *
      u.appTop ((Scheme.ΓSpecIso _).inv (chartCoordinate (0 : Fin 2) 1)) = 1 := by
  let l := pullback.lift u v h
  have he := congrArg (fun s => l.appTop s) (g3c_overlap_coord 1 0 1 1)
  simp only [chartCoordinate_self, map_one, map_mul] at he
  rw [← a3m_appTop_comp_apply, ← a3m_appTop_comp_apply,
    show l ≫ pullback.snd (g3c_chartι 1 0) (g3c_chartι 1 1) = v from pullback.lift_snd _ _ _,
    show l ≫ pullback.fst (g3c_chartι 1 0) (g3c_chartι 1 1) = u from pullback.lift_fst _ _ _] at he
  exact he.symm
#print axioms IntersectionProductScaf_parameter_chart_reciprocal
/-- Unit rescaling of a matrix leaves the projective morphism of its sections unchanged. -/
theorem IntersectionProductScaf_matrixSections_projective_smul
    {n : ℕ} (Z : Scheme.{0}) (f : UniversalRing n →+* Γ(Z, ⊤))
    (A : Matrix (Fin (n + 1)) (Fin (n + 1)) Γ(Z, ⊤)) (u : Γ(Z, ⊤)ˣ)
    (hA : (HomogeneousIdeal.irrelevant (UniversalGrading n)).toIdeal.map
      (IntersectionProductScaf_matrixSections A f) = ⊤)
    (hB : (HomogeneousIdeal.irrelevant (UniversalGrading n)).toIdeal.map
      (IntersectionProductScaf_matrixSections ((u : Γ(Z, ⊤)) • A) f) = ⊤) :
    Proj.fromOfGlobalSections (UniversalGrading n)
        (IntersectionProductScaf_matrixSections A f) hA =
      Proj.fromOfGlobalSections (UniversalGrading n)
        (IntersectionProductScaf_matrixSections ((u : Γ(Z, ⊤)) • A) f) hB := by
  apply spec_g3c_fromOfGlobalSections_unit_twist_aux _ _ _ hA hB u
  intro d F hF
  exact IntersectionProductScaf_matrixSections_smul_homogeneous A f u F d
    ((mem_homogeneousSubmodule _ _).mp hF)
#print axioms IntersectionProductScaf_matrixSections_projective_smul
end TranslatedChartSections

section BoundaryProductChart
open CategoryTheory.Limits MvPolynomial HomogeneousLocalization
attribute [local instance] MvPolynomial.gradedAlgebra
attribute [local instance] Ring.toIntAlgebra AddCommGroup.toIntModule
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
variable (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom]
 (j : Fin (a3s_N X + 1)) (r : Fin 2)

/-- The double affine chart with affine original parameter and either translation coordinate. -/
def IntersectionProductScaf_boundaryProductChart :
    Spec (CommRingCat.of (TensorProduct ℤ (a3m_TT (a3s_CX X) j)
      (Away (UniversalGrading 1) (MvPolynomial.X r)))) ⟶ (a3n_T (a3n_T X)).left :=
  a3m_prodChart (a3m_Tκ (a3s_CX X) j ≫ (a3h_e X).inv) (g3c_chartι 1 r) ≫
    (a3h_e (a3n_T X)).inv

/-- The double affine boundary chart is an open immersion. -/
instance IntersectionProductScaf_boundaryProductChart_isOpenImmersion :
    IsOpenImmersion (IntersectionProductScaf_boundaryProductChart X j r) := by
  unfold IntersectionProductScaf_boundaryProductChart
  infer_instance

/-- The translation projection of a double chart is its second affine coordinate chart. -/
theorem IntersectionProductScaf_boundaryProductChart_translation :
    IntersectionProductScaf_boundaryProductChart X j r ≫ a3n_h (a3n_T X) =
      Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight
        (R := ℤ) (A := a3m_TT (a3s_CX X) j)
        (B := Away (UniversalGrading 1) (MvPolynomial.X r))).toRingHom) ≫
          g3c_chartι 1 r := by
  rw [IntersectionProductScaf_boundaryProductChart, Category.assoc,
    ← a3h_e_snd (a3n_T X), Iso.inv_hom_id_assoc, a3m_prodChart_snd]
#print axioms IntersectionProductScaf_boundaryProductChart_translation
/-- The first projection of a double chart retains its original affine family chart. -/
theorem IntersectionProductScaf_boundaryProductChart_original :
    IntersectionProductScaf_boundaryProductChart X j r ≫
        (a3n_q (a3n_T X)).left ≫ (a3h_e X).hom =
      Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom
        (R := ℤ) (A := a3m_TT (a3s_CX X) j)
        (B := Away (UniversalGrading 1) (MvPolynomial.X r)))) ≫
          a3m_Tκ (a3s_CX X) j := by
  simp only [IntersectionProductScaf_boundaryProductChart, Category.assoc]
  rw [← a3h_e_fst (a3n_T X)]
  simp only [Category.assoc, Iso.inv_hom_id_assoc]
  rw [← Category.assoc, a3m_prodChart_fst]
  simp only [Category.assoc, Iso.inv_hom_id, Category.comp_id]
#print axioms IntersectionProductScaf_boundaryProductChart_original

/-- The spatial projection of a double chart is its first tensor factor. -/
theorem IntersectionProductScaf_boundaryProductChart_spatial :
    IntersectionProductScaf_boundaryProductChart X j r ≫
        (a3n_q (a3n_T X)).left ≫ (a3n_q X).left =
      Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom
        (R := ℤ) (A := a3m_TT (a3s_CX X) j)
        (B := Away (UniversalGrading 1) (MvPolynomial.X r)))) ≫
      Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom
        (R := ℤ) (A := (a3s_CX X).T j) (B := a3m_Away1))) ≫ (a3s_CX X).κ j := by
  have h := congrArg (fun m => m ≫ pullback.fst
      (terminal.from X.left) (terminal.from (g3c_P 1)))
    (IntersectionProductScaf_boundaryProductChart_original X j r)
  simpa only [Category.assoc, a3h_e_fst, a3m_Tκ, a3m_prodChart_fst] using h


#print axioms IntersectionProductScaf_boundaryProductChart_spatial
/-- The original parameter of a double chart is its middle tensor factor. -/
theorem IntersectionProductScaf_boundaryProductChart_original_parameter :
    IntersectionProductScaf_boundaryProductChart X j r ≫
        (a3n_q (a3n_T X)).left ≫ a3n_h X =
      Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom
        (R := ℤ) (A := a3m_TT (a3s_CX X) j)
        (B := Away (UniversalGrading 1) (MvPolynomial.X r)))) ≫
      Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight
        (R := ℤ) (A := (a3s_CX X).T j) (B := a3m_Away1)).toRingHom) ≫ g3c_chartι 1 0 := by
  have h := congrArg (fun m => m ≫ pullback.snd
      (terminal.from X.left) (terminal.from (g3c_P 1)))
    (IntersectionProductScaf_boundaryProductChart_original X j r)
  simpa only [Category.assoc, a3h_e_snd, a3m_Tκ, a3m_prodChart_snd] using h
#print axioms IntersectionProductScaf_boundaryProductChart_original_parameter
/-- The double boundary chart with its complex scalar structure. -/
def IntersectionProductScaf_boundaryProductOver : Over (Spec ↧ℂ) :=
  Over.mk (IntersectionProductScaf_boundaryProductChart X j r ≫ (a3n_T (a3n_T X)).hom)

/-- Original affine parameter sections on a double boundary chart. -/
def IntersectionProductScaf_boundaryOriginalSections : a3m_Away1 →+*
    Γ((IntersectionProductScaf_boundaryProductOver X j r).left, ⊤) :=
  (Scheme.ΓSpecIso _).inv.hom.comp
    ((Algebra.TensorProduct.includeLeftRingHom
      (R := ℤ) (A := a3m_TT (a3s_CX X) j)
      (B := Away (UniversalGrading 1) (MvPolynomial.X r))).comp
      (Algebra.TensorProduct.includeRight
        (R := ℤ) (A := (a3s_CX X).T j) (B := a3m_Away1)).toRingHom)

/-- Translation parameter sections on either affine chart of the translation line. -/
def IntersectionProductScaf_boundaryTranslationSections :
    Away (UniversalGrading 1) (MvPolynomial.X r) →+*
      Γ((IntersectionProductScaf_boundaryProductOver X j r).left, ⊤) :=
  (Scheme.ΓSpecIso _).inv.hom.comp
    (Algebra.TensorProduct.includeRight
      (R := ℤ) (A := a3m_TT (a3s_CX X) j)
      (B := Away (UniversalGrading 1) (MvPolynomial.X r))).toRingHom

/-- The original affine parameter sections recover the parameter morphism. -/
theorem IntersectionProductScaf_boundaryOriginalSections_map :
    (IntersectionProductScaf_boundaryProductOver X j r).left.toSpecΓ ≫
      Spec.map (CommRingCat.ofHom (IntersectionProductScaf_boundaryOriginalSections X j r)) ≫
        g3c_chartι 1 0 =
      IntersectionProductScaf_boundaryProductChart X j r ≫
        (a3n_q (a3n_T X)).left ≫ a3n_h X := by
  rw [IntersectionProductScaf_boundaryProductChart_original_parameter]
  change (Spec _).toSpecΓ ≫ Spec.map
    ((CommRingCat.ofHom (Algebra.TensorProduct.includeRight
      (R := ℤ) (A := (a3s_CX X).T j) (B := a3m_Away1)).toRingHom) ≫
    (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom
      (R := ℤ) (A := a3m_TT (a3s_CX X) j)
      (B := Away (UniversalGrading 1) (MvPolynomial.X r)))) ≫
    (Scheme.ΓSpecIso _).inv) ≫ _ = _
  simp only [Spec.map_comp, Category.assoc, toSpecΓ_SpecMap_ΓSpecIso_inv_assoc]
#print axioms IntersectionProductScaf_boundaryOriginalSections_map

/-- The translation parameter sections recover the selected affine parameter chart. -/
theorem IntersectionProductScaf_boundaryTranslationSections_map :
    (IntersectionProductScaf_boundaryProductOver X j r).left.toSpecΓ ≫
      Spec.map (CommRingCat.ofHom (IntersectionProductScaf_boundaryTranslationSections X j r)) ≫
        g3c_chartι 1 r =
      IntersectionProductScaf_boundaryProductChart X j r ≫ a3n_h (a3n_T X) := by
  rw [IntersectionProductScaf_boundaryProductChart_translation]
  change (Spec _).toSpecΓ ≫ Spec.map
    ((CommRingCat.ofHom (Algebra.TensorProduct.includeRight
      (R := ℤ) (A := a3m_TT (a3s_CX X) j)
      (B := Away (UniversalGrading 1) (MvPolynomial.X r))).toRingHom) ≫
    (Scheme.ΓSpecIso _).inv) ≫ _ = _
  simp only [Spec.map_comp, Category.assoc, toSpecΓ_SpecMap_ΓSpecIso_inv_assoc]
#print axioms IntersectionProductScaf_boundaryTranslationSections_map

/-- Double boundary charts cover every point whose original parameter is affine. -/
theorem IntersectionProductScaf_boundaryProductChart_covers
    (w : (a3n_T (a3n_T X)).left)
    (hw : (a3n_q (a3n_T X)).left w ∈ a3h_U X) :
    ∃ j r, w ∈ Set.range (IntersectionProductScaf_boundaryProductChart X j r) := by
  obtain ⟨j, p, hp⟩ := a3m_U_cover (a3s_CX X)
    ((a3h_e X).hom ((a3n_q (a3n_T X)).left w))
    ((a3h_mem_U_iff X _).mp hw)
  obtain ⟨r, q, hq⟩ := g3c_chartι_covers 1 (a3n_h (a3n_T X) w)
  have hf : (a3h_e (a3n_T X)).hom w ∈ Set.range
      (a3m_prodChart (a3m_Tκ (a3s_CX X) j ≫ (a3h_e X).inv) (g3c_chartι 1 r)) := by
    rw [a3m_range_prodChart]
    simp only [Set.mem_inter_iff, Set.mem_preimage]
    constructor
    · rw [a3h_e_fst_apply]
      refine ⟨p, ?_⟩
      rw [Scheme.Hom.comp_apply, hp]
      exact (Scheme.Hom.comp_apply _ _ _).symm.trans
        (congrArg (fun f : (a3n_T X).left ⟶ (a3n_T X).left =>
          f ((a3n_q (a3n_T X)).left w)) (a3h_e X).hom_inv_id)
    · rw [a3h_e_snd_apply]
      exact ⟨q, hq⟩
  obtain ⟨z, hz⟩ := hf
  refine ⟨j, r, z, ?_⟩
  change (a3h_e (a3n_T X)).inv
    (a3m_prodChart (a3m_Tκ (a3s_CX X) j ≫ (a3h_e X).inv) (g3c_chartι 1 r) z) = w
  rw [hz]
  exact (Scheme.Hom.comp_apply _ _ _).symm.trans
    (congrArg (fun f : (a3n_T (a3n_T X)).left ⟶ (a3n_T (a3n_T X)).left => f w)
      (a3h_e (a3n_T X)).hom_inv_id)
#print axioms IntersectionProductScaf_boundaryProductChart_covers
/-- The spatial affine chart map carried by a double boundary chart. -/
def IntersectionProductScaf_boundarySpatialChart :
    (IntersectionProductScaf_boundaryProductOver X j r).left ⟶ Spec ((a3s_CX X).T j) :=
  Spec.map (CommRingCat.ofHom
    ((Algebra.TensorProduct.includeLeftRingHom
      (R := ℤ) (A := a3m_TT (a3s_CX X) j)
      (B := Away (UniversalGrading 1) (MvPolynomial.X r))).comp
      (Algebra.TensorProduct.includeLeftRingHom
        (R := ℤ) (A := (a3s_CX X).T j) (B := a3m_Away1))))

/-- The normalized spatial chart represents the spatial projection of the double family. -/
theorem IntersectionProductScaf_boundarySpatialChart_projection :
    IntersectionProductScaf_boundarySpatialChart X j r ≫ (a3s_CX X).κ j =
      IntersectionProductScaf_boundaryProductChart X j r ≫
        (a3n_q (a3n_T X)).left ≫ (a3n_q X).left := by
  rw [IntersectionProductScaf_boundaryProductChart_spatial]
  change Spec.map ((CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom
      (R := ℤ) (A := (a3s_CX X).T j) (B := a3m_Away1))) ≫
    (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom
      (R := ℤ) (A := a3m_TT (a3s_CX X) j)
      (B := Away (UniversalGrading 1) (MvPolynomial.X r))))) ≫ _ = _
  rw [Spec.map_comp, Category.assoc]
#print axioms IntersectionProductScaf_boundarySpatialChart_projection

/-- Normalized projection sections on a double boundary chart. -/
def IntersectionProductScaf_boundaryProjectionSections {n : ℕ}
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ) :
    UniversalRing n →+* Γ((IntersectionProductScaf_boundaryProductOver X j r).left, ⊤) :=
  (IntersectionProductScaf_boundarySpatialChart X j r).appTop.hom.comp
    (a3h_sect X (a3r_mat a) j)

/-- Normalized projection sections generate the unit ideal on every double boundary chart. -/
theorem IntersectionProductScaf_boundaryProjectionSections_irrelevant {n : ℕ}
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite) :
    (HomogeneousIdeal.irrelevant (UniversalGrading n)).toIdeal.map
      (IntersectionProductScaf_boundaryProjectionSections X j r a) = ⊤ := by
  rw [IntersectionProductScaf_boundaryProjectionSections,
    ← Ideal.map_map, a3h_sect_irrelevant X hfin, Ideal.map_top]
#print axioms IntersectionProductScaf_boundaryProjectionSections_irrelevant

/-- The regular pencil matrix in either translation parameter chart. -/
def IntersectionProductScaf_boundaryPencilMatrix {n : ℕ}
    (M : Fin (n + 1) × Fin (n + 1) → ℂ) :
    Matrix (Fin (n + 1)) (Fin (n + 1))
      Γ((IntersectionProductScaf_boundaryProductOver X j r).left, ⊤) :=
  let u := IntersectionProductScaf_boundaryTranslationSections X j r (chartCoordinate r r.rev)
  let A := (IntersectionProductScaf_complexScalars
    (IntersectionProductScaf_boundaryProductOver X j r)).mapMatrix (a3r_mat M)
  if r = 0 then (1 - u) • 1 + u • A else (u - 1) • 1 + A

/-- Regular homogeneous pencil sections on the double boundary chart. -/
def IntersectionProductScaf_boundaryPencilSections {n : ℕ}
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (M : Fin (n + 1) × Fin (n + 1) → ℂ) :
    UniversalRing n →+* Γ((IntersectionProductScaf_boundaryProductOver X j r).left, ⊤) :=
  IntersectionProductScaf_matrixSections (IntersectionProductScaf_boundaryPencilMatrix X j r M)
    (IntersectionProductScaf_boundaryProjectionSections X j r a)

/-- Regular evaluations of relative pencil equations, including both parameter charts. -/
def IntersectionProductScaf_boundaryRelativeSections {n : ℕ}
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (M : Fin (n + 1) × Fin (n + 1) → ℂ) :
    MvPolynomial (Fin (n + 1)) (Polynomial ℂ) →+*
      Γ((IntersectionProductScaf_boundaryProductOver X j r).left, ⊤) :=
  MvPolynomial.eval₂Hom
    (Polynomial.eval₂RingHom
      (IntersectionProductScaf_complexScalars (IntersectionProductScaf_boundaryProductOver X j r))
      (IntersectionProductScaf_boundaryOriginalSections X j r a3m_t₁))
    (fun k => IntersectionProductScaf_boundaryPencilSections X j r a M (MvPolynomial.X k))
#print axioms IntersectionProductScaf_boundaryPencilMatrix
#print axioms IntersectionProductScaf_boundaryPencilSections
#print axioms IntersectionProductScaf_boundaryRelativeSections
#print axioms IntersectionProductScaf_boundaryProductChart
#print axioms IntersectionProductScaf_boundaryProductChart_isOpenImmersion
#print axioms IntersectionProductScaf_boundaryProductOver
#print axioms IntersectionProductScaf_boundaryOriginalSections
#print axioms IntersectionProductScaf_boundaryTranslationSections
#print axioms IntersectionProductScaf_boundarySpatialChart
#print axioms IntersectionProductScaf_boundaryProjectionSections
end BoundaryProductChart

section BoundaryOverlap
open CategoryTheory.Limits MvPolynomial HomogeneousLocalization
attribute [local instance] MvPolynomial.gradedAlgebra
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
variable (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom]
  {n : ℕ} (M : Fin (n + 1) × Fin (n + 1) → ℂ)
  (j : Fin (a3s_N X + 1)) (r : Fin 2)
  (Z : Over (Spec ↧ℂ))
  (u : Z ⟶ IntersectionProductScaf_familyOpen (a3n_T X) M)
  (v : Z ⟶ IntersectionProductScaf_boundaryProductOver X j r)
  (h : u.left ≫ (IntersectionProductScaf_familyInclusion (a3n_T X) M).left =
    v.left ≫ IntersectionProductScaf_boundaryProductChart X j r)

include h in
/-- The two parameter charts describe the same translation point on a common family domain. -/
theorem IntersectionProductScaf_boundary_parameter_overlap :
    (u.left ≫ IntersectionProductScaf_familyIntegralParameterChart (a3n_T X) M) ≫
        g3c_chartι 1 0 =
      (v.left ≫ (IntersectionProductScaf_boundaryProductOver X j r).left.toSpecΓ ≫
        Spec.map (CommRingCat.ofHom (IntersectionProductScaf_boundaryTranslationSections X j r))) ≫
          g3c_chartι 1 r := by
  simp only [Category.assoc]
  rw [IntersectionProductScaf_familyIntegralParameterChart_inclusion,
    IntersectionProductScaf_boundaryTranslationSections_map]
  simpa only [Category.assoc] using
    congrArg (fun f => f ≫ a3n_h (a3n_T X)) h
#print axioms IntersectionProductScaf_boundary_parameter_overlap

/-- A boundary parameter section is read unchanged after restriction to a common domain. -/
theorem IntersectionProductScaf_boundaryTranslationSections_restrict
    (b : a3n_A r) :
    (v.left ≫ (IntersectionProductScaf_boundaryProductOver X j r).left.toSpecΓ ≫
      Spec.map (CommRingCat.ofHom (IntersectionProductScaf_boundaryTranslationSections X j r))).appTop
        ((Scheme.ΓSpecIso _).inv b) =
      v.left.appTop (IntersectionProductScaf_boundaryTranslationSections X j r b) := by
  rw [a3m_appTop_comp_apply, a3m_appTop_comp_SpecMap, Scheme.toSpecΓ_appTop]
  simp
#print axioms IntersectionProductScaf_boundaryTranslationSections_restrict


/-- The finite boundary coordinate equals the family translation parameter on their common domain. -/
theorem IntersectionProductScaf_boundary_parameter_finite
    (v0 : Z ⟶ IntersectionProductScaf_boundaryProductOver X j 0)
    (h0 : u.left ≫ (IntersectionProductScaf_familyInclusion (a3n_T X) M).left =
      v0.left ≫ IntersectionProductScaf_boundaryProductChart X j 0) :
    v0.left.appTop (IntersectionProductScaf_boundaryTranslationSections X j 0 a3m_t₁) =
      u.left.appTop (IntersectionProductScaf_familyParameterSections (a3n_T X) M Polynomial.X) := by
  have he := (cancel_mono (g3c_chartι 1 0)).mp
    (IntersectionProductScaf_boundary_parameter_overlap X M j 0 Z u v0 h0)
  have hs := congrArg (fun f : Z.left ⟶ Spec (.of a3m_Away1) =>
    f.appTop ((Scheme.ΓSpecIso _).inv a3m_t₁)) he
  rw [IntersectionProductScaf_boundaryTranslationSections_restrict] at hs
  rw [a3m_appTop_comp_apply] at hs
  have hτ := IntersectionProductScaf_familyParameterSections_chart (a3n_T X) M
  change (IntersectionProductScaf_familyIntegralParameterChart (a3n_T X) M).appTop
    ((Scheme.ΓSpecIso _).inv a3m_t₁) = _ at hτ
  rw [hτ] at hs
  exact hs.symm
#print axioms IntersectionProductScaf_boundary_parameter_finite

/-- The infinity boundary coordinate is reciprocal to the family parameter on their common domain. -/
theorem IntersectionProductScaf_boundary_parameter_infinity
    (v1 : Z ⟶ IntersectionProductScaf_boundaryProductOver X j 1)
    (h1 : u.left ≫ (IntersectionProductScaf_familyInclusion (a3n_T X) M).left =
      v1.left ≫ IntersectionProductScaf_boundaryProductChart X j 1) :
    v1.left.appTop (IntersectionProductScaf_boundaryTranslationSections X j 1
        (chartCoordinate (1 : Fin 2) 0)) *
      u.left.appTop (IntersectionProductScaf_familyParameterSections (a3n_T X) M Polynomial.X) = 1 := by
  have hs := IntersectionProductScaf_parameter_chart_reciprocal Z.left
    (u.left ≫ IntersectionProductScaf_familyIntegralParameterChart (a3n_T X) M)
    (v1.left ≫ (IntersectionProductScaf_boundaryProductOver X j 1).left.toSpecΓ ≫
      Spec.map (CommRingCat.ofHom (IntersectionProductScaf_boundaryTranslationSections X j 1)))
    (IntersectionProductScaf_boundary_parameter_overlap X M j 1 Z u v1 h1)
  rw [IntersectionProductScaf_boundaryTranslationSections_restrict,
    a3m_appTop_comp_apply] at hs
  have hτ := IntersectionProductScaf_familyParameterSections_chart (a3n_T X) M
  change (IntersectionProductScaf_familyIntegralParameterChart (a3n_T X) M).appTop
    ((Scheme.ΓSpecIso _).inv (chartCoordinate (0 : Fin 2) 1)) = _ at hτ
  rwa [hτ] at hs
#print axioms IntersectionProductScaf_boundary_parameter_infinity

/-- Restricting regular pencil sections pulls back both their matrix and normalized spatial chart. -/
theorem IntersectionProductScaf_boundaryPencilSections_restrict
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ) :
    v.left.appTop.hom.comp (IntersectionProductScaf_boundaryPencilSections X j r a M) =
      IntersectionProductScaf_matrixSections
        (v.left.appTop.hom.mapMatrix (IntersectionProductScaf_boundaryPencilMatrix X j r M))
        ((v.left ≫ IntersectionProductScaf_boundarySpatialChart X j r).appTop.hom.comp
          (a3h_sect X (a3r_mat a) j)) := by
  rw [IntersectionProductScaf_boundaryPencilSections, IntersectionProductScaf_matrixSections_map]
  congr 1
#print axioms IntersectionProductScaf_boundaryPencilSections_restrict

/-- Finite boundary pencil sections restrict to the actual family matrix. -/
theorem IntersectionProductScaf_boundary_matrix_finite
    (v0 : Z ⟶ IntersectionProductScaf_boundaryProductOver X j 0)
    (h0 : u.left ≫ (IntersectionProductScaf_familyInclusion (a3n_T X) M).left =
      v0.left ≫ IntersectionProductScaf_boundaryProductChart X j 0) :
    v0.left.appTop.hom.mapMatrix (IntersectionProductScaf_boundaryPencilMatrix X j 0 M) =
      u.left.appTop.hom.mapMatrix (IntersectionProductScaf_familyMatrix (a3n_T X) M) := by
  have hs := IntersectionProductScaf_boundary_parameter_finite X M j Z u v0 h0
  rw [IntersectionProductScaf_familyMatrix_pencil]
  ext i k
  by_cases hik : i = k <;>
    simp [IntersectionProductScaf_boundaryPencilMatrix, Matrix.one_apply, hik,
      CommRingCat.Hom.hom, IntersectionProductScaf_complexScalars_map u,
      IntersectionProductScaf_complexScalars_map v0, hs, a3m_t₁]
  all_goals
    congr 1
    exact (IntersectionProductScaf_complexScalars_map u _).symm
#print axioms IntersectionProductScaf_boundary_matrix_finite

/-- Infinity boundary pencil sections restrict to a scalar multiple of the actual family matrix. -/
theorem IntersectionProductScaf_boundary_matrix_infinity
    (v1 : Z ⟶ IntersectionProductScaf_boundaryProductOver X j 1)
    (h1 : u.left ≫ (IntersectionProductScaf_familyInclusion (a3n_T X) M).left =
      v1.left ≫ IntersectionProductScaf_boundaryProductChart X j 1) :
    v1.left.appTop.hom.mapMatrix (IntersectionProductScaf_boundaryPencilMatrix X j 1 M) =
      v1.left.appTop (IntersectionProductScaf_boundaryTranslationSections X j 1
        (chartCoordinate (1 : Fin 2) 0)) •
        u.left.appTop.hom.mapMatrix (IntersectionProductScaf_familyMatrix (a3n_T X) M) := by
  let t := u.left.appTop (IntersectionProductScaf_familyParameterSections (a3n_T X) M Polynomial.X)
  let s := v1.left.appTop (IntersectionProductScaf_boundaryTranslationSections X j 1
    (chartCoordinate (1 : Fin 2) 0))
  let A := (IntersectionProductScaf_complexScalars Z).mapMatrix (a3r_mat M)
  have hv : v1.left.appTop.hom.mapMatrix (IntersectionProductScaf_boundaryPencilMatrix X j 1 M) =
      (s - 1) • 1 + A := by
    ext i k
    by_cases hik : i = k <;>
      simp [IntersectionProductScaf_boundaryPencilMatrix, Matrix.one_apply, hik,
        CommRingCat.Hom.hom, IntersectionProductScaf_complexScalars_map v1, s, A]
  have hu : u.left.appTop.hom.mapMatrix (IntersectionProductScaf_familyMatrix (a3n_T X) M) =
      (1 - t) • 1 + t • A := by
    rw [IntersectionProductScaf_familyMatrix_pencil]
    ext i k
    by_cases hik : i = k <;>
      simp [Matrix.one_apply, hik, CommRingCat.Hom.hom, IntersectionProductScaf_complexScalars_map u, t, A]
    all_goals
      congr 1
      exact IntersectionProductScaf_complexScalars_map u _
  rw [hv, hu]
  exact IntersectionProductScaf_reciprocal_pencil_matrix A t s
    (IntersectionProductScaf_boundary_parameter_infinity X M j Z u v1 h1)
#print axioms IntersectionProductScaf_boundary_matrix_infinity

include h in
/-- The regular boundary matrix is invertible on its intersection with the family open. -/
theorem IntersectionProductScaf_boundary_matrix_unit :
    IsUnit (v.left.appTop.hom.mapMatrix (IntersectionProductScaf_boundaryPencilMatrix X j r M)).det := by
  have hA : IsUnit (u.left.appTop.hom.mapMatrix
      (IntersectionProductScaf_familyMatrix (a3n_T X) M)).det := by
    rw [← RingHom.map_det]
    exact (IntersectionProductScaf_familyMatrix_det (a3n_T X) M).map _
  fin_cases r
  · erw [IntersectionProductScaf_boundary_matrix_finite X M j Z u v h]
    exact hA
  · erw [IntersectionProductScaf_boundary_matrix_infinity X M j Z u v h, Matrix.det_smul]
    have hs := IntersectionProductScaf_boundary_parameter_infinity X M j Z u v h
    have hu : IsUnit (v.left.appTop (IntersectionProductScaf_boundaryTranslationSections X j 1
        (chartCoordinate (1 : Fin 2) 0))) :=
      isUnit_iff_exists_inv.mpr ⟨_, hs⟩
    exact (hu.pow _).mul hA
#print axioms IntersectionProductScaf_boundary_matrix_unit

include h in
/-- Regular pencil sections generate the unit ideal on their common domain with the family. -/
theorem IntersectionProductScaf_boundaryPencilSections_irrelevant
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite) :
    (HomogeneousIdeal.irrelevant (UniversalGrading n)).toIdeal.map
      (v.left.appTop.hom.comp (IntersectionProductScaf_boundaryPencilSections X j r a M)) = ⊤ := by
  rw [IntersectionProductScaf_boundaryPencilSections_restrict,
    IntersectionProductScaf_matrixSections_irrelevant _
      (IntersectionProductScaf_boundary_matrix_unit X M j r Z u v h),
    ← Ideal.map_map, a3h_sect_irrelevant X hfin, Ideal.map_top]
#print axioms IntersectionProductScaf_boundaryPencilSections_irrelevant

include h in
set_option maxHeartbeats 400000 in
/-- Regular boundary pencil sections represent the spatial family projection on their common domain. -/
theorem IntersectionProductScaf_boundaryPencilSections_map
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite) :
    u.left ≫ (IntersectionProductScaf_squareMapToProjective X hfin M).left ≫
        pullback.snd (terminal.from (Spec ↧ℂ)) (terminal.from (g3c_P n)) =
      Proj.fromOfGlobalSections (UniversalGrading n)
        (v.left.appTop.hom.comp (IntersectionProductScaf_boundaryPencilSections X j r a M))
        (IntersectionProductScaf_boundaryPencilSections_irrelevant X M j r Z u v h a hfin) := by
  let q := (IntersectionProductScaf_familyBase (a3n_T X) M).left ≫ (a3n_q X).left
  let A := u.left.appTop.hom.mapMatrix (IntersectionProductScaf_familyMatrix (a3n_T X) M)
  have hA : IsUnit A.det := by
    rw [← RingHom.map_det]
    exact (IntersectionProductScaf_familyMatrix_det (a3n_T X) M).map _
  have hq : (v.left ≫ IntersectionProductScaf_boundarySpatialChart X j r) ≫
      (a3s_CX X).κ j = u.left ≫ q := by
    calc
      _ = (v.left ≫ IntersectionProductScaf_boundaryProductChart X j r) ≫
          (a3n_q (a3n_T X)).left ≫ (a3n_q X).left := by
        simp only [Category.assoc, IntersectionProductScaf_boundarySpatialChart_projection]
      _ = (u.left ≫ (IntersectionProductScaf_familyInclusion (a3n_T X) M).left) ≫
          (a3n_q (a3n_T X)).left ≫ (a3n_q X).left := by rw [h]
      _ = _ := by
        simp only [q, Category.assoc]
        rw [← Category.assoc (IntersectionProductScaf_familyInclusion (a3n_T X) M).left
          (a3n_q (a3n_T X)).left, IntersectionProductScaf_familyInclusion_base_projection]
  simp only [IntersectionProductScaf_squareMapToProjective, IntersectionProductScaf_translatedProjection,
    Over.homMk_left, Category.assoc, pullback.lift_snd]
  rw [IntersectionProductScaf_translatedProjection₀_natural X hfin
    (IntersectionProductScaf_familyOpen (a3n_T X) M) Z q u.left
    (IntersectionProductScaf_familyMatrix (a3n_T X) M)
    (IntersectionProductScaf_familyMatrix_det (a3n_T X) M) hA]
  rw [IntersectionProductScaf_translatedProjection_of_chart_sections X hfin Z (u.left ≫ q)
    j (v.left ≫ IntersectionProductScaf_boundarySpatialChart X j r) hq A hA]
  simp only [IntersectionProductScaf_boundaryPencilSections_restrict]
  have hr : r = 0 ∨ r = 1 := by fin_cases r <;> simp
  rcases hr with rfl | rfl
  · simp only [IntersectionProductScaf_boundary_matrix_finite X M j Z u v h]
    rfl
  · simp only [IntersectionProductScaf_boundary_matrix_infinity X M j Z u v h]
    have hs := IntersectionProductScaf_boundary_parameter_infinity X M j Z u v h
    have hu : IsUnit (v.left.appTop (IntersectionProductScaf_boundaryTranslationSections X j 1
        (chartCoordinate (1 : Fin 2) 0))) := isUnit_iff_exists_inv.mpr ⟨_, hs⟩
    apply spec_g3c_fromOfGlobalSections_unit_twist_aux _ _ _ _ _ hu.unit
    intro d F hF
    rw [hu.unit_spec]
    exact IntersectionProductScaf_matrixSections_smul_homogeneous _ _ _ F d
      ((mem_homogeneousSubmodule _ _).mp hF)
#print axioms IntersectionProductScaf_boundaryPencilSections_map

include h in
/-- Regular boundary sections retain the original parameter in the full relative family morphism. -/
theorem IntersectionProductScaf_boundaryRelativeSections_map
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite) :
    u.left ≫ (IntersectionProductScaf_familyMap₁ X hfin M).left ≫
        (a3h_e (a3h_PnO n)).hom =
      pullback.lift
        (pullback.lift Z.hom
          (Proj.fromOfGlobalSections (UniversalGrading n)
            (v.left.appTop.hom.comp (IntersectionProductScaf_boundaryPencilSections X j r a M))
            (IntersectionProductScaf_boundaryPencilSections_irrelevant X M j r Z u v h a hfin))
          (terminal.hom_ext _ _))
        (Z.left.toSpecΓ ≫ Spec.map (CommRingCat.ofHom
          (v.left.appTop.hom.comp (IntersectionProductScaf_boundaryOriginalSections X j r))) ≫
          g3c_chartι 1 0) (terminal.hom_ext _ _) := by
  apply pullback.hom_ext
  · simp only [Category.assoc, a3h_e_fst, pullback.lift_fst]
    change u.left ≫ (IntersectionProductScaf_familyMap₁ X hfin M).left ≫
      (a3n_q (a3h_PnO n)).left = _
    simp only [IntersectionProductScaf_familyMap₁, a3n_q, Over.homMk_left, pullback.lift_fst]
    apply pullback.hom_ext
    · simp only [Category.assoc, pullback.lift_fst]
      change u.left ≫ (IntersectionProductScaf_squareMapToProjective X hfin M).left ≫
        (a3h_PnO n).hom = Z.hom
      rw [Over.w, Over.w]
    · simp only [Category.assoc, pullback.lift_snd]
      exact IntersectionProductScaf_boundaryPencilSections_map X M j r Z u v h a hfin
  · simp only [Category.assoc, a3h_e_snd, pullback.lift_snd]
    change u.left ≫ (IntersectionProductScaf_familyMap₁ X hfin M).left ≫
      a3n_p (a3h_PnO n) ≫ a3n_π = _
    rw [← Category.assoc (IntersectionProductScaf_familyMap₁ X hfin M).left,
      IntersectionProductScaf_familyMap₁_parameter]
    change u.left ≫ (IntersectionProductScaf_familyBase (a3n_T X) M).left ≫ a3n_h X = _
    have he := congrArg (fun f => f ≫ (a3n_q (a3n_T X)).left ≫ a3n_h X) h
    simp only [Category.assoc] at he
    rw [← Category.assoc (IntersectionProductScaf_familyInclusion (a3n_T X) M).left
      (a3n_q (a3n_T X)).left, IntersectionProductScaf_familyInclusion_base_projection] at he
    rw [he]
    symm
    change Z.left.toSpecΓ ≫ Spec.map
      ((CommRingCat.ofHom (IntersectionProductScaf_boundaryOriginalSections X j r)) ≫
        v.left.appTop) ≫ g3c_chartι 1 0 = _
    rw [Spec.map_comp]
    simp only [Category.assoc]
    rw [← Category.assoc Z.left.toSpecΓ (Spec.map v.left.appTop),
      ← Scheme.toSpecΓ_naturality, Category.assoc,
      IntersectionProductScaf_boundaryOriginalSections_map]
#print axioms IntersectionProductScaf_boundaryRelativeSections_map

end BoundaryOverlap

section RelativeSupportExtension
open CategoryTheory.Limits MvPolynomial TopologicalSpace
attribute [local instance] MvPolynomial.gradedAlgebra
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
/-- Relative homogeneous equations extend from an ideal support to its boundary in an open chart. -/
theorem IntersectionProductScaf_relativeSections_extended_support
    {n : ℕ} {U V : Scheme} (i : U ⟶ V) [QuasiCompact i]
    (I : U.IdealSheafData) (W : Over (Spec ↧ℂ))
    (j : W.left ⟶ V) [IsOpenImmersion j]
    (f : UniversalRing n →+* Γ(W.left, ⊤)) (g : a3m_Away1 →+* Γ(W.left, ⊤))
    (hf : (HomogeneousIdeal.irrelevant (UniversalGrading n)).toIdeal.map
      ((pullback.snd i j).appTop.hom.comp f) = ⊤)
    (k : pullback i j ⟶ (a3m_U (a3m_Pn n)).toScheme)
    (hk : k ≫ (a3m_U (a3m_Pn n)).ι =
      pullback.lift
        (pullback.lift (pullback.snd i j ≫ W.hom)
          (Proj.fromOfGlobalSections (UniversalGrading n)
            ((pullback.snd i j).appTop.hom.comp f) hf) (terminal.hom_ext _ _))
        ((pullback i j).toSpecΓ ≫ Spec.map (CommRingCat.ofHom
          ((pullback.snd i j).appTop.hom.comp g)) ≫ g3c_chartι 1 0)
        (terminal.hom_ext _ _))
    (y : (a3m_U (a3m_Pn n)).toScheme)
    (hI : ∀ z : (pullback i j : Scheme), pullback.fst i j z ∈ I.support → y ⤳ k z)
    (F : MvPolynomial (Fin (n + 1)) (Polynomial ℂ))
    (d : ℕ) (hF : F.IsHomogeneous d)
    (hyF : F ∈ (a3m_lineCharts (a3m_projCharts n) (a3m_Pn_hov n)).prime y)
    (w : W.left) (hw : j w ∈ (I.map i).support) :
    ¬ IsUnit (W.left.presheaf.germ ⊤ w (by trivial)
      (eval₂Hom (Polynomial.eval₂RingHom (IntersectionProductScaf_complexScalars W)
        (g a3m_t₁)) (fun r => f (MvPolynomial.X r)) F)) := by
  apply IntersectionProductScaf_extendedIdeal_chart_vanishing i I j _ ?_ w hw
  intro v hv
  obtain ⟨u, hu, huv⟩ := hv
  obtain ⟨z, hzu, hzv⟩ := Scheme.Pullback.exists_preimage_pullback u v huv
  let P : Over (Spec ↧ℂ) := Over.mk (pullback.snd i j ≫ W.hom)
  let h : P ⟶ W := Over.homMk (pullback.snd i j) rfl
  have hzF := (a3m_lineCharts (a3m_projCharts n) (a3m_Pn_hov n)).prime_mono
    (hI z (by rwa [hzu])) hyF
  have he : (pullback.lift
      (pullback.lift P.hom (Proj.fromOfGlobalSections (UniversalGrading n)
        (h.left.appTop.hom.comp f) hf) (terminal.hom_ext _ _))
      (P.left.toSpecΓ ≫ Spec.map (CommRingCat.ofHom (h.left.appTop.hom.comp g)) ≫
        g3c_chartι 1 0) (terminal.hom_ext _ _) : P.left ⟶ a3m_T (a3m_Pn n)) z =
      (a3m_U (a3m_Pn n)).ι (k z) := by
    exact (congrArg (fun m : (pullback i j : Scheme) ⟶ a3m_T (a3m_Pn n) => m z) hk).symm
  have hz := (IntersectionProductScaf_relativeSections_prime P
    (h.left.appTop.hom.comp f) (h.left.appTop.hom.comp g) hf z (k z) he F d hF).mp hzF
  have hn := congrArg (fun r : MvPolynomial (Fin (n + 1)) (Polynomial ℂ) →+*
      Γ(P.left, ⊤) => r F)
    (IntersectionProductScaf_relativeSections_natural W f g P h)
  change h.left.appTop _ = _ at hn
  rw [← hn] at hz
  intro hvunit
  apply hz
  rw [← Scheme.mem_basicOpen_top, ← Scheme.preimage_basicOpen_top]
  change pullback.snd i j z ∈ W.left.basicOpen _
  rw [hzv]
  exact (W.left.mem_basicOpen_top _ v).mpr hvunit
#print axioms IntersectionProductScaf_relativeSections_extended_support

section ComplexParameterSections
open CategoryTheory.Limits MvPolynomial HomogeneousLocalization
attribute [local instance] MvPolynomial.gradedAlgebra
attribute [local instance] Ring.toIntAlgebra AddCommGroup.toIntModule
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
variable (Z : Over (Spec ↧ℂ)) (r : Fin 2) (g : a3n_A r →+* Γ(Z.left, ⊤))

/-- A complex parameter chart evaluated by its scalar and integral parameter sections. -/
def IntersectionProductScaf_complexParameterSections : a3m_PnT 1 r →+* Γ(Z.left, ⊤) :=
  (Algebra.TensorProduct.productMap
    (IntersectionProductScaf_complexScalars Z).toIntAlgHom g.toIntAlgHom).toRingHom

/-- Scalar and parameter sections represent the associated complex projective parameter map. -/
theorem IntersectionProductScaf_complexParameterSections_map :
    Z.left.toSpecΓ ≫ Spec.map (CommRingCat.ofHom
      (IntersectionProductScaf_complexParameterSections Z r g)) ≫ a3m_Pnκ 1 r =
      pullback.lift Z.hom
        (Z.left.toSpecΓ ≫ Spec.map (CommRingCat.ofHom g) ≫ g3c_chartι 1 r)
        (terminal.hom_ext _ _) := by
  apply pullback.hom_ext
  · simp only [Category.assoc, pullback.lift_fst]
    rw [a3m_Pnκ, a3m_prodChart_fst, Category.comp_id, ← Spec.map_comp]
    have he : (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom
        (R := ℤ) (A := ℂ) (B := a3n_A r))) ≫
        CommRingCat.ofHom (IntersectionProductScaf_complexParameterSections Z r g) =
        (Scheme.ΓSpecIso (.of ℂ)).inv ≫ Z.hom.appTop := by
      ext c
      simp [IntersectionProductScaf_complexParameterSections, IntersectionProductScaf_complexScalars,
        Algebra.TensorProduct.productMap_apply_tmul]
    rw [he, Spec.map_comp, ← Category.assoc, ← Scheme.toSpecΓ_naturality,
      Category.assoc, toSpecΓ_SpecMap_ΓSpecIso_inv, Category.comp_id]
  · simp only [Category.assoc, pullback.lift_snd]
    rw [a3m_Pnκ, a3m_prodChart_snd, ← Category.assoc (Spec.map _) (Spec.map _),
      ← Spec.map_comp]
    have he : (CommRingCat.ofHom (Algebra.TensorProduct.includeRight
        (R := ℤ) (A := ℂ) (B := a3n_A r)).toRingHom) ≫
        CommRingCat.ofHom (IntersectionProductScaf_complexParameterSections Z r g) =
        CommRingCat.ofHom g := by
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro b
      change IntersectionProductScaf_complexScalars Z 1 * g b = g b
      simp
    rw [he]
#print axioms IntersectionProductScaf_complexParameterSections_map

/-- The affine parameter equivalence evaluates in the chosen coordinate section. -/
theorem IntersectionProductScaf_complexParameterSections_equiv :
    (IntersectionProductScaf_complexParameterSections Z r g).comp
      (a3n_chartEquiv r).toRingHom =
      Polynomial.eval₂RingHom (IntersectionProductScaf_complexScalars Z)
        (g (chartCoordinate r r.rev)) := by
  apply Polynomial.ringHom_ext
  · intro c
    simp [IntersectionProductScaf_complexParameterSections, a3n_chartEquiv,
      Algebra.TensorProduct.productMap_apply_tmul]
  · simp [IntersectionProductScaf_complexParameterSections, a3n_chartEquiv,
      polyEquivTensor_apply, a3n_awayEquiv, a3n_ev,
      Algebra.TensorProduct.productMap_apply_tmul]
#print axioms IntersectionProductScaf_complexParameterSections_equiv

#print axioms IntersectionProductScaf_complexParameterSections
/-- An integral parameter chart and the scalar structure determine the complex parameter morphism. -/
theorem IntersectionProductScaf_complexParameterSections_eq
    (p : Z ⟶ a3n_P1)
    (hp : Z.left.toSpecΓ ≫ Spec.map (CommRingCat.ofHom g) ≫ g3c_chartι 1 r =
      p.left ≫ a3n_π) :
    Z.left.toSpecΓ ≫ Spec.map (CommRingCat.ofHom
      (IntersectionProductScaf_complexParameterSections Z r g)) ≫ a3m_Pnκ 1 r = p.left := by
  rw [IntersectionProductScaf_complexParameterSections_map, hp]
  apply pullback.hom_ext
  · rw [pullback.lift_fst]
    exact p.w.symm
  · rw [pullback.lift_snd]
#print axioms IntersectionProductScaf_complexParameterSections_eq

/-- A scalar parameter value imposes its scalar equation on the global-section prime. -/
theorem IntersectionProductScaf_parameter_section_scalar
    (g0 : a3n_A 0 →+* Γ(Z.left, ⊤)) (p : Z ⟶ a3n_P1)
    (hp : Z.left.toSpecΓ ≫ Spec.map (CommRingCat.ofHom g0) ≫ g3c_chartι 1 0 =
      p.left ≫ a3n_π)
    (x : Z.left) (c : ℂ) (hx : p.left x = a3n_pt c a3n_o) :
    g0 a3m_t₁ - IntersectionProductScaf_complexScalars Z c ∈ (Z.left.toSpecΓ x).asIdeal := by
  let ψ := IntersectionProductScaf_complexParameterSections Z 0 g0
  let q := Spec.map (CommRingCat.ofHom ψ) (Z.left.toSpecΓ x)
  have hq : a3m_Pnκ 1 0 q = p.left x :=
    congrArg (fun f : Z.left ⟶ a3m_Pn 1 => f x)
      (IntersectionProductScaf_complexParameterSections_eq Z 0 g0 p hp)
  have hq' : q = Spec.map (CommRingCat.ofHom (a3n_evc c)) a3n_o := by
    apply (a3m_Pnκ 1 0).isOpenEmbedding.injective
    exact hq.trans hx
  have heq : a3n_chartEquiv 0 (Polynomial.X - Polynomial.C c) ∈ q.asIdeal := by
    rw [hq']
    change a3n_evc c (a3n_chartEquiv 0 (Polynomial.X - Polynomial.C c)) ∈ (⊥ : Ideal ℂ)
    simp [a3n_evc]
  change ((IntersectionProductScaf_complexParameterSections Z 0 g0).comp
    (a3n_chartEquiv 0).toRingHom) (Polynomial.X - Polynomial.C c) ∈
      (Z.left.toSpecΓ x).asIdeal at heq
  rw [IntersectionProductScaf_complexParameterSections_equiv] at heq
  simpa [Polynomial.coe_eval₂RingHom, a3m_t₁] using heq
#print axioms IntersectionProductScaf_parameter_section_scalar

/-- A parameter outside the finite chart makes the infinity coordinate vanish in the section prime. -/
theorem IntersectionProductScaf_parameter_section_infinity
    (g1 : a3n_A 1 →+* Γ(Z.left, ⊤)) (p : Z ⟶ a3n_P1)
    (hp : Z.left.toSpecΓ ≫ Spec.map (CommRingCat.ofHom g1) ≫ g3c_chartι 1 1 =
      p.left ≫ a3n_π)
    (x : Z.left) (hx : p.left x ∉ Set.range (a3m_Pnκ 1 0)) :
    g1 (chartCoordinate (1 : Fin 2) 0) ∈ (Z.left.toSpecΓ x).asIdeal := by
  let ψ := IntersectionProductScaf_complexParameterSections Z 1 g1
  let q := Spec.map (CommRingCat.ofHom ψ) (Z.left.toSpecΓ x)
  have hq : a3m_Pnκ 1 1 q = p.left x :=
    congrArg (fun f : Z.left ⟶ a3m_Pn 1 => f x)
      (IntersectionProductScaf_complexParameterSections_eq Z 1 g1 p hp)
  have hF : (MvPolynomial.X (0 : Fin 2) : MvPolynomial (Fin 2) ℂ) ∈
      (a3m_projCharts 1).prime (p.left x) :=
    ((a3m_projCharts 1).X_mem_prime_iff _ 0).mpr hx
  have hf := ((a3m_projCharts 1).mem_prime_iff_of_isHomogeneous _ 1 q hq
    (MvPolynomial.X 0) 1 (isHomogeneous_X ℂ 0)).mp hF
  change ψ (a3m_Pnθ 1 1 (MvPolynomial.X 0)) ∈ (Z.left.toSpecΓ x).asIdeal at hf
  simpa [ψ, IntersectionProductScaf_complexParameterSections, a3m_Pnθ,
    Algebra.TensorProduct.productMap_apply_tmul] using hf
#print axioms IntersectionProductScaf_parameter_section_infinity

end ComplexParameterSections

section ConcreteBoundarySupport
open HomogeneousLocalization
variable (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom]
  {n : ℕ} (M : Fin (n + 1) × Fin (n + 1) → ℂ)
  (j : Fin (a3s_N X + 1)) (r : Fin 2)
/-- Relative equations of an input point hold on every double chart of the extended square support. -/
theorem IntersectionProductScaf_boundaryRelativeSections_extended_support
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (y : (a3n_T (a3h_PnO n)).left) (hy : y ∈ a3h_U (a3h_PnO n))
    (F : MvPolynomial (Fin (n + 1)) (Polynomial ℂ)) (d : ℕ) (hF : F.IsHomogeneous d)
    (hyF : F ∈ (a3m_lineCharts (a3m_projCharts n) (a3m_Pn_hov n)).prime
      (a3h_pt (a3h_PnO n) y hy))
    (w : (IntersectionProductScaf_boundaryProductOver X j r).left)
    (hw : IntersectionProductScaf_boundaryProductChart X j r w ∈
      ((ccm3_inverseIdeal (IntersectionProductScaf_familyMap₁ X hfin M).left y).map
        (IntersectionProductScaf_familyInclusion (a3n_T X) M).left).support) :
    ¬ IsUnit ((IntersectionProductScaf_boundaryProductOver X j r).left.presheaf.germ
      ⊤ w (by trivial) (IntersectionProductScaf_boundaryRelativeSections X j r a M F)) := by
  let B := IntersectionProductScaf_boundaryProductOver X j r
  let U := IntersectionProductScaf_familyOpen (a3n_T X) M
  let i := (IntersectionProductScaf_familyInclusion (a3n_T X) M).left
  let b := IntersectionProductScaf_boundaryProductChart X j r
  let I := ccm3_inverseIdeal (IntersectionProductScaf_familyMap₁ X hfin M).left y
  let P : Over (Spec ↧ℂ) := Over.mk (pullback.snd i b ≫ B.hom)
  let v : P ⟶ B := Over.homMk (pullback.snd i b) rfl
  let u : P ⟶ U := Over.homMk (pullback.fst i b) (by
    change pullback.fst i b ≫ U.hom = pullback.snd i b ≫ b ≫ (a3n_T (a3n_T X)).hom
    rw [← (IntersectionProductScaf_familyInclusion (a3n_T X) M).w]
    simpa only [Category.assoc] using congrArg
      (fun f => f ≫ (a3n_T (a3n_T X)).hom) (pullback.condition (f := i) (g := b)))
  have huv : u.left ≫ i = v.left ≫ b := pullback.condition (f := i) (g := b)
  have hgen := IntersectionProductScaf_boundaryPencilSections_irrelevant X M j r P u v huv a hfin
  have hm := IntersectionProductScaf_boundaryRelativeSections_map X M j r P u v huv a hfin
  let kbig := u.left ≫ (IntersectionProductScaf_familyMap₁ X hfin M).left ≫
    (a3h_e (a3h_PnO n)).hom
  let V := a3m_U (a3m_Pn n)
  have hrange : Set.range kbig ⊆ Set.range V.ι := by
    rintro _ ⟨z, rfl⟩
    rw [Scheme.Opens.range_ι]
    change ((u.left ≫ (IntersectionProductScaf_familyMap₁ X hfin M).left ≫
      (a3h_e (a3h_PnO n)).hom) ≫
      pullback.snd (terminal.from (a3h_PnO n).left) (terminal.from (g3c_P 1))) z ∈
      Set.range (g3c_chartι 1 0)
    rw [hm, pullback.lift_snd]
    exact ⟨_, rfl⟩
  let k := IsOpenImmersion.lift V.ι kbig hrange
  have hk := (IsOpenImmersion.lift_fac V.ι kbig hrange).trans hm
  have hI : ∀ z : (pullback i b : Scheme), pullback.fst i b z ∈ I.support →
      a3h_pt (a3h_PnO n) y hy ⤳ k z := by
    intro z hz
    apply V.ι.isOpenEmbedding.isInducing.specializes_iff.mp
    have hs : y ⤳ (IntersectionProductScaf_familyMap₁ X hfin M).left (u.left z) := by
      apply specializes_iff_mem_closure.mpr
      change u.left z ∈ ((ccm3_primeIdeal (a3n_T (a3h_PnO n)).left y).comap
        (IntersectionProductScaf_familyMap₁ X hfin M).left).support at hz
      rw [Scheme.IdealSheafData.support_comap] at hz
      change (IntersectionProductScaf_familyMap₁ X hfin M).left (u.left z) ∈
        ((Scheme.IdealSheafData.vanishingIdeal
          ⟨closure ({y} : Set (a3n_T (a3h_PnO n)).left), isClosed_closure⟩).support :
          Set (a3n_T (a3h_PnO n)).left) at hz
      rw [Scheme.IdealSheafData.coe_support_vanishingIdeal] at hz
      exact hz
    have he := congrArg (fun f : P.left ⟶ a3m_T (a3m_Pn n) => f z)
      (IsOpenImmersion.lift_fac V.ι kbig hrange)
    rw [Scheme.Hom.comp_apply] at he
    change (a3h_e (a3h_PnO n)).hom y ⤳ V.ι (k z)
    rw [he]
    exact hs.map (a3h_e (a3h_PnO n)).hom.continuous
  exact IntersectionProductScaf_relativeSections_extended_support i I B b
    (IntersectionProductScaf_boundaryPencilSections X j r a M)
    (IntersectionProductScaf_boundaryOriginalSections X j r) hgen k hk
    (a3h_pt (a3h_PnO n) y hy) hI F d hF hyF w hw
#print axioms IntersectionProductScaf_boundaryRelativeSections_extended_support
end ConcreteBoundarySupport

end RelativeSupportExtension

section BoundarySpecialization
open CategoryTheory.Limits MvPolynomial HomogeneousLocalization
attribute [local instance] MvPolynomial.gradedAlgebra
attribute [local instance] Ring.toIntAlgebra AddCommGroup.toIntModule
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
variable (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom]
  (j : Fin (a3s_N X + 1))

/-- Extending the scalar coefficients commutes with a matrix operation on sections. -/
theorem IntersectionProductScaf_matrixSections_complexify
    {σ R B : Type} [Fintype σ] [CommRing R] [CommRing B]
    (β : ℂ →+* B) (A : Matrix σ σ B) (f : MvPolynomial σ R →+* B) :
    eval₂Hom β (fun k => IntersectionProductScaf_matrixSections A f (MvPolynomial.X k)) =
      IntersectionProductScaf_matrixSections A (eval₂Hom β (fun k => f (MvPolynomial.X k))) := by
  apply MvPolynomial.ringHom_ext
  · intro c
    simp [IntersectionProductScaf_matrixSections]
  · intro k
    simp [IntersectionProductScaf_matrixSections]
#print axioms IntersectionProductScaf_matrixSections_complexify

/-- The original endpoint equation holds on every double chart above that endpoint. -/
theorem IntersectionProductScaf_boundary_original_scalar
    (r : Fin 2) (c : ℂ) (x : (a3n_T X).left)
    (w : (IntersectionProductScaf_boundaryProductOver X j r).left)
    (hw : IntersectionProductScaf_boundaryProductChart X j r w = a3k_ι X c x) :
    IntersectionProductScaf_boundaryOriginalSections X j r a3m_t₁ -
      IntersectionProductScaf_complexScalars (IntersectionProductScaf_boundaryProductOver X j r) c ∈
        ((IntersectionProductScaf_boundaryProductOver X j r).left.toSpecΓ w).asIdeal := by
  let p : IntersectionProductScaf_boundaryProductOver X j r ⟶ a3n_P1 :=
    Over.homMk (IntersectionProductScaf_boundaryProductChart X j r) rfl ≫
      a3n_q (a3n_T X) ≫ Over.homMk (a3n_p X) pullback.condition.symm
  apply IntersectionProductScaf_parameter_section_scalar _ _ p
  · exact IntersectionProductScaf_boundaryOriginalSections_map X j r
  · change a3n_p X ((a3n_q (a3n_T X)).left
        (IntersectionProductScaf_boundaryProductChart X j r w)) = _
    rw [hw]
    have he := congrArg (fun f : (a3n_T X).left ⟶ a3n_P1.left => f x)
      (show a3k_ι X c ≫ (a3n_q (a3n_T X)).left ≫ a3n_p X =
        (a3n_q X).left ≫ X.hom ≫ a3n_pt c by
        rw [← Category.assoc, a3k_ι_q, Category.assoc, a3n_σ_p])
    exact he.trans (congrArg (a3n_pt c) (Subsingleton.elim _ _))
#print axioms IntersectionProductScaf_boundary_original_scalar

/-- A finite translation parameter gives its scalar equation on the double chart. -/
theorem IntersectionProductScaf_boundary_translation_scalar
    (c t : ℂ) (x : (a3n_T X).left)
    (w : (IntersectionProductScaf_boundaryProductOver X j 0).left)
    (hw : IntersectionProductScaf_boundaryProductChart X j 0 w = a3k_ι X c x)
    (ht : a3n_p X x = a3n_pt t a3n_o) :
    IntersectionProductScaf_boundaryTranslationSections X j 0 a3m_t₁ -
      IntersectionProductScaf_complexScalars (IntersectionProductScaf_boundaryProductOver X j 0) t ∈
        ((IntersectionProductScaf_boundaryProductOver X j 0).left.toSpecΓ w).asIdeal := by
  let p : IntersectionProductScaf_boundaryProductOver X j 0 ⟶ a3n_P1 :=
    Over.homMk (IntersectionProductScaf_boundaryProductChart X j 0) rfl ≫
      Over.homMk (a3n_p (a3n_T X)) pullback.condition.symm
  apply IntersectionProductScaf_parameter_section_scalar _ _ p
  · exact IntersectionProductScaf_boundaryTranslationSections_map X j 0
  · change a3n_p (a3n_T X) (IntersectionProductScaf_boundaryProductChart X j 0 w) = _
    rw [hw, ← Scheme.Hom.comp_apply, a3k_ι_p]
    exact ht
#print axioms IntersectionProductScaf_boundary_translation_scalar

/-- The infinity translation coordinate vanishes above points outside the finite chart. -/
theorem IntersectionProductScaf_boundary_translation_infinity
    (c : ℂ) (x : (a3n_T X).left)
    (w : (IntersectionProductScaf_boundaryProductOver X j 1).left)
    (hw : IntersectionProductScaf_boundaryProductChart X j 1 w = a3k_ι X c x)
    (hx : a3n_p X x ∉ Set.range (a3m_Pnκ 1 0)) :
    IntersectionProductScaf_boundaryTranslationSections X j 1 (chartCoordinate (1 : Fin 2) 0) ∈
        ((IntersectionProductScaf_boundaryProductOver X j 1).left.toSpecΓ w).asIdeal := by
  let p : IntersectionProductScaf_boundaryProductOver X j 1 ⟶ a3n_P1 :=
    Over.homMk (IntersectionProductScaf_boundaryProductChart X j 1) rfl ≫
      Over.homMk (a3n_p (a3n_T X)) pullback.condition.symm
  apply IntersectionProductScaf_parameter_section_infinity _ _ p
  · exact IntersectionProductScaf_boundaryTranslationSections_map X j 1
  · change a3n_p (a3n_T X) (IntersectionProductScaf_boundaryProductChart X j 1 w) ∉ _
    rw [hw, ← Scheme.Hom.comp_apply, a3k_ι_p]
    exact hx
#print axioms IntersectionProductScaf_boundary_translation_infinity

/-- Original endpoint specialization preserves every relative equation on the extended support. -/
theorem IntersectionProductScaf_boundary_endpoint_equation
    {n : ℕ} (M : Fin (n + 1) × Fin (n + 1) → ℂ) (r : Fin 2)
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (y : (a3n_T (a3h_PnO n)).left) (hy : y ∈ a3h_U (a3h_PnO n))
    (F : MvPolynomial (Fin (n + 1)) (Polynomial ℂ)) (d : ℕ) (hF : F.IsHomogeneous d)
    (hyF : F ∈ (a3m_lineCharts (a3m_projCharts n) (a3m_Pn_hov n)).prime
      (a3h_pt (a3h_PnO n) y hy))
    (c : ℂ) (x : (a3n_T X).left)
    (w : (IntersectionProductScaf_boundaryProductOver X j r).left)
    (hw : IntersectionProductScaf_boundaryProductChart X j r w = a3k_ι X c x)
    (hs : IntersectionProductScaf_boundaryProductChart X j r w ∈
      ((ccm3_inverseIdeal (IntersectionProductScaf_familyMap₁ X hfin M).left y).map
        (IntersectionProductScaf_familyInclusion (a3n_T X) M).left).support) :
    eval₂Hom (IntersectionProductScaf_complexScalars (IntersectionProductScaf_boundaryProductOver X j r))
      (fun k => IntersectionProductScaf_boundaryPencilSections X j r a M (MvPolynomial.X k))
      (MvPolynomial.map (Polynomial.evalRingHom c) F) ∈
        ((IntersectionProductScaf_boundaryProductOver X j r).left.toSpecΓ w).asIdeal := by
  have he := (IntersectionProductScaf_globalSection_mem_prime _ w _).mpr
    (IntersectionProductScaf_boundaryRelativeSections_extended_support X M j r a hfin y hy F d hF hyF w hs)
  exact (IntersectionProductScaf_relative_equation_specialization _ _ _ _ c
    (IntersectionProductScaf_boundary_original_scalar X j r c x w hw) F).mp he
#print axioms IntersectionProductScaf_boundary_endpoint_equation

/-- Double charts cover every point with the specified translation parameter chart. -/
theorem IntersectionProductScaf_boundaryProductChart_covers_parameter
    (r : Fin 2) (w : (a3n_T (a3n_T X)).left)
    (hw : (a3n_q (a3n_T X)).left w ∈ a3h_U X)
    (hr : a3n_h (a3n_T X) w ∈ Set.range (g3c_chartι 1 r)) :
    ∃ j, w ∈ Set.range (IntersectionProductScaf_boundaryProductChart X j r) := by
  obtain ⟨j, p, hp⟩ := a3m_U_cover (a3s_CX X)
    ((a3h_e X).hom ((a3n_q (a3n_T X)).left w))
    ((a3h_mem_U_iff X _).mp hw)
  obtain ⟨q, hq⟩ := hr
  have hf : (a3h_e (a3n_T X)).hom w ∈ Set.range
      (a3m_prodChart (a3m_Tκ (a3s_CX X) j ≫ (a3h_e X).inv) (g3c_chartι 1 r)) := by
    rw [a3m_range_prodChart]
    simp only [Set.mem_inter_iff, Set.mem_preimage]
    constructor
    · rw [a3h_e_fst_apply]
      refine ⟨p, ?_⟩
      rw [Scheme.Hom.comp_apply, hp]
      exact (Scheme.Hom.comp_apply _ _ _).symm.trans
        (congrArg (fun f : (a3n_T X).left ⟶ (a3n_T X).left =>
          f ((a3n_q (a3n_T X)).left w)) (a3h_e X).hom_inv_id)
    · rw [a3h_e_snd_apply]
      exact ⟨q, hq⟩
  obtain ⟨z, hz⟩ := hf
  refine ⟨j, z, ?_⟩
  change (a3h_e (a3n_T X)).inv
    (a3m_prodChart (a3m_Tκ (a3s_CX X) j ≫ (a3h_e X).inv) (g3c_chartι 1 r) z) = w
  rw [hz]
  exact (Scheme.Hom.comp_apply _ _ _).symm.trans
    (congrArg (fun f : (a3n_T (a3n_T X)).left ⟶ (a3n_T (a3n_T X)).left => f w)
      (a3h_e (a3n_T X)).hom_inv_id)
#print axioms IntersectionProductScaf_boundaryProductChart_covers_parameter

end BoundarySpecialization

section NormalizedBoundaryEquations
open CategoryTheory.Limits MvPolynomial HomogeneousLocalization
attribute [local instance] MvPolynomial.gradedAlgebra
attribute [local instance] Ring.toIntAlgebra AddCommGroup.toIntModule
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
variable (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom]
  (Z : Over (Spec ↧ℂ)) (j : Fin (a3s_N X + 1))
  (ξ : Z.left ⟶ Spec ((a3s_CX X).T j))
  (hξ : ξ ≫ (a3s_CX X).κ j ≫ X.hom = Z.hom)


/-- Matrices with equal residue entries impose the same polynomial equations. -/
theorem IntersectionProductScaf_matrixSections_mod_ideal
    {σ R B : Type} [Fintype σ] [DecidableEq σ] [CommRing R] [CommRing B]
    (P : Ideal B) (A D : Matrix σ σ B) (f : MvPolynomial σ R →+* B)
    (h : (Ideal.Quotient.mk P).mapMatrix A = (Ideal.Quotient.mk P).mapMatrix D)
    (F : MvPolynomial σ R) :
    IntersectionProductScaf_matrixSections A f F ∈ P ↔
      IntersectionProductScaf_matrixSections D f F ∈ P := by
  have he : (Ideal.Quotient.mk P).comp (IntersectionProductScaf_matrixSections A f) =
      (Ideal.Quotient.mk P).comp (IntersectionProductScaf_matrixSections D f) := by
    rw [IntersectionProductScaf_matrixSections_map, IntersectionProductScaf_matrixSections_map, h]
  rw [← Ideal.Quotient.eq_zero_iff_mem, ← Ideal.Quotient.eq_zero_iff_mem]
  exact Iff.of_eq (congrArg (fun z => z = 0) (RingHom.congr_fun he F))
#print axioms IntersectionProductScaf_matrixSections_mod_ideal

/-- A scalar parameter equation specializes the entries of the finite matrix pencil. -/
theorem IntersectionProductScaf_pencil_matrix_mod_scalar
    {σ B : Type} [Fintype σ] [DecidableEq σ] [CommRing B]
    (P : Ideal B) (β : ℂ →+* B) (u : B) (t : ℂ)
    (hu : u - β t ∈ P) (A : Matrix σ σ ℂ) :
    (Ideal.Quotient.mk P).mapMatrix ((1 - u) • 1 + u • β.mapMatrix A) =
      (Ideal.Quotient.mk P).mapMatrix (β.mapMatrix ((1 - t) • 1 + t • A)) := by
  have he : Ideal.Quotient.mk P u = Ideal.Quotient.mk P (β t) := Ideal.Quotient.eq.mpr hu
  ext i k
  simp only [RingHom.mapMatrix_apply, Matrix.add_apply, Matrix.smul_apply, smul_eq_mul,
    map_add, map_mul, map_sub, map_one, he]
  by_cases h : i = k <;> simp [Matrix.one_apply, h, he]
#print axioms IntersectionProductScaf_pencil_matrix_mod_scalar

/-- A vanishing reciprocal parameter specializes the regular matrix to its leading term. -/
theorem IntersectionProductScaf_pencil_matrix_mod_infinity
    {σ B : Type} [Fintype σ] [DecidableEq σ] [CommRing B]
    (P : Ideal B) (β : ℂ →+* B) (u : B) (hu : u ∈ P) (A : Matrix σ σ ℂ) :
    (Ideal.Quotient.mk P).mapMatrix ((u - 1) • 1 + β.mapMatrix A) =
      (Ideal.Quotient.mk P).mapMatrix (β.mapMatrix (A - 1)) := by
  have he : Ideal.Quotient.mk P u = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hu
  ext i k
  simp only [RingHom.mapMatrix_apply, Matrix.add_apply, Matrix.sub_apply,
    Matrix.smul_apply, smul_eq_mul, map_add, map_mul, map_sub, map_one, he]
  by_cases h : i = k <;> simp [Matrix.one_apply, h, he] <;> ring
#print axioms IntersectionProductScaf_pencil_matrix_mod_infinity

include hξ in
/-- Normalized chart constants are the scalar sections of their domain. -/
theorem IntersectionProductScaf_normalized_chart_scalar (c : ℂ) :
    ξ.appTop ((Scheme.ΓSpecIso ((a3s_CX X).T j)).inv ((a3s_CX X).θ j (C c))) =
      IntersectionProductScaf_complexScalars Z c := by
  change _ = Z.hom.appTop ((Scheme.ΓSpecIso (.of ℂ)).inv c)
  rw [← hξ, a3h_κ_hom, a3m_appTop_comp_SpecMap]
  rfl
#print axioms IntersectionProductScaf_normalized_chart_scalar

include hξ in
/-- Complex projection sections on a normalized chart are linear coordinate substitution. -/
theorem IntersectionProductScaf_normalized_projection_sections {n : ℕ}
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ) :
    eval₂Hom (IntersectionProductScaf_complexScalars Z)
      (fun k => ξ.appTop (a3h_sect X (a3r_mat a) j (MvPolynomial.X k))) =
    ξ.appTop.hom.comp ((Scheme.ΓSpecIso ((a3s_CX X).T j)).inv.hom.comp
      (((a3s_CX X).θ j).comp (a3r_lin (a3r_mat a)).toRingHom)) := by
  apply MvPolynomial.ringHom_ext
  · intro c
    simpa using (IntersectionProductScaf_normalized_chart_scalar X Z j ξ hξ c).symm
  · intro k
    simp [a3h_sect, a3h_sub_X, a3r_lin_X]
#print axioms IntersectionProductScaf_normalized_projection_sections

include hξ in
/-- Residue matrix equations in normalized sections give equations in the spatial cone prime. -/
theorem IntersectionProductScaf_normalized_matrix_equation {n : ℕ}
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (A : Matrix (Fin (n + 1)) (Fin (n + 1)) Γ(Z.left, ⊤))
    (D : Matrix (Fin (n + 1)) (Fin (n + 1)) ℂ)
    (w : Z.left)
    (hA : (Ideal.Quotient.mk (Z.left.toSpecΓ w).asIdeal).mapMatrix A =
      (Ideal.Quotient.mk (Z.left.toSpecΓ w).asIdeal).mapMatrix
        ((IntersectionProductScaf_complexScalars Z).mapMatrix D))
    (F : MvPolynomial (Fin (n + 1)) ℂ) (d : ℕ) (hF : F.IsHomogeneous d)
    (he : eval₂Hom (IntersectionProductScaf_complexScalars Z)
      (fun k => IntersectionProductScaf_matrixSections A
        (ξ.appTop.hom.comp (a3h_sect X (a3r_mat a) j)) (MvPolynomial.X k)) F ∈
          (Z.left.toSpecΓ w).asIdeal) :
    a3r_lin (a3r_mat a) (a3r_lin D F) ∈ (a3s_CX X).prime ((a3s_CX X).κ j (ξ w)) := by
  let f : MvPolynomial (Fin (n + 1)) ℂ →+* Γ(Z.left, ⊤) :=
    eval₂Hom (IntersectionProductScaf_complexScalars Z)
      (fun k => ξ.appTop (a3h_sect X (a3r_mat a) j (MvPolynomial.X k)))
  have heq := RingHom.congr_fun (IntersectionProductScaf_matrixSections_complexify
    (IntersectionProductScaf_complexScalars Z) A (ξ.appTop.hom.comp (a3h_sect X (a3r_mat a) j))) F
  have he0 : IntersectionProductScaf_matrixSections A f F ∈ (Z.left.toSpecΓ w).asIdeal :=
    (congrArg (fun b => b ∈ (Z.left.toSpecΓ w).asIdeal) heq).mp he
  have he' := (IntersectionProductScaf_matrixSections_mod_ideal _ A _ f hA F).mp he0
  have hf : f.comp C = IntersectionProductScaf_complexScalars Z := by
    ext c
    simp [f]
  rw [← hf] at he'
  erw [IntersectionProductScaf_matrixSections_constant D f] at he'
  have hn := IntersectionProductScaf_normalized_projection_sections X Z j ξ hξ a
  change f = _ at hn
  erw [hn] at he'
  apply (IntersectionProductScaf_chart_equation_germ (a3s_CX X) j ξ w _ d
    (a3h_lin_isHomogeneous (a3r_mat a) (a3h_lin_isHomogeneous D hF))).mpr
  exact (IntersectionProductScaf_globalSection_mem_prime _ w _).mp he'
#print axioms IntersectionProductScaf_normalized_matrix_equation

/-- Specialized support equations lie in the spatial cone prime after the residue matrix substitution. -/
theorem IntersectionProductScaf_boundary_spatial_equation
    {n : ℕ} (M : Fin (n + 1) × Fin (n + 1) → ℂ) (r : Fin 2)
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (y : (a3n_T (a3h_PnO n)).left) (hy : y ∈ a3h_U (a3h_PnO n))
    (F : MvPolynomial (Fin (n + 1)) (Polynomial ℂ)) (d : ℕ) (hF : F.IsHomogeneous d)
    (hyF : F ∈ (a3m_lineCharts (a3m_projCharts n) (a3m_Pn_hov n)).prime
      (a3h_pt (a3h_PnO n) y hy))
    (c : ℂ) (x : (a3n_T X).left)
    (w : (IntersectionProductScaf_boundaryProductOver X j r).left)
    (hw : IntersectionProductScaf_boundaryProductChart X j r w = a3k_ι X c x)
    (hs : IntersectionProductScaf_boundaryProductChart X j r w ∈
      ((ccm3_inverseIdeal (IntersectionProductScaf_familyMap₁ X hfin M).left y).map
        (IntersectionProductScaf_familyInclusion (a3n_T X) M).left).support)
    (D : Matrix (Fin (n + 1)) (Fin (n + 1)) ℂ)
    (hD : (Ideal.Quotient.mk
        ((IntersectionProductScaf_boundaryProductOver X j r).left.toSpecΓ w).asIdeal).mapMatrix
        (IntersectionProductScaf_boundaryPencilMatrix X j r M) =
      (Ideal.Quotient.mk
        ((IntersectionProductScaf_boundaryProductOver X j r).left.toSpecΓ w).asIdeal).mapMatrix
        ((IntersectionProductScaf_complexScalars
          (IntersectionProductScaf_boundaryProductOver X j r)).mapMatrix D)) :
    a3r_lin (a3r_mat a) (a3r_lin D (MvPolynomial.map (Polynomial.evalRingHom c) F)) ∈
      (a3s_CX X).prime ((a3n_q X).left x) := by
  have hξ : IntersectionProductScaf_boundarySpatialChart X j r ≫ (a3s_CX X).κ j ≫ X.hom =
      (IntersectionProductScaf_boundaryProductOver X j r).hom := by
    rw [← Category.assoc, IntersectionProductScaf_boundarySpatialChart_projection]
    rfl
  have he := IntersectionProductScaf_normalized_matrix_equation X
    (IntersectionProductScaf_boundaryProductOver X j r) j
    (IntersectionProductScaf_boundarySpatialChart X j r) hξ a _ D w hD
    _ d (hF.map (Polynomial.evalRingHom c))
    (IntersectionProductScaf_boundary_endpoint_equation X j M r a hfin y hy F d hF hyF c x w hw hs)
  have hp : (a3s_CX X).κ j (IntersectionProductScaf_boundarySpatialChart X j r w) =
      (a3n_q X).left x := by
    have hp := congrArg (fun f => f w) (IntersectionProductScaf_boundarySpatialChart_projection X j r)
    simp only [Scheme.Hom.comp_apply] at hp
    erw [hw] at hp
    rw [← Scheme.Hom.comp_apply (a3k_ι X c), a3k_ι_q, Scheme.Hom.comp_apply,
      a3n_q_σ_apply] at hp
    exact hp
  rwa [hp] at he
#print axioms IntersectionProductScaf_boundary_spatial_equation

end NormalizedBoundaryEquations

section EndpointConeTransport
open CategoryTheory.Limits MvPolynomial HomogeneousLocalization TopologicalSpace
attribute [local instance] MvPolynomial.gradedAlgebra
