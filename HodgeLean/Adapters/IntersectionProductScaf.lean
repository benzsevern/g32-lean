/-- The endpoint-one fibre meets both original endpoint sections in expected codimension. -/
theorem IntersectionProductScaf_components_one_endpoints
    (beta : AlgebraicCycle X.left ℚ) (S : Finset (a3n_T X).left)
    (hn : Order.height (genericPoint X.left) = n) :
    a3r_Generic {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ |
      ∀ hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
          (a3r_lin (a3r_mat a)).toRingHom).Finite,
        a3r_Generic {M : Fin (n + 1) × Fin (n + 1) → ℂ |
          ∀ y ∈ S, a3n_h X y = genericPoint (g3c_P 1) → ∀ y',
            (IntersectionProductScaf_translationFibreCycle M a hfin y 1) y' ≠ 0 →
            a3n_h X y' = genericPoint (g3c_P 1) → ∀ v, beta v ≠ 0 →
              ∀ c : ℂ, (c = 0 ∨ c = 1) → ∀ z ∈ a3y_comps y' (a3n_σ X c v),
                coheight y' + coheight (a3n_σ X c v) ≤ coheight z + (0 : ℕ)}} := by
  refine a3r_generic_univ.mono fun a _ hfin => ?_
  refine (IntersectionProductScaf_generic_det.inter
    (IntersectionProductScaf_generic_endpoint_component_bound X hfin beta S hn)).mono ?_
  rintro M ⟨hM, hG⟩ y hy hdom y' hy' _ v hv c hc z hz
  simp only [Set.mem_setOf_eq] at hM
  have hdet : IsUnit (a3r_mat M).det := by convert hM using 1 <;> congr 1
  have hunit : IsUnit ((IntersectionProductScaf_lineDet M).eval 1) := by
    rw [IntersectionProductScaf_lineDet_one]
    convert hdet using 1 <;> congr 1
  obtain ⟨hyz, hvz, -⟩ := a3y_comps_spec _ _ hz
  obtain ⟨x, rfl⟩ := a3n_mem_range_σ_of_specializes X c hvz
  have hi := (IntersectionProductScaf_translationFibreCycle_support X a hfin M 1 hunit hn y y').mp hy'
  have hs := hyz.map (IntersectionProductScaf_squareFibreMap X hfin M 1 hunit).left.continuous
  have he := congrArg (fun f : X.left ⟶ (a3n_T (a3h_PnO n)).left => f x)
    (IntersectionProductScaf_squareFibreMap_section X hfin M 1 c hunit)
  change (IntersectionProductScaf_squareFibreMap X hfin M 1 hunit).left (a3n_σ X c x) =
    a3n_σ (a3h_PnO n) c ((IntersectionProductScaf_lineFibreMap X hfin M 1 hunit).left x) at he
  rw [hi, he] at hs
  obtain ⟨D, hD, hDx⟩ := IntersectionProductScaf_proper_image_section_component
    (a3h_πO X hfin) y c _ hs
  have hvx : v ⤳ x := by
    simpa only [a3n_q_σ_apply] using hvz.map (a3n_q X).left.continuous
  have hb := hG hdet y hy c hc D hD v hv x hDx hvx
  rw [IntersectionProductScaf_section_component_base_coheight X y hdom c hc D hD] at hb
  rw [IntersectionProductScaf_translationFibreCycle_coheight X a hfin M 1 hunit hn y y' hy',
    a3n_coheight_σ, a3n_coheight_σ, Nat.cast_zero, add_zero, ← add_assoc]
  exact add_le_add hb le_rfl
#print axioms IntersectionProductScaf_components_one_endpoints


/-- T3: translation commutes with the boundary in the original parameter. -/
theorem IntersectionProductScaf_transCycle_t_face
    (S : Finset (a3n_T X).left) (hn : height (genericPoint X.left) = n) :
    a3r_Generic {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ |
      ∀ hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
          (a3r_lin (a3r_mat a)).toRingHom).Finite,
        a3r_Generic {M : Fin (n + 1) × Fin (n + 1) → ℂ |
          ∀ y ∈ S, a3k_dt X ((IntersectionProductScaf_data M a hfin).Θ₁
              (a1p_pushforward (a3h_G (a3h_πO X hfin)).left
                (Function.locallyFinsuppWithin.single y 1))) =
            (IntersectionProductScaf_data M a hfin).Θ₀
              (a3k_bd (a3h_PnO n) (a1p_pushforward (a3h_G (a3h_πO X hfin)).left
                (Function.locallyFinsuppWithin.single y 1)))}} := by
  have h0 := IntersectionProductScaf_t_face_zero_fibre (X := X) (n := n) S hn
  have h1 := IntersectionProductScaf_t_face_one_fibre (X := X) (n := n) S hn
  have hb := IntersectionProductScaf_t_face_input_fibres (X := X) (n := n) S hn
  refine ((h0.inter h1).inter hb).mono ?_
  rintro a ⟨⟨ha0, ha1⟩, hab⟩ hfin
  have hM := (((ha0 hfin).inter (ha1 hfin)).inter (hab hfin))
  refine IntersectionProductScaf_t_face_finset a hfin S ?_
  intro y hy hdom
  refine hM.mono ?_
  rintro M ⟨⟨h0, h1⟩, hb⟩
  change a3k_dt X _ = _
  rw [a3k_dt, a1p_pushforward_add, a3k_pushforward_smul, a3k_pushforward_smul,
    h0 y hy hdom, h1 y hy hdom]
  exact hb y hy hdom

/-- T4: the one-parameter family is in good position. -/
theorem IntersectionProductScaf_transCycle_good (beta : AlgebraicCycle X.left ℚ)
    (S : Finset (a3n_T X).left) (hn : height (genericPoint X.left) = n) :
    a3r_Generic {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ |
      ∀ hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
          (a3r_lin (a3r_mat a)).toRingHom).Finite,
        a3r_Generic {M : Fin (n + 1) × Fin (n + 1) → ℂ |
          ∀ D : X.left, (∃ y ∈ S, a3k_piece X y D ≠ 0) →
            (∀ v, beta v ≠ 0 → a3i_MeetProperly X.left D v) →
            ∀ y', (IntersectionProductScaf_data M a hfin).Θ₀
                (a1p_pushforward (a3h_πO X hfin).left
                  (Function.locallyFinsuppWithin.single D 1)) y' ≠ 0 →
              ∀ hy' : a3n_h X y' = genericPoint (g3c_P 1), a3o_Good X beta y' hy'}} := by
  have h0 := IntersectionProductScaf_good_cylinder_bound (X := X) (n := n) beta S hn
  have h1 := IntersectionProductScaf_good_zero_bound (X := X) (n := n) beta S hn
  have h2 := IntersectionProductScaf_good_one_bound (X := X) (n := n) beta S hn
  apply IntersectionProductScaf_transCycle_good_of_excess
  refine ((h0.inter h1).inter h2).mono ?_
  rintro a ⟨⟨ha0, ha1⟩, ha2⟩ hfin
  refine (((ha0 hfin).inter (ha1 hfin)).inter (ha2 hfin)).mono ?_
  rintro M ⟨⟨h0, h1⟩, h2⟩ D hD hp y' hy' hd v hv
  exact ⟨h0 D hD hp y' hy' hd v hv, h1 D hD hp y' hy' hd v hv,
    h2 D hD hp y' hy' hd v hv⟩

/-- T5: every member of the two-parameter cycle is in square position. -/
theorem IntersectionProductScaf_transCycle_face (S : Finset (a3n_T X).left)
    (hn : Order.height (genericPoint X.left) = n)
    (hS : ∀ y ∈ S, a3n_h X y = genericPoint (g3c_P 1)) :
    a3r_Generic {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ |
      ∀ hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
          (a3r_lin (a3r_mat a)).toRingHom).Finite,
        a3r_Generic {M : Fin (n + 1) × Fin (n + 1) → ℂ |
          ∀ y ∈ S, ∀ w, (IntersectionProductScaf_data M a hfin).Θ₁
              (a1p_pushforward (a3h_G (a3h_πO X hfin)).left
                (Function.locallyFinsuppWithin.single y 1)) w ≠ 0 →
            a3k_SquarePos X w}} := by
  have hg := IntersectionProductScaf_face_generalizing (X := X) (n := n) S hn
  have hd := IntersectionProductScaf_face_dom_s (X := X) (n := n) S hn
  have hs := IntersectionProductScaf_face_s_dom_t (X := X) (n := n) S hn
  have ht := IntersectionProductScaf_face_t_corners (X := X) (n := n) S hn
  refine (((hg.inter hd).inter hs).inter ht).mono ?_
  rintro a ⟨⟨⟨hag, had⟩, has⟩, hat⟩ hfin
  apply IntersectionProductScaf_transCycle_face_of_conditions a hfin S hS
  refine ((((hag hfin).inter (had hfin)).inter (has hfin)).inter (hat hfin)).mono ?_
  rintro M ⟨⟨⟨hg, hd⟩, hs⟩, ht⟩
  refine ⟨hg, ?_⟩
  intro y hy w hw
  exact ⟨hd y hy (hS y hy) w hw, hs y hy (hS y hy) w hw _,
    ht y hy (hS y hy) w hw⟩

/-- Finite collections of transcendental whole constant fibres satisfy the component excess bound without zero-fibre cancellation. -/
theorem IntersectionProductScaf_components_constant_sections
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom]
    {n : ℕ} (beta : AlgebraicCycle X.left ℚ) (k : ℕ)
    (S : Finset (a3n_T X).left) (hn : Order.height (genericPoint X.left) = n)
    (hS : ∀ y ∈ S, ∃ c : ℂ, Transcendental ℤ c ∧
      y = a3n_σ X c (genericPoint X.left)) :
    a3r_Generic {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ |
      ∀ hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
          (a3r_lin (a3r_mat a)).toRingHom).Finite,
        a3r_Generic {M : Fin (n + 1) × Fin (n + 1) → ℂ |
          ∀ y ∈ S, ∀ y', ((Function.locallyFinsuppWithin.single y 1 :
              AlgebraicCycle (a3n_T X).left ℚ) -
            a3k_bd (a3n_T X) ((IntersectionProductScaf_data M a hfin).Θ₁
              (a1p_pushforward (a3h_G (a3h_πO X hfin)).left
                (Function.locallyFinsuppWithin.single y 1)))) y' ≠ 0 →
            a3n_h X y' = genericPoint (g3c_P 1) → ¬ a3h_Residual X a y y' →
              a3k_ExcessLE X beta y' k}} := by
  have hb := IntersectionProductScaf_components_boundary_fibres (X := X) (n := n) S hn
  have hc := IntersectionProductScaf_components_one_cylinder (X := X) (n := n) beta S hn
  have he := IntersectionProductScaf_components_one_endpoints (X := X) (n := n) beta S hn
  refine ((hb.inter hc).inter he).mono ?_
  rintro a ⟨⟨hab, hac⟩, hae⟩ hfin
  refine (((hab hfin).inter (hac hfin)).inter (hae hfin)).mono ?_
  rintro M ⟨⟨hb, hc⟩, he⟩ y hy y' hdiff hdom' hres
  obtain ⟨c, hct, hyc⟩ := hS y hy
  have hdom : a3n_h X y = genericPoint (g3c_P 1) := by
    rw [hyc]
    exact IntersectionProductScaf_transcendental_section_dom X c hct _
  by_cases hsame : y' = y
  · rw [hsame, hyc]
    exact a3k_excessLE_mono X (Nat.zero_le k)
      (IntersectionProductScaf_constant_section_excess X beta c hct)
  have hzero := IntersectionProductScaf_zero_fibre_difference_off_input X a hfin hn M
    y y' hdom hdom' hsame hres
  have hnonzero : IntersectionProductScaf_translationFibreCycle M a hfin y 1 y' ≠ 0 := by
    intro hz
    apply hdiff
    rw [hb y hy hdom]
    simp only [Function.locallyFinsuppWithin.coe_sub, Pi.sub_apply] at hzero ⊢
    rw [hz, sub_zero, hzero]
  apply a3k_excessLE_mono X (Nat.zero_le k)
  intro v hv
  exact ⟨hc y hy hdom y' hnonzero hdom' v hv,
    he y hy hdom y' hnonzero hdom' v hv 0 (Or.inl rfl),
    he y hy hdom y' hnonzero hdom' v hv 1 (Or.inr rfl)⟩
#print axioms IntersectionProductScaf_components_constant_sections

/-- T6: the non-residual components have the required excess bound. -/
theorem IntersectionProductScaf_transCycle_components (beta : AlgebraicCycle X.left ℚ)
    (k : ℕ) (S : Finset (a3n_T X).left)
    (hn : Order.height (genericPoint X.left) = n) :
    a3r_Generic {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ |
      ∀ hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
          (a3r_lin (a3r_mat a)).toRingHom).Finite,
        a3r_Generic {M : Fin (n + 1) × Fin (n + 1) → ℂ |
          ∀ y ∈ S, ∀ y', ((Function.locallyFinsuppWithin.single y 1 :
              AlgebraicCycle (a3n_T X).left ℚ) -
            a3k_bd (a3n_T X) ((IntersectionProductScaf_data M a hfin).Θ₁
              (a1p_pushforward (a3h_G (a3h_πO X hfin)).left
                (Function.locallyFinsuppWithin.single y 1)))) y' ≠ 0 →
            a3n_h X y' = genericPoint (g3c_P 1) → ¬ a3h_Residual X a y y' →
              a3k_ExcessLE X beta y' k}} := by
  have hb := IntersectionProductScaf_components_boundary_fibres (X := X) (n := n) S hn
  have hr := IntersectionProductScaf_components_zero_residual (X := X) (n := n) beta S hn
  have hc := IntersectionProductScaf_components_one_cylinder (X := X) (n := n) beta S hn
  have he := IntersectionProductScaf_components_one_endpoints (X := X) (n := n) beta S hn
  refine (((hb.inter hr).inter hc).inter he).mono ?_
  rintro a ⟨⟨⟨hab, har⟩, hac⟩, hae⟩ hfin
  apply IntersectionProductScaf_transCycle_components_of_dom beta k S a hfin
  refine ((((hab hfin).inter (har hfin)).inter (hac hfin)).inter (hae hfin)).mono ?_
  rintro M ⟨⟨⟨hb, hr⟩, hc⟩, he⟩ y hy hdom y' hdiff hdom' hres
  rcases hr y hy hdom y' hdom' hres with hexcess | hzero
  · exact a3k_excessLE_mono X (Nat.zero_le k) hexcess
  have hnonzero : IntersectionProductScaf_translationFibreCycle M a hfin y 1 y' ≠ 0 := by
    intro hz
    apply hdiff
    rw [hb y hy hdom]
    simp only [Function.locallyFinsuppWithin.coe_sub, Pi.sub_apply] at hzero ⊢
    rw [hz, sub_zero, hzero]
  apply a3k_excessLE_mono X (Nat.zero_le k)
  intro v hv
  exact ⟨hc y hy hdom y' hnonzero hdom' v hv,
    he y hy hdom y' hnonzero hdom' v hv 0 (Or.inl rfl),
    he y hy hdom y' hnonzero hdom' v hv 1 (Or.inr rfl)⟩


/-- Translation operators up to cone residuals for a general projection
(`a3h_GeneralTranslationR`): for the members `S` of `X × ℙ¹` dominating `ℙ¹` of excess at most
`k + 1` against `β` and a generic finite linear projection `π : X → ℙⁿ` (`a3h_π`), the chains
`Θ₁ c` on `X × ℙ¹_t × ℙ¹_s` and `Θ₀ c` on `X × ℙ¹_s` of `a3h_BlochTranslationR`: the pull-backs
along `π × id × id` of the families of translates `h_s⁻¹ c` over `ℙ¹_s`, compatible with the faces
`t = a`, with members in square position, with the members of `[Y] - ∂_s Θ₁ ((π × id)_*[Y])`
other than the cone residuals of `Y` of excess at most `k` (the general translate, by Kleiman's
transversality over the line, `a3h_generic_translate_rel`, `a3h_generic_line`), and
`Θ₀ (π_*[D])` in good position for the faces `D` meeting `β` properly. The cone residuals are
bounded by Roberts' main lemma over the line (`a3h_generalTranslation_of_residual`).
Source: S. Bloch, *The moving lemma for higher Chow groups*, J. Algebraic Geom. 3 (1994),
537–568, §2; Kleiman, *The transversality of a general translate*, Compositio Math. 28
(1974), 287–297, Theorem 2. -/
theorem a3h_generalTranslationR_aux (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom]
    [IsProjective X.hom] : a3h_GeneralTranslationR X := by
  intro beta k S hS n hn
  have hlin := IntersectionProductScaf_transCycle_add (X := X) (n := n)
  have htface := IntersectionProductScaf_transCycle_t_face (X := X) (n := n) S hn
  have hgood := IntersectionProductScaf_transCycle_good (X := X) (n := n) beta S hn
  have hface := IntersectionProductScaf_transCycle_face (X := X) (n := n) S hn (fun y hy => (hS y hy).1)
  have hcomp := IntersectionProductScaf_transCycle_components (X := X) (n := n) beta k S hn
  refine ((((hlin.inter htface).inter hgood).inter hface).inter hcomp).mono ?_
  rintro a ⟨⟨⟨⟨ha, hz⟩, ho⟩, hf⟩, hc⟩ hfin
  obtain ⟨M, ⟨⟨⟨⟨hlinM, hfaceM⟩, hgoodM⟩, hsquareM⟩, hexcessM⟩⟩ :=
    (((((ha hfin).inter (hz hfin)).inter (ho hfin)).inter (hf hfin)).inter (hc hfin)).nonempty
  let T := IntersectionProductScaf_data M a hfin
  exact ⟨{
    Θ₁ := T.Θ₁
    Θ₀ := T.Θ₀
    Θ₀_add := hlinM.1
    Θ₀_smul := hlinM.2
    face := hfaceM
    square := hsquareM
    excess := hexcessM
    good := hgoodM }⟩

end HodgeLean.Adapters
