/-- Every endpoint section on a dominating prime input has a regular principal equation. -/
theorem IntersectionProductScaf_primeInput_regular_equation
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom]
    (c : ℂ) (hc : c = 0 ∨ c = 1) (w : (a3n_T X).left)
    (hdom : a3n_h X w = genericPoint (g3c_P 1)) :
    let I := ccm3_primeIdeal (a3n_T X).left w
    let J := (a3n_σ X c).ker.comap I.subschemeι
    ∀ x : J.subscheme, ∃ r : I.subscheme.presheaf.stalk (J.subschemeι x),
      IsSMulRegular (I.subscheme.presheaf.stalk (J.subschemeι x)) r ∧
      RingHom.ker (J.subschemeι.stalkMap x).hom = Ideal.span {r} := by
  intro I J x
  have : IsClosedImmersion (a3n_σ X c ≫ (a3n_q X).left) := by
    rw [a3n_σ_q]
    infer_instance
  have : IsClosedImmersion (a3n_σ X c) := IsClosedImmersion.of_comp _ (a3n_q X).left
  let z := I.subschemeι (J.subschemeι x)
  have hz : z ∈ ((a3n_σ X c).ker.support : Set (a3n_T X).left) := by
    have hx := x.property
    change J.subschemeι x ∈ (J.support : Set I.subscheme) at hx
    rw [Scheme.IdealSheafData.support_comap] at hx
    exact hx
  rw [Scheme.Hom.support_ker, (a3n_σ X c).isClosedEmbedding.isClosed_range.closure_eq] at hz
  obtain ⟨v, hv⟩ := hz
  have hE : a3n_σ X c (genericPoint X.left) ⤳ z :=
    hv ▸ (genericPoint_specializes v).map (a3n_σ X c).continuous
  have hex := IntersectionProductScaf_section_prime_stalk_equation X c hc w hdom
    (J.subschemeι x) hE
  change ∃ r : (a3n_T X).left.presheaf.stalk z,
    a3i_stalkIdeal (a3n_T X).left z (a3n_σ X c (genericPoint X.left)) = Ideal.span {r} ∧
    IsSMulRegular (I.subscheme.presheaf.stalk (J.subschemeι x))
      (I.subschemeι.stalkMap (J.subschemeι x) r) at hex
  obtain ⟨r, he, hr⟩ := hex
  refine ⟨I.subschemeι.stalkMap (J.subschemeι x) r, hr, ?_⟩
  obtain ⟨_, ⟨U, hU, rfl⟩, hzU, -⟩ := (a3n_T X).left.isBasis_affineOpens.exists_subset_of_mem_open
    (Set.mem_univ z) isOpen_univ
  have hloc : ((a3n_σ X c).ker.ideal ⟨U, hU⟩).map
      ((a3n_T X).left.presheaf.germ U z hzU).hom = Ideal.span {r} := by
    have hk := congrArg (fun K : (a3n_T X).left.IdealSheafData => K.ideal ⟨U, hU⟩)
      (a2g_ker_eq_primeIdeal (a3n_σ X c))
    rw [hk]
    exact (a3l_map_primeIdeal_eq_stalkIdeal hE ⟨U, hU⟩ hzU).trans he
  rw [IntersectionProductScaf_closed_comap_stalk_kernel I.subschemeι (a3n_σ X c).ker x
    ⟨U, hU⟩ hzU, hloc, Ideal.map_span, Set.image_singleton]
#print axioms IntersectionProductScaf_primeInput_regular_equation

