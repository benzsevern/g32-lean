/-- The image of an inverse-image component specializes the input generic point. -/
theorem IntersectionProductScaf_inverseIdeal_image {U Z : Scheme}
    (f : U ⟶ Z) (z : Z) (u : (ccm3_inverseIdeal f z).subscheme) :
    f ((ccm3_inverseIdeal f z).subschemeι u) ∈ closure ({z} : Set Z) := by
  have hu : (ccm3_inverseIdeal f z).subschemeι u ∈
      (ccm3_inverseIdeal f z).support := by
    change (ccm3_inverseIdeal f z).subschemeι u ∈
      ((ccm3_inverseIdeal f z).support : Set U)
    rw [← Scheme.IdealSheafData.range_subschemeι]
    exact ⟨u, rfl⟩
  change (ccm3_inverseIdeal f z).subschemeι u ∈
    ((ccm3_primeIdeal Z z).comap f).support at hu
  rw [Scheme.IdealSheafData.support_comap] at hu
  change f ((ccm3_inverseIdeal f z).subschemeι u) ∈
    ((Scheme.IdealSheafData.vanishingIdeal
      ⟨closure ({z} : Set Z), isClosed_closure⟩).support : Set Z) at hu
  rw [Scheme.IdealSheafData.coe_support_vanishingIdeal] at hu
  exact hu

/-- Extending an inverse-image ideal preserves specialization of any retained parameter. -/
theorem IntersectionProductScaf_extended_inverseIdeal_parameter_specializes
    {U V Z B : Scheme} (i : U ⟶ V) [QuasiCompact i] (f : U ⟶ Z)
    (r : V ⟶ B) (s : Z ⟶ B) (hcomm : i ≫ r = f ≫ s)
    (z : Z) (x : V) (hx : x ∈ ((ccm3_inverseIdeal f z).map i).support) :
    s z ⤳ r x := by
  rw [Scheme.IdealSheafData.support_map] at hx
  change x ∈ closure (i '' (ccm3_inverseIdeal f z).support) at hx
  apply specializes_iff_mem_closure.mpr
  apply (closure_minimal (t := r ⁻¹' closure ({s z} : Set B)) ?_
    (isClosed_closure.preimage r.continuous)) hx
  rintro _ ⟨u, hu, rfl⟩
  have hz := specializes_iff_mem_closure.mpr
    (IntersectionProductScaf_inverseIdeal_image f z ⟨u, hu⟩)
  have he := congrArg (fun g : U ⟶ B => g u) hcomm
  change r (i u) = s (f u) at he
  change r (i u) ∈ closure ({s z} : Set B)
  rw [he]
  exact specializes_iff_mem_closure.mp (hz.map s.continuous)
#print axioms IntersectionProductScaf_extended_inverseIdeal_parameter_specializes

/-- A generalizing map sends a component of an inverse image to the input generic point. -/
theorem IntersectionProductScaf_inverseIdeal_component_image {U Z : Scheme}
    (f : U ⟶ Z) (hf : GeneralizingMap f) (z : Z)
    (u : (ccm3_inverseIdeal f z).subscheme)
    (hu : closure ({u} : Set (ccm3_inverseIdeal f z).subscheme) ∈
      irreducibleComponents (ccm3_inverseIdeal f z).subscheme) :
    f ((ccm3_inverseIdeal f z).subschemeι u) = z := by
  let I := ccm3_inverseIdeal f z
  obtain ⟨v, hv, hfv⟩ := hf
    (specializes_iff_mem_closure.mpr (IntersectionProductScaf_inverseIdeal_image f z u))
  have hvI : v ∈ I.support := by
    change v ∈ ((ccm3_primeIdeal Z z).comap f).support
    rw [Scheme.IdealSheafData.support_comap]
    change f v ∈ ((Scheme.IdealSheafData.vanishingIdeal
      ⟨closure ({z} : Set Z), isClosed_closure⟩).support : Set Z)
    rw [Scheme.IdealSheafData.coe_support_vanishingIdeal, hfv]
    exact subset_closure (Set.mem_singleton z)
  obtain ⟨v', hv'⟩ := Set.mem_range.mp (I.range_subschemeι.symm.subset hvI)
  have hvu : Specializes v' u := by
    apply I.subschemeι.isClosedEmbedding.isInducing.specializes_iff.mp
    simpa only [hv'] using hv
  have hsub : closure ({u} : Set I.subscheme) ⊆ closure ({v'} : Set I.subscheme) :=
    closure_minimal (Set.singleton_subset_iff.mpr
      (specializes_iff_mem_closure.mp hvu)) isClosed_closure
  have hrev := hu.2 isIrreducible_singleton.closure hsub
  have huv : Specializes u v' := specializes_iff_mem_closure.mpr
    (hrev (subset_closure (Set.mem_singleton v')))
  have heq : v' = u := (hvu.antisymm huv).eq
  simpa only [I, ← hv', heq] using hfv

/-- Under a flat map, a prime pullback has support in the fibre over the input point. -/
theorem IntersectionProductScaf_flatPullbackPrime_image
    {U Z : Over (Spec ↧ℂ)}
    [LocallyOfFiniteType U.hom] [QuasiCompact U.hom]
    [LocallyOfFiniteType Z.hom] [QuasiCompact Z.hom]
    (f : U ⟶ Z) [Flat f.left] (z : Z.left) (u : U.left)
    (hu : ccm3_flatPullbackPrime f.left z u ≠ 0) : f.left u = z := by
  obtain ⟨v, hv, hc⟩ := (ccm3_flatPullbackPrime_support f z u).mp hu
  rw [← hv]
  exact IntersectionProductScaf_inverseIdeal_component_image f.left
    (Flat.generalizingMap f.left) z v hc

/-- Members of a flat open prime family have representatives mapping to the input point. -/
theorem IntersectionProductScaf_openFamilyCycle_single_image
    {U Z W : Over (Spec ↧ℂ)}
    [LocallyOfFiniteType U.hom] [QuasiCompact U.hom]
    [LocallyOfFiniteType Z.hom] [QuasiCompact Z.hom]
    (j : U ⟶ W) [IsOpenImmersion j.left] [QuasiCompact j.left]
    (f : U ⟶ Z) [Flat f.left] (z : Z.left) (w : W.left)
    (hw : IntersectionProductScaf_openFamilyCycle j f
      (Function.locallyFinsuppWithin.single z 1) w ≠ 0) :
    ∃ u : U.left, j.left u = w ∧ f.left u = z := by
  rw [IntersectionProductScaf_openFamilyCycle,
    IntersectionProductScaf_flatPullback_single, IntersectionProductScaf_open_support] at hw
  obtain ⟨u, hu, hc⟩ := hw
  exact ⟨u, hu, IntersectionProductScaf_flatPullbackPrime_image f z u hc⟩

