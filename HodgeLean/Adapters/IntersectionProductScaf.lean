  have hsingle := (mul_ne_zero_iff.mp hw).2
  rw [IntersectionProductScaf_theta₁_single_height X hfin M hn _ w hsingle] at hd
  exact WithTop.add_right_cancel (show (1 : ℕ∞) ≠ ⊤ from ENat.one_ne_top) hd
