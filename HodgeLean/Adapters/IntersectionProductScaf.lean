/-- An affine image preserves regular equations of a locally principal ambient subscheme. -/
theorem IntersectionProductScaf_image_regular_equation
    {U V : Scheme} [IsLocallyNoetherian V] (j : U ⟶ V) [IsAffineHom j]
    (I : U.IdealSheafData) (K : V.IdealSheafData)
    (hprincipal : ∀ z : K.subscheme, ∃ r : V.presheaf.stalk (K.subschemeι z),
      RingHom.ker (K.subschemeι.stalkMap z).hom = Ideal.span {r})
    (hreg : let J := (K.comap j).comap I.subschemeι
      ∀ z : J.subscheme, ∃ s : I.subscheme.presheaf.stalk (J.subschemeι z),
        IsSMulRegular (I.subscheme.presheaf.stalk (J.subschemeι z)) s ∧
        RingHom.ker (J.subschemeι.stalkMap z).hom = Ideal.span {s})
    (x : (K.comap (I.map j).subschemeι).subscheme) :
    ∃ s : (I.map j).subscheme.presheaf.stalk ((K.comap (I.map j).subschemeι).subschemeι x),
      IsSMulRegular ((I.map j).subscheme.presheaf.stalk
        ((K.comap (I.map j).subschemeι).subschemeι x)) s ∧
      RingHom.ker ((K.comap (I.map j).subschemeι).subschemeι.stalkMap x).hom = Ideal.span {s} := by
  let y := (I.map j).subschemeι ((K.comap (I.map j).subschemeι).subschemeι x)
  have hy : y ∈ (K.support : Set V) := by
    have hx := x.property
    change (K.comap (I.map j).subschemeι).subschemeι x ∈
      ((K.comap (I.map j).subschemeι).support : Set (I.map j).subscheme) at hx
    rw [Scheme.IdealSheafData.support_comap] at hx
    exact hx
  let z : K.subscheme := ⟨y, hy⟩
  have hh := hprincipal z
  change ∃ r : V.presheaf.stalk y,
    RingHom.ker (K.subschemeι.stalkMap z).hom = Ideal.span {r} at hh
  obtain ⟨r, hr⟩ := hh
  obtain ⟨_, ⟨W, hW, rfl⟩, hyW, -⟩ := V.isBasis_affineOpens.exists_subset_of_mem_open
    (Set.mem_univ y) isOpen_univ
  have he := a3l_ker_stalkMap_subschemeι K z ⟨W, hW⟩ hyW
  rw [hr] at he
  change Ideal.span {r} = (K.ideal ⟨W, hW⟩).map (V.presheaf.germ W y hyW).hom at he
  obtain ⟨W', hyW', -, a, ha⟩ := IntersectionProductScaf_principal_affine_neighborhood
    V K ⟨W, hW⟩ y hyW r he.symm
  exact IntersectionProductScaf_image_regular_equation_on_chart j I K W'
    (W'.2.preimage j) a ha hreg x hyW'
#print axioms IntersectionProductScaf_image_regular_equation


