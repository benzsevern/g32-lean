/-- A regular section expands in the scheme-theoretic fibres of the ambient family components. -/
theorem IntersectionProductScaf_regular_section_fibre_cycle
    {F Z : Scheme.{0}} [IsNoetherian F] [IsNoetherian Z]
    (j : F ⟶ Z) [IsClosedImmersion j] (I : Z.IdealSheafData)
    (hreg : ∀ x ∈ genericPoints (j.ker.comap I.subschemeι).subscheme,
      ∃ r : I.subscheme.presheaf.stalk ((j.ker.comap I.subschemeι).subschemeι x),
        IsSMulRegular (I.subscheme.presheaf.stalk ((j.ker.comap I.subschemeι).subschemeι x)) r ∧
        RingHom.ker ((j.ker.comap I.subschemeι).subschemeι.stalkMap x).hom = Ideal.span {r})
    (hcomponent : ∀ z ∈ genericPoints I.subscheme,
      ∀ u ∈ genericPoints ((ccm3_primeIdeal I.subscheme z).comap
        (j.ker.comap I.subschemeι).subschemeι).subscheme,
      ((ccm3_primeIdeal I.subscheme z).comap
        (j.ker.comap I.subschemeι).subschemeι).subschemeι u ∈
          genericPoints (j.ker.comap I.subschemeι).subscheme) :
    a2g_fundCycle (I.comap j).subschemeι =
      ∑ w ∈ (a3m_support_finite (a2g_fundCycle I.subschemeι)).toFinset,
        a3m_smul (a2g_fundCycle I.subschemeι w)
          (a2g_fundCycle ((ccm3_primeIdeal Z w).comap j).subschemeι) := by
  have : IsLocallyNoetherian I.subscheme := LocallyOfFiniteType.isLocallyNoetherian I.subschemeι
  have := a2g_subscheme_noetherianSpace I
  have : IsNoetherian I.subscheme := ⟨⟩
  have hY : (genericPoints I.subscheme).Finite :=
    genericPoints.finite TopologicalSpace.NoetherianSpace.finite_irreducibleComponents
  have he := IntersectionProductScaf_regular_section_ambient_cycle I.subschemeι j.ker
    hreg hcomponent hY
  rw [IntersectionProductScaf_fundCycle_component_sum I.subschemeι
    I.subschemeι.isEmbedding.injective hY
    (fun w => a2g_fundCycle (ccm3_primeIdeal Z w ⊔ j.ker).subschemeι)] at he
  have he' : a2g_fundCycle (I ⊔ j.ker).subschemeι =
      ∑ w ∈ (a3m_support_finite (a2g_fundCycle I.subschemeι)).toFinset,
        a3m_smul (a2g_fundCycle I.subschemeι w)
          (a2g_fundCycle (ccm3_primeIdeal Z w ⊔ j.ker).subschemeι) := by
    conv_lhs => rw [← I.ker_subschemeι, a2g_ker_sup_eq_map_comap, a2g_fundCycle_map]
    exact he
  ext x
  have hx := congrArg (fun c : AlgebraicCycle Z ℚ => c (j x)) he'
  rw [IntersectionProductScaf_section_intersection_apply, a3m_sum_apply] at hx
  rw [a3m_sum_apply]
  refine hx.trans (Finset.sum_congr rfl ?_)
  intro w hw
  rw [a3m_smul_apply, a3m_smul_apply, IntersectionProductScaf_section_intersection_apply]
#print axioms IntersectionProductScaf_regular_section_fibre_cycle

/-- A prime section fibre can be computed after embedding its ambient subscheme. -/
theorem IntersectionProductScaf_prime_section_ambient
    {Y Z : Scheme.{0}} (i : Y ⟶ Z) [IsClosedImmersion i]
    (K : Z.IdealSheafData) (z : Y) :
    a2g_fundCycle ((((ccm3_primeIdeal Y z).comap (K.comap i).subschemeι).subschemeι) ≫
