/-- The quotient by the two stalk primes has the intrinsic length of their intersection subscheme. -/
theorem IntersectionProductScaf_primeIntersection_quotient_length
    (Y : Scheme) [IsLocallyNoetherian Y] (u v : Y)
    (y : (ccm3_primeIdeal Y u ⊔ ccm3_primeIdeal Y v).subscheme) :
    Module.length (Y.presheaf.stalk ((ccm3_primeIdeal Y u ⊔ ccm3_primeIdeal Y v).subschemeι y))
      (Y.presheaf.stalk ((ccm3_primeIdeal Y u ⊔ ccm3_primeIdeal Y v).subschemeι y) ⧸
        (a3i_stalkIdeal Y ((ccm3_primeIdeal Y u ⊔ ccm3_primeIdeal Y v).subschemeι y) u ⊔
          a3i_stalkIdeal Y ((ccm3_primeIdeal Y u ⊔ ccm3_primeIdeal Y v).subschemeι y) v)) =
      ccm11_intersectionLength Y (ccm3_primeIdeal Y u) (ccm3_primeIdeal Y v) y := by
  obtain ⟨hu, hv⟩ := a3l_specializes_of_subscheme u v y
  obtain ⟨_, ⟨U, hU, rfl⟩, hzU, -⟩ := Y.isBasis_affineOpens.exists_subset_of_mem_open
    (Set.mem_univ ((ccm3_primeIdeal Y u ⊔ ccm3_primeIdeal Y v).subschemeι y)) isOpen_univ
  have hker := a3l_ker_stalkMap_subschemeι _ y ⟨U, hU⟩ hzU
  rw [Scheme.IdealSheafData.ideal_sup, Pi.sup_apply, Ideal.map_sup,
    a3l_map_primeIdeal_eq_stalkIdeal hu, a3l_map_primeIdeal_eq_stalkIdeal hv] at hker
  exact a3l_length_quot_ker _
    ((ccm3_primeIdeal Y u ⊔ ccm3_primeIdeal Y v).subschemeι.stalkMap_surjective y) _ hker
#print axioms IntersectionProductScaf_primeIntersection_quotient_length

/-- At a common specialization, the original endpoint multiplicity is a local quotient length. -/
theorem IntersectionProductScaf_originalDivisor_serreMult_at
    (c : ℂ) (hc : c = 0 ∨ c = 1) (w z : (a3n_T (a3n_T X)).left)
    (hw : w ⤳ z) (hE : a3k_E X c ⤳ z)
    (hdom : a3n_h X ((a3n_q (a3n_T X)).left w) = genericPoint (g3c_P 1)) :
    a3i_serreMult (a3n_T (a3n_T X)).left z w (a3k_E X c) =
      ((Module.length ((a3n_T (a3n_T X)).left.presheaf.stalk z)
        (((a3n_T (a3n_T X)).left.presheaf.stalk z) ⧸
          (a3i_stalkIdeal (a3n_T (a3n_T X)).left z w ⊔
            a3i_stalkIdeal (a3n_T (a3n_T X)).left z (a3k_E X c)))).toNat : ℤ) := by
  rw [IntersectionProductScaf_originalDivisor_generic] at hE
  obtain ⟨x, rfl⟩ := a3k_ι_cl X c _ z hE
  exact IntersectionProductScaf_originalDivisor_serreMult X c hc x w hw hdom
#print axioms IntersectionProductScaf_originalDivisor_serreMult_at

/-- The local intersection multiplicity along an original face equals the intrinsic fibre length. -/
theorem IntersectionProductScaf_originalDivisor_intersectionLength
    (c : ℂ) (hc : c = 0 ∨ c = 1) (w : (a3n_T (a3n_T X)).left)
    (hdom : a3n_h X ((a3n_q (a3n_T X)).left w) = genericPoint (g3c_P 1))
    (y : (ccm3_primeIdeal (a3n_T (a3n_T X)).left w ⊔
      ccm3_primeIdeal (a3n_T (a3n_T X)).left (a3k_E X c)).subscheme) :
    a3i_serreMult (a3n_T (a3n_T X)).left
      ((ccm3_primeIdeal (a3n_T (a3n_T X)).left w ⊔
        ccm3_primeIdeal (a3n_T (a3n_T X)).left (a3k_E X c)).subschemeι y) w (a3k_E X c) =
      ((ccm11_intersectionLength (a3n_T (a3n_T X)).left
        (ccm3_primeIdeal (a3n_T (a3n_T X)).left w)
        (ccm3_primeIdeal (a3n_T (a3n_T X)).left (a3k_E X c)) y).toNat : ℤ) := by
  have : IsLocallyNoetherian (a3n_T (a3n_T X)).left :=
    LocallyOfFiniteType.isLocallyNoetherian (a3n_T (a3n_T X)).hom
  obtain ⟨hw, hE⟩ := a3l_specializes_of_subscheme w (a3k_E X c) y
  rw [IntersectionProductScaf_originalDivisor_serreMult_at X c hc w _ hw hE hdom,
    IntersectionProductScaf_primeIntersection_quotient_length]
#print axioms IntersectionProductScaf_originalDivisor_intersectionLength

/-- The original-face intersection of a dominating prime cycle is the fundamental intersection cycle. -/
theorem IntersectionProductScaf_originalDivisor_prime_fundCycle
    (c : ℂ) (hc : c = 0 ∨ c = 1) (w : (a3n_T (a3n_T X)).left)
    (hdom : a3n_h X ((a3n_q (a3n_T X)).left w) = genericPoint (g3c_P 1)) :
    a3i_intersectPrime (a3n_T (a3n_T X)).left w (a3k_E X c) =
      a2g_fundCycle ((ccm3_primeIdeal (a3n_T (a3n_T X)).left w ⊔
        ccm3_primeIdeal (a3n_T (a3n_T X)).left (a3k_E X c)).subschemeι) := by
  unfold a3i_intersectPrime a2g_fundCycle
  apply finsum_congr
  intro y
  split_ifs
  · rw [IntersectionProductScaf_originalDivisor_intersectionLength X c hc w hdom y]
    congr 1
  · rfl
#print axioms IntersectionProductScaf_originalDivisor_prime_fundCycle

/-- Projecting an original-face intersection of a dominating prime gives its scheme-theoretic fibre cycle. -/
theorem IntersectionProductScaf_originalDivisor_prime_fibre
    (c : ℂ) (hc : c = 0 ∨ c = 1) (w : (a3n_T (a3n_T X)).left)
    (hdom : a3n_h X ((a3n_q (a3n_T X)).left w) = genericPoint (g3c_P 1)) :
    a1p_pushforward (a3k_ρ X)
      (a3i_intersectPrime (a3n_T (a3n_T X)).left w (a3k_E X c)) =
      a2g_fundCycle (((ccm3_primeIdeal (a3n_T (a3n_T X)).left w).comap
        (a3k_ι X c)).subschemeι) := by
  letI := IntersectionProductScaf_originalSection_isClosedImmersion X c
  rw [IntersectionProductScaf_originalDivisor_prime_fundCycle X c hc w hdom,
    IntersectionProductScaf_originalDivisor_generic, ← a2g_ker_eq_primeIdeal,
    sup_comm, a2g_ker_sup_eq_map_comap, a2g_fundCycle_map]
  have : IsLocallyNoetherian (a3n_T X).left := LocallyOfFiniteType.isLocallyNoetherian (a3n_T X).hom
  have : IsNoetherian (a3n_T X).left := ⟨⟩
  have : IsLocallyNoetherian (a3n_T X).left := LocallyOfFiniteType.isLocallyNoetherian (a3n_T X).hom
  have : IsNoetherian (a3n_T X).left := ⟨⟩
  have := a2g_subscheme_noetherianSpace
    ((ccm3_primeIdeal (a3n_T (a3n_T X)).left w).comap (a3k_ι X c))
  rw [a2g_pushforward_fundCycle]
  · rw [Category.assoc, a3k_ι_ρ, Category.comp_id]
  · intro y hy
    simp only [Scheme.Hom.comp_apply]
    exact a3k_degree_r_i _ _ (a3k_ι_ρ X c) _
#print axioms IntersectionProductScaf_originalDivisor_prime_fibre

/-- A prime fibre coefficient equals the original-divisor intersection coefficient at its section image. -/
theorem IntersectionProductScaf_originalDivisor_prime_fibre_apply
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom]
    (c : ℂ) (hc : c = 0 ∨ c = 1) (w : (a3n_T (a3n_T X)).left)
    (hdom : a3n_h X ((a3n_q (a3n_T X)).left w) = genericPoint (g3c_P 1))
    (x : (a3n_T X).left) :
    a3i_intersectPrime (a3n_T (a3n_T X)).left w (a3k_E X c) (a3k_ι X c x) =
      a2g_fundCycle (((ccm3_primeIdeal (a3n_T (a3n_T X)).left w).comap
        (a3k_ι X c)).subschemeι) x := by
  let := IntersectionProductScaf_originalSection_isClosedImmersion X c
  rw [IntersectionProductScaf_originalDivisor_prime_fundCycle X c hc w hdom,
    IntersectionProductScaf_originalDivisor_generic, ← a2g_ker_eq_primeIdeal,
    sup_comm, a2g_ker_sup_eq_map_comap, a2g_fundCycle_map]
  have : IsLocallyNoetherian (a3n_T X).left := LocallyOfFiniteType.isLocallyNoetherian (a3n_T X).hom
  have : IsNoetherian (a3n_T X).left := ⟨⟩
  have := a2g_subscheme_noetherianSpace
    ((ccm3_primeIdeal (a3n_T (a3n_T X)).left w).comap (a3k_ι X c))
  exact IntersectionProductScaf_fundCycle_comp_injective_apply _ _
    (a3k_ι X c).isEmbedding.injective
    (genericPoints.finite TopologicalSpace.NoetherianSpace.finite_irreducibleComponents) x
#print axioms IntersectionProductScaf_originalDivisor_prime_fibre_apply


/-- Original-face intersection is linear in the scheme-theoretic fibres of dominating prime members. -/
theorem IntersectionProductScaf_originalDivisor_cycle_fibres
    (c : ℂ) (hc : c = 0 ∨ c = 1)
    (W : AlgebraicCycle (a3n_T (a3n_T X)).left ℚ)
    (S : Finset (a3n_T (a3n_T X)).left) (hS : ∀ w ∉ S, W w = 0)
    (hdom : ∀ w, W w ≠ 0 →
      a3n_h X ((a3n_q (a3n_T X)).left w) = genericPoint (g3c_P 1)) :
    a1p_pushforward (a3k_ρ X)
      (a3i_intersect (a3n_T (a3n_T X)).left W
        (Function.locallyFinsuppWithin.single (a3k_E X c) 1)) =
      ∑ w ∈ S, a3m_smul (W w)
        (a2g_fundCycle (((ccm3_primeIdeal (a3n_T (a3n_T X)).left w).comap
          (a3k_ι X c)).subschemeι)) := by
  classical
  rw [a3k_intersect_single_eq_sum _ W _ S hS, a3k_pushforward_sum]
  apply Finset.sum_congr rfl
  intro w hw
  rw [a3k_pushforward_smul]
  by_cases hzero : W w = 0
  · ext z
    simp only [a3m_smul_apply, hzero, zero_mul]
  · rw [IntersectionProductScaf_originalDivisor_prime_fibre X c hc w (hdom w hzero)]
#print axioms IntersectionProductScaf_originalDivisor_cycle_fibres


/-- The pushed prime square family is the fundamental cycle of its extended ideal, with degree. -/
theorem IntersectionProductScaf_squareFamily_fundCycle
    {n : ℕ} (M : Fin (n + 1) × Fin (n + 1) → ℂ)
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (y : (a3n_T X).left) :
    (IntersectionProductScaf_data M a hfin).Θ₁
      (a1p_pushforward (a3h_G (a3h_πO X hfin)).left
        (Function.locallyFinsuppWithin.single y 1)) =
      a3m_smul (a1p_degree (a3h_G (a3h_πO X hfin)).left y : ℚ)
        (a2g_fundCycle (IntersectionProductScaf_squarePrimeIdeal M a hfin y).subschemeι) := by
  rw [IntersectionProductScaf_theta₁_push_single]
  congr 1
  exact IntersectionProductScaf_openFamilyCycle_eq_fundCycle
    (IntersectionProductScaf_familyInclusion (a3n_T X) M)
    (IntersectionProductScaf_familyMap₁ X hfin M)
    ((a3h_G (a3h_πO X hfin)).left y)
#print axioms IntersectionProductScaf_squareFamily_fundCycle

/-- Original faces of the actual square family are the weighted prime-component fibre sums. -/
theorem IntersectionProductScaf_squareFamily_original_fibres
    {n : ℕ} (hn : height (genericPoint X.left) = n)
    (M : Fin (n + 1) × Fin (n + 1) → ℂ)
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (y : (a3n_T X).left) (hy : a3n_h X y = genericPoint (g3c_P 1))
    (c : ℂ) (hc : c = 0 ∨ c = 1) :
    let W := (IntersectionProductScaf_data M a hfin).Θ₁
      (a1p_pushforward (a3h_G (a3h_πO X hfin)).left
        (Function.locallyFinsuppWithin.single y 1))
    a1p_pushforward (a3k_ρ X)
      (a3i_intersect (a3n_T (a3n_T X)).left W
        (Function.locallyFinsuppWithin.single (a3k_E X c) 1)) =
      ∑ w ∈ (a3m_support_finite W).toFinset, a3m_smul (W w)
        (a2g_fundCycle (((ccm3_primeIdeal (a3n_T (a3n_T X)).left w).comap
          (a3k_ι X c)).subschemeι)) := by
  intro W
  apply IntersectionProductScaf_originalDivisor_cycle_fibres X c hc W
  · intro w hw
    simpa using hw
  · intro w hw
    exact IntersectionProductScaf_theta₁_dom_t_of_generalizing X hfin M
      (IntersectionProductScaf_familyMap₁_generalizing X hfin M hn) y hy w hw
#print axioms IntersectionProductScaf_squareFamily_original_fibres

/-- Each parameter section has a regular principal equation in the ambient stalk. -/
theorem IntersectionProductScaf_sectionDivisor_equation (c : ℂ) (x : X.left) :
    ∃ r : (a3n_T X).left.presheaf.stalk (a3n_σ X c x),
      r ∈ IsLocalRing.maximalIdeal _ ∧
      IsSMulRegular ((a3n_T X).left.presheaf.stalk (a3n_σ X c x)) r ∧
      a3i_stalkIdeal (a3n_T X).left (a3n_σ X c x)
        (a3n_σ X c (genericPoint X.left)) = Ideal.span {r} := by
  obtain ⟨r, hm, hr, he⟩ := a3n_ker_g X c x
  refine ⟨r, hm, hr, ?_⟩
  rw [a3n_stalkIdeal_σ X c x _ (genericPoint_specializes x),
    a3c_stalkIdeal_genericPoint]
  exact he
#print axioms IntersectionProductScaf_sectionDivisor_equation

/-- A generator of a parameter-section ideal has order one at its generic point. -/
theorem IntersectionProductScaf_section_generator_order
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom]
    (c : ℂ)
    (r : (a3n_T X).left.presheaf.stalk (a3n_σ X c (genericPoint X.left)))
    (hr : r ≠ 0)
    (he : a3i_stalkIdeal (a3n_T X).left (a3n_σ X c (genericPoint X.left))
      (a3n_σ X c (genericPoint X.left)) = Ideal.span {r}) :
    (a3n_T X).left.ord
      (algebraMap ((a3n_T X).left.presheaf.stalk (a3n_σ X c (genericPoint X.left)))
        (a3n_T X).left.functionField r) (a3n_σ X c (genericPoint X.left)) = 1 := by
  have : IsLocallyNoetherian (a3n_T X).left :=
    LocallyOfFiniteType.isLocallyNoetherian (a3n_T X).hom
  let R := (a3n_T X).left.presheaf.stalk (a3n_σ X c (genericPoint X.left))
  have : IsSimpleModule R (R ⧸ IsLocalRing.maximalIdeal R) :=
    isSimpleModule_iff_quot_maximal.mpr
      ⟨IsLocalRing.maximalIdeal R, inferInstance, ⟨LinearEquiv.refl R _⟩⟩
  rw [a3y_ord_algebraMap _ (a3k_coheight_σ_generic X c) r hr,
    Ring.ord, ← he, a3c_stalkIdeal_self, Module.length_eq_one]
  rfl
#print axioms IntersectionProductScaf_section_generator_order

section ParameterCoordinateRatio
open MvPolynomial HomogeneousLocalization
open AlgebraicGeometry.ComplexProjectiveSpace
attribute [local instance] MvPolynomial.gradedAlgebra
/-- On the overlap of the two affine opens, the chosen rational function has the coordinate ratio. -/
theorem IntersectionProductScaf_parameter_ratio_mul
    (x : g3c_P 1)
    (h0 : x ∈ Proj.basicOpen (UniversalGrading.{0} 1) (MvPolynomial.X 0))
    (hg : x ∈ Proj.basicOpen (UniversalGrading.{0} 1) (MvPolynomial.X 1 - MvPolynomial.X 0)) :
    ((g3c_P 1).presheaf.germ _ x hg a3m_T0) *
      (((g3c_P 1).presheaf.germ _ x h0 a3k_S1) - 1) =
      (g3c_P 1).presheaf.germ _ x h0 a3k_S1 := by
  have hs : ((g3c_P 1).presheaf.germ _ x h0 a3k_S1) - 1 =
      (g3c_P 1).presheaf.germ _ x h0 (a3k_Sg a3m_g_mem) := by
    rw [a3k_Sg_sub, map_sub, map_one]
  rw [hs]
  apply (Proj.stalkIso' (UniversalGrading.{0} 1) x).injective
  rw [map_mul, a3m_germ_T0, a3k_germ_Sg, a3k_S1, a3k_germ_Sg]
  apply HomogeneousLocalization.val_injective
  rw [HomogeneousLocalization.val_mul]
  simp only [a3m_tz, Away.isLocalizationElem, Away.mk]
  erw [HomogeneousLocalization.map_mk, HomogeneousLocalization.map_mk,
    HomogeneousLocalization.map_mk, HomogeneousLocalization.val_mk,
    HomogeneousLocalization.val_mk, HomogeneousLocalization.val_mk]
  rw [Localization.mk_mul, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
  refine ⟨1, ?_⟩
  simp only [OneMemClass.coe_one, one_mul, Submonoid.coe_mul, pow_one]
  ring
#print axioms IntersectionProductScaf_parameter_ratio_mul
/-- The parameter in the function field is the affine coordinate divided by its shift by one. -/
theorem IntersectionProductScaf_parameter_rational_expression :
    a3m_t1 =
      ((g3c_P 1).presheaf.germ _ (genericPoint (g3c_P 1))
        a3k_generic_mem_basicOpen a3k_S1) /
      (((g3c_P 1).presheaf.germ _ (genericPoint (g3c_P 1))
        a3k_generic_mem_basicOpen a3k_S1) - 1) := by
  have hu := (a3k_isUnit_germ_Sg a3m_g_mem _ a3k_generic_mem_basicOpen).mpr
    a3m_genericPoint_mem
  rw [a3k_Sg_sub, map_sub, map_one] at hu
  apply (eq_div_iff hu.ne_zero).mpr
  exact IntersectionProductScaf_parameter_ratio_mul _ a3k_generic_mem_basicOpen
    a3m_genericPoint_mem
#print axioms IntersectionProductScaf_parameter_rational_expression
/-- Evaluation at a parameter value has the expected principal ideal in the affine chart. -/
theorem IntersectionProductScaf_parameter_evaluation_kernel (c : ℂ) :
    RingHom.ker (a3n_evc c) = Ideal.span
      {a3n_chartEquiv 0 (Polynomial.X - Polynomial.C c)} := by
  change (RingHom.ker (Polynomial.evalRingHom c)).comap
    (a3n_chartEquiv 0).symm.toRingEquiv.toRingHom = _
  rw [Polynomial.ker_evalRingHom]
  calc
    _ = (Ideal.span {Polynomial.X - Polynomial.C c}).map
        (a3n_chartEquiv 0).toRingEquiv.toRingHom :=
      (Ideal.map_comap_of_equiv (a3n_chartEquiv 0).toRingEquiv).symm
    _ = _ := by rw [Ideal.map_span, Set.image_singleton]; rfl
#print axioms IntersectionProductScaf_parameter_evaluation_kernel
/-- Pullback of the parameter is computed from the affine coordinate germ at any chart point. -/
theorem IntersectionProductScaf_parameter_pullback_expression
    {Y : Scheme.{0}} [IsIntegral Y] (h : Y ⟶ g3c_P 1)
    (hgen : h (genericPoint Y) = genericPoint (g3c_P 1))
    (x : Y) (hx : h x ∈ Proj.basicOpen (UniversalGrading.{0} 1) (MvPolynomial.X 0)) :
    a3m_pullbackFF h hgen a3m_t1 =
      algebraMap (Y.presheaf.stalk x) Y.functionField
        (h.stalkMap x ((g3c_P 1).presheaf.germ _ (h x) hx a3k_S1)) /
      (algebraMap (Y.presheaf.stalk x) Y.functionField
        (h.stalkMap x ((g3c_P 1).presheaf.germ _ (h x) hx a3k_S1)) - 1) := by
  let ψ : (g3c_P 1).functionField →+* Y.functionField :=
    ((g3c_P 1).presheaf.stalkSpecializes (a3m_specializes_genericPoint h hgen) ≫
      h.stalkMap (genericPoint Y)).hom
  have he : ψ ((g3c_P 1).presheaf.germ _ (genericPoint (g3c_P 1))
      a3k_generic_mem_basicOpen a3k_S1) =
      algebraMap (Y.presheaf.stalk x) Y.functionField
        (h.stalkMap x ((g3c_P 1).presheaf.germ _ (h x) hx a3k_S1)) := by
    apply a3m_pullbackFF_eq h hgen _ x _
    exact TopCat.Presheaf.germ_stalkSpecializes_apply (g3c_P 1).presheaf hx
      (genericPoint_specializes (h x)) a3k_S1
  change ψ a3m_t1 = _
  rw [IntersectionProductScaf_parameter_rational_expression, map_div₀, map_sub, map_one, he]
#print axioms IntersectionProductScaf_parameter_pullback_expression
/-- The point-section ideal restricts to the kernel of affine-chart evaluation. -/
theorem IntersectionProductScaf_parameter_point_chart_kernel (c : ℂ) :
    (a3n_pt c).ker.comap (a3m_Pnκ 1 0) =
      (Spec.map (CommRingCat.ofHom (a3n_evc c))).ker := by
  have : IsClosedImmersion (a3n_pt c ≫ a3n_P1.hom) := by
    change IsClosedImmersion (a3n_pt c ≫ ProjectiveSpace.toBase (Fin 2) (Spec ↧ℂ))
    rw [a3n_pt_toBase]
    infer_instance
  have : IsClosedImmersion (a3n_pt c) := IsClosedImmersion.of_comp _ a3n_P1.hom
  have H : IsPullback (Spec.map (CommRingCat.ofHom (a3n_evc c)))
      (𝟙 (Spec ↧ℂ)) (a3m_Pnκ 1 0) (a3n_pt c) :=
    IsPullback.of_vert_isIso_mono ⟨by simp [a3n_pt]⟩
  rw [← Scheme.IdealSheafData.ker_fst_of_isClosedImmersion,
    ← H.isoPullback_hom_fst, Scheme.Hom.ker_comp_of_isIso]
#print axioms IntersectionProductScaf_parameter_point_chart_kernel
/-- The ideal of a spectrum-map kernel is the ring kernel transported to global sections. -/
theorem IntersectionProductScaf_spec_kernel_ideal
    {R S : CommRingCat.{0}} (f : R ⟶ S) :
    (Spec.map f).ker.ideal ⟨⊤, isAffineOpen_top _⟩ =
      (RingHom.ker f.hom).map (Scheme.ΓSpecIso R).inv.hom := by
  rw [Scheme.Hom.ker_apply]
  change RingHom.ker (Spec.map f).appTop.hom = _
  rw [← RingHom.ker_equiv_comp _ (Scheme.ΓSpecIso S).commRingCatIsoToRingEquiv]
  change RingHom.ker (((Spec.map f).appTop ≫ (Scheme.ΓSpecIso S).hom).hom) = _
  rw [Scheme.ΓSpecIso_naturality]
  change (RingHom.ker f.hom).comap (Scheme.ΓSpecIso R).hom.hom = _
  have he := Ideal.map_comap_of_equiv (I := RingHom.ker f.hom)
    (Scheme.ΓSpecIso R).commRingCatIsoToRingEquiv.symm
  exact he.symm
#print axioms IntersectionProductScaf_spec_kernel_ideal
/-- The projective point ideal is generated by the shifted coordinate on its affine chart. -/
theorem IntersectionProductScaf_parameter_point_chart_ideal (c : ℂ) :
    ((a3n_pt c).ker.comap (a3m_Pnκ 1 0)).ideal ⟨⊤, isAffineOpen_top _⟩ =
      Ideal.span {((Scheme.ΓSpecIso (a3m_PnT 1 0)).inv
        (a3n_chartEquiv 0 (Polynomial.X - Polynomial.C c)))} := by
  rw [IntersectionProductScaf_parameter_point_chart_kernel,
    IntersectionProductScaf_spec_kernel_ideal]
  change (RingHom.ker (a3n_evc c)).map (Scheme.ΓSpecIso (a3m_PnT 1 0)).inv.hom = _
  rw [IntersectionProductScaf_parameter_evaluation_kernel, Ideal.map_span, Set.image_singleton]
#print axioms IntersectionProductScaf_parameter_point_chart_ideal
/-- On the projective affine open, the point ideal has the shifted-coordinate equation. -/
theorem IntersectionProductScaf_parameter_point_open_ideal (c : ℂ) :
    (a3n_pt c).ker.ideal
      ⟨(a3m_Pnκ 1 0) ''ᵁ ⊤, (isAffineOpen_top _).image_of_isOpenImmersion _⟩ =
      Ideal.span {(((a3m_Pnκ 1 0).appIso ⊤).inv
        ((Scheme.ΓSpecIso (a3m_PnT 1 0)).inv
          (a3n_chartEquiv 0 (Polynomial.X - Polynomial.C c))))} := by
  have : IsClosedImmersion (a3n_pt c ≫ a3n_P1.hom) := by
    change IsClosedImmersion (a3n_pt c ≫ ProjectiveSpace.toBase (Fin 2) (Spec ↧ℂ))
    rw [a3n_pt_toBase]
    infer_instance
  have : IsClosedImmersion (a3n_pt c) := IsClosedImmersion.of_comp _ a3n_P1.hom
  have H : IsPullback (Spec.map (CommRingCat.ofHom (a3n_evc c)))
      (𝟙 (Spec ↧ℂ)) (a3m_Pnκ 1 0) (a3n_pt c) :=
    IsPullback.of_vert_isIso_mono ⟨by simp [a3n_pt]⟩
  have he := Scheme.ker_ideal_of_isPullback_of_isOpenImmersion
    (a3n_pt c) (Spec.map (CommRingCat.ofHom (a3n_evc c)))
    (𝟙 (Spec ↧ℂ)) (a3m_Pnκ 1 0) H ⟨⊤, isAffineOpen_top _⟩
  rw [← IntersectionProductScaf_parameter_point_chart_kernel,
    IntersectionProductScaf_parameter_point_chart_ideal] at he
  dsimp only [Subtype.coe_mk] at he
  have hm := congrArg (Ideal.map
    ((a3m_Pnκ 1 0).appIso ⊤).inv.hom) he
  rw [Ideal.map_comap_of_surjective _ (ConcreteCategory.bijective_of_isIso _).2,
    Ideal.map_span, Set.image_singleton] at hm
  exact hm.symm
#print axioms IntersectionProductScaf_parameter_point_open_ideal
/-- Taking an affine ideal to a stalk commutes with pullback of the ideal sheaf. -/
theorem IntersectionProductScaf_comap_ideal_germ
    {Y Z : Scheme} (f : Y ⟶ Z) (K : Z.IdealSheafData)
    (U : Z.affineOpens) (V : Y.affineOpens) (h : V.1 ≤ f ⁻¹ᵁ U.1)
    (x : Y) (hx : x ∈ V.1) :
    ((K.comap f).ideal V).map (Y.presheaf.germ V.1 x hx).hom =
      ((K.ideal U).map (Z.presheaf.germ U.1 (f x) (h hx)).hom).map
        (f.stalkMap x).hom := by
  rw [IntersectionProductScaf_comap_ideal_affine_charts f K U V h,
    Ideal.map_map, Ideal.map_map]
  have hg : f.appLE U.1 V.1 h ≫ Y.presheaf.germ V.1 x hx =
      Z.presheaf.germ U.1 (f x) (h hx) ≫ f.stalkMap x := by
    rw [Scheme.Hom.appLE, Category.assoc, TopCat.Presheaf.germ_res]
    exact (f.germ_stalkMap U.1 x (h hx)).symm
  exact congrArg (Ideal.map · (K.ideal U)) (congrArg CommRingCat.Hom.hom hg)
#print axioms IntersectionProductScaf_comap_ideal_germ
/-- The shifted affine coordinate generates the parameter-section prime in every ambient stalk. -/
theorem IntersectionProductScaf_section_chart_equation
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom]
    (c : ℂ) (x : X.left) :
    let U : (a3m_Pn 1).affineOpens :=
      ⟨(a3m_Pnκ 1 0) ''ᵁ ⊤, (isAffineOpen_top _).image_of_isOpenImmersion _⟩
    let s := ((a3m_Pnκ 1 0).appIso ⊤).inv
      ((Scheme.ΓSpecIso (a3m_PnT 1 0)).inv
        (a3n_chartEquiv 0 (Polynomial.X - Polynomial.C c)))
    ∀ hx : a3n_p X (a3n_σ X c x) ∈ U.1,
      a3i_stalkIdeal (a3n_T X).left (a3n_σ X c x)
        (a3n_σ X c (genericPoint X.left)) =
      Ideal.span {((a3n_p X).stalkMap (a3n_σ X c x)
        ((a3m_Pn 1).presheaf.germ U.1 _ hx s))} := by
