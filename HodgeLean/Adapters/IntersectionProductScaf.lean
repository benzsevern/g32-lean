/-- An invertible endpoint substitution retains the strict specialization dimension bound. -/
theorem IntersectionProductScaf_endpoint_invertible_dimension {n : ℕ}
    (J : Ideal (Polynomial (MvPolynomial (Fin (n + 1)) ℂ))) [J.IsPrime]
    (c : ℂ) (hc : Polynomial.X - Polynomial.C (MvPolynomial.C c) ∉ J)
    (A : Matrix (Fin (n + 1)) (Fin (n + 1)) ℂ) (hA : IsUnit A.det)
    (Q : Ideal (MvPolynomial (Fin (n + 1)) ℂ))
    (hJ : J.map (Polynomial.evalRingHom (MvPolynomial.C c)) ≤ Q.comap (a3r_lin A).toRingHom) :
    ringKrullDim (MvPolynomial (Fin (n + 1)) ℂ ⧸ Q) + 1 ≤
      ringKrullDim (Polynomial (MvPolynomial (Fin (n + 1)) ℂ) ⧸ J) := by
  have hd := IntersectionProductScaf_parameter_specialization_dimension J (MvPolynomial.C c) hc
    (Q.comap (a3r_lin A).toRingHom) (Ideal.map_le_iff_le_comap.mp hJ)
  exact (add_le_add
    (IntersectionProductScaf_invertible_substitution_quotient_dimension A hA
      (Q.comap (a3r_lin A).toRingHom) Q le_rfl) le_rfl).trans hd
#print axioms IntersectionProductScaf_endpoint_invertible_dimension
/-- At infinity, general translation pencils retain the strict endpoint dimension bound. -/
theorem IntersectionProductScaf_generic_endpoint_leading_dimension {n : ℕ}
    (J : Ideal (Polynomial (MvPolynomial (Fin (n + 1)) ℂ))) [J.IsPrime]
    (c : ℂ) (hc : Polynomial.X - Polynomial.C (MvPolynomial.C c) ∉ J) :
    a3r_Generic {M : Fin (n + 1) × Fin (n + 1) → ℂ |
      ∀ Q : Ideal (MvPolynomial (Fin (n + 1)) ℂ),
        J.map (Polynomial.evalRingHom (MvPolynomial.C c)) ≤ Q.comap
          (a3r_lin (Matrix.of (fun i j => M (i, j)) - 1)).toRingHom →
        ringKrullDim (MvPolynomial (Fin (n + 1)) ℂ ⧸ Q) + 1 ≤
          ringKrullDim (Polynomial (MvPolynomial (Fin (n + 1)) ℂ) ⧸ J)} := by
  refine IntersectionProductScaf_generic_pencil_leading_matrix.mono ?_
  intro M hM Q hQ
  exact IntersectionProductScaf_endpoint_invertible_dimension J c hc _ hM Q hQ
#print axioms IntersectionProductScaf_generic_endpoint_leading_dimension
/-- Leading pencil equations force a strict height bound on actual spatial scheme points. -/
theorem IntersectionProductScaf_generic_endpoint_leading_height
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom]
    {n : ℕ} (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (y : (a3n_T X).left) (hy : y ∈ a3h_U X)
    (hdom : a3n_h X y = genericPoint (g3c_P 1))
    (c : ℂ) (hc : c = 0 ∨ c = 1) :
    a3r_Generic {M : Fin (n + 1) × Fin (n + 1) → ℂ |
      ∀ x : X.left,
        let J := (((a3h_P X y hy).comap (a3r_lin (a3h_block a))).comap
          (a3h_eqT (Fin (n + 1))).symm.toRingHom)
        let A := Matrix.of (fun i j => M (i, j)) -
          (1 : Matrix (Fin (n + 1)) (Fin (n + 1)) ℂ)
        J.map (Polynomial.evalRingHom (MvPolynomial.C c)) ≤
          (((a3s_CX X).prime x).comap (a3r_lin (a3r_mat a))).comap
            (a3r_lin A).toRingHom → height x < height y} := by
  let J := (((a3h_P X y hy).comap (a3r_lin (a3h_block a))).comap
    (a3h_eqT (Fin (n + 1))).symm.toRingHom)
  have : J.IsPrime := Ideal.IsPrime.comap _
  have hdJ := IntersectionProductScaf_projected_affineCone_dimension X a hfin y hy
  obtain ⟨_, my, hmy, _⟩ := a1d_height_eq_trdeg (X := a3n_T X) y
  refine (IntersectionProductScaf_generic_endpoint_leading_dimension J c
    (IntersectionProductScaf_projected_affineCone_endpoint_not_mem X a y hy hdom c hc)).mono ?_
  intro M hM x J' A heq
  let Q := ((a3s_CX X).prime x).comap (a3r_lin (a3r_mat a))
  have : Q.IsPrime := Ideal.IsPrime.comap _
  have hb := hM Q heq
  have hx : ringKrullDim (MvPolynomial (Fin (n + 1)) ℂ ⧸ Q) =
      (height x : WithBot ℕ∞) + 1 := by
    rw [← a3r_dim_eq_of_finite (a3s_IX X) (a3r_mat a) hfin
      ((a3s_CX X).prime x) (a3s_IX_le X x)]
    exact (a3s_height_add_one X x).symm
  rw [hx, hdJ] at hb
  obtain ⟨_, mx, hmx, _⟩ := a1d_height_eq_trdeg (X := X) x
  rw [hmx, hmy] at hb ⊢
  have hb' : mx + 1 + 1 ≤ my + 1 := by exact_mod_cast hb
  exact_mod_cast (show mx < my by omega)
#print axioms IntersectionProductScaf_generic_endpoint_leading_height

/-- A point dominating the complex parameter line has positive height. -/
theorem IntersectionProductScaf_one_le_height_of_parameter_generic
    (X : Over (Spec ↧ℂ)) [IsProper X.hom]
    (y : (a3n_T X).left) (hy : a3n_p X y = genericPoint (a3m_Pn 1)) :
    1 ≤ height y := by
  apply Order.one_le_iff_ne_zero.mpr
  intro hz
  have : IsProper (a3n_p X) := inferInstanceAs (IsProper (CategoryTheory.Limits.pullback.snd X.hom a3n_P1.hom))
  have h := (a3n_p X).isClosedMap {y} (a3n_isClosed_of_height_eq_zero y hz)
  rw [Set.image_singleton, hy] at h
  have hd := a3n_height_eq_zero_of_isClosed _ h
  rw [a3n_height_genericPoint_P1] at hd
  exact one_ne_zero hd
#print axioms IntersectionProductScaf_one_le_height_of_parameter_generic
/-- In matching dimension, the original-fibre identity is equivalent to vanishing outside the family open. -/
theorem IntersectionProductScaf_originalFibre_projected_input_iff
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom]
    {n : ℕ} (M : Fin (n + 1) × Fin (n + 1) → ℂ)
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (hn : height (genericPoint X.left) = n)
    (y : (a3n_T X).left) (hy : a3n_h X y = genericPoint (g3c_P 1))
    (c : ℂ) (hc : c = 0 ∨ c = 1) :
    IntersectionProductScaf_originalFibreCycle M a hfin y c =
      IntersectionProductScaf_theta₀ X hfin M
        (a1p_pushforward (a3h_πO X hfin).left
          (a2g_fundCycle (((ccm3_primeIdeal (a3n_T X).left y).comap
            (a3n_σ X c)).subschemeι))) ↔
      ∀ x, x ∉ Set.range (IntersectionProductScaf_familyInclusion X M).left →
        IntersectionProductScaf_originalFibreCycle M a hfin y c x = 0 := by
  have := IntersectionProductScaf_projection_flat X hfin hn
  have := IntersectionProductScaf_familyMap₀_flat_of_projection X hfin M
  rw [IntersectionProductScaf_projected_input_line_fibre X M a hfin y hy c hc]
  change _ = a3m_smul _ (a1p_pushforward (IntersectionProductScaf_familyInclusion X M).left
    (ccm3_flatPullback (IntersectionProductScaf_familyMap₀ X hfin M).left _)) ↔ _
  rw [IntersectionProductScaf_flatPullback_fundCycle,
    ← a3k_pushforward_smul]
  exact IntersectionProductScaf_originalFibre_eq_open_extension_iff X M a hfin y c
#print axioms IntersectionProductScaf_originalFibre_projected_input_iff

section EndpointFibreIdentification
open CategoryTheory.Limits MvPolynomial HomogeneousLocalization TopologicalSpace
attribute [local instance] MvPolynomial.gradedAlgebra
attribute [local instance] Ring.toIntAlgebra AddCommGroup.toIntModule
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

/-- For general matrices, endpoint support outside the translation open has smaller height. -/
theorem IntersectionProductScaf_generic_endpoint_boundary_height
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom]
    {n : ℕ} (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (y : (a3n_T X).left) (hy : y ∈ a3h_U X)
    (hdom : a3n_h X y = genericPoint (g3c_P 1)) (hdim : 1 ≤ height y)
    (c : ℂ) (hc : c = 0 ∨ c = 1) :
    a3r_Generic {M : Fin (n + 1) × Fin (n + 1) → ℂ |
      ∀ x : (a3n_T X).left,
        x ∉ Set.range (IntersectionProductScaf_familyInclusion X M).left →
        a3k_ι X c x ∈ (IntersectionProductScaf_squarePrimeIdeal M a hfin y).support →
        height x < height y} := by
  classical
  refine ((IntersectionProductScaf_generic_endpoint_pencil_height X a hfin y hy hdom hdim c hc).inter
    (IntersectionProductScaf_generic_endpoint_leading_height X a hfin y hy hdom c hc)).mono ?_
  rintro M ⟨hfinite, hinfty⟩ x hx hs
  rw [IntersectionProductScaf_height_of_family_boundary X M x hx]
  have ho : (a3n_q (a3n_T X)).left (a3k_ι X c x) ∈ a3h_U X := by
    rw [← Scheme.Hom.comp_apply, a3k_ι_q, Scheme.Hom.comp_apply]
    rcases hc with rfl | rfl
    · exact a3h_σ0_mem_U X _
    · exact a3h_σ1_mem_U X _
  by_cases hxU : x ∈ a3h_U X
  · obtain ⟨t, ht, _⟩ := IntersectionProductScaf_affine_boundary_section X M x hxU hx
    obtain ⟨j, w, hw⟩ := IntersectionProductScaf_boundaryProductChart_covers_parameter X 0
      (a3k_ι X c x) ho (by rw [a3k_h_ι]; exact (a3h_mem_U_iff' X x).mp hxU)
    apply hfinite t ((a3n_q X).left x)
    apply IntersectionProductScaf_boundary_cone_inclusion X M a hfin y hy c x j 0 w hw hs
    have ht' : a3n_p X x = a3n_pt t a3n_o := by
      rw [ht, ← Scheme.Hom.comp_apply, a3n_σ_p, Scheme.Hom.comp_apply]
      exact congrArg (a3n_pt t) (Subsingleton.elim _ _)
    simpa only [IntersectionProductScaf_boundaryPencilMatrix, ite_true, show (0 : Fin 2).rev = 1 from rfl, a3m_t₁, a3r_mat] using
      IntersectionProductScaf_pencil_matrix_mod_scalar _ _ _ t
        (IntersectionProductScaf_boundary_translation_scalar X j c t x w hw ht') (a3r_mat M)
  · have hr : a3n_h (a3n_T X) (a3k_ι X c x) ∈ Set.range (g3c_chartι 1 1) := by
      rw [a3k_h_ι]
      obtain ⟨r, q, hq⟩ := g3c_chartι_covers 1 (a3n_h X x)
      have hr : r = 0 ∨ r = 1 := by fin_cases r <;> simp
      rcases hr with rfl | rfl
      · exact False.elim (hxU ((a3h_mem_U_iff' X x).mpr ⟨q, hq⟩))
      · exact ⟨q, hq⟩
    obtain ⟨j, w, hw⟩ := IntersectionProductScaf_boundaryProductChart_covers_parameter X 1
      (a3k_ι X c x) ho hr
    apply hinfty ((a3n_q X).left x)
    apply IntersectionProductScaf_boundary_cone_inclusion X M a hfin y hy c x j 1 w hw hs
    have ht' : a3n_p X x ∉ Set.range (a3m_Pnκ 1 0) := hxU
    simpa only [IntersectionProductScaf_boundaryPencilMatrix, show (1 : Fin 2) ≠ 0 by decide,
      ite_false, show (1 : Fin 2).rev = 0 from rfl, a3r_mat] using IntersectionProductScaf_pencil_matrix_mod_infinity _ _ _
        (IntersectionProductScaf_boundary_translation_infinity X j c x w hw ht') (a3r_mat M)
#print axioms IntersectionProductScaf_generic_endpoint_boundary_height

/-- Endpoint boundary support vanishing identifies the original fibre with the projected input family. -/
theorem IntersectionProductScaf_originalFibre_projected_input_of_dimension
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom]
    {n : ℕ} (S : Finset (a3n_T X).left) (hn : height (genericPoint X.left) = n) :
    a3r_Generic {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ |
      ∀ hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
          (a3r_lin (a3r_mat a)).toRingHom).Finite,
        a3r_Generic {M : Fin (n + 1) × Fin (n + 1) → ℂ |
          ∀ y ∈ S, a3n_h X y = genericPoint (g3c_P 1) →
            ∀ c : ℂ, (c = 0 ∨ c = 1) →
              IntersectionProductScaf_originalFibreCycle M a hfin y c =
                IntersectionProductScaf_theta₀ X hfin M
                  (a1p_pushforward (a3h_πO X hfin).left
                    (a2g_fundCycle (((ccm3_primeIdeal (a3n_T X).left y).comap
                      (a3n_σ X c)).subschemeι)))}} := by
  classical
  refine (IntersectionProductScaf_originalFibre_coefficient_height X S hn).mono ?_
  intro a ha hfin
  let T := S.filter fun y => a3n_h X y = genericPoint (g3c_P 1) ∧
    a3n_p X y = genericPoint (a3m_Pn 1)
  have H := a3r_generic_iInter T.attach _ fun y _ =>
    (IntersectionProductScaf_generic_endpoint_boundary_height X a hfin y.1
      (IntersectionProductScaf_parameter_generic_mem_U X y.1 (Finset.mem_filter.mp y.2).2.1)
      (Finset.mem_filter.mp y.2).2.1
      (IntersectionProductScaf_one_le_height_of_parameter_generic X y.1 (Finset.mem_filter.mp y.2).2.2)
      0 (Or.inl rfl)).inter
    (IntersectionProductScaf_generic_endpoint_boundary_height X a hfin y.1
      (IntersectionProductScaf_parameter_generic_mem_U X y.1 (Finset.mem_filter.mp y.2).2.1)
      (Finset.mem_filter.mp y.2).2.1
      (IntersectionProductScaf_one_le_height_of_parameter_generic X y.1 (Finset.mem_filter.mp y.2).2.2)
      1 (Or.inr rfl))
  refine ((ha hfin).inter H).mono ?_
  rintro M ⟨hcoeff, hbound⟩ y hy hdom c hc
  by_cases hp : a3n_p X y = genericPoint (a3m_Pn 1)
  · apply (IntersectionProductScaf_originalFibre_projected_input_iff X M a hfin hn y hdom c hc).mpr
    intro x hx
    by_contra hne
    have hh := hcoeff y hy hdom c hc x hne
    have hs := IntersectionProductScaf_originalFibre_support X M a hfin y c x hne
    have hb := hbound ⟨y, Finset.mem_filter.mpr ⟨hy, hdom, hp⟩⟩ (Finset.mem_attach _ _)
    have hl : height x < height y := by
      rcases hc with rfl | rfl
      · exact hb.1 x hx hs
      · exact hb.2 x hx hs
    exact (ne_of_lt hl) hh
  · exact IntersectionProductScaf_originalFibre_projected_input_of_parameter X M a hfin y hdom hp c hc
#print axioms IntersectionProductScaf_originalFibre_projected_input_of_dimension

