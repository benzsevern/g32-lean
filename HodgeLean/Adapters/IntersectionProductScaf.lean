/-- The generic regular-section expansion can be indexed by all global components. -/
theorem IntersectionProductScaf_regular_section_global_sum_at
    (Y : Scheme) [IsNoetherian Y] (J : Y.IdealSheafData)
    (x : J.subscheme) (hx : x ∈ genericPoints J.subscheme)
    (r : Y.presheaf.stalk (J.subschemeι x))
    (hr : IsSMulRegular (Y.presheaf.stalk (J.subschemeι x)) r)
    (hker : RingHom.ker (J.subschemeι.stalkMap x).hom = Ideal.span {r})
    (hY : (genericPoints Y).Finite) :
    a2g_fundCycle J.subschemeι (J.subschemeι x) =
      ∑ z ∈ hY.toFinset, a2g_fundCycle (𝟙 Y) z *
        a2g_fundCycle (((ccm3_primeIdeal Y z).comap J.subschemeι).subschemeι) x := by
  rw [IntersectionProductScaf_regular_section_component_sum_at Y J x hx r hr hker]
  refine IntersectionProductScaf_component_sum_fromSpecStalk Y (J.subschemeι x)
    (fun z => a2g_fundCycle (𝟙 Y) z *
      a2g_fundCycle (((ccm3_primeIdeal Y z).comap J.subschemeι).subschemeι) x) ?_ hY
  intro z hz
  rw [IntersectionProductScaf_prime_restriction_zero Y J z x hz, mul_zero]
#print axioms IntersectionProductScaf_regular_section_global_sum_at



