/-- Every translated cone component lies over the generic point of the affine translation
parameter. -/
theorem IntersectionProductScaf_translatedCone_component_parameter_generic
    (I : Ideal (MvPolynomial (Fin (n + 1) ⊕ Unit) ℂ)) [I.IsPrime]
    (Q : PrimeSpectrum _) (hQ : Q.asIdeal ∈ ((I.map Polynomial.C).map
      (IntersectionProductScaf_translatedConeMap X a M)).minimalPrimes) :
    let g : Polynomial ℂ →+* _ :=
      (IntersectionProductScaf_translatedConeMap X a M).comp
        (Polynomial.mapRingHom
          (algebraMap ℂ (MvPolynomial (Fin (n + 1) ⊕ Unit) ℂ)))
    (Spec.map (CommRingCat.ofHom g)) Q =
      genericPoint (Spec (.of (Polynomial ℂ))) := by
  dsimp only
  apply IntersectionProductScaf_parameter_spec_generic
  intro p hp
  exact IntersectionProductScaf_translatedCone_component_parameter X hfin hn M I
    Q.asIdeal hQ p hp
