/-- Proper pushforward preserves each parameter fibre with the product-map residue degree. -/
theorem IntersectionProductScaf_proper_pushforward_prime_fibre
    {X Y : Over (Spec ↧ℂ)} [IsIntegral X.left] [IsIntegral Y.left]
    [Smooth X.hom] [Smooth Y.hom] [IsProjective X.hom] [IsProjective Y.hom]
    (g : X ⟶ Y) [IsProper g.left]
    (w : (a3n_T X).left) (hw : a3n_h X w = genericPoint (g3c_P 1))
    (c : ℂ) (hc : c = 0 ∨ c = 1) :
    a1p_pushforward g.left
      (a2g_fundCycle (((ccm3_primeIdeal (a3n_T X).left w).comap
        (a3n_σ X c)).subschemeι)) =
      a3m_smul (a1p_degree (a3h_G g).left w : ℚ)
        (a2g_fundCycle (((ccm3_primeIdeal (a3n_T Y).left ((a3h_G g).left w)).comap
          (a3n_σ Y c)).subschemeι)) := by
  have hσ (Z : Over (Spec ↧ℂ)) (d : ℂ) : IsClosedImmersion (a3n_σ Z d) := by
    have : IsClosedImmersion (a3n_σ Z d ≫ (a3n_q Z).left) := by
      rw [a3n_σ_q]
      infer_instance
    exact IsClosedImmersion.of_comp _ (a3n_q Z).left
  letI : IsClosedImmersion (a3n_σ X 0) := hσ X 0
  letI : IsClosedImmersion (a3n_σ X 1) := hσ X 1
  letI : IsClosedImmersion (a3n_σ Y 0) := hσ Y 0
  letI : IsClosedImmersion (a3n_σ Y 1) := hσ Y 1
  have hGw : a3n_h Y ((a3h_G g).left w) = genericPoint (g3c_P 1) := by
    rw [a3h_G_h_apply]
    exact hw
  have H := a3h_push_cyc g w hw hGw
  rw [IntersectionProductScaf_prime_parameter_divisor_fibres X w hw,
    IntersectionProductScaf_prime_parameter_divisor_fibres Y _ hGw,
    IntersectionProductScaf_pushforward_sub,
    ← a1p_pushforward_comp, ← a1p_pushforward_comp] at H
  simp only [IntersectionProductScaf_product_map_section, a1p_pushforward_comp] at H
  ext x
  rcases hc with rfl | rfl
  · have hx : a3n_σ Y 0 x ∉ Set.range (a3n_σ Y 1) := by
      rintro ⟨z, hz⟩
      exact a3n_σ0_ne_σ1 Y x z hz.symm
    have Hx := congrArg (fun C => C (a3n_σ Y 0 x)) H
    simp only [a3m_smul_apply, Function.locallyFinsuppWithin.coe_sub, Pi.sub_apply] at Hx ⊢
    rw [IntersectionProductScaf_closed_pushforward_apply,
      IntersectionProductScaf_closed_pushforward_apply,
      IntersectionProductScaf_pushforward_apply_of_not_mem_range _ _ _ hx,
      IntersectionProductScaf_pushforward_apply_of_not_mem_range _ _ _ hx] at Hx
    simpa only [sub_zero] using Hx
  · have hx : a3n_σ Y 1 x ∉ Set.range (a3n_σ Y 0) := by
      rintro ⟨z, hz⟩
      exact a3n_σ0_ne_σ1 Y z x hz
    have Hx := congrArg (fun C => C (a3n_σ Y 1 x)) H
    simp only [a3m_smul_apply, Function.locallyFinsuppWithin.coe_sub, Pi.sub_apply] at Hx ⊢
    rw [IntersectionProductScaf_closed_pushforward_apply,
      IntersectionProductScaf_closed_pushforward_apply,
      IntersectionProductScaf_pushforward_apply_of_not_mem_range _ _ _ hx,
      IntersectionProductScaf_pushforward_apply_of_not_mem_range _ _ _ hx] at Hx
    simpa only [zero_sub, mul_neg, neg_inj] using Hx
#print axioms IntersectionProductScaf_proper_pushforward_prime_fibre

section EvaluatedSquareFibres
open CategoryTheory.Limits
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
/-- Specializations of a proper product image on a section come from a component of the source fibre. -/
theorem IntersectionProductScaf_proper_image_section_component
    {X Y : Over (Spec ↧ℂ)} [IsIntegral X.left]
    (g : X ⟶ Y) [IsProper g.left] (w : (a3n_T X).left) (c : ℂ) (x : Y.left)
    (hx : (a3h_G g).left w ⤳ a3n_σ Y c x) :
    ∃ D : X.left, a3n_σ X c D ∈ a3y_comps w (a3n_σ X c (genericPoint X.left)) ∧
      g.left D ⤳ x := by
  obtain ⟨t, hwt, ht⟩ := (a3h_G g).left.isClosedMap.specializingMap hx
  have hp : a3n_p X t = a3n_p Y (a3n_σ Y c x) := by
    have he := congrArg (fun f : (a3n_T X).left ⟶ a3n_P1.left => f t) (a3h_G_p g)
    change a3n_p Y ((a3h_G g).left t) = a3n_p X t at he
    rw [ht] at he
    exact he.symm
  have hr : t ∈ Set.range (a3n_σ X c) := by
    rw [a3n_range_σ]
    change a3n_p X t ∈ Set.range (a3n_pt c)
    rw [hp]
    exact ⟨Y.hom x, congrArg (fun f : Y.left ⟶ a3n_P1.left => f x) (a3n_σ_p Y c) |>.symm⟩
  obtain ⟨u, rfl⟩ := hr
  obtain ⟨z, hz, hzu⟩ := a3y_exists_comp w (a3n_σ X c (genericPoint X.left)) hwt
    ((genericPoint_specializes u).map (a3n_σ X c).continuous)
  obtain ⟨D, rfl⟩ := a3n_mem_range_σ_of_specializes X c (a3y_comps_spec _ _ hz).2.1
  refine ⟨D, hz, ?_⟩
  have he (v : X.left) : (a3h_G g).left (a3n_σ X c v) = a3n_σ Y c (g.left v) :=
    congrArg (fun f : X.left ⟶ (a3n_T Y).left => f v)
      (IntersectionProductScaf_product_map_section g c)
  have hs := (hzu.map (a3h_G g).left.continuous).map (a3n_q Y).left.continuous
  rw [ht, he, a3n_q_σ_apply, a3n_q_σ_apply] at hs
  exact hs
#print axioms IntersectionProductScaf_proper_image_section_component

/-- A component of a dominating prime's parameter fibre has the prime's ambient codimension. -/
theorem IntersectionProductScaf_section_component_base_coheight
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom]
    (w : (a3n_T X).left) (hw : a3n_h X w = genericPoint (g3c_P 1))
    (c : ℂ) (hc : c = 0 ∨ c = 1) (D : X.left)
    (hD : a3n_σ X c D ∈ a3y_comps w (a3n_σ X c (genericPoint X.left))) :
    coheight D = coheight w := by
  have he := IntersectionProductScaf_section_component_coheight X w hw c hc hD
  rw [a3n_coheight_σ] at he
  exact WithTop.add_right_cancel (by simp) he
#print axioms IntersectionProductScaf_section_component_base_coheight

/-- One generic matrix controls specializations from every original endpoint component in a finite input. -/
theorem IntersectionProductScaf_generic_endpoint_component_bound
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom] {n : ℕ}
    {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (beta : AlgebraicCycle X.left ℚ) (S : Finset (a3n_T X).left)
    (hn : height (genericPoint X.left) = n) :
    a3r_Generic {M : Fin (n + 1) × Fin (n + 1) → ℂ |
      ∀ hM : IsUnit (a3r_mat M).det, ∀ y ∈ S, ∀ c : ℂ, (c = 0 ∨ c = 1) →
      ∀ D : X.left, a3n_σ X c D ∈ a3y_comps y (a3n_σ X c (genericPoint X.left)) →
      ∀ v, beta v ≠ 0 → ∀ x : X.left,
        (a3h_πO X hfin).left D ⤳
          (IntersectionProductScaf_lineFibreMap X hfin M 1 (by
            rw [IntersectionProductScaf_lineDet_one]; convert hM using 1 <;> congr 1)).left x →
        v ⤳ x → coheight D + coheight v ≤ coheight x} := by
  have : IsLocallyNoetherian (a3n_T X).left := LocallyOfFiniteType.isLocallyNoetherian (a3n_T X).hom
  have : IsNoetherian (a3n_T X).left := ⟨⟩
  have H := a3r_generic_iInter S _ fun y _ =>
    a3r_generic_iInter ({0, 1} : Finset ℂ) _ fun c _ =>
      a3r_generic_iInter (a3y_comps_finite y (a3n_σ X c (genericPoint X.left))).toFinset _ fun z _ =>
        a3r_generic_iInter (a3m_support_finite beta).toFinset _ fun v _ =>
          IntersectionProductScaf_generic_one_specialization_bound X hfin hn ((a3n_q X).left z) v
  refine H.mono fun M hM hdet y hy c hc D hD v hv x hDx hvx => ?_
  have h := hM y hy c (by simpa only [Finset.mem_insert, Finset.mem_singleton] using hc)
    (a3n_σ X c D) (by simpa only [Set.Finite.mem_toFinset] using hD)
    v (by simpa only [Set.Finite.mem_toFinset, Function.mem_support] using hv)
  rw [a3n_q_σ_apply] at h
  exact h hdet x hDx hvx
#print axioms IntersectionProductScaf_generic_endpoint_component_bound

/-- Evaluating the square projection is the product extension of the evaluated line projection. -/
theorem IntersectionProductScaf_squareFibreMap_product
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] {n : ℕ}
    {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (M : Fin (n + 1) × Fin (n + 1) → ℂ) (c : ℂ)
    (hc : IsUnit ((IntersectionProductScaf_lineDet M).eval c)) :
    (IntersectionProductScaf_squareFibreMap X hfin M c hc).left =
      (a3h_G (IntersectionProductScaf_lineFibreMap X hfin M c hc)).left := by
  apply pullback.hom_ext
  · change (IntersectionProductScaf_squareFibreMap X hfin M c hc).left ≫
        (a3n_q (a3h_PnO n)).left =
      (a3h_G (IntersectionProductScaf_lineFibreMap X hfin M c hc)).left ≫
        (a3n_q (a3h_PnO n)).left
    rw [a3h_G_q, IntersectionProductScaf_squareFibreMap_eq]
    change (_ ≫ pullback.lift _ _ _) ≫ pullback.fst _ _ = _
    rw [Category.assoc, pullback.lift_fst, IntersectionProductScaf_squareMapToProjective_eq]
    change IntersectionProductScaf_familySection (a3n_T X) M c hc ≫
      (IntersectionProductScaf_forgetOriginal X M).left ≫
      (IntersectionProductScaf_familyMap₀ X hfin M).left = _
    rw [← Category.assoc, IntersectionProductScaf_familySection_forgetOriginal,
      Category.assoc, ← IntersectionProductScaf_lineFibreMap_eq]
  · exact (IntersectionProductScaf_squareFibreMap_parameter X hfin M c hc).trans
      (a3h_G_p _).symm
#print axioms IntersectionProductScaf_squareFibreMap_product

/-- Evaluated square projections commute with the original parameter sections. -/
theorem IntersectionProductScaf_squareFibreMap_section
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] {n : ℕ}
    {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (M : Fin (n + 1) × Fin (n + 1) → ℂ) (c d : ℂ)
    (hc : IsUnit ((IntersectionProductScaf_lineDet M).eval c)) :
    a3n_σ X d ≫ (IntersectionProductScaf_squareFibreMap X hfin M c hc).left =
      (IntersectionProductScaf_lineFibreMap X hfin M c hc).left ≫ a3n_σ (a3h_PnO n) d := by
  rw [IntersectionProductScaf_squareFibreMap_product]
  exact IntersectionProductScaf_product_map_section _ _
#print axioms IntersectionProductScaf_squareFibreMap_section

/-- Finite projection of an input parameter fibre has the product-projection residue degree. -/
theorem IntersectionProductScaf_projected_prime_fibre
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom] {n : ℕ}
    {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (y : (a3n_T X).left) (hy : a3n_h X y = genericPoint (g3c_P 1))
    (c : ℂ) (hc : c = 0 ∨ c = 1) :
    a1p_pushforward (a3h_πO X hfin).left
      (a2g_fundCycle (((ccm3_primeIdeal (a3n_T X).left y).comap (a3n_σ X c)).subschemeι)) =
    a3m_smul (a1p_degree (a3h_G (a3h_πO X hfin)).left y : ℚ)
      (a2g_fundCycle (((ccm3_primeIdeal (a3n_T (a3h_PnO n)).left
        ((a3h_G (a3h_πO X hfin)).left y)).comap (a3n_σ (a3h_PnO n) c)).subschemeι)) := by
  have : IsIntegral (a3h_PnO n).left := IntersectionProductScaf_projective_integral n
  have : Smooth (a3h_PnO n).hom := IntersectionProductScaf_projective_smooth n
  have : IsProjective (a3h_PnO n).hom :=
    ⟨⟨{ ambientDimension := n, immersion := 𝟙 _, immersion_toBase := Category.id_comp _ }⟩⟩
  exact IntersectionProductScaf_proper_pushforward_prime_fibre (a3h_πO X hfin) y hy c hc
#print axioms IntersectionProductScaf_projected_prime_fibre

/-- The line family of the projected input fibre is the target fibre's line family weighted by the product projection degree. -/
theorem IntersectionProductScaf_projected_input_line_fibre
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom]
    {n : ℕ} (M : Fin (n + 1) × Fin (n + 1) → ℂ)
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (y : (a3n_T X).left) (hy : a3n_h X y = genericPoint (g3c_P 1))
    (c : ℂ) (hc : c = 0 ∨ c = 1) :
    IntersectionProductScaf_theta₀ X hfin M
      (a1p_pushforward (a3h_πO X hfin).left
        (a2g_fundCycle (((ccm3_primeIdeal (a3n_T X).left y).comap
          (a3n_σ X c)).subschemeι))) =
      a3m_smul (a1p_degree (a3h_G (a3h_πO X hfin)).left y : ℚ)
        (IntersectionProductScaf_theta₀ X hfin M
          (a2g_fundCycle (((ccm3_primeIdeal (a3n_T (a3h_PnO n)).left
            ((a3h_G (a3h_πO X hfin)).left y)).comap
              (a3n_σ (a3h_PnO n) c)).subschemeι))) := by
  rw [IntersectionProductScaf_projected_prime_fibre X hfin y hy c hc]
  exact IntersectionProductScaf_openFamilyCycle_smul
    (IntersectionProductScaf_familyInclusion X M)
    (IntersectionProductScaf_familyMap₀ X hfin M) _ _
#print axioms IntersectionProductScaf_projected_input_line_fibre

/-- A map on the first affine factor commutes with the tensor-product chart. -/
theorem IntersectionProductScaf_productChart_ringMap
    {Y Z : Scheme.{0}} (R S T : CommRingCat.{0}) (f : R →+* S)
    (j : Spec R ⟶ Y) (k : Spec T ⟶ Z) :
    Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.map f.toIntAlgHom
      (AlgHom.id ℤ T)).toRingHom) ≫ a3m_prodChart j k =
      a3m_prodChart (Spec.map (CommRingCat.ofHom f) ≫ j) k := by
  apply pullback.hom_ext
  · simp only [Category.assoc, a3m_prodChart_fst]
    simp only [← Category.assoc, ← Spec.map_comp]
    congr 1
  · simp only [Category.assoc, a3m_prodChart_snd]
    rw [← Category.assoc, ← Spec.map_comp]
    congr 1
    congr 1
    ext t
    simp [Algebra.TensorProduct.includeRight_apply, Algebra.TensorProduct.map_tmul]
#print axioms IntersectionProductScaf_productChart_ringMap

/-- The product extension of a base morphism acts on the first factor of every product chart. -/
theorem IntersectionProductScaf_productMap_chart
    {X Y : Over (Spec ↧ℂ)} (g : X ⟶ Y) (R : CommRingCat.{0})
    (j : Spec R ⟶ X.left) :
    a3m_prodChart j (g3c_chartι 1 0) ≫ (a3h_e X).inv ≫ (a3h_G g).left ≫ (a3h_e Y).hom =
      a3m_prodChart (j ≫ g.left) (g3c_chartι 1 0) := by
  apply pullback.hom_ext
  · simp only [Category.assoc, a3h_e_fst, a3h_G_q, a3m_prodChart_fst]
    have he : (a3h_e X).inv ≫ (a3n_q X).left =
        pullback.fst (terminal.from X.left) (terminal.from (g3c_P 1)) := by
      rw [← a3h_e_fst, Iso.inv_hom_id_assoc]
    rw [← Category.assoc (a3h_e X).inv, he, ← Category.assoc, a3m_prodChart_fst]
    simp only [Category.assoc]
  · simp only [Category.assoc, a3h_e_snd]
    change _ ≫ (a3h_e X).inv ≫ (a3h_G g).left ≫ a3n_p Y ≫ a3n_π = _
    rw [← Category.assoc (a3h_G g).left, a3h_G_p]
    have he : (a3h_e X).inv ≫ a3n_h X =
        pullback.snd (terminal.from X.left) (terminal.from (g3c_P 1)) := by
      rw [← a3h_e_snd, Iso.inv_hom_id_assoc]
    change _ ≫ (a3h_e X).inv ≫ a3n_h X = _
    rw [he, a3m_prodChart_snd, a3m_prodChart_snd]
#print axioms IntersectionProductScaf_productMap_chart

end EvaluatedSquareFibres

section RelativeTranslateBounds
open MvPolynomial
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option maxHeartbeats 400000 in
/-- Relative translate equations impose the cylinder codimension bound after a finite projection. -/
theorem IntersectionProductScaf_generic_relative_bound_of_equations
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] {n : ℕ}
    {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (hn : height (genericPoint X.left) = n)
    (y : (a3n_T X).left) (hy : y ∈ a3h_U X) (v : X.left) :
    a3r_Generic {M : Fin (n + 1) × Fin (n + 1) → ℂ |
      ∀ z : (a3n_T X).left, ∀ hz : z ∈ a3h_U X,
      v ⤳ (a3n_q X).left z →
      (∀ F ∈ (a3h_P X y hy).comap (a3r_lin (a3h_block a)),
        a3r_lin (a3h_block a) (a3h_substT M F) ∈ a3h_P X z hz) →
      coheight y + coheight v ≤ coheight z} := by
  let IC := (a3h_P X y hy).comap (a3r_lin (a3h_block a))
  let PW := ((a3s_CX X).prime v).comap (a3r_lin (a3r_mat a))
  have : IC.IsPrime := Ideal.IsPrime.comap _
  have : PW.IsPrime := Ideal.IsPrime.comap _
  refine (a3h_generic_translate_rel IC PW).mono fun M hM z hz hvz heq => ?_
  let Q := (a3h_P X z hz).comap (a3r_lin (a3h_block a))
  have hW (F : MvPolynomial (Fin (n + 1)) ℂ) (hF : F ∈ PW) : rename Sum.inl F ∈ Q := by
    change a3r_lin (a3h_block a) (rename Sum.inl F) ∈ a3h_P X z hz
    rw [← a3h_rename_lin]
    apply (a3h_fst_prime X z hz _).mp
    exact (a3s_CX X).prime_mono hvz hF
  obtain ⟨j, hj⟩ := (a3m_projCharts n).cover ((a3h_πO X hfin).left ((a3n_q X).left z))
  have hj' : MvPolynomial.X (Sum.inl j) ∉ Q := by
    intro h
    change a3r_lin (a3h_block a) (MvPolynomial.X (Sum.inl j)) ∈ a3h_P X z hz at h
    have h' : rename Sum.inl (a3r_lin (a3r_mat a) (MvPolynomial.X j)) ∈ a3h_P X z hz := by
      rw [a3h_rename_lin, MvPolynomial.rename_X]
      exact h
    have hp := (a3h_fst_prime X z hz (a3r_lin (a3r_mat a) (MvPolynomial.X j))).mpr h'
    have hp' : MvPolynomial.X j ∈ (a3m_projCharts n).prime
        ((a3h_πO X hfin).left ((a3n_q X).left z)) := by
      erw [a3h_prime_π]
      exact hp
    exact ((a3m_projCharts n).X_mem_prime_iff _ j).mp hp' hj
  have hb := hM Q inferInstance hW heq j hj'
  have hdim (w : (a3n_T X).left) (hw : w ∈ a3h_U X) :=
    a3r_dim_eq_of_finite (a3h_IXr (a3s_IX X)) (a3h_block a)
      (a3h_finite_rel (a3s_IX X) a hfin) (a3h_P X w hw) (a3h_IXr_le_P X w hw)
  have hdv := a3r_dim_eq_of_finite (a3s_IX X) (a3r_mat a) hfin
    ((a3s_CX X).prime v) (a3s_IX_le X v)
  obtain ⟨cy, hcy, hcy_le, hdy⟩ := a3h_dim_P X n hn y hy
  obtain ⟨cz, hcz, hcz_le, hdz⟩ := a3h_dim_P X n hn z hz
  obtain ⟨mv, cv, _, hcv, hvc, hdvv⟩ := a3s_nums X n hn v
  change ringKrullDim (_ ⧸ (a3h_P X z hz).comap _) + _ ≤
    ringKrullDim (_ ⧸ (a3h_P X y hy).comap _) + ringKrullDim (_ ⧸ ((a3s_CX X).prime v).comap _) at hb
  rw [← hdim z hz, ← hdim y hy, ← hdv, hdy, hdz, hdvv, Fintype.card_fin] at hb
  have hb' : n + 2 - cz + (n + 1) ≤ n + 2 - cy + (mv + 1) := by exact_mod_cast hb
  rw [hcy, hcv, hcz]
  exact_mod_cast (show cy + cv ≤ cz by omega)
#print axioms IntersectionProductScaf_generic_relative_bound_of_equations
/-- Translation fixing the affine base coordinate is the corresponding block linear substitution. -/
theorem IntersectionProductScaf_substT_block
    {σ : Type} [Fintype σ] (M : σ × σ → ℂ) :
    a3h_substT (τ := Unit) M = a3r_lin (a3h_block M) := by
  apply MvPolynomial.algHom_ext
  intro i
  rcases i with i | i
  · rw [a3h_substT_inl, a3h_lin_block_inl]
  · rw [a3h_substT_inr, a3h_lin_block_inr]
#print axioms IntersectionProductScaf_substT_block

/-- The block projection becomes coefficientwise linear substitution under the polynomial equivalence. -/
theorem IntersectionProductScaf_eqT_linear_projection
    {ρ σ : Type} [Fintype ρ] [Fintype σ] (a : ρ × σ → ℂ)
    (F : MvPolynomial (ρ ⊕ Unit) ℂ) :
    a3h_eqT σ (a3r_lin (a3h_block a) F) =
      (a3h_eqT ρ F).map (a3r_lin (a3r_mat a)).toRingHom := by
  have hC (c : ℂ) : a3h_eqT σ (MvPolynomial.C c) = Polynomial.C (MvPolynomial.C c) :=
    (a3h_eqT σ).commutes c
  have he : (a3h_eqT σ).toAlgHom.comp (a3r_lin (a3h_block a)) =
      (Polynomial.mapAlgHom (a3r_lin (a3r_mat a))).comp (a3h_eqT ρ).toAlgHom := by
    apply MvPolynomial.algHom_ext
    intro i
    rcases i with i | i
    · simp [a3h_lin_block_inl, a3h_eqT_inl, a3r_lin_X, a3r_mat, hC]
    · simp [a3h_lin_block_inr, a3h_eqT_inr]
  exact congrArg (fun f : MvPolynomial (ρ ⊕ Unit) ℂ →ₐ[ℂ] Polynomial (MvPolynomial σ ℂ) => f F) he
#print axioms IntersectionProductScaf_eqT_linear_projection

/-- Linear substitution in homogeneous coordinates over the affine parameter ring.
Source: Hartshorne, *Algebraic Geometry*, II, Proposition 2.5. -/
def IntersectionProductScaf_relativeLinear
    {ρ σ : Type} [Fintype σ] (a : ρ × σ → ℂ) :
    MvPolynomial ρ (Polynomial ℂ) →ₐ[Polynomial ℂ] MvPolynomial σ (Polynomial ℂ) :=
  aeval fun i => ∑ k, MvPolynomial.C (Polynomial.C (a (i, k))) * MvPolynomial.X k

/-- Relative linear substitution is ordinary linear substitution after extending coefficients. -/
theorem IntersectionProductScaf_relativeLinear_map_C
    {ρ σ : Type} [Fintype ρ] [Fintype σ] (a : ρ × σ → ℂ)
    (F : MvPolynomial ρ ℂ) :
    IntersectionProductScaf_relativeLinear a (MvPolynomial.map Polynomial.C F) =
      MvPolynomial.map Polynomial.C (a3r_lin (a3r_mat a) F) := by
  have he : (IntersectionProductScaf_relativeLinear a).toRingHom.comp (MvPolynomial.map Polynomial.C) =
      (MvPolynomial.map Polynomial.C).comp (a3r_lin (a3r_mat a)).toRingHom := by
    apply MvPolynomial.ringHom_ext
    · intro c
      simp [IntersectionProductScaf_relativeLinear, a3r_lin_C]
    · intro i
      simp [IntersectionProductScaf_relativeLinear, a3r_lin_X, a3r_mat]
  exact congrArg (fun f : MvPolynomial ρ ℂ →+* MvPolynomial σ (Polynomial ℂ) => f F) he
#print axioms IntersectionProductScaf_relativeLinear_map_C

/-- Relative linear substitution preserves homogeneous degree in the projective coordinates. -/
theorem IntersectionProductScaf_relativeLinear_homogeneous
    {ρ σ : Type} [Fintype σ] (a : ρ × σ → ℂ)
    (F : MvPolynomial ρ (Polynomial ℂ)) (d : ℕ) (hF : F.IsHomogeneous d) :
    (IntersectionProductScaf_relativeLinear a F).IsHomogeneous d := by
  have hX (i : ρ) :
      (∑ k, MvPolynomial.C (Polynomial.C (a (i, k))) * MvPolynomial.X k).IsHomogeneous 1 := by
    exact IsHomogeneous.sum _ _ _ fun k _ => isHomogeneous_C_mul_X _ _
  simpa only [one_mul, IntersectionProductScaf_relativeLinear] using hF.aeval (S := Polynomial ℂ) _ hX
#print axioms IntersectionProductScaf_relativeLinear_homogeneous

/-- Relative linear substitution commutes with taking homogeneous components. -/
theorem IntersectionProductScaf_relativeLinear_homogeneousComponent
    {ρ σ : Type} [Fintype σ] (a : ρ × σ → ℂ)
    (F : MvPolynomial ρ (Polynomial ℂ)) (d : ℕ) :
    homogeneousComponent d (IntersectionProductScaf_relativeLinear a F) =
      IntersectionProductScaf_relativeLinear a (homogeneousComponent d F) := by
  classical
  conv_lhs => rw [← sum_homogeneousComponent F]
  rw [map_sum, map_sum]
  simp_rw [homogeneousComponent_of_mem ((mem_homogeneousSubmodule _ _).2
    (IntersectionProductScaf_relativeLinear_homogeneous a _ _ (homogeneousComponent_isHomogeneous _ F)))]
  rw [Finset.sum_ite_eq]
  split_ifs with he
  · rfl
  · rw [homogeneousComponent_eq_zero, map_zero]
    simp only [Finset.mem_range, not_lt] at he
    omega
#print axioms IntersectionProductScaf_relativeLinear_homogeneousComponent

/-- Moving the parameter into the coefficient ring commutes with linear projection. -/
theorem IntersectionProductScaf_eq_linear_projection
    {ρ σ : Type} [Fintype ρ] [Fintype σ] (a : ρ × σ → ℂ)
    (F : Polynomial (MvPolynomial ρ ℂ)) :
    a3m_eq σ (F.map (a3r_lin (a3r_mat a)).toRingHom) =
      IntersectionProductScaf_relativeLinear a (a3m_eq ρ F) := by
  classical
  have he : (a3m_eq σ).toRingHom.comp (Polynomial.mapRingHom (a3r_lin (a3r_mat a)).toRingHom) =
      (IntersectionProductScaf_relativeLinear a).toRingHom.comp (a3m_eq ρ).toRingHom := by
    apply Polynomial.ringHom_ext
    · intro G
      simp only [RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_C]
      change a3m_eq σ (Polynomial.C (a3r_lin (a3r_mat a) G)) =
        IntersectionProductScaf_relativeLinear a (a3m_eq ρ (Polynomial.C G))
      rw [a3m_eq_C, a3m_eq_C]
      exact (IntersectionProductScaf_relativeLinear_map_C a G).symm
    · simp only [RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_X]
      change a3m_eq σ Polynomial.X = IntersectionProductScaf_relativeLinear a (a3m_eq ρ Polynomial.X)
      rw [a3m_eq_X, a3m_eq_X]
      simp [IntersectionProductScaf_relativeLinear]
  exact congrArg (fun f : Polynomial (MvPolynomial ρ ℂ) →+* MvPolynomial σ (Polynomial ℂ) => f F) he
#print axioms IntersectionProductScaf_eq_linear_projection

/-- Invertible changes of target coordinates preserve finiteness of a linear projection. -/
theorem IntersectionProductScaf_matrix_projection_finite
    {ρ σ : Type} [Fintype ρ] [Fintype σ] [DecidableEq ρ]
    (I : Ideal (MvPolynomial σ ℂ)) (a : ρ × σ → ℂ)
    (hfin : ((Ideal.Quotient.mk I).comp (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (M : Matrix ρ ρ ℂ) (hM : IsUnit M.det) :
    ((Ideal.Quotient.mk I).comp (a3r_lin (M * a3r_mat a)).toRingHom).Finite := by
  rw [a3r_lin_mul]
  change (((Ideal.Quotient.mk I).comp (a3r_lin (a3r_mat a)).toRingHom).comp
    (a3r_lin M).toRingHom).Finite
  exact hfin.comp (RingHom.Finite.of_surjective _ (a3r_linEquiv M hM).surjective)
#print axioms IntersectionProductScaf_matrix_projection_finite

end RelativeTranslateBounds

section ConstantProjectionComparison
open CategoryTheory.Limits MvPolynomial HomogeneousLocalization
attribute [local instance] MvPolynomial.gradedAlgebra
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
/-- Constant translation of projection sections is the projection defined by the matrix product. -/
theorem IntersectionProductScaf_translatedSections_matrix_product
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] {n : ℕ}
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (Z : Over (Spec ↧ℂ)) (q : Z.left ⟶ X.left) (hq : q ≫ X.hom = Z.hom)
    (M : Matrix (Fin (n + 1)) (Fin (n + 1)) ℂ) (j : Fin (a3s_N X + 1)) :
    IntersectionProductScaf_translatedSections X (a := a) Z q
        ((IntersectionProductScaf_complexScalars Z).mapMatrix M) j =
      IntersectionProductScaf_projectionSections X
        (a := fun p => (M * a3r_mat a) p.1 p.2) Z q j := by
  let b : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ := fun p => (M * a3r_mat a) p.1 p.2
  have he : IntersectionProductScaf_translatedComplexSections X (a := a) Z q
      ((IntersectionProductScaf_complexScalars Z).mapMatrix M) j =
      IntersectionProductScaf_translatedComplexSections X (a := b) Z q
        ((IntersectionProductScaf_complexScalars Z).mapMatrix 1) j := by
    rw [IntersectionProductScaf_translatedComplexSections_constant X Z q M hq,
      IntersectionProductScaf_translatedComplexSections_constant X Z q 1 hq]
    apply RingHom.ext
    intro F
    change IntersectionProductScaf_chartCoordinates X Z q j
        (a3r_lin (a3r_mat a) (a3r_lin M F)) =
      IntersectionProductScaf_chartCoordinates X Z q j (a3r_lin (a3r_mat b) (a3r_lin 1 F))
    rw [a3r_lin_one]
    change _ = IntersectionProductScaf_chartCoordinates X Z q j (a3r_lin (M * a3r_mat a) F)
    rw [a3r_lin_mul]
    rfl
  apply MvPolynomial.ringHom_ext
  · intro ⟨c⟩
    change IntersectionProductScaf_translatedSections X (a := a) Z q
        ((IntersectionProductScaf_complexScalars Z).mapMatrix M) j (c : UniversalRing n) =
      IntersectionProductScaf_projectionSections X (a := b) Z q j (c : UniversalRing n)
    simp only [map_intCast]
  · intro i
    have h := congrArg (fun f : MvPolynomial (Fin (n + 1)) ℂ →+*
      Γ((IntersectionProductScaf_projectionCover X Z q).X j, ⊤) => f (MvPolynomial.X i)) he
    simpa only [IntersectionProductScaf_translatedComplexSections, MvPolynomial.eval₂Hom_X',
      map_one, IntersectionProductScaf_translatedSections, IntersectionProductScaf_chartMatrix,
      IntersectionProductScaf_matrixSections_one] using h
#print axioms IntersectionProductScaf_translatedSections_matrix_product

/-- A constant translated projection is the linear projection with the product matrix. -/
theorem IntersectionProductScaf_translatedProjection_matrix_product
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] {n : ℕ}
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (Z : Over (Spec ↧ℂ)) (q : Z.left ⟶ X.left) (hq : q ≫ X.hom = Z.hom)
    (M : Matrix (Fin (n + 1)) (Fin (n + 1)) ℂ) (hM : IsUnit M.det)
    (hfin' : ((Ideal.Quotient.mk (a3s_IX X)).comp (a3r_lin (M * a3r_mat a)).toRingHom).Finite) :
    (IntersectionProductScaf_translatedProjection X hfin Z q
      ((IntersectionProductScaf_complexScalars Z).mapMatrix M)
      (by rw [← RingHom.map_det]; exact hM.map _)).left =
      q ≫ (a3h_πO X (ℓ := M * a3r_mat a) hfin').left := by
  have h0 : IntersectionProductScaf_translatedProjection₀ X hfin Z q
      ((IntersectionProductScaf_complexScalars Z).mapMatrix M)
      (by rw [← RingHom.map_det]; exact hM.map _) =
      IntersectionProductScaf_translatedProjection₀ X
        (a := fun p => (M * a3r_mat a) p.1 p.2) hfin' Z q 1
          (by rw [Matrix.det_one]; exact isUnit_one) := by
    apply (IntersectionProductScaf_projectionCover X Z q).hom_ext
    intro j
    rw [IntersectionProductScaf_translatedProjection₀_chart,
      IntersectionProductScaf_translatedProjection₀_chart]
    simp only [IntersectionProductScaf_translatedChart]
    simp only [IntersectionProductScaf_translatedSections_matrix_product X a Z q hq M j]
    simp only [IntersectionProductScaf_translatedSections, IntersectionProductScaf_chartMatrix,
      map_one, IntersectionProductScaf_matrixSections_one]
  calc
    _ = (IntersectionProductScaf_translatedProjection X
        (a := fun p => (M * a3r_mat a) p.1 p.2) hfin' Z q 1
          (by rw [Matrix.det_one]; exact isUnit_one)).left := by
      apply pullback.hom_ext
      · change (pullback.lift _ _ _) ≫ pullback.fst _ _ = (pullback.lift _ _ _) ≫ pullback.fst _ _
        rw [pullback.lift_fst, pullback.lift_fst]
      · change (pullback.lift _ _ _) ≫ pullback.snd _ _ = (pullback.lift _ _ _) ≫ pullback.snd _ _
        rw [pullback.lift_snd, pullback.lift_snd]
        exact h0
    _ = _ := IntersectionProductScaf_translatedProjection_one X
      (a := fun p => (M * a3r_mat a) p.1 p.2) hfin' Z q hq
#print axioms IntersectionProductScaf_translatedProjection_matrix_product

/-- The endpoint-one line map is the finite projection with the translated matrix. -/
theorem IntersectionProductScaf_lineFibreMap_one_projection
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] {n : ℕ}
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (M : Fin (n + 1) × Fin (n + 1) → ℂ) (hM : IsUnit (a3r_mat M).det)
    (hfin' : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat M * a3r_mat a)).toRingHom).Finite) :
    (IntersectionProductScaf_lineFibreMap X hfin M 1 (by
      rw [IntersectionProductScaf_lineDet_one]; convert hM using 1 <;> congr 1)).left =
      (a3h_πO X (ℓ := a3r_mat M * a3r_mat a) hfin').left := by
  have he := IntersectionProductScaf_lineFibreMap_eq X hfin M 1 (by
    rw [IntersectionProductScaf_lineDet_one]; convert hM using 1 <;> congr 1)
  rw [IntersectionProductScaf_familyMap₀_section] at he
  have hm := IntersectionProductScaf_familySection_matrix_one X M (by
    convert hM using 1 <;> congr 1)
  have hB : IsUnit ((IntersectionProductScaf_complexScalars X).mapMatrix (a3r_mat M)).det := by
    rw [← RingHom.map_det]
    exact hM.map _
  have ht := IntersectionProductScaf_translatedProjection_congr X hfin X (𝟙 X.left)
    _ _ (by rw [hm]; exact hB) hB hm
  erw [he, ht]
  simpa only [Category.id_comp] using
    IntersectionProductScaf_translatedProjection_matrix_product X a hfin X (𝟙 X.left)
      (Category.id_comp _) (a3r_mat M) hM hfin'
#print axioms IntersectionProductScaf_lineFibreMap_one_projection

end ConstantProjectionComparison

section RelativeProjectionCharts
open CategoryTheory.Limits MvPolynomial HomogeneousLocalization TensorProduct
attribute [local instance] MvPolynomial.gradedAlgebra
attribute [local instance] Ring.toIntAlgebra AddCommGroup.toIntModule
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

/-- Tensor extension of a ring map preserves constant-coefficient dehomogenizations. -/
theorem IntersectionProductScaf_tensorChart_constant
    {Y : Scheme.{0}} {σ : Type} (C : a3m_SpecCharts Y σ ℂ) (j : σ)
    (S : Type) [CommRing S] (f : C.T j →+* S) (F : MvPolynomial σ ℂ) :
    Algebra.TensorProduct.map f.toIntAlgHom (AlgHom.id ℤ a3m_Away1)
      (a3m_Tθ C j (MvPolynomial.map Polynomial.C F)) =
        (f (C.θ j F)) ⊗ₜ[ℤ] (1 : a3m_Away1) := by
  rw [a3m_Tθ_map_C]
  rfl
#print axioms IntersectionProductScaf_tensorChart_constant

/-- The homogeneous cone prime over the affine parameter chart of complex projective space.
Source: Hartshorne, *Algebraic Geometry*, II, Proposition 2.5. -/
def IntersectionProductScaf_projectiveLinePrime (n : ℕ)
    (y : (a3n_T (a3h_PnO n)).left) (hy : y ∈ a3h_U (a3h_PnO n)) :
    Ideal (MvPolynomial (Fin (n + 1) ⊕ Unit) ℂ) :=
  ((a3m_lineCharts (a3m_projCharts n) (a3m_Pn_hov n)).prime (a3h_pt (a3h_PnO n) y hy)).comap
    ((a3m_eq (Fin (n + 1))).toRingHom.comp (a3h_eqT (Fin (n + 1))).toRingHom)
#print axioms IntersectionProductScaf_projectiveLinePrime

/-- Projection dehomogenization over the parameter ring has the same homogeneous scaling factor. -/
theorem IntersectionProductScaf_relative_projection_chart
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] {n : ℕ}
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (j : Fin (a3s_N X + 1)) (i : Fin (n + 1))
    (F : MvPolynomial (Fin (n + 1)) (Polynomial ℂ)) (d : ℕ) (hF : F.IsHomogeneous d) :
    let A := Localization.Away (a3h_s X (a3r_mat a) j i)
    let f := algebraMap ((a3s_CX X).T j) A
    let g := a3h_ψ X (a3r_mat a) j i
    Algebra.TensorProduct.map f.toIntAlgHom (AlgHom.id ℤ a3m_Away1)
      (a3m_Tθ (a3s_CX X) j (IntersectionProductScaf_relativeLinear a F)) =
      (f (a3h_s X (a3r_mat a) j i) ⊗ₜ[ℤ] (1 : a3m_Away1)) ^ d *
        Algebra.TensorProduct.map g.toIntAlgHom (AlgHom.id ℤ a3m_Away1)
          (a3m_Tθ (a3m_projCharts n) i F) := by
  dsimp only
  let f := algebraMap ((a3s_CX X).T j) (Localization.Away (a3h_s X (a3r_mat a) j i))
  let g := a3h_ψ X (a3r_mat a) j i
  let tf := (Algebra.TensorProduct.map f.toIntAlgHom (AlgHom.id ℤ a3m_Away1)).toRingHom
  let tg := (Algebra.TensorProduct.map g.toIntAlgHom (AlgHom.id ℤ a3m_Away1)).toRingHom
  apply a3m_twist
    (tf.comp ((a3m_Tθ (a3s_CX X) j).comp (IntersectionProductScaf_relativeLinear a).toRingHom))
    (tg.comp (a3m_Tθ (a3m_projCharts n) i)) _ ?_ ?_ F d hF
  · intro r
    induction r using Polynomial.induction_on' with
    | add p q hp hq => simp only [map_add, hp, hq]
    | monomial k c =>
      rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_pow, map_mul, map_pow]
      have hc : tf (a3m_Tθ (a3s_CX X) j
          (IntersectionProductScaf_relativeLinear a (MvPolynomial.C (Polynomial.C c)))) =
          tg (a3m_Tθ (a3m_projCharts n) i (MvPolynomial.C (Polynomial.C c))) := by
        have h := a3h_ψ_θ X (ℓ := a3r_mat a) j i (MvPolynomial.C c) 0 (isHomogeneous_C _ c)
        simp only [pow_zero, one_mul, a3r_lin_C] at h
        simpa [tf, tg, f, g, a3m_projCharts, IntersectionProductScaf_relativeLinear, a3m_Tθ,
          Algebra.TensorProduct.map_tmul] using congrArg
            (fun x => x ⊗ₜ[ℤ] (1 : a3m_Away1)) h
      have ht : tf (a3m_Tθ (a3s_CX X) j
          (IntersectionProductScaf_relativeLinear a (MvPolynomial.C Polynomial.X))) =
          tg (a3m_Tθ (a3m_projCharts n) i (MvPolynomial.C Polynomial.X)) := by
        simp [tf, tg, f, g, IntersectionProductScaf_relativeLinear, a3m_Tθ,
          Algebra.TensorProduct.map_tmul]
      simp only [map_mul, map_pow]
      exact congrArg₂ (· * ·) hc (congrArg (· ^ k) ht)
  · intro k
    have h := a3h_ψ_θ X (ℓ := a3r_mat a) j i (MvPolynomial.X k) 1
      (isHomogeneous_X ℂ k)
    simp only [pow_one] at h
    have hh := congrArg (fun x => x ⊗ₜ[ℤ] (1 : a3m_Away1)) h
    change tf (a3m_Tθ (a3s_CX X) j (IntersectionProductScaf_relativeLinear a (MvPolynomial.X k))) = _
    rw [show (MvPolynomial.X k : MvPolynomial (Fin (n+1)) (Polynomial ℂ)) =
      MvPolynomial.map Polynomial.C (MvPolynomial.X k) from (MvPolynomial.map_X _ _).symm,
      IntersectionProductScaf_relativeLinear_map_C]
    simp only [tf, tg, RingHom.comp_apply]
    rw [a3m_Tθ_map_C]
    simp only [Algebra.TensorProduct.includeLeftRingHom_apply, AlgHom.toRingHom_eq_coe,
      RingHom.coe_coe, Algebra.TensorProduct.map_tmul, RingHom.toIntAlgHom_apply,
      AlgHom.id_apply]
    change _ = _ * Algebra.TensorProduct.map g.toIntAlgHom (AlgHom.id ℤ a3m_Away1)
      (a3m_Tθ (a3m_projCharts n) i (MvPolynomial.map Polynomial.C (MvPolynomial.X k)))
    rw [a3m_Tθ_map_C]
    simp only [Algebra.TensorProduct.includeLeftRingHom_apply,
      Algebra.TensorProduct.map_tmul, RingHom.toIntAlgHom_apply, AlgHom.id_apply]
    simpa only [f, g, a3m_projCharts, Algebra.TensorProduct.tmul_mul_tmul, one_mul] using hh
#print axioms IntersectionProductScaf_relative_projection_chart

/-- The projective line-family cone ideal is prime. -/
theorem IntersectionProductScaf_projectiveLinePrime_isPrime (n : ℕ)
    (y : (a3n_T (a3h_PnO n)).left) (hy : y ∈ a3h_U (a3h_PnO n)) :
    (IntersectionProductScaf_projectiveLinePrime n y hy).IsPrime :=
  Ideal.comap_isPrime _ _
#print axioms IntersectionProductScaf_projectiveLinePrime_isPrime

/-- A finite product projection preserves the affine original-parameter chart. -/
theorem IntersectionProductScaf_product_projection_mem_U
    {X Y : Over (Spec ↧ℂ)} (g : X ⟶ Y) (y : (a3n_T X).left) (hy : y ∈ a3h_U X) :
    (a3h_G g).left y ∈ a3h_U Y := by
  rw [a3h_mem_U_iff', a3h_G_h_apply]
  exact (a3h_mem_U_iff' X y).mp hy
#print axioms IntersectionProductScaf_product_projection_mem_U

/-- Specialization preserves membership in the projective line-family cone prime. -/
theorem IntersectionProductScaf_projectiveLinePrime_mono (n : ℕ)
    (y z : (a3n_T (a3h_PnO n)).left)
    (hy : y ∈ a3h_U (a3h_PnO n)) (hz : z ∈ a3h_U (a3h_PnO n))
    (h : y ⤳ z) :
    IntersectionProductScaf_projectiveLinePrime n y hy ≤
      IntersectionProductScaf_projectiveLinePrime n z hz := by
  apply Ideal.comap_mono
  apply (a3m_lineCharts (a3m_projCharts n) (a3m_Pn_hov n)).prime_mono
  apply Topology.IsInducing.subtypeVal.specializes_iff.mp
  exact h.map (a3h_e (a3h_PnO n)).hom.continuous
#print axioms IntersectionProductScaf_projectiveLinePrime_mono

/-- Block projection commutes with composing a translation matrix on the target. -/
theorem IntersectionProductScaf_block_matrix_product
    {ρ σ : Type} [Fintype ρ] [Fintype σ]
    (a : ρ × σ → ℂ) (M : ρ × ρ → ℂ) :
    a3h_block (fun p => (a3r_mat M * a3r_mat a) p.1 p.2) =
      a3h_block M * a3h_block a := by
  simp [a3h_block, Matrix.fromBlocks_multiply, a3r_mat]
  rfl
#print axioms IntersectionProductScaf_block_matrix_product

/-- Applying a relative translation before projection gives the product projection matrix. -/
theorem IntersectionProductScaf_block_translate_projection
    {ρ σ : Type} [Fintype ρ] [Fintype σ]
    (a : ρ × σ → ℂ) (M : ρ × ρ → ℂ) (F : MvPolynomial (ρ ⊕ Unit) ℂ) :
    a3r_lin (a3h_block a) (a3h_substT M F) =
      a3r_lin (a3h_block (fun p => (a3r_mat M * a3r_mat a) p.1 p.2)) F := by
  rw [IntersectionProductScaf_substT_block, IntersectionProductScaf_block_matrix_product, a3r_lin_mul]
  rfl
#print axioms IntersectionProductScaf_block_translate_projection

/-- The endpoint-one square map is the product extension of the translated finite projection. -/
theorem IntersectionProductScaf_squareFibreMap_one_projection
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] {n : ℕ}
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (M : Fin (n + 1) × Fin (n + 1) → ℂ) (hM : IsUnit (a3r_mat M).det)
    (hfin' : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat M * a3r_mat a)).toRingHom).Finite) :
    (IntersectionProductScaf_squareFibreMap X hfin M 1 (by
      rw [IntersectionProductScaf_lineDet_one]; convert hM using 1 <;> congr 1)).left =
      (a3h_G (a3h_πO X (ℓ := a3r_mat M * a3r_mat a) hfin')).left := by
  rw [IntersectionProductScaf_squareFibreMap_product]
  have he : IntersectionProductScaf_lineFibreMap X hfin M 1 (by
      rw [IntersectionProductScaf_lineDet_one]; convert hM using 1 <;> congr 1) =
      a3h_πO X (ℓ := a3r_mat M * a3r_mat a) hfin' := by
    apply Over.OverMorphism.ext
    exact IntersectionProductScaf_lineFibreMap_one_projection X a hfin M hM hfin'
  exact congrArg (fun g => (a3h_G g).left) he
