/-- The original-parameter fibre cycle, weighted by the input projection degree.
Source: Fulton, *Intersection Theory*, second edition, §§1.5–1.6 (fundamental cycles and degree). -/
def IntersectionProductScaf_originalFibreCycle
    (M : Fin (n + 1) × Fin (n + 1) → ℂ)
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite) (y : (a3n_T X).left) (c : ℂ) :
    AlgebraicCycle (a3n_T X).left ℚ :=
  a3m_smul (a1p_degree (a3h_G (a3h_πO X hfin)).left y : ℚ)
    (a2g_fundCycle (((IntersectionProductScaf_squarePrimeIdeal M a hfin y).comap
      (a3k_ι X c)).subschemeι))

/-- The translation-parameter fibre cycle, weighted by the input projection degree.
Source: Fulton, *Intersection Theory*, second edition, §§1.5–1.6 (fundamental cycles and degree). -/
def IntersectionProductScaf_translationFibreCycle
    (M : Fin (n + 1) × Fin (n + 1) → ℂ)
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite) (y : (a3n_T X).left) (c : ℂ) :
    AlgebraicCycle (a3n_T X).left ℚ :=
  a3m_smul (a1p_degree (a3h_G (a3h_πO X hfin)).left y : ℚ)
    (a2g_fundCycle (((IntersectionProductScaf_squarePrimeIdeal M a hfin y).comap
      (a3n_σ (a3n_T X) c)).subschemeι))

