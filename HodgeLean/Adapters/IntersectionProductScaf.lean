/-- An element outside a prime ideal acts regularly on the corresponding prime quotient. -/
theorem IntersectionProductScaf_primeQuotient_regular
    {A : Type u} [CommRing A] (P : Ideal A) [P.IsPrime] (r : A) (hr : r ∉ P) :
    IsSMulRegular (A ⧸ P) r := by
  intro x y hxy
  have hrp : Ideal.Quotient.mk P r ≠ 0 := by
    simpa only [ne_eq, Ideal.Quotient.eq_zero_iff_mem] using hr
  change Ideal.Quotient.mk P r * x = Ideal.Quotient.mk P r * y at hxy
  exact mul_left_cancel₀ hrp hxy

/-- A regular element on an ideal quotient is excluded from every minimal prime over the
ideal. -/
theorem IntersectionProductScaf_regular_not_mem_minimal
    {A : Type u} [CommRing A] (I : Ideal A) (r : A)
    (hr : IsSMulRegular (A ⧸ I) r) (Q : Ideal A) (hQ : Q ∈ I.minimalPrimes) :
    r ∉ Q := by
  apply hr.notMem_of_mem_minimalPrimes
  rwa [I.annihilator_quotient]

/-- Multiplicative regularity in an ideal quotient may be read using scalars from the
original ring. -/
theorem IntersectionProductScaf_regular_quotient_restrictScalars
    {A : Type u} [CommRing A] (I : Ideal A) (r : A)
    (hr : IsSMulRegular (A ⧸ I) (Ideal.Quotient.mk I r)) :
    IsSMulRegular (A ⧸ I) r := by
  intro x y hxy
  apply hr
  simpa [Algebra.smul_def] using hxy

#print axioms IntersectionProductScaf_primeQuotient_regular
#print axioms IntersectionProductScaf_regular_not_mem_minimal
#print axioms IntersectionProductScaf_regular_quotient_restrictScalars

