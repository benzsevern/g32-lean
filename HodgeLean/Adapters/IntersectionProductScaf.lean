/-- The component expansion of a regular section can be placed in an ambient scheme. -/
theorem IntersectionProductScaf_regular_section_ambient_cycle
    {Y Z : Scheme.{0}} [IsNoetherian Y] (i : Y ⟶ Z) [IsClosedImmersion i]
    (K : Z.IdealSheafData)
    (hreg : ∀ x ∈ genericPoints (K.comap i).subscheme,
      ∃ r : Y.presheaf.stalk ((K.comap i).subschemeι x),
        IsSMulRegular (Y.presheaf.stalk ((K.comap i).subschemeι x)) r ∧
        RingHom.ker ((K.comap i).subschemeι.stalkMap x).hom = Ideal.span {r})
    (hcomponent : ∀ z ∈ genericPoints Y,
      ∀ u ∈ genericPoints ((ccm3_primeIdeal Y z).comap (K.comap i).subschemeι).subscheme,
        ((ccm3_primeIdeal Y z).comap (K.comap i).subschemeι).subschemeι u ∈
          genericPoints (K.comap i).subscheme)
    (hY : (genericPoints Y).Finite) :
    a2g_fundCycle ((K.comap i).subschemeι ≫ i) =
      ∑ z ∈ hY.toFinset, a3m_smul (a2g_fundCycle (𝟙 Y) z)
        (a2g_fundCycle (ccm3_primeIdeal Z (i z) ⊔ K).subschemeι) := by
  let J := K.comap i
  have : IsLocallyNoetherian J.subscheme := LocallyOfFiniteType.isLocallyNoetherian J.subschemeι
  have := a2g_subscheme_noetherianSpace J
  have : IsNoetherian J.subscheme := ⟨⟩
  have he := congrArg (a1p_pushforward (J.subschemeι ≫ i))
    (IntersectionProductScaf_regular_section_component_cycle Y J hreg hcomponent hY)
  rw [a2g_pushforward_fundCycle, Category.id_comp, a3k_pushforward_sum] at he
  · rw [he]
    apply Finset.sum_congr rfl
    intro z hz
    rw [a3k_pushforward_smul]
    have := a2g_subscheme_noetherianSpace ((ccm3_primeIdeal Y z).comap J.subschemeι)
    rw [a2g_pushforward_fundCycle]
    · congr 1
      rw [← a2g_fundCycle_map, Scheme.IdealSheafData.map_comp,
        ← a2g_ker_sup_eq_map_comap, J.ker_subschemeι, sup_comm,
        IntersectionProductScaf_map_intersection, a2g_map_primeIdeal]
    · intro u hu
      exact IntersectionProductScaf_closed_degree _ _
  · intro x hx
    exact IntersectionProductScaf_closed_degree _ _
#print axioms IntersectionProductScaf_regular_section_ambient_cycle

/-- The support of an embedded fundamental cycle consists exactly of its component images. -/
theorem IntersectionProductScaf_fundCycle_support
    {Y Z : Scheme} [IsLocallyNoetherian Y] (i : Y ⟶ Z) (hi : Function.Injective i)
    (hY : (genericPoints Y).Finite) :
    Function.support (a2g_fundCycle i) = i '' genericPoints Y := by
  ext w
  constructor
  · intro hw
    have hr : w ∈ Set.range i := by
      by_contra hn
      exact hw (IntersectionProductScaf_fundCycle_apply_of_not_mem_range i hY w hn)
    obtain ⟨y, rfl⟩ := hr
    refine ⟨y, ?_, rfl⟩
    by_contra hy
    exact hw ((IntersectionProductScaf_fundCycle_apply_embedded i hi hY y).trans
      (ite_eq_right hy))
  · rintro ⟨y, hy, rfl⟩
    exact IntersectionProductScaf_fundCycle_generic_ne_zero i hi hY y hy
#print axioms IntersectionProductScaf_fundCycle_support

/-- A component sum can be indexed by the support of its embedded fundamental cycle. -/
theorem IntersectionProductScaf_fundCycle_component_sum
    {Y Z Q : Scheme.{0}} [IsNoetherian Y] [IsNoetherian Z]
    (i : Y ⟶ Z) (hi : Function.Injective i) (hY : (genericPoints Y).Finite)
    (F : Z → AlgebraicCycle Q ℚ) :
    ∑ z ∈ hY.toFinset, a3m_smul (a2g_fundCycle (𝟙 Y) z) (F (i z)) =
      ∑ w ∈ (a3m_support_finite (a2g_fundCycle i)).toFinset,
        a3m_smul (a2g_fundCycle i w) (F w) := by
  have hs := IntersectionProductScaf_fundCycle_support i hi hY
  have hc (z : Y) : a2g_fundCycle i (i z) = a2g_fundCycle (𝟙 Y) z := by
    have h := IntersectionProductScaf_fundCycle_comp_injective_apply (𝟙 Y) i hi hY z
    simpa only [Category.id_comp] using h
  apply Finset.sum_bij (fun z _ => i z)
  · intro z hz
    apply (a3m_support_finite (a2g_fundCycle i)).mem_toFinset.mpr
    rw [hs]
    exact ⟨z, hY.mem_toFinset.mp hz, rfl⟩
  · intro z hz w hw he
    exact hi he
  · intro w hw
    have h := (a3m_support_finite (a2g_fundCycle i)).mem_toFinset.mp hw
    rw [hs] at h
    obtain ⟨z, hz, rfl⟩ := h
    exact ⟨z, hY.mem_toFinset.mpr hz, rfl⟩
  · intro z hz
    rw [hc]
#print axioms IntersectionProductScaf_fundCycle_component_sum

/-- An ambient intersection coefficient is its inverse-image coefficient on the section. -/
theorem IntersectionProductScaf_section_intersection_apply
    {F Z : Scheme} [IsNoetherian F] (j : F ⟶ Z) [IsClosedImmersion j]
    (I : Z.IdealSheafData) (x : F) :
    a2g_fundCycle (I ⊔ j.ker).subschemeι (j x) =
      a2g_fundCycle (I.comap j).subschemeι x := by
  have := a2g_subscheme_noetherianSpace (I.comap j)
  have hV : (genericPoints (I.comap j).subscheme).Finite :=
    genericPoints.finite TopologicalSpace.NoetherianSpace.finite_irreducibleComponents
  rw [sup_comm, a2g_ker_sup_eq_map_comap, a2g_fundCycle_map]
  exact IntersectionProductScaf_fundCycle_comp_injective_apply _ j j.isEmbedding.injective hV x
#print axioms IntersectionProductScaf_section_intersection_apply

