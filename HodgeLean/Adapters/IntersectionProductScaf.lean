#print axioms IntersectionProductScaf_theta₁_single_mem_U
/-- Restriction of the family morphism to any invertible parameter is translation by its
restricted homogeneous matrix. -/
theorem IntersectionProductScaf_familyMap₀_section (c : ℂ)
    (hc : IsUnit ((IntersectionProductScaf_lineDet M).eval c)) :
    IntersectionProductScaf_familySection X M c hc ≫
      (IntersectionProductScaf_familyMap₀ X hfin M).left =
        (IntersectionProductScaf_translatedProjection X hfin X (𝟙 X.left)
          ((IntersectionProductScaf_familySection X M c hc).appTop.hom.mapMatrix
            (IntersectionProductScaf_familyMatrix X M)) (by
              rw [← RingHom.map_det]
              exact (IntersectionProductScaf_familyMatrix_det X M).map _)).left := by
  let e := IntersectionProductScaf_familySection X M c hc
  have hb : e ≫ (IntersectionProductScaf_familyBase X M).left = 𝟙 X.left :=
    pullback.lift_fst _ _ _
  apply pullback.hom_ext
  · change (e ≫ pullback.lift _ _ _) ≫ pullback.fst _ _ =
      (pullback.lift _ _ _) ≫ pullback.fst _ _
    rw [Category.assoc, pullback.lift_fst, pullback.lift_fst]
    change e ≫ (IntersectionProductScaf_familyBase X M).left ≫ X.hom = X.hom
    rw [← Category.assoc, hb, Category.id_comp]
  · change (e ≫ pullback.lift _ _ _) ≫ pullback.snd _ _ =
      (pullback.lift _ _ _) ≫ pullback.snd _ _
    rw [Category.assoc, pullback.lift_snd, pullback.lift_snd]
    rw [IntersectionProductScaf_translatedProjection₀_natural X hfin _ X _ e _ _
      (by rw [← RingHom.map_det]; exact (IntersectionProductScaf_familyMatrix_det X M).map _), hb]

#print axioms IntersectionProductScaf_familyMap₀_section

/-- Every invertible fibre of the extended ideal is the inverse image under the evaluated
translation morphism. -/
theorem IntersectionProductScaf_familyIdeal_section (c : ℂ)
    (hc : IsUnit ((IntersectionProductScaf_lineDet M).eval c))
    (I : (a3h_PnO n).left.IdealSheafData) :
    ((I.comap (IntersectionProductScaf_familyMap₀ X hfin M).left).map
      (IntersectionProductScaf_familyInclusion X M).left).comap (a3n_σ X c) =
        I.comap (IntersectionProductScaf_translatedProjection X hfin X (𝟙 X.left)
          ((IntersectionProductScaf_familySection X M c hc).appTop.hom.mapMatrix
            (IntersectionProductScaf_familyMatrix X M)) (by
              rw [← RingHom.map_det]
              exact (IntersectionProductScaf_familyMatrix_det X M).map _)).left := by
  rw [← IntersectionProductScaf_familySection_inclusion X M c hc,
    Scheme.IdealSheafData.comap_comp, IntersectionProductScaf_open_ideal_restrict,
    ← Scheme.IdealSheafData.comap_comp, IntersectionProductScaf_familyMap₀_section]

#print axioms IntersectionProductScaf_familyIdeal_section

/-- The zero section of the actual one-parameter map is the finite projection. -/
theorem IntersectionProductScaf_familyMap₀_zero :
    IntersectionProductScaf_familySection X M 0 (by
      rw [IntersectionProductScaf_lineDet_zero]; exact isUnit_one) ≫
        (IntersectionProductScaf_familyMap₀ X hfin M).left = (a3h_πO X hfin).left := by
  let e := IntersectionProductScaf_familySection X M 0 (by
    rw [IntersectionProductScaf_lineDet_zero]; exact isUnit_one)
  have hm : e.appTop.hom.mapMatrix (IntersectionProductScaf_familyMatrix X M) = 1 := by
    convert IntersectionProductScaf_familySection_matrix_zero X M using 1 <;>
      (ext i j; first | rfl | (by_cases hij : i = j <;> simp only [Matrix.one_apply, hij, ite_true, ite_false]))
  have hb : e ≫ (IntersectionProductScaf_familyBase X M).left = 𝟙 X.left :=
    pullback.lift_fst _ _ _
  apply pullback.hom_ext
  · change (e ≫ pullback.lift _ _ _) ≫ pullback.fst _ _ = _
    rw [Category.assoc, pullback.lift_fst]
    change e ≫ (pullback.fst X.hom (IntersectionProductScaf_parameterOver M).hom ≫ X.hom) = _
    rw [← Category.assoc]
    change (e ≫ (IntersectionProductScaf_familyBase X M).left) ≫ X.hom = _
    rw [hb, Category.id_comp]
    exact (a3h_π_fst X hfin).symm
  · change (e ≫ pullback.lift _ _ _) ≫ pullback.snd _ _ = _
    rw [Category.assoc, pullback.lift_snd]
    have hi : IsUnit (e.appTop.hom.mapMatrix (IntersectionProductScaf_familyMatrix X M)).det := by
      rw [hm, Matrix.det_one]
      exact isUnit_one
    rw [IntersectionProductScaf_translatedProjection₀_natural X hfin _ X _ e _ _ hi]
    simp only [hm, hb, IntersectionProductScaf_translatedProjection₀_one, Category.id_comp]
    exact (a3h_π_snd X hfin).symm

#print axioms IntersectionProductScaf_familyMap₀_zero

/-- The extended inverse-image ideal has the finite-projection inverse image as its zero fibre. -/
theorem IntersectionProductScaf_familyIdeal_zero
    (I : (a3h_PnO n).left.IdealSheafData) :
    ((I.comap (IntersectionProductScaf_familyMap₀ X hfin M).left).map
      (IntersectionProductScaf_familyInclusion X M).left).comap (a3n_σ X 0) =
        I.comap (a3h_πO X hfin).left := by
  rw [← IntersectionProductScaf_familySection_inclusion X M 0 (by
    rw [IntersectionProductScaf_lineDet_zero]; exact isUnit_one),
    Scheme.IdealSheafData.comap_comp, IntersectionProductScaf_open_ideal_restrict,
    ← Scheme.IdealSheafData.comap_comp, IntersectionProductScaf_familyMap₀_zero]

#print axioms IntersectionProductScaf_familyIdeal_zero

/-- The fundamental cycle of the zero fibre of the extended prime family is the finite
projection's prime inverse-image cycle, including its generic-length coefficients. -/
theorem IntersectionProductScaf_family_zero_fundCycle (z : (a3h_PnO n).left) :
    a2g_fundCycle (((ccm3_inverseIdeal (IntersectionProductScaf_familyMap₀ X hfin M).left z).map
      (IntersectionProductScaf_familyInclusion X M).left).comap (a3n_σ X 0)).subschemeι =
        ccm3_flatPullbackPrime (a3h_π X hfin) z := by
  change a2g_fundCycle ((((ccm3_primeIdeal _ z).comap
    (IntersectionProductScaf_familyMap₀ X hfin M).left).map
      (IntersectionProductScaf_familyInclusion X M).left).comap (a3n_σ X 0)).subschemeι = _
  rw [IntersectionProductScaf_familyIdeal_zero]
  rfl

