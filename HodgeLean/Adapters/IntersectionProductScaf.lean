/-- A component below the expected codimension has zero Serre multiplicity. -/
theorem IntersectionProductScaf_serreMult_eq_zero_of_coheight_lt
    (Y : Over (Spec ↧ℂ)) [IsIntegral Y.left] [Smooth Y.hom]
    (u v z : Y.left) (hz : z ∈ a3y_comps u v)
    (hlt : coheight z < coheight u + coheight v) :
    a3i_serreMult Y.left z u v = 0 := by
  obtain ⟨huz, hvz, hmin⟩ := a3y_comps_spec u v hz
  obtain ⟨cu, cz, du, hcu, hcz, hdu, heu⟩ := a3y_dims Y huz
  obtain ⟨cv, cz', dv, hcv, hcz', hdv, hev⟩ := a3y_dims Y hvz
  have hzz : cz' = cz := by exact_mod_cast hcz'.symm.trans hcz
  subst cz'
  have hlt' : cz < cu + cv := by
    rw [hcz, hcu, hcv] at hlt
    exact_mod_cast hlt
  have hdim : ringKrullDim (Y.left.presheaf.stalk z) = cz := by
    rw [ringKrullDim_stalk_eq_coheight, hcz]
    rfl
  have hspec (P : PrimeSpectrum (Y.left.presheaf.stalk z))
      (w : Y.left) (hw : w ⤳ z) (hle : a3i_stalkIdeal Y.left z w ≤ P.asIdeal) :
      w ⤳ Y.left.fromSpecStalk z P := by
    have hsp : a3y_pt z w hw ⤳ P := by
      rw [← PrimeSpectrum.le_iff_specializes]
      exact hle
    have h := hsp.map (Y.left.fromSpecStalk z).continuous
    rwa [a3y_fromSpecStalk_pt] at h
  have hzero := a3w_vanishing_stalk Y z
    (Y.left.presheaf.stalk z ⧸ a3i_stalkIdeal Y.left z u)
    (Y.left.presheaf.stalk z ⧸ a3i_stalkIdeal Y.left z v)
    (by
      intro P hP Q hQ R hPR hQR
      rw [Module.mem_support_iff_of_finite, Ideal.annihilator_quotient] at hP hQ
      have he := hmin (Y.left.fromSpecStalk z R)
        (hspec R u huz (hP.trans hPR)) (hspec R v hvz (hQ.trans hQR))
        (a3y_specializes_fromSpecStalk z R)
      apply (Y.left.fromSpecStalk z).isEmbedding.injective
      simpa only [Scheme.fromSpecStalk_closedPoint] using he)
    (by
      intro P hP Q hQ
      rw [Module.mem_support_iff_of_finite, Ideal.annihilator_quotient] at hP hQ
      have hp := ringKrullDim_le_of_surjective (Ideal.Quotient.factor hP)
        (Ideal.Quotient.factor_surjective hP)
      have hq := ringKrullDim_le_of_surjective (Ideal.Quotient.factor hQ)
        (Ideal.Quotient.factor_surjective hQ)
      rw [hdu] at hp
      rw [hdv] at hq
      rw [hdim]
      exact lt_of_le_of_lt (add_le_add hp hq) (by exact_mod_cast (by omega : du + dv < cz)))
    cz (by rw [hdim])
  simpa only [a3i_serreMult, a3i_torModule, a3s_chi, hcz, ENat.toNat_natCast] using hzero

#print axioms IntersectionProductScaf_serreMult_eq_zero_of_coheight_lt

/-- A component of a vertical prime's intersection with an original endpoint face is
that prime itself. -/
theorem IntersectionProductScaf_comps_E_vertical
    (w : (a3n_T (a3n_T X)).left)
    (hw : a3n_h X ((a3n_q (a3n_T X)).left w) ≠ genericPoint (g3c_P 1))
    (c : ℂ) (hc : c = 0 ∨ c = 1)
    (z : (a3n_T (a3n_T X)).left) (hz : z ∈ a3y_comps w (a3k_E X c)) : z = w := by
  obtain ⟨hwz, hEz, hmin⟩ := a3y_comps_spec _ _ hz
  have hp := (hwz.map (a3n_q (a3n_T X)).left.continuous).map (a3n_p X).continuous
  have he : a3n_p X ((a3n_q (a3n_T X)).left w) =
      a3n_p X ((a3n_q (a3n_T X)).left z) := by
    by_contra hne
    apply hw
    change a3n_π (a3n_p X ((a3n_q (a3n_T X)).left w)) = _
    rw [a3k_P1_eq_generic hp hne, a3k_π_generic]
  have heh := congrArg a3n_π he
  change a3n_h X ((a3n_q (a3n_T X)).left w) =
    a3n_h X ((a3n_q (a3n_T X)).left z) at heh
  rw [a3n_b_specializes_iff] at hEz
  obtain ⟨x, hx⟩ := a3n_mem_range_σ_of_specializes X c hEz
  have hwr : (a3n_q (a3n_T X)).left w ∈ Set.range (a3n_σ X c) := by
    rcases hc with rfl | rfl
    · refine ⟨_, (a3n_eq_σ0 X _ ?_).symm⟩
      rw [heh, ← hx]
      exact a3n_h_σ0 X x
    · refine ⟨_, (a3n_eq_σ1 X _ ?_).symm⟩
      rw [heh, ← hx]
      exact a3n_h_σ1 X x
  obtain ⟨x', hx'⟩ := hwr
  have hEw : a3k_E X c ⤳ w := by
    rw [a3n_b_specializes_iff, ← hx']
    exact (genericPoint_specializes x').map (a3n_σ X c).continuous
  exact (hmin w (specializes_refl w) hEw hwz).symm

#print axioms IntersectionProductScaf_comps_E_vertical


/-- Intersection with either original endpoint face vanishes for a vertical prime. -/
theorem IntersectionProductScaf_intersectPrime_E_vertical
    (w : (a3n_T (a3n_T X)).left)
    (hw : a3n_h X ((a3n_q (a3n_T X)).left w) ≠ genericPoint (g3c_P 1))
    (c : ℂ) (hc : c = 0 ∨ c = 1) :
    a3i_intersectPrime (a3n_T (a3n_T X)).left w (a3k_E X c) = 0 := by
  ext z
  rw [a3y_intersectPrime_apply]
  split_ifs with hz
  · have he := IntersectionProductScaf_comps_E_vertical w hw c hc z hz
    have hlt : coheight z < coheight w + coheight (a3k_E X c) := by
      rw [he, a3k_coheight_E]
      simpa only [add_comm] using
        ENat.lt_add_left (a3c_coheight_ne_top _ w) (by decide : (0 : ℕ∞) < 1)
    rw [IntersectionProductScaf_serreMult_eq_zero_of_coheight_lt
      (a3n_T (a3n_T X)) w (a3k_E X c) z hz hlt, Int.cast_zero]
    rfl
  · rfl

#print axioms IntersectionProductScaf_intersectPrime_E_vertical

/-- A square cycle with no member dominating the original parameter has zero original face. -/
theorem IntersectionProductScaf_dt_vertical
    (W : AlgebraicCycle (a3n_T (a3n_T X)).left ℚ)
    (hW : ∀ w, W w ≠ 0 →
      a3n_h X ((a3n_q (a3n_T X)).left w) ≠ genericPoint (g3c_P 1)) :
    a3k_dt X W = 0 := by
  have hi (c : ℂ) (hc : c = 0 ∨ c = 1) :
      a3i_intersect (a3n_T (a3n_T X)).left W
        (Function.locallyFinsuppWithin.single (a3k_E X c) 1) = 0 := by
    let s := (a3m_support_finite W).toFinset
    rw [a3k_intersect_single_eq_sum _ W _ s (fun w hw => by simpa [s] using hw)]
    apply Finset.sum_eq_zero
    intro w hw
    have hw' : W w ≠ 0 := by simpa [s] using hw
    rw [IntersectionProductScaf_intersectPrime_E_vertical w (hW w hw') c hc]
    ext z
    exact mul_zero _
  rw [a3k_dt, hi 0 (Or.inl rfl), hi 1 (Or.inr rfl)]
  have hz : a3m_smul (a3k_cycT X (a3n_σ X 0 (genericPoint X.left)))
      (0 : AlgebraicCycle (a3n_T (a3n_T X)).left ℚ) +
      a3m_smul (a3k_cycT X (a3n_σ X 1 (genericPoint X.left))) 0 = 0 := by
    ext z
    simp only [Function.locallyFinsuppWithin.coe_add, Pi.add_apply, a3m_smul_apply,
      Function.locallyFinsuppWithin.coe_zero, Pi.zero_apply, mul_zero, add_zero]
  rw [hz, a3k_pushforward_zero]

