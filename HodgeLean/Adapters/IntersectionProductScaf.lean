/-- The chart coordinate germ agrees with the germ pulled back from the integral projective line. -/
theorem IntersectionProductScaf_complex_parameter_coordinate_germ
    (y : a3m_Pn 1)
    (hy : y ∈ (a3m_Pnκ 1 0) ''ᵁ (⊤ : (Spec (a3m_PnT 1 0)).Opens))
    (h0 : a3n_π y ∈ Proj.basicOpen (UniversalGrading.{0} 1) (MvPolynomial.X 0)) :
    (a3m_Pn 1).presheaf.germ _ y hy
      (((a3m_Pnκ 1 0).appIso ⊤).inv
        ((Scheme.ΓSpecIso (a3m_PnT 1 0)).inv (a3n_chartEquiv 0 Polynomial.X))) =
    a3n_π.stalkMap y ((g3c_P 1).presheaf.germ _ (a3n_π y) h0 a3k_S1) := by
  obtain ⟨z, hz, rfl⟩ := hy
  apply (ConcreteCategory.bijective_of_isIso ((a3m_Pnκ 1 0).stalkMap z)).1
  erw [IntersectionProductScaf_open_chart_germ (a3m_Pnκ 1 0) ⊤ z hz]
  let f := (a3m_Pnκ 1 0) ≫ a3n_π
  let U := Proj.basicOpen (UniversalGrading.{0} 1) (MvPolynomial.X 0)
  have h : (⊤ : (Spec (a3m_PnT 1 0)).Opens) ≤ f ⁻¹ᵁ U := by
    intro q hq
    change a3n_π ((a3m_Pnκ 1 0) q) ∈ U
    rw [a3n_π_κ]
    exact a3k_mem_basicOpen_X0 _ ⟨_, rfl⟩
  have hg : f.appLE U ⊤ h ≫ (Spec (a3m_PnT 1 0)).presheaf.germ ⊤ z hz =
      (g3c_P 1).presheaf.germ U (f z) h0 ≫ f.stalkMap z := by
    rw [Scheme.Hom.appLE, Category.assoc, TopCat.Presheaf.germ_res]
    exact (f.germ_stalkMap U z h0).symm
  have he := congrArg (fun g => g a3k_S1) hg
  simp only [CommRingCat.comp_apply] at he
  rw [IntersectionProductScaf_complex_parameter_chart_coordinate_app] at he
  have hs := congrArg (fun g => g ((g3c_P 1).presheaf.germ _
    (a3n_π ((a3m_Pnκ 1 0) z)) h0 a3k_S1))
    (Scheme.Hom.stalkMap_comp (a3m_Pnκ 1 0) a3n_π z)
  exact he.trans hs
