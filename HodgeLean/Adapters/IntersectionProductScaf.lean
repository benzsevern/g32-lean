/-- The translation fibre is the degree-weighted inverse-image cycle of the evaluated projection. -/
theorem IntersectionProductScaf_translationFibreCycle_eval
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] {n : ℕ}
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (M : Fin (n + 1) × Fin (n + 1) → ℂ) (c : ℂ)
    (hc : IsUnit ((IntersectionProductScaf_lineDet M).eval c)) (y : (a3n_T X).left) :
    IntersectionProductScaf_translationFibreCycle M a hfin y c =
      a3m_smul (a1p_degree (a3h_G (a3h_πO X hfin)).left y : ℚ)
        (ccm3_flatPullbackPrime (IntersectionProductScaf_squareFibreMap X hfin M c hc).left
          ((a3h_G (a3h_πO X hfin)).left y)) := by
  unfold IntersectionProductScaf_translationFibreCycle IntersectionProductScaf_squarePrimeIdeal ccm3_inverseIdeal
  rw [IntersectionProductScaf_squareIdeal_section]
  rfl
#print axioms IntersectionProductScaf_translationFibreCycle_eval

/-- Nonzero coefficients of an invertible translation fibre are exactly the points above the projected input. -/
theorem IntersectionProductScaf_translationFibreCycle_support
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] [Smooth X.hom] {n : ℕ}
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (M : Fin (n + 1) × Fin (n + 1) → ℂ) (c : ℂ)
    (hc : IsUnit ((IntersectionProductScaf_lineDet M).eval c))
    (hn : Order.height (genericPoint X.left) = n) (y y' : (a3n_T X).left) :
    IntersectionProductScaf_translationFibreCycle M a hfin y c y' ≠ 0 ↔
      (IntersectionProductScaf_squareFibreMap X hfin M c hc).left y' =
        (a3h_G (a3h_πO X hfin)).left y := by
  have := IntersectionProductScaf_projectionProduct_finite X hfin
  have := IntersectionProductScaf_squareFibreMap_finite X hfin M c hc
  have hd : 0 < a1p_degree (a3h_G (a3h_πO X hfin)).left y :=
    (a1d_degree_pos_iff _ y).mpr (IntersectionProductScaf_finite_height _ y)
  have hq : (a1p_degree (a3h_G (a3h_πO X hfin)).left y : ℚ) ≠ 0 := by
    exact_mod_cast Nat.ne_of_gt hd
  rw [IntersectionProductScaf_translationFibreCycle_eval X a hfin M c hc y,
    a3m_smul_apply, mul_ne_zero_iff, and_iff_right hq]
  exact IntersectionProductScaf_pullbackPrime_support_iff _
    (IntersectionProductScaf_squareFibreMap_generalizing X hfin M c hc hn) _ _
#print axioms IntersectionProductScaf_translationFibreCycle_support

/-- Every nonzero invertible translation-fibre coefficient has the dimension of its input point. -/
theorem IntersectionProductScaf_translationFibreCycle_height
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] [Smooth X.hom] {n : ℕ}
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
