/-- A section transported through an open chart has the same germ under the chart stalk map. -/
theorem IntersectionProductScaf_open_chart_germ
    {Y Z : Scheme} (j : Y ⟶ Z) [IsOpenImmersion j] (U : Y.Opens)
    (x : Y) (hx : x ∈ U) (s : Γ(Y, U)) :
