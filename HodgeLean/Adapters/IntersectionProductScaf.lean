/-- A component sum supported on generalizations can be indexed by minimal stalk primes. -/
theorem IntersectionProductScaf_component_sum_fromSpecStalk
    (Y : Scheme) [IsNoetherian Y] (x : Y) (f : Y → ℚ)
    (hf : ∀ z, ¬ z ⤳ x → f z = 0) (hY : (genericPoints Y).Finite) :
    ∑ p ∈ (PrimeSpectrum.finite_setOfPred_isMin (Y.presheaf.stalk x)).toFinset,
      f (Y.fromSpecStalk x p) = ∑ z ∈ hY.toFinset, f z := by
  classical
  apply Finset.sum_bij_ne_zero (fun (p : PrimeSpectrum (Y.presheaf.stalk x)) _ _ => Y.fromSpecStalk x p)
  · intro p hp hn
    apply hY.mem_toFinset.mpr
    exact (IntersectionProductScaf_fromSpecStalk_component_iff Y x p).mpr ((PrimeSpectrum.finite_setOfPred_isMin (Y.presheaf.stalk x)).mem_toFinset.mp hp)
  · intro p hp hn q hq hm he
    exact (Y.fromSpecStalk x).isEmbedding.injective he
  · intro z hz hn
    have hzx : z ⤳ x := by
      by_contra h
      exact hn (hf z h)
    let p := a3y_pt x z hzx
    have he : Y.fromSpecStalk x p = z := a3y_fromSpecStalk_pt x z hzx
    have hp : p ∈ (PrimeSpectrum.finite_setOfPred_isMin (Y.presheaf.stalk x)).toFinset := by
      apply (PrimeSpectrum.finite_setOfPred_isMin (Y.presheaf.stalk x)).mem_toFinset.mpr
      exact (IntersectionProductScaf_fromSpecStalk_component_iff Y x p).mp
        (he.symm ▸ hY.mem_toFinset.mp hz)
    exact ⟨p, hp, he.symm ▸ hn, he⟩
  · intro p hp hn
    rfl
#print axioms IntersectionProductScaf_component_sum_fromSpecStalk



