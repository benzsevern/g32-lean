/-- A generator of a parameter-section prime is nonzero in its ambient stalk. -/
theorem IntersectionProductScaf_section_generator_ne_zero
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom]
    (c : ℂ) (x : X.left)
    (r : (a3n_T X).left.presheaf.stalk (a3n_σ X c x))
    (he : a3i_stalkIdeal (a3n_T X).left (a3n_σ X c x)
      (a3n_σ X c (genericPoint X.left)) = Ideal.span {r}) : r ≠ 0 := by
  obtain ⟨s, -, hs, hI⟩ := IntersectionProductScaf_sectionDivisor_equation X c x
  have hn : s ≠ 0 := by
    intro hz
    exact one_ne_zero (hs (show s • (1 : _) = s • 0 by simp [hz]))
  intro hr
  have hm : s ∈ Ideal.span {r} := by
    rw [← he, hI]
    exact Ideal.subset_span (by simp)
  rw [hr, Ideal.span_singleton_zero, Ideal.mem_bot] at hm
  exact hn hm
