section ParameterDomination
open CategoryTheory.Limits
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
/-- Generalization lifting persists after restriction to the inverse image of an ideal subscheme. -/
theorem IntersectionProductScaf_comap_generalizing {U V : Scheme.{0}}
    (f : U ⟶ V) (hf : GeneralizingMap f) (I : V.IdealSheafData) :
    GeneralizingMap ((I.comap f).subschemeMap I f (I.le_map_comap f)) := by
  let g := (I.comap f).subschemeMap I f (I.le_map_comap f)
  have hg (u : (I.comap f).subscheme) :
      I.subschemeι (g u) = f ((I.comap f).subschemeι u) :=
    congrArg (fun m : (I.comap f).subscheme ⟶ V => m u)
      (Scheme.IdealSheafData.subschemeMap_subschemeι _ _ _ _)
  intro u v hv
  have hs := hv.map I.subschemeι.continuous
  rw [hg] at hs
  obtain ⟨w, hw, hfw⟩ := hf hs
  have hwI : w ∈ (I.comap f).support := by
    rw [Scheme.IdealSheafData.support_comap]
    change f w ∈ (I.support : Set V)
    rw [hfw, ← I.range_subschemeι]
    exact ⟨v, rfl⟩
  obtain ⟨w', hw'⟩ := Set.mem_range.mp ((I.comap f).range_subschemeι.symm.subset hwI)
  refine ⟨w', ?_, ?_⟩
  · apply (I.comap f).subschemeι.isClosedEmbedding.isInducing.specializes_iff.mp
    simpa only [hw'] using hw
  · apply I.subschemeι.isClosedEmbedding.injective
    rw [hg, hw', hfw]
#print axioms IntersectionProductScaf_comap_generalizing

/-- A generic component point maps to the generic point of an integral target under generalization lifting. -/
theorem IntersectionProductScaf_generalizing_component_generic {U V : Scheme.{0}}
    [IsIntegral V] (f : U ⟶ V) (hf : GeneralizingMap f) (u : U)
    (hu : closure ({u} : Set U) ∈ irreducibleComponents U) :
    f u = genericPoint V := by
  obtain ⟨u', hu', he⟩ := hf (genericPoint_specializes (f u))
  have h := IntersectionProductScaf_component_generalization u hu u' hu'
  simpa only [h] using he
#print axioms IntersectionProductScaf_generalizing_component_generic

/-- A subscheme pulled back from one factor is flat over the other factor over the complex field. -/
theorem IntersectionProductScaf_product_comap_parameter_flat
    (Y T : Over (Spec ↧ℂ)) (I : Y.left.IdealSheafData) :
    Flat ((I.comap (pullback.fst Y.hom T.hom)).subschemeι ≫ pullback.snd Y.hom T.hom) := by
  let J := I.comap (pullback.fst Y.hom T.hom)
  let g := J.subschemeMap I (pullback.fst Y.hom T.hom) (I.le_map_comap _)
  have hs : IsPullback J.subschemeι g (pullback.fst Y.hom T.hom) I.subschemeι :=
    isPullback_of_isClosedImmersion _ _ _ _
      (Scheme.IdealSheafData.subschemeMap_subschemeι _ _ _ _).symm
      (by simp only [Scheme.IdealSheafData.ker_subschemeι]; rfl)
  have ht := hs.flip.paste_vert (IsPullback.of_hasPullback Y.hom T.hom)
  exact MorphismProperty.of_isPullback ht (inferInstance : Flat (I.subschemeι ≫ Y.hom))
#print axioms IntersectionProductScaf_product_comap_parameter_flat

/-- Generalizing maps to a product retain generalization lifting in the second factor on inverse-image subschemes. -/
theorem IntersectionProductScaf_product_comap_parameter_generalizing
    (Y T : Over (Spec ↧ℂ)) (I : Y.left.IdealSheafData) {U : Scheme.{0}}
    (f : U ⟶ pullback Y.hom T.hom) (hf : GeneralizingMap f) :
    GeneralizingMap (((I.comap (pullback.fst Y.hom T.hom)).comap f).subschemeι ≫
      f ≫ pullback.snd Y.hom T.hom) := by
  let J := I.comap (pullback.fst Y.hom T.hom)
  let g := (J.comap f).subschemeMap J f (J.le_map_comap f)
  have hg : GeneralizingMap g := IntersectionProductScaf_comap_generalizing f hf J
  have : Flat (J.subschemeι ≫ pullback.snd Y.hom T.hom) :=
    IntersectionProductScaf_product_comap_parameter_flat Y T I
  have he : g ≫ (J.subschemeι ≫ pullback.snd Y.hom T.hom) =
      (J.comap f).subschemeι ≫ f ≫ pullback.snd Y.hom T.hom := by
    rw [← Category.assoc, Scheme.IdealSheafData.subschemeMap_subschemeι, Category.assoc]
  rw [← he]
  exact hg.comp (Flat.generalizingMap (J.subschemeι ≫ pullback.snd Y.hom T.hom))
#print axioms IntersectionProductScaf_product_comap_parameter_generalizing

open MonoidalCategory CartesianMonoidalCategory

/-- Forgetting the translation parameter commutes with reordering the two parameters. -/
theorem IntersectionProductScaf_originalProductIso_inv_familyBase
    (Y : Over (Spec ↧ℂ)) {σ : Type} [Fintype σ] (M : σ × σ → ℂ) :
    (IntersectionProductScaf_originalProductIso Y M).inv ≫
      IntersectionProductScaf_familyBase (a3n_T Y) M =
        a3h_G (IntersectionProductScaf_familyBase Y M) := by
  change lift (lift (fst _ _ ≫ fst _ _) (snd _ _)) (fst _ _ ≫ snd _ _) ≫ fst _ _ =
    fst Y (IntersectionProductScaf_parameterOver M) ▷ a3n_P1
  rw [lift_fst]
  apply CartesianMonoidalCategory.hom_ext
  · rw [lift_fst, whiskerRight_fst]
  · rw [lift_snd, whiskerRight_snd]
#print axioms IntersectionProductScaf_originalProductIso_inv_familyBase

/-- The square-family projection retaining the translation parameter. -/
def IntersectionProductScaf_retainedSquareMap
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] {n : ℕ}
    {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (M : Fin (n + 1) × Fin (n + 1) → ℂ) :
    IntersectionProductScaf_familyOpen (a3n_T X) M ⟶
      IntersectionProductScaf_familyOpen (a3n_T (a3h_PnO n)) M :=
  (IntersectionProductScaf_originalProductIso X M).hom ≫
    a3h_G (IntersectionProductScaf_familyProjection X hfin M ≫
      (IntersectionProductScaf_targetFamilyIso M).hom) ≫
    (IntersectionProductScaf_originalProductIso (a3h_PnO n) M).inv

/-- Forgetting the retained parameter recovers the square-family projection. -/
theorem IntersectionProductScaf_retainedSquareMap_base
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] {n : ℕ}
    {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (M : Fin (n + 1) × Fin (n + 1) → ℂ) :
    IntersectionProductScaf_retainedSquareMap X hfin M ≫
      IntersectionProductScaf_familyBase (a3n_T (a3h_PnO n)) M =
        IntersectionProductScaf_familyMap₁ X hfin M := by
  rw [IntersectionProductScaf_retainedSquareMap, Category.assoc, Category.assoc,
    IntersectionProductScaf_originalProductIso_inv_familyBase,
    IntersectionProductScaf_familyMap₁_product, IntersectionProductScaf_familyMap₀_factor]
  change _ ≫ ((_ ▷ a3n_P1) ≫ (_ ▷ a3n_P1)) = _ ≫ ((_ ≫ _ ≫ _) ▷ a3n_P1)
  rw [← comp_whiskerRight, Category.assoc]
  rfl
#print axioms IntersectionProductScaf_retainedSquareMap_base

/-- The square map retaining its translation parameter lifts generalizations. -/
theorem IntersectionProductScaf_retainedSquareMap_generalizing
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] [Smooth X.hom] {n : ℕ}
    {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (M : Fin (n + 1) × Fin (n + 1) → ℂ)
    (hn : Order.height (genericPoint X.left) = n) :
    GeneralizingMap (IntersectionProductScaf_retainedSquareMap X hfin M).left := by
  have : Smooth (a3h_PnO n).hom := IntersectionProductScaf_projective_smooth n
  have := IntersectionProductScaf_projectionTarget_integral X hfin hn
  have := IntersectionProductScaf_familyOpen_integral X M
  have := IntersectionProductScaf_familyOpen_smooth X M
  have := IntersectionProductScaf_familyOpen_integral (a3h_PnO n) M
  have := IntersectionProductScaf_familyOpen_smooth (a3h_PnO n) M
  have := IntersectionProductScaf_familyProjection_finite X hfin M
  have := IntersectionProductScaf_familyProjection_surjective X hfin M hn
  let e := IntersectionProductScaf_targetFamilyIso M
  have : IsFinite (IntersectionProductScaf_familyProjection X hfin M ≫ e.hom).left := by
    change IsFinite ((IntersectionProductScaf_familyProjection X hfin M).left ≫ e.hom.left)
    infer_instance
  have : Surjective (IntersectionProductScaf_familyProjection X hfin M ≫ e.hom).left := by
    change Surjective ((IntersectionProductScaf_familyProjection X hfin M).left ≫ e.hom.left)
    infer_instance
  have hf := IntersectionProductScaf_finite_smooth_product_generalizing
    (IntersectionProductScaf_familyProjection X hfin M ≫ e.hom)
  exact (IntersectionProductScaf_originalProductIso X M).hom.left.isOpenEmbedding.generalizingMap.comp
    (hf.comp (IntersectionProductScaf_originalProductIso (a3h_PnO n) M).inv.left.isOpenEmbedding.generalizingMap)
#print axioms IntersectionProductScaf_retainedSquareMap_generalizing

/-- The square map retains the translation parameter. -/
theorem IntersectionProductScaf_retainedSquareMap_parameter
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] {n : ℕ}
    {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (M : Fin (n + 1) × Fin (n + 1) → ℂ) :
    IntersectionProductScaf_retainedSquareMap X hfin M ≫
      snd (a3n_T (a3h_PnO n)) (IntersectionProductScaf_parameterOver M) =
        snd (a3n_T X) (IntersectionProductScaf_parameterOver M) := by
  simp only [IntersectionProductScaf_retainedSquareMap,
    IntersectionProductScaf_originalProductIso, Category.assoc, lift_snd]
  change _ ≫ ((_ ▷ a3n_P1) ≫ (fst _ _ ≫ snd _ _)) = _
  rw [← Category.assoc (_ ▷ a3n_P1), whiskerRight_fst]
  simp only [Category.assoc, IntersectionProductScaf_targetFamilyIso,
    IntersectionProductScaf_targetFamilyAction, lift_snd,
    IntersectionProductScaf_familyProjection, whiskerRight_snd,
    lift_fst_assoc, lift_snd]
#print axioms IntersectionProductScaf_retainedSquareMap_parameter

/-- Inverse-image subschemes of the square family lift generalizations of the translation parameter. -/
theorem IntersectionProductScaf_familyMap₁_inverse_parameter_generalizing
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] [Smooth X.hom] {n : ℕ}
    {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (M : Fin (n + 1) × Fin (n + 1) → ℂ)
    (hn : Order.height (genericPoint X.left) = n)
    (z : (a3n_T (a3h_PnO n)).left) :
    GeneralizingMap ((ccm3_inverseIdeal (IntersectionProductScaf_familyMap₁ X hfin M).left z).subschemeι ≫
      pullback.snd (a3n_T X).hom (IntersectionProductScaf_parameterOver M).hom ≫
      IntersectionProductScaf_parameterInclusion M) := by
  have he := congrArg Over.Hom.left (IntersectionProductScaf_retainedSquareMap_base X hfin M)
  change (IntersectionProductScaf_retainedSquareMap X hfin M).left ≫
    pullback.fst (a3n_T (a3h_PnO n)).hom (IntersectionProductScaf_parameterOver M).hom = _ at he
  have hp := congrArg Over.Hom.left (IntersectionProductScaf_retainedSquareMap_parameter X hfin M)
  change (IntersectionProductScaf_retainedSquareMap X hfin M).left ≫
    pullback.snd (a3n_T (a3h_PnO n)).hom (IntersectionProductScaf_parameterOver M).hom =
    pullback.snd (a3n_T X).hom (IntersectionProductScaf_parameterOver M).hom at hp
  have h := IntersectionProductScaf_product_comap_parameter_generalizing
    (a3n_T (a3h_PnO n)) (IntersectionProductScaf_parameterOver M)
    (ccm3_primeIdeal (a3n_T (a3h_PnO n)).left z)
    (IntersectionProductScaf_retainedSquareMap X hfin M).left
    (IntersectionProductScaf_retainedSquareMap_generalizing X hfin M hn)
  rw [← Scheme.IdealSheafData.comap_comp, he, hp] at h
  exact h.comp (IntersectionProductScaf_parameterInclusion M).isOpenEmbedding.generalizingMap
#print axioms IntersectionProductScaf_familyMap₁_inverse_parameter_generalizing

/-- Each nonzero prime square-family component dominates the translation parameter. -/
theorem IntersectionProductScaf_theta₁_single_dom_s
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] [Smooth X.hom] {n : ℕ}
    {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (M : Fin (n + 1) × Fin (n + 1) → ℂ)
    (hn : Order.height (genericPoint X.left) = n)
    (z : (a3n_T (a3h_PnO n)).left) (w : (a3n_T (a3n_T X)).left)
    (hw : IntersectionProductScaf_theta₁ X hfin M
      (Function.locallyFinsuppWithin.single z 1) w ≠ 0) :
    a3n_h (a3n_T X) w = genericPoint (g3c_P 1) := by
  obtain ⟨u, huw, hu⟩ := (IntersectionProductScaf_openFamilyCycle_single_support
    (IntersectionProductScaf_familyInclusion (a3n_T X) M)
    (IntersectionProductScaf_familyMap₁ X hfin M) z w).mp hw
  have hgen := IntersectionProductScaf_generalizing_component_generic _
    (IntersectionProductScaf_familyMap₁_inverse_parameter_generalizing X hfin M hn z) u hu
  rw [← huw]
  change a3n_π (a3n_p (a3n_T X) ((IntersectionProductScaf_familyInclusion (a3n_T X) M).left
    ((ccm3_inverseIdeal (IntersectionProductScaf_familyMap₁ X hfin M).left z).subschemeι u))) = _
  have hp : a3n_p (a3n_T X) ((IntersectionProductScaf_familyInclusion (a3n_T X) M).left
      ((ccm3_inverseIdeal (IntersectionProductScaf_familyMap₁ X hfin M).left z).subschemeι u)) =
      genericPoint a3n_P1.left := by
    change ((IntersectionProductScaf_familyInclusion (a3n_T X) M).left ≫ a3n_p (a3n_T X)) _ = _
    rw [IntersectionProductScaf_familyInclusion_parameter]
    exact hgen
  rw [hp]
  exact a3k_π_generic
#print axioms IntersectionProductScaf_theta₁_single_dom_s

/-- Every pushed-prime square-family member dominates the translation parameter. -/
theorem IntersectionProductScaf_theta₁_push_single_dom_s
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] [Smooth X.hom] {n : ℕ}
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (M : Fin (n + 1) × Fin (n + 1) → ℂ)
    (hn : Order.height (genericPoint X.left) = n)
    (y : (a3n_T X).left) (w : (a3n_T (a3n_T X)).left)
    (hw : (IntersectionProductScaf_data M a hfin).Θ₁
      (a1p_pushforward (a3h_G (a3h_πO X hfin)).left
        (Function.locallyFinsuppWithin.single y 1)) w ≠ 0) :
    a3n_h (a3n_T X) w = genericPoint (g3c_P 1) := by
  rw [IntersectionProductScaf_theta₁_push_single, a3m_smul_apply] at hw
  exact IntersectionProductScaf_theta₁_single_dom_s X hfin M hn _ w
    (mul_ne_zero_iff.mp hw).2
#print axioms IntersectionProductScaf_theta₁_push_single_dom_s

/-- A morphism with discrete fibres preserves strict specialization chains. -/
theorem IntersectionProductScaf_quasiFinite_strictMono {U V : Scheme.{0}}
    (f : U ⟶ V) [LocallyQuasiFinite f] : StrictMono f := by
  intro x y hxy
  have hs : y ⤳ x := Scheme.le_iff_specializes.mp hxy.le
  refine lt_of_le_not_ge (Scheme.le_iff_specializes.mpr (hs.map f.continuous)) ?_
  intro hle
  have he : f x = f y := ((Scheme.le_iff_specializes.mp hle).antisymm (hs.map f.continuous)).eq
  have hyx : y = x := (f.isDiscrete_preimage_singleton (f x)).eq_of_specializes hs
    he.symm rfl
  exact hxy.ne hyx.symm
#print axioms IntersectionProductScaf_quasiFinite_strictMono


/-- A finite morphism preserves the dimensions of point closures. -/
theorem IntersectionProductScaf_finite_height {U V : Scheme.{0}}
    (f : U ⟶ V) [IsFinite f] (u : U) : height (f u) = height u := by
  symm
  apply Order.height_eq_of_strictMono f (IntersectionProductScaf_quasiFinite_strictMono f)
  intro x y hy
  obtain ⟨x', hx', he⟩ := f.isClosedMap.specializingMap (Scheme.le_iff_specializes.mp hy.le)
  refine ⟨x', lt_of_le_not_ge (Scheme.le_iff_specializes.mpr hx') ?_, he⟩
  intro hx
  apply hy.not_ge
  have h := Scheme.le_iff_specializes.mpr ((Scheme.le_iff_specializes.mp hx).map f.continuous)
  rwa [he] at h
#print axioms IntersectionProductScaf_finite_height

/-- A component point maps to the prescribed generic point when its subscheme has the inverse-image support. -/
theorem IntersectionProductScaf_component_image_of_support {U Z : Scheme.{0}}
    (f : U ⟶ Z) (hf : GeneralizingMap f) (z : Z) (I : U.IdealSheafData)
    (hI : (I.support : Set U) = f ⁻¹' closure ({z} : Set Z))
    (u : I.subscheme) (hu : closure ({u} : Set I.subscheme) ∈ irreducibleComponents I.subscheme) :
    f (I.subschemeι u) = z := by
  have hi : I.subschemeι u ∈ (I.support : Set U) := by
    rw [← I.range_subschemeι]
    exact ⟨u, rfl⟩
  rw [hI] at hi
  obtain ⟨v, hv, hfv⟩ := hf (specializes_iff_mem_closure.mpr hi)
  have hvI : v ∈ (I.support : Set U) := by
    rw [hI]
    change f v ∈ closure ({z} : Set Z)
    rw [hfv]
    exact subset_closure (Set.mem_singleton z)
  obtain ⟨v', hv'⟩ := Set.mem_range.mp (I.range_subschemeι.symm.subset hvI)
  have hvu : v' ⤳ u := by
    apply I.subschemeι.isClosedEmbedding.isInducing.specializes_iff.mp
    simpa only [hv'] using hv
  have heq := IntersectionProductScaf_component_generalization u hu v' hvu
  simpa only [← hv', heq] using hfv
#print axioms IntersectionProductScaf_component_image_of_support

/-- The inverse image of a prime under the product projection is its prime cylinder. -/
theorem IntersectionProductScaf_cylinder_primeIdeal
    (Y : Over (Spec ↧ℂ)) [IsIntegral Y.left] [LocallyOfFiniteType Y.hom]
    (z : Y.left) :
    (ccm3_primeIdeal Y.left z).comap (a3n_q Y).left =
      ccm3_primeIdeal (a3n_T Y).left (a3n_b Y z) := by
  have H : IsPullback (a3n_j Y z)
      (pullback.fst (cycleComponentι Y.left z ≫ Y.hom) a3n_P1.hom)
      (a3n_q Y).left (cycleComponentι Y.left z) :=
    .of_right (t := .flip <| .of_hasPullback Y.hom a3n_P1.hom)
      (by simpa [a3n_j, pullback.map] using
        (.flip <| IsPullback.of_hasPullback
          (cycleComponentι Y.left z ≫ Y.hom) a3n_P1.hom))
      (by simp [a3n_j, a3n_q, pullback.map])
  have hj : IsClosedImmersion (a3n_j Y z) :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) H.flip inferInstance
  have hi : (cycleComponentι Y.left z).ker = ccm3_primeIdeal Y.left z :=
    Scheme.IdealSheafData.ker_subschemeι _
  have hk : (a3n_j Y z).ker =
      (cycleComponentι Y.left z).ker.comap (a3n_q Y).left := by
    rw [← H.isoPullback_hom_fst, Scheme.Hom.ker_comp_of_isIso,
      Scheme.IdealSheafData.ker_fst_of_isClosedImmersion]
  rw [hi] at hk
  exact hk.symm.trans (a2g_ker_eq_primeIdeal (a3n_j Y z))
#print axioms IntersectionProductScaf_cylinder_primeIdeal
/-- The square map retaining the translation parameter is flat under projection flatness. -/
theorem IntersectionProductScaf_retainedSquareMap_flat
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] {n : ℕ}
    {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    [Flat (a3h_πO X hfin).left]
    (M : Fin (n + 1) × Fin (n + 1) → ℂ) :
    Flat (IntersectionProductScaf_retainedSquareMap X hfin M).left := by
  have := IntersectionProductScaf_familyProjection_flat X hfin M
  let f := IntersectionProductScaf_familyProjection X hfin M ≫
    (IntersectionProductScaf_targetFamilyIso M).hom
  have : Flat f.left := by
    change Flat ((IntersectionProductScaf_familyProjection X hfin M).left ≫
      (IntersectionProductScaf_targetFamilyIso M).hom.left)
    infer_instance
  have : Flat (a3h_G f).left := by
    rw [Over.whiskerRight_left]
    exact MorphismProperty.pullbackMap (P := @Flat)
      (inferInstance : Flat f.left) (inferInstance : Flat (𝟙 a3n_P1.left))
      (Over.w f).symm (Category.id_comp _).symm
  change Flat ((IntersectionProductScaf_originalProductIso X M).hom.left ≫
    (a3h_G f).left ≫ (IntersectionProductScaf_originalProductIso (a3h_PnO n) M).inv.left)
  infer_instance
#print axioms IntersectionProductScaf_retainedSquareMap_flat



/-- The square map retaining the translation parameter is finite. -/
theorem IntersectionProductScaf_retainedSquareMap_finite
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] {n : ℕ}
    {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (M : Fin (n + 1) × Fin (n + 1) → ℂ) :
    IsFinite (IntersectionProductScaf_retainedSquareMap X hfin M).left := by
  have := IntersectionProductScaf_familyProjection_finite X hfin M
  let f := IntersectionProductScaf_familyProjection X hfin M ≫
    (IntersectionProductScaf_targetFamilyIso M).hom
  have : IsFinite f.left := by
    change IsFinite ((IntersectionProductScaf_familyProjection X hfin M).left ≫
      (IntersectionProductScaf_targetFamilyIso M).hom.left)
    infer_instance
  have : IsFinite (a3h_G f).left := by
    rw [Over.whiskerRight_left]
    exact MorphismProperty.pullbackMap (P := @IsFinite)
      (inferInstance : IsFinite f.left) (inferInstance : IsFinite (𝟙 a3n_P1.left))
      (Over.w f).symm (Category.id_comp _).symm
  change IsFinite ((IntersectionProductScaf_originalProductIso X M).hom.left ≫
    (a3h_G f).left ≫ (IntersectionProductScaf_originalProductIso (a3h_PnO n) M).inv.left)
  infer_instance
#print axioms IntersectionProductScaf_retainedSquareMap_finite

/-- The open family inclusion preserves the base projection for every complex scheme. -/
theorem IntersectionProductScaf_familyInclusion_base_projection
    (Y : Over (Spec ↧ℂ)) {σ : Type} [Fintype σ] (M : σ × σ → ℂ) :
    (IntersectionProductScaf_familyInclusion Y M).left ≫ (a3n_q Y).left =
      (IntersectionProductScaf_familyBase Y M).left := by
  change pullback.map _ _ _ _ (𝟙 Y.left)
    (IntersectionProductScaf_parameterInclusion M) (𝟙 (Spec ↧ℂ))
    (by simp only [Category.comp_id, Category.id_comp]) (by exact Category.comp_id _) ≫
      pullback.fst _ _ = pullback.fst _ _
  rw [pullback.map, pullback.lift_fst, Category.comp_id]
#print axioms IntersectionProductScaf_familyInclusion_base_projection


/-- The square inverse image is supported over the cylinder under the retained map. -/
theorem IntersectionProductScaf_retainedSquareMap_inverse_support
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] [Smooth X.hom] {n : ℕ}
    {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (M : Fin (n + 1) × Fin (n + 1) → ℂ)
    (hn : Order.height (genericPoint X.left) = n)
    (z : (a3n_T (a3h_PnO n)).left) :
    ((ccm3_inverseIdeal (IntersectionProductScaf_familyMap₁ X hfin M).left z).support :
        Set (IntersectionProductScaf_familyOpen (a3n_T X) M).left) =
      ((IntersectionProductScaf_retainedSquareMap X hfin M ≫
        IntersectionProductScaf_familyInclusion (a3n_T (a3h_PnO n)) M).left) ⁻¹'
        closure ({a3n_b (a3n_T (a3h_PnO n)) z} : Set (a3n_T (a3n_T (a3h_PnO n))).left) := by
  have := IntersectionProductScaf_projectionTarget_integral X hfin hn
  rw [ccm3_inverseIdeal, Scheme.IdealSheafData.support_comap]
  simp only [ccm3_primeIdeal, Scheme.IdealSheafData.coe_support_vanishingIdeal]
  ext v
  change (IntersectionProductScaf_familyMap₁ X hfin M).left v ∈ closure ({z} : Set _) ↔
    ((IntersectionProductScaf_retainedSquareMap X hfin M ≫
      IntersectionProductScaf_familyInclusion (a3n_T (a3h_PnO n)) M).left) v ∈ closure ({_} : Set _)
  rw [← specializes_iff_mem_closure, ← specializes_iff_mem_closure, a3n_b_specializes_iff]
  change z ⤳ (IntersectionProductScaf_familyMap₁ X hfin M).left v ↔
    z ⤳ (a3n_q (a3n_T (a3h_PnO n))).left
      ((IntersectionProductScaf_familyInclusion (a3n_T (a3h_PnO n)) M).left
        ((IntersectionProductScaf_retainedSquareMap X hfin M).left v))
  rw [← Scheme.Hom.comp_apply, IntersectionProductScaf_familyInclusion_base_projection]
  change _ ↔ z ⤳ ((IntersectionProductScaf_retainedSquareMap X hfin M ≫
    IntersectionProductScaf_familyBase (a3n_T (a3h_PnO n)) M).left v)
  rw [IntersectionProductScaf_retainedSquareMap_base]
#print axioms IntersectionProductScaf_retainedSquareMap_inverse_support

/-- An open immersion over the complex field preserves point-closure dimensions. -/
theorem IntersectionProductScaf_open_height {U V : Over (Spec ↧ℂ)}
    [LocallyOfFiniteType U.hom] [LocallyOfFiniteType V.hom]
    (f : U ⟶ V) [IsOpenImmersion f.left] (u : U.left) :
    height (f.left u) = height u := by
  apply (a1d_degree_pos_iff f u).mp
  rw [IntersectionProductScaf_open_degree]
  decide
#print axioms IntersectionProductScaf_open_height


/-- Adjoining a projective parameter increases the dimension of a point closure by one. -/
theorem IntersectionProductScaf_cylinder_height
    (Y : Over (Spec ↧ℂ)) [IsIntegral Y.left] [LocallyOfFiniteType Y.hom] (z : Y.left) :
    height (a3n_b Y z) = height z + 1 := by
  have : IsFinite (a3n_j Y z) := by
    unfold a3n_j
    exact CategoryTheory.MorphismProperty.pullbackMap (P := @IsFinite)
      (inferInstance : IsFinite (cycleComponentι Y.left z))
      (inferInstance : IsFinite (𝟙 a3n_P1.left)) (by simp) (by simp)
  rw [a3n_b, IntersectionProductScaf_finite_height]
  obtain ⟨-, m, hm, -⟩ := a1d_height_eq_trdeg (X := Y) z
  have hη : height (genericPoint (a3m_component Y z).left) = m := by
    exact (a3m_height_cycleComponent_genericPoint Y.left z).trans hm
  have ht := a3n_height_add_coheight_T (a3m_component Y z) m hη
    (genericPoint (a3n_T (a3m_component Y z)).left)
  have hc : coheight (genericPoint (a3n_T (a3m_component Y z)).left) = 0 :=
    Order.coheight_eq_zero.mpr fun y _ => genericPoint_specializes y
  rw [hc, add_zero] at ht
  rw [hm]
  exact ht.trans (by simp only [Nat.cast_add, Nat.cast_one])
#print axioms IntersectionProductScaf_cylinder_height

/-- The retained map sends square-family component points to their target cylinder point. -/
theorem IntersectionProductScaf_retainedSquareMap_component_image
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] [Smooth X.hom] {n : ℕ}
    {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (M : Fin (n + 1) × Fin (n + 1) → ℂ)
    (hn : Order.height (genericPoint X.left) = n)
    (z : (a3n_T (a3h_PnO n)).left)
    (u : (ccm3_inverseIdeal (IntersectionProductScaf_familyMap₁ X hfin M).left z).subscheme)
    (hu : closure ({u} : Set (ccm3_inverseIdeal (IntersectionProductScaf_familyMap₁ X hfin M).left z).subscheme) ∈
      irreducibleComponents (ccm3_inverseIdeal (IntersectionProductScaf_familyMap₁ X hfin M).left z).subscheme) :
    (IntersectionProductScaf_familyInclusion (a3n_T (a3h_PnO n)) M).left
      ((IntersectionProductScaf_retainedSquareMap X hfin M).left
        ((ccm3_inverseIdeal (IntersectionProductScaf_familyMap₁ X hfin M).left z).subschemeι u)) =
      a3n_b (a3n_T (a3h_PnO n)) z := by
  exact IntersectionProductScaf_component_image_of_support
    (IntersectionProductScaf_retainedSquareMap X hfin M ≫
      IntersectionProductScaf_familyInclusion (a3n_T (a3h_PnO n)) M).left
    ((IntersectionProductScaf_retainedSquareMap_generalizing X hfin M hn).comp
      (IntersectionProductScaf_familyInclusion (a3n_T (a3h_PnO n)) M).left.isOpenEmbedding.generalizingMap)
    _ _ (IntersectionProductScaf_retainedSquareMap_inverse_support X hfin M hn z) u hu
#print axioms IntersectionProductScaf_retainedSquareMap_component_image

/-- A prime square-family member has one more dimension than its input point. -/
theorem IntersectionProductScaf_theta₁_single_height
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] [Smooth X.hom] {n : ℕ}
    {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (M : Fin (n + 1) × Fin (n + 1) → ℂ)
    (hn : Order.height (genericPoint X.left) = n)
    (z : (a3n_T (a3h_PnO n)).left) (w : (a3n_T (a3n_T X)).left)
    (hw : IntersectionProductScaf_theta₁ X hfin M
      (Function.locallyFinsuppWithin.single z 1) w ≠ 0) :
    height w = height z + 1 := by
  have := IntersectionProductScaf_projectionTarget_integral X hfin hn
  have := IntersectionProductScaf_retainedSquareMap_finite X hfin M
  obtain ⟨u, huw, hu⟩ := (IntersectionProductScaf_openFamilyCycle_single_support
    (IntersectionProductScaf_familyInclusion (a3n_T X) M)
    (IntersectionProductScaf_familyMap₁ X hfin M) z w).mp hw
  rw [← huw, IntersectionProductScaf_open_height]
  rw [← IntersectionProductScaf_finite_height (IntersectionProductScaf_retainedSquareMap X hfin M).left]
  rw [← IntersectionProductScaf_open_height
    (IntersectionProductScaf_familyInclusion (a3n_T (a3h_PnO n)) M)]
  rw [IntersectionProductScaf_retainedSquareMap_component_image X hfin M hn z u hu,
    IntersectionProductScaf_cylinder_height]
#print axioms IntersectionProductScaf_theta₁_single_height

/-- The retained map preserves the projective translation parameter after the open inclusions. -/
theorem IntersectionProductScaf_retainedSquareMap_included_parameter
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] {n : ℕ}
    {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (M : Fin (n + 1) × Fin (n + 1) → ℂ) :
    (IntersectionProductScaf_retainedSquareMap X hfin M).left ≫
      (IntersectionProductScaf_familyInclusion (a3n_T (a3h_PnO n)) M).left ≫
        a3n_p (a3n_T (a3h_PnO n)) =
      (IntersectionProductScaf_familyInclusion (a3n_T X) M).left ≫ a3n_p (a3n_T X) := by
  rw [IntersectionProductScaf_familyInclusion_parameter,
    IntersectionProductScaf_familyInclusion_parameter, ← Category.assoc]
  have hp := congrArg Over.Hom.left (IntersectionProductScaf_retainedSquareMap_parameter X hfin M)
  exact congrArg (fun f => f ≫ (IntersectionProductScaf_parameterOverInclusion M).left) hp
#print axioms IntersectionProductScaf_retainedSquareMap_included_parameter

/-- The retained map sends a translation section into the same target section. -/
theorem IntersectionProductScaf_retainedSquareMap_section_image
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] {n : ℕ}
    {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (M : Fin (n + 1) × Fin (n + 1) → ℂ)
    (u : (IntersectionProductScaf_familyOpen (a3n_T X) M).left) (c : ℂ)
    (hu : (IntersectionProductScaf_familyInclusion (a3n_T X) M).left u ∈ Set.range (a3n_σ (a3n_T X) c)) :
    (IntersectionProductScaf_familyInclusion (a3n_T (a3h_PnO n)) M).left
      ((IntersectionProductScaf_retainedSquareMap X hfin M).left u) =
      a3n_σ (a3n_T (a3h_PnO n)) c ((IntersectionProductScaf_familyMap₁ X hfin M).left u) := by
  have hp := congrArg (fun f : (IntersectionProductScaf_familyOpen (a3n_T X) M).left ⟶ a3n_P1.left => f u)
    (IntersectionProductScaf_retainedSquareMap_included_parameter X hfin M)
  change a3n_p (a3n_T (a3h_PnO n))
      ((IntersectionProductScaf_familyInclusion (a3n_T (a3h_PnO n)) M).left
        ((IntersectionProductScaf_retainedSquareMap X hfin M).left u)) =
      a3n_p (a3n_T X) ((IntersectionProductScaf_familyInclusion (a3n_T X) M).left u) at hp
  have hm : (IntersectionProductScaf_familyInclusion (a3n_T (a3h_PnO n)) M).left
      ((IntersectionProductScaf_retainedSquareMap X hfin M).left u) ∈
      Set.range (a3n_σ (a3n_T (a3h_PnO n)) c) := by
    rw [a3n_range_σ] at hu ⊢
    change a3n_p _ _ ∈ Set.range (a3n_pt c)
    rw [hp]
    exact hu
  obtain ⟨v, hv⟩ := hm
  have hb : (a3n_q (a3n_T (a3h_PnO n))).left
      ((IntersectionProductScaf_familyInclusion (a3n_T (a3h_PnO n)) M).left
        ((IntersectionProductScaf_retainedSquareMap X hfin M).left u)) =
      (IntersectionProductScaf_familyMap₁ X hfin M).left u := by
    rw [← Scheme.Hom.comp_apply, IntersectionProductScaf_familyInclusion_base_projection]
    exact congrArg (fun f => f.left u) (IntersectionProductScaf_retainedSquareMap_base X hfin M)
  rw [← hv, a3n_q_σ_apply] at hb
  rw [← hv, hb]
#print axioms IntersectionProductScaf_retainedSquareMap_section_image

/-- A specialization preserving the dimension of its point closure is equality. -/
theorem IntersectionProductScaf_specialization_eq_of_height
    (Y : Over (Spec ↧ℂ)) [LocallyOfFiniteType Y.hom] {x y : Y.left}
    (hs : x ⤳ y) (he : height x = height y) : x = y := by
  by_cases hr : x ≤ y
  · exact (hs.antisymm (Scheme.le_iff_specializes.mp hr)).eq
  have hlt : y < x := lt_of_le_not_ge (Scheme.le_iff_specializes.mpr hs) hr
  obtain ⟨-, m, hm, -⟩ := a1d_height_eq_trdeg (X := Y) y
  have hf : height y < ⊤ := by rw [hm]; exact ENat.natCast_lt_top m
  have h := Order.height_strictMono hlt hf
  rw [he] at h
  exact False.elim (lt_irrefl _ h)
#print axioms IntersectionProductScaf_specialization_eq_of_height

/-- On a translation section the square projection preserves point-closure dimensions. -/
theorem IntersectionProductScaf_familyMap₁_section_height
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] {n : ℕ}
    {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (M : Fin (n + 1) × Fin (n + 1) → ℂ)
    (u : (IntersectionProductScaf_familyOpen (a3n_T X) M).left) (c : ℂ)
    (hu : (IntersectionProductScaf_familyInclusion (a3n_T X) M).left u ∈ Set.range (a3n_σ (a3n_T X) c)) :
    height ((IntersectionProductScaf_familyMap₁ X hfin M).left u) =
      height ((IntersectionProductScaf_familyInclusion (a3n_T X) M).left u) := by
  have := IntersectionProductScaf_retainedSquareMap_finite X hfin M
  rw [← a3n_height_σ (a3n_T (a3h_PnO n)) c,
    ← IntersectionProductScaf_retainedSquareMap_section_image X hfin M u c hu,
    IntersectionProductScaf_open_height, IntersectionProductScaf_finite_height,
    IntersectionProductScaf_open_height]
#print axioms IntersectionProductScaf_familyMap₁_section_height


/-- Codimension one in a point closure reduces its dimension by one. -/
theorem IntersectionProductScaf_codimensionOne_height
    (Y : Over (Spec ↧ℂ)) [IsIntegral Y.left] [LocallyOfFiniteType Y.hom]
    (w d : Y.left) (hd : coheight d = coheight w + 1) :
    height d + 1 = height w := by
  have hw := a3m_height_add_coheight Y w
  have hh := a3m_height_add_coheight Y d
  rw [hd] at hh
  have he : (height d + 1) + coheight w = height w + coheight w := by
    calc
      (height d + 1) + coheight w = height d + (coheight w + 1) := by ac_rfl
      _ = height w + coheight w := hh.trans hw.symm
  exact WithTop.add_right_cancel (a3c_coheight_ne_top Y.left w) he
#print axioms IntersectionProductScaf_codimensionOne_height

/-- Codimension-one specializations on a translation section map to the original input point. -/
theorem IntersectionProductScaf_theta₁_single_section_image
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] [Smooth X.hom] {n : ℕ}
    {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (M : Fin (n + 1) × Fin (n + 1) → ℂ)
    (hn : Order.height (genericPoint X.left) = n)
    (z : (a3n_T (a3h_PnO n)).left) (w : (a3n_T (a3n_T X)).left)
    (hw : IntersectionProductScaf_theta₁ X hfin M
      (Function.locallyFinsuppWithin.single z 1) w ≠ 0)
    (v : (IntersectionProductScaf_familyOpen (a3n_T X) M).left) (c : ℂ)
    (hv : (IntersectionProductScaf_familyInclusion (a3n_T X) M).left v ∈ Set.range (a3n_σ (a3n_T X) c))
    (hs : w ⤳ (IntersectionProductScaf_familyInclusion (a3n_T X) M).left v)
    (hd : height ((IntersectionProductScaf_familyInclusion (a3n_T X) M).left v) + 1 = height w) :
    (IntersectionProductScaf_familyMap₁ X hfin M).left v = z := by
  obtain ⟨u, huw, hu⟩ := (IntersectionProductScaf_openFamilyCycle_single_support
    (IntersectionProductScaf_familyInclusion (a3n_T X) M)
    (IntersectionProductScaf_familyMap₁ X hfin M) z w).mp hw
  have huf := IntersectionProductScaf_inverseIdeal_component_image
    (IntersectionProductScaf_familyMap₁ X hfin M).left
    (IntersectionProductScaf_familyMap₁_generalizing X hfin M hn) z u hu
  have hspec : z ⤳ (IntersectionProductScaf_familyMap₁ X hfin M).left v := by
    rw [← huf]
    apply Specializes.map _ (IntersectionProductScaf_familyMap₁ X hfin M).left.continuous
    apply (IntersectionProductScaf_familyInclusion (a3n_T X) M).left.isOpenEmbedding.isInducing.specializes_iff.mp
    rwa [huw]
  have hh : height ((IntersectionProductScaf_familyMap₁ X hfin M).left v) + 1 = height z + 1 := by
    rw [IntersectionProductScaf_familyMap₁_section_height X hfin M v c hv]
    exact hd.trans (IntersectionProductScaf_theta₁_single_height X hfin M hn z w hw)
  have he := WithTop.add_right_cancel (ENat.natCast_ne_top 1) hh
  exact (IntersectionProductScaf_specialization_eq_of_height (a3n_T (a3h_PnO n)) hspec he.symm).symm
#print axioms IntersectionProductScaf_theta₁_single_section_image

/-- Codimension-one translation sections retain domination of the original parameter. -/
theorem IntersectionProductScaf_theta₁_single_section_dom_t
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] [Smooth X.hom] {n : ℕ}
    {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (M : Fin (n + 1) × Fin (n + 1) → ℂ)
    (hn : Order.height (genericPoint X.left) = n)
    (z : (a3n_T (a3h_PnO n)).left) (hz : a3n_h (a3h_PnO n) z = genericPoint (g3c_P 1))
    (w : (a3n_T (a3n_T X)).left)
    (hw : IntersectionProductScaf_theta₁ X hfin M
      (Function.locallyFinsuppWithin.single z 1) w ≠ 0)
    (c : ℂ) (hc : IsUnit ((IntersectionProductScaf_lineDet M).eval c))
    (d : (a3n_T (a3n_T X)).left) (hd : d ∈ Set.range (a3n_σ (a3n_T X) c))
    (hs : w ⤳ d) (hcoh : coheight d = coheight w + 1) :
    a3n_h X ((a3n_q (a3n_T X)).left d) = genericPoint (g3c_P 1) := by
  have hm : d ∈ Set.range (IntersectionProductScaf_familyInclusion (a3n_T X) M).left := by
    obtain ⟨x, rfl⟩ := hd
    exact IntersectionProductScaf_section_mem_familyOpen (a3n_T X) M c hc x
  obtain ⟨v, hvd⟩ := hm
  have himg := IntersectionProductScaf_theta₁_single_section_image X hfin M hn z w hw v c
    (by rwa [hvd]) (by rwa [hvd])
    (by rw [hvd]; exact IntersectionProductScaf_codimensionOne_height (a3n_T (a3n_T X)) w d hcoh)
  have hq : (a3n_q (a3n_T X)).left
      ((IntersectionProductScaf_familyInclusion (a3n_T X) M).left v) =
        (IntersectionProductScaf_familyBase (a3n_T X) M).left v := by
    change ((IntersectionProductScaf_familyInclusion (a3n_T X) M).left ≫
      (a3n_q (a3n_T X)).left) v = _
    rw [IntersectionProductScaf_familyInclusion_base_projection]
  have hp := congrArg (fun f : (IntersectionProductScaf_familyOpen (a3n_T X) M).left ⟶
      a3n_P1.left => f v) (IntersectionProductScaf_familyMap₁_parameter X hfin M)
  change a3n_p (a3h_PnO n) ((IntersectionProductScaf_familyMap₁ X hfin M).left v) =
    a3n_p X ((IntersectionProductScaf_familyBase (a3n_T X) M).left v) at hp
  have hh : a3n_h (a3h_PnO n) ((IntersectionProductScaf_familyMap₁ X hfin M).left v) =
      a3n_h X ((IntersectionProductScaf_familyBase (a3n_T X) M).left v) := congrArg a3n_π hp
  rw [← hvd, hq, ← hh, himg, hz]
#print axioms IntersectionProductScaf_theta₁_single_section_dom_t

/-- An invertible parameter point is a section of the complex structure morphism. -/
theorem IntersectionProductScaf_parameterPoint_toBase
    {σ : Type} [Fintype σ] (M : σ × σ → ℂ) (c : ℂ)
    (hc : IsUnit ((IntersectionProductScaf_lineDet M).eval c)) :
    Spec.map (CommRingCat.ofHom (IntersectionProductScaf_lineEval M c hc)) ≫
      (IntersectionProductScaf_parameterOver M).hom = 𝟙 (Spec ↧ℂ) := by
  change _ ≫ (IntersectionProductScaf_parameterInclusion M ≫ a3n_P1.hom) = _
  rw [← Category.assoc, IntersectionProductScaf_parameterPoint_inclusion]
  exact a3n_pt_toBase c
#print axioms IntersectionProductScaf_parameterPoint_toBase


/-- The determinant-open section retains the complex structure morphism. -/
def IntersectionProductScaf_familySectionOver
    (Y : Over (Spec ↧ℂ)) {σ : Type} [Fintype σ] (M : σ × σ → ℂ) (c : ℂ)
    (hc : IsUnit ((IntersectionProductScaf_lineDet M).eval c)) :
    Y ⟶ IntersectionProductScaf_familyOpen Y M :=
  Over.homMk (IntersectionProductScaf_familySection Y M c hc) (by
    change (IntersectionProductScaf_familySection Y M c hc ≫ pullback.fst _ _) ≫ Y.hom = Y.hom
    rw [IntersectionProductScaf_familySection, pullback.lift_fst, Category.id_comp])
#print axioms IntersectionProductScaf_familySectionOver


/-- The determinant-open section is the fibre over its specified parameter point. -/
theorem IntersectionProductScaf_familySection_isPullback
    (Y : Over (Spec ↧ℂ)) {σ : Type} [Fintype σ] (M : σ × σ → ℂ) (c : ℂ)
    (hc : IsUnit ((IntersectionProductScaf_lineDet M).eval c)) :
    IsPullback (IntersectionProductScaf_familySection Y M c hc) Y.hom
      (pullback.snd Y.hom (IntersectionProductScaf_parameterOver M).hom)
      (Spec.map (CommRingCat.ofHom (IntersectionProductScaf_lineEval M c hc))) := by
  refine IsPullback.of_right (h₁₂ := pullback.fst Y.hom (IntersectionProductScaf_parameterOver M).hom)
    (h₂₂ := (IntersectionProductScaf_parameterOver M).hom) (v₁₃ := Y.hom) ?_ ?_ ?_
  · rw [IntersectionProductScaf_familySection, pullback.lift_fst,
      IntersectionProductScaf_parameterPoint_toBase]
    exact IsPullback.of_horiz_isIso ⟨by simp⟩
  · exact pullback.lift_snd _ _ _
  · exact (IsPullback.of_hasPullback Y.hom (IntersectionProductScaf_parameterOver M).hom).flip.flip
#print axioms IntersectionProductScaf_familySection_isPullback

/-- Restriction of a family morphism to a specified invertible translation parameter. -/
def IntersectionProductScaf_familyFibreMap
    {Y Z : Over (Spec ↧ℂ)} {σ : Type} [Fintype σ] {M : σ × σ → ℂ}
    (F : IntersectionProductScaf_familyOpen Y M ⟶ IntersectionProductScaf_familyOpen Z M)
    (c : ℂ) (hc : IsUnit ((IntersectionProductScaf_lineDet M).eval c)) : Y ⟶ Z :=
  IntersectionProductScaf_familySectionOver Y M c hc ≫ F ≫ IntersectionProductScaf_familyBase Z M


/-- A parameter-preserving family morphism commutes with restriction to its parameter fibre. -/
theorem IntersectionProductScaf_familyFibreMap_section
    {Y Z : Over (Spec ↧ℂ)} {σ : Type} [Fintype σ] {M : σ × σ → ℂ}
    (F : IntersectionProductScaf_familyOpen Y M ⟶ IntersectionProductScaf_familyOpen Z M)
    (hF : F.left ≫ pullback.snd Z.hom (IntersectionProductScaf_parameterOver M).hom =
      pullback.snd Y.hom (IntersectionProductScaf_parameterOver M).hom)
    (c : ℂ) (hc : IsUnit ((IntersectionProductScaf_lineDet M).eval c)) :
    IntersectionProductScaf_familySection Y M c hc ≫ F.left =
      (IntersectionProductScaf_familyFibreMap F c hc).left ≫ IntersectionProductScaf_familySection Z M c hc := by
  apply pullback.hom_ext
  · simp only [Category.assoc, IntersectionProductScaf_familySection, pullback.lift_fst, Category.comp_id]
    rfl
  · rw [Category.assoc, hF]
    simp only [IntersectionProductScaf_familySection, pullback.lift_snd, Category.assoc]
    rw [← Category.assoc, (IntersectionProductScaf_familyFibreMap F c hc).w]
#print axioms IntersectionProductScaf_familyFibreMap_section


/-- Restricting a parameter-preserving family morphism is a pullback square. -/
theorem IntersectionProductScaf_familyFibreMap_isPullback
    {Y Z : Over (Spec ↧ℂ)} {σ : Type} [Fintype σ] {M : σ × σ → ℂ}
    (F : IntersectionProductScaf_familyOpen Y M ⟶ IntersectionProductScaf_familyOpen Z M)
    (hF : F.left ≫ pullback.snd Z.hom (IntersectionProductScaf_parameterOver M).hom =
      pullback.snd Y.hom (IntersectionProductScaf_parameterOver M).hom)
    (c : ℂ) (hc : IsUnit ((IntersectionProductScaf_lineDet M).eval c)) :
    IsPullback (IntersectionProductScaf_familySection Y M c hc)
      (IntersectionProductScaf_familyFibreMap F c hc).left F.left
      (IntersectionProductScaf_familySection Z M c hc) := by
  apply IsPullback.of_bot (v₂₁ := Z.hom)
    (v₂₂ := pullback.snd Z.hom (IntersectionProductScaf_parameterOver M).hom)
  · rw [(IntersectionProductScaf_familyFibreMap F c hc).w, hF]
    exact IntersectionProductScaf_familySection_isPullback Y M c hc
  · exact IntersectionProductScaf_familyFibreMap_section F hF c hc
  · exact IntersectionProductScaf_familySection_isPullback Z M c hc
#print axioms IntersectionProductScaf_familyFibreMap_isPullback

/-- The retained square map covers the target family in the matching dimension. -/
theorem IntersectionProductScaf_retainedSquareMap_surjective
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] {n : ℕ}
    {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (M : Fin (n + 1) × Fin (n + 1) → ℂ)
    (hn : Order.height (genericPoint X.left) = n) :
    Surjective (IntersectionProductScaf_retainedSquareMap X hfin M).left := by
  have := IntersectionProductScaf_familyProjection_surjective X hfin M hn
  let f := IntersectionProductScaf_familyProjection X hfin M ≫
    (IntersectionProductScaf_targetFamilyIso M).hom
  have : Surjective f.left :=
    ⟨(IntersectionProductScaf_targetFamilyIso M).hom.left.surjective.comp
      (IntersectionProductScaf_familyProjection X hfin M).left.surjective⟩
  have : MorphismProperty.IsStableUnderComposition (@Surjective.{0}) :=
    ⟨fun f g hf hg => ⟨hg.1.comp hf.1⟩⟩
  have : Surjective (a3h_G f).left := by
    rw [Over.whiskerRight_left]
    exact MorphismProperty.pullbackMap (P := @Surjective)
      (inferInstance : Surjective f.left) (inferInstance : Surjective (𝟙 a3n_P1.left))
      (Over.w f).symm (Category.id_comp _).symm
  exact ⟨(IntersectionProductScaf_originalProductIso (a3h_PnO n) M).inv.left.surjective.comp
    ((a3h_G f).left.surjective.comp (IntersectionProductScaf_originalProductIso X M).hom.left.surjective)⟩
#print axioms IntersectionProductScaf_retainedSquareMap_surjective

/-- The square projection evaluated at an invertible translation parameter. -/
def IntersectionProductScaf_squareFibreMap
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] {n : ℕ}
    {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
