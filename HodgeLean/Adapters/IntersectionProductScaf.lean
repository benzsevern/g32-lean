    (M : σ × σ → ℂ) (j : Fin (a3s_N X + 1))
    (I : Ideal (Polynomial (MvPolynomial (Fin (a3s_N X + 1)) ℂ)))
    (P : Ideal Γ((IntersectionProductScaf_projectionCover X
      (IntersectionProductScaf_familyOpen X M) (IntersectionProductScaf_familyBase X M).left).X j, ⊤))
    (hP : P ∈ (Ideal.map
      (Polynomial.eval₂RingHom
        (IntersectionProductScaf_chartCoordinates X (IntersectionProductScaf_familyOpen X M)
          (IntersectionProductScaf_familyBase X M).left j)
        (((IntersectionProductScaf_projectionCover X (IntersectionProductScaf_familyOpen X M)
          (IntersectionProductScaf_familyBase X M).left).f j).appTop
            (IntersectionProductScaf_familyParameterSections X M Polynomial.X))) I).minimalPrimes) :
    letI : Algebra ℂ ((a3s_CX X).T j) :=
      (((a3s_CX X).θ j).comp MvPolynomial.C).toAlgebra
    P.comap (IntersectionProductScaf_familyChartPolynomialSectionsEquiv X M j).toRingHom ∈
      (Ideal.map (algebraMap _ _)
        (Ideal.map (Polynomial.mapRingHom ((a3s_CX X).θ j)) I)).minimalPrimes := by
  letI : Algebra ℂ ((a3s_CX X).T j) :=
    (((a3s_CX X).θ j).comp MvPolynomial.C).toAlgebra
  let e := IntersectionProductScaf_familyChartPolynomialSectionsEquiv X M j
  have h := Ideal.minimalPrimes_comap_of_surjective (f := e.toRingHom) e.surjective hP
  rw [← IntersectionProductScaf_familyChartPolynomialSectionsEquiv_evaluation X M j,
    ← Ideal.map_map, ← Ideal.map_map] at h
  rw [Ideal.comap_map_of_bijective e.toRingHom e.bijective] at h
  exact h

#print axioms IntersectionProductScaf_familyChartPolynomialSectionsEquiv_minimalPrime

/-- Parameter contractions are unchanged by the explicit localized chart-section equivalence. -/
theorem IntersectionProductScaf_familyChartPolynomialSectionsEquiv_parameter_comap
    (M : σ × σ → ℂ) (j : Fin (a3s_N X + 1))
    (P : Ideal Γ((IntersectionProductScaf_projectionCover X
      (IntersectionProductScaf_familyOpen X M) (IntersectionProductScaf_familyBase X M).left).X j, ⊤)) :
    letI : Algebra ℂ ((a3s_CX X).T j) :=
      (((a3s_CX X).θ j).comp MvPolynomial.C).toAlgebra
    (P.comap (IntersectionProductScaf_familyChartPolynomialSectionsEquiv X M j).toRingHom).comap
      ((algebraMap _ _).comp (Polynomial.mapRingHom (algebraMap ℂ ((a3s_CX X).T j)))) =
      P.comap (((IntersectionProductScaf_projectionCover X (IntersectionProductScaf_familyOpen X M)
        (IntersectionProductScaf_familyBase X M).left).f j).appTop.hom.comp
          (IntersectionProductScaf_familyParameterSections X M)) := by
  letI : Algebra ℂ ((a3s_CX X).T j) :=
    (((a3s_CX X).θ j).comp MvPolynomial.C).toAlgebra
  ext p
  change IntersectionProductScaf_familyChartPolynomialSectionsEquiv X M j
    (algebraMap _ _ (p.map (algebraMap ℂ ((a3s_CX X).T j)))) ∈ P ↔ _
  rw [IntersectionProductScaf_familyChartPolynomialSectionsEquiv_parameter]
  rfl

#print axioms IntersectionProductScaf_familyChartPolynomialSectionsEquiv_parameter_comap

/-- Constants in the family parameter ring have the given complex scalar action. -/
theorem IntersectionProductScaf_familyParameterSections_C
    (Y : Over (Spec ↧ℂ)) (M : σ × σ → ℂ) (c : ℂ) :
    IntersectionProductScaf_familyParameterSections Y M (Polynomial.C c) =
      IntersectionProductScaf_complexScalars (IntersectionProductScaf_familyOpen Y M) c := by
  change (pullback.snd Y.hom (IntersectionProductScaf_parameterOver M).hom).appTop
      ((Scheme.ΓSpecIso (.of (IntersectionProductScaf_lineRing M))).inv
        (algebraMap (Polynomial ℂ) (IntersectionProductScaf_lineRing M) (Polynomial.C c))) =
    (pullback.fst Y.hom (IntersectionProductScaf_parameterOver M).hom ≫ Y.hom).appTop
      ((Scheme.ΓSpecIso (.of ℂ)).inv c)
  rw [pullback.condition, IntersectionProductScaf_parameterOver_hom,
    a3m_appTop_comp_SpecMap]
  rfl

#print axioms IntersectionProductScaf_familyParameterSections_C

/-- The parameter contraction of a chart's global-section prime is the parameter prime of
the actual family point. -/
theorem IntersectionProductScaf_familyParameterSections_comap
    (Y : Over (Spec ↧ℂ)) (M : σ × σ → ℂ) {V : Scheme}
    (g : V ⟶ (IntersectionProductScaf_familyOpen Y M).left) (x : V) :
    ((V.toSpecΓ x).asIdeal).comap
      (g.appTop.hom.comp (IntersectionProductScaf_familyParameterSections Y M)) =
    ((pullback.snd Y.hom (IntersectionProductScaf_parameterOver M).hom (g x)).asIdeal).comap
      (algebraMap (Polynomial ℂ) (IntersectionProductScaf_lineRing M)) := by
  let f := g ≫ pullback.snd Y.hom (IntersectionProductScaf_parameterOver M).hom
  have he : g.appTop.hom.comp (IntersectionProductScaf_familyParameterSections Y M) =
      (f.appTop.hom.comp (Scheme.ΓSpecIso (.of (IntersectionProductScaf_lineRing M))).inv.hom).comp
        (algebraMap (Polynomial ℂ) (IntersectionProductScaf_lineRing M)) := by
    apply RingHom.ext
    intro r
    exact (a3m_appTop_comp_apply g
      (pullback.snd Y.hom (IntersectionProductScaf_parameterOver M).hom) _).symm
  rw [he, ← Ideal.comap_comap, IntersectionProductScaf_spec_sections_prime]
  rfl

#print axioms IntersectionProductScaf_familyParameterSections_comap

/-- Trivial parameter contraction on any source chart implies domination of the translation
parameter by its image in the family. -/
theorem IntersectionProductScaf_familyInclusion_generic_of_section_comap
    (Y : Over (Spec ↧ℂ)) (M : σ × σ → ℂ) {V : Scheme}
    (g : V ⟶ (IntersectionProductScaf_familyOpen Y M).left) (x : V)
    (hx : ((V.toSpecΓ x).asIdeal).comap
      (g.appTop.hom.comp (IntersectionProductScaf_familyParameterSections Y M)) = ⊥) :
    a3n_h Y ((IntersectionProductScaf_familyInclusion Y M).left (g x)) =
      genericPoint (g3c_P 1) := by
  apply IntersectionProductScaf_familyInclusion_parameter_generic_of_comap
  rwa [IntersectionProductScaf_familyParameterSections_comap] at hx

#print axioms IntersectionProductScaf_familyInclusion_generic_of_section_comap

/-- Trivial parameter contraction of a lifted cone prime gives domination of the actual family point. -/
theorem IntersectionProductScaf_familyInclusion_generic_of_cone_comap
    (M : σ × σ → ℂ) (j : Fin (a3s_N X + 1))
    (hj : MvPolynomial.X j ∉ (a3s_CX X).prime (genericPoint X.left))
    (x : (IntersectionProductScaf_projectionCover X (IntersectionProductScaf_familyOpen X M)
      (IntersectionProductScaf_familyBase X M).left).X j) :
    letI : Algebra ℂ ((a3s_CX X).T j) :=
      (((a3s_CX X).θ j).comp MvPolynomial.C).toAlgebra
    ∀ Q : Ideal (Localization.Away
      ((Polynomial.mapRingHom (a3t_phi (a3s_CX X) j hj))
        ((IntersectionProductScaf_lineDet M).map (algebraMap ℂ ((a3s_CX X).T j))))),
      Q.comap (IntersectionProductScaf_familyChartConeMap X M j hj) =
        (((IntersectionProductScaf_projectionCover X (IntersectionProductScaf_familyOpen X M)
          (IntersectionProductScaf_familyBase X M).left).X j).toSpecΓ x).asIdeal.comap
            (IntersectionProductScaf_familyChartPolynomialSectionsEquiv X M j).toRingHom →
      Q.comap ((algebraMap _ _).comp
        (Polynomial.mapRingHom (algebraMap ℂ (a3t_Ax (a3s_CX X) j)))) = ⊥ →
      a3n_h X ((IntersectionProductScaf_familyInclusion X M).left
        ((IntersectionProductScaf_projectionCover X (IntersectionProductScaf_familyOpen X M)
          (IntersectionProductScaf_familyBase X M).left).f j x)) = genericPoint (g3c_P 1) := by
  letI : Algebra ℂ ((a3s_CX X).T j) :=
    (((a3s_CX X).θ j).comp MvPolynomial.C).toAlgebra
  intro Q hQP hpar
  apply IntersectionProductScaf_familyInclusion_generic_of_section_comap X M
    ((IntersectionProductScaf_projectionCover X (IntersectionProductScaf_familyOpen X M)
      (IntersectionProductScaf_familyBase X M).left).f j) x
  have h := IntersectionProductScaf_familyChartConeMap_parameter_comap X M j hj Q
  rw [hQP, IntersectionProductScaf_familyChartPolynomialSectionsEquiv_parameter_comap] at h
  exact h.trans hpar

#print axioms IntersectionProductScaf_familyInclusion_generic_of_cone_comap

/-- The polynomial translation matrix as global sections of the open family. -/
def IntersectionProductScaf_familyMatrix (Y : Over (Spec ↧ℂ)) (M : σ × σ → ℂ) :
    Matrix σ σ Γ((IntersectionProductScaf_familyOpen Y M).left, ⊤) :=
  ((pullback.snd Y.hom (IntersectionProductScaf_parameterOver M).hom).appTop.hom.comp
    (Scheme.ΓSpecIso (.of (IntersectionProductScaf_lineRing M))).inv.hom).mapMatrix
      (IntersectionProductScaf_localLineMatrix M)

/-- The global translation matrix is invertible on the open family. -/
theorem IntersectionProductScaf_familyMatrix_det (Y : Over (Spec ↧ℂ)) (M : σ × σ → ℂ) :
    IsUnit (IntersectionProductScaf_familyMatrix Y M).det := by
  have hlocal := IntersectionProductScaf_localLineMatrix_det M
  change IsUnit (@Matrix.det σ (Classical.decEq σ) _ _ _
    (IntersectionProductScaf_localLineMatrix M)) at hlocal
  have hd : Classical.decEq σ = (inferInstance : DecidableEq σ) := Subsingleton.elim _ _
  rw [hd] at hlocal
  erw [IntersectionProductScaf_familyMatrix, ← RingHom.map_det]
  exact hlocal.map _

/-- Restricting the global translation matrix to a section evaluates its parameter. -/
theorem IntersectionProductScaf_familySection_matrix {τ : Type} [Fintype τ] (Y : Over (Spec ↧ℂ))
    (M : τ × τ → ℂ) (c : ℂ)
    (hc : IsUnit ((IntersectionProductScaf_lineDet M).eval c)) :
    (IntersectionProductScaf_familySection Y M c hc).appTop.hom.mapMatrix
        (IntersectionProductScaf_familyMatrix Y M) =
      (Y.hom.appTop.hom.comp (Scheme.ΓSpecIso (.of ℂ)).inv.hom).mapMatrix
        ((Polynomial.evalRingHom c).mapMatrix (IntersectionProductScaf_lineMatrix M)) := by
  ext i j
  change (IntersectionProductScaf_familySection Y M c hc).appTop
    ((pullback.snd Y.hom (IntersectionProductScaf_parameterOver M).hom).appTop
      ((Scheme.ΓSpecIso (.of (IntersectionProductScaf_lineRing M))).inv
        (IntersectionProductScaf_localLineMatrix M i j))) = _
  erw [← a3m_appTop_comp_apply, IntersectionProductScaf_familySection,
    pullback.lift_snd, a3m_appTop_comp_SpecMap]
  change Y.hom.appTop ((Scheme.ΓSpecIso (.of ℂ)).inv
      (IntersectionProductScaf_lineEval M c hc
        (algebraMap (Polynomial ℂ) (IntersectionProductScaf_lineRing M)
          (IntersectionProductScaf_lineMatrix M i j)))) =
    Y.hom.appTop ((Scheme.ΓSpecIso (.of ℂ)).inv
      ((Polynomial.evalRingHom c) (IntersectionProductScaf_lineMatrix M i j)))
  rw [show IntersectionProductScaf_lineEval M c hc
      (algebraMap (Polynomial ℂ) (IntersectionProductScaf_lineRing M)
        (IntersectionProductScaf_lineMatrix M i j)) =
      (Polynomial.evalRingHom c) (IntersectionProductScaf_lineMatrix M i j) from
    IsLocalization.Away.lift_eq (IntersectionProductScaf_lineDet M) hc _]

/-- At parameter zero the global family matrix restricts to the identity. -/
theorem IntersectionProductScaf_familySection_matrix_zero {τ : Type} [Fintype τ] (Y : Over (Spec ↧ℂ))
    (M : τ × τ → ℂ) :
    (IntersectionProductScaf_familySection Y M 0 (by
      rw [IntersectionProductScaf_lineDet_zero]; exact isUnit_one)).appTop.hom.mapMatrix
        (IntersectionProductScaf_familyMatrix Y M) = 1 := by
  rw [IntersectionProductScaf_familySection_matrix]
  exact (congrArg
    (Y.hom.appTop.hom.comp (Scheme.ΓSpecIso (.of ℂ)).inv.hom).mapMatrix
    (IntersectionProductScaf_lineMatrix_zero M)).trans (map_one _)

