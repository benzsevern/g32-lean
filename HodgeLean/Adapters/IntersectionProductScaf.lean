        (Polynomial.mapRingHom (algebraMap (a3t_A (a3s_CX X)) (a3t_Ax (a3s_CX X) j)))) ∈
        (Ideal.map (Polynomial.mapRingHom ((Ideal.Quotient.mk _).comp (a3r_lin ℓ).toRingHom))
          (Ideal.map (IntersectionProductScaf_substLine0 M).toRingHom I)).minimalPrimes := by
  letI : Algebra ℂ ((a3s_CX X).T j) :=
    (((a3s_CX X).θ j).comp MvPolynomial.C).toAlgebra
