/-- At a generic regular-section point the fibre coefficient is the weighted prime-fibre sum. -/
theorem IntersectionProductScaf_regular_section_component_sum_at
    (Y : Scheme) [IsNoetherian Y] (J : Y.IdealSheafData)
    (x : J.subscheme) (hx : x ∈ genericPoints J.subscheme)
    (r : Y.presheaf.stalk (J.subschemeι x))
    (hr : IsSMulRegular (Y.presheaf.stalk (J.subschemeι x)) r)
    (hker : RingHom.ker (J.subschemeι.stalkMap x).hom = Ideal.span {r}) :
    a2g_fundCycle J.subschemeι (J.subschemeι x) =
      ∑ p ∈ (PrimeSpectrum.finite_setOfPred_isMin
        (Y.presheaf.stalk (J.subschemeι x))).toFinset,
        a2g_fundCycle (𝟙 Y) (Y.fromSpecStalk (J.subschemeι x) p) *
          a2g_fundCycle (((ccm3_primeIdeal Y
            (Y.fromSpecStalk (J.subschemeι x) p)).comap J.subschemeι).subschemeι) x := by
  classical
  have hY : (genericPoints Y).Finite :=
    genericPoints.finite TopologicalSpace.NoetherianSpace.finite_irreducibleComponents
  have hJ : (genericPoints J.subscheme).Finite := by
    have := a2g_subscheme_noetherianSpace J
    exact genericPoints.finite TopologicalSpace.NoetherianSpace.finite_irreducibleComponents
  have hc := IntersectionProductScaf_regularFibre_embedded_coefficients J.subschemeι
    (𝟙 Y) Function.injective_id x hx r hr hker hJ hY
  simp only [Category.comp_id] at hc
  change a2g_fundCycle J.subschemeι (J.subschemeι x) = _ at hc
  rw [hc]
  apply Finset.sum_congr rfl
  intro p hp
  obtain ⟨_, ⟨U, hU, rfl⟩, hxU, -⟩ := Y.isBasis_affineOpens.exists_subset_of_mem_open
    (Set.mem_univ (J.subschemeι x)) isOpen_univ
  have hlocal := (a3l_ker_stalkMap_subschemeι J x ⟨U, hU⟩ hxU).symm.trans hker
  have hpideal : a3i_stalkIdeal Y (J.subschemeι x)
      (Y.fromSpecStalk (J.subschemeι x) p) = p.asIdeal :=
    congrArg PrimeSpectrum.asIdeal (a3y_pt_fromSpecStalk (J.subschemeι x) p)
  rw [IntersectionProductScaf_prime_restriction_coefficient Y J _ x hx
    (a3y_specializes_fromSpecStalk (J.subschemeι x) p) ⟨U, hU⟩ hxU,
    hlocal, hpideal, IntersectionProductScaf_quotient_parameter_length]
  rfl
#print axioms IntersectionProductScaf_regular_section_component_sum_at

