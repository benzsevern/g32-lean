#print axioms IntersectionProductScaf_squareFibreMap_eq


/-- The evaluated square projection is the pullback of the retained map along its parameter section. -/
theorem IntersectionProductScaf_squareFibreMap_isPullback
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] {n : ℕ}
    {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
