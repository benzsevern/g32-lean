/-- On affine schemes, inverse images of ideal sheaves are extensions of the corresponding ideals. -/
theorem IntersectionProductScaf_affine_comap_ideal
    {Y Z : Scheme} [IsAffine Y] [IsAffine Z] (f : Y ⟶ Z)
    (K : Z.IdealSheafData) :
    Scheme.IdealSheafData.equivOfIsAffine (K.comap f) =
      (Scheme.IdealSheafData.equivOfIsAffine K).map f.appTop.hom := by
  let eY := Scheme.IdealSheafData.equivOfIsAffine (X := Y)
  let eZ := Scheme.IdealSheafData.equivOfIsAffine (X := Z)
  have hm (J : Y.IdealSheafData) : eZ (J.map f) = (eY J).comap f.appTop.hom := by
    dsimp [eZ, eY]
    rw [Scheme.IdealSheafData.ideal_map_of_isAffineHom]
    rfl
  apply le_antisymm
  · change eY (K.comap f) ≤ _
    rw [← eY.apply_symm_apply ((eZ K).map f.appTop.hom)]
    apply eY.map_le_map_iff'.mpr
    apply Scheme.IdealSheafData.le_map_iff_comap_le.mp
    apply eZ.map_le_map_iff'.mp
    change eZ K ≤ eZ ((eY.symm ((eZ K).map f.appTop.hom)).map f)
    rw [hm, eY.apply_symm_apply]
    exact Ideal.le_comap_map
  · rw [Ideal.map_le_iff_le_comap, ← hm]
    apply eZ.map_le_map_iff'.mpr
    exact Scheme.IdealSheafData.le_map_iff_comap_le.mpr le_rfl
#print axioms IntersectionProductScaf_affine_comap_ideal

