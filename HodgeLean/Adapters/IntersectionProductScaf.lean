  rw [IntersectionProductScaf_sectionDivisor_prime_fundCycle X c hc w hdom,
    ← a2g_ker_eq_primeIdeal, sup_comm, a2g_ker_sup_eq_map_comap, a2g_fundCycle_map]
  have : IsLocallyNoetherian X.left := LocallyOfFiniteType.isLocallyNoetherian X.hom
  have : IsNoetherian X.left := ⟨⟩
