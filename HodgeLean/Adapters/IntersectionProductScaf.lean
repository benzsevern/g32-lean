/-- The product projection contracts the homogeneous prime over the affine parameter chart. -/
theorem IntersectionProductScaf_product_projection_line_prime
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] {n : ℕ}
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (y : (a3n_T X).left) (hy : y ∈ a3h_U X) :
    (a3m_lineCharts (a3m_projCharts n) (a3m_Pn_hov n)).prime
        (a3h_pt (a3h_PnO n) ((a3h_G (a3h_πO X hfin)).left y)
          (IntersectionProductScaf_product_projection_mem_U _ y hy)) =
      ((a3s_LC X).prime (a3h_pt X y hy)).comap
        (IntersectionProductScaf_relativeLinear a).toRingHom := by
  let x := (a3n_q X).left y
  obtain ⟨j, p, hp⟩ := (a3s_CX X).cover x
  obtain ⟨i, hi⟩ := a3h_exists_notMem X (a3r_mat a) hfin x
  have hs : a3h_s X (a3r_mat a) j i ∉ p.asIdeal := by
    rwa [← (a3s_CX X).mem_prime_iff_of_isHomogeneous x j p hp _ 1
      (a3r_lin_X_isHomogeneous (a3r_mat a) i)]
  obtain ⟨p', hp'⟩ : ∃ p' : Spec (a3h_Rs X (a3r_mat a) j i),
      PrimeSpectrum.comap (algebraMap ((a3s_CX X).T j)
        (Localization.Away (a3h_s X (a3r_mat a) j i))) p' = p :=
    (PrimeSpectrum.localization_away_comap_range (Localization.Away (a3h_s X (a3r_mat a) j i))
      (a3h_s X (a3r_mat a) j i)).ge ((PrimeSpectrum.mem_basicOpen _ _).2 hs)
  let r := a3h_ιs X (a3r_mat a) j i ≫ (a3s_CX X).κ j
  obtain ⟨q, hq⟩ : (a3h_e X).hom y ∈ Set.range (a3m_prodChart r (g3c_chartι 1 0)) := by
    rw [a3m_range_prodChart]
    change _ ∈ Set.range r ∧ _
    rw [a3h_e_fst_apply]
    refine ⟨⟨p', ?_⟩, (a3h_mem_U_iff X y).mp hy⟩
    change (a3s_CX X).κ j (a3h_ιs X (a3r_mat a) j i p') = x
    exact (congrArg ((a3s_CX X).κ j) hp').trans hp
  let f := algebraMap ((a3s_CX X).T j) (Localization.Away (a3h_s X (a3r_mat a) j i))
  let g := a3h_ψ X (a3r_mat a) j i
  let tf := (Algebra.TensorProduct.map f.toIntAlgHom (AlgHom.id ℤ a3m_Away1)).toRingHom
  let tg := (Algebra.TensorProduct.map g.toIntAlgHom (AlgHom.id ℤ a3m_Away1)).toRingHom
  have hsource : (a3s_LC X).κ j (Spec.map (CommRingCat.ofHom tf) q) = a3h_pt X y hy := by
    apply Subtype.ext
    change (a3m_U X.left).ι ((a3s_LC X).κ j (Spec.map (CommRingCat.ofHom tf) q)) = _
    erw [← Scheme.Hom.comp_apply, a3m_lineCharts_κ, ← Scheme.Hom.comp_apply]
    change (Spec.map (CommRingCat.ofHom tf) ≫ a3m_prodChart ((a3s_CX X).κ j) (g3c_chartι 1 0)) q = _
    have he := IntersectionProductScaf_productChart_ringMap
      ((a3s_CX X).T j) (a3h_Rs X (a3r_mat a) j i) (.of a3m_Away1)
      f ((a3s_CX X).κ j) (g3c_chartι 1 0)
    exact (congrArg (fun f => f q) he).trans hq
  have htarget : (a3m_lineCharts (a3m_projCharts n) (a3m_Pn_hov n)).κ i
      (Spec.map (CommRingCat.ofHom tg) q) =
        a3h_pt (a3h_PnO n) ((a3h_G (a3h_πO X hfin)).left y)
          (IntersectionProductScaf_product_projection_mem_U _ y hy) := by
    apply Subtype.ext
    change (a3m_U (a3h_PnO n).left).ι
      ((a3m_lineCharts (a3m_projCharts n) (a3m_Pn_hov n)).κ i
        (Spec.map (CommRingCat.ofHom tg) q)) = _
    erw [← Scheme.Hom.comp_apply, a3m_lineCharts_κ, ← Scheme.Hom.comp_apply]
    change (Spec.map (CommRingCat.ofHom tg) ≫ a3m_prodChart (a3m_Pnκ n i) (g3c_chartι 1 0)) q = _
    have he := IntersectionProductScaf_productChart_ringMap
      (a3m_PnT n i) (a3h_Rs X (a3r_mat a) j i) (.of a3m_Away1)
      g (a3m_Pnκ n i) (g3c_chartι 1 0)
    rw [show Spec.map (CommRingCat.ofHom tg) ≫ a3m_prodChart (a3m_Pnκ n i) (g3c_chartι 1 0) =
      a3m_prodChart (Spec.map (CommRingCat.ofHom g) ≫ a3m_Pnκ n i) (g3c_chartι 1 0) from he]
    rw [show Spec.map (CommRingCat.ofHom g) ≫ a3m_Pnκ n i =
      r ≫ (a3h_πO X hfin).left from a3h_chart X hfin j i]
    change (a3m_prodChart (r ≫ (a3h_πO X hfin).left) (g3c_chartι 1 0)) q = _
    rw [← IntersectionProductScaf_productMap_chart (a3h_πO X hfin) _ r]
    simp only [Scheme.Hom.comp_apply, hq]
    rw [show (a3h_e X).inv ((a3h_e X).hom y) = y from
      congrArg (fun f : (a3n_T X).left ⟶ (a3n_T X).left => f y) (a3h_e X).hom_inv_id]
    rfl
  ext F
  rw [a3m_SpecCharts.mem_prime_iff _ _ i _ htarget, Ideal.mem_comap,
    a3m_SpecCharts.mem_prime_iff _ _ j _ hsource]
  refine forall_congr' fun d => ?_
  change tg (a3m_Tθ (a3m_projCharts n) i (homogeneousComponent d F)) ∈ q.asIdeal ↔
    tf (a3m_Tθ (a3s_CX X) j
      (homogeneousComponent d (IntersectionProductScaf_relativeLinear a F))) ∈ q.asIdeal
  rw [IntersectionProductScaf_relativeLinear_homogeneousComponent]
  change tg (a3m_Tθ (a3m_projCharts n) i (homogeneousComponent d F)) ∈ q.asIdeal ↔
    tf (a3m_Tθ (a3s_CX X) j
      (IntersectionProductScaf_relativeLinear a (homogeneousComponent d F))) ∈ q.asIdeal
  erw [IntersectionProductScaf_relative_projection_chart X a j i _ d
    (homogeneousComponent_isHomogeneous d F)]
  have hu : IsUnit (f (a3h_s X (a3r_mat a) j i) ⊗ₜ[ℤ] (1 : a3m_Away1)) :=
    (IsLocalization.Away.algebraMap_isUnit (a3h_s X (a3r_mat a) j i)
      (S := Localization.Away (a3h_s X (a3r_mat a) j i))).map
      (Algebra.TensorProduct.includeLeftRingHom (R := ℤ) (B := a3m_Away1))
  rw [mul_comm, Ideal.mul_unit_mem_iff_mem _ (hu.pow d)]
  rfl
#print axioms IntersectionProductScaf_product_projection_line_prime

/-- The product projection contracts cone primes in the coordinates retaining the original parameter. -/
theorem IntersectionProductScaf_product_projection_cone_prime
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] {n : ℕ}
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (y : (a3n_T X).left) (hy : y ∈ a3h_U X) :
    IntersectionProductScaf_projectiveLinePrime n ((a3h_G (a3h_πO X hfin)).left y)
      (IntersectionProductScaf_product_projection_mem_U _ y hy) =
      (a3h_P X y hy).comap (a3r_lin (a3h_block a)).toRingHom := by
  rw [IntersectionProductScaf_projectiveLinePrime,
    IntersectionProductScaf_product_projection_line_prime X a hfin y hy]
  ext F
  change IntersectionProductScaf_relativeLinear a (a3m_eq _ (a3h_eqT _ F)) ∈
    (a3s_LC X).prime (a3h_pt X y hy) ↔
      a3m_eq _ (a3h_eqT _ (a3r_lin (a3h_block a) F)) ∈ (a3s_LC X).prime (a3h_pt X y hy)
  rw [IntersectionProductScaf_eqT_linear_projection,
    IntersectionProductScaf_eq_linear_projection]
#print axioms IntersectionProductScaf_product_projection_cone_prime

