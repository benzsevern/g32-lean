/-- The coefficient of an extended inverse-image component is its generic local length. -/
theorem IntersectionProductScaf_openFamilyCycle_single_coeff
    {U Z W : Over (Spec ↧ℂ)}
    [LocallyOfFiniteType U.hom] [QuasiCompact U.hom]
    [LocallyOfFiniteType Z.hom] [QuasiCompact Z.hom]
    (j : U ⟶ W) [IsOpenImmersion j.left] [QuasiCompact j.left]
    (f : U ⟶ Z) (z : Z.left) (u : (ccm3_inverseIdeal f.left z).subscheme)
    (hu : closure ({u} : Set (ccm3_inverseIdeal f.left z).subscheme) ∈
      irreducibleComponents (ccm3_inverseIdeal f.left z).subscheme) :
    IntersectionProductScaf_openFamilyCycle j f
      (Function.locallyFinsuppWithin.single z 1)
      (j.left ((ccm3_inverseIdeal f.left z).subschemeι u)) =
        ((ccm3_genericLength f.left z u).toNat : ℚ) := by
  rw [IntersectionProductScaf_openFamilyCycle,
    IntersectionProductScaf_flatPullback_single, IntersectionProductScaf_open_apply]
  exact ccm3_flatPullbackPrime_coeff f z u hu

/-- The actual extended family coefficient is the local length on the extended subscheme. -/
theorem IntersectionProductScaf_openFamilyCycle_extended_coeff
    {U Z W : Over (Spec ↧ℂ)}
    [LocallyOfFiniteType U.hom] [QuasiCompact U.hom]
    [LocallyOfFiniteType Z.hom] [QuasiCompact Z.hom]
    (j : U ⟶ W) [IsOpenImmersion j.left] [QuasiCompact j.left]
    (f : U ⟶ Z) (z : Z.left) (u : (ccm3_inverseIdeal f.left z).subscheme)
    (hu : closure ({u} : Set (ccm3_inverseIdeal f.left z).subscheme) ∈
      irreducibleComponents (ccm3_inverseIdeal f.left z).subscheme) :
    let I := ccm3_inverseIdeal f.left z
    let v := I.subschemeMap (I.map j.left) j.left le_rfl u
    IntersectionProductScaf_openFamilyCycle j f
      (Function.locallyFinsuppWithin.single z 1) (j.left (I.subschemeι u)) =
        ((Module.length ((I.map j.left).subscheme.presheaf.stalk v)
          ((I.map j.left).subscheme.presheaf.stalk v)).toNat : ℚ) := by
  dsimp only
  rw [IntersectionProductScaf_openFamilyCycle_single_coeff j f z u hu]
  exact congrArg (fun l : ℕ∞ => (l.toNat : ℚ))
    (IntersectionProductScaf_open_ideal_length j.left (ccm3_inverseIdeal f.left z) u)

#print axioms IntersectionProductScaf_openFamilyCycle_extended_coeff

/-- The explicit family has exactly the component support of the extended inverse-image subscheme. -/
theorem IntersectionProductScaf_openFamilyCycle_extended_support
    {U Z W : Over (Spec ↧ℂ)}
    [LocallyOfFiniteType U.hom] [QuasiCompact U.hom]
    [LocallyOfFiniteType Z.hom] [QuasiCompact Z.hom]
    (j : U ⟶ W) [IsOpenImmersion j.left] [QuasiCompact j.left]
    (f : U ⟶ Z) (z : Z.left) (w : W.left) :
    let I := ccm3_inverseIdeal f.left z
    IntersectionProductScaf_openFamilyCycle j f
      (Function.locallyFinsuppWithin.single z 1) w ≠ 0 ↔
        ∃ v : (I.map j.left).subscheme, (I.map j.left).subschemeι v = w ∧
          closure ({v} : Set (I.map j.left).subscheme) ∈
            irreducibleComponents (I.map j.left).subscheme := by
  let I := ccm3_inverseIdeal f.left z
  let e := I.subschemeMap (I.map j.left) j.left le_rfl
  have he (u : I.subscheme) : (I.map j.left).subschemeι (e u) = j.left (I.subschemeι u) :=
    congrArg (fun g : I.subscheme ⟶ W.left => g u)
      (I.subschemeMap_subschemeι (I.map j.left) j.left le_rfl)
  constructor
  · intro hw
    obtain ⟨u, hu, hcomp⟩ :=
      (IntersectionProductScaf_openFamilyCycle_single_support j f z w).mp hw
    exact ⟨e u, (he u).trans hu, IntersectionProductScaf_open_ideal_component j.left I u hcomp⟩
  · rintro ⟨v, hv, hcomp⟩
    obtain ⟨u, hu, hev⟩ := IntersectionProductScaf_dense_component_preimage e
      (IntersectionProductScaf_open_ideal_dense j.left I)
      (ccm3_inverse_components_finite f z) v hcomp
    apply (IntersectionProductScaf_openFamilyCycle_single_support j f z w).mpr
    exact ⟨u, (he u).symm.trans ((congrArg (I.map j.left).subschemeι hev).trans hv), hu⟩

#print axioms IntersectionProductScaf_openFamilyCycle_extended_support

/-- Every component of the extended subscheme has its generic local length as family coefficient. -/
theorem IntersectionProductScaf_openFamilyCycle_extended_component_coeff
    {U Z W : Over (Spec ↧ℂ)}
    [LocallyOfFiniteType U.hom] [QuasiCompact U.hom]
    [LocallyOfFiniteType Z.hom] [QuasiCompact Z.hom]
    (j : U ⟶ W) [IsOpenImmersion j.left] [QuasiCompact j.left]
    (f : U ⟶ Z) (z : Z.left)
    (v : ((ccm3_inverseIdeal f.left z).map j.left).subscheme)
    (hv : closure ({v} : Set ((ccm3_inverseIdeal f.left z).map j.left).subscheme) ∈
      irreducibleComponents ((ccm3_inverseIdeal f.left z).map j.left).subscheme) :
    IntersectionProductScaf_openFamilyCycle j f (Function.locallyFinsuppWithin.single z 1)
        (((ccm3_inverseIdeal f.left z).map j.left).subschemeι v) =
      ((Module.length (((ccm3_inverseIdeal f.left z).map j.left).subscheme.presheaf.stalk v)
        (((ccm3_inverseIdeal f.left z).map j.left).subscheme.presheaf.stalk v)).toNat : ℚ) := by
  let I := ccm3_inverseIdeal f.left z
  let e := I.subschemeMap (I.map j.left) j.left le_rfl
  obtain ⟨u, hu, hev⟩ := IntersectionProductScaf_dense_component_preimage e
    (IntersectionProductScaf_open_ideal_dense j.left I)
    (ccm3_inverse_components_finite f z) v hv
  have he : (I.map j.left).subschemeι (e u) = j.left (I.subschemeι u) :=
    congrArg (fun g : I.subscheme ⟶ W.left => g u)
      (I.subschemeMap_subschemeι (I.map j.left) j.left le_rfl)
  have hw : j.left (I.subschemeι u) = (I.map j.left).subschemeι v :=
    he.symm.trans (congrArg (I.map j.left).subschemeι hev)
  have hc := IntersectionProductScaf_openFamilyCycle_extended_coeff j f z u hu
  change IntersectionProductScaf_openFamilyCycle j f (Function.locallyFinsuppWithin.single z 1)
      (j.left (I.subschemeι u)) =
    ((Module.length ((I.map j.left).subscheme.presheaf.stalk (e u))
      ((I.map j.left).subscheme.presheaf.stalk (e u))).toNat : ℚ) at hc
  rw [hw] at hc
  exact hc.trans (congrArg (fun x : (I.map j.left).subscheme =>
    ((Module.length ((I.map j.left).subscheme.presheaf.stalk x)
      ((I.map j.left).subscheme.presheaf.stalk x)).toNat : ℚ)) hev)

#print axioms IntersectionProductScaf_openFamilyCycle_extended_component_coeff

/-- With finitely many component points, the fundamental cycle is their finite sum. -/
theorem IntersectionProductScaf_fundCycle_eq_sum {V W : Scheme}
    (i : V ⟶ W) (hfin : (genericPoints V).Finite) :
    a2g_fundCycle i = ∑ v ∈ hfin.toFinset,
      Function.locallyFinsuppWithin.single (i v)
        ((Module.length (V.presheaf.stalk v) (V.presheaf.stalk v)).toNat : ℚ) := by
  classical
  rw [a2g_fundCycle, finsum_eq_sum_of_support_subset (s := hfin.toFinset)]
  · apply Finset.sum_congr rfl
    intro v hv
    exact ite_eq_left (hfin.mem_toFinset.mp hv)
  · intro v hv
    by_contra hn
    have hg : v ∉ genericPoints V := fun h => hn (hfin.mem_toFinset.mpr h)
    change (if v ∈ genericPoints V then _ else 0) ≠ 0 at hv
    exact hv (ite_eq_right hg)

#print axioms IntersectionProductScaf_fundCycle_eq_sum

/-- The explicit prime family is the fundamental cycle of its extended inverse-image ideal. -/
theorem IntersectionProductScaf_openFamilyCycle_eq_fundCycle
    {U Z W : Over (Spec ↧ℂ)}
    [LocallyOfFiniteType U.hom] [QuasiCompact U.hom]
    [LocallyOfFiniteType Z.hom] [QuasiCompact Z.hom]
    (j : U ⟶ W) [IsOpenImmersion j.left] [QuasiCompact j.left]
    (f : U ⟶ Z) (z : Z.left) :
    IntersectionProductScaf_openFamilyCycle j f (Function.locallyFinsuppWithin.single z 1) =
      a2g_fundCycle ((ccm3_inverseIdeal f.left z).map j.left).subschemeι := by
  classical
  let I := ccm3_inverseIdeal f.left z
  let J := I.map j.left
  let e := I.subschemeMap J j.left le_rfl
  have hI : (genericPoints I.subscheme).Finite := ccm3_inverse_components_finite f z
  have hJ : (genericPoints J.subscheme).Finite := (hI.image e).subset (by
    intro v hv
    obtain ⟨u, hu, hev⟩ := IntersectionProductScaf_dense_component_preimage e
      (IntersectionProductScaf_open_ideal_dense j.left I) hI v hv
    exact ⟨u, hu, hev⟩)
  rw [IntersectionProductScaf_fundCycle_eq_sum _ hJ]
  ext w
  by_cases hw : ∃ v : J.subscheme, J.subschemeι v = w ∧ v ∈ genericPoints J.subscheme
  · obtain ⟨v, rfl, hv⟩ := hw
    rw [IntersectionProductScaf_openFamilyCycle_extended_component_coeff j f z v hv,
      a3m_sum_apply, Finset.sum_eq_single v]
    · rw [Function.locallyFinsuppWithin.single_apply, ite_eq_left (by rfl)]
    · intro v' _ hne
      have hi : J.subschemeι v ≠ J.subschemeι v' := by
        intro hh
        exact hne ((J.subschemeι.isClosedEmbedding.injective hh).symm)
      rw [Function.locallyFinsuppWithin.single_apply]
      exact ite_eq_right hi
    · intro hn
      exact (hn (hJ.mem_toFinset.mpr hv)).elim
  · have hz : IntersectionProductScaf_openFamilyCycle j f
        (Function.locallyFinsuppWithin.single z 1) w = 0 := by
      by_contra hn
      exact hw ((IntersectionProductScaf_openFamilyCycle_extended_support j f z w).mp hn)
    rw [hz, a3m_sum_apply]
    symm
    apply Finset.sum_eq_zero
    intro v hv
    have hi : w ≠ J.subschemeι v := by
      intro hh
      exact hw ⟨v, hh.symm, hJ.mem_toFinset.mp hv⟩
    rw [Function.locallyFinsuppWithin.single_apply]
    exact ite_eq_right hi

#print axioms IntersectionProductScaf_openFamilyCycle_eq_fundCycle



/-- Pushing a prime into an open family multiplies its inverse image by the residue degree. -/
theorem IntersectionProductScaf_openFamilyCycle_push_single
    {V U Z W : Over (Spec ↧ℂ)}
    [LocallyOfFiniteType U.hom] [QuasiCompact U.hom]
    [LocallyOfFiniteType Z.hom] [QuasiCompact Z.hom]
    (j : U ⟶ W) [IsOpenImmersion j.left] [QuasiCompact j.left]
    (f : U ⟶ Z) (g : V ⟶ Z) [QuasiCompact g.left] (v : V.left) :
    IntersectionProductScaf_openFamilyCycle j f
        (a1p_pushforward g.left (Function.locallyFinsuppWithin.single v 1)) =
      a3m_smul (a1p_degree g.left v : ℚ)
        (IntersectionProductScaf_openFamilyCycle j f
          (Function.locallyFinsuppWithin.single (g.left v) 1)) := by
  rw [a1p_pushforward_single, one_mul]
  have hs : (Function.locallyFinsuppWithin.single (g.left v)
      (a1p_degree g.left v : ℚ) : AlgebraicCycle Z.left ℚ) =
      a3m_smul (a1p_degree g.left v : ℚ)
        (Function.locallyFinsuppWithin.single (g.left v) 1) := by
    ext z
    simp only [a3m_smul_apply, Function.locallyFinsuppWithin.single_apply]
    split_ifs <;> simp only [mul_one, mul_zero]
  rw [hs, IntersectionProductScaf_openFamilyCycle_smul]

/-- Every member over a pushed prime maps to a specialization of its image point. -/
theorem IntersectionProductScaf_openFamilyCycle_push_single_specializes
    {V U Z W : Over (Spec ↧ℂ)}
    [LocallyOfFiniteType U.hom] [QuasiCompact U.hom]
    [LocallyOfFiniteType Z.hom] [QuasiCompact Z.hom]
    (j : U ⟶ W) [IsOpenImmersion j.left] [QuasiCompact j.left]
    (f : U ⟶ Z) (g : V ⟶ Z) [QuasiCompact g.left] (v : V.left) (w : W.left)
    (hw : IntersectionProductScaf_openFamilyCycle j f
      (a1p_pushforward g.left (Function.locallyFinsuppWithin.single v 1)) w ≠ 0) :
    ∃ u : U.left, j.left u = w ∧ g.left v ⤳ f.left u := by
  rw [IntersectionProductScaf_openFamilyCycle_push_single, a3m_smul_apply] at hw
  obtain ⟨u, hu, _⟩ :=
    (IntersectionProductScaf_openFamilyCycle_single_support j f (g.left v) w).mp
      (mul_ne_zero_iff.mp hw).2
  exact ⟨_, hu, specializes_iff_mem_closure.mpr
    (IntersectionProductScaf_inverseIdeal_image f.left (g.left v) u)⟩

#print axioms IntersectionProductScaf_openFamilyCycle_push_single_specializes

/-- A member over a pushed prime maps to its image point when the family map is generalizing. -/
theorem IntersectionProductScaf_openFamilyCycle_push_single_image
    {V U Z W : Over (Spec ↧ℂ)}
    [LocallyOfFiniteType U.hom] [QuasiCompact U.hom]
    [LocallyOfFiniteType Z.hom] [QuasiCompact Z.hom]
    (j : U ⟶ W) [IsOpenImmersion j.left] [QuasiCompact j.left]
    (f : U ⟶ Z) (hf : GeneralizingMap f.left)
    (g : V ⟶ Z) [QuasiCompact g.left] (v : V.left) (w : W.left)
    (hw : IntersectionProductScaf_openFamilyCycle j f
      (a1p_pushforward g.left (Function.locallyFinsuppWithin.single v 1)) w ≠ 0) :
    ∃ u : U.left, j.left u = w ∧ f.left u = g.left v := by
  rw [IntersectionProductScaf_openFamilyCycle_push_single, a3m_smul_apply] at hw
  have hc := (mul_ne_zero_iff.mp hw).2
  obtain ⟨u, hu, hg⟩ :=
    (IntersectionProductScaf_openFamilyCycle_single_support j f (g.left v) w).mp hc
  exact ⟨_, hu, IntersectionProductScaf_inverseIdeal_component_image f.left hf _ u hg⟩

#print axioms IntersectionProductScaf_openFamilyCycle_single_coeff
#print axioms IntersectionProductScaf_openFamilyCycle_push_single
#print axioms IntersectionProductScaf_openFamilyCycle_push_single_image

section RelativeLinearSubstitution

open MvPolynomial

variable {R : Type} [CommRing R] {σ τ : Type} [Fintype σ]

/-- Linear substitution in the projective coordinates over a coefficient ring,
fixing every additional base coordinate. -/
def IntersectionProductScaf_relativeSubst (A : Matrix σ σ R) :
    MvPolynomial (σ ⊕ τ) R →ₐ[R] MvPolynomial (σ ⊕ τ) R :=
  aeval (Sum.elim (fun i => ∑ j, C (A i j) * X (Sum.inl j))
    (fun t => X (Sum.inr t)))

/-- Composition of substitutions reverses the order of matrix multiplication. -/
theorem IntersectionProductScaf_relativeSubst_mul (A B : Matrix σ σ R) :
    IntersectionProductScaf_relativeSubst (τ := τ) (A * B) =
      (IntersectionProductScaf_relativeSubst B).comp
        (IntersectionProductScaf_relativeSubst A) := by
  refine MvPolynomial.algHom_ext fun i => ?_
  rcases i with i | t
  · simp only [IntersectionProductScaf_relativeSubst, AlgHom.comp_apply, aeval_X,
      Sum.elim_inl, map_sum, map_mul, aeval_C]
    simp only [Finset.mul_sum, ← mul_assoc]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [Matrix.mul_apply, map_sum, Finset.sum_mul]
    exact Finset.sum_congr rfl fun k _ => by rw [C_mul]; rfl
  · simp only [IntersectionProductScaf_relativeSubst, AlgHom.comp_apply, aeval_X,
      Sum.elim_inr]

/-- The identity matrix fixes all projective and base coordinates. -/
theorem IntersectionProductScaf_relativeSubst_one :
    IntersectionProductScaf_relativeSubst (τ := τ) (1 : Matrix σ σ R) =
      AlgHom.id R _ := by
  refine MvPolynomial.algHom_ext fun i => ?_
  rcases i with i | t
  · simp [IntersectionProductScaf_relativeSubst, Matrix.one_apply]
  · simp [IntersectionProductScaf_relativeSubst]

/-- An invertible relative linear substitution is an algebra automorphism. -/
def IntersectionProductScaf_relativeEquiv (A : Matrix σ σ R) (hA : IsUnit A.det) :
    MvPolynomial (σ ⊕ τ) R ≃ₐ[R] MvPolynomial (σ ⊕ τ) R :=
  AlgEquiv.ofAlgHom (IntersectionProductScaf_relativeSubst A)
    (IntersectionProductScaf_relativeSubst A⁻¹)
    (by rw [← IntersectionProductScaf_relativeSubst_mul,
      Matrix.nonsing_inv_mul A hA, IntersectionProductScaf_relativeSubst_one])
    (by rw [← IntersectionProductScaf_relativeSubst_mul,
      Matrix.mul_nonsing_inv A hA, IntersectionProductScaf_relativeSubst_one])

#print axioms IntersectionProductScaf_relativeSubst_mul
#print axioms IntersectionProductScaf_relativeSubst_one
#print axioms IntersectionProductScaf_relativeEquiv

/-- The relative substitution fixes the coordinates of the base. -/
theorem IntersectionProductScaf_relativeEquiv_base (A : Matrix σ σ R)
    (hA : IsUnit A.det) (t : τ) :
    IntersectionProductScaf_relativeEquiv A hA (X (Sum.inr t)) = X (Sum.inr t) := by
  change IntersectionProductScaf_relativeSubst A (X (Sum.inr t)) = _
  simp only [IntersectionProductScaf_relativeSubst, aeval_X, Sum.elim_inr]

/-- An invertible substitution preserves prime component ideals by inverse image. -/
theorem IntersectionProductScaf_relativeEquiv_prime (A : Matrix σ σ R)
    (hA : IsUnit A.det) (P : Ideal (MvPolynomial (σ ⊕ τ) R)) [P.IsPrime] :
    (P.comap (IntersectionProductScaf_relativeEquiv A hA).toRingHom).IsPrime :=
  Ideal.comap_isPrime _ _

#print axioms IntersectionProductScaf_relativeEquiv_base
#print axioms IntersectionProductScaf_relativeEquiv_prime

/-- Relative linear substitutions preserve total homogeneous degree. -/
theorem IntersectionProductScaf_relativeSubst_homogeneous (A : Matrix σ σ R)
    {F : MvPolynomial (σ ⊕ τ) R} {d : ℕ} (hF : F.IsHomogeneous d) :
    (IntersectionProductScaf_relativeSubst A F).IsHomogeneous d := by
  have h := hF.aeval (S := R)
    (Sum.elim (fun i => ∑ j, C (A i j) * X (Sum.inl j)) (fun t => X (Sum.inr t)))
    (n := 1) (by
      rintro (i | t)
      · exact IsHomogeneous.sum _ _ _ fun j _ => isHomogeneous_C_mul_X _ _
      · exact isHomogeneous_X (R := R) _)
  simpa only [one_mul, IntersectionProductScaf_relativeSubst] using h

/-- Linear substitution commutes with changing the coefficient ring. -/
theorem IntersectionProductScaf_relativeSubst_map {S : Type} [CommRing S]
    (f : R →+* S) (A : Matrix σ σ R) :
    (MvPolynomial.map f).comp (IntersectionProductScaf_relativeSubst (τ := τ) A).toRingHom =
      (IntersectionProductScaf_relativeSubst (f.mapMatrix A)).toRingHom.comp
        (MvPolynomial.map f) := by
  apply MvPolynomial.ringHom_ext
  · intro r
    simp [IntersectionProductScaf_relativeSubst]
  · rintro (i | t)
    · simp [IntersectionProductScaf_relativeSubst, map_sum]
    · simp [IntersectionProductScaf_relativeSubst]

#print axioms IntersectionProductScaf_relativeSubst_map

attribute [local instance] MvPolynomial.gradedAlgebra

/-- The graded ring map associated to relative linear substitution. -/
def IntersectionProductScaf_relativeGraded (A : Matrix σ σ R) :
    homogeneousSubmodule (σ ⊕ τ) R →+*ᵍ homogeneousSubmodule (σ ⊕ τ) R where
  __ := (IntersectionProductScaf_relativeSubst A).toRingHom
  map_mem := IntersectionProductScaf_relativeSubst_homogeneous A

/-- Invertible linear substitutions have no projective base locus. -/
theorem IntersectionProductScaf_relativeGraded_irrelevant (A : Matrix σ σ R)
    (hA : IsUnit A.det) :
    HomogeneousIdeal.irrelevant (homogeneousSubmodule (σ ⊕ τ) R) ≤
      (HomogeneousIdeal.irrelevant (homogeneousSubmodule (σ ⊕ τ) R)).map
        (IntersectionProductScaf_relativeGraded A) := by
  apply (HomogeneousIdeal.irrelevant_le _).2
  intro d hd F hF
  let e := IntersectionProductScaf_relativeEquiv (τ := τ) A hA
  have hinv : (e.symm F).IsHomogeneous d :=
    IntersectionProductScaf_relativeSubst_homogeneous A⁻¹ hF
  have hmem := HomogeneousIdeal.mem_irrelevant_of_mem
    (homogeneousSubmodule (σ ⊕ τ) R) hd hinv
  have himage := Ideal.mem_map_of_mem
    (IntersectionProductScaf_relativeGraded (τ := τ) A).toRingHom hmem
  change e (e.symm F) ∈ _ at himage
  rw [e.apply_symm_apply] at himage
  exact himage

/-- The projective morphism induced by an invertible relative matrix. -/
def IntersectionProductScaf_relativeProj (A : Matrix σ σ R) (hA : IsUnit A.det) :
    Proj (homogeneousSubmodule (σ ⊕ τ) R) ⟶
      Proj (homogeneousSubmodule (σ ⊕ τ) R) :=
  Proj.map (IntersectionProductScaf_relativeGraded A)
    (IntersectionProductScaf_relativeGraded_irrelevant A hA)

/-- Matrix multiplication agrees with composition of the graded substitutions. -/
theorem IntersectionProductScaf_relativeGraded_mul (A B : Matrix σ σ R) :
    IntersectionProductScaf_relativeGraded (τ := τ) (A * B) =
      (IntersectionProductScaf_relativeGraded B).comp
        (IntersectionProductScaf_relativeGraded A) := by
  apply GradedRingHom.ext
  intro F
  exact congrArg (fun f : MvPolynomial (σ ⊕ τ) R →ₐ[R] _ => f F)
    (IntersectionProductScaf_relativeSubst_mul A B)

/-- The graded substitution of the identity matrix is the identity. -/
theorem IntersectionProductScaf_relativeGraded_one :
    IntersectionProductScaf_relativeGraded (τ := τ) (1 : Matrix σ σ R) =
      GradedRingHom.id (homogeneousSubmodule (σ ⊕ τ) R) := by
  apply GradedRingHom.ext
  intro F
  exact congrArg (fun f : MvPolynomial (σ ⊕ τ) R →ₐ[R] _ => f F)
    IntersectionProductScaf_relativeSubst_one

/-- The projective morphism of an invertible matrix is an isomorphism with explicit inverse. -/
def IntersectionProductScaf_relativeProjIso (A : Matrix σ σ R) (hA : IsUnit A.det) :
    Proj (homogeneousSubmodule (σ ⊕ τ) R) ≅
      Proj (homogeneousSubmodule (σ ⊕ τ) R) where
  hom := IntersectionProductScaf_relativeProj A hA
  inv := IntersectionProductScaf_relativeProj A⁻¹ (A.isUnit_nonsing_inv_det hA)
  hom_inv_id := by
    simp only [IntersectionProductScaf_relativeProj,
      ← Proj.map_comp, ← IntersectionProductScaf_relativeGraded_mul,
      Matrix.nonsing_inv_mul A hA, IntersectionProductScaf_relativeGraded_one,
      Proj.map_id]
  inv_hom_id := by
    simp only [IntersectionProductScaf_relativeProj,
      ← Proj.map_comp, ← IntersectionProductScaf_relativeGraded_mul,
      Matrix.mul_nonsing_inv A hA, IntersectionProductScaf_relativeGraded_one,
      Proj.map_id]

#print axioms IntersectionProductScaf_relativeGraded_mul
#print axioms IntersectionProductScaf_relativeGraded_one
#print axioms IntersectionProductScaf_relativeProjIso

#print axioms IntersectionProductScaf_relativeSubst_homogeneous
#print axioms IntersectionProductScaf_relativeGraded_irrelevant
#print axioms IntersectionProductScaf_relativeProj

end RelativeLinearSubstitution

section InvertibleTranslationLocus

variable {σ τ : Type} [Fintype σ]

/-- Coordinate ring of the affine parameter locus where the translation is invertible. -/
abbrev IntersectionProductScaf_lineRing (M : σ × σ → ℂ) :=
  Localization.Away (IntersectionProductScaf_lineDet M)

/-- The translation matrix over its invertible parameter locus. -/
def IntersectionProductScaf_localLineMatrix (M : σ × σ → ℂ) :
    Matrix σ σ (IntersectionProductScaf_lineRing M) :=
  (algebraMap (Polynomial ℂ) (IntersectionProductScaf_lineRing M)).mapMatrix
    (IntersectionProductScaf_lineMatrix M)

/-- Inverting the determinant makes the whole matrix invertible. -/
theorem IntersectionProductScaf_localLineMatrix_det (M : σ × σ → ℂ) :
    IsUnit (IntersectionProductScaf_localLineMatrix M).det := by
  rw [IntersectionProductScaf_localLineMatrix, ← RingHom.map_det]
  exact IsLocalization.Away.algebraMap_isUnit (IntersectionProductScaf_lineDet M)

/-- The explicit affine-cone translation automorphism on the invertible parameter locus. -/
def IntersectionProductScaf_localLineEquiv (M : σ × σ → ℂ) :
    MvPolynomial (σ ⊕ τ) (IntersectionProductScaf_lineRing M) ≃ₐ[
      IntersectionProductScaf_lineRing M]
      MvPolynomial (σ ⊕ τ) (IntersectionProductScaf_lineRing M) :=
  IntersectionProductScaf_relativeEquiv (IntersectionProductScaf_localLineMatrix M)
    (IntersectionProductScaf_localLineMatrix_det M)

/-- Translation on the invertible locus leaves the original parameters fixed. -/
theorem IntersectionProductScaf_localLineEquiv_base (M : σ × σ → ℂ) (t : τ) :
    IntersectionProductScaf_localLineEquiv M (MvPolynomial.X (Sum.inr t)) =
      MvPolynomial.X (Sum.inr t) :=
  IntersectionProductScaf_relativeEquiv_base _ _ t

/-- Specialization of the invertible parameter ring at any invertible matrix value. -/
def IntersectionProductScaf_lineEval (M : σ × σ → ℂ) (z : ℂ)
    (hz : IsUnit ((IntersectionProductScaf_lineDet M).eval z)) :
    IntersectionProductScaf_lineRing M →+* ℂ :=
  IsLocalization.Away.lift (IntersectionProductScaf_lineDet M)
    (g := Polynomial.evalRingHom z) hz

/-- Specializing the localized matrix gives the original polynomial matrix value. -/
theorem IntersectionProductScaf_lineEval_matrix (M : σ × σ → ℂ) (z : ℂ)
    (hz : IsUnit ((IntersectionProductScaf_lineDet M).eval z)) :
    (IntersectionProductScaf_lineEval M z hz).mapMatrix
        (IntersectionProductScaf_localLineMatrix M) =
      (Polynomial.evalRingHom z).mapMatrix (IntersectionProductScaf_lineMatrix M) := by
  ext i j
  exact IsLocalization.Away.lift_eq (IntersectionProductScaf_lineDet M) hz _

/-- The localized family specializes to the identity at parameter zero. -/
theorem IntersectionProductScaf_lineEval_zero (M : σ × σ → ℂ) :
    (IntersectionProductScaf_lineEval M 0 (by
      rw [IntersectionProductScaf_lineDet_zero]; exact isUnit_one)).mapMatrix
        (IntersectionProductScaf_localLineMatrix M) = 1 := by
  rw [IntersectionProductScaf_lineEval_matrix, IntersectionProductScaf_lineMatrix_zero]

/-- The localized family specializes to the specified invertible matrix at parameter one. -/
theorem IntersectionProductScaf_lineEval_one (M : σ × σ → ℂ)
    (hM : IsUnit (a3r_mat M).det) :
    (IntersectionProductScaf_lineEval M 1 (by
      rw [IntersectionProductScaf_lineDet_one]; exact hM)).mapMatrix
        (IntersectionProductScaf_localLineMatrix M) = a3r_mat M := by
  rw [IntersectionProductScaf_lineEval_matrix, IntersectionProductScaf_lineMatrix_one]

#print axioms IntersectionProductScaf_lineEval_matrix
#print axioms IntersectionProductScaf_lineEval_zero
#print axioms IntersectionProductScaf_lineEval_one

attribute [local instance] MvPolynomial.gradedAlgebra

/-- The family of projective automorphisms on the invertible parameter locus.
Taking `τ = Empty` gives the projectivization of the translation cone. -/
def IntersectionProductScaf_localLineProjIso (M : σ × σ → ℂ) :
    Proj (MvPolynomial.homogeneousSubmodule (σ ⊕ τ) (IntersectionProductScaf_lineRing M)) ≅
      Proj (MvPolynomial.homogeneousSubmodule (σ ⊕ τ) (IntersectionProductScaf_lineRing M)) :=
  IntersectionProductScaf_relativeProjIso (IntersectionProductScaf_localLineMatrix M)
    (IntersectionProductScaf_localLineMatrix_det M)

/-- The inverse-image equations of the projective family are the explicit linear substitution. -/
theorem IntersectionProductScaf_localLineProj_preimage (M : σ × σ → ℂ)
    (F : MvPolynomial (σ ⊕ τ) (IntersectionProductScaf_lineRing M)) :
    (IntersectionProductScaf_localLineProjIso M).hom ⁻¹ᵁ
        Proj.basicOpen (MvPolynomial.homogeneousSubmodule (σ ⊕ τ)
          (IntersectionProductScaf_lineRing M)) F =
      Proj.basicOpen (MvPolynomial.homogeneousSubmodule (σ ⊕ τ)
          (IntersectionProductScaf_lineRing M)) (IntersectionProductScaf_localLineEquiv M F) :=
  rfl

#print axioms IntersectionProductScaf_localLineProjIso
#print axioms IntersectionProductScaf_localLineProj_preimage

#print axioms IntersectionProductScaf_localLineMatrix_det
#print axioms IntersectionProductScaf_localLineEquiv
#print axioms IntersectionProductScaf_localLineEquiv_base

/-- Exchanging polynomial coordinates sends a polynomial in the parameter to a coefficient. -/
theorem IntersectionProductScaf_parameter_exchange [Fintype τ] (p : Polynomial ℂ) :
    a3m_eq (σ ⊕ τ) (p.map (MvPolynomial.C : ℂ →+* MvPolynomial (σ ⊕ τ) ℂ)) =
      MvPolynomial.C p := by
  induction p using Polynomial.induction_on' with
  | add p q hp hq => simpa only [Polynomial.map_add, map_add] using congrArg₂ (· + ·) hp hq
  | monomial k c =>
    rw [← Polynomial.C_mul_X_pow_eq_monomial, Polynomial.map_mul,
      Polynomial.map_C, Polynomial.map_pow, Polynomial.map_X, map_mul, map_pow,
      a3m_eq_C, a3m_eq_X, MvPolynomial.map_C, map_mul, map_pow]

#print axioms IntersectionProductScaf_parameter_exchange

attribute [local instance] MvPolynomial.algebraMvPolynomial in
/-- The localized polynomial cone is the cone over the invertible parameter ring. -/
def IntersectionProductScaf_linePolynomialEquiv (M : σ × σ → ℂ) [Fintype τ] :
    Localization.Away ((IntersectionProductScaf_lineDet M).map
      (MvPolynomial.C : ℂ →+* MvPolynomial (σ ⊕ τ) ℂ)) ≃+*
      MvPolynomial (σ ⊕ τ) (IntersectionProductScaf_lineRing M) :=
  IsLocalization.ringEquivOfRingEquiv _ _
    (M := Submonoid.powers ((IntersectionProductScaf_lineDet M).map
      (MvPolynomial.C : ℂ →+* MvPolynomial (σ ⊕ τ) ℂ)))
    (T := (Submonoid.powers (IntersectionProductScaf_lineDet M)).map
      (MvPolynomial.C : Polynomial ℂ →+* MvPolynomial (σ ⊕ τ) (Polynomial ℂ)))
    (a3m_eq (σ ⊕ τ)).toRingEquiv (by
    rw [Submonoid.map_powers, Submonoid.map_powers]
    exact congrArg Submonoid.powers (IntersectionProductScaf_parameter_exchange _))

#print axioms IntersectionProductScaf_linePolynomialEquiv

attribute [local instance] MvPolynomial.algebraMvPolynomial in
/-- Parameter polynomials become coefficients under the localized coordinate exchange. -/
theorem IntersectionProductScaf_linePolynomialEquiv_parameter [Fintype τ]
    (M : σ × σ → ℂ) (p : Polynomial ℂ) :
    IntersectionProductScaf_linePolynomialEquiv (τ := τ) M
      (algebraMap _ _ (p.map (MvPolynomial.C : ℂ →+* MvPolynomial (σ ⊕ τ) ℂ))) =
      MvPolynomial.C (algebraMap (Polynomial ℂ) (IntersectionProductScaf_lineRing M) p) := by
  rw [IntersectionProductScaf_linePolynomialEquiv,
    IsLocalization.ringEquivOfRingEquiv_eq]
  change MvPolynomial.map (algebraMap (Polynomial ℂ) (IntersectionProductScaf_lineRing M))
    (a3m_eq (σ ⊕ τ) (p.map MvPolynomial.C)) = _
  rw [IntersectionProductScaf_parameter_exchange, MvPolynomial.map_C]

#print axioms IntersectionProductScaf_linePolynomialEquiv_parameter

/-- Inverse translation as an automorphism of the determinant-localized polynomial cone. -/
def IntersectionProductScaf_localizedTranslation [Fintype τ] (M : σ × σ → ℂ) :
    Localization.Away ((IntersectionProductScaf_lineDet M).map
      (MvPolynomial.C : ℂ →+* MvPolynomial (σ ⊕ τ) ℂ)) ≃+*
    Localization.Away ((IntersectionProductScaf_lineDet M).map
      (MvPolynomial.C : ℂ →+* MvPolynomial (σ ⊕ τ) ℂ)) :=
  ((IntersectionProductScaf_linePolynomialEquiv M).trans
    (IntersectionProductScaf_localLineEquiv M).toRingEquiv).trans
      (IntersectionProductScaf_linePolynomialEquiv M).symm

/-- The localized inverse translation fixes every polynomial in the translation parameter. -/
theorem IntersectionProductScaf_localizedTranslation_parameter [Fintype τ]
    (M : σ × σ → ℂ) (p : Polynomial ℂ) :
    IntersectionProductScaf_localizedTranslation (τ := τ) M
      (algebraMap _ _ (p.map (MvPolynomial.C : ℂ →+* MvPolynomial (σ ⊕ τ) ℂ))) =
      algebraMap _ _ (p.map (MvPolynomial.C : ℂ →+* MvPolynomial (σ ⊕ τ) ℂ)) := by
  apply (IntersectionProductScaf_linePolynomialEquiv M).injective
  simp only [IntersectionProductScaf_localizedTranslation, RingEquiv.trans_apply,
    RingEquiv.apply_symm_apply, IntersectionProductScaf_linePolynomialEquiv_parameter]
  exact (IntersectionProductScaf_localLineEquiv M).commutes _

/-- Every nonzero complex parameter polynomial is regular on the determinant-localized cone. -/
theorem IntersectionProductScaf_localized_parameter_regular [Fintype τ]
    (M : σ × σ → ℂ) (p : Polynomial ℂ) (hp : p ≠ 0) :
    IsSMulRegular
      (Localization.Away ((IntersectionProductScaf_lineDet M).map
        (MvPolynomial.C : ℂ →+* MvPolynomial (σ ⊕ τ) ℂ)))
      (algebraMap
        (Polynomial (MvPolynomial (σ ⊕ τ) ℂ))
        (Localization.Away ((IntersectionProductScaf_lineDet M).map
          (MvPolynomial.C : ℂ →+* MvPolynomial (σ ⊕ τ) ℂ)))
        (p.map (MvPolynomial.C : ℂ →+* MvPolynomial (σ ⊕ τ) ℂ))) :=
  IntersectionProductScaf_complexPolynomial_regular_of_flat p hp

/-- Parameter polynomials remain regular on localized constant-cylinder quotients. -/
theorem IntersectionProductScaf_localizedCylinder_parameter_regular [Fintype τ]
    (M : σ × σ → ℂ) (I : Ideal (MvPolynomial (σ ⊕ τ) ℂ))
    [Nontrivial (MvPolynomial (σ ⊕ τ) ℂ ⧸ I)]
    (p : Polynomial ℂ) (hp : p ≠ 0) :
    let d := (IntersectionProductScaf_lineDet M).map
      (MvPolynomial.C : ℂ →+* MvPolynomial (σ ⊕ τ) ℂ)
    IsSMulRegular
      (Localization.Away d ⧸
        (I.map Polynomial.C).map (algebraMap _ (Localization.Away d)))
      (Ideal.Quotient.mk
        ((I.map Polynomial.C).map (algebraMap _ (Localization.Away d)))
        (algebraMap _ (Localization.Away d)
          (p.map (MvPolynomial.C : ℂ →+* MvPolynomial (σ ⊕ τ) ℂ)))) := by
  dsimp only
  exact IntersectionProductScaf_regular_localizedQuotient
    (Submonoid.powers ((IntersectionProductScaf_lineDet M).map
      (MvPolynomial.C : ℂ →+* MvPolynomial (σ ⊕ τ) ℂ)))
    (I.map Polynomial.C)
    (p.map (MvPolynomial.C : ℂ →+* MvPolynomial (σ ⊕ τ) ℂ))
    (IntersectionProductScaf_complexPolynomial_regular_quotientCylinder I p hp)

/-- Parameter polynomials remain regular after inverse translation of a localized cylinder. -/
theorem IntersectionProductScaf_translatedLocalizedCylinder_parameter_regular [Fintype τ]
    (M : σ × σ → ℂ) (I : Ideal (MvPolynomial (σ ⊕ τ) ℂ))
    [Nontrivial (MvPolynomial (σ ⊕ τ) ℂ ⧸ I)]
    (p : Polynomial ℂ) (hp : p ≠ 0) :
    let d := (IntersectionProductScaf_lineDet M).map
      (MvPolynomial.C : ℂ →+* MvPolynomial (σ ⊕ τ) ℂ)
    let J := (I.map Polynomial.C).map (algebraMap _ (Localization.Away d))
    IsSMulRegular
      (Localization.Away d ⧸
        J.map (IntersectionProductScaf_localizedTranslation M).toRingHom)
      (Ideal.Quotient.mk
        (J.map (IntersectionProductScaf_localizedTranslation M).toRingHom)
        (algebraMap _ (Localization.Away d)
          (p.map (MvPolynomial.C : ℂ →+* MvPolynomial (σ ⊕ τ) ℂ)))) := by
  dsimp only
  let d := (IntersectionProductScaf_lineDet M).map
    (MvPolynomial.C : ℂ →+* MvPolynomial (σ ⊕ τ) ℂ)
  let J := (I.map Polynomial.C).map (algebraMap _ (Localization.Away d))
  have hreg := IntersectionProductScaf_regular_quotientEquiv
    (IntersectionProductScaf_localizedTranslation M) J
    (J.map (IntersectionProductScaf_localizedTranslation M).toRingHom) rfl
    (algebraMap _ (Localization.Away d)
      (p.map (MvPolynomial.C : ℂ →+* MvPolynomial (σ ⊕ τ) ℂ)))
    (IntersectionProductScaf_localizedCylinder_parameter_regular M I p hp)
  rw [IntersectionProductScaf_localizedTranslation_parameter] at hreg
  exact hreg

/-- No minimal component of the determinant-localized translated cylinder contains a
nonzero polynomial in the translation parameter. -/
theorem IntersectionProductScaf_translatedLocalizedCylinder_parameter_not_mem [Fintype τ]
    (M : σ × σ → ℂ) (I : Ideal (MvPolynomial (σ ⊕ τ) ℂ))
    [Nontrivial (MvPolynomial (σ ⊕ τ) ℂ ⧸ I)]
    (p : Polynomial ℂ) (hp : p ≠ 0) :
    let d := (IntersectionProductScaf_lineDet M).map
      (MvPolynomial.C : ℂ →+* MvPolynomial (σ ⊕ τ) ℂ)
    let J := (I.map Polynomial.C).map (algebraMap _ (Localization.Away d))
    ∀ Q ∈ (J.map (IntersectionProductScaf_localizedTranslation M).toRingHom).minimalPrimes,
      algebraMap _ (Localization.Away d)
        (p.map (MvPolynomial.C : ℂ →+* MvPolynomial (σ ⊕ τ) ℂ)) ∉ Q := by
  dsimp only
  intro Q hQ
  let d := (IntersectionProductScaf_lineDet M).map
    (MvPolynomial.C : ℂ →+* MvPolynomial (σ ⊕ τ) ℂ)
  let J := (I.map Polynomial.C).map (algebraMap _ (Localization.Away d))
  let K := J.map (IntersectionProductScaf_localizedTranslation M).toRingHom
  apply IntersectionProductScaf_regular_not_mem_minimal K _ _ Q hQ
  apply IntersectionProductScaf_regular_quotient_restrictScalars
  exact IntersectionProductScaf_translatedLocalizedCylinder_parameter_regular M I p hp

/-- Every minimal component of the determinant-localized translated cylinder contracts
trivially along the translation-parameter map. -/
theorem IntersectionProductScaf_translatedLocalizedCylinder_parameter_comap [Fintype τ]
    (M : σ × σ → ℂ) (I : Ideal (MvPolynomial (σ ⊕ τ) ℂ))
    [Nontrivial (MvPolynomial (σ ⊕ τ) ℂ ⧸ I)] :
    let d := (IntersectionProductScaf_lineDet M).map
      (MvPolynomial.C : ℂ →+* MvPolynomial (σ ⊕ τ) ℂ)
    let J := (I.map Polynomial.C).map (algebraMap _ (Localization.Away d))
    ∀ Q ∈ (J.map (IntersectionProductScaf_localizedTranslation M).toRingHom).minimalPrimes,
      Q.comap ((algebraMap _ (Localization.Away d)).comp
        (Polynomial.mapRingHom
          (MvPolynomial.C : ℂ →+* MvPolynomial (σ ⊕ τ) ℂ))) = ⊥ := by
  dsimp only
  intro Q hQ
  apply IntersectionProductScaf_parameter_comap_eq_bot
  intro p hp
  exact IntersectionProductScaf_translatedLocalizedCylinder_parameter_not_mem
    M I p hp Q hQ

