/-- The line-family operator on a pushed prime is the prime family multiplied by the
residue-field degree of the finite projection. -/
theorem IntersectionProductScaf_theta₀_push_single
    (M : Fin (n + 1) × Fin (n + 1) → ℂ)
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (D : X.left) :
    (IntersectionProductScaf_data M a hfin).Θ₀
        (a1p_pushforward (a3h_πO X hfin).left
