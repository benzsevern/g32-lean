/-- Original endpoint sections on the open square family have regular equations under projection flatness. -/
theorem IntersectionProductScaf_originalOpen_regular_equation_of_projection
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom]
    {n : ℕ} {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    [Flat (a3h_πO X hfin).left]
    (hn : height (genericPoint X.left) = n)
    (M : Fin (n + 1) × Fin (n + 1) → ℂ)
    (y : (a3n_T X).left) (hy : a3n_h X y = genericPoint (g3c_P 1))
    (c : ℂ) (hc : c = 0 ∨ c = 1) :
    let I := ccm3_inverseIdeal (IntersectionProductScaf_familyMap₁ X hfin M).left
      ((a3h_G (a3h_πO X hfin)).left y)
    let J := (IntersectionProductScaf_originalFace X M c).ker.comap I.subschemeι
    ∀ x : J.subscheme, ∃ r : I.subscheme.presheaf.stalk (J.subschemeι x),
      IsSMulRegular (I.subscheme.presheaf.stalk (J.subschemeι x)) r ∧
      RingHom.ker (J.subschemeι.stalkMap x).hom = Ideal.span {r} := by
  intro I J
  have := IntersectionProductScaf_projectionTarget_integral X hfin hn
  have : Smooth (a3h_PnO n).hom := IntersectionProductScaf_projective_smooth n
  have : IsProjective (a3h_PnO n).hom :=
    ⟨⟨{ ambientDimension := n, immersion := 𝟙 _, immersion_toBase := Category.id_comp _ }⟩⟩
  let f := (IntersectionProductScaf_familyMap₁ X hfin M).left
  let P := ccm3_primeIdeal (a3n_T (a3h_PnO n)).left ((a3h_G (a3h_πO X hfin)).left y)
  let g := Scheme.IdealSheafData.subschemeMap (P.comap f) P f (P.le_map_comap f)
  have : Flat f := IntersectionProductScaf_familyMap₁_flat_of_projection X hfin M
  have : Flat g := IntersectionProductScaf_comap_subschemeMap_flat f P
  have hdom : a3n_h (a3h_PnO n) ((a3h_G (a3h_πO X hfin)).left y) =
      genericPoint (g3c_P 1) := by rw [a3h_G_h_apply, hy]
  have hK : ((a3n_σ (a3h_PnO n) c).ker.comap P.subschemeι).comap g = J := by
    rw [← Scheme.IdealSheafData.comap_comp]
    have hg : g ≫ P.subschemeι = I.subschemeι ≫ f :=
      Scheme.IdealSheafData.subschemeMap_subschemeι _ _ _ _
    rw [hg, Scheme.IdealSheafData.comap_comp]
    change _ = (IntersectionProductScaf_originalFace X M c).ker.comap I.subschemeι
    rw [IntersectionProductScaf_originalFace_ker X hfin M c]
  have H := IntersectionProductScaf_flat_comap_regular_equation g
    ((a3n_σ (a3h_PnO n) c).ker.comap P.subschemeι)
    (IntersectionProductScaf_primeInput_regular_equation (a3h_PnO n) c hc _ hdom)
  rw [hK] at H
  exact H
#print axioms IntersectionProductScaf_originalOpen_regular_equation_of_projection

