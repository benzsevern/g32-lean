/-- Intersection with a parameter section has the local fibre length for a dominating prime. -/
theorem IntersectionProductScaf_sectionDivisor_serreMult
    (c : ℂ) (hc : c = 0 ∨ c = 1) (w z : (a3n_T X).left)
    (hw : w ⤳ z) (hE : a3n_σ X c (genericPoint X.left) ⤳ z)
    (hdom : a3n_h X w = genericPoint (g3c_P 1)) :
    a3i_serreMult (a3n_T X).left z w (a3n_σ X c (genericPoint X.left)) =
      ((Module.length ((a3n_T X).left.presheaf.stalk z)
        (((a3n_T X).left.presheaf.stalk z) ⧸
          (a3i_stalkIdeal (a3n_T X).left z w ⊔
            a3i_stalkIdeal (a3n_T X).left z
              (a3n_σ X c (genericPoint X.left))))).toNat : ℤ) := by
  obtain ⟨x, rfl⟩ := a3n_mem_range_σ_of_specializes X c hE
  obtain ⟨r, -, hr, he⟩ := IntersectionProductScaf_sectionDivisor_equation X c x
  have hp := a3q_stalkIdeal_isPrime (a3n_T X).left hw
  have hnot : r ∉ a3i_stalkIdeal (a3n_T X).left (a3n_σ X c x) w := by
    intro hmem
    have hle : a3i_stalkIdeal (a3n_T X).left (a3n_σ X c x)
        (a3n_σ X c (genericPoint X.left)) ≤
        a3i_stalkIdeal (a3n_T X).left (a3n_σ X c x) w := by
      rw [he, Ideal.span_le, Set.singleton_subset_iff]
      exact hmem
    have hsp := (a3y_pt_le_iff (a3n_σ X c x)
      (a3n_σ X c (genericPoint X.left)) w hE hw).mp hle
    exact a3k_not_mem_range_σ X hdom c hc
      (a3n_mem_range_σ_of_specializes X c hsp)
  exact IntersectionProductScaf_serreMult_principal_right _ _ w _ r he hr
    (IntersectionProductScaf_primeQuotient_regular _ r hnot)
#print axioms IntersectionProductScaf_sectionDivisor_serreMult
/-- A dominating prime meets a parameter section in its fundamental intersection cycle. -/
theorem IntersectionProductScaf_sectionDivisor_prime_fundCycle
    (c : ℂ) (hc : c = 0 ∨ c = 1) (w : (a3n_T X).left)
