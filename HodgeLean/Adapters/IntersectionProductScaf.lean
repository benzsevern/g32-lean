/-- Every component prime of a translated cone contracts trivially along the translation
parameter polynomial map. -/
theorem IntersectionProductScaf_translatedCone_component_parameter_comap
    (I : Ideal (MvPolynomial (Fin (n + 1) ⊕ Unit) ℂ)) [I.IsPrime]
