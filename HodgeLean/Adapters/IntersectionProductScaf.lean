/-- Homogeneous cone component primes contract through both localizations to polynomial cone components. -/
theorem IntersectionProductScaf_familyChartCone_contracted_minimalPrime
    (M : σ × σ → ℂ) (j : Fin (a3s_N X + 1))
    (hj : MvPolynomial.X j ∉ (a3s_CX X).prime (genericPoint X.left))
