/-- Translation endpoint regularity persists through extension of the square family. -/
theorem IntersectionProductScaf_squareFamily_translation_regular_equation
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom]
    {n : ℕ} {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (hn : height (genericPoint X.left) = n)
    (M : Fin (n + 1) × Fin (n + 1) → ℂ)
    (y : (a3n_T X).left) (c : ℂ) (hc : c = 0 ∨ c = 1) :
    let I := IntersectionProductScaf_squarePrimeIdeal M a hfin y
    ∀ x : ((a3n_σ (a3n_T X) c).ker.comap I.subschemeι).subscheme,
      ∃ r : I.subscheme.presheaf.stalk
          (((a3n_σ (a3n_T X) c).ker.comap I.subschemeι).subschemeι x),
        IsSMulRegular (I.subscheme.presheaf.stalk
          (((a3n_σ (a3n_T X) c).ker.comap I.subschemeι).subschemeι x)) r ∧
        RingHom.ker ((((a3n_σ (a3n_T X) c).ker.comap I.subschemeι).subschemeι).stalkMap x).hom =
          Ideal.span {r} := by
  let I := ccm3_inverseIdeal (IntersectionProductScaf_familyMap₁ X hfin M).left
    ((a3h_G (a3h_πO X hfin)).left y)
  let j := (IntersectionProductScaf_familyInclusion (a3n_T X) M).left
  have : IsAffineHom j := IntersectionProductScaf_familyInclusion_affine (a3n_T X) M
  exact IntersectionProductScaf_image_regular_equation j I (a3n_σ (a3n_T X) c).ker
    (IntersectionProductScaf_section_principal (a3n_T X) c)
    (IntersectionProductScaf_squareOpen_translation_regular_equation X hfin hn M _ c hc)
#print axioms IntersectionProductScaf_squareFamily_translation_regular_equation
