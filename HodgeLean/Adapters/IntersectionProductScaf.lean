/-- The finite set of boundary-component and comparison-cycle pairs relevant to good position. -/
def IntersectionProductScaf_pieceBetaSupport (beta : AlgebraicCycle X.left ℚ)
    (S : Finset (a3n_T X).left) : Finset (X.left × X.left) :=
  (IntersectionProductScaf_pieceSupport S).product (a3m_support_finite beta).toFinset

/-- Every pair occurring in the good-position assertion lies in `pieceBetaSupport`. -/
theorem IntersectionProductScaf_mem_pieceBetaSupport
    (beta : AlgebraicCycle X.left ℚ) (S : Finset (a3n_T X).left)
    (D v : X.left) (hD : ∃ y ∈ S, a3k_piece X y D ≠ 0) (hv : beta v ≠ 0) :
    (D, v) ∈ IntersectionProductScaf_pieceBetaSupport beta S := by
  exact Finset.mk_mem_product (IntersectionProductScaf_mem_pieceSupport S D hD)
    ((a3m_support_finite beta).mem_toFinset.mpr hv)

