/-- A regular affine quotient equation remains regular in the subscheme stalk. -/
theorem IntersectionProductScaf_affine_equation_stalk_regular
    {Y : Scheme} (I : Y.IdealSheafData) (U : Y.affineOpens) (r : Γ(Y, U))
    (hr : IsSMulRegular (Γ(Y, U) ⧸ I.ideal U) r)
    (x : I.subscheme) (hx : I.subschemeι x ∈ U.1) :
    IsSMulRegular (I.subscheme.presheaf.stalk x)
      (I.subschemeι.stalkMap x (Y.presheaf.germ U.1 (I.subschemeι x) hx r)) := by
  let J := I
  let g := (J.subschemeι.stalkMap x).hom
  let _ := TopCat.Presheaf.algebra_section_stalk Y.presheaf (⟨J.subschemeι x, hx⟩ : U.1)
  have := U.2.isLocalization_stalk ⟨J.subschemeι x, hx⟩
  let P := (U.2.primeIdealOf ⟨J.subschemeι x, hx⟩).asIdeal
  have hlocal := IntersectionProductScaf_regular_localizedQuotient
    (L := Y.presheaf.stalk (J.subschemeι x)) P.primeCompl (J.ideal U) r
    hr
  have hker := a3l_ker_stalkMap_subschemeι J x U hx
  change RingHom.ker g = (J.ideal U).map (algebraMap Γ(Y, U)
    (Y.presheaf.stalk (J.subschemeι x))) at hker
  rw [← hker] at hlocal
  let e := RingHom.quotientKerEquivOfSurjective (J.subschemeι.stalkMap_surjective x)
  intro a b hab
  apply e.symm.injective
  apply hlocal
  change Ideal.Quotient.mk (RingHom.ker g)
      (Y.presheaf.germ U.1 (J.subschemeι x) hx r) * e.symm a =
    Ideal.Quotient.mk (RingHom.ker g)
      (Y.presheaf.germ U.1 (J.subschemeι x) hx r) * e.symm b
  have he := congrArg e.symm hab
  change e.symm (g (Y.presheaf.germ U.1 (J.subschemeι x) hx r) * a) =
    e.symm (g (Y.presheaf.germ U.1 (J.subschemeι x) hx r) * b) at he
  rw [map_mul, map_mul] at he
  have hg : e.symm (g (Y.presheaf.germ U.1 (J.subschemeι x) hx r)) =
      Ideal.Quotient.mk (RingHom.ker g) (Y.presheaf.germ U.1 (J.subschemeι x) hx r) := by
    apply e.injective
    rw [e.apply_symm_apply]
    rfl
  rwa [hg] at he
#print axioms IntersectionProductScaf_affine_equation_stalk_regular

