/-- An unramified spatial neighborhood gives an unramified stalk after adjoining the projective parameter. -/
theorem IntersectionProductScaf_product_stalk_unramified_of_neighborhood
    {X Y : Over (Spec ↧ℂ)} (f : X ⟶ Y) (A : CommRingCat.{0})
    (j : Spec A ⟶ X.left) [IsOpenImmersion j] [FormallyUnramified (j ≫ f.left)]
    (y : (a3n_T X).left) (hy : y ∈ a3h_U X)
    (hx : (a3n_q X).left y ∈ Set.range j) :
    ((a3h_G f).left.stalkMap y).hom.FormallyUnramified := by
  let U : Over (Spec ↧ℂ) := Over.mk (j ≫ X.hom)
  let jo : U ⟶ X := Over.homMk j rfl
  have : IsOpenImmersion jo.left := inferInstanceAs (IsOpenImmersion j)
  have : FormallyUnramified (jo ≫ f).left := inferInstanceAs (FormallyUnramified (j ≫ f.left))
  have : FormallyUnramified (a3h_G (jo ≫ f)).left := by
    rw [Over.whiskerRight_left]
    exact MorphismProperty.pullbackMap (P := @FormallyUnramified)
      (inferInstance : FormallyUnramified (jo ≫ f).left)
      (inferInstance : FormallyUnramified (𝟙 a3n_P1.left))
      (Over.w (jo ≫ f)).symm (Category.id_comp _).symm
  have : IsOpenImmersion (a3h_G jo).left := by
    rw [Over.whiskerRight_left]
    exact MorphismProperty.pullbackMap (P := @IsOpenImmersion)
      (inferInstance : IsOpenImmersion jo.left)
      (inferInstance : IsOpenImmersion (𝟙 a3n_P1.left))
      (Over.w jo).symm (Category.id_comp _).symm
  obtain ⟨q, hq⟩ : (a3h_e X).hom y ∈ Set.range (a3m_prodChart j (g3c_chartι 1 0)) := by
    rw [a3m_range_prodChart]
    change _ ∈ Set.range j ∧ _
    rw [a3h_e_fst_apply]
    exact ⟨hx, (a3h_mem_U_iff X y).mp hy⟩
  let u := (a3h_e U).inv (a3m_prodChart (𝟙 (Spec A)) (g3c_chartι 1 0) q)
  have hu : (a3h_G jo).left u = y := by
    apply (a3h_e X).hom.isOpenEmbedding.injective
    have hh := congrArg (fun m => m q)
      (IntersectionProductScaf_productMap_chart jo A (𝟙 (Spec A)))
    refine Eq.trans ?_ hq
    simp only [Category.id_comp, Scheme.Hom.comp_apply] at hh
    convert hh using 1
    rfl
  have he : (a3h_G jo).left ≫ (a3h_G f).left = (a3h_G (jo ≫ f)).left := by
    simp only [a3h_G, MonoidalCategory.comp_whiskerRight, Over.comp_left]
  have : FormallyUnramified ((a3h_G jo).left ≫ (a3h_G f).left) := by
    rw [he]
    infer_instance
  rw [← hu]
  exact IntersectionProductScaf_stalk_unramified_of_open_source
    (a3h_G jo).left (a3h_G f).left u (FormallyUnramified.stalkMap _ u)
#print axioms IntersectionProductScaf_product_stalk_unramified_of_neighborhood

/-- A general finite product projection is unramified at each selected point dominating the parameter. -/
theorem IntersectionProductScaf_generic_product_projection_stalk_unramified
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom]
    {n : ℕ} (S : Finset (a3n_T X).left) (hn : Order.height (genericPoint X.left) = n) :
    a3r_Generic {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ |
      ∀ hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
          (a3r_lin (a3r_mat a)).toRingHom).Finite,
        ∀ y ∈ S, a3n_h X y = genericPoint (g3c_P 1) →
          ((a3h_G (a3h_πO X hfin)).left.stalkMap y).hom.FormallyUnramified} := by
  have H := a3r_generic_iInter S _ fun y _ =>
    IntersectionProductScaf_generic_projection_unramified_neighborhood X hn ((a3n_q X).left y)
  refine H.mono ?_
  intro a ha hfin y hy hdom
  obtain ⟨A, j, hj, hx, hun⟩ := ha y hy hfin
  have : IsOpenImmersion j := hj
  have : FormallyUnramified (j ≫ (a3h_πO X hfin).left) := hun
  exact IntersectionProductScaf_product_stalk_unramified_of_neighborhood
    (a3h_πO X hfin) A j y (IntersectionProductScaf_parameter_generic_mem_U X y hdom) hx
#print axioms IntersectionProductScaf_generic_product_projection_stalk_unramified

/-- Away from the ambient generic point and whole constant fibres, a general projection has unit self coefficient. -/
theorem IntersectionProductScaf_zero_self_coefficient
    (S : Finset (a3n_T X).left) (hn : Order.height (genericPoint X.left) = n) :
    a3r_Generic {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ |
