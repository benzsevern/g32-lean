/-- The parameter divisor has coefficient minus one along the one section. -/
theorem IntersectionProductScaf_parameter_one_weight
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom] :
    a3k_cycT X (a3n_σ X 1 (genericPoint X.left)) = -1 := by
