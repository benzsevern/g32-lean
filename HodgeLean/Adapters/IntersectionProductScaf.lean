/-- After extension to complex scalars, the affine coordinate section is the complex chart variable. -/
theorem IntersectionProductScaf_complex_parameter_chart_coordinate_app :
    let U := Proj.basicOpen (UniversalGrading.{0} 1) (MvPolynomial.X 0)
    ∀ h : (⊤ : (Spec (a3m_PnT 1 0)).Opens) ≤
        ((a3m_Pnκ 1 0) ≫ a3n_π) ⁻¹ᵁ U,
      ((a3m_Pnκ 1 0) ≫ a3n_π).appLE U ⊤ h a3k_S1 =
        (Scheme.ΓSpecIso (a3m_PnT 1 0)).inv (a3n_chartEquiv 0 Polynomial.X) := by
  intro U h
  let φ := CommRingCat.ofHom
    (Algebra.TensorProduct.includeRight (R := ℤ) (A := ℂ) (B := a3n_A 0)).toRingHom
  have he : (a3m_Pnκ 1 0) ≫ a3n_π = Spec.map φ ≫ g3c_chartι 1 0 :=
    a3m_prodChart_snd _ _
  have h0 : (⊤ : (Spec (.of a3m_Away1)).Opens) ≤ (g3c_chartι 1 0) ⁻¹ᵁ U :=
    fun x _ => a3k_mem_basicOpen_X0 _ ⟨x, rfl⟩
  revert h
  rw [he]
  intro h
  rw [← Scheme.Hom.appLE_comp_appLE (Spec.map φ) (g3c_chartι 1 0) U ⊤ ⊤ h0 (by simp)]
  change (Spec.map φ).appTop ((g3c_chartι 1 0).appLE U ⊤ h0 a3k_S1) = _
  rw [IntersectionProductScaf_parameter_chart_coordinate_app]
  have H := congrArg (fun f => f a3m_t₁) (Scheme.ΓSpecIso_inv_naturality φ)
  rw [a3n_chartEquiv_X]
