/-- The finite set of all boundary components contributed by members of `S`. -/
def IntersectionProductScaf_pieceSupport (S : Finset (a3n_T X).left) : Finset X.left :=
  S.biUnion fun y => (a3m_support_finite (a3k_piece X y)).toFinset

/-- Every nonzero boundary component contributed by `S` lies in `pieceSupport`. -/
theorem IntersectionProductScaf_mem_pieceSupport
    (S : Finset (a3n_T X).left) (D : X.left)
    (hD : ∃ y ∈ S, a3k_piece X y D ≠ 0) :
    D ∈ IntersectionProductScaf_pieceSupport S := by
  obtain ⟨y, hy, hpiece⟩ := hD
  rw [IntersectionProductScaf_pieceSupport, Finset.mem_biUnion]
  exact ⟨y, hy, (a3m_support_finite (a3k_piece X y)).mem_toFinset.mpr hpiece⟩

