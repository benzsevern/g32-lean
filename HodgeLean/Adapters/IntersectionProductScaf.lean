/-- A restricted prime cycle has zero coefficient outside the specialization locus of its prime. -/
theorem IntersectionProductScaf_prime_restriction_zero
    (Y : Scheme) [IsNoetherian Y] (J : Y.IdealSheafData) (z : Y) (x : J.subscheme)
    (hz : ¬ z ⤳ J.subschemeι x) :
    a2g_fundCycle (((ccm3_primeIdeal Y z).comap J.subschemeι).subschemeι) x = 0 := by
  classical
  have : IsLocallyNoetherian J.subscheme := LocallyOfFiniteType.isLocallyNoetherian J.subschemeι
  have := a2g_subscheme_noetherianSpace J
  have : IsNoetherian J.subscheme := ⟨⟩
  have := a2g_subscheme_noetherianSpace ((ccm3_primeIdeal Y z).comap J.subschemeι)
  apply IntersectionProductScaf_fundCycle_apply_of_not_mem_range _
    (genericPoints.finite TopologicalSpace.NoetherianSpace.finite_irreducibleComponents)
  rw [Scheme.IdealSheafData.range_subschemeι, Scheme.IdealSheafData.support_comap,
    TopologicalSpace.Closeds.coe_preimage]
  change J.subschemeι x ∉ ((ccm3_primeIdeal Y z).support : Set Y)
  simpa only [ccm3_primeIdeal, Scheme.IdealSheafData.coe_support_vanishingIdeal,
    TopologicalSpace.Closeds.coe_mk, ← specializes_iff_mem_closure] using hz
#print axioms IntersectionProductScaf_prime_restriction_zero


