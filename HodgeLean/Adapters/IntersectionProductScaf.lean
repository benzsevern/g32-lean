/-- Product extension of a morphism commutes with every parameter section. -/
theorem IntersectionProductScaf_product_map_section
    {X Y : Over (Spec ↧ℂ)} (g : X ⟶ Y) (c : ℂ) :
    a3n_σ X c ≫ (a3h_G g).left = g.left ≫ a3n_σ Y c := by
  apply CategoryTheory.Limits.pullback.hom_ext
  · change (a3n_σ X c ≫ (a3h_G g).left) ≫ (a3n_q Y).left =
      (g.left ≫ a3n_σ Y c) ≫ (a3n_q Y).left
    rw [Category.assoc, a3h_G_q, ← Category.assoc, a3n_σ_q,
      Category.id_comp, Category.assoc, a3n_σ_q, Category.comp_id]
  · change (a3n_σ X c ≫ (a3h_G g).left) ≫ a3n_p Y =
      (g.left ≫ a3n_σ Y c) ≫ a3n_p Y
    rw [Category.assoc, a3h_G_p, a3n_σ_p, Category.assoc, a3n_σ_p,
      ← Category.assoc, g.w]
