/-- The affine coordinate itself generates the zero-section prime in every ambient stalk. -/
theorem IntersectionProductScaf_section_zero_coordinate_equation
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom]
    (x : X.left) :
    a3i_stalkIdeal (a3n_T X).left (a3n_σ X 0 x)
      (a3n_σ X 0 (genericPoint X.left)) =
      Ideal.span {a3k_t1 X (a3n_σ X 0 x) (a3k_mem_basicOpen_σ X x 0 (Or.inl rfl))} := by
  have hx : a3n_p X (a3n_σ X 0 x) ∈
      (a3m_Pnκ 1 0) ''ᵁ (⊤ : (Spec (a3m_PnT 1 0)).Opens) := by
    rw [a3k_p_σ]
    exact ⟨Spec.map (CommRingCat.ofHom (a3n_evc 0)) a3n_o, by trivial, rfl⟩
  have he := IntersectionProductScaf_section_chart_equation X 0 x hx
  dsimp only at he
  simp only [Polynomial.C_0, sub_zero] at he
  rw [IntersectionProductScaf_complex_parameter_coordinate_germ _ hx
    (a3k_mem_basicOpen_σ X x 0 (Or.inl rfl))] at he
  rw [← CommRingCat.comp_apply, ← Scheme.Hom.stalkMap_comp] at he
  exact he
