    (IntersectionProductScaf_section_components_of_fibre_height (a3n_T (a3n_T X))
      (a3n_σ (a3n_T X) c) I _ hh)
  have hs : (a3m_support_finite (a3m_smul q C)).toFinset =
      (a3m_support_finite C).toFinset := by
    ext w
    simp only [Set.Finite.mem_toFinset, Function.mem_support, a3m_smul_apply,
