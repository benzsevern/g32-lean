/-- A finite morphism is flat when regular parameter sequences exist on every localized affine inverse image. -/
theorem IntersectionProductScaf_finite_flat_of_regular_parameters
    {Y Z : Scheme} [IsLocallyNoetherian Z] (f : Y ⟶ Z) [AlgebraicGeometry.IsFinite f]
    (hreg : ∀ U : Z.affineOpens,
      let g := f ∣_ U.1
      letI := g.appTop.hom.toAlgebra
      ∀ (P : Ideal Γ(U.1.toScheme, ⊤)) [P.IsMaximal],
        ∃ rs : List (Localization.AtPrime P),
          Ideal.ofList rs = maximalIdeal (Localization.AtPrime P) ∧
          IsWeaklyRegular (LocalizedModule P.primeCompl Γ((f ⁻¹ᵁ U.1).toScheme, ⊤)) rs) :
    Flat f := by
  rw [IsZariskiLocalAtTarget.iff_of_iSup_eq_top (P := @Flat) _ (iSup_affineOpens_eq_top Z)]
  intro U
  letI : IsAffine U.1.toScheme := U.2
  letI : IsAffine (f ⁻¹ᵁ U.1).toScheme := U.2.preimage f
  exact IntersectionProductScaf_finite_affine_flat_of_regular_parameters (f ∣_ U.1) (hreg U)
#print axioms IntersectionProductScaf_finite_flat_of_regular_parameters

open CategoryTheory.Limits in
open scoped MonoidalCategory in
/-- Vanishing of first Tor with the residue field makes a finite module over a Noetherian local ring free. -/
theorem IntersectionProductScaf_free_of_residue_tor_vanish
    (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
    (M : ModuleCat.{u} R) [Module.Finite R M]
    (hTor : IsZero (((Tor (ModuleCat.{u} R) 1).obj M).obj
      (ModuleCat.of R (ResidueField R)))) : Module.Free R M := by
  obtain ⟨m, f, hf⟩ := Module.Finite.exists_fin' R M
  let S := f.shortComplexKer
  have hS : S.ShortExact := LinearMap.shortExact_shortComplexKer hf
  have : Module.Projective R (Fin m → R) := Module.Projective.of_free
  have : Projective S.X₂ := (IsProjective.iff_projective (R := R) S.X₂).mp this
  have : Module.Finite R (LinearMap.ker f) := Module.Finite.of_injective
    (LinearMap.ker f).subtype Subtype.val_injective
  let k := ModuleCat.of R (ResidueField R)
  let Q := ProjectiveResolution.of k
  have hz : IsZero ((a3c_tensC M Q.complex).homology 1) :=
    hTor.of_iso (a3c_torIso M k Q 1).symm
  have hker : IsZero (kernel (S.f ▷ k)) := hz.of_iso (a3c_H1IsoA Q S hS).symm
  have hm : Mono (S.f ▷ k) := Preadditive.mono_of_isZero_kernel _ hker
  have hi : Function.Injective ((LinearMap.ker f).subtype.rTensor (ResidueField R)) :=
    (ModuleCat.mono_iff_injective _).mp hm
  exact Module.free_of_lTensor_residueField_injective (LinearMap.ker f).subtype f hf
    f.exact_subtype_ker_map ((LinearMap.lTensor_inj_iff_rTensor_inj _ _).mpr hi)
#print axioms IntersectionProductScaf_free_of_residue_tor_vanish

open CategoryTheory.Limits in
/-- A full-length regular sequence makes a finite module over a regular local ring free. -/
theorem IntersectionProductScaf_free_of_full_regular_sequence
    (R : Type u) [CommRing R] [IsRegularLocalRing R]
    (M : ModuleCat.{u} R) [Module.Finite R M]
    (rs : List R) (hreg : RingTheory.Sequence.IsWeaklyRegular M rs)
    (hmem : ∀ r ∈ rs, r ∈ maximalIdeal R)
    (hlen : (rs.length : WithBot ℕ∞) = ringKrullDim R) : Module.Free R M := by
  obtain ⟨xs, hxslen, hxs, -, hxsreg⟩ := a3c_exists_regular_sop R
  have hlength : xs.length = rs.length := by exact_mod_cast hxslen.trans hlen.symm
  have : IsArtinian R (ResidueField R) :=
    isArtinian_of_surjective_algebraMap (R := ResidueField R) Ideal.Quotient.mk_surjective
  apply IntersectionProductScaf_free_of_residue_tor_vanish R M
  obtain ⟨e⟩ := a3c_tor_symm (ModuleCat.of R (ResidueField R)) 1 M
  apply IsZero.of_iso _ e
  exact a3c_isZero_tor_of_finiteLength_left xs hxsreg hxs
    (ModuleCat.of R (ResidueField R)) (isFiniteLength_iff_isNoetherian_isArtinian.mpr ⟨inferInstance, inferInstance⟩)
    rs M hreg hmem 1 (by omega)
#print axioms IntersectionProductScaf_free_of_full_regular_sequence

open CategoryTheory.Limits in
/-- A nilpotent endomorphism on tensor homology forces vanishing when the next quotient homology vanishes. -/
theorem IntersectionProductScaf_tor_vanish_of_nilpotent_endomorphism
    {R : Type u} [CommRing R] (M N C : ModuleCat.{u} R)
    (f : M ⟶ M) (g : M ⟶ C) (hfg : f ≫ g = 0)
    (hex : (ShortComplex.mk f g hfg).ShortExact)
    (Q : ProjectiveResolution N) (n K : ℕ)
    (hnext : IsZero (((Tor (ModuleCat.{u} R) (n + 1)).obj C).obj N))
    (hnil : ∀ t : (a3c_tensC M Q.complex).homology n,
      ((HomologicalComplex.homologyMap (a3c_tensMap f Q.complex) n).hom^[K]) t = 0) :
    IsZero (((Tor (ModuleCat.{u} R) n).obj M).obj N) := by
  have hm := a3c_mono_of_isZero Q (ShortComplex.mk f g hfg) hex n
    (hnext.of_iso (a3c_torIso C N Q (n + 1)).symm)
  have hinj : Function.Injective
      (HomologicalComplex.homologyMap (a3c_tensMap f Q.complex) n).hom :=
    (ModuleCat.mono_iff_injective _).mp hm
  apply IsZero.of_iso _ (a3c_torIso M N Q n)
  rw [ModuleCat.isZero_iff_subsingleton]
  exact ⟨fun a b => (hinj.iterate K) ((hnil a).trans (hnil b).symm)⟩
#print axioms IntersectionProductScaf_tor_vanish_of_nilpotent_endomorphism

/-- Tensor homology as a functor of the coefficient module. -/
def IntersectionProductScaf_tensorHomologyFunctor
    {R : Type u} [CommRing R] (C : ChainComplex (ModuleCat.{u} R) ℕ) (n : ℕ) :
    ModuleCat.{u} R ⥤ ModuleCat.{u} R where
  obj M := (a3c_tensC M C).homology n
  map f := HomologicalComplex.homologyMap (a3c_tensMap f C) n
  map_id M := by
    have h : a3c_tensMap (𝟙 M) C = 𝟙 _ := by ext i; simp
    rw [h, HomologicalComplex.homologyMap_id]
  map_comp f g := by
    have h : a3c_tensMap (f ≫ g) C = a3c_tensMap f C ≫ a3c_tensMap g C := by
      ext i
      simp [← MonoidalCategory.comp_whiskerRight]
    rw [h, HomologicalComplex.homologyMap_comp]
#print axioms IntersectionProductScaf_tensorHomologyFunctor


/-- Tensor homology preserves addition of coefficient maps. -/
theorem IntersectionProductScaf_tensorHomologyFunctor_additive
    {R : Type u} [CommRing R] (C : ChainComplex (ModuleCat.{u} R) ℕ) (n : ℕ) :
    (IntersectionProductScaf_tensorHomologyFunctor C n).Additive where
  map_add {M N f g} := by
    change HomologicalComplex.homologyMap (a3c_tensMap (f + g) C) n = _
    have h : a3c_tensMap (f + g) C = a3c_tensMap f C + a3c_tensMap g C := by
      ext i
      simp
    rw [h, HomologicalComplex.homologyMap_add]
    rfl
#print axioms IntersectionProductScaf_tensorHomologyFunctor_additive

/-- Coefficient endomorphisms act as a ring on tensor homology. -/
def IntersectionProductScaf_tensorHomologyEnd
    {R : Type u} [CommRing R] (C : ChainComplex (ModuleCat.{u} R) ℕ) (n : ℕ)
    (M : ModuleCat.{u} R) :
    Module.End R M →+* Module.End R ((a3c_tensC M C).homology n) := by
  let F := IntersectionProductScaf_tensorHomologyFunctor C n
  have : F.Additive := IntersectionProductScaf_tensorHomologyFunctor_additive C n
  let q : End M →+* End (F.obj M) :=
    { F.mapEnd M with
      map_zero' := by apply End.ext; exact F.map_zero _ _
      map_add' := by intro a b; apply End.ext; exact F.map_add }
  exact (ModuleCat.endRingEquiv (F.obj M)).toRingHom.comp
    (q.comp (ModuleCat.endRingEquiv M).symm.toRingHom)
#print axioms IntersectionProductScaf_tensorHomologyEnd

/-- The endomorphism action of a base scalar is its usual action on tensor homology. -/
theorem IntersectionProductScaf_tensorHomologyEnd_scalar
    {R : Type u} [CommRing R] (C : ChainComplex (ModuleCat.{u} R) ℕ) (n : ℕ)
    (M : ModuleCat.{u} R) (r : R) :
    IntersectionProductScaf_tensorHomologyEnd C n M (r • LinearMap.id) = r • LinearMap.id := by
  exact congrArg ModuleCat.Hom.hom (a3c_homologyMap_tensMap_smul M r C n)
#print axioms IntersectionProductScaf_tensorHomologyEnd_scalar

/-- The extended annihilator of the second factor kills the coefficient action on tensor homology. -/
theorem IntersectionProductScaf_tensorHomologyEnd_annihilator
    {R B : Type u} [CommRing R] [CommRing B] [Algebra R B]
    (M N : ModuleCat.{u} R) [Module B M] [IsScalarTower R B M]
    (Q : ProjectiveResolution N) (n : ℕ) :
    (Module.annihilator R N).map (algebraMap R B) ≤
      RingHom.ker ((IntersectionProductScaf_tensorHomologyEnd Q.complex n M).comp
        (Algebra.lsmul R R M (A := B)).toRingHom) := by
  apply Ideal.map_le_iff_le_comap.mpr
  intro r hr
  change IntersectionProductScaf_tensorHomologyEnd Q.complex n M
    (Algebra.lsmul R R M (algebraMap R B r)) = 0
  have hs : Algebra.lsmul R R M (algebraMap R B r) = r • LinearMap.id := by
    ext m
    simp [Algebra.lsmul_apply, algebraMap_smul]
  rw [hs, IntersectionProductScaf_tensorHomologyEnd_scalar]
  ext t
  obtain ⟨t, rfl⟩ := (a3c_torIso M N Q n).toLinearEquiv.surjective t
  change r • (a3c_torIso M N Q n).toLinearEquiv t = 0
  rw [← map_smul, a3c_smul_tor_eq_zero_of_mem_annihilator_right M N r hr n t, map_zero]
#print axioms IntersectionProductScaf_tensorHomologyEnd_annihilator

open CategoryTheory.Limits in
set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
/-- A regular coefficient from a larger algebra descends Tor vanishing when a power lies in the extended annihilator. -/
theorem IntersectionProductScaf_tor_vanish_of_regular_coefficient
    {R B : Type u} [CommRing R] [CommRing B] [Algebra R B]
    (M : ModuleCat.{u} B) (N : ModuleCat.{u} R) (b : B)
    (hb : IsSMulRegular M b) (n : ℕ)
    (hpow : ∃ K : ℕ, b ^ K ∈ (Module.annihilator R N).map (algebraMap R B))
    (hnext : IsZero (((Tor (ModuleCat.{u} R) (n + 1)).obj
      ((ModuleCat.restrictScalars (algebraMap R B)).obj
        (ModuleCat.of B (QuotSMulTop b M)))).obj N)) :
    IsZero (((Tor (ModuleCat.{u} R) n).obj
      ((ModuleCat.restrictScalars (algebraMap R B)).obj M)).obj N) := by
  let F := ModuleCat.restrictScalars (algebraMap R B)
  let MR := F.obj M
  have : IsScalarTower R B MR := IsScalarTower.of_algebraMap_smul fun _ _ => rfl
  let S := (M.smulShortComplex b).map F
  have hSB := hb.smulShortComplex_shortExact
  have : Mono (M.smulShortComplex b).f := hSB.mono_f
  have : Epi (M.smulShortComplex b).g := hSB.epi_g
  have hS : S.ShortExact := hSB.map F
  let Q := ProjectiveResolution.of N
  let a : B →+* Module.End R ((a3c_tensC MR Q.complex).homology n) :=
    (IntersectionProductScaf_tensorHomologyEnd Q.complex n MR).comp
      (Algebra.lsmul R R MR (A := B)).toRingHom
  obtain ⟨K, hK⟩ := hpow
  have ha : a b ^ K = 0 := by
    rw [← map_pow]
    exact IntersectionProductScaf_tensorHomologyEnd_annihilator MR N Q n hK
  apply IntersectionProductScaf_tor_vanish_of_nilpotent_endomorphism
    MR N S.X₃ S.f S.g S.zero hS Q n K hnext
  intro t
  change (a b)^[K] t = 0
  rw [← Module.End.pow_apply, ha, LinearMap.zero_apply]
#print axioms IntersectionProductScaf_tor_vanish_of_regular_coefficient

open CategoryTheory.Limits in
set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
/-- A regular sequence in an algebra lowers the residue-field Tor bound by its length. -/
theorem IntersectionProductScaf_tor_vanish_of_algebra_regular_sequence
    {R B : Type u} [CommRing R] [CommRing B] [Algebra R B] [IsLocalRing R]
    (xs : List R) (hxs : IsWeaklyRegular R xs) (hspan : Ideal.ofList xs = maximalIdeal R)
    (ss : List B) (M : ModuleCat.{u} B) (hreg : IsWeaklyRegular M ss)
    (hpow : ∀ b ∈ ss, ∃ K : ℕ, b ^ K ∈
      (Module.annihilator R (ResidueField R)).map (algebraMap R B))
    (n : ℕ) (hn : xs.length < n + ss.length) :
    IsZero (((Tor (ModuleCat.{u} R) n).obj
      ((ModuleCat.restrictScalars (algebraMap R B)).obj M)).obj
        (ModuleCat.of R (ResidueField R))) := by
  induction ss generalizing M n with
  | nil =>
      obtain ⟨e⟩ := a3c_tor_symm (ModuleCat.of R (ResidueField R)) n
        ((ModuleCat.restrictScalars (algebraMap R B)).obj M)
      apply IsZero.of_iso _ e
      exact a3c_isZero_tor_residue xs hxs hspan _ n (by simpa using hn)
  | cons b ss ih =>
      obtain ⟨hb, hs⟩ := (isWeaklyRegular_cons_iff M b ss).mp hreg
      apply IntersectionProductScaf_tor_vanish_of_regular_coefficient M (ModuleCat.of R (ResidueField R)) b hb n
        (hpow b (by simp))
      exact ih (ModuleCat.of B (QuotSMulTop b M)) hs
        (fun c hc => hpow c (by simp [hc])) (n + 1) (by simp only [List.length_cons] at hn; omega)
#print axioms IntersectionProductScaf_tor_vanish_of_algebra_regular_sequence

/-- In an integral local algebra, the extended maximal ideal has the target maximal ideal as its radical. -/
theorem IntersectionProductScaf_integral_local_maximal_radical
    {R B : Type u} [CommRing R] [CommRing B] [Algebra R B]
    [IsLocalRing R] [IsLocalRing B] [IsLocalHom (algebraMap R B)]
    [Algebra.IsIntegral R B] :
    ((maximalIdeal R).map (algebraMap R B)).radical = maximalIdeal B := by
  apply le_antisymm
  · exact (Ideal.IsPrime.radical_le_iff (inferInstance : (maximalIdeal B).IsPrime)).mpr (map_maximalIdeal_le (algebraMap R B))
  · rw [Ideal.radical_eq_sInf]
    apply le_sInf
    rintro P ⟨hP, hprime⟩
    have : P.IsPrime := hprime
    have heq : P.under R = maximalIdeal R :=
      (Ideal.IsMaximal.eq_of_le (maximalIdeal.isMaximal R)
        (Ideal.IsPrime.ne_top (inferInstance : (P.under R).IsPrime))
        (Ideal.map_le_iff_le_comap.mp hP)).symm
    have hmax : (P.under R).IsMaximal := heq.symm ▸ maximalIdeal.isMaximal R
    exact (eq_maximalIdeal (Ideal.isMaximal_of_isIntegral_of_isMaximal_under P hmax)).ge
#print axioms IntersectionProductScaf_integral_local_maximal_radical

open CategoryTheory.Limits in
set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
/-- A finite local algebra between regular local rings is free when the target dimension is at least the source dimension. -/
theorem IntersectionProductScaf_finite_local_regular_free
    (R B : Type u) [CommRing R] [CommRing B] [Algebra R B]
    [IsRegularLocalRing R] [IsRegularLocalRing B]
    [IsLocalHom (algebraMap R B)] [Module.Finite R B]
    (hdim : ringKrullDim R ≤ ringKrullDim B) : Module.Free R B := by
  obtain ⟨xs, hxlen, hxspan, -, hxreg⟩ := a3c_exists_regular_sop R
  obtain ⟨ss, hslen, hsspan, -, hsreg⟩ := a3c_exists_regular_sop B
  have hlen : xs.length ≤ ss.length := by
    have h := hxlen.trans_le (hdim.trans_eq hslen.symm)
    exact_mod_cast h
  let M := (ModuleCat.restrictScalars (algebraMap R B)).obj (ModuleCat.of B B)
  let e : M ≃ₗ[R] B :=
    { __ := AddEquiv.refl B
      map_smul' := fun r b => (Algebra.smul_def (R := R) (A := B) r b).symm }
  have : Module.Finite R M := Module.Finite.equiv e.symm
  apply Module.Free.of_equiv' (N := B) (P := M) ?_ e
  apply IntersectionProductScaf_free_of_residue_tor_vanish R M
  apply IntersectionProductScaf_tor_vanish_of_algebra_regular_sequence xs hxreg hxspan
    ss (ModuleCat.of B B) hsreg
  · intro b hb
    have hm : b ∈ maximalIdeal B := hsspan ▸ Ideal.subset_span (by simpa using hb)
    rw [← IntersectionProductScaf_integral_local_maximal_radical (R := R)] at hm
    simpa only [ResidueField, Ideal.annihilator_quotient, Ideal.mem_radical_iff] using hm
  · omega
#print axioms IntersectionProductScaf_finite_local_regular_free

/-- A parameter in a local algebra has a power in the extended base maximal ideal when the fibre has dimension zero. -/
theorem IntersectionProductScaf_local_fibre_parameter_power
    {R B : Type u} [CommRing R] [CommRing B] [Algebra R B]
    [IsLocalRing R] [IsLocalRing B] [IsLocalHom (algebraMap R B)]
    [Ring.KrullDimLE 0 (B ⧸ (maximalIdeal R).map (algebraMap R B))]
    (b : B) (hb : b ∈ maximalIdeal B) :
    ∃ K : ℕ, b ^ K ∈ (maximalIdeal R).map (algebraMap R B) := by
  let I := (maximalIdeal R).map (algebraMap R B)
  have : Nontrivial (B ⧸ I) := Ideal.Quotient.nontrivial_iff.mpr
    (map_maximalIdeal_lt_top (algebraMap R B)).ne
  have : IsLocalRing (B ⧸ I) := IsLocalRing.of_surjective' (Ideal.Quotient.mk I)
    Ideal.Quotient.mk_surjective
  have hnil : IsNilpotent (Ideal.Quotient.mk I b) :=
    Ring.KrullDimLE.isNilpotent_iff_mem_maximalIdeal.mpr
      (by
        rw [← map_maximalIdeal_of_surjective (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective]
        exact Ideal.mem_map_of_mem _ hb)
  obtain ⟨K, hK⟩ := hnil
  exact ⟨K, Ideal.Quotient.eq_zero_iff_mem.mp (by simpa only [map_pow] using hK)⟩
#print axioms IntersectionProductScaf_local_fibre_parameter_power

open CategoryTheory.Limits in
set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
/-- Regular local algebras with zero-dimensional fibre have vanishing positive residue-field Tor when their dimension is large enough. -/
theorem IntersectionProductScaf_regular_local_algebra_tor_vanish
    (R B : Type u) [CommRing R] [CommRing B] [Algebra R B]
    [IsRegularLocalRing R] [IsRegularLocalRing B]
    [IsLocalHom (algebraMap R B)]
    [Ring.KrullDimLE 0 (B ⧸ (maximalIdeal R).map (algebraMap R B))]
    (hdim : ringKrullDim R ≤ ringKrullDim B) (n : ℕ) (hn : 0 < n) :
    IsZero (((Tor (ModuleCat.{u} R) n).obj
      ((ModuleCat.restrictScalars (algebraMap R B)).obj (ModuleCat.of B B))).obj
        (ModuleCat.of R (ResidueField R))) := by
  obtain ⟨xs, hxlen, hxspan, -, hxreg⟩ := a3c_exists_regular_sop R
  obtain ⟨ss, hslen, hsspan, -, hsreg⟩ := a3c_exists_regular_sop B
  have hlen : xs.length ≤ ss.length := by
    have h := hxlen.trans_le (hdim.trans_eq hslen.symm)
    exact_mod_cast h
  apply IntersectionProductScaf_tor_vanish_of_algebra_regular_sequence xs hxreg hxspan
    ss (ModuleCat.of B B) hsreg
  · intro b hb
    have hm : b ∈ maximalIdeal B := hsspan ▸ Ideal.subset_span (by simpa using hb)
    simpa only [ResidueField, Ideal.annihilator_quotient] using
      (IntersectionProductScaf_local_fibre_parameter_power (R := R) b hm)
  · omega
#print axioms IntersectionProductScaf_regular_local_algebra_tor_vanish

open CategoryTheory.Limits in
set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
/-- Tensor homology with algebra coefficients vanishes exactly when the scalar-extended complex has zero homology. -/
theorem IntersectionProductScaf_tensor_algebra_homology_zero_iff
    {R B : Type u} [CommRing R] [CommRing B] (f : R →+* B)
    (C : ChainComplex (ModuleCat.{u} R) ℕ) (n : ℕ) :
    IsZero ((a3c_tensC ((ModuleCat.restrictScalars f).obj (ModuleCat.of B B)) C).homology n) ↔
      IsZero ((((ModuleCat.extendScalars f).mapHomologicalComplex _).obj C).homology n) := by
  let D := ((ModuleCat.extendScalars f).mapHomologicalComplex _).obj C
  let F := ModuleCat.restrictScalars f
  let e : (a3c_tensC (F.obj (ModuleCat.of B B)) C).homology n ≅ F.obj (D.homology n) :=
    (D.sc n).mapHomologyIso F
  constructor
  · intro h
    have h' := h.of_iso e.symm
    have hs := ModuleCat.isZero_iff_subsingleton.mp h'
    exact ModuleCat.isZero_iff_subsingleton.mpr hs
  · intro h
    apply IsZero.of_iso _ e
    have hs := ModuleCat.isZero_iff_subsingleton.mp h
    exact ModuleCat.isZero_iff_subsingleton.mpr hs
#print axioms IntersectionProductScaf_tensor_algebra_homology_zero_iff

open CategoryTheory.Limits in
open scoped TensorProduct in
set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
/-- Vanishing after extension to every maximal localization detects a zero module. -/
theorem IntersectionProductScaf_isZero_of_local_extendScalars
    {B : Type u} [CommRing B] (M : ModuleCat.{u} B)
    (h : ∀ (P : Ideal B) [P.IsMaximal],
      IsZero ((ModuleCat.extendScalars (algebraMap B (Localization.AtPrime P))).obj M)) :
    IsZero M := by
  have hz (P : Ideal B) [P.IsMaximal] :
      Subsingleton (Localization.AtPrime P ⊗[B] M) := by
    let L := Localization.AtPrime P
    let N := (ModuleCat.restrictScalars (algebraMap B L)).obj (ModuleCat.of L L)
    let e : N ≃ₗ[B] L :=
      { __ := AddEquiv.refl L
        map_smul' := fun r b => (Algebra.smul_def (R := B) (A := L) r b).symm }
    let eT := TensorProduct.congr e (LinearEquiv.refl B M)
    have : Subsingleton (N ⊗[B] M) := ModuleCat.isZero_iff_subsingleton.mp (h P)
    exact eT.surjective.subsingleton
  rw [ModuleCat.isZero_iff_subsingleton]
  refine ⟨fun a b => ?_⟩
  apply Module.eq_of_localization_maximal
    (fun (P : Ideal B) (_ : P.IsMaximal) => Localization.AtPrime P ⊗[B] M)
    (fun P _ => TensorProduct.mk B (Localization.AtPrime P) M 1) a b
  intro P hP
  have := hz P
  exact Subsingleton.elim _ _
#print axioms IntersectionProductScaf_isZero_of_local_extendScalars

open CategoryTheory.Limits in
set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
/-- Flat extension of coefficient algebras commutes with homology of scalar-extended complexes. -/
theorem IntersectionProductScaf_extended_homology_flat_comp_zero_iff
    {R B A : Type u} [CommRing R] [CommRing B] [CommRing A]
    (f : R →+* B) (g : B →+* A) (hg : g.Flat)
    (C : ChainComplex (ModuleCat.{u} R) ℕ) (n : ℕ) :
    IsZero ((((ModuleCat.extendScalars (g.comp f)).mapHomologicalComplex _).obj C).homology n) ↔
      IsZero ((ModuleCat.extendScalars g).obj
        ((((ModuleCat.extendScalars f).mapHomologicalComplex _).obj C).homology n)) := by
  have := a3q_extendScalars_preservesHomology g hg
  let D := ((ModuleCat.extendScalars f).mapHomologicalComplex _).obj C
  let e := HomologicalComplex.homologyMapIso
    ((NatIso.mapHomologicalComplex (ModuleCat.extendScalarsComp f g) _).app C) n ≪≫
    (D.sc n).mapHomologyIso (ModuleCat.extendScalars g)
  exact ⟨fun h => h.of_iso e.symm, fun h => h.of_iso e⟩
#print axioms IntersectionProductScaf_extended_homology_flat_comp_zero_iff

open CategoryTheory.Limits in
set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
/-- Residue-field Tor vanishing at all source maximal localizations makes a finite algebra over a local base free. -/
theorem IntersectionProductScaf_finite_algebra_free_of_local_tor
    (R B : Type u) [CommRing R] [CommRing B] [Algebra R B]
    [IsLocalRing R] [IsNoetherianRing R] [Module.Finite R B]
    (h : ∀ (P : Ideal B) [P.IsMaximal],
      IsZero (((Tor (ModuleCat.{u} R) 1).obj
        ((ModuleCat.restrictScalars ((algebraMap B (Localization.AtPrime P)).comp
          (algebraMap R B))).obj (ModuleCat.of (Localization.AtPrime P) (Localization.AtPrime P)))).obj
            (ModuleCat.of R (ResidueField R)))) : Module.Free R B := by
  let M := (ModuleCat.restrictScalars (algebraMap R B)).obj (ModuleCat.of B B)
  let e : M ≃ₗ[R] B :=
    { __ := AddEquiv.refl B
      map_smul' := fun r b => (Algebra.smul_def (R := R) (A := B) r b).symm }
  have : Module.Finite R M := Module.Finite.equiv e.symm
  apply Module.Free.of_equiv' (N := B) (P := M) ?_ e
  apply IntersectionProductScaf_free_of_residue_tor_vanish R M
  let N := ModuleCat.of R (ResidueField R)
  let Q := ProjectiveResolution.of N
  apply IsZero.of_iso _ (a3c_torIso M N Q 1)
  apply (IntersectionProductScaf_tensor_algebra_homology_zero_iff
    (algebraMap R B) Q.complex 1).mpr
  apply IntersectionProductScaf_isZero_of_local_extendScalars
  intro P hP
  apply (IntersectionProductScaf_extended_homology_flat_comp_zero_iff
    (algebraMap R B) (algebraMap B (Localization.AtPrime P))
    (RingHom.flat_algebraMap_iff.mpr (IsLocalization.flat _ P.primeCompl)) Q.complex 1).mp
  apply (IntersectionProductScaf_tensor_algebra_homology_zero_iff _ Q.complex 1).mp
  exact (h P).of_iso (a3c_torIso _ N Q 1).symm
#print axioms IntersectionProductScaf_finite_algebra_free_of_local_tor

/-- Maximal localizations of an integral algebra over a local ring are local over the base. -/
theorem IntersectionProductScaf_integral_maximal_localization_localHom
    (R B : Type u) [CommRing R] [CommRing B] [Algebra R B]
    [IsLocalRing R] [Algebra.IsIntegral R B] (P : Ideal B) [P.IsMaximal] :
    IsLocalHom (algebraMap R (Localization.AtPrime P)) := by
  apply ((local_hom_TFAE _).out 5 1).mp
  rw [IsScalarTower.algebraMap_eq R B (Localization.AtPrime P), ← Ideal.comap_comap]
  change ((IsLocalRing.maximalIdeal (Localization.AtPrime P)).under B).under R = maximalIdeal R
  rw [IsLocalization.AtPrime.under_maximalIdeal (Localization.AtPrime P) P]
  exact eq_maximalIdeal (Ideal.isMaximal_under_of_isIntegral_of_isMaximal P)
#print axioms IntersectionProductScaf_integral_maximal_localization_localHom

/-- Fibres at maximal localizations of a finite algebra over a local base are Artinian. -/
theorem IntersectionProductScaf_finite_maximal_localization_fibre_artinian
    (R B : Type u) [CommRing R] [CommRing B] [Algebra R B]
    [IsLocalRing R] [Module.Finite R B] (P : Ideal B) [P.IsMaximal] :
    IsArtinianRing (Localization.AtPrime P ⧸
      (maximalIdeal R).map (algebraMap R (Localization.AtPrime P))) := by
  have heq : P.under R = maximalIdeal R :=
    eq_maximalIdeal (Ideal.isMaximal_under_of_isIntegral_of_isMaximal P)
  have : P.LiesOver (maximalIdeal R) := ⟨heq.symm⟩
  infer_instance
#print axioms IntersectionProductScaf_finite_maximal_localization_fibre_artinian

/-- Going down bounds the dimension of a source localization below by the local base dimension. -/
theorem IntersectionProductScaf_goingDown_localization_dimension
    (R B : Type u) [CommRing R] [CommRing B] [Algebra R B]
    [IsLocalRing R] [IsNoetherianRing R] [IsNoetherianRing B]
    [Algebra.HasGoingDown R B] (P : Ideal B) [P.IsPrime]
    [P.LiesOver (maximalIdeal R)] :
    ringKrullDim R ≤ ringKrullDim (Localization.AtPrime P) := by
  rw [← maximalIdeal_height_eq_ringKrullDim,
    IsLocalization.AtPrime.ringKrullDim_eq_height P (Localization.AtPrime P)]
  exact_mod_cast (show (maximalIdeal R).height ≤ P.height from by
    rw [Ideal.height_eq_height_add_of_liesOver_of_hasGoingDown (maximalIdeal R) P]
    exact le_self_add)
#print axioms IntersectionProductScaf_goingDown_localization_dimension

open CategoryTheory.Limits in


set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
/-- A finite algebra over a regular local base is free when its maximal localizations are regular and going down holds. -/
theorem IntersectionProductScaf_finite_regular_algebra_free_of_goingDown
    (R B : Type u) [CommRing R] [CommRing B] [Algebra R B]
    [IsRegularLocalRing R] [Module.Finite R B] [Algebra.HasGoingDown R B]
    (hreg : ∀ (P : Ideal B) [P.IsMaximal], IsRegularLocalRing (Localization.AtPrime P)) :
    Module.Free R B := by
  apply IntersectionProductScaf_finite_algebra_free_of_local_tor R B
  intro P hP
  have := hreg P
  have := IntersectionProductScaf_integral_maximal_localization_localHom R B P
  have := IntersectionProductScaf_finite_maximal_localization_fibre_artinian R B P
  have heq : P.under R = maximalIdeal R :=
    eq_maximalIdeal (Ideal.isMaximal_under_of_isIntegral_of_isMaximal P)
  have : P.LiesOver (maximalIdeal R) := ⟨heq.symm⟩
  have : IsNoetherianRing B := IsNoetherianRing.of_finite R B
  have hdim := IntersectionProductScaf_goingDown_localization_dimension R B P
  simpa only [← IsScalarTower.algebraMap_eq R B (Localization.AtPrime P)] using
    (IntersectionProductScaf_regular_local_algebra_tor_vanish R (Localization.AtPrime P) hdim 1
      (by decide))
#print axioms IntersectionProductScaf_finite_regular_algebra_free_of_goingDown

/-- Localization preserves regularity of every prime local ring. -/
theorem IntersectionProductScaf_regularRing_localization
    (B : Type u) [CommRing B] [IsRegularRing B] (M : Submonoid B) :
    IsRegularRing (Localization M) := by
  apply isRegularRing_iff.mpr
  intro P hP
  let L := Localization.AtPrime P
  have : IsLocalization.AtPrime L (P.under B) :=
    IsLocalization.isLocalization_isLocalization_atPrime_isLocalization M L P
  exact IsRegularLocalRing.of_ringEquiv
    (IsLocalization.algEquiv (P.under B).primeCompl (Localization.AtPrime (P.under B)) L).toRingEquiv
#print axioms IntersectionProductScaf_regularRing_localization

open scoped nonZeroDivisors in
set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
/-- A finite inclusion of regular domains is flat when the base is integrally closed. -/
theorem IntersectionProductScaf_finite_regular_domains_flat
    (R B : Type u) [CommRing R] [CommRing B] [Algebra R B]
    [IsDomain R] [IsDomain B] [IsRegularRing R] [IsRegularRing B]
    [IsIntegrallyClosed R] [FaithfulSMul R B] [Module.Finite R B] :
    Module.Flat R B := by
  apply Module.flat_of_isLocalized_maximal R B
    (fun (P : Ideal R) (_ : P.IsMaximal) =>
      Localization (Algebra.algebraMapSubmonoid B P.primeCompl))
    (fun P _ => (IsScalarTower.toAlgHom R B
      (Localization (Algebra.algebraMapSubmonoid B P.primeCompl))).toLinearMap)
  intro P hP
  let A := Localization.AtPrime P
  let S := Algebra.algebraMapSubmonoid B P.primeCompl
  let C := Localization S
  have : IsRegularRing C := IntersectionProductScaf_regularRing_localization B S
  have : IsDomain C := IsLocalization.isDomain_of_le_nonZeroDivisors (M := S) C
    (map_le_nonZeroDivisors_of_injective (algebraMap R B)
      (FaithfulSMul.algebraMap_injective R B) P.primeCompl_le_nonZeroDivisors)
  have : IsIntegrallyClosed A := isIntegrallyClosed_of_isLocalization A P.primeCompl
    P.primeCompl_le_nonZeroDivisors
  have : FaithfulSMul A C := (faithfulSMul_iff_algebraMap_injective A C).mpr
    (localizationAlgebra_injective (R := R) (S := B) (M := P.primeCompl) A C
      (FaithfulSMul.algebraMap_injective R B))
  have : Module.Free A C := IntersectionProductScaf_finite_regular_algebra_free_of_goingDown A C
    (fun Q _ => inferInstance)
  have : Module.Flat A C := inferInstance
  have : Module.Flat R A := IsLocalization.flat A P.primeCompl
  exact Module.Flat.trans R A C
#print axioms IntersectionProductScaf_finite_regular_domains_flat

end RegularModuleFreeness

section AffineRegularity
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
/-- Affine sections of a scheme with regular stalks form a regular ring. -/
theorem IntersectionProductScaf_affine_regularRing
    (Y : Scheme.{0}) [IsLocallyNoetherian Y] (U : Y.affineOpens)
    (hreg : ∀ y : Y, IsRegularLocalRing (Y.presheaf.stalk y)) :
    IsRegularRing Γ(Y, U.1) := by
  have : IsNoetherianRing Γ(Y, U.1) := IsLocallyNoetherian.component_noetherian U
  apply isRegularRing_iff.mpr
  intro P hP
  let := TopCat.Presheaf.algebra_section_stalk Y.presheaf
    ⟨U.2.fromSpec ⟨P, hP⟩, (U.2.isoSpec.inv _).2⟩
  have : IsLocalization.AtPrime (Y.presheaf.stalk (U.2.fromSpec ⟨P, hP⟩)) P :=
    U.2.isLocalization_stalk' ⟨P, hP⟩ (U.2.isoSpec.inv _).2
  have := hreg (U.2.fromSpec ⟨P, hP⟩)
  exact IsRegularLocalRing.of_ringEquiv
    (IsLocalization.algEquiv P.primeCompl (Y.presheaf.stalk (U.2.fromSpec ⟨P, hP⟩))
      (Localization.AtPrime P)).toRingEquiv
#print axioms IntersectionProductScaf_affine_regularRing

/-- A finite surjection between smooth integral complex schemes is flat. -/
theorem IntersectionProductScaf_finite_smooth_flat
    (Y Z : Over (Spec ↧ℂ)) [IsIntegral Y.left] [IsIntegral Z.left]
    [Smooth Y.hom] [Smooth Z.hom] (f : Y ⟶ Z)
    [IsFinite f.left] [Surjective f.left] : Flat f.left := by
  have : IsSchemeTheoreticallyDominant f.left := .of_isDominant f.left
  rw [IsZariskiLocalAtTarget.iff_of_iSup_eq_top (P := @Flat) _
    (iSup_affineOpens_eq_top Z.left)]
  intro U
  let V := f.left ⁻¹ᵁ U.1
  let g := f.left ∣_ U.1
  letI : IsAffine U.1.toScheme := U.2
  letI : IsAffine V.toScheme := U.2.preimage f.left
  cases isEmpty_or_nonempty V.toScheme with
  | inl h => exact inferInstance
  | inr h =>
    have : Nonempty U.1.toScheme := Nonempty.map g h
    have : IsIntegral V.toScheme := inferInstance
    have : IsIntegral U.1.toScheme := inferInstance
    have : Surjective g := MorphismProperty.of_isPullback
      (P := @Surjective) (isPullback_morphismRestrict f.left U.1).flip inferInstance
    have : IsSchemeTheoreticallyDominant g := .of_isDominant g
    letI := g.appTop.hom.toAlgebra
    have : Module.Finite Γ(U.1.toScheme, ⊤) Γ(V.toScheme, ⊤) := g.finite_appTop
    have : FaithfulSMul Γ(U.1.toScheme, ⊤) Γ(V.toScheme, ⊤) :=
      (faithfulSMul_iff_algebraMap_injective _ _).mpr (g.app_injective ⊤)
    have : IsRegularRing Γ(U.1.toScheme, ⊤) :=
      IntersectionProductScaf_affine_regularRing _ ⟨⊤, isAffineOpen_top _⟩
        (fun x => @a3c_isRegularLocalRing_stalk (Over.mk (U.1.ι ≫ Z.hom))
          ‹IsIntegral U.1.toScheme› (inferInstanceAs (Smooth (U.1.ι ≫ Z.hom))) x)
    have : IsRegularRing Γ(V.toScheme, ⊤) :=
      IntersectionProductScaf_affine_regularRing _ ⟨⊤, isAffineOpen_top _⟩
        (fun x => @a3c_isRegularLocalRing_stalk (Over.mk (V.ι ≫ Y.hom))
          ‹IsIntegral V.toScheme› (inferInstanceAs (Smooth (V.ι ≫ Y.hom))) x)
    have hnormal := zmtiso_normal_of_smooth U.1.toScheme (U.1.ι ≫ Z.hom)
    have : IsIntegrallyClosed Γ(U.1.toScheme, ⊤) := by
      refine IsIntegrallyClosed.of_localization_maximal fun P _ hP => ?_
      let W := isAffineOpen_top U.1.toScheme
      let := TopCat.Presheaf.algebra_section_stalk U.1.toScheme.presheaf
        ⟨W.fromSpec ⟨P, hP.isPrime⟩, (W.isoSpec.inv _).2⟩
      have : IsLocalization.AtPrime
          (U.1.toScheme.presheaf.stalk (W.fromSpec ⟨P, hP.isPrime⟩)) P :=
        W.isLocalization_stalk' ⟨P, hP.isPrime⟩ (W.isoSpec.inv _).2
      exact (hnormal _).2.of_equiv
        (IsLocalization.algEquiv P.primeCompl
          (U.1.toScheme.presheaf.stalk (W.fromSpec ⟨P, hP.isPrime⟩))
          (Localization.AtPrime P)).toRingEquiv
    have := IntersectionProductScaf_finite_regular_domains_flat
      Γ(U.1.toScheme, ⊤) Γ(V.toScheme, ⊤)
    exact (HasRingHomProperty.iff_of_isAffine (P := @Flat) (f := g)).mpr this
#print axioms IntersectionProductScaf_finite_smooth_flat

/-- The finite linear projection in matching dimension is flat. -/
theorem IntersectionProductScaf_projection_flat
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom]
    {n : ℕ} {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (hn : height (genericPoint X.left) = n) : Flat (a3h_πO X hfin).left := by
  have := IntersectionProductScaf_projectionTarget_integral X hfin hn
  have : Smooth (a3h_PnO n).hom := IntersectionProductScaf_projective_smooth n
  have : Surjective (a3h_πO X hfin).left :=
    ⟨a3h_π_surjective X hfin (a3h_dim_cone X n hn)⟩
  exact IntersectionProductScaf_finite_smooth_flat X (a3h_PnO n) (a3h_πO X hfin)
#print axioms IntersectionProductScaf_projection_flat

end AffineRegularity

/-- A flat algebra preserves nonzerodivisors on an extended prime quotient. -/
theorem IntersectionProductScaf_flat_map_prime_regular
    {A B : Type*} [CommRing A] [CommRing B] [Algebra A B] [Module.Flat A B]
    (P : Ideal A) [P.IsPrime] (r : A) (hr : r ∉ P) :
    IsSMulRegular (B ⧸ P.map (algebraMap A B)) (algebraMap A B r) := by
  have : Module.Flat (A ⧸ P) (B ⧸ P.map (algebraMap A B)) :=
    Module.Flat.of_linearEquiv
      (Algebra.TensorProduct.quotIdealMapEquivQuotTensor B P).toLinearEquiv
  have h := (show IsSMulRegular (A ⧸ P) (Ideal.Quotient.mk P r) from
    IsSMulRegular.of_ne_zero (Ideal.Quotient.eq_zero_iff_mem.not.mpr hr)).of_flat
    (S := B ⧸ P.map (algebraMap A B))
  exact h
#print axioms IntersectionProductScaf_flat_map_prime_regular

set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
/-- A flat affine inverse image preserves a parameter outside a prime ideal. -/
theorem IntersectionProductScaf_flat_affine_comap_regular
    {Y Z : Scheme} [IsAffine Y] [IsAffine Z] (f : Y ⟶ Z) [Flat f]
    (K : Z.IdealSheafData)
    [((Scheme.IdealSheafData.equivOfIsAffine K) : Ideal Γ(Z, ⊤)).IsPrime]
    (r : Γ(Z, ⊤)) (hr : r ∉ Scheme.IdealSheafData.equivOfIsAffine K) :
    IsSMulRegular (Γ(Y, ⊤) ⧸ Scheme.IdealSheafData.equivOfIsAffine (K.comap f))
      (f.appTop r) := by
  rw [IntersectionProductScaf_affine_comap_ideal]
  let := f.appTop.hom.toAlgebra
  have : Module.Flat Γ(Z, ⊤) Γ(Y, ⊤) := f.flat_appTop
  exact IntersectionProductScaf_flat_map_prime_regular
    (Scheme.IdealSheafData.equivOfIsAffine K) r hr
#print axioms IntersectionProductScaf_flat_affine_comap_regular

