/-- The finite cone projection remains generalizing after adjoining the original parameter. -/
theorem IntersectionProductScaf_relativeCone_generalizing
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] {n : ℕ}
    {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (hn : Order.height (genericPoint X.left) = n) :
    GeneralizingMap (PrimeSpectrum.comap ((Ideal.Quotient.mk (a3h_IXr (a3s_IX X))).comp
      (a3r_lin (a3h_block a)).toRingHom)) := by
  have hprime : (a3h_IXr (a3s_IX X)).IsPrime := (a3h_IXr_isPrime_dim (a3s_IX X)).1
  have hfinite := a3h_finite_rel (a3s_IX X) a hfin
  apply IntersectionProductScaf_finite_generalizing _ hfinite
  apply IntersectionProductScaf_cone_injective (a3h_IXr (a3s_IX X))
    (fun ij => a3h_block a ij.1 ij.2) hfinite
  simpa only [Fintype.card_sum, Fintype.card_fin, Fintype.card_unit,
    Nat.add_assoc] using a3h_dim_IXr X n hn

