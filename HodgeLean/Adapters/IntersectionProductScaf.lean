/-- No translated cone component contains a nonzero polynomial in the translation parameter. -/
theorem IntersectionProductScaf_translatedCone_component_parameter
    (I : Ideal (MvPolynomial (Fin (n + 1) ⊕ Unit) ℂ)) [I.IsPrime]
    (Q : _root_.Ideal _) (hQ : Q ∈ ((I.map Polynomial.C).map
      (IntersectionProductScaf_translatedConeMap X a M)).minimalPrimes)
    (p : Polynomial ℂ) (hp : p ≠ 0) :
    IntersectionProductScaf_translatedConeMap X a M
      (p.map (algebraMap ℂ (MvPolynomial (Fin (n + 1) ⊕ Unit) ℂ))) ∉ Q :=
  IntersectionProductScaf_component_parameter_not_mem _
    (IntersectionProductScaf_translatedCone_generalizing X hfin hn M) I Q hQ p hp

