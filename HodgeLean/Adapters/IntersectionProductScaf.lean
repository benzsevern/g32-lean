/-- Finite projection to the dimension of `X` lifts generalizations of scheme points. -/
theorem IntersectionProductScaf_projection_generalizing
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] {n : ℕ}
    {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (hn : Order.height (genericPoint X.left) = n) :
    GeneralizingMap (a3h_π X hfin) := by
  let alg : Algebra (MvPolynomial (Fin (n + 1)) ℂ) (MvPolynomial (Fin (a3s_N X + 1)) ℂ ⧸ a3s_IX X) :=
    ((Ideal.Quotient.mk (a3s_IX X)).comp (a3r_lin (a3r_mat a)).toRingHom).toAlgebra
  letI : SMul (MvPolynomial (Fin (n + 1)) ℂ)
      (MvPolynomial (Fin (a3s_N X + 1)) ℂ ⧸ a3s_IX X) := alg.toSMul
  letI : Module (MvPolynomial (Fin (n + 1)) ℂ)
      (MvPolynomial (Fin (a3s_N X + 1)) ℂ ⧸ a3s_IX X) := @Algebra.toModule _ _ _ _ alg
  have hdim := a3h_dim_cone X n hn
  have hinj : Function.Injective (algebraMap (MvPolynomial (Fin (n + 1)) ℂ) (MvPolynomial (Fin (a3s_N X + 1)) ℂ ⧸ a3s_IX X)) := by
    apply (RingHom.injective_iff_ker_eq_bot _).mpr
    ext r
    change Ideal.Quotient.mk (a3s_IX X) (a3r_lin (a3r_mat a) r) = 0 ↔ r = 0
    rw [Ideal.Quotient.eq_zero_iff_mem]
    change r ∈ (a3s_IX X).comap (a3r_lin (a3r_mat a)) ↔ r = 0
    rw [a3h_comap_IX X hfin hdim, Ideal.mem_bot]
  have : FaithfulSMul (MvPolynomial (Fin (n + 1)) ℂ) (MvPolynomial (Fin (a3s_N X + 1)) ℂ ⧸ a3s_IX X) := (faithfulSMul_iff_algebraMap_injective (MvPolynomial (Fin (n + 1)) ℂ) (MvPolynomial (Fin (a3s_N X + 1)) ℂ ⧸ a3s_IX X)).mpr hinj
  have : Algebra.IsIntegral (MvPolynomial (Fin (n + 1)) ℂ) (MvPolynomial (Fin (a3s_N X + 1)) ℂ ⧸ a3s_IX X) := ⟨hfin.to_isIntegral⟩
  have hgd : GeneralizingMap (PrimeSpectrum.comap (algebraMap (MvPolynomial (Fin (n + 1)) ℂ) (MvPolynomial (Fin (a3s_N X + 1)) ℂ ⧸ a3s_IX X))) :=
    Algebra.HasGoingDown.iff_generalizingMap_primeSpectrumComap.mp inferInstance
  intro x y hy
  let Q : PrimeSpectrum (MvPolynomial (Fin (n + 1)) ℂ) := ⟨(a3m_projCharts n).prime y, inferInstance⟩
  have hQ : Q ⤳ PrimeSpectrum.comap (algebraMap (MvPolynomial (Fin (n + 1)) ℂ) (MvPolynomial (Fin (a3s_N X + 1)) ℂ ⧸ a3s_IX X)) (a3h_ptS X x) := by
    apply (PrimeSpectrum.le_iff_specializes _ _).mp
    change (a3m_projCharts n).prime y ≤
      ((a3h_ptS X x).asIdeal).comap
        ((Ideal.Quotient.mk (a3s_IX X)).comp (a3r_lin (a3r_mat a)).toRingHom)
    rw [← Ideal.comap_comap, a3h_comap_ptS]
    change (a3m_projCharts n).prime y ≤
      ((a3s_CX X).prime x).comap (a3r_lin (a3r_mat a))
    rw [← a3h_prime_π X hfin]
    exact (a3m_projCharts n).prime_mono hy
  obtain ⟨P', hP'x, hP'Q⟩ := hgd hQ
  have hP'le := (PrimeSpectrum.le_iff_specializes _ _).mpr hP'x
  set P := P'.asIdeal.comap (Ideal.Quotient.mk (a3s_IX X))
  have hPprime : P.IsPrime := Ideal.comap_isPrime _ _
  have hIXP : a3s_IX X ≤ P := by
    intro F hF
    change Ideal.Quotient.mk _ F ∈ P'.asIdeal
    rw [Ideal.Quotient.eq_zero_iff_mem.mpr hF]
    exact zero_mem _
  have hPQ : P.comap (a3r_lin (a3r_mat a)) = Q.asIdeal :=
    congrArg PrimeSpectrum.asIdeal hP'Q
  have hPx : P ≤ (a3s_CX X).prime x := by
    rw [← a3h_comap_ptS X x]
    exact Ideal.comap_mono hP'le
  set P₀ := (P.homogeneousCore (homogeneousSubmodule (Fin (a3s_N X + 1)) ℂ)).toIdeal
  have hP₀prime : P₀.IsPrime := hPprime.homogeneousCore
  have hP₀h : P₀.IsHomogeneous (homogeneousSubmodule (Fin (a3s_N X + 1)) ℂ) :=
    (P.homogeneousCore _).isHomogeneous
  have hP₀le : P₀ ≤ P := Ideal.toIdeal_homogeneousCore_le _ _
  have hIXP₀ : a3s_IX X ≤ P₀ := by
    intro F hF
    rw [← sum_homogeneousComponent F]
    exact Ideal.sum_mem _ fun e _ => Ideal.mem_homogeneousCore_of_homogeneous_of_mem
      ⟨e, (mem_homogeneousSubmodule _ _).mpr (homogeneousComponent_isHomogeneous e F)⟩
      (hIXP (homogeneousComponent_mem_of_mem (a3s_IX_isHomogeneous X) hF e))
  have hQh : Q.asIdeal.IsHomogeneous (homogeneousSubmodule (Fin (n + 1)) ℂ) :=
    (a3m_projCharts n).isHomogeneous_prime y
  have hcomap : P₀.comap (a3r_lin (a3r_mat a)) = Q.asIdeal := by
    refine le_antisymm (hPQ ▸ Ideal.comap_mono hP₀le) fun G hG => ?_
    rw [Ideal.mem_comap, ← sum_homogeneousComponent G, map_sum]
    refine Ideal.sum_mem _ fun e _ => Ideal.mem_homogeneousCore_of_homogeneous_of_mem
      ⟨e, (mem_homogeneousSubmodule _ _).mpr
        (a3h_lin_isHomogeneous (a3r_mat a) (homogeneousComponent_isHomogeneous e G))⟩ ?_
    rw [← Ideal.mem_comap, hPQ]
    exact homogeneousComponent_mem_of_mem hQh hG e
  obtain ⟨j, hj⟩ := (a3s_CX X).cover x
  have hjP : MvPolynomial.X j ∉ P₀ := by
    intro h
    exact (((a3s_CX X).X_mem_prime_iff x j).mp (hPx (hP₀le h))) hj
  obtain ⟨x', hx'⟩ := a3s_exists_point X P₀ hP₀h j hjP hIXP₀
  refine ⟨x', (a3s_CX X).prime_le_iff.mp ?_, (a3m_projCharts n).prime_injective ?_⟩
  · rw [hx']
    exact hP₀le.trans hPx
  · rw [a3h_prime_π X hfin x', hx', hcomap]

