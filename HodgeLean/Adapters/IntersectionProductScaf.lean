    (hc : IsUnit ((IntersectionProductScaf_lineDet M).eval c))
    (hn : Order.height (genericPoint X.left) = n) (y y' : (a3n_T X).left)
    (hy' : IntersectionProductScaf_translationFibreCycle M a hfin y c y' ≠ 0) :
    height y' = height y := by
  have := IntersectionProductScaf_projectionProduct_finite X hfin
  have := IntersectionProductScaf_squareFibreMap_finite X hfin M c hc
  have hi := (IntersectionProductScaf_translationFibreCycle_support X a hfin M c hc hn y y').mp hy'
  rw [← IntersectionProductScaf_finite_height (IntersectionProductScaf_squareFibreMap X hfin M c hc).left,
    hi, IntersectionProductScaf_finite_height]
#print axioms IntersectionProductScaf_translationFibreCycle_height


/-- Every nonzero invertible translation-fibre coefficient has the codimension of its input point. -/
theorem IntersectionProductScaf_translationFibreCycle_coheight
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] [Smooth X.hom] {n : ℕ}
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (M : Fin (n + 1) × Fin (n + 1) → ℂ) (c : ℂ)
    (hc : IsUnit ((IntersectionProductScaf_lineDet M).eval c))
    (hn : Order.height (genericPoint X.left) = n) (y y' : (a3n_T X).left)
    (hy' : IntersectionProductScaf_translationFibreCycle M a hfin y c y' ≠ 0) :
    coheight y' = coheight y := by
  have hh := IntersectionProductScaf_translationFibreCycle_height X a hfin M c hc hn y y' hy'
  have h₁ := a3m_height_add_coheight (a3n_T X) y'
  have h₂ := a3m_height_add_coheight (a3n_T X) y
  rw [hh] at h₁
  obtain ⟨-, m, hm, -⟩ := a1d_height_eq_trdeg (X := a3n_T X) y
  exact WithTop.add_left_cancel (hm ▸ ENat.natCast_ne_top m) (h₁.trans h₂.symm)
