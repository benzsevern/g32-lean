/-- The zero translation fibre is the inverse-image cycle of the projected input, with its degree. -/
theorem IntersectionProductScaf_translationFibreCycle_zero
    (M : Fin (n + 1) × Fin (n + 1) → ℂ)
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite) (y : (a3n_T X).left) :
    IntersectionProductScaf_translationFibreCycle M a hfin y 0 =
      a3m_smul (a1p_degree (a3h_G (a3h_πO X hfin)).left y : ℚ)
        (ccm3_flatPullbackPrime (a3h_G (a3h_πO X hfin)).left
          ((a3h_G (a3h_πO X hfin)).left y)) := by
  unfold IntersectionProductScaf_translationFibreCycle IntersectionProductScaf_squarePrimeIdeal
  rw [IntersectionProductScaf_square_zero_fundCycle]
