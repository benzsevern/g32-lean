/-- Injective finite maps out of normal domains lift generalizations on spectra. -/
theorem IntersectionProductScaf_finite_generalizing
    {R S : Type} [CommRing R] [CommRing S] [IsDomain S] [IsIntegrallyClosed R]
    (f : R →+* S) (hf : f.Finite) (hi : Function.Injective f) :
    GeneralizingMap (PrimeSpectrum.comap f) := by
  letI := f.toAlgebra
  have : FaithfulSMul R S := (faithfulSMul_iff_algebraMap_injective R S).mpr hi
  have : Algebra.IsIntegral R S := ⟨hf.to_isIntegral⟩
  exact Algebra.HasGoingDown.iff_generalizingMap_primeSpectrumComap.mp inferInstance

attribute [local instance] Polynomial.algebra in
/-- Adjoining a parameter preserves going-down for an injective finite map from a normal domain. -/
theorem IntersectionProductScaf_polynomial_generalizing
    {R S : Type} [CommRing R] [CommRing S] [IsDomain R] [IsDomain S]
    [IsIntegrallyClosed R] (f : R →+* S) (hf : f.Finite)
    (hi : Function.Injective f) :
    GeneralizingMap (PrimeSpectrum.comap (Polynomial.mapRingHom f)) := by
  let := f.toAlgebra
  have : FaithfulSMul R S := (faithfulSMul_iff_algebraMap_injective R S).mpr hi
  have : Algebra.IsIntegral R S := ⟨hf.to_isIntegral⟩
  have : FaithfulSMul (Polynomial R) (Polynomial S) := (faithfulSMul_iff_algebraMap_injective (Polynomial R) (Polynomial S)).mpr
    (Polynomial.map_injective f hi)
  have : Algebra.IsIntegral (Polynomial R) (Polynomial S) := ⟨fun p =>
    Polynomial.isIntegral_iff_isIntegral_coeff.mpr fun i => Algebra.IsIntegral.isIntegral (p.coeff i)⟩
  exact Algebra.HasGoingDown.iff_generalizingMap_primeSpectrumComap.mp inferInstance

#print axioms IntersectionProductScaf_polynomial_generalizing

/-- A generalizing map remains generalizing on corresponding subspaces. -/
theorem IntersectionProductScaf_generalizing_square
    {A B A' B' : Type*} [TopologicalSpace A] [TopologicalSpace B]
    [TopologicalSpace A'] [TopologicalSpace B']
    (f : A → B) (g : A' → B') (i : A' → A) (j : B' → B)
    (hf : GeneralizingMap f) (hi : Topology.IsEmbedding i)
    (hj : Topology.IsEmbedding j) (hcomm : f ∘ i = j ∘ g)
    (hrange : Set.range i = f ⁻¹' Set.range j) : GeneralizingMap g := by
  intro x y hy
  have h : j y ⤳ f (i x) := by
    rw [show f (i x) = j (g x) from congrFun hcomm x]
    exact hy.map hj.continuous
  obtain ⟨z, hzx, hz⟩ := hf h
  have hzi : z ∈ Set.range i := by
    rw [hrange]
    exact ⟨y, hz.symm⟩
  obtain ⟨z', rfl⟩ := hzi
  refine ⟨z', hi.isInducing.specializes_iff.mp hzx, hj.injective ?_⟩
  exact (congrFun hcomm z').symm.trans hz

/-- Restricting a ring map to a principal open preserves lifting of generalizations. -/
theorem IntersectionProductScaf_away_generalizing
    {R S : Type} [CommRing R] [CommRing S] (f : R →+* S)
    (hf : GeneralizingMap (PrimeSpectrum.comap f)) (d : R) :
    GeneralizingMap (PrimeSpectrum.comap
      (IsLocalization.Away.map (Localization.Away d) (Localization.Away (f d)) f d)) := by
  apply IntersectionProductScaf_generalizing_square (PrimeSpectrum.comap f) _
    (PrimeSpectrum.comap (algebraMap S (Localization.Away (f d))))
    (PrimeSpectrum.comap (algebraMap R (Localization.Away d))) hf
    (PrimeSpectrum.localization_comap_isEmbedding _ (Submonoid.powers (f d)))
    (PrimeSpectrum.localization_comap_isEmbedding _ (Submonoid.powers d))
  · funext p
    apply PrimeSpectrum.ext
    ext r
    change algebraMap S (Localization.Away (f d)) (f r) ∈ p.asIdeal ↔
      IsLocalization.Away.map (Localization.Away d) (Localization.Away (f d)) f d
        (algebraMap R (Localization.Away d) r) ∈ p.asIdeal
    rw [IsLocalization.Away.map, IsLocalization.map_eq]
  · rw [PrimeSpectrum.localization_away_comap_range (Localization.Away (f d)) (f d),
      PrimeSpectrum.localization_away_comap_range (Localization.Away d) d]
    rfl

/-- Every minimal prime of an extended prime ideal contracts to that prime under going-down. -/
theorem IntersectionProductScaf_minimalPrime_comap
    {R S : Type} [CommRing R] [CommRing S] (f : R →+* S)
    (hf : GeneralizingMap (PrimeSpectrum.comap f))
    (P : Ideal R) [P.IsPrime] (Q : Ideal S) (hQ : Q ∈ (P.map f).minimalPrimes) :
    Q.comap f = P := by
  let q : PrimeSpectrum S := ⟨Q, hQ.1.1⟩
  let p : PrimeSpectrum R := ⟨P, inferInstance⟩
  have hpq : p ⤳ PrimeSpectrum.comap f q :=
    (PrimeSpectrum.le_iff_specializes _ _).mp ((Ideal.map_le_iff_le_comap).mp hQ.1.2)
  obtain ⟨q', hq', he⟩ := hf hpq
  have hqp : q'.asIdeal.comap f = P := congrArg PrimeSpectrum.asIdeal he
  have hle : q'.asIdeal ≤ Q := (PrimeSpectrum.le_iff_specializes _ _).mpr hq'
  have hge : Q ≤ q'.asIdeal := hQ.2 ⟨q'.isPrime,
    (Ideal.map_le_iff_le_comap).mpr hqp.ge⟩ hle
  exact (congrArg (Ideal.comap f) (le_antisymm hge hle)).trans hqp

