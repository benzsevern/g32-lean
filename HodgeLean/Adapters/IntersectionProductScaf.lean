/-- Primewise generic original-face identities on dominating inputs suffice for a finite collection. -/
theorem IntersectionProductScaf_t_face_finset
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (S : Finset (a3n_T X).left)
    (h : ∀ y ∈ S, a3n_h X y = genericPoint (g3c_P 1) → a3r_Generic {M : Fin (n + 1) × Fin (n + 1) → ℂ |
      a3k_dt X ((IntersectionProductScaf_data M a hfin).Θ₁
          (a1p_pushforward (a3h_G (a3h_πO X hfin)).left
            (Function.locallyFinsuppWithin.single y 1))) =
        (IntersectionProductScaf_data M a hfin).Θ₀
          (a3k_bd (a3h_PnO n) (a1p_pushforward (a3h_G (a3h_πO X hfin)).left
            (Function.locallyFinsuppWithin.single y 1)))}) :
    a3r_Generic {M : Fin (n + 1) × Fin (n + 1) → ℂ |
      ∀ y ∈ S, a3k_dt X ((IntersectionProductScaf_data M a hfin).Θ₁
          (a1p_pushforward (a3h_G (a3h_πO X hfin)).left
            (Function.locallyFinsuppWithin.single y 1))) =
        (IntersectionProductScaf_data M a hfin).Θ₀
          (a3k_bd (a3h_PnO n) (a1p_pushforward (a3h_G (a3h_πO X hfin)).left
            (Function.locallyFinsuppWithin.single y 1)))} := by
  have hall : ∀ y ∈ S, a3r_Generic {M : Fin (n + 1) × Fin (n + 1) → ℂ |
      a3k_dt X ((IntersectionProductScaf_data M a hfin).Θ₁
          (a1p_pushforward (a3h_G (a3h_πO X hfin)).left
            (Function.locallyFinsuppWithin.single y 1))) =
        (IntersectionProductScaf_data M a hfin).Θ₀
          (a3k_bd (a3h_PnO n) (a1p_pushforward (a3h_G (a3h_πO X hfin)).left
            (Function.locallyFinsuppWithin.single y 1)))} := by
    intro y hy
    by_cases hdom : a3n_h X y = genericPoint (g3c_P 1)
    · exact h y hy hdom
    · exact a3r_generic_univ.mono fun M _ =>
