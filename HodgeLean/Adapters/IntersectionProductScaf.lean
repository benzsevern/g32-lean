/-- Pushforward through a closed immersion preserves the coefficient at every image point. -/
theorem IntersectionProductScaf_closed_pushforward_apply
    {Y Z : Scheme} (j : Y ⟶ Z) [IsClosedImmersion j]
    (C : AlgebraicCycle Y ℚ) (x : Y) : a1p_pushforward j C (j x) = C x := by
  rw [a1p_pushforward_apply_eq_sum j C (j x) {x}]
  · simp only [Finset.sum_singleton, a3m_degree_closedImmersion, Nat.cast_one, mul_one]
  · intro y hy
    exact Finset.mem_singleton.mpr (j.isEmbedding.injective hy.1)
  · intro y hy
    have hyx := Finset.mem_singleton.mp hy
    subst y
    exact Set.mem_preimage.mpr rfl
