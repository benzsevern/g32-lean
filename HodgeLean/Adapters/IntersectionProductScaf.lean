/-- The two cycle-valued operators underlying the translation construction. -/
structure IntersectionProductScafData (n : ℕ) where
  /-- The family on `X × ℙ¹_t × ℙ¹_s`, retaining both parameters. -/
  Θ₁ : AlgebraicCycle (a3n_T (a3h_PnO n)).left ℚ →
    AlgebraicCycle (a3n_T (a3n_T X)).left ℚ
  /-- The whole one-parameter family on `X × ℙ¹_s`. -/
  Θ₀ : AlgebraicCycle (a3h_PnO n).left ℚ → AlgebraicCycle (a3n_T X).left ℚ

variable {X} {n : ℕ}

/-- T1: cycle operators obtained from the line of projective translations. -/
def IntersectionProductScaf_transCycle
    (M : Fin (n + 1) × Fin (n + 1) → ℂ)
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite) :
    IntersectionProductScafData X n where
  Θ₁ := IntersectionProductScaf_theta₁ X hfin M
  Θ₀ := IntersectionProductScaf_theta₀ X hfin M

/-- The explicit cycle operators of the inverse-translation family. -/
def IntersectionProductScaf_data
    (M : Fin (n + 1) × Fin (n + 1) → ℂ)
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite) : IntersectionProductScafData X n :=
  IntersectionProductScaf_transCycle M a hfin

#print axioms IntersectionProductScaf_transCycle
#print axioms IntersectionProductScaf_data

/-- T2: the point-cycle operator is rational-linear. -/
theorem IntersectionProductScaf_transCycle_add :
    a3r_Generic {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ |
      ∀ hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
          (a3r_lin (a3r_mat a)).toRingHom).Finite,
        a3r_Generic {M : Fin (n + 1) × Fin (n + 1) → ℂ |
          (∀ c c', (IntersectionProductScaf_data M a hfin).Θ₀ (c + c') =
            (IntersectionProductScaf_data M a hfin).Θ₀ c +
              (IntersectionProductScaf_data M a hfin).Θ₀ c') ∧
          (∀ (r : ℚ) c, (IntersectionProductScaf_data M a hfin).Θ₀ (a3m_smul r c) =
            a3m_smul r ((IntersectionProductScaf_data M a hfin).Θ₀ c))}} := by
  refine a3r_generic_univ.mono fun a _ hfin => ?_
  refine a3r_generic_univ.mono fun M _ => ?_
  constructor
  · intro c c'
    exact IntersectionProductScaf_openFamilyCycle_add
      (IntersectionProductScaf_familyInclusion X M)
      (IntersectionProductScaf_familyMap₀ X hfin M) c c'
  · intro r c
    exact IntersectionProductScaf_openFamilyCycle_smul
      (IntersectionProductScaf_familyInclusion X M)
      (IntersectionProductScaf_familyMap₀ X hfin M) r c

#print axioms IntersectionProductScaf_transCycle_add

/-- The square-family operator on a pushed prime is the prime family multiplied by the
residue-field degree of the product projection. -/
theorem IntersectionProductScaf_theta₁_push_single
    (M : Fin (n + 1) × Fin (n + 1) → ℂ)
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (y : (a3n_T X).left) :
    (IntersectionProductScaf_data M a hfin).Θ₁
        (a1p_pushforward (a3h_G (a3h_πO X hfin)).left
          (Function.locallyFinsuppWithin.single y 1)) =
      a3m_smul (a1p_degree (a3h_G (a3h_πO X hfin)).left y : ℚ)
        (IntersectionProductScaf_theta₁ X hfin M
          (Function.locallyFinsuppWithin.single
            ((a3h_G (a3h_πO X hfin)).left y) 1)) := by
  exact IntersectionProductScaf_openFamilyCycle_push_single
    (IntersectionProductScaf_familyInclusion (a3n_T X) M)
    (IntersectionProductScaf_familyMap₁ X hfin M)
    (a3h_G (a3h_πO X hfin)) y

#print axioms IntersectionProductScaf_theta₁_push_single

/-- Every nonzero member of a pushed-prime square family lies in the standard affine
translation-parameter chart. -/
theorem IntersectionProductScaf_theta₁_push_single_mem_U
    (M : Fin (n + 1) × Fin (n + 1) → ℂ)
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
