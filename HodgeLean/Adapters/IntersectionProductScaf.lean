/-- Equations outside the input prime remain outside every translated cone component. -/
theorem IntersectionProductScaf_translatedCone_component_constant
    (I : Ideal (MvPolynomial (Fin (n + 1) ⊕ Unit) ℂ)) [I.IsPrime]
    (Q : _root_.Ideal _) (hQ : Q ∈ ((I.map Polynomial.C).map
      (IntersectionProductScaf_translatedConeMap X a M)).minimalPrimes)
    (F : MvPolynomial (Fin (n + 1) ⊕ Unit) ℂ) (hF : F ∉ I) :
    IntersectionProductScaf_translatedConeMap X a M (Polynomial.C F) ∉ Q := by
  intro h
  have hc := IntersectionProductScaf_translatedCone_component_comap X hfin hn M I Q hQ
  have hm : Polynomial.C F ∈ I.map Polynomial.C := hc ▸ h
  exact hF (by simpa only [Polynomial.coeff_C_zero] using (Ideal.mem_map_C_iff.mp hm) 0)

