/-- A finite dominant morphism between integral schemes with normal target lifts generalizations. -/
theorem IntersectionProductScaf_finite_normal_generalizing
    {Z Y : Scheme.{0}} [IsIntegral Z] [IsIntegral Y]
    (f : Z ⟶ Y) [IsFinite f] [IsDominant f] (hY : zmtiso_IsNormal Y) :
    GeneralizingMap f := by
  have : IsSchemeTheoreticallyDominant f := .of_isDominant f
  intro x y hy
  obtain ⟨U, hU, hfx, _⟩ := exists_isAffineOpen_mem_and_subset
    (show f x ∈ (⊤ : Y.Opens) from trivial)
  have hyU : y ∈ U := hy.mem_open U.isOpen hfx
  let V := f ⁻¹ᵁ U
  have hV : IsAffineOpen V := hU.preimage f
  have : Nonempty U := ⟨⟨f x, hfx⟩⟩
  have : Nonempty V := ⟨⟨x, hfx⟩⟩
  have : IsIntegrallyClosed Γ(Y, U) := by
    refine IsIntegrallyClosed.of_localization_maximal fun P _ hP => ?_
    let := TopCat.Presheaf.algebra_section_stalk Y.presheaf
      ⟨hU.fromSpec ⟨P, hP.isPrime⟩, (hU.isoSpec.inv _).2⟩
    have : IsLocalization.AtPrime (Y.presheaf.stalk (hU.fromSpec ⟨P, hP.isPrime⟩)) P :=
      hU.isLocalization_stalk' ⟨P, hP.isPrime⟩ (hU.isoSpec.inv _).2
    exact (hY _).2.of_equiv
      (IsLocalization.algEquiv P.primeCompl (Y.presheaf.stalk (hU.fromSpec ⟨P, hP.isPrime⟩))
        (Localization.AtPrime P)).toRingEquiv
  obtain ⟨p, hp⟩ : ∃ p, hV.fromSpec p = x := by
    have hx : x ∈ Set.range hV.fromSpec := by rw [hV.range_fromSpec]; exact hfx
    exact hx
  obtain ⟨q, hq⟩ : ∃ q, hU.fromSpec q = y := by
    have hx : y ∈ Set.range hU.fromSpec := by rw [hU.range_fromSpec]; exact hyU
    exact hx
  have hcomm : Spec.map (f.app U) ≫ hU.fromSpec = hV.fromSpec ≫ f := by
    simpa only [Scheme.Hom.app_eq_appLE] using
      hU.SpecMap_appLE_fromSpec f hV (le_refl V)
  have hgen := IntersectionProductScaf_finite_generalizing (f.app U).hom
    (f.finite_app U hU) (f.app_injective U)
  have hqp : q ⤳ Spec.map (f.app U) p := by
    apply hU.fromSpec.isOpenEmbedding.isEmbedding.specializes_iff.mp
    rw [hq, ← Scheme.Hom.comp_apply, hcomm, Scheme.Hom.comp_apply, hp]
    exact hy
  obtain ⟨p', hpp, hpq⟩ := hgen hqp
  refine ⟨hV.fromSpec p', ?_, ?_⟩
  · simpa only [hp] using hpp.map hV.fromSpec.continuous
  · rw [← Scheme.Hom.comp_apply, ← hcomm, Scheme.Hom.comp_apply]
    change hU.fromSpec (PrimeSpectrum.comap (f.app U).hom p') = y
    rw [hpq, hq]

