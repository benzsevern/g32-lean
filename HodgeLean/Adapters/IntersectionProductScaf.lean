/-- Restricting the affine coordinate section to the standard chart gives its polynomial coordinate. -/
theorem IntersectionProductScaf_parameter_chart_coordinate_app :
    let U := Proj.basicOpen (UniversalGrading.{0} 1) (MvPolynomial.X 0)
    ∀ h : (⊤ : (Spec (.of a3m_Away1)).Opens) ≤ (g3c_chartι 1 0) ⁻¹ᵁ U,
      (g3c_chartι 1 0).appLE U ⊤ h a3k_S1 =
        (Scheme.ΓSpecIso (.of a3m_Away1)).inv a3m_t₁ := by
  intro U h
  let e := Proj.basicOpenIsoSpec (UniversalGrading.{0} 1)
    (MvPolynomial.X 0) (a3m_X_mem 0) one_pos
  have he : e.hom.appTop ≫ e.inv.appTop = 𝟙 _ := by
    rw [← Scheme.Hom.comp_appTop, e.inv_hom_id]
    rfl
  have hi : U.ι.appLE U ⊤ (by intro x hx; exact x.property) = U.topIso.inv := by
    rw [Scheme.Opens.ι_appLE]
    rfl
  have hj : (g3c_chartι 1 0).appLE U ⊤ h = U.topIso.inv ≫ e.inv.appTop := by
    change (e.inv ≫ U.ι).appLE U ⊤ h = _
    rw [← Scheme.Hom.appLE_comp_appLE e.inv U.ι U ⊤ ⊤
      (by intro x hx; exact x.property) (by simp), hi]
    rfl
  have hf : (Proj.basicOpenIsoAway (UniversalGrading.{0} 1) (MvPolynomial.X 0)
      (a3m_X_mem 0) one_pos).hom ≫ U.topIso.inv ≫ e.inv.appTop =
      (Scheme.ΓSpecIso (.of a3m_Away1)).inv := by
    apply (cancel_epi (Scheme.ΓSpecIso (.of a3m_Away1)).hom).mp
    rw [Iso.hom_inv_id]
    have he' : (Proj.basicOpenToSpec (UniversalGrading.{0} 1) (MvPolynomial.X 0)).appTop ≫
        e.inv.appTop = 𝟙 _ := he
    dsimp only [Scheme.Hom.appTop] at he'
    rw [Proj.basicOpenToSpec_app_top, Category.assoc, Category.assoc] at he'
    exact he'
  rw [hj]
  change (U.topIso.inv ≫ e.inv.appTop)
    ((Proj.basicOpenIsoAway (UniversalGrading.{0} 1) (MvPolynomial.X 0)
      (a3m_X_mem 0) one_pos).hom
      (Away.isLocalizationElem (a3m_X_mem 0) (a3m_X_mem 1))) = _
  rw [a3m_elem_X1]
  exact congrArg (fun f => f a3m_t₁) hf
