                a3n_h X ((a3n_q (a3n_T X)).left d) = genericPoint (g3c_P 1)}} := by
  refine a3r_generic_univ.mono fun a _ hfin => ?_
  refine IntersectionProductScaf_generic_matrix.mono fun M hM y _ hy w hw hdoms d hd => ?_
  rw [IntersectionProductScaf_theta₁_push_single, a3m_smul_apply] at hw
  have hsingle := (mul_ne_zero_iff.mp hw).2
