/-- Original-face components avoid the two translation endpoints. -/
theorem IntersectionProductScaf_face_t_corners
    (S : Finset (a3n_T X).left) (hn : Order.height (genericPoint X.left) = n) :
    a3r_Generic {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ |
      ∀ hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
          (a3r_lin (a3r_mat a)).toRingHom).Finite,
        a3r_Generic {M : Fin (n + 1) × Fin (n + 1) → ℂ |
          ∀ y ∈ S, a3n_h X y = genericPoint (g3c_P 1) → ∀ w, ((IntersectionProductScaf_data M a hfin).Θ₁
            (a1p_pushforward (a3h_G (a3h_πO X hfin)).left
            (Function.locallyFinsuppWithin.single y 1))) w ≠ 0 →
            ∀ c : ℂ, (c = 0 ∨ c = 1) → ∀ z ∈ a3y_comps w (a3k_E X c),
              a3n_h (a3n_T X) z ∉ a3m_Z0 ∧ a3n_h (a3n_T X) z ∉ a3m_Zinf}} := by
  refine a3r_generic_univ.mono fun a _ hfin => ?_
  refine IntersectionProductScaf_generic_matrix.mono fun M hM y _ hy w hw c hc z hz => ?_
  have ht := IntersectionProductScaf_theta₁_dom_t_of_generalizing X hfin M
    (IntersectionProductScaf_familyMap₁_generalizing X hfin M hn) y hy w hw
  have hcoh := a3k_coheight_comps_E X w ht c hc hz
  have hs := (a3y_comps_spec _ _ hz).1
  have htd : (a3n_q (a3n_T X)).left z ∈ Set.range (a3n_σ X c) := by
    apply a3n_mem_range_σ_of_specializes X c
    exact (a3n_b_specializes_iff (a3n_T X) _ z).mp (a3y_comps_spec _ _ hz).2.1
  rw [IntersectionProductScaf_theta₁_push_single, a3m_smul_apply] at hw
  have hsingle := (mul_ne_zero_iff.mp hw).2
  have hy' : a3n_h (a3h_PnO n) ((a3h_G (a3h_πO X hfin)).left y) = genericPoint (g3c_P 1) := by
    rw [a3h_G_h_apply, hy]
  constructor
  · intro hz0
    have hsec : z ∈ Set.range (a3n_σ (a3n_T X) 0) :=
      ⟨_, (a3n_eq_σ0 (a3n_T X) z hz0).symm⟩
    have hdom := IntersectionProductScaf_theta₁_single_section_dom_t X hfin M hn _ hy' w hsingle
      0 (by rw [IntersectionProductScaf_lineDet_zero]; exact isUnit_one) z hsec hs hcoh
    exact a3k_not_mem_range_σ X hdom c hc htd
  · intro hz1
    have hsec : z ∈ Set.range (a3n_σ (a3n_T X) 1) :=
      ⟨_, (a3n_eq_σ1 (a3n_T X) z hz1).symm⟩
    have hdom := IntersectionProductScaf_theta₁_single_section_dom_t X hfin M hn _ hy' w hsingle
      1 (by rw [IntersectionProductScaf_lineDet_one]; exact hM) z hsec hs hcoh
    exact a3k_not_mem_range_σ X hdom c hc htd
