/-- Forget the invertible translation parameter. -/
def IntersectionProductScaf_familyBase (Y : Over (Spec ↧ℂ)) (M : σ × σ → ℂ) :
    IntersectionProductScaf_familyOpen Y M ⟶ Y :=
  Over.homMk (pullback.fst Y.hom (IntersectionProductScaf_parameterOver M).hom) rfl

/-- Forgetting the invertible affine parameter is an affine morphism. -/
instance IntersectionProductScaf_familyBase_affine (Y : Over (Spec ↧ℂ)) (M : σ × σ → ℂ) :
    IsAffineHom (IntersectionProductScaf_familyBase Y M).left := by
  change IsAffineHom (pullback.fst Y.hom (IntersectionProductScaf_parameterOver M).hom)
  have hp : IsAffineHom (IntersectionProductScaf_parameterOver M).hom := by
    letI : IsAffine (IntersectionProductScaf_parameterOver M).left :=
      inferInstanceAs (IsAffine (Spec (.of (IntersectionProductScaf_lineRing M))))
    exact isAffineHom_of_isAffine _
  exact MorphismProperty.pullback_fst _ _ hp

