/-- Regular parameter sequences in localized affine coordinate modules imply flatness of a finite affine morphism. -/
theorem IntersectionProductScaf_finite_affine_flat_of_regular_parameters
    {Y Z : Scheme} [IsAffine Y] [IsAffine Z] [IsLocallyNoetherian Z]
    (f : Y ⟶ Z) [AlgebraicGeometry.IsFinite f]
    (hreg : letI := f.appTop.hom.toAlgebra
      ∀ (P : Ideal Γ(Z, ⊤)) [P.IsMaximal],
        ∃ rs : List (Localization.AtPrime P),
          Ideal.ofList rs = maximalIdeal (Localization.AtPrime P) ∧
          IsWeaklyRegular (LocalizedModule P.primeCompl Γ(Y, ⊤)) rs) :
    Flat f := by
  letI := f.appTop.hom.toAlgebra
  have : Module.Finite Γ(Z, ⊤) Γ(Y, ⊤) := f.finite_appTop
  have : IsNoetherianRing Γ(Z, ⊤) :=
    IsLocallyNoetherian.component_noetherian ⟨⊤, isAffineOpen_top Z⟩
  have : Module.Flat Γ(Z, ⊤) Γ(Y, ⊤) :=
    IntersectionProductScaf_flat_of_regular_localized_generators Γ(Z, ⊤) Γ(Y, ⊤) hreg
  exact (HasRingHomProperty.iff_of_isAffine (P := @Flat) (f := f)).mpr this
#print axioms IntersectionProductScaf_finite_affine_flat_of_regular_parameters

