    (a3r_lin (a3r_mat a)).toRingHom).Finite)
  (hn : Order.height (genericPoint X.left) = n)
  (M : Fin (n + 1) × Fin (n + 1) → ℂ)
/-- The translated cone map evaluates a defining equation by explicit inverse substitution and projection. -/
theorem IntersectionProductScaf_translatedConeMap_C
    (F : MvPolynomial (Fin (n + 1) ⊕ Unit) ℂ) :
    IntersectionProductScaf_translatedConeMap X a M (Polynomial.C F) =
      algebraMap _ _ ((a3h_substLine M F).map
        ((Ideal.Quotient.mk (a3h_IXr (a3s_IX X))).comp
          (a3r_lin (a3h_block a)).toRingHom)) := by
  let f := (Ideal.Quotient.mk (a3h_IXr (a3s_IX X))).comp
    (a3r_lin (a3h_block a)).toRingHom
  let d := (IntersectionProductScaf_lineDet M).map
    (MvPolynomial.C : ℂ →+* MvPolynomial (Fin (n + 1) ⊕ Unit) ℂ)
  change (IsLocalization.Away.map (Localization.Away d)
    (Localization.Away ((Polynomial.mapRingHom f) d)) (Polynomial.mapRingHom f) d)
      ((IntersectionProductScaf_localizedTranslation (τ := Unit) M)
        (algebraMap _ _ (Polynomial.C F))) = _
  rw [IntersectionProductScaf_localizedTranslation_C,
    IsLocalization.Away.map, IsLocalization.map_eq]
  rfl

/-- The extended cylinder ideal equals the localized ideal of the explicit translated equations. -/
theorem IntersectionProductScaf_translatedCone_ideal
    (I : Ideal (MvPolynomial (Fin (n + 1) ⊕ Unit) ℂ)) :
    (I.map Polynomial.C).map (IntersectionProductScaf_translatedConeMap X a M) =
      (I.map (a3h_substLine M).toRingHom).map ((algebraMap _ _).comp
        (Polynomial.mapRingHom ((Ideal.Quotient.mk (a3h_IXr (a3s_IX X))).comp
          (a3r_lin (a3h_block a)).toRingHom))) := by
  rw [Ideal.map_map, Ideal.map_map]
  congr 1
  apply RingHom.ext
  intro F
  exact IntersectionProductScaf_translatedConeMap_C X M F

