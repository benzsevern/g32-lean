theorem IntersectionProductScaf_generic_component_generator_order
    (Y : Scheme.{0}) [IsIntegral Y] [IsLocallyNoetherian Y]
    (x : cycleComponent Y (genericPoint Y)) (hx : coheight x = 1)
    (r : Y.presheaf.stalk (cycleComponentι Y (genericPoint Y) x))
    (hr : r ≠ 0)
    (he : IsLocalRing.maximalIdeal _ = Ideal.span {r}) :
    (cycleComponent Y (genericPoint Y)).ord
      (algebraMap ((cycleComponent Y (genericPoint Y)).presheaf.stalk x)
        (cycleComponent Y (genericPoint Y)).functionField
        ((cycleComponentι Y (genericPoint Y)).stalkMap x r)) x = 1 := by
  have hi : Function.Injective ((cycleComponentι Y (genericPoint Y)).stalkMap x).hom := by
    rw [RingHom.injective_iff_ker_eq_bot, a3y_ker_stalkMap, a3c_stalkIdeal_genericPoint]
  have hn := (map_ne_zero_iff _ hi).mpr hr
  rw [a3y_ord_algebraMap x hx _ hn,
    IntersectionProductScaf_surjective_local_generator_order _
      ((cycleComponentι Y (genericPoint Y)).stalkMap_surjective x) r he]
  rfl
#print axioms IntersectionProductScaf_generic_component_generator_order
/-- The parameter divisor has coefficient one along the zero section. -/
theorem IntersectionProductScaf_parameter_zero_weight
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom] :
    a3k_cycT X (a3n_σ X 0 (genericPoint X.left)) = 1 := by
  obtain ⟨D, hD⟩ := a3z_exists_pt (genericPoint (a3n_T X).left)
    (genericPoint_specializes (a3n_σ X 0 (genericPoint X.left)))
  have hD1 : coheight D = 1 := by
    rw [a3y_coheight_eq_one_iff (a3n_T X), hD, a3k_coheight_genericPoint, zero_add,
      a3k_coheight_σ_generic]
  have e1 : a3k_cycT X (a3n_σ X 0 (genericPoint X.left)) =
      ((cycleComponent (a3n_T X).left _).ord (a3o_φ X _ (a3k_hη X)) D : ℚ) := by
    rw [← hD]
    exact a3y_principalCycle_apply _ _ _ (a3o_φ_ne_zero X _ (a3k_hη X)) D
  have h0 : a3n_h X (cycleComponentι (a3n_T X).left _ D) ∈
      Proj.basicOpen (UniversalGrading.{0} 1) (MvPolynomial.X 0) := by
    rw [hD]
    exact a3k_mem_basicOpen_σ X _ 0 (Or.inl rfl)
  let r := a3k_t1 X (cycleComponentι (a3n_T X).left _ D) h0
  have hlocal : ∀ (τ : (a3n_T X).left)
      (hτ : a3n_h X τ ∈ Proj.basicOpen (UniversalGrading.{0} 1) (MvPolynomial.X 0)),
      τ = a3n_σ X 0 (genericPoint X.left) →
      IsLocalRing.maximalIdeal _ = Ideal.span {a3k_t1 X τ hτ} ∧
      a3k_t1 X τ hτ ≠ 0 ∧ a3k_t1 X τ hτ ∈ IsLocalRing.maximalIdeal _ := by
    intro τ hτ hEq
    subst τ
    have he := IntersectionProductScaf_section_zero_coordinate_equation X (genericPoint X.left)
    refine ⟨?_, IntersectionProductScaf_section_generator_ne_zero X 0 _ _ he,
      a3k_t1_σ0 X _ hτ⟩
    rwa [a3c_stalkIdeal_self] at he
  obtain ⟨he, hr, hm⟩ := hlocal _ h0 hD
  have hu : IsUnit (r - 1) := by
    have h := IsLocalRing.isUnit_one_sub_self_of_mem_nonunits r hm
    simpa only [neg_sub] using h.neg
  let g := ((cycleComponentι (a3n_T X).left (genericPoint (a3n_T X).left)).stalkMap D).hom
  let F := algebraMap ((cycleComponent (a3n_T X).left (genericPoint (a3n_T X).left)).presheaf.stalk D)
    (cycleComponent (a3n_T X).left (genericPoint (a3n_T X).left)).functionField
  have ho := IntersectionProductScaf_generic_component_generator_order
    (a3n_T X).left D hD1 r hr he
  have hd : (cycleComponent (a3n_T X).left _).ord (F (g r) - 1) D = 0 := by
    have h := a3m_ord_algebraMap_of_isUnit D (g (r - 1)) (hu.map g)
    simpa only [map_sub, map_one] using h
  have hden : F (g r) - 1 ≠ 0 := by
    simpa only [map_sub, map_one] using ((hu.map g).map F).ne_zero
  have hφ := IntersectionProductScaf_parameter_pullback_expression
    (cycleComponentι (a3n_T X).left _ ≫ a3n_h X)
    (a3o_hgen X _ (a3k_hη X)) D h0
  have hs := congrArg (fun f => f ((g3c_P 1).presheaf.germ _
    (a3n_h X (cycleComponentι (a3n_T X).left _ D)) h0 a3k_S1))
    (Scheme.Hom.stalkMap_comp (cycleComponentι (a3n_T X).left _) (a3n_h X) D)
  simp only [Scheme.Hom.comp_apply] at hφ
  erw [hs] at hφ
  change a3o_φ X _ (a3k_hη X) = F (g r) / (F (g r) - 1) at hφ
  have hn : F (g r) ≠ 0 := by
    intro hz
    exact a3o_φ_ne_zero X _ (a3k_hη X) (by rw [hφ, hz, zero_div])
  rw [e1, hφ, IntersectionProductScaf_order_div D hn hden, ho, hd]
  norm_num
