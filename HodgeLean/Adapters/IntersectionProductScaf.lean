/-- The stalk length of a flat inverse image retains the input multiplicity and the residue-fibre multiplicity. -/
theorem IntersectionProductScaf_flat_comap_stalk_length
    {Y Z : Scheme} (f : Y ⟶ Z) [Flat f] (K : Z.IdealSheafData)
    (x : (K.comap f).subscheme) (U : Z.affineOpens)
    (hx : f ((K.comap f).subschemeι x) ∈ U.1) :
    let y := (K.comap f).subschemeι x
    let A := Z.presheaf.stalk (f y)
    let B := Y.presheaf.stalk y
    let I := (K.ideal U).map (Z.presheaf.germ U.1 (f y) hx).hom
    Module.length ((K.comap f).subscheme.presheaf.stalk x)
        ((K.comap f).subscheme.presheaf.stalk x) =
      Module.length A (A ⧸ I) *
        Module.length B (B ⧸ (IsLocalRing.maximalIdeal A).map (f.stalkMap y).hom) := by
  dsimp only
  let y := (K.comap f).subschemeι x
  let := (f.stalkMap y).hom.toAlgebra
  have : IsLocalHom (algebraMap (Z.presheaf.stalk (f y)) (Y.presheaf.stalk y)) :=
    inferInstanceAs (IsLocalHom (f.stalkMap y).hom)
  have : Module.Flat (Z.presheaf.stalk (f y)) (Y.presheaf.stalk y) := Flat.stalkMap f y
  rw [← a3l_length_quot_ker ((K.comap f).subschemeι.stalkMap x).hom
    ((K.comap f).subschemeι.stalkMap_surjective x) _ rfl,
    IntersectionProductScaf_comap_stalk_kernel f K x U hx]
  exact IntersectionProductScaf_flat_local_quotient_length _
#print axioms IntersectionProductScaf_flat_comap_stalk_length

section RegularModuleFreeness
universe v
open IsLocalRing RingTheory.Sequence

/-- A finite module is free when generators of the maximal ideal form a regular sequence on it. -/
theorem IntersectionProductScaf_free_of_regular_maximal_generators : ∀ (n : ℕ)
    (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
    (M : Type v) [AddCommGroup M] [Module R M] [Module.Finite R M]
    (rs : List R), rs.length = n → Ideal.ofList rs = maximalIdeal R →
      IsWeaklyRegular M rs → Module.Free R M := by
  intro n
  induction n with
  | zero =>
    intro R _ _ _ M _ _ _ rs hlen hspan hreg
    have he : rs = [] := List.length_eq_zero_iff.mp hlen
    rw [he, Ideal.ofList_nil] at hspan
    letI := (isField_iff_maximalIdeal_eq.mpr hspan.symm).toField
    infer_instance
  | succ n ih =>
    intro R _ _ _ M _ _ _ rs hlen hspan hreg
    cases rs with
    | nil => simp at hlen
    | cons x xs =>
      have hx : x ∈ maximalIdeal R := hspan ▸ Ideal.subset_span (by simp)
      have hproper : Ideal.span {x} ≠ ⊤ := by
        exact ne_top_of_le_ne_top (maximalIdeal.isMaximal R).ne_top
          (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hx))
      letI : Nontrivial (R ⧸ Ideal.span {x}) := Ideal.Quotient.nontrivial_iff.mpr hproper
      have : IsLocalRing (R ⧸ Ideal.span {x}) :=
        IsLocalRing.of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective
      have : Module.FinitePresentation R M := Module.finitePresentation_of_finite R M
      have hregs := (isWeaklyRegular_cons_iff' M x xs).mp hreg
      have hspan' : Ideal.ofList (xs.map (Ideal.Quotient.mk (Ideal.span {x}))) =
          maximalIdeal (R ⧸ Ideal.span {x}) := by
        rw [← map_maximalIdeal_of_surjective (Ideal.Quotient.mk (Ideal.span {x}))
          Ideal.Quotient.mk_surjective, ← hspan, Ideal.ofList_cons, Ideal.map_sup,
          Ideal.map_quotient_self, bot_sup_eq, Ideal.map_ofList]
      have : Module.Finite (R ⧸ Ideal.span {x}) (QuotSMulTop x M) :=
        Module.Finite.of_restrictScalars_finite R _ _
      have hfree := ih (R ⧸ Ideal.span {x}) (QuotSMulTop x M)
        (xs.map (Ideal.Quotient.mk (Ideal.span {x}))) (by simpa using Nat.succ.inj hlen)
        hspan' hregs.2
      apply (Module.free_quotSMulTop_iff_free R M ?_ hregs.1).mp hfree
      rwa [jacobson_eq_maximalIdeal _ bot_ne_top]
#print axioms IntersectionProductScaf_free_of_regular_maximal_generators
/-- Regular maximal-ideal generators at every localized module imply flatness. -/
theorem IntersectionProductScaf_flat_of_regular_localized_generators
    (R : Type u) [CommRing R] [IsNoetherianRing R]
    (M : Type v) [AddCommGroup M] [Module R M] [Module.Finite R M]
    (hreg : ∀ (P : Ideal R) [P.IsMaximal],
      ∃ rs : List (Localization.AtPrime P),
        Ideal.ofList rs = maximalIdeal (Localization.AtPrime P) ∧
        IsWeaklyRegular (LocalizedModule P.primeCompl M) rs) :
    Module.Flat R M := by
  apply Module.flat_of_localized_maximal
  intro P hP
  obtain ⟨rs, hs, hr⟩ := hreg P
  have : Module.Finite (Localization.AtPrime P) (LocalizedModule P.primeCompl M) :=
    Module.Finite.of_isLocalizedModule P.primeCompl
      (LocalizedModule.mkLinearMap P.primeCompl M)
  have : Module.Free (Localization.AtPrime P) (LocalizedModule P.primeCompl M) :=
    IntersectionProductScaf_free_of_regular_maximal_generators rs.length
      (Localization.AtPrime P) (LocalizedModule P.primeCompl M) rs rfl hs hr
  have : Module.Flat (Localization.AtPrime P) (LocalizedModule P.primeCompl M) := inferInstance
  have : Module.Flat R (Localization.AtPrime P) := IsLocalization.flat _ P.primeCompl
  exact Module.Flat.trans R (Localization.AtPrime P) _
#print axioms IntersectionProductScaf_flat_of_regular_localized_generators

