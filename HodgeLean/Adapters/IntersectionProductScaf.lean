/-- Regularity in all subscheme stalks implies regularity in its affine coordinate quotient. -/
theorem IntersectionProductScaf_affine_quotient_regular_of_stalks
    {Y : Scheme} (I : Y.IdealSheafData) (U : Y.affineOpens) (r : Γ(Y, U))
    (hr : ∀ x (hx : I.subschemeι x ∈ U.1),
      IsSMulRegular (I.subscheme.presheaf.stalk x)
        (I.subschemeι.stalkMap x (Y.presheaf.germ U.1 _ hx r))) :
    IsSMulRegular (Γ(Y, U) ⧸ I.ideal U) r := by
  have hreg : IsSMulRegular Γ(I.subscheme, I.subschemeι ⁻¹ᵁ U.1) (I.subschemeι.app U r) := by
    apply IntersectionProductScaf_section_regular_of_stalks
    intro x hx
    simpa only [Scheme.Hom.germ_stalkMap_apply] using hr x hx
  rw [← I.ker_subschemeι_app U]
  let e := RingHom.quotientKerEquivOfSurjective (I.subschemeι_app_surjective U)
  apply (Equiv.isSMulRegular_congr (e := e.toEquiv) (s := I.subschemeι.app U r) ?_).mpr hreg
  intro a
  change e (Ideal.Quotient.mk _ r * a) = I.subschemeι.app U r * e a
  rw [map_mul]
  rfl
#print axioms IntersectionProductScaf_affine_quotient_regular_of_stalks
