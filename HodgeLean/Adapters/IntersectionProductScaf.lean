/-- A nonzero zero-fibre coefficient maps to the projected input point. -/
theorem IntersectionProductScaf_translationFibreCycle_zero_image
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom]
    {n : ℕ} {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (M : Fin (n + 1) × Fin (n + 1) → ℂ)
    (hn : Order.height (genericPoint X.left) = n)
    (y y' : (a3n_T X).left)
    (hy' : IntersectionProductScaf_translationFibreCycle M a hfin y 0 y' ≠ 0) :
    (a3h_G (a3h_πO X hfin)).left y' = (a3h_G (a3h_πO X hfin)).left y := by
  rw [IntersectionProductScaf_translationFibreCycle_zero, a3m_smul_apply] at hy'
  apply (IntersectionProductScaf_projectionProduct_pullback_support X hfin hn _ y').mp
  exact (mul_ne_zero_iff.mp hy').2
#print axioms IntersectionProductScaf_translationFibreCycle_zero_image

section FamilyProjectionAction
open CategoryTheory.Limits MonoidalCategory CartesianMonoidalCategory
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

/-- The determinant-open family of a smooth integral complex scheme is integral. -/
theorem IntersectionProductScaf_familyOpen_integral
    {σ : Type} [Fintype σ]
    (Y : Over (Spec ↧ℂ)) [IsIntegral Y.left] [Smooth Y.hom] (M : σ × σ → ℂ) :
    IsIntegral (IntersectionProductScaf_familyOpen Y M).left := by
  have : Nonempty (IntersectionProductScaf_familyOpen Y M).left :=
    ⟨IntersectionProductScaf_familySection Y M 0 (by
      rw [IntersectionProductScaf_lineDet_zero]; exact isUnit_one) (genericPoint Y.left)⟩
  exact isIntegral_of_isOpenImmersion (IntersectionProductScaf_familyInclusion Y M).left
#print axioms IntersectionProductScaf_familyOpen_integral


/-- The structure morphism of the determinant-open family is smooth. -/
theorem IntersectionProductScaf_familyOpen_smooth
    {σ : Type} [Fintype σ]
    (Y : Over (Spec ↧ℂ)) [Smooth Y.hom] (M : σ × σ → ℂ) :
    Smooth (IntersectionProductScaf_familyOpen Y M).hom := by
  rw [← (IntersectionProductScaf_familyInclusion Y M).w]
  infer_instance
#print axioms IntersectionProductScaf_familyOpen_smooth


open MonoidalCategory in
/-- The finite projection with the invertible translation parameter retained. -/
def IntersectionProductScaf_familyProjection
    {σ : Type} [Fintype σ]
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] {n : ℕ}
    {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite) (M : σ × σ → ℂ) :
    IntersectionProductScaf_familyOpen X M ⟶
      IntersectionProductScaf_familyOpen (a3h_PnO n) M :=
  a3h_πO X hfin ▷ IntersectionProductScaf_parameterOver M
#print axioms IntersectionProductScaf_familyProjection


/-- Retaining the invertible translation parameter preserves finiteness. -/
theorem IntersectionProductScaf_familyProjection_finite
    {σ : Type} [Fintype σ]
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom]
    {n : ℕ} {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite) (M : σ × σ → ℂ) :
    IsFinite (IntersectionProductScaf_familyProjection X hfin M).left := by
  unfold IntersectionProductScaf_familyProjection
  rw [Over.whiskerRight_left]
  exact MorphismProperty.pullbackMap (P := @IsFinite)
    (inferInstance : IsFinite (a3h_πO X hfin).left)
    (inferInstance : IsFinite (𝟙 (IntersectionProductScaf_parameterOver M).left))
    (Over.w (a3h_πO X hfin)).symm (Category.id_comp _).symm
#print axioms IntersectionProductScaf_familyProjection_finite


/-- Retaining the determinant-open parameter preserves flatness of the projection. -/
theorem IntersectionProductScaf_familyProjection_flat
    {σ : Type} [Fintype σ]
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom]
    {n : ℕ} {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    [Flat (a3h_πO X hfin).left] (M : σ × σ → ℂ) :
    Flat (IntersectionProductScaf_familyProjection X hfin M).left := by
  unfold IntersectionProductScaf_familyProjection
  rw [Over.whiskerRight_left]
  exact MorphismProperty.pullbackMap (P := @Flat)
    (inferInstance : Flat (a3h_πO X hfin).left)
    (inferInstance : Flat (𝟙 (IntersectionProductScaf_parameterOver M).left))
    (Over.w (a3h_πO X hfin)).symm (Category.id_comp _).symm
#print axioms IntersectionProductScaf_familyProjection_flat

/-- In the matching dimension the projection covers the entire determinant-open target family. -/
theorem IntersectionProductScaf_familyProjection_surjective
    {σ : Type} [Fintype σ]
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom]
    {n : ℕ} {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite) (M : σ × σ → ℂ)
    (hn : Order.height (genericPoint X.left) = n) :
    Surjective (IntersectionProductScaf_familyProjection X hfin M).left := by
  have : Surjective (a3h_πO X hfin).left :=
    ⟨a3h_π_surjective X hfin (a3h_dim_cone X n hn)⟩
  have : MorphismProperty.IsStableUnderComposition (@Surjective.{0}) :=
    ⟨fun f g hf hg => ⟨hg.1.comp hf.1⟩⟩
  unfold IntersectionProductScaf_familyProjection
  rw [Over.whiskerRight_left]
  exact MorphismProperty.pullbackMap (P := @Surjective)
    (inferInstance : Surjective (a3h_πO X hfin).left)
    (inferInstance : Surjective (𝟙 (IntersectionProductScaf_parameterOver M).left))
    (Over.w (a3h_πO X hfin)).symm (Category.id_comp _).symm
#print axioms IntersectionProductScaf_familyProjection_surjective


/-- The finite projection on the determinant-open family lifts generalizations. -/
theorem IntersectionProductScaf_familyProjection_generalizing
    {σ : Type} [Fintype σ]
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom]
    {n : ℕ} {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite) (M : σ × σ → ℂ) [Smooth X.hom]
    (hn : Order.height (genericPoint X.left) = n) :
    GeneralizingMap (IntersectionProductScaf_familyProjection X hfin M).left := by
  have := IntersectionProductScaf_projective_smooth n
  have : Smooth (a3h_PnO n).hom := IntersectionProductScaf_projective_smooth n
  have := IntersectionProductScaf_projectionTarget_integral X hfin hn
  have := IntersectionProductScaf_familyOpen_integral X M
  have := IntersectionProductScaf_familyOpen_integral (a3h_PnO n) M
  have := IntersectionProductScaf_familyOpen_smooth (a3h_PnO n) M
  have := IntersectionProductScaf_familyProjection_finite X hfin M
  have := IntersectionProductScaf_familyProjection_surjective X hfin M hn
  exact IntersectionProductScaf_finite_normal_generalizing _
    (zmtiso_normal_of_smooth _ (IntersectionProductScaf_familyOpen (a3h_PnO n) M).hom)
#print axioms IntersectionProductScaf_familyProjection_generalizing

open CartesianMonoidalCategory in
/-- The determinant-open projection commutes with forgetting the translation parameter. -/
theorem IntersectionProductScaf_familyProjection_base
    {σ : Type} [Fintype σ]
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom]
    {n : ℕ} {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite) (M : σ × σ → ℂ) :
    IntersectionProductScaf_familyProjection X hfin M ≫
      IntersectionProductScaf_familyBase (a3h_PnO n) M =
        IntersectionProductScaf_familyBase X M ≫ a3h_πO X hfin := by
  exact whiskerRight_fst _ _
#print axioms IntersectionProductScaf_familyProjection_base


open CartesianMonoidalCategory in
/-- The determinant-open projection preserves the translation parameter. -/
theorem IntersectionProductScaf_familyProjection_parameter
    {σ : Type} [Fintype σ]
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom]
    {n : ℕ} {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite) (M : σ × σ → ℂ) :
    (IntersectionProductScaf_familyProjection X hfin M).left ≫
      pullback.snd (a3h_PnO n).hom (IntersectionProductScaf_parameterOver M).hom =
        pullback.snd X.hom (IntersectionProductScaf_parameterOver M).hom := by
  change ((IntersectionProductScaf_familyProjection X hfin M) ≫
    snd (a3h_PnO n) (IntersectionProductScaf_parameterOver M)).left = _
  rw [IntersectionProductScaf_familyProjection, whiskerRight_snd]
  rfl
#print axioms IntersectionProductScaf_familyProjection_parameter


/-- The translation matrix on the source family is pulled back from the target family. -/
theorem IntersectionProductScaf_familyProjection_matrix
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom]
    {n : ℕ} {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (M : Fin (n + 1) × Fin (n + 1) → ℂ) :
    (IntersectionProductScaf_familyProjection X hfin M).left.appTop.hom.mapMatrix
      (IntersectionProductScaf_familyMatrix (a3h_PnO n) M) =
        IntersectionProductScaf_familyMatrix X M := by
  ext i j
  change (IntersectionProductScaf_familyProjection X hfin M).left.appTop
    ((pullback.snd (a3h_PnO n).hom (IntersectionProductScaf_parameterOver M).hom).appTop
      ((Scheme.ΓSpecIso (.of (IntersectionProductScaf_lineRing M))).inv
        (IntersectionProductScaf_localLineMatrix M i j))) = _
  erw [← a3m_appTop_comp_apply]
  rw [IntersectionProductScaf_familyProjection_parameter]
  rfl
#print axioms IntersectionProductScaf_familyProjection_matrix

/-- A finite surjection between smooth integral complex schemes lifts generalizations after adjoining a projective parameter. -/
theorem IntersectionProductScaf_finite_smooth_product_generalizing
    {U V : Over (Spec ↧ℂ)} [IsIntegral U.left] [Smooth U.hom]
    [IsIntegral V.left] [Smooth V.hom] (f : U ⟶ V) [IsFinite f.left] [Surjective f.left] :
    GeneralizingMap (a3h_G f).left := by
  have : IsFinite (a3h_G f).left := by
    rw [Over.whiskerRight_left]
    exact MorphismProperty.pullbackMap (P := @IsFinite)
      (inferInstance : IsFinite f.left) (inferInstance : IsFinite (𝟙 a3n_P1.left))
      (Over.w f).symm (Category.id_comp _).symm
  have : MorphismProperty.IsStableUnderComposition (@Surjective.{0}) :=
    ⟨fun f g hf hg => ⟨hg.1.comp hf.1⟩⟩
  have : Surjective (a3h_G f).left := by
    rw [Over.whiskerRight_left]
    exact MorphismProperty.pullbackMap (P := @Surjective)
      (inferInstance : Surjective f.left) (inferInstance : Surjective (𝟙 a3n_P1.left))
      (Over.w f).symm (Category.id_comp _).symm
  exact IntersectionProductScaf_finite_normal_generalizing _
    (zmtiso_normal_of_smooth _ (a3n_T V).hom)
#print axioms IntersectionProductScaf_finite_smooth_product_generalizing


/-- Forgetting the determinant-open parameter is smooth. -/
theorem IntersectionProductScaf_familyBase_smooth
    {σ : Type} [Fintype σ]
    (Y : Over (Spec ↧ℂ)) (M : σ × σ → ℂ) :
    Smooth (IntersectionProductScaf_familyBase Y M).left := by
  have : IsOpenImmersion (IntersectionProductScaf_parameterOverInclusion M).left :=
    inferInstanceAs (IsOpenImmersion (IntersectionProductScaf_parameterInclusion M))
  have : Smooth (IntersectionProductScaf_parameterOver M).hom := by
    rw [← (IntersectionProductScaf_parameterOverInclusion M).w]
    infer_instance
  change Smooth (pullback.fst Y.hom (IntersectionProductScaf_parameterOver M).hom)
  infer_instance
#print axioms IntersectionProductScaf_familyBase_smooth


/-- A relative projective action factorization gives generalization lifting for the actual square map. -/
theorem IntersectionProductScaf_familyMap₁_generalizing_of_action
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom]
    {n : ℕ} {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite) [Smooth X.hom]
    (M : Fin (n + 1) × Fin (n + 1) → ℂ)
    (hn : Order.height (genericPoint X.left) = n)
    (e : IntersectionProductScaf_familyOpen (a3h_PnO n) M ≅
      IntersectionProductScaf_familyOpen (a3h_PnO n) M)
    (he : IntersectionProductScaf_familyMap₀ X hfin M =
      IntersectionProductScaf_familyProjection X hfin M ≫ e.hom ≫
        IntersectionProductScaf_familyBase (a3h_PnO n) M) :
    GeneralizingMap (IntersectionProductScaf_familyMap₁ X hfin M).left := by
  have : Smooth (a3h_PnO n).hom := IntersectionProductScaf_projective_smooth n
  have := IntersectionProductScaf_projectionTarget_integral X hfin hn
  have := IntersectionProductScaf_familyOpen_integral X M
  have := IntersectionProductScaf_familyOpen_smooth X M
  have := IntersectionProductScaf_familyOpen_integral (a3h_PnO n) M
  have := IntersectionProductScaf_familyOpen_smooth (a3h_PnO n) M
  have := IntersectionProductScaf_familyProjection_finite X hfin M
  have := IntersectionProductScaf_familyProjection_surjective X hfin M hn
  have : IsFinite (IntersectionProductScaf_familyProjection X hfin M ≫ e.hom).left := by
    change IsFinite ((IntersectionProductScaf_familyProjection X hfin M).left ≫ e.hom.left)
    infer_instance
  have : Surjective (IntersectionProductScaf_familyProjection X hfin M ≫ e.hom).left := by
    change Surjective ((IntersectionProductScaf_familyProjection X hfin M).left ≫ e.hom.left)
    infer_instance
  have hf := IntersectionProductScaf_finite_smooth_product_generalizing
    (IntersectionProductScaf_familyProjection X hfin M ≫ e.hom)
  have : Smooth (IntersectionProductScaf_familyBase (a3h_PnO n) M).left :=
    IntersectionProductScaf_familyBase_smooth (a3h_PnO n) M
  have : Smooth (a3h_G (IntersectionProductScaf_familyBase (a3h_PnO n) M)).left := by
    rw [Over.whiskerRight_left]
    exact MorphismProperty.pullbackMap (P := @Smooth)
      inferInstance (inferInstance : Smooth (𝟙 a3n_P1.left))
      (Over.w _).symm (Category.id_comp _).symm
  have hg := Flat.generalizingMap (a3h_G (IntersectionProductScaf_familyBase (a3h_PnO n) M)).left
  apply IntersectionProductScaf_familyMap₁_generalizing_of_product X hfin M
  rw [he, ← Category.assoc]
  change GeneralizingMap (((IntersectionProductScaf_familyProjection X hfin M ≫ e.hom) ≫
    IntersectionProductScaf_familyBase (a3h_PnO n) M) ▷ a3n_P1).left
  rw [comp_whiskerRight]
  exact hf.comp hg
#print axioms IntersectionProductScaf_familyMap₁_generalizing_of_action

end FamilyProjectionAction

section ProjectiveMatrixAction
open CategoryTheory.Limits MvPolynomial HomogeneousLocalization
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
attribute [local instance] MvPolynomial.gradedAlgebra
variable {n : ℕ} (Z : Scheme.{0}) (q : Z ⟶ a3m_Pn n)
/-- The standard projective charts pulled back along a map to projective space. -/
abbrev IntersectionProductScaf_actionCover : Z.OpenCover where
  __ := (Scheme.Cover.mkOfCovers (Fin (n + 1)) (fun j => Spec (a3m_PnT n j))
    (a3m_Pnκ n) (a3m_Pn_cover n)).pullback₁ q
  I₀ := Fin (n + 1)
  X j := pullback q (a3m_Pnκ n j)
  f j := pullback.fst q (a3m_Pnκ n j)

/-- Dehomogenized complex coordinates on a pulled-back projective chart. -/
def IntersectionProductScaf_actionCoordinates (j : Fin (n + 1)) :
    MvPolynomial (Fin (n + 1)) ℂ →+* Γ((IntersectionProductScaf_actionCover Z q).X j, ⊤) :=
  (pullback.snd q (a3m_Pnκ n j)).appTop.hom.comp
    ((Scheme.ΓSpecIso (a3m_PnT n j)).inv.hom.comp (a3m_Pnθ n j))

/-- Integral homogeneous sections on a pulled-back projective chart. -/
def IntersectionProductScaf_actionSections (j : Fin (n + 1)) :
    UniversalRing.{0} n →+* Γ((IntersectionProductScaf_actionCover Z q).X j, ⊤) :=
  (IntersectionProductScaf_actionCoordinates Z q j).comp
    (MvPolynomial.map ((Int.castRingHom ℂ).comp ULift.ringEquiv.toRingHom))

/-- The distinguished homogeneous coordinate is one in its own chart. -/
theorem IntersectionProductScaf_actionSections_self (j : Fin (n + 1)) :
    IntersectionProductScaf_actionSections Z q j (MvPolynomial.X j) = 1 := by
  simp only [IntersectionProductScaf_actionSections, RingHom.comp_apply, MvPolynomial.map_X]
  change (pullback.snd q (a3m_Pnκ n j)).appTop
    ((Scheme.ΓSpecIso (a3m_PnT n j)).inv (a3m_Pnθ n j (MvPolynomial.X j))) = 1
  rw [a3m_Pnθ_X_self, map_one, map_one]
#print axioms IntersectionProductScaf_actionSections_self


/-- The chart sections generate the irrelevant ideal. -/
theorem IntersectionProductScaf_actionSections_irrelevant (j : Fin (n + 1)) :
    (HomogeneousIdeal.irrelevant (UniversalGrading.{0} n)).toIdeal.map
      (IntersectionProductScaf_actionSections Z q j) = ⊤ := by
  apply Ideal.eq_top_of_isUnit_mem _ _ isUnit_one
  rw [← IntersectionProductScaf_actionSections_self Z q j]
  exact Ideal.mem_map_of_mem _
    (HomogeneousIdeal.mem_irrelevant_of_mem (UniversalGrading.{0} n) zero_lt_one
      (isHomogeneous_X (ULift.{0} ℤ) j))
#print axioms IntersectionProductScaf_actionSections_irrelevant


/-- Projective chart coordinates transform by their common invertible coordinate ratio. -/
theorem IntersectionProductScaf_actionCoordinates_overlap (j l : Fin (n + 1))
    (F : MvPolynomial (Fin (n + 1)) ℂ) (d : ℕ) (hF : F.IsHomogeneous d) :
    (pullback.snd ((IntersectionProductScaf_actionCover Z q).f j)
      ((IntersectionProductScaf_actionCover Z q).f l)).appTop
        (IntersectionProductScaf_actionCoordinates Z q l F) =
    (pullback.snd ((IntersectionProductScaf_actionCover Z q).f j)
      ((IntersectionProductScaf_actionCover Z q).f l)).appTop
        (IntersectionProductScaf_actionCoordinates Z q l (MvPolynomial.X j)) ^ d *
    (pullback.fst ((IntersectionProductScaf_actionCover Z q).f j)
      ((IntersectionProductScaf_actionCover Z q).f l)).appTop
        (IntersectionProductScaf_actionCoordinates Z q j F) := by
  let C := IntersectionProductScaf_actionCover Z q
  let f₁ := pullback.fst (C.f j) (C.f l)
  let f₂ := pullback.snd (C.f j) (C.f l)
  let r₁ := pullback.snd q (a3m_Pnκ n j)
  let r₂ := pullback.snd q (a3m_Pnκ n l)
  have hcond : (f₁ ≫ r₁) ≫ a3m_Pnκ n j = (f₂ ≫ r₂) ≫ a3m_Pnκ n l := by
    dsimp only [r₁, r₂]
    rw [Category.assoc, Category.assoc, ← pullback.condition, ← pullback.condition,
      ← Category.assoc, ← Category.assoc]
    exact congrArg (fun f => f ≫ q) (pullback.condition (f := C.f j) (g := C.f l))
  let ρ := pullback.lift _ _ hcond
  have h := congrArg ρ.appTop.hom (a3m_Pn_hov n j l F d hF)
  rw [map_mul, map_pow, ← a3m_appTop_comp_apply, ← a3m_appTop_comp_apply,
    ← a3m_appTop_comp_apply, pullback.lift_fst, pullback.lift_snd] at h
  simp only [a3m_appTop_comp_apply, C, f₁, f₂, r₁, r₂] at h
  exact h
#print axioms IntersectionProductScaf_actionCoordinates_overlap

/-- The coordinate ratio on a chart overlap is invertible. -/
theorem IntersectionProductScaf_actionCoordinates_unit (j l : Fin (n + 1)) :
    IsUnit ((pullback.snd ((IntersectionProductScaf_actionCover Z q).f j)
      ((IntersectionProductScaf_actionCover Z q).f l)).appTop
        (IntersectionProductScaf_actionCoordinates Z q l (MvPolynomial.X j))) := by
  let C := IntersectionProductScaf_actionCover Z q
  let u := (pullback.snd (C.f j) (C.f l)).appTop
    (IntersectionProductScaf_actionCoordinates Z q l (MvPolynomial.X j))
  let v := (pullback.fst (C.f j) (C.f l)).appTop
    (IntersectionProductScaf_actionCoordinates Z q j (MvPolynomial.X l))
  have h := IntersectionProductScaf_actionCoordinates_overlap Z q j l (MvPolynomial.X l) 1
    (isHomogeneous_X ℂ l)
  have huv : u * v = 1 := by
    have hself : IntersectionProductScaf_actionCoordinates Z q l (MvPolynomial.X l) = 1 := by
      change (pullback.snd q (a3m_Pnκ n l)).appTop
        ((Scheme.ΓSpecIso (a3m_PnT n l)).inv (a3m_Pnθ n l (MvPolynomial.X l))) = 1
      rw [a3m_Pnθ_X_self, map_one, map_one]
    simpa only [hself, map_one, pow_one, u, v] using h.symm
  exact (Units.mkOfMulEqOne u v huv).isUnit
#print axioms IntersectionProductScaf_actionCoordinates_unit


variable (A : Matrix (Fin (n + 1)) (Fin (n + 1)) Γ(Z, ⊤)) (hA : IsUnit A.det)
/-- Matrix-transformed homogeneous sections on a pulled-back projective chart. -/
def IntersectionProductScaf_actionTransformedSections (j : Fin (n + 1)) :=
  IntersectionProductScaf_matrixSections
    (((IntersectionProductScaf_actionCover Z q).f j).appTop.hom.mapMatrix A)
    (IntersectionProductScaf_actionSections Z q j)

include hA in
/-- Invertible matrices preserve the absence of a projective base locus. -/
theorem IntersectionProductScaf_actionTransformedSections_irrelevant (j : Fin (n + 1)) :
    (HomogeneousIdeal.irrelevant (UniversalGrading.{0} n)).toIdeal.map
      (IntersectionProductScaf_actionTransformedSections Z q A j) = ⊤ := by
  rw [IntersectionProductScaf_actionTransformedSections,
    IntersectionProductScaf_matrixSections_irrelevant _ (by
      rw [← RingHom.map_det]
      exact hA.map _), IntersectionProductScaf_actionSections_irrelevant]
#print axioms IntersectionProductScaf_actionTransformedSections_irrelevant


/-- The projective map represented by the transformed sections in one chart. -/
def IntersectionProductScaf_actionChart (j : Fin (n + 1)) :
    (IntersectionProductScaf_actionCover Z q).X j ⟶ g3c_P n :=
  Proj.fromOfGlobalSections (UniversalGrading.{0} n)
    (IntersectionProductScaf_actionTransformedSections Z q A j)
    (IntersectionProductScaf_actionTransformedSections_irrelevant Z q A hA j)

/-- The transformed projective chart maps agree on overlaps. -/
theorem IntersectionProductScaf_actionChart_compat (j l : Fin (n + 1)) :
    pullback.fst ((IntersectionProductScaf_actionCover Z q).f j)
      ((IntersectionProductScaf_actionCover Z q).f l) ≫
        IntersectionProductScaf_actionChart Z q A hA j =
    pullback.snd ((IntersectionProductScaf_actionCover Z q).f j)
      ((IntersectionProductScaf_actionCover Z q).f l) ≫
        IntersectionProductScaf_actionChart Z q A hA l := by
  let C := IntersectionProductScaf_actionCover Z q
  let p₁ := pullback.fst (C.f j) (C.f l)
  let p₂ := pullback.snd (C.f j) (C.f l)
  let f₁ := p₁.appTop.hom.comp (IntersectionProductScaf_actionTransformedSections Z q A j)
  let f₂ := p₂.appTop.hom.comp (IntersectionProductScaf_actionTransformedSections Z q A l)
  have h₁ : (HomogeneousIdeal.irrelevant (UniversalGrading.{0} n)).toIdeal.map f₁ = ⊤ := by
    dsimp only [f₁]
    rw [← Ideal.map_map, IntersectionProductScaf_actionTransformedSections_irrelevant Z q A hA,
      Ideal.map_top]
  have h₂ : (HomogeneousIdeal.irrelevant (UniversalGrading.{0} n)).toIdeal.map f₂ = ⊤ := by
    dsimp only [f₂]
    rw [← Ideal.map_map, IntersectionProductScaf_actionTransformedSections_irrelevant Z q A hA,
      Ideal.map_top]
  rw [IntersectionProductScaf_actionChart, IntersectionProductScaf_actionChart,
    spec_g3c_comp_fromOfGlobalSections_aux _ _ _ _ h₁,
    spec_g3c_comp_fromOfGlobalSections_aux _ _ _ _ h₂]
  let u := p₂.appTop (IntersectionProductScaf_actionCoordinates Z q l (MvPolynomial.X j))
  have hu : IsUnit u := IntersectionProductScaf_actionCoordinates_unit Z q j l
  apply spec_g3c_fromOfGlobalSections_unit_twist_aux _ f₁ f₂ h₁ h₂ hu.unit
  intro d r hr
  rw [hu.unit_spec]
  have hmat : p₁.appTop.hom.mapMatrix ((C.f j).appTop.hom.mapMatrix A) =
      p₂.appTop.hom.mapMatrix ((C.f l).appTop.hom.mapMatrix A) := by
    ext i k
    change p₁.appTop ((C.f j).appTop (A i k)) = p₂.appTop ((C.f l).appTop (A i k))
    rw [← a3m_appTop_comp_apply, ← a3m_appTop_comp_apply]
    exact congrArg (fun f : _ ⟶ Z => f.appTop (A i k)) pullback.condition
  change (p₂.appTop.hom.comp (IntersectionProductScaf_matrixSections _ _)) r =
    u ^ d * (p₁.appTop.hom.comp (IntersectionProductScaf_matrixSections _ _)) r
  rw [IntersectionProductScaf_matrixSections_map, IntersectionProductScaf_matrixSections_map]
  erw [hmat]
  apply IntersectionProductScaf_matrixSections_twist _ _ _ u _ _ r d hr
  · intro z
    obtain ⟨z⟩ := z
    have hz : (MvPolynomial.C (ULift.up z) : UniversalRing.{0} n) =
        (z : UniversalRing.{0} n) := by norm_cast
    rw [hz]
    simp only [map_intCast]
  · intro i
    change p₂.appTop (IntersectionProductScaf_actionSections Z q l (MvPolynomial.X i)) =
      u * p₁.appTop (IntersectionProductScaf_actionSections Z q j (MvPolynomial.X i))
    simp only [IntersectionProductScaf_actionSections, RingHom.comp_apply, MvPolynomial.map_X]
    simpa only [pow_one] using
      IntersectionProductScaf_actionCoordinates_overlap Z q j l (MvPolynomial.X i) 1
        (isHomogeneous_X ℂ i)
#print axioms IntersectionProductScaf_actionChart_compat


/-- The projective matrix action assembled from homogeneous chart sections. -/
def IntersectionProductScaf_projectiveMatrixMap : Z ⟶ g3c_P n :=
  (IntersectionProductScaf_actionCover Z q).glueMorphisms
    (IntersectionProductScaf_actionChart Z q A hA)
    (IntersectionProductScaf_actionChart_compat Z q A hA)
#print axioms IntersectionProductScaf_projectiveMatrixMap


/-- The matrix action with the complex structure morphism retained. -/
def IntersectionProductScaf_projectiveMatrixOverMap
    (Y : Over (Spec ↧ℂ)) (q : Y.left ⟶ a3m_Pn n)
    (A : Matrix (Fin (n + 1)) (Fin (n + 1)) Γ(Y.left, ⊤)) (hA : IsUnit A.det) :
    Y ⟶ a3h_PnO n :=
  Over.homMk (pullback.lift Y.hom
    (IntersectionProductScaf_projectiveMatrixMap Y.left q A hA)
    (terminal.hom_ext _ _)) (pullback.lift_fst _ _ _)
#print axioms IntersectionProductScaf_projectiveMatrixOverMap


open scoped MonoidalCategory
open CartesianMonoidalCategory
/-- The projective matrix action on the determinant-open target, retaining its parameter. -/
def IntersectionProductScaf_targetFamilyAction
    (M : Fin (n + 1) × Fin (n + 1) → ℂ) :
    IntersectionProductScaf_familyOpen (a3h_PnO n) M ⟶
      IntersectionProductScaf_familyOpen (a3h_PnO n) M :=
  lift (IntersectionProductScaf_projectiveMatrixOverMap
    (IntersectionProductScaf_familyOpen (a3h_PnO n) M)
    (IntersectionProductScaf_familyBase (a3h_PnO n) M).left
    (IntersectionProductScaf_familyMatrix (a3h_PnO n) M)
    (IntersectionProductScaf_familyMatrix_det (a3h_PnO n) M))
    (snd (a3h_PnO n) (IntersectionProductScaf_parameterOver M))
#print axioms IntersectionProductScaf_targetFamilyAction


/-- The target projective action preserves the invertible translation parameter. -/
theorem IntersectionProductScaf_targetFamilyAction_parameter
    (M : Fin (n + 1) × Fin (n + 1) → ℂ) :
    (IntersectionProductScaf_targetFamilyAction M).left ≫
      pullback.snd (a3h_PnO n).hom (IntersectionProductScaf_parameterOver M).hom =
        pullback.snd (a3h_PnO n).hom (IntersectionProductScaf_parameterOver M).hom := by
  change ((IntersectionProductScaf_targetFamilyAction M) ≫
    snd (a3h_PnO n) (IntersectionProductScaf_parameterOver M)).left = _
  rw [IntersectionProductScaf_targetFamilyAction, lift_snd]
  rfl
#print axioms IntersectionProductScaf_targetFamilyAction_parameter


/-- The target projective action leaves its parameter-dependent matrix unchanged. -/
theorem IntersectionProductScaf_targetFamilyAction_matrix
    (M : Fin (n + 1) × Fin (n + 1) → ℂ) :
    (IntersectionProductScaf_targetFamilyAction M).left.appTop.hom.mapMatrix
      (IntersectionProductScaf_familyMatrix (a3h_PnO n) M) =
        IntersectionProductScaf_familyMatrix (a3h_PnO n) M := by
  ext i j
  change (IntersectionProductScaf_targetFamilyAction M).left.appTop
    ((pullback.snd (a3h_PnO n).hom (IntersectionProductScaf_parameterOver M).hom).appTop
      ((Scheme.ΓSpecIso (.of (IntersectionProductScaf_lineRing M))).inv
        (IntersectionProductScaf_localLineMatrix M i j))) = _
  erw [← a3m_appTop_comp_apply]
  rw [IntersectionProductScaf_targetFamilyAction_parameter]
  rfl
#print axioms IntersectionProductScaf_targetFamilyAction_matrix


/-- In a normalized homogeneous chart the localization lift sends coordinate ratios to their sections. -/
theorem IntersectionProductScaf_awayLift_coordinate {n : ℕ} {Z : Scheme.{0}}
    (f : UniversalRing.{0} n →+* Γ(Z, ⊤)) (j k : Fin (n + 1))
    (hj : f (MvPolynomial.X j) = 1) :
    a3h_awayLift (UniversalGrading.{0} n) f (hj ▸ isUnit_one)
      (chartCoordinate j k) = f (MvPolynomial.X k) := by
  have h := a3h_awayLift_mk (UniversalGrading.{0} n) f (hj ▸ isUnit_one)
    (isHomogeneous_X (ULift.{0} ℤ) j) 1 (MvPolynomial.X k) (isHomogeneous_X (ULift.{0} ℤ) k)
  simpa only [chartCoordinate, hj, one_pow, one_mul] using h
#print axioms IntersectionProductScaf_awayLift_coordinate

/-- Normalized action sections recover the original affine chart homomorphism. -/
theorem IntersectionProductScaf_actionSections_awayLift {n : ℕ}
    (Z : Scheme.{0}) (q : Z ⟶ a3m_Pn n) (j : Fin (n + 1)) :
    a3h_awayLift (UniversalGrading.{0} n)
      (IntersectionProductScaf_actionSections Z q j)
      (by rw [IntersectionProductScaf_actionSections_self]; exact isUnit_one) =
    (pullback.snd q (a3m_Pnκ n j)).appTop.hom.comp
      ((Scheme.ΓSpecIso (a3m_PnT n j)).inv.hom.comp
        (Algebra.TensorProduct.includeRight (R := ℤ) (A := ℂ)
          (B := Away (UniversalGrading.{0} n) (MvPolynomial.X j))).toRingHom) := by
  let φ : UniversalRing.{0} n →+* Away (UniversalGrading.{0} n) (MvPolynomial.X j) :=
    eval₂Hom ((fromZeroRingHom (UniversalGrading n) (.powers (MvPolynomial.X j))).comp
      (ProjectiveSpace.degreeZeroEquiv (Fin (n+1)) (ULift.{0} ℤ)).symm.toRingHom)
      (chartCoordinate j)
  apply RingHom.ext
  intro z
  obtain ⟨F, rfl⟩ := a3m_awayCoord_surj n j z
  suffices h : (a3h_awayLift (UniversalGrading.{0} n)
      (IntersectionProductScaf_actionSections Z q j)
      (by rw [IntersectionProductScaf_actionSections_self]; exact isUnit_one)).comp φ =
      ((pullback.snd q (a3m_Pnκ n j)).appTop.hom.comp
      ((Scheme.ΓSpecIso (a3m_PnT n j)).inv.hom.comp
        (Algebra.TensorProduct.includeRight (R := ℤ) (A := ℂ)
          (B := Away (UniversalGrading.{0} n) (MvPolynomial.X j))).toRingHom)).comp φ by
    exact DFunLike.congr_fun h F
  apply MvPolynomial.ringHom_ext
  · intro ⟨c⟩
    have hc : (MvPolynomial.C (ULift.up c) : UniversalRing.{0} n) =
        (c : UniversalRing.{0} n) := by norm_cast
    rw [hc]
    simp only [map_intCast]
  · intro k
    simp only [RingHom.comp_apply, φ, MvPolynomial.eval₂Hom_X']
    rw [IntersectionProductScaf_awayLift_coordinate _ j k
      (IntersectionProductScaf_actionSections_self Z q j)]
    simp only [IntersectionProductScaf_actionSections, IntersectionProductScaf_actionCoordinates,
      RingHom.comp_apply, MvPolynomial.map_X, a3m_Pnθ, MvPolynomial.eval₂Hom_X']
    rfl
#print axioms IntersectionProductScaf_actionSections_awayLift


/-- The normalized chart sections reproduce the original projective chart map. -/
theorem IntersectionProductScaf_actionSections_map {n : ℕ}
    (Z : Scheme.{0}) (q : Z ⟶ a3m_Pn n) (j : Fin (n + 1)) :
    Proj.fromOfGlobalSections (UniversalGrading.{0} n)
      (IntersectionProductScaf_actionSections Z q j)
      (IntersectionProductScaf_actionSections_irrelevant Z q j) =
      (IntersectionProductScaf_actionCover Z q).f j ≫ q ≫
        pullback.snd (terminal.from (Spec ↧ℂ)) (terminal.from (g3c_P n)) := by
  rw [a3h_fromOf_eq (UniversalGrading.{0} n) _ _ zero_lt_one
    (isHomogeneous_X (ULift.{0} ℤ) j)
    (show IsUnit (IntersectionProductScaf_actionSections Z q j (MvPolynomial.X j)) by
      rw [IntersectionProductScaf_actionSections_self]; exact isUnit_one),
    IntersectionProductScaf_actionSections_awayLift]
  change _ = pullback.fst q (a3m_Pnκ n j) ≫ q ≫ _
  erw [pullback.condition_assoc]
  change (pullback q (a3m_Pnκ n j)).toSpecΓ ≫
    Spec.map (CommRingCat.ofHom
      ((pullback.snd q (a3m_Pnκ n j)).appTop.hom.comp
        ((Scheme.ΓSpecIso (a3m_PnT n j)).inv.hom.comp
          (Algebra.TensorProduct.includeRight (R := ℤ) (A := ℂ)
            (B := Away (UniversalGrading.{0} n) (MvPolynomial.X j))).toRingHom))) ≫
      g3c_chartι n j = _
  rw [show a3m_Pnκ n j ≫ pullback.snd (terminal.from (Spec ↧ℂ))
      (terminal.from (g3c_P n)) = _ from
    a3m_prodChart_snd (𝟙 (Spec ↧ℂ)) (g3c_chartι n j)]
  simp only [CommRingCat.ofHom_comp, CommRingCat.ofHom_hom, Spec.map_comp, Category.assoc]
  rw [← Category.assoc _ (Spec.map (pullback.snd q (a3m_Pnκ n j)).appTop),
    ← Scheme.toSpecΓ_naturality, Category.assoc,
    toSpecΓ_SpecMap_ΓSpecIso_inv_assoc]
#print axioms IntersectionProductScaf_actionSections_map

/-- The identity matrix recovers the original projective morphism. -/
theorem IntersectionProductScaf_projectiveMatrixMap_one {n : ℕ}
    (Z : Scheme.{0}) (q : Z ⟶ a3m_Pn n) :
    IntersectionProductScaf_projectiveMatrixMap Z q 1
      (by rw [Matrix.det_one]; exact isUnit_one) =
      q ≫ pullback.snd (terminal.from (Spec ↧ℂ)) (terminal.from (g3c_P n)) := by
  apply (IntersectionProductScaf_actionCover Z q).hom_ext
  intro j
  rw [IntersectionProductScaf_projectiveMatrixMap, Scheme.Cover.ι_glueMorphisms]
  unfold IntersectionProductScaf_actionChart IntersectionProductScaf_actionTransformedSections
  simp only [map_one, IntersectionProductScaf_matrixSections_one]
  exact IntersectionProductScaf_actionSections_map Z q j
#print axioms IntersectionProductScaf_projectiveMatrixMap_one

/-- The identity matrix also preserves a projective morphism over the complex base. -/
theorem IntersectionProductScaf_projectiveMatrixOverMap_one {n : ℕ}
    (Y : Over (Spec ↧ℂ)) (q : Y ⟶ a3h_PnO n) :
    IntersectionProductScaf_projectiveMatrixOverMap Y q.left 1
      (by rw [Matrix.det_one]; exact isUnit_one) = q := by
  apply Over.OverMorphism.ext
  apply pullback.hom_ext
  · change (pullback.lift _ _ _) ≫ pullback.fst _ _ = _
    rw [pullback.lift_fst]
    exact q.w.symm
  · change (pullback.lift _ _ _) ≫ pullback.snd _ _ = _
    rw [pullback.lift_snd]
    exact IntersectionProductScaf_projectiveMatrixMap_one Y.left q.left
#print axioms IntersectionProductScaf_projectiveMatrixOverMap_one

end ProjectiveMatrixAction

/-- Successive changes of homogeneous sections multiply their matrices in order. -/
theorem IntersectionProductScaf_matrixSections_mul
    {σ R B : Type} [Fintype σ] [DecidableEq σ] [CommRing R] [CommRing B]
    (A D : Matrix σ σ B) (f : MvPolynomial σ R →+* B) :
    IntersectionProductScaf_matrixSections A (IntersectionProductScaf_matrixSections D f) =
      IntersectionProductScaf_matrixSections (A * D) f := by
  apply MvPolynomial.ringHom_ext
  · intro r
    simp [IntersectionProductScaf_matrixSections]
  · intro i
    simp only [IntersectionProductScaf_matrixSections, MvPolynomial.eval₂Hom_X']
    exact congrFun (Matrix.mulVec_mulVec (fun j => f (MvPolynomial.X j)) A D) i
#print axioms IntersectionProductScaf_matrixSections_mul

/-- Applying an invertible matrix and then its inverse restores the sections. -/
theorem IntersectionProductScaf_matrixSections_inv_mul
    {σ R B : Type} [Fintype σ] [DecidableEq σ] [CommRing R] [CommRing B]
    (A : Matrix σ σ B) (hA : IsUnit A.det) (f : MvPolynomial σ R →+* B) :
    IntersectionProductScaf_matrixSections A⁻¹ (IntersectionProductScaf_matrixSections A f) = f := by
  rw [IntersectionProductScaf_matrixSections_mul, Matrix.nonsing_inv_mul A hA,
    IntersectionProductScaf_matrixSections_one]
#print axioms IntersectionProductScaf_matrixSections_inv_mul

section ProjectiveMatrixNaturality
open CategoryTheory.Limits MvPolynomial HomogeneousLocalization
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
attribute [local instance] MvPolynomial.gradedAlgebra
variable {n : ℕ} (Z W : Scheme.{0}) (q : Z ⟶ a3m_Pn n) (g : W ⟶ Z)
  (A : Matrix (Fin (n + 1)) (Fin (n + 1)) Γ(Z, ⊤)) (hA : IsUnit A.det)
  (hB : IsUnit (g.appTop.hom.mapMatrix A).det)
/-- Restriction between projective action charts over a morphism of domains. -/
def IntersectionProductScaf_actionRestriction (j : Fin (n + 1)) :
    (IntersectionProductScaf_actionCover W (g ≫ q)).X j ⟶
      (IntersectionProductScaf_actionCover Z q).X j :=
  pullback.lift (pullback.fst (g ≫ q) (a3m_Pnκ n j) ≫ g)
    (pullback.snd (g ≫ q) (a3m_Pnκ n j))
    ((Category.assoc _ _ _).trans pullback.condition)
/-- The matrix-transformed action sections commute with domain restriction. -/
theorem IntersectionProductScaf_actionTransformedSections_natural (j : Fin (n + 1)) :
    (IntersectionProductScaf_actionRestriction Z W q g j).appTop.hom.comp
        (IntersectionProductScaf_actionTransformedSections Z q A j) =
      IntersectionProductScaf_actionTransformedSections W (g ≫ q)
        (g.appTop.hom.mapMatrix A) j := by
  rw [IntersectionProductScaf_actionTransformedSections,
    IntersectionProductScaf_matrixSections_map, IntersectionProductScaf_actionTransformedSections]
  congr 1
  · ext i k
    change (IntersectionProductScaf_actionRestriction Z W q g j).appTop
      ((pullback.fst q (a3m_Pnκ n j)).appTop (A i k)) =
        (pullback.fst (g ≫ q) (a3m_Pnκ n j)).appTop (g.appTop (A i k))
    rw [← a3m_appTop_comp_apply, IntersectionProductScaf_actionRestriction, pullback.lift_fst,
      a3m_appTop_comp_apply]
  · apply RingHom.ext
    intro F
    change (IntersectionProductScaf_actionRestriction Z W q g j).appTop
      ((pullback.snd q (a3m_Pnκ n j)).appTop
        ((Scheme.ΓSpecIso (a3m_PnT n j)).inv
          (a3m_Pnθ n j (MvPolynomial.map
            ((Int.castRingHom ℂ).comp ULift.ringEquiv.toRingHom) F)))) =
      (pullback.snd (g ≫ q) (a3m_Pnκ n j)).appTop _
    rw [← a3m_appTop_comp_apply, IntersectionProductScaf_actionRestriction, pullback.lift_snd]
    rfl
#print axioms IntersectionProductScaf_actionTransformedSections_natural

/-- The projective action chart maps commute with domain restriction. -/
theorem IntersectionProductScaf_actionChart_natural (j : Fin (n + 1)) :
    IntersectionProductScaf_actionRestriction Z W q g j ≫
        IntersectionProductScaf_actionChart Z q A hA j =
      IntersectionProductScaf_actionChart W (g ≫ q)
        (g.appTop.hom.mapMatrix A) hB j := by
  have hi : (HomogeneousIdeal.irrelevant (UniversalGrading.{0} n)).toIdeal.map
      ((IntersectionProductScaf_actionRestriction Z W q g j).appTop.hom.comp
        (IntersectionProductScaf_actionTransformedSections Z q A j)) = ⊤ := by
    rw [IntersectionProductScaf_actionTransformedSections_natural]
    exact IntersectionProductScaf_actionTransformedSections_irrelevant W (g ≫ q) _ hB j
  rw [IntersectionProductScaf_actionChart,
    spec_g3c_comp_fromOfGlobalSections_aux _ _ _ _ hi]
  unfold IntersectionProductScaf_actionChart
  congr 1
  exact IntersectionProductScaf_actionTransformedSections_natural Z W q g A j
#print axioms IntersectionProductScaf_actionChart_natural

/-- The glued projective matrix action commutes with restriction of its domain. -/
theorem IntersectionProductScaf_projectiveMatrixMap_natural :
    g ≫ IntersectionProductScaf_projectiveMatrixMap Z q A hA =
      IntersectionProductScaf_projectiveMatrixMap W (g ≫ q)
        (g.appTop.hom.mapMatrix A) hB := by
  apply (IntersectionProductScaf_actionCover W (g ≫ q)).hom_ext
  intro j
  have hW := (IntersectionProductScaf_actionCover W (g ≫ q)).ι_glueMorphisms
    (IntersectionProductScaf_actionChart W (g ≫ q) (g.appTop.hom.mapMatrix A) hB)
    (IntersectionProductScaf_actionChart_compat W (g ≫ q) (g.appTop.hom.mapMatrix A) hB) j
  change (IntersectionProductScaf_actionCover W (g ≫ q)).f j ≫
    IntersectionProductScaf_projectiveMatrixMap W (g ≫ q) (g.appTop.hom.mapMatrix A) hB = _ at hW
  rw [hW, ← Category.assoc]
  have he : (IntersectionProductScaf_actionCover W (g ≫ q)).f j ≫ g =
      IntersectionProductScaf_actionRestriction Z W q g j ≫
        (IntersectionProductScaf_actionCover Z q).f j :=
    (pullback.lift_fst _ _ _).symm
  rw [he, Category.assoc]
  have hZ := (IntersectionProductScaf_actionCover Z q).ι_glueMorphisms
    (IntersectionProductScaf_actionChart Z q A hA)
    (IntersectionProductScaf_actionChart_compat Z q A hA) j
  change (IntersectionProductScaf_actionCover Z q).f j ≫
    IntersectionProductScaf_projectiveMatrixMap Z q A hA = _ at hZ
  rw [hZ]
  exact IntersectionProductScaf_actionChart_natural Z W q g A hA hB j
#print axioms IntersectionProductScaf_projectiveMatrixMap_natural

end ProjectiveMatrixNaturality

section ProjectiveSectionFactorization
open CategoryTheory.Limits MvPolynomial HomogeneousLocalization
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
attribute [local instance] MvPolynomial.gradedAlgebra
/-- A homogeneous section is invertible when its projective map factors through its affine chart. -/
theorem IntersectionProductScaf_projectiveSections_chart_unit {n : ℕ} (Z : Scheme.{0})
    (f : UniversalRing.{0} n →+* Γ(Z, ⊤))
    (hf : (HomogeneousIdeal.irrelevant (UniversalGrading.{0} n)).toIdeal.map f = ⊤)
    (j : Fin (n + 1)) (r : Z ⟶ Spec (.of (Away (UniversalGrading.{0} n) (MvPolynomial.X j))))
    (he : Proj.fromOfGlobalSections (UniversalGrading.{0} n) f hf = r ≫ g3c_chartι n j) :
    IsUnit (f (MvPolynomial.X j)) := by
  apply Z.toRingedSpace.isUnit_of_isUnit_germ
  intro x hx
  apply (Scheme.mem_basicOpen Z _ x hx).mp
  rw [← Proj.fromOfGlobalSections_preimage_basicOpen (UniversalGrading.{0} n) f hf
    zero_lt_one (isHomogeneous_X (ULift.{0} ℤ) j), he]
  change (r ≫ g3c_chartι n j) x ∈ Proj.basicOpen (UniversalGrading.{0} n) (MvPolynomial.X j)
  rw [← Proj.opensRange_awayι (UniversalGrading.{0} n) (MvPolynomial.X j)
    (isHomogeneous_X (ULift.{0} ℤ) j) zero_lt_one]
  exact ⟨r x, rfl⟩
#print axioms IntersectionProductScaf_projectiveSections_chart_unit

/-- Chart factorization identifies coordinate ratios with normalized homogeneous sections. -/
theorem IntersectionProductScaf_projectiveSections_chart_coordinate {n : ℕ} (Z : Scheme.{0})
    (f : UniversalRing.{0} n →+* Γ(Z, ⊤))
    (hf : (HomogeneousIdeal.irrelevant (UniversalGrading.{0} n)).toIdeal.map f = ⊤)
    (j k : Fin (n + 1)) (r : Z ⟶ Spec (.of (Away (UniversalGrading.{0} n) (MvPolynomial.X j))))
    (he : Proj.fromOfGlobalSections (UniversalGrading.{0} n) f hf = r ≫ g3c_chartι n j) :
    f (MvPolynomial.X j) * r.appTop
      ((Scheme.ΓSpecIso (.of (Away (UniversalGrading.{0} n) (MvPolynomial.X j)))).inv
        (chartCoordinate j k)) = f (MvPolynomial.X k) := by
  have hu := IntersectionProductScaf_projectiveSections_chart_unit Z f hf j r he
  have he' := he
  rw [a3h_fromOf_eq (UniversalGrading.{0} n) f hf zero_lt_one
    (isHomogeneous_X (ULift.{0} ℤ) j) hu] at he'
  have e : Z.toSpecΓ ≫ Spec.map (CommRingCat.ofHom
      (a3h_awayLift (UniversalGrading.{0} n) f hu)) = r :=
    (cancel_mono (g3c_chartι n j)).mp he'
  have hv := congrArg (fun m : Z ⟶ Spec (.of (Away (UniversalGrading.{0} n) (MvPolynomial.X j))) =>
    m.appTop ((Scheme.ΓSpecIso (.of (Away (UniversalGrading.{0} n) (MvPolynomial.X j)))).inv
      (chartCoordinate j k))) e
  rw [a3m_appTop_comp_SpecMap, Scheme.toSpecΓ_appTop] at hv
  have hv' : a3h_awayLift (UniversalGrading.{0} n) f hu (chartCoordinate j k) =
      r.appTop ((Scheme.ΓSpecIso (.of (Away (UniversalGrading.{0} n) (MvPolynomial.X j)))).inv
        (chartCoordinate j k)) := by simpa using hv
  rw [← hv']
  simpa only [chartCoordinate, pow_one] using
    a3h_awayLift_mk (UniversalGrading.{0} n) f hu
      (isHomogeneous_X (ULift.{0} ℤ) j) 1 (MvPolynomial.X k)
      (isHomogeneous_X (ULift.{0} ℤ) k)
#print axioms IntersectionProductScaf_projectiveSections_chart_coordinate

/-- The projective matrix action transforms any global homogeneous section presentation. -/
theorem IntersectionProductScaf_projectiveMatrixMap_ofSections {n : ℕ} (Z : Scheme.{0})
    (q : Z ⟶ a3m_Pn n) (A : Matrix (Fin (n + 1)) (Fin (n + 1)) Γ(Z, ⊤))
    (hA : IsUnit A.det) (f : UniversalRing.{0} n →+* Γ(Z, ⊤))
    (hf : (HomogeneousIdeal.irrelevant (UniversalGrading.{0} n)).toIdeal.map f = ⊤)
    (hq : q ≫ pullback.snd (terminal.from (Spec ↧ℂ)) (terminal.from (g3c_P n)) =
      Proj.fromOfGlobalSections (UniversalGrading.{0} n) f hf) :
    IntersectionProductScaf_projectiveMatrixMap Z q A hA =
      Proj.fromOfGlobalSections (UniversalGrading.{0} n)
        (IntersectionProductScaf_matrixSections A f)
        (by rw [IntersectionProductScaf_matrixSections_irrelevant A hA]; exact hf) := by
  let C := IntersectionProductScaf_actionCover Z q
  apply C.hom_ext
  intro j
  let f' := (C.f j).appTop.hom.comp f
  have hf' : (HomogeneousIdeal.irrelevant (UniversalGrading.{0} n)).toIdeal.map f' = ⊤ := by
    dsimp only [f']
    rw [← Ideal.map_map, hf, Ideal.map_top]
  let r := pullback.snd q (a3m_Pnκ n j) ≫ Spec.map (CommRingCat.ofHom
    (Algebra.TensorProduct.includeRight (R := ℤ) (A := ℂ)
      (B := Away (UniversalGrading.{0} n) (MvPolynomial.X j))).toRingHom)
  have he : Proj.fromOfGlobalSections (UniversalGrading.{0} n) f' hf' =
      r ≫ g3c_chartι n j := by
    rw [← spec_g3c_comp_fromOfGlobalSections_aux (UniversalGrading.{0} n) (C.f j) f hf hf',
      ← hq]
    change pullback.fst q (a3m_Pnκ n j) ≫ q ≫ _ = _
    rw [pullback.condition_assoc]
    rw [show a3m_Pnκ n j ≫ pullback.snd (terminal.from (Spec ↧ℂ))
      (terminal.from (g3c_P n)) = _ from
        a3m_prodChart_snd (𝟙 (Spec ↧ℂ)) (g3c_chartι n j)]
    rfl
  have hu := IntersectionProductScaf_projectiveSections_chart_unit (C.X j) f' hf' j r he
  have hcoords (k : Fin (n + 1)) : f' (MvPolynomial.X k) =
      f' (MvPolynomial.X j) * IntersectionProductScaf_actionSections Z q j (MvPolynomial.X k) := by
    have h := IntersectionProductScaf_projectiveSections_chart_coordinate (C.X j) f' hf' j k r he
    dsimp only [r] at h
    rw [a3m_appTop_comp_SpecMap] at h
    simp only [IntersectionProductScaf_actionSections, IntersectionProductScaf_actionCoordinates,
      RingHom.comp_apply, MvPolynomial.map_X, a3m_Pnθ, MvPolynomial.eval₂Hom_X']
    exact h.symm
  have htf : (HomogeneousIdeal.irrelevant (UniversalGrading.{0} n)).toIdeal.map
      ((C.f j).appTop.hom.comp (IntersectionProductScaf_matrixSections A f)) = ⊤ := by
    rw [← Ideal.map_map, IntersectionProductScaf_matrixSections_irrelevant A hA, hf, Ideal.map_top]
  change (IntersectionProductScaf_actionCover Z q).f j ≫ _ = _
  rw [IntersectionProductScaf_projectiveMatrixMap, Scheme.Cover.ι_glueMorphisms,
    spec_g3c_comp_fromOfGlobalSections_aux _ _ _ _ htf]
  unfold IntersectionProductScaf_actionChart
  apply spec_g3c_fromOfGlobalSections_unit_twist_aux _ _ _ _ _ hu.unit
  intro d F hF
  rw [hu.unit_spec]
  change ((C.f j).appTop.hom.comp (IntersectionProductScaf_matrixSections A f)) F =
    f' (MvPolynomial.X j) ^ d * IntersectionProductScaf_actionTransformedSections Z q A j F
  rw [IntersectionProductScaf_matrixSections_map]
  apply IntersectionProductScaf_matrixSections_twist _ f'
    (IntersectionProductScaf_actionSections Z q j) (f' (MvPolynomial.X j)) _ hcoords F d hF
  intro ⟨z⟩
  have hz : (MvPolynomial.C (ULift.up z) : UniversalRing.{0} n) =
      (z : UniversalRing.{0} n) := by norm_cast
  rw [hz]
  simp only [map_intCast]
#print axioms IntersectionProductScaf_projectiveMatrixMap_ofSections

/-- Successive projective matrix actions multiply the matrices in order. -/
theorem IntersectionProductScaf_projectiveMatrixMap_mul {n : ℕ} (Z : Scheme.{0})
    (q q' : Z ⟶ a3m_Pn n) (A B : Matrix (Fin (n + 1)) (Fin (n + 1)) Γ(Z, ⊤))
    (hA : IsUnit A.det) (hB : IsUnit B.det)
    (hq' : q' ≫ pullback.snd (terminal.from (Spec ↧ℂ)) (terminal.from (g3c_P n)) =
      IntersectionProductScaf_projectiveMatrixMap Z q A hA) :
    IntersectionProductScaf_projectiveMatrixMap Z q' B hB =
      IntersectionProductScaf_projectiveMatrixMap Z q (B * A)
        (by rw [Matrix.det_mul]; exact hB.mul hA) := by
  let C := IntersectionProductScaf_actionCover Z q
  apply C.hom_ext
  intro j
  have hBj : IsUnit ((C.f j).appTop.hom.mapMatrix B).det := by
    rw [← RingHom.map_det]
    exact hB.map _
  have hcA : C.f j ≫ IntersectionProductScaf_projectiveMatrixMap Z q A hA =
      IntersectionProductScaf_actionChart Z q A hA j :=
    C.ι_glueMorphisms _ _ j
  have hcBA : C.f j ≫ IntersectionProductScaf_projectiveMatrixMap Z q (B * A)
      (by rw [Matrix.det_mul]; exact hB.mul hA) =
      IntersectionProductScaf_actionChart Z q (B * A)
        (by rw [Matrix.det_mul]; exact hB.mul hA) j :=
    C.ι_glueMorphisms _ _ j
  rw [hcBA, IntersectionProductScaf_projectiveMatrixMap_natural Z (C.X j) q' (C.f j) B hB hBj]
  have he : (C.f j ≫ q') ≫ pullback.snd (terminal.from (Spec ↧ℂ)) (terminal.from (g3c_P n)) =
      Proj.fromOfGlobalSections (UniversalGrading.{0} n)
        (IntersectionProductScaf_actionTransformedSections Z q A j)
        (IntersectionProductScaf_actionTransformedSections_irrelevant Z q A hA j) := by
    rw [Category.assoc, hq', hcA]
    rfl
  rw [IntersectionProductScaf_projectiveMatrixMap_ofSections (C.X j) (C.f j ≫ q')
    ((C.f j).appTop.hom.mapMatrix B) hBj
    (IntersectionProductScaf_actionTransformedSections Z q A j)
    (IntersectionProductScaf_actionTransformedSections_irrelevant Z q A hA j) he]
  unfold IntersectionProductScaf_actionChart IntersectionProductScaf_actionTransformedSections
  congr 1
  rw [IntersectionProductScaf_matrixSections_mul, ← map_mul]
#print axioms IntersectionProductScaf_projectiveMatrixMap_mul

/-- Matrix composition respects the complex structure morphism. -/
theorem IntersectionProductScaf_projectiveMatrixOverMap_mul {n : ℕ}
    (Y : Over (Spec ↧ℂ)) (q : Y.left ⟶ a3m_Pn n)
    (A B : Matrix (Fin (n + 1)) (Fin (n + 1)) Γ(Y.left, ⊤))
    (hA : IsUnit A.det) (hB : IsUnit B.det) :
    IntersectionProductScaf_projectiveMatrixOverMap Y
      (IntersectionProductScaf_projectiveMatrixOverMap Y q A hA).left B hB =
      IntersectionProductScaf_projectiveMatrixOverMap Y q (B * A)
        (by rw [Matrix.det_mul]; exact hB.mul hA) := by
  apply Over.OverMorphism.ext
  apply pullback.hom_ext
  · change (pullback.lift _ _ _) ≫ pullback.fst _ _ =
      (pullback.lift _ _ _) ≫ pullback.fst _ _
    rw [pullback.lift_fst, pullback.lift_fst]
  · change (pullback.lift _ _ _) ≫ pullback.snd _ _ =
      (pullback.lift _ _ _) ≫ pullback.snd _ _
    rw [pullback.lift_snd, pullback.lift_snd]
    exact IntersectionProductScaf_projectiveMatrixMap_mul Y.left q _ A B hA hB
      (pullback.lift_snd _ _ _)
#print axioms IntersectionProductScaf_projectiveMatrixOverMap_mul

/-- The projective matrix action over the complex base commutes with domain restriction. -/
theorem IntersectionProductScaf_projectiveMatrixOverMap_natural {n : ℕ}
    (Y V : Over (Spec ↧ℂ)) (g : V ⟶ Y) (q : Y.left ⟶ a3m_Pn n)
    (A : Matrix (Fin (n + 1)) (Fin (n + 1)) Γ(Y.left, ⊤)) (hA : IsUnit A.det)
    (hB : IsUnit (g.left.appTop.hom.mapMatrix A).det) :
    g ≫ IntersectionProductScaf_projectiveMatrixOverMap Y q A hA =
      IntersectionProductScaf_projectiveMatrixOverMap V (g.left ≫ q)
        (g.left.appTop.hom.mapMatrix A) hB := by
  apply Over.OverMorphism.ext
  change g.left ≫ pullback.lift _ _ _ = pullback.lift _ _ _
  apply pullback.hom_ext
  · rw [Category.assoc, pullback.lift_fst, pullback.lift_fst]
    exact g.w
  · rw [Category.assoc, pullback.lift_snd, pullback.lift_snd]
    exact IntersectionProductScaf_projectiveMatrixMap_natural Y.left V.left q g.left A hA hB
#print axioms IntersectionProductScaf_projectiveMatrixOverMap_natural

open MonoidalCategory CartesianMonoidalCategory
/-- Any parameter-preserving endomorphism leaves the family matrix unchanged. -/
theorem IntersectionProductScaf_familyMatrix_invariant {n : ℕ}
    (M : Fin (n + 1) × Fin (n + 1) → ℂ)
    (g : IntersectionProductScaf_familyOpen (a3h_PnO n) M ⟶
      IntersectionProductScaf_familyOpen (a3h_PnO n) M)
    (hg : g ≫ snd (a3h_PnO n) (IntersectionProductScaf_parameterOver M) =
      snd (a3h_PnO n) (IntersectionProductScaf_parameterOver M)) :
    g.left.appTop.hom.mapMatrix (IntersectionProductScaf_familyMatrix (a3h_PnO n) M) =
      IntersectionProductScaf_familyMatrix (a3h_PnO n) M := by
  have he : g.left ≫
      pullback.snd (a3h_PnO n).hom (IntersectionProductScaf_parameterOver M).hom =
        pullback.snd (a3h_PnO n).hom (IntersectionProductScaf_parameterOver M).hom :=
    congrArg Over.Hom.left hg
  ext i j
  change g.left.appTop
    ((pullback.snd (a3h_PnO n).hom (IntersectionProductScaf_parameterOver M).hom).appTop
      ((Scheme.ΓSpecIso (.of (IntersectionProductScaf_lineRing M))).inv
        (IntersectionProductScaf_localLineMatrix M i j))) = _
  erw [← a3m_appTop_comp_apply]
  rw [he]
  rfl
#print axioms IntersectionProductScaf_familyMatrix_invariant

/-- A ring endomorphism fixing an invertible matrix also fixes its inverse. -/
theorem IntersectionProductScaf_matrix_inverse_invariant
    {σ R : Type} [Fintype σ] [DecidableEq σ] [CommRing R]
    (φ : R →+* R) (A : Matrix σ σ R) (hA : IsUnit A.det)
    (hφ : φ.mapMatrix A = A) : φ.mapMatrix A⁻¹ = A⁻¹ := by
  have h := congrArg φ.mapMatrix (Matrix.nonsing_inv_mul A hA)
  simp only [map_mul, map_one, hφ] at h
  exact (Matrix.inv_eq_left_inv h).symm
#print axioms IntersectionProductScaf_matrix_inverse_invariant

/-- The inverse projective matrix action retaining the translation parameter. -/
def IntersectionProductScaf_targetFamilyInverse {n : ℕ}
    (M : Fin (n + 1) × Fin (n + 1) → ℂ) :
    IntersectionProductScaf_familyOpen (a3h_PnO n) M ⟶
      IntersectionProductScaf_familyOpen (a3h_PnO n) M :=
  lift (IntersectionProductScaf_projectiveMatrixOverMap
    (IntersectionProductScaf_familyOpen (a3h_PnO n) M)
    (IntersectionProductScaf_familyBase (a3h_PnO n) M).left
    (IntersectionProductScaf_familyMatrix (a3h_PnO n) M)⁻¹
    (Matrix.isUnit_nonsing_inv_det _ (IntersectionProductScaf_familyMatrix_det (a3h_PnO n) M)))
    (snd (a3h_PnO n) (IntersectionProductScaf_parameterOver M))
/-- The inverse projective matrix action retains the translation parameter. -/
theorem IntersectionProductScaf_targetFamilyInverse_parameter {n : ℕ}
    (M : Fin (n + 1) × Fin (n + 1) → ℂ) :
    IntersectionProductScaf_targetFamilyInverse M ≫
      snd (a3h_PnO n) (IntersectionProductScaf_parameterOver M) =
        snd (a3h_PnO n) (IntersectionProductScaf_parameterOver M) := by
  rw [IntersectionProductScaf_targetFamilyInverse, lift_snd]
#print axioms IntersectionProductScaf_targetFamilyInverse_parameter

/-- The inverse matrix action undoes the target family action. -/
theorem IntersectionProductScaf_targetFamilyAction_inv {n : ℕ}
    (M : Fin (n + 1) × Fin (n + 1) → ℂ) :
    IntersectionProductScaf_targetFamilyAction M ≫ IntersectionProductScaf_targetFamilyInverse M = 𝟙 _ := by
  let Y := IntersectionProductScaf_familyOpen (a3h_PnO n) M
  let A := IntersectionProductScaf_familyMatrix (a3h_PnO n) M
  have hA : IsUnit A.det := IntersectionProductScaf_familyMatrix_det (a3h_PnO n) M
  have hiA : IsUnit A⁻¹.det := Matrix.isUnit_nonsing_inv_det _ hA
  let e := IntersectionProductScaf_targetFamilyAction M
  have hmap : e.left.appTop.hom.mapMatrix A⁻¹ = A⁻¹ :=
    IntersectionProductScaf_matrix_inverse_invariant _ A hA
      (IntersectionProductScaf_targetFamilyAction_matrix M)
  have hq : e.left ≫ (IntersectionProductScaf_familyBase (a3h_PnO n) M).left =
      (IntersectionProductScaf_projectiveMatrixOverMap Y
        (IntersectionProductScaf_familyBase (a3h_PnO n) M).left A hA).left :=
    congrArg Over.Hom.left (lift_fst _ _)
  apply CartesianMonoidalCategory.hom_ext
  · rw [Category.assoc, IntersectionProductScaf_targetFamilyInverse, lift_fst, Category.id_comp]
    change e ≫ IntersectionProductScaf_projectiveMatrixOverMap Y
      (IntersectionProductScaf_familyBase (a3h_PnO n) M).left A⁻¹ hiA = _
    rw [IntersectionProductScaf_projectiveMatrixOverMap_natural Y Y e _ A⁻¹ hiA
      (by rw [← RingHom.map_det]; exact hiA.map _)]
    dsimp only [Y, a3h_PnO] at *
    simp only [hmap, hq]
    rw [IntersectionProductScaf_projectiveMatrixOverMap_mul]
    simp only [Matrix.nonsing_inv_mul A hA]
    exact IntersectionProductScaf_projectiveMatrixOverMap_one Y
      (IntersectionProductScaf_familyBase (a3h_PnO n) M)
  · rw [Category.assoc, IntersectionProductScaf_targetFamilyInverse_parameter,
      IntersectionProductScaf_targetFamilyAction, lift_snd, Category.id_comp]
#print axioms IntersectionProductScaf_targetFamilyAction_inv

/-- The target family action undoes its inverse matrix action. -/
theorem IntersectionProductScaf_targetFamilyInverse_inv {n : ℕ}
    (M : Fin (n + 1) × Fin (n + 1) → ℂ) :
    IntersectionProductScaf_targetFamilyInverse M ≫ IntersectionProductScaf_targetFamilyAction M = 𝟙 _ := by
  let Y := IntersectionProductScaf_familyOpen (a3h_PnO n) M
  let A := IntersectionProductScaf_familyMatrix (a3h_PnO n) M
  have hA : IsUnit A.det := IntersectionProductScaf_familyMatrix_det (a3h_PnO n) M
  have hiA : IsUnit A⁻¹.det := Matrix.isUnit_nonsing_inv_det _ hA
  let e := IntersectionProductScaf_targetFamilyInverse M
  have hmap : e.left.appTop.hom.mapMatrix A = A :=
    IntersectionProductScaf_familyMatrix_invariant M e
      (IntersectionProductScaf_targetFamilyInverse_parameter M)
  have hq : e.left ≫ (IntersectionProductScaf_familyBase (a3h_PnO n) M).left =
      (IntersectionProductScaf_projectiveMatrixOverMap Y
        (IntersectionProductScaf_familyBase (a3h_PnO n) M).left A⁻¹ hiA).left :=
    congrArg Over.Hom.left (lift_fst _ _)
  apply CartesianMonoidalCategory.hom_ext
  · rw [Category.assoc, IntersectionProductScaf_targetFamilyAction, lift_fst, Category.id_comp]
    change e ≫ IntersectionProductScaf_projectiveMatrixOverMap Y
      (IntersectionProductScaf_familyBase (a3h_PnO n) M).left A hA = _
    rw [IntersectionProductScaf_projectiveMatrixOverMap_natural Y Y e _ A hA
      (by rw [← RingHom.map_det]; exact hA.map _)]
    dsimp only [Y, a3h_PnO] at *
    simp only [hmap, hq]
    rw [IntersectionProductScaf_projectiveMatrixOverMap_mul]
    simp only [Matrix.mul_nonsing_inv A hA]
    exact IntersectionProductScaf_projectiveMatrixOverMap_one Y
      (IntersectionProductScaf_familyBase (a3h_PnO n) M)
  · rw [Category.assoc, IntersectionProductScaf_targetFamilyAction, lift_snd,
      IntersectionProductScaf_targetFamilyInverse_parameter, Category.id_comp]
#print axioms IntersectionProductScaf_targetFamilyInverse_inv

/-- The determinant-open target family is carried isomorphically by its projective matrix action. -/
def IntersectionProductScaf_targetFamilyIso {n : ℕ}
    (M : Fin (n + 1) × Fin (n + 1) → ℂ) :
    IntersectionProductScaf_familyOpen (a3h_PnO n) M ≅
      IntersectionProductScaf_familyOpen (a3h_PnO n) M where
  hom := IntersectionProductScaf_targetFamilyAction M
  inv := IntersectionProductScaf_targetFamilyInverse M
  hom_inv_id := IntersectionProductScaf_targetFamilyAction_inv M
  inv_hom_id := IntersectionProductScaf_targetFamilyInverse_inv M
#print axioms IntersectionProductScaf_targetFamilyIso

/-- The translated projection is the projective matrix action on the original projection. -/
theorem IntersectionProductScaf_translatedProjection₀_matrixMap
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] {n : ℕ}
    {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (Z : Over (Spec ↧ℂ)) (q : Z.left ⟶ X.left)
    (A : Matrix (Fin (n + 1)) (Fin (n + 1)) Γ(Z.left, ⊤)) (hA : IsUnit A.det) :
    IntersectionProductScaf_translatedProjection₀ X hfin Z q A hA =
      IntersectionProductScaf_projectiveMatrixMap Z.left (q ≫ (a3h_πO X hfin).left) A hA := by
  let C := IntersectionProductScaf_projectionCover X Z q
  apply C.hom_ext
  intro j
  have hAj : IsUnit ((C.f j).appTop.hom.mapMatrix A).det := by
    rw [← RingHom.map_det]
    exact hA.map _
  let f := IntersectionProductScaf_projectionSections X (a := a) Z q j
  have hf : (HomogeneousIdeal.irrelevant (UniversalGrading.{0} n)).toIdeal.map f = ⊤ := by
    dsimp only [f, IntersectionProductScaf_projectionSections]
    rw [← Ideal.map_map, a3h_sect_irrelevant X hfin, Ideal.map_top]
  have he : (C.f j ≫ (q ≫ (a3h_πO X hfin).left)) ≫
      pullback.snd (terminal.from (Spec ↧ℂ)) (terminal.from (g3c_P n)) =
      Proj.fromOfGlobalSections (UniversalGrading.{0} n) f hf := by
    simp only [Category.assoc]
    change C.f j ≫ q ≫ a3h_π X hfin ≫ _ = _
    rw [a3h_π_snd, ← IntersectionProductScaf_translatedProjection₀_one X hfin Z q,
      IntersectionProductScaf_translatedProjection₀_chart]
    unfold IntersectionProductScaf_translatedChart IntersectionProductScaf_translatedSections
      IntersectionProductScaf_chartMatrix
    simp only [map_one, IntersectionProductScaf_matrixSections_one]
    rfl
  rw [IntersectionProductScaf_translatedProjection₀_chart,
    IntersectionProductScaf_projectiveMatrixMap_natural Z.left (C.X j)
      (q ≫ (a3h_πO X hfin).left) (C.f j) A hA hAj,
    IntersectionProductScaf_projectiveMatrixMap_ofSections (C.X j) _ _ hAj f hf he]
  rfl
#print axioms IntersectionProductScaf_translatedProjection₀_matrixMap

/-- The translated projection over the complex base is the matrix action on the original projection. -/
theorem IntersectionProductScaf_translatedProjection_matrixOverMap
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] {n : ℕ}
    {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (Z : Over (Spec ↧ℂ)) (q : Z.left ⟶ X.left)
    (A : Matrix (Fin (n + 1)) (Fin (n + 1)) Γ(Z.left, ⊤)) (hA : IsUnit A.det) :
    IntersectionProductScaf_translatedProjection X hfin Z q A hA =
      IntersectionProductScaf_projectiveMatrixOverMap Z (q ≫ (a3h_πO X hfin).left) A hA := by
  apply Over.OverMorphism.ext
  apply pullback.hom_ext
  · change (pullback.lift _ _ _) ≫ pullback.fst _ _ =
      (pullback.lift _ _ _) ≫ pullback.fst _ _
    rw [pullback.lift_fst, pullback.lift_fst]
  · change (pullback.lift _ _ _) ≫ pullback.snd _ _ =
      (pullback.lift _ _ _) ≫ pullback.snd _ _
    rw [pullback.lift_snd, pullback.lift_snd]
    exact IntersectionProductScaf_translatedProjection₀_matrixMap X hfin Z q A hA
#print axioms IntersectionProductScaf_translatedProjection_matrixOverMap

/-- The translated family projection factors through the target projective matrix action. -/
theorem IntersectionProductScaf_familyMap₀_factor
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] {n : ℕ}
    {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (M : Fin (n + 1) × Fin (n + 1) → ℂ) :
    IntersectionProductScaf_familyMap₀ X hfin M =
      IntersectionProductScaf_familyProjection X hfin M ≫
        IntersectionProductScaf_targetFamilyAction M ≫
          IntersectionProductScaf_familyBase (a3h_PnO n) M := by
  have hbase : IntersectionProductScaf_targetFamilyAction M ≫
      IntersectionProductScaf_familyBase (a3h_PnO n) M =
      IntersectionProductScaf_projectiveMatrixOverMap
        (IntersectionProductScaf_familyOpen (a3h_PnO n) M)
        (IntersectionProductScaf_familyBase (a3h_PnO n) M).left
        (IntersectionProductScaf_familyMatrix (a3h_PnO n) M)
        (IntersectionProductScaf_familyMatrix_det (a3h_PnO n) M) := lift_fst _ _
  rw [IntersectionProductScaf_familyMap₀, IntersectionProductScaf_translatedProjection_matrixOverMap,
    hbase]
  symm
  rw [IntersectionProductScaf_projectiveMatrixOverMap_natural
    (IntersectionProductScaf_familyOpen (a3h_PnO n) M)
    (IntersectionProductScaf_familyOpen X M)
    (IntersectionProductScaf_familyProjection X hfin M) _ _ _
    (by rw [← RingHom.map_det]; exact (IntersectionProductScaf_familyMatrix_det (a3h_PnO n) M).map _)]
  congr 1
  · exact congrArg Over.Hom.left (IntersectionProductScaf_familyProjection_base X hfin M)
  · exact IntersectionProductScaf_familyProjection_matrix X hfin M
#print axioms IntersectionProductScaf_familyMap₀_factor

/-- The relative matrix action preserves flatness of the translated family map. -/
theorem IntersectionProductScaf_familyMap₀_flat_of_projection
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom]
    {n : ℕ} {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    [Flat (a3h_πO X hfin).left] (M : Fin (n + 1) × Fin (n + 1) → ℂ) :
    Flat (IntersectionProductScaf_familyMap₀ X hfin M).left := by
  have := IntersectionProductScaf_familyProjection_flat X hfin M
  have := IntersectionProductScaf_familyBase_smooth (a3h_PnO n) M
  rw [IntersectionProductScaf_familyMap₀_factor]
  change Flat ((IntersectionProductScaf_familyProjection X hfin M).left ≫
    (IntersectionProductScaf_targetFamilyIso M).hom.left ≫
      (IntersectionProductScaf_familyBase (a3h_PnO n) M).left)
  infer_instance
#print axioms IntersectionProductScaf_familyMap₀_flat_of_projection

/-- Reordering the original parameter preserves flatness of the square-family map. -/
theorem IntersectionProductScaf_familyMap₁_flat_of_projection
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom]
    {n : ℕ} {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    [Flat (a3h_πO X hfin).left] (M : Fin (n + 1) × Fin (n + 1) → ℂ) :
    Flat (IntersectionProductScaf_familyMap₁ X hfin M).left := by
  have := IntersectionProductScaf_familyMap₀_flat_of_projection X hfin M
  have : Flat (a3h_G (IntersectionProductScaf_familyMap₀ X hfin M)).left := by
    rw [Over.whiskerRight_left]
    exact MorphismProperty.pullbackMap (P := @Flat)
      inferInstance (inferInstance : Flat (𝟙 a3n_P1.left))
      (Over.w _).symm (Category.id_comp _).symm
  rw [IntersectionProductScaf_familyMap₁_product]
  change Flat ((IntersectionProductScaf_originalProductIso X M).hom.left ≫ _)
  infer_instance
#print axioms IntersectionProductScaf_familyMap₁_flat_of_projection

/-- The square-family map lifts generalizations for every translation matrix. -/
theorem IntersectionProductScaf_familyMap₁_generalizing
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] [Smooth X.hom] {n : ℕ}
    {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (M : Fin (n + 1) × Fin (n + 1) → ℂ)
    (hn : Order.height (genericPoint X.left) = n) :
    GeneralizingMap (IntersectionProductScaf_familyMap₁ X hfin M).left := by
  exact IntersectionProductScaf_familyMap₁_generalizing_of_action X hfin M hn
    (IntersectionProductScaf_targetFamilyIso M) (IntersectionProductScaf_familyMap₀_factor X hfin M)
#print axioms IntersectionProductScaf_familyMap₁_generalizing

