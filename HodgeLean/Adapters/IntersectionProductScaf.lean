/-- Trivial contraction of an input parameter gives genericity of that parameter on every
translated cone component. -/
theorem IntersectionProductScaf_translatedCone_component_inputParameter_generic_of_comap
    (I : Ideal (MvPolynomial (Fin (n + 1) ⊕ Unit) ℂ)) [I.IsPrime]
    (Q : PrimeSpectrum _) (hQ : Q.asIdeal ∈ ((I.map Polynomial.C).map
      (IntersectionProductScaf_translatedConeMap X a M)).minimalPrimes)
    (u : Polynomial ℂ →+* MvPolynomial (Fin (n + 1) ⊕ Unit) ℂ)
    (hu : I.comap u = ⊥) :
    let g : Polynomial ℂ →+* _ :=
      (IntersectionProductScaf_translatedConeMap X a M).comp
        ((Polynomial.C : MvPolynomial (Fin (n + 1) ⊕ Unit) ℂ →+*
          Polynomial (MvPolynomial (Fin (n + 1) ⊕ Unit) ℂ)).comp u)
    (Spec.map (CommRingCat.ofHom g)) Q =
      genericPoint (Spec (.of (Polynomial ℂ))) := by
  apply IntersectionProductScaf_translatedCone_component_inputParameter_generic
    X hfin hn M I Q hQ u
  intro p hp hmem
  have : p ∈ I.comap u := hmem
  rw [hu, Ideal.mem_bot] at this
  exact hp this

