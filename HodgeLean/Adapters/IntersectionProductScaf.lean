/-- Flat extension from a prime quotient preserves regularity of an element outside the prime. -/
theorem IntersectionProductScaf_flat_primeQuotient_regular
    {A B : Type u} [CommRing A] (P : Ideal A) [P.IsPrime] (r : A) (hr : r ∉ P)
    [CommRing B] [Algebra (A ⧸ P) B] [Module.Flat (A ⧸ P) B] :
    IsSMulRegular B (algebraMap (A ⧸ P) B (Ideal.Quotient.mk P r)) := by
  have hreg : IsSMulRegular (A ⧸ P) (Ideal.Quotient.mk P r) := by
    intro x y hxy
    have hrp : Ideal.Quotient.mk P r ≠ 0 := by
      simpa only [ne_eq, Ideal.Quotient.eq_zero_iff_mem] using hr
    exact mul_left_cancel₀ hrp hxy
  exact hreg.of_flat

#print axioms IntersectionProductScaf_flat_primeQuotient_regular

/-- The same flat-extension regularity, viewed through the original ring's scalar action. -/
theorem IntersectionProductScaf_flat_primeQuotient_regular_restrictScalars
    {A B : Type u} [CommRing A] (P : Ideal A) [P.IsPrime] (r : A) (hr : r ∉ P)
    [CommRing B] [Algebra (A ⧸ P) B] [Algebra A B]
    [IsScalarTower A (A ⧸ P) B] [Module.Flat (A ⧸ P) B] :
    IsSMulRegular B r := by
  have hreg := IntersectionProductScaf_flat_primeQuotient_regular P r hr (B := B)
  have he : algebraMap A B r =
      algebraMap (A ⧸ P) B (Ideal.Quotient.mk P r) := by
    rw [← Ideal.Quotient.algebraMap_eq]
    exact IsScalarTower.algebraMap_apply A (A ⧸ P) B r
  intro x y hxy
  have hxy' : algebraMap A B r * x = algebraMap A B r * y := by
    simpa only [Algebra.smul_def] using hxy
  rw [he] at hxy'
  exact hreg hxy'

#print axioms IntersectionProductScaf_flat_primeQuotient_regular_restrictScalars

/-- Avoiding every associated prime is enough for a parameter to act regularly. -/
theorem IntersectionProductScaf_regular_of_not_mem_associatedPrimes
    {A : Type u} [CommRing A] [IsNoetherianRing A]
    (N : Type u) [AddCommGroup N] [Module A N] (r : A)
    (hr : ∀ P ∈ associatedPrimes A N, r ∉ P) : IsSMulRegular N r := by
  have hmem : r ∉ ⋃ P ∈ associatedPrimes A N, (P : Set A) := by
    simp only [Set.mem_iUnion, not_exists]
    exact hr
  rw [biUnion_associatedPrimes_eq_compl_regular] at hmem
  simpa only [Set.mem_compl_iff, Set.mem_ofPred_eq, not_not] using hmem

#print axioms IntersectionProductScaf_regular_of_not_mem_associatedPrimes

/-- Every associated prime of a finite module belongs to its support. -/
theorem IntersectionProductScaf_associatedPrime_mem_support
    {A : Type u} [CommRing A] (N : Type u) [AddCommGroup N] [Module A N]
    [Module.Finite A N] (P : Ideal A) (hP : IsAssociatedPrime P N) :
    (⟨P, hP.isPrime⟩ : PrimeSpectrum A) ∈ Module.support A N := by
  rw [Module.mem_support_iff_of_finite]
  rw [← Submodule.annihilator_top]
  exact hP.annihilator_le

#print axioms IntersectionProductScaf_associatedPrime_mem_support

/-- A parameter avoiding the support of a finite module acts regularly on it. -/
theorem IntersectionProductScaf_regular_of_not_mem_support
    {A : Type u} [CommRing A] [IsNoetherianRing A]
    (N : Type u) [AddCommGroup N] [Module A N] [Module.Finite A N] (r : A)
    (hr : ∀ p ∈ Module.support A N, r ∉ p.asIdeal) : IsSMulRegular N r := by
  apply IntersectionProductScaf_regular_of_not_mem_associatedPrimes N r
  intro P hP
  exact hr ⟨P, hP.isPrime⟩
    (IntersectionProductScaf_associatedPrime_mem_support N P hP)

#print axioms IntersectionProductScaf_regular_of_not_mem_support

/-- Controlling all associated primes by a finite component set gives parameter regularity. -/
theorem IntersectionProductScaf_regular_of_associatedPrimes_subset
    {A : Type u} [CommRing A] [IsNoetherianRing A]
    (N : Type u) [AddCommGroup N] [Module A N] (r : A)
    (Φ : Finset (PrimeSpectrum A))
    (hΦr : ∀ p ∈ Φ, r ∉ p.asIdeal)
    (hN : ∀ (P : Ideal A) (hP : P ∈ associatedPrimes A N),
      (⟨P, hP.isPrime⟩ : PrimeSpectrum A) ∈ Φ) :
    IsSMulRegular N r := by
  apply IntersectionProductScaf_regular_of_not_mem_associatedPrimes N r
  intro P hP
  exact hΦr ⟨P, hP.isPrime⟩ (hN P hP)

#print axioms IntersectionProductScaf_regular_of_associatedPrimes_subset

/-- A regular parameter's fibre length is the sum of its component fibre lengths weighted by
the generic module lengths. -/
theorem IntersectionProductScaf_parameter_length
    {A : Type u} [CommRing A] [IsLocalRing A] [IsNoetherianRing A]
    (r : A) (Φ : Finset (PrimeSpectrum A))
    (hΦm : ∀ p ∈ Φ, p ≠ IsLocalRing.closedPoint A)
    (hΦdim : ∀ p ∈ Φ, ∀ q : PrimeSpectrum A, p < q → q = IsLocalRing.closedPoint A)
    (hΦr : ∀ p ∈ Φ, r ∉ p.asIdeal)
    (N : Type u) [AddCommGroup N] [Module A N] [Module.Finite A N]
    (hN : Module.support A N ⊆ insert (IsLocalRing.closedPoint A) (Φ : Set (PrimeSpectrum A)))
    (hr : IsSMulRegular N r) :
    (Module.length A (QuotSMulTop r N)).toNat =
      ∑ p ∈ Φ, (a3e_locLen p N).toNat *
        (Module.length A (QuotSMulTop r (A ⧸ p.asIdeal))).toNat := by
  have h := (a3e_herbrand_eq_sum r Φ hΦm hΦdim hΦr N hN).1
  rw [IntersectionProductScaf_herbrand_of_regular r N hr] at h
  have hp : ∀ p ∈ Φ, a3e_herbrand r (A ⧸ p.asIdeal) =
      ((Module.length A (QuotSMulTop r (A ⧸ p.asIdeal))).toNat : ℤ) := by
    intro p hmem
    let : p.asIdeal.IsPrime := p.isPrime
    exact IntersectionProductScaf_herbrand_of_regular r _
      (IntersectionProductScaf_primeQuotient_regular p.asIdeal r (hΦr p hmem))
  have hs : (∑ p ∈ Φ, ((a3e_locLen p N).toNat : ℤ) * a3e_herbrand r (A ⧸ p.asIdeal)) =
      ∑ p ∈ Φ, ((a3e_locLen p N).toNat : ℤ) *
        ((Module.length A (QuotSMulTop r (A ⧸ p.asIdeal))).toNat : ℤ) := by
    exact Finset.sum_congr rfl fun p hp' => by rw [hp p hp']
  rw [hs] at h
  exact_mod_cast h

#print axioms IntersectionProductScaf_parameter_length

/-- A regular parameter with finite-length quotient bounds the local dimension by one. -/
theorem IntersectionProductScaf_dimension_le_one_of_parameter
    {A : Type u} [CommRing A] [IsLocalRing A] [IsNoetherianRing A]
    (r : A) (hr : IsSMulRegular A r) (hm : r ∈ IsLocalRing.maximalIdeal A)
    (hlen : Module.length A (QuotSMulTop r A) ≠ ⊤) :
    ringKrullDim A ≤ 1 := by
  have hf := Module.length_ne_top_iff.mp hlen
  have : IsArtinian A (QuotSMulTop r A) :=
    (isFiniteLength_iff_isNoetherian_isArtinian.mp hf).2
  have : IsArtinianRing (QuotSMulTop r A) := isArtinian_of_tower A inferInstance
  have hd : ringKrullDim (QuotSMulTop r A) ≤ 0 := Ring.krullDimLE_iff.mp inferInstance
  rw [← ringKrullDim_quotSMulTop_succ_eq_ringKrullDim hr hm]
  simpa [add_comm] using add_le_add_right hd 1
#print axioms IntersectionProductScaf_dimension_le_one_of_parameter

/-- The local fibre length is the sum over all minimal primes, with generic-length weights. -/
theorem IntersectionProductScaf_parameter_length_minimalPrimes
    {A : Type u} [CommRing A] [IsLocalRing A] [IsNoetherianRing A]
    (r : A) (hr : IsSMulRegular A r) (hm : r ∈ IsLocalRing.maximalIdeal A)
    (hlen : Module.length A (QuotSMulTop r A) ≠ ⊤) :
    (Module.length A (QuotSMulTop r A)).toNat =
      ∑ p ∈ (PrimeSpectrum.finite_setOfPred_isMin A).toFinset,
        (a3e_locLen p A).toNat *
          (Module.length A (QuotSMulTop r (A ⧸ p.asIdeal))).toNat := by
  classical
  have hd := IntersectionProductScaf_dimension_le_one_of_parameter r hr hm hlen
  have hmin : ∀ p : PrimeSpectrum A, p ≠ IsLocalRing.closedPoint A → IsMin p :=
    Order.krullDim_le_one_iff_forall_isMin.mp hd
  have havoid : ∀ p : PrimeSpectrum A, IsMin p → r ∉ p.asIdeal := by
    intro p hp
    apply hr.notMem_of_mem_minimalPrimes
    have ha : Module.annihilator A A = ⊥ := Module.annihilator_eq_bot.mpr inferInstance
    rw [ha]
    exact PrimeSpectrum.isMin_iff.mp hp
  apply IntersectionProductScaf_parameter_length
  · intro p hp he
    have hp' : IsMin p := by simpa using hp
    exact havoid p hp' (he ▸ hm)
  · intro p hp q hpq
    by_contra hq
    exact (hmin q hq).not_lt hpq
  · intro p hp
    exact havoid p (by simpa using hp)
  · intro p hp
    by_cases he : p = IsLocalRing.closedPoint A
    · exact Set.mem_insert_iff.mpr (Or.inl he)
    · exact Set.mem_insert_of_mem _ (by simpa using hmin p he)
  · exact hr
#print axioms IntersectionProductScaf_parameter_length_minimalPrimes

/-- The regular-parameter length formula with coefficients in the cycle field. -/
theorem IntersectionProductScaf_parameter_length_rat
    {A : Type u} [CommRing A] [IsLocalRing A] [IsNoetherianRing A]
    (r : A) (Φ : Finset (PrimeSpectrum A))
    (hΦm : ∀ p ∈ Φ, p ≠ IsLocalRing.closedPoint A)
    (hΦdim : ∀ p ∈ Φ, ∀ q : PrimeSpectrum A, p < q → q = IsLocalRing.closedPoint A)
    (hΦr : ∀ p ∈ Φ, r ∉ p.asIdeal)
    (N : Type u) [AddCommGroup N] [Module A N] [Module.Finite A N]
    (hN : Module.support A N ⊆ insert (IsLocalRing.closedPoint A) (Φ : Set (PrimeSpectrum A)))
    (hr : IsSMulRegular N r) :
    ((Module.length A (QuotSMulTop r N)).toNat : ℚ) =
      ∑ p ∈ Φ, ((a3e_locLen p N).toNat : ℚ) *
        ((Module.length A (QuotSMulTop r (A ⧸ p.asIdeal))).toNat : ℚ) := by
  exact_mod_cast IntersectionProductScaf_parameter_length r Φ hΦm hΦdim hΦr N hN hr

#print axioms IntersectionProductScaf_parameter_length_rat

/-- Scaling a fibre coefficient commutes with its component-length expansion. -/
theorem IntersectionProductScaf_parameter_length_rat_smul
    {A : Type u} [CommRing A] [IsLocalRing A] [IsNoetherianRing A]
    (r : A) (Φ : Finset (PrimeSpectrum A))
    (hΦm : ∀ p ∈ Φ, p ≠ IsLocalRing.closedPoint A)
    (hΦdim : ∀ p ∈ Φ, ∀ q : PrimeSpectrum A, p < q → q = IsLocalRing.closedPoint A)
    (hΦr : ∀ p ∈ Φ, r ∉ p.asIdeal)
    (N : Type u) [AddCommGroup N] [Module A N] [Module.Finite A N]
    (hN : Module.support A N ⊆ insert (IsLocalRing.closedPoint A) (Φ : Set (PrimeSpectrum A)))
    (hr : IsSMulRegular N r) (q : ℚ) :
    q * ((Module.length A (QuotSMulTop r N)).toNat : ℚ) =
      ∑ p ∈ Φ, q * ((a3e_locLen p N).toNat : ℚ) *
        ((Module.length A (QuotSMulTop r (A ⧸ p.asIdeal))).toNat : ℚ) := by
  rw [IntersectionProductScaf_parameter_length_rat r Φ hΦm hΦdim hΦr N hN hr,
    Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro p hp
  ring

#print axioms IntersectionProductScaf_parameter_length_rat_smul

/-- The component-length expansion for a finite flat algebra over a prime quotient. -/
theorem IntersectionProductScaf_parameter_length_flat_primeQuotient
    {A B : Type u} [CommRing A] [IsLocalRing A] [IsNoetherianRing A]
    (P : Ideal A) [P.IsPrime] (r : A) (hr : r ∉ P)
    [CommRing B] [Algebra (A ⧸ P) B] [Algebra A B]
    [IsScalarTower A (A ⧸ P) B] [Module.Flat (A ⧸ P) B] [Module.Finite A B]
    (Φ : Finset (PrimeSpectrum A))
    (hΦm : ∀ p ∈ Φ, p ≠ IsLocalRing.closedPoint A)
    (hΦdim : ∀ p ∈ Φ, ∀ q : PrimeSpectrum A, p < q → q = IsLocalRing.closedPoint A)
    (hΦr : ∀ p ∈ Φ, r ∉ p.asIdeal)
    (hB : Module.support A B ⊆ insert (IsLocalRing.closedPoint A) (Φ : Set (PrimeSpectrum A)))
    (q : ℚ) :
    q * ((Module.length A (QuotSMulTop r B)).toNat : ℚ) =
      ∑ p ∈ Φ, q * ((a3e_locLen p B).toNat : ℚ) *
        ((Module.length A (QuotSMulTop r (A ⧸ p.asIdeal))).toNat : ℚ) := by
  exact IntersectionProductScaf_parameter_length_rat_smul r Φ hΦm hΦdim hΦr B hB
    (IntersectionProductScaf_flat_primeQuotient_regular_restrictScalars P r hr) q

#print axioms IntersectionProductScaf_parameter_length_flat_primeQuotient

end ParameterLengths

section ConeTranslation

open MvPolynomial

variable {σ τ : Type} [Fintype σ]

/-- The square matrix of the translation line, with polynomial parameter. -/
def IntersectionProductScaf_lineMatrix (M : σ × σ → ℂ) :
    Matrix σ σ (Polynomial ℂ) :=
  fun i j => (1 - Polynomial.X) * Polynomial.C (if i = j then 1 else 0) +
    Polynomial.X * Polynomial.C (M (i, j))

/-- The determinant defining the invertible part of the translation line. -/
def IntersectionProductScaf_lineDet (M : σ × σ → ℂ) : Polynomial ℂ :=
  (IntersectionProductScaf_lineMatrix M).det

/-- The translation line starts at the identity matrix. -/
theorem IntersectionProductScaf_lineMatrix_zero (M : σ × σ → ℂ) :
    (Polynomial.evalRingHom (0 : ℂ)).mapMatrix
      (IntersectionProductScaf_lineMatrix M) = 1 := by
  ext i j
  by_cases h : i = j <;> simp [IntersectionProductScaf_lineMatrix, Matrix.one_apply, h]

/-- The translation line ends at the specified square matrix. -/
theorem IntersectionProductScaf_lineMatrix_one (M : σ × σ → ℂ) :
    (Polynomial.evalRingHom (1 : ℂ)).mapMatrix
      (IntersectionProductScaf_lineMatrix M) = a3r_mat M := by
  ext i j
  by_cases h : i = j <;> simp [IntersectionProductScaf_lineMatrix, a3r_mat, h]

/-- Parameter zero belongs to the invertible locus for every square matrix. -/
theorem IntersectionProductScaf_lineDet_zero (M : σ × σ → ℂ) :
    (IntersectionProductScaf_lineDet M).eval 0 = 1 := by
  change (Polynomial.evalRingHom (0 : ℂ)) _ = _
  rw [IntersectionProductScaf_lineDet, RingHom.map_det,
    IntersectionProductScaf_lineMatrix_zero, Matrix.det_one]

/-- At parameter one the invertibility test is the determinant of the square matrix. -/
theorem IntersectionProductScaf_lineDet_one (M : σ × σ → ℂ) :
    (IntersectionProductScaf_lineDet M).eval 1 = (a3r_mat M).det := by
  change (Polynomial.evalRingHom (1 : ℂ)) _ = _
  rw [IntersectionProductScaf_lineDet, RingHom.map_det,
    IntersectionProductScaf_lineMatrix_one]

/-- A general square translation matrix has invertible determinant. -/
theorem IntersectionProductScaf_generic_det :
    a3r_Generic {M : σ × σ → ℂ | IsUnit (a3r_mat M).det} := by
  let A : Matrix σ σ (MvPolynomial (σ × σ) ℂ) := fun i j => MvPolynomial.X (i, j)
  have heval (M : σ × σ → ℂ) : MvPolynomial.eval M A.det = (a3r_mat M).det := by
    rw [RingHom.map_det]
    congr 1
    ext i j
    change MvPolynomial.eval M (MvPolynomial.X (i, j)) = M (i, j)
    exact MvPolynomial.eval_X (i, j)
  refine ⟨A.det, ?_, fun M hM => isUnit_iff_ne_zero.mpr (heval M ▸ hM)⟩
  intro h
  have hh := heval (fun ij => if ij.1 = ij.2 then 1 else 0)
  rw [h, map_zero] at hh
  have hi : a3r_mat (fun ij : σ × σ => if ij.1 = ij.2 then (1 : ℂ) else 0) = 1 := by
    ext i j
    rfl
  rw [hi, Matrix.det_one] at hh
  exact zero_ne_one hh

/-- For a generic translation matrix, the endpoint belongs to the invertible line locus. -/
theorem IntersectionProductScaf_generic_lineDet_one :
    a3r_Generic {M : σ × σ → ℂ |
      IsUnit ((IntersectionProductScaf_lineDet M).eval 1)} := by
  exact IntersectionProductScaf_generic_det.mono fun M hM => by
    change IsUnit (a3r_mat M).det at hM
    change IsUnit ((IntersectionProductScaf_lineDet M).eval 1)
    rw [IntersectionProductScaf_lineDet_one]
    exact hM

/-- Both distinguished translation endpoints lie in the invertible locus generically. -/
theorem IntersectionProductScaf_generic_lineDet_endpoints :
    a3r_Generic {M : σ × σ → ℂ |
      IsUnit ((IntersectionProductScaf_lineDet M).eval 0) ∧
        IsUnit ((IntersectionProductScaf_lineDet M).eval 1)} := by
  exact IntersectionProductScaf_generic_lineDet_one.mono fun M hM => by
    change IsUnit ((IntersectionProductScaf_lineDet M).eval 1) at hM
    change IsUnit ((IntersectionProductScaf_lineDet M).eval 0) ∧
      IsUnit ((IntersectionProductScaf_lineDet M).eval 1)
    exact ⟨by rw [IntersectionProductScaf_lineDet_zero]; exact isUnit_one, hM⟩

#print axioms IntersectionProductScaf_generic_det
#print axioms IntersectionProductScaf_generic_lineDet_one
#print axioms IntersectionProductScaf_generic_lineDet_endpoints

/-- The determinant polynomial never vanishes identically. -/
theorem IntersectionProductScaf_lineDet_ne_zero (M : σ × σ → ℂ) :
    IntersectionProductScaf_lineDet M ≠ 0 := by
  intro h
  have hz := IntersectionProductScaf_lineDet_zero M
  rw [h, Polynomial.eval_zero] at hz
  exact zero_ne_one hz

end ConeTranslation

section TranslationIdeals

/-- Extension to the principal open set followed by contraction to the ambient affine chart. -/
def IntersectionProductScaf_contractAway {R : Type} [CommRing R] (d : R)
    (I : Ideal R) : Ideal R :=
  Ideal.comap (algebraMap R (Localization.Away d))
    (Ideal.map (algebraMap R (Localization.Away d)) I)

/-- Clearing a power of the determinant characterizes the contracted ideal. -/
theorem IntersectionProductScaf_mem_contractAway {R : Type} [CommRing R]
    (d : R) (I : Ideal R) (f : R) :
    f ∈ IntersectionProductScaf_contractAway d I ↔ ∃ k : ℕ, d ^ k * f ∈ I := by
  rw [IntersectionProductScaf_contractAway, Ideal.mem_comap,
    IsLocalization.algebraMap_mem_map_algebraMap_iff (Submonoid.powers d)]
  simp only [Submonoid.mem_powers_iff]
  constructor
  · rintro ⟨_, ⟨k, rfl⟩, hk⟩
    exact ⟨k, hk⟩
  · rintro ⟨k, hk⟩
    exact ⟨d ^ k, ⟨k, rfl⟩, hk⟩

/-- The original equations belong to the contracted ideal. -/
theorem IntersectionProductScaf_le_contractAway {R : Type} [CommRing R]
    (d : R) (I : Ideal R) : I ≤ IntersectionProductScaf_contractAway d I :=
  Ideal.le_comap_map

/-- Contraction adds no equations at a prime where the determinant is nonzero. -/
theorem IntersectionProductScaf_contractAway_le_prime_iff {R : Type} [CommRing R]
    (d : R) (I P : Ideal R) [P.IsPrime] (hd : d ∉ P) :
    IntersectionProductScaf_contractAway d I ≤ P ↔ I ≤ P := by
  constructor
  · exact fun h => (IntersectionProductScaf_le_contractAway d I).trans h
  · intro h f hf
    obtain ⟨k, hk⟩ := (IntersectionProductScaf_mem_contractAway d I f).mp hf
    rcases (Ideal.IsPrime.mem_or_mem ‹P.IsPrime› (h hk)) with hd' | hf'
    · exact False.elim (hd ((Ideal.IsPrime.mem_of_pow_mem ‹P.IsPrime› k hd')))
    · exact hf'

/-- Substitution of `h_s x` in the equations, retaining the base variables. -/
def IntersectionProductScaf_inverseLineIdeal {σ τ : Type} [Fintype σ]
    (M : σ × σ → ℂ) (I : Ideal (MvPolynomial (σ ⊕ τ) ℂ)) :
    Ideal (Polynomial (MvPolynomial (σ ⊕ τ) ℂ)) :=
  I.map (a3h_substLine M).toRingHom

/-- The affine translation family obtained by contraction from the invertible locus. -/
def IntersectionProductScaf_lineClosureIdeal {σ τ : Type} [Fintype σ]
    (M : σ × σ → ℂ) (I : Ideal (MvPolynomial (σ ⊕ τ) ℂ)) :
    Ideal (Polynomial (MvPolynomial (σ ⊕ τ) ℂ)) :=
  IntersectionProductScaf_contractAway
    ((IntersectionProductScaf_lineDet M).map (MvPolynomial.C))
    (IntersectionProductScaf_inverseLineIdeal M I)

end TranslationIdeals
section Specialization

/-- Contraction from a principal open does not change an image in which its denominator
is invertible. -/
theorem IntersectionProductScaf_map_contractAway {R S : Type} [CommRing R] [CommRing S]
    (f : R →+* S) (d : R) (I : Ideal R) (hd : IsUnit (f d)) :
    Ideal.map f (IntersectionProductScaf_contractAway d I) = Ideal.map f I := by
  apply le_antisymm
  · rw [Ideal.map_le_iff_le_comap]
    intro x hx
    obtain ⟨k, hk⟩ := (IntersectionProductScaf_mem_contractAway d I x).mp hx
    have hm := Ideal.mem_map_of_mem f hk
    rw [map_mul, map_pow] at hm
    exact (Ideal.unit_mul_mem_iff_mem _ (hd.pow k)).mp hm
  · exact Ideal.map_mono (IntersectionProductScaf_le_contractAway d I)

/-- Specialization at parameter zero recovers the input equations. -/
theorem IntersectionProductScaf_inverseLineIdeal_zero {σ τ : Type} [Fintype σ]
    (M : σ × σ → ℂ) (I : Ideal (MvPolynomial (σ ⊕ τ) ℂ)) :
    Ideal.map (Polynomial.evalRingHom 0) (IntersectionProductScaf_inverseLineIdeal M I) = I := by
  rw [IntersectionProductScaf_inverseLineIdeal, Ideal.map_map]
  have he : (Polynomial.evalRingHom 0).comp (a3h_substLine (τ := τ) M).toRingHom =
      RingHom.id _ := by
    apply RingHom.ext
    intro F
    exact a3h_substLine_eval_zero M F
  rw [he, Ideal.map_id]

/-- Specialization at parameter one is the inverse translate. -/
theorem IntersectionProductScaf_inverseLineIdeal_one {σ τ : Type} [Fintype σ]
    (M : σ × σ → ℂ) (I : Ideal (MvPolynomial (σ ⊕ τ) ℂ)) :
    Ideal.map (Polynomial.evalRingHom 1) (IntersectionProductScaf_inverseLineIdeal M I) =
      I.map (a3h_substT M).toRingHom := by
  rw [IntersectionProductScaf_inverseLineIdeal, Ideal.map_map]
  congr 1
  apply RingHom.ext
  intro F
  exact a3h_substLine_eval_one M F

end Specialization
section OpenFamilyCycles

variable {U Z W : Over (Spec ↧ℂ)}
    [LocallyOfFiniteType U.hom] [QuasiCompact U.hom]
    [LocallyOfFiniteType Z.hom] [QuasiCompact Z.hom]
    (j : U ⟶ W) [IsOpenImmersion j.left] [QuasiCompact j.left] (f : U ⟶ Z)

/-- The cycle of an inverse image on an open chart, extended by the closures of its
components in the ambient scheme. The inverse-image coefficients are generic lengths. -/
def IntersectionProductScaf_openFamilyCycle (j : U ⟶ W) [IsOpenImmersion j.left]
    [QuasiCompact j.left] (f : U ⟶ Z) (c : AlgebraicCycle Z.left ℚ) :
    AlgebraicCycle W.left ℚ :=
  a1p_pushforward j.left (ccm3_flatPullback f.left c)

/-- The open-family construction respects addition of cycles. -/
theorem IntersectionProductScaf_openFamilyCycle_add (c d : AlgebraicCycle Z.left ℚ) :
    IntersectionProductScaf_openFamilyCycle j f (c + d) =
      IntersectionProductScaf_openFamilyCycle j f c +
        IntersectionProductScaf_openFamilyCycle j f d := by
  rw [IntersectionProductScaf_openFamilyCycle, IntersectionProductTrans_flatPullback_add,
    a1p_pushforward_add]
  rfl

/-- The open-family construction respects rational coefficients. -/
theorem IntersectionProductScaf_openFamilyCycle_smul (r : ℚ) (c : AlgebraicCycle Z.left ℚ) :
    IntersectionProductScaf_openFamilyCycle j f (a3m_smul r c) =
      a3m_smul r (IntersectionProductScaf_openFamilyCycle j f c) := by
  have : IsLocallyNoetherian U.left := LocallyOfFiniteType.isLocallyNoetherian U.hom
  have : CompactSpace U.left := by
    have h := QuasiCompact.isCompact_preimage (f := U.hom) _ isOpen_univ isCompact_univ
    rw [Set.preimage_univ] at h
    exact isCompact_univ_iff.mp h
  have : IsNoetherian U.left := ⟨⟩
  rw [IntersectionProductScaf_openFamilyCycle, IntersectionProductTrans_flatPullback_smul,
    a3k_pushforward_smul]
  rfl

end OpenFamilyCycles
section GenericMatrix

open MvPolynomial

/-- A general square matrix is invertible. -/
theorem IntersectionProductScaf_generic_matrix {σ : Type} [Fintype σ] :
    a3r_Generic {M : σ × σ → ℂ | IsUnit (a3r_mat M).det} := by
  let A : Matrix σ σ (MvPolynomial (σ × σ) ℂ) := fun i j => X (i, j)
  have heval (M : σ × σ → ℂ) : eval M A.det = (a3r_mat M).det := by
    rw [RingHom.map_det]
    congr 1
    ext i j
    change eval M (X (i, j)) = M (i, j)
    simp
  refine ⟨A.det, ?_, fun M hM => isUnit_iff_ne_zero.mpr (by rwa [heval] at hM)⟩
  intro h
  have hz := heval (fun ij => if ij.1 = ij.2 then 1 else 0)
  have hid : a3r_mat (fun ij : σ × σ => if ij.1 = ij.2 then (1 : ℂ) else 0) = 1 := by
    ext i j
    simp [a3r_mat, Matrix.one_apply]
  rw [h, map_zero, hid, Matrix.det_one] at hz
  exact zero_ne_one hz

end GenericMatrix
section BaseRestriction

open MvPolynomial

/-- The same inverse translation on equations with no original base parameter. -/
def IntersectionProductScaf_substLine0 {σ : Type} [Fintype σ] (M : σ × σ → ℂ) :
    MvPolynomial σ ℂ →ₐ[ℂ] Polynomial (MvPolynomial σ ℂ) :=
  aeval fun i => (1 - Polynomial.X) * Polynomial.C (X i) +
    Polynomial.X * Polynomial.C (∑ j, C (M (i, j)) * X j)

/-- Restriction of the original base parameter commutes with inverse translation
at the level of equations. -/
theorem IntersectionProductScaf_substLine_restrict {σ : Type} [Fintype σ]
    (M : σ × σ → ℂ) (t : ℂ) :
    (Polynomial.mapRingHom (a3h_evt (σ' := σ) t).toRingHom).comp
        (a3h_substLine M).toRingHom =
      (IntersectionProductScaf_substLine0 M).toRingHom.comp (a3h_evt t).toRingHom := by
  apply MvPolynomial.ringHom_ext
  · intro c
    simp [IntersectionProductScaf_substLine0, a3h_substLine, a3h_evt]
  · intro i
    rcases i with i | i
    · simp [IntersectionProductScaf_substLine0, a3h_substLine, a3h_evt, map_sum, Polynomial.map_sum]
    · simp [IntersectionProductScaf_substLine0, a3h_substLine, a3h_evt]

end BaseRestriction

