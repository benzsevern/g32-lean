/-- Orders of nonzero rational functions subtract under division. -/
theorem IntersectionProductScaf_order_div
    {Y : Scheme} [IsIntegral Y] [IsLocallyNoetherian Y]
    (x : Y) {f g : Y.functionField} (hf : f ≠ 0) (hg : g ≠ 0) :
    Y.ord (f / g) x = Y.ord f x - Y.ord g x := by
  have h := Scheme.ord_mul (x := x) (div_ne_zero hf hg) hg
  rw [div_mul_cancel₀ f hg] at h
  omega
