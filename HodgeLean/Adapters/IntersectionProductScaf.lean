/-- The stalk kernel of an inverse-image subscheme is the extended ambient localized ideal. -/
theorem IntersectionProductScaf_comap_stalk_kernel
    {Y Z : Scheme} (f : Y ⟶ Z) (K : Z.IdealSheafData)
    (x : (K.comap f).subscheme) (U : Z.affineOpens)
    (hx : f ((K.comap f).subschemeι x) ∈ U.1) :
    RingHom.ker ((K.comap f).subschemeι.stalkMap x).hom =
      ((K.ideal U).map (Z.presheaf.germ U.1 _ hx).hom).map
        (f.stalkMap ((K.comap f).subschemeι x)).hom := by
  obtain ⟨_, ⟨V, hV, rfl⟩, hxV, hVU⟩ := Y.isBasis_affineOpens.exists_subset_of_mem_open
    hx (f ⁻¹ᵁ U.1).2
  rw [a3l_ker_stalkMap_subschemeι (K.comap f) x ⟨V, hV⟩ hxV,
    IntersectionProductScaf_comap_ideal_affine_charts f K U ⟨V, hV⟩ hVU,
    Ideal.map_map, Ideal.map_map]
  have hg : f.appLE U.1 V hVU ≫ Y.presheaf.germ V ((K.comap f).subschemeι x) hxV =
      Z.presheaf.germ U.1 _ hx ≫ f.stalkMap ((K.comap f).subschemeι x) := by
    rw [Scheme.Hom.appLE, Category.assoc, TopCat.Presheaf.germ_res]
    exact (f.germ_stalkMap U.1 _ hx).symm
  exact congrArg (Ideal.map · (K.ideal U)) (congrArg CommRingCat.Hom.hom hg)
#print axioms IntersectionProductScaf_comap_stalk_kernel

/-- Flat local base change multiplies quotient length by the length of the residue fibre. -/
theorem IntersectionProductScaf_flat_local_quotient_length
    {A B : Type*} [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B]
    [Algebra A B] [IsLocalHom (algebraMap A B)] [Module.Flat A B] (I : Ideal A) :
    Module.length B (B ⧸ I.map (algebraMap A B)) =
      Module.length A (A ⧸ I) *
        Module.length B (B ⧸ (IsLocalRing.maximalIdeal A).map (algebraMap A B)) := by
  rw [(Algebra.TensorProduct.quotIdealMapEquivTensorQuot B I).toLinearEquiv.length_eq]
  exact IsLocalRing.length_baseChange A B (A ⧸ I)
#print axioms IntersectionProductScaf_flat_local_quotient_length

