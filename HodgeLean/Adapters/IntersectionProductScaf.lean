    LocallyOfFiniteType.isLocallyNoetherian (a3n_T (a3n_T X)).hom
  have : IsNoetherian (a3n_T (a3n_T X)).left := ⟨⟩
  have := IntersectionProductScaf_projectionProduct_finite X hfin
  have hd : 0 < a1p_degree (a3h_G (a3h_πO X hfin)).left y :=
    (a1d_degree_pos_iff _ y).mpr (IntersectionProductScaf_finite_height _ y)
  let q : ℚ := a1p_degree (a3h_G (a3h_πO X hfin)).left y
