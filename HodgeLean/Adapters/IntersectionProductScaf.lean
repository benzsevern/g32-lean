set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
/-- A nonzero original-fibre coefficient lies on the extended square support. -/
theorem IntersectionProductScaf_originalFibre_support
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom]
    {n : ℕ} (M : Fin (n + 1) × Fin (n + 1) → ℂ)
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (y : (a3n_T X).left) (c : ℂ) (x : (a3n_T X).left)
    (hx : IntersectionProductScaf_originalFibreCycle M a hfin y c x ≠ 0) :
    a3k_ι X c x ∈ (IntersectionProductScaf_squarePrimeIdeal M a hfin y).support := by
  let I := (IntersectionProductScaf_squarePrimeIdeal M a hfin y).comap (a3k_ι X c)
  have : IsLocallyNoetherian (a3n_T X).left :=
    LocallyOfFiniteType.isLocallyNoetherian (a3n_T X).hom
  have : IsNoetherian (a3n_T X).left := ⟨⟩
  have : NoetherianSpace I.subscheme := a2g_subscheme_noetherianSpace I
  have hx' : a2g_fundCycle I.subschemeι x ≠ 0 := by
    change (_ : ℚ) * a2g_fundCycle I.subschemeι x ≠ 0 at hx
    exact (mul_ne_zero_iff.mp hx).2
  have hr : x ∈ Set.range I.subschemeι := by
    by_contra h
    exact hx' (IntersectionProductScaf_fundCycle_apply_of_not_mem_range _
      (genericPoints.finite NoetherianSpace.finite_irreducibleComponents) x h)
  have hs := I.range_subschemeι.subset hr
  change x ∈ (I.support : Set (a3n_T X).left) at hs
  dsimp only [I] at hs
  rwa [Scheme.IdealSheafData.support_comap] at hs
#print axioms IntersectionProductScaf_originalFibre_support

/-- Exchanging polynomial coordinates commutes with scalar parameter evaluation. -/
theorem IntersectionProductScaf_relative_coordinate_eval {σ : Type} [Fintype σ] [DecidableEq σ]
    (F : Polynomial (MvPolynomial σ ℂ)) (c : ℂ) :
    MvPolynomial.map (Polynomial.evalRingHom c) (a3m_eq σ F) =
      Polynomial.eval (MvPolynomial.C c) F := by
  have he : (Polynomial.evalRingHom c).comp Polynomial.C = RingHom.id ℂ := by
    ext z
    simp
  induction F using Polynomial.induction_on' with
  | add p q hp hq => simp only [map_add, Polynomial.eval_add, hp, hq]
  | monomial k a =>
    rw [← Polynomial.C_mul_X_pow_eq_monomial]
    simp [a3m_eq_C, a3m_eq_X, MvPolynomial.map_map, he, MvPolynomial.map_id]
#print axioms IntersectionProductScaf_relative_coordinate_eval

/-- Homogeneous relative equations suffice for inclusion of the specialized polynomial cone. -/
theorem IntersectionProductScaf_specialized_cone_le {σ τ : Type} [Fintype σ] [DecidableEq σ]
    (I : Ideal (MvPolynomial σ (Polynomial ℂ)))
    (hI : I.IsHomogeneous (MvPolynomial.homogeneousSubmodule σ (Polynomial ℂ)))
    (Q : Ideal (MvPolynomial τ ℂ)) (f : MvPolynomial σ ℂ →+* MvPolynomial τ ℂ)
    (c : ℂ)
    (h : ∀ F d, F.IsHomogeneous d → F ∈ I →
      f (MvPolynomial.map (Polynomial.evalRingHom c) F) ∈ Q) :
    (I.comap (a3m_eq σ).toRingHom).map (Polynomial.evalRingHom (MvPolynomial.C c)) ≤
      Q.comap f := by
  rw [Ideal.map_le_iff_le_comap]
  intro F hF
  change f (Polynomial.eval (MvPolynomial.C c) F) ∈ Q
  rw [← IntersectionProductScaf_relative_coordinate_eval]
  change a3m_eq σ F ∈ I at hF
  rw [← MvPolynomial.sum_homogeneousComponent (a3m_eq σ F), map_sum, map_sum]
  apply Ideal.sum_mem
  intro d hd
  exact h _ d (MvPolynomial.homogeneousComponent_isHomogeneous d _)
    (MvPolynomial.homogeneousComponent_mem_of_mem hI hF d)
#print axioms IntersectionProductScaf_specialized_cone_le

/-- The projected polynomial cone is the relative homogeneous prime in exchanged coordinates. -/
theorem IntersectionProductScaf_projected_polynomial_cone
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] {n : ℕ}
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (y : (a3n_T X).left) (hy : y ∈ a3h_U X) :
    (((a3h_P X y hy).comap (a3r_lin (a3h_block a))).comap
      (a3h_eqT (Fin (n + 1))).symm.toRingHom) =
    ((a3m_lineCharts (a3m_projCharts n) (a3m_Pn_hov n)).prime
      (a3h_pt (a3h_PnO n) ((a3h_G (a3h_πO X hfin)).left y)
        (IntersectionProductScaf_product_projection_mem_U _ y hy))).comap
          (a3m_eq (Fin (n + 1))).toRingHom := by
  erw [← IntersectionProductScaf_product_projection_cone_prime X a hfin y hy]
  ext F
  change a3m_eq _ (a3h_eqT _ ((a3h_eqT _).symm F)) ∈
    ((a3m_lineCharts (a3m_projCharts n) (a3m_Pn_hov n)).prime
      (a3h_pt (a3h_PnO n) ((a3h_G (a3h_πO X hfin)).left y)
        (IntersectionProductScaf_product_projection_mem_U _ y hy))) ↔ _
  simp only [AlgEquiv.apply_symm_apply]
  rfl
#print axioms IntersectionProductScaf_projected_polynomial_cone

/-- The extended square support imposes the specialized projected cone on each residue matrix chart. -/
theorem IntersectionProductScaf_boundary_cone_inclusion
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom]
    {n : ℕ} (M : Fin (n + 1) × Fin (n + 1) → ℂ)
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (y : (a3n_T X).left) (hy : y ∈ a3h_U X) (c : ℂ) (x : (a3n_T X).left)
    (j : Fin (a3s_N X + 1)) (r : Fin 2)
    (w : (IntersectionProductScaf_boundaryProductOver X j r).left)
    (hw : IntersectionProductScaf_boundaryProductChart X j r w = a3k_ι X c x)
    (hs : a3k_ι X c x ∈ (IntersectionProductScaf_squarePrimeIdeal M a hfin y).support)
    (D : Matrix (Fin (n + 1)) (Fin (n + 1)) ℂ)
    (hD : (Ideal.Quotient.mk
        ((IntersectionProductScaf_boundaryProductOver X j r).left.toSpecΓ w).asIdeal).mapMatrix
        (IntersectionProductScaf_boundaryPencilMatrix X j r M) =
      (Ideal.Quotient.mk
        ((IntersectionProductScaf_boundaryProductOver X j r).left.toSpecΓ w).asIdeal).mapMatrix
        ((IntersectionProductScaf_complexScalars
          (IntersectionProductScaf_boundaryProductOver X j r)).mapMatrix D)) :
    ((((a3h_P X y hy).comap (a3r_lin (a3h_block a))).comap
      (a3h_eqT (Fin (n + 1))).symm.toRingHom).map
        (Polynomial.evalRingHom (MvPolynomial.C c))) ≤
      (((a3s_CX X).prime ((a3n_q X).left x)).comap (a3r_lin (a3r_mat a))).comap
        (a3r_lin D).toRingHom := by
  rw [IntersectionProductScaf_projected_polynomial_cone X a hfin y hy]
  erw [Ideal.comap_comap]
  apply IntersectionProductScaf_specialized_cone_le _
    ((a3m_lineCharts (a3m_projCharts n) (a3m_Pn_hov n)).isHomogeneous_prime _) _ _ c
  intro F d hF hyF
  exact IntersectionProductScaf_boundary_spatial_equation X j M r a hfin _
    (IntersectionProductScaf_product_projection_mem_U _ y hy) F d hF hyF c x w hw
    (by simpa only [hw, IntersectionProductScaf_squarePrimeIdeal] using hs) D hD
#print axioms IntersectionProductScaf_boundary_cone_inclusion

