/-- At a point over the input prime, its inverse-image stalk length is the residue-fibre length. -/
theorem IntersectionProductScaf_prime_inverse_stalk_length
    {Y Z : Scheme} (f : Y ⟶ Z) (z : Z)
    (v : (ccm3_inverseIdeal f z).subscheme)
    (hv : f ((ccm3_inverseIdeal f z).subschemeι v) = z) :
    ccm3_genericLength f z v =
      Module.length (Y.presheaf.stalk ((ccm3_inverseIdeal f z).subschemeι v))
        (Y.presheaf.stalk ((ccm3_inverseIdeal f z).subschemeι v) ⧸
          (IsLocalRing.maximalIdeal
            (Z.presheaf.stalk (f ((ccm3_inverseIdeal f z).subschemeι v)))).map
              (f.stalkMap ((ccm3_inverseIdeal f z).subschemeι v)).hom) := by
  dsimp only [ccm3_inverseIdeal] at v hv
  let y := ((ccm3_primeIdeal Z z).comap f).subschemeι v
  obtain ⟨U, hU, hyU, _⟩ := exists_isAffineOpen_mem_and_subset
    (show f y ∈ (⊤ : Z.Opens) from trivial)
  have hker : RingHom.ker ((ccm3_inverseIdeal f z).subschemeι.stalkMap v).hom =
      (IsLocalRing.maximalIdeal (Z.presheaf.stalk (f y))).map (f.stalkMap y).hom := by
    change RingHom.ker (((ccm3_primeIdeal Z z).comap f).subschemeι.stalkMap v).hom = _
    rw [IntersectionProductScaf_comap_stalk_kernel f (ccm3_primeIdeal Z z) v ⟨U, hU⟩ hyU]
    rw [a3l_map_primeIdeal_eq_stalkIdeal (show z ⤳ f y from by rw [hv]) ⟨U, hU⟩ hyU]
    apply congrArg (Ideal.map (f.stalkMap y).hom)
    exact (congrArg (a3i_stalkIdeal Z (f y)) hv.symm).trans (a3c_stalkIdeal_self Z (f y))
  unfold ccm3_genericLength
  exact (a3l_length_quot_ker ((ccm3_inverseIdeal f z).subschemeι.stalkMap v).hom
    ((ccm3_inverseIdeal f z).subschemeι.stalkMap_surjective v) _ hker).symm
#print axioms IntersectionProductScaf_prime_inverse_stalk_length

set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
/-- Flat inverse-image stalk lengths multiply the intrinsic input and prime-fibre lengths. -/
theorem IntersectionProductScaf_flat_comap_intrinsic_stalk_length
    {Y Z : Scheme} (f : Y ⟶ Z) [Flat f] (K : Z.IdealSheafData)
    (u : (K.comap f).subscheme) (z : K.subscheme)
    (hz : f ((K.comap f).subschemeι u) = K.subschemeι z)
    (v : (ccm3_inverseIdeal f (K.subschemeι z)).subscheme)
    (hv : (ccm3_inverseIdeal f (K.subschemeι z)).subschemeι v =
      (K.comap f).subschemeι u) :
    Module.length ((K.comap f).subscheme.presheaf.stalk u)
        ((K.comap f).subscheme.presheaf.stalk u) =
      Module.length (K.subscheme.presheaf.stalk z) (K.subscheme.presheaf.stalk z) *
        ccm3_genericLength f (K.subschemeι z) v := by
  obtain ⟨U, hU, hzU, _⟩ := exists_isAffineOpen_mem_and_subset
    (show K.subschemeι z ∈ (⊤ : Z.Opens) from trivial)
  have huU : f ((K.comap f).subschemeι u) ∈ U := by rwa [hz]
  have hi : Module.length (Z.presheaf.stalk (f ((K.comap f).subschemeι u)))
      (Z.presheaf.stalk (f ((K.comap f).subschemeι u)) ⧸
        (K.ideal ⟨U, hU⟩).map
          (Z.presheaf.germ U (f ((K.comap f).subschemeι u)) huU).hom) =
      Module.length (K.subscheme.presheaf.stalk z) (K.subscheme.presheaf.stalk z) := by
    generalize he : f ((K.comap f).subschemeι u) = w at huU ⊢
    have hw : w = K.subschemeι z := he.symm.trans hz
    clear he
    subst w
    exact IntersectionProductScaf_subscheme_quotient_stalk_length K z ⟨U, hU⟩ hzU
  rw [IntersectionProductScaf_flat_comap_stalk_length f K u ⟨U, hU⟩ huU]
  dsimp only
  rw [hi]
  congr 1
  rw [IntersectionProductScaf_prime_inverse_stalk_length f (K.subschemeι z) v (by rw [hv, hz])]
  rw [hv]
#print axioms IntersectionProductScaf_flat_comap_intrinsic_stalk_length

set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
/-- Minimal primes of a stalk correspond to component generic points specializing to its point. -/
theorem IntersectionProductScaf_fromSpecStalk_component_iff
    (Y : Scheme) (x : Y) (p : PrimeSpectrum (Y.presheaf.stalk x)) :
    Y.fromSpecStalk x p ∈ genericPoints Y ↔ IsMin p := by
  constructor
  · intro hp q hq
    have he := IntersectionProductScaf_component_generalization _ hp
      (Y.fromSpecStalk x q)
      (((PrimeSpectrum.le_iff_specializes q p).mp hq).map (Y.fromSpecStalk x).continuous)
    have he' : q = p := (Y.fromSpecStalk x).isEmbedding.injective he
    exact le_of_eq he'.symm
  · intro hp
    obtain ⟨C, hC, hsub⟩ := exists_mem_irreducibleComponents_subset_of_isIrreducible
      (closure ({Y.fromSpecStalk x p} : Set Y)) isIrreducible_singleton.closure
    let z := hC.1.genericPoint
    have hz : closure ({z} : Set Y) = C :=
      hC.1.isGenericPoint_genericPoint (isClosed_of_mem_irreducibleComponents C hC)
    have hsp : z ⤳ Y.fromSpecStalk x p := by
      apply specializes_iff_mem_closure.mpr
      rw [hz]
      exact hsub (subset_closure (Set.mem_singleton _))
    have hzx : z ⤳ x := hsp.trans (a3y_specializes_fromSpecStalk x p)
    have hle : a3y_pt x z hzx ≤ p := by
      rw [PrimeSpectrum.le_iff_specializes,
        ← (Y.fromSpecStalk x).isEmbedding.isInducing.specializes_iff,
        a3y_fromSpecStalk_pt]
      exact hsp
    have he : a3y_pt x z hzx = p := le_antisymm hle (hp hle)
    have hzp : Y.fromSpecStalk x p = z := by
      rw [← he, a3y_fromSpecStalk_pt]
    change closure ({Y.fromSpecStalk x p} : Set Y) ∈ irreducibleComponents Y
    rwa [hzp, hz]
#print axioms IntersectionProductScaf_fromSpecStalk_component_iff

/-- The localized length at a stalk prime is the length at the corresponding scheme point. -/
theorem IntersectionProductScaf_locLen_fromSpecStalk
    (Y : Scheme) (x : Y) (p : PrimeSpectrum (Y.presheaf.stalk x)) :
    a3e_locLen p (Y.presheaf.stalk x) =
      Module.length (Y.presheaf.stalk (Y.fromSpecStalk x p))
        (Y.presheaf.stalk (Y.fromSpecStalk x p)) := by
  have h := IntersectionProductScaf_locLen_stalk Y (a3y_specializes_fromSpecStalk x p)
  change a3e_locLen (a3y_pt x _ (a3y_specializes_fromSpecStalk x p)) _ = _ at h
  rwa [a3y_pt_fromSpecStalk] at h
#print axioms IntersectionProductScaf_locLen_fromSpecStalk

/-- The local regular-fibre formula uses the actual coefficients of an embedded fundamental cycle. -/
theorem IntersectionProductScaf_regularFibre_embedded_coefficients
    {F Y Z : Scheme} [IsLocallyNoetherian Y] (i : F ⟶ Y) [IsClosedImmersion i]
    (j : Y ⟶ Z) (hj : Function.Injective j)
    (x : F) (hx : x ∈ genericPoints F)
    (r : Y.presheaf.stalk (i x)) (hr : IsSMulRegular (Y.presheaf.stalk (i x)) r)
    (hker : RingHom.ker (i.stalkMap x).hom = Ideal.span {r})
    (hF : (genericPoints F).Finite) (hY : (genericPoints Y).Finite) :
    a2g_fundCycle (i ≫ j) (j (i x)) =
      ∑ p ∈ (PrimeSpectrum.finite_setOfPred_isMin (Y.presheaf.stalk (i x))).toFinset,
        a2g_fundCycle j (j (Y.fromSpecStalk (i x) p)) *
          ((Module.length (Y.presheaf.stalk (i x))
            (QuotSMulTop r ((Y.presheaf.stalk (i x)) ⧸ p.asIdeal))).toNat : ℚ) := by
  classical
  have hc : Function.Injective (i ≫ j) := hj.comp i.isEmbedding.injective
  have he : a2g_fundCycle (i ≫ j) (j (i x)) = a2g_fundCycle i (i x) := by
    change a2g_fundCycle (i ≫ j) ((i ≫ j) x) = _
    rw [IntersectionProductScaf_fundCycle_apply_embedded _ hc hF,
      IntersectionProductScaf_fundCycle_apply_embedded _ i.isEmbedding.injective hF]
  rw [he, IntersectionProductScaf_regularFibre_coefficient i x hx r hr hker hF]
  apply Finset.sum_congr rfl
  intro p hp
  have hp' : IsMin p := by simpa using hp
  rw [IntersectionProductScaf_fundCycle_apply_embedded j hj hY,
    ite_eq_left ((IntersectionProductScaf_fromSpecStalk_component_iff Y (i x) p).mpr hp'),
    IntersectionProductScaf_locLen_fromSpecStalk]
#print axioms IntersectionProductScaf_regularFibre_embedded_coefficients

/-- Component generic points correspond along an open immersion. -/
theorem IntersectionProductScaf_open_component_iff
    {U W : Scheme} (j : U ⟶ W) [IsOpenImmersion j] (u : U) :
    j u ∈ genericPoints W ↔ u ∈ genericPoints U := by
  exact ⟨IntersectionProductScaf_component_of_injective j j.isOpenEmbedding.injective u,
    IntersectionProductScaf_generalizing_component j j.isOpenEmbedding.generalizingMap u⟩
#print axioms IntersectionProductScaf_open_component_iff
/-- Fundamental-cycle coefficients are preserved when an ideal is restricted to an open subscheme. -/
theorem IntersectionProductScaf_fundCycle_comap_open_at
    {U W : Scheme} (j : U ⟶ W) [IsOpenImmersion j]
    (I : W.IdealSheafData)
    (hI : (genericPoints I.subscheme).Finite)
    (hJ : (genericPoints (I.comap j).subscheme).Finite)
    (u : (I.comap j).subscheme) :
    a2g_fundCycle I.subschemeι (j ((I.comap j).subschemeι u)) =
      a2g_fundCycle (I.comap j).subschemeι ((I.comap j).subschemeι u) := by
  let g := (I.comap j).subschemeMap I j (I.le_map_comap j)
  have hp : IsPullback (I.comap j).subschemeι g j I.subschemeι :=
    isPullback_of_isClosedImmersion _ _ _ _
      (Scheme.IdealSheafData.subschemeMap_subschemeι _ _ _ _).symm
      (by simp only [Scheme.IdealSheafData.ker_subschemeι])
  have : IsOpenImmersion g := MorphismProperty.of_isPullback hp (inferInstance : IsOpenImmersion j)
  have he : I.subschemeι (g u) = j ((I.comap j).subschemeι u) :=
    congrArg (fun f : (I.comap j).subscheme ⟶ W => f u)
      (Scheme.IdealSheafData.subschemeMap_subschemeι _ _ _ _)
  rw [← he, IntersectionProductScaf_fundCycle_apply_embedded _
      I.subschemeι.isClosedEmbedding.injective hI,
    IntersectionProductScaf_fundCycle_apply_embedded _
      (I.comap j).subschemeι.isClosedEmbedding.injective hJ,
    IntersectionProductScaf_open_component_iff g u]
  congr 1
  exact congrArg (fun l : ℕ∞ => (l.toNat : ℚ))
    (a2g_length_self_eq (asIso (g.stalkMap u)).commRingCatIsoToRingEquiv)
#print axioms IntersectionProductScaf_fundCycle_comap_open_at
/-- A fundamental cycle has no coefficient outside the image of its defining morphism. -/
theorem IntersectionProductScaf_fundCycle_apply_of_not_mem_range
    {V W : Scheme} (i : V ⟶ W) (hfin : (genericPoints V).Finite)
    (w : W) (hw : w ∉ Set.range i) : a2g_fundCycle i w = 0 := by
  rw [IntersectionProductScaf_fundCycle_eq_sum i hfin, a3m_sum_apply]
  apply Finset.sum_eq_zero
  intro v hv
  rw [Function.locallyFinsuppWithin.single_apply, ite_eq_right]
  exact fun h => hw ⟨v, h.symm⟩
#print axioms IntersectionProductScaf_fundCycle_apply_of_not_mem_range

/-- Restricting an ideal to an open subscheme preserves its fundamental-cycle coefficients everywhere. -/
theorem IntersectionProductScaf_fundCycle_comap_open_apply
    {U W : Scheme} (j : U ⟶ W) [IsOpenImmersion j]
    (I : W.IdealSheafData)
    (hI : (genericPoints I.subscheme).Finite)
    (hJ : (genericPoints (I.comap j).subscheme).Finite) (u : U) :
    a2g_fundCycle I.subschemeι (j u) = a2g_fundCycle (I.comap j).subschemeι u := by
  by_cases hu : u ∈ Set.range (I.comap j).subschemeι
  · obtain ⟨v, rfl⟩ := hu
    exact IntersectionProductScaf_fundCycle_comap_open_at j I hI hJ v
  · have hj : j u ∉ Set.range I.subschemeι := by
      rw [Scheme.IdealSheafData.range_subschemeι] at hu ⊢
      rw [Scheme.IdealSheafData.support_comap] at hu
      exact hu
    rw [IntersectionProductScaf_fundCycle_apply_of_not_mem_range _ hI _ hj,
      IntersectionProductScaf_fundCycle_apply_of_not_mem_range _ hJ _ hu]
#print axioms IntersectionProductScaf_fundCycle_comap_open_apply
open TopologicalSpace in
/-- On the parameter open, the original fibre retains the inverse-image fibre lengths. -/
theorem IntersectionProductScaf_originalFibre_open_apply
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom]
    {n : ℕ} (M : Fin (n + 1) × Fin (n + 1) → ℂ)
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (y : (a3n_T X).left) (c : ℂ)
    (u : (IntersectionProductScaf_familyOpen X M).left) :
    IntersectionProductScaf_originalFibreCycle M a hfin y c
        ((IntersectionProductScaf_familyInclusion X M).left u) =
      (a1p_degree (a3h_G (a3h_πO X hfin)).left y : ℚ) *
        a2g_fundCycle (((ccm3_primeIdeal (a3n_T (a3h_PnO n)).left
          ((a3h_G (a3h_πO X hfin)).left y)).comap
            (a3n_σ (a3h_PnO n) c)).comap
              (IntersectionProductScaf_familyMap₀ X hfin M).left).subschemeι u := by
  let I := (IntersectionProductScaf_squarePrimeIdeal M a hfin y).comap (a3k_ι X c)
  let j := (IntersectionProductScaf_familyInclusion X M).left
  have : IsLocallyNoetherian (a3n_T X).left := LocallyOfFiniteType.isLocallyNoetherian (a3n_T X).hom
  have : IsNoetherian (a3n_T X).left := ⟨⟩
  have : NoetherianSpace I.subscheme := a2g_subscheme_noetherianSpace I
  have : NoetherianSpace (I.comap j).subscheme :=
    (I.comap j).subschemeι.isClosedEmbedding.isInducing.noetherianSpace
  have hI := genericPoints.finite (NoetherianSpace.finite_irreducibleComponents (α := I.subscheme))
  have hJ := genericPoints.finite
    (NoetherianSpace.finite_irreducibleComponents (α := (I.comap j).subscheme))
  change (a1p_degree (a3h_G (a3h_πO X hfin)).left y : ℚ) *
    a2g_fundCycle I.subschemeι (j u) = _
  rw [IntersectionProductScaf_fundCycle_comap_open_apply j I hI hJ u]
  congr 2
  exact congrArg (fun K : (IntersectionProductScaf_familyOpen X M).left.IdealSheafData =>
      a2g_fundCycle K.subschemeι)
    (IntersectionProductScaf_originalIdeal_open M a hfin
      (ccm3_primeIdeal _ ((a3h_G (a3h_πO X hfin)).left y)) c)
#print axioms IntersectionProductScaf_originalFibre_open_apply
/-- The original fibre equals extension of its open coefficients exactly when its coefficients vanish outside that open. -/
theorem IntersectionProductScaf_originalFibre_eq_open_extension_iff
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom]
    {n : ℕ} (M : Fin (n + 1) × Fin (n + 1) → ℂ)
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (y : (a3n_T X).left) (c : ℂ) :
    IntersectionProductScaf_originalFibreCycle M a hfin y c =
      a1p_pushforward (IntersectionProductScaf_familyInclusion X M).left
        (a3m_smul (a1p_degree (a3h_G (a3h_πO X hfin)).left y : ℚ)
          (a2g_fundCycle (((ccm3_primeIdeal (a3n_T (a3h_PnO n)).left
            ((a3h_G (a3h_πO X hfin)).left y)).comap
              (a3n_σ (a3h_PnO n) c)).comap
                (IntersectionProductScaf_familyMap₀ X hfin M).left).subschemeι)) ↔
      ∀ x, x ∉ Set.range (IntersectionProductScaf_familyInclusion X M).left →
        IntersectionProductScaf_originalFibreCycle M a hfin y c x = 0 := by
  constructor
  · intro h x hx
    rw [h]
    exact IntersectionProductScaf_open_apply_of_not_mem_range _ _ x hx
  · intro h
    ext x
    by_cases hx : x ∈ Set.range (IntersectionProductScaf_familyInclusion X M).left
    · obtain ⟨u, rfl⟩ := hx
      rw [IntersectionProductScaf_open_apply, a3m_smul_apply]
      exact IntersectionProductScaf_originalFibre_open_apply X M a hfin y c u
    · rw [h x hx, IntersectionProductScaf_open_apply_of_not_mem_range _ _ x hx]
#print axioms IntersectionProductScaf_originalFibre_eq_open_extension_iff

section OriginalDivisorEquations
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
variable (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom]
/-- The original parameter divisor is the image of the generic point of its section. -/
theorem IntersectionProductScaf_originalDivisor_generic (c : ℂ) :
    a3k_E X c = a3k_ι X c (genericPoint (a3n_T X).left) := by
  have hspec : a3k_E X c ⤳ a3k_ι X c (genericPoint (a3n_T X).left) := by
    rw [a3n_b_specializes_iff]
    have he := congrArg (fun f => f (genericPoint (a3n_T X).left)) (a3k_ι_q X c)
    simp only [Scheme.Hom.comp_apply] at he
    rw [he]
    exact (genericPoint_specializes _).map (a3n_σ X c).continuous
  by_contra hne
  have hlt := a3y_coheight_lt hspec hne
  rw [a3k_coheight_E, a3k_coheight_ι, a3k_coheight_genericPoint, zero_add] at hlt
  exact (lt_irrefl _ hlt)
#print axioms IntersectionProductScaf_originalDivisor_generic

/-- Original parameter sections are closed immersions. -/
theorem IntersectionProductScaf_originalSection_isClosedImmersion (c : ℂ) :
    IsClosedImmersion (a3k_ι X c) := by
  have : IsClosedImmersion (a3n_σ X c ≫ (a3n_q X).left) := by
    rw [a3n_σ_q]
    infer_instance
  have : IsClosedImmersion (a3n_σ X c) := IsClosedImmersion.of_comp _ (a3n_q X).left
  exact MorphismProperty.of_isPullback (P := @IsClosedImmersion) (a3k_isPullback X c).flip inferInstance
#print axioms IntersectionProductScaf_originalSection_isClosedImmersion

/-- Each original parameter divisor has a regular principal equation at every point of its section. -/
theorem IntersectionProductScaf_originalDivisor_equation (c : ℂ) (x : (a3n_T X).left) :
    ∃ r : (a3n_T (a3n_T X)).left.presheaf.stalk (a3k_ι X c x),
      r ∈ IsLocalRing.maximalIdeal _ ∧
      IsSMulRegular ((a3n_T (a3n_T X)).left.presheaf.stalk (a3k_ι X c x)) r ∧
      a3i_stalkIdeal (a3n_T (a3n_T X)).left (a3k_ι X c x) (a3k_E X c) = Ideal.span {r} := by
  letI := IntersectionProductScaf_originalSection_isClosedImmersion X c
  let B := (a3n_T (a3n_T X)).left.presheaf.stalk (a3k_ι X c x)
  let A := (a3n_T X).left.presheaf.stalk x
  let g : B →+* A := ((a3k_ι X c).stalkMap x).hom
  have hsurj : Function.Surjective g := (a3k_ι X c).stalkMap_surjective x
  have hB : IsRegularLocalRing B := a3c_isRegularLocalRing_stalk (a3n_T (a3n_T X)) _
  have hA : IsRegularLocalRing A := a3c_isRegularLocalRing_stalk (a3n_T X) x
  let e : B ⧸ RingHom.ker g ≃+* A := RingHom.quotientKerEquivOfSurjective hsurj
  have : IsRegularLocalRing (B ⧸ RingHom.ker g) := IsRegularLocalRing.of_ringEquiv e.symm
  obtain ⟨k, hk⟩ := ENat.ne_top_iff_exists.mp (a3c_coheight_ne_top (a3n_T X).left x)
  have hdimA : ringKrullDim A = k := by
    rw [ringKrullDim_stalk_eq_coheight, ← hk]
    rfl
  have hdimB : ringKrullDim B = (k + 1 : ℕ) := by
    rw [ringKrullDim_stalk_eq_coheight, a3k_coheight_ι, ← hk]
    norm_cast
  have hdimQ : ringKrullDim (B ⧸ RingHom.ker g) = k := by
    rw [ringKrullDim_eq_of_ringEquiv e, hdimA]
  obtain ⟨xs, hlen, hmem, hreg, hspan⟩ :=
    a3d_exists_regular_of_quotient B (RingHom.ker g) (k + 1) k hdimB hdimQ
  obtain ⟨r, rfl⟩ : ∃ r, xs = [r] := by
    match xs, hlen with
    | [r], _ => exact ⟨r, rfl⟩
    | [], h => simp at h
    | _ :: _ :: _, h => simp at h; omega
  rw [RingTheory.Sequence.isWeaklyRegular_singleton_iff] at hreg
  refine ⟨r, hmem r (by simp), hreg, ?_⟩
  have heq : a3i_stalkIdeal (a3n_T (a3n_T X)).left (a3k_ι X c x) (a3k_E X c) =
      RingHom.ker g := by
    rw [IntersectionProductScaf_originalDivisor_generic,
      ← a3y_comap_stalkIdeal (a3k_ι X c) (genericPoint_specializes x),
      a3c_stalkIdeal_genericPoint]
    rfl
  rw [heq, ← hspan, Ideal.ofList_singleton]
#print axioms IntersectionProductScaf_originalDivisor_equation

set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
/-- Every original section pulls back to a locally principal ideal on any ambient subscheme. -/
theorem IntersectionProductScaf_originalSection_pullback_principal
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom]
    (c : ℂ) (I : (a3n_T (a3n_T X)).left.IdealSheafData)
    (x : ((a3k_ι X c).ker.comap I.subschemeι).subscheme) :
    ∃ r : I.subscheme.presheaf.stalk (((a3k_ι X c).ker.comap I.subschemeι).subschemeι x),
      RingHom.ker ((((a3k_ι X c).ker.comap I.subschemeι).subschemeι).stalkMap x).hom =
        Ideal.span {r} := by
  let := IntersectionProductScaf_originalSection_isClosedImmersion X c
  let Z := (a3n_T (a3n_T X)).left
  let K := (a3k_ι X c).ker
  have hp (w : Z) (hw : w ∈ (K.support : Set Z)) (U : Z.affineOpens) (hU : w ∈ U.1) :
      ∃ r : Z.presheaf.stalk w,
        (K.ideal U).map (Z.presheaf.germ U.1 w hU).hom = Ideal.span {r} := by
    change w ∈ ((a3k_ι X c).ker.support : Set Z) at hw
    rw [Scheme.Hom.support_ker, (a3k_ι X c).isClosedEmbedding.isClosed_range.closure_eq] at hw
    obtain ⟨z, rfl⟩ := hw
    obtain ⟨r, -, -, hr⟩ := IntersectionProductScaf_originalDivisor_equation X c z
    refine ⟨r, ?_⟩
    have hK : K = ccm3_primeIdeal Z (a3k_E X c) := by
      rw [IntersectionProductScaf_originalDivisor_generic]
      exact a2g_ker_eq_primeIdeal (a3k_ι X c)
    rw [hK, a3l_map_primeIdeal_eq_stalkIdeal, hr]
    rw [IntersectionProductScaf_originalDivisor_generic]
    exact (genericPoint_specializes z).map (a3k_ι X c).continuous
  let J := K.comap I.subschemeι
  let w := I.subschemeι (J.subschemeι x)
  have hw : w ∈ (K.support : Set Z) := by
    have hx := x.property
    change J.subschemeι x ∈ (J.support : Set I.subscheme) at hx
    rw [Scheme.IdealSheafData.support_comap] at hx
    exact hx
  obtain ⟨_, ⟨U, hU, rfl⟩, hwU, -⟩ := Z.isBasis_affineOpens.exists_subset_of_mem_open
    (Set.mem_univ w) isOpen_univ
  obtain ⟨r, hr⟩ := hp w hw ⟨U, hU⟩ hwU
  refine ⟨I.subschemeι.stalkMap (J.subschemeι x) r, ?_⟩
  rw [IntersectionProductScaf_closed_comap_stalk_kernel I.subschemeι K x ⟨U, hU⟩ hwU,
    hr, Ideal.map_span, Set.image_singleton]
#print axioms IntersectionProductScaf_originalSection_pullback_principal

