/-- Every component of the translated cone contracts to the input cylinder prime. -/
theorem IntersectionProductScaf_translatedCone_component_comap
    (I : Ideal (MvPolynomial (Fin (n + 1) ⊕ Unit) ℂ)) [I.IsPrime]
    (Q : _root_.Ideal _) (hQ : Q ∈ ((I.map Polynomial.C).map
      (IntersectionProductScaf_translatedConeMap X a M)).minimalPrimes) :
    Q.comap (IntersectionProductScaf_translatedConeMap X a M) = I.map Polynomial.C :=
  IntersectionProductScaf_minimalPrime_comap _
    (IntersectionProductScaf_translatedCone_generalizing X hfin hn M) _ Q hQ

