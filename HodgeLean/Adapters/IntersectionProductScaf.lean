            coheight y ≠ 0 →
            (∀ c : ℂ, y ≠ a3n_σ X c (genericPoint X.left)) →
              IntersectionProductScaf_translationFibreCycle M a hfin y 0 y = 1} := by
  refine ((IntersectionProductScaf_generic_nonsection_projection_degree_one X S hn).inter
    (IntersectionProductScaf_generic_product_projection_stalk_unramified X S hn)).mono ?_
  intro a ha hfin M y hy hdom hc hsec
  exact IntersectionProductScaf_zero_self_of_degree_one_unramified X M a hfin hn y
