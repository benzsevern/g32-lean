    (IntersectionProductScaf_retainedSquareMap_finite X hfin M)
#print axioms IntersectionProductScaf_squareFibreMap_finite

/-- Every invertible translation fibre covers the projective target in the matching dimension. -/
theorem IntersectionProductScaf_squareFibreMap_surjective
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] {n : ℕ}
    {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
