/-- Each evaluated square projection preserves the original projective parameter. -/
theorem IntersectionProductScaf_squareFibreMap_parameter
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] {n : ℕ}
    {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (M : Fin (n + 1) × Fin (n + 1) → ℂ) (c : ℂ)
    (hc : IsUnit ((IntersectionProductScaf_lineDet M).eval c)) :
    (IntersectionProductScaf_squareFibreMap X hfin M c hc).left ≫ a3n_p (a3h_PnO n) = a3n_p X := by
  rw [IntersectionProductScaf_squareFibreMap_eq, Category.assoc,
    IntersectionProductScaf_familyMap₁_parameter]
  change IntersectionProductScaf_familySection (a3n_T X) M c hc ≫
    (IntersectionProductScaf_familyBase (a3n_T X) M).left ≫ a3n_p X = a3n_p X
  rw [← Category.assoc]
  simp only [IntersectionProductScaf_familySection, IntersectionProductScaf_familyBase,
    Over.homMk_left, pullback.lift_fst, Category.id_comp]
#print axioms IntersectionProductScaf_squareFibreMap_parameter


/-- Nonzero translation-fibre coefficients preserve the original parameter of the input point. -/
theorem IntersectionProductScaf_translationFibreCycle_parameter
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] [Smooth X.hom] {n : ℕ}
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (M : Fin (n + 1) × Fin (n + 1) → ℂ) (c : ℂ)
    (hc : IsUnit ((IntersectionProductScaf_lineDet M).eval c))
    (hn : Order.height (genericPoint X.left) = n) (y y' : (a3n_T X).left)
    (hy' : IntersectionProductScaf_translationFibreCycle M a hfin y c y' ≠ 0) :
    a3n_h X y' = a3n_h X y := by
  have hi := (IntersectionProductScaf_translationFibreCycle_support X a hfin M c hc hn y y').mp hy'
  have hp := congrArg (fun f : (a3n_T X).left ⟶ a3n_P1.left => f y')
    (IntersectionProductScaf_squareFibreMap_parameter X hfin M c hc)
  change a3n_p (a3h_PnO n) ((IntersectionProductScaf_squareFibreMap X hfin M c hc).left y') =
    a3n_p X y' at hp
  rw [hi] at hp
  have hh : a3n_h (a3h_PnO n) ((a3h_G (a3h_πO X hfin)).left y) = a3n_h X y' :=
    congrArg a3n_π hp
  rw [a3h_G_h_apply] at hh
  exact hh.symm
#print axioms IntersectionProductScaf_translationFibreCycle_parameter

/-- Finite surjective morphisms between integral complex schemes preserve codimension. -/
theorem IntersectionProductScaf_finite_coheight
    {Y Z : Over (Spec ↧ℂ)} [IsIntegral Y.left] [IsIntegral Z.left]
    [LocallyOfFiniteType Y.hom] [LocallyOfFiniteType Z.hom]
    (f : Y ⟶ Z) [IsFinite f.left] [Surjective f.left] (y : Y.left) :
    coheight (f.left y) = coheight y := by
  have hg : f.left (genericPoint Y.left) = genericPoint Z.left := by
    obtain ⟨u, hu⟩ := f.left.surjective (genericPoint Z.left)
    have hs := (genericPoint_specializes u).map f.left.continuous
    rw [hu] at hs
    exact (hs.antisymm (genericPoint_specializes _)).eq
  have hdim : height (genericPoint Z.left) = height (genericPoint Y.left) := by
    rw [← hg]
    exact IntersectionProductScaf_finite_height f.left _
  have h₁ := a3m_height_add_coheight Z (f.left y)
  have h₂ := a3m_height_add_coheight Y y
  rw [IntersectionProductScaf_finite_height f.left, hdim] at h₁
  obtain ⟨-, m, hm, -⟩ := a1d_height_eq_trdeg (X := Y) y
  exact WithTop.add_left_cancel (hm ▸ ENat.natCast_ne_top m) (h₁.trans h₂.symm)
#print axioms IntersectionProductScaf_finite_coheight

/-- Codimension bounds on target intersections descend along finite surjective morphisms. -/
theorem IntersectionProductScaf_finite_intersection_bound
    {Y Z : Over (Spec ↧ℂ)} [IsIntegral Y.left] [IsIntegral Z.left]
    [LocallyOfFiniteType Y.hom] [LocallyOfFiniteType Z.hom]
    (f : Y ⟶ Z) [IsFinite f.left] [Surjective f.left]
    (u v : Y.left) (k : ℕ)
    (hb : ∀ q ∈ a3y_comps (f.left u) (f.left v),
      coheight (f.left u) + coheight (f.left v) ≤ coheight q + k)
    (z : Y.left) (hu : u ⤳ z) (hv : v ⤳ z) :
    coheight u + coheight v ≤ coheight z + k := by
  obtain ⟨q, hq, hqz⟩ := a3y_exists_comp (f.left u) (f.left v)
    (hu.map f.left.continuous) (hv.map f.left.continuous)
  have h := (hb q hq).trans
    (add_le_add (Order.coheight_anti (Scheme.le_iff_specializes.mpr hqz)) le_rfl)
  simpa only [IntersectionProductScaf_finite_coheight f] using h
#print axioms IntersectionProductScaf_finite_intersection_bound

end ParameterDomination

section LineFamilyDimensions
open CategoryTheory.Limits
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

variable (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] {n : ℕ}
    {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (M : Fin (n + 1) × Fin (n + 1) → ℂ)

/-- The line-family map with its translation parameter retained. -/
def IntersectionProductScaf_retainedLineMap :
    IntersectionProductScaf_familyOpen X M ⟶
      IntersectionProductScaf_familyOpen (a3h_PnO n) M :=
  IntersectionProductScaf_familyProjection X hfin M ≫
    (IntersectionProductScaf_targetFamilyIso M).hom

/-- Forgetting the retained parameter gives the line-family projection. -/
theorem IntersectionProductScaf_retainedLineMap_base :
    IntersectionProductScaf_retainedLineMap X hfin M ≫
      IntersectionProductScaf_familyBase (a3h_PnO n) M =
        IntersectionProductScaf_familyMap₀ X hfin M := by
  rw [IntersectionProductScaf_familyMap₀_factor]
  rfl

/-- The line-family map retaining its parameter is finite. -/
theorem IntersectionProductScaf_retainedLineMap_finite :
    IsFinite (IntersectionProductScaf_retainedLineMap X hfin M).left := by
  have := IntersectionProductScaf_familyProjection_finite X hfin M
  change IsFinite ((IntersectionProductScaf_familyProjection X hfin M).left ≫
    (IntersectionProductScaf_targetFamilyIso M).hom.left)
  infer_instance

/-- In matching dimension the retained line map lifts generalizations. -/
theorem IntersectionProductScaf_retainedLineMap_generalizing [Smooth X.hom]
    (hn : Order.height (genericPoint X.left) = n) :
    GeneralizingMap (IntersectionProductScaf_retainedLineMap X hfin M).left := by
  exact (IntersectionProductScaf_familyProjection_generalizing X hfin M hn).comp
    (IntersectionProductScaf_targetFamilyIso M).hom.left.isOpenEmbedding.generalizingMap

#print axioms IntersectionProductScaf_retainedLineMap
#print axioms IntersectionProductScaf_retainedLineMap_base
#print axioms IntersectionProductScaf_retainedLineMap_finite
#print axioms IntersectionProductScaf_retainedLineMap_generalizing
end LineFamilyDimensions

set_option backward.isDefEq.respectTransparency false in
/-- The line inverse image is supported over the target cylinder under the retained map. -/
theorem IntersectionProductScaf_retainedLineMap_inverse_support
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] [Smooth X.hom] {n : ℕ}
    {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (M : Fin (n + 1) × Fin (n + 1) → ℂ)
    (hn : Order.height (genericPoint X.left) = n)
    (z : (a3h_PnO n).left) :
    ((ccm3_inverseIdeal (IntersectionProductScaf_familyMap₀ X hfin M).left z).support :
        Set (IntersectionProductScaf_familyOpen X M).left) =
      ((IntersectionProductScaf_retainedLineMap X hfin M ≫
        IntersectionProductScaf_familyInclusion (a3h_PnO n) M).left) ⁻¹'
        closure ({a3n_b (a3h_PnO n) z} : Set (a3n_T (a3h_PnO n)).left) := by
  have := IntersectionProductScaf_projectionTarget_integral X hfin hn
  rw [ccm3_inverseIdeal, Scheme.IdealSheafData.support_comap]
  simp only [ccm3_primeIdeal, Scheme.IdealSheafData.coe_support_vanishingIdeal]
  ext v
  change (IntersectionProductScaf_familyMap₀ X hfin M).left v ∈ closure ({z} : Set _) ↔
    ((IntersectionProductScaf_retainedLineMap X hfin M ≫
      IntersectionProductScaf_familyInclusion (a3h_PnO n) M).left) v ∈ closure ({_} : Set _)
  rw [← specializes_iff_mem_closure, ← specializes_iff_mem_closure, a3n_b_specializes_iff]
  change z ⤳ (IntersectionProductScaf_familyMap₀ X hfin M).left v ↔
    z ⤳ (a3n_q (a3h_PnO n)).left
      ((IntersectionProductScaf_familyInclusion (a3h_PnO n) M).left
        ((IntersectionProductScaf_retainedLineMap X hfin M).left v))
  rw [← Scheme.Hom.comp_apply, IntersectionProductScaf_familyInclusion_base_projection]
  change _ ↔ z ⤳ ((IntersectionProductScaf_retainedLineMap X hfin M ≫
    IntersectionProductScaf_familyBase (a3h_PnO n) M).left v)
  rw [IntersectionProductScaf_retainedLineMap_base]
#print axioms IntersectionProductScaf_retainedLineMap_inverse_support

set_option backward.isDefEq.respectTransparency false in
/-- The retained line map sends component points to the target cylinder point. -/
theorem IntersectionProductScaf_retainedLineMap_component_image
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] [Smooth X.hom] {n : ℕ}
    {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (M : Fin (n + 1) × Fin (n + 1) → ℂ)
    (hn : Order.height (genericPoint X.left) = n)
    (z : (a3h_PnO n).left)
    (u : (ccm3_inverseIdeal (IntersectionProductScaf_familyMap₀ X hfin M).left z).subscheme)
    (hu : closure ({u} : Set (ccm3_inverseIdeal (IntersectionProductScaf_familyMap₀ X hfin M).left z).subscheme) ∈
      irreducibleComponents (ccm3_inverseIdeal (IntersectionProductScaf_familyMap₀ X hfin M).left z).subscheme) :
    (IntersectionProductScaf_familyInclusion (a3h_PnO n) M).left
      ((IntersectionProductScaf_retainedLineMap X hfin M).left
        ((ccm3_inverseIdeal (IntersectionProductScaf_familyMap₀ X hfin M).left z).subschemeι u)) =
      a3n_b (a3h_PnO n) z := by
  exact IntersectionProductScaf_component_image_of_support
    (IntersectionProductScaf_retainedLineMap X hfin M ≫
      IntersectionProductScaf_familyInclusion (a3h_PnO n) M).left
    ((IntersectionProductScaf_retainedLineMap_generalizing X hfin M hn).comp
      (IntersectionProductScaf_familyInclusion (a3h_PnO n) M).left.isOpenEmbedding.generalizingMap)
    _ _ (IntersectionProductScaf_retainedLineMap_inverse_support X hfin M hn z) u hu
#print axioms IntersectionProductScaf_retainedLineMap_component_image

set_option backward.isDefEq.respectTransparency false in
/-- Every prime line-family member has one more dimension than its input point. -/
theorem IntersectionProductScaf_theta₀_single_height
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] [Smooth X.hom] {n : ℕ}
    {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (M : Fin (n + 1) × Fin (n + 1) → ℂ)
    (hn : Order.height (genericPoint X.left) = n)
    (z : (a3h_PnO n).left) (w : (a3n_T X).left)
    (hw : IntersectionProductScaf_theta₀ X hfin M
      (Function.locallyFinsuppWithin.single z 1) w ≠ 0) :
    height w = height z + 1 := by
  have := IntersectionProductScaf_projectionTarget_integral X hfin hn
  have := IntersectionProductScaf_retainedLineMap_finite X hfin M
  obtain ⟨u, huw, hu⟩ := (IntersectionProductScaf_openFamilyCycle_single_support
    (IntersectionProductScaf_familyInclusion X M)
    (IntersectionProductScaf_familyMap₀ X hfin M) z w).mp hw
  rw [← huw, IntersectionProductScaf_open_height]
  rw [← IntersectionProductScaf_finite_height (IntersectionProductScaf_retainedLineMap X hfin M).left]
  rw [← IntersectionProductScaf_open_height
    (IntersectionProductScaf_familyInclusion (a3h_PnO n) M)]
  rw [IntersectionProductScaf_retainedLineMap_component_image X hfin M hn z u hu,
    IntersectionProductScaf_cylinder_height]
#print axioms IntersectionProductScaf_theta₀_single_height

section LineCycleCodimension
variable (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] [Smooth X.hom] {n : ℕ}
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (M : Fin (n + 1) × Fin (n + 1) → ℂ)
    (hn : Order.height (genericPoint X.left) = n)
    (D : X.left) (w : (a3n_T X).left)
    (hw : (IntersectionProductScaf_data M a hfin).Θ₀
      (a1p_pushforward (a3h_πO X hfin).left
        (Function.locallyFinsuppWithin.single D 1)) w ≠ 0)

include hn hw in
/-- The pushed prime line family increases the input dimension by one. -/
theorem IntersectionProductScaf_theta₀_push_single_height :
    height w = height D + 1 := by
  rw [IntersectionProductScaf_theta₀_push_single, a3m_smul_apply] at hw
  have h := IntersectionProductScaf_theta₀_single_height X hfin M hn _ w
    (mul_ne_zero_iff.mp hw).2
  rwa [IntersectionProductScaf_finite_height] at h
#print axioms IntersectionProductScaf_theta₀_push_single_height

include hn hw in
/-- Each pushed prime line-family member has the codimension of its input. -/
theorem IntersectionProductScaf_theta₀_push_single_coheight :
    coheight w = coheight D := by
  have hh := IntersectionProductScaf_theta₀_push_single_height X a hfin M hn D w hw
  have h₁ := a3m_height_add_coheight (a3n_T X) w
  have h₂ := a3m_height_add_coheight (a3n_T X) (a3n_b X D)
  rw [hh] at h₁
  rw [IntersectionProductScaf_cylinder_height, a3k_coheight_b] at h₂
  obtain ⟨-, m, hm, -⟩ := a1d_height_eq_trdeg (X := X) D
  apply WithTop.add_left_cancel (show height D + 1 ≠ ⊤ from ?_) (h₁.trans h₂.symm)
  rw [hm]
  exact WithTop.add_ne_top.mpr ⟨ENat.natCast_ne_top m, ENat.natCast_ne_top 1⟩
#print axioms IntersectionProductScaf_theta₀_push_single_coheight
end LineCycleCodimension

set_option backward.isDefEq.respectTransparency false in
/-- A specialization of a line-family member on the zero section maps below the projected input. -/
theorem IntersectionProductScaf_theta₀_zero_specializes
    (M : Fin (n + 1) × Fin (n + 1) → ℂ)
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (D : X.left) (w : (a3n_T X).left)
    (hw : (IntersectionProductScaf_data M a hfin).Θ₀
      (a1p_pushforward (a3h_πO X hfin).left
        (Function.locallyFinsuppWithin.single D 1)) w ≠ 0)
    (x : X.left) (hx : w ⤳ a3n_σ X 0 x) :
    (a3h_πO X hfin).left D ⤳ (a3h_πO X hfin).left x := by
  obtain ⟨u, hu, hs⟩ := IntersectionProductScaf_openFamilyCycle_push_single_specializes
    (IntersectionProductScaf_familyInclusion X M)
    (IntersectionProductScaf_familyMap₀ X hfin M) (a3h_πO X hfin) D w hw
  have hzero : IsUnit ((IntersectionProductScaf_lineDet M).eval 0) := by
    rw [IntersectionProductScaf_lineDet_zero]
    exact isUnit_one
  let v := IntersectionProductScaf_familySection X M 0 hzero x
  have hv : (IntersectionProductScaf_familyInclusion X M).left v = a3n_σ X 0 x :=
    congrArg (fun f : X.left ⟶ (a3n_T X).left => f x)
      (IntersectionProductScaf_familySection_inclusion X M 0 hzero)
  have huv : u ⤳ v := by
    apply (IntersectionProductScaf_familyInclusion X M).left.isOpenEmbedding.isInducing.specializes_iff.mp
    rwa [hu, hv]
  have hmap : (IntersectionProductScaf_familyMap₀ X hfin M).left v =
      (a3h_πO X hfin).left x :=
    congrArg (fun f : X.left ⟶ (a3h_PnO n).left => f x)
      (IntersectionProductScaf_familyMap₀_zero X hfin M)
  rw [← hmap]
  exact hs.trans (huv.map (IntersectionProductScaf_familyMap₀ X hfin M).left.continuous)
#print axioms IntersectionProductScaf_theta₀_zero_specializes

set_option backward.isDefEq.respectTransparency false in
/-- Proper intersection of the two projected inputs gives the line-family zero-section bound. -/
theorem IntersectionProductScaf_good_zero_of_projected_proper
    (M : Fin (n + 1) × Fin (n + 1) → ℂ)
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (hn : height (genericPoint X.left) = n)
    (D v : X.left)
    (hp : a3i_MeetProperly (a3h_PnO n).left
      ((a3h_πO X hfin).left D) ((a3h_πO X hfin).left v))
    (w : (a3n_T X).left)
    (hw : (IntersectionProductScaf_data M a hfin).Θ₀
      (a1p_pushforward (a3h_πO X hfin).left
        (Function.locallyFinsuppWithin.single D 1)) w ≠ 0)
    (z : (a3n_T X).left) (hz : z ∈ a3y_comps w (a3n_σ X 0 v)) :
    coheight w + coheight (a3n_σ X 0 v) ≤ coheight z + (0 : ℕ) := by
  have := IntersectionProductScaf_projectionTarget_integral X hfin hn
  have : Surjective (a3h_πO X hfin).left :=
    ⟨a3h_π_surjective X hfin (a3h_dim_cone X n hn)⟩
  obtain ⟨hwz, hvz, -⟩ := a3y_comps_spec _ _ hz
  obtain ⟨x, rfl⟩ := a3n_mem_range_σ_of_specializes X 0 hvz
  have hDx := IntersectionProductScaf_theta₀_zero_specializes M a hfin D w hw x hwz
  have hvx : v ⤳ x := by
    have h := hvz.map (a3n_q X).left.continuous
    simpa only [a3n_q_σ_apply] using h
  obtain ⟨q, hq, hqx⟩ := a3y_exists_comp _ _ hDx (hvx.map (a3h_πO X hfin).left.continuous)
  have hb : coheight D + coheight v ≤ coheight x := by
    have h := Order.coheight_anti (Scheme.le_iff_specializes.mpr hqx)
    rw [a3y_coheight_comps _ _ hp hq] at h
    simpa only [IntersectionProductScaf_finite_coheight (a3h_πO X hfin)] using h
  rw [IntersectionProductScaf_theta₀_push_single_coheight X a hfin M hn D w hw,
    a3n_coheight_σ, a3n_coheight_σ, Nat.cast_zero, add_zero, ← add_assoc]
  exact add_le_add hb le_rfl
#print axioms IntersectionProductScaf_good_zero_of_projected_proper

/-- Restricting an extended original fibre to the open family recovers the inverse image
of the original input section. -/
theorem IntersectionProductScaf_originalIdeal_open
    (M : Fin (n + 1) × Fin (n + 1) → ℂ)
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (I : (a3n_T (a3h_PnO n)).left.IdealSheafData) (c : ℂ) :
    ((((I.comap (IntersectionProductScaf_familyMap₁ X hfin M).left).map
      (IntersectionProductScaf_familyInclusion (a3n_T X) M).left).comap
      (a3k_ι X c)).comap (IntersectionProductScaf_familyInclusion X M).left) =
      (I.comap (a3n_σ (a3h_PnO n) c)).comap
        (IntersectionProductScaf_familyMap₀ X hfin M).left := by
  rw [← Scheme.IdealSheafData.comap_comp,
    ← IntersectionProductScaf_originalFace_inclusion,
    Scheme.IdealSheafData.comap_comp,
    IntersectionProductScaf_open_ideal_restrict,
    IntersectionProductScaf_originalFace_ideal]
#print axioms IntersectionProductScaf_originalIdeal_open

section ProjectionFibreEstimates
open MvPolynomial TensorProduct
section ProjectionFibreBound
variable {ρ σ : Type} [Fintype ρ] [Fintype σ]
/-- A generic secant estimate preserves the input intersection bound on every projection fibre. -/
theorem IntersectionProductScaf_projection_fibre_dim_bound (IX PZ PW : Ideal (MvPolynomial σ ℂ)) [IX.IsPrime] [PZ.IsPrime]
    [PW.IsPrime] (hXZ : IX ≤ PZ) (ℓ : Matrix ρ σ ℂ)
    (hdimX : ringKrullDim (MvPolynomial σ ℂ ⧸ IX) = Fintype.card ρ)
    (hfin : ((Ideal.Quotient.mk IX).comp (a3r_lin ℓ).toRingHom).Finite)
    (hsec : ∀ (j : σ) (𝔓 : Ideal ((MvPolynomial σ ℂ ⧸ PW) ⊗[ℂ] (MvPolynomial σ ℂ ⧸ PZ))),
      𝔓.IsPrime → a3r_δD PW PZ j ∉ 𝔓 →
      (∀ i, ∑ k, algebraMap ℂ _ (ℓ i k) * a3r_δD PW PZ k - 0 ∈ 𝔓) →
      ringKrullDim (_ ⧸ 𝔓) + Fintype.card ρ ≤
        ringKrullDim ((MvPolynomial σ ℂ ⧸ PW) ⊗[ℂ] (MvPolynomial σ ℂ ⧸ PZ)))
    (k : ℕ) (hexc : ∀ 𝔶 ∈ (PZ ⊔ PW).minimalPrimes, (∃ j, MvPolynomial.X j ∉ 𝔶) →
      ringKrullDim (MvPolynomial σ ℂ ⧸ 𝔶) + ringKrullDim (MvPolynomial σ ℂ ⧸ IX) ≤
        ringKrullDim (MvPolynomial σ ℂ ⧸ PZ) + ringKrullDim (MvPolynomial σ ℂ ⧸ PW) + k)
    (Q' : Ideal (MvPolynomial σ ℂ)) [Q'.IsPrime] (hXQ : IX ≤ Q')
    (hQ : Q'.comap (a3r_lin ℓ) = PZ.comap (a3r_lin ℓ))
    (Y : Ideal (MvPolynomial σ ℂ)) [Y.IsPrime] (hY : Q' ⊔ PW ≤ Y) (hYrel : ∃ j, MvPolynomial.X j ∉ Y) :
    ringKrullDim (MvPolynomial σ ℂ ⧸ Y) + ringKrullDim (MvPolynomial σ ℂ ⧸ IX) ≤
      ringKrullDim (MvPolynomial σ ℂ ⧸ PZ) + ringKrullDim (MvPolynomial σ ℂ ⧸ PW) + k := by
  classical
  obtain ⟨𝔔, h𝔔, hK, h𝔔l, h𝔔r⟩ := a3r_exists_pair_prime IX ℓ Q' PZ hXQ hXZ hQ
  obtain ⟨𝔔', h𝔔', hle, h𝔔'l⟩ := a3r_exists_pair_prime_over IX ℓ hfin 𝔔 hK Y
    (h𝔔l ▸ le_sup_left.trans hY)
  have hK' : a3r_pairIdeal IX ℓ ≤ 𝔔' := hK.trans hle
  have hΛ : ∀ i, a3r_inl (a3r_lin ℓ (MvPolynomial.X i)) - a3r_inr (a3r_lin ℓ (MvPolynomial.X i)) ∈ 𝔔' :=
    fun i => hK' (Ideal.mem_sup_right (Ideal.subset_span ⟨i, rfl⟩))
  by_cases hd : ∀ k, a3r_δ k ∈ 𝔔'
  ·
    have hlr : ∀ F, F ∈ 𝔔'.comap a3r_inl ↔ F ∈ 𝔔'.comap a3r_inr := by
      intro F
      rw [Ideal.mem_comap, Ideal.mem_comap]
      have := a3r_inl_sub_inr_mem 𝔔' hd F
      constructor
      · intro h
        have := sub_mem h this
        rwa [sub_sub_cancel] at this
      · intro h
        have := add_mem this h
        rwa [sub_add_cancel] at this
    have hZY : PZ ≤ Y := by
      intro F hF
      rw [← h𝔔'l, hlr]
      exact hle (by rw [← h𝔔r] at hF; exact hF)
    obtain ⟨𝔶, h𝔶, h𝔶Y⟩ := Ideal.exists_minimalPrimes_le (sup_le hZY (le_sup_right.trans hY))
    have h𝔶p : 𝔶.IsPrime := h𝔶.1.1
    have h𝔶rel : ∃ j, MvPolynomial.X j ∉ 𝔶 := let ⟨j, hj⟩ := hYrel; ⟨j, fun h => hj (h𝔶Y h)⟩
    have hd := ringKrullDim_le_of_surjective (Ideal.Quotient.factor h𝔶Y)
      (Ideal.Quotient.factor_surjective h𝔶Y)
    exact (add_le_add hd le_rfl).trans (hexc 𝔶 h𝔶 h𝔶rel)
  ·
    push Not at hd
    obtain ⟨j, hj⟩ := hd
    have hW : PW ≤ 𝔔'.comap a3r_inl := h𝔔'l ▸ le_sup_right.trans hY
    have hZ : PZ ≤ 𝔔'.comap a3r_inr := by
      rw [← h𝔔r]
      exact Ideal.comap_mono hle
    have h := a3r_secant_dim PW PZ ℓ hsec 𝔔' hW hZ hΛ j hj
    rw [h𝔔'l, ← hdimX] at h
    calc _ ≤ ringKrullDim (MvPolynomial σ ℂ ⧸ PW) + ringKrullDim (MvPolynomial σ ℂ ⧸ PZ) := h
      _ ≤ _ := by rw [add_comm (ringKrullDim (MvPolynomial σ ℂ ⧸ PW))]; exact le_add_of_nonneg_right (Nat.cast_nonneg' k)
#print axioms IntersectionProductScaf_projection_fibre_dim_bound
end ProjectionFibreBound

/-- A general finite projection preserves proper intersection on all points of a prime fibre. -/
theorem IntersectionProductScaf_generic_projection_fibre_bound
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom]
    (n : ℕ) (hn : height (genericPoint X.left) = n) (D v : X.left)
    (hp : a3i_MeetProperly X.left D v) :
    a3r_Generic {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ |
      ∀ hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
        (a3r_lin (a3r_mat a)).toRingHom).Finite,
      ∀ u : X.left, (a3h_πO X hfin).left u = (a3h_πO X hfin).left D →
      ∀ x : X.left, u ⤳ x → v ⤳ x → coheight D + coheight v ≤ coheight x} := by
  have he : a3m_ExcessLE X.left ({v} : Set X.left) D 0 := by
    intro v' hv w hw
    obtain rfl : v' = v := hv
    simpa only [Nat.cast_zero, add_zero] using (hp w hw).ge
  refine (a3r_generic_secant (ρ := Fin (n + 1))
    ((a3s_CX X).prime v) ((a3s_CX X).prime D)).mono ?_
  intro a ha hfin u hu x hux hvx
  have hexc := fun Y hY hrel =>
    a3s_dim_of_excessLE X ({v} : Set X.left) D 0 he v (Set.mem_singleton v) Y hY hrel
  have hdim : ringKrullDim (MvPolynomial (Fin (a3s_N X + 1)) ℂ ⧸ a3s_IX X) =
      Fintype.card (Fin (n + 1)) := by
    simpa only [Fintype.card_fin] using a3h_dim_cone X n hn
  have hcomap : ((a3s_CX X).prime u).comap (a3r_lin (a3r_mat a)) =
      ((a3s_CX X).prime D).comap (a3r_lin (a3r_mat a)) := by
    rw [← a3h_prime_π X hfin, ← a3h_prime_π X hfin]
    exact congrArg (a3m_projCharts n).prime hu
  have hb := IntersectionProductScaf_projection_fibre_dim_bound
    (a3s_IX X) ((a3s_CX X).prime D) ((a3s_CX X).prime v)
    (a3s_IX_le X D) (a3r_mat a) hdim hfin ha 0 hexc
    ((a3s_CX X).prime u) (a3s_IX_le X u) hcomap ((a3s_CX X).prime x)
    (sup_le ((a3s_CX X).prime_mono hux) ((a3s_CX X).prime_mono hvx)) (a3s_relevant X x)
  obtain ⟨md, cd, -, hcd, hdc, hdd⟩ := a3s_nums X n hn D
  obtain ⟨mv, cv, -, hcv, hvc, hdv⟩ := a3s_nums X n hn v
  obtain ⟨mx, cx, -, hcx, hxc, hdx⟩ := a3s_nums X n hn x
  rw [hdd, hdv, hdx, a3h_dim_cone X n hn] at hb
  have hb' : mx + 1 + (n + 1) ≤ md + 1 + (mv + 1) + 0 := by exact_mod_cast hb
  rw [hcd, hcv, hcx]
  exact_mod_cast (show cd + cv ≤ cx by omega)
#print axioms IntersectionProductScaf_generic_projection_fibre_bound



end ProjectionFibreEstimates

section MatchedZeroBound
local instance (A : Type*) : DecidableEq A := Classical.decEq A
variable {X : Over (Spec ↧ℂ)} [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom] {n : ℕ}
/-- In matching dimension a general projection gives the zero-section bound for every relevant input. -/
theorem IntersectionProductScaf_good_zero_bound_of_dimension
    (beta : AlgebraicCycle X.left ℚ) (S : Finset (a3n_T X).left)
    (hn : height (genericPoint X.left) = n) :
    a3r_Generic {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ |
      ∀ hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
          (a3r_lin (a3r_mat a)).toRingHom).Finite,
        a3r_Generic {M : Fin (n + 1) × Fin (n + 1) → ℂ |
          ∀ D : X.left, (∃ y ∈ S, a3k_piece X y D ≠ 0) →
            (∀ v, beta v ≠ 0 → a3i_MeetProperly X.left D v) →
            ∀ y', (IntersectionProductScaf_data M a hfin).Θ₀
              (a1p_pushforward (a3h_πO X hfin).left
                (Function.locallyFinsuppWithin.single D 1)) y' ≠ 0 →
              a3n_h X y' = genericPoint (g3c_P 1) →
              ∀ v, beta v ≠ 0 →
                ∀ z ∈ a3y_comps y' (a3n_σ X 0 v),
                  coheight y' + coheight (a3n_σ X 0 v) ≤ coheight z + (0 : ℕ)}} := by
  have hG := a3r_generic_iInter (IntersectionProductScaf_pieceBetaSupport beta S) _
    (fun p _ => a3r_generic_of_imp (a3i_MeetProperly X.left p.1 p.2) _
      (fun hp => IntersectionProductScaf_generic_projection_fibre_bound X n hn p.1 p.2 hp))
  refine hG.mono ?_
  intro a ha hfin
  refine a3r_generic_univ.mono ?_
  intro M _ D hD hp w hw _ v hv z hz
  obtain ⟨hwz, hvz, -⟩ := a3y_comps_spec _ _ hz
  obtain ⟨x, rfl⟩ := a3n_mem_range_σ_of_specializes X 0 hvz
  have hDx := IntersectionProductScaf_theta₀_zero_specializes M a hfin D w hw x hwz
  have hvx : v ⤳ x := by
    have h := hvz.map (a3n_q X).left.continuous
    simpa only [a3n_q_σ_apply] using h
  obtain ⟨u, hux, hu⟩ := IntersectionProductScaf_projection_generalizing X hfin hn hDx
  have hb := ha (D, v) (IntersectionProductScaf_mem_pieceBetaSupport beta S D v hD hv)
    (hp v hv) hfin u hu x hux hvx
  rw [IntersectionProductScaf_theta₀_push_single_coheight X a hfin M hn D w hw,
    a3n_coheight_σ, a3n_coheight_σ, Nat.cast_zero, add_zero, ← add_assoc]
  exact add_le_add hb le_rfl
#print axioms IntersectionProductScaf_good_zero_bound_of_dimension

end MatchedZeroBound


section LineFibreBounds
open CategoryTheory.Limits
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
variable (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] {n : ℕ}
    {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (M : Fin (n + 1) × Fin (n + 1) → ℂ)

/-- The retained line map preserves the translation parameter. -/
theorem IntersectionProductScaf_retainedLineMap_parameter :
    (IntersectionProductScaf_retainedLineMap X hfin M).left ≫
      pullback.snd (a3h_PnO n).hom (IntersectionProductScaf_parameterOver M).hom =
        pullback.snd X.hom (IntersectionProductScaf_parameterOver M).hom := by
  change ((IntersectionProductScaf_familyProjection X hfin M).left ≫
    (IntersectionProductScaf_targetFamilyAction M).left) ≫ _ = _
  rw [Category.assoc, IntersectionProductScaf_targetFamilyAction_parameter,
    IntersectionProductScaf_familyProjection_parameter]
#print axioms IntersectionProductScaf_retainedLineMap_parameter

/-- The retained line map covers the target family in matching dimension. -/
theorem IntersectionProductScaf_retainedLineMap_surjective
    (hn : height (genericPoint X.left) = n) :
    Surjective (IntersectionProductScaf_retainedLineMap X hfin M).left := by
  have := IntersectionProductScaf_familyProjection_surjective X hfin M hn
  exact ⟨(IntersectionProductScaf_targetFamilyIso M).hom.left.surjective.comp
    (IntersectionProductScaf_familyProjection X hfin M).left.surjective⟩
#print axioms IntersectionProductScaf_retainedLineMap_surjective

/-- The line projection evaluated at an invertible parameter. -/
def IntersectionProductScaf_lineFibreMap (c : ℂ)
    (hc : IsUnit ((IntersectionProductScaf_lineDet M).eval c)) : X ⟶ a3h_PnO n :=
  IntersectionProductScaf_familyFibreMap (IntersectionProductScaf_retainedLineMap X hfin M) c hc

/-- Evaluation of the retained line map is restriction of the line-family projection. -/
theorem IntersectionProductScaf_lineFibreMap_eq (c : ℂ)
    (hc : IsUnit ((IntersectionProductScaf_lineDet M).eval c)) :
    (IntersectionProductScaf_lineFibreMap X hfin M c hc).left =
      IntersectionProductScaf_familySection X M c hc ≫
        (IntersectionProductScaf_familyMap₀ X hfin M).left := by
  unfold IntersectionProductScaf_lineFibreMap IntersectionProductScaf_familyFibreMap
  rw [IntersectionProductScaf_retainedLineMap_base]
  rfl
#print axioms IntersectionProductScaf_lineFibreMap
#print axioms IntersectionProductScaf_lineFibreMap_eq

/-- The evaluated line projection is the pullback of the retained map. -/
theorem IntersectionProductScaf_lineFibreMap_isPullback (c : ℂ)
    (hc : IsUnit ((IntersectionProductScaf_lineDet M).eval c)) :
    IsPullback (IntersectionProductScaf_familySection X M c hc)
      (IntersectionProductScaf_lineFibreMap X hfin M c hc).left
      (IntersectionProductScaf_retainedLineMap X hfin M).left
      (IntersectionProductScaf_familySection (a3h_PnO n) M c hc) :=
  IntersectionProductScaf_familyFibreMap_isPullback _
    (IntersectionProductScaf_retainedLineMap_parameter X hfin M) c hc
#print axioms IntersectionProductScaf_lineFibreMap_isPullback

/-- Every invertible parameter fibre has a finite line projection. -/
theorem IntersectionProductScaf_lineFibreMap_finite (c : ℂ)
    (hc : IsUnit ((IntersectionProductScaf_lineDet M).eval c)) :
    IsFinite (IntersectionProductScaf_lineFibreMap X hfin M c hc).left :=
  MorphismProperty.of_isPullback (IntersectionProductScaf_lineFibreMap_isPullback X hfin M c hc)
    (IntersectionProductScaf_retainedLineMap_finite X hfin M)
#print axioms IntersectionProductScaf_lineFibreMap_finite

/-- In matching dimension every invertible parameter fibre covers the target. -/
theorem IntersectionProductScaf_lineFibreMap_surjective (c : ℂ)
    (hc : IsUnit ((IntersectionProductScaf_lineDet M).eval c))
    (hn : height (genericPoint X.left) = n) :
    Surjective (IntersectionProductScaf_lineFibreMap X hfin M c hc).left :=
  MorphismProperty.of_isPullback (IntersectionProductScaf_lineFibreMap_isPullback X hfin M c hc)
    (IntersectionProductScaf_retainedLineMap_surjective X hfin M hn)
#print axioms IntersectionProductScaf_lineFibreMap_surjective

/-- Specialization on an invertible section maps below the projected input. -/
theorem IntersectionProductScaf_theta₀_section_specializes
    (c : ℂ) (hc : IsUnit ((IntersectionProductScaf_lineDet M).eval c))
    (D : X.left) (w : (a3n_T X).left)
    (hw : (IntersectionProductScaf_data M a hfin).Θ₀
      (a1p_pushforward (a3h_πO X hfin).left
        (Function.locallyFinsuppWithin.single D 1)) w ≠ 0)
    (x : X.left) (hx : w ⤳ a3n_σ X c x) :
    (a3h_πO X hfin).left D ⤳ (IntersectionProductScaf_lineFibreMap X hfin M c hc).left x := by
  obtain ⟨u, hu, hs⟩ := IntersectionProductScaf_openFamilyCycle_push_single_specializes
    (IntersectionProductScaf_familyInclusion X M)
    (IntersectionProductScaf_familyMap₀ X hfin M) (a3h_πO X hfin) D w hw
  let v := IntersectionProductScaf_familySection X M c hc x
  have hv : (IntersectionProductScaf_familyInclusion X M).left v = a3n_σ X c x :=
    congrArg (fun f : X.left ⟶ (a3n_T X).left => f x)
      (IntersectionProductScaf_familySection_inclusion X M c hc)
  have huv : u ⤳ v := by
    apply (IntersectionProductScaf_familyInclusion X M).left.isOpenEmbedding.isInducing.specializes_iff.mp
    rwa [hu, hv]
  rw [IntersectionProductScaf_lineFibreMap_eq]
  exact hs.trans (huv.map (IntersectionProductScaf_familyMap₀ X hfin M).left.continuous)
#print axioms IntersectionProductScaf_theta₀_section_specializes

/-- Proper intersection of the projected input and evaluated comparison gives the section bound. -/
theorem IntersectionProductScaf_good_section_of_projected_proper [Smooth X.hom]
    (c : ℂ) (hc : IsUnit ((IntersectionProductScaf_lineDet M).eval c))
    (hn : height (genericPoint X.left) = n)
    (D v : X.left)
    (hp : a3i_MeetProperly (a3h_PnO n).left
      ((a3h_πO X hfin).left D) ((IntersectionProductScaf_lineFibreMap X hfin M c hc).left v))
    (w : (a3n_T X).left)
    (hw : (IntersectionProductScaf_data M a hfin).Θ₀
      (a1p_pushforward (a3h_πO X hfin).left
        (Function.locallyFinsuppWithin.single D 1)) w ≠ 0)
    (z : (a3n_T X).left) (hz : z ∈ a3y_comps w (a3n_σ X c v)) :
    coheight w + coheight (a3n_σ X c v) ≤ coheight z + (0 : ℕ) := by
  have := IntersectionProductScaf_projectionTarget_integral X hfin hn
  have : Surjective (a3h_πO X hfin).left :=
    ⟨a3h_π_surjective X hfin (a3h_dim_cone X n hn)⟩
  have := IntersectionProductScaf_lineFibreMap_finite X hfin M c hc
  have := IntersectionProductScaf_lineFibreMap_surjective X hfin M c hc hn
  obtain ⟨hwz, hvz, -⟩ := a3y_comps_spec _ _ hz
  obtain ⟨x, rfl⟩ := a3n_mem_range_σ_of_specializes X c hvz
  have hDx := IntersectionProductScaf_theta₀_section_specializes X hfin M c hc D w hw x hwz
  have hvx : v ⤳ x := by
    have h := hvz.map (a3n_q X).left.continuous
    simpa only [a3n_q_σ_apply] using h
  obtain ⟨q, hq, hqx⟩ := a3y_exists_comp _ _ hDx
    (hvx.map (IntersectionProductScaf_lineFibreMap X hfin M c hc).left.continuous)
  have hb : coheight D + coheight v ≤ coheight x := by
    have h := Order.coheight_anti (Scheme.le_iff_specializes.mpr hqx)
    rw [a3y_coheight_comps _ _ hp hq] at h
    simpa only [IntersectionProductScaf_finite_coheight (a3h_πO X hfin),
      IntersectionProductScaf_finite_coheight (IntersectionProductScaf_lineFibreMap X hfin M c hc)] using h
  rw [IntersectionProductScaf_theta₀_push_single_coheight X a hfin M hn D w hw,
    a3n_coheight_σ, a3n_coheight_σ, Nat.cast_zero, add_zero, ← add_assoc]
  exact add_le_add hb le_rfl
#print axioms IntersectionProductScaf_good_section_of_projected_proper
end LineFibreBounds

/-- Constant matrix operations on sections are linear polynomial substitution. -/
theorem IntersectionProductScaf_matrixSections_constant
    {σ B : Type} [Fintype σ] [CommRing B]
    (M : Matrix σ σ ℂ) (f : MvPolynomial σ ℂ →+* B) :
    IntersectionProductScaf_matrixSections ((f.comp MvPolynomial.C).mapMatrix M) f =
      f.comp (a3r_lin M).toRingHom := by
  apply MvPolynomial.ringHom_ext
  · intro c
    simp [IntersectionProductScaf_matrixSections]
  · intro i
    simp [IntersectionProductScaf_matrixSections, a3r_lin_X, Matrix.mulVec, dotProduct,
      map_sum]
#print axioms IntersectionProductScaf_matrixSections_constant

section ConstantTranslationEquations
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
open CategoryTheory.Limits
variable (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] {n : ℕ}
  {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
  (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
    (a3r_lin (a3r_mat a)).toRingHom).Finite)
  (Z : Over (Spec ↧ℂ)) (q : Z.left ⟶ X.left)

/-- A constant translation matrix substitutes the projected homogeneous coordinates. -/
theorem IntersectionProductScaf_translatedComplexSections_constant
    (M : Matrix (Fin (n + 1)) (Fin (n + 1)) ℂ)
    (hq : q ≫ X.hom = Z.hom) (j : Fin (a3s_N X + 1)) :
    IntersectionProductScaf_translatedComplexSections X (a := a) Z q
        ((IntersectionProductScaf_complexScalars Z).mapMatrix M) j =
      ((IntersectionProductScaf_chartCoordinates X Z q j).comp
        (a3r_lin (a3r_mat a)).toRingHom).comp (a3r_lin M).toRingHom := by
  rw [IntersectionProductScaf_translatedComplexSections_matrix X Z q _ hq j]
  rw [← IntersectionProductScaf_matrixSections_constant]
  congr 1
  ext i k
  change ((IntersectionProductScaf_projectionCover X Z q).f j).appTop
      (IntersectionProductScaf_complexScalars Z (M i k)) =
    IntersectionProductScaf_chartCoordinates X Z q j
      (a3r_lin (a3r_mat a) (MvPolynomial.C (M i k)))
  rw [MvPolynomial.algHom_C, MvPolynomial.algebraMap_eq,
    IntersectionProductScaf_chartCoordinates_scalar X Z q hq]
  exact (a3m_appTop_comp_apply _ _ _).symm
#print axioms IntersectionProductScaf_translatedComplexSections_constant
/-- Identity translation retains the original complex projective morphism. -/
theorem IntersectionProductScaf_translatedProjection_one
    (hq : q ≫ X.hom = Z.hom) :
    (IntersectionProductScaf_translatedProjection X hfin Z q 1
      (by rw [Matrix.det_one]; exact isUnit_one)).left = q ≫ (a3h_πO X hfin).left := by
  change (IntersectionProductScaf_translatedProjection X hfin Z q 1 _).left = q ≫ a3h_π X hfin
  apply pullback.hom_ext
  · change (pullback.lift _ _ _) ≫ pullback.fst _ _ = _
    rw [pullback.lift_fst, Category.assoc, a3h_π_fst, hq]
  · change (pullback.lift _ _ _) ≫ pullback.snd _ _ = _
    rw [pullback.lift_snd, Category.assoc, a3h_π_snd,
      IntersectionProductScaf_translatedProjection₀_one]
#print axioms IntersectionProductScaf_translatedProjection_one
/-- Homogeneous equations of a constant translated image are linear substitutions at the
original projected image. -/
theorem IntersectionProductScaf_translatedProjection_constant_equation
    (M : Matrix (Fin (n + 1)) (Fin (n + 1)) ℂ) (hM : IsUnit M.det)
    (hq : q ≫ X.hom = Z.hom) (x : Z.left)
    (F : MvPolynomial (Fin (n + 1)) ℂ) (d : ℕ) (hF : F.IsHomogeneous d) :
    F ∈ (a3m_projCharts n).prime
      ((IntersectionProductScaf_translatedProjection X hfin Z q
        ((IntersectionProductScaf_complexScalars Z).mapMatrix M)
        (by rw [← RingHom.map_det]; exact hM.map _)).left x) ↔
    a3r_lin M F ∈ (a3m_projCharts n).prime ((a3h_πO X hfin).left (q x)) := by
  let C := IntersectionProductScaf_projectionCover X Z q
  obtain ⟨u, hu⟩ := C.covers x
  rw [← hu]
  have h := IntersectionProductScaf_translatedProjection_complex_equation X hfin Z q
    1 (by rw [Matrix.det_one]; exact isUnit_one) (C.idx x) u
    (a3r_lin M F) d (a3h_lin_isHomogeneous M hF)
  rw [IntersectionProductScaf_translatedProjection_one X hfin Z q hq,
    Scheme.Hom.comp_apply] at h
  rw [IntersectionProductScaf_translatedProjection_complex_equation X hfin Z q _ _ (C.idx x) u F d hF,
    IntersectionProductScaf_translatedComplexSections_constant X Z q M hq, h,
    IntersectionProductScaf_translatedComplexSections_matrix X Z q 1 hq]
  simp only [IntersectionProductScaf_chartMatrix, map_one,
    IntersectionProductScaf_matrixSections_one, RingHom.comp_apply]
  rfl
#print axioms IntersectionProductScaf_translatedProjection_constant_equation
set_option maxHeartbeats 400000 in
/-- The prime of a constant translated image is the contraction by its linear substitution. -/
theorem IntersectionProductScaf_translatedProjection_constant_prime
    (M : Matrix (Fin (n + 1)) (Fin (n + 1)) ℂ) (hM : IsUnit M.det)
    (hq : q ≫ X.hom = Z.hom) (x : Z.left) :
    (a3m_projCharts n).prime
      ((IntersectionProductScaf_translatedProjection X hfin Z q
        ((IntersectionProductScaf_complexScalars Z).mapMatrix M)
        (by rw [← RingHom.map_det]; exact hM.map _)).left x) =
    ((a3m_projCharts n).prime ((a3h_πO X hfin).left (q x))).comap
      (a3r_lin M).toRingHom := by
  apply le_antisymm
  · intro F hF
    rw [Ideal.mem_comap, ← MvPolynomial.sum_homogeneousComponent F, map_sum]
    apply Ideal.sum_mem
    intro d _
    exact (IntersectionProductScaf_translatedProjection_constant_equation X hfin Z q M hM hq x
      _ d (MvPolynomial.homogeneousComponent_isHomogeneous d F)).mp
        (MvPolynomial.homogeneousComponent_mem_of_mem
          ((a3m_projCharts n).isHomogeneous_prime _) hF d)
  · intro F hF
    change a3r_lin M F ∈ (a3m_projCharts n).prime ((a3h_πO X hfin).left (q x)) at hF
    rw [← MvPolynomial.sum_homogeneousComponent F]
    apply Ideal.sum_mem
    intro d _
    apply (IntersectionProductScaf_translatedProjection_constant_equation X hfin Z q M hM hq x
      _ d (MvPolynomial.homogeneousComponent_isHomogeneous d F)).mpr
    rw [← a3h_lin_homogeneousComponent]
    exact MvPolynomial.homogeneousComponent_mem_of_mem
      ((a3m_projCharts n).isHomogeneous_prime ((a3h_πO X hfin).left (q x))) hF d
#print axioms IntersectionProductScaf_translatedProjection_constant_prime
/-- At parameter one the global matrix restricts to the chosen constant matrix. -/
theorem IntersectionProductScaf_familySection_matrix_one
    {τ : Type} [Fintype τ] (Y : Over (Spec ↧ℂ))
    (M : τ × τ → ℂ) (hM : IsUnit (a3r_mat M).det) :
    (IntersectionProductScaf_familySection Y M 1 (by
      rw [IntersectionProductScaf_lineDet_one]; exact hM)).appTop.hom.mapMatrix
        (IntersectionProductScaf_familyMatrix Y M) =
      (IntersectionProductScaf_complexScalars Y).mapMatrix (a3r_mat M) := by
  rw [IntersectionProductScaf_familySection_matrix, IntersectionProductScaf_lineMatrix_one]
  rfl
#print axioms IntersectionProductScaf_familySection_matrix_one
/-- Equal homogeneous matrices define the same translated morphism. -/
theorem IntersectionProductScaf_translatedProjection_congr
    (Z : Over (Spec ↧ℂ)) (q : Z.left ⟶ X.left)
    (A B : Matrix (Fin (n + 1)) (Fin (n + 1)) Γ(Z.left, ⊤))
    (hA : IsUnit A.det) (hB : IsUnit B.det) (h : A = B) :
    (IntersectionProductScaf_translatedProjection X hfin Z q A hA).left =
      (IntersectionProductScaf_translatedProjection X hfin Z q B hB).left := by
  subst B
  rfl
#print axioms IntersectionProductScaf_translatedProjection_congr
/-- The evaluated endpoint-one projection contracts the original projected prime by the
chosen matrix substitution. -/
theorem IntersectionProductScaf_lineFibreMap_one_prime
    (M : Fin (n + 1) × Fin (n + 1) → ℂ) (hM : IsUnit (a3r_mat M).det)
    (x : X.left) :
    (a3m_projCharts n).prime
      ((IntersectionProductScaf_lineFibreMap X hfin M 1 (by
        rw [IntersectionProductScaf_lineDet_one]; convert hM using 1 <;> congr 1)).left x) =
      ((a3m_projCharts n).prime ((a3h_πO X hfin).left x)).comap
        (a3r_lin (a3r_mat M)).toRingHom := by
  have he := IntersectionProductScaf_lineFibreMap_eq X hfin M 1 (by
    rw [IntersectionProductScaf_lineDet_one]; convert hM using 1 <;> congr 1)
  rw [IntersectionProductScaf_familyMap₀_section] at he
  have hm := IntersectionProductScaf_familySection_matrix_one X M (by
    convert hM using 1 <;> congr 1)
  have hB : IsUnit ((IntersectionProductScaf_complexScalars X).mapMatrix (a3r_mat M)).det := by
    rw [← RingHom.map_det]
    exact hM.map _
  have ht := IntersectionProductScaf_translatedProjection_congr X hfin X (𝟙 X.left)
    _ _ (by rw [hm]; exact hB) hB hm
  erw [he, ht]
  exact IntersectionProductScaf_translatedProjection_constant_prime X hfin X (𝟙 X.left)
    (a3r_mat M) hM (Category.id_comp _) x
#print axioms IntersectionProductScaf_lineFibreMap_one_prime
/-- A generic endpoint-one translation bounds every common specialization with a fixed input. -/
theorem IntersectionProductScaf_generic_one_specialization_bound
    (hn : height (genericPoint X.left) = n) (D v : X.left) :
    a3r_Generic {M : Fin (n + 1) × Fin (n + 1) → ℂ |
      ∀ hM : IsUnit (a3r_mat M).det, ∀ x : X.left,
        (a3h_πO X hfin).left D ⤳
          (IntersectionProductScaf_lineFibreMap X hfin M 1 (by
            rw [IntersectionProductScaf_lineDet_one]; convert hM using 1 <;> congr 1)).left x →
        v ⤳ x → coheight D + coheight v ≤ coheight x} := by
  refine (a3r_generic_translate
    ((a3m_projCharts n).prime ((a3h_πO X hfin).left D))
    ((a3m_projCharts n).prime ((a3h_πO X hfin).left v))).mono ?_
  intro M hM hdet x hDx hvx
  have hD := (a3m_projCharts n).prime_mono hDx
  rw [IntersectionProductScaf_lineFibreMap_one_prime X hfin M hdet x] at hD
  have hv := (a3m_projCharts n).prime_mono (hvx.map (a3h_πO X hfin).left.continuous)
  obtain ⟨j, hj⟩ := (a3m_projCharts n).cover ((a3h_πO X hfin).left x)
  have hj' : MvPolynomial.X j ∉ (a3m_projCharts n).prime ((a3h_πO X hfin).left x) :=
    fun hh => ((a3m_projCharts n).X_mem_prime_iff _ j).mp hh hj
  have hb := hM ((a3m_projCharts n).prime ((a3h_πO X hfin).left x)) inferInstance hv
    (fun F hF => hD hF) j hj'
  have hd (u : X.left) :
      ringKrullDim (MvPolynomial (Fin (n + 1)) ℂ ⧸
        (a3m_projCharts n).prime ((a3h_πO X hfin).left u)) =
      ringKrullDim (MvPolynomial (Fin (a3s_N X + 1)) ℂ ⧸ (a3s_CX X).prime u) := by
    erw [a3h_prime_π]
    exact (a3r_dim_eq_of_finite (a3s_IX X) (a3r_mat a) hfin _ (a3s_IX_le X u)).symm
  rw [hd x, hd D, hd v, Fintype.card_fin] at hb
  obtain ⟨md, cd, -, hcd, hdc, hdd⟩ := a3s_nums X n hn D
  obtain ⟨mv, cv, -, hcv, hvc, hdv⟩ := a3s_nums X n hn v
  obtain ⟨mx, cx, -, hcx, hxc, hdx⟩ := a3s_nums X n hn x
  rw [hdd, hdv, hdx] at hb
  have hb' : mx + 1 + (n + 1) ≤ md + 1 + (mv + 1) := by exact_mod_cast hb
  rw [hcd, hcv, hcx]
  exact_mod_cast (show cd + cv ≤ cx by omega)
#print axioms IntersectionProductScaf_generic_one_specialization_bound
end ConstantTranslationEquations

section LineIncidenceBound
open MvPolynomial TensorProduct
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
local instance (A : Type*) : DecidableEq A := Classical.decEq A
variable {σ : Type} [Fintype σ] [DecidableEq σ]
set_option maxHeartbeats 400000 in
/-- Generic line translations satisfy the affine-cone incidence bound away from parameter zero. -/
theorem IntersectionProductScaf_generic_line0 (IC : Ideal (MvPolynomial σ ℂ)) [IC.IsPrime]
    (PW : Ideal (MvPolynomial σ ℂ)) [PW.IsPrime] :
    a3r_Generic {a : σ × σ → ℂ | ∀ Q : Ideal (Polynomial (MvPolynomial σ ℂ)), Q.IsPrime →
      (∀ F ∈ PW, Polynomial.C F ∈ Q) → (∀ F ∈ IC, IntersectionProductScaf_substLine0 a F ∈ Q) →
      ∀ j, Polynomial.X * Polynomial.C (MvPolynomial.X j) ∉ Q →
      ringKrullDim (Polynomial (MvPolynomial σ ℂ) ⧸ Q) + Fintype.card σ ≤
        ringKrullDim (MvPolynomial σ ℂ ⧸ IC) + ringKrullDim (MvPolynomial σ ℂ ⧸ PW) +
          1} := by
  classical
  set A := MvPolynomial σ ℂ
  set D₀ := (A ⧸ IC) ⊗[ℂ] (MvPolynomial σ ℂ ⧸ PW)
  set D := Polynomial D₀
  have : Algebra.FiniteType ℂ (A ⧸ IC) :=
    Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ ℂ _) (Ideal.Quotient.mkₐ_surjective ℂ _)
  have : Algebra.FiniteType ℂ (MvPolynomial σ ℂ ⧸ PW) :=
    Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ ℂ _) (Ideal.Quotient.mkₐ_surjective ℂ _)
  have : Algebra.FiniteType ℂ D := Algebra.FiniteType.trans (S := D₀) inferInstance inferInstance
  let w : σ → D₀ := fun k => 1 ⊗ₜ Ideal.Quotient.mk PW (MvPolynomial.X k)
  let c : σ → D₀ := fun i => Ideal.Quotient.mk IC (MvPolynomial.X i) ⊗ₜ 1
  refine (a3r_generic_iInter_fintype _ fun j => a3r_generic_linear (ρ := σ) D
    (fun k => Polynomial.X * Polynomial.C (w k))
    (fun i => Polynomial.C (c i) - (1 - Polynomial.X) * Polynomial.C (w i)) j).mono
    fun a ha Q hQ hWQ hCQ j hj => ?_
  set R := Polynomial A
  have hle : IC ≤ Ideal.comap (IntersectionProductScaf_substLine0 a) Q := fun F hF => hCQ F hF
  have hle' : PW ≤ Ideal.comap (Polynomial.CAlgHom (R := ℂ) (A := A)) Q := fun F hF => hWQ F hF
  let θ₁ : A ⧸ IC →ₐ[ℂ] R ⧸ Q := Ideal.quotientMapₐ Q _ hle
  let θ₂ : MvPolynomial σ ℂ ⧸ PW →ₐ[ℂ] R ⧸ Q := Ideal.quotientMapₐ Q _ hle'
  let Θ₀ : D₀ →ₐ[ℂ] R ⧸ Q := Algebra.TensorProduct.lift θ₁ θ₂ fun _ _ => Commute.all _ _
  let Θ : D →+* R ⧸ Q := Polynomial.eval₂RingHom Θ₀.toRingHom (Ideal.Quotient.mk Q Polynomial.X)
  have hΘ1 : ∀ F, Θ (Polynomial.C (Ideal.Quotient.mk IC F ⊗ₜ 1)) =
      Ideal.Quotient.mk Q (IntersectionProductScaf_substLine0 a F) := by
    intro F
    refine (Polynomial.eval₂_C _ _).trans ?_
    change θ₁ (Ideal.Quotient.mk IC F) * θ₂ 1 = _
    rw [_root_.map_one, mul_one]
    rfl
  have hΘ2 : ∀ F, Θ (Polynomial.C (1 ⊗ₜ Ideal.Quotient.mk PW F)) =
      Ideal.Quotient.mk Q (Polynomial.C F) := by
    intro F
    refine (Polynomial.eval₂_C _ _).trans ?_
    change θ₁ 1 * θ₂ (Ideal.Quotient.mk PW F) = _
    rw [_root_.map_one, one_mul]
    rfl
  have hΘX : Θ Polynomial.X = Ideal.Quotient.mk Q Polynomial.X := Polynomial.eval₂_X _ _
  have hΘc : ∀ z : ℂ, Θ (algebraMap ℂ D z) = algebraMap ℂ (R ⧸ Q) z := by
    intro z
    rw [Polynomial.algebraMap_apply]
    exact (Polynomial.eval₂_C _ _).trans (Θ₀.commutes z)
  have hsurj : Function.Surjective Θ := by
    let S := Θ.range
    have hA : ∀ F : A, Ideal.Quotient.mk Q (Polynomial.C F) ∈ S :=
      fun F => ⟨Polynomial.C (1 ⊗ₜ Ideal.Quotient.mk PW F), hΘ2 F⟩
    intro y
    obtain ⟨G, rfl⟩ := Ideal.Quotient.mk_surjective y
    induction G using Polynomial.induction_on' with
    | add p q hp hq =>
      rw [_root_.map_add]
      exact S.add_mem hp hq
    | monomial m F =>
      rw [← Polynomial.C_mul_X_pow_eq_monomial, _root_.map_mul, _root_.map_pow]
      exact S.mul_mem (hA F) (S.pow_mem ⟨Polynomial.X, hΘX⟩ m)
  set 𝔓 := RingHom.ker Θ
  have h𝔓 : 𝔓.IsPrime := RingHom.ker_isPrime _
  have hj' : Polynomial.X * Polynomial.C (w j) ∉ 𝔓 := by
    rw [RingHom.mem_ker, _root_.map_mul, hΘX, hΘ2, ← _root_.map_mul]
    exact fun h => hj (Ideal.Quotient.eq_zero_iff_mem.1 h)
  have hc : ∀ z : ℂ, algebraMap ℂ (R ⧸ Q) z =
      Ideal.Quotient.mk Q (Polynomial.C (C z)) := fun z => by
    rw [← Ideal.Quotient.mk_algebraMap, Polynomial.algebraMap_apply,
      MvPolynomial.algebraMap_eq]
  have hsubst (i : σ) : IntersectionProductScaf_substLine0 a (MvPolynomial.X i) =
      (1 - Polynomial.X) * Polynomial.C (MvPolynomial.X i) +
        Polynomial.X * Polynomial.C (∑ k, MvPolynomial.C (a (i, k)) * MvPolynomial.X k) := by
    simp [IntersectionProductScaf_substLine0]
  have hsum (f : σ → D) : Θ (∑ k, f k) = ∑ k, Θ (f k) :=
    _root_.map_sum Θ.toAddMonoidHom f Finset.univ
  have heq : ∀ i, ∑ k, algebraMap ℂ D (a (i, k)) * (Polynomial.X * Polynomial.C (w k)) -
      (Polynomial.C (c i) - (1 - Polynomial.X) * Polynomial.C (w i)) ∈ 𝔓 := by
    intro i
    rw [RingHom.mem_ker]
    change Θ _ = 0
    simp only [RingHom.map_sub, hsum,
      RingHom.map_mul, RingHom.map_one]
    simp only [w, c, hΘc, hΘX, hΘ1, hΘ2]
    simp only [hsubst, _root_.map_add, _root_.map_mul, _root_.map_sub, _root_.map_one, _root_.map_sum, hc]
    rw [Finset.mul_sum]
    ring_nf
    rw [sub_eq_zero]
    exact Finset.sum_congr rfl fun x _ => by ring
  have hb := ha j 𝔓 h𝔓 hj' heq
  have : Nontrivial (A ⧸ IC) := Ideal.Quotient.nontrivial_iff.2 (Ideal.IsPrime.ne_top inferInstance)
  have : Nontrivial (MvPolynomial σ ℂ ⧸ PW) :=
    Ideal.Quotient.nontrivial_iff.2 (Ideal.IsPrime.ne_top inferInstance)
  have : IsNoetherianRing D₀ := Algebra.FiniteType.isNoetherianRing ℂ D₀
  have hD : ringKrullDim D = ringKrullDim (A ⧸ IC) + ringKrullDim (MvPolynomial σ ℂ ⧸ PW) + 1 := by
    rw [Polynomial.ringKrullDim_of_isNoetherianRing, hc9k8_ringKrullDim_tensorProduct]
  have hDP : ringKrullDim (D ⧸ 𝔓) = ringKrullDim (R ⧸ Q) :=
    ringKrullDim_eq_of_ringEquiv (RingHom.quotientKerEquivOfSurjective (f := Θ) hsurj)
  rwa [hD, hDP] at hb

#print axioms IntersectionProductScaf_generic_line0
variable {ρ σ : Type} [Fintype ρ] [Fintype σ] [DecidableEq ρ]
set_option maxHeartbeats 400000 in
/-- Generic translation lines in projected coordinates satisfy the source-cone incidence bound. -/
theorem IntersectionProductScaf_generic_projected_line (IC : Ideal (MvPolynomial ρ ℂ)) [IC.IsPrime]
    (PW : Ideal (MvPolynomial σ ℂ)) [PW.IsPrime] (ℓ : Matrix ρ σ ℂ) :
    a3r_Generic {a : ρ × ρ → ℂ | ∀ Q : Ideal (Polynomial (MvPolynomial σ ℂ)), Q.IsPrime →
      (∀ F ∈ PW, Polynomial.C F ∈ Q) → (∀ F ∈ IC, (IntersectionProductScaf_substLine0 a F).map (a3r_lin ℓ).toRingHom ∈ Q) →
      ∀ j, Polynomial.X * Polynomial.C (a3r_lin ℓ (MvPolynomial.X j)) ∉ Q →
      ringKrullDim (Polynomial (MvPolynomial σ ℂ) ⧸ Q) + Fintype.card ρ ≤
        ringKrullDim (MvPolynomial ρ ℂ ⧸ IC) + ringKrullDim (MvPolynomial σ ℂ ⧸ PW) +
          1} := by
  classical
  set A := MvPolynomial σ ℂ
  set D₀ := (MvPolynomial ρ ℂ ⧸ IC) ⊗[ℂ] (MvPolynomial σ ℂ ⧸ PW)
  set D := Polynomial D₀
  have : Algebra.FiniteType ℂ (MvPolynomial ρ ℂ ⧸ IC) :=
    Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ ℂ _) (Ideal.Quotient.mkₐ_surjective ℂ _)
  have : Algebra.FiniteType ℂ (MvPolynomial σ ℂ ⧸ PW) :=
    Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ ℂ _) (Ideal.Quotient.mkₐ_surjective ℂ _)
  have : Algebra.FiniteType ℂ D := Algebra.FiniteType.trans (S := D₀) inferInstance inferInstance
  let w : ρ → D₀ := fun k => 1 ⊗ₜ Ideal.Quotient.mk PW (a3r_lin ℓ (MvPolynomial.X k))
  let c : ρ → D₀ := fun i => Ideal.Quotient.mk IC (MvPolynomial.X i) ⊗ₜ 1
  refine (a3r_generic_iInter_fintype _ fun j => a3r_generic_linear (ρ := ρ) D
    (fun k => Polynomial.X * Polynomial.C (w k))
    (fun i => Polynomial.C (c i) - (1 - Polynomial.X) * Polynomial.C (w i)) j).mono
    fun a ha Q hQ hWQ hCQ j hj => ?_
  set R := Polynomial A
  have hle : IC ≤ Ideal.comap ((Polynomial.mapAlgHom (a3r_lin ℓ)).comp
      (IntersectionProductScaf_substLine0 a)) Q := fun F hF => hCQ F hF
  have hle' : PW ≤ Ideal.comap (Polynomial.CAlgHom (R := ℂ) (A := A)) Q := fun F hF => hWQ F hF
  let θ₁ : MvPolynomial ρ ℂ ⧸ IC →ₐ[ℂ] R ⧸ Q := Ideal.quotientMapₐ Q _ hle
  let θ₂ : MvPolynomial σ ℂ ⧸ PW →ₐ[ℂ] R ⧸ Q := Ideal.quotientMapₐ Q _ hle'
  let Θ₀ : D₀ →ₐ[ℂ] R ⧸ Q := Algebra.TensorProduct.lift θ₁ θ₂ fun _ _ => Commute.all _ _
  let Θ : D →+* R ⧸ Q := Polynomial.eval₂RingHom Θ₀.toRingHom (Ideal.Quotient.mk Q Polynomial.X)
  have hΘ1 : ∀ F, Θ (Polynomial.C (Ideal.Quotient.mk IC F ⊗ₜ 1)) =
      Ideal.Quotient.mk Q ((IntersectionProductScaf_substLine0 a F).map (a3r_lin ℓ).toRingHom) := by
    intro F
    refine (Polynomial.eval₂_C _ _).trans ?_
    change θ₁ (Ideal.Quotient.mk IC F) * θ₂ 1 = _
    rw [_root_.map_one, mul_one]
    rfl
  have hΘ2 : ∀ F, Θ (Polynomial.C (1 ⊗ₜ Ideal.Quotient.mk PW F)) =
      Ideal.Quotient.mk Q (Polynomial.C F) := by
    intro F
    refine (Polynomial.eval₂_C _ _).trans ?_
    change θ₁ 1 * θ₂ (Ideal.Quotient.mk PW F) = _
    rw [_root_.map_one, one_mul]
    rfl
  have hΘX : Θ Polynomial.X = Ideal.Quotient.mk Q Polynomial.X := Polynomial.eval₂_X _ _
  have hΘc : ∀ z : ℂ, Θ (algebraMap ℂ D z) = algebraMap ℂ (R ⧸ Q) z := by
    intro z
    rw [Polynomial.algebraMap_apply]
    exact (Polynomial.eval₂_C _ _).trans (Θ₀.commutes z)
  have hsurj : Function.Surjective Θ := by
    let S := Θ.range
    have hA : ∀ F : A, Ideal.Quotient.mk Q (Polynomial.C F) ∈ S :=
      fun F => ⟨Polynomial.C (1 ⊗ₜ Ideal.Quotient.mk PW F), hΘ2 F⟩
    intro y
    obtain ⟨G, rfl⟩ := Ideal.Quotient.mk_surjective y
    induction G using Polynomial.induction_on' with
    | add p q hp hq =>
      rw [_root_.map_add]
      exact S.add_mem hp hq
    | monomial m F =>
      rw [← Polynomial.C_mul_X_pow_eq_monomial, _root_.map_mul, _root_.map_pow]
      exact S.mul_mem (hA F) (S.pow_mem ⟨Polynomial.X, hΘX⟩ m)
  set 𝔓 := RingHom.ker Θ
  have h𝔓 : 𝔓.IsPrime := RingHom.ker_isPrime _
  have hj' : Polynomial.X * Polynomial.C (w j) ∉ 𝔓 := by
    rw [RingHom.mem_ker, _root_.map_mul, hΘX, hΘ2, ← _root_.map_mul]
    exact fun h => hj (Ideal.Quotient.eq_zero_iff_mem.1 h)
  have hc : ∀ z : ℂ, algebraMap ℂ (R ⧸ Q) z =
      Ideal.Quotient.mk Q (Polynomial.C (C z)) := fun z => by
    rw [← Ideal.Quotient.mk_algebraMap, Polynomial.algebraMap_apply,
      MvPolynomial.algebraMap_eq]
  have hsubst (i : ρ) : (IntersectionProductScaf_substLine0 a (MvPolynomial.X i)).map
      (a3r_lin ℓ).toRingHom =
      (1 - Polynomial.X) * Polynomial.C (a3r_lin ℓ (MvPolynomial.X i)) +
        Polynomial.X * Polynomial.C
          (∑ k, MvPolynomial.C (a (i, k)) * a3r_lin ℓ (MvPolynomial.X k)) := by
    simp [IntersectionProductScaf_substLine0, Polynomial.map_sum, a3r_lin_C]
  have hsum (f : ρ → D) : Θ (∑ k, f k) = ∑ k, Θ (f k) :=
    _root_.map_sum Θ.toAddMonoidHom f Finset.univ
  have heq : ∀ i, ∑ k, algebraMap ℂ D (a (i, k)) * (Polynomial.X * Polynomial.C (w k)) -
      (Polynomial.C (c i) - (1 - Polynomial.X) * Polynomial.C (w i)) ∈ 𝔓 := by
    intro i
    rw [RingHom.mem_ker]
    change Θ _ = 0
    simp only [RingHom.map_sub, hsum,
      RingHom.map_mul, RingHom.map_one]
    simp only [w, c, hΘc, hΘX, hΘ1, hΘ2]
    simp only [hsubst, _root_.map_add, _root_.map_mul, _root_.map_sub, _root_.map_one, _root_.map_sum, hc]
    rw [Finset.mul_sum]
    ring_nf
    rw [sub_eq_zero]
    exact Finset.sum_congr rfl fun x _ => by ring
  have hb := ha j 𝔓 h𝔓 hj' heq
  have : Nontrivial (MvPolynomial ρ ℂ ⧸ IC) := Ideal.Quotient.nontrivial_iff.2 (Ideal.IsPrime.ne_top inferInstance)
  have : Nontrivial (MvPolynomial σ ℂ ⧸ PW) :=
    Ideal.Quotient.nontrivial_iff.2 (Ideal.IsPrime.ne_top inferInstance)
  have : IsNoetherianRing D₀ := Algebra.FiniteType.isNoetherianRing ℂ D₀
  have hD : ringKrullDim D = ringKrullDim (MvPolynomial ρ ℂ ⧸ IC) + ringKrullDim (MvPolynomial σ ℂ ⧸ PW) + 1 := by
    rw [Polynomial.ringKrullDim_of_isNoetherianRing, hc9k8_ringKrullDim_tensorProduct]
  have hDP : ringKrullDim (D ⧸ 𝔓) = ringKrullDim (R ⧸ Q) :=
    ringKrullDim_eq_of_ringEquiv (RingHom.quotientKerEquivOfSurjective (f := Θ) hsurj)
  rwa [hD, hDP] at hb

#print axioms IntersectionProductScaf_generic_projected_line
end LineIncidenceBound

section AffineConeComparison
open CategoryTheory AlgebraicGeometry Order
open AlgebraicGeometry.ComplexProjectiveSpace HodgeLean.Foundations
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
variable (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom]
/-- The affine polynomial cone prime has one more dimension than its geometric point. -/
theorem IntersectionProductScaf_affineCone_dimension
    (z : (a3n_T X).left) (hz : z ∈ a3h_U X) :
    ringKrullDim (Polynomial (MvPolynomial (Fin (a3s_N X + 1)) ℂ) ⧸
      a3s_Q X (a3h_pt X z hz)) = (height z : WithBot ℕ∞) + 1 := by
  rw [a3h_height_add_one X z hz]
  symm
  apply ringKrullDim_eq_of_ringEquiv
  exact Ideal.quotientEquiv _ _ (a3h_eqT (Fin (a3s_N X + 1))).toRingEquiv
    (Ideal.map_comap_of_surjective _ (a3h_eqT (Fin (a3s_N X + 1))).surjective _).symm
#print axioms IntersectionProductScaf_affineCone_dimension
/-- Specialization in the affine family is inclusion of its polynomial cone primes. -/
theorem IntersectionProductScaf_affineCone_specializes
    (y z : (a3n_T X).left) (hy : y ∈ a3h_U X) (hz : z ∈ a3h_U X) (h : y ⤳ z) :
    a3s_Q X (a3h_pt X y hy) ≤ a3s_Q X (a3h_pt X z hz) := by
  have hP := (a3h_P_le_iff X y z hy hz).mpr h
  intro F hF
  obtain ⟨G, rfl⟩ := (a3h_eqT (Fin (a3s_N X + 1))).surjective F
  exact hP hF
#print axioms IntersectionProductScaf_affineCone_specializes
/-- The prime of global sections detects nonunit germs. -/
theorem IntersectionProductScaf_globalSection_mem_prime
    (V : Scheme) (x : V) (b : Γ(V, ⊤)) :
    b ∈ (V.toSpecΓ x).asIdeal ↔ ¬ IsUnit (V.presheaf.germ ⊤ x (by trivial) b) := by
  have hb : b ∉ (V.toSpecΓ x).asIdeal ↔
      IsUnit (V.presheaf.germ ⊤ x (by trivial) b) := by
    rw [← PrimeSpectrum.mem_basicOpen, ← Scheme.mem_basicOpen_top]
    change x ∈ (V.toSpecΓ ⁻¹ᵁ PrimeSpectrum.basicOpen b) ↔ _
    rw [Scheme.toSpecΓ_preimage_basicOpen]
  simpa only [not_not] using not_congr hb
#print axioms IntersectionProductScaf_globalSection_mem_prime
/-- A homogeneous chart equation vanishes exactly when its pulled-back germ is a nonunit. -/
theorem IntersectionProductScaf_chart_equation_germ
    {Y V : Scheme} {σ R : Type} [Fintype σ] [CommRing R]
    (C : a3m_SpecCharts Y σ R) (j : σ) (g : V ⟶ Spec (C.T j)) (x : V)
    (F : MvPolynomial σ R) (d : ℕ) (hF : F.IsHomogeneous d) :
    F ∈ C.prime (C.κ j (g x)) ↔
      ¬ IsUnit (V.presheaf.germ ⊤ x (by trivial)
        (g.appTop ((Scheme.ΓSpecIso (C.T j)).inv (C.θ j F)))) := by
  rw [C.mem_prime_iff_of_isHomogeneous _ j (g x) rfl F d hF,
    ← IntersectionProductScaf_spec_sections_prime g x]
  change g.appTop ((Scheme.ΓSpecIso (C.T j)).inv (C.θ j F)) ∈
    (V.toSpecΓ x).asIdeal ↔ _
  exact IntersectionProductScaf_globalSection_mem_prime V x _
#print axioms IntersectionProductScaf_chart_equation_germ
variable (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] {n : ℕ}
  {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
  (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp (a3r_lin (a3r_mat a)).toRingHom).Finite)
/-- Away from zero, the translated cone equations impose the required geometric codimension. -/
theorem IntersectionProductScaf_generic_affine_bound_of_equations
    (hn : height (genericPoint X.left) = n) (D v : X.left) :
    a3r_Generic {M : Fin (n + 1) × Fin (n + 1) → ℂ |
      ∀ (z : (a3n_T X).left) (hz : z ∈ a3h_U X),
        a3n_h X z ∉ a3m_Z0 → v ⤳ (a3n_q X).left z →
        (∀ F ∈ (a3m_projCharts n).prime ((a3h_πO X hfin).left D),
          (IntersectionProductScaf_substLine0 M F).map (a3r_lin (a3r_mat a)).toRingHom ∈
            a3s_Q X (a3h_pt X z hz)) →
        coheight D + coheight v ≤ coheight z} := by
  refine (IntersectionProductScaf_generic_projected_line
    ((a3m_projCharts n).prime ((a3h_πO X hfin).left D))
    ((a3s_CX X).prime v) (a3r_mat a)).mono ?_
  intro M hM z hz hzero hvz heq
  let Q := a3s_Q X (a3h_pt X z hz)
  have hbase (F : MvPolynomial (Fin (a3s_N X + 1)) ℂ) :
      F ∈ (a3s_CX X).prime ((a3n_q X).left z) ↔ Polynomial.C F ∈ Q := by
    have h := a3s_fst_prime X (a3h_pt X z hz) F
    change F ∈ (a3s_CX X).prime (a3s_fst X ((a3h_e X).hom z)) ↔ _ at h
    rwa [a3h_e_fst_apply] at h
  have hW : ∀ F ∈ (a3s_CX X).prime v, Polynomial.C F ∈ Q :=
    fun F hF => (hbase F).mp ((a3s_CX X).prime_mono hvz hF)
  have ht : Polynomial.X ∉ Q := by
    intro ht
    have h := (a3s_mem_Z0 X (a3h_pt X z hz)).mpr ht
    change a3s_snd X ((a3h_e X).hom z) ∈ a3m_Z0 at h
    rw [a3h_e_snd_apply] at h
    exact hzero h
  obtain ⟨j, hj⟩ := (a3m_projCharts n).cover ((a3h_πO X hfin).left ((a3n_q X).left z))
  have hj' : Polynomial.C (a3r_lin (a3r_mat a) (MvPolynomial.X j)) ∉ Q := by
    intro hj'
    have hp := (hbase _).mpr hj'
    have hp' : MvPolynomial.X j ∈
        (a3m_projCharts n).prime ((a3h_πO X hfin).left ((a3n_q X).left z)) := by
      erw [a3h_prime_π]
      exact hp
    exact ((a3m_projCharts n).X_mem_prime_iff _ j).mp hp' hj
  have hprod : Polynomial.X * Polynomial.C (a3r_lin (a3r_mat a) (MvPolynomial.X j)) ∉ Q :=
    fun hh => ((inferInstance : Q.IsPrime).mem_or_mem hh).elim ht hj'
  have hb := hM Q inferInstance hW heq j hprod
  have hD : ringKrullDim (MvPolynomial (Fin (n + 1)) ℂ ⧸
      (a3m_projCharts n).prime ((a3h_πO X hfin).left D)) =
      ringKrullDim (MvPolynomial (Fin (a3s_N X + 1)) ℂ ⧸ (a3s_CX X).prime D) := by
    erw [a3h_prime_π]
    exact (a3r_dim_eq_of_finite (a3s_IX X) (a3r_mat a) hfin _ (a3s_IX_le X D)).symm
  obtain ⟨md, cd, -, hcd, hdc, hdd⟩ := a3s_nums X n hn D
  obtain ⟨mv, cv, -, hcv, hvc, hdv⟩ := a3s_nums X n hn v
  obtain ⟨cz, hcz, hczle, hdz⟩ := a3h_dim_P X n hn z hz
  change ringKrullDim (_ ⧸ a3s_Q X (a3h_pt X z hz)) + _ ≤ _ at hb
  rw [IntersectionProductScaf_affineCone_dimension, a3h_height_add_one X z hz,
    hdz, hD, hdd, hdv, Fintype.card_fin] at hb
  have hb' : n + 2 - cz + (n + 1) ≤ md + 1 + (mv + 1) + 1 := by exact_mod_cast hb
  rw [hcd, hcv, hcz]
  exact_mod_cast (show cd + cv ≤ cz by omega)
#print axioms IntersectionProductScaf_generic_affine_bound_of_equations
end AffineConeComparison

section FamilyAffineCharts
open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Order
open AlgebraicGeometry.ComplexProjectiveSpace HodgeLean.Foundations
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
attribute [local instance] MvPolynomial.gradedAlgebra
variable (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom]
  {σ : Type} [Fintype σ] (M : σ × σ → ℂ) (j : Fin (a3s_N X + 1))
/-- A determinant-open family chart maps to the ordinary affine product chart. -/
def IntersectionProductScaf_familyAffineChart :
    (IntersectionProductScaf_projectionCover X (IntersectionProductScaf_familyOpen X M)
      (IntersectionProductScaf_familyBase X M).left).X j ⟶ Spec (a3m_TT (a3s_CX X) j) :=
  pullback.lift
    (pullback.snd (IntersectionProductScaf_familyBase X M).left ((a3s_CX X).κ j))
    ((IntersectionProductScaf_projectionCover X (IntersectionProductScaf_familyOpen X M)
      (IntersectionProductScaf_familyBase X M).left).f j ≫
      pullback.snd X.hom (IntersectionProductScaf_parameterOver M).hom ≫
      IntersectionProductScaf_parameterChart M ≫
      Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.includeRight (R := ℤ) (A := ℂ) (B := a3m_Away1)).toRingHom))
    (terminal.hom_ext _ _) ≫ (a3m_tensorIso ((a3s_CX X).T j) (.of a3m_Away1)).hom
#print axioms IntersectionProductScaf_familyAffineChart
/-- The affine product chart retains the original projective chart coordinate. -/
theorem IntersectionProductScaf_familyAffineChart_fst :
    IntersectionProductScaf_familyAffineChart X M j ≫
      Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom
        (R := ℤ) (A := (a3s_CX X).T j) (B := a3m_Away1))) =
      pullback.snd (IntersectionProductScaf_familyBase X M).left ((a3s_CX X).κ j) := by
  rw [IntersectionProductScaf_familyAffineChart, Category.assoc,
    a3m_tensorIso_hom_fst, pullback.lift_fst]
#print axioms IntersectionProductScaf_familyAffineChart_fst
/-- The affine product chart retains the ordinary affine parameter coordinate. -/
theorem IntersectionProductScaf_familyAffineChart_snd :
    IntersectionProductScaf_familyAffineChart X M j ≫
      Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight
        (R := ℤ) (A := (a3s_CX X).T j) (B := a3m_Away1)).toRingHom) =
      (IntersectionProductScaf_projectionCover X (IntersectionProductScaf_familyOpen X M)
        (IntersectionProductScaf_familyBase X M).left).f j ≫
        pullback.snd X.hom (IntersectionProductScaf_parameterOver M).hom ≫
        IntersectionProductScaf_parameterChart M ≫
        Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight
          (R := ℤ) (A := ℂ) (B := a3m_Away1)).toRingHom) := by
  rw [IntersectionProductScaf_familyAffineChart, Category.assoc,
    a3m_tensorIso_hom_snd, pullback.lift_snd]
#print axioms IntersectionProductScaf_familyAffineChart_snd
/-- The affine chart map describes the same point of the ambient projective family. -/
theorem IntersectionProductScaf_familyAffineChart_inclusion :
    IntersectionProductScaf_familyAffineChart X M j ≫ a3m_Tκ (a3s_CX X) j =
      (IntersectionProductScaf_projectionCover X (IntersectionProductScaf_familyOpen X M)
        (IntersectionProductScaf_familyBase X M).left).f j ≫
        (IntersectionProductScaf_familyInclusion X M).left ≫ (a3h_e X).hom := by
  apply pullback.hom_ext
  · simp only [Category.assoc, a3m_Tκ, a3m_prodChart_fst, a3h_e_fst]
    rw [← Category.assoc, IntersectionProductScaf_familyAffineChart_fst,
      IntersectionProductScaf_familyInclusion_base_projection]
    exact pullback.condition.symm
  · simp only [Category.assoc, a3m_Tκ, a3m_prodChart_snd, a3h_e_snd]
    rw [← Category.assoc, IntersectionProductScaf_familyAffineChart_snd]
    change _ = _ ≫ (IntersectionProductScaf_familyInclusion X M).left ≫ a3n_p X ≫ a3n_π
    rw [← Category.assoc (IntersectionProductScaf_familyInclusion X M).left,
      IntersectionProductScaf_familyInclusion_parameter]
    simp only [Category.assoc, IntersectionProductScaf_parameterOverInclusion,
      Over.homMk_left, IntersectionProductScaf_parameterInclusion, a3m_Pnκ,
      a3m_prodChart_snd]
#print axioms IntersectionProductScaf_familyAffineChart_inclusion

/-- The affine chart representative maps to the canonical point of the open family. -/
theorem IntersectionProductScaf_familyAffineChart_point
    (x : (IntersectionProductScaf_projectionCover X (IntersectionProductScaf_familyOpen X M)
      (IntersectionProductScaf_familyBase X M).left).X j)
    (w : (a3n_T X).left) (hw : w ∈ a3h_U X)
    (hx : (IntersectionProductScaf_familyInclusion X M).left
      ((IntersectionProductScaf_projectionCover X (IntersectionProductScaf_familyOpen X M)
        (IntersectionProductScaf_familyBase X M).left).f j x) = w) :
    (a3s_LC X).κ j (IntersectionProductScaf_familyAffineChart X M j x) = a3h_pt X w hw := by
  apply Subtype.ext
  change ((IntersectionProductScaf_familyAffineChart X M j ≫ (a3s_LC X).κ j ≫
    (a3m_U X.left).ι) x) = (a3h_e X).hom w
  erw [a3m_lineCharts_κ, IntersectionProductScaf_familyAffineChart_inclusion]
  simp only [Scheme.Hom.comp_apply, hx]
#print axioms IntersectionProductScaf_familyAffineChart_point

/-- Polynomial equations on the affine product chart evaluate by the original chart coordinates
and the actual family parameter. -/
theorem IntersectionProductScaf_familyAffineChart_evaluation :
    ((IntersectionProductScaf_familyAffineChart X M j).appTop.hom.comp
      (Scheme.ΓSpecIso (a3m_TT (a3s_CX X) j)).inv.hom).comp
        ((a3m_Tθ (a3s_CX X) j).comp ((a3m_eq (Fin (a3s_N X + 1))).toRingHom)) =
      Polynomial.eval₂RingHom
        (IntersectionProductScaf_chartCoordinates X (IntersectionProductScaf_familyOpen X M)
          (IntersectionProductScaf_familyBase X M).left j)
        (((IntersectionProductScaf_projectionCover X (IntersectionProductScaf_familyOpen X M)
          (IntersectionProductScaf_familyBase X M).left).f j).appTop
            (IntersectionProductScaf_familyParameterSections X M Polynomial.X)) := by
  apply Polynomial.ringHom_ext
  · intro F
    change (IntersectionProductScaf_familyAffineChart X M j).appTop
      ((Scheme.ΓSpecIso (a3m_TT (a3s_CX X) j)).inv
        (a3m_Tθ (a3s_CX X) j (a3m_eq _ (Polynomial.C F)))) = _
    rw [a3m_eq_C, a3m_Tθ_map_C]
    erw [← a3m_appTop_comp_SpecMap _ (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom (R := ℤ) (A := (a3s_CX X).T j) (B := a3m_Away1))),
      IntersectionProductScaf_familyAffineChart_fst]
    simp only [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
    rfl
  · change (IntersectionProductScaf_familyAffineChart X M j).appTop
      ((Scheme.ΓSpecIso (a3m_TT (a3s_CX X) j)).inv
        (a3m_Tθ (a3s_CX X) j (a3m_eq _ Polynomial.X))) = _
    rw [a3m_eq_X]
    simp only [a3m_Tθ, MvPolynomial.eval₂Hom_C, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
    change (IntersectionProductScaf_familyAffineChart X M j).appTop
      ((Scheme.ΓSpecIso (a3m_TT (a3s_CX X) j)).inv
        (Algebra.TensorProduct.includeRight (R := ℤ) (A := (a3s_CX X).T j) a3m_t₁)) = _
    erw [← a3m_appTop_comp_SpecMap _ (CommRingCat.ofHom (Algebra.TensorProduct.includeRight (R := ℤ) (A := (a3s_CX X).T j) (B := a3m_Away1)).toRingHom), IntersectionProductScaf_familyAffineChart_snd,
      a3m_appTop_comp_apply]
    simp only [a3m_appTop_comp_apply]
    simp only [g3c_SpecMap_appTop_ΓSpecIso_inv, IntersectionProductScaf_parameterChart,
      IntersectionProductScaf_familyParameterSections, RingHom.comp_apply]
    apply congrArg (_ : Γ((IntersectionProductScaf_familyOpen X M).left, ⊤) → _)
    apply congrArg (_ : Γ(Spec (.of (IntersectionProductScaf_lineRing M)), ⊤) → _)
    erw [g3c_SpecMap_appTop_ΓSpecIso_inv, g3c_SpecMap_appTop_ΓSpecIso_inv]
    apply congrArg (fun c => (Scheme.ΓSpecIso (.of (IntersectionProductScaf_lineRing M))).inv
      (algebraMap (Polynomial ℂ) (IntersectionProductScaf_lineRing M) c))
    apply (a3n_chartEquiv 0).injective
    change (a3n_chartEquiv 0) ((a3n_chartEquiv 0).symm _) = _
    rw [AlgEquiv.apply_symm_apply]
    simp [a3n_chartEquiv, polyEquivTensor_apply, a3n_awayEquiv, a3n_ev, a3m_t₁]
#print axioms IntersectionProductScaf_familyAffineChart_evaluation


open MvPolynomial
/-- The projected line substitution preserves homogeneous degree in the source coordinates. -/
theorem IntersectionProductScaf_projectedLine_isHomogeneous
    {ρ σ : Type} [Fintype ρ] [Fintype σ]
    (ℓ : Matrix ρ σ ℂ) (M : ρ × ρ → ℂ)
    (F : MvPolynomial ρ ℂ) (d : ℕ) (hF : F.IsHomogeneous d) :
    (a3m_eq σ ((IntersectionProductScaf_substLine0 M F).map
      (a3r_lin ℓ).toRingHom)).IsHomogeneous d := by
  let g : MvPolynomial ρ ℂ →ₐ[ℂ] MvPolynomial σ (Polynomial ℂ) :=
    (a3m_eq σ).toAlgHom.comp
      ((Polynomial.mapAlgHom (a3r_lin ℓ)).comp (IntersectionProductScaf_substLine0 M))
  have hg (i : ρ) : (g (MvPolynomial.X i)).IsHomogeneous 1 := by
    have he : g (MvPolynomial.X i) =
        MvPolynomial.C (1 - Polynomial.X) *
          MvPolynomial.map Polynomial.C (a3r_lin ℓ (MvPolynomial.X i)) +
        MvPolynomial.C Polynomial.X *
          MvPolynomial.map Polynomial.C (a3r_lin ℓ (a3r_lin (a3r_mat M) (MvPolynomial.X i))) := by
      simp [g, IntersectionProductScaf_substLine0, a3m_eq_C, a3m_eq_X, a3r_lin_X,
        Polynomial.map_sum, map_sum, a3r_mat]
    rw [he]
    apply IsHomogeneous.add
    · exact (isHomogeneous_C _ _).mul
        ((a3h_lin_isHomogeneous ℓ (isHomogeneous_X ℂ i)).map Polynomial.C)
    · exact (isHomogeneous_C _ _).mul
        ((a3h_lin_isHomogeneous ℓ (a3h_lin_isHomogeneous (a3r_mat M)
          (isHomogeneous_X ℂ i))).map Polynomial.C)
  have he : aeval (fun i => g (MvPolynomial.X i)) = g := by
    apply MvPolynomial.algHom_ext
    intro i
    simp
  have h := hF.aeval (S := Polynomial ℂ) (fun i => g (MvPolynomial.X i)) hg
  rw [one_mul, he] at h
  exact h
#print axioms IntersectionProductScaf_projectedLine_isHomogeneous


/-- A prime line member satisfies its projected line equations in the affine cone prime. -/
theorem IntersectionProductScaf_theta₀_single_cone_equations
    {n : ℕ} {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (M : Fin (n + 1) × Fin (n + 1) → ℂ)
    (z : (a3h_PnO n).left) (w : (a3n_T X).left) (hwU : w ∈ a3h_U X)
    (hw : IntersectionProductScaf_theta₀ X hfin M
      (Function.locallyFinsuppWithin.single z 1) w ≠ 0) :
    ∀ F ∈ (a3m_projCharts n).prime z,
      (IntersectionProductScaf_substLine0 M F).map (a3r_lin (a3r_mat a)).toRingHom ∈
        a3s_Q X (a3h_pt X w hwU) := by
  obtain ⟨j, x, hx, heq⟩ :=
    IntersectionProductScaf_theta₀_single_polynomial_equations X hfin M z w hw
  have hpoint := IntersectionProductScaf_familyAffineChart_point X M j x w hwU hx
  have hhom (F : MvPolynomial (Fin (n + 1)) ℂ) (d : ℕ) (hF : F.IsHomogeneous d)
      (hzF : F ∈ (a3m_projCharts n).prime z) :
      (IntersectionProductScaf_substLine0 M F).map (a3r_lin (a3r_mat a)).toRingHom ∈
        a3s_Q X (a3h_pt X w hwU) := by
    change a3m_eq _ _ ∈ (a3s_LC X).prime _
    rw [← hpoint]
    apply (IntersectionProductScaf_chart_equation_germ (a3s_LC X) j
      (IntersectionProductScaf_familyAffineChart X M j) x _ d
      (IntersectionProductScaf_projectedLine_isHomogeneous (a3r_mat a) M F d hF)).mpr
    have he := congrArg (fun f => f ((IntersectionProductScaf_substLine0 M F).map
      (a3r_lin (a3r_mat a)).toRingHom))
      (IntersectionProductScaf_familyAffineChart_evaluation X M j)
    change (IntersectionProductScaf_familyAffineChart X M j).appTop
      ((Scheme.ΓSpecIso _).inv (a3m_Tθ (a3s_CX X) j (a3m_eq _ _))) = _ at he
    change ¬ IsUnit (((IntersectionProductScaf_projectionCover X
      (IntersectionProductScaf_familyOpen X M) (IntersectionProductScaf_familyBase X M).left).X j).presheaf.germ ⊤ x (by trivial)
      ((IntersectionProductScaf_familyAffineChart X M j).appTop
      ((Scheme.ΓSpecIso _).inv (a3m_Tθ (a3s_CX X) j (a3m_eq _ _)))))
    rw [he]
    simpa only [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_map] using heq F hzF
  intro F hF
  rw [← MvPolynomial.sum_homogeneousComponent F, map_sum, Polynomial.map_sum]
  apply Ideal.sum_mem
  intro d hd
  exact hhom _ d (MvPolynomial.homogeneousComponent_isHomogeneous d F)
    (MvPolynomial.homogeneousComponent_mem_of_mem ((a3m_projCharts n).isHomogeneous_prime z) hF d)
#print axioms IntersectionProductScaf_theta₀_single_cone_equations


end FamilyAffineCharts

section MatchedCylinderBound
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
variable {X : Over (Spec ↧ℂ)} [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom] {n : ℕ}
/-- The line family has the expected codimension along the cylinder. -/
theorem IntersectionProductScaf_good_cylinder_bound_of_dimension
    (beta : AlgebraicCycle X.left ℚ) (S : Finset (a3n_T X).left)
    (hn : height (genericPoint X.left) = n) :
    a3r_Generic {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ |
      ∀ hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
          (a3r_lin (a3r_mat a)).toRingHom).Finite,
        a3r_Generic {M : Fin (n + 1) × Fin (n + 1) → ℂ |
          ∀ D : X.left, (∃ y ∈ S, a3k_piece X y D ≠ 0) →
            (∀ v, beta v ≠ 0 → a3i_MeetProperly X.left D v) →
            ∀ y', (IntersectionProductScaf_data M a hfin).Θ₀
              (a1p_pushforward (a3h_πO X hfin).left
                (Function.locallyFinsuppWithin.single D 1)) y' ≠ 0 →
              a3n_h X y' = genericPoint (g3c_P 1) →
              ∀ v, beta v ≠ 0 →
                ∀ z ∈ a3y_comps y' (a3n_b X v), a3n_p X z ∈ Set.range (a3m_Pnκ 1 0) →
                  coheight y' + coheight (a3n_b X v) ≤ coheight z + (0 : ℕ)}} := by
  refine (IntersectionProductScaf_good_zero_bound_of_dimension beta S hn).mono ?_
  intro a ha hfin
  have hG := a3r_generic_iInter (IntersectionProductScaf_pieceBetaSupport beta S) _
    (fun p _ => IntersectionProductScaf_generic_affine_bound_of_equations X hfin hn p.1 p.2)
  refine ((ha hfin).inter hG).mono ?_
  rintro M ⟨hzero, hG⟩ D hD hp w hw hdom v hv z hz hzU
  obtain ⟨hwz, hvz, -⟩ := a3y_comps_spec _ _ hz
  have hvq : v ⤳ (a3n_q X).left z := (a3n_b_specializes_iff X v z).mp hvz
  rw [Nat.cast_zero, add_zero, a3k_coheight_b]
  by_cases ht : a3n_h X z ∈ a3m_Z0
  · have hσ : a3n_σ X 0 v ⤳ z := by
      rw [a3n_eq_σ0 X z ht]
      exact hvq.map (a3n_σ X 0).continuous
    have hb := a3k_coheight_of_σ X 0 w v (hzero D hD hp w hw hdom v hv) hwz hσ
    exact (le_add_of_nonneg_right (show (0 : ENat) ≤ 1 from zero_le)).trans hb
  · have hwU := IntersectionProductScaf_parameter_generic_mem_U X w hdom
    have hzU' : z ∈ a3h_U X := hzU
    have hw' := hw
    rw [IntersectionProductScaf_theta₀_push_single, a3m_smul_apply] at hw'
    have heq := IntersectionProductScaf_theta₀_single_cone_equations X hfin M
      ((a3h_πO X hfin).left D) w hwU (mul_ne_zero_iff.mp hw').2
    have heq' := fun F hF =>
      IntersectionProductScaf_affineCone_specializes X w z hwU hzU' hwz (heq F hF)
    have hb := hG (D, v) (IntersectionProductScaf_mem_pieceBetaSupport beta S D v hD hv)
      z hzU' ht hvq heq'
    rwa [IntersectionProductScaf_theta₀_push_single_coheight X a hfin M hn D w hw]


#print axioms IntersectionProductScaf_good_cylinder_bound_of_dimension

end MatchedCylinderBound

section ParameterIntersectionMultiplicity
open CategoryTheory.MonoidalCategory CategoryTheory.Limits
universe u
/-- A parameter regular on the ambient ring and the module has no higher quotient Tor. -/
theorem IntersectionProductScaf_parameter_tor_vanish
    {R : Type u} [CommRing R] (N : ModuleCat.{u} R) (r : R)
    (hr : IsSMulRegular R r) (hN : IsSMulRegular N r) (i : ℕ) :
    IsZero (((Tor (ModuleCat.{u} R) (i + 1)).obj
      (ModuleCat.of R (QuotSMulTop r R))).obj N) := by
  cases i with
  | zero =>
    let Q := ProjectiveResolution.of N
    let S := (ModuleCat.of R R).smulShortComplex r
    have hS : S.ShortExact := hr.smulShortComplex_shortExact
    letI : Projective S.X₂ := inferInstanceAs (Projective (ModuleCat.of R R))
    have hm : Mono (S.f ▷ N) := by
      change Mono ((r • 𝟙 (ModuleCat.of R R)) ▷ N)
      rw [MonoidalLinear.smul_whiskerRight, id_whiskerRight]
      rw [ModuleCat.mono_iff_injective]
      intro x y h
      apply (λ_ N).toLinearEquiv.injective
      apply hN
      change r • x = r • y at h
      have he := congrArg (λ_ N).toLinearEquiv h
      simpa only [map_smul] using he
    exact (isZero_kernel_of_mono (S.f ▷ N)).of_iso
      ((a3c_torIso _ N Q 1) ≪≫ a3c_H1IsoA Q S hS)
  | succ i =>
    have hreg : RingTheory.Sequence.IsWeaklyRegular (ModuleCat.of R R) [r] := by
      exact (RingTheory.Sequence.isWeaklyRegular_cons_iff _ _ _).mpr
        ⟨hr, .nil R _⟩
    exact a3c_isZero_tor_iterQuot N [r] (ModuleCat.of R R) 0 hreg
      (fun n hn => by
        obtain ⟨k, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : n ≠ 0)
        exact a3c_isZero_tor_self N k)
      (i + 1 + 1) (by simp)
#print axioms IntersectionProductScaf_parameter_tor_vanish

/-- Higher Tor vanishes for a principal quotient when its equation is regular on both factors. -/
theorem IntersectionProductScaf_principal_tor_vanish
    {R : Type u} [CommRing R] (N : ModuleCat.{u} R) (r : R)
    (hr : IsSMulRegular R r) (hN : IsSMulRegular N r) (i : ℕ) :
    IsZero (((Tor (ModuleCat.{u} R) (i + 1)).obj
      (ModuleCat.of R (R ⧸ Ideal.span {r}))).obj N) := by
  let e : QuotSMulTop r R ≃ₗ[R] R ⧸ Ideal.span {r} :=
    Submodule.quotEquivOfEq _ _ (by
      ext a
      simp [Submodule.mem_smul_pointwise_iff_exists, Ideal.mem_span_singleton', mul_comm])
  exact a3c_isZero_tor_of_iso e.toModuleIso N (i + 1)
    (IntersectionProductScaf_parameter_tor_vanish N r hr hN i)
#print axioms IntersectionProductScaf_principal_tor_vanish


/-- The Euler sum for a regular principal intersection is the length of its quotient. -/
theorem IntersectionProductScaf_principal_euler_length
    {R : Type u} [CommRing R] (I : Ideal R) (r : R)
    (hr : IsSMulRegular R r) (hI : IsSMulRegular (R ⧸ I) r) (m : ℕ) :
    ∑ i ∈ Finset.range (m + 1), (-1 : ℤ) ^ i *
      ((Module.length R (((Tor (ModuleCat.{u} R) i).obj
        (ModuleCat.of R (R ⧸ Ideal.span {r}))).obj (ModuleCat.of R (R ⧸ I)))).toNat : ℤ) =
      ((Module.length R (R ⧸ (Ideal.span {r} ⊔ I))).toNat : ℤ) := by
  rw [Finset.sum_range_succ']
  have hz (i : ℕ) : Module.length R (((Tor (ModuleCat.{u} R) (i + 1)).obj
      (ModuleCat.of R (R ⧸ Ideal.span {r}))).obj (ModuleCat.of R (R ⧸ I))) = 0 := by
    have h := IntersectionProductScaf_principal_tor_vanish (ModuleCat.of R (R ⧸ I)) r hr hI i
    haveI := ModuleCat.isZero_iff_subsingleton.mp h
    exact Module.length_eq_zero
  simp only [hz, ENat.toNat_zero, Nat.cast_zero, mul_zero, Finset.sum_const_zero,
    zero_add, pow_zero, one_mul, a3c_length_tor_zero]
#print axioms IntersectionProductScaf_principal_euler_length


/-- A regular local equation computes Serre multiplicity by the scheme-theoretic fibre length. -/
theorem IntersectionProductScaf_serreMult_principal
    (Y : AlgebraicGeometry.Scheme.{u}) (z v w : Y)
    (r : Y.presheaf.stalk z)
    (hv : a3i_stalkIdeal Y z v = Ideal.span {r})
    (hr : IsSMulRegular (Y.presheaf.stalk z) r)
    (hw : IsSMulRegular (Y.presheaf.stalk z ⧸ a3i_stalkIdeal Y z w) r) :
    a3i_serreMult Y z v w =
      ((Module.length (Y.presheaf.stalk z)
        (Y.presheaf.stalk z ⧸ (a3i_stalkIdeal Y z v ⊔ a3i_stalkIdeal Y z w))).toNat : ℤ) := by
  unfold a3i_serreMult a3i_torModule
  rw [hv]
  exact IntersectionProductScaf_principal_euler_length _ r hr hw _
#print axioms IntersectionProductScaf_serreMult_principal

/-- The same fibre-length formula applies with the Cartier divisor in the second argument. -/
theorem IntersectionProductScaf_serreMult_principal_right
    (Y : AlgebraicGeometry.Scheme.{u}) (z w v : Y)
    (r : Y.presheaf.stalk z)
    (hv : a3i_stalkIdeal Y z v = Ideal.span {r})
    (hr : IsSMulRegular (Y.presheaf.stalk z) r)
    (hw : IsSMulRegular (Y.presheaf.stalk z ⧸ a3i_stalkIdeal Y z w) r) :
    a3i_serreMult Y z w v =
      ((Module.length (Y.presheaf.stalk z)
        (Y.presheaf.stalk z ⧸ (a3i_stalkIdeal Y z w ⊔ a3i_stalkIdeal Y z v))).toNat : ℤ) := by
  have he : a3i_serreMult Y z w v = a3i_serreMult Y z v w := by
    unfold a3i_serreMult a3i_torModule
    apply Finset.sum_congr rfl
    intro i hi
    rw [a3c_length_tor_symm]
  rw [he, IntersectionProductScaf_serreMult_principal Y z v w r hv hr hw, sup_comm]
#print axioms IntersectionProductScaf_serreMult_principal_right

end ParameterIntersectionMultiplicity

/-- The stalk at a generic component has finite length. -/
theorem IntersectionProductScaf_generic_stalk_length_finite
    (Y : Scheme) [IsLocallyNoetherian Y] (y : Y) (hy : y ∈ genericPoints Y) :
    Module.length (Y.presheaf.stalk y) (Y.presheaf.stalk y) ≠ ⊤ := by
  have hzero : Order.coheight y = 0 := by
    rw [Order.coheight_eq_zero]
    intro z hyz
    apply specializes_iff_closure_subset.mpr
    exact hy.2 isIrreducible_singleton.closure
      (specializes_iff_closure_subset.mp hyz)
  have : Ring.KrullDimLE 0 (Y.presheaf.stalk y) := krullDimLE_of_coheight_le hzero.le
  have : IsArtinianRing (Y.presheaf.stalk y) :=
    IsNoetherianRing.isArtinianRing_of_krullDimLE_zero
  exact Module.length_ne_top
#print axioms IntersectionProductScaf_generic_stalk_length_finite



/-- Localizing the structure stalk along a specialization recovers the generalization stalk length. -/
theorem IntersectionProductScaf_locLen_stalk
    (Y : Scheme) {x z : Y} (h : z ⤳ x) :
    a3e_locLen ⟨a3i_stalkIdeal Y x z, a3q_stalkIdeal_isPrime Y h⟩
      (Y.presheaf.stalk x) =
      Module.length (Y.presheaf.stalk z) (Y.presheaf.stalk z) := by
  let :=  (Y.presheaf.stalkSpecializes h).hom.toAlgebra
  have := a3q_stalkIdeal_isPrime Y h
  have := a3q_isLocalization_stalkSpecializes Y h
  exact a3q_locLen_eq_length _ _ _
    (Algebra.linearMap (Y.presheaf.stalk x) (Y.presheaf.stalk z))
#print axioms IntersectionProductScaf_locLen_stalk

/-- The coefficient of a fundamental cycle at an embedded point is its generic local length. -/
theorem IntersectionProductScaf_fundCycle_apply_embedded
    {V W : Scheme} (i : V ⟶ W) (hi : Function.Injective i)
    (hfin : (genericPoints V).Finite) (v : V) :
    a2g_fundCycle i (i v) =
      @ite ℚ (v ∈ genericPoints V) (Classical.propDecidable _)
        ((Module.length (V.presheaf.stalk v) (V.presheaf.stalk v)).toNat : ℚ) 0 := by
  classical
  rw [IntersectionProductScaf_fundCycle_eq_sum i hfin, a3m_sum_apply]
  by_cases hv : v ∈ genericPoints V
  · rw [ite_eq_left hv, Finset.sum_eq_single v]
    · simp only [Function.locallyFinsuppWithin.single_apply, ↓reduceIte]
    · intro w hw hne
      rw [Function.locallyFinsuppWithin.single_apply, ite_eq_right]
      exact fun h => hne (hi h).symm
    · intro hn
      exact (hn (hfin.mem_toFinset.mpr hv)).elim
  · rw [ite_eq_right hv]
    apply Finset.sum_eq_zero
    intro w hw
    rw [Function.locallyFinsuppWithin.single_apply, ite_eq_right]
    intro h
    exact hv ((hi h) ▸ (hfin.mem_toFinset.mp hw))
#print axioms IntersectionProductScaf_fundCycle_apply_embedded

/-- A generic component contributes a nonzero coefficient through an injective morphism. -/
theorem IntersectionProductScaf_fundCycle_generic_ne_zero
    {V Z : Scheme} [IsLocallyNoetherian V] (i : V ⟶ Z) (hi : Function.Injective i)
    (hV : (genericPoints V).Finite) (v : V) (hv : v ∈ genericPoints V) :
    a2g_fundCycle i (i v) ≠ 0 := by
  classical
  rw [IntersectionProductScaf_fundCycle_apply_embedded i hi hV v, ite_eq_left hv]
  exact_mod_cast Nat.ne_of_gt (ENat.toNat_pos (ne_of_gt Module.length_pos)
    (IntersectionProductScaf_generic_stalk_length_finite V v hv))
#print axioms IntersectionProductScaf_fundCycle_generic_ne_zero

open scoped Pointwise in
/-- A regular local equation computes a generic fibre coefficient by minimal-prime lengths. -/
theorem IntersectionProductScaf_regularFibre_coefficient
    {F Y : Scheme} [IsLocallyNoetherian Y] (i : F ⟶ Y) [IsClosedImmersion i]
    (x : F) (hx : x ∈ genericPoints F)
    (r : Y.presheaf.stalk (i x)) (hr : IsSMulRegular (Y.presheaf.stalk (i x)) r)
    (hker : RingHom.ker (i.stalkMap x).hom = Ideal.span {r})
    (hfin : (genericPoints F).Finite) :
    a2g_fundCycle i (i x) =
      ∑ p ∈ (PrimeSpectrum.finite_setOfPred_isMin (Y.presheaf.stalk (i x))).toFinset,
        ((a3e_locLen p (Y.presheaf.stalk (i x))).toNat : ℚ) *
          ((Module.length (Y.presheaf.stalk (i x))
            (QuotSMulTop r ((Y.presheaf.stalk (i x)) ⧸ p.asIdeal))).toNat : ℚ) := by
  classical
  have : IsLocallyNoetherian F := LocallyOfFiniteType.isLocallyNoetherian i
  have hspan : Ideal.span {r} = r • (⊤ : Ideal (Y.presheaf.stalk (i x))) := by
    simp [← Submodule.ideal_span_singleton_smul]
  have hl : Module.length (Y.presheaf.stalk (i x))
      (QuotSMulTop r (Y.presheaf.stalk (i x))) =
      Module.length (F.presheaf.stalk x) (F.presheaf.stalk x) := by
    exact (Submodule.quotEquivOfEq _ _ hspan.symm).length_eq.trans
      (a3l_length_quot_ker _ (i.stalkMap_surjective x) _ hker)
  have hm : r ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk (i x)) := by
    apply IsLocalRing.le_maximalIdeal (RingHom.ker_ne_top (i.stalkMap x).hom)
    rw [hker]
    exact Ideal.subset_span (Set.mem_singleton r)
  have hlen : Module.length (Y.presheaf.stalk (i x))
      (QuotSMulTop r (Y.presheaf.stalk (i x))) ≠ ⊤ := by
    rw [hl]
    exact IntersectionProductScaf_generic_stalk_length_finite F x hx
  rw [IntersectionProductScaf_fundCycle_apply_embedded i i.isEmbedding.injective hfin x,
    ite_eq_left hx, ← hl]
  exact_mod_cast IntersectionProductScaf_parameter_length_minimalPrimes r hr hm hlen
#print axioms IntersectionProductScaf_regularFibre_coefficient



/-- An injective ambient morphism preserves all fundamental-cycle coefficients at image points. -/
theorem IntersectionProductScaf_fundCycle_comp_injective_apply
    {V Y Z : Scheme} (i : V ⟶ Y) (j : Y ⟶ Z) (hj : Function.Injective j)
    (hV : (genericPoints V).Finite) (x : Y) :
    a2g_fundCycle (i ≫ j) (j x) = a2g_fundCycle i x := by
  classical
  rw [IntersectionProductScaf_fundCycle_eq_sum _ hV,
    IntersectionProductScaf_fundCycle_eq_sum _ hV, a3m_sum_apply, a3m_sum_apply]
  apply Finset.sum_congr rfl
  intro v hv
  simp only [Function.locallyFinsuppWithin.single_apply, Scheme.Hom.comp_apply, hj.eq_iff]
#print axioms IntersectionProductScaf_fundCycle_comp_injective_apply

/-- Injective scheme morphisms reflect component generic points. -/
theorem IntersectionProductScaf_component_of_injective
    {U W : Scheme} (f : U ⟶ W) (hf : Function.Injective f) (u : U)
    (hu : f u ∈ genericPoints W) : u ∈ genericPoints U := by
  obtain ⟨C, hC, hsub⟩ := exists_mem_irreducibleComponents_subset_of_isIrreducible
    (closure ({u} : Set U)) isIrreducible_singleton.closure
  let v := hC.1.genericPoint
  have hv : closure ({v} : Set U) = C :=
    hC.1.isGenericPoint_genericPoint (isClosed_of_mem_irreducibleComponents C hC)
  have hsp : v ⤳ u := by
    apply specializes_iff_mem_closure.mpr
    rw [hv]
    exact hsub (subset_closure (Set.mem_singleton u))
  have he : v = u := hf (IntersectionProductScaf_component_generalization
    (f u) hu (f v) (hsp.map f.continuous))
  change closure ({u} : Set U) ∈ irreducibleComponents U
  rw [← he, hv]
  exact hC
#print axioms IntersectionProductScaf_component_of_injective

/-- A scheme point is a component generic point exactly when every generalization equals it. -/
theorem IntersectionProductScaf_component_iff_generalizations
    (Y : Scheme) (y : Y) :
    y ∈ genericPoints Y ↔ ∀ z : Y, z ⤳ y → z = y := by
  constructor
  · exact fun hy z hz => IntersectionProductScaf_component_generalization y hy z hz
  · intro h
    obtain ⟨C, hC, hsub⟩ := exists_mem_irreducibleComponents_subset_of_isIrreducible
      (closure ({y} : Set Y)) isIrreducible_singleton.closure
    let z := hC.1.genericPoint
    have hz : closure ({z} : Set Y) = C :=
      hC.1.isGenericPoint_genericPoint (isClosed_of_mem_irreducibleComponents C hC)
    have hzy : z ⤳ y := by
      apply specializes_iff_mem_closure.mpr
      rw [hz]
      exact hsub (subset_closure (Set.mem_singleton y))
    change closure ({y} : Set Y) ∈ irreducibleComponents Y
    rw [← h z hzy, hz]
    exact hC
#print axioms IntersectionProductScaf_component_iff_generalizations
/-- A generic component of a flat inverse image maps to a generic component of the input subscheme. -/
theorem IntersectionProductScaf_flat_comap_component_image
    {Y Z : Scheme} (f : Y ⟶ Z) [Flat f] (K : Z.IdealSheafData)
    (u : (K.comap f).subscheme) (hu : u ∈ genericPoints (K.comap f).subscheme)
    (z : K.subscheme) (hz : f ((K.comap f).subschemeι u) = K.subschemeι z) :
    z ∈ genericPoints K.subscheme := by
  apply (IntersectionProductScaf_component_iff_generalizations _ z).mpr
  intro v hv
  have hsp : K.subschemeι v ⤳ f ((K.comap f).subschemeι u) := by
    rw [hz]
    exact hv.map K.subschemeι.continuous
  obtain ⟨w, hwu, hfw⟩ := (Flat.generalizingMap f) hsp
  have hw : w ∈ (K.comap f).support := by
    rw [Scheme.IdealSheafData.support_comap]
    change f w ∈ (K.support : Set Z)
    rw [hfw, ← Scheme.IdealSheafData.range_subschemeι]
    exact ⟨v, rfl⟩
  obtain ⟨w', hw'⟩ := Set.mem_range.mp
    ((K.comap f).range_subschemeι.symm.subset hw)
  have hsp' : w' ⤳ u := by
    apply (K.comap f).subschemeι.isClosedEmbedding.isInducing.specializes_iff.mp
    simpa only [hw'] using hwu
  have he : w' = u := IntersectionProductScaf_component_generalization u hu w' hsp'
  apply K.subschemeι.isClosedEmbedding.injective
  rw [← hfw, ← hw', he, hz]
#print axioms IntersectionProductScaf_flat_comap_component_image

/-- A component in a flat inverse image is characterized by its input component and its prime-fibre component. -/
theorem IntersectionProductScaf_flat_comap_component_iff
    {Y Z : Scheme} (f : Y ⟶ Z) [Flat f] (K : Z.IdealSheafData)
    (u : (K.comap f).subscheme) (z : K.subscheme)
    (hz : f ((K.comap f).subschemeι u) = K.subschemeι z)
    (v : (ccm3_inverseIdeal f (K.subschemeι z)).subscheme)
    (hv : (ccm3_inverseIdeal f (K.subschemeι z)).subschemeι v =
      (K.comap f).subschemeι u) :
    u ∈ genericPoints (K.comap f).subscheme ↔
      z ∈ genericPoints K.subscheme ∧
        v ∈ genericPoints (ccm3_inverseIdeal f (K.subschemeι z)).subscheme := by
  constructor
  · intro hu
    refine ⟨IntersectionProductScaf_flat_comap_component_image f K u hu z hz, ?_⟩
    apply (IntersectionProductScaf_component_iff_generalizations _ v).mpr
    intro w hw
    have hfw := IntersectionProductScaf_inverseIdeal_image f (K.subschemeι z) w
    have hwK : (ccm3_inverseIdeal f (K.subschemeι z)).subschemeι w ∈
        (K.comap f).support := by
      rw [Scheme.IdealSheafData.support_comap]
      exact (closure_minimal (Set.singleton_subset_iff.mpr (by
        rw [← Scheme.IdealSheafData.range_subschemeι]
        exact ⟨z, rfl⟩)) K.support.isClosed) hfw
    obtain ⟨w', hw'⟩ := Set.mem_range.mp
      ((K.comap f).range_subschemeι.symm.subset hwK)
    have hwu : w' ⤳ u := by
      apply (K.comap f).subschemeι.isClosedEmbedding.isInducing.specializes_iff.mp
      rw [hw', ← hv]
      exact hw.map (ccm3_inverseIdeal f (K.subschemeι z)).subschemeι.continuous
    apply (ccm3_inverseIdeal f (K.subschemeι z)).subschemeι.isClosedEmbedding.injective
    rw [← hw', IntersectionProductScaf_component_generalization u hu w' hwu, hv]
  · rintro ⟨hzgen, hvgen⟩
    apply (IntersectionProductScaf_component_iff_generalizations _ u).mpr
    intro w hw
    have hfw : f ((K.comap f).subschemeι w) ∈ K.support := by
      have := (K.comap f).range_subschemeι.subset (Set.mem_range_self w)
      rwa [Scheme.IdealSheafData.support_comap] at this
    obtain ⟨z', hz'⟩ := Set.mem_range.mp (K.range_subschemeι.symm.subset hfw)
    have hzz : z' ⤳ z := by
      apply K.subschemeι.isClosedEmbedding.isInducing.specializes_iff.mp
      rw [hz', ← hz]
      exact (hw.map (K.comap f).subschemeι.continuous).map f.continuous
    have hez := IntersectionProductScaf_component_generalization z hzgen z' hzz
    have hwI : (K.comap f).subschemeι w ∈
        (ccm3_inverseIdeal f (K.subschemeι z)).support := by
      change _ ∈ ((ccm3_primeIdeal Z (K.subschemeι z)).comap f).support
      rw [Scheme.IdealSheafData.support_comap]
      change f _ ∈ ((Scheme.IdealSheafData.vanishingIdeal
        ⟨closure ({K.subschemeι z} : Set Z), isClosed_closure⟩).support : Set Z)
      rw [Scheme.IdealSheafData.coe_support_vanishingIdeal, ← hz', hez]
      exact subset_closure (Set.mem_singleton _)
    obtain ⟨w', hw'⟩ := Set.mem_range.mp
      ((ccm3_inverseIdeal f (K.subschemeι z)).range_subschemeι.symm.subset hwI)
    have hwv : w' ⤳ v := by
      apply (ccm3_inverseIdeal f (K.subschemeι z)).subschemeι.isClosedEmbedding.isInducing.specializes_iff.mp
      rw [hw', hv]
      exact hw.map (K.comap f).subschemeι.continuous
    apply (K.comap f).subschemeι.isClosedEmbedding.injective
    rw [← hw', IntersectionProductScaf_component_generalization v hvgen w' hwv, hv]
#print axioms IntersectionProductScaf_flat_comap_component_iff

/-- The local quotient by a subscheme ideal has the intrinsic subscheme stalk length. -/
theorem IntersectionProductScaf_subscheme_quotient_stalk_length
    {Z : Scheme} (K : Z.IdealSheafData) (z : K.subscheme)
    (U : Z.affineOpens) (hz : K.subschemeι z ∈ U.1) :
    Module.length (Z.presheaf.stalk (K.subschemeι z))
      (Z.presheaf.stalk (K.subschemeι z) ⧸
        (K.ideal U).map (Z.presheaf.germ U.1 (K.subschemeι z) hz).hom) =
      Module.length (K.subscheme.presheaf.stalk z) (K.subscheme.presheaf.stalk z) := by
  rw [← a3l_ker_stalkMap_subschemeι K z U hz]
  exact a3l_length_quot_ker (K.subschemeι.stalkMap z).hom
    (K.subschemeι.stalkMap_surjective z) _ rfl
#print axioms IntersectionProductScaf_subscheme_quotient_stalk_length

