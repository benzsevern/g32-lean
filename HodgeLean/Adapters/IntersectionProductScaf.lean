/-- Translation endpoint equations are regular on the open square inverse image. -/
theorem IntersectionProductScaf_squareOpen_translation_regular_equation
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom]
    {n : ℕ} {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (hn : height (genericPoint X.left) = n)
    (M : Fin (n + 1) × Fin (n + 1) → ℂ)
    (z : (a3n_T (a3h_PnO n)).left) (c : ℂ) (hc : c = 0 ∨ c = 1) :
    let I := ccm3_inverseIdeal (IntersectionProductScaf_familyMap₁ X hfin M).left z
    let K := (a3n_σ (a3n_T X) c).ker.comap
      (IntersectionProductScaf_familyInclusion (a3n_T X) M).left
    ∀ x : (K.comap I.subschemeι).subscheme,
      ∃ r : I.subscheme.presheaf.stalk ((K.comap I.subschemeι).subschemeι x),
        IsSMulRegular (I.subscheme.presheaf.stalk ((K.comap I.subschemeι).subschemeι x)) r ∧
        RingHom.ker ((K.comap I.subschemeι).subschemeι.stalkMap x).hom = Ideal.span {r} := by
  have := IntersectionProductScaf_projectionTarget_integral X hfin hn
  have : Smooth (a3h_PnO n).hom := IntersectionProductScaf_projective_smooth n
  have : IsProjective (a3h_PnO n).hom :=
    ⟨⟨{ ambientDimension := n, immersion := 𝟙 _, immersion_toBase := Category.id_comp _ }⟩⟩
  have := IntersectionProductScaf_projection_flat X hfin hn
  have := IntersectionProductScaf_retainedSquareMap_flat X hfin M
  let Y := a3n_T (a3h_PnO n)
  let P := ccm3_primeIdeal (a3n_T Y).left (a3n_b Y z)
  let f := (IntersectionProductScaf_retainedSquareMap X hfin M).left ≫
    (IntersectionProductScaf_familyInclusion Y M).left
  have : Flat f := inferInstance
  have he : f ≫ (a3n_q Y).left = (IntersectionProductScaf_familyMap₁ X hfin M).left := by
    dsimp only [f]
    rw [Category.assoc, IntersectionProductScaf_familyInclusion_base_projection]
    exact congrArg Over.Hom.left (IntersectionProductScaf_retainedSquareMap_base X hfin M)
  have hI : P.comap f = ccm3_inverseIdeal
      (IntersectionProductScaf_familyMap₁ X hfin M).left z := by
    dsimp only [P]
    rw [← IntersectionProductScaf_cylinder_primeIdeal Y z,
      ← Scheme.IdealSheafData.comap_comp, he]
    rfl
  have hK : (a3n_σ Y c).ker.comap f = (a3n_σ (a3n_T X) c).ker.comap
      (IntersectionProductScaf_familyInclusion (a3n_T X) M).left :=
    IntersectionProductScaf_parameter_section_ker Y (a3n_T X) f _
      (IntersectionProductScaf_retainedSquareMap_included_parameter X hfin M) c
  dsimp only
  rw [← hI, ← hK]
  let g := (P.comap f).subschemeMap P f (P.le_map_comap f)
  have : Flat g := IntersectionProductScaf_comap_subschemeMap_flat f P
  have H := IntersectionProductScaf_flat_comap_regular_equation g
    ((a3n_σ Y c).ker.comap P.subschemeι)
    (IntersectionProductScaf_primeInput_regular_equation Y c hc (a3n_b Y z) (a3k_h_b Y z))
  have hg : g ≫ P.subschemeι = (P.comap f).subschemeι ≫ f :=
    Scheme.IdealSheafData.subschemeMap_subschemeι _ _ _ _
  have hJ : ((a3n_σ Y c).ker.comap P.subschemeι).comap g =
      ((a3n_σ Y c).ker.comap f).comap (P.comap f).subschemeι := by
    calc
      _ = (a3n_σ Y c).ker.comap (g ≫ P.subschemeι) :=
        (Scheme.IdealSheafData.comap_comp _ _ _).symm
      _ = (a3n_σ Y c).ker.comap ((P.comap f).subschemeι ≫ f) := congrArg _ hg
      _ = _ := Scheme.IdealSheafData.comap_comp _ _ _
  rw [hJ] at H
  exact H
