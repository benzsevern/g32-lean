/-- The intrinsic original section ideal is principal at every section point. -/
theorem IntersectionProductScaf_originalSection_principal
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom]
    (c : ℂ) (z : (a3k_ι X c).ker.subscheme) :
    ∃ r : (a3n_T (a3n_T X)).left.presheaf.stalk ((a3k_ι X c).ker.subschemeι z),
      RingHom.ker ((a3k_ι X c).ker.subschemeι.stalkMap z).hom = Ideal.span {r} := by
  let := IntersectionProductScaf_originalSection_isClosedImmersion X c
  let Y := (a3n_T (a3n_T X)).left
  let K := (a3k_ι X c).ker
  let y := K.subschemeι z
  have hy : y ∈ ((a3k_ι X c).ker.support : Set Y) := z.property
  rw [Scheme.Hom.support_ker, (a3k_ι X c).isClosedEmbedding.isClosed_range.closure_eq] at hy
  obtain ⟨w, hw⟩ := hy
  have hh := IntersectionProductScaf_originalDivisor_equation X c w
  rw [hw] at hh
  obtain ⟨r, -, -, hr⟩ := hh
  refine ⟨r, ?_⟩
  obtain ⟨_, ⟨U, hU, rfl⟩, hyU, -⟩ := Y.isBasis_affineOpens.exists_subset_of_mem_open
    (Set.mem_univ y) isOpen_univ
  have hK : K = ccm3_primeIdeal Y (a3k_E X c) := by
    rw [IntersectionProductScaf_originalDivisor_generic]
    exact a2g_ker_eq_primeIdeal (a3k_ι X c)
  rw [a3l_ker_stalkMap_subschemeι K z ⟨U, hU⟩ hyU]
  change (K.ideal ⟨U, hU⟩).map (Y.presheaf.germ U y hyU).hom = Ideal.span {r}
  rw [hK]
  rw [a3l_map_primeIdeal_eq_stalkIdeal (U := ⟨U, hU⟩), hr]
  rw [IntersectionProductScaf_originalDivisor_generic, ← hw]
  exact (genericPoint_specializes w).map (a3k_ι X c).continuous
#print axioms IntersectionProductScaf_originalSection_principal

/-- The local equation of an original endpoint avoids any prime dominating that parameter. -/
theorem IntersectionProductScaf_originalDivisor_equation_not_mem
    (c : ℂ) (hc : c = 0 ∨ c = 1) (x : (a3n_T X).left)
    (w : (a3n_T (a3n_T X)).left) (hw : w ⤳ a3k_ι X c x)
    (hdom : a3n_h X ((a3n_q (a3n_T X)).left w) = genericPoint (g3c_P 1))
    (r : (a3n_T (a3n_T X)).left.presheaf.stalk (a3k_ι X c x))
    (hr : a3i_stalkIdeal (a3n_T (a3n_T X)).left (a3k_ι X c x) (a3k_E X c) = Ideal.span {r}) :
    r ∉ a3i_stalkIdeal (a3n_T (a3n_T X)).left (a3k_ι X c x) w := by
  intro hmem
  have hE : a3k_E X c ⤳ a3k_ι X c x := by
    rw [IntersectionProductScaf_originalDivisor_generic]
    exact (genericPoint_specializes x).map (a3k_ι X c).continuous
  have hle : a3i_stalkIdeal (a3n_T (a3n_T X)).left (a3k_ι X c x) (a3k_E X c) ≤
      a3i_stalkIdeal (a3n_T (a3n_T X)).left (a3k_ι X c x) w := by
    rw [hr, Ideal.span_le, Set.singleton_subset_iff]
    exact hmem
  have hEw := (a3y_pt_le_iff (a3k_ι X c x) (a3k_E X c) w hE hw).mp hle
  rw [a3n_b_specializes_iff] at hEw
  exact a3k_not_mem_range_σ X hdom c hc (a3n_mem_range_σ_of_specializes X c hEw)
#print axioms IntersectionProductScaf_originalDivisor_equation_not_mem

/-- A component dominating the original parameter has the fibre-length Serre multiplicity. -/
theorem IntersectionProductScaf_originalDivisor_serreMult
    (c : ℂ) (hc : c = 0 ∨ c = 1) (x : (a3n_T X).left)
    (w : (a3n_T (a3n_T X)).left) (hw : w ⤳ a3k_ι X c x)
    (hdom : a3n_h X ((a3n_q (a3n_T X)).left w) = genericPoint (g3c_P 1)) :
    a3i_serreMult (a3n_T (a3n_T X)).left (a3k_ι X c x) w (a3k_E X c) =
      ((Module.length ((a3n_T (a3n_T X)).left.presheaf.stalk (a3k_ι X c x))
        (((a3n_T (a3n_T X)).left.presheaf.stalk (a3k_ι X c x)) ⧸
          (a3i_stalkIdeal (a3n_T (a3n_T X)).left (a3k_ι X c x) w ⊔
            a3i_stalkIdeal (a3n_T (a3n_T X)).left (a3k_ι X c x) (a3k_E X c)))).toNat : ℤ) := by
  obtain ⟨r, -, hreg, he⟩ := IntersectionProductScaf_originalDivisor_equation X c x
  have hp := a3q_stalkIdeal_isPrime (a3n_T (a3n_T X)).left hw
  have hnot := IntersectionProductScaf_originalDivisor_equation_not_mem X c hc x w hw hdom r he
  exact IntersectionProductScaf_serreMult_principal_right _ _ w _ r he hreg
    (IntersectionProductScaf_primeQuotient_regular _ r hnot)
#print axioms IntersectionProductScaf_originalDivisor_serreMult

/-- At an original-face component, the prime intersection coefficient is its local fibre length. -/
theorem IntersectionProductScaf_originalDivisor_intersectPrime
    (c : ℂ) (hc : c = 0 ∨ c = 1) (x : (a3n_T X).left)
    (w : (a3n_T (a3n_T X)).left)
    (hx : a3k_ι X c x ∈ a3y_comps w (a3k_E X c))
    (hdom : a3n_h X ((a3n_q (a3n_T X)).left w) = genericPoint (g3c_P 1)) :
    a3i_intersectPrime (a3n_T (a3n_T X)).left w (a3k_E X c) (a3k_ι X c x) =
      ((Module.length ((a3n_T (a3n_T X)).left.presheaf.stalk (a3k_ι X c x))
        (((a3n_T (a3n_T X)).left.presheaf.stalk (a3k_ι X c x)) ⧸
          (a3i_stalkIdeal (a3n_T (a3n_T X)).left (a3k_ι X c x) w ⊔
            a3i_stalkIdeal (a3n_T (a3n_T X)).left (a3k_ι X c x) (a3k_E X c)))).toNat : ℚ) := by
  rw [a3y_intersectPrime_apply]
  erw [ite_eq_left hx,
    IntersectionProductScaf_originalDivisor_serreMult X c hc x w
      (a3y_comps_spec _ _ hx).1 hdom]
  norm_cast
#print axioms IntersectionProductScaf_originalDivisor_intersectPrime

