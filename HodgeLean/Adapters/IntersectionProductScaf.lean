#print axioms IntersectionProductScaf_translatedLocalizedCylinder_parameter_comap

open MvPolynomial in
/-- The explicit translation equations become the polynomial matrix substitution after exchanging coordinates. -/
theorem IntersectionProductScaf_substLine_exchange [Fintype τ] (M : σ × σ → ℂ)
    (F : MvPolynomial (σ ⊕ τ) ℂ) :
    a3m_eq (σ ⊕ τ) (a3h_substLine M F) =
      IntersectionProductScaf_relativeSubst (IntersectionProductScaf_lineMatrix M)
        (MvPolynomial.map Polynomial.C F) := by
  have hX (i : σ ⊕ τ) :
      a3m_eq (σ ⊕ τ) (a3h_substLine M (X i)) =
        IntersectionProductScaf_relativeSubst (IntersectionProductScaf_lineMatrix M)
          (MvPolynomial.map Polynomial.C (X i)) := by
    rcases i with i | t
    · simp only [a3h_substLine_inl, a3m_eq_C, a3m_eq_X,
        IntersectionProductScaf_relativeSubst, IntersectionProductScaf_lineMatrix,
        map_sum, map_add, map_sub, map_mul, map_one, MvPolynomial.map_X,
        MvPolynomial.map_C,
        MvPolynomial.aeval_X, Sum.elim_inl, Finset.mul_sum]
      simp only [add_mul, Finset.sum_add_distrib, mul_assoc]
      simp [apply_ite, ite_mul, mul_comm, mul_left_comm]
    · simp [a3h_substLine_inr, a3m_eq_C, IntersectionProductScaf_relativeSubst]
  induction F using MvPolynomial.induction_on with
  | C c => simp [a3h_substLine, a3m_eq_C, IntersectionProductScaf_relativeSubst]
  | add F G hF hG => simpa only [map_add] using congrArg₂ (· + ·) hF hG
  | mul_X F i hF => simpa only [map_mul] using congrArg₂ (· * ·) hF (hX i)

#print axioms IntersectionProductScaf_substLine_exchange

attribute [local instance] MvPolynomial.algebraMvPolynomial in
/-- The coordinate exchange evaluates every polynomial through the coefficient localization. -/
theorem IntersectionProductScaf_linePolynomialEquiv_apply [Fintype τ] (M : σ × σ → ℂ)
    (p : Polynomial (MvPolynomial (σ ⊕ τ) ℂ)) :
    IntersectionProductScaf_linePolynomialEquiv (τ := τ) M (algebraMap _ _ p) =
      MvPolynomial.map (algebraMap (Polynomial ℂ) (IntersectionProductScaf_lineRing M))
        (a3m_eq (σ ⊕ τ) p) := by
  rw [IntersectionProductScaf_linePolynomialEquiv, IsLocalization.ringEquivOfRingEquiv_eq]
  rfl

/-- On constant-in-parameter equations the localized automorphism is the explicit inverse translation. -/
theorem IntersectionProductScaf_localizedTranslation_C [Fintype τ] (M : σ × σ → ℂ)
    (F : MvPolynomial (σ ⊕ τ) ℂ) :
    IntersectionProductScaf_localizedTranslation (τ := τ) M
      (algebraMap _ _ (Polynomial.C F)) =
      algebraMap _ _ (a3h_substLine M F) := by
  apply (IntersectionProductScaf_linePolynomialEquiv M).injective
  simp only [IntersectionProductScaf_localizedTranslation, RingEquiv.trans_apply,
    RingEquiv.apply_symm_apply, IntersectionProductScaf_linePolynomialEquiv_apply,
    a3m_eq_C, IntersectionProductScaf_substLine_exchange]
  exact (congrArg (fun f : MvPolynomial (σ ⊕ τ) (Polynomial ℂ) →+*
      MvPolynomial (σ ⊕ τ) (IntersectionProductScaf_lineRing M) =>
      f (MvPolynomial.map Polynomial.C F))
    (IntersectionProductScaf_relativeSubst_map
      (algebraMap (Polynomial ℂ) (IntersectionProductScaf_lineRing M))
      (IntersectionProductScaf_lineMatrix M))).symm

#print axioms IntersectionProductScaf_linePolynomialEquiv_apply
#print axioms IntersectionProductScaf_localizedTranslation_C

end InvertibleTranslationLocus

section MatrixSections

open MvPolynomial

attribute [local instance] MvPolynomial.gradedAlgebra
variable {σ R B : Type} [Fintype σ] [DecidableEq σ] [CommRing R] [CommRing B]

theorem IntersectionProductScaf_irrelevant_span :
    (HomogeneousIdeal.irrelevant (homogeneousSubmodule σ R)).toIdeal =
      Ideal.span (Set.range (MvPolynomial.X : σ → MvPolynomial σ R)) := by
  apply le_antisymm
  · apply (HomogeneousIdeal.toIdeal_irrelevant_le _).mpr
    intro d hd p hp
    change p ∈ Ideal.span (Set.range (MvPolynomial.X : σ → MvPolynomial σ R))
    rw [← Set.image_univ, mem_ideal_span_X_image]
    intro m hm
    by_contra h
    push Not at h
    have hm0 : m = 0 := Finsupp.ext fun i => h i trivial
    have he := hp (mem_support_iff.mp hm)
    rw [hm0] at he
    simp [Finsupp.weight_apply] at he
    omega
  · apply Ideal.span_le.mpr
    rintro _ ⟨i, rfl⟩
    exact HomogeneousIdeal.mem_irrelevant_of_mem _ zero_lt_one (isHomogeneous_X R i)

/-- Invertible changes of a vector preserve the ideal generated by its entries. -/
theorem IntersectionProductScaf_span_mulVec (A : Matrix σ σ R) (hA : IsUnit A.det)
    (v : σ → R) :
    Ideal.span (Set.range (A.mulVec v)) = Ideal.span (Set.range v) := by
  have hle (C : Matrix σ σ R) (w : σ → R) :
      Ideal.span (Set.range (C.mulVec w)) ≤ Ideal.span (Set.range w) := by
    apply Ideal.span_le.mpr
    rintro _ ⟨i, rfl⟩
    exact Ideal.sum_mem _ fun j _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨j, rfl⟩)
  apply le_antisymm (hle A v)
  have h := hle A⁻¹ (A.mulVec v)
  rwa [Matrix.mulVec_mulVec, Matrix.nonsing_inv_mul A hA, Matrix.one_mulVec] at h

/-- Linear change of homogeneous sections with coefficients in their target ring. -/
def IntersectionProductScaf_matrixSections (A : Matrix σ σ B)
    (f : MvPolynomial σ R →+* B) : MvPolynomial σ R →+* B :=
  eval₂Hom (f.comp C) (A.mulVec (fun i => f (MvPolynomial.X i)))

/-- An invertible change preserves the ideal generated by homogeneous sections. -/
theorem IntersectionProductScaf_matrixSections_irrelevant (A : Matrix σ σ B)
    (hA : IsUnit A.det) (f : MvPolynomial σ R →+* B) :
    (HomogeneousIdeal.irrelevant (homogeneousSubmodule σ R)).toIdeal.map
        (IntersectionProductScaf_matrixSections A f) =
      (HomogeneousIdeal.irrelevant (homogeneousSubmodule σ R)).toIdeal.map f := by
  rw [IntersectionProductScaf_irrelevant_span, Ideal.map_span, Ideal.map_span]
  simp only [← Set.range_comp, Function.comp_def, IntersectionProductScaf_matrixSections,
    coe_eval₂Hom, eval₂_X]
  exact IntersectionProductScaf_span_mulVec A hA _

/-- Restriction of sections commutes with the matrix operation. -/
theorem IntersectionProductScaf_matrixSections_map {D : Type} [CommRing D]
    (g : B →+* D) (A : Matrix σ σ B) (f : MvPolynomial σ R →+* B) :
    g.comp (IntersectionProductScaf_matrixSections A f) =
      IntersectionProductScaf_matrixSections (g.mapMatrix A) (g.comp f) := by
  apply MvPolynomial.ringHom_ext
  · intro r
    simp [IntersectionProductScaf_matrixSections]
  · intro i
    simp [IntersectionProductScaf_matrixSections, Matrix.mulVec, dotProduct, map_sum]

/-- A common unit twist of coordinates survives any matrix operation. -/
theorem IntersectionProductScaf_matrixSections_twist (A : Matrix σ σ B)
    (f g : MvPolynomial σ R →+* B) (u : B)
    (hC : ∀ r, f (C r) = g (C r))
    (hX : ∀ i, f (MvPolynomial.X i) = u * g (MvPolynomial.X i))
    (p : MvPolynomial σ R) (d : ℕ) (hp : p.IsHomogeneous d) :
    IntersectionProductScaf_matrixSections A f p =
      u ^ d * IntersectionProductScaf_matrixSections A g p := by
  apply a3m_twist _ _ u _ _ p d hp
  · intro r
    simpa only [IntersectionProductScaf_matrixSections, coe_eval₂Hom, eval₂_C,
      RingHom.comp_apply] using hC r
  · intro i
    simp only [IntersectionProductScaf_matrixSections, coe_eval₂Hom, eval₂_X,
      Matrix.mulVec, dotProduct, hX, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro j _
    ring

