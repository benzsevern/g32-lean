/-- Flat pullback preserves regular principal equations of subschemes. -/
theorem IntersectionProductScaf_flat_comap_regular_equation
    {Y Z : Scheme} (f : Y ⟶ Z) [Flat f] (K : Z.IdealSheafData)
    (hreg : ∀ z : K.subscheme, ∃ r : Z.presheaf.stalk (K.subschemeι z),
      IsSMulRegular (Z.presheaf.stalk (K.subschemeι z)) r ∧
      RingHom.ker (K.subschemeι.stalkMap z).hom = Ideal.span {r})
    (x : (K.comap f).subscheme) :
    ∃ r : Y.presheaf.stalk ((K.comap f).subschemeι x),
      IsSMulRegular (Y.presheaf.stalk ((K.comap f).subschemeι x)) r ∧
      RingHom.ker ((K.comap f).subschemeι.stalkMap x).hom = Ideal.span {r} := by
  let y := (K.comap f).subschemeι x
  have hy : f y ∈ (K.support : Set Z) := by
    have hx := x.property
    change y ∈ ((K.comap f).support : Set Y) at hx
    rw [Scheme.IdealSheafData.support_comap] at hx
    exact hx
  let z : K.subscheme := ⟨f y, hy⟩
  have hh := hreg z
  change ∃ r : Z.presheaf.stalk (f y), IsSMulRegular (Z.presheaf.stalk (f y)) r ∧
    RingHom.ker (K.subschemeι.stalkMap z).hom = Ideal.span {r} at hh
  obtain ⟨r, hr, he⟩ := hh
  refine ⟨f.stalkMap y r, IntersectionProductScaf_flat_stalk_regular f y r hr, ?_⟩
  obtain ⟨_, ⟨U, hU, rfl⟩, hzU, -⟩ := Z.isBasis_affineOpens.exists_subset_of_mem_open
    (Set.mem_univ (f y)) isOpen_univ
  have hk := a3l_ker_stalkMap_subschemeι K z ⟨U, hU⟩ hzU
  rw [he] at hk
  change Ideal.span {r} = (K.ideal ⟨U, hU⟩).map
    (Z.presheaf.germ U (f y) hzU).hom at hk
  rw [IntersectionProductScaf_comap_stalk_kernel f K x ⟨U, hU⟩ hzU,
    ← hk, Ideal.map_span, Set.image_singleton]
