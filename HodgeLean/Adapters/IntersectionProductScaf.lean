  have e1 : a3k_cycT X (a3n_σ X 1 (genericPoint X.left)) =
      ((cycleComponent (a3n_T X).left _).ord (a3o_φ X _ (a3k_hη X)) D : ℚ) := by
    rw [← hD]
    exact a3y_principalCycle_apply _ _ _ (a3o_φ_ne_zero X _ (a3k_hη X)) D
  have h0 : a3n_h X (cycleComponentι (a3n_T X).left _ D) ∈
      Proj.basicOpen (UniversalGrading.{0} 1) (MvPolynomial.X 0) := by
    rw [hD]
    exact a3k_mem_basicOpen_σ X _ 1 (Or.inr rfl)
  let r := a3k_t1 X (cycleComponentι (a3n_T X).left _ D) h0
  have hlocal : ∀ (τ : (a3n_T X).left)
      (hτ : a3n_h X τ ∈ Proj.basicOpen (UniversalGrading.{0} 1) (MvPolynomial.X 0)),
      τ = a3n_σ X 1 (genericPoint X.left) →
      IsLocalRing.maximalIdeal _ = Ideal.span {a3k_t1 X τ hτ - 1} ∧
      a3k_t1 X τ hτ - 1 ≠ 0 ∧ a3k_t1 X τ hτ - 1 ∈ IsLocalRing.maximalIdeal _ := by
    intro τ hτ hEq
    subst τ
    have he := IntersectionProductScaf_section_one_coordinate_equation X (genericPoint X.left)
    refine ⟨?_, IntersectionProductScaf_section_generator_ne_zero X 1 _ _ he,
      a3k_t1_σ1 X _ hτ⟩
    rwa [a3c_stalkIdeal_self] at he
  obtain ⟨he, hr, hm⟩ := hlocal _ h0 hD
  have hu : IsUnit r := by
    have h : 1 - r ∈ nonunits _ := by
      apply (IsLocalRing.mem_maximalIdeal _).mp
      simpa only [neg_sub] using
        (IsLocalRing.maximalIdeal ((a3n_T X).left.presheaf.stalk
          (cycleComponentι (a3n_T X).left _ D))).neg_mem hm
    exact IsLocalRing.isUnit_of_mem_nonunits_one_sub_self r h
  let g := ((cycleComponentι (a3n_T X).left (genericPoint (a3n_T X).left)).stalkMap D).hom
  let F := algebraMap ((cycleComponent (a3n_T X).left (genericPoint (a3n_T X).left)).presheaf.stalk D)
    (cycleComponent (a3n_T X).left (genericPoint (a3n_T X).left)).functionField
  have ho := IntersectionProductScaf_generic_component_generator_order
    (a3n_T X).left D hD1 (r - 1) hr he
  simp only [map_sub, map_one] at ho
  change (cycleComponent (a3n_T X).left _).ord (F (g r) - 1) D = 1 at ho
  have hd : (cycleComponent (a3n_T X).left _).ord (F (g r)) D = 0 :=
    a3m_ord_algebraMap_of_isUnit D (g r) (hu.map g)
  have hden : F (g r) - 1 ≠ 0 := by
    intro hz
    simp only [hz, Scheme.ord_zero, Pi.zero_apply] at ho
    norm_num at ho
  have hφ := IntersectionProductScaf_parameter_pullback_expression
    (cycleComponentι (a3n_T X).left _ ≫ a3n_h X)
    (a3o_hgen X _ (a3k_hη X)) D h0
  have hs := congrArg (fun f => f ((g3c_P 1).presheaf.germ _
    (a3n_h X (cycleComponentι (a3n_T X).left _ D)) h0 a3k_S1))
    (Scheme.Hom.stalkMap_comp (cycleComponentι (a3n_T X).left _) (a3n_h X) D)
  simp only [Scheme.Hom.comp_apply] at hφ
  erw [hs] at hφ
  change a3o_φ X _ (a3k_hη X) = F (g r) / (F (g r) - 1) at hφ
  have hn : F (g r) ≠ 0 := by
    intro hz
    exact a3o_φ_ne_zero X _ (a3k_hη X) (by rw [hφ, hz, zero_div])
  rw [e1, hφ, IntersectionProductScaf_order_div D hn hden, hd, ho]
  norm_num
#print axioms IntersectionProductScaf_parameter_one_weight
end ParameterCoordinateRatio

/-- Parameter-preserving maps pull back the same endpoint section ideal. -/
theorem IntersectionProductScaf_parameter_section_ker
    (Y Z : Over (Spec ↧ℂ)) {U : Scheme.{0}}
    (f : U ⟶ (a3n_T Y).left) (g : U ⟶ (a3n_T Z).left)
    (h : f ≫ a3n_p Y = g ≫ a3n_p Z) (c : ℂ) :
    (a3n_σ Y c).ker.comap f = (a3n_σ Z c).ker.comap g := by
  have : IsClosedImmersion (a3n_pt c ≫ a3n_P1.hom) := by
    change IsClosedImmersion (a3n_pt c ≫
      ProjectiveSpace.toBase (Fin 2) (Spec ↧ℂ))
    rw [a3n_pt_toBase]
    infer_instance
  have : IsClosedImmersion (a3n_pt c) := IsClosedImmersion.of_comp _ a3n_P1.hom
  have hk (W : Over (Spec ↧ℂ)) :
      (a3n_σ W c).ker = (a3n_pt c).ker.comap (a3n_p W) := by
    rw [← (a3n_isPullback W c).isoPullback_hom_fst,
      Scheme.Hom.ker_comp_of_isIso, Scheme.IdealSheafData.ker_fst_of_isClosedImmersion]
  rw [hk Y, hk Z, ← Scheme.IdealSheafData.comap_comp,
    ← Scheme.IdealSheafData.comap_comp, h]
#print axioms IntersectionProductScaf_parameter_section_ker
/-- A dominating prime meets every endpoint section in codimension one. -/
theorem IntersectionProductScaf_section_component_coheight
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom]
    (w : (a3n_T X).left) (hw : a3n_h X w = genericPoint (g3c_P 1))
    (c : ℂ) (hc : c = 0 ∨ c = 1) {z : (a3n_T X).left}
    (hz : z ∈ a3y_comps w (a3n_σ X c (genericPoint X.left))) :
    coheight z = coheight w + 1 := by
  obtain ⟨hwz, hEz, -⟩ := a3y_comps_spec _ _ hz
  have hr := a3n_mem_range_σ_of_specializes X c hEz
  have hne : w ≠ z := by
    rintro rfl
    exact a3k_not_mem_range_σ X hw c hc hr
  refine le_antisymm ?_ (Order.add_one_le_of_lt (a3y_coheight_lt hwz hne))
  have h := a3k_coheight_comps_le X hz
  rwa [a3k_coheight_σ_generic] at h
#print axioms IntersectionProductScaf_section_component_coheight


/-- The parameter section ideal is principal at every section point. -/
theorem IntersectionProductScaf_section_principal
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom]
    (c : ℂ) (z : (a3n_σ X c).ker.subscheme) :
    ∃ r : (a3n_T X).left.presheaf.stalk ((a3n_σ X c).ker.subschemeι z),
      RingHom.ker ((a3n_σ X c).ker.subschemeι.stalkMap z).hom = Ideal.span {r} := by
  have : IsClosedImmersion (a3n_σ X c ≫ (a3n_q X).left) := by
    rw [a3n_σ_q]
    infer_instance
  have : IsClosedImmersion (a3n_σ X c) := IsClosedImmersion.of_comp _ (a3n_q X).left
  let Y := (a3n_T X).left
  let K := (a3n_σ X c).ker
  let y := K.subschemeι z
  have hy : y ∈ ((a3n_σ X c).ker.support : Set Y) := z.property
  rw [Scheme.Hom.support_ker, (a3n_σ X c).isClosedEmbedding.isClosed_range.closure_eq] at hy
  obtain ⟨w, hw⟩ := hy
  have hh := IntersectionProductScaf_sectionDivisor_equation X c w
  rw [hw] at hh
  obtain ⟨r, -, -, hr⟩ := hh
  refine ⟨r, ?_⟩
  obtain ⟨_, ⟨U, hU, rfl⟩, hyU, -⟩ := Y.isBasis_affineOpens.exists_subset_of_mem_open
    (Set.mem_univ y) isOpen_univ
  have hK : K = ccm3_primeIdeal Y (a3n_σ X c (genericPoint X.left)) := by
    exact a2g_ker_eq_primeIdeal (a3n_σ X c)
  rw [a3l_ker_stalkMap_subschemeι K z ⟨U, hU⟩ hyU]
  change (K.ideal ⟨U, hU⟩).map (Y.presheaf.germ U y hyU).hom = Ideal.span {r}
  rw [hK]
  rw [a3l_map_primeIdeal_eq_stalkIdeal (U := ⟨U, hU⟩), hr]
  rw [← hw]
  exact (genericPoint_specializes w).map (a3n_σ X c).continuous
#print axioms IntersectionProductScaf_section_principal

/-- A parameter section equation avoids every prime dominating the parameter. -/
theorem IntersectionProductScaf_sectionDivisor_equation_not_mem
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom]
    (c : ℂ) (hc : c = 0 ∨ c = 1) (w z : (a3n_T X).left)
    (hw : w ⤳ z) (hE : a3n_σ X c (genericPoint X.left) ⤳ z)
    (hdom : a3n_h X w = genericPoint (g3c_P 1))
    (r : (a3n_T X).left.presheaf.stalk z)
    (hr : a3i_stalkIdeal (a3n_T X).left z
      (a3n_σ X c (genericPoint X.left)) = Ideal.span {r}) :
    r ∉ a3i_stalkIdeal (a3n_T X).left z w := by
  intro hmem
  have hle : a3i_stalkIdeal (a3n_T X).left z (a3n_σ X c (genericPoint X.left)) ≤
      a3i_stalkIdeal (a3n_T X).left z w := by
    rw [hr, Ideal.span_le, Set.singleton_subset_iff]
    exact hmem
  have hsp := (a3y_pt_le_iff z (a3n_σ X c (genericPoint X.left)) w hE hw).mp hle
  exact a3k_not_mem_range_σ X hdom c hc (a3n_mem_range_σ_of_specializes X c hsp)
#print axioms IntersectionProductScaf_sectionDivisor_equation_not_mem

/-- A dominating integral prime family has regular parameter equations at all points of an endpoint. -/
theorem IntersectionProductScaf_section_prime_stalk_equation
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom]
    (c : ℂ) (hc : c = 0 ∨ c = 1) (w : (a3n_T X).left)
    (hdom : a3n_h X w = genericPoint (g3c_P 1))
    (x : cycleComponent (a3n_T X).left w)
    (hE : a3n_σ X c (genericPoint X.left) ⤳ cycleComponentι (a3n_T X).left w x) :
    ∃ r : (a3n_T X).left.presheaf.stalk (cycleComponentι (a3n_T X).left w x),
      a3i_stalkIdeal (a3n_T X).left (cycleComponentι (a3n_T X).left w x)
        (a3n_σ X c (genericPoint X.left)) = Ideal.span {r} ∧
      IsSMulRegular ((cycleComponent (a3n_T X).left w).presheaf.stalk x)
        ((cycleComponentι (a3n_T X).left w).stalkMap x r) := by
  have hex : ∃ r : (a3n_T X).left.presheaf.stalk (cycleComponentι (a3n_T X).left w x),
      r ∈ IsLocalRing.maximalIdeal _ ∧
      IsSMulRegular ((a3n_T X).left.presheaf.stalk (cycleComponentι (a3n_T X).left w x)) r ∧
      a3i_stalkIdeal (a3n_T X).left (cycleComponentι (a3n_T X).left w x)
        (a3n_σ X c (genericPoint X.left)) = Ideal.span {r} := by
    obtain ⟨z, hz⟩ := a3n_mem_range_σ_of_specializes X c hE
    rw [← hz]
    exact IntersectionProductScaf_sectionDivisor_equation X c z
  obtain ⟨r, -, -, hr⟩ := hex
  have hnot := IntersectionProductScaf_sectionDivisor_equation_not_mem X c hc w _
    (a3z_specializes_pt w x) hE hdom r hr
  refine ⟨r, hr, ?_⟩
  have hn : (cycleComponentι (a3n_T X).left w).stalkMap x r ≠ 0 := by
    intro hz
    apply hnot
    rw [← a3y_ker_stalkMap]
    exact hz
  exact fun a b hab => mul_left_cancel₀ hn hab
#print axioms IntersectionProductScaf_section_prime_stalk_equation

/-- An original endpoint equation remains regular on the open square inverse image of a dominating prime. -/
theorem IntersectionProductScaf_originalOpen_regular_parameter_of_projection
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom]
    {n : ℕ} {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    [Flat (a3h_πO X hfin).left]
    (hn : height (genericPoint X.left) = n)
    (M : Fin (n + 1) × Fin (n + 1) → ℂ)
    (y : (a3n_T X).left) (hy : a3n_h X y = genericPoint (g3c_P 1))
    (c : ℂ) (hc : c = 0 ∨ c = 1) :
    letI := IntersectionProductScaf_projectionTarget_integral X hfin hn
    let P := ccm3_primeIdeal (a3n_T (a3h_PnO n)).left ((a3h_G (a3h_πO X hfin)).left y)
    let f := (IntersectionProductScaf_familyMap₁ X hfin M).left
    let g := Scheme.IdealSheafData.subschemeMap (P.comap f) P f (P.le_map_comap f)
    ∀ x : (P.comap f).subscheme,
      a3n_σ (a3h_PnO n) c (genericPoint (a3h_PnO n).left) ⤳ P.subschemeι (g x) →
      ∃ r : (a3n_T (a3h_PnO n)).left.presheaf.stalk (P.subschemeι (g x)),
        a3i_stalkIdeal (a3n_T (a3h_PnO n)).left (P.subschemeι (g x))
          (a3n_σ (a3h_PnO n) c (genericPoint (a3h_PnO n).left)) = Ideal.span {r} ∧
        IsSMulRegular ((P.comap f).subscheme.presheaf.stalk x)
          (g.stalkMap x (P.subschemeι.stalkMap (g x) r)) := by
  intro P f g x hE
  have := IntersectionProductScaf_projectionTarget_integral X hfin hn
  have : Smooth (a3h_PnO n).hom := IntersectionProductScaf_projective_smooth n
  have : IsProjective (a3h_PnO n).hom :=
    ⟨⟨{ ambientDimension := n, immersion := 𝟙 _, immersion_toBase := Category.id_comp _ }⟩⟩
  have : Flat f := IntersectionProductScaf_familyMap₁_flat_of_projection X hfin M
  have hdom : a3n_h (a3h_PnO n) ((a3h_G (a3h_πO X hfin)).left y) =
      genericPoint (g3c_P 1) := by rw [a3h_G_h_apply, hy]
  obtain ⟨r, he, hr⟩ := IntersectionProductScaf_section_prime_stalk_equation
    (a3h_PnO n) c hc _ hdom (g x) hE
  refine ⟨r, he, ?_⟩
  exact IntersectionProductScaf_comap_stalk_regular f P x
    (P.subschemeι.stalkMap (g x) r) hr
#print axioms IntersectionProductScaf_originalOpen_regular_parameter_of_projection

