/-- A parameter outside an affine prime remains regular at every stalk of its flat inverse image. -/
theorem IntersectionProductScaf_flat_affine_comap_stalk_regular
    {Y Z : Scheme} [IsAffine Y] [IsAffine Z] (f : Y ⟶ Z) [Flat f]
    (K : Z.IdealSheafData)
    [((Scheme.IdealSheafData.equivOfIsAffine K) : Ideal Γ(Z, ⊤)).IsPrime]
    (r : Γ(Z, ⊤)) (hr : r ∉ Scheme.IdealSheafData.equivOfIsAffine K)
    (x : (K.comap f).subscheme) :
    IsSMulRegular ((K.comap f).subscheme.presheaf.stalk x)
      ((K.comap f).subschemeι.stalkMap x
        (Y.presheaf.germ ⊤ ((K.comap f).subschemeι x) (by trivial) (f.appTop r))) := by
  exact IntersectionProductScaf_affine_equation_stalk_regular (K.comap f)
    ⟨⊤, isAffineOpen_top Y⟩ (f.appTop r)
    (IntersectionProductScaf_flat_affine_comap_regular f K r hr) x (by trivial)
#print axioms IntersectionProductScaf_flat_affine_comap_stalk_regular

/-- The induced morphism on inverse-image subschemes of a flat morphism is flat. -/
theorem IntersectionProductScaf_comap_subschemeMap_flat
    {Y Z : Scheme} (f : Y ⟶ Z) [Flat f] (I : Z.IdealSheafData) :
    Flat (Scheme.IdealSheafData.subschemeMap (I.comap f) I f (I.le_map_comap f)) := by
  rw [← Scheme.IdealSheafData.comapIso_hom_snd]
  infer_instance
#print axioms IntersectionProductScaf_comap_subschemeMap_flat

/-- A flat stalk map preserves a regular element. -/
theorem IntersectionProductScaf_flat_stalk_regular
    {Y Z : Scheme} (f : Y ⟶ Z) [Flat f] (x : Y)
    (r : Z.presheaf.stalk (f x)) (hr : IsSMulRegular (Z.presheaf.stalk (f x)) r) :
    IsSMulRegular (Y.presheaf.stalk x) (f.stalkMap x r) := by
  let := (f.stalkMap x).hom.toAlgebra
  have : Module.Flat (Z.presheaf.stalk (f x)) (Y.presheaf.stalk x) := Flat.stalkMap f x
  exact hr.of_flat
#print axioms IntersectionProductScaf_flat_stalk_regular

/-- Regular parameters on a subscheme remain regular in its flat inverse image. -/
theorem IntersectionProductScaf_comap_stalk_regular
    {Y Z : Scheme} (f : Y ⟶ Z) [Flat f] (I : Z.IdealSheafData)
    (x : (I.comap f).subscheme)
    (r : I.subscheme.presheaf.stalk
      (Scheme.IdealSheafData.subschemeMap (I.comap f) I f (I.le_map_comap f) x))
    (hr : IsSMulRegular (I.subscheme.presheaf.stalk
      (Scheme.IdealSheafData.subschemeMap (I.comap f) I f (I.le_map_comap f) x)) r) :
    IsSMulRegular ((I.comap f).subscheme.presheaf.stalk x)
      ((Scheme.IdealSheafData.subschemeMap (I.comap f) I f
        (I.le_map_comap f)).stalkMap x r) := by
  have := IntersectionProductScaf_comap_subschemeMap_flat f I
  exact IntersectionProductScaf_flat_stalk_regular _ x r hr
#print axioms IntersectionProductScaf_comap_stalk_regular

/-- A localized inclusion of a finitely generated ideal has one common denominator. -/
theorem IntersectionProductScaf_localized_ideal_denominator
    {R A : Type*} [CommRing R] [CommRing A] [Algebra R A]
    (M : Submonoid R) [IsLocalization M A] (I J : Ideal R) (hI : I.FG)
    (h : I.map (algebraMap R A) ≤ J.map (algebraMap R A)) :
    ∃ s : M, ∀ x ∈ I, (s : R) * x ∈ J := by
  classical
  obtain ⟨S, hS⟩ := hI
  have hd : ∀ x ∈ S, ∃ s : M, (s : R) * x ∈ J := by
    intro x hx
    have hxI : x ∈ I := hS ▸ Ideal.subset_span hx
    have hxJ := h (Ideal.mem_map_of_mem (algebraMap R A) hxI)
    obtain ⟨s, hs, hsm⟩ := (IsLocalization.algebraMap_mem_map_algebraMap_iff M A J x).mp hxJ
    exact ⟨⟨s, hs⟩, hsm⟩
  choose s hs using hd
  let d : M := ∏ x : S, s x.val x.property
  refine ⟨d, ?_⟩
  intro x hx
  rw [← hS] at hx
  induction hx using Submodule.span_induction with
  | mem y hy =>
    have hdiv : s y hy ∣ d := Finset.dvd_prod_of_mem _ (Finset.mem_univ (⟨y, hy⟩ : S))
    obtain ⟨t, ht⟩ := hdiv
    have hdt : (d : R) = (s y hy : R) * (t : R) := congrArg Subtype.val ht
    rw [hdt, mul_right_comm, mul_comm _ (t : R)]
    exact J.mul_mem_left _ (hs y hy)
  | zero => simp
  | add a b ha hb ia ib => simpa [mul_add] using J.add_mem ia ib
  | smul a b hb ib => simpa [smul_eq_mul, mul_left_comm] using J.mul_mem_left a ib
#print axioms IntersectionProductScaf_localized_ideal_denominator

/-- A principal localized ideal has a numerator in the original ideal that generates it. -/
theorem IntersectionProductScaf_localized_principal_numerator
    {R A : Type*} [CommRing R] [CommRing A] [Algebra R A]
    (M : Submonoid R) [IsLocalization M A] (I : Ideal R)
    (r : A) (hr : I.map (algebraMap R A) = Ideal.span {r}) :
    ∃ a ∈ I, I.map (algebraMap R A) = Ideal.span {algebraMap R A a} := by
  have hm : r ∈ I.map (algebraMap R A) := hr ▸ Ideal.mem_span_singleton_self r
  obtain ⟨⟨a, s⟩, he⟩ := (IsLocalization.mem_map_algebraMap_iff M A).mp hm
  refine ⟨a, a.property, ?_⟩
  rw [← he, Ideal.span_singleton_mul_right_unit (IsLocalization.map_units A s), hr]
#print axioms IntersectionProductScaf_localized_principal_numerator

set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
/-- A principal stalk ideal on a locally Noetherian scheme is principal on an affine neighborhood. -/
theorem IntersectionProductScaf_principal_affine_neighborhood
    (Y : Scheme) [IsLocallyNoetherian Y] (K : Y.IdealSheafData)
    (U : Y.affineOpens) (x : Y) (hx : x ∈ U.1)
    (r : Y.presheaf.stalk x)
    (hr : (K.ideal U).map (Y.presheaf.germ U.1 x hx).hom = Ideal.span {r}) :
    ∃ V : Y.affineOpens, x ∈ V.1 ∧ V.1 ≤ U.1 ∧
      ∃ a : Γ(Y, V), K.ideal V = Ideal.span {a} := by
  let _ := TopCat.Presheaf.algebra_section_stalk Y.presheaf (⟨x, hx⟩ : U.1)
  let P := (U.2.primeIdealOf ⟨x, hx⟩).asIdeal
  have := U.2.isLocalization_stalk ⟨x, hx⟩
  have := IsLocallyNoetherian.component_noetherian U
  obtain ⟨a, ha, hea⟩ := IntersectionProductScaf_localized_principal_numerator
    P.primeCompl (K.ideal U) r hr
  have hle : (K.ideal U).map (algebraMap Γ(Y, U) (Y.presheaf.stalk x)) ≤
      (Ideal.span {a}).map (algebraMap Γ(Y, U) (Y.presheaf.stalk x)) := by
    rw [Ideal.map_span, Set.image_singleton, hea]
  obtain ⟨s, hs⟩ := IntersectionProductScaf_localized_ideal_denominator
    P.primeCompl (K.ideal U) (Ideal.span {a}) (IsNoetherian.noetherian _) hle
  let V : Y.affineOpens := ⟨Y.basicOpen (s : Γ(Y, U)), U.2.basicOpen _⟩
  have hxV : x ∈ V.1 := (Y.mem_basicOpen _ x hx).mpr
    (IsLocalization.map_units (Y.presheaf.stalk x) s)
  let f := (Y.presheaf.map (homOfLE (Y.basicOpen_le (s : Γ(Y, U)))).op).hom
  refine ⟨V, hxV, Y.basicOpen_le _, f a, ?_⟩
  have hmap : (K.ideal U).map f = K.ideal V := K.map_ideal (U := V) (V := U) (Y.basicOpen_le (s : Γ(Y, U)))
  rw [← hmap, ← Set.image_singleton, ← Ideal.map_span]
  apply le_antisymm
  · apply Ideal.map_le_iff_le_comap.mpr
    intro b hb
    have hsm : f (s : Γ(Y, U)) * f b ∈ (Ideal.span {a}).map f := by
      rw [← map_mul]
      exact Ideal.mem_map_of_mem f (hs b hb)
    have hu : IsUnit (f (s : Γ(Y, U))) := Y.toRingedSpace.isUnit_res_basicOpen _
    exact (Ideal.unit_mul_mem_iff_mem _ hu).mp hsm
  · exact Ideal.map_mono (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr ha))
#print axioms IntersectionProductScaf_principal_affine_neighborhood

/-- A section is regular if its germ is regular at every point of its domain. -/
theorem IntersectionProductScaf_section_regular_of_stalks
    (Y : Scheme) (U : Y.Opens) (r : Γ(Y, U))
    (hr : ∀ x (hx : x ∈ U), IsSMulRegular (Y.presheaf.stalk x) (Y.presheaf.germ U x hx r)) :
    IsSMulRegular Γ(Y, U) r := by
  intro a b hab
  apply TopCat.Presheaf.section_ext Y.sheaf U a b
  intro x hx
  apply hr x hx
  change Y.presheaf.germ U x hx r * Y.presheaf.germ U x hx a =
    Y.presheaf.germ U x hx r * Y.presheaf.germ U x hx b
  change r * a = r * b at hab
  simpa only [map_mul] using congrArg (Y.presheaf.germ U x hx) hab
#print axioms IntersectionProductScaf_section_regular_of_stalks
