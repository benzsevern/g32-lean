/-- Regularity on an affine inverse image reaches the stalks of the extended subscheme. -/
theorem IntersectionProductScaf_extended_equation_stalk_regular
    {U V : Scheme} (f : U ⟶ V) [QuasiCompact f] (I : U.IdealSheafData)
    (W : V.affineOpens) (hW : IsAffineOpen (f ⁻¹ᵁ W)) (r : Γ(V, W))
    (hr : IsSMulRegular (Γ(U, f ⁻¹ᵁ W) ⧸ I.ideal ⟨_, hW⟩) (f.app W r))
    (x : (I.map f).subscheme) (hx : (I.map f).subschemeι x ∈ W.1) :
    IsSMulRegular ((I.map f).subscheme.presheaf.stalk x)
      ((I.map f).subschemeι.stalkMap x
        (V.presheaf.germ W.1 ((I.map f).subschemeι x) hx r)) := by
  exact IntersectionProductScaf_affine_equation_stalk_regular (I.map f) W r
    (IntersectionProductScaf_map_equation_regular f I W hW r hr) x hx
