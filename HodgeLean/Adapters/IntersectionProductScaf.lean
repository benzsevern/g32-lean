/-- The identity matrix leaves every homogeneous section unchanged. -/
theorem IntersectionProductScaf_matrixSections_one
    {σ R B : Type} [Fintype σ] [DecidableEq σ] [CommRing R] [CommRing B]
    (f : MvPolynomial σ R →+* B) :
    IntersectionProductScaf_matrixSections (1 : Matrix σ σ B) f = f := by
  apply MvPolynomial.ringHom_ext
  · intro r
    simp only [IntersectionProductScaf_matrixSections, MvPolynomial.coe_eval₂Hom,
      MvPolynomial.eval₂_C, RingHom.comp_apply]
  · intro i
    simp only [IntersectionProductScaf_matrixSections, MvPolynomial.coe_eval₂Hom,
      MvPolynomial.eval₂_X, Matrix.one_mulVec]

#print axioms IntersectionProductScaf_matrixSections_one

/-- Evaluation of the polynomial translation agrees with the matrix action on sections. -/
theorem IntersectionProductScaf_matrixSections_substLine0
    {σ B : Type} [Fintype σ] [CommRing B]
    (M : σ × σ → ℂ) (f : MvPolynomial σ ℂ →+* B)
    (t : Polynomial ℂ →+* B)
    (hC : ∀ c, t (Polynomial.C c) = f (MvPolynomial.C c)) :
    IntersectionProductScaf_matrixSections
        (t.mapMatrix (IntersectionProductScaf_lineMatrix M)) f =
      (Polynomial.eval₂RingHom f (t Polynomial.X)).comp
        (IntersectionProductScaf_substLine0 M).toRingHom := by
  apply MvPolynomial.ringHom_ext
  · intro c
    simp [IntersectionProductScaf_matrixSections, IntersectionProductScaf_substLine0]
  · intro i
    simp [IntersectionProductScaf_matrixSections, IntersectionProductScaf_lineMatrix,
      IntersectionProductScaf_substLine0, Matrix.mulVec, dotProduct, map_sum,
      hC, add_mul, Finset.sum_add_distrib, mul_assoc]
    simp [apply_ite, Polynomial.eval₂_finsetSum, Polynomial.eval₂_mul,
      Finset.mul_sum, mul_left_comm]

#print axioms IntersectionProductScaf_matrixSections_substLine0

/-- Polynomial inverse translation preserves homogeneous scaling of coefficient coordinates. -/
theorem IntersectionProductScaf_substLine0_twist
    {σ B : Type} [Fintype σ] [CommRing B]
    (M : σ × σ → ℂ) (f g : MvPolynomial σ ℂ →+* B) (u : B)
    (hC : ∀ c, f (MvPolynomial.C c) = g (MvPolynomial.C c))
    (hX : ∀ i, f (MvPolynomial.X i) = u * g (MvPolynomial.X i))
    (F : MvPolynomial σ ℂ) (d : ℕ) (hF : F.IsHomogeneous d) :
    (IntersectionProductScaf_substLine0 M F).map f =
      Polynomial.C u ^ d * (IntersectionProductScaf_substLine0 M F).map g := by
  let t := Polynomial.mapRingHom (f.comp MvPolynomial.C)
  have hf := IntersectionProductScaf_matrixSections_substLine0 M (Polynomial.C.comp f) t
    (by intro c; simp only [t, Polynomial.coe_mapRingHom, Polynomial.map_C, RingHom.comp_apply])
  have hg := IntersectionProductScaf_matrixSections_substLine0 M (Polynomial.C.comp g) t
    (by
      intro c
      simp only [t, Polynomial.coe_mapRingHom, Polynomial.map_C, RingHom.comp_apply]
      rw [hC])
  have h := IntersectionProductScaf_matrixSections_twist
    (t.mapMatrix (IntersectionProductScaf_lineMatrix M))
    (Polynomial.C.comp f) (Polynomial.C.comp g) (Polynomial.C u)
    (by intro c; change Polynomial.C (f _) = Polynomial.C (g _); rw [hC])
    (by intro i; simp only [RingHom.comp_apply, hX, map_mul]) F d hF
  rw [hf, hg] at h
  simp only [RingHom.comp_apply, t, Polynomial.coe_mapRingHom, Polynomial.map_X] at h
  exact h

#print axioms IntersectionProductScaf_substLine0_twist

/-- Normalizing cone coordinates scales every homogeneous translated equation by the inverted
chart coordinate to its degree. -/
theorem IntersectionProductScaf_chart_substLine0_homogeneous
    {Y : Scheme} [IsIntegral Y] {σ ρ : Type} [Fintype σ] [Fintype ρ]
    (C : a3m_SpecCharts Y σ ℂ) (j : σ)
    (hj : MvPolynomial.X j ∉ C.prime (genericPoint Y))
    (ℓ : Matrix ρ σ ℂ) (M : ρ × ρ → ℂ)
    (F : MvPolynomial ρ ℂ) (d : ℕ) (hF : F.IsHomogeneous d) :
    (IntersectionProductScaf_substLine0 M F).map
      ((a3t_phi C j hj).comp ((C.θ j).comp (a3r_lin ℓ).toRingHom)) =
      Polynomial.C (IsLocalization.Away.invSelf (a3t_x C j)) ^ d *
        (IntersectionProductScaf_substLine0 M F).map
          ((algebraMap (a3t_A C) (a3t_Ax C j)).comp
            ((Ideal.Quotient.mk _).comp (a3r_lin ℓ).toRingHom)) := by
  apply IntersectionProductScaf_substLine0_twist M _ _
    (IsLocalization.Away.invSelf (a3t_x C j)) ?_ ?_ F d hF
  · intro c
    change a3t_phi C j hj (C.θ j (a3r_lin ℓ (MvPolynomial.C c))) =
      algebraMap (a3t_A C) (a3t_Ax C j) (Ideal.Quotient.mk _ (a3r_lin ℓ (MvPolynomial.C c)))
    rw [a3t_phi_θ, a3t_phiT_of_isHomogeneous C j _ 0
      (a3h_lin_isHomogeneous ℓ (MvPolynomial.isHomogeneous_C ρ c))]
    simp only [pow_zero, one_mul]
  · intro i
    change a3t_phi C j hj (C.θ j (a3r_lin ℓ (MvPolynomial.X i))) =
      IsLocalization.Away.invSelf (a3t_x C j) *
        algebraMap (a3t_A C) (a3t_Ax C j) (Ideal.Quotient.mk _ (a3r_lin ℓ (MvPolynomial.X i)))
    rw [a3t_phi_θ, a3t_phiT_of_isHomogeneous C j _ 1 (a3r_lin_X_isHomogeneous ℓ i), pow_one]

#print axioms IntersectionProductScaf_chart_substLine0_homogeneous

attribute [local instance] MvPolynomial.gradedAlgebra in
/-- Homogeneous equations scaled by powers of a unit generate the same extended ideal. -/
theorem IntersectionProductScaf_map_homogeneous_ideal_of_unit_scaling
    {σ B : Type} [CommRing B]
    (I : Ideal (MvPolynomial σ ℂ))
    (hI : I.IsHomogeneous (MvPolynomial.homogeneousSubmodule σ ℂ))
    (f g : MvPolynomial σ ℂ →+* B) (u : B) (hu : IsUnit u)
    (hscale : ∀ (F : MvPolynomial σ ℂ) (d : ℕ), F.IsHomogeneous d →
      f F = u ^ d * g F) :
    Ideal.map f I = Ideal.map g I := by
  apply le_antisymm
  · rw [Ideal.map_le_iff_le_comap]
    intro F hF
    change f F ∈ Ideal.map g I
    rw [← MvPolynomial.sum_homogeneousComponent F, map_sum]
    apply Ideal.sum_mem
    intro d hd
    rw [hscale _ d (MvPolynomial.homogeneousComponent_isHomogeneous d F)]
    exact Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem g
      (MvPolynomial.homogeneousComponent_mem_of_mem hI hF d))
  · rw [Ideal.map_le_iff_le_comap]
    intro F hF
    change g F ∈ Ideal.map f I
    rw [← MvPolynomial.sum_homogeneousComponent F, map_sum]
    apply Ideal.sum_mem
    intro d hd
    apply (Ideal.unit_mul_mem_iff_mem _ (hu.pow d)).mp
    rw [← hscale _ d (MvPolynomial.homogeneousComponent_isHomogeneous d F)]
    exact Ideal.mem_map_of_mem f
      (MvPolynomial.homogeneousComponent_mem_of_mem hI hF d)

#print axioms IntersectionProductScaf_map_homogeneous_ideal_of_unit_scaling

attribute [local instance] MvPolynomial.gradedAlgebra in
/-- Normalized and homogeneous translated equations define the same ideal on the localized cone. -/
theorem IntersectionProductScaf_chart_substLine0_ideal
    {Y : Scheme} [IsIntegral Y] {σ ρ : Type} [Fintype σ] [Fintype ρ]
    (C : a3m_SpecCharts Y σ ℂ) (j : σ)
    (hj : MvPolynomial.X j ∉ C.prime (genericPoint Y))
    (ℓ : Matrix ρ σ ℂ) (M : ρ × ρ → ℂ)
    (I : Ideal (MvPolynomial ρ ℂ))
    (hI : I.IsHomogeneous (MvPolynomial.homogeneousSubmodule ρ ℂ)) :
    Ideal.map ((Polynomial.mapRingHom
      ((a3t_phi C j hj).comp ((C.θ j).comp (a3r_lin ℓ).toRingHom))).comp
        (IntersectionProductScaf_substLine0 M).toRingHom) I =
      Ideal.map ((Polynomial.mapRingHom
        ((algebraMap (a3t_A C) (a3t_Ax C j)).comp
          ((Ideal.Quotient.mk _).comp (a3r_lin ℓ).toRingHom))).comp
            (IntersectionProductScaf_substLine0 M).toRingHom) I := by
  have hu : IsUnit (IsLocalization.Away.invSelf (S := a3t_Ax C j) (a3t_x C j)) := by
    refine isUnit_iff_exists_inv.mpr ⟨algebraMap (a3t_A C) (a3t_Ax C j) (a3t_x C j), ?_⟩
    simpa only [mul_comm] using
      (IsLocalization.Away.mul_invSelf (S := a3t_Ax C j) (a3t_x C j))
  apply IntersectionProductScaf_map_homogeneous_ideal_of_unit_scaling I hI _ _
    (Polynomial.C (IsLocalization.Away.invSelf (a3t_x C j))) (hu.map Polynomial.C)
  intro F d hF
  exact IntersectionProductScaf_chart_substLine0_homogeneous C j hj ℓ M F d hF

#print axioms IntersectionProductScaf_chart_substLine0_ideal

section ParameterOpen

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

open scoped MonoidalCategory
open CategoryTheory.Limits

variable {σ : Type} [Fintype σ]

/-- The affine parameter scheme with the determinant inverted. -/
abbrev IntersectionProductScaf_parameterScheme (M : σ × σ → ℂ) : Scheme :=
  Spec (.of (IntersectionProductScaf_lineRing M))

/-- The map from the invertible parameter locus to the affine chart of the parameter line. -/
def IntersectionProductScaf_parameterChart (M : σ × σ → ℂ) :
    IntersectionProductScaf_parameterScheme M ⟶ Spec (a3m_PnT 1 0) :=
  Spec.map (CommRingCat.ofHom
    ((algebraMap (Polynomial ℂ) (IntersectionProductScaf_lineRing M)).comp
      (a3n_chartEquiv 0).symm.toRingHom))

instance IntersectionProductScaf_parameterChart_open (M : σ × σ → ℂ) :
    IsOpenImmersion (IntersectionProductScaf_parameterChart M) := by
  have : IsIso (CommRingCat.ofHom (a3n_chartEquiv 0).symm.toRingHom) :=
    inferInstanceAs (IsIso (a3n_chartEquiv 0).toRingEquiv.toCommRingCatIso.inv)
  unfold IntersectionProductScaf_parameterChart
  rw [CommRingCat.ofHom_comp, Spec.map_comp]
  infer_instance

/-- Inclusion of the invertible affine locus into the projective parameter line. -/
def IntersectionProductScaf_parameterInclusion (M : σ × σ → ℂ) :
    IntersectionProductScaf_parameterScheme M ⟶ a3m_Pn 1 :=
  IntersectionProductScaf_parameterChart M ≫ a3m_Pnκ 1 0

instance IntersectionProductScaf_parameterInclusion_open (M : σ × σ → ℂ) :
    IsOpenImmersion (IntersectionProductScaf_parameterInclusion M) := by
  unfold IntersectionProductScaf_parameterInclusion
  infer_instance

/-- The parameter locus as a scheme over the complex numbers. -/
abbrev IntersectionProductScaf_parameterOver (M : σ × σ → ℂ) : Over (Spec ↧ℂ) :=
  Over.mk (IntersectionProductScaf_parameterInclusion M ≫ a3n_P1.hom)

attribute [local instance] MvPolynomial.gradedAlgebra in
/-- The parameter locus has the scalar structure induced by its polynomial coordinate ring. -/
theorem IntersectionProductScaf_parameterOver_hom (M : σ × σ → ℂ) :
    (IntersectionProductScaf_parameterOver M).hom =
      Spec.map (CommRingCat.ofHom
        ((algebraMap (Polynomial ℂ) (IntersectionProductScaf_lineRing M)).comp Polynomial.C)) := by
  change IntersectionProductScaf_parameterChart M ≫ a3m_Pnκ 1 0 ≫
    pullback.fst (terminal.from (Spec ↧ℂ)) (terminal.from (g3c_P 1)) = _
  rw [a3m_Pnκ, a3m_prodChart_fst, Category.comp_id,
    IntersectionProductScaf_parameterChart, ← Spec.map_comp]
  congr 1
  ext c
  change algebraMap (Polynomial ℂ) (IntersectionProductScaf_lineRing M)
      ((a3n_chartEquiv 0).symm (Algebra.TensorProduct.includeLeftRingHom c)) =
    algebraMap (Polynomial ℂ) (IntersectionProductScaf_lineRing M) (Polynomial.C c)
  congr 1
  apply (a3n_chartEquiv 0).injective
  rw [AlgEquiv.apply_symm_apply]
  simp [a3n_chartEquiv, polyEquivTensor_apply]

#print axioms IntersectionProductScaf_parameterOver_hom

/-- Inclusion of the parameter locus, retaining the complex structure. -/
def IntersectionProductScaf_parameterOverInclusion (M : σ × σ → ℂ) :
    IntersectionProductScaf_parameterOver M ⟶ a3n_P1 :=
  Over.homMk (IntersectionProductScaf_parameterInclusion M) rfl

/-- The translation locus on an arbitrary complex scheme. -/
abbrev IntersectionProductScaf_familyOpen (X : Over (Spec ↧ℂ)) (M : σ × σ → ℂ) :
    Over (Spec ↧ℂ) := X ⊗ IntersectionProductScaf_parameterOver M

/-- Inclusion of the translation locus in the projective family. -/
def IntersectionProductScaf_familyInclusion (X : Over (Spec ↧ℂ)) (M : σ × σ → ℂ) :
    IntersectionProductScaf_familyOpen X M ⟶ a3n_T X :=
  𝟙 X ⊗ₘ IntersectionProductScaf_parameterOverInclusion M

instance IntersectionProductScaf_familyInclusion_open (X : Over (Spec ↧ℂ))
    (M : σ × σ → ℂ) :
    IsOpenImmersion (IntersectionProductScaf_familyInclusion X M).left := by
  change IsOpenImmersion (pullback.map _ _ _ _ (𝟙 X.left)
    (IntersectionProductScaf_parameterInclusion M) (𝟙 (Spec ↧ℂ))
      (by simp only [Category.comp_id, Category.id_comp]) (by exact Category.comp_id _))
  exact MorphismProperty.pullbackMap (P := @IsOpenImmersion)
    (inferInstance : IsOpenImmersion (𝟙 X.left))
    (inferInstance : IsOpenImmersion (IntersectionProductScaf_parameterInclusion M))
    (Category.id_comp _).symm rfl

set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
/-- Membership in the family open is membership of the parameter in its determinant open. -/
theorem IntersectionProductScaf_familyInclusion_range
    (X : Over (Spec ↧ℂ)) {σ : Type} [Fintype σ] [DecidableEq σ] (M : σ × σ → ℂ) :
    Set.range (IntersectionProductScaf_familyInclusion X M).left =
      a3n_p X ⁻¹' Set.range (IntersectionProductScaf_parameterInclusion M) := by
  change Set.range (pullback.map _ _ _ _ (𝟙 X.left)
    (IntersectionProductScaf_parameterInclusion M) (𝟙 (Spec ↧ℂ))
      (by simp only [Category.comp_id, Category.id_comp]) (by exact Category.comp_id _)) = _
  rw [Scheme.Pullback.range_map]
  simp only [Scheme.Hom.id_base, TopCat.coe_id, Set.range_id, Set.preimage_univ,
    Set.univ_inter]
  rfl
#print axioms IntersectionProductScaf_familyInclusion_range
set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
/-- The determinant-open square inclusion is affine. -/
theorem IntersectionProductScaf_familyInclusion_affine
    (X : Over (Spec ↧ℂ)) {σ : Type} [Fintype σ] [DecidableEq σ] (M : σ × σ → ℂ) :
    IsAffineHom (IntersectionProductScaf_familyInclusion X M).left := by
  have hparam : IsAffineHom (IntersectionProductScaf_parameterInclusion M) := by
    have : IsAffine (IntersectionProductScaf_parameterScheme M) := inferInstance
    have : IsAffineHom (IntersectionProductScaf_parameterInclusion M ≫ a3n_P1.hom) :=
      isAffineHom_of_isAffine _
    exact IsAffineHom.of_comp _ a3n_P1.hom
  change IsAffineHom (pullback.map _ _ _ _ (𝟙 X.left)
    (IntersectionProductScaf_parameterInclusion M) (𝟙 (Spec ↧ℂ))
      (by simp only [Category.comp_id, Category.id_comp]) (by exact Category.comp_id _))
  exact MorphismProperty.pullbackMap (P := @IsAffineHom)
    (inferInstance : IsAffineHom (𝟙 X.left)) hparam
    (Category.id_comp _).symm rfl
#print axioms IntersectionProductScaf_familyInclusion_affine

/-- The family inclusion preserves its affine parameter through the parameter-locus
inclusion into the projective line. -/
theorem IntersectionProductScaf_familyInclusion_parameter
    (X : Over (Spec ↧ℂ)) (M : σ × σ → ℂ) :
    (IntersectionProductScaf_familyInclusion X M).left ≫ a3n_p X =
      pullback.snd X.hom (IntersectionProductScaf_parameterOver M).hom ≫
        (IntersectionProductScaf_parameterOverInclusion M).left := by
  exact Over.tensorHom_left_snd X.hom a3n_P1.hom (𝟙 X)
    (IntersectionProductScaf_parameterOverInclusion M)

/-- Every point of the determinant-invertible family maps into the standard affine chart
of the projective translation parameter. -/
theorem IntersectionProductScaf_familyInclusion_mem_U
    (X : Over (Spec ↧ℂ)) (M : σ × σ → ℂ)
    (u : (IntersectionProductScaf_familyOpen X M).left) :
    (IntersectionProductScaf_familyInclusion X M).left u ∈ a3h_U X := by
  change a3n_p X ((IntersectionProductScaf_familyInclusion X M).left u) ∈
    Set.range (a3m_Pnκ 1 0)
  refine ⟨IntersectionProductScaf_parameterChart M
    (pullback.snd X.hom (IntersectionProductScaf_parameterOver M).hom u), ?_⟩
  rw [← Scheme.Hom.comp_apply]
  change IntersectionProductScaf_parameterInclusion M _ = _
  have he := congrArg (fun f : (IntersectionProductScaf_familyOpen X M).left ⟶
      a3n_P1.left => f u)
    (Over.tensorHom_left_snd X.hom a3n_P1.hom (𝟙 X)
      (IntersectionProductScaf_parameterOverInclusion M))
  exact he.symm

#print axioms IntersectionProductScaf_parameterChart
#print axioms IntersectionProductScaf_parameterChart_open
#print axioms IntersectionProductScaf_parameterInclusion_open
#print axioms IntersectionProductScaf_familyInclusion_open
#print axioms IntersectionProductScaf_familyInclusion_parameter
#print axioms IntersectionProductScaf_familyInclusion_mem_U

/-- Evaluation at an invertible parameter value factors its projective point. -/
theorem IntersectionProductScaf_parameterPoint_inclusion
    (M : σ × σ → ℂ) (c : ℂ)
    (hc : IsUnit ((IntersectionProductScaf_lineDet M).eval c)) :
    Spec.map (CommRingCat.ofHom (IntersectionProductScaf_lineEval M c hc)) ≫
      IntersectionProductScaf_parameterInclusion M = a3n_pt c := by
  unfold IntersectionProductScaf_parameterInclusion IntersectionProductScaf_parameterChart a3n_pt
  rw [← Category.assoc, ← Spec.map_comp]
  apply congrArg (fun f => Spec.map f ≫ a3m_Pnκ 1 0)
  apply CommRingCat.hom_ext
  apply RingHom.ext
  intro r
  change IntersectionProductScaf_lineEval M c hc
    (algebraMap (Polynomial ℂ) (IntersectionProductScaf_lineRing M)
      ((a3n_chartEquiv 0).symm r)) = (Polynomial.evalRingHom c) ((a3n_chartEquiv 0).symm r)
  exact IsLocalization.Away.lift_eq (IntersectionProductScaf_lineDet M) hc
    ((a3n_chartEquiv 0).symm r)

#print axioms IntersectionProductScaf_parameterPoint_inclusion

/-- A point of the determinant-invertible affine parameter locus with trivial contraction
to `ℂ[s]` maps to the generic point of the projective parameter. -/
theorem IntersectionProductScaf_parameterInclusion_generic_of_comap
    (M : σ × σ → ℂ) (q : IntersectionProductScaf_parameterScheme M)
    (hq : q.asIdeal.comap
      (algebraMap (Polynomial ℂ) (IntersectionProductScaf_lineRing M)) = ⊥) :
    a3n_π (IntersectionProductScaf_parameterInclusion M q) =
      genericPoint (g3c_P 1) := by
  have hc : IntersectionProductScaf_parameterChart M q = a3n_bot 0 := by
    apply PrimeSpectrum.ext
    change q.asIdeal.comap
      ((algebraMap (Polynomial ℂ) (IntersectionProductScaf_lineRing M)).comp
        (a3n_chartEquiv 0).symm.toRingHom) = ⊥
    rw [← Ideal.comap_comap, hq, ← RingHom.ker_eq_comap_bot]
    exact (RingHom.injective_iff_ker_eq_bot _).mp (a3n_chartEquiv 0).symm.injective
  rw [IntersectionProductScaf_parameterInclusion, Scheme.Hom.comp_apply, hc]
  change a3n_π (a3m_Pnκ 1 0 (a3n_bot 0)) = _
  rw [← a3n_η, ← a3n_genericPoint_P1, a3k_π_generic]

#print axioms IntersectionProductScaf_parameterInclusion_generic_of_comap

/-- A family point whose affine parameter prime contracts trivially to `ℂ[s]` dominates
the projective translation parameter after inclusion. -/
theorem IntersectionProductScaf_familyInclusion_parameter_generic_of_comap
    (X : Over (Spec ↧ℂ)) (M : σ × σ → ℂ)
    (u : (IntersectionProductScaf_familyOpen X M).left)
    (hq : ((pullback.snd X.hom (IntersectionProductScaf_parameterOver M).hom u).asIdeal).comap
      (algebraMap (Polynomial ℂ) (IntersectionProductScaf_lineRing M)) = ⊥) :
    a3n_h X ((IntersectionProductScaf_familyInclusion X M).left u) =
      genericPoint (g3c_P 1) := by
  change (((IntersectionProductScaf_familyInclusion X M).left ≫ a3n_p X) ≫ a3n_π) u = _
  rw [IntersectionProductScaf_familyInclusion_parameter, Category.assoc,
    Scheme.Hom.comp_apply, Scheme.Hom.comp_apply]
  exact IntersectionProductScaf_parameterInclusion_generic_of_comap M _ hq

#print axioms IntersectionProductScaf_familyInclusion_parameter_generic_of_comap

/-- The section of the determinant-invertible family at an invertible parameter value. -/
def IntersectionProductScaf_familySection (Y : Over (Spec ↧ℂ))
    (M : σ × σ → ℂ) (c : ℂ)
    (hc : IsUnit ((IntersectionProductScaf_lineDet M).eval c)) :
    Y.left ⟶ (IntersectionProductScaf_familyOpen Y M).left :=
  pullback.lift (𝟙 Y.left)
    (Y.hom ≫ Spec.map (CommRingCat.ofHom (IntersectionProductScaf_lineEval M c hc))) (by
      change 𝟙 Y.left ≫ Y.hom = (Y.hom ≫ _) ≫
        (IntersectionProductScaf_parameterInclusion M ≫ a3n_P1.hom)
      rw [Category.id_comp, Category.assoc, ← Category.assoc
        (Spec.map (CommRingCat.ofHom (IntersectionProductScaf_lineEval M c hc))),
        IntersectionProductScaf_parameterPoint_inclusion]
      change Y.hom = Y.hom ≫ a3n_pt c ≫ ProjectiveSpace.toBase (Fin 2) (Spec ↧ℂ)
      rw [a3n_pt_toBase, Category.comp_id])

/-- The section of the open family is the usual projective section after inclusion. -/
theorem IntersectionProductScaf_familySection_inclusion (Y : Over (Spec ↧ℂ))
    (M : σ × σ → ℂ) (c : ℂ)
    (hc : IsUnit ((IntersectionProductScaf_lineDet M).eval c)) :
    IntersectionProductScaf_familySection Y M c hc ≫
      (IntersectionProductScaf_familyInclusion Y M).left = a3n_σ Y c := by
  change IntersectionProductScaf_familySection Y M c hc ≫
    pullback.map _ _ _ _ (𝟙 Y.left) (IntersectionProductScaf_parameterInclusion M)
      (𝟙 (Spec ↧ℂ)) (by simp only [Category.id_comp, Category.comp_id])
      (by exact Category.comp_id _) = a3n_σ Y c
  apply pullback.hom_ext
  · simp only [pullback.map, IntersectionProductScaf_familySection, a3n_σ,
      Category.assoc, pullback.lift_fst, Category.comp_id]
  · simp only [pullback.map, IntersectionProductScaf_familySection, a3n_σ,
      Category.assoc, pullback.lift_snd, pullback.lift_snd_assoc,
      IntersectionProductScaf_parameterPoint_inclusion]

#print axioms IntersectionProductScaf_familySection
#print axioms IntersectionProductScaf_familySection_inclusion

/-- Each invertible parameter fibre lies in the open translation family. -/
theorem IntersectionProductScaf_section_mem_familyOpen (Y : Over (Spec ↧ℂ))
    (M : σ × σ → ℂ) (c : ℂ)
    (hc : IsUnit ((IntersectionProductScaf_lineDet M).eval c)) (x : Y.left) :
    a3n_σ Y c x ∈ Set.range (IntersectionProductScaf_familyInclusion Y M).left := by
  refine ⟨IntersectionProductScaf_familySection Y M c hc x, ?_⟩
  exact congrArg (fun f : Y.left ⟶ (a3n_T Y).left => f x)
    (IntersectionProductScaf_familySection_inclusion Y M c hc)

#print axioms IntersectionProductScaf_section_mem_familyOpen

/-- A prime divisor boundary is supported inside the determinant-invertible family whenever
its endpoint matrix is invertible. -/
theorem IntersectionProductScaf_cyc_mem_familyOpen (Y : Over (Spec ↧ℂ))
    [IsProper Y.hom] (M : σ × σ → ℂ) (hM : IsUnit (a3r_mat M).det)
    (y : (a3n_T Y).left) (hy : a3n_h Y y = genericPoint (g3c_P 1))
    (d : (a3n_T Y).left) (hd : a3o_cyc Y y hy d ≠ 0) :
    d ∈ Set.range (IntersectionProductScaf_familyInclusion Y M).left := by
  rcases a3o_cyc_supp Y y hy d hd with ⟨x, rfl⟩ | ⟨x, rfl⟩
  · exact IntersectionProductScaf_section_mem_familyOpen Y M 0
      (by rw [IntersectionProductScaf_lineDet_zero]; exact isUnit_one) x
  · exact IntersectionProductScaf_section_mem_familyOpen Y M 1
      (by rw [IntersectionProductScaf_lineDet_one]; exact hM) x

#print axioms IntersectionProductScaf_cyc_mem_familyOpen

/-- The principal divisor boundary is recovered exactly from its restriction to the open
translation family at an invertible endpoint matrix. -/
theorem IntersectionProductScaf_cyc_eq_push_restriction (Y : Over (Spec ↧ℂ))
    [IsProper Y.hom] (M : σ × σ → ℂ) (hM : IsUnit (a3r_mat M).det)
    (y : (a3n_T Y).left) (hy : a3n_h Y y = genericPoint (g3c_P 1)) :
    a1p_pushforward (IntersectionProductScaf_familyInclusion Y M).left
      (IntersectionProductScaf_openCycleRestriction
        (IntersectionProductScaf_familyInclusion Y M).left (a3o_cyc Y y hy)
        (a3m_support_finite (a3o_cyc Y y hy))) = a3o_cyc Y y hy := by
  apply IntersectionProductScaf_openCycleRestriction_push
  intro d hd
  exact IntersectionProductScaf_cyc_mem_familyOpen Y M hM y hy d hd

/-- Generically, every dominating prime boundary is recovered from the open translation family. -/
theorem IntersectionProductScaf_generic_cyc_eq_push_restriction
    (Y : Over (Spec ↧ℂ)) [IsProper Y.hom]
    (y : (a3n_T Y).left) (hy : a3n_h Y y = genericPoint (g3c_P 1)) :
    a3r_Generic {M : σ × σ → ℂ |
      a1p_pushforward (IntersectionProductScaf_familyInclusion Y M).left
        (IntersectionProductScaf_openCycleRestriction
          (IntersectionProductScaf_familyInclusion Y M).left (a3o_cyc Y y hy)
          (a3m_support_finite (a3o_cyc Y y hy))) = a3o_cyc Y y hy} := by
  exact IntersectionProductScaf_generic_det.mono fun M hM => by
    change IsUnit (a3r_mat M).det at hM
    exact IntersectionProductScaf_cyc_eq_push_restriction Y M hM y hy

/-- One generic determinant condition recovers every dominating boundary in a finite set. -/
theorem IntersectionProductScaf_generic_cyc_eq_push_restriction_finset
    (Y : Over (Spec ↧ℂ)) [IsProper Y.hom]
    (S : Finset (a3n_T Y).left)
    (hS : ∀ y ∈ S, a3n_h Y y = genericPoint (g3c_P 1)) :
    a3r_Generic {M : σ × σ → ℂ | ∀ y, ∀ hy : y ∈ S,
      a1p_pushforward (IntersectionProductScaf_familyInclusion Y M).left
        (IntersectionProductScaf_openCycleRestriction
          (IntersectionProductScaf_familyInclusion Y M).left
          (a3o_cyc Y y (hS y hy)) (a3m_support_finite (a3o_cyc Y y (hS y hy)))) =
            a3o_cyc Y y (hS y hy)} := by
  exact IntersectionProductScaf_generic_det.mono fun M hM y hy => by
    change IsUnit (a3r_mat M).det at hM
    exact IntersectionProductScaf_cyc_eq_push_restriction Y M hM y (hS y hy)

#print axioms IntersectionProductScaf_cyc_eq_push_restriction
#print axioms IntersectionProductScaf_generic_cyc_eq_push_restriction
#print axioms IntersectionProductScaf_generic_cyc_eq_push_restriction_finset

end ParameterOpen

section ComplexSectionCharts

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
attribute [local instance] MvPolynomial.gradedAlgebra
open CategoryTheory.Limits MvPolynomial

variable {n : ℕ} (Z : Over (Spec ↧ℂ))
  (f : UniversalRing n →+* Γ(Z.left, ⊤)) (i : Fin (n + 1))
  (hu : IsUnit (f (MvPolynomial.X i)))

/-- Complex scalars acting on the global sections of a scheme over the complex numbers. -/
def IntersectionProductScaf_complexScalars : ℂ →+* Γ(Z.left, ⊤) :=
  Z.hom.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of ℂ)).inv.hom

/-- A projective affine chart evaluated using homogeneous global sections. -/
def IntersectionProductScaf_sectionChart : a3m_PnT n i →+* Γ(Z.left, ⊤) :=
  letI : Algebra ℤ Γ(Z.left, ⊤) := Ring.toIntAlgebra _
  (Algebra.TensorProduct.productMap
    (IntersectionProductScaf_complexScalars Z).toIntAlgHom
    (a3h_awayLift (UniversalGrading n) f hu).toIntAlgHom).toRingHom

/-- Homogeneous complex equations dehomogenize by the chosen unit section. -/
theorem IntersectionProductScaf_sectionChart_equation
    (F : MvPolynomial (Fin (n + 1)) ℂ) (d : ℕ) (hF : F.IsHomogeneous d) :
    eval₂Hom (IntersectionProductScaf_complexScalars Z) (fun k => f (MvPolynomial.X k)) F =
      f (MvPolynomial.X i) ^ d *
        IntersectionProductScaf_sectionChart Z f i hu (a3m_Pnθ n i F) := by
  apply a3m_twist
    (eval₂Hom (IntersectionProductScaf_complexScalars Z) (fun k => f (MvPolynomial.X k)))
    ((IntersectionProductScaf_sectionChart Z f i hu).comp (a3m_Pnθ n i))
    (f (MvPolynomial.X i)) _ _ F d hF
  · intro c
    simp [IntersectionProductScaf_sectionChart, a3m_Pnθ,
      Algebra.TensorProduct.productMap_apply_tmul]
  · intro k
    have h := a3h_awayLift_mk (UniversalGrading n) f hu
      (isHomogeneous_X (ULift.{0} ℤ) i) 1 (MvPolynomial.X k)
      (by simpa using isHomogeneous_X (ULift.{0} ℤ) k)
    simpa [IntersectionProductScaf_sectionChart, a3m_Pnθ,
      Algebra.TensorProduct.productMap_apply_tmul, chartCoordinate] using h.symm

/-- The complex section chart represents the projective map over its scalar base. -/
theorem IntersectionProductScaf_sectionChart_map
    (hf : (HomogeneousIdeal.irrelevant (UniversalGrading n)).toIdeal.map f = ⊤) :
    Z.left.toSpecΓ ≫ Spec.map (CommRingCat.ofHom
        (IntersectionProductScaf_sectionChart Z f i hu)) ≫ a3m_Pnκ n i =
      pullback.lift Z.hom (Proj.fromOfGlobalSections (UniversalGrading n) f hf)
        (terminal.hom_ext _ _) := by
  apply pullback.hom_ext
  · simp only [Category.assoc, pullback.lift_fst]
    rw [a3m_Pnκ, a3m_prodChart_fst, Category.comp_id, ← Spec.map_comp]
    have h : (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom
        (R := ℤ) (A := ℂ) (B := HomogeneousLocalization.Away (UniversalGrading n)
          (MvPolynomial.X i)))) ≫
        CommRingCat.ofHom (IntersectionProductScaf_sectionChart Z f i hu) =
        (Scheme.ΓSpecIso (CommRingCat.of ℂ)).inv ≫ Z.hom.appTop := by
      ext c
      simp [IntersectionProductScaf_sectionChart, IntersectionProductScaf_complexScalars,
        Algebra.TensorProduct.productMap_apply_tmul]
    rw [h, Spec.map_comp, ← Category.assoc, ← Scheme.toSpecΓ_naturality,
      Category.assoc, toSpecΓ_SpecMap_ΓSpecIso_inv, Category.comp_id]
  · simp only [Category.assoc, pullback.lift_snd]
    rw [a3m_Pnκ, a3m_prodChart_snd, ← Category.assoc (Spec.map _) (Spec.map _),
      ← Spec.map_comp]
    have h : (CommRingCat.ofHom (Algebra.TensorProduct.includeRight
        (R := ℤ) (A := ℂ) (B := HomogeneousLocalization.Away (UniversalGrading n)
          (MvPolynomial.X i))).toRingHom) ≫
        CommRingCat.ofHom (IntersectionProductScaf_sectionChart Z f i hu) =
        CommRingCat.ofHom (a3h_awayLift (UniversalGrading n) f hu) := by
      ext b
      simp [IntersectionProductScaf_sectionChart,
        Algebra.TensorProduct.productMap_apply_tmul]
    rw [h, a3h_fromOf_eq (UniversalGrading n) f hf zero_lt_one
      (isHomogeneous_X (ULift.{0} ℤ) i) hu]
    rfl

include i hu in
/-- On a unit coordinate chart, complex homogeneous ideal membership is detected by germs. -/
theorem IntersectionProductScaf_sectionChart_prime
    (hf : (HomogeneousIdeal.irrelevant (UniversalGrading n)).toIdeal.map f = ⊤)
    (x : Z.left) (F : MvPolynomial (Fin (n + 1)) ℂ) (d : ℕ)
    (hF : F.IsHomogeneous d) :
    F ∈ (a3m_projCharts n).prime
        (pullback.lift Z.hom (Proj.fromOfGlobalSections (UniversalGrading n) f hf)
          (terminal.hom_ext _ _) x) ↔
      ¬ IsUnit (Z.left.presheaf.germ ⊤ x (by trivial)
        (eval₂Hom (IntersectionProductScaf_complexScalars Z)
          (fun k => f (MvPolynomial.X k)) F)) := by
  let ψ := IntersectionProductScaf_sectionChart Z f i hu
  let p := Spec.map (CommRingCat.ofHom ψ) (Z.left.toSpecΓ x)
  have hp : (a3m_projCharts n).κ i p =
      pullback.lift Z.hom (Proj.fromOfGlobalSections (UniversalGrading n) f hf)
        (terminal.hom_ext _ _) x := by
    exact congrArg (fun g : Z.left ⟶ a3m_Pn n => g x)
      (IntersectionProductScaf_sectionChart_map Z f i hu hf)
  rw [(a3m_projCharts n).mem_prime_iff_of_isHomogeneous _ i p hp F d hF]
  change ψ (a3m_Pnθ n i F) ∈ (Z.left.toSpecΓ x).asIdeal ↔ _
  have hg : ∀ b : Γ(Z.left, ⊤), b ∈ (Z.left.toSpecΓ x).asIdeal ↔
      ¬ IsUnit (Z.left.presheaf.germ ⊤ x (by trivial) b) := by
    intro b
    have hb : b ∉ (Z.left.toSpecΓ x).asIdeal ↔
        IsUnit (Z.left.presheaf.germ ⊤ x (by trivial) b) := by
      rw [← PrimeSpectrum.mem_basicOpen, ← Scheme.mem_basicOpen_top]
      change x ∈ (Z.left.toSpecΓ ⁻¹ᵁ PrimeSpectrum.basicOpen b) ↔ _
      rw [Scheme.toSpecΓ_preimage_basicOpen]
    simpa only [not_not] using not_congr hb
  rw [hg, IntersectionProductScaf_sectionChart_equation Z f i hu F d hF,
    map_mul, map_pow]
  have hu' := (hu.map (Z.left.presheaf.germ ⊤ x (by trivial)).hom).pow d
  apply not_congr
  exact ⟨fun h => hu'.mul h, fun h => ((Commute.all _ _).isUnit_mul_iff.mp h).2⟩

#print axioms IntersectionProductScaf_sectionChart_prime

#print axioms IntersectionProductScaf_sectionChart_map

#print axioms IntersectionProductScaf_sectionChart_equation

/-- Evaluating complex equations in global sections commutes with morphisms over the base. -/
theorem IntersectionProductScaf_complexSections_natural
    (W : Over (Spec ↧ℂ)) (g : W ⟶ Z) :
    g.left.appTop.hom.comp
        (eval₂Hom (IntersectionProductScaf_complexScalars Z)
          (fun k => f (MvPolynomial.X k))) =
      eval₂Hom (IntersectionProductScaf_complexScalars W)
        (fun k => (g.left.appTop.hom.comp f) (MvPolynomial.X k)) := by
  apply MvPolynomial.ringHom_ext
  · intro c
    simp only [RingHom.comp_apply, coe_eval₂Hom, eval₂_C,
      IntersectionProductScaf_complexScalars]
    rw [← a3m_appTop_comp_apply, Over.w g]
  · intro k
    simp

#print axioms IntersectionProductScaf_complexSections_natural

/-- Complex homogeneous equations at any point are detected by the evaluated section germs. -/
theorem IntersectionProductScaf_complexSections_prime
    (hf : (HomogeneousIdeal.irrelevant (UniversalGrading n)).toIdeal.map f = ⊤)
    (x : Z.left) (F : MvPolynomial (Fin (n + 1)) ℂ) (d : ℕ)
    (hF : F.IsHomogeneous d) :
    F ∈ (a3m_projCharts n).prime
        (pullback.lift Z.hom (Proj.fromOfGlobalSections (UniversalGrading n) f hf)
          (terminal.hom_ext _ _) x) ↔
      ¬ IsUnit (Z.left.presheaf.germ ⊤ x (by trivial)
        (eval₂Hom (IntersectionProductScaf_complexScalars Z)
          (fun k => f (MvPolynomial.X k)) F)) := by
  let φ := Proj.fromOfGlobalSections (UniversalGrading n) f hf
  have hx : φ x ∈ (⊤ : (g3c_P n).Opens) := trivial
  rw [← iSup_coordinateBasicOpen_eq_top n, TopologicalSpace.Opens.mem_iSup] at hx
  obtain ⟨i, hi⟩ := hx
  have hxi : x ∈ Z.left.basicOpen (f (MvPolynomial.X i)) := by
    change x ∈ (φ ⁻¹ᵁ Proj.basicOpen (UniversalGrading n) (MvPolynomial.X i)) at hi
    rwa [Proj.fromOfGlobalSections_preimage_basicOpen _ _ _ zero_lt_one
      (isHomogeneous_X (ULift.{0} ℤ) i)] at hi
  let U := Z.left.basicOpen (f (MvPolynomial.X i))
  let W : Over (Spec ↧ℂ) := Over.mk (U.ι ≫ Z.hom)
  let g : W ⟶ Z := Over.homMk U.ι rfl
  let f' := g.left.appTop.hom.comp f
  have hf' : (HomogeneousIdeal.irrelevant (UniversalGrading n)).toIdeal.map f' = ⊤ := by
    rw [← Ideal.map_map, hf, Ideal.map_top]
  have hu' : IsUnit (f' (MvPolynomial.X i)) := by
    apply W.left.toRingedSpace.isUnit_of_isUnit_germ ⊤
    intro y hy
    rw [← Scheme.mem_basicOpen_top]
    change y ∈ W.left.basicOpen (g.left.appTop (f (MvPolynomial.X i)))
    rw [← Scheme.preimage_basicOpen_top]
    exact y.property
  have hmap : g.left ≫ (pullback.lift Z.hom φ (terminal.hom_ext _ _) :
      Z.left ⟶ a3m_Pn n) =
      pullback.lift W.hom (Proj.fromOfGlobalSections (UniversalGrading n) f' hf')
        (terminal.hom_ext _ _) := by
    apply pullback.hom_ext
    · simp only [Category.assoc, pullback.lift_fst]
      exact Over.w g
    · simp only [Category.assoc, pullback.lift_snd]
      exact spec_g3c_comp_fromOfGlobalSections_aux _ g.left f hf hf'
  have hp := IntersectionProductScaf_sectionChart_prime W f' i hu' hf'
    ⟨x, hxi⟩ F d hF
  have hxmap := congrArg (fun m : W.left ⟶ a3m_Pn n => m ⟨x, hxi⟩) hmap
  rw [Scheme.Hom.comp_apply] at hxmap
  change (pullback.lift Z.hom φ (terminal.hom_ext _ _) :
    Z.left ⟶ a3m_Pn n) x = _ at hxmap
  rw [← hxmap] at hp
  rw [hp]
  have he := congrArg (fun r : MvPolynomial (Fin (n + 1)) ℂ →+* Γ(W.left, ⊤) => r F)
    (IntersectionProductScaf_complexSections_natural Z f W g)
  change g.left.appTop _ = _ at he
  rw [← he]
  apply not_congr
  rw [← Scheme.mem_basicOpen_top, ← Scheme.mem_basicOpen_top]
  change (⟨x, hxi⟩ : W.left) ∈ W.left.basicOpen (g.left.appTop _) ↔ _
  rw [← Scheme.preimage_basicOpen_top]
  rfl

#print axioms IntersectionProductScaf_complexSections_prime

end ComplexSectionCharts

section RelativeSectionCharts
open CategoryTheory.Limits MvPolynomial
attribute [local instance] MvPolynomial.gradedAlgebra
attribute [local instance] Ring.toIntAlgebra AddCommGroup.toIntModule
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
variable {n : ℕ} (Z : Over (Spec ↧ℂ))
  (f : UniversalRing n →+* Γ(Z.left, ⊤)) (i : Fin (n + 1))
  (hu : IsUnit (f (MvPolynomial.X i))) (g : a3m_Away1 →+* Γ(Z.left, ⊤))

/-- Evaluating a projective chart and an affine parameter in global sections. -/
def IntersectionProductScaf_relativeSectionChart :
    a3m_TT (a3m_projCharts n) i →+* Γ(Z.left, ⊤) :=
  (Algebra.TensorProduct.productMap
    (IntersectionProductScaf_sectionChart Z f i hu).toIntAlgHom
    g.toIntAlgHom).toRingHom

/-- Relative homogeneous equations retain their parameter under dehomogenization. -/
theorem IntersectionProductScaf_relativeSectionChart_equation
    (F : MvPolynomial (Fin (n + 1)) (Polynomial ℂ))
    (d : ℕ) (hF : F.IsHomogeneous d) :
    eval₂Hom (Polynomial.eval₂RingHom (IntersectionProductScaf_complexScalars Z)
        (g a3m_t₁)) (fun k => f (MvPolynomial.X k)) F =
      f (MvPolynomial.X i) ^ d *
        IntersectionProductScaf_relativeSectionChart Z f i hu g
          (a3m_Tθ (a3m_projCharts n) i F) := by
  apply a3m_twist
    (eval₂Hom (Polynomial.eval₂RingHom (IntersectionProductScaf_complexScalars Z)
      (g a3m_t₁)) (fun k => f (MvPolynomial.X k)))
    ((IntersectionProductScaf_relativeSectionChart Z f i hu g).comp
      (a3m_Tθ (a3m_projCharts n) i)) (f (MvPolynomial.X i)) _ _ F d hF
  · intro r
    induction r using Polynomial.induction_on' with
    | add p q hp hq => simp only [map_add, hp, hq]
    | monomial k c =>
      rw [← Polynomial.C_mul_X_pow_eq_monomial]
      simp [IntersectionProductScaf_relativeSectionChart, a3m_Tθ,
        IntersectionProductScaf_sectionChart, a3m_projCharts, a3m_Pnθ,
        Algebra.TensorProduct.productMap_apply_tmul]
  · intro k
    have h := IntersectionProductScaf_sectionChart_equation Z f i hu
      (MvPolynomial.X k) 1 (isHomogeneous_X ℂ k)
    simpa [IntersectionProductScaf_relativeSectionChart, a3m_Tθ,
      a3m_projCharts, Algebra.TensorProduct.productMap_apply_tmul] using h
#print axioms IntersectionProductScaf_relativeSectionChart_equation


/-- The relative section chart represents the product of the projective map and parameter. -/
theorem IntersectionProductScaf_relativeSectionChart_map
    (hf : (HomogeneousIdeal.irrelevant (UniversalGrading n)).toIdeal.map f = ⊤) :
    Z.left.toSpecΓ ≫ Spec.map (CommRingCat.ofHom
        (IntersectionProductScaf_relativeSectionChart Z f i hu g)) ≫
        a3m_Tκ (a3m_projCharts n) i =
      pullback.lift
        (pullback.lift Z.hom (Proj.fromOfGlobalSections (UniversalGrading n) f hf)
          (terminal.hom_ext _ _))
        (Z.left.toSpecΓ ≫ Spec.map (CommRingCat.ofHom g) ≫ g3c_chartι 1 0)
        (terminal.hom_ext _ _) := by
  apply pullback.hom_ext
  · simp only [Category.assoc, pullback.lift_fst, a3m_Tκ, a3m_prodChart_fst]
    rw [← Category.assoc (Spec.map _) (Spec.map _), ← Spec.map_comp]
    have he : (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom
        (R := ℤ) (A := a3m_PnT n i) (B := a3m_Away1))) ≫
        CommRingCat.ofHom (IntersectionProductScaf_relativeSectionChart Z f i hu g) =
        CommRingCat.ofHom (IntersectionProductScaf_sectionChart Z f i hu) := by
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro b
      change (Algebra.TensorProduct.productMap
        (IntersectionProductScaf_sectionChart Z f i hu).toIntAlgHom g.toIntAlgHom)
        (b ⊗ₜ[ℤ] 1) = _
      change IntersectionProductScaf_sectionChart Z f i hu b * g 1 = _
      simp
    rw [he]
    exact IntersectionProductScaf_sectionChart_map Z f i hu hf
  · simp only [Category.assoc, pullback.lift_snd, a3m_Tκ, a3m_prodChart_snd]
    rw [← Category.assoc (Spec.map _) (Spec.map _), ← Spec.map_comp]
    congr 2
    congr 1
    ext b
    change (Algebra.TensorProduct.productMap
      (IntersectionProductScaf_sectionChart Z f i hu).toIntAlgHom g.toIntAlgHom)
      (1 ⊗ₜ[ℤ] b) = g b
    change IntersectionProductScaf_sectionChart Z f i hu 1 * g b = g b
    simp
#print axioms IntersectionProductScaf_relativeSectionChart_map

/-- Relative cone membership is detected by evaluated equations on a unit coordinate chart. -/
theorem IntersectionProductScaf_relativeSectionChart_prime
    (x : Z.left) (y : (a3m_U (a3m_Pn n)).toScheme)
    (hy : (Z.left.toSpecΓ ≫ Spec.map (CommRingCat.ofHom
        (IntersectionProductScaf_relativeSectionChart Z f i hu g)) ≫
        a3m_Tκ (a3m_projCharts n) i) x = (a3m_U (a3m_Pn n)).ι y)
    (F : MvPolynomial (Fin (n + 1)) (Polynomial ℂ))
    (d : ℕ) (hF : F.IsHomogeneous d) :
    F ∈ (a3m_lineCharts (a3m_projCharts n) (a3m_Pn_hov n)).prime y ↔
      ¬ IsUnit (Z.left.presheaf.germ ⊤ x (by trivial)
        (eval₂Hom (Polynomial.eval₂RingHom (IntersectionProductScaf_complexScalars Z)
          (g a3m_t₁)) (fun k => f (MvPolynomial.X k)) F)) := by
  let ψ := IntersectionProductScaf_relativeSectionChart Z f i hu g
  let p := Spec.map (CommRingCat.ofHom ψ) (Z.left.toSpecΓ x)
  have hp : (a3m_lineCharts (a3m_projCharts n) (a3m_Pn_hov n)).κ i p = y := by
    apply (a3m_U (a3m_Pn n)).ι.isOpenEmbedding.injective
    rw [← Scheme.Hom.comp_apply, a3m_lineCharts_κ]
    exact hy
  rw [(a3m_lineCharts (a3m_projCharts n) (a3m_Pn_hov n)).mem_prime_iff_of_isHomogeneous
    _ i p hp F d hF]
  change ψ (a3m_Tθ (a3m_projCharts n) i F) ∈ (Z.left.toSpecΓ x).asIdeal ↔ _
  have hg : ∀ b : Γ(Z.left, ⊤), b ∈ (Z.left.toSpecΓ x).asIdeal ↔
      ¬ IsUnit (Z.left.presheaf.germ ⊤ x (by trivial) b) := by
    intro b
    have hb : b ∉ (Z.left.toSpecΓ x).asIdeal ↔
        IsUnit (Z.left.presheaf.germ ⊤ x (by trivial) b) := by
      rw [← PrimeSpectrum.mem_basicOpen, ← Scheme.mem_basicOpen_top]
      change x ∈ (Z.left.toSpecΓ ⁻¹ᵁ PrimeSpectrum.basicOpen b) ↔ _
      rw [Scheme.toSpecΓ_preimage_basicOpen]
    simpa only [not_not] using not_congr hb
  rw [hg, IntersectionProductScaf_relativeSectionChart_equation Z f i hu g F d hF,
    map_mul, map_pow]
  have hu' := (hu.map (Z.left.presheaf.germ ⊤ x (by trivial)).hom).pow d
  apply not_congr
  exact ⟨fun h => hu'.mul h, fun h => ((Commute.all _ _).isUnit_mul_iff.mp h).2⟩
#print axioms IntersectionProductScaf_relativeSectionChart_prime

/-- Evaluating relative homogeneous equations commutes with morphisms over the scalar base. -/
theorem IntersectionProductScaf_relativeSections_natural
    (W : Over (Spec ↧ℂ)) (h : W ⟶ Z) :
    h.left.appTop.hom.comp
        (eval₂Hom (Polynomial.eval₂RingHom (IntersectionProductScaf_complexScalars Z)
          (g a3m_t₁)) (fun k => f (MvPolynomial.X k))) =
      eval₂Hom (Polynomial.eval₂RingHom (IntersectionProductScaf_complexScalars W)
        ((h.left.appTop.hom.comp g) a3m_t₁))
        (fun k => (h.left.appTop.hom.comp f) (MvPolynomial.X k)) := by
  apply MvPolynomial.ringHom_ext
  · intro r
    induction r using Polynomial.induction_on' with
    | add p q hp hq => simp only [map_add, hp, hq]
    | monomial k c =>
      rw [← Polynomial.C_mul_X_pow_eq_monomial]
      simp only [map_mul, map_pow, RingHom.comp_apply, coe_eval₂Hom, eval₂_C,
        Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C, Polynomial.eval₂_X]
      congr 1
      simp only [IntersectionProductScaf_complexScalars, RingHom.comp_apply]
      rw [← a3m_appTop_comp_apply, Over.w h]
  · intro k
    simp
#print axioms IntersectionProductScaf_relativeSections_natural


/-- Relative cone equations are detected by section germs without a chosen unit coordinate. -/
theorem IntersectionProductScaf_relativeSections_prime
    (hf : (HomogeneousIdeal.irrelevant (UniversalGrading n)).toIdeal.map f = ⊤)
    (x : Z.left) (y : (a3m_U (a3m_Pn n)).toScheme)
    (hy : (pullback.lift
        (pullback.lift Z.hom (Proj.fromOfGlobalSections (UniversalGrading n) f hf)
          (terminal.hom_ext _ _))
        (Z.left.toSpecΓ ≫ Spec.map (CommRingCat.ofHom g) ≫ g3c_chartι 1 0)
        (terminal.hom_ext _ _) : Z.left ⟶ a3m_T (a3m_Pn n)) x =
          (a3m_U (a3m_Pn n)).ι y)
    (F : MvPolynomial (Fin (n + 1)) (Polynomial ℂ))
    (d : ℕ) (hF : F.IsHomogeneous d) :
    F ∈ (a3m_lineCharts (a3m_projCharts n) (a3m_Pn_hov n)).prime y ↔
      ¬ IsUnit (Z.left.presheaf.germ ⊤ x (by trivial)
        (eval₂Hom (Polynomial.eval₂RingHom (IntersectionProductScaf_complexScalars Z)
          (g a3m_t₁)) (fun k => f (MvPolynomial.X k)) F)) := by
  let φ := Proj.fromOfGlobalSections (UniversalGrading n) f hf
  have hx : φ x ∈ (⊤ : (g3c_P n).Opens) := trivial
  rw [← iSup_coordinateBasicOpen_eq_top n, TopologicalSpace.Opens.mem_iSup] at hx
  obtain ⟨i, hi⟩ := hx
  have hxi : x ∈ Z.left.basicOpen (f (MvPolynomial.X i)) := by
    change x ∈ (φ ⁻¹ᵁ Proj.basicOpen (UniversalGrading n) (MvPolynomial.X i)) at hi
    rwa [Proj.fromOfGlobalSections_preimage_basicOpen _ _ _ zero_lt_one
      (isHomogeneous_X (ULift.{0} ℤ) i)] at hi
  let U := Z.left.basicOpen (f (MvPolynomial.X i))
  let W : Over (Spec ↧ℂ) := Over.mk (U.ι ≫ Z.hom)
  let h : W ⟶ Z := Over.homMk U.ι rfl
  let f' := h.left.appTop.hom.comp f
  let g' := h.left.appTop.hom.comp g
  have hf' : (HomogeneousIdeal.irrelevant (UniversalGrading n)).toIdeal.map f' = ⊤ := by
    rw [← Ideal.map_map, hf, Ideal.map_top]
  have hu' : IsUnit (f' (MvPolynomial.X i)) := by
    apply W.left.toRingedSpace.isUnit_of_isUnit_germ ⊤
    intro z hz
    rw [← Scheme.mem_basicOpen_top]
    change z ∈ W.left.basicOpen (h.left.appTop (f (MvPolynomial.X i)))
    rw [← Scheme.preimage_basicOpen_top]
    exact z.property
  have hmap : h.left ≫ (pullback.lift
      (pullback.lift Z.hom φ (terminal.hom_ext _ _))
      (Z.left.toSpecΓ ≫ Spec.map (CommRingCat.ofHom g) ≫ g3c_chartι 1 0)
      (terminal.hom_ext _ _) : Z.left ⟶ a3m_T (a3m_Pn n)) =
      W.left.toSpecΓ ≫ Spec.map (CommRingCat.ofHom
        (IntersectionProductScaf_relativeSectionChart W f' i hu' g')) ≫
          a3m_Tκ (a3m_projCharts n) i := by
    rw [IntersectionProductScaf_relativeSectionChart_map W f' i hu' g' hf']
    apply pullback.hom_ext
    · simp only [Category.assoc, pullback.lift_fst]
      apply pullback.hom_ext
      · simp only [Category.assoc, pullback.lift_fst]
        exact Over.w h
      · simp only [Category.assoc, pullback.lift_snd]
        exact spec_g3c_comp_fromOfGlobalSections_aux _ h.left f hf hf'
    · simp only [Category.assoc, pullback.lift_snd]
      rw [← Category.assoc h.left Z.left.toSpecΓ, Scheme.toSpecΓ_naturality,
        Category.assoc, ← Category.assoc (Spec.map _) (Spec.map _), ← Spec.map_comp]
      rfl
  have hy' : (W.left.toSpecΓ ≫ Spec.map (CommRingCat.ofHom
        (IntersectionProductScaf_relativeSectionChart W f' i hu' g')) ≫
        a3m_Tκ (a3m_projCharts n) i) ⟨x, hxi⟩ = (a3m_U (a3m_Pn n)).ι y := by
    rw [← hmap, Scheme.Hom.comp_apply]
    exact hy
  rw [IntersectionProductScaf_relativeSectionChart_prime W f' i hu' g' ⟨x, hxi⟩ y hy' F d hF]
  have he := congrArg (fun r : MvPolynomial (Fin (n + 1)) (Polynomial ℂ) →+*
      Γ(W.left, ⊤) => r F)
    (IntersectionProductScaf_relativeSections_natural Z f g W h)
  change h.left.appTop _ = _ at he
  rw [← he]
  apply not_congr
  rw [← Scheme.mem_basicOpen_top, ← Scheme.mem_basicOpen_top]
  change (⟨x, hxi⟩ : W.left) ∈ W.left.basicOpen (h.left.appTop _) ↔ _
  rw [← Scheme.preimage_basicOpen_top]
  rfl
#print axioms IntersectionProductScaf_relativeSections_prime

#print axioms IntersectionProductScaf_relativeSectionChart
end RelativeSectionCharts

section TranslatedProjection

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
open CategoryTheory.Limits MvPolynomial

attribute [local instance] MvPolynomial.gradedAlgebra
variable (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] {n : ℕ}
  {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
  (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp (a3r_lin (a3r_mat a)).toRingHom).Finite)
  (Z : Over (Spec ↧ℂ)) (q : Z.left ⟶ X.left)
  (A : Matrix (Fin (n + 1)) (Fin (n + 1)) Γ(Z.left, ⊤)) (hA : IsUnit A.det)

/-- Pullback of the projection charts to a translation domain. -/
abbrev IntersectionProductScaf_projectionCover : Z.left.OpenCover where
  __ := (a3h_cover X).pullback₁ q
  I₀ := Fin (a3s_N X + 1)
  X j := pullback q ((a3s_CX X).κ j)
  f j := pullback.fst q ((a3s_CX X).κ j)

/-- The affine open in a translation domain supplied by one projection chart. -/
def IntersectionProductScaf_projectionAffine (j : Fin (a3s_N X + 1))
    [IsAffine ((IntersectionProductScaf_projectionCover X Z q).X j)] : Z.left.affineOpens :=
  ⟨(IntersectionProductScaf_projectionCover X Z q).f j |>.opensRange,
    isAffineOpen_opensRange ((IntersectionProductScaf_projectionCover X Z q).f j)⟩

/-- Every point of a translation domain belongs to one affine projection chart. -/
theorem IntersectionProductScaf_mem_projectionAffine
    [∀ j, IsAffine ((IntersectionProductScaf_projectionCover X Z q).X j)] (z : Z.left) :
    ∃ j, z ∈ (IntersectionProductScaf_projectionAffine X Z q j).1 := by
  let C := IntersectionProductScaf_projectionCover X Z q
  obtain ⟨x, hx⟩ := C.covers z
  exact ⟨C.idx z, Scheme.Hom.mem_opensRange.mpr ⟨x, hx⟩⟩

/-- The original projection sections restricted to a translation chart. -/
def IntersectionProductScaf_projectionSections (j : Fin (a3s_N X + 1)) :
    UniversalRing n →+* Γ((IntersectionProductScaf_projectionCover X Z q).X j, ⊤) :=
  (pullback.snd q ((a3s_CX X).κ j)).appTop.hom.comp (a3h_sect X (a3r_mat a) j)

/-- The translation matrix restricted to a projection chart. -/
def IntersectionProductScaf_chartMatrix (j : Fin (a3s_N X + 1)) :=
  ((IntersectionProductScaf_projectionCover X Z q).f j).appTop.hom.mapMatrix A

/-- The translated homogeneous sections on a projection chart. -/
def IntersectionProductScaf_translatedSections (j : Fin (a3s_N X + 1)) :=
  IntersectionProductScaf_matrixSections (IntersectionProductScaf_chartMatrix X Z q A j)
    (IntersectionProductScaf_projectionSections X (a := a) Z q j)

include hfin hA in
/-- The translated sections generate the unit ideal on each chart. -/
theorem IntersectionProductScaf_translatedSections_irrelevant (j : Fin (a3s_N X + 1)) :
    (HomogeneousIdeal.irrelevant (UniversalGrading n)).toIdeal.map
      (IntersectionProductScaf_translatedSections X (a := a) Z q A j) = ⊤ := by
  rw [IntersectionProductScaf_translatedSections,
    IntersectionProductScaf_matrixSections_irrelevant _ (by
      erw [IntersectionProductScaf_chartMatrix, ← RingHom.map_det]
      exact hA.map _), IntersectionProductScaf_projectionSections,
    ← Ideal.map_map, a3h_sect_irrelevant X hfin, Ideal.map_top]

/-- The projective map defined by the translated sections on a chart. -/
def IntersectionProductScaf_translatedChart (j : Fin (a3s_N X + 1)) :
    (IntersectionProductScaf_projectionCover X Z q).X j ⟶ g3c_P n :=
  Proj.fromOfGlobalSections (UniversalGrading n)
    (IntersectionProductScaf_translatedSections X (a := a) Z q A j)
    (IntersectionProductScaf_translatedSections_irrelevant X hfin Z q A hA j)

/-- Original affine coordinates on the pulled-back charts. -/
def IntersectionProductScaf_chartCoordinates (j : Fin (a3s_N X + 1)) :
    MvPolynomial (Fin (a3s_N X + 1)) ℂ →+*
      Γ((IntersectionProductScaf_projectionCover X Z q).X j, ⊤) :=
  (pullback.snd q ((a3s_CX X).κ j)).appTop.hom.comp
    ((Scheme.ΓSpecIso ((a3s_CX X).T j)).inv.hom.comp ((a3s_CX X).θ j))

/-- Original affine coordinates carry the scalar structure of the translation domain. -/
theorem IntersectionProductScaf_chartCoordinates_scalar
    (hq : q ≫ X.hom = Z.hom) (j : Fin (a3s_N X + 1)) (c : ℂ) :
    IntersectionProductScaf_chartCoordinates X Z q j (MvPolynomial.C c) =
      IntersectionProductScaf_complexScalars
        (Over.mk ((IntersectionProductScaf_projectionCover X Z q).f j ≫ Z.hom)) c := by
  change (pullback.snd q ((a3s_CX X).κ j)).appTop
      ((Scheme.ΓSpecIso ((a3s_CX X).T j)).inv ((a3s_CX X).θ j (MvPolynomial.C c))) =
    (pullback.fst q ((a3s_CX X).κ j) ≫ Z.hom).appTop
      ((Scheme.ΓSpecIso (CommRingCat.of ℂ)).inv c)
  rw [← hq, ← Category.assoc, pullback.condition, Category.assoc, a3h_κ_hom,
    a3m_appTop_comp_SpecMap]
  rfl

#print axioms IntersectionProductScaf_chartCoordinates_scalar

/-- Coordinate changes on the original projection charts persist after pullback. -/
theorem IntersectionProductScaf_chartCoordinates_overlap
    (j l : Fin (a3s_N X + 1))
    (F : MvPolynomial (Fin (a3s_N X + 1)) ℂ) (d : ℕ) (hF : F.IsHomogeneous d) :
    (pullback.snd ((IntersectionProductScaf_projectionCover X Z q).f j)
        ((IntersectionProductScaf_projectionCover X Z q).f l)).appTop
      (IntersectionProductScaf_chartCoordinates X Z q l F) =
    (pullback.snd ((IntersectionProductScaf_projectionCover X Z q).f j)
        ((IntersectionProductScaf_projectionCover X Z q).f l)).appTop
      (IntersectionProductScaf_chartCoordinates X Z q l (MvPolynomial.X j)) ^ d *
    (pullback.fst ((IntersectionProductScaf_projectionCover X Z q).f j)
        ((IntersectionProductScaf_projectionCover X Z q).f l)).appTop
      (IntersectionProductScaf_chartCoordinates X Z q j F) := by
  let C := IntersectionProductScaf_projectionCover X Z q
  let f₁ := pullback.fst (C.f j) (C.f l)
  let f₂ := pullback.snd (C.f j) (C.f l)
  let r₁ := pullback.snd q ((a3s_CX X).κ j)
  let r₂ := pullback.snd q ((a3s_CX X).κ l)
  have hcond : (f₁ ≫ r₁) ≫ (a3s_CX X).κ j = (f₂ ≫ r₂) ≫ (a3s_CX X).κ l := by
    dsimp only [r₁, r₂]
    rw [Category.assoc, Category.assoc, ← pullback.condition, ← pullback.condition,
      ← Category.assoc, ← Category.assoc]
    exact congrArg (fun f => f ≫ q) (pullback.condition (f := C.f j) (g := C.f l))
  let ρ := pullback.lift _ _ hcond
  have h := congrArg ρ.appTop.hom (a3h_hov X j l F d hF)
  rw [map_mul, map_pow, ← a3m_appTop_comp_apply, ← a3m_appTop_comp_apply,
    ← a3m_appTop_comp_apply, pullback.lift_fst, pullback.lift_snd] at h
  simpa only [a3m_appTop_comp_apply, IntersectionProductScaf_chartCoordinates,
    RingHom.comp_apply, C, f₁, f₂, r₁, r₂] using h

/-- The coordinate ratio on an overlap is a unit. -/
theorem IntersectionProductScaf_chartCoordinates_unit (j l : Fin (a3s_N X + 1)) :
    IsUnit ((pullback.snd ((IntersectionProductScaf_projectionCover X Z q).f j)
        ((IntersectionProductScaf_projectionCover X Z q).f l)).appTop
      (IntersectionProductScaf_chartCoordinates X Z q l (MvPolynomial.X j))) := by
  let C := IntersectionProductScaf_projectionCover X Z q
  let u := (pullback.snd (C.f j) (C.f l)).appTop
    (IntersectionProductScaf_chartCoordinates X Z q l (MvPolynomial.X j))
  let v := (pullback.fst (C.f j) (C.f l)).appTop
    (IntersectionProductScaf_chartCoordinates X Z q j (MvPolynomial.X l))
  have h := IntersectionProductScaf_chartCoordinates_overlap X Z q j l
    (MvPolynomial.X l) 1 (isHomogeneous_X ℂ l)
  have huv : u * v = 1 := by
    simpa only [IntersectionProductScaf_chartCoordinates, RingHom.comp_apply,
      (a3s_CX X).θ_X_self, map_one, pow_one, u, v] using h.symm
  exact (Units.mkOfMulEqOne u v huv).isUnit


include hfin hA in
/-- Translated projective chart maps agree on every overlap. -/
theorem IntersectionProductScaf_translatedChart_compat (j l : Fin (a3s_N X + 1)) :
    pullback.fst ((IntersectionProductScaf_projectionCover X Z q).f j)
        ((IntersectionProductScaf_projectionCover X Z q).f l) ≫
      IntersectionProductScaf_translatedChart X hfin Z q A hA j =
    pullback.snd ((IntersectionProductScaf_projectionCover X Z q).f j)
        ((IntersectionProductScaf_projectionCover X Z q).f l) ≫
      IntersectionProductScaf_translatedChart X hfin Z q A hA l := by
  let C := IntersectionProductScaf_projectionCover X Z q
  let p₁ := pullback.fst (C.f j) (C.f l)
  let p₂ := pullback.snd (C.f j) (C.f l)
  let f₁ := p₁.appTop.hom.comp (IntersectionProductScaf_translatedSections X (a := a) Z q A j)
  let f₂ := p₂.appTop.hom.comp (IntersectionProductScaf_translatedSections X (a := a) Z q A l)
  have h₁ : (HomogeneousIdeal.irrelevant (UniversalGrading n)).toIdeal.map f₁ = ⊤ := by
    dsimp only [f₁]
    rw [← Ideal.map_map, IntersectionProductScaf_translatedSections_irrelevant X hfin Z q A hA,
      Ideal.map_top]
  have h₂ : (HomogeneousIdeal.irrelevant (UniversalGrading n)).toIdeal.map f₂ = ⊤ := by
    dsimp only [f₂]
    rw [← Ideal.map_map, IntersectionProductScaf_translatedSections_irrelevant X hfin Z q A hA,
      Ideal.map_top]
  rw [IntersectionProductScaf_translatedChart, IntersectionProductScaf_translatedChart,
    spec_g3c_comp_fromOfGlobalSections_aux _ _ _ _ h₁,
    spec_g3c_comp_fromOfGlobalSections_aux _ _ _ _ h₂]
  let u := p₂.appTop (IntersectionProductScaf_chartCoordinates X Z q l (MvPolynomial.X j))
  have hu : IsUnit u := IntersectionProductScaf_chartCoordinates_unit X Z q j l
  apply spec_g3c_fromOfGlobalSections_unit_twist_aux _ f₁ f₂ h₁ h₂ hu.unit
  intro d r hr
  rw [hu.unit_spec]
  have hmat : p₁.appTop.hom.mapMatrix (IntersectionProductScaf_chartMatrix X Z q A j) =
      p₂.appTop.hom.mapMatrix (IntersectionProductScaf_chartMatrix X Z q A l) := by
    ext i k
    change p₁.appTop ((C.f j).appTop (A i k)) = p₂.appTop ((C.f l).appTop (A i k))
    rw [← a3m_appTop_comp_apply, ← a3m_appTop_comp_apply]
    exact congrArg (fun f : _ ⟶ Z.left => f.appTop (A i k)) pullback.condition
  change (p₂.appTop.hom.comp (IntersectionProductScaf_matrixSections _ _)) r =
    u ^ d * (p₁.appTop.hom.comp (IntersectionProductScaf_matrixSections _ _)) r
  rw [IntersectionProductScaf_matrixSections_map, IntersectionProductScaf_matrixSections_map]
  erw [hmat]
  apply IntersectionProductScaf_matrixSections_twist _ _ _ u _ _ r d hr
  · intro z
    obtain ⟨z⟩ := z
    have hz : (MvPolynomial.C (ULift.up z) : UniversalRing n) = (z : UniversalRing n) := by
      norm_cast
    rw [hz]
    simp only [map_intCast]
  · intro i
    change p₂.appTop (IntersectionProductScaf_chartCoordinates X Z q l
        (a3h_sub (a3r_mat a) (MvPolynomial.X i))) =
      u * p₁.appTop (IntersectionProductScaf_chartCoordinates X Z q j
        (a3h_sub (a3r_mat a) (MvPolynomial.X i)))
    rw [a3h_sub_X]
    simpa only [pow_one] using
      IntersectionProductScaf_chartCoordinates_overlap X Z q j l
        (a3r_lin (a3r_mat a) (MvPolynomial.X i)) 1
        (a3r_lin_X_isHomogeneous (a3r_mat a) i)

/-- The projective translation map assembled from its explicit homogeneous sections. -/
def IntersectionProductScaf_translatedProjection₀ : Z.left ⟶ g3c_P n :=
  (IntersectionProductScaf_projectionCover X Z q).glueMorphisms
    (IntersectionProductScaf_translatedChart X hfin Z q A hA)
    (IntersectionProductScaf_translatedChart_compat X hfin Z q A hA)

/-- The translated projection takes values in projective space over the complex numbers. -/
def IntersectionProductScaf_translatedProjection : Z ⟶ a3h_PnO n :=
  Over.homMk (pullback.lift Z.hom
    (IntersectionProductScaf_translatedProjection₀ X hfin Z q A hA)
    (terminal.hom_ext _ _)) (pullback.lift_fst _ _ _)


#print axioms IntersectionProductScaf_translatedSections_irrelevant
#print axioms IntersectionProductScaf_projectionAffine
#print axioms IntersectionProductScaf_mem_projectionAffine
#print axioms IntersectionProductScaf_chartCoordinates_overlap
#print axioms IntersectionProductScaf_chartCoordinates_unit
#print axioms IntersectionProductScaf_translatedChart_compat
#print axioms IntersectionProductScaf_translatedProjection

end TranslatedProjection

section TranslationNaturality

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
open CategoryTheory.Limits

attribute [local instance] MvPolynomial.gradedAlgebra
variable (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] {n : ℕ}
  {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
  (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp (a3r_lin (a3r_mat a)).toRingHom).Finite)
  (Z W : Over (Spec ↧ℂ)) (q : Z.left ⟶ X.left) (g : W.left ⟶ Z.left)
  (A : Matrix (Fin (n + 1)) (Fin (n + 1)) Γ(Z.left, ⊤)) (hA : IsUnit A.det)
  (hB : IsUnit (g.appTop.hom.mapMatrix A).det)

/-- Restriction between projection charts over a morphism of translation domains. -/
def IntersectionProductScaf_chartRestriction (j : Fin (a3s_N X + 1)) :
    (IntersectionProductScaf_projectionCover X W (g ≫ q)).X j ⟶
      (IntersectionProductScaf_projectionCover X Z q).X j :=
  pullback.lift (pullback.fst (g ≫ q) ((a3s_CX X).κ j) ≫ g)
    (pullback.snd (g ≫ q) ((a3s_CX X).κ j))
    ((Category.assoc _ _ _).trans pullback.condition)

/-- The explicit homogeneous translation sections commute with domain restriction. -/
theorem IntersectionProductScaf_translatedSections_natural (j : Fin (a3s_N X + 1)) :
    (IntersectionProductScaf_chartRestriction X Z W q g j).appTop.hom.comp
        (IntersectionProductScaf_translatedSections X (a := a) Z q A j) =
      IntersectionProductScaf_translatedSections X (a := a) W (g ≫ q)
        (g.appTop.hom.mapMatrix A) j := by
  rw [IntersectionProductScaf_translatedSections,
    IntersectionProductScaf_matrixSections_map, IntersectionProductScaf_translatedSections]
  congr 1
  · ext i k
    change (IntersectionProductScaf_chartRestriction X Z W q g j).appTop
      ((pullback.fst q ((a3s_CX X).κ j)).appTop (A i k)) =
        (pullback.fst (g ≫ q) ((a3s_CX X).κ j)).appTop (g.appTop (A i k))
    rw [← a3m_appTop_comp_apply, IntersectionProductScaf_chartRestriction, pullback.lift_fst,
      a3m_appTop_comp_apply]
  · apply RingHom.ext
    intro F
    change (IntersectionProductScaf_chartRestriction X Z W q g j).appTop
      ((pullback.snd q ((a3s_CX X).κ j)).appTop (a3h_sect X (a3r_mat a) j F)) =
        (pullback.snd (g ≫ q) ((a3s_CX X).κ j)).appTop (a3h_sect X (a3r_mat a) j F)
    rw [← a3m_appTop_comp_apply, IntersectionProductScaf_chartRestriction, pullback.lift_snd]

/-- Naturality of the translated projective chart maps. -/
theorem IntersectionProductScaf_translatedChart_natural (j : Fin (a3s_N X + 1)) :
    IntersectionProductScaf_chartRestriction X Z W q g j ≫
        IntersectionProductScaf_translatedChart X hfin Z q A hA j =
      IntersectionProductScaf_translatedChart X hfin W (g ≫ q)
        (g.appTop.hom.mapMatrix A) hB j := by
  have hi : (HomogeneousIdeal.irrelevant (UniversalGrading n)).toIdeal.map
      ((IntersectionProductScaf_chartRestriction X Z W q g j).appTop.hom.comp
        (IntersectionProductScaf_translatedSections X (a := a) Z q A j)) = ⊤ := by
    rw [IntersectionProductScaf_translatedSections_natural]
    exact IntersectionProductScaf_translatedSections_irrelevant X hfin W (g ≫ q) _ hB j
  rw [IntersectionProductScaf_translatedChart,
    spec_g3c_comp_fromOfGlobalSections_aux _ _ _ _ hi]
  unfold IntersectionProductScaf_translatedChart
  congr 1
  exact IntersectionProductScaf_translatedSections_natural X Z W q g A j

/-- On a chart the glued projection is the explicit section map. -/
theorem IntersectionProductScaf_translatedProjection₀_chart (j : Fin (a3s_N X + 1)) :
    (IntersectionProductScaf_projectionCover X Z q).f j ≫
        IntersectionProductScaf_translatedProjection₀ X hfin Z q A hA =
      IntersectionProductScaf_translatedChart X hfin Z q A hA j :=
  (IntersectionProductScaf_projectionCover X Z q).ι_glueMorphisms _ _ j

/-- The explicit translated sections extended to complex homogeneous polynomials. -/
def IntersectionProductScaf_translatedComplexSections (j : Fin (a3s_N X + 1)) :
    MvPolynomial (Fin (n + 1)) ℂ →+*
      Γ((IntersectionProductScaf_projectionCover X Z q).X j, ⊤) :=
  MvPolynomial.eval₂Hom
    (IntersectionProductScaf_complexScalars
      (Over.mk ((IntersectionProductScaf_projectionCover X Z q).f j ≫ Z.hom)))
    (fun k => IntersectionProductScaf_translatedSections X (a := a) Z q A j
      (MvPolynomial.X k))

/-- Complex translated equations are the matrix substitution in the original affine coordinates. -/
theorem IntersectionProductScaf_translatedComplexSections_matrix
    (hq : q ≫ X.hom = Z.hom) (j : Fin (a3s_N X + 1)) :
    IntersectionProductScaf_translatedComplexSections X (a := a) Z q A j =
      IntersectionProductScaf_matrixSections (IntersectionProductScaf_chartMatrix X Z q A j)
        ((IntersectionProductScaf_chartCoordinates X Z q j).comp
          (a3r_lin (a3r_mat a)).toRingHom) := by
  apply MvPolynomial.ringHom_ext
  · intro c
    simp only [IntersectionProductScaf_translatedComplexSections,
      IntersectionProductScaf_matrixSections, MvPolynomial.coe_eval₂Hom,
      MvPolynomial.eval₂_C, RingHom.comp_apply, AlgHom.toRingHom_eq_coe,
      RingHom.coe_coe, MvPolynomial.algHom_C]
    exact (IntersectionProductScaf_chartCoordinates_scalar X Z q hq j c).symm
  · intro k
    simp [IntersectionProductScaf_translatedComplexSections,
      IntersectionProductScaf_translatedSections, IntersectionProductScaf_matrixSections,
      IntersectionProductScaf_projectionSections, IntersectionProductScaf_chartCoordinates,
      a3h_sect, a3h_sub_X, Matrix.mulVec, dotProduct]

#print axioms IntersectionProductScaf_translatedComplexSections_matrix

/-- Complex homogeneous equations of a translated image are read on its source chart. -/
theorem IntersectionProductScaf_translatedProjection_complex_equation
    (j : Fin (a3s_N X + 1))
    (x : (IntersectionProductScaf_projectionCover X Z q).X j)
    (F : MvPolynomial (Fin (n + 1)) ℂ) (d : ℕ) (hF : F.IsHomogeneous d) :
    F ∈ (a3m_projCharts n).prime
        ((IntersectionProductScaf_translatedProjection X hfin Z q A hA).left
          ((IntersectionProductScaf_projectionCover X Z q).f j x)) ↔
      ¬ IsUnit (((IntersectionProductScaf_projectionCover X Z q).X j).presheaf.germ
        ⊤ x (by trivial)
        (IntersectionProductScaf_translatedComplexSections X (a := a) Z q A j F)) := by
  let C := IntersectionProductScaf_projectionCover X Z q
  have hm : C.f j ≫ (IntersectionProductScaf_translatedProjection X hfin Z q A hA).left =
      pullback.lift (C.f j ≫ Z.hom)
        (IntersectionProductScaf_translatedChart X hfin Z q A hA j)
        (terminal.hom_ext _ _) := by
    apply pullback.hom_ext
    · simp [IntersectionProductScaf_translatedProjection]
    · simp only [Category.assoc, IntersectionProductScaf_translatedProjection,
        Over.homMk_left, pullback.lift_snd]
      exact IntersectionProductScaf_translatedProjection₀_chart X hfin Z q A hA j
  have he := congrArg (fun m : C.X j ⟶ a3m_Pn n => m x) hm
  rw [Scheme.Hom.comp_apply] at he
  erw [he]
  exact IntersectionProductScaf_complexSections_prime
    (Over.mk (C.f j ≫ Z.hom))
    (IntersectionProductScaf_translatedSections X (a := a) Z q A j)
    (IntersectionProductScaf_translatedSections_irrelevant X hfin Z q A hA j) x F d hF

#print axioms IntersectionProductScaf_translatedProjection_complex_equation

/-- The support of a translated inverse image is cut out by all its complex homogeneous equations. -/
theorem IntersectionProductScaf_translatedProjection_support_iff
    (z : (a3h_PnO n).left) (j : Fin (a3s_N X + 1))
    (x : (IntersectionProductScaf_projectionCover X Z q).X j) :
    (IntersectionProductScaf_projectionCover X Z q).f j x ∈
        (ccm3_inverseIdeal (IntersectionProductScaf_translatedProjection X hfin Z q A hA).left z).support ↔
      ∀ (F : MvPolynomial (Fin (n + 1)) ℂ) (d : ℕ), F.IsHomogeneous d →
        F ∈ (a3m_projCharts n).prime z →
          ¬ IsUnit (((IntersectionProductScaf_projectionCover X Z q).X j).presheaf.germ
            ⊤ x (by trivial)
            (IntersectionProductScaf_translatedComplexSections X (a := a) Z q A j F)) := by
  change _ ∈ ((ccm3_primeIdeal (a3h_PnO n).left z).comap
    (IntersectionProductScaf_translatedProjection X hfin Z q A hA).left).support ↔ _
  rw [Scheme.IdealSheafData.support_comap]
  change (IntersectionProductScaf_translatedProjection X hfin Z q A hA).left
    ((IntersectionProductScaf_projectionCover X Z q).f j x) ∈
      ((Scheme.IdealSheafData.vanishingIdeal
        ⟨closure ({z} : Set (a3h_PnO n).left), isClosed_closure⟩).support :
          Set (a3h_PnO n).left) ↔ _
  rw [Scheme.IdealSheafData.coe_support_vanishingIdeal]
  change _ ∈ closure ({z} : Set (a3h_PnO n).left) ↔ _
  rw [← specializes_iff_mem_closure, ← (a3m_projCharts n).prime_le_iff]
  constructor
  · intro h F d hF hz
    exact (IntersectionProductScaf_translatedProjection_complex_equation
      X hfin Z q A hA j x F d hF).mp (h hz)
  · intro h F hz
    rw [MvPolynomial.mem_iff_homogeneousComponent_mem
      ((a3m_projCharts n).isHomogeneous_prime _)]
    intro d
    apply (IntersectionProductScaf_translatedProjection_complex_equation
      X hfin Z q A hA j x (MvPolynomial.homogeneousComponent d F) d
      (MvPolynomial.homogeneousComponent_isHomogeneous d F)).mpr
    apply h _ d (MvPolynomial.homogeneousComponent_isHomogeneous d F)
    exact (MvPolynomial.mem_iff_homogeneousComponent_mem
      ((a3m_projCharts n).isHomogeneous_prime z) F).mp hz d

#print axioms IntersectionProductScaf_translatedProjection_support_iff

/-- On an affine source chart, the inverse-image ideal and the evaluated complex equations
have the same radical. -/
theorem IntersectionProductScaf_translatedProjection_chart_radical
    (z : (a3h_PnO n).left) (j : Fin (a3s_N X + 1))
    [IsAffine ((IntersectionProductScaf_projectionCover X Z q).X j)] :
    (((ccm3_inverseIdeal (IntersectionProductScaf_translatedProjection X hfin Z q A hA).left z).comap
        ((IntersectionProductScaf_projectionCover X Z q).f j)).ideal
          ⟨⊤, isAffineOpen_top _⟩).radical =
      (Ideal.map (IntersectionProductScaf_translatedComplexSections X (a := a) Z q A j)
        ((a3m_projCharts n).prime z)).radical := by
  let C := IntersectionProductScaf_projectionCover X Z q
  let U := C.X j
  let I := (ccm3_inverseIdeal
    (IntersectionProductScaf_translatedProjection X hfin Z q A hA).left z).comap (C.f j)
  let e := IntersectionProductScaf_translatedComplexSections X (a := a) Z q A j
  let J := Ideal.map e ((a3m_projCharts n).prime z)
  change (I.ideal ⟨⊤, isAffineOpen_top U⟩).radical = J.radical
  apply PrimeSpectrum.zeroLocus_eq_iff.mp
  rw [← U.toSpecΓ_image_zeroLocus (I.ideal ⟨⊤, isAffineOpen_top U⟩),
    ← U.toSpecΓ_image_zeroLocus J]
  congr 1
  ext x
  rw [← Scheme.IdealSheafData.mem_support_iff_of_mem
    (I := I) (U := ⟨⊤, isAffineOpen_top U⟩) (x := x) (by trivial)]
  rw [Scheme.IdealSheafData.support_comap]
  change C.f j x ∈ (ccm3_inverseIdeal
    (IntersectionProductScaf_translatedProjection X hfin Z q A hA).left z).support ↔ _
  rw [IntersectionProductScaf_translatedProjection_support_iff X hfin Z q A hA z j x,
    ← U.toSpecΓ_preimage_zeroLocus J]
  change _ ↔ J ≤ (U.toSpecΓ x).asIdeal
  rw [Ideal.map_le_iff_le_comap]
  have hg : ∀ b : Γ(U, ⊤), b ∈ (U.toSpecΓ x).asIdeal ↔
      ¬ IsUnit (U.presheaf.germ ⊤ x (by trivial) b) := by
    intro b
    have hb : b ∉ (U.toSpecΓ x).asIdeal ↔
        IsUnit (U.presheaf.germ ⊤ x (by trivial) b) := by
      rw [← PrimeSpectrum.mem_basicOpen, ← Scheme.mem_basicOpen_top]
      change x ∈ (U.toSpecΓ ⁻¹ᵁ PrimeSpectrum.basicOpen b) ↔ _
      rw [Scheme.toSpecΓ_preimage_basicOpen]
    simpa only [not_not] using not_congr hb
  constructor
  · intro h F hF
    change e F ∈ (U.toSpecΓ x).asIdeal
    rw [← MvPolynomial.sum_homogeneousComponent F, map_sum]
    apply Ideal.sum_mem
    intro d hd
    apply (hg _).mpr
    exact h _ d (MvPolynomial.homogeneousComponent_isHomogeneous d F)
      (MvPolynomial.homogeneousComponent_mem_of_mem
        ((a3m_projCharts n).isHomogeneous_prime z) hF d)
  · intro h F d hF hz
    exact (hg _).mp (h hz)

#print axioms IntersectionProductScaf_translatedProjection_chart_radical

/-- A positive-degree homogeneous equation vanishes at a translated image exactly when
its translated section has a nonunit germ on the source chart. -/
theorem IntersectionProductScaf_translatedProjection₀_equation
    (j : Fin (a3s_N X + 1))
    (x : (IntersectionProductScaf_projectionCover X Z q).X j)
    (F : UniversalRing n) (d : ℕ) (hd : 0 < d) (hF : F ∈ UniversalGrading n d) :
    F ∈ (IntersectionProductScaf_translatedProjection₀ X hfin Z q A hA
      ((IntersectionProductScaf_projectionCover X Z q).f j x)).asHomogeneousIdeal ↔
      ¬ IsUnit (((IntersectionProductScaf_projectionCover X Z q).X j).presheaf.germ
        ⊤ x (by trivial) (IntersectionProductScaf_translatedSections X (a := a) Z q A j F)) := by
  have he := congrArg (fun f : (IntersectionProductScaf_projectionCover X Z q).X j ⟶
      g3c_P n => f x) (IntersectionProductScaf_translatedProjection₀_chart X hfin Z q A hA j)
  rw [Scheme.Hom.comp_apply] at he
  rw [he]
  have h : F ∉ (IntersectionProductScaf_translatedChart X hfin Z q A hA j x).asHomogeneousIdeal ↔
      IsUnit (((IntersectionProductScaf_projectionCover X Z q).X j).presheaf.germ
        ⊤ x (by trivial) (IntersectionProductScaf_translatedSections X (a := a) Z q A j F)) := by
    rw [← Proj.mem_basicOpen, ← Scheme.mem_basicOpen_top]
    change x ∈ (IntersectionProductScaf_translatedChart X hfin Z q A hA j ⁻¹ᵁ
      Proj.basicOpen (UniversalGrading n) F) ↔ _
    rw [IntersectionProductScaf_translatedChart,
      Proj.fromOfGlobalSections_preimage_basicOpen _ _ _ hd hF]
  simpa only [not_not] using not_congr h

#print axioms IntersectionProductScaf_translatedProjection₀_equation

/-- Defining homogeneous equations of an inverse-image subscheme have nonunit translated
germs at every point represented on a projection chart. -/
theorem IntersectionProductScaf_translatedProjection_inverseIdeal_equation
    (z : (a3h_PnO n).left)
    (u : (ccm3_inverseIdeal (IntersectionProductScaf_translatedProjection X hfin Z q A hA).left z).subscheme)
    (j : Fin (a3s_N X + 1))
    (x : (IntersectionProductScaf_projectionCover X Z q).X j)
    (hx : (IntersectionProductScaf_projectionCover X Z q).f j x =
      (ccm3_inverseIdeal (IntersectionProductScaf_translatedProjection X hfin Z q A hA).left z).subschemeι u)
    (F : UniversalRing n) (d : ℕ) (hd : 0 < d) (hF : F ∈ UniversalGrading n d)
    (hz : F ∈ (pullback.snd (terminal.from (Spec ↧ℂ))
      (terminal.from (g3c_P n)) z).asHomogeneousIdeal) :
    ¬ IsUnit (((IntersectionProductScaf_projectionCover X Z q).X j).presheaf.germ
      ⊤ x (by trivial) (IntersectionProductScaf_translatedSections X (a := a) Z q A j F)) := by
  have hsp := specializes_iff_mem_closure.mpr
    (IntersectionProductScaf_inverseIdeal_image
      (IntersectionProductScaf_translatedProjection X hfin Z q A hA).left z u)
  rw [← hx] at hsp
  have hp := hsp.map (pullback.snd (terminal.from (Spec ↧ℂ))
    (terminal.from (g3c_P n))).continuous
  change _ ⤳ (((IntersectionProductScaf_translatedProjection X hfin Z q A hA).left ≫
    pullback.snd (terminal.from (Spec ↧ℂ)) (terminal.from (g3c_P n)))
      ((IntersectionProductScaf_projectionCover X Z q).f j x)) at hp
  have he : (IntersectionProductScaf_translatedProjection X hfin Z q A hA).left ≫
      pullback.snd (terminal.from (Spec ↧ℂ)) (terminal.from (g3c_P n)) =
        IntersectionProductScaf_translatedProjection₀ X hfin Z q A hA :=
    pullback.lift_snd _ _ _
  rw [he] at hp
  apply (IntersectionProductScaf_translatedProjection₀_equation X hfin Z q A hA j x F d hd hF).mp
  by_contra hnon
  exact ((Proj.mem_basicOpen _ _ _).mp
    (hp.mem_open (Proj.basicOpen (UniversalGrading n) F).isOpen hnon)) hz

#print axioms IntersectionProductScaf_translatedProjection_inverseIdeal_equation

/-- The translated projection commutes with restriction of its domain. -/
theorem IntersectionProductScaf_translatedProjection₀_natural :
    g ≫ IntersectionProductScaf_translatedProjection₀ X hfin Z q A hA =
      IntersectionProductScaf_translatedProjection₀ X hfin W (g ≫ q)
        (g.appTop.hom.mapMatrix A) hB := by
  apply (IntersectionProductScaf_projectionCover X W (g ≫ q)).hom_ext
  intro j
  rw [IntersectionProductScaf_translatedProjection₀_chart, ← Category.assoc]
  have he : (IntersectionProductScaf_projectionCover X W (g ≫ q)).f j ≫ g =
      IntersectionProductScaf_chartRestriction X Z W q g j ≫
        (IntersectionProductScaf_projectionCover X Z q).f j :=
    (pullback.lift_fst _ _ _).symm
  rw [he, Category.assoc, IntersectionProductScaf_translatedProjection₀_chart]
  exact IntersectionProductScaf_translatedChart_natural X hfin Z W q g A hA hB j


