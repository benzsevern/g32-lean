/-- A generator of a maximal ideal retains order one under a surjective local ring map. -/
theorem IntersectionProductScaf_surjective_local_generator_order
    {R S : Type*} [CommRing R] [CommRing S] [IsLocalRing R] [IsLocalRing S]
    (f : R →+* S) (hf : Function.Surjective f) (r : R)
    (he : IsLocalRing.maximalIdeal R = Ideal.span {r}) :
    Ring.ord S (f r) = 1 := by
  have hs := IsLocalRing.map_maximalIdeal_of_surjective f hf
  rw [he, Ideal.map_span, Set.image_singleton] at hs
  rw [Ring.ord, hs]
  have : IsSimpleModule S (S ⧸ IsLocalRing.maximalIdeal S) :=
    isSimpleModule_iff_quot_maximal.mpr
      ⟨IsLocalRing.maximalIdeal S, inferInstance, ⟨LinearEquiv.refl S _⟩⟩
  exact Module.length_eq_one S _
