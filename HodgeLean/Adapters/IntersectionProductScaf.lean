instance IntersectionProductScaf_familyOpen_noetherian (Y : Over (Spec ↧ℂ))
    [IsProper Y.hom] (M : σ × σ → ℂ) :
    NoetherianSpace (IntersectionProductScaf_familyOpen Y M).left :=
  (IntersectionProductScaf_familyInclusion Y M).left.isOpenEmbedding.isInducing.noetherianSpace

instance IntersectionProductScaf_familyOpen_lft (Y : Over (Spec ↧ℂ))
    [LocallyOfFiniteType Y.hom] (M : σ × σ → ℂ) :
    LocallyOfFiniteType (IntersectionProductScaf_familyOpen Y M).hom := by
  rw [← (IntersectionProductScaf_familyInclusion Y M).w]
  infer_instance

variable (M : Fin (n + 1) × Fin (n + 1) → ℂ)

/-- The inverse-translation map on the open one-parameter family. -/
def IntersectionProductScaf_familyMap₀ :
    IntersectionProductScaf_familyOpen X M ⟶ a3h_PnO n :=
  IntersectionProductScaf_translatedProjection X hfin
    (IntersectionProductScaf_familyOpen X M) (IntersectionProductScaf_familyBase X M).left
    (IntersectionProductScaf_familyMatrix X M) (IntersectionProductScaf_familyMatrix_det X M)

/-- The translated projective coordinates with both parameters retained in the source. -/
def IntersectionProductScaf_squareMapToProjective :
    IntersectionProductScaf_familyOpen (a3n_T X) M ⟶ a3h_PnO n :=
  IntersectionProductScaf_translatedProjection X hfin
    (IntersectionProductScaf_familyOpen (a3n_T X) M)
    ((IntersectionProductScaf_familyBase (a3n_T X) M).left ≫ (a3n_q X).left)
    (IntersectionProductScaf_familyMatrix (a3n_T X) M)
    (IntersectionProductScaf_familyMatrix_det (a3n_T X) M)

/-- Projection to the original parameter on the open two-parameter family. -/
def IntersectionProductScaf_originalParameter :
    IntersectionProductScaf_familyOpen (a3n_T X) M ⟶ a3n_P1 :=
  IntersectionProductScaf_familyBase (a3n_T X) M ≫
    Over.homMk (a3n_p X) pullback.condition.symm

/-- The inverse-translation map fixes the original parameter. -/
def IntersectionProductScaf_familyMap₁ :
    IntersectionProductScaf_familyOpen (a3n_T X) M ⟶ a3n_T (a3h_PnO n) :=
  Over.homMk
    (pullback.lift (IntersectionProductScaf_squareMapToProjective X hfin M).left
      (IntersectionProductScaf_originalParameter X M).left
      ((IntersectionProductScaf_squareMapToProjective X hfin M).w.trans
        (IntersectionProductScaf_originalParameter X M).w.symm))
    ((pullback.lift_fst_assoc _ _ _ _).trans
      (IntersectionProductScaf_squareMapToProjective X hfin M).w)

/-- The one-parameter inverse-image cycle, extended through the open immersion. -/
def IntersectionProductScaf_theta₀ (c : AlgebraicCycle (a3h_PnO n).left ℚ) :
    AlgebraicCycle (a3n_T X).left ℚ :=
  IntersectionProductScaf_openFamilyCycle (IntersectionProductScaf_familyInclusion X M)
    (IntersectionProductScaf_familyMap₀ X hfin M) c

/-- The two-parameter inverse-image cycle, extended through the open immersion. -/
def IntersectionProductScaf_theta₁ (c : AlgebraicCycle (a3n_T (a3h_PnO n)).left ℚ) :
    AlgebraicCycle (a3n_T (a3n_T X)).left ℚ :=
  IntersectionProductScaf_openFamilyCycle (IntersectionProductScaf_familyInclusion (a3n_T X) M)
    (IntersectionProductScaf_familyMap₁ X hfin M) c

section FamilyEquations

attribute [local instance] MvPolynomial.gradedAlgebra

/-- The open line family's complex sections are evaluations of the explicit translated polynomials. -/
theorem IntersectionProductScaf_familySections_substLine0 (j : Fin (a3s_N X + 1)) :
    let C := IntersectionProductScaf_projectionCover X
      (IntersectionProductScaf_familyOpen X M) (IntersectionProductScaf_familyBase X M).left
    let f := (IntersectionProductScaf_chartCoordinates X
      (IntersectionProductScaf_familyOpen X M) (IntersectionProductScaf_familyBase X M).left j).comp
        (a3r_lin (a3r_mat a)).toRingHom
    IntersectionProductScaf_translatedComplexSections X (a := a)
        (IntersectionProductScaf_familyOpen X M) (IntersectionProductScaf_familyBase X M).left
        (IntersectionProductScaf_familyMatrix X M) j =
      (Polynomial.eval₂RingHom f
        ((C.f j).appTop (IntersectionProductScaf_familyParameterSections X M Polynomial.X))).comp
          (IntersectionProductScaf_substLine0 M).toRingHom := by
  let C := IntersectionProductScaf_projectionCover X
    (IntersectionProductScaf_familyOpen X M) (IntersectionProductScaf_familyBase X M).left
  let f := (IntersectionProductScaf_chartCoordinates X
    (IntersectionProductScaf_familyOpen X M) (IntersectionProductScaf_familyBase X M).left j).comp
      (a3r_lin (a3r_mat a)).toRingHom
  let t := (C.f j).appTop.hom.comp (IntersectionProductScaf_familyParameterSections X M)
  dsimp only
  rw [IntersectionProductScaf_translatedComplexSections_matrix X
    (IntersectionProductScaf_familyOpen X M) (IntersectionProductScaf_familyBase X M).left
    (IntersectionProductScaf_familyMatrix X M) (Over.w (IntersectionProductScaf_familyBase X M))]
  change IntersectionProductScaf_matrixSections
    (t.mapMatrix (IntersectionProductScaf_lineMatrix M)) f =
      (Polynomial.eval₂RingHom f (t Polynomial.X)).comp
        (IntersectionProductScaf_substLine0 M).toRingHom
  apply IntersectionProductScaf_matrixSections_substLine0
  intro c
  change (C.f j).appTop (IntersectionProductScaf_familyParameterSections X M (Polynomial.C c)) =
    IntersectionProductScaf_chartCoordinates X (IntersectionProductScaf_familyOpen X M)
      (IntersectionProductScaf_familyBase X M).left j
      (a3r_lin (a3r_mat a) (MvPolynomial.C c))
  rw [IntersectionProductScaf_familyParameterSections_C, MvPolynomial.algHom_C,
    MvPolynomial.algebraMap_eq]
  rw [IntersectionProductScaf_chartCoordinates_scalar X
    (IntersectionProductScaf_familyOpen X M) (IntersectionProductScaf_familyBase X M).left
    (Over.w (IntersectionProductScaf_familyBase X M))]
  change (C.f j).appTop ((IntersectionProductScaf_familyOpen X M).hom.appTop
    ((Scheme.ΓSpecIso (.of ℂ)).inv c)) =
    (C.f j ≫ (IntersectionProductScaf_familyOpen X M).hom).appTop
      ((Scheme.ΓSpecIso (.of ℂ)).inv c)
  exact (a3m_appTop_comp_apply _ _ _).symm

#print axioms IntersectionProductScaf_familySections_substLine0

/-- Affine chart components of the open line family are the minimal primes of its evaluated
polynomial translation ideal. -/
theorem IntersectionProductScaf_familyChart_minimalPrimes
    (z : (a3h_PnO n).left) (j : Fin (a3s_N X + 1)) :
    let C := IntersectionProductScaf_projectionCover X
      (IntersectionProductScaf_familyOpen X M) (IntersectionProductScaf_familyBase X M).left
    let f := (IntersectionProductScaf_chartCoordinates X
      (IntersectionProductScaf_familyOpen X M) (IntersectionProductScaf_familyBase X M).left j).comp
        (a3r_lin (a3r_mat a)).toRingHom
    (((ccm3_inverseIdeal (IntersectionProductScaf_familyMap₀ X hfin M).left z).comap
      (C.f j)).ideal ⟨⊤, isAffineOpen_top _⟩).minimalPrimes =
      (Ideal.map (Polynomial.eval₂RingHom f
        ((C.f j).appTop (IntersectionProductScaf_familyParameterSections X M Polynomial.X)))
          (Ideal.map (IntersectionProductScaf_substLine0 M).toRingHom
            ((a3m_projCharts n).prime z))).minimalPrimes := by
  have h := congrArg (fun I => I.minimalPrimes)
    (IntersectionProductScaf_translatedProjection_chart_radical X hfin
      (IntersectionProductScaf_familyOpen X M) (IntersectionProductScaf_familyBase X M).left
      (IntersectionProductScaf_familyMatrix X M) (IntersectionProductScaf_familyMatrix_det X M) z j)
  simp only [Ideal.radical_minimalPrimes] at h
  rw [IntersectionProductScaf_familySections_substLine0 X M j, ← Ideal.map_map] at h
  exact h

#print axioms IntersectionProductScaf_familyChart_minimalPrimes

/-- Each prime line-family member is represented by a minimal prime of the evaluated
translation ideal on an affine projection chart. -/
theorem IntersectionProductScaf_theta₀_single_chart_component
    (z : (a3h_PnO n).left) (w : (a3n_T X).left)
    (hw : IntersectionProductScaf_theta₀ X hfin M
      (Function.locallyFinsuppWithin.single z 1) w ≠ 0) :
    let C := IntersectionProductScaf_projectionCover X
      (IntersectionProductScaf_familyOpen X M) (IntersectionProductScaf_familyBase X M).left
    let I := ccm3_inverseIdeal (IntersectionProductScaf_familyMap₀ X hfin M).left z
    ∃ (j : Fin (a3s_N X + 1))
      (v : Spec (.of (Γ(C.X j, ⊤) ⧸ ((I.comap (C.f j)).ideal
        ⟨⊤, isAffineOpen_top _⟩)))),
      (IntersectionProductScaf_familyInclusion X M).left
        (C.f j ((I.comap (C.f j)).subschemeι
          ((I.comap (C.f j)).subschemeCover.f ⟨⊤, isAffineOpen_top _⟩ v))) = w ∧
      v.asIdeal.comap (Ideal.Quotient.mk _) ∈
        (Ideal.map (Polynomial.eval₂RingHom
          ((IntersectionProductScaf_chartCoordinates X
            (IntersectionProductScaf_familyOpen X M)
            (IntersectionProductScaf_familyBase X M).left j).comp
            (a3r_lin (a3r_mat a)).toRingHom)
          ((C.f j).appTop (IntersectionProductScaf_familyParameterSections X M Polynomial.X)))
            (Ideal.map (IntersectionProductScaf_substLine0 M).toRingHom
              ((a3m_projCharts n).prime z))).minimalPrimes := by
  let C := IntersectionProductScaf_projectionCover X
    (IntersectionProductScaf_familyOpen X M) (IntersectionProductScaf_familyBase X M).left
  let I := ccm3_inverseIdeal (IntersectionProductScaf_familyMap₀ X hfin M).left z
  obtain ⟨u, huw, hu⟩ := (IntersectionProductScaf_openFamilyCycle_single_support
    (IntersectionProductScaf_familyInclusion X M)
    (IntersectionProductScaf_familyMap₀ X hfin M) z w).mp hw
  obtain ⟨x, hx⟩ := C.covers (I.subschemeι u)
  let j := C.idx (I.subschemeι u)
  letI : IsOpenImmersion (C.f j) := C.map_prop j
  obtain ⟨v, hvx, hv⟩ := IntersectionProductScaf_comap_component I (C.f j) u hu x hx
  obtain ⟨p, hpv, hp⟩ := IntersectionProductScaf_subscheme_component_on_affine
    (I.comap (C.f j)) ⟨⊤, isAffineOpen_top _⟩ v hv (by trivial)
  refine ⟨j, p, ?_, ?_⟩
  · rw [hpv, hvx, hx]
    exact huw
  · rw [← IntersectionProductScaf_familyChart_minimalPrimes X hfin M z j]
    exact hp

#print axioms IntersectionProductScaf_theta₀_single_chart_component

/-- The affine coordinate prime of a line-family component is minimal over the evaluated
translation ideal. -/
theorem IntersectionProductScaf_theta₀_single_coordinate_prime
    (z : (a3h_PnO n).left) (w : (a3n_T X).left)
    (hw : IntersectionProductScaf_theta₀ X hfin M
      (Function.locallyFinsuppWithin.single z 1) w ≠ 0) :
    let C := IntersectionProductScaf_projectionCover X
      (IntersectionProductScaf_familyOpen X M) (IntersectionProductScaf_familyBase X M).left
    ∃ (j : Fin (a3s_N X + 1)) (x : C.X j),
      (IntersectionProductScaf_familyInclusion X M).left (C.f j x) = w ∧
      ((C.X j).toSpecΓ x).asIdeal ∈
        (Ideal.map (Polynomial.eval₂RingHom
          ((IntersectionProductScaf_chartCoordinates X
            (IntersectionProductScaf_familyOpen X M)
            (IntersectionProductScaf_familyBase X M).left j).comp
            (a3r_lin (a3r_mat a)).toRingHom)
          ((C.f j).appTop (IntersectionProductScaf_familyParameterSections X M Polynomial.X)))
            (Ideal.map (IntersectionProductScaf_substLine0 M).toRingHom
              ((a3m_projCharts n).prime z))).minimalPrimes := by
  let C := IntersectionProductScaf_projectionCover X
    (IntersectionProductScaf_familyOpen X M) (IntersectionProductScaf_familyBase X M).left
  let I := ccm3_inverseIdeal (IntersectionProductScaf_familyMap₀ X hfin M).left z
  obtain ⟨u, huw, hu⟩ := (IntersectionProductScaf_openFamilyCycle_single_support
    (IntersectionProductScaf_familyInclusion X M)
    (IntersectionProductScaf_familyMap₀ X hfin M) z w).mp hw
  obtain ⟨x, hx⟩ := C.covers (I.subschemeι u)
  let j := C.idx (I.subschemeι u)
  letI : IsOpenImmersion (C.f j) := C.map_prop j
  obtain ⟨v, hvx, hv⟩ := IntersectionProductScaf_comap_component I (C.f j) u hu x hx
  refine ⟨j, x, (congrArg (IntersectionProductScaf_familyInclusion X M).left hx).trans huw, ?_⟩
  rw [← IntersectionProductScaf_familyChart_minimalPrimes X hfin M z j, ← hvx]
  exact IntersectionProductScaf_affine_subscheme_component (I.comap (C.f j)) v hv

#print axioms IntersectionProductScaf_theta₀_single_coordinate_prime

/-- Actual prime line-family members are represented by minimal primes in localized chart polynomials. -/
theorem IntersectionProductScaf_theta₀_single_localized_chart_prime
    (z : (a3h_PnO n).left) (w : (a3n_T X).left)
    (hw : IntersectionProductScaf_theta₀ X hfin M
      (Function.locallyFinsuppWithin.single z 1) w ≠ 0) :
    let C := IntersectionProductScaf_projectionCover X
      (IntersectionProductScaf_familyOpen X M) (IntersectionProductScaf_familyBase X M).left
    ∃ (j : Fin (a3s_N X + 1)) (x : C.X j),
      (IntersectionProductScaf_familyInclusion X M).left (C.f j x) = w ∧
      (letI : Algebra ℂ ((a3s_CX X).T j) :=
        (((a3s_CX X).θ j).comp MvPolynomial.C).toAlgebra
       (((C.X j).toSpecΓ x).asIdeal.comap
         (IntersectionProductScaf_familyChartPolynomialSectionsEquiv X M j).toRingHom) ∈
         (Ideal.map (algebraMap _ _)
           (Ideal.map (Polynomial.mapRingHom
             (((a3s_CX X).θ j).comp (a3r_lin (a3r_mat a)).toRingHom))
             (Ideal.map (IntersectionProductScaf_substLine0 M).toRingHom
               ((a3m_projCharts n).prime z)))).minimalPrimes) := by
  let C := IntersectionProductScaf_projectionCover X
    (IntersectionProductScaf_familyOpen X M) (IntersectionProductScaf_familyBase X M).left
  obtain ⟨j, x, hx, hP⟩ := IntersectionProductScaf_theta₀_single_coordinate_prime X hfin M z w hw
  refine ⟨j, x, hx, ?_⟩
  letI : Algebra ℂ ((a3s_CX X).T j) :=
    (((a3s_CX X).θ j).comp MvPolynomial.C).toAlgebra
  let f := IntersectionProductScaf_chartCoordinates X
    (IntersectionProductScaf_familyOpen X M) (IntersectionProductScaf_familyBase X M).left j
  let t := (C.f j).appTop (IntersectionProductScaf_familyParameterSections X M Polynomial.X)
  let l := (a3r_lin (a3r_mat a)).toRingHom
  let J := Ideal.map (IntersectionProductScaf_substLine0 M).toRingHom
    ((a3m_projCharts n).prime z)
  have heval : (Polynomial.eval₂RingHom f t).comp (Polynomial.mapRingHom l) =
      Polynomial.eval₂RingHom (f.comp l) t := by
    apply RingHom.ext
    intro F
    exact Polynomial.eval₂_map l f t
  have hP' : ((C.X j).toSpecΓ x).asIdeal ∈
      (Ideal.map (Polynomial.eval₂RingHom f t) (Ideal.map (Polynomial.mapRingHom l) J)).minimalPrimes := by
    rw [Ideal.map_map, heval]
    exact hP
  have h := IntersectionProductScaf_familyChartPolynomialSectionsEquiv_minimalPrime X M j
    (Ideal.map (Polynomial.mapRingHom l) J) ((C.X j).toSpecΓ x).asIdeal hP'
  have hm : Ideal.map (Polynomial.mapRingHom ((a3s_CX X).θ j))
      (Ideal.map (Polynomial.mapRingHom l) J) =
      Ideal.map (Polynomial.mapRingHom (((a3s_CX X).θ j).comp l)) J := by
    rw [Ideal.map_map, Polynomial.mapRingHom_comp]
  rw [hm] at h
  exact h

#print axioms IntersectionProductScaf_theta₀_single_localized_chart_prime

/-- Actual prime line-family members lift to minimal primes of their normalized cone equations. -/
theorem IntersectionProductScaf_theta₀_single_normalized_cone_prime
    (z : (a3h_PnO n).left) (w : (a3n_T X).left)
    (hw : IntersectionProductScaf_theta₀ X hfin M
      (Function.locallyFinsuppWithin.single z 1) w ≠ 0) :
    let C := IntersectionProductScaf_projectionCover X
      (IntersectionProductScaf_familyOpen X M) (IntersectionProductScaf_familyBase X M).left
    ∃ (j : Fin (a3s_N X + 1)) (x : C.X j)
      (hj : MvPolynomial.X j ∉ (a3s_CX X).prime (genericPoint X.left)),
      (IntersectionProductScaf_familyInclusion X M).left (C.f j x) = w ∧
      (letI : Algebra ℂ ((a3s_CX X).T j) :=
        (((a3s_CX X).θ j).comp MvPolynomial.C).toAlgebra
       ∃ Q ∈ (Ideal.map (IntersectionProductScaf_familyChartConeMap X M j hj)
         (Ideal.map (algebraMap _ _)
           (Ideal.map (Polynomial.mapRingHom
             (((a3s_CX X).θ j).comp (a3r_lin (a3r_mat a)).toRingHom))
             (Ideal.map (IntersectionProductScaf_substLine0 M).toRingHom
               ((a3m_projCharts n).prime z))))).minimalPrimes,
         Q.comap (IntersectionProductScaf_familyChartConeMap X M j hj) =
           ((C.X j).toSpecΓ x).asIdeal.comap
             (IntersectionProductScaf_familyChartPolynomialSectionsEquiv X M j).toRingHom) := by
  let C := IntersectionProductScaf_projectionCover X
    (IntersectionProductScaf_familyOpen X M) (IntersectionProductScaf_familyBase X M).left
  obtain ⟨j, x, hx, hP⟩ :=
    IntersectionProductScaf_theta₀_single_localized_chart_prime X hfin M z w hw
  have hj := IntersectionProductScaf_chart_coordinate_not_mem (a3s_CX X) j
    ((pullback.snd (IntersectionProductScaf_familyBase X M).left ((a3s_CX X).κ j)) x)
  refine ⟨j, x, hj, hx, ?_⟩
  letI : Algebra ℂ ((a3s_CX X).T j) :=
    (((a3s_CX X).θ j).comp MvPolynomial.C).toAlgebra
  exact IntersectionProductScaf_familyChartConeMap_minimalPrime X M j hj _ _ hP

#print axioms IntersectionProductScaf_theta₀_single_normalized_cone_prime

/-- Actual prime line-family members lift to minimal primes of the homogeneous translated cone ideal. -/
theorem IntersectionProductScaf_theta₀_single_homogeneous_cone_prime
    (z : (a3h_PnO n).left) (w : (a3n_T X).left)
    (hw : IntersectionProductScaf_theta₀ X hfin M
      (Function.locallyFinsuppWithin.single z 1) w ≠ 0) :
    let C := IntersectionProductScaf_projectionCover X
      (IntersectionProductScaf_familyOpen X M) (IntersectionProductScaf_familyBase X M).left
    ∃ (j : Fin (a3s_N X + 1)) (x : C.X j)
      (hj : MvPolynomial.X j ∉ (a3s_CX X).prime (genericPoint X.left)),
      (IntersectionProductScaf_familyInclusion X M).left (C.f j x) = w ∧
      (letI : Algebra ℂ ((a3s_CX X).T j) :=
        (((a3s_CX X).θ j).comp MvPolynomial.C).toAlgebra
       ∃ Q : Ideal (Localization.Away
         ((Polynomial.mapRingHom (a3t_phi (a3s_CX X) j hj))
           ((IntersectionProductScaf_lineDet M).map (algebraMap ℂ ((a3s_CX X).T j))))),
         Q ∈ (Ideal.map (algebraMap _ _)
         (Ideal.map (Polynomial.mapRingHom
           ((algebraMap (a3t_A (a3s_CX X)) (a3t_Ax (a3s_CX X) j)).comp
             ((Ideal.Quotient.mk _).comp (a3r_lin (a3r_mat a)).toRingHom)))
           (Ideal.map (IntersectionProductScaf_substLine0 M).toRingHom
             ((a3m_projCharts n).prime z)))).minimalPrimes ∧
         Q.comap (IntersectionProductScaf_familyChartConeMap X M j hj) =
           ((C.X j).toSpecΓ x).asIdeal.comap
             (IntersectionProductScaf_familyChartPolynomialSectionsEquiv X M j).toRingHom) := by
  obtain ⟨j, x, hj, hx, Q, hQ, hQP⟩ :=
    IntersectionProductScaf_theta₀_single_normalized_cone_prime X hfin M z w hw
  letI : Algebra ℂ ((a3s_CX X).T j) :=
    (((a3s_CX X).θ j).comp MvPolynomial.C).toAlgebra
  refine ⟨j, x, hj, hx, Q, ?_, hQP⟩
  rw [IntersectionProductScaf_familyChartConeMap_ideal X M j hj (a3r_mat a)
    ((a3m_projCharts n).prime z) ((a3m_projCharts n).isHomogeneous_prime z)] at hQ
  exact hQ

#print axioms IntersectionProductScaf_theta₀_single_homogeneous_cone_prime

/-- Every member of the explicit prime line family has a source-chart representative
where the input's universal homogeneous equations have nonunit translated germs. -/
theorem IntersectionProductScaf_theta₀_single_equations
    (z : (a3h_PnO n).left) (w : (a3n_T X).left)
    (hw : IntersectionProductScaf_theta₀ X hfin M
      (Function.locallyFinsuppWithin.single z 1) w ≠ 0) :
    let C := IntersectionProductScaf_projectionCover X
      (IntersectionProductScaf_familyOpen X M) (IntersectionProductScaf_familyBase X M).left
    ∃ (j : Fin (a3s_N X + 1)) (x : C.X j),
      (IntersectionProductScaf_familyInclusion X M).left (C.f j x) = w ∧
      ∀ (F : UniversalRing n) (d : ℕ), 0 < d → F ∈ UniversalGrading n d →
        F ∈ (pullback.snd (terminal.from (Spec ↧ℂ))
          (terminal.from (g3c_P n)) z).asHomogeneousIdeal →
        ¬ IsUnit ((C.X j).presheaf.germ ⊤ x (by trivial)
          (IntersectionProductScaf_translatedSections X (a := a)
            (IntersectionProductScaf_familyOpen X M) (IntersectionProductScaf_familyBase X M).left
            (IntersectionProductScaf_familyMatrix X M) j F)) := by
  obtain ⟨u, hu, _⟩ := (IntersectionProductScaf_openFamilyCycle_single_support
    (IntersectionProductScaf_familyInclusion X M)
    (IntersectionProductScaf_familyMap₀ X hfin M) z w).mp hw
  let C := IntersectionProductScaf_projectionCover X
    (IntersectionProductScaf_familyOpen X M) (IntersectionProductScaf_familyBase X M).left
  let v := (ccm3_inverseIdeal (IntersectionProductScaf_familyMap₀ X hfin M).left z).subschemeι u
  obtain ⟨x, hx⟩ := C.covers v
  refine ⟨C.idx v, x, ?_, ?_⟩
  · exact (congrArg (IntersectionProductScaf_familyInclusion X M).left hx).trans hu
  · intro F d hd hF hz
    exact IntersectionProductScaf_translatedProjection_inverseIdeal_equation X hfin
      (IntersectionProductScaf_familyOpen X M) (IntersectionProductScaf_familyBase X M).left
      (IntersectionProductScaf_familyMatrix X M) (IntersectionProductScaf_familyMatrix_det X M)
      z u (C.idx v) x hx F d hd hF hz

#print axioms IntersectionProductScaf_theta₀_single_equations

/-- Prime line-family members satisfy all complex homogeneous equations on a source chart. -/
theorem IntersectionProductScaf_theta₀_single_complex_equations
    (z : (a3h_PnO n).left) (w : (a3n_T X).left)
    (hw : IntersectionProductScaf_theta₀ X hfin M
      (Function.locallyFinsuppWithin.single z 1) w ≠ 0) :
    let C := IntersectionProductScaf_projectionCover X
      (IntersectionProductScaf_familyOpen X M) (IntersectionProductScaf_familyBase X M).left
    ∃ (j : Fin (a3s_N X + 1)) (x : C.X j),
      (IntersectionProductScaf_familyInclusion X M).left (C.f j x) = w ∧
      ∀ (F : MvPolynomial (Fin (n + 1)) ℂ) (d : ℕ), F.IsHomogeneous d →
        F ∈ (a3m_projCharts n).prime z →
          ¬ IsUnit ((C.X j).presheaf.germ ⊤ x (by trivial)
            (IntersectionProductScaf_translatedComplexSections X (a := a)
              (IntersectionProductScaf_familyOpen X M) (IntersectionProductScaf_familyBase X M).left
              (IntersectionProductScaf_familyMatrix X M) j F)) := by
  obtain ⟨u, hu, _⟩ := (IntersectionProductScaf_openFamilyCycle_single_support
    (IntersectionProductScaf_familyInclusion X M)
    (IntersectionProductScaf_familyMap₀ X hfin M) z w).mp hw
  let C := IntersectionProductScaf_projectionCover X
    (IntersectionProductScaf_familyOpen X M) (IntersectionProductScaf_familyBase X M).left
  let I := ccm3_inverseIdeal (IntersectionProductScaf_familyMap₀ X hfin M).left z
  let v := I.subschemeι u
  obtain ⟨x, hx⟩ := C.covers v
  refine ⟨C.idx v, x, ?_, ?_⟩
  · exact (congrArg (IntersectionProductScaf_familyInclusion X M).left hx).trans hu
  · apply (IntersectionProductScaf_translatedProjection_support_iff X hfin
      (IntersectionProductScaf_familyOpen X M) (IntersectionProductScaf_familyBase X M).left
      (IntersectionProductScaf_familyMatrix X M) (IntersectionProductScaf_familyMatrix_det X M)
      z (C.idx v) x).mp
    change C.f (C.idx v) x ∈ I.support
    rw [hx]
    change v ∈ (I.support : Set (IntersectionProductScaf_familyOpen X M).left)
    rw [← Scheme.IdealSheafData.range_subschemeι]
    exact ⟨u, rfl⟩

#print axioms IntersectionProductScaf_theta₀_single_complex_equations

/-- Every input ideal polynomial vanishes on a source-chart representative of a prime line member. -/
theorem IntersectionProductScaf_theta₀_single_polynomial_equations
    (z : (a3h_PnO n).left) (w : (a3n_T X).left)
    (hw : IntersectionProductScaf_theta₀ X hfin M
      (Function.locallyFinsuppWithin.single z 1) w ≠ 0) :
    let C := IntersectionProductScaf_projectionCover X
      (IntersectionProductScaf_familyOpen X M) (IntersectionProductScaf_familyBase X M).left
    ∃ (j : Fin (a3s_N X + 1)) (x : C.X j),
      (IntersectionProductScaf_familyInclusion X M).left (C.f j x) = w ∧
      ∀ F ∈ (a3m_projCharts n).prime z,
        ¬ IsUnit ((C.X j).presheaf.germ ⊤ x (by trivial)
          (Polynomial.eval₂
            ((IntersectionProductScaf_chartCoordinates X (IntersectionProductScaf_familyOpen X M)
              (IntersectionProductScaf_familyBase X M).left j).comp
                (a3r_lin (a3r_mat a)).toRingHom)
            ((C.f j).appTop (IntersectionProductScaf_familyParameterSections X M Polynomial.X))
            (IntersectionProductScaf_substLine0 M F))) := by
  obtain ⟨j, x, hx, heq⟩ :=
    IntersectionProductScaf_theta₀_single_complex_equations X hfin M z w hw
  refine ⟨j, x, hx, ?_⟩
  intro F hF
  let C := IntersectionProductScaf_projectionCover X
    (IntersectionProductScaf_familyOpen X M) (IntersectionProductScaf_familyBase X M).left
  have hzero : ¬ IsUnit ((C.X j).presheaf.germ ⊤ x (by trivial)
      (IntersectionProductScaf_translatedComplexSections X (a := a)
        (IntersectionProductScaf_familyOpen X M) (IntersectionProductScaf_familyBase X M).left
        (IntersectionProductScaf_familyMatrix X M) j F)) := by
    change _ ∈ IsLocalRing.maximalIdeal ((C.X j).presheaf.stalk x)
    rw [← MvPolynomial.sum_homogeneousComponent F, map_sum, map_sum]
    apply Ideal.sum_mem
    intro d hd
    change ¬ IsUnit _
    exact heq (MvPolynomial.homogeneousComponent d F) d
      (MvPolynomial.homogeneousComponent_isHomogeneous d F)
      (MvPolynomial.homogeneousComponent_mem_of_mem
        ((a3m_projCharts n).isHomogeneous_prime z) hF d)
  rw [IntersectionProductScaf_familySections_substLine0 X M j] at hzero
  exact hzero

