/-- The local equation ideal on an embedded inverse image is the image of the ambient stalk ideal. -/
theorem IntersectionProductScaf_closed_comap_stalk_kernel
    {Y Z : Scheme} (i : Y ⟶ Z) [IsClosedImmersion i]
    (K : Z.IdealSheafData) (x : (K.comap i).subscheme)
    (U : Z.affineOpens) (hx : i ((K.comap i).subschemeι x) ∈ U.1) :
    RingHom.ker ((K.comap i).subschemeι.stalkMap x).hom =
      ((K.ideal U).map (Z.presheaf.germ U.1 _ hx).hom).map
        (i.stalkMap ((K.comap i).subschemeι x)).hom := by
  rw [a3l_ker_stalkMap_subschemeι (K.comap i) x ⟨i ⁻¹ᵁ U, U.2.preimage i⟩ hx,
    IntersectionProductScaf_closed_comap_ideal, Ideal.map_map, Ideal.map_map]
  congr 1
  ext r
  exact (Scheme.Hom.germ_stalkMap_apply i U.1 ((K.comap i).subschemeι x) hx r).symm
#print axioms IntersectionProductScaf_closed_comap_stalk_kernel





/-- A parameter quotient of an ideal quotient has the length of the sum-ideal quotient. -/
theorem IntersectionProductScaf_quotient_parameter_length
    {A : Type*} [CommRing A] (P : Ideal A) (r : A) :
    Module.length A (QuotSMulTop r (A ⧸ P)) =
      Module.length A (A ⧸ (P ⊔ Ideal.span {r})) := by
  exact (QuotSMulTop.equivTensorQuot r (A ⧸ P)).length_eq.trans
    (a3l_length_tensor_quot P (Ideal.span {r}))
#print axioms IntersectionProductScaf_quotient_parameter_length

/-- A regular parameter has no kernel contribution to the Herbrand difference. -/
theorem IntersectionProductScaf_herbrand_of_regular
    {R : Type*} [CommRing R] (r : R) (N : Type*) [AddCommGroup N] [Module R N]
    (hr : IsSMulRegular N r) :
    a3e_herbrand r N = ((Module.length R (QuotSMulTop r N)).toNat : ℤ) := by
  have hk : a3e_kerSMul r N = ⊥ :=
    (isSMulRegular_iff_ker_lsmul_eq_bot N r).mp hr
  have : Subsingleton (a3e_kerSMul r N) := Submodule.subsingleton_iff_eq_bot.mpr hk
  have hz : Module.length R (a3e_kerSMul r N) = 0 := Module.length_eq_zero
  rw [a3e_herbrand, hz]
  simp only [ENat.toNat_zero, Nat.cast_zero, sub_zero]

#print axioms IntersectionProductScaf_herbrand_of_regular

