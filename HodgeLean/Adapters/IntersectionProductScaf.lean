/-- Every affine generator of a subscheme with regular local equations is regular. -/
theorem IntersectionProductScaf_affine_generator_regular
    {Y : Scheme} (K : Y.IdealSheafData)
    (hreg : ∀ z : K.subscheme, ∃ r : Y.presheaf.stalk (K.subschemeι z),
      IsSMulRegular (Y.presheaf.stalk (K.subschemeι z)) r ∧
      RingHom.ker (K.subschemeι.stalkMap z).hom = Ideal.span {r})
    (U : Y.affineOpens) (r : Γ(Y, U)) (hK : K.ideal U = Ideal.span {r}) :
    IsSMulRegular Γ(Y, U) r := by
  apply IntersectionProductScaf_section_regular_of_stalks
  intro x hx
  by_cases hk : x ∈ (K.support : Set Y)
  · let z : K.subscheme := ⟨x, hk⟩
    have hh := hreg z
    change ∃ s : Y.presheaf.stalk x, IsSMulRegular (Y.presheaf.stalk x) s ∧
      RingHom.ker (K.subschemeι.stalkMap z).hom = Ideal.span {s} at hh
    obtain ⟨s, hs, hker⟩ := hh
    have he := a3l_ker_stalkMap_subschemeι K z U hx
    rw [hK, Ideal.map_span, Set.image_singleton, hker] at he
    change Ideal.span {s} = Ideal.span {Y.presheaf.germ U.1 x hx r} at he
    have hmem : s ∈ Ideal.span {Y.presheaf.germ U.1 x hx r} :=
      he ▸ Ideal.mem_span_singleton_self s
    obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp hmem
    rw [← ha] at hs
    exact hs.of_mul
  · have hn : x ∉ Y.zeroLocus (U := U.1) (K.ideal U) :=
      fun h => hk ((K.mem_support_iff_of_mem hx).mpr h)
    rw [hK, Y.zeroLocus_span, Y.zeroLocus_singleton] at hn
    have hu : IsUnit (Y.presheaf.germ U.1 x hx r) :=
      (Y.mem_basicOpen r x hx).mp (not_not.mp hn)
    exact hu.isSMulRegular (M := Y.presheaf.stalk x)
#print axioms IntersectionProductScaf_affine_generator_regular
