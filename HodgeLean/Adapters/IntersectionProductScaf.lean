/-- Separation of the relative cone gives degree one for the actual product projection. -/
theorem IntersectionProductScaf_product_projection_degree_one_of_cone_separation
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom] {n : ℕ}
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (y : (a3n_T X).left) (hy : y ∈ a3h_U X)
    (hsep : ∀ (K : Type) [Field K] [Algebra ℂ K]
      (φ ψ : (MvPolynomial (Fin (a3s_N X + 1) ⊕ Unit) ℂ ⧸ a3h_P X y hy) →ₐ[ℂ] K),
      Function.Injective φ →
      (∀ i, φ (Ideal.Quotient.mk _ (a3r_lin (a3h_block a) (MvPolynomial.X i))) =
        ψ (Ideal.Quotient.mk _ (a3r_lin (a3h_block a) (MvPolynomial.X i)))) → φ = ψ) :
    a1p_degree (a3h_G (a3h_πO X hfin)).left y = 1 := by
  let x := (a3n_q X).left y
  obtain ⟨j, p, hp⟩ := (a3s_CX X).cover x
  obtain ⟨i, hi⟩ := a3h_exists_notMem X (a3r_mat a) hfin x
  have hs : a3h_s X (a3r_mat a) j i ∉ p.asIdeal := by
    rwa [← (a3s_CX X).mem_prime_iff_of_isHomogeneous x j p hp _ 1
      (a3r_lin_X_isHomogeneous (a3r_mat a) i)]
  obtain ⟨p', hp'⟩ : ∃ p' : Spec (a3h_Rs X (a3r_mat a) j i),
      PrimeSpectrum.comap (algebraMap ((a3s_CX X).T j)
        (Localization.Away (a3h_s X (a3r_mat a) j i))) p' = p :=
    (PrimeSpectrum.localization_away_comap_range (Localization.Away (a3h_s X (a3r_mat a) j i))
      (a3h_s X (a3r_mat a) j i)).ge ((PrimeSpectrum.mem_basicOpen _ _).2 hs)
  let r := a3h_ιs X (a3r_mat a) j i ≫ (a3s_CX X).κ j
  obtain ⟨q, hq⟩ : (a3h_e X).hom y ∈ Set.range (a3m_prodChart r (g3c_chartι 1 0)) := by
    rw [a3m_range_prodChart]
    change _ ∈ Set.range r ∧ _
    rw [a3h_e_fst_apply]
    refine ⟨⟨p', ?_⟩, (a3h_mem_U_iff X y).mp hy⟩
    change (a3s_CX X).κ j (a3h_ιs X (a3r_mat a) j i p') = x
    exact (congrArg ((a3s_CX X).κ j) hp').trans hp
  let f := algebraMap ((a3s_CX X).T j) (Localization.Away (a3h_s X (a3r_mat a) j i))
  let g := a3h_ψ X (a3r_mat a) j i
  let tf := (Algebra.TensorProduct.map f.toIntAlgHom (AlgHom.id ℤ a3m_Away1)).toRingHom
  let tg := (Algebra.TensorProduct.map g.toIntAlgHom (AlgHom.id ℤ a3m_Away1)).toRingHom
  let κ := a3m_Tκ (a3s_CX X) j ≫ (a3h_e X).inv
  let κT := a3m_Tκ (a3m_projCharts n) i ≫ (a3h_e (a3h_PnO n)).inv
  have hα : Spec.map (CommRingCat.ofHom tf) ≫ a3m_Tκ (a3s_CX X) j =
      a3m_prodChart r (g3c_chartι 1 0) :=
    IntersectionProductScaf_productChart_ringMap
      ((a3s_CX X).T j) (a3h_Rs X (a3r_mat a) j i) (.of a3m_Away1)
      f ((a3s_CX X).κ j) (g3c_chartι 1 0)
  have hβ : Spec.map (CommRingCat.ofHom tg) ≫ a3m_Tκ (a3m_projCharts n) i =
      a3m_prodChart (r ≫ (a3h_πO X hfin).left) (g3c_chartι 1 0) := by
    have hh := IntersectionProductScaf_productChart_ringMap
      (a3m_PnT n i) (a3h_Rs X (a3r_mat a) j i) (.of a3m_Away1)
      g (a3m_Pnκ n i) (g3c_chartι 1 0)
    change Spec.map (CommRingCat.ofHom tg) ≫ a3m_prodChart (a3m_Pnκ n i)
      (g3c_chartι 1 0) = _
    rw [hh, show Spec.map (CommRingCat.ofHom g) ≫ a3m_Pnκ n i =
      r ≫ (a3h_πO X hfin).left from a3h_chart X hfin j i]
  have he : (Spec.map (CommRingCat.ofHom tf) ≫ κ) ≫
      (a3h_G (a3h_πO X hfin)).left = Spec.map (CommRingCat.ofHom tg) ≫ κT := by
    apply (cancel_mono (a3h_e (a3h_PnO n)).hom).mp
    simp only [κ, κT, Category.assoc, Iso.inv_hom_id, Category.comp_id]
    rw [← Category.assoc (Spec.map (CommRingCat.ofHom tf)), hα,
      IntersectionProductScaf_productMap_chart, hβ]
  have hαq : a3m_Tκ (a3s_CX X) j (Spec.map (CommRingCat.ofHom tf) q) =
      (a3h_e X).hom y := (congrArg (fun m => m q) hα).trans hq
  have hpκ : κ (Spec.map (CommRingCat.ofHom tf) q) = y := by
    change (a3h_e X).inv (a3m_Tκ (a3s_CX X) j (Spec.map (CommRingCat.ofHom tf) q)) = y
    rw [hαq]
    exact congrArg (fun f : (a3n_T X).left ⟶ (a3n_T X).left => f y) (a3h_e X).hom_inv_id
  have hsource : (a3s_LC X).κ j (Spec.map (CommRingCat.ofHom tf) q) = a3h_pt X y hy := by
    apply Subtype.ext
    change (a3m_U X.left).ι ((a3s_LC X).κ j (Spec.map (CommRingCat.ofHom tf) q)) = _
    erw [← Scheme.Hom.comp_apply, a3m_lineCharts_κ]
    exact hαq
  let _ : ∀ j, Algebra ℂ ((a3s_LC X).T j) := fun j =>
    (((a3s_LC X).θ j).comp (algebraMap ℂ (MvPolynomial (Fin (a3s_N X + 1)) (Polynomial ℂ)))).toAlgebra
  have hpos : 0 < a1p_degree (a3h_G (a3h_πO X hfin)).left (κ (Spec.map (CommRingCat.ofHom tf) q)) := by
    have := IntersectionProductScaf_projectionProduct_finite X hfin
    exact (a1d_degree_pos_iff _ _).mpr (IntersectionProductScaf_finite_height _ _)
  let u (k : Fin (n + 1)) := a3m_Tθ (a3s_CX X) j
    (IntersectionProductScaf_relativeLinear a (MvPolynomial.X k))
  let t := a3m_Tθ (a3s_CX X) j (MvPolynomial.C Polynomial.X)
  let w (k : Fin (n + 1)) := a3m_Tθ (a3m_projCharts n) i (MvPolynomial.X k)
  let t' := a3m_Tθ (a3m_projCharts n) i (MvPolynomial.C Polynomial.X)
  have hui : tf (u i) = f (a3h_s X (a3r_mat a) j i) ⊗ₜ[ℤ] (1 : a3m_Away1) := by
    have h := IntersectionProductScaf_relative_projection_chart X a j i _ 1
      (isHomogeneous_X (Polynomial ℂ) i)
    change tf (u i) = (f (a3h_s X (a3r_mat a) j i) ⊗ₜ[ℤ] (1 : a3m_Away1)) ^ 1 *
      tg (a3m_Tθ (a3m_projCharts n) i (MvPolynomial.X i)) at h
    rw [pow_one, a3m_Tθ_X_self, map_one, mul_one] at h
    exact h
  have hu (k : Fin (n + 1)) : tf (u k) = tf (u i) * tg (w k) := by
    rw [hui]
    have h := IntersectionProductScaf_relative_projection_chart X a j i _ 1
      (isHomogeneous_X (Polynomial ℂ) k)
    change tf (u k) = (f (a3h_s X (a3r_mat a) j i) ⊗ₜ[ℤ] (1 : a3m_Away1)) ^ 1 *
      tg (w k) at h
    simpa only [pow_one] using h
  have ht : tf t = tg t' := by
    have h := IntersectionProductScaf_relative_projection_chart X a j i _ 0
      (isHomogeneous_C _ Polynomial.X)
    simpa [t, t', tf, tg, f, g, IntersectionProductScaf_relativeLinear, pow_zero] using h
  have hv : tf (u i) ∉ q.asIdeal := by
    rw [hui]
    intro hm
    exact q.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem q.asIdeal hm
      ((IsLocalization.Away.algebraMap_isUnit (a3h_s X (a3r_mat a) j i)
        (S := Localization.Away (a3h_s X (a3r_mat a) j i))).map
        (Algebra.TensorProduct.includeLeftRingHom (R := ℤ) (B := a3m_Away1))))
  rw [← hpκ]
  apply IntersectionProductScaf_degree_one_of_refined_chart_rigidity
    (a3h_G (a3h_πO X hfin)) ((a3s_LC X).T j) (a3m_TT (a3m_projCharts n) i)
    (.of (Localization.Away (a3h_s X (a3r_mat a) j i) ⊗[ℤ] a3m_Away1))
    κ κT (IntersectionProductScaf_relative_chart_over X j)
    (CommRingCat.ofHom tf) (CommRingCat.ofHom tg) he q hpos u (u i) t w t' hv hu ht
  intro E _ _ φ ψ hφ z hproj ht
  apply (IntersectionProductScaf_relative_chart_map_rigidity (a3s_LC X)
    (fun _ _ => rfl) (a3h_pt X y hy) j (Spec.map (CommRingCat.ofHom tf) q)
    hsource a hsep E φ ψ hφ z ?_ ht).1
  intro k
  simp only [IntersectionProductScaf_eqT_linear_projection,
    IntersectionProductScaf_eq_linear_projection, a3h_eqT_inl, a3m_eq_C,
    MvPolynomial.map_X]
  exact hproj k
#print axioms IntersectionProductScaf_product_projection_degree_one_of_cone_separation

/-- A general finite product projection has degree one on all positive-codimension nonsection inputs in a finite set. -/
theorem IntersectionProductScaf_generic_nonsection_projection_degree_one
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom]
    {n : ℕ} (S : Finset (a3n_T X).left) (hn : Order.height (genericPoint X.left) = n) :
    a3r_Generic {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ |
      ∀ hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
          (a3r_lin (a3r_mat a)).toRingHom).Finite,
        ∀ y ∈ S, a3n_h X y = genericPoint (g3c_P 1) → coheight y ≠ 0 →
          (∀ c : ℂ, y ≠ a3n_σ X c (genericPoint X.left)) →
            a1p_degree (a3h_G (a3h_πO X hfin)).left y = 1} := by
  have hpoint (y : (a3n_T X).left) :
      a3r_Generic {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ |
        ∀ hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
            (a3r_lin (a3r_mat a)).toRingHom).Finite,
          a3n_h X y = genericPoint (g3c_P 1) → coheight y ≠ 0 →
            (∀ c : ℂ, y ≠ a3n_σ X c (genericPoint X.left)) →
              a1p_degree (a3h_G (a3h_πO X hfin)).left y = 1} := by
    by_cases h : a3n_h X y = genericPoint (g3c_P 1) ∧ coheight y ≠ 0 ∧
        (∀ c : ℂ, y ≠ a3n_σ X c (genericPoint X.left))
    · have hy := IntersectionProductScaf_parameter_generic_mem_U X y h.1
      refine (IntersectionProductScaf_generic_nonsection_cone_separates_maps
        X hn y hy h.2.1 h.2.2).mono ?_
      intro a ha hfin _ _ _
      exact IntersectionProductScaf_product_projection_degree_one_of_cone_separation X a hfin y hy ha
    · exact a3r_generic_univ.mono fun _ _ _ hdom hc hsec => (h ⟨hdom, hc, hsec⟩).elim
  exact (a3r_generic_iInter S _ (fun y _ => hpoint y)).mono fun _ ha hfin y hy => ha y hy hfin
#print axioms IntersectionProductScaf_generic_nonsection_projection_degree_one




/-- Specializing an endpoint-one fibre component satisfies the translated relative cone equations. -/
theorem IntersectionProductScaf_one_fibre_cone_equations
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom] {n : ℕ}
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (hn : Order.height (genericPoint X.left) = n)
    (M : Fin (n + 1) × Fin (n + 1) → ℂ) (hM : IsUnit (a3r_mat M).det)
    (y w z : (a3n_T X).left) (hy : y ∈ a3h_U X) (hz : z ∈ a3h_U X)
    (hw : IntersectionProductScaf_translationFibreCycle M a hfin y 1 w ≠ 0)
    (hwz : w ⤳ z) :
    ∀ F ∈ (a3h_P X y hy).comap (a3r_lin (a3h_block a)),
      a3r_lin (a3h_block a) (a3h_substT M F) ∈ a3h_P X z hz := by
  have hfin' := IntersectionProductScaf_matrix_projection_finite (a3s_IX X) a hfin (a3r_mat M) hM
  have hc : IsUnit ((IntersectionProductScaf_lineDet M).eval 1) := by
    rw [IntersectionProductScaf_lineDet_one]
    convert hM using 1 <;> congr 1
  have hi := (IntersectionProductScaf_translationFibreCycle_support X a hfin M 1 hc hn y w).mp hw
  rw [IntersectionProductScaf_squareFibreMap_one_projection X a hfin M hM hfin'] at hi
  have hs := hwz.map (a3h_G (a3h_πO X hfin')).left.continuous
  rw [hi] at hs
  have hp := IntersectionProductScaf_projectiveLinePrime_mono n _ _
    (IntersectionProductScaf_product_projection_mem_U _ y hy)
    (IntersectionProductScaf_product_projection_mem_U _ z hz) hs
  rw [IntersectionProductScaf_product_projection_cone_prime X a hfin y hy,
    IntersectionProductScaf_product_projection_cone_prime X
      (fun p => (a3r_mat M * a3r_mat a) p.1 p.2) hfin' z hz] at hp
  intro F hF
  rw [IntersectionProductScaf_block_translate_projection]
  exact hp hF
#print axioms IntersectionProductScaf_one_fibre_cone_equations

/-- One generic matrix bounds the cylinder intersections of all selected endpoint-one fibres. -/
theorem IntersectionProductScaf_one_fibre_cylinder_bound
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom] {n : ℕ}
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (beta : AlgebraicCycle X.left ℚ) (S : Finset (a3n_T X).left)
    (hn : Order.height (genericPoint X.left) = n) :
    a3r_Generic {M : Fin (n + 1) × Fin (n + 1) → ℂ |
      ∀ y ∈ S, a3n_h X y = genericPoint (g3c_P 1) → ∀ w,
        IntersectionProductScaf_translationFibreCycle M a hfin y 1 w ≠ 0 →
        ∀ v, beta v ≠ 0 → ∀ z ∈ a3y_comps w (a3n_b X v),
          a3n_p X z ∈ Set.range (a3m_Pnκ 1 0) →
          coheight w + coheight (a3n_b X v) ≤ coheight z + (0 : ℕ)} := by
  classical
  have H := a3r_generic_iInter (S.filter fun y => a3n_h X y = genericPoint (g3c_P 1)).attach _
    fun y _ => a3r_generic_iInter (a3m_support_finite beta).toFinset _ fun v _ =>
      IntersectionProductScaf_generic_relative_bound_of_equations X hfin hn y.1
        (IntersectionProductScaf_parameter_generic_mem_U X y.1 (Finset.mem_filter.mp y.2).2) v
  refine (IntersectionProductScaf_generic_det.inter H).mono ?_
  rintro M ⟨hM, hG⟩ y hy hdom w hw v hv z hz hzU
  simp only [Set.mem_setOf_eq] at hM
  have hdet : IsUnit (a3r_mat M).det := by convert hM using 1 <;> congr 1
  have hc : IsUnit ((IntersectionProductScaf_lineDet M).eval 1) := by
    rw [IntersectionProductScaf_lineDet_one]
    convert hdet using 1 <;> congr 1
  obtain ⟨hwz, hvz, -⟩ := a3y_comps_spec _ _ hz
  have hvq : v ⤳ (a3n_q X).left z := by
    simpa only [a3n_q_b] using hvz.map (a3n_q X).left.continuous
  have hb := hG ⟨y, Finset.mem_filter.mpr ⟨hy, hdom⟩⟩ (Finset.mem_attach _ _) v
    (by simpa only [Set.Finite.mem_toFinset, Function.mem_support] using hv) z hzU hvq
    (IntersectionProductScaf_one_fibre_cone_equations X a hfin hn M hdet y w z
      (IntersectionProductScaf_parameter_generic_mem_U X y hdom) hzU hw hwz)
  rw [IntersectionProductScaf_translationFibreCycle_coheight X a hfin M 1 hc hn y w hw,
    a3k_coheight_b, Nat.cast_zero, add_zero]
  exact hb
#print axioms IntersectionProductScaf_one_fibre_cylinder_bound

/-- Every distinct dominating member of the zero translation fibre is a cone residual. -/
theorem IntersectionProductScaf_zero_fibre_residual
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom] {n : ℕ}
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (hn : Order.height (genericPoint X.left) = n)
    (M : Fin (n + 1) × Fin (n + 1) → ℂ)
    (y w : (a3n_T X).left)
    (hy : a3n_h X y = genericPoint (g3c_P 1))
    (hw : a3n_h X w = genericPoint (g3c_P 1)) (hne : w ≠ y)
    (hf : IntersectionProductScaf_translationFibreCycle M a hfin y 0 w ≠ 0) :
    a3h_Residual X a y w := by
  have hyU := IntersectionProductScaf_parameter_generic_mem_U X y hy
  have hwU := IntersectionProductScaf_parameter_generic_mem_U X w hw
  have hi := (IntersectionProductScaf_translationFibreCycle_support X a hfin M 0
    (by rw [IntersectionProductScaf_lineDet_zero]; exact isUnit_one) hn y w).mp hf
  rw [IntersectionProductScaf_squareFibreMap_eq, IntersectionProductScaf_familyMap₁_zero] at hi
  refine ⟨hyU, hwU, ?_, hne⟩
  erw [← IntersectionProductScaf_product_projection_cone_prime X a hfin w hwU,
    ← IntersectionProductScaf_product_projection_cone_prime X a hfin y hyU]
  simp only [hi]
#print axioms IntersectionProductScaf_zero_fibre_residual

/-- Outside the input point and the residual locus, the zero-fibre difference coefficient vanishes. -/
theorem IntersectionProductScaf_zero_fibre_difference_off_input
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom] {n : ℕ}
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (hn : Order.height (genericPoint X.left) = n)
    (M : Fin (n + 1) × Fin (n + 1) → ℂ)
    (y w : (a3n_T X).left)
    (hy : a3n_h X y = genericPoint (g3c_P 1))
    (hw : a3n_h X w = genericPoint (g3c_P 1)) (hne : w ≠ y)
    (hr : ¬ a3h_Residual X a y w) :
    ((Function.locallyFinsuppWithin.single y 1 : AlgebraicCycle (a3n_T X).left ℚ) -
      IntersectionProductScaf_translationFibreCycle M a hfin y 0) w = 0 := by
  have hz : IntersectionProductScaf_translationFibreCycle M a hfin y 0 w = 0 := by
    by_contra h
    exact hr (IntersectionProductScaf_zero_fibre_residual X a hfin hn M y w hy hw hne h)
  simp only [Function.locallyFinsuppWithin.coe_sub, Pi.sub_apply,
    Function.locallyFinsuppWithin.single_apply, if_neg hne, hz, sub_self]
#print axioms IntersectionProductScaf_zero_fibre_difference_off_input

/-- A transcendental complex parameter is generic on the integral projective line. -/
theorem IntersectionProductScaf_transcendental_parameter_generic
    (c : ℂ) (hc : Transcendental ℤ c) :
    a3n_π (a3n_pt c (⟨⊥, Ideal.isPrime_bot⟩ : Spec ↧ℂ)) = genericPoint (g3c_P 1) := by
  let f : a3m_Away1 →+* ℂ := (a3n_evc c).comp
    (Algebra.TensorProduct.includeRight (R := ℤ) (A := ℂ) (B := a3m_Away1)).toRingHom
  have he : f.comp a3m_evt = (Polynomial.aeval c).toRingHom := by
    apply Polynomial.ringHom_ext
    · intro a
      exact congrArg (fun g : ℤ →+* ℂ => g a)
        (RingHom.ext_int ((f.comp a3m_evt).comp Polynomial.C)
          ((Polynomial.aeval c).toRingHom.comp Polynomial.C))
    · change a3n_evc c (Algebra.TensorProduct.includeRight (R := ℤ) (A := ℂ)
        (a3m_evt Polynomial.X)) = Polynomial.aeval c Polynomial.X
      rw [Polynomial.aeval_X]
      simp only [a3m_evt, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
      rw [← a3n_chartEquiv_X]
      simp [a3n_evc]
  have hf : Function.Injective f := by
    have hinj : Function.Injective (f.comp a3m_evt) := by
      rw [he]
      exact transcendental_iff_injective.mp hc
    intro x y hxy
    obtain ⟨p, rfl⟩ := a3m_evt_surjective x
    obtain ⟨q, rfl⟩ := a3m_evt_surjective y
    exact congrArg a3m_evt (hinj hxy)
  have hb : Spec.map (CommRingCat.ofHom f) (⟨⊥, Ideal.isPrime_bot⟩ : Spec ↧ℂ) = a3m_bot1 := by
    apply PrimeSpectrum.ext
    ext x
    change f x = 0 ↔ x = 0
    exact map_eq_zero_iff f hf
  have hmap : a3n_pt c ≫ a3n_π = Spec.map (CommRingCat.ofHom f) ≫ g3c_chartι 1 0 := by
    rw [a3n_pt, Category.assoc]
    change Spec.map _ ≫ a3m_prodChart (𝟙 _) (g3c_chartι 1 0) ≫ pullback.snd _ _ = _
    rw [a3m_prodChart_snd, ← Category.assoc, ← Spec.map_comp]
    rfl
  rw [← Scheme.Hom.comp_apply, hmap, Scheme.Hom.comp_apply, hb,
    a3m_genericPoint_P1, a3m_η1]
#print axioms IntersectionProductScaf_transcendental_parameter_generic
/-- Constant fibres at transcendental complex parameters satisfy the integral-line genericity test. -/
theorem IntersectionProductScaf_transcendental_section_dom
    (X : Over (Spec ↧ℂ)) (c : ℂ) (hc : Transcendental ℤ c) (x : X.left) :
    a3n_h X (a3n_σ X c x) = genericPoint (g3c_P 1) := by
  change ((a3n_σ X c ≫ a3n_p X) ≫ a3n_π) x = _
  rw [a3n_σ_p, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply,
    show X.hom x = (⟨⊥, Ideal.isPrime_bot⟩ : Spec ↧ℂ) from Subsingleton.elim _ _]
  exact IntersectionProductScaf_transcendental_parameter_generic c hc
#print axioms IntersectionProductScaf_transcendental_section_dom

/-- Product projection preserves the degree on each constant parameter section. -/
theorem IntersectionProductScaf_product_section_degree
    {X Y : Over (Spec ↧ℂ)} (g : X ⟶ Y) (c : ℂ) (x : X.left) :
    a1p_degree (a3h_G g).left (a3n_σ X c x) = a1p_degree g.left x := by
  have hclosed (W : Over (Spec ↧ℂ)) : IsClosedImmersion (a3n_σ W c) := by
    have : IsClosedImmersion (a3n_σ W c ≫ (a3n_q W).left) := by
      rw [a3n_σ_q]
      infer_instance
    exact IsClosedImmersion.of_comp _ (a3n_q W).left
  have := hclosed X
  have := hclosed Y
  have h := congrArg (fun f => a1p_degree f x)
    (IntersectionProductScaf_product_map_section g c)
  simpa only [a1p_degree_comp, a3m_degree_closedImmersion, mul_one, one_mul] using h
#print axioms IntersectionProductScaf_product_section_degree

/-- The inverse image of a whole constant fibre has multiplicity one. -/
theorem IntersectionProductScaf_product_pullback_section
    {X Y : Over (Spec ↧ℂ)} [IsIntegral X.left] [IsIntegral Y.left]
    (g : X ⟶ Y) (c : ℂ) :
    ccm3_flatPullbackPrime (a3h_G g).left (a3n_σ Y c (genericPoint Y.left)) =
      Function.locallyFinsuppWithin.single (a3n_σ X c (genericPoint X.left)) 1 := by
  have : IsClosedImmersion (a3n_σ X c ≫ (a3n_q X).left) := by
    rw [a3n_σ_q]
    infer_instance
  have : IsClosedImmersion (a3n_σ X c) := IsClosedImmersion.of_comp _ (a3n_q X).left
  change a2g_fundCycle (((ccm3_primeIdeal _ _).comap (a3h_G g).left).subschemeι) = _
  rw [← a2g_ker_eq_primeIdeal]
  have h := IntersectionProductScaf_parameter_section_ker Y X
    (a3h_G g).left (𝟙 _) (by rw [Category.id_comp, a3h_G_p]) c
  rw [h, Scheme.IdealSheafData.comap_id, a2g_fundCycle_ker,
    a2g_fundCycle_of_isIntegral]
#print axioms IntersectionProductScaf_product_pullback_section

/-- The zero translation fibre of a whole constant section carries the projection degree. -/
theorem IntersectionProductScaf_zero_constant_section
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom]
    {n : ℕ} (M : Fin (n + 1) × Fin (n + 1) → ℂ)
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (hn : Order.height (genericPoint X.left) = n) (c : ℂ) :
    IntersectionProductScaf_translationFibreCycle M a hfin
        (a3n_σ X c (genericPoint X.left)) 0 =
      a3m_smul (a1p_degree (a3h_πO X hfin).left (genericPoint X.left) : ℚ)
        (Function.locallyFinsuppWithin.single (a3n_σ X c (genericPoint X.left)) 1) := by
  have : IsIntegral (a3h_PnO n).left :=
    IntersectionProductScaf_projectionTarget_integral X hfin hn
  have hg : (a3h_πO X hfin).left (genericPoint X.left) =
      genericPoint (a3h_PnO n).left := by
    obtain ⟨u, hu⟩ := a3h_π_surjective X hfin (a3h_dim_cone X n hn)
      (genericPoint (a3h_PnO n).left)
    change (a3h_πO X hfin).left u = genericPoint (a3h_PnO n).left at hu
    have hs := (genericPoint_specializes u).map (a3h_πO X hfin).left.continuous
    rw [hu] at hs
    exact (hs.antisymm (genericPoint_specializes _)).eq
  rw [IntersectionProductScaf_translationFibreCycle_zero,
    IntersectionProductScaf_product_section_degree]
  have hp := congrArg (fun f => f (genericPoint X.left))
    (IntersectionProductScaf_product_map_section (a3h_πO X hfin) c)
  change (a3h_G (a3h_πO X hfin)).left (a3n_σ X c (genericPoint X.left)) =
    a3n_σ (a3h_PnO n) c ((a3h_πO X hfin).left (genericPoint X.left)) at hp
  rw [hp, hg, IntersectionProductScaf_product_pullback_section]
#print axioms IntersectionProductScaf_zero_constant_section

/-- An unramified local map has residue-fibre length one. -/
theorem IntersectionProductScaf_unramified_local_fibre_length
    {A B : Type*} [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B]
    [Algebra A B] [IsLocalHom (algebraMap A B)] [Algebra.EssFiniteType A B]
    [Algebra.FormallyUnramified A B] :
    Module.length B (B ⧸ (IsLocalRing.maximalIdeal A).map (algebraMap A B)) = 1 := by
  rw [Algebra.FormallyUnramified.map_maximalIdeal]
  exact Module.length_eq_one_iff.mpr (isSimpleModule_iff_isCoatom.mpr
    (Ideal.isMaximal_def.mp (IsLocalRing.maximalIdeal.isMaximal B)))
#print axioms IntersectionProductScaf_unramified_local_fibre_length

/-- Flat unramified local base change preserves quotient length. -/
theorem IntersectionProductScaf_flat_unramified_quotient_length
    {A B : Type*} [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B]
    [Algebra A B] [IsLocalHom (algebraMap A B)] [Module.Flat A B]
    [Algebra.EssFiniteType A B] [Algebra.FormallyUnramified A B] (I : Ideal A) :
    Module.length B (B ⧸ I.map (algebraMap A B)) = Module.length A (A ⧸ I) := by
  rw [IntersectionProductScaf_flat_local_quotient_length,
    IntersectionProductScaf_unramified_local_fibre_length, mul_one]
#print axioms IntersectionProductScaf_flat_unramified_quotient_length

set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
/-- A prime inverse image has coefficient one at an unramified point of a quasi-finite generalizing map. -/
theorem IntersectionProductScaf_pullbackPrime_coeff_of_unramified
    {U Z : Over (Spec ↧ℂ)}
    [LocallyOfFiniteType U.hom] [QuasiCompact U.hom]
    [LocallyOfFiniteType Z.hom] [QuasiCompact Z.hom]
    (f : U ⟶ Z) [LocallyQuasiFinite f.left] (hf : GeneralizingMap f.left)
    (z : Z.left) (u : U.left) (hfu : f.left u = z)
    (hun : (f.left.stalkMap u).hom.FormallyUnramified) :
    ccm3_flatPullbackPrime f.left z u = 1 := by
  have : LocallyOfFiniteType (f.left ≫ Z.hom) := by rw [f.w]; infer_instance
  have : LocallyOfFiniteType f.left := locallyOfFiniteType_of_comp f.left Z.hom
  have hnonzero := (IntersectionProductScaf_pullbackPrime_support_iff f hf z u).mpr hfu
  obtain ⟨x, hx, hcomp⟩ := (ccm3_flatPullbackPrime_support f z u).mp hnonzero
  dsimp only [ccm3_inverseIdeal] at x hx hcomp
  rw [← hx] at hfu hun ⊢
  refine (ccm3_flatPullbackPrime_coeff f z x hcomp).trans ?_
  have hlen : ccm3_genericLength f.left z x = 1 := by
    let y := ((ccm3_primeIdeal Z.left z).comap f.left).subschemeι x
    let A := Z.left.presheaf.stalk (f.left y)
    let B := U.left.presheaf.stalk y
    let := (f.left.stalkMap y).hom.toAlgebra
    have : IsLocalHom (algebraMap A B) := inferInstanceAs (IsLocalHom (f.left.stalkMap y).hom)
    have : Algebra.EssFiniteType A B := by
      rw [← RingHom.essFiniteType_algebraMap, RingHom.algebraMap_toAlgebra]
      exact LocallyOfFiniteType.stalkMap f.left y
    have : Algebra.FormallyUnramified A B := by
      rw [← RingHom.formallyUnramified_algebraMap, RingHom.algebraMap_toAlgebra]
      exact hun
    obtain ⟨V, hV, hyV, _⟩ := exists_isAffineOpen_mem_and_subset
      (show f.left y ∈ (⊤ : Z.left.Opens) from trivial)
    have hker : RingHom.ker ((ccm3_inverseIdeal f.left z).subschemeι.stalkMap x).hom =
        (IsLocalRing.maximalIdeal A).map (f.left.stalkMap y).hom := by
      change RingHom.ker (((ccm3_primeIdeal Z.left z).comap f.left).subschemeι.stalkMap x).hom = _
      rw [IntersectionProductScaf_comap_stalk_kernel f.left (ccm3_primeIdeal Z.left z)
        x ⟨V, hV⟩ hyV]
      change ((ccm3_primeIdeal Z.left z).ideal ⟨V, hV⟩ |>.map
        (Z.left.presheaf.germ V (f.left y) hyV).hom).map (f.left.stalkMap y).hom = _
      rw [a3l_map_primeIdeal_eq_stalkIdeal (show z ⤳ f.left y from by rw [hfu]) ⟨V, hV⟩ hyV]
      apply congrArg (Ideal.map (f.left.stalkMap y).hom)
      exact (congrArg (a3i_stalkIdeal Z.left (f.left y)) hfu.symm).trans
        (a3c_stalkIdeal_self Z.left (f.left y))
    unfold ccm3_genericLength
    rw [← a3l_length_quot_ker ((ccm3_inverseIdeal f.left z).subschemeι.stalkMap x).hom
      ((ccm3_inverseIdeal f.left z).subschemeι.stalkMap_surjective x) _ hker]
    exact IntersectionProductScaf_unramified_local_fibre_length (A := A) (B := B)
  rw [hlen]
  norm_num
#print axioms IntersectionProductScaf_pullbackPrime_coeff_of_unramified

/-- Unit projection degree and an unramified stalk give unit self coefficient in the zero translation fibre. -/
theorem IntersectionProductScaf_zero_self_of_degree_one_unramified
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom]
    {n : ℕ} (M : Fin (n + 1) × Fin (n + 1) → ℂ)
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (hn : Order.height (genericPoint X.left) = n) (y : (a3n_T X).left)
    (hd : a1p_degree (a3h_G (a3h_πO X hfin)).left y = 1)
    (hun : ((a3h_G (a3h_πO X hfin)).left.stalkMap y).hom.FormallyUnramified) :
    IntersectionProductScaf_translationFibreCycle M a hfin y 0 y = 1 := by
  have := IntersectionProductScaf_projectionProduct_finite X hfin
  rw [IntersectionProductScaf_translationFibreCycle_zero, a3m_smul_apply, hd, Nat.cast_one,
    one_mul]
  exact IntersectionProductScaf_pullbackPrime_coeff_of_unramified
    (a3h_G (a3h_πO X hfin))
    (IntersectionProductScaf_projectionProduct_generalizing a hfin hn) _ y rfl hun
#print axioms IntersectionProductScaf_zero_self_of_degree_one_unramified

/-- A transcendental constant section with projection degree different from one violates the zero-fibre alternative. -/
theorem IntersectionProductScaf_constant_section_obstruction
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom]
    {n : ℕ} (M : Fin (n + 1) × Fin (n + 1) → ℂ)
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (hn : Order.height (genericPoint X.left) = n) (c : ℂ)
    (hc : Transcendental ℤ c)
    (hd : a1p_degree (a3h_πO X hfin).left (genericPoint X.left) ≠ 1) :
    let y := a3n_σ X c (genericPoint X.left)
    a3n_h X y = genericPoint (g3c_P 1) ∧
      ¬ a3h_Residual X a y y ∧ coheight y ≠ 0 ∧
      ((Function.locallyFinsuppWithin.single y 1 : AlgebraicCycle (a3n_T X).left ℚ) -
        IntersectionProductScaf_translationFibreCycle M a hfin y 0) y ≠ 0 := by
  dsimp only
  refine ⟨IntersectionProductScaf_transcendental_section_dom X c hc _, ?_, ?_, ?_⟩
  · rintro ⟨_, _, _, hne⟩
    exact hne rfl
  · rw [a3k_coheight_σ_generic]
    exact one_ne_zero
  · rw [IntersectionProductScaf_zero_constant_section X M a hfin hn c]
    simp only [Function.locallyFinsuppWithin.coe_sub, Pi.sub_apply,
      a3m_smul_apply, Function.locallyFinsuppWithin.single_apply, ite_true, mul_one]
    intro h
    have he : (a1p_degree (a3h_πO X hfin).left (genericPoint X.left) : ℚ) = 1 :=
      (sub_eq_zero.mp h).symm
    exact hd (by exact_mod_cast he)
#print axioms IntersectionProductScaf_constant_section_obstruction


/-- A whole constant fibre meets every comparison cylinder in the expected codimension. -/
theorem IntersectionProductScaf_constant_section_cylinder
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom]
    (c : ℂ) (v : X.left) (z : (a3n_T X).left)
    (hz : z ∈ a3y_comps (a3n_σ X c (genericPoint X.left)) (a3n_b X v)) :
    coheight (a3n_σ X c (genericPoint X.left)) + coheight (a3n_b X v) ≤
      coheight z + (0 : ℕ) := by
  have hs := a3y_comps_spec _ _ hz
  obtain ⟨x, rfl⟩ := a3n_mem_range_σ_of_specializes X c hs.1
  have hx : v ⤳ x := by
    simpa only [a3n_q_σ_apply] using (a3n_b_specializes_iff X v _).mp hs.2.1
  rw [a3k_coheight_σ_generic, a3k_coheight_b, a3n_coheight_σ,
    Nat.cast_zero, add_zero, add_comm (1 : ℕ∞)]
  simpa only [add_comm] using
    add_le_add_right (Order.coheight_anti (Scheme.le_iff_specializes.mpr hx)) 1
#print axioms IntersectionProductScaf_constant_section_cylinder

/-- A whole constant fibre satisfying the integral-line domination test has excess zero. -/
theorem IntersectionProductScaf_constant_section_excess_of_dom
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom]
    (beta : AlgebraicCycle X.left ℚ) (c : ℂ)
    (hc : a3n_h X (a3n_σ X c (genericPoint X.left)) = genericPoint (g3c_P 1)) :
    a3k_ExcessLE X beta (a3n_σ X c (genericPoint X.left)) 0 := by
  have hdom (x : X.left) : a3n_h X (a3n_σ X c x) = genericPoint (g3c_P 1) := by
    have he : a3n_h X (a3n_σ X c x) =
        a3n_h X (a3n_σ X c (genericPoint X.left)) := by
      change ((a3n_σ X c ≫ a3n_p X) ≫ a3n_π) x =
        ((a3n_σ X c ≫ a3n_p X) ≫ a3n_π) (genericPoint X.left)
      rw [a3n_σ_p]
      exact congrArg (fun p => a3n_π (a3n_pt c p)) (Subsingleton.elim _ _)
    exact he.trans hc
  intro v hv
  refine ⟨fun z hz _ => IntersectionProductScaf_constant_section_cylinder X c v z hz, ?_, ?_⟩
  · intro z hz
    have hs := a3y_comps_spec _ _ hz
    obtain ⟨x, rfl⟩ := a3n_mem_range_σ_of_specializes X c hs.1
    obtain ⟨x', hx'⟩ := a3n_mem_range_σ_of_specializes X 0 hs.2.1
    have hb := a3n_h_σ0 X x'
    rw [hx', hdom] at hb
    exact (a3k_generic_not_mem_Z0 hb).elim
  · intro z hz
    have hs := a3y_comps_spec _ _ hz
    obtain ⟨x, rfl⟩ := a3n_mem_range_σ_of_specializes X c hs.1
    obtain ⟨x', hx'⟩ := a3n_mem_range_σ_of_specializes X 1 hs.2.1
    have hb := a3n_h_σ1 X x'
    rw [hx', hdom] at hb
    exact (a3k_generic_not_mem_Zinf hb).elim
#print axioms IntersectionProductScaf_constant_section_excess_of_dom

/-- A whole constant fibre at a transcendental parameter has excess zero. -/
theorem IntersectionProductScaf_constant_section_excess
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom]
    (beta : AlgebraicCycle X.left ℚ) (c : ℂ) (hc : Transcendental ℤ c) :
    a3k_ExcessLE X beta (a3n_σ X c (genericPoint X.left)) 0 := by
  intro v hv
  have hdom (z : (a3n_T X).left)
      (hz : a3n_σ X c (genericPoint X.left) ⤳ z) :
      a3n_h X z = genericPoint (g3c_P 1) := by
    obtain ⟨x, rfl⟩ := a3n_mem_range_σ_of_specializes X c hz
    exact IntersectionProductScaf_transcendental_section_dom X c hc x
  refine ⟨?_, ?_, ?_⟩
  · intro z hz _
    have hs := a3y_comps_spec _ _ hz
    obtain ⟨x, rfl⟩ := a3n_mem_range_σ_of_specializes X c hs.1
    have hx : v ⤳ x := by
      simpa only [a3n_q_σ_apply] using (a3n_b_specializes_iff X v _).mp hs.2.1
    rw [a3k_coheight_σ_generic, a3k_coheight_b, a3n_coheight_σ,
      Nat.cast_zero, add_zero, add_comm (1 : ℕ∞)]
    simpa only [add_comm] using
      add_le_add_right (Order.coheight_anti (Scheme.le_iff_specializes.mpr hx)) 1
  · intro z hz
    have hs := a3y_comps_spec _ _ hz
    obtain ⟨x, hx⟩ := a3n_mem_range_σ_of_specializes X 0 hs.2.1
    have hg := hdom z hs.1
    have hb := a3n_h_σ0 X x
    rw [hx, hg] at hb
    exact (a3k_generic_not_mem_Z0 hb).elim
  · intro z hz
    have hs := a3y_comps_spec _ _ hz
    obtain ⟨x, hx⟩ := a3n_mem_range_σ_of_specializes X 1 hs.2.1
    have hg := hdom z hs.1
    have hb := a3n_h_σ1 X x
    rw [hx, hg] at hb
    exact (a3k_generic_not_mem_Zinf hb).elim
#print axioms IntersectionProductScaf_constant_section_excess

/-- If every finite projection has degree different from one, the zero-fibre alternative fails even after both generic choices. -/
theorem IntersectionProductScaf_constant_section_not_generic
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom]
    {n : ℕ} (hn : Order.height (genericPoint X.left) = n)
    (c : ℂ) (hc : Transcendental ℤ c)
    (hd : ∀ (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
      (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
        (a3r_lin (a3r_mat a)).toRingHom).Finite),
      a1p_degree (a3h_πO X hfin).left (genericPoint X.left) ≠ 1) :
    ¬ a3r_Generic {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ |
      ∀ hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
          (a3r_lin (a3r_mat a)).toRingHom).Finite,
        a3r_Generic {M : Fin (n + 1) × Fin (n + 1) → ℂ |
          ∀ y ∈ ({a3n_σ X c (genericPoint X.left)} : Finset (a3n_T X).left),
            a3n_h X y = genericPoint (g3c_P 1) → ∀ y',
              a3n_h X y' = genericPoint (g3c_P 1) → ¬ a3h_Residual X a y y' →
                coheight y' = 0 ∨
                ((Function.locallyFinsuppWithin.single y 1 : AlgebraicCycle (a3n_T X).left ℚ) -
                  IntersectionProductScaf_translationFibreCycle M a hfin y 0) y' = 0}} := by
  intro h
  have hfin := a3r_generic_finite (a3s_IX X) (a3s_IX_isHomogeneous X)
    (a3h_dim_cone X n hn)
  obtain ⟨a, hfa, ha⟩ := (hfin.inter h).nonempty
  obtain ⟨M, hM⟩ := (ha hfa).nonempty
  obtain ⟨hdom, hres, hheight, hcoeff⟩ :=
    IntersectionProductScaf_constant_section_obstruction X M a hfa hn c hc (hd a hfa)
  rcases hM _ (Finset.mem_singleton_self _) hdom _ hdom hres with he | he
  · exact hheight he
  · exact hcoeff he
#print axioms IntersectionProductScaf_constant_section_not_generic

