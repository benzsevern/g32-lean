/-- The evaluated square projection lifts generalizations on every invertible translation fibre. -/
theorem IntersectionProductScaf_squareFibreMap_generalizing
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] [Smooth X.hom] {n : ℕ}
    {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
