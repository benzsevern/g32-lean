/-- Codimension-zero input points have excess zero against every comparison cycle. -/
theorem IntersectionProductScaf_excess_zero_of_coheight_zero
    (beta : AlgebraicCycle X.left ℚ) (y : (a3n_T X).left) (hy : coheight y = 0) :
    a3k_ExcessLE X beta y 0 := by
  intro v hv
  have hbound (w z : (a3n_T X).left) (hz : z ∈ a3y_comps y w) :
      coheight y + coheight w ≤ coheight z + (0 : ℕ) := by
    rw [hy, zero_add, Nat.cast_zero, add_zero]
    exact a3k_coheight_le_of_specializes X (a3y_comps_spec _ _ hz).2.1
  exact ⟨fun z hz _ => hbound _ z hz, fun z hz => hbound _ z hz,
    fun z hz => hbound _ z hz⟩
#print axioms IntersectionProductScaf_excess_zero_of_coheight_zero

/-- Nonresidual zero-fibre coefficients either have excess zero or cancel the input coefficient. -/
theorem IntersectionProductScaf_components_zero_residual
    (beta : AlgebraicCycle X.left ℚ)
    (S : Finset (a3n_T X).left) (hn : Order.height (genericPoint X.left) = n) :
    a3r_Generic {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ |
      ∀ hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
          (a3r_lin (a3r_mat a)).toRingHom).Finite,
        a3r_Generic {M : Fin (n + 1) × Fin (n + 1) → ℂ |
          ∀ y ∈ S, a3n_h X y = genericPoint (g3c_P 1) → ∀ y',
            a3n_h X y' = genericPoint (g3c_P 1) → ¬ a3h_Residual X a y y' →
              a3k_ExcessLE X beta y' 0 ∨
              ((Function.locallyFinsuppWithin.single y 1 : AlgebraicCycle (a3n_T X).left ℚ) -
                IntersectionProductScaf_translationFibreCycle M a hfin y 0) y' = 0}} := by
  refine (IntersectionProductScaf_zero_self_coefficient (X := X) S hn).mono ?_
  intro a ha hfin
  refine a3r_generic_univ.mono ?_
  intro M _ y hy hdom y' hdom' hres
  by_cases he : y' = y
  · subst y'
    by_cases hh : coheight y = 0
    · exact Or.inl (IntersectionProductScaf_excess_zero_of_coheight_zero beta y hh)
    by_cases hs : ∃ c : ℂ, y = a3n_σ X c (genericPoint X.left)
    · obtain ⟨c, rfl⟩ := hs
      exact Or.inl (IntersectionProductScaf_constant_section_excess_of_dom X beta c hdom)
    · right
      have hc := ha hfin M y hy hdom hh (fun c he => hs ⟨c, he⟩)
      simp only [Function.locallyFinsuppWithin.coe_sub, Pi.sub_apply,
        Function.locallyFinsuppWithin.single_apply, ite_true, hc, sub_self]
  · exact Or.inr (IntersectionProductScaf_zero_fibre_difference_off_input X a hfin hn M
      y y' hdom hdom' he hres)

/-- The endpoint-one fibre meets comparison cylinders in expected codimension. -/
theorem IntersectionProductScaf_components_one_cylinder
    (beta : AlgebraicCycle X.left ℚ) (S : Finset (a3n_T X).left)
    (hn : Order.height (genericPoint X.left) = n) :
    a3r_Generic {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ |
      ∀ hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
          (a3r_lin (a3r_mat a)).toRingHom).Finite,
        a3r_Generic {M : Fin (n + 1) × Fin (n + 1) → ℂ |
          ∀ y ∈ S, a3n_h X y = genericPoint (g3c_P 1) → ∀ y',
            (IntersectionProductScaf_translationFibreCycle M a hfin y 1) y' ≠ 0 →
            a3n_h X y' = genericPoint (g3c_P 1) → ∀ v, beta v ≠ 0 →
              ∀ z ∈ a3y_comps y' (a3n_b X v),
                a3n_p X z ∈ Set.range (a3m_Pnκ 1 0) →
                  coheight y' + coheight (a3n_b X v) ≤ coheight z + (0 : ℕ)}} := by
  refine a3r_generic_univ.mono fun a _ hfin => ?_
  refine (IntersectionProductScaf_one_fibre_cylinder_bound X a hfin beta S hn).mono ?_
