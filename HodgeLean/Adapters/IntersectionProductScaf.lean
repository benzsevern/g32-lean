/-- With identity matrix, the glued map is the original projection after base change. -/
theorem IntersectionProductScaf_translatedProjection₀_one
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] {n : ℕ}
    {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (Z : Over (Spec ↧ℂ)) (q : Z.left ⟶ X.left) :
    IntersectionProductScaf_translatedProjection₀ X hfin Z q 1
      (by rw [Matrix.det_one]; exact isUnit_one) = q ≫ a3h_π₀ X hfin := by
  apply (IntersectionProductScaf_projectionCover X Z q).hom_ext
  intro j
  rw [IntersectionProductScaf_translatedProjection₀_chart]
  change _ = pullback.fst q ((a3s_CX X).κ j) ≫ q ≫ a3h_π₀ X hfin
  rw [← Category.assoc, pullback.condition, Category.assoc, a3h_κ_π₀]
  have hi : (HomogeneousIdeal.irrelevant (UniversalGrading n)).toIdeal.map
      ((pullback.snd q ((a3s_CX X).κ j)).appTop.hom.comp
        (a3h_sect X (a3r_mat a) j)) = ⊤ := by
    rw [← Ideal.map_map, a3h_sect_irrelevant X hfin, Ideal.map_top]
  rw [a3h_chartMap, spec_g3c_comp_fromOfGlobalSections_aux _ _ _ _ hi]
  unfold IntersectionProductScaf_translatedChart
  congr 1
  unfold IntersectionProductScaf_translatedSections IntersectionProductScaf_chartMatrix
  rw [map_one, IntersectionProductScaf_matrixSections_one]
  rfl

#print axioms IntersectionProductScaf_translatedProjection₀_one

