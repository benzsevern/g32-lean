/-- Restricting an ideal to an affine open agrees with its affine ideal under the top-sections isomorphism. -/
theorem IntersectionProductScaf_restrict_ideal_top
    {Y : Scheme} (I : Y.IdealSheafData) (U : Y.affineOpens) :
    ((I.comap U.1.ι).ideal ⟨⊤, @isAffineOpen_top U.1.toScheme U.2⟩).map U.1.topIso.hom.hom = I.ideal U := by
  rw [Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion]
  simp only [Scheme.Opens.ι_appIso, Iso.refl_inv]
  change (I.ideal ⟨U.1.ι ''ᵁ ⊤, _⟩).map
    (Y.presheaf.map (eqToHom U.1.ι_image_top.symm).op).hom = I.ideal U
  exact I.map_ideal (le_of_eq (Subtype.ext U.1.ι_image_top.symm))
#print axioms IntersectionProductScaf_restrict_ideal_top

