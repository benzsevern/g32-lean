/-- A component supported at translation parameter zero cannot dominate that parameter. -/
theorem IntersectionProductScaf_not_square_of_s_vertical
    (w : (a3n_T (a3n_T X)).left)
    (hw : w ∈ Set.range (a3n_σ (a3n_T X) 0)) : ¬ a3k_SquarePos X w := by
