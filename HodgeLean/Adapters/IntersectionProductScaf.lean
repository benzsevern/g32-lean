section ParameterCompatibility

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
open CategoryTheory.Limits

variable (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] {n : ℕ}
  {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
  (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp (a3r_lin (a3r_mat a)).toRingHom).Finite)
  (M : Fin (n + 1) × Fin (n + 1) → ℂ)

/-- Forget the original parameter while retaining the translation parameter. -/
def IntersectionProductScaf_forgetOriginal :
    IntersectionProductScaf_familyOpen (a3n_T X) M ⟶ IntersectionProductScaf_familyOpen X M :=
  Over.homMk
    (pullback.lift ((IntersectionProductScaf_familyBase (a3n_T X) M ≫ a3n_q X).left)
      (pullback.snd (a3n_T X).hom (IntersectionProductScaf_parameterOver M).hom)
      ((IntersectionProductScaf_familyBase (a3n_T X) M ≫ a3n_q X).w.trans pullback.condition))
    ((pullback.lift_fst_assoc _ _ _ _).trans
      (IntersectionProductScaf_familyBase (a3n_T X) M ≫ a3n_q X).w)

/-- Forgetting the original parameter preserves the coordinates on `X`. -/
theorem IntersectionProductScaf_forgetOriginal_base :
    (IntersectionProductScaf_forgetOriginal X M).left ≫
        (IntersectionProductScaf_familyBase X M).left =
      (IntersectionProductScaf_familyBase (a3n_T X) M).left ≫ (a3n_q X).left :=
  pullback.lift_fst _ _ _

/-- The translation matrix is independent of the original parameter. -/
theorem IntersectionProductScaf_forgetOriginal_matrix :
    (IntersectionProductScaf_forgetOriginal X M).left.appTop.hom.mapMatrix
        (IntersectionProductScaf_familyMatrix X M) =
      IntersectionProductScaf_familyMatrix (a3n_T X) M := by
  ext i j
  change (IntersectionProductScaf_forgetOriginal X M).left.appTop
    ((pullback.snd X.hom (IntersectionProductScaf_parameterOver M).hom).appTop
      ((Scheme.ΓSpecIso (.of (IntersectionProductScaf_lineRing M))).inv
        (IntersectionProductScaf_localLineMatrix M i j))) = _
  erw [← a3m_appTop_comp_apply]
  have hp : (IntersectionProductScaf_forgetOriginal X M).left ≫
      pullback.snd X.hom (IntersectionProductScaf_parameterOver M).hom =
        pullback.snd (a3n_T X).hom (IntersectionProductScaf_parameterOver M).hom :=
    pullback.lift_snd _ _ _
  rw [hp]
  rfl

/-- The projective part of the square family is the one-parameter translation after
forgetting the original parameter. -/
theorem IntersectionProductScaf_squareMapToProjective_eq :
    IntersectionProductScaf_squareMapToProjective X hfin M =
      IntersectionProductScaf_forgetOriginal X M ≫ IntersectionProductScaf_familyMap₀ X hfin M := by
  let g := IntersectionProductScaf_forgetOriginal X M
  have hB : IsUnit (g.left.appTop.hom.mapMatrix (IntersectionProductScaf_familyMatrix X M)).det := by
    rw [IntersectionProductScaf_forgetOriginal_matrix]
    exact IntersectionProductScaf_familyMatrix_det (a3n_T X) M
  have h := IntersectionProductScaf_translatedProjection₀_natural X hfin
    (IntersectionProductScaf_familyOpen X M) (IntersectionProductScaf_familyOpen (a3n_T X) M)
    (IntersectionProductScaf_familyBase X M).left g.left
    (IntersectionProductScaf_familyMatrix X M) (IntersectionProductScaf_familyMatrix_det X M) hB
  dsimp only [g] at h
  simp only [IntersectionProductScaf_forgetOriginal_base,
    IntersectionProductScaf_forgetOriginal_matrix] at h
  apply Over.OverMorphism.ext
  change (IntersectionProductScaf_squareMapToProjective X hfin M).left =
    g.left ≫ (IntersectionProductScaf_familyMap₀ X hfin M).left
  apply pullback.hom_ext
  · change (IntersectionProductScaf_squareMapToProjective X hfin M).left ≫
        (a3h_PnO n).hom =
      (g.left ≫ (IntersectionProductScaf_familyMap₀ X hfin M).left) ≫ (a3h_PnO n).hom
    rw [Category.assoc, (IntersectionProductScaf_familyMap₀ X hfin M).w, g.w]
    exact (IntersectionProductScaf_squareMapToProjective X hfin M).w
  · change (pullback.lift _ _ _) ≫ pullback.snd _ _ =
      (g.left ≫ pullback.lift _ _ _) ≫ pullback.snd _ _
    rw [pullback.lift_snd, Category.assoc, pullback.lift_snd]
    exact h.symm

/-- The original parameter is retained by the square-family map. -/
theorem IntersectionProductScaf_familyMap₁_parameter :
    (IntersectionProductScaf_familyMap₁ X hfin M).left ≫ a3n_p (a3h_PnO n) =
      (IntersectionProductScaf_originalParameter X M).left :=
  pullback.lift_snd _ _ _


#print axioms IntersectionProductScaf_forgetOriginal_base
#print axioms IntersectionProductScaf_forgetOriginal_matrix
#print axioms IntersectionProductScaf_squareMapToProjective_eq
#print axioms IntersectionProductScaf_familyMap₁_parameter

/-- Forgetting the original parameter commutes with every section of the open family. -/
theorem IntersectionProductScaf_familySection_forgetOriginal (c : ℂ)
    (hc : IsUnit ((IntersectionProductScaf_lineDet M).eval c)) :
    IntersectionProductScaf_familySection (a3n_T X) M c hc ≫
      (IntersectionProductScaf_forgetOriginal X M).left =
        (a3n_q X).left ≫ IntersectionProductScaf_familySection X M c hc := by
  apply pullback.hom_ext
  · change (_ ≫ pullback.lift _ _ _) ≫ pullback.fst _ _ =
      (_ ≫ pullback.lift _ _ _) ≫ pullback.fst _ _
    rw [Category.assoc, pullback.lift_fst, Category.assoc, pullback.lift_fst]
    change IntersectionProductScaf_familySection (a3n_T X) M c hc ≫
      (IntersectionProductScaf_familyBase (a3n_T X) M).left ≫ (a3n_q X).left =
        (a3n_q X).left ≫ 𝟙 X.left
    rw [← Category.assoc]
    simp only [IntersectionProductScaf_familySection, IntersectionProductScaf_familyBase,
      Over.homMk_left, pullback.lift_fst, Category.id_comp, Category.comp_id]
  · change (_ ≫ pullback.lift _ _ _) ≫ pullback.snd _ _ =
      (_ ≫ pullback.lift _ _ _) ≫ pullback.snd _ _
    rw [Category.assoc, pullback.lift_snd, Category.assoc, pullback.lift_snd]
    change (pullback.lift _ _ _) ≫ pullback.snd _ _ = _
    rw [pullback.lift_snd, ← Category.assoc, (a3n_q X).w]

#print axioms IntersectionProductScaf_familySection_forgetOriginal

/-- At translation parameter zero the square map is the original product projection. -/
theorem IntersectionProductScaf_familyMap₁_zero :
    IntersectionProductScaf_familySection (a3n_T X) M 0 (by
      rw [IntersectionProductScaf_lineDet_zero]; exact isUnit_one) ≫
        (IntersectionProductScaf_familyMap₁ X hfin M).left =
          (a3h_G (a3h_πO X hfin)).left := by
  apply pullback.hom_ext
  · change (_ ≫ pullback.lift _ _ _) ≫ pullback.fst _ _ = _
    rw [Category.assoc, pullback.lift_fst, IntersectionProductScaf_squareMapToProjective_eq]
    change IntersectionProductScaf_familySection (a3n_T X) M 0 _ ≫
      (IntersectionProductScaf_forgetOriginal X M).left ≫
      (IntersectionProductScaf_familyMap₀ X hfin M).left = _
    rw [← Category.assoc, IntersectionProductScaf_familySection_forgetOriginal,
      Category.assoc, IntersectionProductScaf_familyMap₀_zero]
    exact (a3h_G_q (a3h_πO X hfin)).symm
  · change (_ ≫ (IntersectionProductScaf_familyMap₁ X hfin M).left) ≫
      a3n_p (a3h_PnO n) = (a3h_G (a3h_πO X hfin)).left ≫ a3n_p (a3h_PnO n)
    rw [Category.assoc, IntersectionProductScaf_familyMap₁_parameter, a3h_G_p]
    change IntersectionProductScaf_familySection (a3n_T X) M 0 _ ≫
      (IntersectionProductScaf_familyBase (a3n_T X) M).left ≫ a3n_p X = a3n_p X
    rw [← Category.assoc]
    simp only [IntersectionProductScaf_familySection, IntersectionProductScaf_familyBase,
      Over.homMk_left, pullback.lift_fst, Category.id_comp]

#print axioms IntersectionProductScaf_familyMap₁_zero

/-- The extended square ideal restricts at zero to the inverse image under the product projection. -/
theorem IntersectionProductScaf_squareIdeal_zero
    (I : (a3n_T (a3h_PnO n)).left.IdealSheafData) :
    ((I.comap (IntersectionProductScaf_familyMap₁ X hfin M).left).map
      (IntersectionProductScaf_familyInclusion (a3n_T X) M).left).comap
        (a3n_σ (a3n_T X) 0) = I.comap (a3h_G (a3h_πO X hfin)).left := by
  rw [← IntersectionProductScaf_familySection_inclusion (a3n_T X) M 0 (by
    rw [IntersectionProductScaf_lineDet_zero]; exact isUnit_one),
    Scheme.IdealSheafData.comap_comp, IntersectionProductScaf_open_ideal_restrict,
    ← Scheme.IdealSheafData.comap_comp, IntersectionProductScaf_familyMap₁_zero]

#print axioms IntersectionProductScaf_squareIdeal_zero

/-- The square family's zero fibre has the inverse-image cycle of the product projection,
with all generic-length coefficients retained. -/
theorem IntersectionProductScaf_square_zero_fundCycle
    (z : (a3n_T (a3h_PnO n)).left) :
    a2g_fundCycle (((ccm3_inverseIdeal (IntersectionProductScaf_familyMap₁ X hfin M).left z).map
      (IntersectionProductScaf_familyInclusion (a3n_T X) M).left).comap
        (a3n_σ (a3n_T X) 0)).subschemeι =
          ccm3_flatPullbackPrime (a3h_G (a3h_πO X hfin)).left z := by
  change a2g_fundCycle ((((ccm3_primeIdeal _ z).comap
    (IntersectionProductScaf_familyMap₁ X hfin M).left).map
      (IntersectionProductScaf_familyInclusion (a3n_T X) M).left).comap
        (a3n_σ (a3n_T X) 0)).subschemeι = _
  rw [IntersectionProductScaf_squareIdeal_zero]
  rfl

#print axioms IntersectionProductScaf_square_zero_fundCycle

end ParameterCompatibility

section ParameterProduct
open scoped MonoidalCategory
open CartesianMonoidalCategory

/-- Reordering the two parameter factors identifies the open square with a projective family. -/
def IntersectionProductScaf_originalProductIso (X : Over (Spec ↧ℂ))
    {σ : Type} [Fintype σ] (M : σ × σ → ℂ) :
    IntersectionProductScaf_familyOpen (a3n_T X) M ≅
      a3n_T (IntersectionProductScaf_familyOpen X M) where
  hom := lift (lift (fst _ _ ≫ fst _ _) (snd _ _)) (fst _ _ ≫ snd _ _)
  inv := lift (lift (fst _ _ ≫ fst _ _) (snd _ _)) (fst _ _ ≫ snd _ _)
  hom_inv_id := by
    apply hom_ext
    · apply hom_ext <;>
        simp only [Category.assoc, lift_fst_assoc, lift_fst, lift_snd,
          Category.id_comp]
    · simp only [Category.assoc, lift_fst_assoc, lift_snd,
        Category.id_comp]
  inv_hom_id := by
    apply hom_ext
    · apply hom_ext <;>
        simp only [Category.assoc, lift_fst_assoc, lift_fst, lift_snd,
          Category.id_comp]
    · simp only [Category.assoc, lift_fst_assoc, lift_snd,
        Category.id_comp]

#print axioms IntersectionProductScaf_originalProductIso

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
variable (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] {n : ℕ}
  {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
  (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp (a3r_lin (a3r_mat a)).toRingHom).Finite)
  (M : Fin (n + 1) × Fin (n + 1) → ℂ)

omit [IsIntegral X.left] [IsProjective X.hom] in
/-- The product identification has the prescribed projection to the one-parameter family. -/
theorem IntersectionProductScaf_originalProductIso_base :
    (IntersectionProductScaf_originalProductIso X M).hom ≫
      a3n_q (IntersectionProductScaf_familyOpen X M) =
        IntersectionProductScaf_forgetOriginal X M := by
  change lift (lift (fst _ _ ≫ fst _ _) (snd _ _)) (fst _ _ ≫ snd _ _) ≫ fst _ _ = _
  rw [lift_fst]
  rfl

omit [IsIntegral X.left] [IsProjective X.hom] in
/-- The product identification retains the original projective parameter. -/
theorem IntersectionProductScaf_originalProductIso_parameter :
    (IntersectionProductScaf_originalProductIso X M).hom.left ≫
      a3n_p (IntersectionProductScaf_familyOpen X M) =
        (IntersectionProductScaf_originalParameter X M).left := by
  change ((IntersectionProductScaf_originalProductIso X M).hom ≫
    snd (IntersectionProductScaf_familyOpen X M) a3n_P1).left = _
  exact congrArg Over.Hom.left (lift_snd _ _)

/-- Under the product identification the square map is the product of the translation map
with the identity of the original parameter. -/
theorem IntersectionProductScaf_familyMap₁_product :
    IntersectionProductScaf_familyMap₁ X hfin M =
      (IntersectionProductScaf_originalProductIso X M).hom ≫
        a3h_G (IntersectionProductScaf_familyMap₀ X hfin M) := by
  apply Over.OverMorphism.ext
  apply CategoryTheory.Limits.pullback.hom_ext
  · change (CategoryTheory.Limits.pullback.lift _ _ _) ≫
      CategoryTheory.Limits.pullback.fst _ _ = _
    rw [CategoryTheory.Limits.pullback.lift_fst]
    have h := congrArg Over.Hom.left
      (IntersectionProductScaf_squareMapToProjective_eq X hfin M)
    rw [h]
    change _ = ((IntersectionProductScaf_originalProductIso X M).hom ≫
      (IntersectionProductScaf_familyMap₀ X hfin M ▷ a3n_P1) ≫ fst _ _).left
    rw [whiskerRight_fst, ← Category.assoc]
    change _ = ((IntersectionProductScaf_originalProductIso X M).hom ≫
      a3n_q (IntersectionProductScaf_familyOpen X M) ≫ _).left
    rw [← Category.assoc, IntersectionProductScaf_originalProductIso_base]
  · rw [IntersectionProductScaf_familyMap₁_parameter]
    change _ = ((IntersectionProductScaf_originalProductIso X M).hom ≫
      (IntersectionProductScaf_familyMap₀ X hfin M ▷ a3n_P1) ≫ snd _ _).left
    rw [whiskerRight_snd]
    exact (IntersectionProductScaf_originalProductIso_parameter X M).symm

/-- Generalization lifting for the product family passes through the parameter reordering. -/
theorem IntersectionProductScaf_familyMap₁_generalizing_of_product
    (h : GeneralizingMap (a3h_G
      (IntersectionProductScaf_familyMap₀ X hfin M)).left) :
    GeneralizingMap (IntersectionProductScaf_familyMap₁ X hfin M).left := by
  have hc :=
    (IntersectionProductScaf_originalProductIso X M).hom.left.isOpenEmbedding.generalizingMap.comp h
  rw [congrArg Over.Hom.left (IntersectionProductScaf_familyMap₁_product X hfin M)]
  change GeneralizingMap (fun x => (a3h_G
    (IntersectionProductScaf_familyMap₀ X hfin M)).left
      ((IntersectionProductScaf_originalProductIso X M).hom.left x))
  exact hc

#print axioms IntersectionProductScaf_originalProductIso_base
#print axioms IntersectionProductScaf_originalProductIso_parameter
#print axioms IntersectionProductScaf_familyMap₁_product
#print axioms IntersectionProductScaf_familyMap₁_generalizing_of_product

end ParameterProduct

section ParameterFaces
open CategoryTheory.Limits
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

/-- A product map carries a parameter section to the same parameter section. -/
theorem IntersectionProductScaf_product_section {U V : Over (Spec ↧ℂ)}
    (f : U ⟶ V) (c : ℂ) :
    a3n_σ U c ≫ (a3h_G f).left = f.left ≫ a3n_σ V c := by
  apply pullback.hom_ext
  · change (a3n_σ U c ≫ (a3h_G f).left) ≫ (a3n_q V).left =
      (f.left ≫ a3n_σ V c) ≫ (a3n_q V).left
    rw [Category.assoc, a3h_G_q, ← Category.assoc, a3n_σ_q,
      Category.id_comp, Category.assoc, a3n_σ_q, Category.comp_id]
  · change (a3n_σ U c ≫ (a3h_G f).left) ≫ a3n_p V =
      (f.left ≫ a3n_σ V c) ≫ a3n_p V
    rw [Category.assoc, a3h_G_p, a3n_σ_p, Category.assoc, a3n_σ_p,
      ← Category.assoc, f.w]

/-- Restriction of a product map to any parameter section is a pullback square. -/
theorem IntersectionProductScaf_product_section_isPullback {U V : Over (Spec ↧ℂ)}
    (f : U ⟶ V) (c : ℂ) :
    IsPullback (a3n_σ U c) f.left (a3h_G f).left (a3n_σ V c) := by
  apply IsPullback.of_bot (v₂₁ := V.hom) (v₂₂ := a3n_p V)
  · rw [f.w, a3h_G_p]
    exact a3n_isPullback U c
  · exact IntersectionProductScaf_product_section f c
  · exact a3n_isPullback V c

variable (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] {n : ℕ}
  {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
  (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp (a3r_lin (a3r_mat a)).toRingHom).Finite)
  (M : Fin (n + 1) × Fin (n + 1) → ℂ)

/-- The original parameter section on the open translation square. -/
def IntersectionProductScaf_originalFace (c : ℂ) :
    (IntersectionProductScaf_familyOpen X M).left ⟶
      (IntersectionProductScaf_familyOpen (a3n_T X) M).left :=
  a3n_σ (IntersectionProductScaf_familyOpen X M) c ≫
    (IntersectionProductScaf_originalProductIso X M).inv.left

/-- The inverse-translation map restricts to its one-parameter version on each original face. -/
theorem IntersectionProductScaf_originalFace_map (c : ℂ) :
    IntersectionProductScaf_originalFace X M c ≫
      (IntersectionProductScaf_familyMap₁ X hfin M).left =
        (IntersectionProductScaf_familyMap₀ X hfin M).left ≫ a3n_σ (a3h_PnO n) c := by
  rw [IntersectionProductScaf_familyMap₁_product]
  change (a3n_σ _ c ≫ (IntersectionProductScaf_originalProductIso X M).inv.left) ≫
    (IntersectionProductScaf_originalProductIso X M).hom.left ≫ _ = _
  have he : (IntersectionProductScaf_originalProductIso X M).inv.left ≫
      (IntersectionProductScaf_originalProductIso X M).hom.left = 𝟙 _ :=
    congrArg Over.Hom.left (IntersectionProductScaf_originalProductIso X M).inv_hom_id
  rw [Category.assoc, ← Category.assoc (IntersectionProductScaf_originalProductIso X M).inv.left,
    he, Category.id_comp]
  exact IntersectionProductScaf_product_section _ c

/-- Each original face of the translation map is its scheme-theoretic base change. -/
theorem IntersectionProductScaf_originalFace_isPullback (c : ℂ) :
    IsPullback (IntersectionProductScaf_originalFace X M c)
      (IntersectionProductScaf_familyMap₀ X hfin M).left
      (IntersectionProductScaf_familyMap₁ X hfin M).left (a3n_σ (a3h_PnO n) c) := by
  let e := (Over.forget (Spec ↧ℂ)).mapIso (IntersectionProductScaf_originalProductIso X M)
  refine (IntersectionProductScaf_product_section_isPullback
    (IntersectionProductScaf_familyMap₀ X hfin M) c).of_iso'
      (Iso.refl _) e (Iso.refl _) (Iso.refl _) ?_ ?_ ?_ ?_
  · change 𝟙 _ ≫ a3n_σ _ c = (a3n_σ _ c ≫
      (IntersectionProductScaf_originalProductIso X M).inv.left) ≫
        (IntersectionProductScaf_originalProductIso X M).hom.left
    rw [Category.id_comp, Category.assoc, ← Over.comp_left, Iso.inv_hom_id,
      Over.id_left, Category.comp_id]
  · simp only [Iso.refl_hom, Category.id_comp, Category.comp_id]
  · simp only [Iso.refl_hom, Category.comp_id]
    exact (congrArg Over.Hom.left (IntersectionProductScaf_familyMap₁_product X hfin M)).symm
  · simp only [Iso.refl_hom, Category.id_comp, Category.comp_id]


#print axioms IntersectionProductScaf_product_section
#print axioms IntersectionProductScaf_product_section_isPullback
#print axioms IntersectionProductScaf_originalFace
#print axioms IntersectionProductScaf_originalFace_map
#print axioms IntersectionProductScaf_originalFace_isPullback

/-- The original face ideal is the pullback of the target parameter-section ideal. -/
theorem IntersectionProductScaf_originalFace_ker
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom]
    {n : ℕ} {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (M : Fin (n + 1) × Fin (n + 1) → ℂ) (c : ℂ) :
    (IntersectionProductScaf_originalFace X M c).ker =
      (a3n_σ (a3h_PnO n) c).ker.comap (IntersectionProductScaf_familyMap₁ X hfin M).left := by
  have : IsClosedImmersion (a3n_σ (a3h_PnO n) c ≫ (a3n_q (a3h_PnO n)).left) := by
    rw [a3n_σ_q]
    infer_instance
  have : IsClosedImmersion (a3n_σ (a3h_PnO n) c) :=
    IsClosedImmersion.of_comp _ (a3n_q (a3h_PnO n)).left
  have h := IntersectionProductScaf_originalFace_isPullback X hfin M c
  rw [← h.isoPullback_hom_fst, Scheme.Hom.ker_comp_of_isIso,
    Scheme.IdealSheafData.ker_fst_of_isClosedImmersion]
#print axioms IntersectionProductScaf_originalFace_ker

/-- Restricting an inverse-image ideal to an original face commutes with inverse translation. -/
theorem IntersectionProductScaf_originalFace_ideal (c : ℂ)
    (I : (a3n_T (a3h_PnO n)).left.IdealSheafData) :
    (I.comap (IntersectionProductScaf_familyMap₁ X hfin M).left).comap
      (IntersectionProductScaf_originalFace X M c) =
    (I.comap (a3n_σ (a3h_PnO n) c)).comap
      (IntersectionProductScaf_familyMap₀ X hfin M).left := by
  rw [← Scheme.IdealSheafData.comap_comp, IntersectionProductScaf_originalFace_map,
    Scheme.IdealSheafData.comap_comp]

/-- The fundamental cycle of a restricted square inverse-image ideal is the fundamental
cycle of the corresponding line-family inverse-image ideal. -/
theorem IntersectionProductScaf_originalFace_fundCycle (c : ℂ)
    (I : (a3n_T (a3h_PnO n)).left.IdealSheafData) :
    a2g_fundCycle (((I.comap
      (IntersectionProductScaf_familyMap₁ X hfin M).left).comap
        (IntersectionProductScaf_originalFace X M c)).subschemeι) =
      a2g_fundCycle (((I.comap (a3n_σ (a3h_PnO n) c)).comap
        (IntersectionProductScaf_familyMap₀ X hfin M).left).subschemeι) := by
  rw [IntersectionProductScaf_originalFace_ideal]

#print axioms IntersectionProductScaf_originalFace_fundCycle

/-- Restricting an actual prime square family to an original face gives the fundamental
cycle of the line-family inverse image of the restricted prime ideal. -/
theorem IntersectionProductScaf_originalFace_prime_fundCycle (c : ℂ)
    (z : (a3n_T (a3h_PnO n)).left) :
    a2g_fundCycle ((((ccm3_primeIdeal _ z).comap
      (IntersectionProductScaf_familyMap₁ X hfin M).left).comap
        (IntersectionProductScaf_originalFace X M c)).subschemeι) =
      a2g_fundCycle (((((ccm3_primeIdeal _ z).comap
        (a3n_σ (a3h_PnO n) c)).comap
          (IntersectionProductScaf_familyMap₀ X hfin M).left).subschemeι)) := by
  exact IntersectionProductScaf_originalFace_fundCycle X hfin M c (ccm3_primeIdeal _ z)

#print axioms IntersectionProductScaf_originalFace_prime_fundCycle

/-- The inverse image of a parameter face is exactly the corresponding face of the open square. -/
theorem IntersectionProductScaf_originalFace_range (c : ℂ) :
    Set.range (IntersectionProductScaf_originalFace X M c) =
      (IntersectionProductScaf_familyMap₁ X hfin M).left ⁻¹'
        Set.range (a3n_σ (a3h_PnO n) c) := by
  have h := IntersectionProductScaf_originalFace_isPullback X hfin M c
  have he : IntersectionProductScaf_originalFace X M c = h.isoPullback.hom ≫
      pullback.fst (IntersectionProductScaf_familyMap₁ X hfin M).left
        (a3n_σ (a3h_PnO n) c) := h.isoPullback_hom_fst.symm
  rw [he, Scheme.Hom.comp_base, TopCat.coe_comp, Set.range_comp,
    Set.range_eq_univ.2 h.isoPullback.hom.surjective,
    Set.image_univ, Scheme.Pullback.range_fst]

#print axioms IntersectionProductScaf_originalFace_ideal
#print axioms IntersectionProductScaf_originalFace_range

end ParameterFaces

section FaceInclusion
open scoped MonoidalCategory
open CartesianMonoidalCategory
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
variable (X : Over (Spec ↧ℂ)) {n : ℕ}
  (M : Fin (n + 1) × Fin (n + 1) → ℂ)

/-- The reordered section is the product of the original section with the open parameter. -/
theorem IntersectionProductScaf_originalFace_tensor (c : ℂ) :
    IntersectionProductScaf_originalFace X M c =
      ((a3k_σO X c) ▷ IntersectionProductScaf_parameterOver M).left := by
  have h : a3k_σO (IntersectionProductScaf_familyOpen X M) c =
      (a3k_σO X c ▷ IntersectionProductScaf_parameterOver M) ≫
        (IntersectionProductScaf_originalProductIso X M).hom := by
    apply hom_ext
    · change a3k_σO (IntersectionProductScaf_familyOpen X M) c ≫
        a3n_q (IntersectionProductScaf_familyOpen X M) = _
      rw [a3k_σO_q]
      change 𝟙 _ = (a3k_σO X c ▷ IntersectionProductScaf_parameterOver M) ≫
        (lift (lift (fst _ _ ≫ fst _ _) (snd _ _)) (fst _ _ ≫ snd _ _)) ≫ fst _ _
      rw [lift_fst, comp_lift, whiskerRight_fst_assoc, whiskerRight_snd]
      change 𝟙 _ = lift (fst _ _ ≫ a3k_σO X c ≫ a3n_q X) (snd _ _)
      rw [a3k_σO_q, Category.comp_id, lift_fst_snd]
    · apply Over.OverMorphism.ext
      change a3n_σ (IntersectionProductScaf_familyOpen X M) c ≫
        a3n_p (IntersectionProductScaf_familyOpen X M) = _
      rw [a3n_σ_p]
      change _ = ((a3k_σO X c ▷ IntersectionProductScaf_parameterOver M) ≫
        (lift (lift (fst _ _ ≫ fst _ _) (snd _ _)) (fst _ _ ≫ snd _ _)) ≫ snd _ _).left
      rw [lift_snd, whiskerRight_fst_assoc]
      change _ = (CategoryTheory.Limits.pullback.fst X.hom
        (IntersectionProductScaf_parameterOver M).hom ≫ a3n_σ X c) ≫ a3n_p X
      rw [Category.assoc, a3n_σ_p, ← Category.assoc]
      rfl
  have hh := congrArg Over.Hom.left h
  change (a3k_σO (IntersectionProductScaf_familyOpen X M) c).left ≫
    (IntersectionProductScaf_originalProductIso X M).inv.left = _
  rw [hh]
  change ((a3k_σO X c ▷ IntersectionProductScaf_parameterOver M) ≫
    (IntersectionProductScaf_originalProductIso X M).hom ≫
    (IntersectionProductScaf_originalProductIso X M).inv).left = _
  rw [Iso.hom_inv_id, Category.comp_id]

/-- The open original face embeds as the corresponding face of the projective square. -/
theorem IntersectionProductScaf_originalFace_inclusion (c : ℂ) :
    IntersectionProductScaf_originalFace X M c ≫
      (IntersectionProductScaf_familyInclusion (a3n_T X) M).left =
        (IntersectionProductScaf_familyInclusion X M).left ≫ a3k_ι X c := by
  rw [IntersectionProductScaf_originalFace_tensor]
  change ((a3k_σO X c ▷ IntersectionProductScaf_parameterOver M) ≫
      (𝟙 (a3n_T X) ⊗ₘ IntersectionProductScaf_parameterOverInclusion M)).left =
    ((𝟙 X ⊗ₘ IntersectionProductScaf_parameterOverInclusion M) ≫
      (a3k_σO X c ▷ a3n_P1)).left
  simp only [← MonoidalCategory.tensorHom_id, MonoidalCategory.tensorHom_comp_tensorHom,
    Category.comp_id, Category.id_comp]

#print axioms IntersectionProductScaf_originalFace_tensor
#print axioms IntersectionProductScaf_originalFace_inclusion

set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
/-- The original open face is the base change of the original section along the parameter projection. -/
theorem IntersectionProductScaf_originalFace_base_isPullback
    (X : Over (Spec ↧ℂ)) {n : ℕ} (M : Fin (n + 1) × Fin (n + 1) → ℂ) (c : ℂ) :
    IsPullback (IntersectionProductScaf_originalFace X M c)
      (IntersectionProductScaf_familyBase X M).left
      (IntersectionProductScaf_familyBase (a3n_T X) M).left (a3n_σ X c) := by
  have hf : IntersectionProductScaf_originalFace X M c ≫
      (IntersectionProductScaf_familyBase (a3n_T X) M).left =
      (IntersectionProductScaf_familyBase X M).left ≫ a3n_σ X c := by
    rw [IntersectionProductScaf_originalFace_tensor]
    simp [Over.whiskerRight_left, IntersectionProductScaf_familyBase, a3k_σO]
  have hs : IntersectionProductScaf_originalFace X M c ≫
      CategoryTheory.Limits.pullback.snd (a3n_T X).hom (IntersectionProductScaf_parameterOver M).hom =
      CategoryTheory.Limits.pullback.snd X.hom (IntersectionProductScaf_parameterOver M).hom := by
    rw [IntersectionProductScaf_originalFace_tensor]
    simp [Over.whiskerRight_left]
  refine IsPullback.of_right
    (h₁₂ := CategoryTheory.Limits.pullback.snd (a3n_T X).hom (IntersectionProductScaf_parameterOver M).hom)
    (h₂₂ := (a3n_T X).hom) (v₁₃ := (IntersectionProductScaf_parameterOver M).hom)
    ?_ hf (IsPullback.of_hasPullback _ _).flip
  rw [hs, show a3n_σ X c ≫ (a3n_T X).hom = X.hom from (a3k_σO X c).w]
  exact (IsPullback.of_hasPullback _ _).flip
#print axioms IntersectionProductScaf_originalFace_base_isPullback


end FaceInclusion

section FamilyDomination
open CategoryTheory.Limits
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

variable (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] {n : ℕ}
    {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (M : Fin (n + 1) × Fin (n + 1) → ℂ)

/-- The open family inclusion preserves its projection to the original family. -/
theorem IntersectionProductScaf_familyInclusion_base :
    (IntersectionProductScaf_familyInclusion (a3n_T X) M).left ≫
      (a3n_q (a3n_T X)).left =
        (IntersectionProductScaf_familyBase (a3n_T X) M).left := by
  change pullback.map _ _ _ _ (𝟙 (a3n_T X).left)
    (IntersectionProductScaf_parameterInclusion M) (𝟙 (Spec ↧ℂ))
    (by simp only [Category.comp_id, Category.id_comp]) (by exact Category.comp_id _) ≫
      pullback.fst _ _ = pullback.fst _ _
  rw [pullback.map, pullback.lift_fst, Category.comp_id]

set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
/-- The endpoint ideal on the determinant-open square is the restriction of its ambient section ideal. -/
theorem IntersectionProductScaf_originalFace_restrict_ker
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] {n : ℕ}
    (M : Fin (n + 1) × Fin (n + 1) → ℂ) (c : ℂ) :
    (a3k_ι X c).ker.comap (IntersectionProductScaf_familyInclusion (a3n_T X) M).left =
      (IntersectionProductScaf_originalFace X M c).ker := by
  have : IsClosedImmersion (a3n_σ X c ≫ (a3n_q X).left) := by
    rw [a3n_σ_q]
    infer_instance
  have : IsClosedImmersion (a3n_σ X c) := IsClosedImmersion.of_comp _ (a3n_q X).left
  have h := a3k_isPullback X c
  have ho := IntersectionProductScaf_originalFace_base_isPullback X M c
  rw [← h.isoPullback_hom_fst, Scheme.Hom.ker_comp_of_isIso,
    Scheme.IdealSheafData.ker_fst_of_isClosedImmersion, ← Scheme.IdealSheafData.comap_comp,
    IntersectionProductScaf_familyInclusion_base X M]
  rw [← ho.isoPullback_hom_fst, Scheme.Hom.ker_comp_of_isIso,
    Scheme.IdealSheafData.ker_fst_of_isClosedImmersion]
#print axioms IntersectionProductScaf_originalFace_restrict_ker

/-- The original parameter of a family member specializes that of its input. -/
theorem IntersectionProductScaf_theta₁_parameter_specializes
    (y : (a3n_T X).left) (w : (a3n_T (a3n_T X)).left)
    (hw : IntersectionProductScaf_theta₁ X hfin M
      (a1p_pushforward (a3h_G (a3h_πO X hfin)).left
        (Function.locallyFinsuppWithin.single y 1)) w ≠ 0) :
    a3n_h X y ⤳ a3n_h X ((a3n_q (a3n_T X)).left w) := by
  obtain ⟨u, hu, hfu⟩ := IntersectionProductScaf_openFamilyCycle_push_single_specializes
    (IntersectionProductScaf_familyInclusion (a3n_T X) M)
    (IntersectionProductScaf_familyMap₁ X hfin M)
    (a3h_G (a3h_πO X hfin)) y w hw
  have hh := hfu.map (a3n_h (a3h_PnO n)).continuous
  rw [a3h_G_h_apply] at hh
  have hp := congrArg (fun f : (IntersectionProductScaf_familyOpen (a3n_T X) M).left ⟶
      a3n_P1.left => f u) (IntersectionProductScaf_familyMap₁_parameter X hfin M)
  change a3n_p (a3h_PnO n) ((IntersectionProductScaf_familyMap₁ X hfin M).left u) =
    a3n_p X ((IntersectionProductScaf_familyBase (a3n_T X) M).left u) at hp
  have hh' := congrArg a3n_π hp
  change a3n_h (a3h_PnO n) ((IntersectionProductScaf_familyMap₁ X hfin M).left u) =
    a3n_h X ((IntersectionProductScaf_familyBase (a3n_T X) M).left u) at hh'
  rw [hh'] at hh
  rw [← hu]
  change a3n_h X y ⤳ a3n_h X
    (((IntersectionProductScaf_familyInclusion (a3n_T X) M).left ≫
      (a3n_q (a3n_T X)).left) u)
  rw [IntersectionProductScaf_familyInclusion_base]
  exact hh

#print axioms IntersectionProductScaf_theta₁_parameter_specializes

/-- A vertical input has no family member dominating the original parameter. -/
theorem IntersectionProductScaf_theta₁_not_dom_t
    (y : (a3n_T X).left) (hy : a3n_h X y ≠ genericPoint (g3c_P 1))
    (w : (a3n_T (a3n_T X)).left)
    (hw : IntersectionProductScaf_theta₁ X hfin M
      (a1p_pushforward (a3h_G (a3h_πO X hfin)).left
        (Function.locallyFinsuppWithin.single y 1)) w ≠ 0) :
    a3n_h X ((a3n_q (a3n_T X)).left w) ≠ genericPoint (g3c_P 1) := by
  intro hdom
  have h := IntersectionProductScaf_theta₁_parameter_specializes X hfin M y w hw
  rw [hdom] at h
  exact hy ((h.antisymm (genericPoint_specializes _)).eq)

#print axioms IntersectionProductScaf_theta₁_not_dom_t

/-- Lifting generalizations along the square-family map gives domination of the original
parameter for each member over a dominating input prime. -/
theorem IntersectionProductScaf_theta₁_dom_t_of_generalizing
    (hf : GeneralizingMap (IntersectionProductScaf_familyMap₁ X hfin M).left)
    (y : (a3n_T X).left) (hy : a3n_h X y = genericPoint (g3c_P 1))
    (w : (a3n_T (a3n_T X)).left)
    (hw : IntersectionProductScaf_theta₁ X hfin M
      (a1p_pushforward (a3h_G (a3h_πO X hfin)).left
        (Function.locallyFinsuppWithin.single y 1)) w ≠ 0) :
    a3n_h X ((a3n_q (a3n_T X)).left w) = genericPoint (g3c_P 1) := by
  obtain ⟨u, hu, hfu⟩ := IntersectionProductScaf_openFamilyCycle_push_single_image
    (IntersectionProductScaf_familyInclusion (a3n_T X) M)
    (IntersectionProductScaf_familyMap₁ X hfin M) hf
    (a3h_G (a3h_πO X hfin)) y w hw
  have hq : (a3n_q (a3n_T X)).left
      ((IntersectionProductScaf_familyInclusion (a3n_T X) M).left u) =
        (IntersectionProductScaf_familyBase (a3n_T X) M).left u := by
    change ((IntersectionProductScaf_familyInclusion (a3n_T X) M).left ≫
      (a3n_q (a3n_T X)).left) u = _
    rw [IntersectionProductScaf_familyInclusion_base]
  have hp := congrArg (fun f : (IntersectionProductScaf_familyOpen (a3n_T X) M).left ⟶
      a3n_P1.left => f u) (IntersectionProductScaf_familyMap₁_parameter X hfin M)
  change a3n_p (a3h_PnO n) ((IntersectionProductScaf_familyMap₁ X hfin M).left u) =
    a3n_p X ((IntersectionProductScaf_familyBase (a3n_T X) M).left u) at hp
  have hh : a3n_h (a3h_PnO n) ((IntersectionProductScaf_familyMap₁ X hfin M).left u) =
      a3n_h X ((IntersectionProductScaf_familyBase (a3n_T X) M).left u) :=
    congrArg a3n_π hp
  rw [← hu, hq, ← hh, hfu, a3h_G_h_apply, hy]

#print axioms IntersectionProductScaf_familyInclusion_base
#print axioms IntersectionProductScaf_theta₁_dom_t_of_generalizing

/-- A generalizing square-family map supplies original-parameter domination in square position. -/
theorem IntersectionProductScaf_squarePos_of_generalizing
    [Smooth X.hom]
    (hf : GeneralizingMap (IntersectionProductScaf_familyMap₁ X hfin M).left)
    (y : (a3n_T X).left) (hy : a3n_h X y = genericPoint (g3c_P 1))
    (w : (a3n_T (a3n_T X)).left)
    (hw : IntersectionProductScaf_theta₁ X hfin M
      (a1p_pushforward (a3h_G (a3h_πO X hfin)).left
        (Function.locallyFinsuppWithin.single y 1)) w ≠ 0)
    (hdoms : a3n_h (a3n_T X) w = genericPoint (g3c_P 1))
    (hfaces : ∀ d, a3o_cyc (a3n_T X) w hdoms d ≠ 0 →
      a3n_h X ((a3n_q (a3n_T X)).left d) = genericPoint (g3c_P 1))
    (hfacet : ∀ c : ℂ, (c = 0 ∨ c = 1) → ∀ z ∈ a3y_comps w (a3k_E X c),
      a3n_h (a3n_T X) z ∉ a3m_Z0 ∧ a3n_h (a3n_T X) z ∉ a3m_Zinf) :
    a3k_SquarePos X w where
  dom_s := hdoms
  dom_t := IntersectionProductScaf_theta₁_dom_t_of_generalizing
    X hfin M hf y hy w hw
  face_s := hfaces
  face_t := hfacet

#print axioms IntersectionProductScaf_squarePos_of_generalizing

end FamilyDomination

section BoundarySpecializations

variable (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom]

/-- Every term of a prime boundary lies under a specialization of the input prime. -/
theorem IntersectionProductScaf_piece_specializes
    (y : (a3n_T X).left) (x : X.left) (hx : a3k_piece X y x ≠ 0) :
    (a3n_q X).left y ⤳ x := by
  by_cases hy : a3n_h X y = genericPoint (g3c_P 1)
  · rw [a3k_piece_of_dom X y hy,
      a3o_pushforward_apply X _ (a3o_cyc_supp X y hy)] at hx
    have hs (c : ℂ) (hc : a3o_cyc X y hy (a3n_σ X c x) ≠ 0) :
        (a3n_q X).left y ⤳ x := by
      obtain ⟨D, hD, _, _⟩ := a3z_principalCycle_ne_zero (a3n_T X).left y
        (a3o_φ X y hy) (a3o_φ_ne_zero X y hy) _ hc
      have h := a3z_specializes_pt y D
      rw [hD] at h
      have hq := h.map (a3n_q X).left.continuous
      rwa [a3n_q_σ_apply] at hq
    by_cases h0 : a3o_cyc X y hy (a3n_σ X 0 x) = 0
    · rw [h0, zero_add] at hx
      exact hs 1 hx
    · exact hs 0 h0
  · rw [a3k_piece, dite_eq_right hy] at hx
    exact (hx rfl).elim

#print axioms IntersectionProductScaf_piece_specializes

/-- Every boundary coefficient comes from a specialization of a member of the chain. -/
theorem IntersectionProductScaf_boundary_specializes
    (c : AlgebraicCycle (a3n_T X).left ℚ) (x : X.left)
    (hx : a3k_bd X c x ≠ 0) :
    ∃ y, c y ≠ 0 ∧ (a3n_q X).left y ⤳ x := by
  rw [a3k_bd] at hx
  obtain ⟨y, hy, hxy⟩ := a3m_exists_of_sum_apply_ne_zero _ _ x hx
  rw [a3m_smul_apply] at hxy
  exact ⟨y, (mul_ne_zero_iff.mp hxy).1,
    IntersectionProductScaf_piece_specializes X y x (mul_ne_zero_iff.mp hxy).2⟩

#print axioms IntersectionProductScaf_boundary_specializes

/-- A boundary member retains the specialization relation in the original parameter. -/
theorem IntersectionProductScaf_theta₁_boundary_parameter_specializes
    {n : ℕ} {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (M : Fin (n + 1) × Fin (n + 1) → ℂ)
    (y y' : (a3n_T X).left)
    (hy' : a3k_bd (a3n_T X) (IntersectionProductScaf_theta₁ X hfin M
      (a1p_pushforward (a3h_G (a3h_πO X hfin)).left
        (Function.locallyFinsuppWithin.single y 1))) y' ≠ 0) :
    a3n_h X y ⤳ a3n_h X y' := by
  obtain ⟨w, hw, hwy⟩ :=
    IntersectionProductScaf_boundary_specializes (a3n_T X) _ y' hy'
  exact (IntersectionProductScaf_theta₁_parameter_specializes X hfin M y w hw).trans
    (hwy.map (a3n_h X).continuous)

#print axioms IntersectionProductScaf_theta₁_boundary_parameter_specializes

/-- A vertical input and its translated boundary both vanish at every dominating point. -/
theorem IntersectionProductScaf_theta₁_vertical_difference
    {n : ℕ} {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (M : Fin (n + 1) × Fin (n + 1) → ℂ)
    (y y' : (a3n_T X).left)
    (hy : a3n_h X y ≠ genericPoint (g3c_P 1))
    (hy' : a3n_h X y' = genericPoint (g3c_P 1)) :
    ((Function.locallyFinsuppWithin.single y 1 : AlgebraicCycle (a3n_T X).left ℚ) -
      a3k_bd (a3n_T X) (IntersectionProductScaf_theta₁ X hfin M
        (a1p_pushforward (a3h_G (a3h_πO X hfin)).left
          (Function.locallyFinsuppWithin.single y 1)))) y' = 0 := by
  have hne : y' ≠ y := by
    intro h
    exact hy (h ▸ hy')
  have hb : a3k_bd (a3n_T X) (IntersectionProductScaf_theta₁ X hfin M
      (a1p_pushforward (a3h_G (a3h_πO X hfin)).left
        (Function.locallyFinsuppWithin.single y 1))) y' = 0 := by
    by_contra h
    have hs := IntersectionProductScaf_theta₁_boundary_parameter_specializes X hfin M y y' h
    rw [hy'] at hs
    exact hy ((hs.antisymm (genericPoint_specializes _)).eq)
  simp only [Function.locallyFinsuppWithin.coe_sub, Pi.sub_apply,
    Function.locallyFinsuppWithin.single_apply, ite_eq_right hne, hb, sub_self]

#print axioms IntersectionProductScaf_theta₁_vertical_difference

end BoundarySpecializations

section DimensionWitness

/-- The cone map for the point `[1:0]` in the projective line. -/
def IntersectionProductScaf_pointConeMap :
    MvPolynomial (Fin 2) ℂ →ₐ[ℂ] Polynomial ℂ :=
  MvPolynomial.aeval fun i => if i = 0 then Polynomial.X else 0

/-- The cone map of a point into the projective line is surjective. -/
theorem IntersectionProductScaf_pointConeMap_surjective :
    Function.Surjective IntersectionProductScaf_pointConeMap := by
  intro p
  induction p using Polynomial.induction_on' with
  | add p q hp hq =>
    obtain ⟨f, hf⟩ := hp
    obtain ⟨g, hg⟩ := hq
    exact ⟨f + g, by rw [map_add, hf, hg]⟩
  | monomial n c =>
    refine ⟨MvPolynomial.C c * MvPolynomial.X 0 ^ n, ?_⟩
    simp [IntersectionProductScaf_pointConeMap, Polynomial.C_mul_X_pow_eq_monomial]

/-- Finiteness of the cone map does not force equality of projective dimensions. -/
theorem IntersectionProductScaf_pointConeMap_finite :
    IntersectionProductScaf_pointConeMap.toRingHom.Finite :=
  RingHom.Finite.of_surjective _ IntersectionProductScaf_pointConeMap_surjective

/-- For a nonzero lower-left matrix entry, the inverse image of `[1:0]` along
its own translation line has the equation `s = 0`, even after determinant contraction. -/
theorem IntersectionProductScaf_pointFamily_vertical
    (M : Fin 2 × Fin 2 → ℂ) (hm : M (1, 0) ≠ 0) :
    IntersectionProductScaf_contractAway (IntersectionProductScaf_lineDet M)
      (Ideal.span {Polynomial.C (M (1, 0)) * Polynomial.X}) =
        RingHom.ker (Polynomial.evalRingHom (0 : ℂ)) := by
  have hspan : Ideal.span {Polynomial.C (M (1, 0)) * Polynomial.X} =
      RingHom.ker (Polynomial.evalRingHom (0 : ℂ)) := by
    rw [Ideal.span_singleton_mul_left_unit ((isUnit_iff_ne_zero.mpr hm).map Polynomial.C),
      Polynomial.ker_evalRingHom]
    simp only [map_zero, sub_zero]
  rw [hspan]
  have : (RingHom.ker (Polynomial.evalRingHom (0 : ℂ))).IsPrime :=
    RingHom.ker_isPrime _
  apply le_antisymm
  · apply (IntersectionProductScaf_contractAway_le_prime_iff _ _ _ ?_).mpr le_rfl
    intro hd
    have hzero := RingHom.mem_ker.mp hd
    change (IntersectionProductScaf_lineDet M).eval 0 = 0 at hzero
    rw [IntersectionProductScaf_lineDet_zero] at hzero
    exact one_ne_zero hzero
  · exact IntersectionProductScaf_le_contractAway _ _

#print axioms IntersectionProductScaf_pointConeMap_surjective
#print axioms IntersectionProductScaf_pointConeMap_finite
#print axioms IntersectionProductScaf_pointFamily_vertical

end DimensionWitness

section ProjectionGeneralizations
open MvPolynomial
attribute [local instance] MvPolynomial.gradedAlgebra

/-- A finite map from a polynomial ring to a prime quotient of the same dimension
has zero kernel. -/
theorem IntersectionProductScaf_cone_injective
    {ρ σ : Type} [Fintype ρ] [Fintype σ]
    (I : Ideal (MvPolynomial σ ℂ)) [I.IsPrime] (a : ρ × σ → ℂ)
    (hfin : ((Ideal.Quotient.mk I).comp (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (hdim : ringKrullDim (MvPolynomial σ ℂ ⧸ I) = Fintype.card ρ) :
    Function.Injective ((Ideal.Quotient.mk I).comp
      (a3r_lin (a3r_mat a)).toRingHom) := by
  apply (RingHom.injective_iff_ker_eq_bot _).mpr
  have hker : I.comap (a3r_lin (a3r_mat a)) = ⊥ := by
    by_contra hne
    obtain ⟨r, hr, hr0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hne
    have hd := a3r_dim_eq_of_finite I (a3r_mat a) hfin I le_rfl
    have hR : ringKrullDim (MvPolynomial ρ ℂ) = Fintype.card ρ := by
      rw [MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field,
        ENat.card_eq_coe_fintype_card, zero_add]
      rfl
    have h1 := ringKrullDim_quotient_succ_le_of_nonZeroDivisor
      (R := MvPolynomial ρ ℂ) (mem_nonZeroDivisors_of_ne_zero hr0)
    have h2 : ringKrullDim (MvPolynomial ρ ℂ ⧸ I.comap (a3r_lin (a3r_mat a))) ≤
        ringKrullDim (MvPolynomial ρ ℂ ⧸ Ideal.span {r}) :=
      ringKrullDim_le_of_surjective (Ideal.Quotient.factor (Ideal.span_le.2
        (Set.singleton_subset_iff.2 hr))) (Ideal.Quotient.factor_surjective _)
    have h3 : ringKrullDim (MvPolynomial ρ ℂ ⧸ I.comap (a3r_lin (a3r_mat a))) + 1 ≤
        ringKrullDim (MvPolynomial ρ ℂ) := le_trans (by gcongr) h1
    rw [← hd, hdim, hR] at h3
    exact absurd h3 (by norm_cast; omega)
  ext r
  change Ideal.Quotient.mk I (a3r_lin (a3r_mat a) r) = 0 ↔ r = 0
  rw [Ideal.Quotient.eq_zero_iff_mem]
  change r ∈ I.comap (a3r_lin (a3r_mat a)) ↔ r = 0
  rw [hker, Ideal.mem_bot]

