/-- Pulling an ideal back to an embedded subscheme extends its affine ideal. -/
theorem IntersectionProductScaf_closed_comap_ideal
    {Y Z : Scheme} (i : Y ⟶ Z) [IsClosedImmersion i]
    (K : Z.IdealSheafData) (U : Z.affineOpens) :
    (K.comap i).ideal ⟨i ⁻¹ᵁ U, U.2.preimage i⟩ = (K.ideal U).map (i.app U).hom := by
  have he := congrArg (fun J : Z.IdealSheafData => J.ideal U)
    (a2g_ker_sup_eq_map_comap i K)
  rw [Scheme.IdealSheafData.ideal_sup, Pi.sup_apply, Scheme.Hom.ker_apply,
    Scheme.IdealSheafData.ideal_map_of_isAffineHom] at he
  have hm := congrArg (Ideal.map (i.app U).hom) he
  rw [Ideal.map_sup, RingHom.map_ker, bot_sup_eq,
    Ideal.map_comap_of_surjective _ (i.app_surjective U U.2)] at hm
  exact hm.symm
#print axioms IntersectionProductScaf_closed_comap_ideal

