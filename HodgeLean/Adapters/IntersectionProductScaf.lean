/-- Uniform dimensions of ambient prime fibres give generic support on the intrinsic section. -/
theorem IntersectionProductScaf_section_components_of_fibre_height
    (Z : Over (Spec ↧ℂ)) [LocallyOfFiniteType Z.hom] [IsNoetherian Z.left]
    {F : Scheme.{0}} [IsNoetherian F] (j : F ⟶ Z.left) [IsClosedImmersion j]
    (I : Z.left.IdealSheafData) (d : ℕ∞)
    (hheight : ∀ w, a2g_fundCycle I.subschemeι w ≠ 0 → ∀ x,
      a2g_fundCycle (((ccm3_primeIdeal Z.left w).comap j).subschemeι) x ≠ 0 →
        height x = d) :
    ∀ z ∈ genericPoints I.subscheme,
      ∀ u ∈ genericPoints ((ccm3_primeIdeal I.subscheme z).comap
        (j.ker.comap I.subschemeι).subschemeι).subscheme,
      ((ccm3_primeIdeal I.subscheme z).comap
        (j.ker.comap I.subschemeι).subschemeι).subschemeι u ∈
          genericPoints (j.ker.comap I.subschemeι).subscheme := by
  have : IsLocallyNoetherian I.subscheme := LocallyOfFiniteType.isLocallyNoetherian I.subschemeι
  have := a2g_subscheme_noetherianSpace I
  have : IsNoetherian I.subscheme := ⟨⟩
  let Y : Over (Spec ↧ℂ) := Over.mk (I.subschemeι ≫ Z.hom)
  have : LocallyOfFiniteType Y.hom := inferInstanceAs
    (LocallyOfFiniteType (I.subschemeι ≫ Z.hom))
  apply IntersectionProductScaf_section_components_of_equal_height Y
    (j.ker.comap I.subschemeι) d
  intro z hz u hu
  let J := j.ker.comap I.subschemeι
  let P := (ccm3_primeIdeal I.subscheme z).comap J.subschemeι
  have := a2g_subscheme_noetherianSpace J
  have : IsLocallyNoetherian J.subscheme := LocallyOfFiniteType.isLocallyNoetherian J.subschemeι
  have : IsNoetherian J.subscheme := ⟨⟩
  have := a2g_subscheme_noetherianSpace P
  have : IsLocallyNoetherian P.subscheme := LocallyOfFiniteType.isLocallyNoetherian P.subschemeι
  have hP : (genericPoints P.subscheme).Finite :=
    genericPoints.finite TopologicalSpace.NoetherianSpace.finite_irreducibleComponents
  have hI : (genericPoints I.subscheme).Finite :=
    genericPoints.finite TopologicalSpace.NoetherianSpace.finite_irreducibleComponents
  let k := P.subschemeι ≫ J.subschemeι ≫ I.subschemeι
  have hk : Function.Injective k := k.isEmbedding.injective
  have hn := IntersectionProductScaf_fundCycle_generic_ne_zero k hk hP u hu
  rw [IntersectionProductScaf_prime_section_ambient] at hn
  have hr : I.subschemeι (J.subschemeι (P.subschemeι u)) ∈ Set.range j := by
    have hm := (P.subschemeι u).property
    change J.subschemeι (P.subschemeι u) ∈ (J.support : Set I.subscheme) at hm
    rw [Scheme.IdealSheafData.support_comap] at hm
    change I.subschemeι (J.subschemeι (P.subschemeι u)) ∈ (j.ker.support : Set Z.left) at hm
    rwa [Scheme.Hom.support_ker, j.isClosedEmbedding.isClosed_range.closure_eq] at hm
  obtain ⟨x, hx⟩ := hr
  change a2g_fundCycle (ccm3_primeIdeal Z.left (I.subschemeι z) ⊔ j.ker).subschemeι
    (I.subschemeι (J.subschemeι (P.subschemeι u))) ≠ 0 at hn
  rw [← hx, IntersectionProductScaf_section_intersection_apply] at hn
  have hd := hheight (I.subschemeι z)
    (IntersectionProductScaf_fundCycle_generic_ne_zero I.subschemeι
      I.subschemeι.isEmbedding.injective hI z hz) x hn
  have he := congrArg height hx
  rw [IntersectionProductScaf_finite_height j,
    IntersectionProductScaf_finite_height I.subschemeι] at he
  exact he.symm.trans hd
#print axioms IntersectionProductScaf_section_components_of_fibre_height


