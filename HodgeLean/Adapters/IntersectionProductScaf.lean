/-- The relative cone projection lifts generalizations after adjoining and localizing the translation parameter. -/
theorem IntersectionProductScaf_relativeCone_line_generalizing
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] {n : ℕ}
    {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (hn : Order.height (genericPoint X.left) = n)
    (d : Polynomial (MvPolynomial (Fin (n + 1) ⊕ Unit) ℂ)) :
    let f := (Ideal.Quotient.mk (a3h_IXr (a3s_IX X))).comp
      (a3r_lin (a3h_block a)).toRingHom
    GeneralizingMap (PrimeSpectrum.comap
      (IsLocalization.Away.map (Localization.Away d)
        (Localization.Away ((Polynomial.mapRingHom f) d)) (Polynomial.mapRingHom f) d)) := by
  dsimp only
  apply IntersectionProductScaf_away_generalizing
  have hprime : (a3h_IXr (a3s_IX X)).IsPrime := (a3h_IXr_isPrime_dim (a3s_IX X)).1
  have hfinite := a3h_finite_rel (a3s_IX X) a hfin
  have : IsIntegrallyClosed (MvPolynomial (Fin (n + 1) ⊕ Unit) ℂ) :=
    UniqueFactorizationMonoid.instIsIntegrallyClosed
  apply IntersectionProductScaf_polynomial_generalizing _ hfinite
  apply IntersectionProductScaf_cone_injective (a3h_IXr (a3s_IX X))
    (fun ij => a3h_block a ij.1 ij.2) hfinite
  simpa only [Fintype.card_sum, Fintype.card_fin, Fintype.card_unit,
    Nat.add_assoc] using a3h_dim_IXr X n hn
/-- The finite relative cone projection composed with inverse translation on the invertible locus. -/
def IntersectionProductScaf_translatedConeMap
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] {n : ℕ}
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (M : Fin (n + 1) × Fin (n + 1) → ℂ) :
    let f := (Ideal.Quotient.mk (a3h_IXr (a3s_IX X))).comp
      (a3r_lin (a3h_block a)).toRingHom
    let d := (IntersectionProductScaf_lineDet M).map
      (MvPolynomial.C : ℂ →+* MvPolynomial (Fin (n + 1) ⊕ Unit) ℂ)
    Polynomial (MvPolynomial (Fin (n + 1) ⊕ Unit) ℂ) →+*
      Localization.Away ((Polynomial.mapRingHom f) d) := by
  dsimp only
  let f := (Ideal.Quotient.mk (a3h_IXr (a3s_IX X))).comp
    (a3r_lin (a3h_block a)).toRingHom
  let d := (IntersectionProductScaf_lineDet M).map
    (MvPolynomial.C : ℂ →+* MvPolynomial (Fin (n + 1) ⊕ Unit) ℂ)
  exact (IsLocalization.Away.map (Localization.Away d)
    (Localization.Away ((Polynomial.mapRingHom f) d)) (Polynomial.mapRingHom f) d).comp
    ((IntersectionProductScaf_localizedTranslation (τ := Unit) M).toRingHom.comp
      (algebraMap (Polynomial (MvPolynomial (Fin (n + 1) ⊕ Unit) ℂ)) (Localization.Away d)))

/-- The translated finite relative cone projection lifts generalizations. -/
theorem IntersectionProductScaf_translatedCone_generalizing
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] {n : ℕ}
    {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (hn : Order.height (genericPoint X.left) = n)
    (M : Fin (n + 1) × Fin (n + 1) → ℂ) :
    GeneralizingMap (PrimeSpectrum.comap (IntersectionProductScaf_translatedConeMap X a M)) := by
  let d := (IntersectionProductScaf_lineDet M).map
    (MvPolynomial.C : ℂ →+* MvPolynomial (Fin (n + 1) ⊕ Unit) ℂ)
  have h := IntersectionProductScaf_generalizing_comp_equiv _
    (IntersectionProductScaf_relativeCone_line_generalizing X hfin hn d)
    (IntersectionProductScaf_localizedTranslation (τ := Unit) M)
  exact h.comp (PrimeSpectrum.localization_away_isOpenEmbedding (Localization.Away d) d).generalizingMap

