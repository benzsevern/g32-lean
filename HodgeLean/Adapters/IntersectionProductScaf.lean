/-- Regular equations on the original section give the degree-weighted component fibre expansion. -/
theorem IntersectionProductScaf_originalFibre_expansion_of_regular
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom]
    {n : ℕ} (hn : height (genericPoint X.left) = n)
    (M : Fin (n + 1) × Fin (n + 1) → ℂ)
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (y : (a3n_T X).left) (hy : a3n_h X y = genericPoint (g3c_P 1))
    (c : ℂ) (hc : c = 0 ∨ c = 1)
    (hreg : let I := IntersectionProductScaf_squarePrimeIdeal M a hfin y
      ∀ x ∈ genericPoints ((a3k_ι X c).ker.comap I.subschemeι).subscheme,
        ∃ r : I.subscheme.presheaf.stalk (((a3k_ι X c).ker.comap I.subschemeι).subschemeι x),
          IsSMulRegular (I.subscheme.presheaf.stalk
            (((a3k_ι X c).ker.comap I.subschemeι).subschemeι x)) r ∧
          RingHom.ker ((((a3k_ι X c).ker.comap I.subschemeι).subschemeι).stalkMap x).hom =
            Ideal.span {r}) :
    let W := (IntersectionProductScaf_data M a hfin).Θ₁
      (a1p_pushforward (a3h_G (a3h_πO X hfin)).left
        (Function.locallyFinsuppWithin.single y 1))
    IntersectionProductScaf_originalFibreCycle M a hfin y c =
      ∑ w ∈ (a3m_support_finite W).toFinset, a3m_smul (W w)
        (a2g_fundCycle (((ccm3_primeIdeal (a3n_T (a3n_T X)).left w).comap
          (a3k_ι X c)).subschemeι)) := by
  classical
  let := IntersectionProductScaf_originalSection_isClosedImmersion X c
  have : IsLocallyNoetherian (a3n_T X).left := LocallyOfFiniteType.isLocallyNoetherian (a3n_T X).hom
  have : IsNoetherian (a3n_T X).left := ⟨⟩
  have : IsLocallyNoetherian (a3n_T (a3n_T X)).left :=
    LocallyOfFiniteType.isLocallyNoetherian (a3n_T (a3n_T X)).hom
  have : IsNoetherian (a3n_T (a3n_T X)).left := ⟨⟩
  have := IntersectionProductScaf_projectionProduct_finite X hfin
  have hd : 0 < a1p_degree (a3h_G (a3h_πO X hfin)).left y :=
    (a1d_degree_pos_iff _ y).mpr (IntersectionProductScaf_finite_height _ y)
  let q : ℚ := a1p_degree (a3h_G (a3h_πO X hfin)).left y
  have hq : q ≠ 0 := by
    dsimp [q]
    exact_mod_cast Nat.ne_of_gt hd
  let I := IntersectionProductScaf_squarePrimeIdeal M a hfin y
  let C := a2g_fundCycle I.subschemeι
  intro W
  have hW : W = a3m_smul q C := IntersectionProductScaf_squareFamily_fundCycle X M a hfin y
  have hh : ∀ w, C w ≠ 0 → ∀ x,
      a2g_fundCycle (((ccm3_primeIdeal (a3n_T (a3n_T X)).left w).comap
        (a3k_ι X c)).subschemeι) x ≠ 0 →
      height x = height ((a3h_G (a3h_πO X hfin)).left y) := by
    intro w hw x hx
    apply IntersectionProductScaf_squareFamily_original_fibre_height X hn M a hfin y hy w
      (show W w ≠ 0 from ?_) c hc x hx
    rw [hW, a3m_smul_apply]
    exact mul_ne_zero hq hw
  have he := IntersectionProductScaf_regular_section_fibre_cycle (a3k_ι X c) I hreg
    (IntersectionProductScaf_section_components_of_fibre_height (a3n_T (a3n_T X))
      (a3k_ι X c) I _ hh)
  have hs : (a3m_support_finite (a3m_smul q C)).toFinset =
      (a3m_support_finite C).toFinset := by
    ext w
    simp only [Set.Finite.mem_toFinset, Function.mem_support, a3m_smul_apply,
      ne_eq, mul_eq_zero, hq, false_or]
  change a3m_smul q (a2g_fundCycle (I.comap (a3k_ι X c)).subschemeι) = _
  rw [he, a3m_smul_sum, hW, hs]
  apply Finset.sum_congr rfl
  intro w hw
  ext x
  simp only [a3m_smul_apply, mul_assoc]
  rfl
