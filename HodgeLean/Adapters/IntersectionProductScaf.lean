/-- Pulling an ideal back between affine charts extends it along the restriction ring map. -/
theorem IntersectionProductScaf_comap_ideal_affine_charts
    {Y Z : Scheme} (f : Y ⟶ Z) (K : Z.IdealSheafData)
    (U : Z.affineOpens) (V : Y.affineOpens) (h : V.1 ≤ f ⁻¹ᵁ U.1) :
    (K.comap f).ideal V = (K.ideal U).map (f.appLE U.1 V.1 h).hom := by
  let : IsAffine U.1.toScheme := U.2
  let : IsAffine V.1.toScheme := V.2
  let g := f.resLE U.1 V.1 h
  have hg : g ≫ U.1.ι = V.1.ι ≫ f := by simp [g]
  have hc : (K.comap f).comap V.1.ι = (K.comap U.1.ι).comap g := by
    rw [← Scheme.IdealSheafData.comap_comp, ← Scheme.IdealSheafData.comap_comp, hg]
  have he := IntersectionProductScaf_affine_comap_ideal g (K.comap U.1.ι)
  change ((K.comap U.1.ι).comap g).ideal ⟨⊤, isAffineOpen_top _⟩ =
    ((K.comap U.1.ι).ideal ⟨⊤, isAffineOpen_top _⟩).map g.appTop.hom at he
  rw [← hc] at he
  have hm := congrArg (Ideal.map V.1.topIso.hom.hom) he
  rw [IntersectionProductScaf_restrict_ideal_top, Ideal.map_map] at hm
  have ha : g.appTop ≫ V.1.topIso.hom = U.1.topIso.hom ≫ f.appLE U.1 V.1 h := by
    simp [g, Scheme.Hom.resLE_app_top]
  have ha' := congrArg CommRingCat.Hom.hom ha
  simp only [CommRingCat.hom_comp] at ha'
  rw [ha', ← Ideal.map_map, IntersectionProductScaf_restrict_ideal_top] at hm
  exact hm
#print axioms IntersectionProductScaf_comap_ideal_affine_charts

