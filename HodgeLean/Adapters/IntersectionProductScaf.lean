/-- A regular section with component fibres supported on its generic points has the component cycle expansion. -/
theorem IntersectionProductScaf_regular_section_component_cycle
    (Y : Scheme) [IsNoetherian Y] (J : Y.IdealSheafData)
    (hreg : ∀ x ∈ genericPoints J.subscheme,
      ∃ r : Y.presheaf.stalk (J.subschemeι x),
        IsSMulRegular (Y.presheaf.stalk (J.subschemeι x)) r ∧
        RingHom.ker (J.subschemeι.stalkMap x).hom = Ideal.span {r})
    (hcomponent : ∀ z ∈ genericPoints Y,
      ∀ u ∈ genericPoints ((ccm3_primeIdeal Y z).comap J.subschemeι).subscheme,
        ((ccm3_primeIdeal Y z).comap J.subschemeι).subschemeι u ∈ genericPoints J.subscheme)
    (hY : (genericPoints Y).Finite) :
    a2g_fundCycle (𝟙 J.subscheme) =
      ∑ z ∈ hY.toFinset, a3m_smul (a2g_fundCycle (𝟙 Y) z)
        (a2g_fundCycle (((ccm3_primeIdeal Y z).comap J.subschemeι).subschemeι)) := by
  classical
  have : IsLocallyNoetherian J.subscheme := LocallyOfFiniteType.isLocallyNoetherian J.subschemeι
  have := a2g_subscheme_noetherianSpace J
  have : IsNoetherian J.subscheme := ⟨⟩
  have hJ : (genericPoints J.subscheme).Finite :=
    genericPoints.finite TopologicalSpace.NoetherianSpace.finite_irreducibleComponents
  ext x
  rw [a3m_sum_apply]
  by_cases hx : x ∈ genericPoints J.subscheme
  · obtain ⟨r, hr, hker⟩ := hreg x hx
    have hc := IntersectionProductScaf_regular_section_global_sum_at Y J x hx r hr hker hY
    have he := IntersectionProductScaf_fundCycle_comp_injective_apply (𝟙 J.subscheme)
      J.subschemeι J.subschemeι.isEmbedding.injective hJ x
    rw [Category.id_comp] at he
    rw [← he]
    simpa only [a3m_smul_apply] using hc
  · have he := IntersectionProductScaf_fundCycle_apply_embedded (𝟙 J.subscheme)
      Function.injective_id hJ x
    change a2g_fundCycle (𝟙 J.subscheme) x = _ at he
    rw [ite_eq_right hx] at he
    rw [he]
    symm
    apply Finset.sum_eq_zero
    intro z hz
    rw [a3m_smul_apply]
    suffices hzero : a2g_fundCycle (((ccm3_primeIdeal Y z).comap J.subschemeι).subschemeι) x = 0 by
      rw [hzero, mul_zero]
    have := a2g_subscheme_noetherianSpace ((ccm3_primeIdeal Y z).comap J.subschemeι)
    have hV : (genericPoints ((ccm3_primeIdeal Y z).comap J.subschemeι).subscheme).Finite :=
      genericPoints.finite TopologicalSpace.NoetherianSpace.finite_irreducibleComponents
    rw [IntersectionProductScaf_fundCycle_eq_sum _ hV, a3m_sum_apply]
    apply Finset.sum_eq_zero
    intro u hu
    rw [Function.locallyFinsuppWithin.single_apply, ite_eq_right]
    intro he
    exact hx (he ▸ hcomponent z (hY.mem_toFinset.mp hz) u (hV.mem_toFinset.mp hu))
#print axioms IntersectionProductScaf_regular_section_component_cycle

/-- A subscheme embedding has residue-field degree one at every point. -/
theorem IntersectionProductScaf_closed_degree {Y Z : Scheme} (i : Y ⟶ Z)
    [IsClosedImmersion i] (y : Y) : a1p_degree i y = 1 := by
  let _ := (i.residueFieldMap y).hom.toAlgebra
  have hs : Function.Surjective (i.residueFieldMap y) := by
    intro b
    obtain ⟨a, ha⟩ := Y.residue_surjective y b
    obtain ⟨c, hc⟩ := i.stalkMap_surjective y a
    refine ⟨Z.residue (i y) c, ?_⟩
    have he := congrArg (fun f : Z.presheaf.stalk (i y) ⟶ Y.residueField y => f c)
      (Scheme.residue_residueFieldMap i y)
    simpa only [CommRingCat.comp_apply, hc, ha] using he
  let e := RingEquiv.ofBijective (i.residueFieldMap y).hom
    ⟨(i.residueFieldMap y).hom.injective, hs⟩
  change Module.finrank (Z.residueField (i y)) (Y.residueField y) = 1
  rw [Algebra.finrank_eq_of_equiv_equiv e (RingEquiv.refl _)
    (S₁ := Y.residueField y) (by ext; rfl)]
  exact Module.finrank_self _
#print axioms IntersectionProductScaf_closed_degree

/-- Intersecting a subscheme with an ambient ideal commutes with its embedding.
Source: Hartshorne, *Algebraic Geometry*, II, Exercise 3.11. -/
theorem IntersectionProductScaf_map_intersection {Y Z : Scheme} (i : Y ⟶ Z)
    [IsClosedImmersion i] (P : Y.IdealSheafData) (K : Z.IdealSheafData) :
    (P ⊔ K.comap i).map i = P.map i ⊔ K := by
  conv_lhs => rw [← P.ker_subschemeι, a2g_ker_sup_eq_map_comap]
  rw [← Scheme.IdealSheafData.map_comp, ← Scheme.IdealSheafData.comap_comp,
    ← a2g_ker_sup_eq_map_comap, Scheme.Hom.ker_comp, P.ker_subschemeι]
#print axioms IntersectionProductScaf_map_intersection

