/-- A standard integral projective chart is the polynomial algebra in its remaining coordinates.
Source: Hartshorne, *Algebraic Geometry*, II, Proposition 2.5. -/
def IntersectionProductScaf_projectiveChartPolynomialEquiv (n : ℕ) (i : Fin (n + 1)) :
    Away (UniversalGrading n) (X i : UniversalRing n) ≃ₐ[ℤ]
      MvPolynomial {j : Fin (n + 1) // j ≠ i} ℤ := by
  classical
  let v (j : Fin (n + 1)) : MvPolynomial {j : Fin (n + 1) // j ≠ i} ℤ :=
    if h : j = i then 1 else X ⟨j, h⟩
  let f : UniversalRing n →+* MvPolynomial {j : Fin (n + 1) // j ≠ i} ℤ :=
    eval₂Hom (C.comp ULift.ringEquiv.toRingHom) v
  have hf : IsUnit (f (X i)) := by simp [f, v]
  let g : Away (UniversalGrading n) (X i : UniversalRing n) →+*
      MvPolynomial {j : Fin (n + 1) // j ≠ i} ℤ :=
    (Localization.awayLift f (X i) hf).comp
      (algebraMap _ (Localization.Away (X i : UniversalRing n)))
  let h : MvPolynomial {j : Fin (n + 1) // j ≠ i} ℤ →+*
      Away (UniversalGrading n) (X i : UniversalRing n) :=
    eval₂Hom (algebraMap ℤ _) (fun j => chartCoordinate i j.1)
  have hg (j : Fin (n + 1)) : g (chartCoordinate i j) = v j := by
    change Localization.awayLift f (X i) hf
      (Localization.mk (X j) ⟨X i ^ 1, ⟨1, rfl⟩⟩) = _
    rw [Localization.awayLift_mk f (X i) (X j) 1]
    · simp [f, v]
    · simp [f, v]
  have hh (j : Fin (n + 1)) : h (v j) = chartCoordinate i j := by
    by_cases hj : j = i
    · subst j; simp [v]
    · simp [v, hj, h]
  have hgh : g.comp h = RingHom.id _ := by
    apply MvPolynomial.ringHom_ext
    · intro c
      exact congrArg (fun φ : ℤ →+* MvPolynomial {j : Fin (n + 1) // j ≠ i} ℤ => φ c)
        (RingHom.ext_int ((g.comp h).comp C) ((RingHom.id _).comp C))
    · intro j
      simp only [RingHom.comp_apply, RingHom.id_apply, h, MvPolynomial.eval₂Hom_X']
      rw [hg]
      simp [v, j.2]
  have hhg : h.comp g = RingHom.id _ := by
    let φ : UniversalRing n →+* Away (UniversalGrading n) (X i : UniversalRing n) :=
      eval₂Hom ((fromZeroRingHom (UniversalGrading n) (.powers (X i))).comp
        (ProjectiveSpace.degreeZeroEquiv (Fin (n+1)) (ULift.{0} ℤ)).symm.toRingHom)
        (chartCoordinate i)
    have he : (h.comp g).comp φ = φ := by
      apply MvPolynomial.ringHom_ext
      · intro ⟨c⟩
        change (h.comp g).comp φ (C (c : ULift.{0} ℤ)) = φ (C (c : ULift.{0} ℤ))
        simp only [map_intCast]
      · intro j
        change h (g (φ (X j))) = φ (X j)
        simp only [φ, MvPolynomial.eval₂Hom_X']
        rw [hg, hh]
    apply RingHom.ext
    intro z
    obtain ⟨F, rfl⟩ := a3m_awayCoord_surj n i z
    exact DFunLike.congr_fun he F
  exact
    { toRingEquiv :=
        { __ := g
          invFun := h
          left_inv := fun z => DFunLike.congr_fun hhg z
          right_inv := fun z => DFunLike.congr_fun hgh z }
      commutes' := fun z => by
        change g (z : Away (UniversalGrading n) (X i : UniversalRing n)) = (z : MvPolynomial _ ℤ)
        exact map_intCast g z }
#print axioms IntersectionProductScaf_projectiveChartPolynomialEquiv

set_option maxHeartbeats 400000 in
/-- The polynomial chart equivalence sends each coordinate ratio to its free variable. -/
theorem IntersectionProductScaf_projectiveChartPolynomialEquiv_coordinate
    (n : ℕ) (j k : Fin (n + 1)) (h : k ≠ j) :
    IntersectionProductScaf_projectiveChartPolynomialEquiv n j (chartCoordinate j k) =
      MvPolynomial.X ⟨k, h⟩ := by
  have he : (IntersectionProductScaf_projectiveChartPolynomialEquiv n j).symm
      (MvPolynomial.X ⟨k, h⟩) = chartCoordinate j k := by
    change MvPolynomial.eval₂Hom (algebraMap ℤ (Away (UniversalGrading n) (MvPolynomial.X j : UniversalRing n)))
      (fun i : {k : Fin (n + 1) // k ≠ j} => chartCoordinate j i.1)
      (MvPolynomial.X ⟨k, h⟩) = _
    simp only [MvPolynomial.eval₂Hom_X']
  rw [← he, AlgEquiv.apply_symm_apply]
#print axioms IntersectionProductScaf_projectiveChartPolynomialEquiv_coordinate

/-- A complex projective chart is a polynomial algebra over the complex field.
Source: Hartshorne, *Algebraic Geometry*, II, Proposition 2.5. -/
def IntersectionProductScaf_complexProjectiveChartEquiv (n : ℕ) (j : Fin (n + 1)) :
    a3m_PnT n j ≃ₐ[ℂ] MvPolynomial {k : Fin (n + 1) // k ≠ j} ℂ :=
  (Algebra.TensorProduct.congr (AlgEquiv.refl : ℂ ≃ₐ[ℂ] ℂ)
    (IntersectionProductScaf_projectiveChartPolynomialEquiv n j)).trans
      (MvPolynomial.algebraTensorAlgEquiv ℤ ℂ)
#print axioms IntersectionProductScaf_complexProjectiveChartEquiv

/-- Every standard chart of complex projective space has a domain as its coordinate ring. -/
theorem IntersectionProductScaf_complexProjectiveChart_isDomain (n : ℕ) (j : Fin (n + 1)) :
    IsDomain (a3m_PnT n j) :=
  (IntersectionProductScaf_complexProjectiveChartEquiv n j).toMulEquiv.isDomain
#print axioms IntersectionProductScaf_complexProjectiveChart_isDomain

/-- Every homogeneous coordinate remains nonzero on each complex projective chart. -/
theorem IntersectionProductScaf_complexProjectiveChart_coordinate_ne_zero
    (n : ℕ) (j k : Fin (n + 1)) : a3m_Pnθ n j (MvPolynomial.X k) ≠ 0 := by
  have := IntersectionProductScaf_complexProjectiveChart_isDomain n j
  by_cases h : k = j
  · subst k
    rw [a3m_Pnθ_X_self]
    exact one_ne_zero
  · have he : IntersectionProductScaf_complexProjectiveChartEquiv n j
        (a3m_Pnθ n j (MvPolynomial.X k)) = MvPolynomial.X ⟨k, h⟩ := by
      simp [a3m_Pnθ, IntersectionProductScaf_complexProjectiveChartEquiv,
        IntersectionProductScaf_projectiveChartPolynomialEquiv_coordinate n j k h]
    intro hz
    rw [hz, map_zero] at he
    exact (MvPolynomial.X_ne_zero (R := ℂ) (σ := {k : Fin (n + 1) // k ≠ j}) ⟨k, h⟩) he.symm
#print axioms IntersectionProductScaf_complexProjectiveChart_coordinate_ne_zero

/-- The structure morphism of complex projective space is smooth.
Source: Hartshorne, *Algebraic Geometry*, II, Theorem 8.15. -/
theorem IntersectionProductScaf_projective_smooth (n : ℕ) :
    Smooth (ProjectiveSpace.toBase (Fin (n + 1)) (Spec ↧ℂ)) := by
  let C : (a3m_Pn n).OpenCover :=
    Scheme.Cover.mkOfCovers (Fin (n + 1)) (fun j => Spec (a3m_PnT n j))
      (a3m_Pnκ n) (fun y => a3m_Pn_cover n y)
  refine IsZariskiLocalAtSource.of_openCover C fun j => ?_
  change Smooth (a3m_Pnκ n j ≫ ProjectiveSpace.toBase (Fin (n + 1)) (Spec ↧ℂ))
  have hc : a3m_Pnκ n j ≫ ProjectiveSpace.toBase (Fin (n + 1)) (Spec ↧ℂ) =
      Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom
        (R := ℤ) (A := ℂ) (B := Away (UniversalGrading n) (X j : UniversalRing n)))) := by
    have h := a3m_prodChart_fst (𝟙 (Spec ↧ℂ)) (g3c_chartι n j)
    rw [Category.comp_id] at h
    exact h
  rw [hc, HasRingHomProperty.Spec_iff (P := @Smooth)]
  change (algebraMap ℂ (a3m_PnT n j)).Smooth
  rw [RingHom.smooth_algebraMap]
  have : Algebra.Smooth ℤ (Away (UniversalGrading n) (X j : UniversalRing n)) :=
    Algebra.Smooth.of_equiv (IntersectionProductScaf_projectiveChartPolynomialEquiv n j).symm
  infer_instance
#print axioms IntersectionProductScaf_projective_smooth

/-- A smooth scheme over a field is reduced.
Source: Stacks Project, Tag 056S. -/
theorem IntersectionProductScaf_smooth_reduced {K : Type} [Field K]
    (Y : Scheme.{0}) (f : Y ⟶ Spec (.of K)) [Smooth f] : IsReduced Y := by
  have h := zmtiso_normal_of_smooth Y f
  have : ∀ y : Y, _root_.IsReduced (Y.presheaf.stalk y) := fun y => by
    let := (h y).1
    exact isReduced_of_noZeroDivisors
  exact isReduced_of_isReduced_stalk Y
#print axioms IntersectionProductScaf_smooth_reduced

/-- Complex projective space is integral in every dimension. -/
theorem IntersectionProductScaf_projective_integral (n : ℕ) : IsIntegral (a3h_PnO n).left := by
  have hi (j : Fin (n + 1)) : IsDomain (a3m_PnT n j) :=
    IntersectionProductScaf_complexProjectiveChart_isDomain n j
  let b (j : Fin (n + 1)) : Spec (a3m_PnT n j) := ⟨⊥, Ideal.isPrime_bot⟩
  have hb (j : Fin (n + 1)) (q : Spec (a3m_PnT n j)) : b j ⤳ q :=
    (PrimeSpectrum.le_iff_specializes _ _).mp bot_le
  let η : a3m_Pn n := a3m_Pnκ n 0 (b 0)
  have hη (x : a3m_Pn n) : η ⤳ x := by
    obtain ⟨j, q, rfl⟩ := a3m_Pn_cover n x
    have hr : a3m_Pnκ n j (b j) ∈ Set.range (a3m_Pnκ n 0) := by
      refine ((a3m_projCharts n).inter 0 j (b j)).mpr ?_
      change a3m_Pnθ n j (MvPolynomial.X 0) ∉ (⊥ : _root_.Ideal _)
      rw [Ideal.mem_bot]
      exact IntersectionProductScaf_complexProjectiveChart_coordinate_ne_zero n j 0
    obtain ⟨u, hu⟩ := hr
    exact ((hb 0 u).map (a3m_Pnκ n 0).continuous).trans
      (hu ▸ (hb j q).map (a3m_Pnκ n j).continuous)
  have hirr : IrreducibleSpace (a3m_Pn n) := by
    rw [irreducibleSpace_def]
    have he : closure ({η} : Set (a3m_Pn n)) = Set.univ :=
      Set.eq_univ_of_forall fun x => specializes_iff_mem_closure.mp (hη x)
    change IsIrreducible Set.univ
    rw [← he]
    exact isIrreducible_singleton.closure
  have : Smooth (a3h_PnO n).hom := IntersectionProductScaf_projective_smooth n
  have : IsReduced (a3h_PnO n).left := IntersectionProductScaf_smooth_reduced _ (a3h_PnO n).hom
  exact (isIntegral_iff_irreducibleSpace_and_isReduced _).mpr ⟨hirr, inferInstance⟩
#print axioms IntersectionProductScaf_projective_integral


variable (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom]
/-- A surjective finite linear projection has integral projective target.
Source: Hartshorne, *Algebraic Geometry*, II, Proposition 3.1. -/
theorem IntersectionProductScaf_projectionTarget_integral {n : ℕ}
    {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ}
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (hn : Order.height (genericPoint X.left) = n) : IsIntegral (a3h_PnO n).left := by
  have hs : Smooth (a3h_PnO n).hom := IntersectionProductScaf_projective_smooth n
  have hr : IsReduced (a3h_PnO n).left :=
    IntersectionProductScaf_smooth_reduced _ (a3h_PnO n).hom
  have hi : IrreducibleSpace (a3h_PnO n).left :=
    (a3h_π_surjective X hfin (a3h_dim_cone X n hn)).irreducibleSpace
      (a3h_πO X hfin).left.continuous
  exact (isIntegral_iff_irreducibleSpace_and_isReduced _).mpr ⟨hi, hr⟩
#print axioms IntersectionProductScaf_projectionTarget_integral

end ProjectiveCharts

section FiniteLineIncidence

open MvPolynomial

variable {σ τ : Type} [Fintype σ] [Fintype τ] [DecidableEq σ]

/-- One generic translation matrix satisfies the line-incidence bound for every pair in two
finite collections of prime ideals. -/
theorem IntersectionProductScaf_generic_line_finsets
    (SC : Finset (Ideal (MvPolynomial (σ ⊕ τ) ℂ)))
    (SW : Finset (Ideal (MvPolynomial σ ℂ)))
    (hC : ∀ I ∈ SC, I.IsPrime) (hW : ∀ P ∈ SW, P.IsPrime) :
    a3r_Generic {a : σ × σ → ℂ |
      ∀ I ∈ SC, ∀ P ∈ SW,
        ∀ Q : Ideal (Polynomial (MvPolynomial (σ ⊕ τ) ℂ)), Q.IsPrime →
        (∀ F ∈ P, Polynomial.C (rename Sum.inl F) ∈ Q) →
        (∀ F ∈ I, a3h_substLine a F ∈ Q) →
        ∀ j, Polynomial.X * Polynomial.C (X (Sum.inl j)) ∉ Q →
        ringKrullDim (Polynomial (MvPolynomial (σ ⊕ τ) ℂ) ⧸ Q) + Fintype.card σ ≤
          ringKrullDim (MvPolynomial (σ ⊕ τ) ℂ ⧸ I) +
            ringKrullDim (MvPolynomial σ ℂ ⧸ P) + 1} := by
  have hIC : ∀ I ∈ SC, a3r_Generic {a : σ × σ → ℂ |
      ∀ P ∈ SW,
        ∀ Q : Ideal (Polynomial (MvPolynomial (σ ⊕ τ) ℂ)), Q.IsPrime →
        (∀ F ∈ P, Polynomial.C (rename Sum.inl F) ∈ Q) →
        (∀ F ∈ I, a3h_substLine a F ∈ Q) →
        ∀ j, Polynomial.X * Polynomial.C (X (Sum.inl j)) ∉ Q →
        ringKrullDim (Polynomial (MvPolynomial (σ ⊕ τ) ℂ) ⧸ Q) + Fintype.card σ ≤
          ringKrullDim (MvPolynomial (σ ⊕ τ) ℂ ⧸ I) +
            ringKrullDim (MvPolynomial σ ℂ ⧸ P) + 1} := by
    intro I hI
    letI : I.IsPrime := hC I hI
    exact (a3r_generic_iInter SW _ fun P hP => by
      letI : P.IsPrime := hW P hP
      exact a3h_generic_line I P).mono fun a ha P hP => ha P hP
  exact (a3r_generic_iInter SC _ hIC).mono fun a ha I hI => ha I hI

#print axioms IntersectionProductScaf_generic_line_finsets

/-- One generic matrix satisfies the translate-incidence bound for every pair in two finite
collections of prime ideals. -/
theorem IntersectionProductScaf_generic_translate_finsets
    (SC : Finset (Ideal (MvPolynomial (σ ⊕ τ) ℂ)))
    (SW : Finset (Ideal (MvPolynomial σ ℂ)))
    (hC : ∀ I ∈ SC, I.IsPrime) (hW : ∀ P ∈ SW, P.IsPrime) :
    a3r_Generic {a : σ × σ → ℂ |
      ∀ I ∈ SC, ∀ P ∈ SW,
        ∀ Q : Ideal (MvPolynomial (σ ⊕ τ) ℂ), Q.IsPrime →
        (∀ F ∈ P, rename Sum.inl F ∈ Q) →
        (∀ F ∈ I, a3h_substT a F ∈ Q) →
        ∀ j, X (Sum.inl j) ∉ Q →
        ringKrullDim (MvPolynomial (σ ⊕ τ) ℂ ⧸ Q) + Fintype.card σ ≤
          ringKrullDim (MvPolynomial (σ ⊕ τ) ℂ ⧸ I) +
            ringKrullDim (MvPolynomial σ ℂ ⧸ P)} := by
  have hIC : ∀ I ∈ SC, a3r_Generic {a : σ × σ → ℂ |
      ∀ P ∈ SW,
        ∀ Q : Ideal (MvPolynomial (σ ⊕ τ) ℂ), Q.IsPrime →
        (∀ F ∈ P, rename Sum.inl F ∈ Q) →
        (∀ F ∈ I, a3h_substT a F ∈ Q) →
        ∀ j, X (Sum.inl j) ∉ Q →
        ringKrullDim (MvPolynomial (σ ⊕ τ) ℂ ⧸ Q) + Fintype.card σ ≤
          ringKrullDim (MvPolynomial (σ ⊕ τ) ℂ ⧸ I) +
            ringKrullDim (MvPolynomial σ ℂ ⧸ P)} := by
    intro I hI
    letI : I.IsPrime := hC I hI
    exact (a3r_generic_iInter SW _ fun P hP => by
      letI : P.IsPrime := hW P hP
      exact a3h_generic_translate_rel I P).mono fun a ha P hP => ha P hP
  exact (a3r_generic_iInter SC _ hIC).mono fun a ha I hI => ha I hI

#print axioms IntersectionProductScaf_generic_translate_finsets

end FiniteLineIncidence

section AffineComponents

open CategoryTheory.Limits

/-- On an affine spectrum, a point generates an irreducible component exactly when its
prime ideal is minimal. -/
theorem IntersectionProductScaf_spec_component_iff_minimal {R : Type*} [CommRing R]
    (p : PrimeSpectrum R) :
    closure ({p} : Set (PrimeSpectrum R)) ∈ irreducibleComponents (PrimeSpectrum R) ↔
      p.asIdeal ∈ minimalPrimes R := by
  rw [← PrimeSpectrum.vanishingIdeal_mem_minimalPrimes]
  simp

/-- An irreducible-component point remains a component point after restriction to an open
subscheme containing it. -/
theorem IntersectionProductScaf_open_component {U W : Scheme} (j : U ⟶ W)
    [IsOpenImmersion j] (u : U)
    (hu : closure ({j u} : Set W) ∈ irreducibleComponents W) :
    closure ({u} : Set U) ∈ irreducibleComponents U := by
  rw [j.isOpenEmbedding.closure_eq_preimage_closure_image, Set.image_singleton]
  exact preimage_mem_irreducibleComponents hu j.isOpenEmbedding
    ⟨j u, subset_closure rfl, u, rfl⟩

/-- Restricting a global component point to an affine-open scheme produces a minimal
coordinate prime. -/
theorem IntersectionProductScaf_affineOpen_component_minimal {W : Scheme}
    (U : W.affineOpens) (u : U.1.toScheme)
    (hu : closure ({U.1.ι u} : Set W) ∈ irreducibleComponents W) :
    (U.2.isoSpec.hom u).asIdeal ∈ minimalPrimes Γ(W, U.1) := by
  exact a3_affineOpenScheme_component_minimal U u
    (IntersectionProductScaf_open_component U.1.ι u hu)

/-- A component point in an affine chart of a closed subscheme contracts to a minimal
prime over the chart ideal. -/
theorem IntersectionProductScaf_subschemeCover_component_minimal {W : Scheme}
    (I : W.IdealSheafData) (U : W.affineOpens)
    (v : Spec (.of (Γ(W, U.1) ⧸ I.ideal U)))
    (hv : closure ({I.subschemeCover.f U v} : Set I.subscheme) ∈
      irreducibleComponents I.subscheme) :
    v.asIdeal.comap (Ideal.Quotient.mk (I.ideal U)) ∈ (I.ideal U).minimalPrimes := by
  letI : IsOpenImmersion (I.subschemeCover.f U) := I.subschemeCover.map_prop U
  apply a3_quotient_minimal_comap
  exact a3_spec_component_minimal v
    (IntersectionProductScaf_open_component (I.subschemeCover.f U) v hv)

/-- Every component point of a closed subscheme is represented by a minimal prime over its
ideal on one affine chart. -/
theorem IntersectionProductScaf_subscheme_component_chart {W : Scheme}
    (I : W.IdealSheafData) (u : I.subscheme)
    (hu : closure ({u} : Set I.subscheme) ∈ irreducibleComponents I.subscheme) :
    ∃ (U : W.affineOpens) (v : Spec (.of (Γ(W, U.1) ⧸ I.ideal U))),
      I.subschemeCover.f U v = u ∧
        v.asIdeal.comap (Ideal.Quotient.mk (I.ideal U)) ∈ (I.ideal U).minimalPrimes := by
  let U := I.subschemeCover.idx u
  obtain ⟨v, hv⟩ := I.subschemeCover.covers u
  refine ⟨U, v, hv, ?_⟩
  apply IntersectionProductScaf_subschemeCover_component_minimal I U v
  rwa [hv]

/-- A component point lying over a specified affine open is represented by a minimal prime
in that exact subscheme chart. -/
theorem IntersectionProductScaf_subscheme_component_on_affine {W : Scheme}
    (I : W.IdealSheafData) (U : W.affineOpens) (u : I.subscheme)
    (hu : closure ({u} : Set I.subscheme) ∈ irreducibleComponents I.subscheme)
    (huU : I.subschemeι u ∈ U.1) :
    ∃ v : Spec (.of (Γ(W, U.1) ⧸ I.ideal U)),
      I.subschemeCover.f U v = u ∧
        v.asIdeal.comap (Ideal.Quotient.mk (I.ideal U)) ∈ (I.ideal U).minimalPrimes := by
  letI : IsOpenImmersion (I.subschemeCover.f U) := I.subschemeCover.map_prop U
  have hrange : u ∈ (I.subschemeCover.f U).opensRange := by
    rw [I.opensRange_subschemeCover_map U]
    exact huU
  obtain ⟨v, hv⟩ := Scheme.Hom.mem_opensRange.mp hrange
  refine ⟨v, hv, ?_⟩
  apply IntersectionProductScaf_subschemeCover_component_minimal I U v
  rwa [hv]

set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
/-- A component of an affine closed subscheme gives a minimal prime in the ambient global
section ring. -/
theorem IntersectionProductScaf_affine_subscheme_component {W : Scheme} [IsAffine W]
    (I : W.IdealSheafData) (u : I.subscheme)
    (hu : closure ({u} : Set I.subscheme) ∈ irreducibleComponents I.subscheme) :
    (W.toSpecΓ (I.subschemeι u)).asIdeal ∈
      (I.ideal ⟨⊤, isAffineOpen_top W⟩).minimalPrimes := by
  let U : W.affineOpens := ⟨⊤, isAffineOpen_top W⟩
  obtain ⟨p, hp, hmin⟩ := IntersectionProductScaf_subscheme_component_on_affine
    I U u hu (by trivial)
  have he : I.subschemeCover.f U ≫ I.subschemeι ≫ W.toSpecΓ =
      Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (I.ideal U))) := by
    rw [← Category.assoc, I.subschemeCover_map_subschemeι,
      I.glueDataObjι_ι, Category.assoc]
    change Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (I.ideal U))) ≫
      (isAffineOpen_top W).fromSpec ≫ W.toSpecΓ = _
    rw [IsAffineOpen.fromSpec_top, W.isoSpec_inv_toSpecΓ]
    exact Category.comp_id _
  have hpoint := congrArg (fun f : _ ⟶ Spec Γ(W, ⊤) => f p) he
  simp only [Scheme.Hom.comp_apply] at hpoint
  erw [hp] at hpoint
  erw [hpoint]
  exact hmin

#print axioms IntersectionProductScaf_affine_subscheme_component

/-- Contracting the global-section prime along a morphism to an affine spectrum recovers
its image prime. -/
theorem IntersectionProductScaf_spec_sections_prime {V : Scheme} {R : Type}
    [CommRing R] (f : V ⟶ Spec (.of R)) (x : V) :
    ((V.toSpecΓ x).asIdeal).comap
      (f.appTop.hom.comp (Scheme.ΓSpecIso (.of R)).inv.hom) = (f x).asIdeal := by
  have he : V.toSpecΓ ≫ Spec.map (CommRingCat.ofHom
      (f.appTop.hom.comp (Scheme.ΓSpecIso (.of R)).inv.hom)) = f := by
    change V.toSpecΓ ≫ Spec.map ((Scheme.ΓSpecIso (.of R)).inv ≫ f.appTop) = f
    rw [Spec.map_comp, ← Category.assoc, ← Scheme.toSpecΓ_naturality,
      Category.assoc, toSpecΓ_SpecMap_ΓSpecIso_inv, Category.comp_id]
  exact congrArg PrimeSpectrum.asIdeal
    (congrArg (fun g : V ⟶ Spec (.of R) => g x) he)

#print axioms IntersectionProductScaf_spec_sections_prime

/-- The homogeneous ideal of an integral scheme vanishes in every projective chart ring. -/
theorem IntersectionProductScaf_chart_generic_ideal {Y : Scheme} [IsIntegral Y]
    {σ : Type} [Fintype σ] (C : a3m_SpecCharts Y σ ℂ) (j : σ) :
    C.prime (genericPoint Y) ≤ RingHom.ker (C.θ j) := by
  letI : AlgebraicGeometry.IsReduced (Spec (C.T j)) :=
    isReduced_of_isOpenImmersion (C.κ j)
  letI : _root_.IsReduced (C.T j) := (affine_isReduced_iff (C.T j)).mp inferInstance
  intro F hF
  change C.θ j F = 0
  rw [← MvPolynomial.sum_homogeneousComponent F, map_sum]
  apply Finset.sum_eq_zero
  intro d hd
  apply IsNilpotent.eq_zero
  apply nilpotent_iff_mem_prime.mpr
  intro P hP
  let p : Spec (C.T j) := ⟨P, hP⟩
  exact (C.mem_prime_iff_of_isHomogeneous (C.κ j p) j p rfl _ d
    (MvPolynomial.homogeneousComponent_isHomogeneous d F)).mp
    (C.prime_mono (genericPoint_specializes (C.κ j p))
      (MvPolynomial.homogeneousComponent_mem_of_mem
        (C.isHomogeneous_prime (genericPoint Y)) hF d))

#print axioms IntersectionProductScaf_chart_generic_ideal

/-- A point on a projective chart excludes its normalizing coordinate from the generic ideal. -/
theorem IntersectionProductScaf_chart_coordinate_not_mem
    {Y : Scheme} [IsIntegral Y] {σ : Type} [Fintype σ]
    (C : a3m_SpecCharts Y σ ℂ) (j : σ) (x : Spec (C.T j)) :
    MvPolynomial.X j ∉ C.prime (genericPoint Y) := by
  intro hj
  have h := IntersectionProductScaf_chart_generic_ideal C j hj
  change C.θ j (MvPolynomial.X j) = 0 at h
  rw [C.θ_X_self] at h
  apply x.isPrime.one_notMem
  rw [h]
  exact Ideal.zero_mem _

#print axioms IntersectionProductScaf_chart_coordinate_not_mem

/-- Dehomogenization has kernel generated by the scheme ideal and the equation setting the
chosen coordinate to one. -/
theorem IntersectionProductScaf_chart_kernel {Y : Scheme} [IsIntegral Y]
    {σ : Type} [Fintype σ] (C : a3m_SpecCharts Y σ ℂ) (j : σ) :
    RingHom.ker (C.θ j) = C.prime (genericPoint Y) ⊔
      Ideal.span {MvPolynomial.X j - 1} := by
  let I := C.prime (genericPoint Y)
  let J := I ⊔ Ideal.span {MvPolynomial.X j - 1}
  have hjJ : MvPolynomial.X j - 1 ∈ J :=
    (show Ideal.span {MvPolynomial.X j - 1} ≤ J from le_sup_right)
      (Ideal.subset_span (Set.mem_singleton _))
  have hle : J ≤ RingHom.ker (C.θ j) := by
    refine sup_le (IntersectionProductScaf_chart_generic_ideal C j) ?_
    rw [Ideal.span_le]
    rintro F (rfl : F = _)
    change C.θ j (MvPolynomial.X j - 1) = 0
    rw [map_sub, map_one, C.θ_X_self, sub_self]
  apply le_antisymm ?_ hle
  intro F hF
  by_cases hj : MvPolynomial.X j ∈ I
  · have h1 : (1 : MvPolynomial σ ℂ) ∈ J := by
      convert J.sub_mem ((show I ≤ J from le_sup_left) hj) hjJ using 1 <;> ring
    rw [Ideal.eq_top_of_isUnit_mem J h1 isUnit_one]
    exact Submodule.mem_top
  · obtain ⟨p, hp⟩ : genericPoint Y ∈ Set.range (C.κ j) := by
      by_contra h
      exact hj ((C.X_mem_prime_iff _ j).mpr h)
    have hG : a3t_homog j F ∈ I := by
      apply (C.mem_prime_iff_of_isHomogeneous _ j p hp _ _
        (a3t_homog_isHomogeneous j F)).mpr
      rw [a3t_map_homog j (C.θ j) (C.θ_X_self j)]
      change C.θ j F ∈ p.asIdeal
      rw [show C.θ j F = 0 from hF]
      exact p.asIdeal.zero_mem
    have hx : Ideal.Quotient.mk J (MvPolynomial.X j) = 1 := by
      apply sub_eq_zero.mp
      rw [← map_one (Ideal.Quotient.mk J), ← map_sub]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr hjJ
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    rw [← a3t_map_homog j (Ideal.Quotient.mk J) hx F]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr ((show I ≤ J from le_sup_left) hG)

#print axioms IntersectionProductScaf_chart_kernel

/-- A projective chart ring is the coordinate-one slice of its homogeneous cone. -/
def IntersectionProductScaf_chartSliceEquiv {Y : Scheme} [IsIntegral Y]
    {σ : Type} [Fintype σ] (C : a3m_SpecCharts Y σ ℂ) (j : σ) :
    (MvPolynomial σ ℂ ⧸ (C.prime (genericPoint Y) ⊔
      Ideal.span {MvPolynomial.X j - 1})) ≃+* C.T j :=
  (Ideal.quotEquivOfEq (IntersectionProductScaf_chart_kernel C j).symm).trans
    (RingHom.quotientKerEquivOfSurjective (C.θ_surj j))

/-- The cone-slice equivalence evaluates polynomial representatives by dehomogenization. -/
theorem IntersectionProductScaf_chartSliceEquiv_mk {Y : Scheme} [IsIntegral Y]
    {σ : Type} [Fintype σ] (C : a3m_SpecCharts Y σ ℂ) (j : σ)
    (F : MvPolynomial σ ℂ) :
    IntersectionProductScaf_chartSliceEquiv C j (Ideal.Quotient.mk _ F) = C.θ j F := rfl

#print axioms IntersectionProductScaf_chartSliceEquiv_mk

/-- A ring map with a retraction lifts every minimal prime over an ideal to a minimal prime
over its extension. -/
theorem IntersectionProductScaf_split_minimalPrime {R S : Type} [CommRing R] [CommRing S]
    (f : R →+* S) (g : S →+* R) (hgf : g.comp f = RingHom.id R)
    (I P : Ideal R) (hP : P ∈ I.minimalPrimes) :
    ∃ Q ∈ (Ideal.map f I).minimalPrimes, Q.comap f = P := by
  letI : P.IsPrime := hP.1.1
  have hpre : (P.comap g).comap f = P := by
    rw [Ideal.comap_comap, hgf, Ideal.comap_id]
  have hle : Ideal.map f I ≤ P.comap g := by
    rw [Ideal.map_le_iff_le_comap, hpre]
    exact hP.1.2
  obtain ⟨Q, hQ, hQP⟩ := Ideal.exists_minimalPrimes_le hle
  letI : Q.IsPrime := hQ.1.1
  have hQle : Q.comap f ≤ P := by
    rw [← hpre]
    exact Ideal.comap_mono hQP
  have hIQ : I ≤ Q.comap f := Ideal.map_le_iff_le_comap.mp hQ.1.2
  exact ⟨Q, hQ, le_antisymm hQle (hP.2 ⟨inferInstance, hIQ⟩ hQle)⟩

#print axioms IntersectionProductScaf_split_minimalPrime

/-- A ring-map retraction extends across localization at an element and its image. -/
theorem IntersectionProductScaf_split_away
    {R S : Type*} [CommRing R] [CommRing S]
    (f : R →+* S) (g : S →+* R) (hgf : g.comp f = RingHom.id R) (d : R) :
    ∃ g' : Localization.Away (f d) →+* Localization.Away d,
      g'.comp (IsLocalization.Away.map (Localization.Away d)
        (Localization.Away (f d)) f d) = RingHom.id _ := by
  have hgf_apply (x : R) : g (f x) = x :=
    congrArg (fun k : R →+* R => k x) hgf
  let g' : Localization.Away (f d) →+* Localization.Away d :=
    IsLocalization.Away.lift (f d)
      (g := (algebraMap R (Localization.Away d)).comp g) (by
        change IsUnit (algebraMap R (Localization.Away d) (g (f d)))
        rw [hgf_apply]
        exact IsLocalization.Away.algebraMap_isUnit d)
  refine ⟨g', ?_⟩
  apply IsLocalization.ringHom_ext (Submonoid.powers d)
  ext x
  simp only [RingHom.comp_apply, RingHom.id_apply, IsLocalization.Away.map,
    IsLocalization.map_eq, g', IsLocalization.Away.lift_eq, hgf_apply]

#print axioms IntersectionProductScaf_split_away

/-- Minimal primes lift through a polynomial extension of a split ring map after localization. -/
theorem IntersectionProductScaf_split_polynomial_away_minimalPrime
    {R S : Type} [CommRing R] [CommRing S]
    (f : R →+* S) (g : S →+* R) (hgf : g.comp f = RingHom.id R)
    (d : Polynomial R) (I P : Ideal (Localization.Away d)) (hP : P ∈ I.minimalPrimes) :
    ∃ Q ∈ (Ideal.map
      (IsLocalization.Away.map (Localization.Away d) (Localization.Away ((Polynomial.mapRingHom f) d))
        (Polynomial.mapRingHom f) d) I).minimalPrimes,
      Q.comap (IsLocalization.Away.map (Localization.Away d)
        (Localization.Away ((Polynomial.mapRingHom f) d)) (Polynomial.mapRingHom f) d) = P := by
  have hpoly : (Polynomial.mapRingHom g).comp (Polynomial.mapRingHom f) =
      RingHom.id (Polynomial R) := by
    apply RingHom.ext
    intro p
    change (p.map f).map g = p
    rw [Polynomial.map_map, hgf, Polynomial.map_id]
  obtain ⟨g', hg'⟩ := IntersectionProductScaf_split_away
    (Polynomial.mapRingHom f) (Polynomial.mapRingHom g) hpoly d
  exact IntersectionProductScaf_split_minimalPrime _ g' hg' I P hP

#print axioms IntersectionProductScaf_split_polynomial_away_minimalPrime

/-- Minimal primes over extended polynomial ideals contract through localization of the coefficients. -/
theorem IntersectionProductScaf_polynomial_away_minimalPrime_comap
    {R : Type*} [CommRing R] (x : R) (I : Ideal (Polynomial R))
    (P : Ideal (Polynomial (Localization.Away x)))
    (hP : P ∈ (Ideal.map (Polynomial.mapRingHom (algebraMap R (Localization.Away x))) I).minimalPrimes) :
    P.comap (Polynomial.mapRingHom (algebraMap R (Localization.Away x))) ∈ I.minimalPrimes := by
  letI : Algebra (Polynomial R) (Polynomial (Localization.Away x)) :=
    Polynomial.algebra R (Localization.Away x)
  letI : IsLocalization ((Submonoid.powers x).map (Polynomial.C : R →+* Polynomial R))
      (Polynomial (Localization.Away x)) :=
    Polynomial.isLocalization (Submonoid.powers x) (Localization.Away x)
  change P ∈ (Ideal.map (algebraMap (Polynomial R) (Polynomial (Localization.Away x))) I).minimalPrimes at hP
  rw [IsLocalization.minimalPrimes_map
    ((Submonoid.powers x).map (Polynomial.C : R →+* Polynomial R))
    (Polynomial (Localization.Away x)) I] at hP
  exact hP

#print axioms IntersectionProductScaf_polynomial_away_minimalPrime_comap

/-- Minimal primes contract through coefficient localization followed by polynomial localization. -/
theorem IntersectionProductScaf_double_away_polynomial_minimalPrime_comap
    {R : Type*} [CommRing R] (x : R) (d : Polynomial (Localization.Away x))
    (I : Ideal (Polynomial R)) (P : Ideal (Localization.Away d))
    (hP : P ∈ (Ideal.map (algebraMap _ _)
      (Ideal.map (Polynomial.mapRingHom (algebraMap R (Localization.Away x))) I)).minimalPrimes) :
    P.comap ((algebraMap (Polynomial (Localization.Away x)) (Localization.Away d)).comp
      (Polynomial.mapRingHom (algebraMap R (Localization.Away x)))) ∈ I.minimalPrimes := by
  have h := hP
  rw [IsLocalization.minimalPrimes_map (Submonoid.powers d) (Localization.Away d)
    (Ideal.map (Polynomial.mapRingHom (algebraMap R (Localization.Away x))) I)] at h
  have h' := IntersectionProductScaf_polynomial_away_minimalPrime_comap x I
    (P.comap (algebraMap (Polynomial (Localization.Away x)) (Localization.Away d))) h
  rw [Ideal.comap_comap] at h'
  exact h'

#print axioms IntersectionProductScaf_double_away_polynomial_minimalPrime_comap

/-- Component points lift to the inverse-image subscheme on any open chart containing them. -/
theorem IntersectionProductScaf_comap_component {V W : Scheme}
    (I : W.IdealSheafData) (j : V ⟶ W) [IsOpenImmersion j]
    (u : I.subscheme)
    (hu : closure ({u} : Set I.subscheme) ∈ irreducibleComponents I.subscheme)
    (x : V) (hx : j x = I.subschemeι u) :
    ∃ v : (I.comap j).subscheme,
      (I.comap j).subschemeι v = x ∧
      closure ({v} : Set (I.comap j).subscheme) ∈
        irreducibleComponents (I.comap j).subscheme := by
  obtain ⟨p, hp, hpu⟩ := Scheme.Pullback.exists_preimage_pullback x u hx
  let v := (I.comapIso j).inv p
  let k := (I.comapIso j).hom ≫ pullback.snd j I.subschemeι
  have hv : (I.comap j).subschemeι v = x := by
    change ((I.comapIso j).inv ≫ (I.comap j).subschemeι) p = x
    simpa using hp
  have hk : k v = u := by
    change ((I.comapIso j).inv ≫ (I.comapIso j).hom ≫
      pullback.snd j I.subschemeι) p = u
    simpa only [Iso.inv_hom_id_assoc] using hpu
  refine ⟨v, hv, IntersectionProductScaf_open_component k v ?_⟩
  rwa [hk]

#print axioms IntersectionProductScaf_comap_component

#print axioms IntersectionProductScaf_spec_component_iff_minimal
#print axioms IntersectionProductScaf_open_component
#print axioms IntersectionProductScaf_affineOpen_component_minimal
#print axioms IntersectionProductScaf_subschemeCover_component_minimal
#print axioms IntersectionProductScaf_subscheme_component_chart
#print axioms IntersectionProductScaf_subscheme_component_on_affine

end AffineComponents

section ChartConeLaurent

open MvPolynomial

variable {Y : Scheme} [IsIntegral Y] {σ : Type} [Fintype σ]
  (C : a3m_SpecCharts Y σ ℂ) (j : σ)

/-- Rescaling chart coordinates by an invertible Laurent variable. -/
def IntersectionProductScaf_chartLaurentPolynomial :
    MvPolynomial σ ℂ →+* LaurentPolynomial (C.T j) :=
  eval₂Hom (LaurentPolynomial.C.comp ((C.θ j).comp MvPolynomial.C))
    (fun k => LaurentPolynomial.C (C.θ j (MvPolynomial.X k)) * LaurentPolynomial.T 1)

/-- Homogeneous polynomials acquire exactly their degree under Laurent rescaling. -/
theorem IntersectionProductScaf_chartLaurentPolynomial_homogeneous
    (F : MvPolynomial σ ℂ) (d : ℕ) (hF : F.IsHomogeneous d) :
    IntersectionProductScaf_chartLaurentPolynomial C j F =
      LaurentPolynomial.T 1 ^ d * LaurentPolynomial.C (C.θ j F) := by
  apply a3m_twist (IntersectionProductScaf_chartLaurentPolynomial C j)
    (LaurentPolynomial.C.comp (C.θ j)) (LaurentPolynomial.T 1)
    (fun c => by simp only [IntersectionProductScaf_chartLaurentPolynomial,
      coe_eval₂Hom, eval₂_C, RingHom.comp_apply])
    (fun k => by
      simp only [IntersectionProductScaf_chartLaurentPolynomial, coe_eval₂Hom, eval₂_X,
        RingHom.comp_apply]
      exact mul_comm _ _) F d hF

#print axioms IntersectionProductScaf_chartLaurentPolynomial_homogeneous

/-- Laurent rescaling annihilates the homogeneous ideal of the underlying scheme. -/
theorem IntersectionProductScaf_chartLaurentPolynomial_ideal :
    C.prime (genericPoint Y) ≤ RingHom.ker
      (IntersectionProductScaf_chartLaurentPolynomial C j) := by
  intro F hF
  change IntersectionProductScaf_chartLaurentPolynomial C j F = 0
  rw [← MvPolynomial.sum_homogeneousComponent F, map_sum]
  apply Finset.sum_eq_zero
  intro d hd
  rw [IntersectionProductScaf_chartLaurentPolynomial_homogeneous C j _ d
    (MvPolynomial.homogeneousComponent_isHomogeneous d F)]
  have hzero : C.θ j (MvPolynomial.homogeneousComponent d F) = 0 :=
    IntersectionProductScaf_chart_generic_ideal C j
      (MvPolynomial.homogeneousComponent_mem_of_mem
        (C.isHomogeneous_prime (genericPoint Y)) hF d)
  rw [hzero, map_zero, mul_zero]

#print axioms IntersectionProductScaf_chartLaurentPolynomial_ideal

/-- The rescaling map on the homogeneous cone quotient. -/
def IntersectionProductScaf_chartLaurentCone :
    a3t_A C →+* LaurentPolynomial (C.T j) :=
  Ideal.Quotient.lift _ (IntersectionProductScaf_chartLaurentPolynomial C j)
    (IntersectionProductScaf_chartLaurentPolynomial_ideal C j)

/-- The chosen cone coordinate becomes the invertible Laurent variable. -/
theorem IntersectionProductScaf_chartLaurentCone_coordinate :
    IntersectionProductScaf_chartLaurentCone C j (a3t_x C j) = LaurentPolynomial.T 1 := by
  change IntersectionProductScaf_chartLaurentPolynomial C j (MvPolynomial.X j) = _
  simp [IntersectionProductScaf_chartLaurentPolynomial, C.θ_X_self]

#print axioms IntersectionProductScaf_chartLaurentCone_coordinate

/-- The localized cone maps to Laurent polynomials over its projective chart. -/
def IntersectionProductScaf_chartLaurentAway :
    a3t_Ax C j →+* LaurentPolynomial (C.T j) :=
  IsLocalization.Away.lift (a3t_x C j) (g := IntersectionProductScaf_chartLaurentCone C j)
    (by rw [IntersectionProductScaf_chartLaurentCone_coordinate]
        exact LaurentPolynomial.isUnit_T 1)

/-- The localized map agrees with rescaling on polynomial representatives. -/
theorem IntersectionProductScaf_chartLaurentAway_mk (F : MvPolynomial σ ℂ) :
    IntersectionProductScaf_chartLaurentAway C j
      (algebraMap (a3t_A C) (a3t_Ax C j) (Ideal.Quotient.mk _ F)) =
      IntersectionProductScaf_chartLaurentPolynomial C j F :=
  IsLocalization.Away.lift_eq (a3t_x C j) _ _

#print axioms IntersectionProductScaf_chartLaurentAway_mk

/-- Normalized cone coordinates become constant Laurent polynomials. -/
theorem IntersectionProductScaf_chartLaurentAway_phiT :
    (IntersectionProductScaf_chartLaurentAway C j).comp (a3t_phiT C j) =
      LaurentPolynomial.C.comp (C.θ j) := by
  have hx : IntersectionProductScaf_chartLaurentAway C j
      (algebraMap (a3t_A C) (a3t_Ax C j) (a3t_x C j)) =
      LaurentPolynomial.T 1 := by
    rw [IntersectionProductScaf_chartLaurentAway_mk]
    exact IntersectionProductScaf_chartLaurentCone_coordinate C j
  have hi := congrArg (IntersectionProductScaf_chartLaurentAway C j)
    (IsLocalization.Away.mul_invSelf (a3t_x C j) (S := a3t_Ax C j))
  rw [map_mul, hx, map_one] at hi
  refine MvPolynomial.ringHom_ext (fun c => ?_) (fun k => ?_)
  · simp only [RingHom.comp_apply, a3t_phiT, coe_eval₂Hom, eval₂_C]
    rw [IsScalarTower.algebraMap_apply ℂ (a3t_A C) (a3t_Ax C j)]
    change IntersectionProductScaf_chartLaurentAway C j
      (algebraMap (a3t_A C) (a3t_Ax C j) (Ideal.Quotient.mk _ (MvPolynomial.C c))) = _
    rw [IntersectionProductScaf_chartLaurentAway_mk]
    simp only [IntersectionProductScaf_chartLaurentPolynomial, coe_eval₂Hom, eval₂_C,
      RingHom.comp_apply]
  · change IntersectionProductScaf_chartLaurentAway C j (a3t_phiT C j (MvPolynomial.X k)) = _
    rw [a3t_phiT_X, map_mul, IntersectionProductScaf_chartLaurentAway_mk]
    simp only [IntersectionProductScaf_chartLaurentPolynomial, coe_eval₂Hom, eval₂_X,
      RingHom.comp_apply]
    rw [mul_assoc, hi, mul_one]

#print axioms IntersectionProductScaf_chartLaurentAway_phiT

/-- Evaluating the Laurent variable at the inverted cone coordinate. -/
def IntersectionProductScaf_chartLaurentInverse
    (hj : MvPolynomial.X j ∉ C.prime (genericPoint Y)) :
    LaurentPolynomial (C.T j) →+* a3t_Ax C j :=
  LaurentPolynomial.eval₂ (a3t_phi C j hj)
    (IsLocalization.Away.algebraMap_isUnit (a3t_x C j) (S := a3t_Ax C j)).unit

/-- Laurent evaluation recovers the original cone polynomial. -/
theorem IntersectionProductScaf_chartLaurentInverse_polynomial
    (hj : MvPolynomial.X j ∉ C.prime (genericPoint Y)) :
    (IntersectionProductScaf_chartLaurentInverse C j hj).comp
      (IntersectionProductScaf_chartLaurentPolynomial C j) =
        (algebraMap (a3t_A C) (a3t_Ax C j)).comp (Ideal.Quotient.mk _) := by
  refine MvPolynomial.ringHom_ext (fun c => ?_) (fun k => ?_)
  · simp only [RingHom.comp_apply, IntersectionProductScaf_chartLaurentPolynomial,
      coe_eval₂Hom, eval₂_C, IntersectionProductScaf_chartLaurentInverse,
      LaurentPolynomial.eval₂_C, a3t_phi_θ]
    simp only [a3t_phiT, coe_eval₂Hom, eval₂_C]
    rw [← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap,
      ← IsScalarTower.algebraMap_apply]
  · simp only [RingHom.comp_apply, IntersectionProductScaf_chartLaurentPolynomial,
      coe_eval₂Hom, eval₂_X, IntersectionProductScaf_chartLaurentInverse, map_mul,
      LaurentPolynomial.eval₂_C, LaurentPolynomial.eval₂_T, zpow_one, IsUnit.unit_spec]
    exact a3t_phi_mul_x C j hj k

#print axioms IntersectionProductScaf_chartLaurentInverse_polynomial

/-- Evaluating the chart Laurent map is the identity on the localized homogeneous cone. -/
theorem IntersectionProductScaf_chartLaurentInverse_away
    (hj : MvPolynomial.X j ∉ C.prime (genericPoint Y)) :
    (IntersectionProductScaf_chartLaurentInverse C j hj).comp
      (IntersectionProductScaf_chartLaurentAway C j) = RingHom.id _ := by
  apply IsLocalization.ringHom_ext (Submonoid.powers (a3t_x C j))
  apply RingHom.ext
  intro q
  obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective q
  change IntersectionProductScaf_chartLaurentInverse C j hj
    (IntersectionProductScaf_chartLaurentAway C j
      (algebraMap (a3t_A C) (a3t_Ax C j) (Ideal.Quotient.mk _ F))) = _
  rw [IntersectionProductScaf_chartLaurentAway_mk]
  exact congrArg (fun f : MvPolynomial σ ℂ →+* a3t_Ax C j => f F)
    (IntersectionProductScaf_chartLaurentInverse_polynomial C j hj)

#print axioms IntersectionProductScaf_chartLaurentInverse_away

/-- The localized cone map recovers every Laurent polynomial on the chart. -/
theorem IntersectionProductScaf_chartLaurentAway_inverse
    (hj : MvPolynomial.X j ∉ C.prime (genericPoint Y)) :
    (IntersectionProductScaf_chartLaurentAway C j).comp
      (IntersectionProductScaf_chartLaurentInverse C j hj) = RingHom.id _ := by
  apply IsLocalization.ringHom_ext
    (Submonoid.powers (Polynomial.X : Polynomial (C.T j)))
  refine Polynomial.ringHom_ext (fun t => ?_) ?_
  · simp only [RingHom.comp_apply, RingHom.id_apply,
      LaurentPolynomial.algebraMap_eq_toLaurent, Polynomial.toLaurent_C]
    change IntersectionProductScaf_chartLaurentAway C j
      (IntersectionProductScaf_chartLaurentInverse C j hj (LaurentPolynomial.C t)) = _
    rw [IntersectionProductScaf_chartLaurentInverse, LaurentPolynomial.eval₂_C]
    obtain ⟨F, rfl⟩ := C.θ_surj j t
    rw [a3t_phi_θ]
    exact congrArg (fun f : MvPolynomial σ ℂ →+* LaurentPolynomial (C.T j) => f F)
      (IntersectionProductScaf_chartLaurentAway_phiT C j)
  · simp only [RingHom.comp_apply, RingHom.id_apply,
      LaurentPolynomial.algebraMap_eq_toLaurent, Polynomial.toLaurent_X]
    change IntersectionProductScaf_chartLaurentAway C j
      (IntersectionProductScaf_chartLaurentInverse C j hj (LaurentPolynomial.T 1)) = _
    rw [IntersectionProductScaf_chartLaurentInverse, LaurentPolynomial.eval₂_T,
      zpow_one, IsUnit.unit_spec, IntersectionProductScaf_chartLaurentAway_mk]
    exact IntersectionProductScaf_chartLaurentCone_coordinate C j

#print axioms IntersectionProductScaf_chartLaurentAway_inverse

/-- A nonempty projective chart times the multiplicative group is the localized homogeneous
cone. -/
def IntersectionProductScaf_chartLaurentEquiv
    (hj : MvPolynomial.X j ∉ C.prime (genericPoint Y)) :
    a3t_Ax C j ≃+* LaurentPolynomial (C.T j) where
  __ := IntersectionProductScaf_chartLaurentAway C j
  invFun := IntersectionProductScaf_chartLaurentInverse C j hj
  left_inv x := congrArg (fun f : a3t_Ax C j →+* a3t_Ax C j => f x)
    (IntersectionProductScaf_chartLaurentInverse_away C j hj)
  right_inv x := congrArg
    (fun f : LaurentPolynomial (C.T j) →+* LaurentPolynomial (C.T j) => f x)
    (IntersectionProductScaf_chartLaurentAway_inverse C j hj)

/-- The cone-chart equivalence restricts to the ordinary chart inclusion on normalized
coordinates. -/
theorem IntersectionProductScaf_chartLaurentEquiv_phi
    (hj : MvPolynomial.X j ∉ C.prime (genericPoint Y)) (t : C.T j) :
    IntersectionProductScaf_chartLaurentEquiv C j hj (a3t_phi C j hj t) =
      LaurentPolynomial.C t := by
  obtain ⟨F, rfl⟩ := C.θ_surj j t
  rw [a3t_phi_θ]
  exact congrArg (fun f : MvPolynomial σ ℂ →+* LaurentPolynomial (C.T j) => f F)
    (IntersectionProductScaf_chartLaurentAway_phiT C j)

#print axioms IntersectionProductScaf_chartLaurentEquiv_phi

/-- The normalized chart inclusion into the localized cone is flat. -/
theorem IntersectionProductScaf_chart_phi_flat
    (hj : MvPolynomial.X j ∉ C.prime (genericPoint Y)) :
    RingHom.Flat (a3t_phi C j hj) := by
  have hp : RingHom.Flat (Polynomial.C : C.T j →+* Polynomial (C.T j)) := by
    change RingHom.Flat (algebraMap (C.T j) (Polynomial (C.T j)))
    exact RingHom.flat_algebraMap_iff.mpr inferInstance
  have hl : RingHom.Flat
      (algebraMap (Polynomial (C.T j)) (LaurentPolynomial (C.T j))) :=
    RingHom.flat_algebraMap_iff.mpr (IsLocalization.flat _
      (Submonoid.powers (Polynomial.X : Polynomial (C.T j))))
  have hc : RingHom.Flat (LaurentPolynomial.C : C.T j →+* LaurentPolynomial (C.T j)) := by
    have he : (algebraMap (Polynomial (C.T j)) (LaurentPolynomial (C.T j))).comp
        Polynomial.C = LaurentPolynomial.C := by
      apply RingHom.ext
      intro t
      exact Polynomial.toLaurent_C t
    rw [← he]
    exact hp.comp hl
  let e := IntersectionProductScaf_chartLaurentEquiv C j hj
  have he : e.symm.toRingHom.comp LaurentPolynomial.C = a3t_phi C j hj := by
    apply RingHom.ext
    intro t
    change e.symm (LaurentPolynomial.C t) = a3t_phi C j hj t
    apply e.injective
    rw [e.apply_symm_apply]
    exact (IntersectionProductScaf_chartLaurentEquiv_phi C j hj t).symm
  rw [← he]
  exact hc.comp (RingHom.Flat.of_bijective e.symm.bijective)

#print axioms IntersectionProductScaf_chart_phi_flat

/-- The localized cone projection to its projective chart lifts generalizations of primes. -/
theorem IntersectionProductScaf_chart_phi_generalizing
    (hj : MvPolynomial.X j ∉ C.prime (genericPoint Y)) :
    GeneralizingMap (PrimeSpectrum.comap (a3t_phi C j hj)) := by
  letI := (a3t_phi C j hj).toAlgebra
  letI : Module.Flat (C.T j) (a3t_Ax C j) :=
    IntersectionProductScaf_chart_phi_flat C j hj
  exact Algebra.HasGoingDown.iff_generalizingMap_primeSpectrumComap.mp inferInstance

#print axioms IntersectionProductScaf_chart_phi_generalizing

/-- Every chart component lifts to a component of its extended ideal on the localized cone. -/
theorem IntersectionProductScaf_chart_phi_minimalPrime
    (hj : MvPolynomial.X j ∉ C.prime (genericPoint Y))
    (I P : Ideal (C.T j)) (hP : P ∈ I.minimalPrimes) :
    ∃ Q ∈ (Ideal.map (a3t_phi C j hj) I).minimalPrimes,
      Q.comap (a3t_phi C j hj) = P := by
  let e := IntersectionProductScaf_chartLaurentEquiv C j hj
  let r : a3t_Ax C j →+* C.T j :=
    (LaurentPolynomial.eval₂ (RingHom.id (C.T j)) 1).comp e.toRingHom
  have hr : r.comp (a3t_phi C j hj) = RingHom.id (C.T j) := by
    apply RingHom.ext
    intro t
    change LaurentPolynomial.eval₂ (RingHom.id (C.T j)) 1
      (e (a3t_phi C j hj t)) = t
    rw [IntersectionProductScaf_chartLaurentEquiv_phi, LaurentPolynomial.eval₂_C]
    rfl
  exact IntersectionProductScaf_split_minimalPrime (a3t_phi C j hj) r hr I P hP

#print axioms IntersectionProductScaf_chart_phi_minimalPrime

/-- Parameter-localized chart components lift to the corresponding parameter-localized cone. -/
theorem IntersectionProductScaf_chart_polynomial_away_minimalPrime
    (hj : MvPolynomial.X j ∉ C.prime (genericPoint Y))
    (d : Polynomial (C.T j)) (I P : Ideal (Localization.Away d))
    (hP : P ∈ I.minimalPrimes) :
    ∃ Q ∈ (Ideal.map
      (IsLocalization.Away.map (Localization.Away d)
        (Localization.Away ((Polynomial.mapRingHom (a3t_phi C j hj)) d))
        (Polynomial.mapRingHom (a3t_phi C j hj)) d) I).minimalPrimes,
      Q.comap (IsLocalization.Away.map (Localization.Away d)
        (Localization.Away ((Polynomial.mapRingHom (a3t_phi C j hj)) d))
        (Polynomial.mapRingHom (a3t_phi C j hj)) d) = P := by
  let e := IntersectionProductScaf_chartLaurentEquiv C j hj
  let r : a3t_Ax C j →+* C.T j :=
    (LaurentPolynomial.eval₂ (RingHom.id (C.T j)) 1).comp e.toRingHom
  have hr : r.comp (a3t_phi C j hj) = RingHom.id (C.T j) := by
    apply RingHom.ext
    intro t
    change LaurentPolynomial.eval₂ (RingHom.id (C.T j)) 1
      (e (a3t_phi C j hj t)) = t
    rw [IntersectionProductScaf_chartLaurentEquiv_phi, LaurentPolynomial.eval₂_C]
    rfl
  exact IntersectionProductScaf_split_polynomial_away_minimalPrime
    (a3t_phi C j hj) r hr d I P hP

#print axioms IntersectionProductScaf_chart_polynomial_away_minimalPrime

/-- Normalized cone coordinates preserve coefficientwise scalar parameter polynomials. -/
theorem IntersectionProductScaf_chart_parameterPolynomial_map
    (hj : MvPolynomial.X j ∉ C.prime (genericPoint Y)) (p : Polynomial ℂ) :
    (Polynomial.mapRingHom (a3t_phi C j hj))
      (p.map ((C.θ j).comp MvPolynomial.C)) = p.map (algebraMap ℂ (a3t_Ax C j)) := by
  have hc : (a3t_phi C j hj).comp ((C.θ j).comp MvPolynomial.C) =
      algebraMap ℂ (a3t_Ax C j) := by
    apply RingHom.ext
    intro c
    change a3t_phi C j hj (C.θ j (MvPolynomial.C c)) = _
    rw [a3t_phi_θ]
    simp only [a3t_phiT, MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_C]
  change (p.map ((C.θ j).comp MvPolynomial.C)).map (a3t_phi C j hj) = _
  rw [Polynomial.map_map, hc]

#print axioms IntersectionProductScaf_chart_parameterPolynomial_map

end ChartConeLaurent

section ParameterLengths

/-- Reordering a polynomial ring over a homogeneous coordinate ring sends a scalar
parameter polynomial to the corresponding constant multivariable polynomial. -/
theorem IntersectionProductScaf_polynomialParameter_eq
    {σ : Type} [Fintype σ] [DecidableEq σ] (p : Polynomial ℂ) :
    a3m_eq σ (p.map (algebraMap ℂ (MvPolynomial σ ℂ))) = MvPolynomial.C p := by
  let f : Polynomial ℂ →+* MvPolynomial σ (Polynomial ℂ) :=
    (a3m_eq σ).toRingHom.comp
      (Polynomial.mapRingHom (algebraMap ℂ (MvPolynomial σ ℂ)))
  have hf : f = MvPolynomial.C := by
    apply Polynomial.ringHom_ext
    · intro c
      simp [f, a3m_eq_C]
    · simp [f, a3m_eq_X]
  exact congrArg (fun g : Polynomial ℂ →+* MvPolynomial σ (Polynomial ℂ) => g p) hf

#print axioms IntersectionProductScaf_polynomialParameter_eq

/-- Exclusion of nonzero scalar parameter polynomials from the product-chart prime forces
the corresponding projective parameter to be generic. -/
theorem IntersectionProductScaf_parameter_generic_of_chart_exclusion
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom]
    (w : (a3n_T X).left) (hw : w ∈ a3h_U X)
    (h : ∀ p : Polynomial ℂ, p ≠ 0 →
      p.map (algebraMap ℂ (MvPolynomial (Fin (a3s_N X + 1)) ℂ)) ∉
        a3s_Q X (a3h_pt X w hw)) :
    a3n_h X w = genericPoint (g3c_P 1) := by
  have hb := a3m_line_snd_bot (a3s_CX X) (a3s_hov X) (a3h_pt X w hw) (by
    intro p hp hmem
    apply h p hp
    change MvPolynomial.C p ∈ (a3s_LC X).prime (a3h_pt X w hw) at hmem
    change p.map (algebraMap ℂ (MvPolynomial (Fin (a3s_N X + 1)) ℂ)) ∈
      ((a3s_LC X).prime (a3h_pt X w hw)).comap
        (a3m_eq (Fin (a3s_N X + 1)))
    rw [Ideal.mem_comap, IntersectionProductScaf_polynomialParameter_eq]
    exact hmem)
  change CategoryTheory.Limits.pullback.snd (CategoryTheory.Limits.terminal.from X.left)
    (CategoryTheory.Limits.terminal.from (g3c_P 1)) ((a3h_e X).hom w) = _ at hb
  rw [a3h_e_snd_apply] at hb
  rw [a3m_genericPoint_P1, a3m_η1]
  exact hb

#print axioms IntersectionProductScaf_parameter_generic_of_chart_exclusion

/-- Trivial contraction of a product-chart prime to the scalar parameter ring gives
domination of the projective parameter. -/
theorem IntersectionProductScaf_parameter_generic_of_chart_comap
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom]
    (w : (a3n_T X).left) (hw : w ∈ a3h_U X)
    (h : (a3s_Q X (a3h_pt X w hw)).comap
      (Polynomial.mapRingHom
        (algebraMap ℂ (MvPolynomial (Fin (a3s_N X + 1)) ℂ))) = ⊥) :
    a3n_h X w = genericPoint (g3c_P 1) := by
  apply IntersectionProductScaf_parameter_generic_of_chart_exclusion X w hw
  intro p hp hmem
  have : p ∈ (a3s_Q X (a3h_pt X w hw)).comap
      (Polynomial.mapRingHom
        (algebraMap ℂ (MvPolynomial (Fin (a3s_N X + 1)) ℂ))) := hmem
  rw [h, Ideal.mem_bot] at this
  exact hp this

#print axioms IntersectionProductScaf_parameter_generic_of_chart_comap

/-- A point dominating the projective parameter belongs to its standard affine chart. -/
theorem IntersectionProductScaf_parameter_generic_mem_U
    (X : Over (Spec ↧ℂ)) (y : (a3n_T X).left)
    (hy : a3n_h X y = genericPoint (g3c_P 1)) : y ∈ a3h_U X := by
  rw [a3h_mem_U_iff]
  change _ ∈ Set.range (g3c_chartι 1 0)
  rw [a3h_e_snd_apply, hy, a3m_genericPoint_P1, a3m_η1]
  exact ⟨a3m_bot1, rfl⟩

#print axioms IntersectionProductScaf_parameter_generic_mem_U

/-- A prime avoiding every nonzero parameter polynomial contracts to the generic parameter
prime. -/
theorem IntersectionProductScaf_parameter_comap_eq_bot
    {S : Type*} [CommRing S] (f : Polynomial ℂ →+* S) (Q : Ideal S)
    (hQ : ∀ p : Polynomial ℂ, p ≠ 0 → f p ∉ Q) : Q.comap f = ⊥ := by
  ext p
  constructor
  · intro hp
    by_contra hp0
    exact hQ p hp0 hp
  · intro hp
    rw [Ideal.mem_bot] at hp
    rw [hp]
    exact (Q.comap f).zero_mem

/-- A trivial parameter contraction through a composite ring map remains trivial after
contracting first to the intermediate chart ring. -/
theorem IntersectionProductScaf_parameter_comap_comp
    {R S T : Type*} [CommRing R] [CommRing S] [CommRing T]
    (u : R →+* S) (f : S →+* T) (Q : Ideal T)
    (hQ : Q.comap (f.comp u) = ⊥) : (Q.comap f).comap u = ⊥ := by
  rw [Ideal.comap_comap]
  exact hQ

#print axioms IntersectionProductScaf_parameter_comap_comp

#print axioms IntersectionProductScaf_parameter_comap_eq_bot

/-- On affine spectra, parameter-polynomial exclusion says that the point lies over the generic
point of the affine parameter line. -/
theorem IntersectionProductScaf_parameter_spec_generic
    {S : Type} [CommRing S] (f : Polynomial ℂ →+* S) (Q : PrimeSpectrum S)
    (hQ : ∀ p : Polynomial ℂ, p ≠ 0 → f p ∉ Q.asIdeal) :
    (Spec.map (CommRingCat.ofHom f)) Q =
      genericPoint (Spec (.of (Polynomial ℂ))) := by
  rw [genericPoint_eq_bot_of_affine]
  apply PrimeSpectrum.ext
  exact IntersectionProductScaf_parameter_comap_eq_bot f Q.asIdeal hQ

#print axioms IntersectionProductScaf_parameter_spec_generic

/-- A nonzero complex polynomial acts regularly after extension to any nontrivial complex
algebra's polynomial ring. -/
theorem IntersectionProductScaf_complexPolynomial_regular
    {R : Type} [CommRing R] [Nontrivial R] [Algebra ℂ R]
    (p : Polynomial ℂ) (hp : p ≠ 0) :
    IsSMulRegular (Polynomial R) (p.map (algebraMap ℂ R)) := by
  have hlc : IsUnit p.leadingCoeff := isUnit_iff_ne_zero.mpr
    (Polynomial.leadingCoeff_ne_zero.mpr hp)
  have hlcMap : IsUnit (p.map (algebraMap ℂ R)).leadingCoeff := by
    rw [Polynomial.leadingCoeff_map_eq_of_isUnit_leadingCoeff _ hlc]
    exact hlc.map _
  intro x y hxy
  have hxy' : p.map (algebraMap ℂ R) * x =
      p.map (algebraMap ℂ R) * y := by
    simpa [Algebra.smul_def] using hxy
  apply sub_eq_zero.mp
  apply (Polynomial.isUnit_leadingCoeff_mul_right_eq_zero_iff hlcMap).mp
  rw [mul_sub, hxy', sub_self]

/-- Nonzero complex parameter polynomials remain regular after flat extension of a polynomial
algebra. -/
theorem IntersectionProductScaf_complexPolynomial_regular_of_flat
    {R S : Type} [CommRing R] [Nontrivial R] [Algebra ℂ R]
    [CommRing S] [Algebra (Polynomial R) S] [Module.Flat (Polynomial R) S]
    (p : Polynomial ℂ) (hp : p ≠ 0) :
    IsSMulRegular S
      (algebraMap (Polynomial R) S (p.map (algebraMap ℂ R))) :=
  (IntersectionProductScaf_complexPolynomial_regular p hp).of_flat

/-- A nonzero complex parameter polynomial acts regularly on every nontrivial constant-cylinder
quotient. -/
theorem IntersectionProductScaf_complexPolynomial_regular_quotientCylinder
    {R : Type} [CommRing R] [Algebra ℂ R] (I : Ideal R) [Nontrivial (R ⧸ I)]
    (p : Polynomial ℂ) (hp : p ≠ 0) :
    IsSMulRegular (Polynomial R ⧸ I.map Polynomial.C)
      (Ideal.Quotient.mk (I.map Polynomial.C) (p.map (algebraMap ℂ R))) := by
  let e := I.polynomialQuotientEquivQuotientPolynomial
  have hreg : IsSMulRegular (Polynomial (R ⧸ I))
      (p.map (algebraMap ℂ (R ⧸ I))) :=
    IntersectionProductScaf_complexPolynomial_regular p hp
  intro x y hxy
  apply e.symm.injective
  apply hreg
  have hxy' : Ideal.Quotient.mk (I.map Polynomial.C) (p.map (algebraMap ℂ R)) * x =
      Ideal.Quotient.mk (I.map Polynomial.C) (p.map (algebraMap ℂ R)) * y := by
    simpa [Algebra.smul_def] using hxy
  have he := congrArg e.symm hxy'
  simpa [e, Polynomial.map_map, Algebra.smul_def] using he

#print axioms IntersectionProductScaf_complexPolynomial_regular
#print axioms IntersectionProductScaf_complexPolynomial_regular_of_flat
#print axioms IntersectionProductScaf_complexPolynomial_regular_quotientCylinder

/-- Mapping a constant cylinder ideal is the constant cylinder on the mapped coefficient ideal. -/
theorem IntersectionProductScaf_map_cylinder
    {R S : Type} [CommRing R] [CommRing S] (f : R →+* S) (I : Ideal R) :
    (I.map Polynomial.C).map (Polynomial.mapRingHom f) =
      (I.map f).map Polynomial.C := by
  rw [Ideal.map_map, Ideal.map_map]
  congr 1
  apply RingHom.ext
  intro r
  simp

/-- Nonzero complex parameter polynomials act regularly after mapping a coefficient ideal and
forming its polynomial cylinder. -/
theorem IntersectionProductScaf_complexPolynomial_regular_mappedCylinder
    {R S : Type} [CommRing R] [CommRing S] [Algebra ℂ S]
    (f : R →+* S) (I : Ideal R) [Nontrivial (S ⧸ I.map f)]
    (p : Polynomial ℂ) (hp : p ≠ 0) :
    IsSMulRegular
      (Polynomial S ⧸ (I.map Polynomial.C).map (Polynomial.mapRingHom f))
      (Ideal.Quotient.mk
        ((I.map Polynomial.C).map (Polynomial.mapRingHom f))
        (p.map (algebraMap ℂ S))) := by
  rw [IntersectionProductScaf_map_cylinder]
  exact IntersectionProductScaf_complexPolynomial_regular_quotientCylinder (I.map f) p hp

#print axioms IntersectionProductScaf_map_cylinder
#print axioms IntersectionProductScaf_complexPolynomial_regular_mappedCylinder

/-- Regular elements remain regular after quotienting a localization by the extended ideal. -/
theorem IntersectionProductScaf_regular_localizedQuotient
    {A L : Type*} [CommRing A] [CommRing L] [Algebra A L]
    (M : Submonoid A) [IsLocalization M L] (I : Ideal A) (r : A)
    (hr : IsSMulRegular (A ⧸ I) (Ideal.Quotient.mk I r)) :
    IsSMulRegular (L ⧸ I.map (algebraMap A L))
      (Ideal.Quotient.mk (I.map (algebraMap A L)) (algebraMap A L r)) := by
  let q := Ideal.quotientMap (I.map (algebraMap A L)) (algebraMap A L) Ideal.le_comap_map
  letI : Algebra (A ⧸ I) (L ⧸ I.map (algebraMap A L)) := q.toAlgebra
  have hloc : IsLocalization (Algebra.algebraMapSubmonoid (A ⧸ I) M)
      (L ⧸ I.map (algebraMap A L)) :=
    IsLocalization.of_surjective M L (Ideal.Quotient.mk I)
      Ideal.Quotient.mk_surjective
      (Ideal.Quotient.mk (I.map (algebraMap A L))) Ideal.Quotient.mk_surjective rfl (by simp)
  letI := hloc
  letI : Module.Flat (A ⧸ I) (L ⧸ I.map (algebraMap A L)) :=
    IsLocalization.flat _ (Algebra.algebraMapSubmonoid (A ⧸ I) M)
  have hreg := hr.of_flat (S := L ⧸ I.map (algebraMap A L))
  simpa only [q, RingHom.algebraMap_toAlgebra, Ideal.quotientMap_mk] using hreg

#print axioms IntersectionProductScaf_regular_localizedQuotient

/-- A ring equivalence carries regularity across corresponding quotient ideals. -/
theorem IntersectionProductScaf_regular_quotientEquiv
    {A B : Type*} [CommRing A] [CommRing B]
    (e : A ≃+* B) (I : Ideal A) (J : Ideal B) (hJ : J = I.map e.toRingHom)
    (r : A) (hr : IsSMulRegular (A ⧸ I) (Ideal.Quotient.mk I r)) :
    IsSMulRegular (B ⧸ J) (Ideal.Quotient.mk J (e r)) := by
  have hJ' : J = I.map (e : A →+* B) := hJ
  let q := Ideal.quotientEquiv I J e hJ'
  intro x y hxy
  apply q.symm.injective
  apply hr
  change Ideal.Quotient.mk J (e r) * x =
    Ideal.Quotient.mk J (e r) * y at hxy
  change Ideal.Quotient.mk I r * q.symm x = Ideal.Quotient.mk I r * q.symm y
  have he := congrArg q.symm hxy
  rw [map_mul, map_mul] at he
  have hqr : q.symm (Ideal.Quotient.mk J (e r)) = Ideal.Quotient.mk I r := by
    change (Ideal.quotientEquiv I J e hJ').symm
      (Ideal.Quotient.mk J (e r)) = Ideal.Quotient.mk I r
    rw [Ideal.quotientEquiv_symm_mk, RingEquiv.symm_apply_apply]
  rwa [hqr] at he

#print axioms IntersectionProductScaf_regular_quotientEquiv

/-- Regularity descends from an ideal quotient to the quotient by its contraction. -/
theorem IntersectionProductScaf_regular_comap
    {A B : Type*} [CommRing A] [CommRing B] (f : A →+* B) (I : Ideal B) (r : A)
    (hr : IsSMulRegular (B ⧸ I) (f r)) :
    IsSMulRegular (A ⧸ I.comap f) r := by
  let g := Ideal.quotientMap I f le_rfl
  have hg : Function.Injective g := Ideal.quotientMap_injective
  intro x y hxy
  apply hg
  apply hr
  change Ideal.Quotient.mk I (f r) * g x = Ideal.Quotient.mk I (f r) * g y
  have h := congrArg g hxy
  change g (Ideal.Quotient.mk (I.comap f) r * x) =
    g (Ideal.Quotient.mk (I.comap f) r * y) at h
  simpa only [map_mul, Ideal.quotientMap_mk, g] using h
#print axioms IntersectionProductScaf_regular_comap

/-- A regular equation on an affine inverse image remains regular after extending its ideal. -/
theorem IntersectionProductScaf_map_equation_regular
    {U V : Scheme} (f : U ⟶ V) [QuasiCompact f] (I : U.IdealSheafData)
    (W : V.affineOpens) (hW : IsAffineOpen (f ⁻¹ᵁ W)) (r : Γ(V, W))
    (hr : IsSMulRegular (Γ(U, f ⁻¹ᵁ W) ⧸ I.ideal ⟨_, hW⟩) (f.app W r)) :
    IsSMulRegular (Γ(V, W) ⧸ (I.map f).ideal W) r := by
  rw [Scheme.IdealSheafData.ideal_map I f W hW]
  exact IntersectionProductScaf_regular_comap (f.app W).hom (I.ideal ⟨_, hW⟩) r hr
#print axioms IntersectionProductScaf_map_equation_regular

