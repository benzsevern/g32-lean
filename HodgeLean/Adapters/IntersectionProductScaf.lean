/-- The extended ideal of the prime square inverse image.
Source: Fulton, *Intersection Theory*, second edition, §1.5 (inverse images of subschemes). -/
def IntersectionProductScaf_squarePrimeIdeal
    (M : Fin (n + 1) × Fin (n + 1) → ℂ)
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite) (y : (a3n_T X).left) :
    (a3n_T (a3n_T X)).left.IdealSheafData :=
  (ccm3_inverseIdeal (IntersectionProductScaf_familyMap₁ X hfin M).left
    ((a3h_G (a3h_πO X hfin)).left y)).map
      (IntersectionProductScaf_familyInclusion (a3n_T X) M).left

/-- The extended square support retains specialization of the complex original parameter. -/
theorem IntersectionProductScaf_squarePrimeIdeal_parameter_specializes
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [IsProjective X.hom] {n : ℕ}
    (M : Fin (n + 1) × Fin (n + 1) → ℂ)
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (y : (a3n_T X).left) (w : (a3n_T (a3n_T X)).left)
    (hw : w ∈ (IntersectionProductScaf_squarePrimeIdeal M a hfin y).support) :
    a3n_p X y ⤳ a3n_p X ((a3n_q (a3n_T X)).left w) := by
  have hcomm : (IntersectionProductScaf_familyInclusion (a3n_T X) M).left ≫
      ((a3n_q (a3n_T X)).left ≫ a3n_p X) =
      (IntersectionProductScaf_familyMap₁ X hfin M).left ≫ a3n_p (a3h_PnO n) := by
    rw [← Category.assoc, IntersectionProductScaf_familyInclusion_base,
      IntersectionProductScaf_familyMap₁_parameter]
    rfl
  have hs := IntersectionProductScaf_extended_inverseIdeal_parameter_specializes
    (IntersectionProductScaf_familyInclusion (a3n_T X) M).left
    (IntersectionProductScaf_familyMap₁ X hfin M).left
    ((a3n_q (a3n_T X)).left ≫ a3n_p X) (a3n_p (a3h_PnO n)) hcomm
    ((a3h_G (a3h_πO X hfin)).left y) w hw
  have he := congrArg (fun f : (a3n_T X).left ⟶ a3n_P1.left => f y)
    (a3h_G_p (a3h_πO X hfin))
  change a3n_p (a3h_PnO n) ((a3h_G (a3h_πO X hfin)).left y) = a3n_p X y at he
  rw [he] at hs
  exact hs
