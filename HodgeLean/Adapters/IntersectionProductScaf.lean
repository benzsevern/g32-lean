/-- The square boundary is the sum of its fibre cycles with the parameter divisor coefficients. -/
theorem IntersectionProductScaf_squareFamily_boundary_weighted_fibres
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom]
    {n : ℕ} (hn : height (genericPoint X.left) = n)
    (M : Fin (n + 1) × Fin (n + 1) → ℂ)
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (y : (a3n_T X).left) :
    a3k_bd (a3n_T X) ((IntersectionProductScaf_data M a hfin).Θ₁
      (a1p_pushforward (a3h_G (a3h_πO X hfin)).left
        (Function.locallyFinsuppWithin.single y 1))) =
      a3m_smul (a3k_cycT (a3n_T X)
        (a3n_σ (a3n_T X) 0 (genericPoint (a3n_T X).left)))
        (IntersectionProductScaf_translationFibreCycle M a hfin y 0) +
      a3m_smul (a3k_cycT (a3n_T X)
        (a3n_σ (a3n_T X) 1 (genericPoint (a3n_T X).left)))
        (IntersectionProductScaf_translationFibreCycle M a hfin y 1) := by
  rw [IntersectionProductScaf_translationFibre_component_expansion X hn M a hfin y 0 (Or.inl rfl),
    IntersectionProductScaf_translationFibre_component_expansion X hn M a hfin y 1 (Or.inr rfl)]
  ext x
  simp only [a3k_bd, a3m_sum_apply, a3m_smul_apply,
    Function.locallyFinsuppWithin.coe_add, Pi.add_apply]
  rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro w hw
  have hnz : ((IntersectionProductScaf_data M a hfin).Θ₁
      (a1p_pushforward (a3h_G (a3h_πO X hfin)).left
        (Function.locallyFinsuppWithin.single y 1))) w ≠ 0 := by simpa using hw
  rw [IntersectionProductScaf_piece_fibres (a3n_T X) w
    (IntersectionProductScaf_theta₁_push_single_dom_s X a hfin M hn y w hnz)]
  simp only [Function.locallyFinsuppWithin.coe_add, Pi.add_apply, a3m_smul_apply]
  ring
#print axioms IntersectionProductScaf_squareFamily_boundary_weighted_fibres
/-- Original endpoint sections have regular local equations on the extended square family. -/
theorem IntersectionProductScaf_originalFibre_regular_equation
    (S : Finset (a3n_T X).left) (hn : height (genericPoint X.left) = n) :
    a3r_Generic {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ |
      ∀ hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
          (a3r_lin (a3r_mat a)).toRingHom).Finite,
        a3r_Generic {M : Fin (n + 1) × Fin (n + 1) → ℂ |
          ∀ y ∈ S, a3n_h X y = genericPoint (g3c_P 1) →
            ∀ c : ℂ, (c = 0 ∨ c = 1) →
              let I := IntersectionProductScaf_squarePrimeIdeal M a hfin y
              ∀ x ∈ genericPoints ((a3k_ι X c).ker.comap I.subschemeι).subscheme,
                ∃ r : I.subscheme.presheaf.stalk
                    (((a3k_ι X c).ker.comap I.subschemeι).subschemeι x),
                  IsSMulRegular (I.subscheme.presheaf.stalk
                    (((a3k_ι X c).ker.comap I.subschemeι).subschemeι x)) r ∧
                  RingHom.ker ((((a3k_ι X c).ker.comap I.subschemeι).subschemeι).stalkMap x).hom =
                    Ideal.span {r}}} := by
  refine a3r_generic_univ.mono fun a _ hfin => ?_
  have := IntersectionProductScaf_projection_flat X hfin hn
  refine a3r_generic_univ.mono fun M _ y _ hy c hc x _ => ?_
  exact IntersectionProductScaf_originalFibre_regular_equation_of_projection
    X hfin hn M y hy c hc x

#print axioms IntersectionProductScaf_originalFibre_regular_equation

/-- The original fibre has the component fibre lengths weighted by the actual family coefficients. -/
theorem IntersectionProductScaf_originalFibre_component_expansion
    (S : Finset (a3n_T X).left) (hn : height (genericPoint X.left) = n) :
    a3r_Generic {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ |
      ∀ hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
          (a3r_lin (a3r_mat a)).toRingHom).Finite,
        a3r_Generic {M : Fin (n + 1) × Fin (n + 1) → ℂ |
          ∀ y ∈ S, a3n_h X y = genericPoint (g3c_P 1) →
            ∀ c : ℂ, (c = 0 ∨ c = 1) →
              let W := (IntersectionProductScaf_data M a hfin).Θ₁
                (a1p_pushforward (a3h_G (a3h_πO X hfin)).left
                  (Function.locallyFinsuppWithin.single y 1))
              IntersectionProductScaf_originalFibreCycle M a hfin y c =
                ∑ w ∈ (a3m_support_finite W).toFinset, a3m_smul (W w)
                  (a2g_fundCycle (((ccm3_primeIdeal (a3n_T (a3n_T X)).left w).comap
                    (a3k_ι X c)).subschemeι))}} := by
  refine (IntersectionProductScaf_originalFibre_regular_equation S hn).mono ?_
  intro a ha hfin
  refine (ha hfin).mono ?_
  intro M hM y hy hdom c hc
  exact IntersectionProductScaf_originalFibre_expansion_of_regular X hn M a hfin y hdom c hc
    (hM y hy hdom c hc)

/-- Every nonzero original-fibre coefficient has the dimension of its input point. -/
theorem IntersectionProductScaf_originalFibre_coefficient_height
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom]
    {n : ℕ} (S : Finset (a3n_T X).left) (hn : height (genericPoint X.left) = n) :
    a3r_Generic {a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ |
      ∀ hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
          (a3r_lin (a3r_mat a)).toRingHom).Finite,
        a3r_Generic {M : Fin (n + 1) × Fin (n + 1) → ℂ |
          ∀ y ∈ S, a3n_h X y = genericPoint (g3c_P 1) →
            ∀ c : ℂ, (c = 0 ∨ c = 1) → ∀ x : (a3n_T X).left,
              IntersectionProductScaf_originalFibreCycle M a hfin y c x ≠ 0 → height x = height y}} := by
  refine (IntersectionProductScaf_originalFibre_component_expansion S hn).mono ?_
  intro a ha hfin
  have := IntersectionProductScaf_projectionProduct_finite X hfin
  refine (ha hfin).mono ?_
  intro M hM y hy hdom c hc x hx
  rw [hM y hy hdom c hc] at hx
  simp only [a3m_sum_apply, a3m_smul_apply] at hx
  obtain ⟨w, hw, hwx⟩ := Finset.exists_ne_zero_of_sum_ne_zero hx
  obtain ⟨hw0, hx0⟩ := mul_ne_zero_iff.mp hwx
  have he := IntersectionProductScaf_squareFamily_original_fibre_height X hn M a hfin
    y hdom w hw0 c hc x hx0
  rwa [IntersectionProductScaf_finite_height] at he
#print axioms IntersectionProductScaf_originalFibre_coefficient_height

/-- A flat pullback coefficient receives a contribution only from the image point. -/
theorem IntersectionProductScaf_flatPullback_apply_image
    {U Z : Over (Spec ↧ℂ)}
    [LocallyOfFiniteType U.hom] [QuasiCompact U.hom]
    [LocallyOfFiniteType Z.hom] [QuasiCompact Z.hom]
    (f : U ⟶ Z) [Flat f.left] (c : AlgebraicCycle Z.left ℚ) (u : U.left) :
    ccm3_flatPullback f.left c u =
      c (f.left u) * ccm3_flatPullbackPrime f.left (f.left u) u := by
  classical
  let h := a3m_support_finite c
  rw [ccm3_flatPullback, finsum_eq_sum_of_support_subset (s := h.toFinset)]
  · rw [a3m_sum_apply]
    simp only [Function.locallyFinsuppWithin.mapRange_apply]
    apply Finset.sum_eq_single (f.left u)
    · intro z hz hne
      have he : ccm3_flatPullbackPrime f.left z u = 0 := by
        by_contra hn
        exact hne (IntersectionProductScaf_flatPullbackPrime_image f z u hn).symm
      rw [he, mul_zero]
    · intro hn
      have hc : c (f.left u) = 0 := by
        by_contra hc
        exact hn (h.mem_toFinset.mpr hc)
      rw [hc, zero_mul]
  · intro z hz
    by_contra hn
    have hc : c z = 0 := by
      by_contra hc
      exact hn (h.mem_toFinset.mpr hc)
    apply hz
    ext x
    simp only [Function.locallyFinsuppWithin.mapRange_apply, hc, zero_mul]
    rfl
#print axioms IntersectionProductScaf_flatPullback_apply_image

open TopologicalSpace in
set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
/-- Flat inverse image preserves the fundamental cycle with all input and fibre multiplicities. -/
theorem IntersectionProductScaf_flatPullback_fundCycle
    {U Z : Over (Spec ↧ℂ)}
    [LocallyOfFiniteType U.hom] [QuasiCompact U.hom]
    [LocallyOfFiniteType Z.hom] [QuasiCompact Z.hom]
    (f : U ⟶ Z) [Flat f.left] (K : Z.left.IdealSheafData) :
    ccm3_flatPullback f.left (a2g_fundCycle K.subschemeι) =
      a2g_fundCycle (K.comap f.left).subschemeι := by
  classical
  have : IsLocallyNoetherian U.left := LocallyOfFiniteType.isLocallyNoetherian U.hom
  have : IsLocallyNoetherian Z.left := LocallyOfFiniteType.isLocallyNoetherian Z.hom
  have : IsNoetherian U.left := ⟨⟩
  have : IsNoetherian Z.left := ⟨⟩
  have : NoetherianSpace K.subscheme := a2g_subscheme_noetherianSpace K
  have : NoetherianSpace (K.comap f.left).subscheme :=
    a2g_subscheme_noetherianSpace (K.comap f.left)
  let hK := genericPoints.finite (NoetherianSpace.finite_irreducibleComponents (α := K.subscheme))
  let hJ := genericPoints.finite
    (NoetherianSpace.finite_irreducibleComponents (α := (K.comap f.left).subscheme))
  ext x
  rw [IntersectionProductScaf_flatPullback_apply_image]
  by_cases hx : x ∈ Set.range (K.comap f.left).subschemeι
  · obtain ⟨u, rfl⟩ := hx
    have hz : f.left ((K.comap f.left).subschemeι u) ∈ K.support := by
      have h := (K.comap f.left).range_subschemeι.subset (Set.mem_range_self u)
      rwa [Scheme.IdealSheafData.support_comap] at h
    obtain ⟨z, hz⟩ := Set.mem_range.mp (K.range_subschemeι.symm.subset hz)
    let I := ccm3_inverseIdeal f.left (K.subschemeι z)
    have hxI : (K.comap f.left).subschemeι u ∈ I.support := by
      change _ ∈ ((ccm3_primeIdeal Z.left (K.subschemeι z)).comap f.left).support
      rw [Scheme.IdealSheafData.support_comap]
      change f.left _ ∈ ((Scheme.IdealSheafData.vanishingIdeal
        ⟨closure ({K.subschemeι z} : Set Z.left), isClosed_closure⟩).support : Set Z.left)
      rw [Scheme.IdealSheafData.coe_support_vanishingIdeal, ← hz]
      exact subset_closure (Set.mem_singleton _)
    obtain ⟨v, hv⟩ := Set.mem_range.mp (I.range_subschemeι.symm.subset hxI)
    have : NoetherianSpace I.subscheme := a2g_subscheme_noetherianSpace I
    let hI := genericPoints.finite (NoetherianSpace.finite_irreducibleComponents (α := I.subscheme))
    have hc := IntersectionProductScaf_flat_comap_component_iff f.left K u z hz.symm v hv
    have hlen := IntersectionProductScaf_flat_comap_intrinsic_stalk_length f.left K u z hz.symm v hv
    rw [← hz]
    change a2g_fundCycle K.subschemeι (K.subschemeι z) *
      a2g_fundCycle I.subschemeι ((K.comap f.left).subschemeι u) = _
    rw [← hv, IntersectionProductScaf_fundCycle_apply_embedded I.subschemeι
      I.subschemeι.isClosedEmbedding.injective hI v]
    rw [hv]
    rw [IntersectionProductScaf_fundCycle_apply_embedded K.subschemeι
      K.subschemeι.isClosedEmbedding.injective hK z,
      IntersectionProductScaf_fundCycle_apply_embedded (K.comap f.left).subschemeι
        (K.comap f.left).subschemeι.isClosedEmbedding.injective hJ u]
    by_cases hzgen : z ∈ genericPoints K.subscheme
    · by_cases hvgen : v ∈ genericPoints I.subscheme
      · rw [if_pos hzgen, if_pos hvgen, if_pos (hc.mpr ⟨hzgen, hvgen⟩), hlen]
        simp only [ENat.toNat_mul, Nat.cast_mul, ccm3_genericLength, I]
      · rw [if_pos hzgen, if_neg hvgen, if_neg (fun h => hvgen (hc.mp h).2), mul_zero]
    · rw [if_neg hzgen, if_neg (fun h => hzgen (hc.mp h).1), zero_mul]
  · have hz : f.left x ∉ Set.range K.subschemeι := by
      intro hz
      apply hx
      rw [Scheme.IdealSheafData.range_subschemeι, Scheme.IdealSheafData.support_comap]
      exact K.range_subschemeι.subset hz
    rw [IntersectionProductScaf_fundCycle_apply_of_not_mem_range K.subschemeι hK _ hz,
      IntersectionProductScaf_fundCycle_apply_of_not_mem_range (K.comap f.left).subschemeι hJ _ hx,
      zero_mul]
#print axioms IntersectionProductScaf_flatPullback_fundCycle

open TopologicalSpace in
/-- A fibre with incompatible complex parameter has zero original cycle. -/
theorem IntersectionProductScaf_originalFibre_zero_of_parameter
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom]
    {n : ℕ} (M : Fin (n + 1) × Fin (n + 1) → ℂ)
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (y : (a3n_T X).left) (c : ℂ)
    (hc : ¬ a3n_p X y ⤳ a3n_pt c a3n_o) :
    IntersectionProductScaf_originalFibreCycle M a hfin y c = 0 := by
  let I := (IntersectionProductScaf_squarePrimeIdeal M a hfin y).comap (a3k_ι X c)
  have : IsLocallyNoetherian (a3n_T X).left :=
    LocallyOfFiniteType.isLocallyNoetherian (a3n_T X).hom
  have : IsNoetherian (a3n_T X).left := ⟨⟩
  have : NoetherianSpace I.subscheme := a2g_subscheme_noetherianSpace I
  ext x
  change (_ : ℚ) * a2g_fundCycle I.subschemeι x = 0
  suffices h : a2g_fundCycle I.subschemeι x = 0 by rw [h, mul_zero]
  apply IntersectionProductScaf_fundCycle_apply_of_not_mem_range _
    (genericPoints.finite NoetherianSpace.finite_irreducibleComponents)
  intro hx
  have hxI := I.range_subschemeι.subset hx
  change x ∈ (I.support : Set (a3n_T X).left) at hxI
  dsimp only [I] at hxI
  rw [Scheme.IdealSheafData.support_comap] at hxI
  have hs := IntersectionProductScaf_squarePrimeIdeal_parameter_specializes
    X M a hfin y (a3k_ι X c x) hxI
  apply hc
  have he : a3n_p X ((a3n_q (a3n_T X)).left (a3k_ι X c x)) =
      a3n_pt c a3n_o := by
    have he := congrArg (fun f : (a3n_T X).left ⟶ a3n_P1.left => f x)
      (show a3k_ι X c ≫ (a3n_q (a3n_T X)).left ≫ a3n_p X =
        (a3n_q X).left ≫ X.hom ≫ a3n_pt c by
        rw [← Category.assoc, a3k_ι_q, Category.assoc, a3n_σ_p])
    exact he.trans (congrArg (a3n_pt c) (Subsingleton.elim _ _))
  rwa [he] at hs
#print axioms IntersectionProductScaf_originalFibre_zero_of_parameter
open TopologicalSpace in
/-- An input fibre with incompatible complex parameter has zero fundamental cycle. -/
theorem IntersectionProductScaf_inputFibre_zero_of_parameter
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom]
    (y : (a3n_T X).left) (c : ℂ)
    (hc : ¬ a3n_p X y ⤳ a3n_pt c a3n_o) :
    a2g_fundCycle (((ccm3_primeIdeal (a3n_T X).left y).comap
      (a3n_σ X c)).subschemeι) = 0 := by
  let I := (ccm3_primeIdeal (a3n_T X).left y).comap (a3n_σ X c)
  have : IsLocallyNoetherian X.left := LocallyOfFiniteType.isLocallyNoetherian X.hom
  have : IsNoetherian X.left := ⟨⟩
  have : NoetherianSpace I.subscheme := a2g_subscheme_noetherianSpace I
  ext x
  apply IntersectionProductScaf_fundCycle_apply_of_not_mem_range _
    (genericPoints.finite NoetherianSpace.finite_irreducibleComponents)
  rintro ⟨u, rfl⟩
  have hs := (specializes_iff_mem_closure.mpr
    (IntersectionProductScaf_inverseIdeal_image (a3n_σ X c) y u)).map (a3n_p X).continuous
  apply hc
  have he := congrArg (fun f : X.left ⟶ a3n_P1.left => f (I.subschemeι u)) (a3n_σ_p X c)
  change a3n_p X (a3n_σ X c (I.subschemeι u)) = _ at he
  change a3n_p X y ⤳ a3n_p X (a3n_σ X c (I.subschemeι u)) at hs
  rw [he] at hs
  exact hs.trans (specializes_of_eq (congrArg (a3n_pt c) (Subsingleton.elim _ _)))
#print axioms IntersectionProductScaf_inputFibre_zero_of_parameter
/-- An integral-line dominating input that specializes to an endpoint dominates the complex line. -/
theorem IntersectionProductScaf_parameter_generic_of_endpoint_specializes
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom]
    (y : (a3n_T X).left) (hy : a3n_h X y = genericPoint (g3c_P 1))
    (c : ℂ) (hc : c = 0 ∨ c = 1) (hs : a3n_p X y ⤳ a3n_pt c a3n_o) :
    a3n_p X y = genericPoint (a3m_Pn 1) := by
  apply a3k_P1_eq_generic hs
  intro he
  apply a3k_not_mem_range_σ X hy c hc
  rw [a3n_range_σ]
  exact ⟨a3n_o, he.symm⟩
