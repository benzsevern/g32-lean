/-- The translation parameter acts regularly on the translated cone quotient when its
associated primes are all component primes. -/
theorem IntersectionProductScaf_translatedCone_parameter_regular
    (I : Ideal (MvPolynomial (Fin (n + 1) ⊕ Unit) ℂ)) [I.IsPrime]
    (p : Polynomial ℂ) (hp : p ≠ 0)
    (hAssoc : ∀ P ∈ associatedPrimes _
      (_ ⧸ (I.map Polynomial.C).map
        (IntersectionProductScaf_translatedConeMap X a M)),
      P ∈ ((I.map Polynomial.C).map
        (IntersectionProductScaf_translatedConeMap X a M)).minimalPrimes) :
