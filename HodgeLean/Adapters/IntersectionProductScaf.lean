/-- Generalization lifting, translation domination, and the two face conditions give square
position for every member of the finite input family. -/
theorem IntersectionProductScaf_transCycle_face_of_conditions
    (a : Fin (n + 1) × Fin (a3s_N X + 1) → ℂ)
    (hfin : ((Ideal.Quotient.mk (a3s_IX X)).comp
      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (S : Finset (a3n_T X).left)
    (hS : ∀ y ∈ S, a3n_h X y = genericPoint (g3c_P 1))
    (hcond : a3r_Generic {M : Fin (n + 1) × Fin (n + 1) → ℂ |
      GeneralizingMap (IntersectionProductScaf_familyMap₁ X hfin M).left ∧
      ∀ y ∈ S, ∀ w,
        (IntersectionProductScaf_data M a hfin).Θ₁
          (a1p_pushforward (a3h_G (a3h_πO X hfin)).left
            (Function.locallyFinsuppWithin.single y 1)) w ≠ 0 →
        ∃ hdoms : a3n_h (a3n_T X) w = genericPoint (g3c_P 1),
          (∀ d, a3o_cyc (a3n_T X) w hdoms d ≠ 0 →
            a3n_h X ((a3n_q (a3n_T X)).left d) = genericPoint (g3c_P 1)) ∧
          (∀ c : ℂ, (c = 0 ∨ c = 1) → ∀ z ∈ a3y_comps w (a3k_E X c),
            a3n_h (a3n_T X) z ∉ a3m_Z0 ∧ a3n_h (a3n_T X) z ∉ a3m_Zinf)}) :
    a3r_Generic {M : Fin (n + 1) × Fin (n + 1) → ℂ |
      ∀ y ∈ S, ∀ w, (IntersectionProductScaf_data M a hfin).Θ₁
          (a1p_pushforward (a3h_G (a3h_πO X hfin)).left
            (Function.locallyFinsuppWithin.single y 1)) w ≠ 0 →
        a3k_SquarePos X w} := by
  refine hcond.mono fun M hM y hy w hw => ?_
  obtain ⟨hgeneral, hM⟩ := hM
  obtain ⟨hdoms, hfaces, hfacet⟩ := hM y hy w hw
  exact IntersectionProductScaf_squarePos_of_generalizing X hfin M hgeneral y
    (hS y hy) w hw hdoms hfaces hfacet

