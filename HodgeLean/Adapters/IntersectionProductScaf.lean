      (a3r_lin (a3r_mat a)).toRingHom).Finite)
    (M : Fin (n + 1) × Fin (n + 1) → ℂ) (c : ℂ)
    (hc : IsUnit ((IntersectionProductScaf_lineDet M).eval c))
    (I : (a3n_T (a3h_PnO n)).left.IdealSheafData) :
    ((I.comap (IntersectionProductScaf_familyMap₁ X hfin M).left).map
      (IntersectionProductScaf_familyInclusion (a3n_T X) M).left).comap (a3n_σ (a3n_T X) c) =
      I.comap (IntersectionProductScaf_squareFibreMap X hfin M c hc).left := by
  rw [← IntersectionProductScaf_familySection_inclusion (a3n_T X) M c hc,
