/-- Restricting a prime to a generic subscheme point gives its local quotient length. -/
theorem IntersectionProductScaf_prime_restriction_coefficient
    (Y : Scheme) [IsNoetherian Y] (J : Y.IdealSheafData) (z : Y)
    (x : J.subscheme) (hx : x ∈ genericPoints J.subscheme)
    (hz : z ⤳ J.subschemeι x) (U : Y.affineOpens) (hU : J.subschemeι x ∈ U.1) :
    a2g_fundCycle (((ccm3_primeIdeal Y z).comap J.subschemeι).subschemeι) x =
      ((Module.length (Y.presheaf.stalk (J.subschemeι x))
        ((Y.presheaf.stalk (J.subschemeι x)) ⧸
          (a3i_stalkIdeal Y (J.subschemeι x) z ⊔
            (J.ideal U).map (Y.presheaf.germ U.1 _ hU).hom))).toNat : ℚ) := by
  classical
  let K := ccm3_primeIdeal Y z ⊔ J
  have hmem : J.subschemeι x ∈ (K.support : Set Y) := by
    simp only [K, Scheme.IdealSheafData.support_sup, TopologicalSpace.Closeds.coe_inf,
      ccm3_primeIdeal, Scheme.IdealSheafData.coe_support_vanishingIdeal,
      TopologicalSpace.Closeds.coe_mk, Set.mem_inter_iff]
    refine ⟨specializes_iff_mem_closure.mp hz, ?_⟩
    rw [← Scheme.IdealSheafData.range_subschemeι]
    exact ⟨x, rfl⟩
  let y : K.subscheme := ⟨J.subschemeι x, hmem⟩
  have he : Scheme.IdealSheafData.inclusion (show J ≤ K from le_sup_right) y = x := by
    apply J.subschemeι.isEmbedding.injective
    rw [← Scheme.Hom.comp_apply, Scheme.IdealSheafData.inclusion_subschemeι]
    rfl
  have hc := IntersectionProductScaf_prime_subscheme_coefficient Y J z y (he.symm ▸ hx) U hU
  have hV : (genericPoints ((ccm3_primeIdeal Y z).comap J.subschemeι).subscheme).Finite := by
    have : IsLocallyNoetherian J.subscheme := LocallyOfFiniteType.isLocallyNoetherian J.subschemeι
    have := a2g_subscheme_noetherianSpace J
    have : IsNoetherian J.subscheme := ⟨⟩
    have := a2g_subscheme_noetherianSpace ((ccm3_primeIdeal Y z).comap J.subschemeι)
    exact genericPoints.finite TopologicalSpace.NoetherianSpace.finite_irreducibleComponents
  change a2g_fundCycle K.subschemeι (J.subschemeι x) = _ at hc
  rw [show K = J.subschemeι.ker ⊔ ccm3_primeIdeal Y z by
    rw [Scheme.IdealSheafData.ker_subschemeι]; exact sup_comm _ _,
    a2g_ker_sup_eq_map_comap, a2g_fundCycle_map,
    IntersectionProductScaf_fundCycle_comp_injective_apply _ _ J.subschemeι.isEmbedding.injective hV] at hc
  exact hc
#print axioms IntersectionProductScaf_prime_restriction_coefficient



