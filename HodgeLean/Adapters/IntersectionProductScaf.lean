  have hp : (IntersectionProductScaf_parameterOver M).hom =
      Spec.map (CommRingCat.ofHom (algebraMap ℂ (IntersectionProductScaf_lineRing M))) := by
    rw [IntersectionProductScaf_parameterOver_hom,
