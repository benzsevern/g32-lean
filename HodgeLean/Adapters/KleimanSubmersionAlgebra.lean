import Mathlib.RingTheory.Unramified.LocalRing
import Mathlib.RingTheory.Etale.Basic
import Mathlib.RingTheory.RingHom.Etale
import Mathlib.RingTheory.Localization.AtPrime.Basic

/-! # Étale coordinates generate the maximal ideal at a complex point

For an étale map from a complex polynomial ring and a complex point of the target ring, every
function vanishing at the point is, after multiplication by a function not vanishing there, a
combination of the coordinates minus their values. This is unramifiedness at the point.
-/

noncomputable section
open MvPolynomial IsLocalRing

namespace HodgeLean.Adapters

/-- A polynomial minus its value at `c` lies in the ideal generated by the `X i - c i`.
Source: Mathlib `MvPolynomial.induction_on`. -/
theorem hc9k_sub_C_eval_mem_span {K : Type*} [Field K] {n : ℕ} (c : Fin n → K)
    (P : MvPolynomial (Fin n) K) :
    P - C (eval c P) ∈
      Ideal.span (Set.range fun j => (X j - C (c j) : MvPolynomial (Fin n) K)) := by
  induction P using MvPolynomial.induction_on with
  | C a => simp
  | add P Q hP hQ =>
    have : P + Q - C (eval c (P + Q)) = (P - C (eval c P)) + (Q - C (eval c Q)) := by
      simp only [map_add]; ring
    rw [this]
    exact Ideal.add_mem _ hP hQ
  | mul_X P j hP =>
    have : P * X j - C (eval c (P * X j)) =
        (P - C (eval c P)) * X j + C (eval c P) * (X j - C (c j)) := by
      simp only [map_mul, eval_X]; ring
    rw [this]
    exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ hP)
      (Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨j, rfl⟩))

/-- Unramifiedness of an étale coordinate map at a complex point: every function vanishing at
the point becomes, after multiplication by a function nonvanishing there, a combination of the
coordinates minus their values.
Source: Stacks Project, Tag 02GU and Tag 00UW; Mathlib `Algebra.isUnramifiedAt_iff_map_eq`. -/
theorem hc9k_etale_point_relation {K : Type*} [Field K] {n : ℕ} {S : Type*} [CommRing S]
    (g : MvPolynomial (Fin n) K →+* S) (hg : g.Etale) (φ : S →+* K)
    (hφ : ∀ r : K, φ (g (C r)) = r) (s : S) (hs : φ s = 0) :
    ∃ (σ : S) (b : Fin n → S), φ σ ≠ 0 ∧
      σ * s = ∑ j, b j * (g (X j) - g (C (φ (g (X j))))) := by
  classical
  algebraize [g]
  let c : Fin n → K := fun j => φ (g (X j))
  let q : Ideal S := RingHom.ker φ
  have : q.IsPrime := RingHom.ker_isPrime φ
  let p : Ideal (MvPolynomial (Fin n) K) := q.comap g
  have : p.IsPrime := Ideal.comap_isPrime g q
  have : q.LiesOver p := ⟨rfl⟩
  let := Localization.AtPrime.algebraOfLiesOver p q
  have : Algebra.IsUnramifiedAt (MvPolynomial (Fin n) K) q := inferInstance
  have hmap := ((Algebra.isUnramifiedAt_iff_map_eq (MvPolynomial (Fin n) K) p q).mp this).2
  -- the prime below is contained in the ideal of the coordinates minus their values
  have hφg : ∀ P, φ (g P) = eval c P := by
    intro P
    induction P using MvPolynomial.induction_on with
    | C a => simp [hφ]
    | add P Q hP hQ => simp [hP, hQ]
    | mul_X P j hP => simp [hP, c]
  have hp : p ≤ Ideal.span (Set.range fun j => (X j - C (c j) : MvPolynomial (Fin n) K)) := by
    intro P hP
    have h0 : eval c P = 0 := by
      rw [← hφg]
      exact hP
    simpa [h0] using hc9k_sub_C_eval_mem_span c P
  let L := Localization.AtPrime q
  have hsL : algebraMap S L s ∈ maximalIdeal L := by
    rw [IsLocalization.AtPrime.to_map_mem_maximal_iff L q s]
    exact hs
  rw [← hmap] at hsL
  have hsL' := Ideal.map_mono (f := algebraMap (MvPolynomial (Fin n) K) L) hp hsL
  rw [Ideal.map_span, ← Set.range_comp] at hsL'
  obtain ⟨β, hβ⟩ := (Ideal.mem_span_range_iff_exists_fun).mp hsL'
  obtain ⟨⟨τ, hτ⟩, hint⟩ := IsLocalization.exist_integer_multiples_of_finset q.primeCompl
    (Finset.univ.image β)
  choose b hb using fun j => hint (β j) (Finset.mem_image_of_mem β (Finset.mem_univ j))
  have heq : algebraMap S L (τ * s) =
      algebraMap S L (∑ j, b j * (g (X j) - g (C (c j)))) := by
    rw [map_mul, ← hβ, Finset.mul_sum, map_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [map_mul, hb j, Algebra.smul_def, mul_assoc]
    congr 1
    simp only [Function.comp_apply, map_sub, IsScalarTower.algebraMap_apply
      (MvPolynomial (Fin n) K) S L]
    rfl
  obtain ⟨⟨μ, hμ⟩, hμe⟩ := (IsLocalization.eq_iff_exists q.primeCompl L).mp heq
  refine ⟨μ * τ, fun j => μ * b j, ?_, ?_⟩
  · rw [map_mul]
    exact mul_ne_zero hμ hτ
  · simp only [mul_assoc] at hμe ⊢
    rw [hμe, Finset.mul_sum]

end HodgeLean.Adapters
