import HodgeLean.RealDefs.DimensionThree

/-! # Lefschetz (1,1) scoped to one variety: definitions (FROZEN) -/

noncomputable section

open CategoryTheory AlgebraicGeometry AlgebraicGeometry.ComplexPoint
open HodgeLean.RealDefs

namespace HodgeLean.Adapters

/-- Lefschetz (1,1) scoped to one smooth projective integral complex variety: every rational
degree-two Hodge class is in the span of divisor cycle classes. It is tagged by Ben's decision of
2026-10-24; unlike `LefschetzOneOneHyp`, it makes no assertion about any other variety.

Consistency: `ℙ¹` satisfies this because its rational degree-two cohomology is generated by the
class of a point, which is a divisor cycle class.

Source: Griffiths–Harris, *Principles of Algebraic Geometry*, Ch. 1 §2 (the Lefschetz theorem on
`(1,1)`-classes). -/
@[hodge_hypothesis]
def LefschetzOneOneFor (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom]
    [IsProjective X.hom] : Prop :=
  Hdg^1(X; ℚ) ≤ algebraicCycleClassSpan X 1

example (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom] :
    LefschetzOneOneFor X ↔
      ∀ x : H^(2 * 1)(X; ℚ), x ∈ Hdg^1(X; ℚ) → x ∈ algebraicCycleClassSpan X 1 :=
  Iff.rfl

end HodgeLean.Adapters
