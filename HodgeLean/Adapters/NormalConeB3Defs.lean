/-! # Diagonal cone coefficient: objects

Stage A3-B3 objects: the conormal algebra and the glued normal bundle of an ideal sheaf, the
tangent bundle `Spec Sym(Ω)` of a scheme over a field, the diagonal, the cone cycles, the
full-preimage coefficient, vector bundles of rank `r` and the zero-section Gysin relation.
-/

noncomputable section
namespace HodgeLean.Adapters
open CategoryTheory Limits AlgebraicGeometry

universe u

/-! ## The conormal algebra -/

/-- The conormal algebra `Sym_{R/I}(I/I²)`, written as `Sym_R(I/I²)` modulo the ideal generated by
`I` in degree zero; `I/I²` is killed by `I`, so the two agree.
Source: Fulton, *Intersection Theory*, second edition, Appendix B.7.1 (the normal bundle
`N_X Y = Spec Sym(I/I²)`); Mathlib, `SymmetricAlgebra` and `Ideal.Cotangent`. -/
abbrev a3b3_conormalAlg {R : Type*} [CommRing R] (I : Ideal R) : Type _ :=
  SymmetricAlgebra R I.Cotangent ⧸ I.map (algebraMap R (SymmetricAlgebra R I.Cotangent))

example {R : Type*} [CommRing R] (I : Ideal R) : CommRing (a3b3_conormalAlg I) := inferInstance

/-- The degree-one class of an element of the ideal.
Source: Mathlib, `SymmetricAlgebra.ι` and `Ideal.toCotangent`. -/
def a3b3_conormalι {R : Type*} [CommRing R] (I : Ideal R) : I →ₗ[R] a3b3_conormalAlg I :=
  (Ideal.Quotient.mkₐ R _).toLinearMap ∘ₗ SymmetricAlgebra.ι R I.Cotangent ∘ₗ I.toCotangent

example {R : Type*} [CommRing R] (I : Ideal R) : a3b3_conormalι I 0 = 0 := map_zero _

/-- The class of a product of two elements of the ideal vanishes: it lies in `I²`.
Source: Mathlib, `Ideal.toCotangent_eq_zero`. -/
theorem a3b3_conormalι_mul {R : Type*} [CommRing R] (I : Ideal R) (x y : I) :
    a3b3_conormalι I (x * y) = 0 := by
  simp only [a3b3_conormalι, LinearMap.coe_comp, Function.comp_apply]
  rw [(Ideal.toCotangent_eq_zero I (x * y)).2 (by
    rw [pow_two]; exact Ideal.mul_mem_mul x.2 y.2)]
  simp

/-- Scalars from the ideal vanish in the conormal algebra.
Source: Mathlib, `Ideal.Quotient.eq_zero_iff_mem`. -/
theorem a3b3_conormalAlg_algebraMap_eq_zero {R : Type*} [CommRing R] (I : Ideal R) (a : R)
    (ha : a ∈ I) : algebraMap R (a3b3_conormalAlg I) a = 0 := by
  rw [IsScalarTower.algebraMap_apply R (SymmetricAlgebra R I.Cotangent)]
  exact Ideal.Quotient.eq_zero_iff_mem.2 (Ideal.mem_map_of_mem _ ha)

/-- Two ring maps out of the conormal algebra agree when they agree on scalars and on degree-one
classes.
Source: Mathlib, `SymmetricAlgebra.induction` and `Ideal.Quotient.ringHom_ext`. -/
theorem a3b3_conormalAlg_ringHom_ext {R : Type*} [CommRing R] (I : Ideal R) {T : Type*}
    [CommRing T] {g₁ g₂ : a3b3_conormalAlg I →+* T}
    (h₁ : ∀ r : R, g₁ (algebraMap R _ r) = g₂ (algebraMap R _ r))
    (h₂ : ∀ x : I, g₁ (a3b3_conormalι I x) = g₂ (a3b3_conormalι I x)) : g₁ = g₂ := by
  apply Ideal.Quotient.ringHom_ext
  refine RingHom.ext fun a => ?_
  induction a using SymmetricAlgebra.induction with
  | algebraMap r => exact h₁ r
  | ι x =>
    obtain ⟨x, rfl⟩ := I.toCotangent_surjective x
    exact h₂ x
  | mul a b ha hb => simp only [RingHom.comp_apply, map_mul] at ha hb ⊢; rw [ha, hb]
  | add a b ha hb => simp only [RingHom.comp_apply, map_add] at ha hb ⊢; rw [ha, hb]

section map
variable {R S : Type*} [CommRing R] [CommRing S] (φ : R →+* S) (I : Ideal R) (J : Ideal S)
  (h : I.map φ ≤ J)

/-- The degree-one part of the functorial map, as an `R`-linear map (implementation). -/
private def a3b3_conormalMapLinear :
    letI : Algebra R (a3b3_conormalAlg J) :=
      ((algebraMap S (a3b3_conormalAlg J)).comp φ).toAlgebra
    I →ₗ[R] a3b3_conormalAlg J :=
  letI : Algebra R (a3b3_conormalAlg J) :=
    ((algebraMap S (a3b3_conormalAlg J)).comp φ).toAlgebra
  { toFun := fun x => a3b3_conormalι J ⟨φ x, h (Ideal.mem_map_of_mem φ x.2)⟩
    map_add' := fun x y => by
      rw [← map_add]
      congr 1
      exact Subtype.ext (map_add φ _ _)
    map_smul' := fun r x => by
      rw [RingHom.id_apply, Algebra.smul_def, RingHom.algebraMap_toAlgebra, RingHom.comp_apply,
        ← Algebra.smul_def, ← map_smul]
      congr 1
      exact Subtype.ext (by simp [smul_eq_mul]) }

/-- The functorial map on symmetric algebras, before passing to the quotient (implementation). -/
private def a3b3_conormalMapSym : SymmetricAlgebra R I.Cotangent →+* a3b3_conormalAlg J :=
  letI : Algebra R (a3b3_conormalAlg J) :=
    ((algebraMap S (a3b3_conormalAlg J)).comp φ).toAlgebra
  (SymmetricAlgebra.lift (Ideal.Cotangent.lift (a3b3_conormalMapLinear φ I J h) (fun x y => by
    change a3b3_conormalι J _ = 0
    have : (⟨φ ((x * y : I) : R), h (Ideal.mem_map_of_mem φ (x * y).2)⟩ : J) =
        ⟨φ x, h (Ideal.mem_map_of_mem φ x.2)⟩ * ⟨φ y, h (Ideal.mem_map_of_mem φ y.2)⟩ :=
      Subtype.ext (by simp)
    rw [this, a3b3_conormalι_mul]))).toRingHom

private theorem a3b3_conormalMapSym_algebraMap (r : R) :
    a3b3_conormalMapSym φ I J h (algebraMap R _ r) = algebraMap S _ (φ r) := by
  let : Algebra R (a3b3_conormalAlg J) :=
    ((algebraMap S (a3b3_conormalAlg J)).comp φ).toAlgebra
  exact (SymmetricAlgebra.lift _).commutes r

private theorem a3b3_conormalMapSym_ι (x : I) :
    a3b3_conormalMapSym φ I J h (SymmetricAlgebra.ι R I.Cotangent (I.toCotangent x)) =
      a3b3_conormalι J ⟨φ x, h (Ideal.mem_map_of_mem φ x.2)⟩ := by
  let : Algebra R (a3b3_conormalAlg J) :=
    ((algebraMap S (a3b3_conormalAlg J)).comp φ).toAlgebra
  change SymmetricAlgebra.lift _ (SymmetricAlgebra.ι R I.Cotangent (I.toCotangent x)) = _
  rw [SymmetricAlgebra.lift_ι_apply, Ideal.Cotangent.lift_toCotangent]
  rfl

/-- Functoriality of the conormal algebra for ring maps carrying the ideal into the ideal:
`[a] ↦ [φ a]` in degree one and `φ` on scalars.
Source: Fulton, *Intersection Theory*, second edition, Appendix B.7.1 (the conormal sheaf
`I/I²` and the normal bundle `Spec Sym(I/I²)`); Mathlib, `SymmetricAlgebra.lift` and
`Ideal.Cotangent.lift`. -/
def a3b3_conormalMap : a3b3_conormalAlg I →+* a3b3_conormalAlg J :=
  Ideal.Quotient.lift _ (a3b3_conormalMapSym φ I J h) (fun a ha => by
    have hle : I.map (algebraMap R (SymmetricAlgebra R I.Cotangent)) ≤
        RingHom.ker (a3b3_conormalMapSym φ I J h) := by
      rw [Ideal.map_le_iff_le_comap]
      intro b hb
      rw [Ideal.mem_comap, RingHom.mem_ker]
      rw [a3b3_conormalMapSym_algebraMap]
      exact a3b3_conormalAlg_algebraMap_eq_zero J _ (h (Ideal.mem_map_of_mem φ hb))
    exact hle ha)

example (x : I) :
    a3b3_conormalMap φ I J h (a3b3_conormalι I x) =
      a3b3_conormalι J ⟨φ x, h (Ideal.mem_map_of_mem φ x.2)⟩ :=
  a3b3_conormalMapSym_ι φ I J h x

/-- The functorial map on scalars.
Source: Mathlib, `SymmetricAlgebra.lift` (`AlgHom.commutes`). -/
theorem a3b3_conormalMap_algebraMap (r : R) :
    a3b3_conormalMap φ I J h (algebraMap R _ r) = algebraMap S _ (φ r) := by
  rw [IsScalarTower.algebraMap_apply R (SymmetricAlgebra R I.Cotangent) (a3b3_conormalAlg I)]
  exact a3b3_conormalMapSym_algebraMap φ I J h r

/-- The functorial map on degree-one classes.
Source: Mathlib, `SymmetricAlgebra.lift_ι_apply` and `Ideal.Cotangent.lift_toCotangent`. -/
theorem a3b3_conormalMap_ι (x : I) :
    a3b3_conormalMap φ I J h (a3b3_conormalι I x) =
      a3b3_conormalι J ⟨φ x, h (Ideal.mem_map_of_mem φ x.2)⟩ :=
  a3b3_conormalMapSym_ι φ I J h x

end map

/-- Functoriality of the conormal algebra: composition.
Source: Fulton, *Intersection Theory*, second edition, Appendix B.7.1. -/
theorem a3b3_conormalMap_comp {R S T : Type*} [CommRing R] [CommRing S] [CommRing T]
    (φ : R →+* S) (ψ : S →+* T) (I : Ideal R) (J : Ideal S) (K : Ideal T)
    (h₁ : I.map φ ≤ J) (h₂ : J.map ψ ≤ K) (h₃ : I.map (ψ.comp φ) ≤ K) :
    (a3b3_conormalMap ψ J K h₂).comp (a3b3_conormalMap φ I J h₁) =
      a3b3_conormalMap (ψ.comp φ) I K h₃ := by
  apply a3b3_conormalAlg_ringHom_ext
  · intro r
    simp only [RingHom.comp_apply, a3b3_conormalMap_algebraMap]
  · intro x
    simp only [RingHom.comp_apply, a3b3_conormalMap_ι]

/-- Functoriality of the conormal algebra: the identity.
Source: Fulton, *Intersection Theory*, second edition, Appendix B.7.1. -/
theorem a3b3_conormalMap_id {R : Type*} [CommRing R] (φ : R →+* R) (hφ : φ = RingHom.id R)
    (I : Ideal R) (h : I.map φ ≤ I) : a3b3_conormalMap φ I I h = RingHom.id _ := by
  subst hφ
  apply a3b3_conormalAlg_ringHom_ext
  · intro r
    simp only [a3b3_conormalMap_algebraMap, RingHom.id_apply]
  · intro x
    simp only [a3b3_conormalMap_ι, RingHom.id_apply]

/-- The functorial map depends only on the ring map, not on the containment proof.
Source: Lean core, `Eq.subst`. -/
theorem a3b3_conormalMap_congr {R S : Type*} [CommRing R] [CommRing S] {φ φ' : R →+* S}
    (hφ : φ = φ') (I : Ideal R) (J : Ideal S) (h : I.map φ ≤ J) (h' : I.map φ' ≤ J) :
    a3b3_conormalMap φ I J h = a3b3_conormalMap φ' I J h' := by
  subst hφ
  rfl

/-! ## The normal cone as a quotient of the conormal algebra -/

/-- The degree-one class `[a] ↦ [a]₁` from the conormal module to the normal cone ring
(implementation). -/
private def a3b3_conormalToConeLinear {R : Type*} [CommRing R] (I : Ideal R) :
    I →ₗ[R] a3cc3_normalConeRing I where
  toFun x := a3b1_coneMonomial R I 1 ⟨x.1, by simp⟩
  map_add' x y := by
    rw [← a3b1_coneMonomial_add]
    rfl
  map_smul' r x := by
    unfold a3b1_coneMonomial
    rw [RingHom.id_apply, ← Ideal.Quotient.mkₐ_eq_mk R, ← map_smul]
    congr 1
    apply Subtype.ext
    simp [Polynomial.smul_monomial]

/-- The canonical map on the symmetric algebra, before passing to the quotient (implementation). -/
private def a3b3_conormalToConeSym {R : Type*} [CommRing R] (I : Ideal R) :
    SymmetricAlgebra R I.Cotangent →ₐ[R] a3cc3_normalConeRing I :=
  SymmetricAlgebra.lift (Ideal.Cotangent.lift (a3b3_conormalToConeLinear I) (fun x y => by
    change a3b1_coneMonomial R I 1 _ = 0
    apply Ideal.Quotient.eq_zero_iff_mem.2
    rw [mem_map_algebraMap_reesAlgebra_iff]
    intro n
    change (Polynomial.monomial 1 ((x * y : I) : R)).coeff n ∈ I ^ (n + 1)
    rw [Polynomial.coeff_monomial]
    split_ifs with hn
    · subst hn
      rw [pow_two]
      exact Ideal.mul_mem_mul x.2 y.2
    · exact zero_mem _))

/-- The canonical surjection `Sym_{R/I}(I/I²) → gr_I R`, sending the class of `a ∈ I` to its
degree-one class.
Source: Fulton, *Intersection Theory*, second edition, Appendix B.7.1 and §4.1 (the cone
`C_X Y = Spec ⊕ Iⁿ/Iⁿ⁺¹` is a closed subcone of `Spec Sym(I/I²)`). -/
def a3b3_conormalToCone {R : Type*} [CommRing R] (I : Ideal R) :
    a3b3_conormalAlg I →+* a3cc3_normalConeRing I :=
  Ideal.Quotient.lift _ (a3b3_conormalToConeSym I).toRingHom (fun a ha => by
    have hle : I.map (algebraMap R (SymmetricAlgebra R I.Cotangent)) ≤ RingHom.ker
        (a3b3_conormalToConeSym I).toRingHom := by
      rw [Ideal.map_le_iff_le_comap]
      intro b hb
      rw [Ideal.mem_comap, RingHom.mem_ker]
      change a3b3_conormalToConeSym I (algebraMap R _ b) = 0
      rw [AlgHom.commutes, IsScalarTower.algebraMap_apply R (reesAlgebra I)]
      exact Ideal.Quotient.eq_zero_iff_mem.2 (Ideal.mem_map_of_mem _ hb)
    exact hle ha)

/-- The canonical surjection on degree-one classes: `[a] ↦ [a]₁`.
Source: Mathlib, `SymmetricAlgebra.lift_ι_apply` and `Ideal.Cotangent.lift_toCotangent`. -/
theorem a3b3_conormalToCone_ι {R : Type*} [CommRing R] (I : Ideal R) (x : I) :
    a3b3_conormalToCone I (a3b3_conormalι I x) =
      a3b1_coneMonomial R I 1 ⟨x.1, by simp⟩ := by
  change a3b3_conormalToConeSym I (SymmetricAlgebra.ι R I.Cotangent (I.toCotangent x)) = _
  rw [a3b3_conormalToConeSym, SymmetricAlgebra.lift_ι_apply, Ideal.Cotangent.lift_toCotangent]
  rfl

example {R : Type*} [CommRing R] (I : Ideal R) (x : I) :
    a3b3_conormalToCone I (a3b3_conormalι I x) =
      a3b1_coneMonomial R I 1 ⟨x.1, by simp⟩ :=
  a3b3_conormalToCone_ι I x

/-! ## The normal bundle of an ideal sheaf -/

open Scheme.AffineZariskiSite in
/-- The restriction map of sections along a morphism `U ⟶ V` of the small affine Zariski site.
Source: Mathlib, `AlgebraicGeometry.Scheme.AffineZariskiSite` and `TopCat.Presheaf`. -/
abbrev a3b3_restrict {X : Scheme.{u}} {U V : X.AffineZariskiSite} (f : U ⟶ V) :
    Γ(X, V.1) →+* Γ(X, U.1) :=
  (X.presheaf.map (homOfLE (toOpens_mono f.le)).op).hom

example {X : Scheme.{u}} (U : X.AffineZariskiSite) (a : Γ(X, U.1)) :
    a3b3_restrict (𝟙 U) a = a := by
  simp [a3b3_restrict]

open Scheme.AffineZariskiSite in
/-- Restriction carries the ideal of an ideal sheaf into the ideal.
Source: Mathlib, `Scheme.IdealSheafData.ideal_le_comap_ideal`. -/
theorem a3b3_restrict_ideal {X : Scheme.{u}} (I : X.IdealSheafData) {U V : X.AffineZariskiSite}
    (f : U ⟶ V) :
    (I.ideal ⟨V.1, V.2⟩).map (a3b3_restrict f) ≤ I.ideal ⟨U.1, U.2⟩ :=
  Ideal.map_le_iff_le_comap.2
    (I.ideal_le_comap_ideal (U := ⟨U.1, U.2⟩) (V := ⟨V.1, V.2⟩) (toOpens_mono f.le))

/-- Restriction is functorial.
Source: Mathlib, `CategoryTheory.Functor.map_comp`. -/
theorem a3b3_restrict_comp {X : Scheme.{u}} {U V W : X.AffineZariskiSite} (f : V ⟶ U)
    (g : W ⟶ V) : a3b3_restrict (g ≫ f) = (a3b3_restrict g).comp (a3b3_restrict f) := by
  rw [a3b3_restrict, a3b3_restrict, a3b3_restrict, ← CommRingCat.hom_comp, ← Functor.map_comp]
  rfl

/-- The conormal algebras of an ideal sheaf over the small affine Zariski site:
`U ↦ Sym_{Γ(U)/I(U)}(I(U)/I(U)²)`.
Source: Fulton, *Intersection Theory*, second edition, Appendix B.7.1; Mathlib,
`AlgebraicGeometry.Scheme.AffineZariskiSite`. -/
def a3b3_normalDiagram (X : Scheme.{u}) (I : X.IdealSheafData) :
    X.AffineZariskiSiteᵒᵖ ⥤ CommRingCat.{u} where
  obj U := CommRingCat.of (a3b3_conormalAlg (I.ideal ⟨U.unop.1, U.unop.2⟩))
  map {U V} f := CommRingCat.ofHom (a3b3_conormalMap (a3b3_restrict f.unop) _ _
    (a3b3_restrict_ideal I f.unop))
  map_id U := by
    ext1
    exact a3b3_conormalMap_id _ (by simp [a3b3_restrict]) _ _
  map_comp {U V W} f g := by
    ext1
    rw [CommRingCat.hom_comp, CommRingCat.hom_ofHom, CommRingCat.hom_ofHom,
      CommRingCat.hom_ofHom, a3b3_conormalMap_comp _ _ _ _ _ _ _ (by
        rw [← Ideal.map_map]
        exact (Ideal.map_mono (a3b3_restrict_ideal I f.unop)).trans (a3b3_restrict_ideal I g.unop))]
    exact a3b3_conormalMap_congr (a3b3_restrict_comp f.unop g.unop) _ _ _ _

example (X : Scheme.{u}) (I : X.IdealSheafData) (U : X.AffineZariskiSiteᵒᵖ) :
    (a3b3_normalDiagram X I).obj U =
      CommRingCat.of (a3b3_conormalAlg (I.ideal ⟨U.unop.1, U.unop.2⟩)) := rfl

/-- The structure map from the structure sheaf to the conormal algebras.
Source: Fulton, *Intersection Theory*, second edition, Appendix B.7.1. -/
def a3b3_normalDiagramMap (X : Scheme.{u}) (I : X.IdealSheafData) :
    (Scheme.AffineZariskiSite.toOpensFunctor X).op ⋙ X.presheaf ⟶ a3b3_normalDiagram X I where
  app U := CommRingCat.ofHom (algebraMap Γ(X, U.unop.1) _)
  naturality {U V} f := by
    ext1
    refine RingHom.ext fun r => ?_
    exact (a3b3_conormalMap_algebraMap _ _ _ _ r).symm

example (X : Scheme.{u}) (I : X.IdealSheafData) (U : X.AffineZariskiSiteᵒᵖ) :
    (a3b3_normalDiagramMap X I).app U =
      CommRingCat.ofHom
        (algebraMap Γ(X, U.unop.1) (a3b3_conormalAlg (I.ideal ⟨U.unop.1, U.unop.2⟩))) :=
  rfl

/-- The normal bundle `Spec Sym(I/I²)` of an ideal sheaf, glued over the affine opens. The
gluing needs the localization property of the conormal algebras, which is the argument `H`.
Source: Fulton, *Intersection Theory*, second edition, Appendix B.7.1 (the normal bundle
`N_X Y`); Stacks Project, Tag 01LH (relative gluing); Mathlib,
`AlgebraicGeometry.Scheme.AffineZariskiSite.relativeGluingData`. -/
def a3b3_normalBundle (X : Scheme.{u}) (I : X.IdealSheafData)
    (H : (a3b3_normalDiagramMap X I).Coequifibered) : Scheme.{u} :=
  (Scheme.AffineZariskiSite.relativeGluingData H).glued

example (X : Scheme.{u}) (I : X.IdealSheafData) (H : (a3b3_normalDiagramMap X I).Coequifibered) :
    a3b3_normalBundle X I H = (Scheme.AffineZariskiSite.relativeGluingData H).glued := rfl

/-- The projection of the normal bundle to the ambient scheme.
Source: Stacks Project, Tag 01LH; Mathlib, `Scheme.Cover.RelativeGluingData.toBase`. -/
def a3b3_normalBundleProj (X : Scheme.{u}) (I : X.IdealSheafData)
    (H : (a3b3_normalDiagramMap X I).Coequifibered) : a3b3_normalBundle X I H ⟶ X :=
  (Scheme.AffineZariskiSite.relativeGluingData H).toBase

example (X : Scheme.{u}) (I : X.IdealSheafData) (H : (a3b3_normalDiagramMap X I).Coequifibered) :
    a3b3_normalBundle X I H ⟶ X := a3b3_normalBundleProj X I H

/-- The chart of the normal bundle over an affine open.
Source: Stacks Project, Tag 01LH; Mathlib, `Scheme.Cover.RelativeGluingData.cover`. -/
def a3b3_normalChart (X : Scheme.{u}) (I : X.IdealSheafData)
    (H : (a3b3_normalDiagramMap X I).Coequifibered) (U : X.affineOpens) :
    Spec (CommRingCat.of (a3b3_conormalAlg (I.ideal U))) ⟶ a3b3_normalBundle X I H :=
  (Scheme.AffineZariskiSite.relativeGluingData H).cover.f (⟨U.1, U.2⟩ : X.AffineZariskiSite)

example (X : Scheme.{u}) (I : X.IdealSheafData)
    (H : (a3b3_normalDiagramMap X I).Coequifibered) (U : X.affineOpens) :
    Spec (CommRingCat.of (a3b3_conormalAlg (I.ideal U))) ⟶ X :=
  a3b3_normalChart X I H U ≫ a3b3_normalBundleProj X I H

/-! ## The diagonal -/

/-- The ideal sheaf of the diagonal of a scheme over a field, the kernel of the diagonal.
Source: Fulton, *Intersection Theory*, second edition, §6.1 (the diagonal `δ : Y → Y × Y`);
Mathlib, `CategoryTheory.Limits.pullback.diagonal` and `AlgebraicGeometry.Scheme.Hom.ker`. -/
def a3b3_diagonalIdeal {k : Type u} [Field k] {Y : Scheme.{u}}
    (p : Y ⟶ Spec (CommRingCat.of k)) : (pullback p p).IdealSheafData :=
  (pullback.diagonal p).ker

example {k : Type u} [Field k] {Y : Scheme.{u}} (p : Y ⟶ Spec (CommRingCat.of k)) :
    (pullback p p).IdealSheafData := a3b3_diagonalIdeal p

/-! ## The tangent bundle -/

section tangent
open TensorProduct

/-- Two ring maps out of `A ⊗ₖ A` agree when they agree on pure tensors.
Source: Mathlib, `TensorProduct.inductionOn`. -/
theorem a3b3_tensor_ringHom_ext {k A : Type*} [CommRing k] [CommRing A] [Algebra k A] {T : Type*}
    [CommRing T] {g₁ g₂ : A ⊗[k] A →+* T}
    (h : ∀ a b : A, g₁ (a ⊗ₜ[k] b) = g₂ (a ⊗ₜ[k] b)) : g₁ = g₂ := by
  refine RingHom.ext fun x => ?_
  induction x using TensorProduct.inductionOn with
  | tmul a b => exact h a b
  | add x y hx hy => simp only [map_add, hx, hy]

/-- A map of `k`-algebras carries the kernel of the multiplication of `A ⊗ₖ A` into that of
`B ⊗ₖ B`.
Source: Mathlib, `KaehlerDifferential.ideal` and `Algebra.TensorProduct.lmul'_apply_tmul`. -/
theorem a3b3_kaehlerIdeal_map_le {k A B : Type*} [CommRing k] [CommRing A] [CommRing B]
    [Algebra k A] [Algebra k B] (ρ : A →ₐ[k] B) :
    (KaehlerDifferential.ideal k A).map (Algebra.TensorProduct.map ρ ρ).toRingHom ≤
      KaehlerDifferential.ideal k B := by
  rw [Ideal.map_le_iff_le_comap]
  intro x hx
  have key : ∀ y : A ⊗[k] A, Algebra.TensorProduct.lmul' k (Algebra.TensorProduct.map ρ ρ y) =
      ρ (Algebra.TensorProduct.lmul' k y) := by
    intro y
    induction y using TensorProduct.inductionOn with
    | tmul a b => simp
    | add x y hx hy => simp only [map_add, hx, hy]
  change _ ∈ RingHom.ker _
  rw [RingHom.mem_ker]
  erw [key]
  rw [(RingHom.mem_ker).1 hx, map_zero]

/-- Mathlib's module of differentials is, by definition, the conormal module of the kernel of
the multiplication: so `a3b3_conormalAlg (KaehlerDifferential.ideal k A)` is `Sym_A(Ω_{A/k})`.
Source: Mathlib, `KaehlerDifferential`. -/
example {A : Type u} [CommRing A] (k : Type u) [Field k] [Algebra k A] :
    (KaehlerDifferential.ideal k A).Cotangent = Ω[A⁄k] := rfl

section
variable {k : Type u} [Field k]

/-- A morphism over the base point is compatible with the scalars of `a3b2_fieldMap`.
Source: Mathlib, `Scheme.Hom.appLE_comp_appLE`. -/
theorem a3b3_fieldMap_appLE {X Z : Scheme.{u}} (pX : X ⟶ Spec (CommRingCat.of k))
    (pZ : Z ⟶ Spec (CommRingCat.of k)) (f : X ⟶ Z) (h : f ≫ pZ = pX) (U : Z.Opens)
    (V : X.Opens) (e : V ≤ f ⁻¹ᵁ U) :
    (f.appLE U V e).hom.comp (a3b2_fieldMap k Z pZ U) = a3b2_fieldMap k X pX V := by
  subst h
  rw [a3b2_fieldMap, a3b2_fieldMap, ← CommRingCat.hom_comp, Category.assoc]
  congr 2
  exact Scheme.Hom.appLE_comp_appLE _ _ _ _ _ _ _

open Scheme.AffineZariskiSite in
/-- Restriction is compatible with the scalars of `a3b2_fieldMap`.
Source: Mathlib, `Scheme.Hom.appLE_map`. -/
theorem a3b3_fieldMap_restrict {Y : Scheme.{u}} (p : Y ⟶ Spec (CommRingCat.of k))
    {U V : Y.AffineZariskiSite} (f : U ⟶ V) :
    (a3b3_restrict f).comp (a3b2_fieldMap k Y p V.1) = a3b2_fieldMap k Y p U.1 := by
  rw [a3b2_fieldMap, a3b2_fieldMap, a3b3_restrict, ← CommRingCat.hom_comp, Category.assoc]
  congr 2
  exact Scheme.Hom.appLE_map _ _ _
end

/-- The functorial map of Kähler conormal algebras along a map of `k`-algebras: the conormal
algebra map of `ρ ⊗ ρ`.
Source: Mathlib, `Algebra.TensorProduct.map`; Fulton, *Intersection Theory*, second edition,
Appendix B.7.1. -/
def a3b3_kaehlerConormalMap {k A B : Type*} [CommRing k] [CommRing A] [CommRing B]
    [Algebra k A] [Algebra k B] (ρ : A →ₐ[k] B) :
    a3b3_conormalAlg (KaehlerDifferential.ideal k A) →+*
      a3b3_conormalAlg (KaehlerDifferential.ideal k B) :=
  a3b3_conormalMap (Algebra.TensorProduct.map ρ ρ).toRingHom _ _ (a3b3_kaehlerIdeal_map_le ρ)

example {k A : Type*} [CommRing k] [CommRing A] [Algebra k A] (x : KaehlerDifferential.ideal k A) :
    a3b3_kaehlerConormalMap (AlgHom.id k A) (a3b3_conormalι _ x) = a3b3_conormalι _ x := by
  rw [a3b3_kaehlerConormalMap, a3b3_conormalMap_ι]
  congr 1
  exact Subtype.ext (by simp [Algebra.TensorProduct.map_id])

/-- Functoriality of the Kähler conormal algebras: the identity.
Source: Mathlib, `Algebra.TensorProduct.map_id`. -/
theorem a3b3_kaehlerConormalMap_id {k A : Type*} [CommRing k] [CommRing A] [Algebra k A]
    (ρ : A →ₐ[k] A) (hρ : ρ = AlgHom.id k A) : a3b3_kaehlerConormalMap ρ = RingHom.id _ := by
  subst hρ
  exact a3b3_conormalMap_id _ (by simp [Algebra.TensorProduct.map_id]) _ _

/-- Functoriality of the Kähler conormal algebras: composition.
Source: Mathlib, `Algebra.TensorProduct.map_comp`. -/
theorem a3b3_kaehlerConormalMap_comp {k A B C : Type*} [CommRing k] [CommRing A] [CommRing B]
    [CommRing C] [Algebra k A] [Algebra k B] [Algebra k C] (ρ : A →ₐ[k] B) (σ : B →ₐ[k] C)
    (τ : A →ₐ[k] C) (hτ : σ.comp ρ = τ) :
    (a3b3_kaehlerConormalMap σ).comp (a3b3_kaehlerConormalMap ρ) = a3b3_kaehlerConormalMap τ := by
  subst hτ
  rw [a3b3_kaehlerConormalMap, a3b3_kaehlerConormalMap, a3b3_conormalMap_comp _ _ _ _ _ _ _ (by
    rw [← Ideal.map_map]
    exact (Ideal.map_mono (a3b3_kaehlerIdeal_map_le _)).trans (a3b3_kaehlerIdeal_map_le _))]
  exact a3b3_conormalMap_congr (by rw [Algebra.TensorProduct.map_comp]; rfl) _ _ _ _

variable {k : Type u} [Field k]

open Scheme.AffineZariskiSite in
/-- The restriction map between affine opens, as a map of `k`-algebras for the scalars of
`a3b2_fieldMap`. -/
private def a3b3_restrictAlgHom {Y : Scheme.{u}} (p : Y ⟶ Spec (CommRingCat.of k))
    {U V : Y.AffineZariskiSite} (f : U ⟶ V) :
    letI := (a3b2_fieldMap k Y p V.1).toAlgebra
    letI := (a3b2_fieldMap k Y p U.1).toAlgebra
    Γ(Y, V.1) →ₐ[k] Γ(Y, U.1) :=
  letI := (a3b2_fieldMap k Y p V.1).toAlgebra
  letI := (a3b2_fieldMap k Y p U.1).toAlgebra
  { a3b3_restrict f with commutes' := RingHom.congr_fun (a3b3_fieldMap_restrict p f) }

open Scheme.AffineZariskiSite in
private theorem a3b3_restrictAlgHom_id {Y : Scheme.{u}} (p : Y ⟶ Spec (CommRingCat.of k))
    (U : Y.AffineZariskiSite) :
    letI := (a3b2_fieldMap k Y p U.1).toAlgebra
    a3b3_restrictAlgHom p (𝟙 U) = AlgHom.id k _ := by
  let := (a3b2_fieldMap k Y p U.1).toAlgebra
  ext a
  change a3b3_restrict (𝟙 U) a = a
  simp [a3b3_restrict]

open Scheme.AffineZariskiSite in
private theorem a3b3_restrictAlgHom_comp {Y : Scheme.{u}} (p : Y ⟶ Spec (CommRingCat.of k))
    {U V W : Y.AffineZariskiSite} (f : V ⟶ U) (g : W ⟶ V) :
    letI := (a3b2_fieldMap k Y p U.1).toAlgebra
    letI := (a3b2_fieldMap k Y p V.1).toAlgebra
    letI := (a3b2_fieldMap k Y p W.1).toAlgebra
    (a3b3_restrictAlgHom p g).comp (a3b3_restrictAlgHom p f) = a3b3_restrictAlgHom p (g ≫ f) := by
  let := (a3b2_fieldMap k Y p U.1).toAlgebra
  let := (a3b2_fieldMap k Y p V.1).toAlgebra
  let := (a3b2_fieldMap k Y p W.1).toAlgebra
  ext a
  change a3b3_restrict g (a3b3_restrict f a) = a3b3_restrict (g ≫ f) a
  rw [a3b3_restrict_comp f g]
  rfl

/-- The Kähler conormal algebras of a scheme over a field over the small affine Zariski site:
`U ↦ Sym_{A⊗A}(I/I²)/I` with `A = Γ(Y, U)` and `I` the kernel of `A ⊗ₖ A → A`, which is
`Sym_A(Ω_{A/k})` since Mathlib defines `Ω[A⁄k]` as `I/I²`.
Source: Hartshorne, *Algebraic Geometry*, II, §8 (the sheaf of differentials, glued from
`Ω_{A/k}` over affine opens) and Exercise II.5.18 (the geometric vector bundle `Spec Sym`);
Mathlib, `KaehlerDifferential.ideal` and `KaehlerDifferential`. -/
def a3b3_tangentDiagram {Y : Scheme.{u}}
    (p : Y ⟶ Spec (CommRingCat.of k)) : Y.AffineZariskiSiteᵒᵖ ⥤ CommRingCat.{u} where
  obj U := letI := (a3b2_fieldMap k Y p U.unop.1).toAlgebra
    CommRingCat.of (a3b3_conormalAlg (KaehlerDifferential.ideal k Γ(Y, U.unop.1)))
  map {U V} f := letI := (a3b2_fieldMap k Y p U.unop.1).toAlgebra
    letI := (a3b2_fieldMap k Y p V.unop.1).toAlgebra
    CommRingCat.ofHom (a3b3_kaehlerConormalMap (a3b3_restrictAlgHom p f.unop))
  map_id U := by
    let := (a3b2_fieldMap k Y p U.unop.1).toAlgebra
    ext1
    exact a3b3_kaehlerConormalMap_id _ (a3b3_restrictAlgHom_id p U.unop)
  map_comp {U V W} f g := by
    let := (a3b2_fieldMap k Y p U.unop.1).toAlgebra
    let := (a3b2_fieldMap k Y p V.unop.1).toAlgebra
    let := (a3b2_fieldMap k Y p W.unop.1).toAlgebra
    ext1
    change a3b3_kaehlerConormalMap (a3b3_restrictAlgHom p (g.unop ≫ f.unop)) =
      (a3b3_kaehlerConormalMap (a3b3_restrictAlgHom p g.unop)).comp
        (a3b3_kaehlerConormalMap (a3b3_restrictAlgHom p f.unop))
    exact (a3b3_kaehlerConormalMap_comp _ _ _ (a3b3_restrictAlgHom_comp p f.unop g.unop)).symm

example {Y : Scheme.{u}} (p : Y ⟶ Spec (CommRingCat.of k)) (U : Y.AffineZariskiSiteᵒᵖ) :
    (a3b3_tangentDiagram p).obj U = (letI := (a3b2_fieldMap k Y p U.unop.1).toAlgebra
      CommRingCat.of (a3b3_conormalAlg (KaehlerDifferential.ideal k Γ(Y, U.unop.1)))) := rfl

/-- The structure map from the structure sheaf to the Kähler conormal algebras, through the left
factor of `A ⊗ₖ A`.
Source: Hartshorne, *Algebraic Geometry*, II, §8 and Exercise II.5.18. -/
def a3b3_tangentDiagramMap {Y : Scheme.{u}}
    (p : Y ⟶ Spec (CommRingCat.of k)) :
    (Scheme.AffineZariskiSite.toOpensFunctor Y).op ⋙ Y.presheaf ⟶ a3b3_tangentDiagram p where
  app U := letI := (a3b2_fieldMap k Y p U.unop.1).toAlgebra
    CommRingCat.ofHom ((algebraMap (Γ(Y, U.unop.1) ⊗[k] Γ(Y, U.unop.1))
      (a3b3_conormalAlg (KaehlerDifferential.ideal k Γ(Y, U.unop.1)))).comp
        (Algebra.TensorProduct.includeLeftRingHom (R := k) (A := Γ(Y, U.unop.1))
          (B := Γ(Y, U.unop.1))))
  naturality {U V} f := by
    let := (a3b2_fieldMap k Y p U.unop.1).toAlgebra
    let := (a3b2_fieldMap k Y p V.unop.1).toAlgebra
    ext1
    refine RingHom.ext fun r => ?_
    change algebraMap (Γ(Y, V.unop.1) ⊗[k] Γ(Y, V.unop.1))
        (a3b3_conormalAlg (KaehlerDifferential.ideal k Γ(Y, V.unop.1)))
        (a3b3_restrict f.unop r ⊗ₜ[k] 1) =
      a3b3_kaehlerConormalMap (a3b3_restrictAlgHom p f.unop)
        (algebraMap (Γ(Y, U.unop.1) ⊗[k] Γ(Y, U.unop.1))
          (a3b3_conormalAlg (KaehlerDifferential.ideal k Γ(Y, U.unop.1))) (r ⊗ₜ[k] 1))
    rw [a3b3_kaehlerConormalMap, a3b3_conormalMap_algebraMap]
    congr 1
    erw [Algebra.TensorProduct.map_tmul, map_one]
    rfl

example {Y : Scheme.{u}} (p : Y ⟶ Spec (CommRingCat.of k)) :
    (Scheme.AffineZariskiSite.toOpensFunctor Y).op ⋙ Y.presheaf ⟶ a3b3_tangentDiagram p :=
  a3b3_tangentDiagramMap p

/-- The tangent bundle `Spec Sym(Ω_{Y/k})` of a scheme over a field, glued over the affine opens.
The gluing needs the localization property of the Kähler conormal algebras, the argument `H`.
Source: Hartshorne, *Algebraic Geometry*, II, §8 and Exercise II.5.18; Stacks Project, Tag 01LH
(relative gluing); Mathlib, `AlgebraicGeometry.Scheme.AffineZariskiSite.relativeGluingData`. -/
def a3b3_tangentBundle {Y : Scheme.{u}}
    (p : Y ⟶ Spec (CommRingCat.of k)) (H : (a3b3_tangentDiagramMap p).Coequifibered) :
    Scheme.{u} :=
  (Scheme.AffineZariskiSite.relativeGluingData H).glued

example {Y : Scheme.{u}} (p : Y ⟶ Spec (CommRingCat.of k))
    (H : (a3b3_tangentDiagramMap p).Coequifibered) :
    a3b3_tangentBundle p H = (Scheme.AffineZariskiSite.relativeGluingData H).glued := rfl

/-- The projection of the tangent bundle to the scheme.
Source: Stacks Project, Tag 01LH; Mathlib, `Scheme.Cover.RelativeGluingData.toBase`. -/
def a3b3_tangentBundleProj {Y : Scheme.{u}}
    (p : Y ⟶ Spec (CommRingCat.of k)) (H : (a3b3_tangentDiagramMap p).Coequifibered) :
    a3b3_tangentBundle p H ⟶ Y :=
  (Scheme.AffineZariskiSite.relativeGluingData H).toBase

example {Y : Scheme.{u}} (p : Y ⟶ Spec (CommRingCat.of k))
    (H : (a3b3_tangentDiagramMap p).Coequifibered) : a3b3_tangentBundle p H ⟶ Y :=
  a3b3_tangentBundleProj p H

/-- The chart of the tangent bundle over an affine open.
Source: Stacks Project, Tag 01LH; Mathlib, `Scheme.Cover.RelativeGluingData.cover`. -/
def a3b3_tangentChart {Y : Scheme.{u}}
    (p : Y ⟶ Spec (CommRingCat.of k)) (H : (a3b3_tangentDiagramMap p).Coequifibered)
    (U : Y.affineOpens) :
    letI := (a3b2_fieldMap k Y p U.1).toAlgebra
    Spec (CommRingCat.of (a3b3_conormalAlg (KaehlerDifferential.ideal k Γ(Y, U.1)))) ⟶
      a3b3_tangentBundle p H :=
  (Scheme.AffineZariskiSite.relativeGluingData H).cover.f (⟨U.1, U.2⟩ : Y.AffineZariskiSite)

example {Y : Scheme.{u}} (p : Y ⟶ Spec (CommRingCat.of k))
    (H : (a3b3_tangentDiagramMap p).Coequifibered) (U : Y.affineOpens) :
    letI := (a3b2_fieldMap k Y p U.1).toAlgebra
    Spec (CommRingCat.of (a3b3_conormalAlg (KaehlerDifferential.ideal k Γ(Y, U.1)))) ⟶ Y :=
  a3b3_tangentChart p H U ≫ a3b3_tangentBundleProj p H

/-- `appLE` along equal morphisms.
Source: Lean core, `Eq.subst`. -/
theorem a3b3_appLE_congr_hom {X Z : Scheme.{u}} {f g : X ⟶ Z} (h : f = g) (U : Z.Opens)
    (V : X.Opens) (e : V ≤ f ⁻¹ᵁ U) (e' : V ≤ g ⁻¹ᵁ U) : f.appLE U V e = g.appLE U V e' := by
  subst h; rfl

/-- The projection `Y ×ₖ Y ⟶ Y` onto a factor, on sections over an affine open `W` inside
`pr⁻¹ U`, as a map of `k`-algebras. -/
private def a3b3_projAlgHom {Y : Scheme.{u}} (p : Y ⟶ Spec (CommRingCat.of k))
    (q : (pullback p p : Scheme.{u}) ⟶ Y) (hq : q ≫ p = pullback.fst p p ≫ p) (U : Y.Opens)
    (W : (pullback p p : Scheme.{u}).Opens) (hW : W ≤ q ⁻¹ᵁ U) :
    letI := (a3b2_fieldMap k Y p U).toAlgebra
    letI := (a3b2_fieldMap k (pullback p p) (pullback.fst p p ≫ p) W).toAlgebra
    Γ(Y, U) →ₐ[k] Γ((pullback p p : Scheme.{u}), W) :=
  letI := (a3b2_fieldMap k Y p U).toAlgebra
  letI := (a3b2_fieldMap k (pullback p p) (pullback.fst p p ≫ p) W).toAlgebra
  { (q.appLE U W hW).hom with
    commutes' := RingHom.congr_fun (a3b3_fieldMap_appLE _ _ q hq U W hW) }

/-- The comparison map `Γ(Y, U) ⊗ₖ Γ(Y, U) → Γ(Y ×ₖ Y, W)` for an affine open `U` of `Y` and
`W = pr₁⁻¹ U ∩ pr₂⁻¹ U`, `a ⊗ b ↦ pr₁* a · pr₂* b`. It is an isomorphism (`W ≅ U ×ₖ U`) and
carries the kernel of the multiplication onto the diagonal ideal.
Source: Hartshorne, *Algebraic Geometry*, II, Theorem 3.3 and its proof (the fibre product of
affine schemes is `Spec` of the tensor product) and §8 (`Ω` as `I/I²` for the diagonal);
Mathlib, `Algebra.TensorProduct.lift`. -/
def a3b3_tangentToProduct {Y : Scheme.{u}} (p : Y ⟶ Spec (CommRingCat.of k)) (U : Y.Opens)
    (W : (pullback p p : Scheme.{u}).Opens)
    (hW : W = pullback.fst p p ⁻¹ᵁ U ⊓ pullback.snd p p ⁻¹ᵁ U) :
    letI := (a3b2_fieldMap k Y p U).toAlgebra
    Γ(Y, U) ⊗[k] Γ(Y, U) →+* Γ((pullback p p : Scheme.{u}), W) :=
  letI := (a3b2_fieldMap k Y p U).toAlgebra
  letI := (a3b2_fieldMap k (pullback p p) (pullback.fst p p ≫ p) W).toAlgebra
  (Algebra.TensorProduct.lift
    (a3b3_projAlgHom p (pullback.fst p p) rfl U W (hW ▸ inf_le_left))
    (a3b3_projAlgHom p (pullback.snd p p) pullback.condition.symm U W (hW ▸ inf_le_right))
    (fun _ _ => Commute.all _ _)).toRingHom

example {Y : Scheme.{u}} (p : Y ⟶ Spec (CommRingCat.of k)) (U : Y.Opens)
    (W : (pullback p p : Scheme.{u}).Opens)
    (hW : W = pullback.fst p p ⁻¹ᵁ U ⊓ pullback.snd p p ⁻¹ᵁ U) :
    a3b3_tangentToProduct p U W hW 1 = 1 := map_one _

/-- The comparison map on pure tensors.
Source: Mathlib, `Algebra.TensorProduct.lift_tmul`. -/
theorem a3b3_tangentToProduct_tmul {Y : Scheme.{u}} (p : Y ⟶ Spec (CommRingCat.of k))
    (U : Y.Opens) (W : (pullback p p : Scheme.{u}).Opens)
    (hW : W = pullback.fst p p ⁻¹ᵁ U ⊓ pullback.snd p p ⁻¹ᵁ U) (a b : Γ(Y, U)) :
    letI := (a3b2_fieldMap k Y p U).toAlgebra
    a3b3_tangentToProduct p U W hW (a ⊗ₜ[k] b) =
      (pullback.fst p p).appLE U W (hW ▸ inf_le_left) a *
        (pullback.snd p p).appLE U W (hW ▸ inf_le_right) b :=
  rfl

/-- The comparison map carries the kernel of `Γ(U) ⊗ₖ Γ(U) → Γ(U)` into the diagonal ideal over
`W = pr₁⁻¹ U ∩ pr₂⁻¹ U`: the generators `1 ⊗ s - s ⊗ 1` go to sections that vanish on the
diagonal, since both projections restrict to the identity there.
Source: Mathlib, `KaehlerDifferential.span_range_eq_ideal`, `pullback.diagonal_fst`,
`pullback.diagonal_snd` and `Scheme.Hom.ker_apply`. -/
theorem a3b3_tangentToProduct_map_le {Y : Scheme.{u}} (p : Y ⟶ Spec (CommRingCat.of k))
    [IsSeparated p] (U : Y.Opens) (W : (pullback p p : Scheme.{u}).affineOpens)
    (hW : W.1 = pullback.fst p p ⁻¹ᵁ U ⊓ pullback.snd p p ⁻¹ᵁ U) :
    letI := (a3b2_fieldMap k Y p U).toAlgebra
    (KaehlerDifferential.ideal k Γ(Y, U)).map (a3b3_tangentToProduct p U W.1 hW) ≤
      (a3b3_diagonalIdeal p).ideal W := by
  let := (a3b2_fieldMap k Y p U).toAlgebra
  rw [← KaehlerDifferential.span_range_eq_ideal, Ideal.map_span, Ideal.span_le]
  rintro _ ⟨_, ⟨s, rfl⟩, rfl⟩
  rw [a3b3_diagonalIdeal, Scheme.Hom.ker_apply, SetLike.mem_coe, RingHom.mem_ker, map_sub,
    a3b3_tangentToProduct_tmul, a3b3_tangentToProduct_tmul, map_one, map_one, one_mul, mul_one,
    map_sub, sub_eq_zero, ← CommRingCat.comp_apply, ← CommRingCat.comp_apply,
    Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_comp_appLE, Scheme.Hom.appLE_comp_appLE]
  congr 2
  exact a3b3_appLE_congr_hom ((pullback.diagonal_snd p).trans (pullback.diagonal_fst p).symm)
    _ _ _ _

end tangent

/-- The product of a scheme of finite type over a field with itself is Noetherian when the scheme
is.
Source: Mathlib, `LocallyOfFiniteType.isLocallyNoetherian` and `quasiCompact_iff_compactSpace`;
Hartshorne, *Algebraic Geometry*, II, Exercise 3.13. -/
instance a3b3_pullback_isNoetherian {k : Type u} [Field k] {Y : Scheme.{u}}
    (p : Y ⟶ Spec (CommRingCat.of k)) [LocallyOfFiniteType p] [IsNoetherian Y] :
    IsNoetherian (pullback p p) := by
  have : IsLocallyNoetherian ((pullback p p : Scheme.{u})) :=
    LocallyOfFiniteType.isLocallyNoetherian (pullback.fst p p)
  have : QuasiCompact p := (quasiCompact_iff_compactSpace p).2 inferInstance
  have : CompactSpace ((pullback p p : Scheme.{u})) :=
    (quasiCompact_iff_compactSpace (pullback.fst p p)).1 inferInstance
  exact { toIsLocallyNoetherian := inferInstance, toCompactSpace := inferInstance }

/-- The product `V ×ₖ W` of the reduced subvarieties `V = closure {u}` and `W = closure {v}`, as a
closed subscheme of `Y ×ₖ Y`: the sum of the scheme-theoretic inverse images of the two ideals
under the projections.
Source: Fulton, *Intersection Theory*, second edition, §6.1 (`V × W ⊂ Y × Y` and
`V ∩ W = δ⁻¹(V × W)`); Serre, *Algèbre locale, multiplicités*, Chapitre V, B.3. -/
def a3b3_productIdeal {k : Type u} [Field k] {Y : Scheme.{u}}
    (p : Y ⟶ Spec (CommRingCat.of k)) (u v : Y) : (pullback p p).IdealSheafData :=
  (ccm3_primeIdeal Y u).comap (pullback.fst p p) ⊔ (ccm3_primeIdeal Y v).comap (pullback.snd p p)

example {k : Type u} [Field k] {Y : Scheme.{u}} (p : Y ⟶ Spec (CommRingCat.of k)) (u v : Y) :
    (ccm3_primeIdeal Y u).comap (pullback.fst p p) ≤ a3b3_productIdeal p u v := le_sup_left

/-- The stalk at a point of an ideal sheaf: the ideal of the local ring generated by the images
of its sections over the affine opens containing the point.
Source: Hartshorne, *Algebraic Geometry*, II, Proposition 5.9 and Exercise 3.11 (stalks of a
quasi-coherent ideal sheaf); Mathlib, `TopCat.Presheaf.germ`. -/
def a3b3_stalkIdeal {X : Scheme.{u}} (K : X.IdealSheafData) (x : X) :
    Ideal (X.presheaf.stalk x) :=
  ⨆ (U : X.affineOpens) (hU : x ∈ U.1), (K.ideal U).map (X.presheaf.germ U.1 x hU).hom

example {X : Scheme.{u}} (x : X) : a3b3_stalkIdeal (⊥ : X.IdealSheafData) x = ⊥ := by
  simp [a3b3_stalkIdeal, Scheme.IdealSheafData.ideal_bot]

/-- The local ring of `Y ×ₖ Y` at the diagonal point `δ(z)`.
Source: Serre, *Algèbre locale, multiplicités*, Chapitre V, B.3 (the local ring of `Y × Y` along
the diagonal). -/
abbrev a3b3_diagonalStalk {k : Type u} [Field k] {Y : Scheme.{u}}
    (p : Y ⟶ Spec (CommRingCat.of k)) (z : Y) : CommRingCat.{u} :=
  (pullback p p : Scheme.{u}).presheaf.stalk (pullback.diagonal p z)

example {k : Type u} [Field k] {Y : Scheme.{u}} (p : Y ⟶ Spec (CommRingCat.of k)) (z : Y) :
    CommRingCat.{u} := a3b3_diagonalStalk p z

/-- The local ring of `closure {u} ×ₖ closure {v}` at `δ(z)`, as a module over the local ring of
`Y ×ₖ Y` there.
Source: Serre, *Algèbre locale, multiplicités*, Chapitre V, B.3 (the module `M ⊗_k N`). -/
abbrev a3b3_productStalkQuot {k : Type u} [Field k] {Y : Scheme.{u}}
    (p : Y ⟶ Spec (CommRingCat.of k)) (u v z : Y) : ModuleCat.{u} (a3b3_diagonalStalk p z) :=
  ModuleCat.of _ (a3b3_diagonalStalk p z ⧸
    a3b3_stalkIdeal (a3b3_productIdeal p u v) (pullback.diagonal p z))

example {k : Type u} [Field k] {Y : Scheme.{u}} (p : Y ⟶ Spec (CommRingCat.of k)) (u v z : Y) :
    ModuleCat.{u} (a3b3_diagonalStalk p z) := a3b3_productStalkQuot p u v z

/-- The local ring of the diagonal at `δ(z)`, as a module over the local ring of `Y ×ₖ Y` there.
Source: Serre, *Algèbre locale, multiplicités*, Chapitre V, B.3 (the module `S_Δ`). -/
abbrev a3b3_diagonalStalkQuot {k : Type u} [Field k] {Y : Scheme.{u}}
    (p : Y ⟶ Spec (CommRingCat.of k)) (z : Y) : ModuleCat.{u} (a3b3_diagonalStalk p z) :=
  ModuleCat.of _ (a3b3_diagonalStalk p z ⧸
    a3b3_stalkIdeal (a3b3_diagonalIdeal p) (pullback.diagonal p z))

example {k : Type u} [Field k] {Y : Scheme.{u}} (p : Y ⟶ Spec (CommRingCat.of k)) (z : Y) :
    ModuleCat.{u} (a3b3_diagonalStalk p z) := a3b3_diagonalStalkQuot p z

/-- The fundamental cycle of the scheme-theoretic image of a morphism to a Noetherian scheme:
each irreducible component of the image carries the exact length of its local ring at the generic
point. It is the stage A3-B2 cycle `a3b2_idealCycle` of the kernel ideal; the finiteness
arguments are the proved Noetherian lemmas.
Source: Fulton, *Intersection Theory*, second edition, §1.5, the cycle `[Z]`; Mathlib,
`AlgebraicGeometry.Scheme.Hom.ker`. -/
def a3b3_imageCycle {Z N : Scheme.{u}} (g : Z ⟶ N) (hN : IsNoetherian N) : AlgebraicCycle N ℚ :=
  a3b2_idealCycle g.ker (a3b2_components_finite_of_isNoetherian _)
    (a3b2_length_ne_top_of_isLocallyNoetherian _)

example {Z N : Scheme.{u}} (g : Z ⟶ N) (hN : IsNoetherian N) :
    a3b3_imageCycle g hN = a3b2_idealCycle g.ker (a3b2_components_finite_of_isNoetherian _)
      (a3b2_length_ne_top_of_isLocallyNoetherian _) := rfl

/-- The full-preimage coefficient of a cycle `c` on a scheme `N` over `X` at a point `x` of `X`:
the coefficient of `c` at the generic point of the full set-theoretic preimage
`π⁻¹ (closure {x})`, and zero when that preimage has no generic point. This selects a coefficient;
it does not construct an intersection with a zero section. It is meaningful for a cycle that is a
sum of whole restrictions `π⁻¹ Z` of a bundle, and at points off the zero section it may pick up
the coefficient of a component lying over a smaller set. Its relation to the zero-section Gysin
pullback is the frozen statement `a3b3_coneCycle_zeroSectionGysin`.
Source: Fulton, *Intersection Theory*, second edition, §1.5 (the coefficient of a cycle at a
subvariety); Mathlib, `IsGenericPoint`. -/
def a3b3_fullPreimageCoeff {N X : Scheme.{u}} (π : N ⟶ X) (c : AlgebraicCycle N ℚ) (x : X) :
    ℚ := by
  classical
  exact if h : ∃ η : N, closure {η} = π ⁻¹' closure {x} then c h.choose else 0

example {N X : Scheme.{u}} (π : N ⟶ X) (x : X) : a3b3_fullPreimageCoeff π 0 x = 0 := by
  unfold a3b3_fullPreimageCoeff
  split_ifs <;> rfl

/-- The full-preimage coefficient at `x` is the coefficient of the cycle at any generic point of
the preimage of `closure {x}`; generic points are unique in a scheme.
Source: Mathlib, `inseparable_iff_closure_eq` and `Inseparable.eq`. -/
theorem a3b3_fullPreimageCoeff_eq {N X : Scheme.{u}} (π : N ⟶ X) (c : AlgebraicCycle N ℚ)
    (x : X) (η : N) (hη : closure {η} = π ⁻¹' closure {x}) :
    a3b3_fullPreimageCoeff π c x = c η := by
  have hex : ∃ η' : N, closure {η'} = π ⁻¹' closure {x} := ⟨η, hη⟩
  unfold a3b3_fullPreimageCoeff
  rw [dite_eq_left_of_eq_true (eq_true hex)]
  congr 1
  exact (inseparable_iff_closure_eq.2 (hex.choose_spec.trans hη.symm)).eq

/-! ## Vector bundles and the zero-section Gysin relation -/

/-- `q : E ⟶ S` is a vector bundle of rank `r` (a geometric vector bundle): affine opens `U i`
cover `S`, and on each `q⁻¹ (U i)` there are `r` coordinate functions `t i` such that the induced
morphism `q⁻¹ (U i) ⟶ 𝔸^r_{U i} = Spec Γ(S, U i)[x₁, …, x_r]`, `xₘ ↦ t i m`, is an isomorphism
(it lies over `U i` by construction, the scalars acting through `q`); on every overlap
`U i ∩ U j` the coordinates of the chart `j` are linear combinations of those of the chart `i`
with coefficients in `Γ(S, U i ∩ U j)`, so the transition functions are linear.
Source: Hartshorne, *Algebraic Geometry*, II, Exercise 5.18 (geometric vector bundles of rank
`n`, with linear transition automorphisms of `A[x₁, …, xₙ]`); Fulton, *Intersection Theory*,
second edition, Appendix B.3; Mathlib, `AlgebraicGeometry.Scheme.Opens.toSpecΓ`. -/
def a3b3_IsVectorBundle {E S : Scheme.{u}} (q : E ⟶ S) (r : ℕ) : Prop :=
  ∃ (ι : Type u) (U : ι → S.affineOpens) (t : ∀ i, Fin r → Γ(E, q ⁻¹ᵁ (U i).1)),
    (∀ s : S, ∃ i, s ∈ (U i).1) ∧
    (∀ i, IsIso ((q ⁻¹ᵁ (U i).1).toSpecΓ ≫
      Spec.map (CommRingCat.ofHom (MvPolynomial.eval₂Hom (q.app (U i).1).hom (t i))))) ∧
    ∀ i j, ∃ a : Fin r → Fin r → Γ(S, (U i).1 ⊓ (U j).1), ∀ m : Fin r,
      E.presheaf.map (homOfLE (q.preimage_mono inf_le_right)).op (t j m) =
        ∑ l : Fin r, q.app ((U i).1 ⊓ (U j).1) (a m l) *
          E.presheaf.map (homOfLE (q.preimage_mono inf_le_left)).op (t i l)

example {E S : Scheme.{u}} (q : E ⟶ S) (r : ℕ) (h : a3b3_IsVectorBundle q r) (s : S) :
    ∃ U : S.affineOpens, s ∈ U.1 := by
  obtain ⟨ι, U, t, hU, -, -⟩ := h
  obtain ⟨i, hi⟩ := hU s
  exact ⟨U i, hi⟩

/-- `γ` represents the zero-section Gysin pullback `0^! [c]` of the cycle `c` on a vector bundle
`q : E ⟶ S` of rank `r` (in this stage `E` is the normal bundle of the diagonal and `S = Y`, the
diagonal): `q` is a rank-`r` vector bundle in the sense of `a3b3_IsVectorBundle` and flat, `γ` is a
`d`-cycle on `S`, `c` is a `(d + r)`-cycle on `E`, and the flat pullback `q* γ`, which is then a
`(d + r)`-cycle (`q` is flat of relative dimension `r`), is rationally equivalent to `c` in
dimension `d + r`. Fulton defines `0^! = (q*)⁻¹ : A_{d+r} E → A_d S`, flat pullback along a vector
bundle being an isomorphism on Chow groups; so the relation says that the class of `γ` is
`0^! [c]`. Flatness and the rank are conjuncts, not assumptions on `q`.
Source: Fulton, *Intersection Theory*, second edition, §1.7 (flat pullback), Theorem 3.3(a) and
the definition of `0^!` in §3.3, and §6.1 (`X · V = 0^! [C]`). -/
def a3b3_IsZeroSectionGysin {E S : Scheme.{u}} (q : E ⟶ S) (hE : IsLocallyNoetherian E)
    (d r : ℕ) (c : AlgebraicCycle E ℚ) (γ : AlgebraicCycle S ℚ) : Prop :=
  a3b3_IsVectorBundle q r ∧ Flat q ∧ γ ∈ a2_dimCycles S ℚ d ∧ c ∈ a2_dimCycles E ℚ (d + r) ∧
    @a2_RatEquiv E hE ℚ _ (d + r) c (ccm3_flatPullback q γ)

example {E S : Scheme.{u}} (q : E ⟶ S) (hE : IsLocallyNoetherian E) (d r : ℕ)
    (hq : a3b3_IsVectorBundle q r) [Flat q] :
    a3b3_IsZeroSectionGysin q hE d r 0 0 := by
  refine ⟨hq, inferInstance, (a2_dimCycles S ℚ d).zero_mem,
    (a2_dimCycles E ℚ (d + r)).zero_mem, ?_⟩
  have : ccm3_flatPullback q (0 : AlgebraicCycle S ℚ) = 0 := by
    unfold ccm3_flatPullback
    convert finsum_zero with x
    ext y
    simp
  rw [a2_RatEquiv, this, sub_zero]
  exact (@a2_ratEquivDim E hE ℚ _ (d + r)).zero_mem

/-! ## A non-degenerate instance -/

/-- On the spectrum of a field, Serre's multiplicity of the point with itself at the point is `1`:
the only term is the length of `κ ⊗ κ = κ`. This is the satisfiable instance of the coefficient
statements below with a nonzero coefficient.
Source: Serre, *Algèbre locale, multiplicités*, Chapitre V (`χ(k, k) = 1` over a field); Mathlib,
`Module.length_eq_one_iff`. -/
theorem a3b3_serreMult_point (k : Type u) [Field k] (x : Spec (CommRingCat.of k)) :
    a3i_serreMult (Spec (CommRingCat.of k)) x x x = 1 := by
  have hsub : Subsingleton (Spec (CommRingCat.of k)) :=
    inferInstanceAs (Subsingleton (PrimeSpectrum k))
  have hco : Order.coheight x = 0 :=
    Order.coheight_eq_zero.2 fun y _ => (Subsingleton.elim y x).le
  have : Ring.KrullDimLE 0 ((Spec (CommRingCat.of k)).presheaf.stalk x) :=
    krullDimLE_of_coheight_le hco.le
  set O := (Spec (CommRingCat.of k)).presheaf.stalk x
  have hmax : (a3i_stalkIdeal (Spec (CommRingCat.of k)) x x).IsMaximal := by
    have hex : ∃ q : Spec O, (Spec (CommRingCat.of k)).fromSpecStalk x q = x :=
      ⟨_, Scheme.fromSpecStalk_closedPoint⟩
    unfold a3i_stalkIdeal
    rw [dite_eq_left_of_eq_true (eq_true hex)]
    exact Ideal.IsPrime.isMaximal' (Classical.choose hex).isPrime
  set 𝔭 := a3i_stalkIdeal (Spec (CommRingCat.of k)) x x
  have hsimple : IsSimpleModule O (O ⧸ 𝔭) :=
    isSimpleModule_iff_quot_maximal.2 ⟨𝔭, hmax, ⟨LinearEquiv.refl _ _⟩⟩
  have hbot : (𝔭 • ⊤ : Submodule O (O ⧸ 𝔭)) = ⊥ := by
    refine le_bot_iff.1 (Submodule.smul_le.2 fun r hr m _ => ?_)
    obtain ⟨m, rfl⟩ := Ideal.Quotient.mk_surjective m
    rw [Submodule.mem_bot, Algebra.smul_def, Ideal.Quotient.algebraMap_eq, ← map_mul,
      Ideal.Quotient.eq_zero_iff_mem]
    exact 𝔭.mul_mem_right _ hr
  have hlen : Module.length O (a3i_torModule (Spec (CommRingCat.of k)) x x x 0) = 1 := by
    unfold a3i_torModule
    rw [(a3l_tor0Iso _ _).toLinearEquiv.length_eq]
    change Module.length O (TensorProduct O (O ⧸ 𝔭) (O ⧸ 𝔭)) = 1
    rw [(TensorProduct.quotTensorEquivQuotSMul (O ⧸ 𝔭) 𝔭).length_eq,
      (Submodule.quotEquivOfEqBot _ hbot).length_eq]
    exact Module.length_eq_one _ _
  simp only [a3i_serreMult, hco]
  simp only [ENat.toNat_zero, zero_add, Finset.range_one, Finset.sum_singleton, pow_zero,
    one_mul]
  rw [show Module.length ((Spec (CommRingCat.of k)).presheaf.stalk x)
    (a3i_torModule (Spec (CommRingCat.of k)) x x x 0) = 1 from hlen]
  rfl

end HodgeLean.Adapters
