import HodgeLean.Adapters.NormalConeB3Etale
import HodgeLean.Adapters.NormalConeB3Product

/-! # Diagonal cone coefficient: the diagonal is locally a regular embedding

For a smooth separated scheme `Y` over a field, every point of `Y ×ₖ Y` has an affine neighbourhood
on which the diagonal ideal is the unit ideal (off the closed diagonal) or is generated by a regular
sequence: near a diagonal point take an affine `V` étale over `k[x₁, …, xₙ]`, identify
`pr₁⁻¹ V ∩ pr₂⁻¹ V` with `Spec (Γ(V) ⊗ₖ Γ(V))` and use the sequence `xᵢ ⊗ 1 - 1 ⊗ xᵢ` after
inverting an element equal to `1` on the diagonal.
-/

noncomputable section
namespace HodgeLean.Adapters
open CategoryTheory Limits AlgebraicGeometry TensorProduct RingTheory.Sequence
universe u

section diag
variable {k : Type u} [Field k] {Y : Scheme.{u}} (p : Y ⟶ Spec (CommRingCat.of k))

/-- A smooth scheme over a field has, around every point, an affine open whose ring of sections is
étale over a polynomial ring over `k`, compatibly with the scalars.
Source: Mathlib, `Smooth.exists_isStandardSmooth` and
`RingHom.IsStandardSmooth.exists_etale_mvPolynomial`. -/
theorem a3b3_exists_etale_chart [Smooth p] (y : Y) :
    ∃ (V : Y.Opens) (_ : IsAffineOpen V) (_ : y ∈ V) (n : ℕ)
      (g : MvPolynomial (Fin n) k →+* Γ(Y, V)),
      g.comp MvPolynomial.C = a3b2_fieldMap k Y p V ∧ g.Etale := by
  obtain ⟨U, hU, V, hV, hyV, e, hf⟩ := Smooth.exists_isStandardSmooth p y
  have hsub : Subsingleton (Spec (CommRingCat.of k)) :=
    inferInstanceAs (Subsingleton (PrimeSpectrum k))
  obtain rfl : U = ⊤ := by
    ext z
    simp only [TopologicalSpace.Opens.coe_top, Set.mem_univ, iff_true]
    rw [Subsingleton.elim z (p y)]
    exact e hyV
  have hfm : (a3b2_fieldMap k Y p V).IsStandardSmooth := by
    have := RingHom.isStandardSmooth_respectsIso.2 (p.appLE ⊤ V e).hom
      (Scheme.ΓSpecIso (CommRingCat.of k)).symm.commRingCatIsoToRingEquiv hf
    exact this
  obtain ⟨n, g, hg, hgE⟩ := hfm.exists_etale_mvPolynomial
  exact ⟨V, hV, hyV, n, g, hg, hgE⟩

/-- Off the diagonal the diagonal ideal is the unit ideal.
Source: Mathlib, `Scheme.Hom.ker_apply`. -/
theorem a3b3_diagonalIdeal_eq_top [IsSeparated p] (U : (pullback p p : Scheme.{u}).affineOpens)
    (hU : ∀ y : Y, pullback.diagonal p y ∉ U.1) : (a3b3_diagonalIdeal p).ideal U = ⊤ := by
  rw [a3b3_diagonalIdeal, Scheme.Hom.ker_apply]
  have h : pullback.diagonal p ⁻¹ᵁ U.1 = ⊥ := by
    ext y
    simp only [TopologicalSpace.Opens.coe_bot, Set.mem_empty_iff_false, iff_false]
    exact hU y
  have : Subsingleton Γ(Y, pullback.diagonal p ⁻¹ᵁ U.1) := by rw [h]; infer_instance
  rw [Ideal.eq_top_iff_one, RingHom.mem_ker]
  exact Subsingleton.elim _ _

/-- The kernel of a map out of a localization away from `t`, when the composite sends `t` to a
unit, is the extension of the kernel of the composite.
Source: Atiyah–Macdonald, Proposition 3.11. -/
theorem a3b3_ker_of_isLocalization {R B C : Type*} [CommRing R] [CommRing B] [CommRing C]
    [Algebra R B] (t : R) [IsLocalization.Away t B] (ψ : B →+* C) :
    RingHom.ker ψ = (RingHom.ker (ψ.comp (algebraMap R B))).map (algebraMap R B) := by
  apply le_antisymm
  · intro x hx
    obtain ⟨r, ⟨_, n, rfl⟩, rfl⟩ := IsLocalization.exists_mk'_eq (Submonoid.powers t) x
    have hu : IsUnit (algebraMap R B (t ^ n)) :=
      IsLocalization.map_units B (⟨t ^ n, n, rfl⟩ : Submonoid.powers t)
    have hr : algebraMap R B r = IsLocalization.mk' B r (⟨t ^ n, n, rfl⟩ : Submonoid.powers t) *
        algebraMap R B (t ^ n) := (IsLocalization.mk'_spec B r _).symm
    have hrk : r ∈ RingHom.ker (ψ.comp (algebraMap R B)) := by
      rw [RingHom.mem_ker, RingHom.comp_apply, hr, map_mul, RingHom.mem_ker.1 hx, zero_mul]
    obtain ⟨v, hv⟩ := hu.exists_right_inv
    have : IsLocalization.mk' B r (⟨t ^ n, n, rfl⟩ : Submonoid.powers t) =
        algebraMap R B r * v := by
      rw [hr, mul_assoc, hv, mul_one]
    rw [this]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ hrk)
  · rw [Ideal.map_le_iff_le_comap]
    intro r hr
    exact hr

private theorem a3b3_id_appLE (V : Y.Opens) (e : V ≤ (𝟙 Y) ⁻¹ᵁ V) (a : Γ(Y, V)) :
    (𝟙 Y : Y ⟶ Y).appLE V V e a = a := by
  have : (homOfLE e).op = 𝟙 (Opposite.op V) := Subsingleton.elim _ _
  change (Y.presheaf.map (homOfLE e).op) a = a
  rw [this]
  erw [CategoryTheory.Functor.map_id]
  rfl

/-- The diagonal pulls back the comparison map to the multiplication: on `V ⊂ δ⁻¹ W`,
`δ* (pr₁* a · pr₂* b) = a b`.
Source: Mathlib, `pullback.diagonal_fst`, `pullback.diagonal_snd` and
`Scheme.Hom.appLE_comp_appLE`. -/
theorem a3b3_diagonal_appLE_tangentToProduct (V : Y.Opens)
    (W : (pullback p p : Scheme.{u}).Opens)
    (hW : W = pullback.fst p p ⁻¹ᵁ V ⊓ pullback.snd p p ⁻¹ᵁ V)
    (hVW : V ≤ pullback.diagonal p ⁻¹ᵁ W) :
    letI := (a3b2_fieldMap k Y p V).toAlgebra
    ((pullback.diagonal p).appLE W V hVW).hom.comp (a3b3_tangentToProduct p V W hW) =
      (Algebra.TensorProduct.lmul' k : Γ(Y, V) ⊗[k] Γ(Y, V) →ₐ[k] Γ(Y, V)).toRingHom := by
  let := (a3b2_fieldMap k Y p V).toAlgebra
  apply a3b3_tensor_ringHom_ext
  intro a b
  rw [RingHom.comp_apply, a3b3_tangentToProduct_tmul, map_mul, ← CommRingCat.comp_apply,
    ← CommRingCat.comp_apply, Scheme.Hom.appLE_comp_appLE, Scheme.Hom.appLE_comp_appLE]
  rw [a3b3_appLE_congr_hom (pullback.diagonal_fst p) _ _ _ (by simp),
    a3b3_appLE_congr_hom (pullback.diagonal_snd p) _ _ _ (by simp), a3b3_id_appLE,
    a3b3_id_appLE]
  simp [Algebra.TensorProduct.lmul'_apply_tmul]

/-- Around a diagonal point of a smooth separated scheme over a field the diagonal ideal is
generated by a regular sequence, with as many terms as an étale chart `V` of `Y` around the point
has coordinates, on an affine open of `Y ×ₖ Y` whose preimage under the diagonal is `V`.
Source: Stacks Project, Lemma 31.21.3 (tag 063L); Matsumura, *Commutative Ring Theory*,
Theorem 16.2. -/
theorem a3b3_diagonal_regular_chart [Smooth p] [IsSeparated p] (y : Y) :
    ∃ (V : Y.Opens) (_ : IsAffineOpen V) (_ : y ∈ V) (n : ℕ)
      (g : MvPolynomial (Fin n) k →+* Γ(Y, V)), g.Etale ∧
      ∃ U : (pullback p p : Scheme.{u}).affineOpens, pullback.diagonal p ⁻¹ᵁ U.1 = V ∧
        ∃ rs : List Γ((pullback p p : Scheme.{u}), U.1), rs.length = n ∧
          RingTheory.Sequence.IsRegular Γ((pullback p p : Scheme.{u}), U.1) rs ∧
            (a3b3_diagonalIdeal p).ideal U = Ideal.ofList rs := by
  obtain ⟨V, hV, hyV, n, g, hg, hgE⟩ := a3b3_exists_etale_chart p y
  let : Algebra k Γ(Y, V) := (a3b2_fieldMap k Y p V).toAlgebra
  let : Algebra (MvPolynomial (Fin n) k) Γ(Y, V) := g.toAlgebra
  have : IsScalarTower k (MvPolynomial (Fin n) k) Γ(Y, V) :=
    IsScalarTower.of_algebraMap_eq' (by
      rw [RingHom.algebraMap_toAlgebra, RingHom.algebraMap_toAlgebra, MvPolynomial.algebraMap_eq,
        hg])
  have : Algebra.Etale (MvPolynomial (Fin n) k) Γ(Y, V) := RingHom.etale_algebraMap.mp hgE
  obtain ⟨t, ht1, hB⟩ := a3b3_etale_diagonal (k := k) (A := Γ(Y, V)) n
  set W : (pullback p p : Scheme.{u}).Opens := pullback.fst p p ⁻¹ᵁ V ⊓ pullback.snd p p ⁻¹ᵁ V
    with hWdef
  obtain ⟨hWa, hφ⟩ := a3b3_tangentToProduct_bijective p V hV W rfl
  set φ := a3b3_tangentToProduct p V W rfl
  set e := RingEquiv.ofBijective φ hφ
  set s := φ t
  set W' := (pullback p p : Scheme.{u}).basicOpen s
  have hW'a : IsAffineOpen W' := hWa.basicOpen s
  -- `Γ(W')` is the localization of `Γ(V) ⊗ₖ Γ(V)` away from `t`
  let : Algebra Γ((pullback p p : Scheme.{u}), W) Γ((pullback p p : Scheme.{u}), W') :=
    ((pullback p p : Scheme.{u}).presheaf.map
      (homOfLE ((pullback p p : Scheme.{u}).basicOpen_le s)).op).hom.toAlgebra
  have : IsLocalization.Away s Γ((pullback p p : Scheme.{u}), W') := hWa.isLocalization_basicOpen s
  let : Algebra (Γ(Y, V) ⊗[k] Γ(Y, V)) Γ((pullback p p : Scheme.{u}), W') :=
    ((algebraMap Γ((pullback p p : Scheme.{u}), W) Γ((pullback p p : Scheme.{u}), W')).comp
      e.symm.symm.toRingHom).toAlgebra
  have : IsLocalization.Away t Γ((pullback p p : Scheme.{u}), W') := by
    have h := IsLocalization.isLocalization_of_base_ringEquiv (Submonoid.powers s)
      Γ((pullback p p : Scheme.{u}), W') e.symm
    have hm : (Submonoid.powers s).map e.symm = Submonoid.powers t := by
      rw [Submonoid.map_powers]
      congr 1
      exact e.symm_apply_apply t
    rw [hm] at h
    exact h
  have hB' := hB Γ((pullback p p : Scheme.{u}), W')
  -- the preimages of `W` and `W'` under the diagonal are `V`
  have hpreW : pullback.diagonal p ⁻¹ᵁ W = V := by
    ext z
    change (pullback.fst p p) (pullback.diagonal p z) ∈ V ∧
      (pullback.snd p p) (pullback.diagonal p z) ∈ V ↔ z ∈ V
    rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, pullback.diagonal_fst,
      pullback.diagonal_snd]
    simp
  have hVW : V ≤ pullback.diagonal p ⁻¹ᵁ W := hpreW.ge
  have hcomp := a3b3_diagonal_appLE_tangentToProduct p V W rfl hVW
  have h1 : (pullback.diagonal p).appLE W V hVW s = 1 := by
    have := RingHom.congr_fun hcomp t
    rw [RingHom.comp_apply] at this
    rw [this]
    exact ht1
  have hpre : pullback.diagonal p ⁻¹ᵁ W' = V := by
    apply le_antisymm
    · rw [← hpreW]
      exact (pullback.diagonal p).preimage_mono ((pullback p p : Scheme.{u}).basicOpen_le s)
    · have hb : Y.basicOpen ((pullback.diagonal p).appLE W V hVW s) =
          V ⊓ Y.basicOpen ((pullback.diagonal p).app W s) := by
        rw [Scheme.Hom.appLE, CommRingCat.comp_apply, Scheme.basicOpen_res]
      rw [h1, Scheme.basicOpen_one] at hb
      rw [Scheme.preimage_basicOpen]
      exact hb.le.trans inf_le_right
  have hle : V ≤ pullback.diagonal p ⁻¹ᵁ W' := hpre.ge
  set ψ := ((pullback.diagonal p).appLE W' V hle).hom
  have hψalg : ψ.comp (algebraMap (Γ(Y, V) ⊗[k] Γ(Y, V)) Γ((pullback p p : Scheme.{u}), W')) =
      (Algebra.TensorProduct.lmul' k : Γ(Y, V) ⊗[k] Γ(Y, V) →ₐ[k] Γ(Y, V)).toRingHom := by
    rw [← hcomp]
    refine RingHom.ext fun x => ?_
    change ((pullback p p : Scheme.{u}).presheaf.map _ ≫
      (pullback.diagonal p).appLE W' V hle) (φ x) = _
    rw [Scheme.Hom.map_appLE]
    rfl
  have hideal : (a3b3_diagonalIdeal p).ideal ⟨W', hW'a⟩ = RingHom.ker ψ := by
    rw [a3b3_diagonalIdeal, Scheme.Hom.ker_apply]
    ext x
    simp only [RingHom.mem_ker]
    constructor
    · intro hx
      change ((pullback.diagonal p).app W' ≫ Y.presheaf.map (homOfLE hle).op) x = 0
      rw [CommRingCat.comp_apply, hx, map_zero]
    · intro hx
      rw [Scheme.Hom.app_eq_appLE, ← Scheme.Hom.appLE_map (pullback.diagonal p) hle
        (homOfLE hpre.le).op, CommRingCat.comp_apply]
      change Y.presheaf.map _ (ψ x) = 0
      rw [hx, map_zero]
  have hker : RingHom.ker ψ = (KaehlerDifferential.ideal k Γ(Y, V)).map
      (algebraMap (Γ(Y, V) ⊗[k] Γ(Y, V)) Γ((pullback p p : Scheme.{u}), W')) := by
    rw [a3b3_ker_of_isLocalization t ψ, hψalg]
    rfl
  have : Nonempty V := ⟨⟨y, hyV⟩⟩
  refine ⟨V, hV, hyV, n, g, hgE, ⟨W', hW'a⟩, hpre, _, by simp, ⟨hB'.2, ?_⟩, ?_⟩
  · rw [smul_eq_mul, Ideal.mul_top, ← hB'.1, ← hker]
    intro h
    have h1' : (1 : Γ((pullback p p : Scheme.{u}), W')) ∈ RingHom.ker ψ := h ▸ Submodule.mem_top
    rw [RingHom.mem_ker, map_one] at h1'
    exact one_ne_zero h1'
  · rw [hideal, hker, hB'.1]

/-- Around a diagonal point of a smooth separated scheme over a field the diagonal ideal is
generated by a regular sequence.
Source: Stacks Project, Lemma 31.21.3 (tag 063L); Matsumura, *Commutative Ring Theory*,
Theorem 16.2. -/
theorem a3b3_diagonal_regular_at [Smooth p] [IsSeparated p] (y : Y) :
    ∃ U : (pullback p p : Scheme.{u}).affineOpens, pullback.diagonal p y ∈ U.1 ∧
      ∃ rs : List Γ((pullback p p : Scheme.{u}), U.1),
        RingTheory.Sequence.IsRegular Γ((pullback p p : Scheme.{u}), U.1) rs ∧
          (a3b3_diagonalIdeal p).ideal U = Ideal.ofList rs := by
  obtain ⟨V, -, hyV, -, -, -, U, hU, rs, -, hrs, hI⟩ := a3b3_diagonal_regular_chart p y
  refine ⟨U, ?_, rs, hrs, hI⟩
  change y ∈ pullback.diagonal p ⁻¹ᵁ U.1
  rw [hU]; exact hyV

/-- Every point of `Y ×ₖ Y` has an affine neighbourhood on which the diagonal ideal is the unit
ideal or is generated by a regular sequence.
Source: Fulton, *Intersection Theory*, second edition, §6.1 and Appendix B.7.1; Stacks Project,
Lemma 31.21.3 (tag 063L). -/
theorem a3b3_diagonal_locallyRegular_of [Smooth p] [IsSeparated p] :
    ∀ x : (pullback p p : Scheme.{u}), ∃ U : (pullback p p : Scheme.{u}).affineOpens, x ∈ U.1 ∧
      ((a3b3_diagonalIdeal p).ideal U = ⊤ ∨ ∃ rs : List Γ((pullback p p : Scheme.{u}), U.1),
        RingTheory.Sequence.IsRegular Γ((pullback p p : Scheme.{u}), U.1) rs ∧
          (a3b3_diagonalIdeal p).ideal U = Ideal.ofList rs) := by
  intro x
  by_cases hx : x ∈ Set.range (pullback.diagonal p)
  · obtain ⟨y, rfl⟩ := hx
    obtain ⟨U, hU, rs, hrs, hI⟩ := a3b3_diagonal_regular_at p y
    exact ⟨U, hU, Or.inr ⟨rs, hrs, hI⟩⟩
  · have hcl : IsClosed (Set.range (pullback.diagonal p)) :=
      (pullback.diagonal p).isClosedEmbedding.isClosed_range
    obtain ⟨_, ⟨U, hU, rfl⟩, hxU, hsub⟩ :=
      (pullback p p : Scheme.{u}).isBasis_affineOpens.exists_subset_of_mem_open hx hcl.isOpen_compl
    exact ⟨⟨U, hU⟩, hxU, Or.inl (a3b3_diagonalIdeal_eq_top p ⟨U, hU⟩ fun y hy => hsub hy ⟨y, rfl⟩)⟩

end diag
end HodgeLean.Adapters
