import HodgeLean.Adapters.NormalConeB4aGysinBridgeDefs

/-! # Reformulated bridge of A3-B4a: slice ideals

Two ideals of the local ring `𝒪_{K,w}` of a closed subscheme `i : K ⟶ Z` of a scheme over `ℂ`,
built from sections `g` of `𝒪_Z` on an open `U`: `a3b4g_sliceIdeal` is the ideal generated by the
germs of the shifted sections `g − a` (the list `a3b4a_gysin_sliceSequence`), and
`a3b4g_familyRadical` is the radical of the ideal generated by the germ of the last shifted section.
When the last section is the family parameter `t − s`, the second ideal is the ideal of the reduced
special fibre in `𝒪_{K,w}`. These are definitions of objects; none of them asserts a property of a
slice.
-/

noncomputable section
namespace HodgeLean.Adapters
open CategoryTheory Limits AlgebraicGeometry

/-- The ideal of `𝒪_{K,w}` generated by the germs at `w` of the shifted sections `g_j − a_j`,
pulled back along `i`; its quotient is the local ring of the slice `g = a` of `K` at `w`.
Source: Matsumura, *Commutative Ring Theory*, §14 (parameter ideals of a local ring); Mathlib,
`Ideal.ofList`. -/
def a3b4g_sliceIdeal {Z K : Scheme.{0}} (q : Z ⟶ Spec (CommRingCat.of ℂ))
    (i : K ⟶ Z) (U : Z.Opens) {n : ℕ} (g : Fin n → Γ(Z, U)) (a : Fin n → ℂ) (w : K)
    (hw : i.base w ∈ U) : Ideal (K.presheaf.stalk w) :=
  Ideal.ofList (a3b4a_gysin_sliceSequence q i U g a w hw)

example {Z K : Scheme.{0}} (q : Z ⟶ Spec (CommRingCat.of ℂ)) (i : K ⟶ Z) (U : Z.Opens)
    {n : ℕ} (g : Fin n → Γ(Z, U)) (a : Fin n → ℂ) (w : ComplexPoint (Over.mk (i ≫ q)))
    (hw : i.base w.underlying ∈ U) :
    a3b4a_gysin_sliceLength q i U g a w =
      Module.length (K.presheaf.stalk w.underlying)
        (K.presheaf.stalk w.underlying ⧸ a3b4g_sliceIdeal q i U g a w.underlying hw) := by
  simp only [a3b4a_gysin_sliceLength, hw, ↓reduceDIte]
  rfl

/-- The radical, in `𝒪_{K,w}`, of the ideal generated by the germ of the last shifted section
`g_r − a_r`. When `g_r − a_r` is the family parameter `t − s` of `K` over the line, the quotient of
`𝒪_{K,w}` by this ideal is the local ring of the reduced special fibre `(K_s)_red` at `w`.
Source: Hartshorne, *Algebraic Geometry*, Exercise II.2.3 (the reduced subscheme and the
nilradical); Mathlib, `Ideal.radical`. -/
def a3b4g_familyRadical {Z K : Scheme.{0}} (q : Z ⟶ Spec (CommRingCat.of ℂ))
    (i : K ⟶ Z) (U : Z.Opens) {r : ℕ} (g : Fin (r + 1) → Γ(Z, U)) (a : Fin (r + 1) → ℂ)
    (w : K) (hw : i.base w ∈ U) : Ideal (K.presheaf.stalk w) :=
  (Ideal.span {(K.presheaf.germ (i ⁻¹ᵁ U) w hw
    (i.app U (g (Fin.last r) - a3b4a_gysin_sectionConst q U (a (Fin.last r)))))}).radical

/-- The family radical lies inside the slice radical: the last germ is one of the generators of
the slice ideal. -/
example {Z K : Scheme.{0}} (q : Z ⟶ Spec (CommRingCat.of ℂ)) (i : K ⟶ Z) (U : Z.Opens)
    {r : ℕ} (g : Fin (r + 1) → Γ(Z, U)) (a : Fin (r + 1) → ℂ) (w : K) (hw : i.base w ∈ U) :
    a3b4g_familyRadical q i U g a w hw ≤ (a3b4g_sliceIdeal q i U g a w hw).radical := by
  unfold a3b4g_familyRadical
  apply Ideal.radical_mono
  rw [Ideal.span_le]
  rintro x rfl
  apply Ideal.subset_span
  simp only [a3b4a_gysin_sliceSequence, List.mem_ofFn]
  exact ⟨Fin.last r, rfl⟩

end HodgeLean.Adapters
