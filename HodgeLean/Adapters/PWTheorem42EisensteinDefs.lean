import HodgeLean.Adapters.AbelianPowerHodgeDefs
import HodgeLean.Adapters.AbelianCMData
import HodgeLean.Adapters.AbelianHodgeDischarge
import HodgeLean.RealDefs.WeilClasses

/-! # Theorem 4.2 at `L = k = ℚ(√-3)`, stage F1 of the Powers flagship: definitions

Definitions for `PWTheorem42Eisenstein`, stage F1 (milestone M1) of formalizing PW v0.3,
Theorem 4.2 (`thm:gen`), "Hodge classes on powers of abelian varieties of Weil type and of type
IV with exact endomorphism algebra" (doi:10.5281/zenodo.23570103). For an abelian `A`, a
`ℚ`-algebra map `θ : L →ₐ[ℚ] End⁰(A)` from a field `L`, an element `u : L` with `u² = -d`, and
power data `P : AbelianPowerData A Y r` (stage G4):

* `f1_weilAction A θ u d hu`: G4's `pwWeilAction` with its preservation input supplied by
  `spec_g4_pwAction_map_le`, so that it depends on `θ`, `u` and `hu` only;
* `pwPowerSpan A θ u d hu hW P p`: the image in `HQ Y (2p)`, under G2's model map
  `P.cohomologyMap (2p)`, of PW-0's model span `cmPowerSpan` over the image of `L`, generated by
  `1`, the model's rational degree-two Hodge classes and the pullbacks of the rational Weil
  classes of `A`;
* `f1_IsPulledWeilClosed` and `f1_pulledWeilCupSpan A θ u d hu hW P D p`: the same kind of span
  built on `Y` itself, as the least cup-closed family of subspaces of `HQ Y (2·)` containing the
  unit class, a chosen degree-two space `D` (for example `Hdg¹(Y; ℚ)` or the span of divisor
  classes) and the pullbacks `f_a^*` of the rational Weil classes of `A`, `a ∈ 𝒪^r`.

No definition asserts a generation, Hodge or algebraicity result; those are the statements of
`PWTheorem42Eisenstein`. HC no distance; AV milestone no distance.
-/

noncomputable section

open CategoryTheory AlgebraicGeometry AlgebraicGeometry.ComplexPoint
open scoped CategoryTheory.MonObj TensorProduct
open HodgeLean.RealDefs HodgeLean.Foundations HodgeLean.Foundations.WeilPower

namespace HodgeLean.Adapters

variable (A : Over (Spec ↧ℂ)) [GrpObj A] [IsCommMonObj A] [IsIntegral A.left]
  [Smooth A.hom] [IsProjective A.hom]
variable {L : Type*} [Field L] [Algebra ℚ L]

/-- **The Weil action of `k = ℚ(u)` on `H¹(A)`, with no extra input**: G4's `pwWeilAction` with
`J = θ(u)^*`, its Hodge-preservation argument supplied by `spec_g4_pwAction_map_le` (which holds
for every `u`).
Source: PW v0.3, Subsection 2.2 (`W_k(A)` for `k = ℚ(u) ⊆ L` acting on `V`); `pwWeilAction`,
`spec_g4_pwAction_map_le` (`Adapters/AbelianCMData.lean`). -/
def f1_weilAction (θ : L →ₐ[ℚ] AbelianEnd0 A) (u : L) (d : ℚ)
    (hu : u ^ 2 = -algebraMap ℚ L d) :
    letI := (finiteBetti_abelian A).finite 1
    HodgeBlocks.WeilAction (abelianWeightOneHodgeStructure A) d :=
  pwWeilAction A θ u d hu (spec_g4_pwAction_map_le A θ u)

example (θ : L →ₐ[ℚ] AbelianEnd0 A) (u : L) (hu : u ^ 2 = -algebraMap ℚ L 3) :
    letI := (finiteBetti_abelian A).finite 1
    (f1_weilAction A θ u 3 hu).J = pwAction A θ u :=
  rfl

/-- The same action, read on the weight-one structure of the package
`abelianVarietyCohomologyOf … (torusCohomology_cupProductOf A)`, which has the same pieces: this is
the form `WeilClassesAlgebraic` and `weilClassOf` take. -/
example (θ : L →ₐ[ℚ] AbelianEnd0 A) (u : L) (d : ℚ) (hu : u ^ 2 = -algebraMap ℚ L d) :
    letI := (torusCohomology_cupProductOf A).finite
    HodgeBlocks.WeilAction (abelianVarietyCohomologyOf (finiteBetti_abelian A)
      (spec_bettiDeRhamIso_abelian A) (hodgeDecomposition_of_abelian A)
      (torusCohomology_cupProductOf A)).weight1 d :=
  f1_weilAction A θ u d hu

variable {Y : Over (Spec ↧ℂ)} [GrpObj Y] [IsCommMonObj Y] [IsIntegral Y.left] [Smooth Y.hom]
  [IsProjective Y.hom] {r : ℕ}

/-- **The powers span of Theorem 4.2 on `Y`, through the model**: the image under G2's model map
`P.cohomologyMap (2p) : ⋀^{2p} (HQ A 1 ⊗ ℚ^r) → HQ Y (2p)` of PW-0's `cmPowerSpan` over
`R = pwActionRange A θ` (the image of `L`), in degree `2p`, with degree-two generators the model's
rational degree-two Hodge classes `rationalExteriorHodge … r 2` and Weil generators the rational
Weil classes of `f1_weilAction A θ u d hu`. The Weil generators are pulled back along every
`cmPowerPullback R a`, `a ∈ R^r`; G4's `spec_g4_span_pwOrder_eq` shows `𝒪^r` gives the same span,
and G2's `spec_g2_homPullback_pwSumMap_degree` identifies the image of each with an actual
pullback `f_a^*`. The argument `hW` (Weil type) is a proposition; Theorem 4.2's statements derive it
from (P3).
Source: PW v0.3, Theorem 4.2 and its proof, paragraph "Conclusion" (the algebra `𝓑` generated by
the divisor classes and the planes `f_a^* W_k(A)`); `cmPowerSpan`
(`Foundations/PowersVocabularyDefs.lean`), `AbelianPowerData.cohomologyMap`
(`Adapters/AbelianPowerHodgeDefs.lean`). -/
def pwPowerSpan (θ : L →ₐ[ℚ] AbelianEnd0 A) (u : L) (d : ℚ) (hu : u ^ 2 = -algebraMap ℚ L d)
    (hW : letI := (finiteBetti_abelian A).finite 1; (f1_weilAction A θ u d hu).IsWeilType)
    (P : AbelianPowerData A Y r) (p : ℕ) : Submodule ℚ (HQ Y (2 * p)) :=
  letI := (finiteBetti_abelian A).finite 1
  (cmPowerSpan (pwActionRange A θ)
      (rationalExteriorHodge (abelianWeightOneHodgeStructure A).H
        (abelianWeightOneHodgeStructure A).isInternal r 2)
      ((f1_weilAction A θ u d hu).weilClasses
        (h10_sup_h01_eq_top (finiteBetti_abelian A) (spec_bettiDeRhamIso_abelian A)
          (hodgeDecomposition_of_abelian A) (torusCohomology_cupProductOf A)) hW)
      (2 * p)).map (P.cohomologyMap (2 * p))

example (θ : L →ₐ[ℚ] AbelianEnd0 A) (u : L) (d : ℚ) (hu : u ^ 2 = -algebraMap ℚ L d)
    (hW : letI := (finiteBetti_abelian A).finite 1; (f1_weilAction A θ u d hu).IsWeilType)
    (P : AbelianPowerData A Y r) (p : ℕ) :
    pwPowerSpan A θ u d hu hW P p ≤ LinearMap.range (P.cohomologyMap (2 * p)) :=
  LinearMap.map_le_range

/-- A family `F p ⊆ HQ Y (2p)` containing the unit class in degree `0`, the space `D` in degree
`1`, and, for every `a ∈ 𝒪^r`, the pullback `f_a^* = homPullback (P.pwSumMap θ a)` of the rational
Weil classes `weilClassOf` of `f1_weilAction A θ u d hu` (in degree `k = dim (V_s ∩ H^{1,0})`),
closed under the cup product of `Y`. The same shape as `IsDivisorWeilClosed`, with the Weil
classes of `A` pulled back to `Y`.
Source: PW v0.3, Theorem 4.2 and its proof, paragraph "Conclusion" (the algebra `𝓑`);
`IsDivisorWeilClosed` (`RealDefs/WeilClasses.lean`).

Consistency and non-vacuity: the family constantly equal to `⊤` satisfies these closure
conditions for every input. It is an untagged closure predicate, not a generation or
algebraicity hypothesis. -/
structure f1_IsPulledWeilClosed (θ : L →ₐ[ℚ] AbelianEnd0 A) (u : L) (d : ℚ)
    (hu : u ^ 2 = -algebraMap ℚ L d)
    (hW : letI := (finiteBetti_abelian A).finite 1; (f1_weilAction A θ u d hu).IsWeilType)
    (P : AbelianPowerData A Y r) (D : Submodule ℚ (HQ Y (2 * 1)))
    (F : ∀ p : ℕ, Submodule ℚ (HQ Y (2 * p))) : Prop where
  unit_mem : (show HQ Y (2 * 0) from unitClass Y) ∈ F 0
  divisor_le : D ≤ F 1
  pullback_le : ∀ a : Fin r → pwOrder A θ,
    letI := (finiteBetti_abelian A).finite 1
    (weilClassOf (finiteBetti_abelian A) (spec_bettiDeRhamIso_abelian A)
        (hodgeDecomposition_of_abelian A) (torusCohomology_cupProductOf A)
        (f1_weilAction A θ u d hu) hW).map (homPullback (P.pwSumMap θ a) _) ≤
      F (Module.finrank ℂ ↥((f1_weilAction A θ u d hu).Vs ⊓ (abelianWeightOneHodgeStructure A).H (1, 0)))
  cup_mem : ∀ {p q : ℕ} (h : 2 * p + 2 * q = 2 * (p + q)) (a : HQ Y (2 * p)) (b : HQ Y (2 * q)),
    a ∈ F p → b ∈ F q → (cupProductOf Y).cup h a b ∈ F (p + q)

example (θ : L →ₐ[ℚ] AbelianEnd0 A) (u : L) (d : ℚ) (hu : u ^ 2 = -algebraMap ℚ L d)
    (hW : letI := (finiteBetti_abelian A).finite 1; (f1_weilAction A θ u d hu).IsWeilType)
    (P : AbelianPowerData A Y r) (D : Submodule ℚ (HQ Y (2 * 1))) :
    f1_IsPulledWeilClosed A θ u d hu hW P D (fun _ => ⊤) where
  unit_mem := trivial
  divisor_le := le_top
  pullback_le _ := le_top
  cup_mem _ _ _ _ _ := trivial

/-- **The pulled-Weil cup span on `Y`**: the least `f1_IsPulledWeilClosed` family, in degree `2p`.
With `D = algebraicCycleClassSpan Y 1` it is the paper's literal algebra, generated by the divisor
classes and the planes `f_a^* W_k(A)`, `a ∈ 𝒪^r`; with `D = Hdg¹(Y; ℚ)` its degree-two generators
are the rational Hodge classes, as in `divisorWeilSpan`.
Source: PW v0.3, Theorem 4.2 (first sentence) and its proof, paragraph "Conclusion";
`divisorWeilSpan` (`RealDefs/WeilClasses.lean`). -/
def f1_pulledWeilCupSpan (θ : L →ₐ[ℚ] AbelianEnd0 A) (u : L) (d : ℚ)
    (hu : u ^ 2 = -algebraMap ℚ L d)
    (hW : letI := (finiteBetti_abelian A).finite 1; (f1_weilAction A θ u d hu).IsWeilType)
    (P : AbelianPowerData A Y r) (D : Submodule ℚ (HQ Y (2 * 1))) (p : ℕ) :
    Submodule ℚ (HQ Y (2 * p)) :=
  ⨅ (F : ∀ p : ℕ, Submodule ℚ (HQ Y (2 * p))) (_ : f1_IsPulledWeilClosed A θ u d hu hW P D F), F p

example (θ : L →ₐ[ℚ] AbelianEnd0 A) (u : L) (d : ℚ) (hu : u ^ 2 = -algebraMap ℚ L d)
    (hW : letI := (finiteBetti_abelian A).finite 1; (f1_weilAction A θ u d hu).IsWeilType)
    (P : AbelianPowerData A Y r) (D : Submodule ℚ (HQ Y (2 * 1))) (p : ℕ) :
    f1_pulledWeilCupSpan A θ u d hu hW P D p ≤ ⊤ :=
  le_top

end HodgeLean.Adapters
