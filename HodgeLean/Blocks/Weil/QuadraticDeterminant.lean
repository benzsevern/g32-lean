import HodgeLean.Blocks.Weil.DeterminantComparison
import HodgeLean.Foundations.WeilHermitian

/-! # The determinant inclusion for the quadratic field generated by J -/

noncomputable section
set_option maxHeartbeats 400000

namespace HodgeBlocks.WeilAction

open HodgeLean.Foundations.WeilHermitian

/-- Positive d makes the polynomial defining the imaginary quadratic field irreducible. -/
theorem quadratic_no_root {d : ℚ} (hd : 0 < d) : ∀ r : ℚ, r ^ 2 ≠ -d + 0 * r := by
  intro r h
  have hr := sq_nonneg r
  nlinarith

variable {V : Type*} [AddCommGroup V] [Module ℚ V] [Module.Finite ℚ V]
  {M : QHodgeStructure 1 V} {d : ℚ}
  [Fact (∀ r : ℚ, r ^ 2 ≠ -d + 0 * r)]

variable (A : WeilAction M d)

/-- The canonical inclusion for K = Q(√(-d)), with its module structure supplied by J. -/
def quadraticDeterminantInclusion
    (hH : M.H (1, 0) ⊔ M.H (0, 1) = ⊤) (hW : A.IsWeilType) (hd : 0 < d)
    (hκ : 1 ≤ Module.finrank ℂ ↥(A.Vs ⊓ M.H (1, 0))) :
    (⋀[QuadraticAlgebra ℚ (-d) 0]^(Module.finrank ℂ ↥(A.Vs ⊓ M.H (1, 0)) +
      Module.finrank ℂ ↥(A.Vs ⊓ M.H (1, 0))) (WithJ V (a := -d) ⟨A.J, A.J_sq⟩)) →ₗ[ℚ]
    (⋀[ℚ]^(Module.finrank ℂ ↥(A.Vs ⊓ M.H (1, 0)) +
      Module.finrank ℂ ↥(A.Vs ⊓ M.H (1, 0))) V) := by
  letI : Module (QuadraticAlgebra ℚ (-d) 0) V := WithJ.instModule ⟨A.J, A.J_sq⟩
  letI : IsScalarTower ℚ (QuadraticAlgebra ℚ (-d) 0) V :=
    WithJ.instIsScalarTower ⟨A.J, A.J_sq⟩
  letI : Module.Finite (QuadraticAlgebra ℚ (-d) 0) V :=
    Module.Finite.of_restrictScalars_finite ℚ _ _
  exact A.determinantInclusion (K := QuadraticAlgebra ℚ (-d) 0) (V := V) hH hW hd hκ
    QuadraticAlgebra.omega
    (by simp [pow_two, QuadraticAlgebra.omega_mul_omega_eq_algebraMap])
    (by
      ext x
      exact (equiv_omega_smul ⟨A.J, A.J_sq⟩ x).symm)
    (QuadraticAlgebra.finrank_eq_two (-d) 0)

/-- The canonical quadratic determinant inclusion is injective. -/
theorem quadraticDeterminantInclusion_injective
    (hH : M.H (1, 0) ⊔ M.H (0, 1) = ⊤) (hW : A.IsWeilType) (hd : 0 < d)
    (hκ : 1 ≤ Module.finrank ℂ ↥(A.Vs ⊓ M.H (1, 0))) :
    Function.Injective (A.quadraticDeterminantInclusion hH hW hd hκ) := by
  letI : Module (QuadraticAlgebra ℚ (-d) 0) V := WithJ.instModule ⟨A.J, A.J_sq⟩
  letI : IsScalarTower ℚ (QuadraticAlgebra ℚ (-d) 0) V :=
    WithJ.instIsScalarTower ⟨A.J, A.J_sq⟩
  letI : Module.Finite (QuadraticAlgebra ℚ (-d) 0) V :=
    Module.Finite.of_restrictScalars_finite ℚ _ _
  unfold quadraticDeterminantInclusion
  exact A.determinantInclusion_injective (K := QuadraticAlgebra ℚ (-d) 0)
    (V := V) _ _ _ _ _ _ _ _

/-- Its image is the full rational Weil space. -/
theorem range_quadraticDeterminantInclusion
    (hH : M.H (1, 0) ⊔ M.H (0, 1) = ⊤) (hW : A.IsWeilType) (hd : 0 < d)
    (hκ : 1 ≤ Module.finrank ℂ ↥(A.Vs ⊓ M.H (1, 0))) :
    LinearMap.range (A.quadraticDeterminantInclusion hH hW hd hκ) =
      A.weilClasses hH hW := by
  letI : Module (QuadraticAlgebra ℚ (-d) 0) V := WithJ.instModule ⟨A.J, A.J_sq⟩
  letI : IsScalarTower ℚ (QuadraticAlgebra ℚ (-d) 0) V :=
    WithJ.instIsScalarTower ⟨A.J, A.J_sq⟩
  letI : Module.Finite (QuadraticAlgebra ℚ (-d) 0) V :=
    Module.Finite.of_restrictScalars_finite ℚ _ _
  unfold quadraticDeterminantInclusion
  exact A.range_determinantInclusion (K := QuadraticAlgebra ℚ (-d) 0)
    (V := V) _ _ _ _ _ _ _ _

/-- Every quadratic determinant vector is a rational Weil class. -/
theorem quadraticDeterminantInclusion_mem
    (hH : M.H (1, 0) ⊔ M.H (0, 1) = ⊤) (hW : A.IsWeilType) (hd : 0 < d)
    (hκ : 1 ≤ Module.finrank ℂ ↥(A.Vs ⊓ M.H (1, 0))) (w) :
    A.quadraticDeterminantInclusion hH hW hd hκ w ∈ A.weilClasses hH hW := by
  rw [← A.range_quadraticDeterminantInclusion hH hW hd hκ]
  exact ⟨w, rfl⟩

#print axioms quadratic_no_root
#print axioms quadraticDeterminantInclusion
#print axioms quadraticDeterminantInclusion_injective
#print axioms range_quadraticDeterminantInclusion
#print axioms quadraticDeterminantInclusion_mem

end HodgeBlocks.WeilAction
