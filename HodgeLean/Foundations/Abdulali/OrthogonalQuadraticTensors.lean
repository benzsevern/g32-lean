import HodgeLean.Foundations.Abdulali.OrthogonalBilinearForms
import HodgeLean.Foundations.Program.MilneTensorMatrixPairFunction
import HodgeLean.Foundations.Program.MilneTensorPairing
import Mathlib.LinearAlgebra.Multilinear.Curry

noncomputable section
open scoped TensorProduct
namespace HodgeLean.Foundations.Abdulali
open HodgeLean.Foundations HodgeLean.Foundations.Program

/-- The inverse-form tensor for the standard symmetric form, written in its
coordinate basis. The standard form is its own inverse matrix.
Source: Weyl, The Classical Groups, Chapter II, §9. -/
def standardInverseFormTensor (d : ℕ) : ⨂[ℂ]^2 (Fin d → ℂ) :=
  ∑ ij : Fin d × Fin d, ⨂ₜ[ℂ] s,
    m1b_matrixPairVectors (1 : Matrix (Fin d) (Fin d) ℂ) ij s

/-- Pairing the inverse-form tensor with two vectors gives their standard
bilinear pairing, fixing the normalization of the quadratic generator.
Source: Weyl, The Classical Groups, Chapter II, §9. -/
theorem standardInverseFormTensor_pairing (d : ℕ) (v : Fin 2 → Fin d → ℂ) :
    m1b_tensorFunction (1 : Matrix (Fin d) (Fin d) ℂ).toBilin' 2
      (standardInverseFormTensor d) v =
      (1 : Matrix (Fin d) (Fin d) ℂ).toBilin' (v 0) (v 1) :=
  m1b_matrixPairVectors_tensorFunction 1 v

private def multilinearTwoBilinear {V : Type*} [AddCommGroup V] [Module ℂ V]
    (f : MultilinearMap ℂ (fun _ : Fin 2 => V) ℂ) : LinearMap.BilinForm ℂ V where
  toFun x := (f.curryLeft x).toLinearMap 0 0
  map_add' x y := by
    apply LinearMap.ext
    intro v
    simp only [map_add, MultilinearMap.toLinearMap_apply, MultilinearMap.add_apply,
      LinearMap.add_apply]
  map_smul' c x := by
    apply LinearMap.ext
    intro v
    simp only [map_smul, MultilinearMap.toLinearMap_apply, MultilinearMap.smul_apply,
      LinearMap.smul_apply, RingHom.id_apply]

private theorem multilinearTwoBilinear_apply {V : Type*} [AddCommGroup V] [Module ℂ V]
    (f : MultilinearMap ℂ (fun _ : Fin 2 => V) ℂ) (x y : V) :
    multilinearTwoBilinear f x y = f ![x, y] := by
  change f (Fin.cons x (Function.update 0 (0 : Fin 1) y)) = f ![x, y]
  congr 1
  ext i
  fin_cases i <;> simp

/-- In positive dimension the actual degree-two O-fixed tensor space is the
line generated by the normalized inverse-form tensor.
Source: Weyl, The Classical Groups, Chapter II, §9 (the quadratic generators). -/
theorem standard_orthogonal_quadratic_tensors (d : ℕ) (hd : 0 < d) :
    m1b_fixed (m1b_isometries (1 : Matrix (Fin d) (Fin d) ℂ).toBilin') 2 =
      Submodule.span ℂ {standardInverseFormTensor d} := by
  let B := (1 : Matrix (Fin d) (Fin d) ℂ).toBilin'
  have hB : B.Nondegenerate :=
    LinearMap.BilinForm.nondegenerate_toBilin'_iff_det_ne_zero.mpr (by simp)
  have hQ : standardInverseFormTensor d ∈ m1b_fixed (m1b_isometries B) 2 := by
    apply (m1b_tensorFunction_fixed_iff B hB 2 (m1b_isometries B) (fun _ h => h) _).mpr
    intro u hu v
    rw [standardInverseFormTensor_pairing, standardInverseFormTensor_pairing]
    exact hu.2 _ _
  apply le_antisymm
  · intro t ht
    let f := m1b_tensorFunction B 2 t
    let F := multilinearTwoBilinear f
    have hf := m1b_tensorFunction_fixed B 2 (m1b_isometries B) (fun _ h => h) t ht
    have hF : ∀ u ∈ m1b_isometries B, ∀ x y, F (u x) (u y) = F x y := by
      intro u hu x y
      rw [multilinearTwoBilinear_apply, multilinearTwoBilinear_apply]
      have h := hf u hu ![x, y]
      have hv : (fun i => u (![x, y] i)) = ![u x, u y] := by
        ext i; fin_cases i <;> rfl
      rw [hv] at h
      exact h
    obtain ⟨c, hc⟩ := standard_orthogonal_bilinear_forms d hd F hF
    have htQ : t = c • standardInverseFormTensor d := by
      apply m1b_tensorFunction_injective B hB 2
      apply MultilinearMap.ext
      intro v
      have hv : v = ![v 0, v 1] := by ext i; fin_cases i <;> rfl
      have hFc := LinearMap.congr_fun₂ hc (v 0) (v 1)
      rw [multilinearTwoBilinear_apply] at hFc
      change f ![v 0, v 1] = c * B (v 0) (v 1) at hFc
      change f v = _
      simp only [map_smul, MultilinearMap.smul_apply, smul_eq_mul]
      have hQv : m1b_tensorFunction B 2 (standardInverseFormTensor d) v =
          B (v 0) (v 1) := standardInverseFormTensor_pairing d v
      rw [hQv]
      exact (congrArg f hv).trans hFc
    rw [htQ]
    exact Submodule.smul_mem _ c (Submodule.subset_span (Set.mem_singleton _))
  · exact Submodule.span_le.mpr (by intro t ht; rcases ht with rfl; exact hQ)

end HodgeLean.Foundations.Abdulali
