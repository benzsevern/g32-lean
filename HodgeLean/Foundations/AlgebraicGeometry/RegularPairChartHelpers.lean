import HodgeLean.Foundations.AlgebraicGeometry.RegularPairChartDefs
import Mathlib.Algebra.Polynomial.Eval.Coeff
import Mathlib.Algebra.Regular.Basic

noncomputable section
set_option maxHeartbeats 400000
namespace AlgebraicGeometry.RegularPairChart
open Polynomial

/-- Cancellation by a regular coefficient holds coefficientwise in the polynomial ring. -/
theorem constant_regular {R : Type*} [CommRing R]
    (v : R) (hv : IsRegular v) : IsRegular (C v : R[X]) := by
  apply (Commute.isRegular_iff (fun _ => Commute.all _ _)).mpr
  intro p q hpq
  apply Polynomial.ext
  intro n
  apply hv.left
  simpa only [coeff_C_mul] using congrArg (fun p : R[X] => p.coeff n) hpq

/-- The binomial relation is saturated with respect to the second regular parameter. -/
theorem relation_saturated {R : Type*} [CommRing R]
    (u v : R) (hv : IsRegular v)
    (hu : IsRegular (Ideal.Quotient.mk (Ideal.span {v}) u))
    (p : R[X]) (hp : C u - X * C v ∣ C v * p) :
    C u - X * C v ∣ p := by
  let f := Ideal.Quotient.mk (Ideal.span {v})
  have hfv : f v = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr
    (Ideal.subset_span (Set.mem_singleton _))
  obtain ⟨q, hq⟩ := hp
  have hmap := congrArg (Polynomial.map f) hq
  have hz : C (f u) * q.map f = 0 := by
    simpa only [Polynomial.map_mul, Polynomial.map_sub, Polynomial.map_C,
      Polynomial.map_X, hfv, C_0, mul_zero, zero_mul, sub_zero] using hmap.symm
  have hqzero : q.map f = 0 :=
    (constant_regular (f u) hu).left
      (hz.trans (mul_zero _).symm)
  have hdiv : C v ∣ q := by
    apply (C_dvd_iff_dvd_coeff v q).mpr
    intro n
    apply Ideal.mem_span_singleton.mp
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    have hc := congrArg (fun q : (R ⧸ Ideal.span {v})[X] => q.coeff n) hqzero
    simpa only [Polynomial.coeff_map, coeff_zero] using hc
  obtain ⟨k, hk⟩ := hdiv
  refine ⟨k, ?_⟩
  apply (constant_regular v hv).left
  change C v * p = C v * ((C u - X * C v) * k)
  rw [hq, hk]
  ring

/-- A regular pair gives a regular denominator in its binomial chart ring. -/
theorem quotient_denominator_regular {R : Type*} [CommRing R]
    (u v : R) (hv : IsRegular v)
    (hu : IsRegular (Ideal.Quotient.mk (Ideal.span {v}) u)) :
    IsRegular (Ideal.Quotient.mk (Ideal.span {C u - X * C v}) (C v)) := by
  apply (Commute.isRegular_iff (fun _ => Commute.all _ _)).mpr
  intro a b hab
  apply sub_eq_zero.mp
  obtain ⟨p, hp⟩ := Ideal.Quotient.mk_surjective (a - b)
  rw [← hp]
  apply Ideal.Quotient.eq_zero_iff_mem.mpr
  apply Ideal.mem_span_singleton.mpr
  apply relation_saturated u v hv hu
  apply Ideal.mem_span_singleton.mp
  apply Ideal.Quotient.eq_zero_iff_mem.mp
  rw [map_mul, hp, mul_sub]
  exact sub_eq_zero.mpr hab


open MvPolynomial
/-- An unused coordinate preserves membership in the ideal of selected coordinates.
Source: the monomial support criterion for ideals generated by variables. -/
theorem coordinate_ideal_saturated
    {κ R : Type*} [CommRing R] (J : Set κ) (i : κ) (hi : i ∉ J)
    (p : MvPolynomial κ R)
    (hp : X i * p ∈ Ideal.span (X '' J : Set (MvPolynomial κ R))) :
    p ∈ Ideal.span (X '' J : Set (MvPolynomial κ R)) := by
  classical
  apply mem_ideal_span_X_image.mpr
  intro m hm
  have hshift : Finsupp.single i 1 + m ∈ (X i * p).support := by
    rw [support_X_mul]
    exact Finset.mem_map.mpr ⟨m, hm, rfl⟩
  obtain ⟨j, hj, hne⟩ := mem_ideal_span_X_image.mp hp _ hshift
  refine ⟨j, hj, ?_⟩
  have hji : j ≠ i := fun he => hi (he ▸ hj)
  simpa only [Finsupp.add_apply, Finsupp.single_eq_of_ne hji, zero_add] using hne

/-- Any ordered list of distinct variables is a weakly regular sequence.
Source: saturation of coordinate ideals and the quotient definition of regular sequences. -/
theorem coordinate_list_weakly_regular
    {κ R : Type*} [CommRing R] (l : List κ) (hl : l.Nodup) :
    RingTheory.Sequence.IsWeaklyRegular (MvPolynomial κ R) (l.map (X : κ → MvPolynomial κ R)) := by
  classical
  constructor
  intro n hn
  have hn' : n < l.length := by simpa only [List.length_map] using hn
  have hi : l[n] ∉ {i | i ∈ l.take n} := by
    intro hmem
    obtain ⟨j, hj, he⟩ := List.mem_iff_getElem.mp hmem
    have hjn : j < n := lt_of_lt_of_le hj (by simp only [List.length_take]; exact min_le_left _ _)
    have hjl : j < l.length := lt_trans hjn hn'
    have he' : l[j] = l[n] := by simpa only [List.getElem_take] using he
    exact Nat.ne_of_lt hjn ((hl.getElem_inj_iff).mp he')
  have hI : Ideal.ofList ((l.map (X : κ → MvPolynomial κ R)).take n) =
      Ideal.span (X '' {i | i ∈ l.take n} : Set (MvPolynomial κ R)) := by
    rw [← List.map_take]
    apply congrArg Ideal.span
    ext p
    simp only [Set.mem_ofPred_eq, List.mem_map, Set.mem_image]
  rw [Ideal.smul_eq_mul, Ideal.mul_top, hI]
  simp only [List.getElem_map]
  apply (isSMulRegular_quotient_iff_mem_of_smul_mem _ _).mpr
  exact coordinate_ideal_saturated _ _ hi


/-- Flat coordinate charts preserve the weak regularity of distinct branch variables.
Source: flat base change for weakly regular sequences. -/
theorem flat_coordinate_list_weakly_regular
    {κ R A : Type*} [CommRing R] [CommRing A]
    [Algebra (MvPolynomial κ R) A] [Module.Flat (MvPolynomial κ R) A]
    (l : List κ) (hl : l.Nodup) :
    RingTheory.Sequence.IsWeaklyRegular A
      (l.map (fun i => algebraMap (MvPolynomial κ R) A (X i))) := by
  simpa only [List.map_map, Function.comp_def] using
    (coordinate_list_weakly_regular (R := R) l hl).of_flat (S := A)


end AlgebraicGeometry.RegularPairChart
