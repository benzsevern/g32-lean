import Mathlib.Algebra.Field.Subfield.Basic
import Mathlib.RingTheory.IntegralClosure.IsIntegralClosure.Basic
import Mathlib.Algebra.Algebra.Equiv
import Mathlib.RingTheory.RootsOfUnity.PrimitiveRoots

/-! # Field calculations for I2a
HC no distance; AV milestone no distance.
-/
noncomputable section
set_option maxHeartbeats 400000
namespace AlgebraicGeometry.TameMonomialCover.Helpers

/-- An automorphism of a field generated by the base and one element is determined by that element.
Source: Mathlib, RingHom.eq_of_eqOn_of_field_closure_eq_top. -/
theorem aut_ext
    {R K : Type*} [CommRing R] [Field K] [Algebra R K]
    (v : K) (hgen : Subfield.closure (Set.range (algebraMap R K) ∪ {v}) = ⊤)
    (d e : K ≃ₐ[R] K) (hv : d v = e v) : d = e := by
  have H : d.toRingHom = e.toRingHom :=
    RingHom.eq_of_eqOn_of_field_closure_eq_top hgen (by
      intro x hx
      rcases hx with ⟨r, rfl⟩ | hx
      · exact (d.commutes r).trans (e.commutes r).symm
      · exact Set.mem_singleton_iff.mp hx ▸ hv)
  ext x
  exact congrArg (fun f : K →+* K => f x) H

/-- The generator transforms by the corresponding power of its scalar multiplier.
Source: Mathlib, AlgEquiv.mul_apply and AlgEquiv.commutes. -/
theorem aut_pow_generator
    {R K : Type*} [CommRing R] [Field K] [Algebra R K]
    (d : K ≃ₐ[R] K) (v : K) (z : R)
    (hd : d v = algebraMap R K z * v) (k : ℕ) :
    (d ^ k) v = algebraMap R K z ^ k * v := by
  induction k with
  | zero => simp only [pow_zero, AlgEquiv.one_apply, one_mul]
  | succ k ih =>
    rw [pow_succ', AlgEquiv.mul_apply, ih, map_mul, map_pow,
      d.commutes, hd, pow_succ]
    ac_rfl

/-- Field generation and a root-of-unity multiplier bound the automorphism period.
Source: Mathlib, RingHom.eq_of_eqOn_of_field_closure_eq_top and map_pow. -/
theorem aut_pow_eq_one
    {R K : Type*} [CommRing R] [Field K] [Algebra R K]
    (v : K) (hgen : Subfield.closure (Set.range (algebraMap R K) ∪ {v}) = ⊤)
    (d : K ≃ₐ[R] K) (z : R) (hd : d v = algebraMap R K z * v)
    (m : ℕ) (hz : z ^ m = 1) : d ^ m = 1 := by
  apply aut_ext v hgen
  rw [aut_pow_generator d v z hd, ← map_pow, hz, map_one,
    one_mul, AlgEquiv.one_apply]

/-- Powers of the integral-closure action restrict powers of the field action.
Source: Mathlib, AlgEquiv.coe_mapIntegralClosure. -/
theorem integralClosure_pow_apply
    {R K : Type*} [CommRing R] [Field K] [Algebra R K]
    (d : K ≃ₐ[R] K) (k : ℕ) (b : integralClosure R K) :
    ((d.mapIntegralClosure ^ k) b : K) = (d ^ k) (b : K) := by
  induction k with
  | zero => rfl
  | succ k ih =>
    simp only [pow_succ', AlgEquiv.mul_apply, AlgEquiv.coe_mapIntegralClosure, ih]

/-- A period of the field action is a period of its integral-closure action.
Source: Mathlib, AlgEquiv.coe_mapIntegralClosure and Subtype.ext. -/
theorem integralClosure_pow_eq_one
    {R K : Type*} [CommRing R] [Field K] [Algebra R K]
    (d : K ≃ₐ[R] K) (m : ℕ) (hd : d ^ m = 1) :
    d.mapIntegralClosure ^ m = 1 := by
  ext b
  rw [integralClosure_pow_apply, hd]
  rfl

/-- A binomial generator with a positive power in the base is integral over the base.
Source: Mathlib, IsIntegral.of_pow and isIntegral_algebraMap. -/
theorem binomial_integral
    {R K : Type*} [CommRing R] [Field K] [Algebra R K]
    (m : ℕ) (hm : 0 < m) (q : R) (v : K)
    (hv : v ^ m = algebraMap R K q) : IsIntegral R v := by
  apply IsIntegral.of_pow hm
  rw [hv]
  exact isIntegral_algebraMap

/-- At a zero of its binomial coefficient, the integral generator has zero residue.
Source: Mathlib, map_pow and eq_zero_of_pow_eq_zero. -/
theorem binomial_residue_zero
    {R K F : Type*} [CommRing R] [Field K] [Field F] [Algebra R K]
    (m : ℕ) (hm : 0 < m) (q : R) (v : K)
    (hv : v ^ m = algebraMap R K q)
    (p : integralClosure R K →+* F)
    (hp : p (algebraMap R (integralClosure R K) q) = 0) :
    p ⟨v, binomial_integral m hm q v hv⟩ = 0 := by
  let V : integralClosure R K := ⟨v, binomial_integral m hm q v hv⟩
  have hV : V ^ m = algebraMap R (integralClosure R K) q := by
    apply Subtype.ext
    exact hv
  have hz : p V ^ m = 0 := by rw [← map_pow, hV, hp]
  exact eq_zero_of_pow_eq_zero hz

end AlgebraicGeometry.TameMonomialCover.Helpers
