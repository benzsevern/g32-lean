import HodgeLean.Foundations.Analytic.ComplexAnalyticSpaceDefs
import HodgeConjecture.Lemmas.AlgebraicGeometry.ComplexPoint.AffineScheme
import HodgeConjecture.Lemmas.AlgebraicGeometry.ComplexPoint.AffineSpace
import HodgeConjecture.Lemmas.AlgebraicGeometry.ComplexPoint.ClosedImmersion
import HodgeConjecture.Lemmas.AlgebraicGeometry.ComplexPoint.Open
import HodgeConjecture.Lemmas.AlgebraicGeometry.ComplexPoint.ProjectiveCompact
import HodgeConjecture.Lemmas.AlgebraicGeometry.ComplexPoint.ProjectiveHausdorff
import HodgeConjecture.Lemmas.AlgebraicGeometry.ComplexPoint.Manifold

/-! # Analytification of complex schemes: definitions

Track F4 of the full-formalization program. Concrete definitions, prefixed `f4_`.

The underlying space of the analytification of `X : Over (Spec ℂ)` is the type of complex points
`ComplexPoint X` with the upstream analytic topology `Point.analyticTopology` (the topology glued
from the affine charts, generated by the sets where a local regular function takes values in an
open subset of `ℂ`). This file builds the analytic atlas on it.

* **Algebraic charts.** An `f4_RawChart X` is an affine open `U`, finitely many regular functions
  `a₁, …, aₙ` on `U` (the coordinates) and finitely many polynomials `P₁, …, P_k` in `n`
  variables (the equations). Its chart map `toFun` evaluates the coordinates at a complex point
  (`Point.evaluate`), its equations `eqns` evaluate the polynomials. It is *generating*
  (`Generates`) if every regular function on `U` is, at the complex points of `U`, a polynomial
  in the coordinates; a *presentation* (`IsPresentation`) if moreover the polynomials vanishing
  at all the points read in the chart are exactly the ideal generated by the `Pⱼ`; *admissible*
  (`IsAdmissible`) if it is generating, the chart map embeds the points of `U` in `ℂⁿ`, and the
  image is the common zero set of the `Pⱼ`. An admissible raw chart is an `an_Chart` onto a local
  model cut out by polynomials (`f4_RawChart.toChart`).
* **The atlas and the space.** `f4_atlas X h` has all admissible raw charts as its charts, given a
  proof `h` that they cover the complex points. `f4_an X h ht2 hsc han` bundles it
  with proofs of the Hausdorff property, second countability and analyticity of the atlas into an
  `an_ReducedSpace`. The frozen file supplies the four proofs from its theorems.
* **Fibre products and projective space.** `f4_pullbackPair f g` sends a complex point of the
  fibre product `X ×_Y Z` (in `Over (Spec ℂ)`) to its two projections. `f4_projectiveSpace d` is
  `ℙᵈ_ℂ`, `f4_projOver Y d` is `ℙᵈ_Y` over `Spec ℂ` with its projection `f4_projToBase Y d`, and
  `f4_point` is `Spec ℂ` itself, with the structure maps `f4_toPoint X`. The point has one complex
  point, and its chart `f4_pointChart` (no coordinates, no equations) is an admissible
  presentation (`f4_pointChart_isPresentation`, `f4_pointChart_isAdmissible`).
* **Instances.** `f4_affineSpace n` (`𝔸ⁿ_ℂ`), the node `f4_node = Spec ℂ[x, y]/(xy)` with its
  coordinate equivalence `f4_nodeEquiv` onto `an_node` and its surjective structure map to the
  point (`f4_toPoint_node_surjective`), and the cusp chart `f4_cuspChart` of
  `𝔸¹` (coordinates `x², x³`, equation `w₁³ − w₂²`), which is not generating.

Nothing here states that the admissible charts cover, that the space is Hausdorff or second
countable, or that the atlas is analytic. The structure sheaf is the reduced one by construction,
so the space built from a nonreduced scheme is that of its reduction: nonreduced complex spaces
are out of scope. HC no distance; AV milestone no distance.
-/

noncomputable section

open Set Topology CategoryTheory CategoryTheory.Limits AlgebraicGeometry
open AlgebraicGeometry.ComplexPoint

namespace HodgeLean.Foundations.Analytic

/-! ### Algebraic charts -/

section RawChart

variable (X : Over (Spec ↧ℂ))

/-- An algebraic chart: an affine open `U` of `X`, regular functions `a₁, …, aₙ` on `U` (the
coordinates) and polynomials `P₁, …, P_k` in `n` variables (the equations). Nothing is assumed
about them; `f4_RawChart.IsAdmissible` says when they form a chart.
Source: Serre, *Géométrie algébrique et géométrie analytique*, Ann. Inst. Fourier 6 (1956), §2
(the analytic space associated with an algebraic variety, from affine pieces embedded in `ℂⁿ`);
SGA 1, Exposé XII, §1 (the analytification of a scheme locally of finite type over `ℂ`). -/
structure f4_RawChart where
  /-- The affine open. -/
  U : X.left.affineOpens
  /-- The number of coordinates. -/
  n : ℕ
  /-- The coordinates, regular functions on `U`. -/
  coord : Fin n → Γ(X.left, U.1)
  /-- The number of equations. -/
  k : ℕ
  /-- The equations, polynomials in the coordinates. -/
  eqn : Fin k → MvPolynomial (Fin n) ℂ

example (U : X.left.affineOpens) (a : Γ(X.left, U.1)) : (f4_RawChart.mk U 1 ![a] 0 ![]).n = 1 :=
  rfl

variable {X}

/-- The complex points lying over the affine open of the chart.
Source: SGA 1, Exposé XII, §1. -/
abbrev f4_RawChart.dom (r : f4_RawChart X) : Set (ComplexPoint X) :=
  Point.overOpen r.U.1

example (r : f4_RawChart X) (z : ComplexPoint X) : z ∈ r.dom ↔ z.underlying ∈ r.U.1 := Iff.rfl

/-- The chart map: the values of the coordinates at a complex point (`0` off `U`).
Source: Serre, GAGA, §2 (an affine variety in `ℂⁿ` given by its coordinate functions). -/
def f4_RawChart.toFun (r : f4_RawChart X) : ComplexPoint X → (Fin r.n → ℂ) :=
  fun z i ↦ Point.evaluate r.U.1 (r.coord i) z

example (r : f4_RawChart X) (z : ComplexPoint X) (i : Fin r.n) :
    r.toFun z i = Point.evaluate r.U.1 (r.coord i) z := rfl

/-- The equations, evaluated on `ℂⁿ`.
Source: Serre, GAGA, §2. -/
def f4_RawChart.eqns (r : f4_RawChart X) : (Fin r.n → ℂ) → (Fin r.k → ℂ) :=
  fun w j ↦ MvPolynomial.eval w (r.eqn j)

example (r : f4_RawChart X) (w : Fin r.n → ℂ) (j : Fin r.k) :
    r.eqns w j = MvPolynomial.eval w (r.eqn j) := rfl

/-- Polynomial equations are holomorphic on all of `ℂⁿ`. -/
theorem f4_RawChart.eqns_analytic (r : f4_RawChart X) : AnalyticOnNhd ℂ r.eqns univ :=
  fun w _ ↦ analyticAt_pi_iff.2 fun j ↦
    AnalyticOnNhd.eval_mvPolynomial (r.eqn j) w (mem_univ _)

/-- The chart is *generating*: every regular function on `U` is, at the complex points of `U`, a
polynomial in the coordinates.
Source: Serre, GAGA, §2 (the coordinate ring of an affine variety is generated by the coordinate
functions); Atiyah–Macdonald, Ch. 5 (finitely generated algebras). -/
def f4_RawChart.Generates (r : f4_RawChart X) : Prop :=
  ∀ s : Γ(X.left, r.U.1), ∃ p : MvPolynomial (Fin r.n) ℂ,
    ∀ z ∈ r.dom, Point.evaluate r.U.1 s z = MvPolynomial.eval (r.toFun z) p

/-- Every coordinate is a polynomial in the coordinates, so the clause of `Generates` holds for
each coordinate of any chart. -/
example (r : f4_RawChart X) (i : Fin r.n) : ∃ p : MvPolynomial (Fin r.n) ℂ,
    ∀ z ∈ r.dom, Point.evaluate r.U.1 (r.coord i) z = MvPolynomial.eval (r.toFun z) p :=
  ⟨MvPolynomial.X i, fun z _ ↦ by simp [f4_RawChart.toFun]⟩

/-- The chart is a *presentation*: it is generating, and a polynomial vanishes at every point read
in the chart exactly when it lies in the ideal generated by the equations.
Source: Serre, GAGA, §2; Hilbert's basis theorem (the vanishing ideal is finitely generated). -/
def f4_RawChart.IsPresentation (r : f4_RawChart X) : Prop :=
  r.Generates ∧ ∀ p : MvPolynomial (Fin r.n) ℂ,
    (∀ z ∈ r.dom, MvPolynomial.eval (r.toFun z) p = 0) ↔ p ∈ Ideal.span (range r.eqn)

/-- The equations of a presentation vanish at every point read in the chart. -/
example (r : f4_RawChart X) (h : r.IsPresentation) (j : Fin r.k) (z : ComplexPoint X)
    (hz : z ∈ r.dom) : r.eqns (r.toFun z) j = 0 :=
  (h.2 (r.eqn j)).2 (Ideal.subset_span (mem_range_self j)) z hz

/-- The chart is *admissible*: it is generating, the chart map embeds the points over `U` in
`ℂⁿ`, and their image is the common zero set of the equations.
Source: Serre, GAGA, §2; SGA 1, Exposé XII, §1 (the analytic structure is the one for which the
affine pieces are closed analytic subspaces of `ℂⁿ`). -/
def f4_RawChart.IsAdmissible (r : f4_RawChart X) : Prop :=
  r.Generates ∧ IsEmbedding (r.dom.domRestrict r.toFun) ∧
    r.toFun '' r.dom = an_zeroLocus univ r.eqns

/-- The chart map of an admissible chart is injective on the points over `U`. -/
example (r : f4_RawChart X) (h : r.IsAdmissible) : InjOn r.toFun r.dom :=
  fun z hz z' hz' e ↦ congrArg Subtype.val (h.2.1.injective (a₁ := ⟨z, hz⟩) (a₂ := ⟨z', hz'⟩) e)

/-- An admissible raw chart as a chart onto the local model cut out in `ℂⁿ` by its equations.
Source: Serre, GAGA, §2; Grauert–Remmert, *Coherent Analytic Sheaves*, §1.1.5. -/
def f4_RawChart.toChart (r : f4_RawChart X) (h : r.IsAdmissible) : an_Chart (ComplexPoint X) where
  dom := r.dom
  isOpen_dom := Point.isOpen_overOpen _
  n := r.n
  U := univ
  isOpen_U := isOpen_univ
  k := r.k
  eqns := r.eqns
  analyticOnNhd_eqns := r.eqns_analytic
  toFun := r.toFun
  isEmbedding := h.2.1
  image_eq := h.2.2

example (r : f4_RawChart X) (h : r.IsAdmissible) : (r.toChart h).dom = r.dom := rfl

variable (X)

/-- The admissible raw charts.
Source: SGA 1, Exposé XII, §1. -/
abbrev f4_AdmChart : Type := {r : f4_RawChart X // r.IsAdmissible}

example (r : f4_AdmChart X) : r.1.IsAdmissible := r.2

/-- The atlas of all admissible algebraic charts, given that they cover.
Source: Serre, GAGA, §2; SGA 1, Exposé XII, §1. -/
def f4_atlas (h : ∀ z : ComplexPoint X, ∃ r : f4_AdmChart X, z ∈ r.1.dom) :
    an_Atlas (ComplexPoint X) where
  ι := f4_AdmChart X
  chart r := r.1.toChart r.2
  covers := h

example (h : ∀ z : ComplexPoint X, ∃ r : f4_AdmChart X, z ∈ r.1.dom) (r : f4_AdmChart X) :
    ((f4_atlas X h).chart r).toFun = r.1.toFun :=
  rfl

/-- The analytification as a reduced complex analytic space, from proofs that the admissible
charts cover, that the analytic topology is Hausdorff and second countable, and that the atlas is
analytic. The frozen file supplies them (`f4_analytification`).
Source: Serre, GAGA, §2; SGA 1, Exposé XII, §1; Grauert–Remmert, *Coherent Analytic Sheaves*,
§1.1.5. -/
def f4_an (hcov : ∀ z : ComplexPoint X, ∃ r : f4_AdmChart X, z ∈ r.1.dom)
    (ht2 : T2Space (ComplexPoint X))
    (hsc : SecondCountableTopology (ComplexPoint X)) (han : (f4_atlas X hcov).IsAnalytic) :
    an_ReducedSpace (ComplexPoint X) where
  t2Space := ht2
  secondCountable := hsc
  atlas := f4_atlas X hcov
  isAnalytic := han

example (hcov : ∀ z : ComplexPoint X, ∃ r : f4_AdmChart X, z ∈ r.1.dom)
    (ht2 : T2Space (ComplexPoint X))
    (hsc : SecondCountableTopology (ComplexPoint X)) (han : (f4_atlas X hcov).IsAnalytic) :
    (f4_an X hcov ht2 hsc han).atlas = f4_atlas X hcov := rfl

end RawChart

/-! ### Fibre products, projective space and the point -/

section Products

/-- A complex point of the fibre product `X ×_Y Z` and its two projections.
Source: SGA 1, Exposé XII, §1 (analytification commutes with fibre products); EGA I, §3.4
(points of a fibre product). -/
def f4_pullbackPair {X Y Z : Over (Spec ↧ℂ)} (f : X ⟶ Y) (g : Z ⟶ Y) :
    ComplexPoint (pullback f g) → ComplexPoint X × ComplexPoint Z :=
  fun z ↦ (Point.map (pullback.fst f g) z, Point.map (pullback.snd f g) z)

/-- The two projections of a point of the fibre product agree in `Y`. -/
example {X Y Z : Over (Spec ↧ℂ)} (f : X ⟶ Y) (g : Z ⟶ Y) (z : ComplexPoint (pullback f g)) :
    Point.map f (f4_pullbackPair f g z).1 = Point.map g (f4_pullbackPair f g z).2 := by
  simp only [f4_pullbackPair, Point.map, Category.assoc, pullback.condition]

/-- Complex projective space `ℙᵈ_ℂ` over `Spec ℂ`.
Source: Hartshorne, *Algebraic Geometry*, Ch. II, §7 (projective space over a base). -/
abbrev f4_projectiveSpace (d : ℕ) : Over (Spec ↧ℂ) :=
  Over.mk (ProjectiveSpace.toBase (Fin (d + 1)) (Spec ↧ℂ))

example (d : ℕ) : (f4_projectiveSpace d).hom = ProjectiveSpace.toBase (Fin (d + 1)) (Spec ↧ℂ) :=
  rfl

/-- Projective space `ℙᵈ_Y` over a complex scheme `Y`, as a scheme over `Spec ℂ`.
Source: Hartshorne, *Algebraic Geometry*, Ch. II, §7 (`ℙⁿ_Y = ℙⁿ_ℤ ×_ℤ Y`). -/
def f4_projOver (Y : Over (Spec ↧ℂ)) (d : ℕ) : Over (Spec ↧ℂ) :=
  Over.mk (ProjectiveSpace.toBase (Fin (d + 1)) Y.left ≫ Y.hom)

example (Y : Over (Spec ↧ℂ)) (d : ℕ) :
    (f4_projOver Y d).hom = ProjectiveSpace.toBase (Fin (d + 1)) Y.left ≫ Y.hom := rfl

/-- The projection `ℙᵈ_Y → Y` over `Spec ℂ`.
Source: Hartshorne, *Algebraic Geometry*, Ch. II, §7. -/
def f4_projToBase (Y : Over (Spec ↧ℂ)) (d : ℕ) : f4_projOver Y d ⟶ Y :=
  Over.homMk (ProjectiveSpace.toBase (Fin (d + 1)) Y.left) rfl

example (Y : Over (Spec ↧ℂ)) (d : ℕ) :
    (f4_projToBase Y d).left = ProjectiveSpace.toBase (Fin (d + 1)) Y.left := rfl

/-- The point `Spec ℂ`, the terminal object of `Over (Spec ℂ)`.
Source: EGA I, §3.3 (the `S`-scheme `S`). -/
abbrev f4_point : Over (Spec ↧ℂ) := Over.mk (𝟙 (Spec ↧ℂ))

example : f4_point.hom = 𝟙 (Spec ↧ℂ) := rfl

/-- The structure map of a complex scheme, to the point.
Source: EGA I, §3.3. -/
def f4_toPoint (X : Over (Spec ↧ℂ)) : X ⟶ f4_point :=
  Over.homMk X.hom (Category.comp_id _)

example (X : Over (Spec ↧ℂ)) : (f4_toPoint X).left = X.hom := rfl

instance f4_projectiveSpace_locallyOfFiniteType (d : ℕ) :
    LocallyOfFiniteType (f4_projectiveSpace d).hom :=
  inferInstanceAs (LocallyOfFiniteType (ProjectiveSpace.toBase (Fin (d + 1)) (Spec ↧ℂ)))

instance f4_projectiveSpace_quasiCompact (d : ℕ) : QuasiCompact (f4_projectiveSpace d).hom :=
  inferInstanceAs (QuasiCompact (ProjectiveSpace.toBase (Fin (d + 1)) (Spec ↧ℂ)))

instance f4_projectiveSpace_isSeparated (d : ℕ) : IsSeparated (f4_projectiveSpace d).hom :=
  inferInstanceAs (IsSeparated (ProjectiveSpace.toBase (Fin (d + 1)) (Spec ↧ℂ)))

instance f4_point_locallyOfFiniteType : LocallyOfFiniteType f4_point.hom :=
  inferInstanceAs (LocallyOfFiniteType (𝟙 (Spec ↧ℂ)))

instance f4_point_quasiCompact : QuasiCompact f4_point.hom :=
  inferInstanceAs (QuasiCompact (𝟙 (Spec ↧ℂ)))

instance f4_point_isSeparated : IsSeparated f4_point.hom :=
  inferInstanceAs (IsSeparated (𝟙 (Spec ↧ℂ)))

/-- `ℙᵈ_ℂ` is projective over the point: the identity is a presentation. -/
instance f4_projectiveSpace_isProjective (d : ℕ) :
    IsProjective (f4_toPoint (f4_projectiveSpace d)).left :=
  ⟨⟨{ ambientDimension := d
      immersion := 𝟙 _
      immersion_toBase := Category.id_comp _ }⟩⟩

/-- The point has exactly one complex point, the identity: a morphism `Spec ℂ → Spec ℂ` over
`Spec ℂ` is the identity.
Source: EGA I, §3.3 (the `S`-scheme `S` is terminal among `S`-schemes). -/
instance f4_point_subsingleton : Subsingleton (ComplexPoint f4_point) := by
  constructor
  intro a b
  ext
  have ha := Over.w a
  have hb := Over.w b
  simp only [Over.mk_left, Over.mk_hom,
    Category.comp_id] at ha hb
  rw [ha, hb]

example (z : ComplexPoint f4_point) : z = 𝟙 f4_point := Subsingleton.elim _ _

instance f4_point_isAffine : IsAffine f4_point.left := inferInstanceAs (IsAffine (Spec ↧ℂ))

end Products

/-! ### The chart of the point -/

section PointChart

/-- The chart of the point: the affine open `Spec ℂ` itself, no coordinates and no equations. It
reads the one complex point as the one point of `ℂ⁰`, and is an admissible presentation.
Source: Serre, GAGA, §2 (the analytic space of `Spec ℂ` is a point); EGA I, §3.3. -/
def f4_pointChart : f4_RawChart f4_point where
  U := ⟨⊤, isAffineOpen_top _⟩
  n := 0
  coord := ![]
  k := 0
  eqn := ![]

example : f4_pointChart.n = 0 ∧ f4_pointChart.k = 0 := ⟨rfl, rfl⟩

/-- The one complex point lies over the affine open of the chart of the point. -/
theorem f4_pointChart_mem_dom (z : ComplexPoint f4_point) : z ∈ f4_pointChart.dom := by
  show z.underlying ∈ (⊤ : f4_point.left.Opens)
  trivial

/-- The chart of the point is generating: every regular function is the constant polynomial of its
value at the one complex point. -/
theorem f4_pointChart_generates : f4_pointChart.Generates := by
  intro s
  refine ⟨MvPolynomial.C (Point.evaluate f4_pointChart.U.1 s (𝟙 _)), fun z _ ↦ ?_⟩
  rw [MvPolynomial.eval_C, Subsingleton.elim z (𝟙 _)]

/-- The chart of the point is a presentation: a polynomial in no variables vanishes at the point
exactly when it is `0`, the ideal spanned by no equations. -/
theorem f4_pointChart_isPresentation : f4_pointChart.IsPresentation := by
  refine ⟨f4_pointChart_generates, fun p ↦ ?_⟩
  rw [@range_eq_empty _ _ (inferInstanceAs (IsEmpty (Fin 0))), Ideal.span_empty]
  refine ⟨fun h ↦ Ideal.mem_bot.2 ?_, fun h z _ ↦ by rw [Ideal.mem_bot.1 h, map_zero]⟩
  change MvPolynomial (Fin 0) ℂ at p
  have h0 : MvPolynomial.eval (Fin.elim0 : Fin 0 → ℂ) p = 0 :=
    (congrArg (MvPolynomial.eval · p) (funext fun j : Fin 0 ↦ j.elim0)).trans
      (h (𝟙 _) (f4_pointChart_mem_dom _))
  rw [MvPolynomial.eq_C_of_isEmpty p, MvPolynomial.eval_C] at h0
  rw [MvPolynomial.eq_C_of_isEmpty p, h0, map_zero]
  rfl

/-- The chart of the point is admissible: a map between one-point spaces is an embedding, and the
zero set of no equations in `ℂ⁰` is its one point. -/
theorem f4_pointChart_isAdmissible : f4_pointChart.IsAdmissible := by
  refine ⟨f4_pointChart_generates, ?_, ?_⟩
  · have : Subsingleton f4_pointChart.dom := inferInstance
    exact ⟨⟨Subsingleton.elim _ _⟩, fun a b _ ↦ Subsingleton.elim a b⟩
  · ext w
    simp only [mem_image, an_zeroLocus, mem_ofPred_eq, mem_univ, true_and]
    exact ⟨fun _ ↦ funext fun j : Fin 0 ↦ j.elim0,
      fun _ ↦ ⟨𝟙 _, f4_pointChart_mem_dom _, funext fun j : Fin 0 ↦ j.elim0⟩⟩

example : f4_AdmChart f4_point := ⟨f4_pointChart, f4_pointChart_isAdmissible⟩

end PointChart

/-! ### Instances: affine space, the node, the cusp chart -/

section Instances

/-- Affine space `𝔸ⁿ_ℂ` over `Spec ℂ`.
Source: Hartshorne, *Algebraic Geometry*, Ch. II, §2 (`𝔸ⁿ = Spec ℂ[x₁, …, xₙ]`). -/
abbrev f4_affineSpace (n : ℕ) : Over (Spec ↧ℂ) :=
  Over.mk (complexAffineSpace (Fin n) ↘ Spec ↧ℂ)

example (n : ℕ) : (f4_affineSpace n).left = complexAffineSpace (Fin n) := rfl

instance f4_affineSpace_locallyOfFiniteType (n : ℕ) :
    LocallyOfFiniteType (f4_affineSpace n).hom :=
  inferInstanceAs (LocallyOfFiniteType (complexAffineSpace (Fin n) ↘ Spec ↧ℂ))

instance f4_affineSpace_quasiCompact (n : ℕ) : QuasiCompact (f4_affineSpace n).hom :=
  inferInstanceAs (QuasiCompact (complexAffineSpace (Fin n) ↘ Spec ↧ℂ))

instance f4_affineSpace_isSeparated (n : ℕ) : IsSeparated (f4_affineSpace n).hom :=
  inferInstanceAs (IsSeparated (complexAffineSpace (Fin n) ↘ Spec ↧ℂ))

instance f4_affineSpace_isAffine (n : ℕ) : IsAffine (f4_affineSpace n).left :=
  inferInstanceAs (IsAffine (complexAffineSpace (Fin n)))

/-- The coordinate ring `ℂ[x, y]/(xy)` of the node.
Source: Hartshorne, *Algebraic Geometry*, Ch. I, Exercise 5.6 (the node `xy = 0`). -/
abbrev f4_nodeRing : Type :=
  MvPolynomial (Fin 2) ℂ ⧸
    Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) ℂ)}

example : (Ideal.Quotient.mk _ (MvPolynomial.X 0 * MvPolynomial.X 1) : f4_nodeRing) = 0 :=
  Ideal.Quotient.eq_zero_iff_mem.2 (Ideal.subset_span rfl)

/-- The node `Spec ℂ[x, y]/(xy)` over `Spec ℂ`.
Source: Hartshorne, *Algebraic Geometry*, Ch. I, Exercise 5.6. -/
abbrev f4_node : Over (Spec ↧ℂ) := Over.mk (affineSpecStructureMap f4_nodeRing)

example : f4_node.hom = affineSpecStructureMap f4_nodeRing := rfl

/-- The node is of finite type over `ℂ`. -/
instance f4_node_locallyOfFiniteType : LocallyOfFiniteType f4_node.hom := by
  change LocallyOfFiniteType (affineSpecStructureMap f4_nodeRing)
  rw [HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)]
  exact RingHom.finiteType_algebraMap.mpr inferInstance

instance f4_node_quasiCompact : QuasiCompact f4_node.hom :=
  inferInstanceAs (QuasiCompact (affineSpecStructureMap f4_nodeRing))

instance f4_node_isSeparated : IsSeparated f4_node.hom :=
  inferInstanceAs (IsSeparated (affineSpecStructureMap f4_nodeRing))

/-- The algebra map `ℂ[x, y]/(xy) → ℂ` of a point of the node `{z₀ z₁ = 0} ⊆ ℂ²`: evaluation at
the point, which kills `xy`.
Source: Hartshorne, *Algebraic Geometry*, Ch. I, §1 (a point of the zero set of an ideal gives the
evaluation map of the coordinate ring); Atiyah–Macdonald, *Introduction to Commutative Algebra*,
Ch. 1 (a ring map vanishing on an ideal factors through the quotient). -/
def f4_nodeAlgHom (w : an_node) : f4_nodeRing →ₐ[ℂ] ℂ :=
  Ideal.Quotient.liftₐ _ (MvPolynomial.aeval (w : Fin 2 → ℂ)) (by
    intro a ha
    obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton'.1 ha
    have hw : (w : Fin 2 → ℂ) 0 * (w : Fin 2 → ℂ) 1 = 0 := congrFun w.2.2 0
    simp [hw])

example (w : an_node) (i : Fin 2) :
    f4_nodeAlgHom w (Ideal.Quotient.mk _ (MvPolynomial.X i)) = (w : Fin 2 → ℂ) i := by
  simp [f4_nodeAlgHom]

/-- The values of the two coordinates at a complex point of the node lie on `{z₀ z₁ = 0}`.
Source: `affineSpecEquiv` (complex points of `Spec R` are `ℂ`-algebra maps `R → ℂ`); Hartshorne,
*Algebraic Geometry*, Ch. I, §1 (the points of an affine variety lie on the zero set of its
ideal). -/
def f4_nodeCoord (z : ComplexPoint f4_node) : an_node :=
  ⟨fun i ↦ affineSpecEquiv f4_nodeRing z (Ideal.Quotient.mk _ (MvPolynomial.X i)), mem_univ _, by
    funext j
    have h0 : (Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 :
        MvPolynomial (Fin 2) ℂ)})) (MvPolynomial.X 0 * MvPolynomial.X 1) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.2 (Ideal.subset_span rfl)
    have h := congrArg (affineSpecEquiv f4_nodeRing z) h0
    rw [map_mul, map_mul, map_zero] at h
    simpa [an_nodeEqn] using h⟩

example (z : ComplexPoint f4_node) (i : Fin 2) :
    (f4_nodeCoord z : Fin 2 → ℂ) i =
      affineSpecEquiv f4_nodeRing z (Ideal.Quotient.mk _ (MvPolynomial.X i)) := rfl

/-- The complex points of the node are the points of `{z₀ z₁ = 0} ⊆ ℂ²`, by their coordinates.
Source: Hartshorne, *Algebraic Geometry*, Ch. I, §1 (points of an affine variety as the zero set
of its ideal); `affineSpecEquiv` (complex points of `Spec R` are `ℂ`-algebra maps `R → ℂ`). -/
def f4_nodeEquiv : ComplexPoint f4_node ≃ an_node where
  toFun := f4_nodeCoord
  invFun w := (affineSpecEquiv f4_nodeRing).symm (f4_nodeAlgHom w)
  left_inv z := by
    apply (affineSpecEquiv f4_nodeRing).injective
    rw [Equiv.apply_symm_apply]
    apply Ideal.Quotient.algHom_ext
    apply MvPolynomial.algHom_ext
    intro i
    simp [f4_nodeAlgHom, f4_nodeCoord]
  right_inv w := by
    apply Subtype.ext
    funext i
    simp [f4_nodeAlgHom, f4_nodeCoord]

example (z : ComplexPoint f4_node) : f4_nodeEquiv z = f4_nodeCoord z := rfl

/-- The node maps onto the point: it has a complex point (the origin), and the point `Spec ℂ` has
one point.
Source: Hartshorne, *Algebraic Geometry*, Ch. II, §2 (`Spec` of a field is one point, and `Spec`
of a nonzero ring is nonempty). -/
instance f4_toPoint_node_surjective : Surjective (f4_toPoint f4_node).left := by
  constructor
  intro x
  obtain ⟨z⟩ : Nonempty (ComplexPoint f4_node) := ⟨f4_nodeEquiv.symm ⟨0, mem_univ _, by
    funext j; simp [an_nodeEqn]⟩⟩
  refine ⟨z.underlying, ?_⟩
  have : Subsingleton (PrimeSpectrum ℂ) := inferInstance
  exact this.elim _ _

example : Function.Surjective (f4_toPoint f4_node).left.base :=
  (f4_toPoint_node_surjective).surj

/-- The cusp chart of `𝔸¹`: the affine open `𝔸¹` itself, the coordinates `x²` and `x³`, and the
equation `w₁³ − w₂²` of the cusp. Its chart map `z ↦ (z², z³)` is a homeomorphism onto the cusp,
but `x` is not a polynomial in `x²` and `x³` near `0`, so it is not generating.
Source: Hartshorne, *Algebraic Geometry*, Ch. I, Exercise 3.2 (the cusp `y² = x³` and its
bijective, non-isomorphic parametrization by `𝔸¹`). -/
def f4_cuspChart : f4_RawChart (f4_affineSpace 1) where
  U := ⟨⊤, isAffineOpen_top _⟩
  n := 2
  coord := ![AffineSpace.coord (Spec ↧ℂ) 0 ^ 2, AffineSpace.coord (Spec ↧ℂ) 0 ^ 3]
  k := 1
  eqn := ![MvPolynomial.X 0 ^ 3 - MvPolynomial.X 1 ^ 2]

example : f4_cuspChart.n = 2 := rfl

example (w : Fin 2 → ℂ) : f4_cuspChart.eqns w (0 : Fin 1) = w 0 ^ 3 - w 1 ^ 2 := by
  show MvPolynomial.eval w (MvPolynomial.X 0 ^ 3 - MvPolynomial.X 1 ^ 2) = _
  simp

end Instances

end HodgeLean.Foundations.Analytic
