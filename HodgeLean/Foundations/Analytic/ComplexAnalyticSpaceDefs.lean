import HodgeLean.Foundations.AnalyticSubset
import HodgeLean.Foundations.AnalyticGermDimensionDefs

/-! # Reduced complex analytic spaces: definitions

Track F2 of the full-formalization program. Concrete definitions, prefixed `an_`.

* **Local models.** `an_zeroLocus U f` is the common zero set in an open `U ⊆ ℂⁿ` of a map
  `f : ℂⁿ → ℂᵏ` holomorphic on `U`; `an_IsLocalModel` says a set is one. The holomorphic
  functions on `U` form the ring `an_holRing U`, the functions vanishing on `Z` the reduced ideal
  `an_reducedIdeal U Z` (all of them, not only those generated by the `fᵢ`), and restriction is
  `an_restrict`. The sheaf `an_structureSheaf Z` of one model is the sheaf of functions on `Z`
  that are locally restrictions of holomorphic functions on open subsets of `ℂⁿ`
  (`an_IsLocRestr`).
* **Charts and atlases.** An `an_Chart X` is an open `dom ⊆ X` with a map to `ℂⁿ` restricting to a
  homeomorphism of `dom` onto a local model (`an_Chart.toModel`). An `an_Atlas X` is a family of
  charts covering `X`. A map `g : X → ℂᵐ` is holomorphic on `S` (`an_Atlas.IsHolOn`) if in every
  chart it is locally the restriction of a holomorphic map of the ambient `ℂⁿ`; the atlas is
  analytic (`an_Atlas.IsAnalytic`) if every chart map is holomorphic in every chart.
* **The glued structure sheaf.** A function `g : U → ℂ` on `U ⊆ X` is holomorphic
  (`an_Atlas.IsHolFun`) if in each chart it is, near each point, the restriction of a function
  holomorphic at the image point: the local predicate of the models, transported along the charts.
  These functions form a subring `an_Atlas.holSubring U`, a local predicate
  `an_Atlas.holPredicate`, the sheaf of types `an_Atlas.holSheafTypes`, and the sheaf of
  commutative rings `an_Atlas.holSheafRing` on `X`, whose stalks carry the evaluation
  `an_Atlas.evalStalk x` at the point.
* **Reduced complex analytic spaces.** `an_ReducedSpace X` bundles a Hausdorff, second-countable
  topology on `X` with an analytic atlas. Its structure sheaf `an_ReducedSpace.structureSheaf` is
  the sheaf of commutative rings glued from the charts, constructed, not stored.
* **Maps and subsets.** `an_IsHom` (continuous maps pulling holomorphic functions back to
  holomorphic functions: morphisms of the function sheaves), `an_IsProperHom`,
  `an_IsClosedAnalytic` (closed, locally the common zero set of finitely many sections of the
  structure sheaf), `an_IsLocallyAnalyticAt` (locally near one point the trace of a closed
  analytic subset).
* **Dimension.** `an_dimAt S Z x` is the Krull dimension of the reduced analytic local ring of the
  germ of `Z` at `x`, read in a chosen chart (`adim2_dimension`); `an_dim` is the case `Z = univ`.
  `an_IsRegularOfDim` (near `y`, `Z` is a `d`-dimensional complex submanifold) and `an_geomDim`
  (the local maximum of the dimensions of nearby manifold points) give the geometric dimension.
* **Instances.** `an_euclidSpace n` on `ℂⁿ`, `an_modelSpace U f` on a local model (for instance the
  node `an_nodeSpace` on `an_node = {z₀ z₁ = 0}`) with its closed embedding into `ℂⁿ`
  (`an_modelSpace_val_isProperHom`), and `an_manifoldSpace E M` on a Hausdorff, second-countable
  analytic manifold charted on a finite-dimensional `E` (its atlas is analytic:
  `an_manifoldAtlas_isAnalytic`).

Nothing here states that a stalk is local, that a dimension has a value, or that a set is closed
analytic. HC no distance; AV milestone no distance.
-/

noncomputable section

open Set Filter Topology TopologicalSpace CategoryTheory
open scoped ContDiff Manifold

namespace HodgeLean.Foundations.Analytic

open HodgeLean.Foundations

/-! ### Local models -/

section LocalModel

variable {n k : ℕ}

/-- The common zero set in `U ⊆ ℂⁿ` of a map `f : ℂⁿ → ℂᵏ`, that is of its `k` coordinates.
Source: Grauert–Remmert, *Coherent Analytic Sheaves*, §1.1.1 (model spaces: the zero set
`N(f₁, …, f_k) ⊆ D` of finitely many holomorphic functions on a domain `D ⊆ ℂⁿ`). -/
def an_zeroLocus (U : Set (Fin n → ℂ)) (f : (Fin n → ℂ) → (Fin k → ℂ)) : Set (Fin n → ℂ) :=
  {z | z ∈ U ∧ f z = 0}

example : an_zeroLocus (univ : Set (Fin 1 → ℂ)) (fun z ↦ fun _ : Fin 1 ↦ z 0) = {0} := by
  ext z
  simp only [an_zeroLocus, mem_univ, true_and, mem_ofPred_eq, mem_singleton_iff]
  constructor
  · intro h; funext i; fin_cases i; exact congrFun h 0
  · rintro rfl; rfl

/-- A *local model*: a subset of `ℂⁿ` which is the common zero set, in some open `U`, of finitely
many functions holomorphic on `U`.
Source: Grauert–Remmert, *Coherent Analytic Sheaves*, §1.1.1 (model spaces);
Gunning–Rossi, *Analytic Functions of Several Complex Variables*, Ch. V, §A (local models). -/
def an_IsLocalModel (n : ℕ) (Z : Set (Fin n → ℂ)) : Prop :=
  ∃ (U : Set (Fin n → ℂ)) (k : ℕ) (f : (Fin n → ℂ) → (Fin k → ℂ)),
    IsOpen U ∧ AnalyticOnNhd ℂ f U ∧ Z = an_zeroLocus U f

example : an_IsLocalModel 1 univ :=
  ⟨univ, 0, 0, isOpen_univ, analyticOnNhd_const, by
    ext z; simp [an_zeroLocus]⟩

/-- The ring of holomorphic functions on `U ⊆ ℂⁿ`: the functions on `U` that are restrictions of a
function analytic at every point of `U`.
Source: Grauert–Remmert, *Coherent Analytic Sheaves*, §1.1.1 (the sheaf `𝒪_D` of holomorphic
functions on a domain `D`). -/
def an_holRing (U : Set (Fin n → ℂ)) : Subring (U → ℂ) where
  carrier := {g | ∃ G : (Fin n → ℂ) → ℂ, AnalyticOnNhd ℂ G U ∧ ∀ z : U, g z = G z}
  zero_mem' := ⟨0, analyticOnNhd_const, fun _ ↦ rfl⟩
  one_mem' := ⟨1, analyticOnNhd_const, fun _ ↦ rfl⟩
  add_mem' := by
    rintro _ _ ⟨G, hG, h⟩ ⟨H, hH, h'⟩
    exact ⟨G + H, hG.add hH, fun z ↦ by simp [h z, h' z]⟩
  neg_mem' := by
    rintro _ ⟨G, hG, h⟩
    exact ⟨-G, hG.neg, fun z ↦ by simp [h z]⟩
  mul_mem' := by
    rintro _ _ ⟨G, hG, h⟩ ⟨H, hH, h'⟩
    exact ⟨G * H, hG.mul hH, fun z ↦ by simp [h z, h' z]⟩

example (U : Set (Fin n → ℂ)) : (1 : U → ℂ) ∈ an_holRing U := (an_holRing U).one_mem

/-- The *reduced* ideal `I_Z`: all holomorphic functions on `U` vanishing at every point of `Z`.
Source: Grauert–Remmert, *Coherent Analytic Sheaves*, §4.1 (the full ideal sheaf `𝒥(A)` of an
analytic set, and the reduction `A_red = (A, 𝒪_D/𝒥(A))`). -/
def an_reducedIdeal (U : Set (Fin n → ℂ)) (Z : Set (Fin n → ℂ)) : Ideal (an_holRing U) where
  carrier := {g | ∀ z : U, (z : Fin n → ℂ) ∈ Z → (g : U → ℂ) z = 0}
  zero_mem' := fun _ _ ↦ rfl
  add_mem' := by
    intro a b ha hb z hz
    simp [ha z hz, hb z hz]
  smul_mem' := by
    intro c a ha z hz
    simp [ha z hz]

example (U Z : Set (Fin n → ℂ)) : (0 : an_holRing U) ∈ an_reducedIdeal U Z :=
  (an_reducedIdeal U Z).zero_mem

/-- Restriction of holomorphic functions on `U` to a subset `Z ⊆ U`.
Source: Grauert–Remmert, *Coherent Analytic Sheaves*, §1.1.1 (the structure map
`𝒪_D → 𝒪_D/𝒥`). -/
def an_restrict (U Z : Set (Fin n → ℂ)) (h : Z ⊆ U) : an_holRing U →+* (Z → ℂ) where
  toFun g z := (g : U → ℂ) ⟨z, h z.2⟩
  map_one' := rfl
  map_mul' _ _ := rfl
  map_zero' := rfl
  map_add' _ _ := rfl

example (U Z : Set (Fin n → ℂ)) (h : Z ⊆ U) : an_restrict U Z h 1 = 1 := map_one _

/-- A function on a subset `S` of a set `Z ⊆ ℂⁿ` is *locally a restriction of holomorphic
functions*: each point of `S` has an open neighbourhood `W ⊆ ℂⁿ` and a function `G` holomorphic on
`W` agreeing with it at the points of `S` in `W`. Such a function is continuous.
Source: Grauert–Remmert, *Coherent Analytic Sheaves*, §4.1 (holomorphic functions on a reduced
model space are the local restrictions of ambient holomorphic functions). -/
def an_IsLocRestr (Z : Set (Fin n → ℂ)) {S : Set Z} (g : S → ℂ) : Prop :=
  ∀ x : S, ∃ W : Set (Fin n → ℂ), IsOpen W ∧ ((x : Z) : Fin n → ℂ) ∈ W ∧
    ∃ G : (Fin n → ℂ) → ℂ, AnalyticOnNhd ℂ G W ∧
      ∀ y : S, ((y : Z) : Fin n → ℂ) ∈ W → g y = G ((y : Z) : Fin n → ℂ)

example (Z : Set (Fin n → ℂ)) : an_IsLocRestr Z (fun _ : (univ : Set Z) ↦ (1 : ℂ)) :=
  fun _ ↦ ⟨univ, isOpen_univ, mem_univ _, 1, analyticOnNhd_const, fun _ _ ↦ rfl⟩

/-- Local restriction of holomorphic functions is a local predicate on the open subsets of `Z`.
Source: Grauert–Remmert, *Coherent Analytic Sheaves*, §4.1 (the sheaf of holomorphic functions on
a reduced model space); Hartshorne, *Algebraic Geometry*, Ch. II, §1 (sheaves of functions defined
by a local condition). -/
def an_locRestrPredicate (Z : Set (Fin n → ℂ)) :
    TopCat.LocalPredicate (X := TopCat.of Z) (fun _ ↦ ℂ) where
  pred {U} g := an_IsLocRestr Z (S := (U : Set Z)) g
  res {U V} i g hg := by
    intro x
    obtain ⟨W, hW, hxW, G, hG, hgG⟩ := hg ⟨x.1, (leOfHom i) x.2⟩
    exact ⟨W, hW, hxW, G, hG, fun y hy ↦ hgG ⟨y.1, (leOfHom i) y.2⟩ hy⟩
  locality {U} g hg := by
    intro x
    obtain ⟨V, hxV, i, hV⟩ := hg x
    obtain ⟨W, hW, hxW, G, hG, hgG⟩ := hV ⟨x, hxV⟩
    obtain ⟨O, hO, hOV⟩ := isOpen_induced_iff.1 V.isOpen
    have hxO : ((x : Z) : Fin n → ℂ) ∈ O := by
      have : (x : Z) ∈ Subtype.val ⁻¹' O := hOV ▸ hxV
      exact this
    refine ⟨W ∩ O, hW.inter hO, ⟨hxW, hxO⟩, G, hG.mono inter_subset_left, fun y hy ↦ ?_⟩
    have hyV : (y : Z) ∈ (V : Set Z) := by
      rw [← hOV]; exact hy.2
    exact hgG ⟨y, hyV⟩ hy.1

/-- The structure sheaf of one model `Z ⊆ ℂⁿ`, as a sheaf of types: on an open `S ⊆ Z`, the
functions that are locally restrictions of holomorphic functions. The structure sheaf of a space,
glued from its charts and valued in commutative rings, is `an_ReducedSpace.structureSheaf`; on a
chart domain it agrees with this one (`an_chart_restrict`). For a local model
`Z = an_zeroLocus U f` its sections near a point are the quotient of the holomorphic functions by
the reduced ideal (`𝒪_U / I_Z`).
Source: Grauert–Remmert, *Coherent Analytic Sheaves*, §4.1 (reduced model spaces). -/
def an_structureSheaf (Z : Set (Fin n → ℂ)) : TopCat.Sheaf (Type) (TopCat.of Z) :=
  TopCat.subsheafToTypes (an_locRestrPredicate Z)

example (Z : Set (Fin n → ℂ)) : TopCat.Sheaf (Type) (TopCat.of Z) := an_structureSheaf Z

end LocalModel


/-! ### Charts and atlases -/

section Atlas

universe u

/-- A chart onto a local model: an open `dom ⊆ X` and a map `toFun : X → ℂⁿ` whose restriction to
`dom` is a homeomorphism onto the zero set `an_zeroLocus U eqns` of a map `eqns` holomorphic on an
open `U ⊆ ℂⁿ`. Only the values of `toFun` on `dom` matter.
Source: Grauert–Remmert, *Coherent Analytic Sheaves*, §1.1.5 (complex spaces are locally
isomorphic to model spaces); Gunning–Rossi, *Analytic Functions of Several Complex Variables*,
Ch. V, §A, Definition 1. -/
structure an_Chart (X : Type u) [TopologicalSpace X] where
  /-- The domain of the chart. -/
  dom : Set X
  isOpen_dom : IsOpen dom
  /-- The dimension of the ambient space of the local model. -/
  n : ℕ
  /-- The open set of `ℂⁿ` carrying the equations. -/
  U : Set (Fin n → ℂ)
  isOpen_U : IsOpen U
  /-- The number of equations. -/
  k : ℕ
  /-- The equations of the local model. -/
  eqns : (Fin n → ℂ) → (Fin k → ℂ)
  analyticOnNhd_eqns : AnalyticOnNhd ℂ eqns U
  /-- The chart map. -/
  toFun : X → (Fin n → ℂ)
  isEmbedding : IsEmbedding (dom.domRestrict toFun)
  image_eq : toFun '' dom = an_zeroLocus U eqns

/-- An atlas: a family of charts whose domains cover `X`.
Source: Grauert–Remmert, *Coherent Analytic Sheaves*, §1.1.5; Gunning–Rossi, Ch. V, §A. -/
structure an_Atlas (X : Type u) [TopologicalSpace X] where
  /-- The index of the charts. -/
  ι : Type u
  /-- The charts. -/
  chart : ι → an_Chart X
  covers : ∀ x, ∃ i, x ∈ (chart i).dom

variable {X : Type u} [TopologicalSpace X]

/-- The point of the local model to which the chart sends a point of its domain.
Source: Grauert–Remmert, *Coherent Analytic Sheaves*, §1.1.5 (the chart is an isomorphism of the
domain onto the model). -/
def an_Chart.toModel (c : an_Chart X) {x : X} (hx : x ∈ c.dom) : an_zeroLocus c.U c.eqns :=
  ⟨c.toFun x, c.image_eq ▸ mem_image_of_mem _ hx⟩

example (c : an_Chart X) {x : X} (hx : x ∈ c.dom) : (c.toModel hx : Fin c.n → ℂ) = c.toFun x :=
  rfl

/-- The image in the local model of the part of `U` inside the chart domain.
Source: Grauert–Remmert, *Coherent Analytic Sheaves*, §1.1.5. -/
def an_Chart.modelImage (c : an_Chart X) (U : Set X) : Set (an_zeroLocus c.U c.eqns) :=
  {z | ∃ x ∈ U ∩ c.dom, c.toFun x = z}

/-- A point of `U` inside the chart domain, as a point of `c.modelImage U`.
Source: Grauert–Remmert, *Coherent Analytic Sheaves*, §1.1.5. -/
def an_Chart.toModelImage (c : an_Chart X) {U : Set X} (hU : U ⊆ c.dom) (x : U) :
    c.modelImage U :=
  ⟨c.toModel (hU x.2), x, ⟨x.2, hU x.2⟩, rfl⟩

example (c : an_Chart X) {U : Set X} (hU : U ⊆ c.dom) (x : U) :
    (((c.toModelImage hU x : an_zeroLocus c.U c.eqns)) : Fin c.n → ℂ) = c.toFun x := rfl

/-- A map `g : X → ℂᵐ` is holomorphic on `S` in the chart `c` if near each point of `S` in the
chart's domain it is, read in the chart, the restriction of a map holomorphic on an open subset of
the ambient `ℂⁿ`.
Source: Grauert–Remmert, *Coherent Analytic Sheaves*, §1.1.1 and §4.1 (holomorphic functions on a
reduced model space). -/
def an_Chart.IsHolOn (c : an_Chart X) {m : ℕ} (g : X → (Fin m → ℂ)) (S : Set X) : Prop :=
  ∀ x ∈ S ∩ c.dom, ∃ W : Set (Fin c.n → ℂ), IsOpen W ∧ c.toFun x ∈ W ∧
    ∃ G : (Fin c.n → ℂ) → (Fin m → ℂ), AnalyticOnNhd ℂ G W ∧
      ∀ y ∈ S ∩ c.dom, c.toFun y ∈ W → g y = G (c.toFun y)

/-- A map `g : X → ℂᵐ` is holomorphic on `S` if it is so in every chart of the atlas.
Source: Grauert–Remmert, *Coherent Analytic Sheaves*, §1.1.5. -/
def an_Atlas.IsHolOn (A : an_Atlas X) {m : ℕ} (g : X → (Fin m → ℂ)) (S : Set X) : Prop :=
  ∀ i, (A.chart i).IsHolOn g S

/-- An atlas is *analytic* if every chart map is holomorphic, on its domain, in every chart: the
transition maps are holomorphic.
Source: Gunning–Rossi, *Analytic Functions of Several Complex Variables*, Ch. V, §A,
Definition 1 (analytic spaces by holomorphically compatible local models). -/
def an_Atlas.IsAnalytic (A : an_Atlas X) : Prop :=
  ∀ i j, (A.chart i).IsHolOn (A.chart j).toFun (A.chart j).dom

/-- A chosen chart at a point.
Source: Grauert–Remmert, *Coherent Analytic Sheaves*, §1.1.5 (every point has a chart
neighbourhood); the choice is that of `Classical.choose`. -/
def an_Atlas.chartAt (A : an_Atlas X) (x : X) : A.ι := (A.covers x).choose

theorem an_Atlas.mem_chartAt (A : an_Atlas X) (x : X) : x ∈ (A.chart (A.chartAt x)).dom :=
  (A.covers x).choose_spec

/-- Constant maps are holomorphic on every set. -/
theorem an_Atlas.isHolOn_const (A : an_Atlas X) {m : ℕ} (v : Fin m → ℂ) (S : Set X) :
    A.IsHolOn (fun _ ↦ v) S :=
  fun _ _ _ ↦ ⟨univ, isOpen_univ, mem_univ _, fun _ ↦ v, analyticOnNhd_const, fun _ _ _ ↦ rfl⟩

example (c : an_Chart X) : c.IsHolOn (fun _ ↦ (0 : Fin 1 → ℂ)) univ :=
  fun _ _ ↦ ⟨univ, isOpen_univ, mem_univ _, 0, analyticOnNhd_const, fun _ _ _ ↦ rfl⟩

end Atlas

/-! ### The structure sheaf glued from the charts -/

section Sheaf

universe u

variable {X : Type u} [TopologicalSpace X]

/-- A function `g : U → ℂ` on a subset `U ⊆ X` is *holomorphic* if in every chart containing a
point `x ∈ U` it is, on a neighbourhood of `x`, the restriction along the chart of a function
holomorphic at the image of `x`: the local predicate `an_IsLocRestr` of the models, transported
along the charts.
Source: Grauert–Remmert, *Coherent Analytic Sheaves*, §1.1.5 and §4.1 (the structure sheaf of a
reduced complex space is the sheaf of holomorphic functions, locally the restrictions of ambient
holomorphic functions in the model spaces). -/
def an_Atlas.IsHolFun (A : an_Atlas X) {U : Set X} (g : U → ℂ) : Prop :=
  ∀ x : U, ∀ i, (x : X) ∈ (A.chart i).dom → ∃ N : Set X, IsOpen N ∧ (x : X) ∈ N ∧
    ∃ G : (Fin (A.chart i).n → ℂ) → ℂ, AnalyticAt ℂ G ((A.chart i).toFun x) ∧
      ∀ y : U, (y : X) ∈ N ∩ (A.chart i).dom → g y = G ((A.chart i).toFun y)

/-- The holomorphic functions on `U ⊆ X` form a subring of all functions.
Source: Grauert–Remmert, *Coherent Analytic Sheaves*, §1.1.5 (the structure sheaf is a sheaf of
`ℂ`-algebras). -/
def an_Atlas.holSubring (A : an_Atlas X) (U : Set X) : Subring (U → ℂ) where
  carrier := {g | A.IsHolFun g}
  zero_mem' := fun _ _ _ ↦ ⟨univ, isOpen_univ, mem_univ _, 0, analyticAt_const, fun _ _ ↦ rfl⟩
  one_mem' := fun _ _ _ ↦ ⟨univ, isOpen_univ, mem_univ _, 1, analyticAt_const, fun _ _ ↦ rfl⟩
  add_mem' := by
    intro g g' hg hg' x i hx
    obtain ⟨N, hN, hxN, G, hG, h⟩ := hg x i hx
    obtain ⟨N', hN', hxN', G', hG', h'⟩ := hg' x i hx
    exact ⟨N ∩ N', hN.inter hN', ⟨hxN, hxN'⟩, G + G', hG.add hG', fun y hy ↦ by
      simp [h y ⟨hy.1.1, hy.2⟩, h' y ⟨hy.1.2, hy.2⟩]⟩
  mul_mem' := by
    intro g g' hg hg' x i hx
    obtain ⟨N, hN, hxN, G, hG, h⟩ := hg x i hx
    obtain ⟨N', hN', hxN', G', hG', h'⟩ := hg' x i hx
    exact ⟨N ∩ N', hN.inter hN', ⟨hxN, hxN'⟩, G * G', hG.mul hG', fun y hy ↦ by
      simp [h y ⟨hy.1.1, hy.2⟩, h' y ⟨hy.1.2, hy.2⟩]⟩
  neg_mem' := by
    intro g hg x i hx
    obtain ⟨N, hN, hxN, G, hG, h⟩ := hg x i hx
    exact ⟨N, hN, hxN, -G, hG.neg, fun y hy ↦ by simp [h y hy]⟩

example (A : an_Atlas X) (U : Set X) : (1 : U → ℂ) ∈ A.holSubring U := (A.holSubring U).one_mem

/-- Holomorphy is a local predicate on the open subsets of `X`.
Source: Grauert–Remmert, *Coherent Analytic Sheaves*, §1.1.5; Hartshorne, *Algebraic Geometry*,
Ch. II, §1 (sheaves of functions defined by a local condition). -/
def an_Atlas.holPredicate (A : an_Atlas X) :
    TopCat.LocalPredicate (X := TopCat.of X) (fun _ ↦ ℂ) where
  pred {U} g := g ∈ A.holSubring (U : Set X)
  res {U V} i g hg := by
    intro x j hx
    obtain ⟨N, hN, hxN, G, hG, h⟩ := hg ⟨x, (leOfHom i) x.2⟩ j hx
    exact ⟨N, hN, hxN, G, hG, fun y hy ↦ h ⟨y, (leOfHom i) y.2⟩ hy⟩
  locality {U} g hg := by
    intro x j hx
    obtain ⟨V, hxV, i, hV⟩ := hg x
    obtain ⟨N, hN, hxN, G, hG, h⟩ := hV ⟨x, hxV⟩ j hx
    exact ⟨N ∩ V, hN.inter V.isOpen, ⟨hxN, hxV⟩, G, hG, fun y hy ↦ h ⟨y, hy.1.2⟩ ⟨hy.1.1, hy.2⟩⟩

/-- The sheaf of holomorphic functions on `X`, as a sheaf of types.
Source: Grauert–Remmert, *Coherent Analytic Sheaves*, §1.1.5. -/
def an_Atlas.holSheafTypes (A : an_Atlas X) : TopCat.Sheaf (Type u) (TopCat.of X) :=
  TopCat.subsheafToTypes A.holPredicate

instance (A : an_Atlas X) (U : (TopologicalSpace.Opens (TopCat.of X))ᵒᵖ) :
    CommRing (A.holSheafTypes.presheaf.obj U) :=
  inferInstanceAs (CommRing (A.holSubring (U.unop : Set X)))

/-- The presheaf of holomorphic functions on `X`, as a presheaf of commutative rings.
Source: Grauert–Remmert, *Coherent Analytic Sheaves*, §1.1.5. -/
def an_Atlas.holPresheafRing (A : an_Atlas X) :
    TopCat.Presheaf CommRingCat.{u} (TopCat.of X) where
  obj U := CommRingCat.of (A.holSheafTypes.presheaf.obj U)
  map h := CommRingCat.ofHom
    { toFun := fun f ↦ A.holSheafTypes.presheaf.map h f
      map_one' := rfl
      map_mul' := fun _ _ ↦ rfl
      map_zero' := rfl
      map_add' := fun _ _ ↦ rfl }
  map_id _ := rfl
  map_comp _ _ := rfl

/-- The sheaf of holomorphic functions on `X`, as a sheaf of commutative rings: the sheaf
condition is that of the underlying sheaf of types.
Source: Grauert–Remmert, *Coherent Analytic Sheaves*, §1.1.5 (the structure sheaf `𝒪_X` of a
reduced complex space); Mathlib's `smoothSheafCommRing` for the same construction on manifolds. -/
def an_Atlas.holSheafRing (A : an_Atlas X) : TopCat.Sheaf CommRingCat.{u} (TopCat.of X) where
  obj := A.holPresheafRing
  property := by
    rw [CategoryTheory.Presheaf.isSheaf_iff_isSheaf_forget _ _ (CategoryTheory.forget CommRingCat)]
    exact A.holSheafTypes.property

/-- Forgetting the ring structure gives back the sheaf of types. -/
example (A : an_Atlas X) :
    (CategoryTheory.sheafCompose _ (CategoryTheory.forget CommRingCat.{u})).obj A.holSheafRing =
      A.holSheafTypes := rfl

open CategoryTheory.Limits in
/-- Evaluation at `x` of sections over the open neighbourhoods of `x`, as a cocone.
Source: Grauert–Remmert, *Coherent Analytic Sheaves*, §1.1.5 (the value `f(x)` of a germ). -/
def an_Atlas.evalCocone (A : an_Atlas X) (x : X) :
    Cocone ((TopologicalSpace.OpenNhds.inclusion (x : TopCat.of X)).op ⋙
      A.holSheafRing.presheaf) where
  pt := CommRingCat.of (ULift.{u} ℂ)
  ι :=
    { app U := CommRingCat.ofHom
        ((ULift.ringEquiv (R := ℂ)).symm.toRingHom.comp
          ((Pi.evalRingHom (fun _ : (U.unop.1 : Set X) ↦ ℂ) ⟨x, U.unop.2⟩).comp
            (A.holSubring (U.unop.1 : Set X)).subtype))
      naturality _ _ _ := rfl }

open CategoryTheory.Limits in
/-- The value at `x` of a germ at `x` of a holomorphic function.
Source: Grauert–Remmert, *Coherent Analytic Sheaves*, §1.1.5 (the value `f(x)` of a germ, the
residue of `f` modulo the maximal ideal). -/
def an_Atlas.evalStalk (A : an_Atlas X) (x : X) :
    A.holSheafRing.presheaf.stalk (x : TopCat.of X) →+* ℂ :=
  (ULift.ringEquiv (R := ℂ)).toRingHom.comp (colimit.desc _ (A.evalCocone x)).hom

open CategoryTheory.Limits in
/-- The value of the germ of a section is the value of the section. -/
theorem an_Atlas.evalStalk_germ (A : an_Atlas X) (U : TopologicalSpace.Opens (TopCat.of X))
    (x : X) (hx : x ∈ U) (f : A.holSheafRing.presheaf.obj (Opposite.op U)) :
    A.evalStalk x (A.holSheafRing.presheaf.germ U x hx f) = f.1 ⟨x, hx⟩ := by
  change ULift.down (((A.holSheafRing.presheaf.germ U x hx) ≫
    colimit.desc _ (A.evalCocone x)).hom f) = _
  erw [colimit.ι_desc]
  rfl

end Sheaf

/-! ### Reduced complex analytic spaces, maps, subsets and dimension -/

section ReducedSpace

universe u

/-- A *reduced complex analytic space*: a Hausdorff, second-countable space with an analytic atlas
of charts onto local models. Its structure sheaf (`an_ReducedSpace.structureSheaf`) is
constructed from the atlas, not stored.
Source: Grauert–Remmert, *Coherent Analytic Sheaves*, §1.1.5 (complex spaces: Hausdorff ringed
spaces locally isomorphic to model spaces) and §4.1 (reduced spaces, whose structure sheaf is a
sheaf of continuous functions); Gunning–Rossi, *Analytic Functions of Several Complex Variables*,
Ch. V, §A, Definition 1 (analytic spaces by compatible local models). Second countability is a
standing assumption added here; the spaces later stages build (analytifications of
quasi-projective schemes, their closed subspaces) satisfy it. -/
structure an_ReducedSpace (X : Type u) [TopologicalSpace X] where
  t2Space : T2Space X
  secondCountable : SecondCountableTopology X
  /-- The atlas of charts onto local models. -/
  atlas : an_Atlas X
  isAnalytic : atlas.IsAnalytic

variable {X : Type u} [TopologicalSpace X]

/-- The holomorphic functions on `U ⊆ X` of a reduced complex analytic space.
Source: Grauert–Remmert, *Coherent Analytic Sheaves*, §1.1.5 and §4.1. -/
abbrev an_ReducedSpace.IsHolFun (S : an_ReducedSpace X) {U : Set X} (g : U → ℂ) : Prop :=
  S.atlas.IsHolFun g

/-- The structure sheaf `𝒪_X`: the sheaf of commutative rings of holomorphic functions, glued
from the charts.
Source: Grauert–Remmert, *Coherent Analytic Sheaves*, §1.1.5 and §4.1. -/
abbrev an_ReducedSpace.structureSheaf (S : an_ReducedSpace X) :
    TopCat.Sheaf CommRingCat.{u} (TopCat.of X) :=
  S.atlas.holSheafRing

/-- The value at `x` of a germ at `x`.
Source: Grauert–Remmert, *Coherent Analytic Sheaves*, §1.1.5. -/
abbrev an_ReducedSpace.evalStalk (S : an_ReducedSpace X) (x : X) :
    S.structureSheaf.presheaf.stalk (x : TopCat.of X) →+* ℂ :=
  S.atlas.evalStalk x

example (S : an_ReducedSpace X) (U : Set X) : S.IsHolFun (fun _ : U ↦ (1 : ℂ)) :=
  (S.atlas.holSubring U).one_mem

variable {Y : Type*} [TopologicalSpace Y]

/-- A holomorphic map of reduced complex analytic spaces: a continuous map along which
holomorphic functions pull back to holomorphic functions, i.e. a morphism of the structure
sheaves of functions.
Source: Grauert–Remmert, *Coherent Analytic Sheaves*, §1.1.5 (holomorphic maps of complex spaces)
and §4.1 (for reduced spaces they are the continuous maps pulling back holomorphic functions). -/
def an_IsHom (S : an_ReducedSpace X) (T : an_ReducedSpace Y) (f : X → Y) : Prop :=
  Continuous f ∧ ∀ V : Set Y, IsOpen V → ∀ g : V → ℂ, T.IsHolFun g →
    S.IsHolFun (fun x : f ⁻¹' V ↦ g ⟨f x, x.2⟩)

/-- The identity of a reduced complex analytic space is holomorphic. -/
theorem an_isHom_id (S : an_ReducedSpace X) : an_IsHom S S id :=
  ⟨continuous_id, fun _ _ _ hg ↦ hg⟩

/-- A proper holomorphic map.
Source: Grauert–Remmert, *Coherent Analytic Sheaves*, §10.6 (proper holomorphic maps). -/
def an_IsProperHom (S : an_ReducedSpace X) (T : an_ReducedSpace Y) (f : X → Y) : Prop :=
  IsProperMap f ∧ an_IsHom S T f

/-- The identity of a reduced complex analytic space is proper and holomorphic. -/
theorem an_isProperHom_id (S : an_ReducedSpace X) : an_IsProperHom S S id :=
  ⟨isProperMap_id, an_isHom_id S⟩

/-- A closed analytic subset: closed, and near each of its points the common zero set of finitely
many holomorphic functions.
Source: Grauert–Remmert, *Coherent Analytic Sheaves*, §1.1.6 (analytic sets in complex spaces:
locally the zeros of finitely many sections of `𝒪_X`); Gunning–Rossi, Ch. V, §A. -/
def an_IsClosedAnalytic (S : an_ReducedSpace X) (Z : Set X) : Prop :=
  IsClosed Z ∧ ∀ x ∈ Z, ∃ W : Set X, IsOpen W ∧ x ∈ W ∧
    ∃ (k : ℕ) (g : Fin k → W → ℂ), (∀ j, S.IsHolFun (g j)) ∧
      ∀ y : W, ((y : X) ∈ Z ↔ ∀ j, g j y = 0)

/-- The whole space is closed analytic (no equations). -/
theorem an_isClosedAnalytic_univ (S : an_ReducedSpace X) : an_IsClosedAnalytic S univ :=
  ⟨isClosed_univ, fun _ _ ↦ ⟨univ, isOpen_univ, mem_univ _, 0, Fin.elim0, fun j ↦ j.elim0,
    fun _ ↦ by simp⟩⟩

/-- The empty set is closed analytic. -/
theorem an_isClosedAnalytic_empty (S : an_ReducedSpace X) : an_IsClosedAnalytic S ∅ :=
  ⟨isClosed_empty, fun _ h ↦ h.elim⟩

/-- A subset is *locally analytic at* `y`: on some open neighbourhood of `y` it is the trace of a
closed analytic subset.
Source: Grauert–Remmert, *Coherent Analytic Sheaves*, §1.1.6 (analyticity is a local
property). -/
def an_IsLocallyAnalyticAt (S : an_ReducedSpace X) (Z : Set X) (y : X) : Prop :=
  ∃ V : Set X, IsOpen V ∧ y ∈ V ∧ ∃ T : Set X, an_IsClosedAnalytic S T ∧ Z ∩ V = T ∩ V

example (S : an_ReducedSpace X) (y : X) : an_IsLocallyAnalyticAt S univ y :=
  ⟨univ, isOpen_univ, mem_univ _, univ, an_isClosedAnalytic_univ S, rfl⟩

/-- The local dimension at `x` of a subset `Z`: the Krull dimension of the reduced analytic local
ring `𝒪_{ℂⁿ, c x} / I(c(Z))` of the germ at `c x` of the image of `Z` in the chosen chart `c` at
`x` (`adim2_dimension`). It is `⊥` when `x ∉ closure Z`. For the whole space it is the Krull
dimension of the local ring `𝒪_{X,x}` (`an_dim_eq_stalk`).
Source: Grauert–Remmert, *Coherent Analytic Sheaves*, §5.1 (dimension of a complex space at a
point as the Krull dimension of `𝒪_{X,x}`); de Jong–Pfister, *Local Analytic Geometry*, §3.4. -/
def an_dimAt (S : an_ReducedSpace X) (Z : Set X) (x : X) : WithBot ℕ∞ :=
  let c := S.atlas.chart (S.atlas.chartAt x)
  adim2_dimension c.n (adim2_germ c.n (c.toFun '' (Z ∩ c.dom)) (c.toFun x))

/-- The local dimension of the space at `x`.
Source: Grauert–Remmert, *Coherent Analytic Sheaves*, §5.1. -/
abbrev an_dim (S : an_ReducedSpace X) (x : X) : WithBot ℕ∞ := an_dimAt S univ x

example (S : an_ReducedSpace X) (x : X) : an_dim S x = an_dimAt S univ x := rfl

/-- The dimension of the space: the supremum of the local dimensions.
Source: Grauert–Remmert, *Coherent Analytic Sheaves*, §5.1. -/
def an_dimension (S : an_ReducedSpace X) : WithBot ℕ∞ := ⨆ x, an_dim S x

example (S : an_ReducedSpace X) (x : X) : an_dim S x ≤ an_dimension S := le_iSup (an_dim S) x

/-- `y` is a *manifold point of `Z` of dimension `d`*: `y ∈ Z`, and on an open neighbourhood `W`
the set `Z ∩ W` is the image of an open `V ⊆ ℂᵈ` under a map `σ`, holomorphic into every chart,
with a left inverse `ψ` whose coordinates are holomorphic functions on `W`. Then `σ` is a
holomorphic embedding with injective differential.
Source: Grauert–Remmert, *Coherent Analytic Sheaves*, §5.3 (regular points, where `X` is a
manifold); Chirka, *Complex Analytic Sets*, §2.3 (regular points of an analytic set). -/
def an_IsRegularOfDim (S : an_ReducedSpace X) (Z : Set X) (d : ℕ) (y : X) : Prop :=
  y ∈ Z ∧ ∃ (W : Set X) (V : Set (Fin d → ℂ)) (σ : (Fin d → ℂ) → X) (ψ : X → (Fin d → ℂ)),
    IsOpen W ∧ y ∈ W ∧ IsOpen V ∧ ContinuousOn σ V ∧ σ '' V = Z ∩ W ∧
    (∀ v ∈ V, ψ (σ v) = v) ∧ (∀ j, S.IsHolFun (fun w : W ↦ ψ w j)) ∧
    ∀ i, AnalyticOnNhd ℂ ((S.atlas.chart i).toFun ∘ σ) (V ∩ σ ⁻¹' (S.atlas.chart i).dom)

/-- A point outside `Z` is not a manifold point of `Z`. -/
example (S : an_ReducedSpace X) (Z : Set X) (d : ℕ) (y : X) (hy : y ∉ Z) :
    ¬ an_IsRegularOfDim S Z d y :=
  fun h ↦ hy h.1

/-- The geometric dimension of `Z` at `x`: over smaller and smaller open neighbourhoods `W` of `x`,
the largest dimension of a manifold point of `Z` in `W`.
Source: Chirka, *Complex Analytic Sets*, §2.4 (dimension at a point as the limit of the dimensions
of nearby regular points); Grauert–Remmert, *Coherent Analytic Sheaves*, §5.3. -/
def an_geomDim (S : an_ReducedSpace X) (Z : Set X) (x : X) : WithBot ℕ∞ :=
  ⨅ (W : Set X) (_ : IsOpen W) (_ : x ∈ W),
    ⨆ (y ∈ W) (d : ℕ) (_ : an_IsRegularOfDim S Z d y), ((d : ℕ∞) : WithBot ℕ∞)

/-- The geometric dimension of the empty set is `⊥`. -/
example (S : an_ReducedSpace X) (x : X) : an_geomDim S ∅ x = ⊥ := by
  refine le_antisymm ((iInf₂_le univ isOpen_univ).trans (iInf_le_of_le (mem_univ x) ?_)) bot_le
  simp [an_IsRegularOfDim]

end ReducedSpace

/-! ### Instances: `ℂⁿ`, local models, the node, manifolds -/

section Instances

/-- The one-chart atlas of `ℂⁿ`: the identity onto the local model `ℂⁿ` with no equations.
Source: Grauert–Remmert, *Coherent Analytic Sheaves*, §1.1.1 (a domain is a model space). -/
def an_euclidAtlas (n : ℕ) : an_Atlas (Fin n → ℂ) where
  ι := PUnit
  chart _ :=
    { dom := univ
      isOpen_dom := isOpen_univ
      n := n
      U := univ
      isOpen_U := isOpen_univ
      k := 0
      eqns := 0
      analyticOnNhd_eqns := analyticOnNhd_const
      toFun := id
      isEmbedding := IsEmbedding.subtypeVal
      image_eq := by
        ext z; simp [an_zeroLocus] }
  covers _ := ⟨⟨⟩, mem_univ _⟩

example (n : ℕ) : ((an_euclidAtlas n).chart ⟨⟩).toFun = id := rfl

/-- The atlas of `ℂⁿ` is analytic: its one transition map is the identity. -/
theorem an_euclidAtlas_isAnalytic (n : ℕ) : (an_euclidAtlas n).IsAnalytic :=
  fun _ _ _ _ ↦ ⟨univ, isOpen_univ, mem_univ _, id, analyticOnNhd_id, fun _ _ _ ↦ rfl⟩

/-- `ℂⁿ` as a reduced complex analytic space.
Source: Grauert–Remmert, *Coherent Analytic Sheaves*, §1.1.1 and §1.1.5. -/
def an_euclidSpace (n : ℕ) : an_ReducedSpace (Fin n → ℂ) where
  t2Space := inferInstance
  secondCountable := inferInstance
  atlas := an_euclidAtlas n
  isAnalytic := an_euclidAtlas_isAnalytic n

example (n : ℕ) (x : Fin n → ℂ) :
    an_dim (an_euclidSpace n) x = adim2_dimension n (adim2_germ n (id '' (univ ∩ univ)) x) :=
  rfl

/-- On `ℂⁿ`, a function holomorphic at every point of an open set is a section of the structure
sheaf there. -/
example (n : ℕ) (V : Set (Fin n → ℂ)) (G : (Fin n → ℂ) → ℂ) (hG : AnalyticOnNhd ℂ G V) :
    (an_euclidSpace n).IsHolFun (fun x : V ↦ G x) :=
  fun x _ _ ↦ ⟨univ, isOpen_univ, mem_univ _, G, hG x x.2, fun _ _ ↦ rfl⟩

/-- A local model as a space: the subspace `an_zeroLocus U f` with the one chart given by its
inclusion into `ℂⁿ`.
Source: Grauert–Remmert, *Coherent Analytic Sheaves*, §1.1.1 (model spaces). -/
def an_modelAtlas {n k : ℕ} (U : Set (Fin n → ℂ)) (hU : IsOpen U)
    (f : (Fin n → ℂ) → (Fin k → ℂ)) (hf : AnalyticOnNhd ℂ f U) :
    an_Atlas (an_zeroLocus U f) where
  ι := PUnit
  chart _ :=
    { dom := univ
      isOpen_dom := isOpen_univ
      n := n
      U := U
      isOpen_U := hU
      k := k
      eqns := f
      analyticOnNhd_eqns := hf
      toFun := Subtype.val
      isEmbedding := IsEmbedding.subtypeVal.comp IsEmbedding.subtypeVal
      image_eq := by simp }
  covers _ := ⟨⟨⟩, mem_univ _⟩

/-- The atlas of a local model is analytic: its one transition map is the identity. -/
theorem an_modelAtlas_isAnalytic {n k : ℕ} (U : Set (Fin n → ℂ)) (hU : IsOpen U)
    (f : (Fin n → ℂ) → (Fin k → ℂ)) (hf : AnalyticOnNhd ℂ f U) :
    (an_modelAtlas U hU f hf).IsAnalytic :=
  fun _ _ _ _ ↦ ⟨univ, isOpen_univ, mem_univ _, id, analyticOnNhd_id, fun _ _ _ ↦ rfl⟩

/-- A local model as a reduced complex analytic space.
Source: Grauert–Remmert, *Coherent Analytic Sheaves*, §1.1.1 and §4.1 (reduced model spaces). -/
def an_modelSpace {n k : ℕ} (U : Set (Fin n → ℂ)) (hU : IsOpen U)
    (f : (Fin n → ℂ) → (Fin k → ℂ)) (hf : AnalyticOnNhd ℂ f U) :
    an_ReducedSpace (an_zeroLocus U f) where
  t2Space := inferInstance
  secondCountable := inferInstance
  atlas := an_modelAtlas U hU f hf
  isAnalytic := an_modelAtlas_isAnalytic U hU f hf

/-- A local model cut out in all of `ℂⁿ` is a closed analytic subspace: its inclusion is a proper
holomorphic map (a closed embedding). -/
theorem an_modelSpace_val_isProperHom {n k : ℕ} (f : (Fin n → ℂ) → (Fin k → ℂ))
    (hf : AnalyticOnNhd ℂ f univ) :
    an_IsProperHom (an_modelSpace univ isOpen_univ f hf) (an_euclidSpace n) Subtype.val := by
  have hcl : IsClosed (an_zeroLocus univ f) := by
    have : an_zeroLocus univ f = f ⁻¹' {0} := by ext; simp [an_zeroLocus]
    rw [this]
    exact isClosed_singleton.preimage (continuousOn_univ.1 hf.continuousOn)
  refine ⟨hcl.isClosedEmbedding_subtypeVal.isProperMap, continuous_subtype_val, ?_⟩
  intro V _ g hg x _ _
  obtain ⟨N, hN, hxN, G, hG, h⟩ := hg ⟨((x : an_zeroLocus univ f) : Fin n → ℂ), x.2⟩ ⟨⟩
    (mem_univ _)
  exact ⟨Subtype.val ⁻¹' N, hN.preimage continuous_subtype_val, hxN, G, hG,
    fun y hy ↦ h ⟨((y : an_zeroLocus univ f) : Fin n → ℂ), y.2⟩ ⟨hy.1, mem_univ _⟩⟩

/-- The product of the two coordinates of `ℂ²`, the equation of the node.
Source: Chirka, *Complex Analytic Sets*, §2.3 (the curve `{zw = 0}`). -/
def an_nodeEqn : (Fin 2 → ℂ) → (Fin 1 → ℂ) := fun z _ ↦ z 0 * z 1

theorem an_nodeEqn_analytic : AnalyticOnNhd ℂ an_nodeEqn univ := by
  intro z _
  have h0 : AnalyticAt ℂ (fun z : Fin 2 → ℂ ↦ z 0) z :=
    (ContinuousLinearMap.proj (R := ℂ) (φ := fun _ : Fin 2 ↦ ℂ) 0).analyticAt z
  have h1 : AnalyticAt ℂ (fun z : Fin 2 → ℂ ↦ z 1) z :=
    (ContinuousLinearMap.proj (R := ℂ) (φ := fun _ : Fin 2 ↦ ℂ) 1).analyticAt z
  exact analyticAt_pi_iff.2 fun _ ↦ h0.mul h1

/-- The node `{z₀ z₁ = 0} ⊆ ℂ²`, a singular local model.
Source: Grauert–Remmert, *Coherent Analytic Sheaves*, §1.1.1; Chirka, *Complex Analytic Sets*,
§2.3 (the singular point of `{zw = 0}`). -/
abbrev an_node : Set (Fin 2 → ℂ) := an_zeroLocus univ an_nodeEqn

/-- The node with its one chart, the inclusion into `ℂ²`.
Source: Grauert–Remmert, *Coherent Analytic Sheaves*, §1.1.1 (model spaces). -/
def an_nodeAtlas : an_Atlas an_node :=
  an_modelAtlas univ isOpen_univ an_nodeEqn an_nodeEqn_analytic

/-- The node as a reduced complex analytic space.
Source: Grauert–Remmert, *Coherent Analytic Sheaves*, §1.1.1 and §4.1. -/
def an_nodeSpace : an_ReducedSpace an_node :=
  an_modelSpace univ isOpen_univ an_nodeEqn an_nodeEqn_analytic

example : an_nodeSpace.atlas = an_nodeAtlas := rfl

example : (0 : Fin 2 → ℂ) ∈ an_node := ⟨mem_univ _, by funext i; simp [an_nodeEqn]⟩

example : an_IsLocalModel 2 an_node :=
  ⟨univ, 1, an_nodeEqn, isOpen_univ, an_nodeEqn_analytic, rfl⟩

/-- The closed embedding of the node into `ℂ²` is proper and holomorphic. -/
example : an_IsProperHom an_nodeSpace (an_euclidSpace 2) Subtype.val :=
  an_modelSpace_val_isProperHom an_nodeEqn an_nodeEqn_analytic

/-- The equation `z₀ z₁ - 1` of the hyperbola. -/
def an_hyperbolaEqn : (Fin 2 → ℂ) → (Fin 1 → ℂ) := fun z _ ↦ z 0 * z 1 - 1

/-- The hyperbola `{z₀ z₁ = 1} ⊆ ℂ²`, closed in `ℂ²`.
Its projection to the first coordinate is `ℂ \ {0}`, which is not closed.
Source: Grauert–Remmert, *Coherent Analytic Sheaves*, §10.6 (the proper mapping theorem assumes
properness); the image of `{zw = 1}` under `(z, w) ↦ z` is `{z ≠ 0}`. -/
abbrev an_hyperbola : Set (Fin 2 → ℂ) := an_zeroLocus univ an_hyperbolaEqn

/-- The projection of `ℂ²` to the first coordinate, valued in `ℂ¹`.
Source: Grauert–Remmert, *Coherent Analytic Sheaves*, §10.6 (the projection of the hyperbola as
the standard example of a non-proper map). -/
def an_proj0 : (Fin 2 → ℂ) → (Fin 1 → ℂ) := fun z _ ↦ z 0

example : (![1, 1] : Fin 2 → ℂ) ∈ an_hyperbola :=
  ⟨mem_univ _, by funext i; simp [an_hyperbolaEqn]⟩

example : an_proj0 ![2, 3] = fun _ ↦ 2 := rfl

/-- The first projection is holomorphic. -/
theorem an_proj0_isHom : an_IsHom (an_euclidSpace 2) (an_euclidSpace 1) an_proj0 := by
  have hc : Continuous an_proj0 := continuous_pi fun _ ↦ continuous_apply 0
  have hp : ∀ z, AnalyticAt ℂ an_proj0 z := fun z ↦ analyticAt_pi_iff.2 fun _ ↦
    (ContinuousLinearMap.proj (R := ℂ) (φ := fun _ : Fin 2 ↦ ℂ) 0).analyticAt z
  refine ⟨hc, fun V _ g hg x _ _ ↦ ?_⟩
  obtain ⟨N, hN, hxN, G, hG, h⟩ := hg ⟨an_proj0 x, x.2⟩ ⟨⟩ (mem_univ _)
  exact ⟨an_proj0 ⁻¹' N, hN.preimage hc, hxN, G ∘ an_proj0,
    AnalyticAt.comp (g := G) (f := an_proj0) hG (hp x),
    fun y hy ↦ h ⟨an_proj0 y, y.2⟩ ⟨hy.1, mem_univ _⟩⟩

variable (E : Type*) [NormedAddCommGroup E] [NormedSpace ℂ E] [FiniteDimensional ℂ E]

/-- Coordinates on a finite-dimensional complex space, from `Module.finBasis`.
Source: Bourbaki, *Algèbre*, Ch. II, §7 (bases of finite-dimensional vector spaces); a linear
isomorphism of finite-dimensional normed spaces is continuous. -/
def an_coord : E ≃L[ℂ] (Fin (Module.finrank ℂ E) → ℂ) :=
  (Module.finBasis ℂ E).equivFun.toContinuousLinearEquiv

example (v : E) : (an_coord E).symm (an_coord E v) = v := by simp

variable (M : Type*) [TopologicalSpace M] [ChartedSpace E M]

/-- The atlas of a manifold charted on a finite-dimensional `E`: for each `x`, the chart
`chartAt E x` followed by coordinates, onto the open local model `an_coord E '' target` with no
equations.
Source: Grauert–Remmert, *Coherent Analytic Sheaves*, §1.1.5 (complex manifolds are the complex
spaces locally isomorphic to domains). -/
def an_manifoldAtlas : an_Atlas M where
  ι := M
  chart x :=
    { dom := (chartAt E x).source
      isOpen_dom := (chartAt E x).open_source
      n := Module.finrank ℂ E
      U := an_coord E '' (chartAt E x).target
      isOpen_U := (an_coord E).toHomeomorph.isOpenMap _ (chartAt E x).open_target
      k := 0
      eqns := 0
      analyticOnNhd_eqns := analyticOnNhd_const
      toFun := an_coord E ∘ chartAt E x
      isEmbedding := (an_coord E).toHomeomorph.isEmbedding.comp
        (chartAt E x).isOpenEmbedding_restrict.isEmbedding
      image_eq := by
        rw [image_comp, (chartAt E x).image_source_eq_target]
        ext z; simp [an_zeroLocus] }
  covers x := ⟨x, mem_chart_source E x⟩

example (x : M) : ((an_manifoldAtlas E M).chart x).dom = (chartAt E x).source := rfl

variable {E M}

omit [FiniteDimensional ℂ E] in
/-- The chart transitions of an analytic manifold are analytic on their (open) domains. -/
theorem an_transition_analyticOnNhd [IsManifold 𝓘(ℂ, E) ω M] (x y : M) :
    AnalyticOnNhd ℂ (chartAt E y ∘ (chartAt E x).symm)
      ((chartAt E x).symm ≫ₕ chartAt E y).source := by
  have h := (contDiffGroupoid ω 𝓘(ℂ, E)).compatible (chart_mem_atlas E x) (chart_mem_atlas E y)
  rw [contDiffGroupoid, mem_groupoid_of_pregroupoid] at h
  have h1 : ContDiffOn ℂ ω (chartAt E y ∘ (chartAt E x).symm)
      ((chartAt E x).symm ≫ₕ chartAt E y).source := by
    simpa [contDiffPregroupoid] using h.1
  have hopen := ((chartAt E x).symm ≫ₕ chartAt E y).open_source
  rw [contDiffOn_omega_iff_analyticOn hopen.uniqueDiffOn] at h1
  exact hopen.analyticOn_iff_analyticOnNhd.1 h1

/-- **Complex manifolds carry analytic atlases.** On an analytic manifold charted on a
finite-dimensional `E`, the atlas of charts followed by coordinates is analytic.
Source: Grauert–Remmert, *Coherent Analytic Sheaves*, §1.1.5 (complex manifolds as complex
spaces); the definition of `IsManifold 𝓘(ℂ, E) ω` (analytic chart transitions). -/
theorem an_manifoldAtlas_isAnalytic [IsManifold 𝓘(ℂ, E) ω M] :
    (an_manifoldAtlas E M).IsAnalytic := by
  intro (x : M) (y : M) p hp
  obtain ⟨hpy, hpx⟩ := hp
  change p ∈ (chartAt E y).source at hpy
  change p ∈ (chartAt E x).source at hpx
  let e := (chartAt E x).symm ≫ₕ chartAt E y
  refine ⟨an_coord E '' e.source,
    (an_coord E).toHomeomorph.isOpenMap _ e.open_source, ?_,
    an_coord E ∘ (chartAt E y ∘ (chartAt E x).symm) ∘ (an_coord E).symm, ?_, ?_⟩
  · exact ⟨chartAt E x p, ⟨(chartAt E x).map_source hpx,
      by simpa [(chartAt E x).left_inv hpx] using hpy⟩, rfl⟩
  · rintro _ ⟨z, hz, rfl⟩
    have h1 : AnalyticAt ℂ (chartAt E y ∘ (chartAt E x).symm) z :=
      an_transition_analyticOnNhd x y z hz
    have h2 : AnalyticAt ℂ (⇑(an_coord E).symm) (an_coord E z) :=
      (an_coord E).symm.toContinuousLinearMap.analyticAt _
    have h3 := (an_coord E).toContinuousLinearMap.analyticAt
      ((chartAt E y ∘ (chartAt E x).symm) z)
    have h4 := h1.comp_of_eq h2 (by simp)
    refine h3.comp_of_eq h4 ?_
    show chartAt E y ((chartAt E x).symm ((an_coord E).symm (an_coord E z))) = _
    rw [ContinuousLinearEquiv.symm_apply_apply]; rfl
  · rintro q ⟨-, hqx⟩ -
    change q ∈ (chartAt E x).source at hqx
    simp [an_manifoldAtlas, (chartAt E x).left_inv hqx]

variable (E M)

/-- A Hausdorff, second-countable analytic manifold charted on a finite-dimensional `E`, as a
reduced complex analytic space.
Source: Grauert–Remmert, *Coherent Analytic Sheaves*, §1.1.5 (complex manifolds are the complex
spaces locally isomorphic to domains). -/
def an_manifoldSpace [T2Space M] [SecondCountableTopology M] [IsManifold 𝓘(ℂ, E) ω M] :
    an_ReducedSpace M where
  t2Space := inferInstance
  secondCountable := inferInstance
  atlas := an_manifoldAtlas E M
  isAnalytic := an_manifoldAtlas_isAnalytic

example : (an_manifoldSpace ℂ ℂ).atlas = an_manifoldAtlas ℂ ℂ := rfl

end Instances

