import HodgeLean.Foundations.AnalyticSetDimensionProofs

/-! # Analytic dimension: frozen algebraic segment

Implication from Weierstrass division and preparation to Noetherian analytic local rings.
The finite-equation input already belongs to `IsClosedAnalytic`. Regular-locus geometry,
dimension descent, and the consumer filtration are deferred in the specification document.
HC no distance; AV milestone no distance.
-/

noncomputable section
open Set Filter Topology Polynomial
open HodgeLean.Foundations.AnalyticDivisorAlgebraic6
namespace HodgeLean.Foundations

/-- Division by a distinguished polynomial gives polynomial representatives modulo its image.
Source: Gunning--Rossi, II.B, Weierstrass division theorem. -/
theorem adim_division_representative (n : ℕ)
    (ι : Polynomial (AnalyticGerm n) →+* AnalyticGerm (n + 1))
    (hι : IsWeierstrassEmbedding ι) (P : Polynomial (AnalyticGerm n))
    (hP : IsWeierstrassPolynomial P) (g : AnalyticGerm (n + 1)) :
    ∃ (q : AnalyticGerm (n + 1)) (r : Polynomial (AnalyticGerm n)),
      r.degree < P.natDegree ∧ g = q * ι P + ι r :=
  adim_division_representative_aux n ι hι P hP g


/-- An ideal containing a distinguished polynomial is generated by finitely many polynomial images.
Source: Gunning--Rossi, II.B, Noetherian induction using Weierstrass division. -/
theorem adim_prepared_ideal (n : ℕ) (hn : IsNoetherianRing (AnalyticGerm n))
    (ι : Polynomial (AnalyticGerm n) →+* AnalyticGerm (n + 1))
    (hι : IsWeierstrassEmbedding ι) (P : Polynomial (AnalyticGerm n))
    (hP : IsWeierstrassPolynomial P) (I : Ideal (AnalyticGerm (n + 1)))
    (hI : ι P ∈ I) :
    ∃ s : Finset (Polynomial (AnalyticGerm n)), Ideal.span (ι '' (s : Set _)) = I :=
  adim_prepared_ideal_aux n hn ι hι P hP I hI


/-- In zero variables evaluation identifies analytic germs with the coefficient field.
Source: Gunning--Rossi, II.B, the base of the Noetherian induction. -/
theorem adim_noetherian_zero : IsNoetherianRing (AnalyticGerm 0) :=
  adim_noetherian_zero_aux


/-- Preparation and division propagate Noetherianity to the next ambient dimension.
Source: Gunning--Rossi, II.B, Noetherianity of convergent power series rings. -/
theorem adim_noetherian_succ (n : ℕ) (hn : IsNoetherianRing (AnalyticGerm n)) :
    IsNoetherianRing (AnalyticGerm (n + 1)) :=
  adim_noetherian_succ_aux n hn


/-- Analytic local rings at the origin in every finite dimension are Noetherian.
Source: Gunning--Rossi, II.B, Noetherianity of convergent power series rings. -/
theorem adim_noetherian (n : ℕ) : IsNoetherianRing (AnalyticGerm n) :=
  adim_noetherian_aux n

/-- Concrete division input from the coordinate in one variable.
Source: Gunning--Rossi, II.B, preparation of the coordinate function. -/
example : ∃ (ι : Polynomial (AnalyticGerm 0) →+* AnalyticGerm 1)
    (P r : Polynomial (AnalyticGerm 0)) (q : AnalyticGerm 1),
    IsWeierstrassEmbedding ι ∧ IsWeierstrassPolynomial P ∧
    r.degree < P.natDegree ∧ adim_coordinate 0 ^ 2 + 1 = q * ι P + ι r := by
  obtain ⟨ι, P, hι, hP, _⟩ :=
    spec_preparation_transfer (adim_coordinate_regular 0) (adim_coordinate_nonunit 0)
  obtain ⟨q, r, hr, he⟩ :=
    adim_division_representative 0 ι hι P hP (adim_coordinate 0 ^ 2 + 1)
  exact ⟨ι, P, r, q, hι, hP, hr, he⟩

/-- The prepared principal ideal gives every premise of the ideal-generation statement.
Source: Gunning--Rossi, II.B, ideals containing distinguished equations. -/
example : ∃ (ι : Polynomial (AnalyticGerm 0) →+* AnalyticGerm 1)
    (P : Polynomial (AnalyticGerm 0)) (s : Finset (Polynomial (AnalyticGerm 0))),
    IsWeierstrassEmbedding ι ∧ IsWeierstrassPolynomial P ∧
    Ideal.span (ι '' (s : Set _)) = Ideal.span {ι P} := by
  obtain ⟨ι, P, hι, hP, _⟩ :=
    spec_preparation_transfer (adim_coordinate_regular 0) (adim_coordinate_nonunit 0)
  obtain ⟨s, hs⟩ := adim_prepared_ideal 0 adim_noetherian_zero ι hι P hP
    (Ideal.span {ι P}) (Ideal.subset_span (by simp))
  exact ⟨ι, P, s, hι, hP, hs⟩

example : IsNoetherianRing (Polynomial (AnalyticGerm 0)) := by
  let := adim_noetherian_zero
  infer_instance

example : IsNoetherianRing (Polynomial (AnalyticGerm 1)) := by
  let := adim_noetherian_succ 0 adim_noetherian_zero
  infer_instance

example : IsNoetherianRing (Polynomial (AnalyticGerm 3)) := by
  let := adim_noetherian 3
  infer_instance

end HodgeLean.Foundations
