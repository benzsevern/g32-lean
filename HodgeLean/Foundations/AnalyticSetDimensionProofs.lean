private abbrev adimCanonicalEmbedding :=
  adimPrivate% "_private.HodgeLean.Foundations.AnalyticDivisorAlgebraic6Proofs.0.HodgeLean.Foundations.AnalyticDivisorAlgebraic6.canonicalEmbedding"

private abbrev adimCanonicalEmbeddingSpec :=
  adimPrivate% "_private.HodgeLean.Foundations.AnalyticDivisorAlgebraic6Proofs.0.HodgeLean.Foundations.AnalyticDivisorAlgebraic6.canonicalEmbedding_spec"

private abbrev adimSplitGermEquiv :=
  adimPrivate% "_private.HodgeLean.Foundations.AnalyticDivisorAlgebraic6Proofs.0.HodgeLean.Foundations.AnalyticDivisorAlgebraic6.splitGermEquiv"

private abbrev adimProductPolynomial :=
  adimPrivate% "_private.HodgeLean.Foundations.AnalyticDivisorAlgebraic6Proofs.0.HodgeLean.Foundations.AnalyticDivisorAlgebraic6.productPolynomial"

private abbrev adimProductPolynomialSum :=
  adimPrivate% "_private.HodgeLean.Foundations.AnalyticDivisorAlgebraic6Proofs.0.HodgeLean.Foundations.AnalyticDivisorAlgebraic6.productPolynomial_sum"

private abbrev adimWeierstrassRepresentative :=
  adimPrivate% "_private.HodgeLean.Foundations.AnalyticDivisorAlgebraic6Proofs.0.HodgeLean.Foundations.AnalyticDivisorAlgebraic6.weierstrass_representative"

private theorem adim_weierstrass_division {n : ℕ}
    (P : Polynomial (AnalyticGerm n)) (hP : IsWeierstrassPolynomial P)
    (g : AnalyticGerm (n + 1)) :
    ∃ (q : AnalyticGerm (n + 1)) (r : Polynomial (AnalyticGerm n)),
      r.degree < P.natDegree ∧
        g = q * adimCanonicalEmbedding n P + adimCanonicalEmbedding n r := by
  let e := adimSplitGermEquiv n
  obtain ⟨f, hf, hfg⟩ := (e g).2
  obtain ⟨a, ha, hPa⟩ := adimWeierstrassRepresentative hP
  obtain ⟨q, hq, b, hb, hdiv⟩ :=
    HodgeLean.Foundations.AnalyticDivisorAlgebraic4.spec_weierstrass_division
      hf (fun j ↦ (ha j).1) (fun j ↦ (ha j).2)
  let qb : ProductAnalyticGerm n := ⟨↑q, q, hq, rfl⟩
  let qg : AnalyticGerm (n + 1) := e.symm qb
  let bg : Fin P.natDegree → AnalyticGerm n := fun j ↦ ⟨↑(b j), b j, hb j, rfl⟩
  let r : Polynomial (AnalyticGerm n) := ∑ j, C (bg j) * X ^ (j : ℕ)
  refine ⟨qg, r, ?_, ?_⟩
  · by_cases hr : r = 0
    · rw [hr, degree_zero]
      exact WithBot.bot_lt_coe _
    · exact lt_of_le_of_lt (degree_sum_le _ _) <|
        (Finset.sup_lt_iff (WithBot.bot_lt_coe _)).2 fun j _ ↦
          lt_of_le_of_lt (degree_C_mul_X_pow_le _ _) (by exact_mod_cast j.2)
  · apply e.injective
    simp only [qg, map_add, map_mul, RingEquiv.apply_symm_apply, adimCanonicalEmbedding]
    have hc : ∀ Q, e (adimCanonicalEmbedding n Q) = adimProductPolynomial n Q :=
      fun Q ↦ by
        change e (e.symm (adimProductPolynomial n Q)) = _
        exact e.apply_symm_apply _
    rw [hc, hc]
    change e g = qb * adimProductPolynomial n P + adimProductPolynomial n r
    apply Subtype.ext
    change (e g).1 = qb.1 * (adimProductPolynomial n P).1 +
      (adimProductPolynomial n r).1
    rw [← hfg, hPa]
    rw [adimProductPolynomialSum bg b (fun _ ↦ rfl)]
    exact Filter.Germ.coe_eq.mpr hdiv

/-- Division by a distinguished polynomial gives polynomial representatives modulo its image.
Source: Gunning--Rossi, II.B, Weierstrass division theorem. -/
theorem adim_division_representative_aux (n : ℕ)
    (ι : Polynomial (AnalyticGerm n) →+* AnalyticGerm (n + 1))
    (hι : IsWeierstrassEmbedding ι) (P : Polynomial (AnalyticGerm n))
    (hP : IsWeierstrassPolynomial P) (g : AnalyticGerm (n + 1)) :
    ∃ (q : AnalyticGerm (n + 1)) (r : Polynomial (AnalyticGerm n)),
      r.degree < P.natDegree ∧ g = q * ι P + ι r := by
  rw [weierstrassEmbedding_unique hι (adimCanonicalEmbeddingSpec n)]
  exact adim_weierstrass_division P hP g

/-- An ideal containing a distinguished polynomial is generated by finitely many polynomial images.
Source: Gunning--Rossi, II.B, Noetherian induction using Weierstrass division. -/
theorem adim_prepared_ideal_aux (n : ℕ) (hn : IsNoetherianRing (AnalyticGerm n))
    (ι : Polynomial (AnalyticGerm n) →+* AnalyticGerm (n + 1))
    (hι : IsWeierstrassEmbedding ι) (P : Polynomial (AnalyticGerm n))
    (hP : IsWeierstrassPolynomial P) (I : Ideal (AnalyticGerm (n + 1)))
    (hI : ι P ∈ I) :
    ∃ s : Finset (Polynomial (AnalyticGerm n)), Ideal.span (ι '' (s : Set _)) = I := by
  let J : Ideal (Polynomial (AnalyticGerm n)) := I.comap ι
  letI : IsNoetherianRing (AnalyticGerm n) := hn
  have hpoly : IsNoetherianRing (Polynomial (AnalyticGerm n)) :=
    Polynomial.isNoetherianRing
  obtain ⟨t, htfin, ht⟩ :=
    Submodule.fg_def.mp ((isNoetherianRing_iff_ideal_fg _).mp hpoly J)
  change Ideal.span t = J at ht
  refine ⟨htfin.toFinset, ?_⟩
  rw [htfin.coe_toFinset]
  apply le_antisymm
  · rw [Ideal.span_le]
    rintro _ ⟨f, hf, rfl⟩
    have hfJ : f ∈ J := by
      rw [← ht]
      exact Ideal.subset_span hf
    exact hfJ
  · intro g hg
    obtain ⟨q, r, -, hgr⟩ := adim_division_representative_aux n ι hι P hP g
    have hrI : ι r ∈ I := by
      have hre : ι r = g - q * ι P := by rw [hgr]; ring
      rw [hre]
      exact I.sub_mem hg (I.mul_mem_left q hI)
    have hrJ : r ∈ J := hrI
    have hrspan : ι r ∈ Ideal.span (ι '' t) := by
      have hr : r ∈ Ideal.span t := by rw [ht]; exact hrJ
      rw [← Ideal.map_span]
      exact Ideal.mem_map_of_mem ι hr
    have hPJ : P ∈ J := hI
    have hPspan : ι P ∈ Ideal.span (ι '' t) := by
      have hmem : P ∈ Ideal.span t := by rw [ht]; exact hPJ
      rw [← Ideal.map_span]
      exact Ideal.mem_map_of_mem ι hmem
    rw [hgr]
    exact (Ideal.span (ι '' t)).add_mem
      ((Ideal.span (ι '' t)).mul_mem_left q hPspan) hrspan

/-- In zero variables evaluation identifies analytic germs with the coefficient field.
Source: Gunning--Rossi, II.B, the base of the Noetherian induction. -/
theorem adim_noetherian_zero_aux : IsNoetherianRing (AnalyticGerm 0) := by
  let e : AnalyticGerm 0 ≃+* ℂ := RingEquiv.ofBijective (analyticGermValue 0) ⟨by
    rintro ⟨g, f, hf, rfl⟩ ⟨h, k, hk, rfl⟩ hv
    apply Subtype.ext
    rw [Filter.Germ.coe_eq]
    filter_upwards [] with z
    have hz : z = 0 := Subsingleton.elim _ _
    change f 0 = k 0 at hv
    simpa [hz] using hv
  , by
    intro c
    refine ⟨⟨@Filter.Germ.ofFun (Fin 0 → ℂ) ℂ (nhds 0) (fun _ ↦ c),
      ⟨fun _ ↦ c, analyticAt_const, rfl⟩⟩, ?_⟩
    change (@Filter.Germ.ofFun (Fin 0 → ℂ) ℂ (nhds 0) (fun _ ↦ c)).value = c
    simpa using (Filter.Germ.value_ofFun (fun _ : Fin 0 → ℂ ↦ c) (0 : Fin 0 → ℂ))⟩
  rw [isNoetherianRing_iff_ideal_fg]
  intro I
  have h : (I.map e.toRingHom).FG := Ideal.fg_of_isNoetherianRing _
  have h' := h.map e.symm.toRingHom
  simpa only [RingEquiv.toRingHom_eq_coe, Ideal.map_of_equiv] using h'

/-- Preparation and division propagate Noetherianity to the next ambient dimension.
Source: Gunning--Rossi, II.B, Noetherianity of convergent power series rings. -/
theorem adim_noetherian_succ_aux (n : ℕ) (hn : IsNoetherianRing (AnalyticGerm n)) :
    IsNoetherianRing (AnalyticGerm (n + 1)) := by
  rw [isNoetherianRing_iff_ideal_fg]
  intro I
  by_cases hI0 : I = ⊥
  · rw [hI0]
    exact Submodule.fg_bot
  by_cases hI1 : I = ⊤
  · rw [hI1]
    exact Ideal.fg_top _
  obtain ⟨g, hgI, hg0⟩ : ∃ g ∈ I, g ≠ 0 := by
    exact Submodule.exists_mem_ne_zero_of_ne_bot hI0
  have hgu : ¬ IsUnit g := fun h ↦ hI1 (I.eq_top_of_isUnit_mem hgI h)
  obtain ⟨L, e, he, hreg⟩ := spec_exists_linearChange_regular hg0 hgu
  have hegu : ¬ IsUnit (e g) := fun h ↦ hgu (by simpa using h.map e.symm)
  obtain ⟨ι, P, hι, hP, hassoc⟩ := spec_preparation_transfer hreg hegu
  let J : Ideal (AnalyticGerm (n + 1)) := I.map e.toRingHom
  have hegJ : e g ∈ J := Ideal.mem_map_of_mem e.toRingHom hgI
  have hιPJ : ι P ∈ J := by
    obtain ⟨c, hc⟩ := hassoc.dvd
    rw [hc]
    exact J.mul_mem_right c hegJ
  obtain ⟨s, hs⟩ := adim_prepared_ideal_aux n hn ι hι P hP J hιPJ
  have hJ : J.FG := by
    rw [← hs]
    exact Submodule.fg_span (s.finite_toSet.image ι)
  have hback := hJ.map e.symm.toRingHom
  simpa only [J, RingEquiv.toRingHom_eq_coe, Ideal.map_of_equiv] using hback

/-- Analytic local rings at the origin in every finite dimension are Noetherian.
Source: Gunning--Rossi, II.B, Noetherianity of convergent power series rings. -/
theorem adim_noetherian_aux (n : ℕ) : IsNoetherianRing (AnalyticGerm n) := by
  induction n with
  | zero => exact adim_noetherian_zero_aux
  | succ n ih => exact adim_noetherian_succ_aux n ih

end HodgeLean.Foundations
