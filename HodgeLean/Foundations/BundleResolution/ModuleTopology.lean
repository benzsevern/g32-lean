import HodgeLean.Foundations.BundleThom.ConormalTransport
import Mathlib.Algebra.Category.ModuleCat.Sheaf.LocallyFree
import HodgeLean.Foundations.BundleThom.Defs
import HodgeConjecture.Lemmas.AlgebraicGeometry.ComplexPoint.Open
import Mathlib.Algebra.Category.ModuleCat.Sheaf.PullbackFree

/-! # Analytic topology on dual fibres of an algebraic module

Local algebraic sections supply evaluation coordinates. The total-space
 topology is generated by these coordinates and the analytic base topology.
HC no distance; AV milestone no distance. -/

noncomputable section
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
open CategoryTheory AlgebraicGeometry TopologicalSpace Bundle
namespace HodgeLean.Foundations.BundleResolution

/-- Complex fibre of the supplied algebraic module, pulled back to the actual point.
Source: Hartshorne, Algebraic Geometry, II.5, fibres. -/
abbrev i1_moduleFibre {Q : Over (Spec ↧ℂ)} (M : Q.left.Modules)
    (x : ComplexPoint Q) : ModuleCat ℂ :=
  (moduleSpecΓFunctor (R := CommRingCat.of ℂ)).obj
    ((Scheme.Modules.pullback x.left).obj M)

/-- Dual of the actual module fibre.
Source: Hartshorne, Algebraic Geometry, II.8, dual bundles. -/
abbrev i1_moduleDualFibre {Q : Over (Spec ↧ℂ)} (M : Q.left.Modules)
    (x : ComplexPoint Q) := Module.Dual ℂ (i1_moduleFibre M x)

/-- Specialize a local module section at an actual complex point.
Source: Hartshorne, Algebraic Geometry, II.5, fibres and pullback of sections. -/
def i1_moduleSectionValue {Q : Over (Spec ↧ℂ)}
    (M : Q.left.Modules) (U : Q.left.Opens)
    (s : SheafOfModules.unit U.toScheme.ringCatSheaf ⟶
      (Scheme.Modules.pullback U.ι).obj M)
    (x : ComplexPoint Q) (hx : x ∈ Point.overOpen U) : i1_moduleFibre M x := by
  let a := ComplexPoint.liftToOpen Q U x hx
  letI : (SheafOfModules.pushforward a.toRingCatSheafHom).IsRightAdjoint :=
    (inferInstance : (Scheme.Modules.pushforward a).IsRightAdjoint)
  let t : SheafOfModules.unit (Spec ↧ℂ).ringCatSheaf ⟶
      (Scheme.Modules.pullback x.left).obj M :=
    inv (SheafOfModules.pullbackObjUnitToUnit a.toRingCatSheafHom) ≫
      (Scheme.Modules.pullback a).map s ≫
      (Scheme.Modules.pullbackComp a U.ι).hom.app M ≫
      (Scheme.Modules.pullbackCongr (ComplexPoint.liftToOpen_fac Q U x hx)).hom.app
        M
  exact (moduleSpecΓFunctor (R := CommRingCat.of ℂ)).map t (1 : Γ(Spec ↧ℂ, ⊤))

/-- Pointwise evaluation topology on a dual module fibre.
Source: Hartshorne, II.8; finite-dimensional complex dual topology. -/
def i1_moduleDualFibreTopology {Q : Over (Spec ↧ℂ)}
    (M : Q.left.Modules) (x : ComplexPoint Q) : TopologicalSpace (i1_moduleDualFibre M x) :=
  TopologicalSpace.induced (fun f : i1_moduleDualFibre M x => fun m => f m) inferInstance

/-- The analytic total topology generated by base opens and local section evaluations.
Source: Hartshorne, II.5 and II.8; Bott–Tu, §6, bundle charts. -/
def i1_moduleDualTotalTopology {Q : Over (Spec ↧ℂ)}
    (M : Q.left.Modules) (k : ℕ) :
    TopologicalSpace (TotalSpace (Fin k → ℂ) (i1_moduleDualFibre M)) :=
  TopologicalSpace.generateFrom {A | (∃ O : Set (ComplexPoint Q), IsOpen O ∧
    A = TotalSpace.proj ⁻¹' O) ∨
    ∃ (U : Q.left.Opens)
      (s : SheafOfModules.unit U.toScheme.ringCatSheaf ⟶
        (Scheme.Modules.pullback U.ι).obj M)
      (O : Set ℂ), IsOpen O ∧ A = {v | ∃ hx : v.proj ∈ Point.overOpen U,
        v.2 (i1_moduleSectionValue M U s v.proj hx) ∈ O}}

example {Q : Over (Spec ↧ℂ)} (M : Q.left.Modules)
    (x : ComplexPoint Q) (f : i1_moduleDualFibre M x) (m : i1_moduleFibre M x) :
    f ((3 : ℂ) • m) = 3 * f m := map_smul f 3 m

example {Q : Over (Spec ↧ℂ)} (M : Q.left.Modules) (k : ℕ) :
    TopologicalSpace (TotalSpace (Fin k → ℂ) (i1_moduleDualFibre M)) :=
  i1_moduleDualTotalTopology M k

example {Q : Over (Spec ↧ℂ)} (M : Q.left.Modules) (x : ComplexPoint Q)
    (f : i1_moduleDualFibre M x) (m : i1_moduleFibre M x) :
    f (m + m) = f m + f m := map_add f m m

end HodgeLean.Foundations.BundleResolution
