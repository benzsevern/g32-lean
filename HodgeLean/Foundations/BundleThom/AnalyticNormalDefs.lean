import HodgeLean.Foundations.BundleThom.ConormalTransport
import HodgeLean.Foundations.BundleThom.Defs
import HodgeConjecture.Lemmas.AlgebraicGeometry.ComplexPoint.Open
import Mathlib.Algebra.Category.ModuleCat.Sheaf.PullbackFree

/-! # Analytic topology on the actual dual conormal

Local algebraic sections supply evaluation coordinates. The total-space
 topology is generated by these coordinates and the analytic base topology.
HC no distance; AV milestone no distance. -/

noncomputable section
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
open CategoryTheory AlgebraicGeometry TopologicalSpace Bundle
namespace HodgeLean.Foundations.BundleThom

/-- Specialize a local conormal section at an actual complex point.
Source: Hartshorne, Algebraic Geometry, II.5, fibres and pullback of sections. -/
def i1_conormalSectionValue {Q : Over (Spec ↧ℂ)} {V : Scheme}
    (j : Q.left ⟶ V) (U : Q.left.Opens)
    (s : SheafOfModules.unit U.toScheme.ringCatSheaf ⟶
      (Scheme.Modules.pullback U.ι).obj (Conormal.sheaf j))
    (x : ComplexPoint Q) (hx : x ∈ Point.overOpen U) : i1_conormalFibre j x := by
  let a := ComplexPoint.liftToOpen Q U x hx
  letI : (SheafOfModules.pushforward a.toRingCatSheafHom).IsRightAdjoint :=
    (inferInstance : (Scheme.Modules.pushforward a).IsRightAdjoint)
  let t : SheafOfModules.unit (Spec ↧ℂ).ringCatSheaf ⟶
      (Scheme.Modules.pullback x.left).obj (Conormal.sheaf j) :=
    inv (SheafOfModules.pullbackObjUnitToUnit a.toRingCatSheafHom) ≫
      (Scheme.Modules.pullback a).map s ≫
      (Scheme.Modules.pullbackComp a U.ι).hom.app (Conormal.sheaf j) ≫
      (Scheme.Modules.pullbackCongr (ComplexPoint.liftToOpen_fac Q U x hx)).hom.app
        (Conormal.sheaf j)
  exact (moduleSpecΓFunctor (R := CommRingCat.of ℂ)).map t (1 : Γ(Spec ↧ℂ, ⊤))

/-- Pointwise evaluation topology on a dual conormal fibre.
Source: Hartshorne, II.8; finite-dimensional complex dual topology. -/
def i1_normalFibreTopology {Q : Over (Spec ↧ℂ)} {V : Scheme}
    (j : Q.left ⟶ V) (x : ComplexPoint Q) : TopologicalSpace (i1_normalFibre j x) :=
  TopologicalSpace.induced (fun f : i1_normalFibre j x => fun m => f m) inferInstance

/-- The analytic total topology generated by base opens and local section evaluations.
Source: Hartshorne, II.5 and II.8; Bott–Tu, §6, bundle charts. -/
def i1_normalTotalTopology {Q : Over (Spec ↧ℂ)} {V : Scheme}
    (j : Q.left ⟶ V) (k : ℕ) :
    TopologicalSpace (TotalSpace (Fin k → ℂ) (i1_normalFibre j)) :=
  TopologicalSpace.generateFrom {A | (∃ O : Set (ComplexPoint Q), IsOpen O ∧
    A = TotalSpace.proj ⁻¹' O) ∨
    ∃ (U : Q.left.Opens)
      (s : SheafOfModules.unit U.toScheme.ringCatSheaf ⟶
        (Scheme.Modules.pullback U.ι).obj (Conormal.sheaf j))
      (O : Set ℂ), IsOpen O ∧ A = {v | ∃ hx : v.proj ∈ Point.overOpen U,
        v.2 (i1_conormalSectionValue j U s v.proj hx) ∈ O}}

example {Q : Over (Spec ↧ℂ)} {V : Scheme} (j : Q.left ⟶ V)
    (x : ComplexPoint Q) (f : i1_normalFibre j x) (m : i1_conormalFibre j x) :
    f ((3 : ℂ) • m) = 3 * f m := map_smul f 3 m

example {Q : Over (Spec ↧ℂ)} {V : Scheme} (j : Q.left ⟶ V) (k : ℕ) :
    TopologicalSpace (TotalSpace (Fin k → ℂ) (i1_normalFibre j)) :=
  i1_normalTotalTopology j k

example {Q : Over (Spec ↧ℂ)} {V : Scheme} (j : Q.left ⟶ V)
    (x : ComplexPoint Q) (m : i1_conormalFibre j x) :
    @Continuous (i1_normalFibre j x) ℂ (i1_normalFibreTopology j x) inferInstance
      (fun f => f m) := by
  letI := i1_normalFibreTopology j x
  exact (continuous_apply m).comp continuous_induced_dom

end HodgeLean.Foundations.BundleThom
