import HodgeLean.Foundations.ComplexSheafSingularProofs

/-! # The complex sheaf-to-singular comparison: frozen specification

Inputs stage 3c. Stage 3b (`HodgeLean.Adapters.DeRhamAbelian`) reduced Betti–de Rham bijectivity
for abelian `X` to one missing lemma, a `ℂ`-linear equivalence
`H^n(X(ℂ); ℂ) ≃ H^n_sing(X(ℂ); ℂ)` (the premise of
`spec_bijective_bettiDeRhamHQ_of_complexSingular`). Upstream proves the comparison over `ℚ`
only. This file states its generalization to other coefficients, split along the upstream proof,
so that each statement is proved by porting one upstream `ℚ` statement.

Claimed:
* small-chain approximation for an open cover, with coefficients in any commutative ring `K`:
  the inclusion of cover-small singular chains is a chain homotopy equivalence;
* its dual: restriction of `K`-cochains to cover-small chains is a quasi-isomorphism;
* for a field `K`: a closed `K`-cochain that is locally zero along a covering sieve has a locally
  zero primitive; ordinary `K`-cochains are quasi-isomorphic to global sections of the first-plus
  cochain complex (every space) and of the singular-cochain sheaf complex (paracompact Hausdorff);
* flasqueness of every term of the integer-indexed singular-cochain resolution, any `K`;
* for a field `K` and hereditarily paracompact Hausdorff `X(ℂ)`: hypercohomology of the
  `K`-singular-cochain resolution is additively equivalent to `H^n_sing(X(ℂ); K)`;
* for any `K` and those topological inputs: the edge map from cohomology of global sections to
  hypercohomology of the `K`-singular-cochain resolution is bijective;
* for a field `K` and smooth integral `X` with those topological inputs: the named additive
  comparison `singularToFieldCohomology K X n : H^n_sing(X(ℂ); K) →+ H^n(X(ℂ); K)`
  (`HodgeLean.Foundations.ComplexSheafSingularDefs`) is bijective;
* for a field `K` and smooth integral `X`: that named comparison commutes with multiplication by
  every `c : K`;
* for a subfield `K` of `ℂ` and smooth integral `X` with those topological inputs: a `K`-linear
  equivalence `H^n(X(ℂ); K) ≃ H^n_sing(X(ℂ); K)`, the corollary of the previous two;
* for smooth projective integral `X`: the `ℂ`-linear equivalence, in the exact form that
  `spec_bijective_bettiDeRhamHQ_of_complexSingular` consumes;
* for abelian `X`: `BettiDeRhamIso X`, as the implication from the previous statement through
  stage 3b;
* the falsification check `dim H^1(X(ℂ); ℂ) = 2g` for abelian `X`.

Not claimed: naturality of the comparison in `X`, compatibility with cup products, any statement
with non-constant coefficient sheaves, integral coefficients for the sheaf-side module structure,
or any Hodge-theoretic input. No statement assumes `BettiDeRhamIso` or `HodgeDecomposition`.
HC no distance; AV milestone no distance.
-/

noncomputable section
open CategoryTheory CategoryTheory.Limits AlgebraicGeometry ComplexPoint TopologicalSpace
open AlgebraicTopology.Singular
open HodgeLean.RealDefs

namespace HodgeLean.Foundations

/-- Small-chain approximation with coefficients in a commutative ring `K`: for an open cover `U`
of `Y`, the inclusion of the `K`-chains generated by simplices that lie in one member of `U` into
all singular `K`-chains is a chain homotopy equivalence.

Source: Hatcher, *Algebraic Topology*, Proposition 2.21 (stated for every coefficient group);
generalizes upstream's `coverSmallRationalChainApproximation_of_openCover`
(`Lemmas/AlgebraicTopology/Singular/Excision/Field.lean`), which transports the integral
homotopy along `ℤ → ℚ`; the same transport works along `ℤ → K`. -/
theorem spec_coverSmallChainApproximation_of_openCover (K : Type) [CommRing K]
    {ι : Type} (Y : TopCat.{0}) (U : ι → Set Y) (hUopen : ∀ i, IsOpen (U i))
    (hUcover : ⋃ i, U i = Set.univ) :
    HomologicalComplex.homotopyEquivalences (ModuleCat K) (ComplexShape.down ℕ)
      (SSet.chainComplexMap (coverSmallSingularSubcomplex Y U).ι (ModuleCat.of K K)) :=
  spec_coverSmallChainApproximation_of_openCover_aux K Y U hUopen hUcover

example {ι : Type} (Y : TopCat.{0}) (U : ι → Set Y) (hUopen : ∀ i, IsOpen (U i))
    (hUcover : ⋃ i, U i = Set.univ) :
    HomologicalComplex.homotopyEquivalences (ModuleCat ℂ) (ComplexShape.down ℕ)
      (SSet.chainComplexMap (coverSmallSingularSubcomplex Y U).ι (ModuleCat.of ℂ ℂ)) :=
  spec_coverSmallChainApproximation_of_openCover ℂ Y U hUopen hUcover

/-- Restriction of singular `K`-cochains to the chains subordinate to an open cover is a
quasi-isomorphism, for every commutative ring `K`.

Source: Hatcher, *Algebraic Topology*, Proposition 2.21 and §3.1 (dualizing a chain homotopy
equivalence); generalizes upstream's `rationalCochainRestrictionToCoverSmall_quasiIso`
(`Lemmas/AlgebraicTopology/Singular/Sheaf/SubdivisionCochain.lean`). -/
theorem spec_cochainRestrictionToCoverSmall_quasiIso (K : Type) [CommRing K]
    {ι : Type} (Y : TopCat.{0}) (U : ι → Set Y) (hUopen : ∀ i, IsOpen (U i))
    (hUcover : ⋃ i, U i = Set.univ) :
    QuasiIso (HomologicalComplex.linearDualMap
      (SSet.chainComplexMap (coverSmallSingularSubcomplex Y U).ι (ModuleCat.of K K))) :=
  spec_cochainRestrictionToCoverSmall_quasiIso_aux K Y U hUopen hUcover

example {ι : Type} (Y : TopCat.{0}) (U : ι → Set Y) (hUopen : ∀ i, IsOpen (U i))
    (hUcover : ⋃ i, U i = Set.univ) :
    QuasiIso (HomologicalComplex.linearDualMap
      (SSet.chainComplexMap (coverSmallSingularSubcomplex Y U).ι (ModuleCat.of ℂ ℂ))) :=
  spec_cochainRestrictionToCoverSmall_quasiIso ℂ Y U hUopen hUcover

/-- Over a field `K`: a closed singular `K`-cochain on `Y` that restricts to zero on every member
of a covering sieve of `Y` is the coboundary of a cochain that also restricts to zero on every
member of that sieve.

Source: Bredon, *Sheaf Theory*, 2nd ed., GTM 170, III.1 (the locally zero cochains form an
acyclic complex), with Hatcher, Proposition 2.21; generalizes upstream's
`exists_topOpenLocallyZero_primitive` (`SubdivisionCochain.lean`, `section RationalCover`). -/
theorem spec_exists_topOpenLocallyZero_primitive (K : Type) [Field K]
    (Y : TopCat.{0}) (S : (Opens.grothendieckTopology Y).Cover (⊤ : Opens Y)) (n : ℕ)
    (φ : (TopOpenSingularChainComplex K Y).linearDualCochainComplex.X n)
    (hφlocal : ∀ I : S.Arrow, (singularCochainPresheaf K Y n).map I.f.op φ = 0)
    (hφclosed : ((TopOpenSingularChainComplex K Y).linearDualCochainComplex.d
      n (n + 1)) φ = 0) :
    ∃ ψ : (TopOpenSingularChainComplex K Y).linearDualCochainComplex.X
        ((ComplexShape.up ℕ).prev n),
      ((TopOpenSingularChainComplex K Y).linearDualCochainComplex.sc n).f ψ = φ ∧
        ∀ I : S.Arrow,
          (singularCochainPresheaf K Y ((ComplexShape.up ℕ).prev n)).map I.f.op ψ = 0 :=
  spec_exists_topOpenLocallyZero_primitive_aux K Y S n φ hφlocal hφclosed

example (Y : TopCat.{0}) (S : (Opens.grothendieckTopology Y).Cover (⊤ : Opens Y))
    (φ : (TopOpenSingularChainComplex ℂ Y).linearDualCochainComplex.X 1)
    (hφlocal : ∀ I : S.Arrow, (singularCochainPresheaf ℂ Y 1).map I.f.op φ = 0)
    (hφclosed : ((TopOpenSingularChainComplex ℂ Y).linearDualCochainComplex.d 1 2) φ = 0) :
    ∃ ψ : (TopOpenSingularChainComplex ℂ Y).linearDualCochainComplex.X
        ((ComplexShape.up ℕ).prev 1),
      ((TopOpenSingularChainComplex ℂ Y).linearDualCochainComplex.sc 1).f ψ = φ ∧
        ∀ I : S.Arrow,
          (singularCochainPresheaf ℂ Y ((ComplexShape.up ℕ).prev 1)).map I.f.op ψ = 0 :=
  spec_exists_topOpenLocallyZero_primitive ℂ Y S 1 φ hφlocal hφclosed

/-- Over a field `K`, ordinary singular `K`-cochains on any space map quasi-isomorphically to
global sections of the first-plus singular-cochain complex.

Source: Bredon, *Sheaf Theory*, 2nd ed., GTM 170, III.1; generalizes upstream's
`topOpenToGlobalSingularCochainPlusComplex_quasiIso` (`SubdivisionCochain.lean`). -/
theorem spec_topOpenToGlobalSingularCochainPlusComplex_quasiIso (K : Type) [Field K]
    (Y : TopCat.{0}) :
    QuasiIso (topOpenToGlobalSingularCochainPlusComplex K Y) :=
  spec_topOpenToGlobalSingularCochainPlusComplex_quasiIso_aux K Y

example (Y : TopCat.{0}) : QuasiIso (topOpenToGlobalSingularCochainPlusComplex ℂ Y) :=
  spec_topOpenToGlobalSingularCochainPlusComplex_quasiIso ℂ Y

/-- Over a field `K`, on a paracompact Hausdorff space, ordinary singular `K`-cochains compute the
global sections of the singular-cochain sheaf complex.

Source: Bredon, *Sheaf Theory*, 2nd ed., GTM 170, III.1 and III.2; generalizes upstream's
`topOpenToGlobalSingularCochainSheafComplex_quasiIso` (`SubdivisionCochain.lean`). -/
theorem spec_topOpenToGlobalSingularCochainSheafComplex_quasiIso (K : Type) [Field K]
    (Y : TopCat.{0}) [ParacompactSpace Y] [T2Space Y] :
    QuasiIso (topOpenToGlobalSingularCochainSheafComplex K Y) :=
  spec_topOpenToGlobalSingularCochainSheafComplex_quasiIso_aux K Y

example (Y : TopCat.{0}) [ParacompactSpace Y] [T2Space Y] :
    QuasiIso (topOpenToGlobalSingularCochainSheafComplex ℂ Y) :=
  spec_topOpenToGlobalSingularCochainSheafComplex_quasiIso ℂ Y

/-- Every integer-indexed term of the `K`-singular-cochain resolution on `X(ℂ)` is flasque when
`X(ℂ)` is Hausdorff and every open subset is paracompact, for every commutative ring `K`.

Source: Bredon, *Sheaf Theory*, 2nd ed., GTM 170, III.1 (the sheaf of singular cochains is
flasque on a hereditarily paracompact space); generalizes the `ℚ`-only
`singularCochainSheafComplexInt_isFlasque`
(`HodgeLean/Foundations/Port/AlgebraicGeometry/Cohomology/GlobalSections.lean`), whose proof uses
upstream's coefficient-generic `singularCochainSheaf_isFlasque_of_opens_paracompact`. -/
theorem spec_singularCochainSheafComplexInt_isFlasque (K : Type) [CommRing K]
    (X : Over (Spec ↧ℂ)) [T2Space (ComplexPoint X)]
    [∀ U : Opens (ComplexPoint X), ParacompactSpace U] (n : ℤ) :
    TopCat.Sheaf.IsFlasque ((singularCochainSheafComplexInt X K).X n) :=
  spec_singularCochainSheafComplexInt_isFlasque_aux K X n

example (X : Over (Spec ↧ℂ)) [T2Space (ComplexPoint X)]
    [∀ U : Opens (ComplexPoint X), ParacompactSpace U] :
    TopCat.Sheaf.IsFlasque ((singularCochainSheafComplexInt X ℂ).X 2) :=
  spec_singularCochainSheafComplexInt_isFlasque ℂ X 2

/-- Over a field `K`, when `X(ℂ)` is Hausdorff and every open subset is paracompact,
hypercohomology of the `K`-singular-cochain resolution is additively equivalent to singular
cohomology `H^n_sing(X(ℂ); K)`.

Source: Bredon, *Sheaf Theory*, 2nd ed., GTM 170, III.1 (flasque resolutions compute
cohomology); generalizes upstream's `rationalSingularCochainHypercohomologyAddEquivCohomology`
(`Other/AlgebraicGeometry/Cohomology/GlobalSections.lean`, ported in this repository). -/
theorem spec_singularCochainHypercohomology_addEquiv_cohomology (K : Type) [Field K]
    (X : Over (Spec ↧ℂ)) [T2Space (ComplexPoint X)]
    [∀ U : Opens (ComplexPoint X), ParacompactSpace U] (n : ℕ) :
    Nonempty (Hypercohomology X (singularCochainSheafComplexInt X K) (n : ℤ) ≃+
      AlgebraicTopology.Singular.Cohomology K (TopCat.of (ComplexPoint X)) n) :=
  spec_singularCochainHypercohomology_addEquiv_cohomology_aux K X n

example (X : Over (Spec ↧ℂ)) [T2Space (ComplexPoint X)]
    [∀ U : Opens (ComplexPoint X), ParacompactSpace U] :
    Nonempty (Hypercohomology X (singularCochainSheafComplexInt X ℂ) ((1 : ℕ) : ℤ) ≃+
      AlgebraicTopology.Singular.Cohomology ℂ (TopCat.of (ComplexPoint X)) 1) :=
  spec_singularCochainHypercohomology_addEquiv_cohomology ℂ X 1

/-- For every commutative ring `K`, when `X(ℂ)` is Hausdorff and every open subset is paracompact,
the edge map `H^n(Γ(X(ℂ), S)) → ℍ^n(X(ℂ); S)` (`globalSectionsToHypercohomology`) is bijective in
every degree for the integer-indexed `K`-singular-cochain resolution
`S = singularCochainSheafComplexInt X K`.

Source: Bredon, *Sheaf Theory*, 2nd ed., GTM 170, II.4 (flasque sheaves are acyclic for global
sections, so a bounded-below complex of flasque sheaves computes its hypercohomology through global
sections); generalizes upstream's `rationalSingularCochainHypercohomologyAddEquivGlobalSectionsOfResolution`
(`Other/AlgebraicGeometry/Cohomology/GlobalSections.lean`), whose proof uses termwise flasqueness
(here `spec_singularCochainSheafComplexInt_isFlasque`) and `globalSectionsComplex_map_quasiIso`. -/
theorem spec_globalSectionsToHypercohomology_bijective (K : Type) [CommRing K]
    (X : Over (Spec ↧ℂ)) [T2Space (ComplexPoint X)]
    [∀ U : Opens (ComplexPoint X), ParacompactSpace U] (n : ℤ) :
    Function.Bijective
      (globalSectionsToHypercohomology X (singularCochainSheafComplexInt X K) n) :=
  spec_globalSectionsToHypercohomology_bijective_aux K X n

example (X : Over (Spec ↧ℂ)) [T2Space (ComplexPoint X)]
    [∀ U : Opens (ComplexPoint X), ParacompactSpace U] :
    Function.Surjective
      (globalSectionsToHypercohomology X (singularCochainSheafComplexInt X ℂ) 2) :=
  (spec_globalSectionsToHypercohomology_bijective ℂ X 2).surjective

/-- For a field `K` and a smooth integral `X` with `X(ℂ)` Hausdorff and hereditarily paracompact,
the named comparison `singularToFieldCohomology K X n : H^n_sing(X(ℂ); K) →+ H^n(X(ℂ); K)` is
bijective in every degree.

Source: Bredon, *Sheaf Theory*, 2nd ed., GTM 170, III.1 (singular cochain sheaves form a flasque
resolution of the constant sheaf on a locally contractible hereditarily paracompact space) and II.4
(flasque resolutions compute sheaf cohomology through global sections); assembled from
`spec_topOpenToGlobalSingularCochainSheafComplex_quasiIso`,
`spec_globalSectionsToHypercohomology_bijective` and upstream's
`constantsToSingularCochainComplexInt_quasiIso`, as in upstream's
`rationalCohomologyAddEquivSingularCohomology` (`Other/AlgebraicGeometry/Cohomology/GlobalSections.lean`). -/
theorem spec_singularToFieldCohomology_bijective (K : Type) [Field K]
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [T2Space (ComplexPoint X)]
    [∀ U : Opens (ComplexPoint X), ParacompactSpace U] (n : ℕ) :
    Function.Bijective (singularToFieldCohomology K X n) :=
  spec_singularToFieldCohomology_bijective_aux K X n

example (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [T2Space (ComplexPoint X)]
    [∀ U : Opens (ComplexPoint X), ParacompactSpace U] :
    Function.Injective (singularToFieldCohomology ℂ X 1) :=
  (spec_singularToFieldCohomology_bijective ℂ X 1).injective

/-- For a field `K` and a smooth integral `X`, the named comparison
`singularToFieldCohomology K X n` commutes with multiplication by every `c : K`. The `K`-structure
on `H^n(X(ℂ); K)` is upstream's `fieldCohomologyModule`, induced by the coefficient endomorphism
`fieldScalarSheaf K X c`; on singular cohomology it is the module structure of the cochains.

Source: Bredon, *Sheaf Theory*, 2nd ed., GTM 170, III.1 (the comparison is natural in the
coefficients): each leg of the comparison commutes with the endomorphism `c ·` of the
coefficients, upstream's `hypercohomologyAddEquivConstantCohomology_symm_smul`
(`Definitions/AlgebraicGeometry/Hodge/Filtration.lean:648`) for the last leg. -/
theorem spec_singularToFieldCohomology_smul (K : Type) [Field K]
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] (n : ℕ) (c : K)
    (x : AlgebraicTopology.Singular.Cohomology K (TopCat.of (ComplexPoint X)) n) :
    singularToFieldCohomology K X n (c • x) = c • singularToFieldCohomology K X n x :=
  spec_singularToFieldCohomology_smul_aux K X n c x

example (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom]
    (x : AlgebraicTopology.Singular.Cohomology ℂ (TopCat.of (ComplexPoint X)) 1) :
    singularToFieldCohomology ℂ X 1 (Complex.I • x) =
      Complex.I • singularToFieldCohomology ℂ X 1 x :=
  spec_singularToFieldCohomology_smul ℂ X 1 Complex.I x

/-- For a subfield `K` of `ℂ` and a smooth integral `X` with `X(ℂ)` Hausdorff and hereditarily
paracompact, constant-sheaf cohomology `H^n(X(ℂ); K)` and singular cohomology
`H^n_sing(X(ℂ); K)` are isomorphic `K`-vector spaces. The `K`-structure on the sheaf side is
upstream's `fieldCohomologyModule`.

It is the corollary of `spec_singularToFieldCohomology_bijective` and
`spec_singularToFieldCohomology_smul`: the inverse of `singularToFieldCohomology K X n`, made
`K`-linear by `LinearEquiv.ofBijective`.

Source: Bredon, *Sheaf Theory*, 2nd ed., GTM 170, III.1 (singular cochain sheaves form a flasque
resolution of the constant sheaf on a locally contractible hereditarily paracompact space, and
the comparison is natural in the coefficients); generalizes upstream's
`rationalCohomologyLinearEquivSingularCohomology`
(`Other/AlgebraicGeometry/Cohomology/SingularComparison.lean`). -/
theorem spec_fieldCohomology_linearEquiv_singular (K : Type) [Field K] [Algebra K ℂ]
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [T2Space (ComplexPoint X)]
    [∀ U : Opens (ComplexPoint X), ParacompactSpace U] (n : ℕ) :
    Nonempty (H^n(X; K) ≃ₗ[K]
      AlgebraicTopology.Singular.Cohomology K (TopCat.of (ComplexPoint X)) n) :=
  spec_fieldCohomology_linearEquiv_singular_aux K X n

example (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [T2Space (ComplexPoint X)]
    [∀ U : Opens (ComplexPoint X), ParacompactSpace U] :
    Nonempty (H^1(X; ℂ) ≃ₗ[ℂ]
      AlgebraicTopology.Singular.Cohomology ℂ (TopCat.of (ComplexPoint X)) 1) :=
  spec_fieldCohomology_linearEquiv_singular ℂ X 1

/-- For smooth projective integral `X`, constant-sheaf cohomology `H^n(X(ℂ); ℂ)` and singular
cohomology `H^n_sing(X(ℂ); ℂ)` are isomorphic complex vector spaces, in every degree. This is the
exact premise of `HodgeLean.Adapters.spec_bijective_bettiDeRhamHQ_of_complexSingular`.

Source: Bredon, *Sheaf Theory*, 2nd ed., GTM 170, III.1, through
`spec_fieldCohomology_linearEquiv_singular` with `K = ℂ`; the topological inputs come from
upstream's `openParacompactSpace` (`Lemmas/AlgebraicGeometry/ComplexPoint/ProjectiveParacompact.lean`). -/
theorem spec_complexCohomology_linearEquiv_singular (X : Over (Spec ↧ℂ))
    [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom] (n : ℕ) :
    Nonempty (H^n(X; ℂ) ≃ₗ[ℂ]
      AlgebraicTopology.Singular.Cohomology ℂ (TopCat.of (ComplexPoint X)) n) :=
  spec_complexCohomology_linearEquiv_singular_aux X n

example (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom] :
    Nonempty (H^0(X; ℂ) ≃ₗ[ℂ]
      AlgebraicTopology.Singular.Cohomology ℂ (TopCat.of (ComplexPoint X)) 0) :=
  spec_complexCohomology_linearEquiv_singular X 0

/-- For abelian `X`, the Betti–de Rham comparison `ℂ ⊗[ℚ] H^n(X(ℂ); ℚ) → H_dR^n(X)` is bijective
in every degree. This is the implication from `spec_complexCohomology_linearEquiv_singular`
through stage 3b; it assumes no Hodge-theoretic input.

Source: `spec_complexCohomology_linearEquiv_singular` and
`HodgeLean.Adapters.spec_bijective_bettiDeRhamHQ_of_complexSingular` (Birkenhake–Lange,
*Complex Abelian Varieties*, 2nd ed., Grundlehren 302, Lemma 1.3.1, for the Betti numbers). -/
theorem spec_bettiDeRhamIso_abelian (X : Over (Spec ↧ℂ)) [GrpObj X]
    [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom] :
    BettiDeRhamIso X :=
  spec_bettiDeRhamIso_abelian_aux X

example (X : Over (Spec ↧ℂ)) [GrpObj X] [IsIntegral X.left] [Smooth X.hom]
    [IsProjective X.hom] :
    Function.Bijective (bettiDeRhamHQ X 1) :=
  (spec_bettiDeRhamIso_abelian X).bijective 1

/-- Falsification check: for abelian `X` of dimension `g`, constant-sheaf cohomology
`H^1(X(ℂ); ℂ)` has dimension `2g`. A comparison that produced only one Hodge piece, such as
`H^1(X, 𝒪_X)` of dimension `g`, fails this for every `g ≥ 1`.

Source: Birkenhake–Lange, *Complex Abelian Varieties*, 2nd ed., Grundlehren 302, Lemma 1.3.1,
through `spec_complexCohomology_linearEquiv_singular` and
`HodgeLean.Adapters.spec_finrank_complexSingular_abelian`. -/
theorem spec_finrank_complexCohomology_one_abelian (X : Over (Spec ↧ℂ)) [GrpObj X]
    [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom] :
    Module.finrank ℂ H^1(X; ℂ) = 2 * dim X.left :=
  spec_finrank_complexCohomology_one_abelian_aux X

example (X : Over (Spec ↧ℂ)) [GrpObj X] [IsIntegral X.left] [Smooth X.hom]
    [IsProjective X.hom] (hg : 0 < dim X.left) :
    Module.finrank ℂ H^1(X; ℂ) ≠ dim X.left := by
  rw [spec_finrank_complexCohomology_one_abelian X]
  omega

end HodgeLean.Foundations
