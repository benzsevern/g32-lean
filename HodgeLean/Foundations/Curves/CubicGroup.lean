import HodgeLean.Foundations.Curves.CubicGroupProofs

/-! # Curves C3: regular addition and negation on the cubic (FROZEN SPEC)

The frozen spec for `docs/briefs/curve-group.md`. Do not edit this file. Each theorem is proved
by the matching `_aux` theorem in `CubicGroupProofs.lean`.

The complex points of `E` are identified with Mathlib's points of `W` (infinity to `0`, the
`z`-chart point `(x, y)` to `some x y`), and addition and negation are **morphisms of schemes
over `Spec ℂ`** inducing Mathlib's group law on those points. A rational law on a dense open does
not satisfy these statements: the morphisms are global. This is C3 only: no `GrpObj E` (C4), no
cohomology, no Jacobian.
Relation to the goal: HC no distance; AV milestone no distance.
-/

namespace HodgeLean.Foundations.Curves

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry
open CategoryTheory.MonoidalCategory CategoryTheory.CartesianMonoidalCategory

/-- **The point comparison.** Some bijection between the complex points of `E` and Mathlib's
points of `W` sends infinity to `0` and the `z`-chart point `(x, y)` to `some x y`.
Source: Silverman, *The Arithmetic of Elliptic Curves*, III.1–III.2; C1's charts. -/
theorem exists_isCubicPointEquiv : ∃ e : ComplexPoint E ≃ W.toAffine.Point, IsCubicPointEquiv e :=
  exists_isCubicPointEquiv_aux

example : ∃ e : ComplexPoint E ≃ W.toAffine.Point, IsCubicPointEquiv e :=
  exists_isCubicPointEquiv

/-- **Regular addition.** For any such comparison, there is a morphism `E ⊗ E ⟶ E` over `Spec ℂ`
that induces Mathlib's addition on complex points.
Source: Silverman, III.3.6 (the group law is a morphism); Mathlib
`WeierstrassCurve.Affine.Point.instAddCommGroup`. -/
theorem exists_add_morphism (e : ComplexPoint E ≃ W.toAffine.Point) (he : IsCubicPointEquiv e) :
    ∃ m : E ⊗ E ⟶ E, ∀ P Q : ComplexPoint E, lift P Q ≫ m = e.symm (e P + e Q) :=
  exists_add_morphism_aux e he

example (e : ComplexPoint E ≃ W.toAffine.Point) (he : IsCubicPointEquiv e) :
    ∃ m : E ⊗ E ⟶ E, ∀ P Q : ComplexPoint E, lift P Q ≫ m = e.symm (e P + e Q) :=
  exists_add_morphism e he

/-- **Regular negation.** For any such comparison, there is a morphism `E ⟶ E` over `Spec ℂ`
that induces Mathlib's negation on complex points.
Source: Silverman, III.3.6; Mathlib `WeierstrassCurve.Affine.Point.neg`. -/
theorem exists_neg_morphism (e : ComplexPoint E ≃ W.toAffine.Point) (he : IsCubicPointEquiv e) :
    ∃ i : E ⟶ E, ∀ P : ComplexPoint E, P ≫ i = e.symm (-e P) :=
  exists_neg_morphism_aux e he

example (e : ComplexPoint E ≃ W.toAffine.Point) (he : IsCubicPointEquiv e) :
    ∃ i : E ⟶ E, ∀ P : ComplexPoint E, P ≫ i = e.symm (-e P) :=
  exists_neg_morphism e he

end HodgeLean.Foundations.Curves
