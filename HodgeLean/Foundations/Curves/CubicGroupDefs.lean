namespace HodgeLean.Foundations.Curves

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry

/-- Evaluation of the affine Weierstrass coordinate ring at a point `(x, y)` of `y² = x³ + x`.
Source: Mathlib `AdjoinRoot.lift`, `WeierstrassCurve.Affine.Equation`. -/
noncomputable def affineEval (x y : ℂ) (h : W.toAffine.Equation x y) :
    W.toAffine.CoordinateRing →+* ℂ :=
  AdjoinRoot.lift (Polynomial.evalRingHom x) y (by
    rw [Polynomial.eval₂_evalRingHom]; exact h)

example (x y : ℂ) (h : W.toAffine.Equation x y) :
    affineEval x y h (AdjoinRoot.root W.toAffine.polynomial) = y := by
  simp [affineEval]

/-- An identification of the complex points of `E` with Mathlib's nonsingular points of `W` that
sends the point at infinity to `0` and the `z`-chart point at `(x, y)` to `some x y`.
Source: Silverman, *The Arithmetic of Elliptic Curves*, III.2; C1's charts. -/
def IsCubicPointEquiv (e : ComplexPoint E ≃ W.toAffine.Point) : Prop :=
  (∀ P : ComplexPoint E, P.left = infinity → e P = 0) ∧
    ∀ (x y : ℂ) (h : W.toAffine.Nonsingular x y) (P : ComplexPoint E),
      P.left = Spec.map (CommRingCat.ofHom (affineEval x y h.1)) ≫ zChartMap →
        e P = .some x y h

example (e : ComplexPoint E ≃ W.toAffine.Point) (he : IsCubicPointEquiv e) (P : ComplexPoint E)
    (hP : P.left = infinity) : e P = 0 :=
  he.1 P hP

end HodgeLean.Foundations.Curves
