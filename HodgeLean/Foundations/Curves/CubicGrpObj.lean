import HodgeLean.Foundations.Curves.CubicGrpObjProofs

/-! # Curves C4: the cubic as a group object (FROZEN SPEC)

The frozen spec for curves C4 (`docs/roadmap/curves.md` §C4, `docs/specs/CubicGrpObj.md`).
Do not edit this file. Each theorem is proved by the matching `_aux` theorem in
`CubicGrpObjProofs.lean`.

**Claimed.** Scheme morphisms from a reduced complex scheme of locally finite type into a
separated one are determined by their values on complex points (T1); the products of `E` used by
the group-object axioms are reduced (T2) and products of schemes locally of finite type are
locally of finite type (T2'). As an implication from the point identities of C3 S2
and S3 (taken as hypotheses, never unfolded), there is a `GrpObj E` whose multiplication and
inverse are the given morphisms and whose unit is the infinity section (T3). For any group object
on `E` whose multiplication induces Mathlib's addition through a comparison `e`, the induced group
on complex points is additively isomorphic to `W.toAffine.Point` via `e` (T5), and its unit is not
the finite point `(0,0)`, which is `2`-torsion (T6). Commutativity (T4) is not restated: it is
`isCommMonObj_of_complexSelfProductIntegral` with `complexSelfProductIntegral_of_isIntegral`,
recorded below as an `example`.

**Not claimed.** The unconditional `GrpObj E` is recorded only as the `example` after T3, which
composes T3 with C3 S1-S3 (all proved); no uniqueness of the group object (expressible, not
needed by C5); no cohomology, Jacobian or S13 checks (C5).
Relation to the goal: HC no distance; AV milestone no distance.
-/

namespace HodgeLean.Foundations.Curves

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry
open CategoryTheory.MonoidalCategory CategoryTheory.CartesianMonoidalCategory
open scoped CategoryTheory.MonObj

/-- **T1, extensionality on complex points.** Two morphisms `f g : Y ⟶ X` over `Spec ℂ`, with
`Y` reduced and locally of finite type (hence Jacobson, with closed points the complex points) and
`X` separated, are equal once they agree on every complex point of `Y`.
Source: Hartshorne, *Algebraic Geometry*, Exercise II.4.2 (reduced source, separated target)
and Exercise II.3.14 (closed points are dense in finite type over a field), with Hilbert's
Nullstellensatz for the residue fields; Mathlib `AlgebraicGeometry.JacobsonSpace`,
`AlgebraicGeometry.ext_of_isDominant_of_isSeparated'`. -/
theorem complexPoint_hom_ext {Y X : Over (Spec ↧ℂ)} [IsReduced Y.left]
    [LocallyOfFiniteType Y.hom] [IsSeparated X.hom] {f g : Y ⟶ X}
    (h : ∀ P : ComplexPoint Y, P ≫ f = P ≫ g) : f = g :=
  complexPoint_hom_ext_aux h

example {f g : E ⟶ E} (h : ∀ P : ComplexPoint E, P ≫ f = P ≫ g) : f = g :=
  complexPoint_hom_ext h

/-- **T2, reduced products.** `E ⊗ E` and both bracketings of `E ⊗ E ⊗ E` are reduced.
Source: Stacks Project, Tag 05P3, Lemma 33.3.3 (products of integral schemes over an
algebraically closed field), as `isIntegral_pullback_of_isAlgClosed`; C2's `E_isIntegral`. -/
theorem isReduced_cubic_tensor :
    IsReduced (E ⊗ E).left ∧ IsReduced ((E ⊗ E) ⊗ E).left ∧ IsReduced (E ⊗ (E ⊗ E)).left :=
  isReduced_cubic_tensor_aux

example : IsReduced (E ⊗ E).left := isReduced_cubic_tensor.1

/-- **T2', finite type of products.** The product over `Spec ℂ` of two schemes locally of finite
type is locally of finite type; Mathlib's instance search does not find this through the
monoidal structure on `Over (Spec ℂ)`.
Source: Hartshorne, *Algebraic Geometry*, Exercise II.3.13(c),(d) (composition and base change,
finite-type case; the local argument is the same); Mathlib `AlgebraicGeometry.LocallyOfFiniteType`. -/
theorem locallyOfFiniteType_tensor (X Y : Over (Spec ↧ℂ)) [LocallyOfFiniteType X.hom]
    [LocallyOfFiniteType Y.hom] : LocallyOfFiniteType (X ⊗ Y).hom :=
  locallyOfFiniteType_tensor_aux X Y

example {f g : (E ⊗ E) ⊗ E ⟶ E} (h : ∀ P : ComplexPoint ((E ⊗ E) ⊗ E), P ≫ f = P ≫ g) :
    f = g :=
  have := isReduced_cubic_tensor.2.1
  have := locallyOfFiniteType_tensor E E
  have := locallyOfFiniteType_tensor (E ⊗ E) E
  complexPoint_hom_ext h

/-- **T3, the group object (implication from C3 S2, S3).** Given a comparison `e` and morphisms
`m`, `i` inducing Mathlib's addition and negation on complex points, there is a group object on
`E` with multiplication `m`, inverse `i` and unit the infinity section.
Source: Silverman, *The Arithmetic of Elliptic Curves*, III.3.6; Mathlib
`WeierstrassCurve.Affine.Point.instAddCommGroup` for the point identities, transported by T1, T2. -/
theorem exists_grpObj (e : ComplexPoint E ≃ W.toAffine.Point) (he : IsCubicPointEquiv e)
    (m : E ⊗ E ⟶ E) (hm : ∀ P Q : ComplexPoint E, lift P Q ≫ m = e.symm (e P + e Q))
    (i : E ⟶ E) (hi : ∀ P : ComplexPoint E, P ≫ i = e.symm (-e P)) :
    ∃ G : GrpObj E, G.one = Over.homMk infinity infinity_over ∧ G.mul = m ∧ G.inv = i :=
  exists_grpObj_aux e he m hm i hi

example : ∃ e : ComplexPoint E ≃ W.toAffine.Point, IsCubicPointEquiv e ∧
    ∃ G : GrpObj E, G.one = Over.homMk infinity infinity_over ∧
      (∀ P Q : ComplexPoint E, lift P Q ≫ G.mul = e.symm (e P + e Q)) ∧
      ∀ P : ComplexPoint E, P ≫ G.inv = e.symm (-e P) := by
  obtain ⟨e, he⟩ := exists_isCubicPointEquiv
  obtain ⟨m, hm⟩ := exists_add_morphism e he
  obtain ⟨i, hi⟩ := exists_neg_morphism e he
  obtain ⟨G, h1, h2, h3⟩ := exists_grpObj e he m hm i hi
  exact ⟨e, he, G, h1, h2 ▸ hm, h3 ▸ hi⟩

-- The roadmap's witness target (`docs/roadmap/curves.md` §3(c)), as consumed by C5.
example : ∃ X : Over (Spec ↧ℂ), Nonempty (GrpObj X) ∧ IsIntegral X.left ∧ Smooth X.hom ∧
    IsProjective X.hom ∧ SmoothOfRelativeDimension 1 X.hom := by
  obtain ⟨e, he⟩ := exists_isCubicPointEquiv
  obtain ⟨m, hm⟩ := exists_add_morphism e he
  obtain ⟨i, hi⟩ := exists_neg_morphism e he
  obtain ⟨G, -⟩ := exists_grpObj e he m hm i hi
  exact ⟨E, ⟨G⟩, inferInstance, inferInstance, inferInstance, inferInstance⟩

/-- T4, commutativity, is an existing theorem: every group object on the proper integral `E` is
commutative. Source: `isCommMonObj_of_complexSelfProductIntegral` (Milne, *Abelian Varieties*,
Cor. 1.4) and `complexSelfProductIntegral_of_isIntegral` (Stacks Project, Tag 05P3). -/
example [GrpObj E] : IsCommMonObj E :=
  isCommMonObj_of_complexSelfProductIntegral E (complexSelfProductIntegral_of_isIntegral E)

/-- **T5, points.** For a group object on `E` whose multiplication induces Mathlib's addition via
`e`, the induced group on complex points is additively isomorphic to `W.toAffine.Point` via `e`.
Source: Mathlib `CategoryTheory.MonObj` (the monoid structure on morphisms into a monoid
object); Mathlib `WeierstrassCurve.Affine.Point.instAddCommGroup`. -/
theorem exists_complexPoint_addEquiv (e : ComplexPoint E ≃ W.toAffine.Point) [GrpObj E]
    (hμ : ∀ P Q : ComplexPoint E, lift P Q ≫ μ[E] = e.symm (e P + e Q)) :
    ∃ φ : Additive (ComplexPoint E) ≃+ W.toAffine.Point,
      ∀ P : ComplexPoint E, φ (Additive.ofMul P) = e P :=
  exists_complexPoint_addEquiv_aux e hμ

example (e : ComplexPoint E ≃ W.toAffine.Point) [GrpObj E]
    (hμ : ∀ P Q : ComplexPoint E, lift P Q ≫ μ[E] = e.symm (e P + e Q)) :
    ∃ φ : Additive (ComplexPoint E) ≃+ W.toAffine.Point,
      ∀ P : ComplexPoint E, φ (Additive.ofMul P) = e P :=
  exists_complexPoint_addEquiv e hμ

/-- **T6, falsification.** For a group object on `E` inducing Mathlib's addition via a cubic
comparison `e`, the unit is not the finite point `(0,0)`, and that point is `2`-torsion:
`(0,0) + (0,0) = O`. A spec whose unit were `(0,0)` would contradict this.
Source: Silverman, *The Arithmetic of Elliptic Curves*, III.2.3 (a point with `y = 0` on
`y² = x³ + x` has order two); Mathlib `WeierstrassCurve.Affine.Point.neg_some`. -/
theorem finitePoint_ne_one (e : ComplexPoint E ≃ W.toAffine.Point) (he : IsCubicPointEquiv e)
    [GrpObj E] (hμ : ∀ P Q : ComplexPoint E, lift P Q ≫ μ[E] = e.symm (e P + e Q)) :
    (Over.homMk finitePoint finitePoint_over : ComplexPoint E) ≠ η[E] ∧
      lift (Over.homMk finitePoint finitePoint_over : ComplexPoint E)
        (Over.homMk finitePoint finitePoint_over) ≫ μ[E] = η[E] :=
  finitePoint_ne_one_aux e he hμ

example (e : ComplexPoint E ≃ W.toAffine.Point) (he : IsCubicPointEquiv e) [GrpObj E]
    (hμ : ∀ P Q : ComplexPoint E, lift P Q ≫ μ[E] = e.symm (e P + e Q)) :
    (Over.homMk finitePoint finitePoint_over : ComplexPoint E) ≠ η[E] :=
  (finitePoint_ne_one e he hμ).1

end HodgeLean.Foundations.Curves
