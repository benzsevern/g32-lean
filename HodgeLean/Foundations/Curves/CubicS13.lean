import HodgeLean.Foundations.Curves.CubicS13Proofs

/-! # Curves C5: the S13 checks on the cubic (FROZEN SPEC)

The frozen spec for curves C5 (`docs/roadmap/curves.md` §C5 and §3(c), `docs/specs/CubicS13.md`).
Do not edit this file. Each theorem is proved by the matching `_aux` theorem in
`CubicS13Proofs.lean`.

**Claimed.** `E`, with the named group object `cubicGrpObj` (`CubicS13Defs.lean`), witnesses
the roadmap's existential target: some integral, smooth, projective complex group scheme has
relative dimension one (S2). For S13's constructed cup product `cupProductOf E`, never an
arbitrary `CupProduct`: the Betti numbers of `E` are `choose 2 n`, that is `1, 2, 1` and then
`0` (S3, S3'); C7, C1 and O7 hold on `E` (S4); the exterior-square map is nonzero and two
degree-one classes have a nonzero cup product, which no square-zero product satisfies (S5, S6);
the top cup power of `η : HQ E 2` is nonzero exactly when `η` is, so the O3 premise of
`hardLefschetz_abelian_of_cupPow` holds for every nonzero `η` and fails for `0` (S7); and
`HQ E 1` is nonzero, which separates `E` from the point witness of `TorusCohomologyChecks.lean`
(S8). `dim E.left = 1` is C2's `E_dim` and is not restated.

**Not claimed.** No Hodge-theoretic input on `E`: `BettiDeRhamIso E`, `HodgeDecomposition E`,
`CycleClassMultiplicative (cupProductOf E)`, `CycleClassIsHodge E` and `LefschetzOneOneHyp`
stay open, and the `g = 1` milestone on `E` is recorded below only as an implication from them.
No claim about any other curve, and no uniqueness of the group object.
Relation to the goal: HC no distance; AV milestone no distance.
-/

noncomputable section

namespace HodgeLean.Foundations.Curves

open CategoryTheory AlgebraicGeometry AlgebraicGeometry.ComplexPoint TopologicalSpace
open HodgeLean.RealDefs HodgeLean.Adapters

/-- S1, the dimension of `E`, is C2's existing theorem `E_dim`, derived from
`SmoothOfRelativeDimension 1 E.hom`. Source: `E_dim` (`CubicSmooth.lean`); HodgeConjecture
`AlgebraicGeometry.SmoothOfRelativeDimension.dim_eq` (`Smooth/Equidimensional.lean`). -/
example : dim E.left = 1 := E_dim

/-- **S2, the existential target.** Some integral smooth projective complex group object has
relative dimension one; the witness is `E` with `cubicGrpObj`.
Source: `docs/roadmap/curves.md` §3(c); C1, C2 (`Cubic.lean`, `CubicSmooth.lean`) and C4 T3
(`exists_grpObj`); Silverman, *The Arithmetic of Elliptic Curves*, III.3.6. -/
theorem exists_complex_abelian_curve :
    ∃ X : Over (Spec ↧ℂ), Nonempty (GrpObj X) ∧ IsIntegral X.left ∧ Smooth X.hom ∧
      IsProjective X.hom ∧ SmoothOfRelativeDimension 1 X.hom :=
  exists_complex_abelian_curve_aux

example : ∃ X : Over (Spec ↧ℂ), Nonempty (GrpObj X) ∧ SmoothOfRelativeDimension 1 X.hom :=
  let ⟨X, hG, _, _, _, h1⟩ := exists_complex_abelian_curve; ⟨X, hG, h1⟩

/-- **S3, Betti numbers.** The rational Betti numbers of `E` are those of the real two-torus.
Source: `finrank_HQ_abelian` (`TorusCohomologyChecks.lean`) at `E`, `cubicGrpObj`, with
`E_dim`; Birkenhake–Lange, *Complex Abelian Varieties*, Lemma 1.3.1. -/
theorem finrank_HQ_cubic (n : ℕ) : Module.finrank ℚ (HQ E n) = Nat.choose 2 n :=
  finrank_HQ_cubic_aux n

example : Module.finrank ℚ (HQ E 0) = 1 ∧ Module.finrank ℚ (HQ E 1) = 2 ∧
    Module.finrank ℚ (HQ E 2) = 1 := by
  simp [finrank_HQ_cubic]

-- The same ranks from the existing S13 theorem, instantiated at `E` (not restated).
example : Module.finrank ℚ (HQ E 0) = 1 ∧ Module.finrank ℚ (HQ E 1) = 2 ∧
    Module.finrank ℚ (HQ E 2) = 1 :=
  torusSpine_bettiRanks_g1 E E_dim

/-- **S3', vanishing above degree two.** Source: `finrank_HQ_abelian` at `E` with `E_dim`
(`Nat.choose_eq_zero_of_lt`); Birkenhake–Lange, *Complex Abelian Varieties*, Lemma 1.3.1. -/
theorem finrank_HQ_cubic_of_two_lt {n : ℕ} (hn : 2 < n) : Module.finrank ℚ (HQ E n) = 0 :=
  finrank_HQ_cubic_of_two_lt_aux hn

example : Module.finrank ℚ (HQ E 3) = 0 := finrank_HQ_cubic_of_two_lt (by norm_num)

/-- **S4, the S13 package on `E`.** C7 for the constructed cup product, C1 and O7 hold on `E`.
Source: `torusCohomology_cupProductOf`, `finiteBetti_abelian`, `vanishingAboveTop_abelian`
(`Adapters/TorusCohomology.lean`) at `E`, `cubicGrpObj`; Birkenhake–Lange, *Complex Abelian
Varieties*, Lemma 1.3.1. -/
theorem s13_inputs_cubic :
    TorusCohomology (cupProductOf E) ∧ FiniteBetti E ∧ VanishingAboveTop E :=
  s13_inputs_cubic_aux

example : TorusCohomology (cupProductOf E) := s13_inputs_cubic.1

/-- **S5, the exterior-square check.** The degree-two wedge map of S13's constructed cup product
on `E` is nonzero. The square-zero `CupProduct` of `docs/roadmap/torus-track.md` §0 has zero
`cupWedgeMap 2`, so this separates `cupProductOf E` from it.
Source: `torusCohomology_cupProductOf` (bijectivity in degree two) at `E`, and
`finrank ⋀² ℚ² = 1`; Birkenhake–Lange, *Complex Abelian Varieties*, Lemma 1.3.1. -/
theorem cupWedgeMap_two_cubic_ne_zero : (cupProductOf E).cupWedgeMap 2 ≠ 0 :=
  cupWedgeMap_two_cubic_ne_zero_aux

example : (cupProductOf E).cupWedgeMap 2 ≠ 0 := cupWedgeMap_two_cubic_ne_zero

/-- **S6, the nonzero product check.** Some two degree-one classes of `E` have a nonzero cup
product under `cupProductOf E`.
Source: S5 with `CupProduct.cupWedgeMap_ιMulti` and `CupProduct.cup_one`; Birkenhake–Lange,
*Complex Abelian Varieties*, Lemma 1.3.1 (`H² = ⋀² H¹` by cup product). -/
theorem exists_cup_ne_zero_cubic :
    ∃ a b : HQ E 1, (cupProductOf E).cup (rfl : 1 + 1 = 2) a b ≠ 0 :=
  exists_cup_ne_zero_cubic_aux

example : ¬ ∀ a b : HQ E 1, (cupProductOf E).cup (rfl : 1 + 1 = 2) a b = 0 :=
  fun h => let ⟨a, b, hab⟩ := exists_cup_ne_zero_cubic; hab (h a b)

/-- **S7, the O3 premise on `E`.** In complex dimension one the top cup power of `η` is `η ∪ 1`,
so it is nonzero exactly when `η` is.
Source: `cupPow`, `RealDefs.lefschetzPow`, `CupProduct.cup_one` and `E_dim`;
Huybrechts, *Complex Geometry*, §1.2 (hard Lefschetz in complex dimension one). -/
theorem cupPow_cubic_ne_zero_iff (η : HQ E 2) :
    cupPow E (cupProductOf E) η (dim E.left) ≠ 0 ↔ η ≠ 0 :=
  cupPow_cubic_ne_zero_iff_aux η

example {η : HQ E 2} (hη : η ≠ 0) : HardLefschetz E (cupProductOf E) η :=
  hardLefschetz_abelian_of_cupPow E ((cupPow_cubic_ne_zero_iff η).mpr hη)

/-- **S8, falsification.** `HQ E 1` is nonzero. The point witness of
`TorusCohomologyChecks.lean` has `HQ 1 = 0` (`finrank_HQ_abelian_zero`), so this separates `E`
from it; with `E_dim` it also makes `zero_fails_nd_and_cupPow` apply to `E`.
Source: S3 at `n = 1`; Birkenhake–Lange, *Complex Abelian Varieties*, Lemma 1.3.1. -/
theorem nontrivial_HQ_one_cubic : Nontrivial (HQ E 1) :=
  nontrivial_HQ_one_cubic_aux

example : ∃ a : HQ E 1, a ≠ 0 := by
  have := nontrivial_HQ_one_cubic
  exact exists_ne 0

example : ¬ Symplectic.IsNondegenerate (((s13_inputs_cubic.1).cupWedgeEquiv 2).symm 0) :=
  (zero_fails_nd_and_cupPow E s13_inputs_cubic.1 (by rw [E_dim]; norm_num)).1

/-- The `g = 1` milestone on `E`, as an implication from the five premises still open for `E`;
`dim E.left = 1` and the S13 package are discharged. Source: `hdg_le_span_abelian_g1_cupProductOf`
(`AbelianMilestones.lean`, F-1690) at `E`, `cubicGrpObj`, with `E_dim`. -/
example (hB : BettiDeRhamIso E) (hD : HodgeDecomposition E)
    (hM : CycleClassMultiplicative (cupProductOf E)) (hH : CycleClassIsHodge E)
    (h11 : LefschetzOneOneHyp) :
    ∀ p : ℕ, Hdg^p(E; ℚ) ≤ algebraicCycleClassSpan E p :=
  hdg_le_span_abelian_g1_cupProductOf E hB hD hH h11 E_dim

end HodgeLean.Foundations.Curves
