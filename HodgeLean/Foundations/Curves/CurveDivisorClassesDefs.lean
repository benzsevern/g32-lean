import HodgeLean.Foundations.Curves.CurveDivisors

/-! # Definitions for divisor classes on curves (FROZEN)

Divisor classes are Weil divisors modulo the subgroup generated by principal divisors of nonzero
rational functions. The degree-zero classes are the image of the degree-zero divisors. On the fixed
cubic `E`, the Abel map sends a point `P` to the class of `[P] - [∞]`, and `cubicPointOf` sends a
point of Mathlib's affine Weierstrass group to the corresponding point of `E`.
HC no distance; AV milestone no distance.
-/

noncomputable section
open CategoryTheory AlgebraicGeometry TopologicalSpace

namespace HodgeLean.Foundations.Curves

/-- The subgroup of principal divisors: the subgroup generated by the divisors of nonzero rational
functions. Taking the generated subgroup makes this an unconditional definition; by J1
`principalDivisor_mul`, on a smooth projective curve it is exactly the image of `principalDivisor`
on nonzero functions.
Source: Hartshorne, *Algebraic Geometry*, II.6, Definition before Proposition 6.5. -/
def principalDivisors (X : Scheme) [IsIntegral X] [IsLocallyNoetherian X] :
    AddSubgroup (Divisor X) :=
  AddSubgroup.closure {D | ∃ f : X.functionField, f ≠ 0 ∧ principalDivisor X f = D}

example (X : Scheme) [IsIntegral X] [IsLocallyNoetherian X] (f : X.functionField) (hf : f ≠ 0) :
    principalDivisor X f ∈ principalDivisors X :=
  AddSubgroup.subset_closure ⟨f, hf, rfl⟩

/-- The divisor class group `Cl(X) = Div(X) / Prin(X)`, as an additive group. This is the
quotient of Weil divisors on the scheme, not the class group of the ring of global functions.
Source: Hartshorne, *Algebraic Geometry*, II.6, Definition before Proposition 6.2. -/
abbrev DivisorClass (X : Scheme) [IsIntegral X] [IsLocallyNoetherian X] :=
  Divisor X ⧸ principalDivisors X

example (X : Scheme) [IsIntegral X] [IsLocallyNoetherian X] : AddCommGroup (DivisorClass X) :=
  inferInstance

/-- The quotient map from divisors to divisor classes.
Source: Hartshorne, *Algebraic Geometry*, II.6; Mathlib `QuotientAddGroup.mk'`. -/
def DivisorClass.mk (X : Scheme) [IsIntegral X] [IsLocallyNoetherian X] :
    Divisor X →+ DivisorClass X :=
  QuotientAddGroup.mk' (principalDivisors X)

example (X : Scheme) [IsIntegral X] [IsLocallyNoetherian X] (f : X.functionField) (hf : f ≠ 0) :
    DivisorClass.mk X (principalDivisor X f) = 0 :=
  (QuotientAddGroup.eq_zero_iff _).mpr (AddSubgroup.subset_closure ⟨f, hf, rfl⟩)

/-- The degree on divisor classes, given that principal divisors have degree zero. The hypothesis
is an explicit argument; `principalDivisors_le_ker_degree` in the frozen spec supplies it on a
smooth projective curve over `ℂ`.
Source: Hartshorne, *Algebraic Geometry*, II.6, Corollary 6.10; Mathlib `QuotientAddGroup.lift`. -/
def divisorClassDegree {S : Scheme} (X : Over S) [IsIntegral X.left]
    [IsLocallyNoetherian X.left] [CompactSpace X.left]
    (h : principalDivisors X.left ≤ (divisorDegree X).ker) : DivisorClass X.left →+ ℤ :=
  QuotientAddGroup.lift (principalDivisors X.left) (divisorDegree X) h

example {S : Scheme} (X : Over S) [IsIntegral X.left] [IsLocallyNoetherian X.left]
    [CompactSpace X.left] (h : principalDivisors X.left ≤ (divisorDegree X).ker)
    (D : Divisor X.left) : divisorClassDegree X h (DivisorClass.mk X.left D) = divisorDegree X D :=
  rfl

/-- The degree-zero divisor classes `Cl⁰(X)`: the image of the degree-zero divisors. This needs no
descent of the degree; `mk_mem_divisorClassZero_iff` in the frozen spec identifies it with the
kernel of the descended degree.
Source: Hartshorne, *Algebraic Geometry*, II.6, Example 6.10.2. -/
def DivisorClassZero {S : Scheme} (X : Over S) [IsIntegral X.left]
    [IsLocallyNoetherian X.left] [CompactSpace X.left] : AddSubgroup (DivisorClass X.left) :=
  (divisorDegree X).ker.map (DivisorClass.mk X.left)

example {S : Scheme} (X : Over S) [IsIntegral X.left] [IsLocallyNoetherian X.left]
    [CompactSpace X.left] : (0 : DivisorClass X.left) ∈ DivisorClassZero X :=
  (DivisorClassZero X).zero_mem

/-- The prime divisor `[P]` of a point. The fallback branch makes this unconditional; on a curve
`pointDivisor_of_isClosed` in the frozen spec says it is `pointCycle P 1` at every closed point.
Source: Hartshorne, *Algebraic Geometry*, II.6, Definition of prime divisor; Mathlib
`AlgebraicCycle.isWeilDivisor_single`. -/
def pointDivisor (X : Scheme) (P : X) : Divisor X := by
  classical
  exact if h : Order.coheight P = 1 then
    ⟨Function.locallyFinsuppWithin.single P 1, AlgebraicCycle.isWeilDivisor_single h 1⟩
  else 0

example (X : Scheme) (P : X) (h : ¬ Order.coheight P = 1) : pointDivisor X P = 0 := by
  simp [pointDivisor, h]

/-- The point at infinity `[0:1:0]` of the fixed cubic, as a point of its underlying space.
Source: Silverman, *The Arithmetic of Elliptic Curves*, III.1. -/
def cubicInfinity : E.left := infinity.base default

example : cubicInfinity = infinity.base default := rfl

/-- The Abel map with base point `∞` on the fixed cubic: `P ↦ [P] - [∞]` in `Cl(E)`. It is
defined on every point; `cubicAbelMap_mem_divisorClassZero` in the frozen spec says it lands in
`Cl⁰(E)` at closed points.
Source: Silverman, *The Arithmetic of Elliptic Curves*, III.3.4. -/
def cubicAbelMap (P : E.left) : DivisorClass E.left :=
  DivisorClass.mk E.left (pointDivisor E.left P - pointDivisor E.left cubicInfinity)

example : cubicAbelMap cubicInfinity = 0 := by
  simp [cubicAbelMap]

/-- Evaluation of the affine Weierstrass coordinate ring at a solution `(x,y)` of the equation.
Source: Mathlib `WeierstrassCurve.Affine.CoordinateRing.quotientXYIdealEquiv`. -/
def equationEval {x y : ℂ} (h : W.toAffine.Equation x y) : W.toAffine.CoordinateRing →+* ℂ :=
  (WeierstrassCurve.Affine.CoordinateRing.quotientXYIdealEquiv (W' := W.toAffine) h).toRingHom.comp
    (Ideal.Quotient.mk _)

example {x y : ℂ} (h : W.toAffine.Equation x y) :
    equationEval h = (WeierstrassCurve.Affine.CoordinateRing.quotientXYIdealEquiv
      (W' := W.toAffine) h).toRingHom.comp (Ideal.Quotient.mk _) := rfl

/-- The point of `E` corresponding to a point of Mathlib's Weierstrass group: `0` goes to `∞`,
and the affine point `(x,y)` goes to the image of the complex point `(x,y)` of the `z` chart.
Source: Silverman, *The Arithmetic of Elliptic Curves*, III.1 and III.2. -/
def cubicPointOf : W.toAffine.Point → E.left
  | .zero => cubicInfinity
  | .some _ _ h => (Spec.map (CommRingCat.ofHom (equationEval h.1)) ≫ zChartMap).base default

example : cubicPointOf 0 = cubicInfinity := rfl

/-- The origin `(0,0)` is a nonsingular point of `y² = x³ + x`.
Source: Silverman, *The Arithmetic of Elliptic Curves*, III.1; Mathlib
`WeierstrassCurve.Affine.equation_iff_nonsingular`. -/
theorem W_nonsingular_origin : W.toAffine.Nonsingular 0 0 :=
  W.toAffine.equation_iff_nonsingular.mp <| by
    rw [WeierstrassCurve.Affine.equation_zero]
    simp [W, WeierstrassCurve.ofJ1728]

example : W.toAffine.Nonsingular 0 0 := W_nonsingular_origin

end HodgeLean.Foundations.Curves
