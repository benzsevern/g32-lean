import HodgeLean.Foundations.Curves.CurveDivisorsDefs
import HodgeConjecture.Lemmas.AlgebraicGeometry.ComplexPoint.SmoothCoordinates
import Mathlib.RingTheory.Unramified.LocalRing
import Mathlib.RingTheory.DiscreteValuationRing.TFAE

/-! # Stalks of a smooth complex curve are discrete valuation rings

At a coheight-one point of an integral smooth complex curve, the local ring is a DVR. Around the
point there is an étale coordinate `ℂ[x] → Γ(U)`; étale maps are unramified, so the maximal ideal
of the local ring is generated by the image of a generator of the prime of `ℂ[x]` below it.
HC no distance; AV milestone no distance.
-/

noncomputable section
open CategoryTheory AlgebraicGeometry IsLocalRing

attribute [local instance] overSpecAlgebra

namespace HodgeLean.Foundations.Curves

/-- A localization at a prime of a Noetherian domain that is formally unramified over a principal
ideal ring is a DVR as soon as it is not a field: its maximal ideal is extended from the base.
Source: Stacks Project, Tag 02FM; Mathlib `Algebra.isUnramifiedAt_iff_map_eq`. -/
theorem isDVR_localization_of_formallyUnramified {R S : Type*} [CommRing R] [CommRing S]
    [Algebra R S] [IsPrincipalIdealRing R] [IsDomain S] [IsNoetherianRing S]
    [Algebra.EssFiniteType R S] [Algebra.FormallyUnramified R S]
    (q : Ideal S) [q.IsPrime] (hq : ¬ IsField (Localization.AtPrime q)) :
    IsDiscreteValuationRing (Localization.AtPrime q) := by
  let p := q.comap (algebraMap R S)
  have : q.LiesOver p := ⟨rfl⟩
  let := Localization.AtPrime.algebraOfLiesOver p q
  have h := (Algebra.isUnramifiedAt_iff_map_eq R p q).mp inferInstance
  obtain ⟨π, hπ⟩ := (IsPrincipalIdealRing.principal p).principal
  have hmax : maximalIdeal (Localization.AtPrime q) =
      Submodule.span _ {algebraMap R (Localization.AtPrime q) π} := by
    rw [← h.2, hπ]
    rw [show (Submodule.span R {π} : Ideal R) = Ideal.span {π} from rfl, Ideal.map_span,
      Set.image_singleton]
  exact ((IsDiscreteValuationRing.TFAE _ hq).out 1 5).mpr
    (⟨⟨_, hmax⟩⟩ : (maximalIdeal (Localization.AtPrime q)).IsPrincipal)

/-- The polynomial ring in one variable, written as `MvPolynomial (Fin 1) ℂ`, is a PID.
Source: Mathlib `MvPolynomial.uniqueAlgEquiv`. -/
instance : IsPrincipalIdealRing (MvPolynomial (Fin 1) ℂ) :=
  let e : Polynomial ℂ ≃ₐ[ℂ] MvPolynomial (Fin 1) ℂ :=
    (MvPolynomial.uniqueAlgEquiv ℂ (Fin 1)).symm
  IsPrincipalIdealRing.of_surjective e.toRingEquiv.toRingHom e.surjective

variable {X : Over (Spec ↧ℂ)} [IsIntegral X.left] [SmoothOfRelativeDimension 1 X.hom]
  [IsLocallyNoetherian X.left]

/-- The local ring of an integral smooth complex curve at a coheight-one point is a DVR.
Source: Hartshorne, *Algebraic Geometry*, I.6 and II.8; HodgeConjecture `localEtaleCoordinates`. -/
theorem isDVR_stalk {P : X.left} (hP : Order.coheight P = 1) :
    IsDiscreteValuationRing (X.left.presheaf.stalk P) := by
  let D := localEtaleCoordinates X 1 P
  have hU := D.isAffine
  have : Nonempty D.neighborhood := ⟨⟨P, D.mem⟩⟩
  let x : D.neighborhood := ⟨P, D.mem⟩
  let q := (hU.primeIdealOf x).asIdeal
  let : Algebra (MvPolynomial (Fin 1) ℂ) Γ(X.left, D.neighborhood) :=
    D.coordinateAlgHom.toRingHom.toAlgebra
  have : Algebra.Etale (MvPolynomial (Fin 1) ℂ) Γ(X.left, D.neighborhood) := D.etale
  have : IsNoetherianRing Γ(X.left, D.neighborhood) :=
    IsLocallyNoetherian.component_noetherian ⟨D.neighborhood, hU⟩
  let := TopCat.Presheaf.algebra_section_stalk X.left.presheaf x
  have hstalk := hU.isLocalization_stalk x
  let e : Localization.AtPrime q ≃+* X.left.presheaf.stalk P :=
    (IsLocalization.algEquiv q.primeCompl _ (X.left.presheaf.stalk P)).toRingEquiv
  have hnf : ¬ IsField (Localization.AtPrime q) := by
    intro h
    have h' : IsField (X.left.presheaf.stalk P) := MulEquiv.isField h e.symm.toMulEquiv
    have h1 := ringKrullDim_stalk_eq_coheight P
    rw [ringKrullDim_eq_zero_of_isField h', hP] at h1
    simp at h1
  have := isDVR_localization_of_formallyUnramified (R := MvPolynomial (Fin 1) ℂ) q hnf
  exact IsDiscreteValuationRing.RingEquivClass.isDiscreteValuationRing e

end HodgeLean.Foundations.Curves
