import HodgeLean.Adapters.LefschetzOneOneAlgebraicAbelianDefs
import HodgeLean.Foundations.Port.AlgebraicGeometry.ComplexPoint.DenseNonvanishing
import HodgeLean.Foundations.DivisorClassHodgeRegular
import HodgeLean.Foundations.Port.AlgebraicGeometry.Smooth.RegularLocal

/-! # Divisor classes on abelian varieties: local facts on the variety (DC1, sub-stage f)

Helpers for `dc1_componentSupport_interior_aux` and `dc1_locallyPrincipal_aux`:

* a point of coheight one is not the generic point, so its closure is a proper closed subset
  (`dcl_closure_ne_univ`);
* the complex points of a proper Zariski-closed subset of the smooth integral `X` have empty
  interior in the analytic topology, by density of nonempty Zariski opens
  (`ComplexPoint.dense_overOpen`, through the étale charts) (`dcl_componentSupport_interior`);
* a prime divisor is locally the zero set of one regular function (`dcl_locallyPrincipal`): on an
  affine chart `U` the ring of sections is a regular ring (`dcl_isRegularRing_sections`, from the
  regularity of the stalks of the smooth `X`), so its localization at the point is factorial
  (`dcl_ufd_localization_atPrime`, Auslander–Buchsbaum); the prime of the divisor has height one
  there (`dcl_coheight_one_prime`), hence is generated by one `a`; removing the finitely many
  other minimal primes of `(a)` by a basic open gives the neighbourhood
  (`dcl_exists_local_equation`).

Source: Hartshorne, *Algebraic Geometry*, Ch. II, Proposition 6.11 and Remark 6.11.1A;
Matsumura, *Commutative Ring Theory*, Theorem 20.3; Mumford, *Red Book*, Ch. I §10, Theorem 1.

HC no distance; AV milestone no distance.
-/

noncomputable section

open CategoryTheory AlgebraicGeometry TopologicalSpace HodgeLean.Adapters Set

universe u

namespace HodgeLean.Foundations

section Support

variable (X : Over (Spec ↧ℂ))

/-- A point of coheight one is not a generic point: its closure is not all of `X`. -/
theorem dcl_closure_ne_univ (x : X.left) (hx : Order.coheight x = 1) :
    closure ({x} : Set X.left) ≠ univ := by
  intro h
  have hmax : IsMax x := by
    intro y _
    rw [Scheme.le_iff_specializes, specializes_iff_mem_closure, h]
    exact mem_univ _
  rw [← Order.coheight_eq_zero] at hmax
  rw [hmax] at hx
  exact zero_ne_one hx

variable [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom]

/-- The complex points of the closure of a point of coheight one have empty interior: they are
the complement of the complex points of a nonempty Zariski open, which are dense. -/
theorem dcl_componentSupport_interior (x : X.left) (hx : Order.coheight x = 1) :
    interior (bh4_componentSupport X x) = ∅ := by
  let U : X.left.Opens := ⟨(closure ({x} : Set X.left))ᶜ, isClosed_closure.isOpen_compl⟩
  have hU : Nonempty U := by
    obtain ⟨y, hy⟩ := (Set.ne_univ_iff_exists_notMem _).mp (dcl_closure_ne_univ X x hx)
    exact ⟨⟨y, hy⟩⟩
  have : QuasiSeparatedSpace X.left := quasiSeparatedSpace_of_quasiSeparated X.hom
  have hd := ComplexPoint.dense_overOpen X U
  have heq : bh4_componentSupport X x = (Point.overOpen U)ᶜ := by
    ext z; simp [bh4_componentSupport, Point.overOpen, U]
  rw [heq, interior_compl, hd.closure_eq, compl_univ]

end Support

section Algebra

/-- **Local equation of a height-one prime in a regular domain.** If no prime lies strictly
between `0` and `px ≤ pz`, there are `a ∈ px` and `t ∉ pz` such that, among primes not
containing `t`, those containing `a` are exactly those containing `px`. -/
theorem dcl_exists_local_equation {R : Type u} [CommRing R] [IsDomain R] [IsRegularRing R]
    (px pz : Ideal R) [px.IsPrime] [pz.IsPrime] (hle : px ≤ pz) (hne : px ≠ ⊥)
    (hcoh : ∀ q : Ideal R, q.IsPrime → q < px → q = ⊥) :
    ∃ a ∈ px, ∃ t ∉ pz, ∀ pw : Ideal R, pw.IsPrime → t ∉ pw → (px ≤ pw ↔ a ∈ pw) := by
  classical
  let L := Localization.AtPrime pz
  have := dcl_ufd_localization_atPrime (A := R) pz
  have hdisj : Disjoint (pz.primeCompl : Set R) px := by
    rw [Set.disjoint_left]; intro y hy hyx; exact hy (hle hyx)
  let P := px.map (algebraMap R L)
  have hP : P.IsPrime := IsLocalization.isPrime_of_isPrime_disjoint pz.primeCompl L px
    inferInstance hdisj
  have hPc : P.comap (algebraMap R L) = px :=
    IsLocalization.under_map_of_isPrime_disjoint pz.primeCompl L (I := px) inferInstance hdisj
  have hinj : Function.Injective (algebraMap R L) :=
    IsLocalization.injective L pz.primeCompl_le_nonZeroDivisors
  have hP0 : P ≠ ⊥ := by
    intro h
    apply hne
    rw [← hPc, h]
    exact Ideal.comap_bot_of_injective _ hinj
  obtain ⟨π, hπP, hπ⟩ := hP.exists_mem_prime_of_ne_bot hP0
  have hJ : (Ideal.span {π}).IsPrime := (Ideal.span_singleton_prime hπ.ne_zero).mpr hπ
  have hJP : Ideal.span {π} ≤ P := by rw [Ideal.span_le, Set.singleton_subset_iff]; exact hπP
  have hJeq : Ideal.span {π} = P := by
    by_contra hJne
    let q := (Ideal.span {π}).comap (algebraMap R L)
    have hqle : q ≤ px := hPc ▸ Ideal.comap_mono hJP
    have hqne : q ≠ px := by
      intro h
      apply hJne
      rw [← IsLocalization.map_under pz.primeCompl L (Ideal.span {π})]
      exact congrArg (Ideal.map (algebraMap R L)) h
    have hq0 := hcoh q (Ideal.IsPrime.comap _) (lt_of_le_of_ne hqle hqne)
    have : Ideal.span {π} = ⊥ := by
      rw [← IsLocalization.map_under pz.primeCompl L (Ideal.span {π})]
      change Ideal.map _ q = ⊥
      rw [hq0, Ideal.map_bot]
    exact hπ.ne_zero (Ideal.span_singleton_eq_bot.mp this)
  obtain ⟨⟨⟨a, ha⟩, ⟨t, ht⟩⟩, hat⟩ :=
    (IsLocalization.mem_map_algebraMap_iff pz.primeCompl L).mp hπP
  simp only at hat
  have hPa : P = Ideal.span {algebraMap R L a} := by
    rw [← hJeq, ← hat]
    exact (Ideal.span_singleton_eq_span_singleton.mpr (associated_mul_unit_right π _
      (IsLocalization.map_units L (⟨t, ht⟩ : pz.primeCompl))))
  -- the minimal primes of `(a)` not inside `pz`, and one element of each outside `pz`
  have hfin := Ideal.finite_minimalPrimes_of_isNoetherianRing R (Ideal.span {a})
  let F := hfin.toFinset.filter (fun Q ↦ ¬ Q ≤ pz)
  let g : Ideal R → R := fun Q ↦
    if h : ¬ Q ≤ pz then (Set.not_subset.mp h).choose else 1
  have hg : ∀ Q ∈ F, g Q ∈ Q ∧ g Q ∉ pz := by
    intro Q hQ
    have hQ' : ¬ Q ≤ pz := (Finset.mem_filter.mp hQ).2
    simp only [g, dite_eq_left hQ']
    exact (Set.not_subset.mp hQ').choose_spec
  let s := ∏ Q ∈ F, g Q
  have hs : s ∉ pz := by
    rw [Ideal.IsPrime.prod_mem_iff (hp := inferInstance)]
    push Not
    exact fun Q hQ ↦ (hg Q hQ).2
  refine ⟨a, ha, s, hs, fun pw hpw hspw ↦ ⟨fun h ↦ h ha, fun haw ↦ ?_⟩⟩
  obtain ⟨Q, hQmin, hQw⟩ := Ideal.exists_minimalPrimes_le
    ((Ideal.span_singleton_le_iff_mem _).mpr haw)
  have hQp : Q.IsPrime := hQmin.1.1
  by_cases hQz : Q ≤ pz
  · have hdisjQ : Disjoint (pz.primeCompl : Set R) Q := by
      rw [Set.disjoint_left]; intro y hy hyQ; exact hy (hQz hyQ)
    have haQ : a ∈ Q := (Ideal.span_singleton_le_iff_mem _).mp hQmin.1.2
    have hPQ : P ≤ Q.map (algebraMap R L) := by
      rw [hPa, Ideal.span_le, Set.singleton_subset_iff]
      exact Ideal.mem_map_of_mem _ haQ
    have := Ideal.comap_mono (f := algebraMap R L) hPQ
    have hQc : (Q.map (algebraMap R L)).comap (algebraMap R L) = Q :=
      IsLocalization.under_map_of_isPrime_disjoint pz.primeCompl L (I := Q) hQp hdisjQ
    rw [hPc, hQc] at this
    exact this.trans hQw
  · exfalso
    have hQF : Q ∈ F := Finset.mem_filter.mpr ⟨hfin.mem_toFinset.mpr hQmin, hQz⟩
    apply hspw
    rw [Ideal.IsPrime.prod_mem_iff (hp := hpw)]
    exact ⟨Q, hQF, hQw (hg Q hQF).1⟩

end Algebra

section Charts

/-- In an affine chart, specialization of points is inclusion of their primes. -/
theorem dcl_fromSpec_specializes_iff {X : Over (Spec ↧ℂ)} {U : X.left.Opens}
    (hU : IsAffineOpen U) (p q : PrimeSpectrum Γ(X.left, U)) :
    hU.fromSpec p ⤳ hU.fromSpec q ↔ p.asIdeal ≤ q.asIdeal :=
  (hU.fromSpec.isOpenEmbedding.isInducing.specializes_iff (x := p) (y := q)).trans
    (PrimeSpectrum.le_iff_specializes p q).symm

/-- In an affine chart, a point lies in `D(f)` exactly when its prime omits `f`. -/
theorem dcl_fromSpec_mem_basicOpen_iff {X : Over (Spec ↧ℂ)} {U : X.left.Opens}
    (hU : IsAffineOpen U) (p : PrimeSpectrum Γ(X.left, U)) (f : Γ(X.left, U)) :
    hU.fromSpec p ∈ X.left.basicOpen f ↔ f ∉ p.asIdeal := by
  have h : p ∈ hU.fromSpec ⁻¹ᵁ X.left.basicOpen f ↔ p ∈ PrimeSpectrum.basicOpen f := by
    rw [hU.fromSpec_preimage_basicOpen]; exact Iff.rfl
  exact h.trans (PrimeSpectrum.mem_basicOpen _ _)

/-- Every point of an affine open comes from a prime of its ring of sections. -/
theorem dcl_exists_fromSpec_eq {X : Over (Spec ↧ℂ)} {U : X.left.Opens} (hU : IsAffineOpen U)
    {y : X.left} (hy : y ∈ U) : ∃ p : PrimeSpectrum Γ(X.left, U), hU.fromSpec p = y := by
  have : y ∈ Set.range hU.fromSpec := by rw [hU.range_fromSpec]; exact hy
  exact this

/-- On an affine open of the smooth projective `X`, the ring of sections is a regular ring. -/
theorem dcl_isRegularRing_sections (X : Over (Spec ↧ℂ)) [Smooth X.hom] [IsProjective X.hom]
    {U : X.left.Opens} (hU : IsAffineOpen U) : IsRegularRing Γ(X.left, U) := by
  have : IsNoetherian X.left := isNoetherian_of_isProjective X
  have : IsNoetherianRing Γ(X.left, U) := IsLocallyNoetherian.component_noetherian ⟨U, hU⟩
  rw [isRegularRing_iff]
  intro p _
  let y : PrimeSpectrum Γ(X.left, U) := ⟨p, inferInstance⟩
  have hy : hU.fromSpec y ∈ U := by
    rw [← SetLike.mem_coe, ← hU.range_fromSpec]; exact Set.mem_range_self y
  let := TopCat.Presheaf.algebra_section_stalk X.left.presheaf ⟨hU.fromSpec y, hy⟩
  have : IsLocalization.AtPrime (X.left.presheaf.stalk (hU.fromSpec y)) p :=
    hU.isLocalization_stalk' y hy
  have hreg := Smooth.isRegularLocalRing_stalk_complex (f := X.hom) (hU.fromSpec y)
  exact IsRegularLocalRing.of_ringEquiv (IsLocalization.algEquiv p.primeCompl
    (X.left.presheaf.stalk (hU.fromSpec y)) (Localization.AtPrime p)).toRingEquiv

/-- With `X` integral, the prime of a point of coheight one in an affine chart is nonzero and
has no prime strictly between it and `0`. -/
theorem dcl_coheight_one_prime (X : Over (Spec ↧ℂ)) [IsIntegral X.left] {U : X.left.Opens}
    (hU : IsAffineOpen U) [Nonempty U]
    (px : PrimeSpectrum Γ(X.left, U)) (hx : Order.coheight (hU.fromSpec px) = 1) :
    px.asIdeal ≠ ⊥ ∧ ∀ q : Ideal Γ(X.left, U), q.IsPrime → q < px.asIdeal → q = ⊥ := by
  constructor
  · intro h0
    have hnmax : ¬ IsMax (hU.fromSpec px) := by
      rw [← Order.coheight_eq_zero, hx]; exact one_ne_zero
    obtain ⟨y, hxy⟩ := not_isMax_iff.mp hnmax
    have hyx : y ⤳ hU.fromSpec px := (Scheme.le_iff_specializes).mp hxy.le
    obtain ⟨py, rfl⟩ := dcl_exists_fromSpec_eq hU (hyx.mem_open U.2 (hU.range_fromSpec ▸
      Set.mem_range_self px))
    have hle : py.asIdeal ≤ px.asIdeal := (dcl_fromSpec_specializes_iff hU py px).mp hyx
    rw [h0, le_bot_iff] at hle
    have : py = px := PrimeSpectrum.ext (hle.trans h0.symm)
    exact hxy.ne (congrArg hU.fromSpec this.symm)
  · intro q hq hlt
    by_contra hq0
    let pq : PrimeSpectrum Γ(X.left, U) := ⟨q, hq⟩
    let p0 : PrimeSpectrum Γ(X.left, U) := ⟨⊥, Ideal.isPrime_bot⟩
    have h1 : hU.fromSpec px < hU.fromSpec pq := by
      rw [lt_iff_le_not_ge, Scheme.le_iff_specializes, Scheme.le_iff_specializes,
        dcl_fromSpec_specializes_iff, dcl_fromSpec_specializes_iff]
      exact ⟨hlt.le, not_le_of_gt hlt⟩
    have h2 : hU.fromSpec pq < hU.fromSpec p0 := by
      rw [lt_iff_le_not_ge, Scheme.le_iff_specializes, Scheme.le_iff_specializes,
        dcl_fromSpec_specializes_iff, dcl_fromSpec_specializes_iff]
      exact ⟨bot_le, fun h ↦ hq0 (le_bot_iff.mp h)⟩
    have e1 := Order.coheight_add_one_le h1
    have e2 := Order.coheight_add_one_le h2
    rw [hx] at e1
    have : (2 : ℕ∞) ≤ 1 := by
      calc (2 : ℕ∞) = 0 + 1 + 1 := by norm_num
        _ ≤ Order.coheight (hU.fromSpec p0) + 1 + 1 := by gcongr; exact zero_le
        _ ≤ Order.coheight (hU.fromSpec pq) + 1 := by gcongr
        _ ≤ 1 := e1
    exact absurd this (by decide)

end Charts

section Principal

variable (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom]

/-- **Prime divisors of the smooth `X` are locally principal**, on complex points. -/
theorem dcl_locallyPrincipal (x : X.left) (hx : Order.coheight x = 1) (z : ComplexPoint X) :
    ∃ (V : X.left.Opens) (s : Γ(X.left, V)), z ∈ Point.overOpen V ∧
      ∀ w ∈ Point.overOpen V, (w ∈ bh4_componentSupport X x ↔ Point.evaluate V s w = 0) := by
  by_cases hz : z.underlying ∈ closure ({x} : Set X.left)
  · obtain ⟨U, hU, hzU, -⟩ := exists_isAffineOpen_mem_and_subset (x := z.underlying)
      (U := ⊤) trivial
    have : Nonempty U := ⟨⟨z.underlying, hzU⟩⟩
    have hxz : x ⤳ z.underlying := specializes_iff_mem_closure.mpr hz
    have hxU : x ∈ U := hxz.mem_open U.2 hzU
    have := dcl_isRegularRing_sections X hU
    obtain ⟨px, rfl⟩ := dcl_exists_fromSpec_eq hU hxU
    obtain ⟨pz, hpz⟩ := dcl_exists_fromSpec_eq hU hzU
    have hle : px.asIdeal ≤ pz.asIdeal :=
      (dcl_fromSpec_specializes_iff hU px pz).mp (hpz ▸ hxz)
    obtain ⟨hne, hcoh⟩ := dcl_coheight_one_prime X hU px hx
    obtain ⟨a, -, t, ht, hiff⟩ := dcl_exists_local_equation px.asIdeal pz.asIdeal hle hne hcoh
    let V := X.left.basicOpen t
    have hVU : V ≤ U := X.left.basicOpen_le t
    refine ⟨V, X.left.presheaf.map (homOfLE hVU).op a, ?_, fun w hw ↦ ?_⟩
    · change z.underlying ∈ X.left.basicOpen t
      rw [← hpz, dcl_fromSpec_mem_basicOpen_iff]
      exact ht
    · have hwV : w.underlying ∈ V := hw
      obtain ⟨pw, hpw⟩ := dcl_exists_fromSpec_eq hU (hVU hwV)
      have htw : t ∉ pw.asIdeal := by
        rw [← dcl_fromSpec_mem_basicOpen_iff hU pw, hpw]; exact hwV
      have hev := Point.mem_overOpen_basicOpen_iff_evaluate_ne_zero
        (X.left.presheaf.map (homOfLE hVU).op a) w hw
      rw [Scheme.basicOpen_res] at hev
      have hev' : Point.evaluate V (X.left.presheaf.map (homOfLE hVU).op a) w = 0 ↔
          a ∈ pw.asIdeal := by
        rw [← not_iff_not, ← ne_eq, ← hev]
        change w.underlying ∈ V ⊓ X.left.basicOpen a ↔ _
        rw [Opens.mem_inf, ← hpw, dcl_fromSpec_mem_basicOpen_iff hU pw a]
        exact ⟨fun h ↦ h.2, fun h ↦ ⟨hpw ▸ hwV, h⟩⟩
      rw [hev', ← hiff pw.asIdeal inferInstance htw]
      change w.underlying ∈ closure ({hU.fromSpec px} : Set X.left) ↔ _
      rw [← specializes_iff_mem_closure, ← hpw, dcl_fromSpec_specializes_iff]
  · refine ⟨⟨(closure ({x} : Set X.left))ᶜ, isClosed_closure.isOpen_compl⟩, 1, hz,
      fun w hw ↦ ?_⟩
    have hw' : w.underlying ∉ closure ({x} : Set X.left) := hw
    have h1 : Point.evaluate ⟨(closure ({x} : Set X.left))ᶜ, isClosed_closure.isOpen_compl⟩
        (1 : Γ(X.left, ⟨(closure ({x} : Set X.left))ᶜ, isClosed_closure.isOpen_compl⟩)) w = 1 := by
      have hw2 : w.underlying ∈
          (⟨(closure ({x} : Set X.left))ᶜ, isClosed_closure.isOpen_compl⟩ : X.left.Opens) := hw
      simp only [Point.evaluate, hw2, ↓reduceDIte, map_one]
    rw [h1]
    exact ⟨fun h ↦ absurd h hw', fun h ↦ absurd h one_ne_zero⟩

end Principal

end HodgeLean.Foundations
