import HodgeLean.Foundations.HodgeGroupAlgebraicProofs
import HodgeLean.Foundations.MatrixAlgGroupLie
import HodgeLean.Adapters.PowersVocabulary

/-!
# The Hodge group and `G_k` as algebraic `ℚ`-groups (Track G2) (FROZEN SPEC)

Each theorem is the matching `_aux` theorem of `HodgeGroupAlgebraicProofs.lean`.

Scope. A `ℚ`-algebraic subgroup of `GL(V)`, `V ≅ ℚⁿ` through a basis `b`, is recorded by its
complex points: a subgroup of `GL_n(ℂ)` that is the zero set of rational polynomials
(`g2_IsRatAlgSubgroup`). Its Lie algebra and connectedness are Track G1's `g1_lieOfSet` and
`g1_zariski` on the point set. Two groups are **constructed**, nothing is stored:

* the Hodge group `g2_hodgeGroup H hH b`, the intersection of all `ℚ`-algebraic subgroups whose
  complex points contain `h(U(1))` (`g2_circleImage`);
* `G_k = Lef ∩ SL_k`, `g2_gkGroup b E R J d`, the zero set of explicit rational equations
  (`g2_gkEquations`).

Claimed:
1. the Hodge group is a `ℚ`-algebraic subgroup, contains `h(U(1))`, is the `ℚ`-Zariski closure
   of the group generated by the conjugates of `h(U(1))` under `Aut(ℂ)`, and is connected;
2. its Lie algebra is the complex span of `hodgeLieAlgebra H hH`, the key bridge;
3. `G_k` is a `ℚ`-algebraic subgroup, its points are described without polynomials
   (`det` on each eigenspace of `J`), its Lie algebra is the complex span of `gkLie E R J`, and
   for `R = ℚ[J]` with `E` nondegenerate and `J` skew it is connected;
4. equality of the point sets implies `HodgeLieIsGk`, and conversely when `G_k` is connected;
5. the adapter: the group form `g2_HodgeGroupEqGk` for an abelian variety implies the
   `HodgeLieIsGk` binder of the PW Theorem 4.2 targets;
and, on the CM structure of `ℚ²` given by the rotation, the Hodge group is `SO(2)`, the bare
image `h(U(1))` is not `ℚ`-algebraic, and `G_k = {1}`.

Each statement is an implication from its named binders. Not claimed: group schemes, the
`ℚ`-Zariski closure of the set `h(U(1))` alone being a group (it is not in general, see
`docs/specs/HodgeGroupAlgebraic.md`), independence of the basis, connectedness of `G_k` for a
general `R`, or any statement about the Mumford–Tate group of a particular abelian variety.
HC no distance; AV milestone no distance.
-/

noncomputable section
set_option maxHeartbeats 400000
attribute [local instance 100] LieRing.ofAssociativeRing

namespace HodgeLean.Foundations

open MvPolynomial
open scoped TensorProduct

section General

variable {V : Type*} [AddCommGroup V] [Module ℚ V] {n : ℕ}
  (H : ℤ × ℤ → Submodule ℂ (ℂ ⊗[ℚ] V)) (hH : DirectSum.IsInternal H)

/-- **The Hodge group is a `ℚ`-algebraic subgroup**: the intersection of the `ℚ`-algebraic
subgroups containing `h(U(1))` is the zero set of rational polynomials and a subgroup.
Source: Borel, *Linear Algebraic Groups*, 2nd ed., AG.11.3 and §1.1 (intersections of
`k`-closed subgroups); Moonen, *An introduction to Mumford–Tate groups* (2004), §1–2. -/
theorem g2_isRatAlgSubgroup_hodgeGroup (b : Module.Basis (Fin n) ℚ V) :
    g2_IsRatAlgSubgroup (g2_hodgeGroup H hH b) :=
  g2_isRatAlgSubgroup_hodgeGroup_aux H hH b

example (b : Module.Basis (Fin n) ℚ V) {x y : Matrix.GeneralLinearGroup (Fin n) ℂ}
    (hx : x ∈ g2_hodgeGroup H hH b) (hy : y ∈ g2_hodgeGroup H hH b) :
    x * y⁻¹ ∈ g2_hodgeGroup H hH b :=
  (g2_isRatAlgSubgroup_hodgeGroup H hH b).2.2.1 x hx _
    ((g2_isRatAlgSubgroup_hodgeGroup H hH b).2.2.2 y hy)

/-- **`h(U(1))` lies in the Hodge group.**
Source: Moonen, *An introduction to Mumford–Tate groups* (2004), §1–2 (`h(U(1)) ⊆ Hg(ℝ)`). -/
theorem g2_circleImage_subset_hodgeGroup (b : Module.Basis (Fin n) ℚ V) :
    g2_circleImage H hH b ⊆ g2_hodgeGroup H hH b :=
  g2_circleImage_subset_hodgeGroup_aux H hH b

example (b : Module.Basis (Fin n) ℚ V) (z : Circle) (g : Matrix.GeneralLinearGroup (Fin n) ℂ)
    (hg : (g : Matrix (Fin n) (Fin n) ℂ) =
      LinearMap.toMatrix (Algebra.TensorProduct.basis ℂ b) (Algebra.TensorProduct.basis ℂ b)
        (g2_circleAction H hH z)) :
    g ∈ g2_hodgeGroup H hH b :=
  g2_circleImage_subset_hodgeGroup H hH b ⟨z, hg⟩

/-- **The Hodge group as a `ℚ`-Zariski closure.** It is the `ℚ`-Zariski closure of the subgroup
generated by the conjugates of `h(U(1))` under all field automorphisms of `ℂ`. The conjugates
are needed: the `ℚ`-closure of the set `h(U(1))` alone is a finite union of conjugate tori and
is not a group for a CM abelian surface with a primitive CM type.
Source: Borel, *Linear Algebraic Groups*, 2nd ed., §2.1–2.2 (the group generated by
irreducible subvarieties through `1` is closed and connected) and AG.14.4 (a closed set stable
under `Aut(K/k)` is `k`-closed); Moonen, *An introduction to Mumford–Tate groups* (2004), §1–2. -/
theorem g2_hodgeGroup_eq_ratClosure (b : Module.Basis (Fin n) ℚ V) :
    g2_hodgeGroup H hH b =
      g2_ratClosure (Subgroup.closure (g2_galoisOrbit (g2_circleImage H hH b)) :
        Set (Matrix.GeneralLinearGroup (Fin n) ℂ)) :=
  g2_hodgeGroup_eq_ratClosure_aux H hH b

example (b : Module.Basis (Fin n) ℚ V) :
    g2_ratClosure (g2_circleImage H hH b) ⊆ g2_hodgeGroup H hH b := by
  rw [g2_hodgeGroup_eq_ratClosure]
  intro g hg f hf
  refine hg f fun x hx => hf x ?_
  exact Subgroup.subset_closure (Set.mem_iUnion.mpr ⟨RingEquiv.refl ℂ, x, hx, by ext; simp⟩)

/-- **The Hodge group is connected** in the Zariski topology.
Source: Mumford, *Families of abelian varieties*, Proc. Sympos. Pure Math. 9 (1966), §1 (the
Hodge group is connected); Borel, *Linear Algebraic Groups*, 2nd ed., §2.2 (a group generated
by irreducible subvarieties through `1` is connected). -/
theorem g2_hodgeGroup_isConnected (b : Module.Basis (Fin n) ℚ V) :
    @IsConnected _ (g1_zariski ℂ n) (g2_hodgeGroup H hH b) :=
  g2_hodgeGroup_isConnected_aux H hH b

example (b : Module.Basis (Fin n) ℚ V) : (g2_hodgeGroup H hH b).Nonempty :=
  @IsConnected.nonempty _ (g1_zariski ℂ n) _ (g2_hodgeGroup_isConnected H hH b)

/-- **The Lie algebra of the Hodge group is the complexified `hodgeLieAlgebra`.** In the basis
`1 ⊗ b`, the Lie algebra (G1's `g1_lieOfSet`) of the constructed Hodge group is the complex span
of `hodgeLieAlgebra H hH = rationalLieHull (gradingOperator H hH)`. So the repository's Hodge
Lie algebra is the Lie algebra of the genuine Hodge group.
Source: Borel, *Linear Algebraic Groups*, 2nd ed., §7.1–7.6 (in characteristic zero the Lie
algebra of the group generated by connected subgroups is the Lie algebra they generate) and
AG.14 (Galois descent); Moonen, *An introduction to Mumford–Tate groups* (2004), §1–2;
Deligne, *Théorie de Hodge II*, Publ. Math. IHÉS 40 (1971), §2.1 (`C = dh`). -/
theorem g2_lie_hodgeGroup (b : Module.Basis (Fin n) ℚ V) :
    g1_lieOfSet (g2_hodgeGroup H hH b) =
      (complexSpan (hodgeLieAlgebra H hH).toSubmodule).map
        (LinearMap.toMatrix (Algebra.TensorProduct.basis ℂ b)
          (Algebra.TensorProduct.basis ℂ b)).toLinearMap :=
  g2_lie_hodgeGroup_aux H hH b

example (b : Module.Basis (Fin n) ℚ V) :
    LinearMap.toMatrix (Algebra.TensorProduct.basis ℂ b) (Algebra.TensorProduct.basis ℂ b)
      (gradingOperator H hH) ∈ g1_lieOfSet (g2_hodgeGroup H hH b) := by
  have := Module.Finite.of_basis b
  rw [g2_lie_hodgeGroup]
  exact ⟨_, mem_complexSpan_rationalLieHull _, rfl⟩

/-- **`G_k` is a `ℚ`-algebraic subgroup**: the zero set of `g2_gkEquations` is a subgroup.
Source: PW v0.3, Subsection 2.3 (`G_k(A) = Lef(A) ∩ SL_k(V)`); Borel, *Linear Algebraic Groups*,
2nd ed., §1.6–1.7 (classical groups, centralizers); Shimura, *Arithmetic of unitary groups*,
Ann. of Math. 79 (1964), §1 (`det` of a `k`-linear map). -/
theorem g2_isRatAlgSubgroup_gkGroup (b : Module.Basis (Fin n) ℚ V)
    (E : LinearMap.BilinForm ℚ V) (R : Subalgebra ℚ (Module.End ℚ V)) (J : Module.End ℚ V)
    {d : ℚ} (hd : 0 < d) (hJ : J * J = (-d) • (1 : Module.End ℚ V)) :
    g2_IsRatAlgSubgroup (g2_gkGroup b E R J d) :=
  g2_isRatAlgSubgroup_gkGroup_aux b E R J hd hJ

example (b : Module.Basis (Fin n) ℚ V) (E : LinearMap.BilinForm ℚ V)
    (R : Subalgebra ℚ (Module.End ℚ V)) (J : Module.End ℚ V) {d : ℚ} (hd : 0 < d)
    (hJ : J * J = (-d) • (1 : Module.End ℚ V)) :
    (1 : Matrix.GeneralLinearGroup (Fin n) ℂ) ∈ g2_gkGroup b E R J d :=
  (g2_isRatAlgSubgroup_gkGroup b E R J hd hJ).2.1

/-- **The points of `G_k`, without polynomials.** With `P = (1 - (i/√d) J)/2`, the projection
onto the `i√d`-eigenspace `V₊` of `J` along `V₋`, a complex point `g` lies in `G_k` iff it
commutes with every `r ∈ R` and with `J`, preserves `E`, and `det(g|V₊) = det(gP + 1 - P) = 1`
and `det(g|V₋) = det(g(1 - P) + P) = 1`: the `k`-determinant is `1` at both embeddings of `k`.
Source: PW v0.3, Subsection 2.3; Shimura, *Arithmetic of unitary groups*, Ann. of Math. 79
(1964), §1; Bourbaki, *Algèbre*, ch. III, §9 (determinant and norm over `k ⊗ ℂ = ℂ × ℂ`). -/
theorem g2_mem_gkGroup_iff (b : Module.Basis (Fin n) ℚ V)
    (E : LinearMap.BilinForm ℚ V) (R : Subalgebra ℚ (Module.End ℚ V)) (J : Module.End ℚ V)
    {d : ℚ} (hd : 0 < d) (hJ : J * J = (-d) • (1 : Module.End ℚ V))
    (g : Matrix.GeneralLinearGroup (Fin n) ℂ) :
    g ∈ g2_gkGroup b E R J d ↔
      (∀ r ∈ R, (g : Matrix (Fin n) (Fin n) ℂ) * (LinearMap.toMatrix b b r).map (algebraMap ℚ ℂ) =
          (LinearMap.toMatrix b b r).map (algebraMap ℚ ℂ) * g) ∧
      (g : Matrix (Fin n) (Fin n) ℂ) * (LinearMap.toMatrix b b J).map (algebraMap ℚ ℂ) =
          (LinearMap.toMatrix b b J).map (algebraMap ℚ ℂ) * g ∧
      Matrix.transpose (g : Matrix (Fin n) (Fin n) ℂ) *
          (LinearMap.BilinForm.toMatrix b E).map (algebraMap ℚ ℂ) * g =
        (LinearMap.BilinForm.toMatrix b E).map (algebraMap ℚ ℂ) ∧
      ((g : Matrix (Fin n) (Fin n) ℂ) *
          ((1 / 2 : ℂ) • (1 - (Complex.I / ((Real.sqrt d : ℝ) : ℂ)) •
            (LinearMap.toMatrix b b J).map (algebraMap ℚ ℂ))) +
        (1 - (1 / 2 : ℂ) • (1 - (Complex.I / ((Real.sqrt d : ℝ) : ℂ)) •
            (LinearMap.toMatrix b b J).map (algebraMap ℚ ℂ)))).det = 1 ∧
      ((g : Matrix (Fin n) (Fin n) ℂ) *
          (1 - (1 / 2 : ℂ) • (1 - (Complex.I / ((Real.sqrt d : ℝ) : ℂ)) •
            (LinearMap.toMatrix b b J).map (algebraMap ℚ ℂ))) +
        (1 / 2 : ℂ) • (1 - (Complex.I / ((Real.sqrt d : ℝ) : ℂ)) •
            (LinearMap.toMatrix b b J).map (algebraMap ℚ ℂ))).det = 1 :=
  g2_mem_gkGroup_iff_aux b E R J hd hJ g

example (b : Module.Basis (Fin n) ℚ V) (E : LinearMap.BilinForm ℚ V)
    (R : Subalgebra ℚ (Module.End ℚ V)) (J : Module.End ℚ V) {d : ℚ} (hd : 0 < d)
    (hJ : J * J = (-d) • (1 : Module.End ℚ V)) (g : Matrix.GeneralLinearGroup (Fin n) ℂ)
    (hg : g ∈ g2_gkGroup b E R J d) :
    (g : Matrix (Fin n) (Fin n) ℂ) * (LinearMap.toMatrix b b J).map (algebraMap ℚ ℂ) =
      (LinearMap.toMatrix b b J).map (algebraMap ℚ ℂ) * g :=
  ((g2_mem_gkGroup_iff b E R J hd hJ g).mp hg).2.1

/-- **The Lie algebra of `G_k` is the complexified `gkLie`.** In the basis `1 ⊗ b`, the Lie
algebra of the constructed `G_k` is the complex span of `gkLie E R J` (commuting with `R` and
`J`, `E`-skew, `tr X = 0`, `tr (J X) = 0`).
Source: Borel, *Linear Algebraic Groups*, 2nd ed., §3.9, §3.11 and §6.12 (Lie algebras of
classical groups, centralizers and intersections in characteristic zero); PW v0.3,
Subsection 2.3 (`Lie(G_k)`); G1's `g1_lie_inf` and `g1_lie_centralizer`. -/
theorem g2_lie_gkGroup (b : Module.Basis (Fin n) ℚ V)
    (E : LinearMap.BilinForm ℚ V) (R : Subalgebra ℚ (Module.End ℚ V)) (J : Module.End ℚ V)
    {d : ℚ} (hd : 0 < d) (hJ : J * J = (-d) • (1 : Module.End ℚ V)) :
    g1_lieOfSet (g2_gkGroup b E R J d) =
      (complexSpan (gkLie E R J).toSubmodule).map
        (LinearMap.toMatrix (Algebra.TensorProduct.basis ℂ b)
          (Algebra.TensorProduct.basis ℂ b)).toLinearMap :=
  g2_lie_gkGroup_aux b E R J hd hJ

example (b : Module.Basis (Fin n) ℚ V) (E : LinearMap.BilinForm ℚ V) (J : Module.End ℚ V)
    {d : ℚ} (hd : 0 < d) (hJ : J * J = (-d) • (1 : Module.End ℚ V)) :
    g1_lieOfSet (g2_gkGroup b E (Algebra.adjoin ℚ {J}) J d) =
      (complexSpan (weilSU E J).toSubmodule).map
        (LinearMap.toMatrix (Algebra.TensorProduct.basis ℂ b)
          (Algebra.TensorProduct.basis ℂ b)).toLinearMap := by
  rw [g2_lie_gkGroup b E _ J hd hJ, HodgeLean.Adapters.spec_pw0_gkLie_adjoin_eq]

/-- **`G_k` is connected for `R = ℚ[J]` and `E` alternating**: for `E` nondegenerate with `J` skew
(`E (J x) y = -E x (J y)`), the eigenspaces `V₊`, `V₋` are isotropic and dual, `G_k(ℂ)` is
`SL(V₊)`, and `SL` is connected.
Source: Borel, *Linear Algebraic Groups*, 2nd ed., §2.2 and §23.3 (`SL_m` is connected);
van Geemen, *An introduction to the Hodge conjecture for abelian varieties*, §5–6 (`SU(h)` of a
Weil-type structure). -/
theorem g2_gkGroup_isConnected_adjoin (b : Module.Basis (Fin n) ℚ V)
    (E : LinearMap.BilinForm ℚ V) (J : Module.End ℚ V) {d : ℚ} (hd : 0 < d)
    (hJ : J * J = (-d) • (1 : Module.End ℚ V)) (hE : E.Nondegenerate) (hAlt : E.IsAlt)
    (hskew : ∀ x y, E (J x) y = -E x (J y)) :
    @IsConnected _ (g1_zariski ℂ n) (g2_gkGroup b E (Algebra.adjoin ℚ {J}) J d) :=
  g2_gkGroup_isConnected_adjoin_aux b E J hd hJ hE hAlt hskew

example (b : Module.Basis (Fin n) ℚ V) (E : LinearMap.BilinForm ℚ V) (J : Module.End ℚ V)
    {d : ℚ} (hd : 0 < d) (hJ : J * J = (-d) • (1 : Module.End ℚ V)) (hE : E.Nondegenerate)
    (hAlt : E.IsAlt) (hskew : ∀ x y, E (J x) y = -E x (J y)) :
    @IsPreconnected _ (g1_zariski ℂ n) (g2_gkGroup b E (Algebra.adjoin ℚ {J}) J d) :=
  @IsConnected.isPreconnected _ (g1_zariski ℂ n) _
    (g2_gkGroup_isConnected_adjoin b E J hd hJ hE hAlt hskew)

/-- **The group form implies the Lie form**: `Hg = G_k` as point sets implies `HodgeLieIsGk`.
Equal groups have equal Lie algebras; by `g2_lie_hodgeGroup` and `g2_lie_gkGroup` these are the
complex spans of `hodgeLieAlgebra` and `gkLie`.
Source: Borel, *Linear Algebraic Groups*, 2nd ed., §3.5; PW v0.3, Theorem 4.2, hypothesis
`Hg(A) = G_k(A)`, and Remark 4.3. -/
theorem g2_hodgeLieIsGk_of_eq (b : Module.Basis (Fin n) ℚ V)
    (E : LinearMap.BilinForm ℚ V) (R : Subalgebra ℚ (Module.End ℚ V)) (J : Module.End ℚ V)
    {d : ℚ} (hd : 0 < d) (hJ : J * J = (-d) • (1 : Module.End ℚ V))
    (h : g2_hodgeGroup H hH b = g2_gkGroup b E R J d) : HodgeLieIsGk H hH E R J :=
  g2_hodgeLieIsGk_of_eq_aux H hH b E R J hd hJ h

example [FiniteDimensional ℚ V] (E : LinearMap.BilinForm ℚ V)
    (R : Subalgebra ℚ (Module.End ℚ V)) (J : Module.End ℚ V) {d : ℚ} (hd : 0 < d)
    (hJ : J * J = (-d) • (1 : Module.End ℚ V)) (h : g2_HodgeGroupEqGk H hH E R J d) :
    HodgeLieIsGk H hH E R J :=
  g2_hodgeLieIsGk_of_eq H hH _ E R J hd hJ h

/-- **The Lie form implies the group form when `G_k` is connected**: `HodgeLieIsGk` and the
connectedness of `G_k` give `Hg = G_k` as point sets (both are connected, by
`g2_hodgeGroup_isConnected`, with equal Lie algebras; G1's `g1_eq_of_lie_eq`).
Source: Borel, *Linear Algebraic Groups*, 2nd ed., §7.1; Humphreys, *Linear Algebraic Groups*,
§13.1; G1's `g1_eq_of_lie_eq` and `g1_hodgeGroup_eq_gkGroup`. -/
theorem g2_eq_of_hodgeLieIsGk (b : Module.Basis (Fin n) ℚ V)
    (E : LinearMap.BilinForm ℚ V) (R : Subalgebra ℚ (Module.End ℚ V)) (J : Module.End ℚ V)
    {d : ℚ} (hd : 0 < d) (hJ : J * J = (-d) • (1 : Module.End ℚ V))
    (hconn : @IsConnected _ (g1_zariski ℂ n) (g2_gkGroup b E R J d))
    (h : HodgeLieIsGk H hH E R J) : g2_hodgeGroup H hH b = g2_gkGroup b E R J d :=
  g2_eq_of_hodgeLieIsGk_aux H hH b E R J hd hJ hconn h

/-- For `R = ℚ[J]`, `E` nondegenerate and `J` skew, the group form and the Lie form are
equivalent. -/
example (b : Module.Basis (Fin n) ℚ V) (E : LinearMap.BilinForm ℚ V) (J : Module.End ℚ V)
    {d : ℚ} (hd : 0 < d) (hJ : J * J = (-d) • (1 : Module.End ℚ V)) (hE : E.Nondegenerate)
    (hAlt : E.IsAlt) (hskew : ∀ x y, E (J x) y = -E x (J y)) :
    g2_hodgeGroup H hH b = g2_gkGroup b E (Algebra.adjoin ℚ {J}) J d ↔
      HodgeLieIsGk H hH E (Algebra.adjoin ℚ {J}) J :=
  ⟨g2_hodgeLieIsGk_of_eq H hH b E _ J hd hJ,
    g2_eq_of_hodgeLieIsGk H hH b E _ J hd hJ (g2_gkGroup_isConnected_adjoin b E J hd hJ hE hAlt hskew)⟩

end General

section Rotation

/-- **Satisfiable instance: the CM structure of `ℚ²`, `Hg = SO(2)`.** For the weight-one
structure of the rotation `[[0, -1], [1, 0]]` (CM by `ℚ(i)`, an elliptic curve with CM by
`ℤ[i]`), the Hodge group is the torus `SO(2) = U(1)`: the matrices `[[a, -c], [c, a]]` with
`a² + c² = 1`.
Source: Moonen, *An introduction to Mumford–Tate groups* (2004), §1–2 (CM elliptic curves:
`Hg = U(1)`, a one-dimensional torus); Mumford, *Families of abelian varieties*, Proc. Sympos.
Pure Math. 9 (1966), §2. -/
theorem g2_hodgeGroup_rotation :
    g2_hodgeGroup (complexStructureHodge rotation 1 0)
        (isInternal_complexStructureHodge rotation_mul_rotation (by decide))
        (Pi.basisFun ℚ (Fin 2)) =
      {g : Matrix.GeneralLinearGroup (Fin 2) ℂ | (g : Matrix (Fin 2) (Fin 2) ℂ) 0 0 =
        (g : Matrix (Fin 2) (Fin 2) ℂ) 1 1 ∧
        (g : Matrix (Fin 2) (Fin 2) ℂ) 0 1 = -(g : Matrix (Fin 2) (Fin 2) ℂ) 1 0 ∧
        (g : Matrix (Fin 2) (Fin 2) ℂ).det = 1} :=
  g2_hodgeGroup_rotation_aux

example : (1 : Matrix.GeneralLinearGroup (Fin 2) ℂ) ∈
    g2_hodgeGroup (complexStructureHodge rotation 1 0)
      (isInternal_complexStructureHodge rotation_mul_rotation (by decide))
      (Pi.basisFun ℚ (Fin 2)) := by
  rw [g2_hodgeGroup_rotation]
  simp

/-- **Degenerate case ruled out: `h(U(1))` without Zariski closure is not `ℚ`-algebraic.** For
the rotation structure, the image of the circle (the real rotations) is a group but not the zero
set of rational polynomials, so the closure in `g2_hodgeGroup` is needed.
Source: Borel, *Linear Algebraic Groups*, 2nd ed., AG.13 (the real points of an irreducible
curve are Zariski dense in it); Moonen, *An introduction to Mumford–Tate groups* (2004), §1. -/
theorem g2_not_isRatAlgSubgroup_circleImage_rotation :
    ¬ g2_IsRatAlgSubgroup (g2_circleImage (complexStructureHodge rotation 1 0)
        (isInternal_complexStructureHodge rotation_mul_rotation (by decide))
        (Pi.basisFun ℚ (Fin 2))) :=
  g2_not_isRatAlgSubgroup_circleImage_rotation_aux

example : g2_circleImage (complexStructureHodge rotation 1 0)
      (isInternal_complexStructureHodge rotation_mul_rotation (by decide))
      (Pi.basisFun ℚ (Fin 2)) ≠
    g2_hodgeGroup (complexStructureHodge rotation 1 0)
      (isInternal_complexStructureHodge rotation_mul_rotation (by decide))
      (Pi.basisFun ℚ (Fin 2)) := fun h =>
  g2_not_isRatAlgSubgroup_circleImage_rotation (h ▸ g2_isRatAlgSubgroup_hodgeGroup _ _ _)

/-- **`G_k` of the rotation structure is trivial**: with `E` the standard alternating form,
`R = ℚ[J]` and `d = 1`, `G_k = SU(1) = {1}`. So `Hg = G_k` fails there (`Hg = SO(2)`), and the
group form of (P3) is not automatic.
Source: PW v0.3, Subsection 2.3 (`G_k = SU(h)` for `End⁰ = k`); van Geemen, *An introduction
to the Hodge conjecture for abelian varieties*, §5–6. -/
theorem g2_gkGroup_rotation :
    g2_gkGroup (Pi.basisFun ℚ (Fin 2)) (Matrix.toBilin' !![0, 1; -1, 0])
        (Algebra.adjoin ℚ {rotation}) rotation 1 = {1} :=
  g2_gkGroup_rotation_aux

example : g2_hodgeGroup (complexStructureHodge rotation 1 0)
      (isInternal_complexStructureHodge rotation_mul_rotation (by decide))
      (Pi.basisFun ℚ (Fin 2)) ≠
    g2_gkGroup (Pi.basisFun ℚ (Fin 2)) (Matrix.toBilin' !![0, 1; -1, 0])
      (Algebra.adjoin ℚ {rotation}) rotation 1 := by
  rw [g2_hodgeGroup_rotation, g2_gkGroup_rotation]
  intro h
  have h1 : (-1 : Matrix.GeneralLinearGroup (Fin 2) ℂ) ∈ ({1} : Set _) := by
    rw [← h]
    simp [Matrix.det_fin_two]
  have h2 := congrArg (fun g : Matrix.GeneralLinearGroup (Fin 2) ℂ =>
    (g : Matrix (Fin 2) (Fin 2) ℂ) 0 0) (Set.mem_singleton_iff.mp h1)
  norm_num at h2

end Rotation

section PW

open CategoryTheory AlgebraicGeometry HodgeLean.RealDefs HodgeLean.Adapters
open HodgeLean.Foundations.Symplectic
open scoped CategoryTheory.MonObj

variable (A : Over (Spec ↧ℂ)) [GrpObj A] [IsCommMonObj A] [IsIntegral A.left]
  [Smooth A.hom] [IsProjective A.hom] {L : Type*} [Field L] [Algebra ℚ L]

/-- **The adapter to PW Theorem 4.2.** For an abelian variety `A`, `θ : L →ₐ[ℚ] End⁰(A)`,
`u ∈ L` with `u² = -d`, `d > 0`, and any form `E` on `H¹(A, ℚ)`, the group form
`g2_HodgeGroupEqGk` of the paper's hypothesis (P3) implies the binder `HodgeLieIsGk` of the
Theorem 4.2 targets, with `R = pwActionRange A θ` and `J = pwAction A θ u`.
Source: PW v0.3, Theorem 4.2, hypothesis `Hg(A) = G_k(A)`; `g2_hodgeLieIsGk_of_eq`;
`docs/specs/PWTheorem42Final.md` (branch `spec/pwfin`), "Target statements, after P1 and G2". -/
theorem g2_pw_hodgeLieIsGk (θ : L →ₐ[ℚ] AbelianEnd0 A) (u : L) {d : ℚ} (hd : 0 < d)
    (hu : u ^ 2 = -algebraMap ℚ L d) (E : LinearMap.BilinForm ℚ (HQ A 1))
    (hHg : letI := (finiteBetti_abelian A).finite 1
      g2_HodgeGroupEqGk (abelianWeightOneHodgeStructure A).H
        (abelianWeightOneHodgeStructure A).isInternal E (pwActionRange A θ) (pwAction A θ u) d) :
    letI := (finiteBetti_abelian A).finite 1
    HodgeLieIsGk (abelianWeightOneHodgeStructure A).H
      (abelianWeightOneHodgeStructure A).isInternal E (pwActionRange A θ) (pwAction A θ u) :=
  g2_pw_hodgeLieIsGk_aux A θ u hd hu E hHg

/-- With the polarization form of the PW targets. -/
example (θ : L →ₐ[ℚ] AbelianEnd0 A) (u : L) {d : ℚ} (hd : 0 < d)
    (hu : u ^ 2 = -algebraMap ℚ L d) (pol : HQ A 2)
    (hη : IsNondegenerate (polarizationVec (torusCohomology_cupProductOf A) pol))
    (hHg : letI := (finiteBetti_abelian A).finite 1
      g2_HodgeGroupEqGk (abelianWeightOneHodgeStructure A).H
        (abelianWeightOneHodgeStructure A).isInternal
        (polarizationForm (torusCohomology_cupProductOf A) hη) (pwActionRange A θ)
        (pwAction A θ u) d) :
    letI := (finiteBetti_abelian A).finite 1
    HodgeLieIsGk (abelianWeightOneHodgeStructure A).H
      (abelianWeightOneHodgeStructure A).isInternal
      (polarizationForm (torusCohomology_cupProductOf A) hη) (pwActionRange A θ)
      (pwAction A θ u) :=
  g2_pw_hodgeLieIsGk A θ u hd hu _ hHg

end PW

