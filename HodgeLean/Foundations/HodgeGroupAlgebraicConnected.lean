import HodgeLean.Foundations.HodgeGroupAlgebraicDescent

/-! # Connectedness of the Hodge group (Track G2, helpers)

* `g2h_circleMat H hH b z`: the matrix of `h(z)` as an invertible matrix; `z ↦ h(z)` is a
  homomorphism `U(1) → GL_n(ℂ)`, continuous from the analytic topology of `U(1)` to the Zariski
  topology (its entries are Laurent polynomials in `z`), so `h(U(1))` is Zariski connected.
* `g2h_isConnected_galoisOrbit`: the conjugates `σ(h(U(1)))` are connected and pass through
  `1`, so their union is connected.
* `g2h_isConnected_closure_of_connected`: the subgroup generated by a connected set through
  `1` stable under inverses is connected (the component of `1` is stable under left
  translation by its own elements).
-/

noncomputable section
set_option maxHeartbeats 400000

namespace HodgeLean.Foundations

open MvPolynomial TopologicalSpace
open scoped TensorProduct

section Circle

variable {V : Type*} [AddCommGroup V] [Module ℚ V]
  (H : ℤ × ℤ → Submodule ℂ (ℂ ⊗[ℚ] V)) (hH : DirectSum.IsInternal H) {n : ℕ}

theorem g2h_circleAction_one : g2_circleAction H hH 1 = LinearMap.id :=
  linearMap_ext_of_isInternal hH fun _ _ hx => by
    rw [g2_circleAction_apply_of_mem H hH 1 hx]
    simp

theorem g2h_circleAction_mul (z w : Circle) :
    g2_circleAction H hH (z * w) = g2_circleAction H hH z ∘ₗ g2_circleAction H hH w :=
  linearMap_ext_of_isInternal hH fun _ x hx => by
    rw [LinearMap.comp_apply, g2_circleAction_apply_of_mem H hH _ hx,
      g2_circleAction_apply_of_mem H hH w hx, map_smul, g2_circleAction_apply_of_mem H hH z hx,
      smul_smul, Circle.coe_mul, mul_zpow, mul_comm]

/-- `h(z)` as an invertible matrix in the basis `1 ⊗ b`, with inverse `h(z⁻¹)`.
Source: Deligne, *Théorie de Hodge II*, Publ. Math. IHÉS 40 (1971), §2.1 (`h` is a
homomorphism); Moonen, *An introduction to Mumford–Tate groups* (2004), §1–2. -/
def g2h_circleMat (b : Module.Basis (Fin n) ℚ V) (z : Circle) :
    Matrix.GeneralLinearGroup (Fin n) ℂ where
  val := LinearMap.toMatrix (Algebra.TensorProduct.basis ℂ b) (Algebra.TensorProduct.basis ℂ b)
    (g2_circleAction H hH z)
  inv := LinearMap.toMatrix (Algebra.TensorProduct.basis ℂ b) (Algebra.TensorProduct.basis ℂ b)
    (g2_circleAction H hH z⁻¹)
  val_inv := by
    rw [← LinearMap.toMatrix_comp, ← g2h_circleAction_mul, mul_inv_cancel,
      g2h_circleAction_one, LinearMap.toMatrix_id]
  inv_val := by
    rw [← LinearMap.toMatrix_comp, ← g2h_circleAction_mul, inv_mul_cancel,
      g2h_circleAction_one, LinearMap.toMatrix_id]

example (b : Module.Basis (Fin n) ℚ V) : g2h_circleMat H hH b 1 = 1 := by
  ext1
  change LinearMap.toMatrix _ _ _ = 1
  rw [g2h_circleAction_one, LinearMap.toMatrix_id]

theorem g2h_circleMat_one (b : Module.Basis (Fin n) ℚ V) : g2h_circleMat H hH b 1 = 1 := by
  ext1
  change LinearMap.toMatrix _ _ _ = 1
  rw [g2h_circleAction_one, LinearMap.toMatrix_id]

theorem g2h_circleImage_eq_range (b : Module.Basis (Fin n) ℚ V) :
    g2_circleImage H hH b = Set.range (g2h_circleMat H hH b) := by
  ext g
  constructor
  · rintro ⟨z, hz⟩
    exact ⟨z, Units.ext hz.symm⟩
  · rintro ⟨z, rfl⟩
    exact ⟨z, rfl⟩

theorem g2h_one_mem_circleImage (b : Module.Basis (Fin n) ℚ V) :
    (1 : Matrix.GeneralLinearGroup (Fin n) ℂ) ∈ g2_circleImage H hH b := by
  rw [g2h_circleImage_eq_range]
  exact ⟨1, g2h_circleMat_one H hH b⟩

theorem g2h_inv_mem_circleImage (b : Module.Basis (Fin n) ℚ V)
    {g : Matrix.GeneralLinearGroup (Fin n) ℂ} (hg : g ∈ g2_circleImage H hH b) :
    g⁻¹ ∈ g2_circleImage H hH b := by
  rw [g2h_circleImage_eq_range] at hg ⊢
  obtain ⟨z, rfl⟩ := hg
  exact ⟨z⁻¹, Units.ext rfl⟩

/-- `h(z) y` as a finite sum over the Hodge components of `y`. -/
theorem g2h_circleAction_apply_eq_sum [DecidableEq (ℂ ⊗[ℚ] V)] (z : Circle) (y : ℂ ⊗[ℚ] V) :
    g2_circleAction H hH z y =
      ∑ pq ∈ ((LinearEquiv.ofBijective (DirectSum.coeLinearMap H) hH).symm y).support,
        ((z : ℂ) ^ (pq.1 - pq.2)) •
          (((LinearEquiv.ofBijective (DirectSum.coeLinearMap H) hH).symm y pq : ℂ ⊗[ℚ] V)) := by
  set d := (LinearEquiv.ofBijective (DirectSum.coeLinearMap H) hH).symm y
  have hy : y = ∑ pq ∈ d.support, (d pq : ℂ ⊗[ℚ] V) := by
    have := (LinearEquiv.ofBijective (DirectSum.coeLinearMap H) hH).apply_symm_apply y
    change DirectSum.coeLinearMap H d = y at this
    rw [DirectSum.coeLinearMap_eq_dfinsuppSum] at this
    exact this.symm
  conv_lhs => rw [hy]
  rw [map_sum]
  exact Finset.sum_congr rfl fun pq _ => g2_circleAction_apply_of_mem H hH z (d pq).2

theorem g2h_continuous_zpow (k : ℤ) : Continuous fun z : Circle => (z : ℂ) ^ k := by
  have : (fun z : Circle => (z : ℂ) ^ k) = fun z => ((z ^ k : Circle) : ℂ) := by
    funext z
    rw [Circle.coe_zpow]
  rw [this]
  exact continuous_subtype_val.comp (continuous_zpow k)

theorem g2h_continuous_circleMat_apply (b : Module.Basis (Fin n) ℚ V) (i j : Fin n) :
    Continuous fun z : Circle => (g2h_circleMat H hH b z : Matrix (Fin n) (Fin n) ℂ) i j := by
  classical
  change Continuous fun z : Circle => LinearMap.toMatrix (Algebra.TensorProduct.basis ℂ b)
    (Algebra.TensorProduct.basis ℂ b) (g2_circleAction H hH z) i j
  simp_rw [LinearMap.toMatrix_apply, g2h_circleAction_apply_eq_sum, map_sum, map_smul,
    Finsupp.coe_finsetSum, Finset.sum_apply, Finsupp.smul_apply, smul_eq_mul]
  exact continuous_finsetSum _ fun pq _ => (g2h_continuous_zpow _).mul continuous_const

set_option warn.classDefReducibility false in
attribute [local instance] g1_zariski

/-- `z ↦ h(z)` is continuous from `U(1)` to `GL_n(ℂ)` with its Zariski topology. -/
theorem g2h_continuous_circleMat (b : Module.Basis (Fin n) ℚ V) :
    Continuous (g2h_circleMat H hH b) := by
  refine continuous_iff_isClosed.mpr fun Z hZ => ?_
  obtain ⟨s, rfl⟩ := (g1_isClosed_iff Z).mp hZ
  have : g2h_circleMat H hH b ⁻¹' g1_zeroSet s =
      ⋂ f ∈ s, {z | eval (g1_coords (g2h_circleMat H hH b z)) f = 0} := by
    ext z
    simp [g1_zeroSet]
  rw [this]
  refine isClosed_biInter fun f _ => isClosed_eq ?_ continuous_const
  exact (continuous_eval f).comp
    (continuous_pi fun ij => g2h_continuous_circleMat_apply H hH b ij.1 ij.2)

/-- **`h(U(1))` is Zariski connected**: it is the continuous image of the connected circle.
Source: Borel, *Linear Algebraic Groups*, 2nd ed., §2.2 (images of connected varieties);
Mumford, *Families of abelian varieties*, Proc. Sympos. Pure Math. 9 (1966), §1. -/
theorem g2h_isConnected_circleImage (b : Module.Basis (Fin n) ℚ V) :
    IsConnected (g2_circleImage H hH b) := by
  rw [g2h_circleImage_eq_range]
  exact isConnected_range (g2h_continuous_circleMat H hH b)

end Circle

section Group

set_option warn.classDefReducibility false in
attribute [local instance] g1_zariski

variable {n : ℕ}

/-- The union of the conjugates of a connected set through `1` is connected. -/
theorem g2h_isConnected_galoisOrbit {C : Set (Matrix.GeneralLinearGroup (Fin n) ℂ)}
    (hC : IsConnected C) (h1 : 1 ∈ C) : IsConnected (g2_galoisOrbit C) :=
  ⟨⟨1, Set.mem_iUnion.mpr ⟨RingEquiv.refl ℂ, 1, h1, map_one _⟩⟩,
    isPreconnected_iUnion ⟨1, Set.mem_iInter.mpr fun _ => ⟨1, h1, map_one _⟩⟩
      fun σ => hC.isPreconnected.image _ (g2h_continuous_map σ).continuousOn⟩

theorem g2h_inv_mem_galoisOrbit {C : Set (Matrix.GeneralLinearGroup (Fin n) ℂ)}
    (hC : ∀ x ∈ C, x⁻¹ ∈ C) {g : Matrix.GeneralLinearGroup (Fin n) ℂ}
    (hg : g ∈ g2_galoisOrbit C) : g⁻¹ ∈ g2_galoisOrbit C := by
  obtain ⟨σ, x, hx, rfl⟩ := Set.mem_iUnion.mp hg
  exact Set.mem_iUnion.mpr ⟨σ, x⁻¹, hC x hx, map_inv _ x⟩

/-- **The subgroup generated by a connected set through `1` is connected.** Here the set is
stable under inverses, so the subgroup is the monoid it generates; the component of `1` in it
contains the set and is stable under left translation by its own elements.
Source: Borel, *Linear Algebraic Groups*, 2nd ed., §2.2 (groups generated by connected
subvarieties through `1`). -/
theorem g2h_isConnected_closure_of_connected {S : Set (Matrix.GeneralLinearGroup (Fin n) ℂ)}
    (hS : IsConnected S) (h1 : 1 ∈ S) (hinv : ∀ x ∈ S, x⁻¹ ∈ S) :
    IsConnected (Subgroup.closure S : Set (Matrix.GeneralLinearGroup (Fin n) ℂ)) := by
  set Γ := (Subgroup.closure S : Set (Matrix.GeneralLinearGroup (Fin n) ℂ)) with hΓ_def
  set K := connectedComponentIn Γ 1
  have h1Γ : (1 : Matrix.GeneralLinearGroup (Fin n) ℂ) ∈ Γ := (Subgroup.closure S).one_mem
  have hSK : S ⊆ K := hS.isPreconnected.subset_connectedComponentIn h1 Subgroup.subset_closure
  have hKΓ : K ⊆ Γ := connectedComponentIn_subset _ _
  have hmul : ∀ x ∈ K, ∀ y ∈ K, x * y ∈ K := by
    intro x hx y hy
    have hpre : IsPreconnected ((x * ·) '' K) :=
      isPreconnected_connectedComponentIn.image _ (g1_continuous_mul_left x).continuousOn
    have hsub : (x * ·) '' K ⊆ Γ := by
      rintro _ ⟨k, hk, rfl⟩
      exact (Subgroup.closure S).mul_mem (hKΓ hx) (hKΓ hk)
    have hxmem : x ∈ (x * ·) '' K := ⟨1, mem_connectedComponentIn h1Γ, mul_one x⟩
    have := hpre.subset_connectedComponentIn hxmem hsub
    rw [← connectedComponentIn_eq hx] at this
    exact this ⟨y, hy, rfl⟩
  have hΓK : Γ ⊆ K := by
    intro g hg
    have hg' : g ∈ (Subgroup.closure S).toSubmonoid := hg
    clear hg
    rw [Subgroup.closure_toSubmonoid] at hg'
    induction hg' using Submonoid.closure_induction with
    | mem x hx =>
      rcases hx with hx | hx
      · exact hSK hx
      · exact hSK (by simpa using hinv _ hx)
    | one => exact mem_connectedComponentIn h1Γ
    | mul x y _ _ hx hy => exact hmul x hx y hy
  rw [le_antisymm hΓK hKΓ]
  exact isConnected_connectedComponentIn_iff.mpr h1Γ

end Group

end HodgeLean.Foundations
