import HodgeLean.Foundations.HodgeGroupAlgebraicGk
import HodgeLean.Foundations.MatrixAlgGroupLieIdentityComponent
import Mathlib.Analysis.Normed.Module.Connected
import Mathlib.LinearAlgebra.Matrix.Transvection
import Mathlib.Topology.Algebra.MvPolynomial

/-! # Helpers for `G_k` (Track G2): connectedness for an alternating form

For `R = ℚ[J]`, `J² = -d`, `d > 0`, and `E` **alternating**, nondegenerate, with `J` skew, the
eigenspaces `V₊`, `V₋` of `J` on `V_ℂ` are isotropic and `E` pairs them perfectly; in a basis
`(e, f)` of `V_ℂ` with `e` a basis of `V₊` and `f` the dual basis of `V₋`, a point of `G_k` is
`diag (A, A⁻ᵀ)` with `det A = 1`. So `G_k ≅ SL_m(ℂ)`. `SL_m(ℂ)` is generated by transvections and
diagonal matrices of determinant `1` (`Matrix.diagonal_transvection_induction`), each lying on a
curve through `1` (`t ↦ 1 + t c E_ij`, and `z ↦ diag(z, z⁻¹)` on `ℂ^×`); the identity component
is closed under products, so it is all of `G_k`.

The alternating hypothesis is needed: `HodgeGroupAlgebraicGkCounterexample.lean` gives a
nondegenerate `J`-skew form that is not alternating, with `G_k` disconnected.
-/

noncomputable section
set_option maxHeartbeats 400000

namespace HodgeLean.Foundations

open MvPolynomial

variable {n : ℕ}

/-! ## Curves in the Zariski topology -/

set_option warn.classDefReducibility false in
attribute [local instance] g1_zariski in
/-- A map into `GL_n(ℂ)` whose matrix entries are continuous is Zariski continuous. -/
theorem g2k_continuous_zariski {X : Type*} [TopologicalSpace X]
    (c : X → Matrix.GeneralLinearGroup (Fin n) ℂ)
    (hc : ∀ i j, Continuous fun x => (c x : Matrix (Fin n) (Fin n) ℂ) i j) : Continuous c := by
  rw [continuous_iff_isClosed]
  intro Z hZ
  obtain ⟨s, rfl⟩ := (g1_isClosed_iff Z).mp hZ
  have : c ⁻¹' g1_zeroSet s = ⋂ f ∈ s, {x | eval (g1_coords (c x)) f = 0} := by
    ext x
    simp [g1_zeroSet]
  rw [this]
  refine isClosed_biInter fun f _ => isClosed_eq ?_ continuous_const
  exact (MvPolynomial.continuous_eval f).comp (continuous_pi fun ij => hc ij.1 ij.2)

set_option warn.classDefReducibility false in
attribute [local instance] g1_zariski in
/-- A Zariski-continuous curve in `S` from a connected space, through `1`, stays in the component
of `1`. -/
theorem g2k_mem_component_of_curve {X : Type*} [TopologicalSpace X] [ConnectedSpace X]
    (S : Set (Matrix.GeneralLinearGroup (Fin n) ℂ)) (c : X → Matrix.GeneralLinearGroup (Fin n) ℂ)
    (hc : ∀ i j, Continuous fun x => (c x : Matrix (Fin n) (Fin n) ℂ) i j) (hS : ∀ x, c x ∈ S)
    (x₀ x₁ : X) (h₀ : c x₀ = 1) : c x₁ ∈ connectedComponentIn S 1 := by
  have hconn : IsConnected (Set.range c) :=
    isConnected_range (g2k_continuous_zariski c hc)
  have hsub : Set.range c ⊆ connectedComponentIn S 1 :=
    hconn.isPreconnected.subset_connectedComponentIn ⟨x₀, h₀⟩ (by rintro _ ⟨x, rfl⟩; exact hS x)
  exact hsub ⟨x₁, rfl⟩

set_option warn.classDefReducibility false in
attribute [local instance] g1_zariski in
/-- The component of `1` in a set closed under products is closed under products. -/
theorem g2k_component_mul (S : Set (Matrix.GeneralLinearGroup (Fin n) ℂ))
    (hS : ∀ x ∈ S, ∀ y ∈ S, x * y ∈ S) {x y : Matrix.GeneralLinearGroup (Fin n) ℂ}
    (hx : x ∈ connectedComponentIn S 1) (hy : y ∈ connectedComponentIn S 1) :
    x * y ∈ connectedComponentIn S 1 := by
  set C := connectedComponentIn S 1
  have hCS : C ⊆ S := connectedComponentIn_subset S 1
  have himg : IsPreconnected ((fun g => x * g) '' C) :=
    isPreconnected_connectedComponentIn.image _ (g1_continuous_mul_left x).continuousOn
  have hxS : x ∈ S := hCS hx
  have h1S : (1 : Matrix.GeneralLinearGroup (Fin n) ℂ) ∈ S :=
    connectedComponentIn_nonempty_iff.mp ⟨x, hx⟩
  have hsub : (fun g => x * g) '' C ⊆ connectedComponentIn S x :=
    himg.subset_connectedComponentIn ⟨1, mem_connectedComponentIn h1S, mul_one x⟩
      (by rintro _ ⟨g, hg, rfl⟩; exact hS x hxS g (hCS hg))
  rw [← connectedComponentIn_eq hx] at hsub
  exact hsub ⟨y, hy, rfl⟩

/-! ## An adapted basis -/

section Adapted

open Matrix

variable {m : ℕ} (Jm Ω P : Matrix (Fin n) (Fin n) ℂ) (α : ℂ)

/-- The bilinear form of a Gram matrix. -/
def g2k_B (x y : Fin n → ℂ) : ℂ := x ⬝ᵥ (Ω *ᵥ y)

theorem g2k_B_skew (hskew : Matrix.transpose Jm * Ω = -(Ω * Jm)) (x y : Fin n → ℂ) :
    g2k_B Ω (Jm *ᵥ x) y = -g2k_B Ω x (Jm *ᵥ y) := by
  rw [g2k_B, g2k_B, dotProduct_comm, Matrix.dotProduct_mulVec, ← Matrix.mulVec_transpose,
    Matrix.mulVec_mulVec, hskew, Matrix.neg_mulVec, ← Matrix.mulVec_mulVec, neg_dotProduct,
    dotProduct_comm]

theorem g2k_B_smul_left (c : ℂ) (x y : Fin n → ℂ) : g2k_B Ω (c • x) y = c * g2k_B Ω x y := by
  simp [g2k_B, smul_dotProduct]

theorem g2k_B_smul_right (c : ℂ) (x y : Fin n → ℂ) : g2k_B Ω x (c • y) = c * g2k_B Ω x y := by
  simp [g2k_B, Matrix.mulVec_smul, dotProduct_smul]

theorem g2k_B_add_left (x x' y : Fin n → ℂ) : g2k_B Ω (x + x') y = g2k_B Ω x y + g2k_B Ω x' y := by
  simp [g2k_B, add_dotProduct]

theorem g2k_B_alt (halt : Matrix.transpose Ω = -Ω) (x y : Fin n → ℂ) :
    g2k_B Ω y x = -g2k_B Ω x y := by
  rw [g2k_B, g2k_B, Matrix.dotProduct_mulVec, ← Matrix.mulVec_transpose, halt, Matrix.neg_mulVec,
    neg_dotProduct, dotProduct_comm]

/-- Vectors in an eigenspace of a skew `J` with a nonzero eigenvalue are isotropic. -/
theorem g2k_B_isotropic (hskew : Matrix.transpose Jm * Ω = -(Ω * Jm)) {β : ℂ} (hβ : β ≠ 0)
    {x y : Fin n → ℂ} (hx : Jm *ᵥ x = β • x) (hy : Jm *ᵥ y = β • y) : g2k_B Ω x y = 0 := by
  have h := g2k_B_skew Jm Ω hskew x y
  rw [hx, hy, g2k_B_smul_left, g2k_B_smul_right] at h
  have h2 : (2 * β) * g2k_B Ω x y = 0 := by linear_combination h
  rcases mul_eq_zero.mp h2 with h3 | h3
  · exact absurd ((mul_eq_zero.mp h3).resolve_left two_ne_zero) hβ
  · exact h3

theorem g2k_one_sub_mul_self (hP : P * P = P) : (1 - P) * (1 - P) = 1 - P := by
  rw [mul_sub, sub_mul, sub_mul, hP]
  simp

theorem g2k_finrank_range (Q : Matrix (Fin n) (Fin n) ℂ) (hQ : Q * Q = Q) (h : Q.trace = m) :
    Module.finrank ℂ (LinearMap.range (Matrix.toLin' Q)) = m := by
  have hqq : Matrix.toLin' Q * Matrix.toLin' Q = Matrix.toLin' Q := by
    rw [Module.End.mul_eq_comp, ← Matrix.toLin'_mul, hQ]
  have h1 := ((LinearMap.isProj_range_iff_isIdempotentElem _).mpr hqq).trace
  rw [LinearMap.trace_eq_matrix_trace ℂ (Pi.basisFun ℂ (Fin n)), LinearMap.toMatrix_eq_toMatrix',
    LinearMap.toMatrix'_toLin', h] at h1
  exact_mod_cast h1.symm

theorem g2k_transpose_mul_mul_apply {ι κ : Type*} (X : Matrix (Fin n) ι ℂ)
    (Y : Matrix (Fin n) κ ℂ) (c : ι) (c' : κ) :
    (Matrix.transpose X * Ω * Y) c c' = g2k_B Ω (fun r => X r c) (fun r => Y r c') := by
  simp only [Matrix.mul_apply, Matrix.transpose_apply, g2k_B, dotProduct, Matrix.mulVec,
    Finset.sum_mul, Finset.mul_sum]
  rw [Finset.sum_comm]
  simp only [mul_assoc]

/-- **An adapted basis.** -/
theorem g2k_exists_adapted (hP : P * P = P) (hJP : Jm * P = α • P)
    (hJQ : Jm * (1 - P) = (-α) • (1 - P)) (hα : α ≠ 0)
    (hskew : Matrix.transpose Jm * Ω = -(Ω * Jm)) (halt : Matrix.transpose Ω = -Ω)
    (hΩ : Ω.det ≠ 0) (htrP : P.trace = m) (htrQ : (1 - P).trace = m) (hn : n = m + m) :
    ∃ (S : Matrix (Fin n) (Fin m ⊕ Fin m) ℂ) (T : Matrix (Fin m ⊕ Fin m) (Fin n) ℂ),
      T * S = 1 ∧ S * T = 1 ∧
      P * S = S * (Matrix.fromBlocks (1 : Matrix (Fin m) (Fin m) ℂ) 0 0 0 :
        Matrix (Fin m ⊕ Fin m) (Fin m ⊕ Fin m) ℂ) ∧
      Matrix.transpose S * Ω * S = (Matrix.fromBlocks 0 (1 : Matrix (Fin m) (Fin m) ℂ) (-1) 0 :
        Matrix (Fin m ⊕ Fin m) (Fin m ⊕ Fin m) ℂ) := by
  classical
  set Vp := LinearMap.range (Matrix.toLin' P)
  set Vm := LinearMap.range (Matrix.toLin' (1 - P))
  have hQ := g2k_one_sub_mul_self P hP
  have hfinp := g2k_finrank_range P hP htrP
  have hfinm := g2k_finrank_range (1 - P) hQ htrQ
  have hPv : ∀ v ∈ Vp, P *ᵥ v = v := by
    rintro _ ⟨u, rfl⟩
    rw [Matrix.toLin'_apply, Matrix.mulVec_mulVec, hP]
  have hPw : ∀ w ∈ Vm, P *ᵥ w = 0 := by
    rintro _ ⟨u, rfl⟩
    rw [Matrix.toLin'_apply, Matrix.mulVec_mulVec, mul_sub, mul_one, hP, sub_self,
      Matrix.zero_mulVec]
  have hJv : ∀ v ∈ Vp, Jm *ᵥ v = α • v := by
    rintro _ ⟨u, rfl⟩
    rw [Matrix.toLin'_apply, Matrix.mulVec_mulVec, hJP, Matrix.smul_mulVec]
  have hJw : ∀ w ∈ Vm, Jm *ᵥ w = (-α) • w := by
    rintro _ ⟨u, rfl⟩
    rw [Matrix.toLin'_apply, Matrix.mulVec_mulVec, hJQ, Matrix.smul_mulVec]
  have isoP : ∀ x ∈ Vp, ∀ y ∈ Vp, g2k_B Ω x y = 0 := fun x hx y hy =>
    g2k_B_isotropic Jm Ω hskew hα (hJv x hx) (hJv y hy)
  have isoM : ∀ x ∈ Vm, ∀ y ∈ Vm, g2k_B Ω x y = 0 := fun x hx y hy =>
    g2k_B_isotropic Jm Ω hskew (neg_ne_zero.mpr hα) (hJw x hx) (hJw y hy)
  let Bf : (Fin n → ℂ) →ₗ[ℂ] (Fin n → ℂ) →ₗ[ℂ] ℂ := Matrix.toBilin' Ω
  have hBf : ∀ x y, Bf x y = g2k_B Ω x y := fun x y => Matrix.toBilin'_apply' Ω x y
  let β : Vm →ₗ[ℂ] Module.Dual ℂ Vp :=
    (LinearMap.lcomp ℂ ℂ Vp.subtype) ∘ₗ Bf.flip ∘ₗ Vm.subtype
  have hβ : ∀ (y : Vm) (x : Vp), β y x = g2k_B Ω x y := fun y x => hBf x y
  have hinj : Function.Injective β := by
    rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
    intro y hy
    have hall : ∀ x, g2k_B Ω x y = 0 := by
      intro x
      have hx : x = P *ᵥ x + (1 - P) *ᵥ x := by
        rw [← Matrix.add_mulVec, add_sub_cancel, Matrix.one_mulVec]
      rw [hx, g2k_B_add_left]
      have h1 : g2k_B Ω (P *ᵥ x) y = 0 := by
        have := congrArg (fun φ : Module.Dual ℂ Vp => φ ⟨P *ᵥ x, x, rfl⟩) hy
        simpa [hβ] using this
      rw [h1, zero_add]
      exact isoM _ ⟨x, rfl⟩ _ y.2
    have hΩy : Ω *ᵥ (y : Fin n → ℂ) = 0 := by
      funext i
      have := hall (Pi.single i 1)
      simpa [g2k_B, single_dotProduct] using this
    exact Subtype.ext (Matrix.eq_zero_of_mulVec_eq_zero hΩ hΩy)
  have hdim : Module.finrank ℂ Vm = Module.finrank ℂ (Module.Dual ℂ Vp) := by
    rw [Subspace.dual_finrank_eq, hfinp, hfinm]
  let βe := LinearMap.linearEquivOfInjective β hinj hdim
  let e : Module.Basis (Fin m) ℂ Vp := Module.finBasisOfFinrankEq ℂ Vp hfinp
  let f : Fin m → Vm := fun j => βe.symm (e.coord j)
  have hef : ∀ i j, g2k_B Ω (e i) (f j) = if i = j then 1 else 0 := by
    intro i j
    have h1 : β (f j) = e.coord j := βe.apply_symm_apply (e.coord j)
    rw [← hβ, h1, Module.Basis.coord_apply, Module.Basis.repr_self, Finsupp.single_apply]
  let S : Matrix (Fin n) (Fin m ⊕ Fin m) ℂ := Matrix.of fun r c =>
    Sum.elim (fun i => (e i : Fin n → ℂ) r) (fun j => (f j : Fin n → ℂ) r) c
  let T : Matrix (Fin m ⊕ Fin m) (Fin n) ℂ := Matrix.of fun c r =>
    Sum.elim (fun k => (Ω *ᵥ (f k : Fin n → ℂ)) r) (fun k => ((e k : Fin n → ℂ) ᵥ* Ω) r) c
  have hTS : T * S = 1 := by
    ext c c'
    rw [Matrix.mul_apply]
    rcases c with k | k <;> rcases c' with i | j
    · change (Ω *ᵥ (f k : Fin n → ℂ)) ⬝ᵥ (e i : Fin n → ℂ) = _
      rw [dotProduct_comm]
      change g2k_B Ω (e i) (f k) = _
      rw [hef, Matrix.one_apply]
      simp [eq_comm]
    · change (Ω *ᵥ (f k : Fin n → ℂ)) ⬝ᵥ (f j : Fin n → ℂ) = _
      rw [dotProduct_comm]
      change g2k_B Ω (f j) (f k) = _
      rw [isoM _ (f j).2 _ (f k).2]
      simp
    · change ((e k : Fin n → ℂ) ᵥ* Ω) ⬝ᵥ (e i : Fin n → ℂ) = _
      rw [← Matrix.dotProduct_mulVec]
      change g2k_B Ω (e k) (e i) = _
      rw [isoP _ (e k).2 _ (e i).2]
      simp
    · change ((e k : Fin n → ℂ) ᵥ* Ω) ⬝ᵥ (f j : Fin n → ℂ) = _
      rw [← Matrix.dotProduct_mulVec]
      change g2k_B Ω (e k) (f j) = _
      rw [hef, Matrix.one_apply]
      simp
  have hST : S * T = 1 :=
    (Matrix.mul_eq_one_comm_of_equiv (finSumFinEquiv.trans (finCongr hn.symm))).mp hTS
  refine ⟨S, T, hTS, hST, ?_, ?_⟩
  · ext r c
    rw [Matrix.mul_apply]
    rcases c with i | j
    · change (P *ᵥ (e i : Fin n → ℂ)) r = _
      rw [hPv _ (e i).2, Matrix.mul_apply, Fintype.sum_sum_type]
      simp [Matrix.one_apply, S]
    · change (P *ᵥ (f j : Fin n → ℂ)) r = _
      rw [hPw _ (f j).2, Matrix.mul_apply, Fintype.sum_sum_type]
      simp [S]
  · ext c c'
    rw [g2k_transpose_mul_mul_apply]
    rcases c with i | j <;> rcases c' with i' | j'
    · change g2k_B Ω (e i) (e i') = _
      rw [isoP _ (e i).2 _ (e i').2]
      simp
    · change g2k_B Ω (e i) (f j') = _
      rw [hef]
      simp [Matrix.one_apply]
    · change g2k_B Ω (f j) (e i') = _
      rw [g2k_B_alt Ω halt, hef]
      simp [Matrix.one_apply, eq_comm]
    · change g2k_B Ω (f j) (f j') = _
      rw [isoM _ (f j).2 _ (f j').2]
      simp

end Adapted

/-! ## `G_k` in the adapted frame -/

section Frame

variable {m : ℕ}

/-- The block diagonal matrix `diag (A, B)`. -/
def g2k_blk (A B : Matrix (Fin m) (Fin m) ℂ) : Matrix (Fin m ⊕ Fin m) (Fin m ⊕ Fin m) ℂ :=
  Matrix.fromBlocks A 0 0 B

/-- The standard alternating Gram matrix `[[0, 1], [-1, 0]]`. -/
def g2k_K (m : ℕ) : Matrix (Fin m ⊕ Fin m) (Fin m ⊕ Fin m) ℂ :=
  Matrix.fromBlocks 0 1 (-1) 0

theorem g2k_blk_mul (A B A' B' : Matrix (Fin m) (Fin m) ℂ) :
    g2k_blk A B * g2k_blk A' B' = g2k_blk (A * A') (B * B') := by
  simp [g2k_blk, Matrix.fromBlocks_multiply]

theorem g2k_blk_one : g2k_blk (1 : Matrix (Fin m) (Fin m) ℂ) 1 = 1 := Matrix.fromBlocks_one

theorem g2k_blk_add (A B A' B' : Matrix (Fin m) (Fin m) ℂ) :
    g2k_blk A B + g2k_blk A' B' = g2k_blk (A + A') (B + B') := by
  simp [g2k_blk, Matrix.fromBlocks_add]

theorem g2k_blk_sub_one (A B : Matrix (Fin m) (Fin m) ℂ) :
    1 - g2k_blk A B = g2k_blk (1 - A) (1 - B) := by
  rw [← g2k_blk_one, g2k_blk, g2k_blk, g2k_blk, sub_eq_add_neg, Matrix.fromBlocks_neg,
    Matrix.fromBlocks_add]
  simp [sub_eq_add_neg]

theorem g2k_blk_transpose (A B : Matrix (Fin m) (Fin m) ℂ) :
    Matrix.transpose (g2k_blk A B) = g2k_blk (Matrix.transpose A) (Matrix.transpose B) := by
  simp [g2k_blk, Matrix.fromBlocks_transpose]

theorem g2k_det_blk (A B : Matrix (Fin m) (Fin m) ℂ) : (g2k_blk A B).det = A.det * B.det := by
  simp [g2k_blk]

theorem g2k_blk_K_blk (A B : Matrix (Fin m) (Fin m) ℂ) :
    g2k_blk (Matrix.transpose A) (Matrix.transpose B) * g2k_K m * g2k_blk A B =
      Matrix.fromBlocks 0 (Matrix.transpose A * B) (-(Matrix.transpose B * A)) 0 := by
  simp [g2k_blk, g2k_K, Matrix.fromBlocks_multiply]

variable (S : Matrix (Fin n) (Fin m ⊕ Fin m) ℂ) (T : Matrix (Fin m ⊕ Fin m) (Fin n) ℂ)

theorem g2k_frame_mul (hTS : T * S = 1) (X Y : Matrix (Fin m ⊕ Fin m) (Fin m ⊕ Fin m) ℂ) :
    S * X * T * (S * Y * T) = S * (X * Y) * T := by
  simp only [Matrix.mul_assoc]
  rw [← Matrix.mul_assoc T S, hTS, Matrix.one_mul]

theorem g2k_frame_conj (hST : S * T = 1) (g : Matrix (Fin n) (Fin n) ℂ) :
    S * (T * g * S) * T = g := by
  simp only [Matrix.mul_assoc]
  rw [hST, Matrix.mul_one, ← Matrix.mul_assoc, hST, Matrix.one_mul]

theorem g2k_frame_det (hTS : T * S = 1) (hST : S * T = 1) (g : Matrix (Fin n) (Fin n) ℂ) :
    (T * g * S).det = g.det :=
  Matrix.det_conj_of_mul_eq_one hTS hST

theorem g2k_frame_transpose (hTS : T * S = 1) (X : Matrix (Fin m ⊕ Fin m) (Fin m ⊕ Fin m) ℂ)
    (K : Matrix (Fin m ⊕ Fin m) (Fin m ⊕ Fin m) ℂ) :
    Matrix.transpose (S * X * T) * (Matrix.transpose T * K * T) * (S * X * T) =
      Matrix.transpose T * (Matrix.transpose X * K * X) * T := by
  have h : Matrix.transpose S * Matrix.transpose T = 1 := by
    rw [← Matrix.transpose_mul, hTS, Matrix.transpose_one]
  simp only [Matrix.transpose_mul, Matrix.mul_assoc]
  rw [← Matrix.mul_assoc (Matrix.transpose S) (Matrix.transpose T), h, Matrix.one_mul,
    ← Matrix.mul_assoc T S, hTS, Matrix.one_mul]

theorem g2k_frame_affine (hTS : T * S = 1) (hST : S * T = 1)
    (X Y : Matrix (Fin m ⊕ Fin m) (Fin m ⊕ Fin m) ℂ) :
    S * X * T * (S * Y * T) + (1 - S * Y * T) = S * (X * Y + (1 - Y)) * T := by
  rw [g2k_frame_mul S T hTS, ← hST]
  simp only [Matrix.mul_add, Matrix.add_mul, Matrix.mul_sub, Matrix.sub_mul, Matrix.mul_one]

theorem g2k_frame_det' (hTS : T * S = 1) (hST : S * T = 1)
    (X : Matrix (Fin m ⊕ Fin m) (Fin m ⊕ Fin m) ℂ) : (S * X * T).det = X.det := by
  rw [← g2k_frame_det S T hTS hST]
  congr 1
  simp only [Matrix.mul_assoc]
  rw [hTS, Matrix.mul_one, ← Matrix.mul_assoc, hTS, Matrix.one_mul]

theorem g2k_frame_one_sub (hST : S * T = 1) (Y : Matrix (Fin m ⊕ Fin m) (Fin m ⊕ Fin m) ℂ) :
    1 - S * Y * T = S * (1 - Y) * T := by
  rw [Matrix.mul_sub, Matrix.sub_mul, Matrix.mul_one, hST]

theorem g2k_frame_affine2 (hTS : T * S = 1) (hST : S * T = 1)
    (X Y : Matrix (Fin m ⊕ Fin m) (Fin m ⊕ Fin m) ℂ) :
    S * X * T * (1 - S * Y * T) + S * Y * T = S * (X * (1 - Y) + Y) * T := by
  have h : 1 - S * Y * T = S * (1 - Y) * T := by
    rw [Matrix.mul_sub, Matrix.sub_mul, Matrix.mul_one, hST]
  rw [h, g2k_frame_mul S T hTS, ← Matrix.add_mul, ← Matrix.mul_add]

variable (Jm Ω P : Matrix (Fin n) (Fin n) ℂ) (α : ℂ)

/-- **The parametrization lands in the equations of `G_k`.** -/
theorem g2k_frame_conds (hTS : T * S = 1) (hST : S * T = 1)
    (hJm : Jm = S * g2k_blk (α • (1 : Matrix (Fin m) (Fin m) ℂ))
      ((-α) • (1 : Matrix (Fin m) (Fin m) ℂ)) * T)
    (hΩ : Ω = Matrix.transpose T * g2k_K m * T) (hPf : P = S * g2k_blk (m := m) 1 0 * T)
    (A : Matrix (Fin m) (Fin m) ℂ) (hA : A.det = 1) :
    (S * g2k_blk A (Matrix.transpose A⁻¹) * T) * Jm =
        Jm * (S * g2k_blk A (Matrix.transpose A⁻¹) * T) ∧
      Matrix.transpose (S * g2k_blk A (Matrix.transpose A⁻¹) * T) * Ω *
          (S * g2k_blk A (Matrix.transpose A⁻¹) * T) = Ω ∧
      ((S * g2k_blk A (Matrix.transpose A⁻¹) * T) * P + (1 - P)).det = 1 ∧
      ((S * g2k_blk A (Matrix.transpose A⁻¹) * T) * (1 - P) + P).det = 1 := by
  have hAu : IsUnit A.det := by rw [hA]; exact isUnit_one
  have hinv : A⁻¹ * A = 1 := Matrix.nonsing_inv_mul A hAu
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [hJm, g2k_frame_mul S T hTS, g2k_frame_mul S T hTS, g2k_blk_mul, g2k_blk_mul]
    simp [Matrix.mul_smul, Matrix.smul_mul]
  · rw [hΩ, g2k_frame_transpose S T hTS, g2k_blk_transpose, g2k_blk_K_blk,
      ← Matrix.transpose_mul, hinv, Matrix.transpose_one, Matrix.transpose_transpose, hinv]
    rfl
  · rw [hPf, g2k_frame_affine S T hTS hST, g2k_frame_det' S T hTS hST, g2k_blk_mul,
      g2k_blk_sub_one, g2k_blk_add, g2k_det_blk]
    simp [hA]
  · rw [hPf, g2k_frame_affine2 S T hTS hST, g2k_frame_det' S T hTS hST, g2k_blk_sub_one,
      g2k_blk_mul, g2k_blk_add, g2k_det_blk]
    simp [Matrix.det_transpose, Matrix.det_nonsing_inv, hA]

theorem g2k_frame_inner (hTS : T * S = 1) (Y : Matrix (Fin m ⊕ Fin m) (Fin m ⊕ Fin m) ℂ) :
    T * (S * Y * T) * S = Y := by
  simp only [Matrix.mul_assoc]
  rw [hTS, Matrix.mul_one, ← Matrix.mul_assoc, hTS, Matrix.one_mul]

/-- **Every point of `G_k` is `diag (A, A⁻ᵀ)` in the adapted frame**, with `det A = 1`. -/
theorem g2k_frame_exists (hTS : T * S = 1) (hST : S * T = 1)
    (hΩ : Ω = Matrix.transpose T * g2k_K m * T) (hPf : P = S * g2k_blk (m := m) 1 0 * T)
    (g : Matrix (Fin n) (Fin n) ℂ) (hgP : g * P = P * g)
    (hiso : Matrix.transpose g * Ω * g = Ω) (hdet : (g * P + (1 - P)).det = 1) :
    ∃ A : Matrix (Fin m) (Fin m) ℂ, A.det = 1 ∧
      g = S * g2k_blk A (Matrix.transpose A⁻¹) * T := by
  set M := T * g * S with hMdef
  have hg : g = S * M * T := (g2k_frame_conj S T hST g).symm
  have hY : T * P * S = g2k_blk 1 0 := by rw [hPf]; exact g2k_frame_inner S T hTS _
  have e1 : M * (T * P * S) = T * (g * P) * S := by
    simp only [hMdef, Matrix.mul_assoc]
    rw [← Matrix.mul_assoc S T, hST, Matrix.one_mul]
  have e2 : (T * P * S) * M = T * (P * g) * S := by
    simp only [hMdef, Matrix.mul_assoc]
    rw [← Matrix.mul_assoc S T, hST, Matrix.one_mul]
  have hMY : M * g2k_blk 1 0 = g2k_blk 1 0 * M := by rw [← hY, e1, e2, hgP]
  have hM := (Matrix.fromBlocks_toBlocks M).symm
  set A := M.toBlocks₁₁
  set D := M.toBlocks₂₂
  have hBC : M.toBlocks₁₂ = 0 ∧ M.toBlocks₂₁ = 0 := by
    rw [hM] at hMY
    simp only [g2k_blk, Matrix.fromBlocks_multiply] at hMY
    simp only [Matrix.mul_one, Matrix.mul_zero, add_zero, Matrix.one_mul, Matrix.zero_mul,
      zero_add] at hMY
    obtain ⟨-, h2, h3, -⟩ := Matrix.fromBlocks_inj.mp hMY
    exact ⟨h2.symm, h3⟩
  have hMblk : M = g2k_blk A D := by rw [hM, hBC.1, hBC.2]; rfl
  have hK : Matrix.transpose S * Ω * S = g2k_K m := by
    rw [hΩ]
    have h : Matrix.transpose S * Matrix.transpose T = 1 := by
      rw [← Matrix.transpose_mul, hTS, Matrix.transpose_one]
    simp only [Matrix.mul_assoc]
    rw [hTS, Matrix.mul_one, ← Matrix.mul_assoc, h, Matrix.one_mul]
  have hMK : Matrix.transpose M * g2k_K m * M = g2k_K m := by
    have h : Matrix.transpose M * g2k_K m * M = Matrix.transpose S *
        (Matrix.transpose g * (Matrix.transpose T * g2k_K m * T) * g) * S := by
      rw [hMdef]
      simp only [Matrix.transpose_mul, Matrix.mul_assoc]
    rw [h, ← hΩ, hiso, hK]
  have hAD : Matrix.transpose A * D = 1 := by
    rw [hMblk, g2k_blk_transpose, g2k_blk_K_blk, g2k_K] at hMK
    exact (Matrix.fromBlocks_inj.mp hMK).2.1
  have hdetA : A.det = 1 := by
    rw [hg, hPf, g2k_frame_affine S T hTS hST, g2k_frame_det' S T hTS hST, hMblk, g2k_blk_mul,
      g2k_blk_sub_one, g2k_blk_add, g2k_det_blk] at hdet
    simpa using hdet
  have hD : D = Matrix.transpose A⁻¹ := by
    rw [Matrix.transpose_nonsing_inv]
    exact (Matrix.inv_eq_right_inv hAD).symm
  exact ⟨A, hdetA, by rw [hg, hMblk, hD]⟩

/-- The parametrization `A ↦ S diag (A, A⁻ᵀ) T`. -/
def g2k_Phi (A : Matrix (Fin m) (Fin m) ℂ) : Matrix (Fin n) (Fin n) ℂ :=
  S * g2k_blk A (Matrix.transpose A⁻¹) * T

theorem g2k_Phi_mul (hTS : T * S = 1) (A B : Matrix (Fin m) (Fin m) ℂ) :
    g2k_Phi S T (A * B) = g2k_Phi S T A * g2k_Phi S T B := by
  rw [g2k_Phi, g2k_Phi, g2k_Phi, g2k_frame_mul S T hTS, g2k_blk_mul, Matrix.mul_inv_rev,
    Matrix.transpose_mul]

theorem g2k_Phi_one (hST : S * T = 1) : g2k_Phi S T (1 : Matrix (Fin m) (Fin m) ℂ) = 1 := by
  rw [g2k_Phi, inv_one, Matrix.transpose_one, g2k_blk_one, Matrix.mul_one, hST]

/-- `g2k_Phi` as an invertible matrix, for `det A = 1`. -/
def g2k_PhiGL (hTS : T * S = 1) (hST : S * T = 1) (A : Matrix (Fin m) (Fin m) ℂ)
    (hA : A.det = 1) : Matrix.GeneralLinearGroup (Fin n) ℂ where
  val := g2k_Phi S T A
  inv := g2k_Phi S T A⁻¹
  val_inv := by
    rw [← g2k_Phi_mul S T hTS, Matrix.mul_nonsing_inv A (by rw [hA]; exact isUnit_one),
      g2k_Phi_one S T hST]
  inv_val := by
    rw [← g2k_Phi_mul S T hTS, Matrix.nonsing_inv_mul A (by rw [hA]; exact isUnit_one),
      g2k_Phi_one S T hST]

theorem g2k_coe_PhiGL (hTS : T * S = 1) (hST : S * T = 1) (A : Matrix (Fin m) (Fin m) ℂ)
    (hA : A.det = 1) : (g2k_PhiGL S T hTS hST A hA : Matrix (Fin n) (Fin n) ℂ) = g2k_Phi S T A :=
  rfl

theorem g2k_continuous_single (i j : Fin m) {f : ℂ → ℂ} (hf : Continuous f) :
    Continuous fun s => (Matrix.single i j (f s) : Matrix (Fin m) (Fin m) ℂ) := by
  refine continuous_pi fun a => continuous_pi fun b => ?_
  simp only [Matrix.single_apply]
  split_ifs
  · exact hf
  · exact continuous_const

theorem g2k_prod_two {i i₀ : Fin m} (h : i ≠ i₀) (a b : ℂ) :
    ∏ k, (if k = i then a else if k = i₀ then b else 1) = a * b := by
  classical
  rw [← Finset.mul_prod_erase Finset.univ _ (Finset.mem_univ i), if_pos rfl]
  congr 1
  rw [Finset.prod_congr rfl fun k hk => if_neg (Finset.ne_of_mem_erase hk),
    Finset.prod_ite_eq' (Finset.univ.erase i) i₀, if_pos (Finset.mem_erase.mpr ⟨h.symm,
      Finset.mem_univ _⟩)]

set_option warn.classDefReducibility false in
attribute [local instance] g1_zariski in
/-- **Connectedness from the parametrization.** A set `G` closed under products, containing the
image of `SL_m` under `g2k_Phi` and covered by it, is Zariski connected. -/
theorem g2k_frame_isConnected (hTS : T * S = 1) (hST : S * T = 1)
    (G : Set (Matrix.GeneralLinearGroup (Fin n) ℂ))
    (hmem : ∀ (A : Matrix (Fin m) (Fin m) ℂ) (hA : A.det = 1), g2k_PhiGL S T hTS hST A hA ∈ G)
    (hcov : ∀ g ∈ G, ∃ A : Matrix (Fin m) (Fin m) ℂ, A.det = 1 ∧
      (g : Matrix (Fin n) (Fin n) ℂ) = g2k_Phi S T A)
    (hmul : ∀ x ∈ G, ∀ y ∈ G, x * y ∈ G) : IsConnected G := by
  classical
  set C := connectedComponentIn G 1
  let Pr : Matrix (Fin m) (Fin m) ℂ → Prop := fun A =>
    A.det = 1 ∧ ∀ g : Matrix.GeneralLinearGroup (Fin n) ℂ,
      (g : Matrix (Fin n) (Fin n) ℂ) = g2k_Phi S T A → g ∈ C
  have hPrmul : ∀ A B, Pr A → Pr B → Pr (A * B) := by
    rintro A B ⟨hA, hA'⟩ ⟨hB, hB'⟩
    refine ⟨by rw [Matrix.det_mul, hA, hB, mul_one], fun g hg => ?_⟩
    have h1 := hA' (g2k_PhiGL S T hTS hST A hA) rfl
    have h2 := hB' (g2k_PhiGL S T hTS hST B hB) rfl
    have : g = g2k_PhiGL S T hTS hST A hA * g2k_PhiGL S T hTS hST B hB := by
      ext1
      rw [hg, Units.val_mul, g2k_coe_PhiGL, g2k_coe_PhiGL, g2k_Phi_mul S T hTS]
    rw [this]
    exact g2k_component_mul G hmul h1 h2
  have hcurve : ∀ {X : Type} [TopologicalSpace X] [ConnectedSpace X]
      (c : X → Matrix (Fin m) (Fin m) ℂ) (hdet : ∀ x, (c x).det = 1) (hc : Continuous c)
      (hc' : Continuous fun x => (c x)⁻¹) (x₀ x₁ : X) (h₀ : c x₀ = 1), Pr (c x₁) := by
    intro X _ _ c hdet hc hc' x₀ x₁ h₀
    refine ⟨hdet x₁, fun g hg => ?_⟩
    have hcont : Continuous fun x => g2k_Phi S T (c x) :=
      (continuous_const.matrix_mul (Continuous.matrix_fromBlocks hc continuous_const
        continuous_const hc'.matrix_transpose)).matrix_mul continuous_const
    have h := g2k_mem_component_of_curve G (fun x => g2k_PhiGL S T hTS hST (c x) (hdet x))
      (fun i j => (continuous_apply j).comp ((continuous_apply i).comp hcont))
      (fun x => hmem _ _) x₀ x₁ (by ext1; rw [g2k_coe_PhiGL, h₀, g2k_Phi_one S T hST]; rfl)
    have : g = g2k_PhiGL S T hTS hST (c x₁) (hdet x₁) := by ext1; rw [hg]; rfl
    rw [this]
    exact h
  have hPr1 : Pr 1 := by
    refine hcurve (X := Unit) (fun _ => 1) (fun _ => Matrix.det_one) continuous_const
      (by simp only [inv_one]; exact continuous_const) () () rfl
  have htrans : ∀ t : Matrix.TransvectionStruct (Fin m) ℂ, Pr t.toMatrix := by
    intro t
    have hinv : ∀ s : ℂ, (Matrix.transvection t.i t.j (s * t.c))⁻¹ =
        Matrix.transvection t.i t.j (-(s * t.c)) := fun s =>
      Matrix.inv_eq_right_inv (by
        rw [Matrix.transvection_mul_transvection_same _ _ t.hij, add_neg_cancel,
          Matrix.transvection_zero])
    have h := hcurve (X := ℂ) (fun s => Matrix.transvection t.i t.j (s * t.c))
      (fun s => Matrix.det_transvection_of_ne _ _ t.hij _)
      (by
        unfold Matrix.transvection
        exact continuous_const.add (g2k_continuous_single _ _ (continuous_id.mul continuous_const)))
      (by
        simp_rw [hinv]
        unfold Matrix.transvection
        exact continuous_const.add
          (g2k_continuous_single _ _ (continuous_id.mul continuous_const).neg))
      0 1 (by simp [Matrix.transvection_zero])
    simpa [Matrix.TransvectionStruct.toMatrix] using h
  have hdiag : ∀ D : Fin m → ℂ, (Matrix.diagonal D).det = 1 → Pr (Matrix.diagonal D) := by
    intro D hD
    rw [Matrix.det_diagonal] at hD
    rcases Nat.eq_zero_or_pos m with hm | hm
    · subst hm
      have : Matrix.diagonal D = 1 := by
        ext i
        exact i.elim0
      rw [this]
      exact hPr1
    · let i₀ : Fin m := ⟨0, hm⟩
      have hDne : ∀ i, D i ≠ 0 := fun i h => by
        have := Finset.prod_eq_zero (Finset.mem_univ i) h
        rw [hD] at this
        exact one_ne_zero this
      let d : Fin m → Fin m → ℂ := fun i k =>
        if k = i then D i else if k = i₀ then (D i)⁻¹ else 1
      have hprod : D = ∏ i ∈ Finset.univ.erase i₀, d i := by
        funext k
        rw [Finset.prod_apply]
        by_cases hk : k = i₀
        · rw [Finset.prod_congr rfl fun i hi => (show d i k = (D i)⁻¹ by
            simp only [d, hk, if_neg (Ne.symm (Finset.ne_of_mem_erase hi)), if_true])]
          rw [Finset.prod_inv_distrib, hk]
          have h1 := Finset.mul_prod_erase Finset.univ D (Finset.mem_univ i₀)
          rw [hD] at h1
          exact eq_inv_of_mul_eq_one_left h1
        · rw [Finset.prod_congr rfl fun i _ => (show d i k = if k = i then D i else 1 by
            simp only [d, if_neg hk])]
          rw [Finset.prod_ite_eq (Finset.univ.erase i₀) k (fun i => D i),
            if_pos (Finset.mem_erase.mpr ⟨hk, Finset.mem_univ _⟩)]
      rw [hprod]
      refine Finset.prod_induction _ (fun f => Pr (Matrix.diagonal f))
        (fun f g hf hg => by
          rw [show f * g = fun k => f k * g k from rfl, ← Matrix.diagonal_mul_diagonal]
          exact hPrmul _ _ hf hg)
        (by
          have h1 : Matrix.diagonal (1 : Fin m → ℂ) = 1 := Matrix.diagonal_one
          rw [h1]
          exact hPr1) fun i hi => ?_
      have hi0 : i ≠ i₀ := Finset.ne_of_mem_erase hi
      let w := Complex.log (D i)
      let v : ℂ → Fin m → ℂ := fun s k =>
        if k = i then Complex.exp (s * w) else if k = i₀ then Complex.exp (-(s * w)) else 1
      have hvv : ∀ s, Matrix.diagonal (v s) * Matrix.diagonal (v (-s)) = 1 := by
        intro s
        rw [Matrix.diagonal_mul_diagonal, ← Matrix.diagonal_one]
        congr 1
        funext k
        simp only [v, Pi.one_apply]
        split_ifs <;> simp [← Complex.exp_add]
      have hcont : ∀ (σ : ℂ), Continuous fun s : ℂ => v (σ * s) := by
        intro σ
        refine continuous_pi fun k => ?_
        simp only [v]
        split_ifs
        · fun_prop
        · fun_prop
        · exact continuous_const
      have h := hcurve (X := ℂ) (fun s => Matrix.diagonal (v s))
        (fun s => by rw [Matrix.det_diagonal]; simp only [v]; rw [g2k_prod_two hi0,
          ← Complex.exp_add, add_neg_cancel, Complex.exp_zero])
        (by simpa using (hcont 1).matrix_diagonal)
        (by
          simp_rw [fun s => Matrix.inv_eq_right_inv (hvv s)]
          simpa using (hcont (-1)).matrix_diagonal)
        0 1 (by
          rw [← Matrix.diagonal_one]
          congr 1
          funext k
          simp only [v, zero_mul, neg_zero, Complex.exp_zero, Pi.one_apply]
          split_ifs <;> rfl)
      have hv1 : v 1 = d i := by
        funext k
        simp only [v, d, one_mul, Complex.exp_neg, Complex.exp_log (hDne i), w]
      simpa [hv1] using h
  have hall : ∀ A : Matrix (Fin m) (Fin m) ℂ, A.det = 1 → Pr A := fun A hA =>
    Matrix.diagonal_transvection_induction Pr A (fun D hD => hdiag D (hD.trans hA)) htrans hPrmul
  have hGC : G ⊆ C := fun g hg => by
    obtain ⟨A, hA, hgA⟩ := hcov g hg
    exact (hall A hA).2 g hgA
  have h1G : (1 : Matrix.GeneralLinearGroup (Fin n) ℂ) ∈ G := by
    have h := hmem 1 Matrix.det_one
    have : g2k_PhiGL S T hTS hST 1 Matrix.det_one = 1 := by
      ext1
      rw [g2k_coe_PhiGL, g2k_Phi_one S T hST]
      rfl
    rwa [this] at h
  have hGeq : G = C := Set.Subset.antisymm hGC (connectedComponentIn_subset G 1)
  rw [hGeq]
  exact isConnected_connectedComponentIn_iff.mpr h1G

end Frame

/-! ## The corrected connectedness statement -/

section Glue

variable {V : Type*} [AddCommGroup V] [Module ℚ V] (b : Module.Basis (Fin n) ℚ V)
  (E : LinearMap.BilinForm ℚ V) (J : Module.End ℚ V)

theorem g2k_commute_adjoin (X : Matrix (Fin n) (Fin n) ℂ)
    (hX : X * g2k_Jm b J = g2k_Jm b J * X) :
    ∀ r ∈ Algebra.adjoin ℚ {J}, X * (LinearMap.toMatrix b b r).map (algebraMap ℚ ℂ) =
      (LinearMap.toMatrix b b r).map (algebraMap ℚ ℂ) * X := by
  intro r hr
  induction hr using Algebra.adjoin_induction with
  | mem x hx =>
    rw [Set.mem_singleton_iff] at hx
    subst hx
    exact hX
  | algebraMap q =>
    rw [LinearMap.toMatrix_algebraMap]
    have : (Matrix.scalar (Fin n) q).map (algebraMap ℚ ℂ) = (q : ℂ) • 1 := by
      ext i j
      simp only [Matrix.map_apply, Matrix.scalar_apply, Matrix.diagonal_apply, Matrix.smul_apply,
        Matrix.one_apply, smul_eq_mul]
      split_ifs <;> simp
    rw [this, Matrix.mul_smul, Matrix.smul_mul, mul_one, one_mul]
  | add x y _ _ hx hy =>
    rw [map_add, Matrix.map_add _ (map_add _), mul_add, add_mul, hx, hy]
  | mul x y _ _ hx hy =>
    rw [LinearMap.toMatrix_mul, Matrix.map_mul, ← mul_assoc, hx, mul_assoc, hy, mul_assoc]

theorem g2k_Jm_mul_P {d : ℚ} (hd : 0 < d) (hJ : J * J = (-d) • (1 : Module.End ℚ V)) :
    g2k_Jm b J * g2k_P b J d = ((d : ℂ) * g2k_c d) • g2k_P b J d := by
  have hJJ := g2k_Jm_mul_self b J hJ
  have h := g2k_c_sq_mul hd
  have lhs : g2k_Jm b J * g2k_P b J d =
      (g2k_c d / 2 * d) • (1 : Matrix (Fin n) (Fin n) ℂ) + (1 / 2 : ℂ) • g2k_Jm b J := by
    rw [g2k_P_eq, mul_add, Matrix.mul_smul, Matrix.mul_smul, mul_one, hJJ, smul_smul]
    module
  have rhs : ((d : ℂ) * g2k_c d) • g2k_P b J d =
      (g2k_c d / 2 * d) • (1 : Matrix (Fin n) (Fin n) ℂ) +
        ((d : ℂ) * g2k_c d * (-g2k_c d / 2)) • g2k_Jm b J := by
    rw [g2k_P_eq, smul_add, smul_smul, smul_smul]
    congr 2
    ring
  rw [lhs, rhs]
  congr 2
  linear_combination (1 / 2 : ℂ) * h

theorem g2k_Jm_mul_one_sub_P {d : ℚ} (hd : 0 < d) (hJ : J * J = (-d) • (1 : Module.End ℚ V)) :
    g2k_Jm b J * (1 - g2k_P b J d) = (-((d : ℂ) * g2k_c d)) • (1 - g2k_P b J d) := by
  have h := g2k_c_sq_mul hd
  have hJP := g2k_Jm_mul_P b J hd hJ
  have hJ2 : g2k_Jm b J = (2 * ((d : ℂ) * g2k_c d)) • g2k_P b J d -
      ((d : ℂ) * g2k_c d) • (1 : Matrix (Fin n) (Fin n) ℂ) := by
    rw [g2k_P_eq, smul_add, smul_smul, smul_smul]
    have e1 : 2 * ((d : ℂ) * g2k_c d) * (1 / 2) = (d : ℂ) * g2k_c d := by ring
    have e2 : 2 * ((d : ℂ) * g2k_c d) * (-g2k_c d / 2) = 1 := by linear_combination (-1 : ℂ) * h
    rw [e1, e2, one_smul]
    abel
  rw [mul_sub, mul_one, hJP, smul_sub]
  conv_lhs => rw [hJ2]
  module

theorem g2k_Ωm_skew (hskew : ∀ x y, E (J x) y = -E x (J y)) :
    Matrix.transpose (g2k_Jm b J) * (LinearMap.BilinForm.toMatrix b E).map (algebraMap ℚ ℂ) =
      -((LinearMap.BilinForm.toMatrix b E).map (algebraMap ℚ ℂ) * g2k_Jm b J) := by
  have h : E.compLeft J = -E.compRight J := by
    ext x y
    simp [hskew]
  have hq := congrArg (LinearMap.BilinForm.toMatrix b) h
  rw [map_neg, LinearMap.BilinForm.toMatrix_compLeft, LinearMap.BilinForm.toMatrix_compRight] at hq
  have := congrArg (fun M => M.map (algebraMap ℚ ℂ)) hq
  rw [Matrix.map_neg _ (map_neg (algebraMap ℚ ℂ)), Matrix.map_mul, Matrix.map_mul,
    Matrix.transpose_map] at this
  rw [g2k_Jm]
  exact this

theorem g2k_Ωm_alt (hAlt : E.IsAlt) :
    Matrix.transpose ((LinearMap.BilinForm.toMatrix b E).map (algebraMap ℚ ℂ)) =
      -(LinearMap.BilinForm.toMatrix b E).map (algebraMap ℚ ℂ) := by
  ext i j
  simp only [Matrix.transpose_apply, Matrix.map_apply, LinearMap.BilinForm.toMatrix_apply,
    Matrix.neg_apply]
  rw [← (LinearMap.IsAlt.neg hAlt (b i) (b j)), map_neg]

theorem g2k_Ωm_det (hE : E.Nondegenerate) :
    ((LinearMap.BilinForm.toMatrix b E).map (algebraMap ℚ ℂ)).det ≠ 0 := by
  have h := (LinearMap.BilinForm.nondegenerate_iff_det_ne_zero b).mp hE
  rw [← RingHom.mapMatrix_apply, ← RingHom.map_det]
  exact (map_ne_zero (algebraMap ℚ ℂ)).mpr h

theorem g2k_blk_smul {m : ℕ} (c : ℂ) (A B : Matrix (Fin m) (Fin m) ℂ) :
    c • g2k_blk A B = g2k_blk (c • A) (c • B) := by
  simp [g2k_blk, Matrix.fromBlocks_smul]

set_option warn.classDefReducibility false in
attribute [local instance] g1_zariski in
/-- **`G_k` is connected for `R = ℚ[J]` and `E` alternating.** For `J² = -d`, `d > 0`, `E`
nondegenerate and alternating with `J` skew, `G_k(ℂ) ≅ SL_m(ℂ)` (`m = n/2`), which is
connected. The alternating hypothesis is needed (`g2k_gkGroup_adjoin_not_isConnected`). -/
theorem g2k_gkGroup_isConnected_adjoin_of_isAlt {d : ℚ} (hd : 0 < d)
    (hJ : J * J = (-d) • (1 : Module.End ℚ V)) (hE : E.Nondegenerate) (hAlt : E.IsAlt)
    (hskew : ∀ x y, E (J x) y = -E x (J y)) :
    IsConnected (g2_gkGroup b E (Algebra.adjoin ℚ {J}) J d) := by
  set Jm := g2k_Jm b J
  set Ω := (LinearMap.BilinForm.toMatrix b E).map (algebraMap ℚ ℂ)
  set P := g2k_P b J d
  set α : ℂ := (d : ℂ) * g2k_c d
  obtain ⟨htrP, hn⟩ := g2k_trace_P b J hd hJ
  set m := n / 2
  have hP := g2k_P_mul_self b J hd hJ
  have htrQ : (1 - P).trace = (m : ℂ) := by
    rw [Matrix.trace_sub, Matrix.trace_one, htrP, Fintype.card_fin]
    conv_lhs => rw [hn]
    push_cast
    ring
  have hα : α ≠ 0 := by
    refine mul_ne_zero (by exact_mod_cast hd.ne') fun h0 => ?_
    have h := g2k_c_sq hd
    rw [h0] at h
    have : (d : ℂ) ≠ 0 := by exact_mod_cast hd.ne'
    field_simp at h
    norm_num at h
  obtain ⟨S, T, hTS, hST, hPS, hSΩS⟩ := g2k_exists_adapted Jm Ω P α hP
    (g2k_Jm_mul_P b J hd hJ) (g2k_Jm_mul_one_sub_P b J hd hJ) hα (g2k_Ωm_skew b E J hskew)
    (g2k_Ωm_alt b E hAlt) (g2k_Ωm_det b E hE) htrP htrQ (by omega)
  have hΩf : Ω = Matrix.transpose T * g2k_K m * T := by
    rw [g2k_K, ← hSΩS]
    have h : Matrix.transpose T * Matrix.transpose S = 1 := by
      rw [← Matrix.transpose_mul, hST, Matrix.transpose_one]
    simp only [Matrix.mul_assoc]
    rw [hST, Matrix.mul_one, ← Matrix.mul_assoc, h, Matrix.one_mul]
  have hPf : P = S * g2k_blk (m := m) 1 0 * T := by
    rw [g2k_blk, ← hPS, Matrix.mul_assoc, hST, Matrix.mul_one]
  have hQf : 1 - P = S * g2k_blk (m := m) 0 1 * T := by
    rw [hPf, g2k_frame_one_sub S T hST, g2k_blk_sub_one]
    simp
  have hJm : Jm = S * g2k_blk (α • (1 : Matrix (Fin m) (Fin m) ℂ))
      ((-α) • (1 : Matrix (Fin m) (Fin m) ℂ)) * T := by
    have h1 : Jm = Jm * P + Jm * (1 - P) := by rw [← mul_add, add_sub_cancel, mul_one]
    rw [h1, g2k_Jm_mul_P b J hd hJ, g2k_Jm_mul_one_sub_P b J hd hJ]
    change α • P + (-α) • (1 - P) = _
    rw [hQf, hPf, ← Matrix.smul_mul, ← Matrix.mul_smul, ← Matrix.smul_mul, ← Matrix.mul_smul,
      ← Matrix.add_mul, ← Matrix.mul_add, g2k_blk_smul, g2k_blk_smul, g2k_blk_add]
    simp
  refine g2k_frame_isConnected S T hTS hST _ (fun A hA => ?_) (fun g hg => ?_)
    (g2k_isRatAlgSubgroup_gkGroup b E _ J hd hJ).2.2.1
  · obtain ⟨c1, c2, c3, c4⟩ := g2k_frame_conds S T Jm Ω P α hTS hST hJm hΩf hPf A hA
    rw [g2k_mem_gkGroup_iff b E _ J hd hJ, g2k_coe_PhiGL]
    exact ⟨g2k_commute_adjoin b J _ c1, c1, c2, c3, c4⟩
  · obtain ⟨-, h2, h3, h4, -⟩ := (g2k_mem_gkGroup_iff b E _ J hd hJ g).mp hg
    exact g2k_frame_exists S T Ω P hTS hST hΩf hPf g (g2k_commute_P b J h2) h3 h4

end Glue

end HodgeLean.Foundations
