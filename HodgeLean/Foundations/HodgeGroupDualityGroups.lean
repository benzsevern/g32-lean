import HodgeLean.Foundations.HodgeGroupDualityHull
import HodgeLean.Foundations.HodgeGroupDualityMatrices
import HodgeLean.Foundations.HodgeGroupAlgebraic

/-! The homological group hypothesis in coordinates dual to a rational cohomology basis.
The homological polarization has inverse Gram matrix; multiplying it by a nonzero scalar
has no effect on its isometry group. Endomorphisms act by transpose, whereas group elements
act contragrediently. Both eigenspace determinants are retained.
-/

noncomputable section
set_option maxHeartbeats 400000
namespace HodgeLean.Foundations
open scoped TensorProduct
variable {V : Type*} [AddCommGroup V] [Module ℚ V] {n : ℕ}

/-- The rational algebraic group generated by the dual Hodge circle. -/
def g2_homologyHodgeGroup
    (H : ℤ × ℤ → Submodule ℂ (ℂ ⊗[ℚ] V)) (hH : DirectSum.IsInternal H)
    (b : Module.Basis (Fin n) ℚ V) : Set (Matrix.GeneralLinearGroup (Fin n) ℂ) :=
  ⋂₀ {G | g2_IsRatAlgSubgroup G ∧ g2_contragredient '' g2_circleImage H hH b ⊆ G}

/-- Special-unitary equations on the dual representation, including both embeddings of the
quadratic field. The dual polarization is written in inverse Gram coordinates. -/
def g2_homologySpecialUnitary (b : Module.Basis (Fin n) ℚ V)
    (E : LinearMap.BilinForm ℚ V) (R : Subalgebra ℚ (Module.End ℚ V))
    (J : Module.End ℚ V) (d : ℚ) : Set (Matrix.GeneralLinearGroup (Fin n) ℂ) :=
  let Jm := (LinearMap.toMatrix b b J).map (algebraMap ℚ ℂ)
  let Ω := (LinearMap.BilinForm.toMatrix b E).map (algebraMap ℚ ℂ)
  let P := (1 / 2 : ℂ) • (1 - (Complex.I / ((Real.sqrt d : ℝ) : ℂ)) • Jm)
  {g | (∀ r ∈ R, (g : Matrix (Fin n) (Fin n) ℂ) *
          ((LinearMap.toMatrix b b r).map (algebraMap ℚ ℂ)).transpose =
        ((LinearMap.toMatrix b b r).map (algebraMap ℚ ℂ)).transpose * (g : Matrix (Fin n) (Fin n) ℂ)) ∧
    (g : Matrix (Fin n) (Fin n) ℂ) * Jm.transpose = Jm.transpose * (g : Matrix (Fin n) (Fin n) ℂ) ∧
    (g : Matrix (Fin n) (Fin n) ℂ).transpose * Ω⁻¹ * (g : Matrix (Fin n) (Fin n) ℂ) = Ω⁻¹ ∧
    ((g : Matrix (Fin n) (Fin n) ℂ) * P.transpose + (1 - P.transpose)).det = 1 ∧
    ((g : Matrix (Fin n) (Fin n) ℂ) * (1 - P.transpose) + P.transpose).det = 1}

/-- Transpose identifies the two sets of special-unitary equations. -/
theorem g2_transpose_mem_homologySpecialUnitary_iff (b : Module.Basis (Fin n) ℚ V)
    (E : LinearMap.BilinForm ℚ V) (R : Subalgebra ℚ (Module.End ℚ V))
    (J : Module.End ℚ V) {d : ℚ} (hd : 0 < d)
    (hJ : J * J = (-d) • (1 : Module.End ℚ V))
    (hΩ : IsUnit ((LinearMap.BilinForm.toMatrix b E).map (algebraMap ℚ ℂ)).det)
    (g : Matrix.GeneralLinearGroup (Fin n) ℂ) :
    g2_dualTranspose g ∈ g2_homologySpecialUnitary b E R J d ↔
      g ∈ g2_gkGroup b E R J d := by
  rw [g2_mem_gkGroup_iff b E R J hd hJ]
  simp only [g2_homologySpecialUnitary, Set.mem_ofPred_eq, g2_dualTranspose,
    Matrix.transpose_transpose, g2_transpose_commutes_iff]
  apply and_congr_right
  intro _
  apply and_congr_right
  intro hj
  rw [g2_transpose_isometry_iff g _ hΩ]
  apply and_congr_right
  intro _
  apply g2_transpose_eigenDets_iff
  simp only [mul_smul_comm, smul_mul_assoc, mul_sub, sub_mul, mul_one, one_mul, hj]

end HodgeLean.Foundations
