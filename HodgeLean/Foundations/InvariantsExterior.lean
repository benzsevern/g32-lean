import HodgeLean.Foundations.SchurWeylLie

/-!
# Exterior powers and the invariant-theory lemma

Target F-1575 (1): for `W` of dimension `N` and multiplicity spaces `U`, `U'` of
dimension `m`, the `SL(W)`-invariants of the exterior algebra of
`(W ⊗ U) ⊕ (W^∨ ⊗ U')` are generated by the quadratic contractions `θ(u, u')`
and the determinant-type classes `det(W ⊗ a)`, `det(W^∨ ⊗ a')`.

This file develops the Lie-algebra approach over a field of characteristic zero.
F-1575 (1) is proved in `sl(W)` Lie form by `invariants_eq_generatedDegree` in
`InvariantsExteriorBlocks`; `InvariantsExteriorExamples` proves the dimension-two
three-class spanning example. The group form for `SL(W)` is not proved. The route
uses the tensor first fundamental theorem and polarization, unlike TR54 §3
(skew Cauchy and `GL(U) × GL(U')` highest weights), with the same generating set.

Relation to the goal: HC no distance; AV milestone no distance. F-1575 still
needs step (2), the Hodge group input, and F-1569.

## Proved reductions

* `exteriorLie`, `invariantExteriorLie`: the derivation action, with the slot
  formula, Lie bracket identity, and equivariant `toTensorPower`.
* `theta`, `detW`, `detWDual`: exactly the prescribed generators. θ is the
  image of the identity tensor. Determinants are images of specified top
  vectors; changing the basis scales them and leaves their spans unchanged.
* `exteriorProjector`: the normalized sign projector, idempotent and commuting
  with the derivation action. `exists_invariant_tensor_iff` lifts invariants
  without any appeal to complete reducibility.
* `sum_tensor_words`, `invariant_tensor_word`: expansion by complementary
  slot projections, preserving invariance of each component.
* `tensorMultiplicityEquiv_tensorDer`: canonical regrouping of tensor powers
  of `W ⊗ U`, intertwining the derivation action. The dual and `U'` case is a
  separate instantiation of the same theorem.
* `invariant_rTensor_iff_mem_span`: adjoining a trivial multiplicity factor.
* `antisymmetrized_multiplicities_eq_mixedDeterminant`: cancellation of the two
  signs; `mixedDeterminant_mem_span_detW` and its dual reduce mixed determinants
  to the exact single-multiplicity generators by polarization.
* `generatedDegree_le_invariants`: every prescribed wedge product is invariant.
  `elementary_pair_not_generated` falsifies membership for one summand of θ
  when `W = K²`, `U = U' = K`.
* `generatedDegree_eq_top_of_finrank_one`: full generation in dimension one,
  for arbitrary separate multiplicity spaces.
* `coloredMultiplicityOut_tensorDer`, `sum_coloredMultiplicityIn_out`: equivariant
  grouping of all colored words into mixed tensors and two trivial multiplicity factors.
* `reindex_tensorDer`, `mixedReindex_invariants_eq_span`: equivariant slot relabelling,
  with transported T8(a) contraction and determinant-power spanning families.
* `wedgeQuotient_detTensorDual_mem`, `wedgeQuotient_detTensor_mem`: exterior images
  of individual determinant blocks lie in the prescribed span.
* `wedgeQuotient_tensorAppend_mem`, `wedgeQuotient_permRep_mem`: concatenating
  blocks and permuting their slots preserve membership of their exterior images.
* `invariants_le_generatedDegree_of_colored_images`: assembly of the reverse
  inclusion, conditional on the mixed-tensor image calculation proved in the continuation.

## General block images and scope

The continuation `InvariantsExteriorBlocks` proves the general block-image calculation:
independent sums of local contraction pairs regroup into tensor products; recursive
vector and dual determinant powers regroup into their individual blocks. Slot permutations
move to the output while pulling back the multiplicities. Concatenation becomes the wedge
product, and signs do not change span membership. T8(a)'s spanning families and the
colored-word assembly then give `invariants_eq_generatedDegree` in every degree.

`InvariantsExteriorExamples` proves that for `dim W = 2` and `U = U' = K`, the degree-two
invariants, included in the exterior algebra, are exactly the span of `θ(1,1)`, `detW(1)`,
and `detWDual(1)`. These are Lie invariants; no Lie-to-group comparison is asserted.
-/

open PiTensorProduct Finset Module
open scoped TensorProduct

noncomputable section
attribute [local instance 100] LieRing.ofAssociativeRing
attribute [local instance] HodgeLean.Foundations.SchurWeyl.dualAddCommGroup

namespace HodgeLean.Foundations.InvariantsExterior
open SchurWeyl

variable {K M : Type*} [Field K] [CharZero K] [AddCommGroup M] [Module K M]

/-- The canonical quotient from tensors to exterior powers.
Source: Bourbaki, *Algebra*, Chapter III, §7 (exterior algebra). -/
def wedgeQuotient (k : ℕ) : (⨂[K]^k M) →ₗ[K] ⋀[K]^k M :=
  PiTensorProduct.lift (exteriorPower.ιMulti K k).toMultilinearMap

omit [CharZero K] in
@[simp] theorem wedgeQuotient_tprod (k : ℕ) (v : Fin k → M) :
    wedgeQuotient k (tprod K v) = exteriorPower.ιMulti K k v := by
  simp [wedgeQuotient]

omit [CharZero K] in
theorem toTensorPower_ιMulti (k : ℕ) (v : Fin k → M) :
    exteriorPower.toTensorPower K M k (exteriorPower.ιMulti K k v) =
      antisymTensor K M (Fin k) v :=
  exteriorPower.alternatingMapLinearEquiv_apply_ιMulti _ _

omit [CharZero K] in
theorem wedgeQuotient_toTensorPower (k : ℕ) (v : ⋀[K]^k M) :
    wedgeQuotient k (exteriorPower.toTensorPower K M k v) = (k.factorial : K) • v := by
  suffices h : (wedgeQuotient (K := K) (M := M) k).comp
      (exteriorPower.toTensorPower K M k) = (k.factorial : K) • LinearMap.id by
    exact LinearMap.congr_fun h v
  apply exteriorPower.linearMap_ext
  apply AlternatingMap.ext
  intro x
  simp only [LinearMap.compAlternatingMap_apply, LinearMap.comp_apply,
    toTensorPower_ιMulti, antisymTensor_apply, map_sum, map_zsmul, wedgeQuotient_tprod]
  simp only [← Function.comp_def, AlternatingMap.map_perm, Units.smul_def,
    smul_smul]
  simp [Nat.cast_smul_eq_nsmul, Fintype.card_perm]

theorem toTensorPower_injective (k : ℕ) :
    Function.Injective (exteriorPower.toTensorPower K M k) := by
  intro x y h
  have := congrArg (wedgeQuotient k) h
  simpa only [wedgeQuotient_toTensorPower,
    smul_right_inj (show (k.factorial : K) ≠ 0 by exact_mod_cast k.factorial_ne_zero)] using this

/-- The derivation action transferred from the tensor power using antisymmetrization.
Source: Fulton–Harris, *Representation Theory*, §8.1 (induced representations). -/
def exteriorDer (k : ℕ) (f : Module.End K M) : Module.End K (⋀[K]^k M) :=
  (k.factorial : K)⁻¹ • (wedgeQuotient k).comp
    ((tensorDer (Fin k) f).comp (exteriorPower.toTensorPower K M k))

theorem exteriorDer_ιMulti (k : ℕ) (f : Module.End K M) (v : Fin k → M) :
    exteriorDer k f (exteriorPower.ιMulti K k v) =
      ∑ i, exteriorPower.ιMulti K k (Function.update v i (f (v i))) := by
  simp only [exteriorDer, LinearMap.smul_apply, LinearMap.comp_apply,
    toTensorPower_ιMulti, tensorDer_antisymTensor, map_sum]
  simp_rw [← toTensorPower_ιMulti, wedgeQuotient_toTensorPower]
  rw [← Finset.smul_sum, smul_smul, inv_mul_cancel₀, one_smul]
  exact_mod_cast k.factorial_ne_zero

theorem toTensorPower_exteriorDer (k : ℕ) (f : Module.End K M) (v : ⋀[K]^k M) :
    exteriorPower.toTensorPower K M k (exteriorDer k f v) =
      tensorDer (Fin k) f (exteriorPower.toTensorPower K M k v) := by
  suffices h : (exteriorPower.toTensorPower K M k).comp (exteriorDer k f) =
      (tensorDer (Fin k) f).comp (exteriorPower.toTensorPower K M k) by
    exact LinearMap.congr_fun h v
  apply exteriorPower.linearMap_ext
  apply AlternatingMap.ext
  intro x
  simp only [LinearMap.compAlternatingMap_apply, LinearMap.comp_apply, exteriorDer_ιMulti,
    map_sum, toTensorPower_ιMulti, tensorDer_antisymTensor]

/-- The exterior-power derivation representation of `gl(M)`.
Source: Fulton–Harris, *Representation Theory*, §8.1. -/
def exteriorLie (k : ℕ) : Module.End K M →ₗ⁅K⁆ Module.End K (⋀[K]^k M) where
  toFun := exteriorDer k
  map_add' f g := by
    apply LinearMap.ext
    intro v
    apply toTensorPower_injective k
    simp [toTensorPower_exteriorDer, map_add]
  map_smul' c f := by
    apply LinearMap.ext
    intro v
    apply toTensorPower_injective k
    simp [toTensorPower_exteriorDer]
  map_lie' {f g} := by
    apply LinearMap.ext
    intro v
    apply toTensorPower_injective k
    rw [toTensorPower_exteriorDer, (tensorDer (Fin k)).map_lie]
    simp only [Ring.lie_def, LinearMap.sub_apply, Module.End.mul_apply, map_sub,
      toTensorPower_exteriorDer]

theorem exteriorDer_map {P : Type*} [AddCommGroup P] [Module K P]
    (k : ℕ) (f : Module.End K M) (g : Module.End K P) (j : M →ₗ[K] P)
    (hj : g.comp j = j.comp f) (v : ⋀[K]^k M) :
    exteriorDer k g (exteriorPower.map k j v) = exteriorPower.map k j (exteriorDer k f v) := by
  suffices h : (exteriorDer k g).comp (exteriorPower.map k j) =
      (exteriorPower.map k j).comp (exteriorDer k f) by
    exact LinearMap.congr_fun h v
  apply exteriorPower.linearMap_ext
  apply AlternatingMap.ext
  intro x
  simp only [LinearMap.compAlternatingMap_apply, LinearMap.comp_apply,
    exteriorPower.map_apply_ιMulti, exteriorDer_ιMulti, map_sum]
  apply Finset.sum_congr rfl
  intro i _
  congr 1
  funext l
  by_cases h : l = i
  · subst h
    simpa using LinearMap.congr_fun hj (x l)
  · simp [Function.update_of_ne h, Function.comp_def]

section Multiplicities

variable (K) (W U U' : Type*)
  [AddCommGroup W] [Module K W] [AddCommGroup U] [Module K U]
  [AddCommGroup U'] [Module K U']

/-- The two distinct multiplicity spaces in F-1575 (1).
Source: F-1575 (1), with the TR56 repair keeping `U` and `U'` distinct. -/
abbrev Space := (W ⊗[K] U) × (Module.Dual K W ⊗[K] U')

/-- The action on the two summands, trivial on the multiplicity factors.
Source: Fulton–Harris, *Representation Theory*, §8.1. -/
def multiplicityLie : Module.End K W →ₗ⁅K⁆ Module.End K (Space K W U U') where
  toFun f := (f.rTensor U).prodMap ((dualLie K W f).rTensor U')
  map_add' f g := by simp only [map_add, LinearMap.rTensor_add, LinearMap.prodMap_add]
  map_smul' c f := by simp only [map_smul, LinearMap.rTensor_smul, LinearMap.prodMap_smul, RingHom.id_apply]
  map_lie' {f g} := by
    rw [(dualLie K W).map_lie]
    simp only [Ring.lie_def, LinearMap.rTensor_sub, LinearMap.rTensor_mul]
    apply LinearMap.ext
    intro x
    simp only [LinearMap.prodMap_apply, LinearMap.sub_apply, Module.End.mul_apply,
      Prod.mk_sub_mk]

/-- The derivation representation on the exterior powers of the F-1575 space.
Source: F-1575 (1), Lie-algebra form; Fulton–Harris, §8.1. -/
def invariantExteriorLie (k : ℕ) :
    Module.End K W →ₗ⁅K⁆ Module.End K (⋀[K]^k (Space K W U U')) :=
  (exteriorLie k).comp (multiplicityLie K W U U')

instance (k : ℕ) : LieRingModule (Module.End K W) (⋀[K]^k (Space K W U U')) :=
  LieRingModule.compLieHom _ (invariantExteriorLie K W U U' k)

instance (k : ℕ) : LieModule K (Module.End K W) (⋀[K]^k (Space K W U U')) :=
  LieModule.compLieHom _ (invariantExteriorLie K W U U' k)

variable {K W U U'}

theorem lie_eq_exteriorDer (k : ℕ) (f : Module.End K W)
    (v : ⋀[K]^k (Space K W U U')) :
    ⁅f, v⁆ = exteriorDer k (multiplicityLie K W U U' f) v := rfl

theorem toTensorPower_lie (k : ℕ) (f : Module.End K W)
    (v : ⋀[K]^k (Space K W U U')) :
    exteriorPower.toTensorPower K (Space K W U U') k ⁅f, v⁆ =
      tensorDer (Fin k) (multiplicityLie K W U U' f)
        (exteriorPower.toTensorPower K (Space K W U U') k v) :=
  toTensorPower_exteriorDer k _ v

/-- Insert a vector in the first summand at a fixed multiplicity.
Source: F-1575 (1), the map `w ↦ (w ⊗ a, 0)`. -/
def vectorIn (a : U) : W →ₗ[K] Space K W U U' :=
  (LinearMap.inl K _ _).comp ((TensorProduct.mk K W U).flip a)

/-- Insert a covector in the second summand at a fixed multiplicity.
Source: F-1575 (1), the map `φ ↦ (0, φ ⊗ a')`. -/
def dualIn (a' : U') : Module.Dual K W →ₗ[K] Space K W U U' :=
  (LinearMap.inr K _ _).comp ((TensorProduct.mk K (Module.Dual K W) U').flip a')

omit [CharZero K] in
@[simp] theorem vectorIn_apply (a : U) (w : W) :
    vectorIn (U' := U') a w = (w ⊗ₜ[K] a, 0) := rfl

omit [CharZero K] in
@[simp] theorem dualIn_apply (a' : U') (φ : Module.Dual K W) :
    dualIn (U := U) a' φ = (0, φ ⊗ₜ[K] a') := rfl

omit [CharZero K] in
theorem multiplicityLie_vectorIn (f : Module.End K W) (a : U) :
    (multiplicityLie K W U U' f).comp (vectorIn a) = (vectorIn a).comp f := by
  ext w <;> simp [multiplicityLie, LinearMap.prodMap_apply]

omit [CharZero K] in
theorem multiplicityLie_dualIn (f : Module.End K W) (a' : U') :
    (multiplicityLie K W U U' f).comp (dualIn a') =
      (dualIn a').comp (dualLie K W f) := by
  ext φ <;> simp [multiplicityLie, LinearMap.prodMap_apply]

end Multiplicities

section Determinants

variable {W U U' : Type*} [AddCommGroup W] [Module K W] [FiniteDimensional K W]
  [AddCommGroup U] [Module K U] [AddCommGroup U'] [Module K U']

omit [FiniteDimensional K W] in
theorem exteriorDer_basis {n : ℕ} (b : Basis (Fin n) K W) (f : Module.End K W) :
    exteriorDer n f (exteriorPower.ιMulti K n b) =
      LinearMap.trace K W f • exteriorPower.ιMulti K n b := by
  apply toTensorPower_injective n
  rw [toTensorPower_exteriorDer, map_smul, toTensorPower_ιMulti,
    tensorDer_antisymTensor_basis]

/-- A determinant class with a specified top vector; this construction is basis-free.
Source: F-1575 (1), image of the top exterior power under `w ↦ w ⊗ a`. -/
def detWOf (t : ⋀[K]^(finrank K W) W) (a : U) :
    ⋀[K]^(finrank K W) (Space K W U U') :=
  exteriorPower.map _ (vectorIn a) t

/-- A dual determinant class with a specified top vector; no basis is part of the definition.
Source: F-1575 (1), image of the top exterior power under `φ ↦ φ ⊗ a'`. -/
def detWDualOf (t : ⋀[K]^(finrank K W) (Module.Dual K W)) (a' : U') :
    ⋀[K]^(finrank K W) (Space K W U U') :=
  exteriorPower.map _ (dualIn a') t

/-- The determinant generator using the chosen top vector. Changing basis scales it.
Source: F-1575 (1), `det(W ⊗ a)`. -/
def detW (a : U) : ⋀[K]^(finrank K W) (Space K W U U') :=
  detWOf (exteriorPower.ιMulti K _ (Module.finBasis K W)) a

/-- The dual determinant generator using the dual of the chosen basis.
Source: F-1575 (1), `det(W^∨ ⊗ a')`. -/
def detWDual (a' : U') : ⋀[K]^(finrank K W) (Space K W U U') :=
  detWDualOf (exteriorPower.ιMulti K _ (Module.finBasis K W).dualBasis) a'

omit [CharZero K] in
theorem detW_eq (a : U) : detW (K := K) (W := W) (U' := U') a =
    exteriorPower.ιMulti K _ (fun i => ((Module.finBasis K W i) ⊗ₜ[K] a, 0)) := by
  simp [detW, detWOf, Function.comp_def]

omit [CharZero K] in
theorem detWDual_eq (a' : U') : detWDual (K := K) (W := W) (U := U) a' =
    exteriorPower.ιMulti K _ (fun i => (0, (Module.finBasis K W).dualBasis i ⊗ₜ[K] a')) := by
  simp [detWDual, detWDualOf, Function.comp_def]

theorem lie_detW (f : Module.End K W) (a : U) :
    ⁅f, detW (K := K) (W := W) (U' := U') a⁆ = LinearMap.trace K W f • detW (K := K) (W := W) (U' := U') a := by
  rw [lie_eq_exteriorDer]
  unfold detW detWOf
  rw [exteriorDer_map _ _ _ _ (multiplicityLie_vectorIn f a), exteriorDer_basis, map_smul]

theorem lie_detWDual (f : Module.End K W) (a' : U') :
    ⁅f, detWDual (K := K) (W := W) (U := U) a'⁆ = -LinearMap.trace K W f • detWDual (K := K) (W := W) (U := U) a' := by
  rw [lie_eq_exteriorDer]
  unfold detWDual detWDualOf
  rw [exteriorDer_map _ _ _ _ (multiplicityLie_dualIn f a'), exteriorDer_basis, map_smul]
  simp [dualLie_apply, trace_dualMap]

theorem detW_invariant (f : slEnd K W) (a : U) :
    ⁅(f : Module.End K W), detW (K := K) (W := W) (U' := U') a⁆ = 0 := by
  rw [lie_detW, (mem_slEnd.mp f.property), zero_smul]

theorem detWDual_invariant (f : slEnd K W) (a' : U') :
    ⁅(f : Module.End K W), detWDual (K := K) (W := W) (U := U) a'⁆ = 0 := by
  rw [lie_detWDual, (mem_slEnd.mp f.property), neg_zero, zero_smul]

omit [FiniteDimensional K W] in
theorem ιMulti_basis_change {n : ℕ} (b c : Basis (Fin n) K W) :
    exteriorPower.ιMulti K n c = b.det c • exteriorPower.ιMulti K n b := by
  apply toTensorPower_injective n
  simp only [map_smul, toTensorPower_ιMulti, antisymTensor_basis_eq_smul b c]

omit [FiniteDimensional K W] in
theorem detWOf_basis_change (b c : Basis (Fin (finrank K W)) K W) (a : U) :
    detWOf (U' := U') (exteriorPower.ιMulti K _ c) a =
      b.det c • detWOf (U' := U') (exteriorPower.ιMulti K _ b) a := by
  simp only [detWOf, ιMulti_basis_change b c, map_smul]

omit [FiniteDimensional K W] in
theorem detWDualOf_basis_change
    (b c : Basis (Fin (finrank K W)) K (Module.Dual K W)) (a' : U') :
    detWDualOf (U := U) (exteriorPower.ιMulti K _ c) a' =
      b.det c • detWDualOf (U := U) (exteriorPower.ιMulti K _ b) a' := by
  simp only [detWDualOf, ιMulti_basis_change b c, map_smul]

omit [FiniteDimensional K W] in
theorem detW_span_basis_independent (b c : Basis (Fin (finrank K W)) K W) :
    Submodule.span K (Set.range (fun a : U => detWOf (U' := U') (exteriorPower.ιMulti K _ b) a)) =
      Submodule.span K (Set.range (fun a : U => detWOf (U' := U') (exteriorPower.ιMulti K _ c) a)) := by
  apply le_antisymm
  · rw [Submodule.span_le]
    rintro _ ⟨a, rfl⟩
    dsimp only
    rw [detWOf_basis_change (U' := U') c b a]
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨a, rfl⟩)
  · rw [Submodule.span_le]
    rintro _ ⟨a, rfl⟩
    dsimp only
    rw [detWOf_basis_change (U' := U') b c a]
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨a, rfl⟩)

omit [FiniteDimensional K W] in
theorem detWDual_span_basis_independent
    (b c : Basis (Fin (finrank K W)) K (Module.Dual K W)) :
    Submodule.span K (Set.range (fun a' : U' =>
      detWDualOf (U := U) (exteriorPower.ιMulti K _ b) a')) =
      Submodule.span K (Set.range (fun a' : U' =>
        detWDualOf (U := U) (exteriorPower.ιMulti K _ c) a')) := by
  apply le_antisymm
  · rw [Submodule.span_le]
    rintro _ ⟨a', rfl⟩
    dsimp only
    rw [detWDualOf_basis_change (U := U) c b a']
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨a', rfl⟩)
  · rw [Submodule.span_le]
    rintro _ ⟨a', rfl⟩
    dsimp only
    rw [detWDualOf_basis_change (U := U) b c a']
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨a', rfl⟩)

end Determinants

section Contractions

omit [AddCommGroup M] in
private theorem update_pair_zero (v w z : M) :
    Function.update ![v, w] 0 z = ![z, w] := by
  funext i
  fin_cases i <;> simp

omit [AddCommGroup M] in
private theorem update_pair_one (v w z : M) :
    Function.update ![v, w] 1 z = ![v, z] := by
  funext i
  fin_cases i <;> simp

/-- The bilinear wedge into degree two.
Source: Bourbaki, *Algebra*, Chapter III, §7. -/
def wedgePair : M →ₗ[K] M →ₗ[K] ⋀[K]^2 M :=
  LinearMap.mk₂ K (fun v w => exteriorPower.ιMulti K 2 ![v, w])
    (by
      intro v v' w
      simpa only [update_pair_zero] using
        (exteriorPower.ιMulti K 2).map_update_add ![v, w] 0 v v')
    (by
      intro c v w
      simpa only [update_pair_zero] using
        (exteriorPower.ιMulti K 2).map_update_smul ![v, w] 0 c v)
    (by
      intro v w w'
      simpa only [show (0 : Fin 1).succ = (1 : Fin 2) from rfl, update_pair_one] using
        (exteriorPower.ιMulti K 2).map_update_add ![v, w] (0 : Fin 1).succ w w')
    (by
      intro c v w
      simpa only [show (0 : Fin 1).succ = (1 : Fin 2) from rfl, update_pair_one] using
        (exteriorPower.ιMulti K 2).map_update_smul ![v, w] (0 : Fin 1).succ c w)

omit [CharZero K] in
@[simp] theorem wedgePair_apply (v w : M) :
    wedgePair v w = exteriorPower.ιMulti K 2 ![v, w] := rfl

theorem exteriorDer_wedgePair (f : Module.End K M) (v w : M) :
    exteriorDer 2 f (wedgePair v w) = wedgePair (f v) w + wedgePair v (f w) := by
  simp only [wedgePair_apply, exteriorDer_ιMulti, Fin.sum_univ_two]
  congr 2 <;> funext i <;> fin_cases i <;> rfl

variable {W U U' : Type*} [AddCommGroup W] [Module K W] [FiniteDimensional K W]
  [AddCommGroup U] [Module K U] [AddCommGroup U'] [Module K U']

/-- The basis-free tensor corresponding to the identity endomorphism of `W`.
Source: Bourbaki, *Algebra*, Chapter II, §4 (duality and tensor products). -/
def identityTensor : W ⊗[K] Module.Dual K W :=
  (TensorProduct.comm K _ _) ((dualTensorHomEquiv K W W).symm LinearMap.id)

omit [CharZero K] in
theorem identityTensor_eq_sum {ι : Type*} [Fintype ι] [DecidableEq ι] (b : Basis ι K W) :
    identityTensor (K := K) (W := W) = ∑ i, b i ⊗ₜ[K] b.dualBasis i := by
  apply (TensorProduct.comm K W (Module.Dual K W)).injective
  apply (dualTensorHomEquiv K W W).injective
  ext w
  simp [identityTensor]

/-- The contraction followed by the two inclusions and exterior multiplication.
Source: F-1575 (1), the quadratic contraction `θ(u,u')`. -/
def contractionToExterior (a : U) (a' : U') :
    W ⊗[K] Module.Dual K W →ₗ[K] ⋀[K]^2 (Space K W U U') :=
  TensorProduct.lift ((wedgePair.comp (vectorIn a)).compl₂ (dualIn a'))

omit [CharZero K] [FiniteDimensional K W] in
@[simp] theorem contractionToExterior_tmul (a : U) (a' : U') (w : W) (φ : Module.Dual K W) :
    contractionToExterior a a' (w ⊗ₜ[K] φ) = wedgePair (vectorIn a w) (dualIn a' φ) := rfl

/-- The quadratic generator, defined as the image of the identity tensor and hence basis-free.
Source: F-1575 (1), `θ(u,u') = ∑ᵢ (eᵢ ⊗ u) ∧ (eᵢ^∨ ⊗ u')`. -/
def theta (a : U) (a' : U') : ⋀[K]^2 (Space K W U U') :=
  contractionToExterior a a' identityTensor

omit [CharZero K] in
theorem theta_eq_sum {ι : Type*} [Fintype ι] [DecidableEq ι]
    (b : Basis ι K W) (a : U) (a' : U') :
    theta (K := K) (W := W) a a' = ∑ i, wedgePair (vectorIn a (b i)) (dualIn a' (b.dualBasis i)) := by
  simp [theta, identityTensor_eq_sum b]

omit [CharZero K] in
theorem identityTensor_invariant (f : Module.End K W) :
    f.rTensor (Module.Dual K W) (identityTensor (K := K) (W := W)) +
      (dualLie K W f).lTensor W identityTensor = 0 := by
  let e := (TensorProduct.comm K W (Module.Dual K W)).trans
    (dualTensorHomEquiv K W W)
  have h (t : W ⊗[K] Module.Dual K W) :
      e (f.rTensor _ t + (dualLie K W f).lTensor _ t) =
        f.comp (e t) - (e t).comp f := by
    induction t using TensorProduct.inductionOn with
    | tmul w φ =>
      ext x
      simp [e, dualLie_apply, LinearMap.comp_apply, sub_eq_add_neg]
    | add x y hx hy =>
      rw [(f.rTensor _).map_add, ((dualLie K W f).lTensor _).map_add,
        add_add_add_comm, e.map_add, hx, hy, e.map_add]
      simp only [LinearMap.comp_add, LinearMap.add_comp]
      abel
  apply e.injective
  rw [map_zero, h]
  have hi : e identityTensor = LinearMap.id := by simp [e, identityTensor]
  rw [hi, LinearMap.comp_id, LinearMap.id_comp, sub_self]

omit [FiniteDimensional K W] in
theorem exteriorDer_contractionToExterior (f : Module.End K W) (a : U) (a' : U')
    (t : W ⊗[K] Module.Dual K W) :
    exteriorDer 2 (multiplicityLie K W U U' f) (contractionToExterior a a' t) =
      contractionToExterior a a' (f.rTensor _ t + (dualLie K W f).lTensor _ t) := by
  induction t using TensorProduct.inductionOn with
  | tmul w φ =>
    simp only [contractionToExterior_tmul, exteriorDer_wedgePair, LinearMap.rTensor_tmul,
      LinearMap.lTensor_tmul, map_add]
    have hv := LinearMap.congr_fun (multiplicityLie_vectorIn (U' := U') f a) w
    have hd := LinearMap.congr_fun (multiplicityLie_dualIn (U := U) f a') φ
    simp only [LinearMap.comp_apply] at hv hd
    rw [hv, hd]
  | add x y hx hy =>
    simp only [map_add] at hx hy ⊢
    rw [hx, hy]
    abel

/-- The quadratic contractions are invariant even under `gl(W)`. -/
theorem lie_theta (f : Module.End K W) (a : U) (a' : U') : ⁅f, theta (K := K) (W := W) a a'⁆ = 0 := by
  rw [lie_eq_exteriorDer, theta, exteriorDer_contractionToExterior, identityTensor_invariant,
    map_zero]

theorem theta_invariant (f : slEnd K W) (a : U) (a' : U') :
    ⁅(f : Module.End K W), theta (K := K) (W := W) a a'⁆ = 0 := lie_theta _ _ _

end Contractions

section TensorReduction

theorem wedgeQuotient_tensorDer (k : ℕ) (f : Module.End K M) (v : ⨂[K]^k M) :
    wedgeQuotient k (tensorDer (Fin k) f v) = exteriorDer k f (wedgeQuotient k v) := by
  induction v using PiTensorProduct.induction_on with
  | smul_tprod c v =>
    simp [tensorDer_tprod, exteriorDer_ιMulti]
  | add x y hx hy => simp [hx, hy]

/-- The normalized sign projector on the tensor power.
Source: Goodman–Wallach, *Symmetry, Representations, and Invariants*, Chapter 4.
Mathlib's `toTensorPower` itself is unnormalized. -/
def exteriorProjector (k : ℕ) : Module.End K (⨂[K]^k M) :=
  (k.factorial : K)⁻¹ • (exteriorPower.toTensorPower K M k).comp (wedgeQuotient k)

omit [CharZero K] in
theorem exteriorProjector_tprod (k : ℕ) (v : Fin k → M) :
    exteriorProjector k (tprod K v) = (k.factorial : K)⁻¹ • antisymTensor K M (Fin k) v := by
  simp only [exteriorProjector, LinearMap.smul_apply, LinearMap.comp_apply,
    wedgeQuotient_tprod, toTensorPower_ιMulti]

theorem exteriorProjector_toTensorPower (k : ℕ) (v : ⋀[K]^k M) :
    exteriorProjector k (exteriorPower.toTensorPower K M k v) =
      exteriorPower.toTensorPower K M k v := by
  simp only [exteriorProjector, LinearMap.smul_apply, LinearMap.comp_apply,
    wedgeQuotient_toTensorPower, map_smul, smul_smul]
  rw [inv_mul_cancel₀, one_smul]
  exact_mod_cast k.factorial_ne_zero

theorem exteriorProjector_idempotent (k : ℕ) (t : ⨂[K]^k M) :
    exteriorProjector k (exteriorProjector k t) = exteriorProjector k t := by
  change exteriorProjector k ((k.factorial : K)⁻¹ •
      exteriorPower.toTensorPower K M k (wedgeQuotient k t)) = _
  rw [map_smul, exteriorProjector_toTensorPower]
  rfl

theorem exteriorProjector_tensorDer (k : ℕ) (f : Module.End K M) (t : ⨂[K]^k M) :
    exteriorProjector k (tensorDer (Fin k) f t) = tensorDer (Fin k) f (exteriorProjector k t) := by
  change (k.factorial : K)⁻¹ • exteriorPower.toTensorPower K M k
      (wedgeQuotient k (tensorDer (Fin k) f t)) =
    tensorDer (Fin k) f ((k.factorial : K)⁻¹ • exteriorPower.toTensorPower K M k (wedgeQuotient k t))
  rw [wedgeQuotient_tensorDer, map_smul, toTensorPower_exteriorDer]

/-- Invariants pass through the split exterior quotient without a semisimplicity theorem.
The lift in the forward implication is `1/k!` times antisymmetrization. -/
theorem exists_invariant_tensor_iff (k : ℕ) (S : Set (Module.End K M)) (v : ⋀[K]^k M) :
    (∀ f ∈ S, exteriorDer k f v = 0) ↔
      ∃ t : ⨂[K]^k M, wedgeQuotient k t = v ∧ ∀ f ∈ S, tensorDer (Fin k) f t = 0 := by
  constructor
  · intro hv
    refine ⟨(k.factorial : K)⁻¹ • exteriorPower.toTensorPower K M k v, ?_, ?_⟩
    · rw [map_smul, wedgeQuotient_toTensorPower, smul_smul, inv_mul_cancel₀, one_smul]
      exact_mod_cast k.factorial_ne_zero
    · intro f hf
      rw [map_smul, ← toTensorPower_exteriorDer, hv f hf, map_zero, smul_zero]
  · rintro ⟨t, rfl, ht⟩ f hf
    rw [← wedgeQuotient_tensorDer, ht f hf, map_zero]

end TensorReduction

section Polarization

variable {A B : Type*} [AddCommGroup A] [Module K A] [AddCommGroup B] [Module K B]

/-- Wedge a fixed family in one factor against variable multiplicities in the other.
Source: F-1575 (1), the mixed determinant before symmetrization. -/
def multiplicityWedge {n : ℕ} (j : A →ₗ[K] B →ₗ[K] M) (v : Fin n → A) :
    MultilinearMap K (fun _ : Fin n => B) (⋀[K]^n M) :=
  (exteriorPower.ιMulti K n).toMultilinearMap.compLinearMap (fun i => j (v i))

omit [CharZero K] in
@[simp] theorem multiplicityWedge_apply {n : ℕ} (j : A →ₗ[K] B →ₗ[K] M)
    (v : Fin n → A) (a : Fin n → B) :
    multiplicityWedge j v a = exteriorPower.ιMulti K n (fun i => j (v i) (a i)) := rfl

/-- The mixed determinant, symmetric in the multiplicities.
Source: F-1575 (1), determinant blocks after exterior projection; polarization as in
Goodman–Wallach, *Symmetry, Representations, and Invariants*, Chapter 4. -/
def mixedDeterminant {n : ℕ} (j : A →ₗ[K] B →ₗ[K] M) (v : Fin n → A) (a : Fin n → B) :
    ⋀[K]^n M := ∑ σ : Equiv.Perm (Fin n), multiplicityWedge j v (fun i => a (σ i))

omit [CharZero K] in
theorem mixedDeterminant_mem_span_diagonal {n : ℕ} (j : A →ₗ[K] B →ₗ[K] M)
    (v : Fin n → A) (a : Fin n → B) :
    mixedDeterminant j v a ∈ Submodule.span K
      (Set.range (fun b : B => exteriorPower.ιMulti K n (fun i => j (v i) b))) := by
  unfold mixedDeterminant
  rw [← polarization (multiplicityWedge j v) a]
  exact Submodule.sum_mem _ fun s _ =>
    Submodule.smul_mem _ _ (Submodule.subset_span ⟨_, rfl⟩)

omit [CharZero K] in
theorem mixedDeterminant_const {n : ℕ} (j : A →ₗ[K] B →ₗ[K] M)
    (v : Fin n → A) (b : B) :
    mixedDeterminant j v (fun _ => b) =
      (n.factorial : K) • exteriorPower.ιMulti K n (fun i => j (v i) b) := by
  simp [mixedDeterminant, Fintype.card_perm, Nat.cast_smul_eq_nsmul]

omit [CharZero K] in
theorem mixedDeterminant_perm {n : ℕ} (j : A →ₗ[K] B →ₗ[K] M)
    (v : Fin n → A) (a : Fin n → B) (τ : Equiv.Perm (Fin n)) :
    mixedDeterminant j v (a ∘ τ) = mixedDeterminant j v a := by
  unfold mixedDeterminant
  exact Fintype.sum_equiv (Equiv.mulLeft τ) _ _ (fun σ => rfl)

omit [CharZero K] in
/-- Antisymmetrizing the vector slots produces the symmetric mixed determinant:
the permutation sign and exterior sign cancel. -/
theorem antisymmetrized_multiplicities_eq_mixedDeterminant {n : ℕ}
    (j : A →ₗ[K] B →ₗ[K] M) (v : Fin n → A) (a : Fin n → B) :
    (∑ σ : Equiv.Perm (Fin n), Equiv.Perm.sign σ •
      exteriorPower.ιMulti K n (fun i => j (v (σ i)) (a i))) = mixedDeterminant j v a := by
  have h (σ : Equiv.Perm (Fin n)) : Equiv.Perm.sign σ •
      exteriorPower.ιMulti K n (fun i => j (v (σ i)) (a i)) =
        multiplicityWedge j v (fun i => a (σ.symm i)) := by
    have he : (fun i => j (v (σ i)) (a i)) =
        (fun i => j (v i) (a (σ.symm i))) ∘ σ := by ext i; simp
    rw [he, AlternatingMap.map_perm]
    simp [Units.smul_def, smul_smul]
  simp_rw [h]
  exact Fintype.sum_equiv (Equiv.inv _) _ _ (fun σ => rfl)

end Polarization

section DiagonalDeterminants

variable {W U U' : Type*} [AddCommGroup W] [Module K W] [FiniteDimensional K W]
  [AddCommGroup U] [Module K U] [AddCommGroup U'] [Module K U']

omit [CharZero K] in
/-- Polarization reduces mixed vector determinant blocks to exactly the generators
`detW a` of F-1575 (1). This is a reduction, not the full generation theorem. -/
theorem mixedDeterminant_mem_span_detW (a : Fin (finrank K W) → U) :
    mixedDeterminant ((TensorProduct.mk K W U).compr₂
        (LinearMap.inl K (W ⊗[K] U) (Module.Dual K W ⊗[K] U')))
      (Module.finBasis K W) a ∈
      Submodule.span K (Set.range (detW (K := K) (W := W) (U' := U'))) := by
  have he : detW (K := K) (W := W) (U' := U') =
      fun b : U => exteriorPower.ιMulti K _ (fun i => ((Module.finBasis K W i) ⊗ₜ[K] b, 0)) :=
    funext detW_eq
  rw [he]
  simpa only [LinearMap.compr₂_apply, TensorProduct.mk_apply, LinearMap.inl_apply]
    using mixedDeterminant_mem_span_diagonal
      ((TensorProduct.mk K W U).compr₂
        (LinearMap.inl K (W ⊗[K] U) (Module.Dual K W ⊗[K] U')))
      (Module.finBasis K W) a

omit [CharZero K] in
/-- The same polarization reduction for the distinct dual multiplicity space `U'`. -/
theorem mixedDeterminant_mem_span_detWDual (a' : Fin (finrank K W) → U') :
    mixedDeterminant ((TensorProduct.mk K (Module.Dual K W) U').compr₂
        (LinearMap.inr K (W ⊗[K] U) (Module.Dual K W ⊗[K] U')))
      (Module.finBasis K W).dualBasis a' ∈
      Submodule.span K (Set.range (detWDual (K := K) (W := W) (U := U))) := by
  have he : detWDual (K := K) (W := W) (U := U) =
      fun b : U' => exteriorPower.ιMulti K _
        (fun i => (0, (Module.finBasis K W).dualBasis i ⊗ₜ[K] b)) :=
    funext detWDual_eq
  rw [he]
  simpa only [LinearMap.compr₂_apply, TensorProduct.mk_apply, LinearMap.inr_apply]
    using mixedDeterminant_mem_span_diagonal
      ((TensorProduct.mk K (Module.Dual K W) U').compr₂
        (LinearMap.inr K (W ⊗[K] U) (Module.Dual K W ⊗[K] U')))
      (Module.finBasis K W).dualBasis a'

end DiagonalDeterminants

section DimensionOne

variable {W U U' : Type*} [AddCommGroup W] [Module K W] [FiniteDimensional K W]
  [AddCommGroup U] [Module K U] [AddCommGroup U'] [Module K U']

omit [CharZero K] in
theorem slEnd_eq_zero_of_finrank_one (h : finrank K W = 1) (f : slEnd K W) :
    (f : Module.End K W) = 0 := by
  let b : Basis (Fin 1) K W := (Module.finBasis K W).reindex (finCongr h)
  apply b.ext
  intro i
  apply b.repr.injective
  apply Finsupp.ext
  intro j
  fin_cases i
  fin_cases j
  have ht := mem_slEnd.mp f.property
  simpa [LinearMap.trace_eq_matrix_trace K b, Matrix.trace, LinearMap.toMatrix_apply] using ht

/-- In dimension one every exterior class is `sl(W)`-invariant. -/
theorem invariant_of_finrank_one (h : finrank K W = 1) (k : ℕ) (f : slEnd K W)
    (v : ⋀[K]^k (Space K W U U')) : ⁅(f : Module.End K W), v⁆ = 0 := by
  rw [slEnd_eq_zero_of_finrank_one h f, zero_lie]

end DimensionOne

section Products

omit [CharZero K] in
theorem wedge_ιMulti {k l : ℕ} (v : Fin k → M) (w : Fin l → M) :
    exteriorPower.wedge K M k l (exteriorPower.ιMulti K k v) (exteriorPower.ιMulti K l w) =
      exteriorPower.ιMulti K (k + l) (Fin.append v w) := by
  apply Subtype.ext
  exact ExteriorAlgebra.ιMulti_mul_ιMulti v w

omit [AddCommGroup M] in
private theorem update_append_left {k l : ℕ} (v : Fin k → M) (w : Fin l → M)
    (i : Fin k) (z : M) :
    Function.update (Fin.append v w) (i.castAdd l) z = Fin.append (Function.update v i z) w := by
  funext a
  refine Fin.addCases (fun j => ?_) (fun j => ?_) a
  · by_cases h : j = i
    · subst h; simp
    · have hh : j.castAdd l ≠ i.castAdd l := by
        intro hh
        apply h
        apply Fin.ext
        exact congrArg (fun x : Fin (k + l) => x.val) hh
      simp [Function.update_of_ne h, Function.update_of_ne hh]
  · have hh : Fin.natAdd k j ≠ i.castAdd l := by
      intro hh
      have hv := congrArg Fin.val hh
      simp only [Fin.val_natAdd, Fin.val_castAdd] at hv
      omega
    simp [Function.update_of_ne hh]

omit [AddCommGroup M] in
private theorem update_append_right {k l : ℕ} (v : Fin k → M) (w : Fin l → M)
    (i : Fin l) (z : M) :
    Function.update (Fin.append v w) (Fin.natAdd k i) z = Fin.append v (Function.update w i z) := by
  funext a
  refine Fin.addCases (fun j => ?_) (fun j => ?_) a
  · have hh : j.castAdd l ≠ Fin.natAdd k i := by
      intro hh
      have hv := congrArg Fin.val hh
      simp only [Fin.val_natAdd, Fin.val_castAdd] at hv
      omega
    simp [Function.update_of_ne hh]
  · by_cases h : j = i
    · subst h; simp
    · have hh : Fin.natAdd k j ≠ Fin.natAdd k i := by
        intro hh
        apply h
        apply Fin.ext
        have hv := congrArg Fin.val hh
        simp only [Fin.val_natAdd] at hv
        omega
      simp [Function.update_of_ne h, Function.update_of_ne hh]

theorem exteriorDer_wedge {k l : ℕ} (f : Module.End K M) (v : ⋀[K]^k M) (w : ⋀[K]^l M) :
    exteriorDer (k + l) f (exteriorPower.wedge K M k l v w) =
      exteriorPower.wedge K M k l (exteriorDer k f v) w +
        exteriorPower.wedge K M k l v (exteriorDer l f w) := by
  suffices h : (exteriorPower.wedge K M k l).compr₂ (exteriorDer (k + l) f) =
      (exteriorPower.wedge K M k l).comp (exteriorDer k f) +
        (exteriorPower.wedge K M k l).compl₂ (exteriorDer l f) from
    congrArg (fun q => q v w) h
  apply exteriorPower.linearMap_ext
  apply AlternatingMap.ext
  intro x
  apply exteriorPower.linearMap_ext
  apply AlternatingMap.ext
  intro y
  change exteriorDer (k + l) f (exteriorPower.wedge K M k l
      (exteriorPower.ιMulti K k x) (exteriorPower.ιMulti K l y)) = _
  simp only [LinearMap.compAlternatingMap_apply, LinearMap.add_apply, LinearMap.comp_apply,
    LinearMap.compl₂_apply, wedge_ιMulti, exteriorDer_ιMulti, map_sum, LinearMap.sum_apply]
  rw [Fin.sum_univ_add]
  simp only [Fin.append_left, Fin.append_right, update_append_left, update_append_right]

/-- Concatenate two tensor powers, in the same order as the graded wedge product.
Source: Mathlib's `PiTensorProduct` reindexing along `finSumFinEquiv`. -/
def tensorAppend (k l : ℕ) : (⨂[K]^k M) ⊗[K] (⨂[K]^l M) ≃ₗ[K] (⨂[K]^(k + l) M) :=
  (tmulEquiv K M).trans
    (PiTensorProduct.reindex K (fun _ : Fin k ⊕ Fin l => M) finSumFinEquiv)

omit [CharZero K] in
theorem tensorAppend_tprod {k l : ℕ} (v : Fin k → M) (w : Fin l → M) :
    tensorAppend k l (tprod K v ⊗ₜ[K] tprod K w) = tprod K (Fin.append v w) := by
  simp only [tensorAppend, LinearEquiv.trans_apply, tmulEquiv_apply, reindex_tprod]
  congr 1
  funext i
  refine Fin.addCases (fun j => ?_) (fun j => ?_) i <;> simp

omit [CharZero K] in
/-- The tensor quotient sends concatenation to wedge multiplication. -/
theorem wedgeQuotient_tensorAppend {k l : ℕ} (v : ⨂[K]^k M) (w : ⨂[K]^l M) :
    wedgeQuotient (k + l) (tensorAppend k l (v ⊗ₜ[K] w)) =
      exteriorPower.wedge K M k l (wedgeQuotient k v) (wedgeQuotient l w) := by
  induction v using PiTensorProduct.induction_on with
  | smul_tprod c v =>
    induction w using PiTensorProduct.induction_on with
    | smul_tprod d w =>
      simp only [TensorProduct.smul_tmul, TensorProduct.tmul_smul, map_smul,
        LinearMap.smul_apply, tensorAppend_tprod, wedgeQuotient_tprod, wedge_ιMulti]
    | add x y hx hy => simp only [TensorProduct.tmul_add, map_add, hx, hy]
  | add x y hx hy =>
    simp only [TensorProduct.add_tmul, map_add, LinearMap.add_apply, hx, hy]

end Products

section GeneratedDegrees

variable {W U U' : Type*} [AddCommGroup W] [Module K W] [FiniteDimensional K W]
  [AddCommGroup U] [Module K U] [AddCommGroup U'] [Module K U']

/-- Wedge products of exactly the generators in F-1575 (1), including the empty product.
Source: F-1575 (1), the generating set `θ(u,u')`, `det(W ⊗ a)`, `det(W^∨ ⊗ a')`. -/
inductive GeneratorProduct : (k : ℕ) → (⋀[K]^k (Space K W U U')) → Prop
  | unit : GeneratorProduct 0 (exteriorPower.ιMulti K 0 Fin.elim0)
  | theta (a : U) (a' : U') : GeneratorProduct 2 (theta a a')
  | detW (a : U) : GeneratorProduct (finrank K W) (detW a)
  | detWDual (a' : U') : GeneratorProduct (finrank K W) (detWDual a')
  | wedge {k l : ℕ} {v : ⋀[K]^k (Space K W U U')} {w : ⋀[K]^l (Space K W U U')} :
      GeneratorProduct k v → GeneratorProduct l w →
      GeneratorProduct (k + l) (exteriorPower.wedge K (Space K W U U') k l v w)

/-- The degree-`k` span of the prescribed wedge products.
Source: F-1575 (1), homogeneous part of the algebra generated by its stated classes. -/
def generatedDegree (k : ℕ) : Submodule K (⋀[K]^k (Space K W U U')) :=
  Submodule.span K {v | GeneratorProduct k v}

theorem generatorProduct_invariant {k : ℕ} {v : ⋀[K]^k (Space K W U U')}
    (h : GeneratorProduct k v) (f : slEnd K W) : ⁅(f : Module.End K W), v⁆ = 0 := by
  induction h with
  | unit => simp [lie_eq_exteriorDer, exteriorDer_ιMulti]
  | theta a a' => exact theta_invariant f a a'
  | detW a => exact detW_invariant f a
  | detWDual a' => exact detWDual_invariant f a'
  | wedge hv hw ihv ihw =>
    simp only [lie_eq_exteriorDer] at ihv ihw ⊢
    rw [exteriorDer_wedge, ihv, ihw]
    simp only [map_zero, LinearMap.zero_apply, add_zero]

/-- The easy inclusion in F-1575 (1): every prescribed wedge product is invariant.
The reverse inclusion is proved in `InvariantsExteriorBlocks` using the tensor
decomposition with independent multiplicities. -/
theorem generatedDegree_le_invariants (k : ℕ) :
    generatedDegree (K := K) (W := W) (U := U) (U' := U') k ≤
      (LieModule.maxTrivSubmodule K (slEnd K W) (⋀[K]^k (Space K W U U')) : Submodule K _) := by
  rw [generatedDegree, Submodule.span_le]
  intro v hv
  change ∀ f : slEnd K W, ⁅f, v⁆ = 0
  intro f
  rw [LieSubalgebra.coe_bracket_of_module]
  exact generatorProduct_invariant hv f

/-- The prescribed spans are closed under the graded wedge product. -/
theorem wedge_mem_generatedDegree {k l : ℕ}
    {v : ⋀[K]^k (Space K W U U')} {w : ⋀[K]^l (Space K W U U')}
    (hv : v ∈ generatedDegree k) (hw : w ∈ generatedDegree l) :
    exteriorPower.wedge K (Space K W U U') k l v w ∈ generatedDegree (k + l) := by
  induction hv using Submodule.span_induction with
  | mem v hv =>
    induction hw using Submodule.span_induction with
    | mem w hw => exact Submodule.subset_span (GeneratorProduct.wedge hv hw)
    | zero => simpa only [map_zero, LinearMap.zero_apply] using (generatedDegree (K := K) (W := W) (U := U) (U' := U')
        (k + l)).zero_mem
    | add x y _ _ hx hy => simpa only [map_add] using Submodule.add_mem _ hx hy
    | smul a x _ hx => simpa only [map_smul] using Submodule.smul_mem _ a hx
  | zero => simpa only [map_zero, LinearMap.zero_apply] using (generatedDegree (K := K) (W := W) (U := U) (U' := U')
      (k + l)).zero_mem
  | add x y _ _ hx hy =>
    simpa only [map_add, LinearMap.add_apply] using Submodule.add_mem _ hx hy
  | smul a x _ hx =>
    simpa only [map_smul, LinearMap.smul_apply] using Submodule.smul_mem _ a hx

/-- Generation in degree one implies generation of every exterior degree. -/
theorem generatedDegree_eq_top_of_degree_one
    (h : generatedDegree (K := K) (W := W) (U := U) (U' := U') 1 = ⊤) (k : ℕ) :
    generatedDegree (K := K) (W := W) (U := U) (U' := U') k = ⊤ := by
  apply top_unique
  rw [← exteriorPower.ιMulti_span K k (Space K W U U'), Submodule.span_le]
  rintro _ ⟨v, rfl⟩
  induction k with
  | zero =>
    have hv : v = Fin.elim0 := funext (fun i => Fin.elim0 i)
    rw [hv]
    exact Submodule.subset_span GeneratorProduct.unit
  | succ k ih =>
    have hh : exteriorPower.ιMulti K 1 (fun _ => v (Fin.last k)) ∈
        generatedDegree (K := K) (W := W) (U := U) (U' := U') 1 := by rw [h]; trivial
    have hp := wedge_mem_generatedDegree (ih (fun i => v (i.castSucc))) hh
    rw [wedge_ιMulti] at hp
    have he : Fin.append (fun i => v (i.castSucc)) (fun _ : Fin 1 => v (Fin.last k)) = v := by
      funext i
      refine Fin.addCases (fun j => ?_) (fun j => ?_) i
      · rw [Fin.append_left]
        rfl
      · fin_cases j
        rw [Fin.append_right]
        rfl
    rw [he] at hp
    exact hp

/-- In dimension one the prescribed determinants span degree one. -/
theorem generatedDegree_one_eq_top_of_finrank_one (h : finrank K W = 1) :
    generatedDegree (K := K) (W := W) (U := U) (U' := U') 1 = ⊤ := by
  let i : Fin (finrank K W) := ⟨0, by omega⟩
  have hi (j : Fin (finrank K W)) : j = i := by apply Fin.ext; have := j.isLt; dsimp [i]; omega
  let b := Module.finBasis K W
  let L := (exteriorPower.oneEquiv K (Space K W U U')).symm.toLinearMap
  have hL (x : Space K W U U') :
      L x = exteriorPower.ιMulti K 1 (fun _ => x) := by
    apply (exteriorPower.oneEquiv K _).injective
    simp [L, exteriorPower.oneEquiv_ιMulti]
  have transport (n m : ℕ) (hn : n = m) (x : Space K W U U') :
      exteriorPower.ιMulti K n (fun _ => x) ∈ generatedDegree n →
        exteriorPower.ιMulti K m (fun _ => x) ∈ generatedDegree m := by
    cases hn
    exact id
  have hv (a : U) : L (vectorIn a (b i)) ∈ generatedDegree 1 := by
    have hd : exteriorPower.ιMulti K (finrank K W) (fun _ => vectorIn a (b i)) ∈
        generatedDegree (K := K) (W := W) (U := U) (U' := U') (finrank K W) := by
      have hh : detW (K := K) (W := W) (U' := U') a ∈
          generatedDegree (finrank K W) := Submodule.subset_span (GeneratorProduct.detW a)
      simpa only [b, detW_eq, ← vectorIn_apply, hi] using hh
    rw [hL]
    exact transport _ _ h _ hd
  have hd (a' : U') : L (dualIn a' (b.dualBasis i)) ∈ generatedDegree 1 := by
    have hh : exteriorPower.ιMulti K (finrank K W) (fun _ => dualIn a' (b.dualBasis i)) ∈
        generatedDegree (K := K) (W := W) (U := U) (U' := U') (finrank K W) := by
      have hh : detWDual (K := K) (W := W) (U := U) a' ∈
          generatedDegree (finrank K W) := Submodule.subset_span (GeneratorProduct.detWDual a')
      simpa only [b, detWDual_eq, ← dualIn_apply, hi] using hh
    rw [hL]
    exact transport _ _ h _ hh
  have hv' (w : W) (a : U) : L (vectorIn a w) ∈ generatedDegree 1 := by
    have hw : w = b.repr w i • b i := by
      conv_lhs => rw [← b.sum_repr w]
      exact Finset.sum_eq_single i (fun j _ hj => (hj (hi j)).elim)
        (fun hn => (hn (Finset.mem_univ i)).elim)
    rw [hw, map_smul, map_smul]
    exact Submodule.smul_mem _ _ (hv a)
  have hd' (w : Module.Dual K W) (a : U') : L (dualIn a w) ∈ generatedDegree 1 := by
    have hw : w = b.dualBasis.repr w i • b.dualBasis i := by
      conv_lhs => rw [← b.dualBasis.sum_repr w]
      exact Finset.sum_eq_single i (fun j _ hj => (hj (hi j)).elim)
        (fun hn => (hn (Finset.mem_univ i)).elim)
    rw [hw, map_smul, map_smul]
    exact Submodule.smul_mem _ _ (hd a)
  have hx (x : Space K W U U') : L x ∈ generatedDegree 1 := by
    have hl (v : W ⊗[K] U) : L (v, 0) ∈ generatedDegree 1 := by
      induction v using TensorProduct.inductionOn with
      | tmul w a => exact hv' w a
      | add v w hv hw =>
        change L ((v, 0) + (w, 0)) ∈ _
        rw [map_add]
        exact Submodule.add_mem _ hv hw
    have hr (v : Module.Dual K W ⊗[K] U') : L (0, v) ∈ generatedDegree 1 := by
      induction v using TensorProduct.inductionOn with
      | tmul w a => exact hd' w a
      | add v w hv hw =>
        change L ((0, v) + (0, w)) ∈ _
        rw [map_add]
        exact Submodule.add_mem _ hv hw
    have he : x = (x.1, 0) + (0, x.2) := by ext <;> simp
    rw [he, map_add]
    exact Submodule.add_mem _ (hl _) (hr _)
  apply top_unique
  intro v _
  obtain ⟨x, rfl⟩ := (exteriorPower.oneEquiv K (Space K W U U')).symm.surjective v
  exact hx x

/-- For `dim W = 1`, every exterior class is a combination of the prescribed products. -/
theorem generatedDegree_eq_top_of_finrank_one (h : finrank K W = 1) (k : ℕ) :
    generatedDegree (K := K) (W := W) (U := U) (U' := U') k = ⊤ :=
  generatedDegree_eq_top_of_degree_one (generatedDegree_one_eq_top_of_finrank_one h) k

/-- F-1575 (1) in Lie form in dimension one, for separate arbitrary multiplicity spaces. -/
theorem invariants_eq_generatedDegree_of_finrank_one (h : finrank K W = 1) (k : ℕ) :
    (LieModule.maxTrivSubmodule K (slEnd K W) (⋀[K]^k (Space K W U U')) : Submodule K _) =
      generatedDegree (K := K) (W := W) (U := U) (U' := U') k := by
  apply le_antisymm
  · rw [generatedDegree_eq_top_of_finrank_one h]; exact le_top
  · exact generatedDegree_le_invariants k

/-- Permuting tensor slots changes the exterior image by the permutation sign. -/
theorem wedgeQuotient_permRep (k : ℕ) (τ : Equiv.Perm (Fin k))
    (t : ⨂[K]^k (Space K W U U')) :
    wedgeQuotient k (permRep K (Space K W U U') (Fin k) τ t) =
      (Equiv.Perm.sign τ : ℤ) • wedgeQuotient k t := by
  suffices h : (wedgeQuotient (K := K) (M := Space K W U U') k).comp
      (permRep K (Space K W U U') (Fin k) τ) =
      (Equiv.Perm.sign τ : ℤ) • wedgeQuotient k from LinearMap.congr_fun h t
  ext v
  simp only [LinearMap.compMultilinearMap_apply, LinearMap.comp_apply,
    permRep_tprod, wedgeQuotient_tprod, LinearMap.smul_apply]
  simpa only [← Function.comp_def, AlternatingMap.map_perm, Equiv.Perm.sign_symm,
    Units.smul_def]

/-- Signs from reordering blocks do not affect membership in the generated span. -/
theorem wedgeQuotient_permRep_mem {k : ℕ} (τ : Equiv.Perm (Fin k))
    (t : ⨂[K]^k (Space K W U U')) (ht : wedgeQuotient k t ∈ generatedDegree k) :
    wedgeQuotient k (permRep K (Space K W U U') (Fin k) τ t) ∈ generatedDegree k := by
  rw [wedgeQuotient_permRep]
  exact (generatedDegree k).toAddSubgroup.zsmul_mem ht _

/-- A vector determinant block with independent multiplicities has the mixed determinant image. -/
theorem wedgeQuotient_detTensorDual (a : Fin (finrank K W) → U) :
    wedgeQuotient (finrank K W)
      (PiTensorProduct.map (fun i => vectorIn (U' := U') (a i)) (detTensorDual K W)) =
    mixedDeterminant ((TensorProduct.mk K W U).compr₂
      (LinearMap.inl K (W ⊗[K] U) (Module.Dual K W ⊗[K] U')))
      (Module.finBasis K W) a := by
  simp only [detTensorDual, toTensorPower_ιMulti, antisymTensor_apply, map_sum,
    map_zsmul, map_tprod, wedgeQuotient_tprod]
  simpa only [Units.smul_def, LinearMap.compr₂_apply, TensorProduct.mk_apply,
    LinearMap.inl_apply, vectorIn_apply] using
    antisymmetrized_multiplicities_eq_mixedDeterminant
      ((TensorProduct.mk K W U).compr₂
        (LinearMap.inl K (W ⊗[K] U) (Module.Dual K W ⊗[K] U')))
      (Module.finBasis K W) a

/-- A covector determinant block has the analogous image, with the separate space `U'`. -/
theorem wedgeQuotient_detTensor (a' : Fin (finrank K W) → U') :
    wedgeQuotient (finrank K W)
      (PiTensorProduct.map (fun i => dualIn (U := U) (a' i)) (detTensor K W)) =
    mixedDeterminant ((TensorProduct.mk K (Module.Dual K W) U').compr₂
      (LinearMap.inr K (W ⊗[K] U) (Module.Dual K W ⊗[K] U')))
      (Module.finBasis K W).dualBasis a' := by
  simp only [detTensor, toTensorPower_ιMulti, antisymTensor_apply, map_sum,
    map_zsmul, map_tprod, wedgeQuotient_tprod]
  simpa only [Units.smul_def, LinearMap.compr₂_apply, TensorProduct.mk_apply,
    LinearMap.inr_apply, dualIn_apply] using
    antisymmetrized_multiplicities_eq_mixedDeterminant
      ((TensorProduct.mk K (Module.Dual K W) U').compr₂
        (LinearMap.inr K (W ⊗[K] U) (Module.Dual K W ⊗[K] U')))
      (Module.finBasis K W).dualBasis a'

/-- Polarization puts each vector determinant block in the prescribed span. -/
theorem wedgeQuotient_detTensorDual_mem (a : Fin (finrank K W) → U) :
    wedgeQuotient (finrank K W)
      (PiTensorProduct.map (fun i => vectorIn (U' := U') (a i)) (detTensorDual K W)) ∈
      generatedDegree (finrank K W) := by
  rw [wedgeQuotient_detTensorDual]
  apply (show Submodule.span K (Set.range (detW (K := K) (W := W) (U' := U'))) ≤
      generatedDegree (finrank K W) from ?_) (mixedDeterminant_mem_span_detW a)
  rw [Submodule.span_le]
  rintro _ ⟨a, rfl⟩
  exact Submodule.subset_span (GeneratorProduct.detW a)

/-- Polarization puts each covector determinant block in the prescribed span. -/
theorem wedgeQuotient_detTensor_mem (a' : Fin (finrank K W) → U') :
    wedgeQuotient (finrank K W)
      (PiTensorProduct.map (fun i => dualIn (U := U) (a' i)) (detTensor K W)) ∈
      generatedDegree (finrank K W) := by
  rw [wedgeQuotient_detTensor]
  apply (show Submodule.span K (Set.range (detWDual (K := K) (W := W) (U := U))) ≤
      generatedDegree (finrank K W) from ?_) (mixedDeterminant_mem_span_detWDual a')
  rw [Submodule.span_le]
  rintro _ ⟨a, rfl⟩
  exact Submodule.subset_span (GeneratorProduct.detWDual a)

/-- Exterior images of concatenated blocks stay in the generated span. -/
theorem wedgeQuotient_tensorAppend_mem {k l : ℕ}
    (v : ⨂[K]^k (Space K W U U')) (w : ⨂[K]^l (Space K W U U'))
    (hv : wedgeQuotient k v ∈ generatedDegree k)
    (hw : wedgeQuotient l w ∈ generatedDegree l) :
    wedgeQuotient (k + l) (tensorAppend k l (v ⊗ₜ[K] w)) ∈ generatedDegree (k + l) := by
  rw [wedgeQuotient_tensorAppend]
  exact wedge_mem_generatedDegree hv hw

end GeneratedDegrees

section Falsification

/-- For `W = K²`, `U = U' = K`, a single summand of θ is not invariant.
The traceless matrix sending `e₀` to `e₁` detects it. -/
theorem elementary_pair_not_invariant :
    let e₀ : Fin 2 → K := Pi.single 0 1
    let φ₀ : Module.Dual K (Fin 2 → K) := LinearMap.proj 0
    let z : ⋀[K]^2 (Space K (Fin 2 → K) K K) :=
      wedgePair (vectorIn (1 : K) e₀) (dualIn (1 : K) φ₀)
    z ∉ LieModule.maxTrivSubmodule K (slEnd K (Fin 2 → K))
      (⋀[K]^2 (Space K (Fin 2 → K) K K)) := by
  dsimp only
  intro hz
  let e₀ : Fin 2 → K := Pi.single 0 1
  let e₁ : Fin 2 → K := Pi.single 1 1
  let φ₀ : Module.Dual K (Fin 2 → K) := LinearMap.proj 0
  let f : Module.End K (Fin 2 → K) := φ₀.smulRight e₁
  have hf : f ∈ slEnd K (Fin 2 → K) := by
    rw [mem_slEnd, LinearMap.trace_smulRight]
    simp [φ₀, e₁]
  rw [LieModule.mem_maxTrivSubmodule] at hz
  have h := hz ⟨f, hf⟩
  rw [LieSubalgebra.coe_bracket_of_module, lie_eq_exteriorDer] at h
  change exteriorDer 2 (multiplicityLie K (Fin 2 → K) K K f)
    (wedgePair (vectorIn (1 : K) e₀) (dualIn (1 : K) φ₀)) = 0 at h
  have hv : (multiplicityLie K (Fin 2 → K) K K f) (vectorIn (1 : K) e₀) =
      vectorIn (1 : K) e₁ := by
    simp [multiplicityLie, LinearMap.prodMap_apply, f, e₀, e₁, φ₀]
  have hφ : dualLie K (Fin 2 → K) f φ₀ = 0 := by
    apply LinearMap.ext
    intro x
    simp [dualLie_apply, LinearMap.dualMap_apply, f, φ₀, e₁]
  have hd : (multiplicityLie K (Fin 2 → K) K K f) (dualIn (1 : K) φ₀) = 0 := by
    calc
      _ = dualIn (U := K) (1 : K) (dualLie K (Fin 2 → K) f φ₀) :=
        LinearMap.congr_fun (multiplicityLie_dualIn (U := K) f (1 : K)) φ₀
      _ = 0 := by rw [hφ, map_zero]
  rw [exteriorDer_wedgePair, hv, hd, map_zero, add_zero] at h
  let p : Module.Dual K (Space K (Fin 2 → K) K K) :=
    (LinearMap.proj 1).comp ((TensorProduct.rid K (Fin 2 → K)).toLinearMap.comp
      (LinearMap.fst K _ _))
  let q : Module.Dual K (Space K (Fin 2 → K) K K) :=
    ((Module.Dual.eval K (Fin 2 → K)) e₀).comp
      ((TensorProduct.rid K (Module.Dual K (Fin 2 → K))).toLinearMap.comp
        (LinearMap.snd K _ _))
  have hp := congrArg
    (exteriorPower.pairingDual K (Space K (Fin 2 → K) K K) 2
      (exteriorPower.ιMulti K 2 ![p, q])) h
  simp [wedgePair_apply, exteriorPower.pairingDual_ιMulti_ιMulti, Matrix.det_fin_two,
    p, q, e₀, e₁, φ₀] at hp

/-- Consequently that single summand is outside the span of the prescribed degree-two products. -/
theorem elementary_pair_not_generated :
    let e₀ : Fin 2 → K := Pi.single 0 1
    let φ₀ : Module.Dual K (Fin 2 → K) := LinearMap.proj 0
    let z : ⋀[K]^2 (Space K (Fin 2 → K) K K) :=
      wedgePair (vectorIn (1 : K) e₀) (dualIn (1 : K) φ₀)
    z ∉ generatedDegree 2 := by
  dsimp only
  intro hz
  exact elementary_pair_not_invariant (K := K) (generatedDegree_le_invariants 2 hz)

end Falsification

section TrivialTensorFactor

variable {V T : Type*} [AddCommGroup V] [Module K V]
  [AddCommGroup T] [Module K T] [FiniteDimensional K T]

omit [CharZero K] in
/-- Adding a trivial finite-dimensional tensor factor adds arbitrary multiplicity vectors
to a spanning set of invariants. No complete reducibility is needed. -/
theorem invariant_rTensor_iff_mem_span (S : Set (Module.End K V)) (t : V ⊗[K] T) :
    (∀ f ∈ S, f.rTensor T t = 0) ↔
      t ∈ Submodule.span K (Set.range
        (fun p : {v : V // ∀ f ∈ S, f v = 0} × T => p.1.val ⊗ₜ[K] p.2)) := by
  let b := Module.finBasis K T
  let c (i : Fin (finrank K T)) : V ⊗[K] T →ₗ[K] V :=
    (TensorProduct.rid K V).toLinearMap.comp ((b.coord i).lTensor V)
  have hc (i : Fin (finrank K T)) (f : Module.End K V) (x : V ⊗[K] T) :
      c i (f.rTensor T x) = f (c i x) := by
    induction x using TensorProduct.inductionOn with
    | tmul v w => simp [c]
    | add x y hx hy => simp only [map_add, hx, hy]
  have hsum (x : V ⊗[K] T) : ∑ i, c i x ⊗ₜ[K] b i = x := by
    induction x using TensorProduct.inductionOn with
    | tmul v w =>
      simp only [c, LinearMap.comp_apply, LinearMap.lTensor_tmul, LinearEquiv.coe_coe,
        TensorProduct.rid_tmul, TensorProduct.smul_tmul,
        ← TensorProduct.tmul_sum]
      change v ⊗ₜ[K] (∑ i, b.repr w i • b i) = v ⊗ₜ[K] w
      rw [b.sum_repr]
    | add x y hx hy => simp only [map_add, TensorProduct.add_tmul, Finset.sum_add_distrib, hx, hy]
  constructor
  · intro ht
    rw [← hsum t]
    apply Submodule.sum_mem
    intro i _
    refine Submodule.subset_span ⟨(⟨c i t, ?_⟩, b i), rfl⟩
    intro f hf
    rw [← hc, ht f hf, map_zero]
  · intro ht f hf
    induction ht using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨⟨v, w⟩, rfl⟩ := hx
      simp [v.property f hf]
    | zero => simp
    | add x y _ _ hx hy => simp [hx, hy]
    | smul a x _ hx => simp [hx]

end TrivialTensorFactor

section Examples

example (v w : M) : wedgeQuotient 2 (tprod K ![v, w]) = wedgePair v w :=
  wedgeQuotient_tprod 2 ![v, w]

example (f : Module.End K M) (v w : M) :
    exteriorLie 2 f (wedgePair v w) = wedgePair (f v) w + wedgePair v (f w) :=
  exteriorDer_wedgePair f v w

variable {W U U' : Type*} [AddCommGroup W] [Module K W] [FiniteDimensional K W]
  [AddCommGroup U] [Module K U] [AddCommGroup U'] [Module K U']

example (f : Module.End K W) (w : W) (φ : Module.Dual K W) (a : U) (a' : U') :
    multiplicityLie K W U U' f (w ⊗ₜ[K] a, φ ⊗ₜ[K] a') =
      (f w ⊗ₜ[K] a, -(φ.comp f) ⊗ₜ[K] a') := rfl

example (f : Module.End K W) (x y : Space K W U U') :
    invariantExteriorLie K W U U' 2 f (wedgePair x y) =
      wedgePair (multiplicityLie K W U U' f x) y +
        wedgePair x (multiplicityLie K W U U' f y) := exteriorDer_wedgePair _ _ _

example (w : W) (φ : Module.Dual K W) (a : U) (a' : U') :
    contractionToExterior a a' (w ⊗ₜ[K] φ) =
      exteriorPower.ιMulti K 2 ![vectorIn a w, dualIn a' φ] := rfl

example (t : Fin (finrank K W) → W) (a : U) :
    detWOf (U' := U') (exteriorPower.ιMulti K _ t) a =
      exteriorPower.ιMulti K _ (fun i => (t i ⊗ₜ[K] a, 0)) := by
  simp [detWOf, Function.comp_def]

example (t : Fin (finrank K W) → Module.Dual K W) (a' : U') :
    detWDualOf (U := U) (exteriorPower.ιMulti K _ t) a' =
      exteriorPower.ιMulti K _ (fun i => (0, t i ⊗ₜ[K] a')) := by
  simp [detWDualOf, Function.comp_def]

example (a : U) (a' : U') :
    detW (K := K) (W := W) (U' := U') a =
      exteriorPower.ιMulti K _ (fun i => ((Module.finBasis K W i) ⊗ₜ[K] a, 0)) ∧
    detWDual (K := K) (W := W) (U := U) a' =
      exteriorPower.ιMulti K _ (fun i => (0, (Module.finBasis K W).dualBasis i ⊗ₜ[K] a')) :=
  ⟨detW_eq a, detWDual_eq a'⟩

example : identityTensor (K := K) (W := Fin 2 → K) =
    (Pi.basisFun K (Fin 2) 0) ⊗ₜ[K] (Pi.basisFun K (Fin 2)).dualBasis 0 +
      (Pi.basisFun K (Fin 2) 1) ⊗ₜ[K] (Pi.basisFun K (Fin 2)).dualBasis 1 := by
  rw [identityTensor_eq_sum (Pi.basisFun K (Fin 2)), Fin.sum_univ_two]

example (a : U) (a' : U') : theta (K := K) (W := Fin 2 → K) a a' =
    wedgePair (vectorIn a (Pi.basisFun K (Fin 2) 0))
      (dualIn a' ((Pi.basisFun K (Fin 2)).dualBasis 0)) +
    wedgePair (vectorIn a (Pi.basisFun K (Fin 2) 1))
      (dualIn a' ((Pi.basisFun K (Fin 2)).dualBasis 1)) := by
  rw [theta_eq_sum (Pi.basisFun K (Fin 2)), Fin.sum_univ_two]

example (j : W →ₗ[K] U →ₗ[K] M) (w₀ w₁ : W) (a : U) :
    mixedDeterminant j ![w₀, w₁] (fun _ => a) =
      (2 : K) • multiplicityWedge j ![w₀, w₁] (fun _ => a) := by
  simpa using mixedDeterminant_const j ![w₀, w₁] a

example (a b : U) (a' b' : U') :
    exteriorPower.wedge K (Space K W U U') 2 2 (theta a a') (theta b b') ∈
      generatedDegree 4 :=
  Submodule.subset_span (GeneratorProduct.wedge (GeneratorProduct.theta a a')
    (GeneratorProduct.theta b b'))

end Examples

section TensorWords

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

omit [CharZero K] in
/-- Expand a tensor power using complementary operators in each slot. For the
projections onto the two summands this is the expansion into colored tensor words. -/
theorem sum_tensor_words (p q : Module.End K M) (h : p + q = 1) :
    (∑ s : Finset ι, PiTensorProduct.map (s.piecewise (fun _ => p) (fun _ => q))) =
      (1 : Module.End K (⨂[K] _ : ι, M)) := by
  let F := mapMultilinear K (fun _ : ι => M) (fun _ => M)
  have hh := F.map_add_univ (fun _ => p) (fun _ => q)
  have he : (fun _ : ι => p) + (fun _ => q) = (fun _ => (1 : Module.End K M)) := by
    funext i
    exact h
  rw [he] at hh
  simpa only [F, mapMultilinear_apply, PiTensorProduct.map_one] using hh.symm

omit [CharZero K] in
/-- Slotwise maps commuting with the action commute with its tensor derivation. -/
theorem tensorDer_map_commute (f : Module.End K M) (g : ι → Module.End K M)
    (h : ∀ i, f.comp (g i) = (g i).comp f) :
    (tensorDer ι f).comp (PiTensorProduct.map g) =
      (PiTensorProduct.map g).comp (tensorDer ι f) := by
  ext x
  simp only [LinearMap.compMultilinearMap_apply, LinearMap.comp_apply,
    map_tprod, tensorDer_tprod, map_sum]
  apply Finset.sum_congr rfl
  intro i _
  congr 1
  funext j
  by_cases hj : j = i
  · subst j
    simpa using LinearMap.congr_fun (h i) (x i)
  · simp [Function.update_of_ne hj]

omit [CharZero K] in
/-- Each colored component of an invariant tensor remains invariant. -/
theorem invariant_tensor_word (p q f : Module.End K M)
    (hp : f.comp p = p.comp f) (hq : f.comp q = q.comp f)
    (s : Finset ι) (t : ⨂[K] _ : ι, M) (ht : tensorDer ι f t = 0) :
    tensorDer ι f (PiTensorProduct.map (s.piecewise (fun _ => p) (fun _ => q)) t) = 0 := by
  have hc := tensorDer_map_commute f (s.piecewise (fun _ => p) (fun _ => q))
    (by
      intro i
      by_cases hi : i ∈ s
      · simpa [hi] using hp
      · simpa [hi] using hq)
  have he := LinearMap.congr_fun hc t
  simpa only [LinearMap.comp_apply, ht, map_zero] using he

omit [CharZero K] in
/-- Slotwise intertwiners induce an intertwiner of tensor derivations. -/
theorem tensorDer_map {P : Type*} [AddCommGroup P] [Module K P]
    (f : Module.End K M) (g : Module.End K P) (j : ι → M →ₗ[K] P)
    (hj : ∀ i, g.comp (j i) = (j i).comp f) (t : ⨂[K] _ : ι, M) :
    tensorDer ι g (PiTensorProduct.map j t) = PiTensorProduct.map j (tensorDer ι f t) := by
  suffices h : (tensorDer ι g).comp (PiTensorProduct.map j) =
      (PiTensorProduct.map j).comp (tensorDer ι f) from LinearMap.congr_fun h t
  ext x
  simp only [LinearMap.compMultilinearMap_apply, LinearMap.comp_apply,
    map_tprod, tensorDer_tprod, map_sum]
  apply Finset.sum_congr rfl
  intro i _
  congr 1
  funext l
  by_cases hl : l = i
  · subst l
    simpa using LinearMap.congr_fun (hj i) (x i)
  · simp [Function.update_of_ne hl]

end TensorWords

section TensorMultiplicity

variable (K) (W U ι : Type*) [AddCommGroup W] [Module K W]
  [AddCommGroup U] [Module K U] [FiniteDimensional K W] [FiniteDimensional K U]
  [Fintype ι] [DecidableEq ι]

/-- Canonical regrouping of tensor and multiplicity factors. A basis proves
invertibility; `tensorMultiplicityEquiv_toLinearMap` identifies its underlying
map with the basis-free tensor product of the slotwise bilinear maps.
Source: Bourbaki, *Algebra*, Chapter III, §5 (tensor products). -/
def tensorMultiplicityEquiv :
    (⨂[K] _ : ι, W) ⊗[K] (⨂[K] _ : ι, U) ≃ₗ[K] (⨂[K] _ : ι, W ⊗[K] U) :=
  ((Basis.piTensorProduct (fun _ : ι => Module.finBasis K W)).tensorProduct
    (Basis.piTensorProduct (fun _ : ι => Module.finBasis K U))).equiv
    (Basis.piTensorProduct (fun _ : ι =>
      (Module.finBasis K W).tensorProduct (Module.finBasis K U)))
    { toFun p := fun i => (p.1 i, p.2 i)
      invFun p := (fun i => (p i).1, fun i => (p i).2)
      left_inv := fun p => by cases p; rfl
      right_inv := fun p => rfl }

variable {K W U ι}

omit [CharZero K] in
theorem tensorMultiplicityEquiv_toLinearMap :
    (tensorMultiplicityEquiv K W U ι).toLinearMap =
      TensorProduct.lift (PiTensorProduct.map₂ (fun _ : ι => TensorProduct.mk K W U)) := by
  apply ((Basis.piTensorProduct (fun _ : ι => Module.finBasis K W)).tensorProduct
    (Basis.piTensorProduct (fun _ : ι => Module.finBasis K U))).ext
  intro p
  change tensorMultiplicityEquiv K W U ι _ = _
  unfold tensorMultiplicityEquiv
  rw [Basis.equiv_apply]
  simp [Basis.tensorProduct_apply', PiTensorProduct.map₂_tprod_tprod]

omit [CharZero K] in
theorem tensorMultiplicityEquiv_tprod (v : ι → W) (a : ι → U) :
    tensorMultiplicityEquiv K W U ι (tprod K v ⊗ₜ[K] tprod K a) =
      tprod K (fun i => v i ⊗ₜ[K] a i) := by
  change (tensorMultiplicityEquiv K W U ι).toLinearMap _ = _
  rw [tensorMultiplicityEquiv_toLinearMap]
  simp [Basis.tensorProduct_apply', PiTensorProduct.map₂_tprod_tprod]

omit [CharZero K] in
theorem tensorMultiplicityEquiv_tensorDer (f : Module.End K W)
    (t : (⨂[K] _ : ι, W) ⊗[K] (⨂[K] _ : ι, U)) :
    tensorDer ι (f.rTensor U) (tensorMultiplicityEquiv K W U ι t) =
      tensorMultiplicityEquiv K W U ι ((tensorDer ι f).rTensor _ t) := by
  suffices h : (tensorDer ι (f.rTensor U)).comp (tensorMultiplicityEquiv K W U ι).toLinearMap =
      (tensorMultiplicityEquiv K W U ι).toLinearMap.comp ((tensorDer ι f).rTensor _) from
    LinearMap.congr_fun h t
  apply ((Basis.piTensorProduct (fun _ : ι => Module.finBasis K W)).tensorProduct
    (Basis.piTensorProduct (fun _ : ι => Module.finBasis K U))).ext
  intro p
  simp only [LinearMap.comp_apply, LinearEquiv.coe_coe, Basis.tensorProduct_apply',
    Basis.piTensorProduct_apply, tensorMultiplicityEquiv_tprod, LinearMap.rTensor_tmul,
    tensorDer_tprod, TensorProduct.sum_tmul, map_sum]
  apply Finset.sum_congr rfl
  intro i _
  congr 1
  funext j
  by_cases hj : j = i
  · subst j; simp
  · simp [Function.update_of_ne hj]

example (w : W) (a : U) :
    tensorMultiplicityEquiv K W U (Fin 1)
      (tprod K (fun _ => w) ⊗ₜ[K] tprod K (fun _ => a)) =
      tprod K (fun _ => w ⊗ₜ[K] a) := tensorMultiplicityEquiv_tprod _ _

/-- Regroup both kinds of multiplicity slots, keeping `U` and `U'` separate.
Source: constructed here from Mathlib's tensor-factor commutation and `tensorMultiplicityEquiv`. -/
def mixedMultiplicityEquiv
    (U' κ : Type*) [AddCommGroup U'] [Module K U'] [FiniteDimensional K U']
    [Fintype κ] [DecidableEq κ] :
    MixedTensor K W ι κ ⊗[K] ((⨂[K] _ : ι, U) ⊗[K] (⨂[K] _ : κ, U')) ≃ₗ[K]
      (⨂[K] _ : ι, W ⊗[K] U) ⊗[K] (⨂[K] _ : κ, Module.Dual K W ⊗[K] U') :=
  (TensorProduct.tensorTensorTensorComm K _ _ _ _).trans
    (TensorProduct.congr (tensorMultiplicityEquiv K W U ι)
      (tensorMultiplicityEquiv K (Module.Dual K W) U' κ))

example (U' κ : Type*) [AddCommGroup U'] [Module K U'] [FiniteDimensional K U']
    [Fintype κ] [DecidableEq κ]
    (t : MixedTensor K W ι κ ⊗[K] ((⨂[K] _ : ι, U) ⊗[K] (⨂[K] _ : κ, U'))) :
    (mixedMultiplicityEquiv (K := K) (W := W) (U := U) (U' := U') (ι := ι) κ).symm
      (mixedMultiplicityEquiv (K := K) (W := W) (U := U) (U' := U') (ι := ι) κ t) = t :=
  LinearEquiv.symm_apply_apply _ t

variable {U' κ : Type*} [AddCommGroup U'] [Module K U'] [FiniteDimensional K U']
  [Fintype κ] [DecidableEq κ]

omit [CharZero K] in
/-- The regrouping is equivariant; the two multiplicity tensor powers are trivial factors. -/
theorem mixedMultiplicityEquiv_lie (f : Module.End K W)
    (t : MixedTensor K W ι κ ⊗[K] ((⨂[K] _ : ι, U) ⊗[K] (⨂[K] _ : κ, U'))) :
    mixedMultiplicityEquiv (K := K) (W := W) (U := U) (ι := ι) U' κ
      ((mixedLie K W ι κ f).rTensor _ t) =
    ((tensorDer ι (f.rTensor U)).rTensor (⨂[K] _ : κ, Module.Dual K W ⊗[K] U') +
      (tensorDer κ ((dualLie K W f).rTensor U')).lTensor (⨂[K] _ : ι, W ⊗[K] U))
      (mixedMultiplicityEquiv (K := K) (W := W) (U := U) (ι := ι) U' κ t) := by
  induction t using TensorProduct.inductionOn with
  | tmul z a =>
    induction z using TensorProduct.inductionOn with
    | tmul v w =>
      induction a using TensorProduct.inductionOn with
      | tmul u u' =>
        change mixedMultiplicityEquiv (K := K) (W := W) (U := U) (ι := ι) U' κ
          ((((tensorDer ι f).rTensor (⨂[K] _ : κ, Module.Dual K W) + (tensorDer κ (dualLie K W f)).lTensor (⨂[K] _ : ι, W))
            (v ⊗ₜ[K] w)) ⊗ₜ[K] (u ⊗ₜ[K] u')) = _
        simp only [LinearMap.rTensor_tmul, LinearMap.lTensor_tmul,
          LinearMap.add_apply, TensorProduct.add_tmul, TensorProduct.tmul_add, map_add,
          mixedMultiplicityEquiv, LinearEquiv.trans_apply,
          TensorProduct.tensorTensorTensorComm_tmul, TensorProduct.congr_tmul,
          tensorMultiplicityEquiv_tensorDer]
      | add a b ha hb => simp_all only [TensorProduct.tmul_add, map_add]
    | add a b ha hb => simp_all only [TensorProduct.add_tmul, map_add]
  | add a b ha hb => simp_all only [map_add]

end TensorMultiplicity

section SlotReindex

variable {ι κ ι' κ' : Type*}
  [Fintype ι] [DecidableEq ι] [Fintype κ] [DecidableEq κ]
  [Fintype ι'] [DecidableEq ι'] [Fintype κ'] [DecidableEq κ']

omit [CharZero K] in
/-- Relabelling tensor slots intertwines the derivation action. -/
theorem reindex_tensorDer (e : ι ≃ κ) (f : Module.End K M)
    (t : ⨂[K] _ : ι, M) :
    PiTensorProduct.reindex K (fun _ : ι => M) e (tensorDer ι f t) =
      tensorDer κ f (PiTensorProduct.reindex K (fun _ : ι => M) e t) := by
  suffices h : (PiTensorProduct.reindex K (fun _ : ι => M) e).toLinearMap.comp
      (tensorDer ι f) = (tensorDer κ f).comp
        (PiTensorProduct.reindex K (fun _ : ι => M) e).toLinearMap from
    LinearMap.congr_fun h t
  ext x
  simp only [LinearMap.compMultilinearMap_apply, LinearMap.comp_apply,
    LinearEquiv.coe_coe, tensorDer_tprod, map_sum, reindex_tprod]
  rw [← Equiv.sum_comp e]
  apply Finset.sum_congr rfl
  intro i _
  congr 1
  funext j
  by_cases h : e.symm j = i
  · have hj : j = e i := by simpa using congrArg e h
    subst j
    simp only [Equiv.symm_apply_apply, Function.update_self]
    exact congrArg (fun j => f (x j)) (e.symm_apply_apply i).symm
  · have hj : j ≠ e i := by
      intro hj
      apply h
      rw [hj, Equiv.symm_apply_apply]
    simp [Function.update_of_ne h, Function.update_of_ne hj]

variable {W : Type*} [AddCommGroup W] [Module K W]

/-- Independently relabel the vector and covector slots of a mixed tensor.
Source: Mathlib's `PiTensorProduct.reindex`, applied independently to both tensor factors. -/
def mixedReindex (e : ι ≃ ι') (d : κ ≃ κ') :
    MixedTensor K W ι κ ≃ₗ[K] MixedTensor K W ι' κ' :=
  TensorProduct.congr (PiTensorProduct.reindex K (fun _ : ι => W) e)
    (PiTensorProduct.reindex K (fun _ : κ => Module.Dual K W) d)

example (e : ι ≃ ι') (d : κ ≃ κ') (t : MixedTensor K W ι κ) :
    (mixedReindex (K := K) (W := W) e d).symm (mixedReindex e d t) = t :=
  LinearEquiv.symm_apply_apply _ t

omit [CharZero K] in
/-- Mixed-slot relabelling is equivariant for `gl(W)`, hence also for `sl(W)`. -/
theorem mixedReindex_lie (e : ι ≃ ι') (d : κ ≃ κ') (f : Module.End K W)
    (t : MixedTensor K W ι κ) :
    mixedReindex e d ⁅f, t⁆ = ⁅f, mixedReindex e d t⁆ := by
  induction t using TensorProduct.inductionOn with
  | tmul v w =>
    simp only [lie_mixedTensor, mixedLie_apply, LinearMap.sub_apply,
      LinearMap.rTensor_tmul, LinearMap.lTensor_tmul, map_sub, mixedReindex,
      TensorProduct.congr_tmul, reindex_tensorDer]
  | add x y hx hy => simp only [lie_add, map_add, hx, hy]

/-- Invariant membership is preserved and reflected by slot relabelling. -/
theorem mixedReindex_mem_invariants_iff (e : ι ≃ ι') (d : κ ≃ κ')
    (t : MixedTensor K W ι κ) :
    mixedReindex e d t ∈ LieModule.maxTrivSubmodule K (slEnd K W)
      (MixedTensor K W ι' κ') ↔
    t ∈ LieModule.maxTrivSubmodule K (slEnd K W) (MixedTensor K W ι κ) := by
  simp only [LieModule.mem_maxTrivSubmodule, LieSubalgebra.coe_bracket_of_module,
    ← mixedReindex_lie, map_eq_zero_iff _ (mixedReindex e d).injective]

/-- Transport an invariant spanning family along arbitrary slot bijections. -/
theorem mixedReindex_invariants_eq_span {A : Type*}
    (e : ι ≃ ι') (d : κ ≃ κ') (g : A → MixedTensor K W ι κ)
    (hg : (LieModule.maxTrivSubmodule K (slEnd K W) (MixedTensor K W ι κ) :
      Submodule K _) = Submodule.span K (Set.range g)) :
    (LieModule.maxTrivSubmodule K (slEnd K W) (MixedTensor K W ι' κ') :
      Submodule K _) = Submodule.span K (Set.range (fun a => mixedReindex e d (g a))) := by
  have hm : Submodule.map (mixedReindex (K := K) (W := W) e d).toLinearMap
      (LieModule.maxTrivSubmodule K (slEnd K W) (MixedTensor K W ι κ) : Submodule K _) =
      (LieModule.maxTrivSubmodule K (slEnd K W) (MixedTensor K W ι' κ') : Submodule K _) := by
    ext x
    constructor
    · rintro ⟨y, hy, rfl⟩
      exact (mixedReindex_mem_invariants_iff e d y).2 hy
    · intro hx
      obtain ⟨y, rfl⟩ := (mixedReindex (K := K) (W := W) e d).surjective x
      exact ⟨y, (mixedReindex_mem_invariants_iff e d y).1 hx, rfl⟩
  rw [← hm, hg, Submodule.map_span]
  congr 1
  ext x
  constructor
  · rintro ⟨y, ⟨a, rfl⟩, rfl⟩
    exact ⟨a, rfl⟩
  · rintro ⟨a, rfl⟩
    exact ⟨g a, ⟨a, rfl⟩, rfl⟩

variable [FiniteDimensional K W]

/-- T8(a), with extra covector slots in any finite index type of the required size. -/
theorem invariants_eq_span_detPow_reindex (m : ℕ)
    (d : (ι ⊕ Blocks (finrank K W) m) ≃ κ) :
    (LieModule.maxTrivSubmodule K (slEnd K W) (MixedTensor K W ι κ) : Submodule K _) =
      Submodule.span K (Set.range fun τ : Equiv.Perm (ι ⊕ Blocks (finrank K W) m) =>
        mixedReindex (Equiv.refl ι) d
          ((permRep K (Module.Dual K W) _ τ).lTensor _
            (extendDual (detPow K W m) (contraction K W ι 1)))) :=
  mixedReindex_invariants_eq_span (Equiv.refl ι) d _ (maxTriv_slEnd_eq_span_detPow ι m)

/-- T8(a), with extra vector slots in any finite index type of the required size. -/
theorem invariants_eq_span_detPowDual_reindex (m : ℕ)
    (e : (κ ⊕ Blocks (finrank K W) m) ≃ ι) :
    (LieModule.maxTrivSubmodule K (slEnd K W) (MixedTensor K W ι κ) : Submodule K _) =
      Submodule.span K (Set.range fun τ : Equiv.Perm (κ ⊕ Blocks (finrank K W) m) =>
        mixedReindex e (Equiv.refl κ)
          ((permRep K W _ τ).rTensor _
            (extendVec (detPowDual K W m) (contraction K W κ 1)))) :=
  mixedReindex_invariants_eq_span e (Equiv.refl κ) _ (maxTriv_slEnd_eq_span_detPowDual κ m)

/-- Equal vector and covector cardinalities give the relabelled contraction span. -/
theorem invariants_eq_span_contraction_reindex (d : ι ≃ κ) :
    (LieModule.maxTrivSubmodule K (slEnd K W) (MixedTensor K W ι κ) : Submodule K _) =
      Submodule.span K (Set.range fun τ : Equiv.Perm ι =>
        mixedReindex (Equiv.refl ι) d (contraction K W ι τ)) :=
  mixedReindex_invariants_eq_span (Equiv.refl ι) d _ maxTriv_slEnd_eq_span_contraction

/-- The cardinality condition supplies the slot bijection used by T8(a).
Source: constructed here from Mathlib's `Fintype.equivOfCardEq`. -/
def blockSlotEquiv (m : ℕ)
    (h : Fintype.card κ = Fintype.card ι + m * finrank K W) :
    (ι ⊕ Blocks (finrank K W) m) ≃ κ :=
  Fintype.equivOfCardEq (by simp only [Fintype.card_sum, card_blocks]; exact h.symm)

example (m : ℕ) (h : Fintype.card κ = Fintype.card ι + m * finrank K W) :
    Function.Bijective (blockSlotEquiv (K := K) (W := W) m h) :=
  (blockSlotEquiv (K := K) (W := W) m h).bijective

end SlotReindex

section OrderedWords

variable {V D : Type*} [AddCommGroup V] [Module K V] [AddCommGroup D] [Module K D]
  {ι κ : Type*} [Fintype ι] [DecidableEq ι] [Fintype κ] [DecidableEq κ]

/-- Embed an ordered colored word into the tensor power of the direct sum.
Source: constructed here from Mathlib's direct-sum inclusions and tensor-product maps. -/
def orderedWordIn :
    (⨂[K] _ : ι, V) ⊗[K] (⨂[K] _ : κ, D) →ₗ[K] (⨂[K] _ : ι ⊕ κ, V × D) :=
  (tmulEquiv K (V × D)).toLinearMap.comp
    (TensorProduct.map (PiTensorProduct.map (fun _ : ι => LinearMap.inl K V D))
      (PiTensorProduct.map (fun _ : κ => LinearMap.inr K V D)))

/-- Recover the vector and dual slots of an ordered colored word.
Source: constructed here from Mathlib's product projections and tensor-product maps. -/
def orderedWordOut :
    (⨂[K] _ : ι ⊕ κ, V × D) →ₗ[K] (⨂[K] _ : ι, V) ⊗[K] (⨂[K] _ : κ, D) :=
  (TensorProduct.map (PiTensorProduct.map (fun _ : ι => LinearMap.fst K V D))
      (PiTensorProduct.map (fun _ : κ => LinearMap.snd K V D))).comp
    (tmulEquiv K (V × D)).symm.toLinearMap

omit [CharZero K] in
/-- The ordered colored-word embedding is split injective. -/
theorem orderedWordOut_in (t : (⨂[K] _ : ι, V) ⊗[K] (⨂[K] _ : κ, D)) :
    orderedWordOut (orderedWordIn t) = t := by
  suffices h : (orderedWordOut (K := K) (V := V) (D := D) (ι := ι) (κ := κ)).comp
      orderedWordIn = LinearMap.id from LinearMap.congr_fun h t
  ext v w
  simp [orderedWordOut, orderedWordIn, tmulEquiv_apply, tmulEquiv_symm_apply]

omit [CharZero K] in
/-- Grouping an ordered colored word intertwines the two tensor derivations. -/
theorem tensorDer_orderedWordIn (f : Module.End K V) (g : Module.End K D)
    (t : (⨂[K] _ : ι, V) ⊗[K] (⨂[K] _ : κ, D)) :
    tensorDer (ι ⊕ κ) (f.prodMap g) (orderedWordIn t) =
      orderedWordIn (((tensorDer ι f).rTensor (⨂[K] _ : κ, D) + (tensorDer κ g).lTensor (⨂[K] _ : ι, V)) t) := by
  induction t using TensorProduct.inductionOn with
  | tmul v w =>
    have hl : ∀ _ : ι, (f.prodMap g).comp (LinearMap.inl K V D) =
        (LinearMap.inl K V D).comp f := by intro i; ext x <;> simp
    have hr : ∀ _ : κ, (f.prodMap g).comp (LinearMap.inr K V D) =
        (LinearMap.inr K V D).comp g := by intro i; ext x <;> simp
    simp only [orderedWordIn, LinearMap.comp_apply, TensorProduct.map_tmul,
      LinearEquiv.coe_coe, tensorDer_tmulEquiv, tensorDer_map f (f.prodMap g) _ hl,
      tensorDer_map g (f.prodMap g) _ hr, LinearMap.add_apply, LinearMap.rTensor_tmul,
      LinearMap.lTensor_tmul, map_add]
  | add a b ha hb => simp_all only [map_add]

/-- The colored component with vector slots first and covector slots second.
Source: constructed here by tensoring the two canonical product projections. -/
def orderedWordProjection : Module.End K (⨂[K] _ : ι ⊕ κ, V × D) :=
  PiTensorProduct.map (Sum.elim
    (fun _ : ι => (LinearMap.inl K V D).comp (LinearMap.fst K V D))
    (fun _ : κ => (LinearMap.inr K V D).comp (LinearMap.snd K V D)))

omit [CharZero K] in
/-- Grouping and then inserting recovers exactly the chosen colored component. -/
theorem orderedWordIn_out (t : ⨂[K] _ : ι ⊕ κ, V × D) :
    orderedWordIn (orderedWordOut t) = orderedWordProjection t := by
  suffices h : (orderedWordIn (K := K) (V := V) (D := D) (ι := ι) (κ := κ)).comp
      orderedWordOut = orderedWordProjection from LinearMap.congr_fun h t
  ext v
  simp only [orderedWordOut, orderedWordIn, orderedWordProjection, LinearMap.comp_apply,
    LinearMap.compMultilinearMap_apply, LinearEquiv.coe_coe, tmulEquiv_symm_apply,
    TensorProduct.map_tmul, map_tprod, tmulEquiv_apply]
  congr 1
  funext i
  cases i <;> rfl

omit [CharZero K] in
/-- Invariant colored tensors give invariant ordered mixed tensors, without semisimplicity. -/
theorem invariant_orderedWordOut (f : Module.End K V) (g : Module.End K D)
    (t : ⨂[K] _ : ι ⊕ κ, V × D) (ht : tensorDer (ι ⊕ κ) (f.prodMap g) t = 0) :
    ((tensorDer ι f).rTensor (⨂[K] _ : κ, D) + (tensorDer κ g).lTensor (⨂[K] _ : ι, V)) (orderedWordOut t) = 0 := by
  have hinj : Function.Injective
      (orderedWordIn (K := K) (V := V) (D := D) (ι := ι) (κ := κ)) :=
    Function.LeftInverse.injective orderedWordOut_in
  apply hinj
  rw [map_zero, ← tensorDer_orderedWordIn, orderedWordIn_out]
  have hc := tensorDer_map_commute (f.prodMap g)
    (Sum.elim (fun _ : ι => (LinearMap.inl K V D).comp (LinearMap.fst K V D))
      (fun _ : κ => (LinearMap.inr K V D).comp (LinearMap.snd K V D))) (by
        intro i
        cases i <;> ext x <;> simp)
  have he := LinearMap.congr_fun hc t
  simpa only [LinearMap.comp_apply, ht, map_zero, orderedWordProjection] using he

omit [CharZero K] in
/-- The projection to an ordered word intertwines the full derivation action. -/
theorem orderedWordOut_tensorDer (f : Module.End K V) (g : Module.End K D)
    (t : ⨂[K] _ : ι ⊕ κ, V × D) :
    orderedWordOut (tensorDer (ι ⊕ κ) (f.prodMap g) t) =
      ((tensorDer ι f).rTensor (⨂[K] _ : κ, D) +
        (tensorDer κ g).lTensor (⨂[K] _ : ι, V)) (orderedWordOut t) := by
  have hinj : Function.Injective
      (orderedWordIn (K := K) (V := V) (D := D) (ι := ι) (κ := κ)) :=
    Function.LeftInverse.injective orderedWordOut_in
  apply hinj
  rw [← tensorDer_orderedWordIn, orderedWordIn_out, orderedWordIn_out]
  have hc := tensorDer_map_commute (f.prodMap g)
    (Sum.elim (fun _ : ι => (LinearMap.inl K V D).comp (LinearMap.fst K V D))
      (fun _ : κ => (LinearMap.inr K V D).comp (LinearMap.snd K V D))) (by
        intro i
        cases i <;> ext x <;> simp)
  exact (LinearMap.congr_fun hc t).symm

end OrderedWords

section ColoredWords

variable {V D : Type*} [AddCommGroup V] [Module K V] [AddCommGroup D] [Module K D]
  {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- Insert a word with vector slots `s` and dual slots its complement.
Source: constructed here by reindexing `orderedWordIn` along `Equiv.sumCompl`. -/
def coloredWordIn (s : Finset ι) :
    (⨂[K] _ : {i // i ∈ s}, V) ⊗[K] (⨂[K] _ : {i // i ∉ s}, D) →ₗ[K]
      (⨂[K] _ : ι, V × D) :=
  (PiTensorProduct.reindex K (fun _ => V × D) (Equiv.sumCompl (· ∈ s))).toLinearMap.comp
    orderedWordIn

/-- Group a colored word into its vector slots and its dual slots.
Source: constructed here by reindexing `orderedWordOut` along `Equiv.sumCompl`. -/
def coloredWordOut (s : Finset ι) :
    (⨂[K] _ : ι, V × D) →ₗ[K]
      (⨂[K] _ : {i // i ∈ s}, V) ⊗[K] (⨂[K] _ : {i // i ∉ s}, D) :=
  orderedWordOut.comp
    (PiTensorProduct.reindex K (fun _ : ι => V × D) (Equiv.sumCompl (· ∈ s)).symm).toLinearMap

omit [CharZero K] in
/-- The split maps recover precisely the complementary-slot component. -/
theorem coloredWordIn_out (s : Finset ι) (t : ⨂[K] _ : ι, V × D) :
    coloredWordIn s (coloredWordOut s t) =
      PiTensorProduct.map (s.piecewise
        (fun _ => (LinearMap.inl K V D).comp (LinearMap.fst K V D))
        (fun _ => (LinearMap.inr K V D).comp (LinearMap.snd K V D))) t := by
  suffices h : (coloredWordIn (K := K) (V := V) (D := D) s).comp (coloredWordOut s) =
      PiTensorProduct.map (s.piecewise
        (fun _ => (LinearMap.inl K V D).comp (LinearMap.fst K V D))
        (fun _ => (LinearMap.inr K V D).comp (LinearMap.snd K V D))) from
    LinearMap.congr_fun h t
  ext v
  simp only [coloredWordIn, coloredWordOut, LinearMap.compMultilinearMap_apply,
    LinearMap.comp_apply, LinearEquiv.coe_coe, reindex_tprod, Equiv.symm_symm,
    orderedWordOut, orderedWordIn, tmulEquiv_symm_apply, TensorProduct.map_tmul,
    map_tprod, tmulEquiv_apply, reindex_tprod]
  congr 1
  funext i
  by_cases hi : i ∈ s
  · simp [Equiv.sumCompl_symm_apply_of_pos hi, hi]
  · simp [Equiv.sumCompl_symm_apply_of_neg hi, hi]

omit [CharZero K] in
/-- Every tensor is the sum of its grouped colored words. -/
theorem sum_coloredWordIn_out (t : ⨂[K] _ : ι, V × D) :
    ∑ s : Finset ι, coloredWordIn s (coloredWordOut s t) = t := by
  simp_rw [coloredWordIn_out]
  have h := LinearMap.congr_fun (sum_tensor_words (ι := ι)
    ((LinearMap.inl K V D).comp (LinearMap.fst K V D))
    ((LinearMap.inr K V D).comp (LinearMap.snd K V D)) (by ext x <;> simp)) t
  simpa only [LinearMap.sum_apply, Module.End.one_apply] using h

omit [CharZero K] in
/-- Grouping any coloring preserves invariance for the block-diagonal action. -/
theorem invariant_coloredWordOut (s : Finset ι) (f : Module.End K V) (g : Module.End K D)
    (t : ⨂[K] _ : ι, V × D) (ht : tensorDer ι (f.prodMap g) t = 0) :
    ((tensorDer {i // i ∈ s} f).rTensor (⨂[K] _ : {i // i ∉ s}, D) +
      (tensorDer {i // i ∉ s} g).lTensor (⨂[K] _ : {i // i ∈ s}, V))
        (coloredWordOut s t) = 0 := by
  apply invariant_orderedWordOut
  have he := reindex_tensorDer (K := K) (M := V × D)
    (Equiv.sumCompl (· ∈ s)).symm (f.prodMap g) t
  rw [ht, map_zero] at he
  exact he.symm

omit [CharZero K] in
/-- The grouping for an arbitrary coloring is equivariant for the full action. -/
theorem coloredWordOut_tensorDer (s : Finset ι) (f : Module.End K V) (g : Module.End K D)
    (t : ⨂[K] _ : ι, V × D) :
    coloredWordOut s (tensorDer ι (f.prodMap g) t) =
      ((tensorDer {i // i ∈ s} f).rTensor (⨂[K] _ : {i // i ∉ s}, D) +
        (tensorDer {i // i ∉ s} g).lTensor (⨂[K] _ : {i // i ∈ s}, V))
          (coloredWordOut s t) := by
  change orderedWordOut ((PiTensorProduct.reindex K (fun _ : ι => V × D)
    (Equiv.sumCompl (· ∈ s)).symm) (tensorDer ι (f.prodMap g) t)) = _
  rw [reindex_tensorDer, orderedWordOut_tensorDer]
  rfl

end ColoredWords

section ColoredMultiplicities

variable {W U U' : Type*} [AddCommGroup W] [Module K W] [FiniteDimensional K W]
  [AddCommGroup U] [Module K U] [FiniteDimensional K U]
  [AddCommGroup U'] [Module K U'] [FiniteDimensional K U']
  {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- The grouped mixed tensor and its two distinct multiplicity factors for one coloring.
Source: constructed here for the colored-word decomposition used in F-1575 (1). -/
abbrev ColoredMultiplicityTensor (s : Finset ι) :=
  MixedTensor K W {i // i ∈ s} {i // i ∉ s} ⊗[K]
    ((⨂[K] _ : {i // i ∈ s}, U) ⊗[K] (⨂[K] _ : {i // i ∉ s}, U'))

/-- Include a grouped mixed tensor with multiplicities into its colored summand.
Source: constructed here from `mixedMultiplicityEquiv` and `coloredWordIn`. -/
def coloredMultiplicityIn (s : Finset ι) :
    ColoredMultiplicityTensor (K := K) (W := W) (U := U) (U' := U') s →ₗ[K]
      (⨂[K] _ : ι, Space K W U U') :=
  (coloredWordIn s).comp
    (mixedMultiplicityEquiv (K := K) (W := W) (U := U) U' {i // i ∉ s}).toLinearMap

/-- Group any colored component as mixed tensors tensored with trivial multiplicities.
Source: constructed here from `coloredWordOut` and the inverse of `mixedMultiplicityEquiv`. -/
def coloredMultiplicityOut (s : Finset ι) :
    (⨂[K] _ : ι, Space K W U U') →ₗ[K]
      ColoredMultiplicityTensor (K := K) (W := W) (U := U) (U' := U') s :=
  (mixedMultiplicityEquiv (K := K) (W := W) (U := U) U' {i // i ∉ s}).symm.toLinearMap.comp
    (coloredWordOut s)

/-- Grouping and re-inserting all colorings recovers the original tensor. -/
theorem sum_coloredMultiplicityIn_out (t : ⨂[K] _ : ι, Space K W U U') :
    ∑ s : Finset ι, coloredMultiplicityIn s (coloredMultiplicityOut s t) = t := by
  simpa only [coloredMultiplicityIn, coloredMultiplicityOut, LinearMap.comp_apply,
    LinearEquiv.coe_coe, LinearEquiv.apply_symm_apply] using sum_coloredWordIn_out t

/-- Each grouped colored component of an invariant tensor is a mixed invariant with
trivial multiplicity factors. This is the `gl(W)`-equivariant colored-word reduction. -/
theorem invariant_coloredMultiplicityOut (s : Finset ι) (f : Module.End K W)
    (t : ⨂[K] _ : ι, Space K W U U')
    (ht : tensorDer ι (multiplicityLie K W U U' f) t = 0) :
    (mixedLie K W {i // i ∈ s} {i // i ∉ s} f).rTensor
      ((⨂[K] _ : {i // i ∈ s}, U) ⊗[K] (⨂[K] _ : {i // i ∉ s}, U'))
      (coloredMultiplicityOut s t) = 0 := by
  apply (mixedMultiplicityEquiv (K := K) (W := W) (U := U)
    (ι := {i // i ∈ s}) U' {i // i ∉ s}).injective
  rw [map_zero, mixedMultiplicityEquiv_lie]
  simp only [coloredMultiplicityOut, LinearMap.comp_apply,
    LinearEquiv.coe_coe, LinearEquiv.apply_symm_apply]
  exact invariant_coloredWordOut s (f.rTensor U) ((dualLie K W f).rTensor U') t ht

/-- Full `gl(W)` equivariance of grouping a colored tensor with its multiplicities. -/
theorem coloredMultiplicityOut_tensorDer (s : Finset ι) (f : Module.End K W)
    (t : ⨂[K] _ : ι, Space K W U U') :
    coloredMultiplicityOut s (tensorDer ι (multiplicityLie K W U U' f) t) =
      (mixedLie K W {i // i ∈ s} {i // i ∉ s} f).rTensor
        ((⨂[K] _ : {i // i ∈ s}, U) ⊗[K] (⨂[K] _ : {i // i ∉ s}, U'))
        (coloredMultiplicityOut s t) := by
  apply (mixedMultiplicityEquiv (K := K) (W := W) (U := U)
    (ι := {i // i ∈ s}) U' {i // i ∉ s}).injective
  rw [mixedMultiplicityEquiv_lie]
  simp only [coloredMultiplicityOut, LinearMap.comp_apply,
    LinearEquiv.coe_coe, LinearEquiv.apply_symm_apply]
  exact coloredWordOut_tensorDer s (f.rTensor U) ((dualLie K W f).rTensor U') t

set_option maxHeartbeats 800000 in
/-- The remaining block-image obligation suffices for the reverse inclusion.
The premise concerns only mixed-tensor invariants with a trivial multiplicity factor;
T8(a) and `mixedReindex_invariants_eq_span` supply their spanning families. -/
theorem invariants_le_generatedDegree_of_colored_images (k : ℕ)
    (himages : ∀ (s : Finset (Fin k))
      (v : MixedTensor K W {i // i ∈ s} {i // i ∉ s}),
      v ∈ LieModule.maxTrivSubmodule K (slEnd K W)
        (MixedTensor K W {i // i ∈ s} {i // i ∉ s}) →
      ∀ a : (⨂[K] _ : {i // i ∈ s}, U) ⊗[K] (⨂[K] _ : {i // i ∉ s}, U'),
        wedgeQuotient k (coloredMultiplicityIn s (v ⊗ₜ[K] a)) ∈ generatedDegree k) :
    (LieModule.maxTrivSubmodule K (slEnd K W) (⋀[K]^k (Space K W U U')) : Submodule K _) ≤
      generatedDegree (K := K) (W := W) (U := U) (U' := U') k := by
  intro v hv
  change ∀ f : slEnd K W, ⁅f, v⁆ = 0 at hv
  let t := (k.factorial : K)⁻¹ • exteriorPower.toTensorPower K (Space K W U U') k v
  have hq : wedgeQuotient k t = v := by
    simp only [t, map_smul, wedgeQuotient_toTensorPower, smul_smul]
    rw [inv_mul_cancel₀ (by exact_mod_cast k.factorial_ne_zero), one_smul]
  have ht (f : slEnd K W) : tensorDer (Fin k) (multiplicityLie K W U U' f) t = 0 := by
    have hh := hv f
    rw [LieSubalgebra.coe_bracket_of_module] at hh
    simp only [t, map_smul, ← toTensorPower_lie, hh, map_zero, smul_zero]
  rw [← hq, ← sum_coloredMultiplicityIn_out t, map_sum]
  apply Submodule.sum_mem
  intro s _
  let S : Set (Module.End K (MixedTensor K W {i // i ∈ s} {i // i ∉ s})) :=
    Set.range (fun f : slEnd K W => mixedLie K W {i // i ∈ s} {i // i ∉ s} f)
  have hz : ∀ f ∈ S, f.rTensor
      ((⨂[K] _ : {i // i ∈ s}, U) ⊗[K] (⨂[K] _ : {i // i ∉ s}, U'))
      (coloredMultiplicityOut s t) = 0 := by
    rintro _ ⟨f, rfl⟩
    exact invariant_coloredMultiplicityOut (K := K) (W := W) (U := U) (U' := U')
      (ι := Fin k) s (f : Module.End K W) t (ht f)
  have hs := (invariant_rTensor_iff_mem_span (K := K)
    (V := MixedTensor K W {i // i ∈ s} {i // i ∉ s})
    (T := (⨂[K] _ : {i // i ∈ s}, U) ⊗[K] (⨂[K] _ : {i // i ∉ s}, U'))
    S (coloredMultiplicityOut s t)).1 hz
  generalize hzdef : coloredMultiplicityOut s t = z at hs ⊢
  clear hzdef
  induction hs using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨⟨w, a⟩, rfl⟩ := hx
    apply himages s w.val
    rw [LieModule.mem_maxTrivSubmodule]
    intro f
    rw [LieSubalgebra.coe_bracket_of_module, lie_mixedTensor]
    exact w.property _ ⟨f, rfl⟩
  | zero => simp only [map_zero]; exact Submodule.zero_mem _
  | add x y _ _ hx hy => simp only [map_add]; exact Submodule.add_mem _ hx hy
  | smul c x _ hx => simp only [map_smul]; exact Submodule.smul_mem _ c hx

end ColoredMultiplicities

end HodgeLean.Foundations.InvariantsExterior
