import HodgeLean.Foundations.DirectSumInvariants
import HodgeLean.Foundations.InvariantsExteriorBlocks

/-! # Several blocks of the first fundamental theorem (FROZEN DEFINITIONS)

Stage A3b of the Powers flagship (`docs/roadmap/pw-flagship-plan.md`, §4.2 row A3b). For a family of
blocks `v : ι`, each with spaces `W v`, `U v`, `U' v`, two definitions:

* `MultiSpace K W U U' = Π_v Space K (W v) (U v) (U' v)`, the direct sum of the blocks' F-1575
  spaces `(W_v ⊗ U_v) ⊕ (W_v^∨ ⊗ U'_v)`;
* `MultiGeneratorProduct k x`: `x ∈ ⋀^k (Π_v Space_v)` is a `∧`-product, in any order, of images
  `⋀(ι_v) g` of per-block generator products `g` (`InvariantsExterior.GeneratorProduct`), where
  `ι_v = LinearMap.single` includes block `v`; and `multiGeneratedDegree k`, their span.

These are constructions only: that `multiGeneratedDegree k` is the space of invariants of
`⊕_v 𝔰𝔩(W_v)` is claimed in `MultiBlockInvariants.lean`, not here.
HC no distance; AV milestone no distance.
-/

noncomputable section
attribute [local instance 100] LieRing.ofAssociativeRing
attribute [local instance] HodgeLean.Foundations.SchurWeyl.dualAddCommGroup
open scoped TensorProduct
namespace HodgeLean.Foundations
open InvariantsExterior SchurWeyl

variable {K : Type*} [Field K]
variable {ι : Type*} {W U U' : ι → Type*}
  [∀ v, AddCommGroup (W v)] [∀ v, Module K (W v)]
  [∀ v, AddCommGroup (U v)] [∀ v, Module K (U v)]
  [∀ v, AddCommGroup (U' v)] [∀ v, Module K (U' v)]

variable (K W U U') in
/-- The direct sum of the blocks' spaces, `Π_v (W_v ⊗ U_v) × (W_v^∨ ⊗ U'_v)`.
Source: PW v0.3, proof of Theorem 4.2, "Derived group" step (the derived group `∏_v SL(W_v)` acts
on `⋀ (⊕_v Space_v)`); F-1575 (1) for each block. -/
abbrev MultiSpace := (v : ι) → Space K (W v) (U v) (U' v)

example (v : ι) (x : MultiSpace K W U U') : Space K (W v) (U v) (U' v) := x v

variable [DecidableEq ι] [∀ v, FiniteDimensional K (W v)]

/-- `∧`-products, in any order, of the images of per-block generator products. A block `v`
enters through `⋀(ι_v)`, `ι_v = LinearMap.single` the inclusion of `Space_v` in `Π_v Space_v`.
Source: PW v0.3, proof of Theorem 4.2, "Derived group" step (the invariants of `∏_v SL(W_v)` are
generated by the per-block invariants); F-1575 (1) for the per-block generators. -/
inductive MultiGeneratorProduct : (k : ℕ) → ⋀[K]^k (MultiSpace K W U U') → Prop
  | unit : MultiGeneratorProduct 0 (exteriorPower.ιMulti K 0 Fin.elim0)
  | block (v : ι) {k : ℕ} {g : ⋀[K]^k (Space K (W v) (U v) (U' v))} :
      GeneratorProduct k g →
      MultiGeneratorProduct k
        (exteriorPower.map k (LinearMap.single K (fun v => Space K (W v) (U v) (U' v)) v) g)
  | wedge {k l : ℕ} {x : ⋀[K]^k (MultiSpace K W U U')} {y : ⋀[K]^l (MultiSpace K W U U')} :
      MultiGeneratorProduct k x → MultiGeneratorProduct l y →
      MultiGeneratorProduct (k + l) (exteriorPower.wedge K _ k l x y)

/-- The degree-`k` span of the `MultiGeneratorProduct`s.
Source: PW v0.3, proof of Theorem 4.2, "Derived group" step; the homogeneous part of the algebra
generated by the per-block F-1575 (1) generators. -/
def multiGeneratedDegree (k : ℕ) : Submodule K (⋀[K]^k (MultiSpace K W U U')) :=
  Submodule.span K {x | MultiGeneratorProduct k x}

example (v : ι) (a : U v) (a' : U' v) :
    exteriorPower.map 2 (LinearMap.single K (fun v => Space K (W v) (U v) (U' v)) v)
        (theta a a') ∈ multiGeneratedDegree (K := K) (W := W) (U := U) (U' := U') 2 :=
  Submodule.subset_span (MultiGeneratorProduct.block v (GeneratorProduct.theta a a'))

end HodgeLean.Foundations
