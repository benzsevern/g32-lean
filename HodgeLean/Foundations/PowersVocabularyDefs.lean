import HodgeLean.Foundations.EQWCoreDefs
import HodgeLean.Foundations.WeilPowerSpan

/-! # Vocabulary for the Powers flagship, stage PW-0 (FROZEN DEFINITIONS)

Definitions for `PowersVocabulary`, the first stage of formalizing PW v0.3, Theorem 4.2
(`thm:gen`), "Hodge classes on powers of abelian varieties of Weil type and of type IV with
exact endomorphism algebra" (doi:10.5281/zenodo.23570103):

* `gkLie E R J`, the rational Lie algebra of `G_k(A) = Lef(A) ∩ SL_k(V)`: endomorphisms commuting
  with a subalgebra `R` (the image of `L = End⁰(A)`) and with `J` (the image of `u`, `k = ℚ(u)`),
  `E`-skew, with vanishing `k`-trace (`tr X = 0` and `tr (J X) = 0`). At `R = ℚ[J]` it is EQW's
  `weilSU E J`.
* `HodgeLieIsGk H hH E R J`, the Lie-algebra form of the paper's hypothesis (P3),
  `Hg(A) = G_k(A)`: the complexified Hodge Lie algebra equals the complexified `gkLie`.
* `cmPowerPullback R a`, the degree-one pullback along `f_a : A^r → A`, `(x_i) ↦ Σ a_i x_i`, for
  coefficients `a_i ∈ R`, in the model `V → V ⊗ ℚ^r`.
* `IsCMPowerClosed` and `cmPowerSpan R D W`, the graded span generated by `1`, the degree-two
  space `D` and the pullbacks of `W` along every `cmPowerPullback R a`, closed under wedge
  product. At `R = ℚ[J]` with `J² ∈ ℚ` it is `divisorPulledWeilSpan`.

No definition asserts a generation, Hodge or algebraicity result. HC no distance; AV milestone
no distance.
-/

noncomputable section
attribute [local instance 100] LieRing.ofAssociativeRing

namespace HodgeLean.Foundations

open WeilPower
open scoped TensorProduct

variable {V : Type*} [AddCommGroup V] [Module ℚ V]

/-- The rational Lie algebra of `G_k(A)`: endomorphisms `X` of `V` that commute with every element
of the subalgebra `R` (the image of the CM field `L`) and with `J` (the image of `u`,
`k = ℚ(u) ⊆ L`), are skew for `E`, and have `tr X = 0` and `tr (J X) = 0`. The first two conditions
cut out `Lie(Lef(A)) = Lie(Res_{F/ℚ} U(h₀))`; for `X` commuting with `J` the two trace conditions
say that the `k`-linear trace of `X` vanishes, which is `Lie(SL_k(V))`.
Source: PW v0.3, Subsection 2.3 (the paragraph after Lemma 2.1: `G_k(A) = Lef(A) ∩ SL_k(V)`,
`Lef(A) = Res_{F/ℚ} U(h₀)`); Murty, *Hodge and Weil classes on abelian varieties*, Prop. 3.8 and
§3 (the Lefschetz group as the centralizer of `End⁰(A)` in the symplectic group). -/
def gkLie (E : LinearMap.BilinForm ℚ V) (R : Subalgebra ℚ (Module.End ℚ V))
    (J : Module.End ℚ V) : LieSubalgebra ℚ (Module.End ℚ V) where
  carrier := {X | X ∈ weilSU E J ∧ ∀ r ∈ R, X * r = r * X}
  add_mem' := by
    rintro X Y ⟨hX, hXR⟩ ⟨hY, hYR⟩
    refine ⟨(weilSU E J).add_mem hX hY, fun r hr => ?_⟩
    rw [add_mul, mul_add, hXR r hr, hYR r hr]
  zero_mem' := ⟨(weilSU E J).zero_mem, fun r _ => by rw [zero_mul, mul_zero]⟩
  smul_mem' := by
    rintro c X ⟨hX, hXR⟩
    refine ⟨(weilSU E J).smul_mem c hX, fun r hr => ?_⟩
    rw [smul_mul_assoc, hXR r hr, mul_smul_comm]
  lie_mem' := by
    rintro X Y ⟨hX, hXR⟩ ⟨hY, hYR⟩
    refine ⟨(weilSU E J).lie_mem hX hY, fun r hr => ?_⟩
    rw [Ring.lie_def, sub_mul, mul_sub, mul_assoc, hYR r hr, ← mul_assoc, hXR r hr,
      mul_assoc Y, hXR r hr, ← mul_assoc, hYR r hr, mul_assoc, mul_assoc]

example (E : LinearMap.BilinForm ℚ V) (R : Subalgebra ℚ (Module.End ℚ V))
    (J : Module.End ℚ V) : gkLie E R J ≤ weilSU E J :=
  fun _ hX => hX.1

/-- **The Lie-algebra form of the paper's hypothesis (P3), `Hg(A) = G_k(A)`**: the complexified
Hodge Lie algebra (`hodgeLieAlgebra = rationalLieHull` of the grading operator, the repository's
substitute for `Lie(Hg(A))`) equals the complexification of `gkLie E R J`. It is an equality of
two complex subspaces of `End_ℂ (ℂ ⊗ V)`, a standard notion, and states no conclusion of
Theorem 4.2. It is not tagged.

Consistency and non-vacuity: at `R = ℚ[J]`, `J² = -3`, it is equivalent to the hypothesis `hSU`
of `exteriorHodgeClasses_eq_generated` (`spec_pw0_hodgeLieIsGk_adjoin_iff`), and it fails on the
CM structure `hsuCMHodge` (`spec_pw0_not_hodgeLieIsGk_hsuCMHodge`), so it is neither automatic nor
contradictory as a shape.
Source: PW v0.3, Theorem 4.2, hypothesis `Hg(A) = G_k(A)`, and Remark 4.3 (it is used only
through (H1)); Moonen, *An introduction to Mumford–Tate groups* (2004), §1–2 (the Hodge group and
its Lie algebra). -/
def HodgeLieIsGk (H : ℤ × ℤ → Submodule ℂ (ℂ ⊗[ℚ] V)) (hH : DirectSum.IsInternal H)
    (E : LinearMap.BilinForm ℚ V) (R : Subalgebra ℚ (Module.End ℚ V))
    (J : Module.End ℚ V) : Prop :=
  complexSpan (hodgeLieAlgebra H hH).toSubmodule = complexSpan (gkLie E R J).toSubmodule

example (H : ℤ × ℤ → Submodule ℂ (ℂ ⊗[ℚ] V)) (hH : DirectSum.IsInternal H)
    (E : LinearMap.BilinForm ℚ V) (R : Subalgebra ℚ (Module.End ℚ V)) (J : Module.End ℚ V) :
    HodgeLieIsGk H hH E R J ↔
      complexSpan (hodgeLieAlgebra H hH).toSubmodule = complexSpan (gkLie E R J).toSubmodule :=
  Iff.rfl

/-- The degree-one pullback along `f_a : A^r → A`, `(x_i) ↦ Σ a_i x_i`, with coefficients
`a_i ∈ R`, in the model `H¹(A^r) = V ⊗ ℚ^r`: `x ↦ Σ_i a_i x ⊗ e_i`.
Source: PW v0.3, Theorem 4.2 (the maps `f_a`, `a ∈ 𝒪^r`) and its proof, paragraph "Weil
classes"; F-1575 / TR54 §3 (the case `R = ℚ[J]`, `weilPowerPullback`). -/
def cmPowerPullback (R : Subalgebra ℚ (Module.End ℚ V)) {m : ℕ} (a : Fin m → R) :
    V →ₗ[ℚ] V ⊗[ℚ] (Fin m → ℚ) :=
  ∑ i, ((TensorProduct.mk ℚ V (Fin m → ℚ)).flip (Pi.single i 1)).comp
    (a i : Module.End ℚ V)

example (R : Subalgebra ℚ (Module.End ℚ V)) {m : ℕ} (a : Fin m → R) (x : V) :
    cmPowerPullback R a x = ∑ i, (a i : Module.End ℚ V) x ⊗ₜ[ℚ] (Pi.single i 1 : Fin m → ℚ) := by
  simp [cmPowerPullback]

/-- A graded family containing the unit, the degree-two space `D`, and the pullbacks of the
original Weil space `W` along `cmPowerPullback R a` for every `a : Fin m → R`, closed under wedge
product. The same shape as `IsDivisorPulledWeilClosed`, with `R`-coefficients.
Source: PW v0.3, Theorem 4.2 and its proof, paragraph "Conclusion" (the algebra `𝓑`).

Consistency and non-vacuity: the family constantly equal to the full space satisfies these
closure conditions for every input. This is an untagged closure predicate, not a generation or
algebraicity hypothesis. -/
structure IsCMPowerClosed (R : Subalgebra ℚ (Module.End ℚ V)) {m n : ℕ}
    (D : Submodule ℚ (⋀[ℚ]^2 (V ⊗[ℚ] (Fin m → ℚ))))
    (W : Submodule ℚ (⋀[ℚ]^n V))
    (F : ∀ k, Submodule ℚ (⋀[ℚ]^k (V ⊗[ℚ] (Fin m → ℚ)))) : Prop where
  unit_mem : exteriorPower.ιMulti ℚ 0 Fin.elim0 ∈ F 0
  divisor_le : D ≤ F 2
  pullback_mem : ∀ (a : Fin m → R) w, w ∈ W → exteriorPower.map n (cmPowerPullback R a) w ∈ F n
  wedge_mem : ∀ i j v w, v ∈ F i → w ∈ F j → exteriorPower.wedge ℚ _ i j v w ∈ F (i + j)

example (R : Subalgebra ℚ (Module.End ℚ V)) {m n : ℕ}
    (D : Submodule ℚ (⋀[ℚ]^2 (V ⊗[ℚ] (Fin m → ℚ))))
    (W : Submodule ℚ (⋀[ℚ]^n V)) :
    IsCMPowerClosed R D W (fun _ => ⊤) := by
  constructor
  · trivial
  · exact le_top
  · intros; trivial
  · intros; trivial

/-- The rational span, in degree `k`, generated by `1`, the degree-two space `D` and the pullbacks
of `W` along every `cmPowerPullback R a`, under wedge product: the least `IsCMPowerClosed` family.
For the Hodge application take `D = rationalExteriorHodge H hH m 2` and `W` the original rational
Weil space; the Weil generators keep their degree `n`.
Source: PW v0.3, Theorem 4.2 and its proof, paragraph "Conclusion" (the algebra `𝓑` generated by
the divisor classes and the planes `f_a^* W_k(A)`). -/
def cmPowerSpan (R : Subalgebra ℚ (Module.End ℚ V)) {m n : ℕ}
    (D : Submodule ℚ (⋀[ℚ]^2 (V ⊗[ℚ] (Fin m → ℚ))))
    (W : Submodule ℚ (⋀[ℚ]^n V)) (k : ℕ) :
    Submodule ℚ (⋀[ℚ]^k (V ⊗[ℚ] (Fin m → ℚ))) :=
  ⨅ (F : ∀ i, Submodule ℚ (⋀[ℚ]^i (V ⊗[ℚ] (Fin m → ℚ))))
    (_ : IsCMPowerClosed R D W F), F k

example (R : Subalgebra ℚ (Module.End ℚ V)) {m n : ℕ}
    (D : Submodule ℚ (⋀[ℚ]^2 (V ⊗[ℚ] (Fin m → ℚ))))
    (W : Submodule ℚ (⋀[ℚ]^n V)) (k : ℕ) :
    cmPowerSpan R D W k ≤ ⊤ :=
  le_top

end HodgeLean.Foundations
