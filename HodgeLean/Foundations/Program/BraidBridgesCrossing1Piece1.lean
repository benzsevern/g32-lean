  have h1 := b65x_certFactors_ne_zero_1_1 t ht 2
  have h2 := b65x_certFactors_ne_zero_1_1 t ht 3
  change b65x_cpEval b65x_certD_1_1 t ≠ 0 at h0
  change b65x_cpEval (b65x_cpSub b65x_certN_1_1 b65x_certD_1_1) t ≠ 0 at h1
  change b65x_cpEval (b65x_cpAdd b65x_certN_1_1 (b65x_cpScale 2 b65x_certD_1_1)) t ≠ 0 at h2
  rw [b65x_cpEval_sub] at h1
  rw [b65x_cpEval_add, b65x_cpEval_scale] at h2
