    0 < ((-b65x_crossX_1_2_2)).eval₂ (Rat.castHom ℝ) t := by

  exact b65x_bernstein_interval_eval_pos _ (-1) (1) (by norm_num)
    24 b65x_signCoeff_1_2_2_0 b65x_signIdentity_1_2_2_0 b65x_signCoeff_positive_1_2_2_0
    t (by push_cast at *; constructor <;> linarith [ht.1, ht.2])

theorem b65x_exhaust_1_2_2 (t : ℝ) (ht : t ∈ b65x_dom 2)
    (hcut : b65x_OnCut 2 (b65x_down 1 2 t)) :
    ∃ c ∈ b65x_crossings 1 2, c.cut = 2 ∧ t ∈ Set.Icc (c.lo : ℝ) c.hi := by
  have hz := (b65x_cross_signs_1_2_2 t ht).1.mp hcut.1
  have hn := (b65x_cross_signs_1_2_2 t ht).2.2.2.1.mp hcut.2
  change t ∈ Set.Icc (-1 : ℝ) (1) at ht

  have hp := b65x_signPositive_1_2_2 t (by push_cast at *; constructor <;> linarith [ht.1, ht.2])

  rw [Polynomial.eval₂_neg, hz] at hp
  linarith

theorem b65x_piece_crossings_1_2 :
    (∀ m m' : Fin (b65x_crossings 1 2).length, m < m' →
      (b65x_crossings 1 2)[m].hi < (b65x_crossings 1 2)[m'].lo) ∧
    (∀ c ∈ b65x_crossings 1 2,
      (c.lo : ℝ) ∈ b65x_dom 2 ∧ (c.hi : ℝ) ∈ b65x_dom 2 ∧ c.lo < c.hi ∧
      (c.dir = 1 ∨ c.dir = -1) ∧
      (∀ t ∈ Set.Icc (c.lo : ℝ) c.hi, (b65x_down 1 2 t).im < 0) ∧
      (∃! t, t ∈ Set.Icc (c.lo : ℝ) c.hi ∧
        (b65x_down 1 2 t).re = b65x_cutPoint c.cut) ∧
      (c.dir : ℝ) * ((b65x_down 1 2 c.lo).re - b65x_cutPoint c.cut) < 0 ∧
      0 < (c.dir : ℝ) * ((b65x_down 1 2 c.hi).re - b65x_cutPoint c.cut)) ∧
    ∀ t ∈ b65x_dom 2, ∀ j : Fin 3, b65x_OnCut j (b65x_down 1 2 t) →
      ∃ c ∈ b65x_crossings 1 2, c.cut = j ∧ t ∈ Set.Icc (c.lo : ℝ) c.hi := by
  refine ⟨?_, ?_, ?_⟩
  · intro m m' hm
    fin_cases m <;> fin_cases m' <;> norm_num [b65x_crossings] at *
  · intro c hc

    norm_num [b65x_crossings] at hc

  · intro t ht j hcut
    fin_cases j

    · exact b65x_exhaust_1_2_0 t ht hcut

    · exact b65x_exhaust_1_2_1 t ht hcut

    · exact b65x_exhaust_1_2_2 t ht hcut

