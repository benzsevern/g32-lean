  have h4 := b65x_certFactors_ne_zero_1_2 t ht 4

  have h5 := b65x_certFactors_ne_zero_1_2 t ht 5

  change b65x_cpEval b65x_certD_1_2 t ≠ 0 at h0
  change b65x_cpEval (b65x_cpSub b65x_certN_1_2 (b65x_cpScale 3 b65x_certD_1_2)) t ≠ 0 at h1
  change b65x_cpEval (b65x_cpSub b65x_certN_1_2 b65x_certD_1_2) t ≠ 0 at h2
  change b65x_cpEval (b65x_cpAdd b65x_certN_1_2 (b65x_cpScale 2 b65x_certD_1_2)) t ≠ 0 at h3
  change b65x_cpEval b65x_certP5_1_2 t ≠ 0 at h4
  change b65x_cpEval b65x_certP7_1_2 t ≠ 0 at h5
  norm_num only [b65x_certFactors_1_2, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.cons_val_two, Matrix.cons_val_succ, b65x_certP5_1_2, b65x_certP7_1_2,
    b65x_cpEval_sub, b65x_cpEval_add, b65x_cpEval_mul, b65x_cpEval_pow,
    b65x_cpEval_scale] at h0 h1 h2 h3 h4 h5
  have hN : b65x_cpEval b65x_certN_1_2 t ≠ 0 := by
    intro h
    have hr := congrArg Complex.re h
    norm_num [b65x_cpEval, b65x_certN_1_2, Polynomial.eval₂_pow,
      pow_two, Complex.mul_re] at hr
    nlinarith [sq_nonneg t]
  have hreg : b65b_inverseNormalization (b65x_piece 1 2 t) ∈ b65s_regular := by
    rw [b65x_certND_ratio_1_2]
    exact b65x_regular_of_homogeneous _ _ h0 hN h1 h2 h3
      (by simpa only [mul_assoc] using h4) (by simpa only [mul_assoc] using h5)
  refine ⟨?_, hreg⟩
  intro h
  apply hreg.1
  simp [b65b_inverseNormalization, h]

end HodgeLean.Foundations.Program
