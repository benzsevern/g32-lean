  have hrel : b65x_cpEval b65x_certD_2_1 t =
      (12500000000000 : ℂ) * (((1 + t ^ 2 : ℝ) : ℂ)) *
        (((b65b_boxCentre 6).1 : ℂ) - b65x_piece 2 1 t *
          (((b65b_boxCentre 6).1 : ℂ) - ((b65b_boxCentre 0).1 : ℂ))) := by
