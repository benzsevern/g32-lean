  have h4 := b65x_certFactors_ne_zero_2_1 t ht 4

  have h5 := b65x_certFactors_ne_zero_2_1 t ht 5

  change b65x_cpEval b65x_certD_2_1 t ≠ 0 at h0
  change b65x_cpEval (b65x_cpSub b65x_certN_2_1 (b65x_cpScale 3 b65x_certD_2_1)) t ≠ 0 at h1
