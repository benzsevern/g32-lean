theorem b65x_certND_ratio_7_1 (t : ℝ) :
    b65b_inverseNormalization (b65x_piece 7 1 t) =
      b65x_cpEval b65x_certN_7_1 t / b65x_cpEval b65x_certD_7_1 t := by
  have hQ : (1 + t ^ 2 : ℝ) ≠ 0 := ne_of_gt (by positivity)
  have hQc : (((1 + t ^ 2 : ℝ) : ℂ)) ≠ 0 := Complex.ofReal_ne_zero.mpr hQ
  push_cast at hQc
  have hrel : b65x_cpEval b65x_certD_7_1 t =
      (50000000000000 : ℂ) * (((1 + t ^ 2 : ℝ) : ℂ)) *
        (((b65b_boxCentre 6).1 : ℂ) - b65x_piece 7 1 t *
          (((b65b_boxCentre 6).1 : ℂ) - ((b65b_boxCentre 0).1 : ℂ))) := by
    norm_num [b65x_cpEval, b65x_certD_7_1, Polynomial.eval₂_pow,
      b65x_piece, b65x_centre, b65x_radius, b65x_et, mr_centre, mr_basePoint,
      b65b_vertex0, b65b_track, b65b_radius, b65b_boxCentre]
    push_cast
    field_simp [hQc]
    <;> ring
  have hnrel : b65x_cpEval b65x_certN_7_1 t =
      (50000000000000 : ℂ) * (((1 + t ^ 2 : ℝ) : ℂ)) *
        (((b65b_boxCentre 0).1 : ℂ) * ((b65b_boxCentre 6).1 : ℂ)) := by
    norm_num [b65x_cpEval, b65x_certN_7_1, Polynomial.eval₂_pow, b65b_boxCentre]
