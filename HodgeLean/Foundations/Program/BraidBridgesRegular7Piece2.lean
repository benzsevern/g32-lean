        (((b65b_boxCentre 0).1 : ℂ) * ((b65b_boxCentre 6).1 : ℂ)) := by
    norm_num [b65x_cpEval, b65x_certN_7_2, Polynomial.eval₂_pow, b65b_boxCentre]
    all_goals push_cast
