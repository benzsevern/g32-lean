theorem b65x_certND_ratio_8_1 (t : ℝ) :
    b65b_inverseNormalization (b65x_piece 8 1 t) =
      b65x_cpEval b65x_certN_8_1 t / b65x_cpEval b65x_certD_8_1 t := by
  have hQ : (1 + t ^ 2 : ℝ) ≠ 0 := ne_of_gt (by positivity)
  have hQc : (((1 + t ^ 2 : ℝ) : ℂ)) ≠ 0 := Complex.ofReal_ne_zero.mpr hQ
  push_cast at hQc
  have hrel : b65x_cpEval b65x_certD_8_1 t =
      (25000000000000 : ℂ) * (((1 + t ^ 2 : ℝ) : ℂ)) *
        (((b65b_boxCentre 6).1 : ℂ) - b65x_piece 8 1 t *
          (((b65b_boxCentre 6).1 : ℂ) - ((b65b_boxCentre 0).1 : ℂ))) := by
    norm_num [b65x_cpEval, b65x_certD_8_1, Polynomial.eval₂_pow,
      b65x_piece, b65x_centre, b65x_radius, b65x_et, mr_centre, mr_basePoint,
      b65b_vertex0, b65b_track, b65b_radius, b65b_boxCentre]
    push_cast
    field_simp [hQc]
    <;> ring
  have hnrel : b65x_cpEval b65x_certN_8_1 t =
      (25000000000000 : ℂ) * (((1 + t ^ 2 : ℝ) : ℂ)) *
        (((b65b_boxCentre 0).1 : ℂ) * ((b65b_boxCentre 6).1 : ℂ)) := by
    norm_num [b65x_cpEval, b65x_certN_8_1, Polynomial.eval₂_pow, b65b_boxCentre]
    all_goals push_cast
    all_goals ring
  unfold b65b_inverseNormalization
  rw [hnrel, hrel]
  have hLQ : (25000000000000 : ℂ) * (((1 + t ^ 2 : ℝ) : ℂ)) ≠ 0 := by
    apply mul_ne_zero (by norm_num)
    exact Complex.ofReal_ne_zero.mpr hQ
  exact (mul_div_mul_left _ _ hLQ).symm

theorem b65x_piece_regular_8_1 (t : ℝ) (ht : t ∈ Set.Icc (-1) (1)) :
    ((b65b_boxCentre 6).1 : ℂ) - b65x_piece 8 1 t *
        (((b65b_boxCentre 6).1 : ℂ) - ((b65b_boxCentre 0).1 : ℂ)) ≠ 0 ∧
      b65b_inverseNormalization (b65x_piece 8 1 t) ∈ b65s_regular := by

  have h0 := b65x_certFactors_ne_zero_8_1 t ht 0

  have h1 := b65x_certFactors_ne_zero_8_1 t ht 1

  have h2 := b65x_certFactors_ne_zero_8_1 t ht 2

  have h3 := b65x_certFactors_ne_zero_8_1 t ht 3

  have h4 := b65x_certFactors_ne_zero_8_1 t ht 4

  have h5 := b65x_certFactors_ne_zero_8_1 t ht 5

  change b65x_cpEval b65x_certD_8_1 t ≠ 0 at h0
  change b65x_cpEval (b65x_cpSub b65x_certN_8_1 (b65x_cpScale 3 b65x_certD_8_1)) t ≠ 0 at h1
  change b65x_cpEval (b65x_cpSub b65x_certN_8_1 b65x_certD_8_1) t ≠ 0 at h2
  change b65x_cpEval (b65x_cpAdd b65x_certN_8_1 (b65x_cpScale 2 b65x_certD_8_1)) t ≠ 0 at h3
  change b65x_cpEval b65x_certP5_8_1 t ≠ 0 at h4
  change b65x_cpEval b65x_certP7_8_1 t ≠ 0 at h5
  norm_num only [b65x_certFactors_8_1, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.cons_val_two, Matrix.cons_val_succ, b65x_certP5_8_1, b65x_certP7_8_1,
    b65x_cpEval_sub, b65x_cpEval_add, b65x_cpEval_mul, b65x_cpEval_pow,
    b65x_cpEval_scale] at h0 h1 h2 h3 h4 h5
  have hN : b65x_cpEval b65x_certN_8_1 t ≠ 0 := by
    intro h
    have hr := congrArg Complex.re h
    norm_num [b65x_cpEval, b65x_certN_8_1, Polynomial.eval₂_pow,
      pow_two, Complex.mul_re] at hr
    nlinarith [sq_nonneg t]
  have hreg : b65b_inverseNormalization (b65x_piece 8 1 t) ∈ b65s_regular := by
    rw [b65x_certND_ratio_8_1]
    exact b65x_regular_of_homogeneous _ _ h0 hN h1 h2 h3
      (by simpa only [mul_assoc] using h4) (by simpa only [mul_assoc] using h5)
  refine ⟨?_, hreg⟩
  intro h
  apply hreg.1
  simp [b65b_inverseNormalization, h]

