theorem b65b_replayEntries_unitary : ∀ i,
    b65b_qDecode (b65b_replayEntries i) * (b65b_qDecode (b65b_replayEntries i)).conjTranspose = 1 ∧
    (b65b_qDecode (b65b_replayEntries i)).conjTranspose * b65b_qDecode (b65b_replayEntries i) = 1 := by
  intro i
  fin_cases i <;> decide +kernel

def b65b_replayEntry (i : Fin 44) : (Matrix (Fin 4) (Fin 4) b65b_Q)ˣ where
  val := b65b_qDecode (b65b_replayEntries i)
  inv := (b65b_qDecode (b65b_replayEntries i)).conjTranspose
  val_inv := (b65b_replayEntries_unitary i).1
  inv_val := (b65b_replayEntries_unitary i).2

def b65b_qStep (m : b65s_Move) (t : Fin 13 → (Matrix (Fin 4) (Fin 4) b65b_Q)ˣ) :
    Fin 13 → (Matrix (Fin 4) (Fin 4) b65b_Q)ˣ :=
  match m with
  | .positive i => b4_braid i.castSucc i.succ t
  | .negative i => Function.update (t ∘ Equiv.swap i.castSucc i.succ) i.succ
      ((t i.succ)⁻¹ * t i.castSucc * t i.succ)
  | .conjugate _ => t

def b65b_qWord (w : List b65s_Move) (t : Fin 13 → (Matrix (Fin 4) (Fin 4) b65b_Q)ˣ) :
    Fin 13 → (Matrix (Fin 4) (Fin 4) b65b_Q)ˣ :=
  w.foldl (fun s m ↦ b65b_qStep m s) t

