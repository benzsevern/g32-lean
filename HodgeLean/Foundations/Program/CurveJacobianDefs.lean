import HodgeLean.Foundations.Program.RelativeTorusKernel
import HodgeLean.Adapters.DegreeOneLatticeDefs

/-!
# Track B3, compact Riemann surfaces and their Jacobians: definitions

A Riemann surface is a type `C` with a Mathlib `ChartedSpace E C` and `IsManifold 𝓘(ℂ, E) ω C`,
for a complex normed space `E` of dimension one (the statements carry `finrank ℂ E = 1`; the model
is `E` rather than `ℂ` so that B2's tori `b2_torus Λ F`, modelled on `Fin g → ℂ`, are instances).
Every object below is constructed from this data:

* `b3_HolForm E C`, the holomorphic `1`-forms: holomorphic functions on the tangent bundle that are
  `ℂ`-linear on each tangent space;
* the velocity `b3_velocity` of a path `γ : ℝ → C` (Mathlib's `mfderiv` over `ℝ`), the integral
  `b3_pathIntegral γ θ = ∫₀¹ θ(γ t, γ' t) dt`, and its restriction `b3_pathPeriod γ` to
  holomorphic forms;
* the `C¹` loops `b3_SmoothLoop E C` (`1`-periodic `C¹` maps `ℝ → C`), their periods
  `b3_period γ : Ω¹(C) → ℂ`, and the **period lattice** `b3_periodLattice E C`, the subgroup of
  `Ω¹(C) → ℂ` generated by the periods; it is the model of `H₁(C, ℤ)` (the bridge to singular
  cohomology is the pair of statements `b3_period_eq_iff_loopPeriod`, `b3_exists_smoothLoop`);
* the complexified period map `b3_cplxPeriod : ℂ ⊗[ℤ] Λ → (Ω¹(C) → ℂ)`, its kernel
  `b3_periodF E C`, and the **Jacobian** `b3_Jacobian E C = b2_torus Λ (b3_periodF E C)`, which is
  `span_ℂ Λ ⧸ Λ`, i.e. `Ω¹(C)^∨ ⧸ H₁(C, ℤ)` once the periods span the dual;
* the orientation `b3_orient` of a complex vector space, the transversality `b3_Transverse` and the
  intersection number `b3_intersection` of two loops (signed count of crossings);
* the properties `b3_IsIntersectionForm` (a form on `Λ` computing intersection numbers),
  `b3_IsAbelJacobi` (a map `C → J(C)` given by integration from a base point), and, for a map
  `f : C → C'`, the pullback `b3_pullback f` of functions on tangent bundles and the property
  `b3_IsPushforward f g` of a lattice map `g : Λ_C → Λ_C'`;
* the elliptic curve `b3_Elliptic = b2_torus ℤ² b2_stdF = ℂ ⧸ (ℤ + iℤ)` with its model
  `b3_EllipticModel`.

HC no distance; AV milestone no distance.
-/

noncomputable section

open Manifold
open scoped TensorProduct ContDiff

namespace HodgeLean.Foundations.Program

/-! ## Holomorphic `1`-forms -/

section Forms

variable (E : Type) [NormedAddCommGroup E] [NormedSpace ℂ E]
variable (C : Type) [TopologicalSpace C] [ChartedSpace E C] [IsManifold 𝓘(ℂ, E) ω C]

/-- **The holomorphic `1`-forms `Ω¹(C)`**: functions `θ` on the tangent bundle of `C` that are
holomorphic (`ω`-smooth for the complex manifold structure of the tangent bundle) and `ℂ`-linear on
each tangent space. In a chart `z`, `θ = f(z) dz` with `f` holomorphic.
Source: Forster, *Lectures on Riemann Surfaces*, GTM 81, §9 (holomorphic `1`-forms); Mathlib
`TangentBundle`, `ContMDiff`. -/
def b3_HolForm : Submodule ℂ (TangentBundle 𝓘(ℂ, E) C → ℂ) where
  carrier := {θ | ContMDiff 𝓘(ℂ, E).tangent 𝓘(ℂ, ℂ) ω θ ∧
    ∀ (x : C) (a : ℂ) (v w : TangentSpace 𝓘(ℂ, E) x),
      θ ⟨x, a • v + w⟩ = a * θ ⟨x, v⟩ + θ ⟨x, w⟩}
  add_mem' := by
    rintro θ η ⟨hθ, hθ'⟩ ⟨hη, hη'⟩
    refine ⟨hθ.add hη, fun x a v w ↦ ?_⟩
    simp only [Pi.add_apply, hθ', hη']
    ring
  zero_mem' := ⟨contMDiff_const, fun _ _ _ _ ↦ by simp⟩
  smul_mem' := by
    rintro c θ ⟨hθ, hθ'⟩
    refine ⟨(contMDiff_const (c := c)).mul hθ, fun x a v w ↦ ?_⟩
    simp only [Pi.smul_apply, smul_eq_mul, hθ']
    ring

example : (0 : TangentBundle 𝓘(ℂ, E) C → ℂ) ∈ b3_HolForm E C := (b3_HolForm E C).zero_mem

/-- **The velocity** `γ'(t) ∈ T_{γ t} C` of a path `γ : ℝ → C`, Mathlib's manifold derivative over
`ℝ` applied to `1`; the tangent spaces for the models `𝓘(ℝ, E)` and `𝓘(ℂ, E)` are both `E` in the
coordinates of `chartAt (γ t)`.
Source: Lee, *Introduction to Smooth Manifolds*, 2nd ed., GTM 218, Ch. 3 (velocity of a curve);
Mathlib `mfderiv`. -/
def b3_velocity (γ : ℝ → C) (t : ℝ) : TangentSpace 𝓘(ℂ, E) (γ t) :=
  mfderiv 𝓘(ℝ, ℝ) 𝓘(ℝ, E) γ t 1

example (x : C) (t : ℝ) : b3_velocity E C (fun _ ↦ x) t = 0 := by
  rw [b3_velocity, mfderiv_const]
  rfl

/-- **The integral of a function `θ` on the tangent bundle along a path**,
`∫₀¹ θ(γ t, γ'(t)) dt`.
Source: Forster, *Lectures on Riemann Surfaces*, §10 (integration of `1`-forms along curves);
Mathlib `intervalIntegral`, `MeasureTheory.curveIntegral` (the flat case). -/
def b3_pathIntegral (γ : ℝ → C) (θ : TangentBundle 𝓘(ℂ, E) C → ℂ) : ℂ :=
  ∫ t in (0 : ℝ)..1, θ ⟨γ t, b3_velocity E C γ t⟩

example (γ : ℝ → C) : b3_pathIntegral E C γ 0 = 0 := by
  simp [b3_pathIntegral]

/-- **The periods of a path on holomorphic forms**, `θ ↦ ∫_γ θ` on `Ω¹(C)`.
Source: Forster, *Lectures on Riemann Surfaces*, §10 and §20 (periods). -/
def b3_pathPeriod (γ : ℝ → C) : b3_HolForm E C → ℂ :=
  fun θ ↦ b3_pathIntegral E C γ θ

example (γ : ℝ → C) : b3_pathPeriod E C γ 0 = 0 := by
  simp [b3_pathPeriod, b3_pathIntegral]

/-- **The `C¹` loops** of `C`: `1`-periodic maps `ℝ → C` that are `C¹` for the real structure of
the charts.
Source: Lee, *Introduction to Smooth Manifolds*, Ch. 3 (curves and velocities); Forster, §20. -/
def b3_SmoothLoop : Type :=
  {γ : ℝ → C // Function.Periodic γ 1 ∧ ContMDiff 𝓘(ℝ, ℝ) 𝓘(ℝ, E) 1 γ}

/-- The constant loop at a point.
Source: Lee, *Introduction to Smooth Manifolds*, Ch. 3 (constant curves are smooth); Mathlib
`contMDiff_const`. -/
def b3_constLoop (x : C) : b3_SmoothLoop E C :=
  ⟨fun _ ↦ x, fun _ ↦ rfl, contMDiff_const⟩

example (x : C) (t : ℝ) : (b3_constLoop E C x).1 t = x := rfl

/-- **The period of a loop**, `θ ↦ ∫_γ θ` on `Ω¹(C)`.
Source: Forster, *Lectures on Riemann Surfaces*, §20–§21 (periods); Griffiths–Harris,
*Principles of Algebraic Geometry*, Ch. 2.2. -/
def b3_period (γ : b3_SmoothLoop E C) : b3_HolForm E C → ℂ :=
  b3_pathPeriod E C γ.1

example (x : C) : b3_period E C (b3_constLoop E C x) 0 = 0 := by
  simp [b3_period, b3_pathPeriod, b3_pathIntegral]

/-- **The period lattice `Λ_C`**, the subgroup of `Ω¹(C) → ℂ` generated by the periods of `C¹`
loops: the image of `H₁(C, ℤ)` under the period map.
Source: Forster, *Lectures on Riemann Surfaces*, §21 (the period lattice and the Jacobi variety);
Griffiths–Harris, Ch. 2.2. -/
def b3_periodLattice : AddSubgroup (b3_HolForm E C → ℂ) :=
  AddSubgroup.closure (Set.range (b3_period E C))

/-- The period of a loop as an element of the period lattice.
Source: as for `b3_periodLattice`. -/
def b3_latticePeriod (γ : b3_SmoothLoop E C) : b3_periodLattice E C :=
  ⟨b3_period E C γ, AddSubgroup.subset_closure ⟨γ, rfl⟩⟩

example (γ : b3_SmoothLoop E C) : (b3_latticePeriod E C γ : b3_HolForm E C → ℂ) =
    b3_period E C γ := rfl

/-- **The complexified period map** `ℂ ⊗[ℤ] Λ_C → (Ω¹(C) → ℂ)`, `c ⊗ λ ↦ c • λ`.
Source: Griffiths–Harris, Ch. 2.2 (`H₁(C, ℂ) → H⁰(Ω¹)^∨`); Mathlib `LinearMap.liftBaseChange`. -/
def b3_cplxPeriod :
    ℂ ⊗[ℤ] b3_periodLattice E C →ₗ[ℂ] (b3_HolForm E C → ℂ) :=
  LinearMap.liftBaseChange ℂ (b3_periodLattice E C).subtype.toIntLinearMap

example (c : ℂ) (l : b3_periodLattice E C) :
    b3_cplxPeriod E C (c ⊗ₜ[ℤ] l) = c • (l : b3_HolForm E C → ℂ) := rfl

/-- **The filtration of the Jacobian**: the kernel of the complexified period map, the
annihilator of `Ω¹(C)` in `H₁(C, ℂ)`, which Poincaré duality identifies with `H^{1,0}`.
Source: Griffiths–Harris, Ch. 2.2 (the Jacobian); Birkenhake–Lange, *Complex Abelian Varieties*,
2nd ed., Grundlehren 302, Ch. 11. -/
def b3_periodF : Submodule ℂ (ℂ ⊗[ℤ] b3_periodLattice E C) :=
  LinearMap.ker (b3_cplxPeriod E C)

example : (0 : ℂ ⊗[ℤ] b3_periodLattice E C) ∈ b3_periodF E C := (b3_periodF E C).zero_mem

/-- **The Jacobian** `J(C) = ((ℂ ⊗ Λ_C) ⧸ F) ⧸ Λ_C`, B2's torus of the period lattice and the
kernel filtration. Through `LinearMap.quotKerEquivRange` it is `span_ℂ Λ_C ⧸ Λ_C`.
Source: Forster, *Lectures on Riemann Surfaces*, §21 (`Jac(X) = ℂ^g ⧸ Per(ω₁, …, ω_g)`);
Birkenhake–Lange, Ch. 11. -/
abbrev b3_Jacobian : Type :=
  b2_torus (b3_periodLattice E C) (b3_periodF E C)

example (l : b3_periodLattice E C) :
    (QuotientAddGroup.mk (b2_latticeMap _ (b3_periodF E C) l) : b3_Jacobian E C) = 0 :=
  (QuotientAddGroup.eq_zero_iff _).2 ⟨l, rfl⟩

/-- **The `ℂ`-linear functionals on `Ω¹(C)`**, inside all functions `Ω¹(C) → ℂ`.
Source: Bourbaki, *Algèbre*, ch. II, §2 (the dual module). -/
def b3_linearDual : Submodule ℂ (b3_HolForm E C → ℂ) where
  carrier := {u | ∀ (a : ℂ) (θ η : b3_HolForm E C), u (a • θ + η) = a * u θ + u η}
  add_mem' := by
    intro u v hu hv a θ η
    simp only [Pi.add_apply, hu a θ η, hv a θ η]
    ring
  zero_mem' := fun _ _ _ ↦ by simp
  smul_mem' := by
    intro c u hu a θ η
    simp only [Pi.smul_apply, smul_eq_mul, hu a θ η]
    ring

example : (0 : b3_HolForm E C → ℂ) ∈ b3_linearDual E C := (b3_linearDual E C).zero_mem

/-- **An Abel–Jacobi map based at `p₀`**: `aj p₀ = 0`, and along every `C¹` path `γ` the
difference `aj (γ 1) - aj (γ 0)` is the class of an element of `ℂ ⊗ Λ_C` whose periods are the
integrals `∫_γ θ`.
Source: Forster, *Lectures on Riemann Surfaces*, §21 (the Abel–Jacobi map); Griffiths–Harris,
Ch. 2.2. -/
def b3_IsAbelJacobi (p₀ : C) (aj : C → b3_Jacobian E C) : Prop :=
  aj p₀ = 0 ∧ ∀ γ : ℝ → C, ContMDiff 𝓘(ℝ, ℝ) 𝓘(ℝ, E) 1 γ →
    ∃ v : ℂ ⊗[ℤ] b3_periodLattice E C, b3_cplxPeriod E C v = b3_pathPeriod E C γ ∧
      aj (γ 1) - aj (γ 0) =
        QuotientAddGroup.mk (Submodule.Quotient.mk (p := b3_periodF E C) v)

example (p₀ : C) (aj : C → b3_Jacobian E C) (h : b3_IsAbelJacobi E C p₀ aj) : aj p₀ = 0 := h.1

end Forms

/-! ## Intersection numbers of loops -/

section Intersection

variable (E : Type) [NormedAddCommGroup E] [NormedSpace ℂ E] [FiniteDimensional ℂ E]
variable {C : Type} [TopologicalSpace C] [ChartedSpace E C] [IsManifold 𝓘(ℂ, E) ω C]

/-- **The orientation form of a complex vector space**, `(v, w) ↦ Σᵢ Im (v̄ᵢ wᵢ)` in the
coordinates of Mathlib's chosen basis. For `E = ℂ` it is a positive multiple of `Im (v̄ w)`, so
`(1, i)` is positive; on a line its sign does not depend on the basis.
Source: Griffiths–Harris, Ch. 0.2 (the orientation of a complex manifold); Mathlib
`Module.finBasis`. -/
def b3_orient (v w : E) : ℝ :=
  ∑ i, (starRingEnd ℂ ((Module.finBasis ℂ E).equivFun v i) *
    (Module.finBasis ℂ E).equivFun w i).im

example (v : E) : b3_orient E v 0 = 0 := by
  simp [b3_orient]

/-- **The crossing parameters** of two loops, `{(s, t) ∈ [0, 1)² | γ s = δ t}`.
Source: Guillemin–Pollack, *Differential Topology*, Ch. 3 §3 (intersection theory). -/
def b3_crossings (γ δ : b3_SmoothLoop E C) : Set (ℝ × ℝ) :=
  {p | p.1 ∈ Set.Ico (0 : ℝ) 1 ∧ p.2 ∈ Set.Ico (0 : ℝ) 1 ∧ γ.1 p.1 = δ.1 p.2}

example (x : C) : ((0 : ℝ), (0 : ℝ)) ∈ b3_crossings E (b3_constLoop E C x) (b3_constLoop E C x) :=
  ⟨⟨le_rfl, one_pos⟩, ⟨le_rfl, one_pos⟩, rfl⟩

/-- **Transverse loops**: at every crossing `γ s = δ t` the velocities `γ'(s)`, `δ'(t)` are
`ℝ`-independent (their orientation form is nonzero).
Source: Guillemin–Pollack, Ch. 1 §5 and Ch. 3 §3. -/
def b3_Transverse (γ δ : b3_SmoothLoop E C) : Prop :=
  ∀ s t, γ.1 s = δ.1 t → b3_orient E (b3_velocity E C γ.1 s) (b3_velocity E C δ.1 t) ≠ 0

example (γ δ : b3_SmoothLoop E C) (h : ∀ s t, γ.1 s ≠ δ.1 t) : b3_Transverse E γ δ :=
  fun s t hst ↦ absurd hst (h s t)

/-- **The intersection number** of two loops: the number of crossings `(s, t) ∈ [0, 1)²`, each
counted with the sign of the orientation of `(γ'(s), δ'(t))`. For transverse loops on a compact
surface the crossings are finite; otherwise `finsum` gives `0`.
Source: Guillemin–Pollack, Ch. 3 §3 (oriented intersection numbers); Farkas–Kra, *Riemann
Surfaces*, 2nd ed., GTM 71, Ch. III (intersection of cycles on a surface). -/
def b3_intersection (γ δ : b3_SmoothLoop E C) : ℤ :=
  ∑ᶠ p ∈ b3_crossings E γ δ,
    ((SignType.sign (b3_orient E (b3_velocity E C γ.1 p.1) (b3_velocity E C δ.1 p.2)) : ℤ))

example (γ δ : b3_SmoothLoop E C) (h : ∀ s t, γ.1 s ≠ δ.1 t) : b3_intersection E γ δ = 0 := by
  have : b3_crossings E γ δ = ∅ := Set.eq_empty_of_forall_notMem fun p hp ↦ h _ _ hp.2.2
  simp [b3_intersection, this]

/-- **A form computing intersection numbers**: a bilinear form on the period lattice whose value
on the periods of two transverse loops is their intersection number.
Source: Farkas–Kra, Ch. III (the intersection form on `H₁` and the canonical homology basis);
Griffiths–Harris, Ch. 2.2. -/
def b3_IsIntersectionForm (Q : LinearMap.BilinForm ℤ (b3_periodLattice E C)) : Prop :=
  ∀ γ δ : b3_SmoothLoop E C, b3_Transverse E γ δ →
    Q (b3_latticePeriod E C γ) (b3_latticePeriod E C δ) = b3_intersection E γ δ

example (Q : LinearMap.BilinForm ℤ (b3_periodLattice E C)) (h : b3_IsIntersectionForm E Q)
    (γ δ : b3_SmoothLoop E C) (hγδ : b3_Transverse E γ δ) :
    Q (b3_latticePeriod E C γ) (b3_latticePeriod E C δ) = b3_intersection E γ δ :=
  h γ δ hγδ

end Intersection

/-! ## Maps of surfaces -/

section Maps

variable (E : Type) [NormedAddCommGroup E] [NormedSpace ℂ E]
variable {C : Type} [TopologicalSpace C] [ChartedSpace E C] [IsManifold 𝓘(ℂ, E) ω C]
variable (E' : Type) [NormedAddCommGroup E'] [NormedSpace ℂ E']
variable {C' : Type} [TopologicalSpace C'] [ChartedSpace E' C'] [IsManifold 𝓘(ℂ, E') ω C']

/-- **The pullback along `f : C → C'`** of functions on tangent bundles,
`(f^* θ)(x, v) = θ(f x, df_x v)`; on holomorphic `1`-forms it is the pullback of forms.
Source: Forster, *Lectures on Riemann Surfaces*, §9 (pullback of differential forms); Mathlib
`mfderiv`. -/
def b3_pullback (f : C → C') :
    (TangentBundle 𝓘(ℂ, E') C' → ℂ) →ₗ[ℂ] (TangentBundle 𝓘(ℂ, E) C → ℂ) where
  toFun θ p := θ ⟨f p.1, mfderiv 𝓘(ℂ, E) 𝓘(ℂ, E') f p.1 p.2⟩
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

example (f : C → C') (p : TangentBundle 𝓘(ℂ, E) C) : b3_pullback E E' f 0 p = 0 := rfl

/-- **A pushforward of period lattices along `f`**: an additive map `Λ_C → Λ_C'` sending the
period of each loop `γ` to the period of `f ∘ γ`.
Source: Birkenhake–Lange, Ch. 11 (the maps `f_*` and `f^*` of Jacobians); Griffiths–Harris,
Ch. 2.2. -/
def b3_IsPushforward (f : C → C')
    (g : b3_periodLattice E C →+ b3_periodLattice E' C') : Prop :=
  ∀ (γ : b3_SmoothLoop E C) (γ' : b3_SmoothLoop E' C'), γ'.1 = f ∘ γ.1 →
    g (b3_latticePeriod E C γ) = b3_latticePeriod E' C' γ'

example (f : C → C') (g : b3_periodLattice E C →+ b3_periodLattice E' C')
    (h : b3_IsPushforward E E' f g) (x : C) :
    g (b3_latticePeriod E C (b3_constLoop E C x)) =
      b3_latticePeriod E' C' (b3_constLoop E' C' (f x)) :=
  h _ _ rfl

end Maps

/-! ## The elliptic curve `ℂ ⧸ (ℤ + iℤ)` -/

section Elliptic

/-- The discreteness of the lattice of B2's standard elliptic curve.
Source: B2 `b2_latticeMap_discrete`. -/
instance b3_elliptic_discrete : DiscreteTopology (b2_latticeMap (Fin 2 → ℤ) b2_stdF).range :=
  b2_latticeMap_discrete b2_stdF b2_std_isWeightOne_aux

/-- **The model space of the elliptic curve**, `ℂ^g` with `g = dim_ℂ ((ℂ ⊗ ℤ²) ⧸ F) = 1`.
Source: B2 `b2_torus_chartedSpace`. -/
abbrev b3_EllipticModel : Type :=
  Fin (Module.finrank ℂ ((ℂ ⊗[ℤ] (Fin 2 → ℤ)) ⧸ b2_stdF)) → ℂ

/-- **The elliptic curve** `ℂ ⧸ (ℤ + iℤ)`, B2's torus of `ℤ²` with the Hodge line
`F = ℂ (e₀ + i e₁)`.
Source: Birkenhake–Lange, §1.1; Forster, §21 (genus one). -/
abbrev b3_Elliptic : Type :=
  b2_torus (Fin 2 → ℤ) b2_stdF

/-- The elliptic curve is a complex manifold. Source: B2 `b2_torus_isManifold`. -/
instance b3_elliptic_isManifold : IsManifold 𝓘(ℂ, b3_EllipticModel) ω b3_Elliptic :=
  b2_torus_isManifold b2_stdF

/-- The elliptic curve is compact. Source: B2 `b2_torus_compactSpace`. -/
instance b3_elliptic_compactSpace : CompactSpace b3_Elliptic :=
  b2_torus_compactSpace b2_stdF b2_std_isWeightOne_aux

/-- The elliptic curve is Hausdorff. Source: B2 `b2_torus_t2Space`. -/
instance b3_elliptic_t2Space : T2Space b3_Elliptic :=
  b2_torus_t2Space b2_stdF

/-- The model of the elliptic curve is a complex line.
Source: B2 `b2_two_mul_finrank` (`2 dim_ℂ ((ℂ ⊗ Λ) ⧸ F) = rk Λ`). -/
theorem b3_ellipticModel_finrank : Module.finrank ℂ b3_EllipticModel = 1 := by
  have h := b2_two_mul_finrank b2_stdF b2_std_isWeightOne_aux
  simp only [Module.finrank_fin_fun] at h ⊢
  omega

example : FiniteDimensional ℂ b3_EllipticModel := inferInstance

/-- **The point with lattice coordinates `(s, t)`** of the elliptic curve, the class of
`s e₀ + t e₁`. In `(ℂ ⊗ ℤ²) ⧸ F` the relation `e₀ + i e₁ ∈ F` gives `[e₁] = i [e₀]`, so in the
coordinate `z` with `[e₀] ↦ 1` this is the point `z = s + i t` of `ℂ ⧸ (ℤ + iℤ)`.
Source: Birkenhake–Lange, §1.1 (`X = V ⧸ Λ` with real coordinates in a lattice basis). -/
def b3_ellipticPoint (s t : ℝ) : b3_Elliptic :=
  QuotientAddGroup.mk (Submodule.Quotient.mk (p := b2_stdF)
    ((s : ℂ) ⊗ₜ[ℤ] (Pi.single 0 1 : Fin 2 → ℤ) + (t : ℂ) ⊗ₜ[ℤ] (Pi.single 1 1 : Fin 2 → ℤ)))

example : b3_ellipticPoint 0 0 = 0 := by
  simp [b3_ellipticPoint]

/-- Moving by one lattice step in either coordinate does not change the point.
Source: B2 (`b2_latticeMap` lands in the lattice). -/
theorem b3_ellipticPoint_add_one (s t : ℝ) :
    b3_ellipticPoint (s + 1) t = b3_ellipticPoint s t ∧
      b3_ellipticPoint s (t + 1) = b3_ellipticPoint s t := by
  constructor
  · refine QuotientAddGroup.eq_iff_sub_mem.2 ⟨Pi.single 0 1, ?_⟩
    show Submodule.Quotient.mk _ = _
    rw [← Submodule.Quotient.mk_sub]
    congr 1
    push_cast
    rw [TensorProduct.add_tmul]
    abel
  · refine QuotientAddGroup.eq_iff_sub_mem.2 ⟨Pi.single 1 1, ?_⟩
    show Submodule.Quotient.mk _ = _
    rw [← Submodule.Quotient.mk_sub]
    congr 1
    push_cast
    rw [TensorProduct.add_tmul]
    abel

/-- **The loop `a`** of the elliptic curve, `t ↦ [t e₀]` (`z = t`).
Source: Farkas–Kra, *Riemann Surfaces*, Ch. III (the canonical homology basis of a torus). -/
def b3_ellipticA : ℝ → b3_Elliptic := fun t ↦ b3_ellipticPoint t 0

example : Function.Periodic b3_ellipticA 1 := fun t ↦ (b3_ellipticPoint_add_one t 0).1

/-- **The loop `b`** of the elliptic curve, `t ↦ [t e₁]` (`z = i t`).
Source: Farkas–Kra, Ch. III (the canonical homology basis of a torus). -/
def b3_ellipticB : ℝ → b3_Elliptic := fun t ↦ b3_ellipticPoint 0 t

