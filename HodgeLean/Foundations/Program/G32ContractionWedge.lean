import HodgeLean.Foundations.Program.G32ContractionDefs
import HodgeLean.Foundations.Program.CyclotomicWeilLinear

/-! # Nonvanishing of a complementary wedge against a determinant line

Right contractions of the exterior algebra by linear forms, applied to the products of degree-one
elements of a submodule, and the resulting nonvanishing of `Z ∧ w_ℂ` for `Z` in the wedges of
`⊕_{s ≠ t} V_s` and `w` a nonzero rational determinant wedge. HC no distance; AV milestone no
distance.
-/

noncomputable section
open scoped TensorProduct

namespace HodgeLean.Foundations.Program

open HodgeLean.Foundations

section Contract

variable {E : Type*} [AddCommGroup E] [Module ℂ E]

/-- Right contraction by a linear form, as a linear endomorphism of the exterior algebra.
Source: Mathlib `CliffordAlgebra.contractRight`. -/
def g32c_contract (d : Module.Dual ℂ E) : Module.End ℂ (ExteriorAlgebra ℂ E) :=
  (CliffordAlgebra.contractRight (Q := (0 : QuadraticForm ℂ E))).flip d

theorem g32c_contract_mul_ι (d : Module.Dual ℂ E) (b : ExteriorAlgebra ℂ E) (a : E) :
    g32c_contract d (b * ExteriorAlgebra.ι ℂ a) =
      d a • b - g32c_contract d b * ExteriorAlgebra.ι ℂ a :=
  CliffordAlgebra.contractRight_mul_ι (Q := (0 : QuadraticForm ℂ E)) d a b

theorem g32c_contract_prod_eq_zero (d : Module.Dual ℂ E) (l : List E)
    (hl : ∀ a ∈ l, d a = 0) : g32c_contract d (l.map (ExteriorAlgebra.ι ℂ)).prod = 0 := by
  induction l using List.reverseRecOn with
  | nil =>
    exact CliffordAlgebra.contractRight_one (Q := (0 : QuadraticForm ℂ E)) (d := d)
  | append_singleton l a ih =>
    rw [List.map_append, List.prod_append, List.map_singleton, List.prod_singleton,
      g32c_contract_mul_ι, hl a (by simp), ih fun b hb => hl b (by simp [hb])]
    simp

/-- The span of the products of degree-one elements of a submodule.
Source: Mathlib `ExteriorAlgebra.ι`; the subalgebra generated by `K`. -/
def g32c_prodSpan (K : Submodule ℂ E) : Submodule ℂ (ExteriorAlgebra ℂ E) :=
  Submodule.span ℂ {y | ∃ l : List E, (∀ a ∈ l, a ∈ K) ∧ (l.map (ExteriorAlgebra.ι ℂ)).prod = y}

theorem g32c_prodSpan_mono {K K' : Submodule ℂ E} (hK : K ≤ K') :
    g32c_prodSpan K ≤ g32c_prodSpan K' :=
  Submodule.span_mono fun _ ⟨l, hl, hy⟩ => ⟨l, fun a ha => hK (hl a ha), hy⟩

theorem g32c_prodSpan_mul {K : Submodule ℂ E} {x y : ExteriorAlgebra ℂ E}
    (hx : x ∈ g32c_prodSpan K) (hy : y ∈ g32c_prodSpan K) : x * y ∈ g32c_prodSpan K := by
  have hxy := Submodule.mul_mem_mul hx hy
  rw [g32c_prodSpan, Submodule.span_mul_span] at hxy
  refine Submodule.span_mono ?_ hxy
  rintro _ ⟨_, ⟨l1, hl1, rfl⟩, _, ⟨l2, hl2, rfl⟩, rfl⟩
  refine ⟨l1 ++ l2, fun a ha => ?_, by rw [List.map_append, List.prod_append]⟩
  rcases List.mem_append.mp ha with ha | ha
  · exact hl1 a ha
  · exact hl2 a ha

theorem g32c_coe_map_mem_prodSpan (K : Submodule ℂ E) (n : ℕ) (z : ⋀[ℂ]^n K) :
    ((exteriorPower.map n K.subtype z : ⋀[ℂ]^n E) : ExteriorAlgebra ℂ E) ∈ g32c_prodSpan K := by
  let F : ⋀[ℂ]^n K →ₗ[ℂ] ExteriorAlgebra ℂ E :=
    (ExteriorAlgebra.exteriorPower ℂ n E).subtype ∘ₗ exteriorPower.map n K.subtype
  change F z ∈ _
  have hle : LinearMap.range F ≤ g32c_prodSpan K := by
    rw [LinearMap.range_eq_map, ← exteriorPower.ιMulti_span, Submodule.map_span,
      Submodule.span_le]
    rintro _ ⟨_, ⟨v, rfl⟩, rfl⟩
    refine Submodule.subset_span ⟨List.ofFn fun i => (v i : E), fun a ha => ?_, ?_⟩
    · obtain ⟨i, rfl⟩ := List.mem_ofFn.mp ha
      exact (v i).2
    · simp only [F, LinearMap.comp_apply, exteriorPower.map_apply_ιMulti, Submodule.subtype_apply,
        exteriorPower.ιMulti_apply_coe, ExteriorAlgebra.ιMulti_apply, List.map_ofFn]
      rfl
  exact hle ⟨z, rfl⟩

theorem g32c_contract_eq_zero_of_mem (d : Module.Dual ℂ E) {K : Submodule ℂ E}
    (hK : ∀ a ∈ K, d a = 0) {y : ExteriorAlgebra ℂ E} (hy : y ∈ g32c_prodSpan K) :
    g32c_contract d y = 0 := by
  induction hy using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨l, hl, rfl⟩ := hy
    exact g32c_contract_prod_eq_zero d l fun a ha => hK a (hl a ha)
  | zero => exact map_zero _
  | add x y _ _ hx hy => rw [map_add, hx, hy, add_zero]
  | smul c x _ hx => rw [map_smul, hx, smul_zero]

/-- The composite of the right contractions by a list of linear forms, the last one first.
Source: Mathlib `CliffordAlgebra.contractRight`. -/
def g32c_contractList (L : List (Module.Dual ℂ E)) : Module.End ℂ (ExteriorAlgebra ℂ E) :=
  (L.map g32c_contract).prod

theorem g32c_contractList_append (L : List (Module.Dual ℂ E)) (d : Module.Dual ℂ E)
    (y : ExteriorAlgebra ℂ E) :
    g32c_contractList (L ++ [d]) y = g32c_contractList L (g32c_contract d y) := by
  rw [g32c_contractList, List.map_append, List.prod_append, List.map_singleton,
    List.prod_singleton, Module.End.mul_apply]
  rfl

theorem g32c_contractList_prod (L : List (E × Module.Dual ℂ E))
    (h1 : ∀ p ∈ L, p.2 p.1 = 1) (h2 : L.Pairwise fun q p => p.2 q.1 = 0)
    (l : List E) (hl : ∀ a ∈ l, ∀ p ∈ L, p.2 a = 0) :
    g32c_contractList (L.map Prod.snd)
        ((l.map (ExteriorAlgebra.ι ℂ)).prod * ((L.map Prod.fst).map (ExteriorAlgebra.ι ℂ)).prod) =
      (l.map (ExteriorAlgebra.ι ℂ)).prod := by
  induction L using List.reverseRecOn with
  | nil => simp [g32c_contractList]
  | append_singleton L p ih =>
    rw [List.pairwise_append] at h2
    rw [List.map_append, List.map_singleton, g32c_contractList_append, List.map_append,
      List.map_singleton, List.map_append, List.map_singleton, List.prod_append,
      List.prod_singleton, ← mul_assoc, g32c_contract_mul_ι, h1 p (by simp), one_smul,
      ← List.prod_append, ← List.map_append, g32c_contract_prod_eq_zero, zero_mul, sub_zero]
    · rw [List.map_append, List.prod_append]
      exact ih (fun q hq => h1 q (by simp [hq])) h2.1 fun a ha q hq => hl a ha q (by simp [hq])
    · intro a ha
      rcases List.mem_append.mp ha with ha | ha
      · exact hl a ha p (by simp)
      · obtain ⟨q, hq, rfl⟩ := List.mem_map.mp ha
        exact h2.2.2 q hq p (by simp)

end Contract

section Cyclotomic

variable {V : Type*} [AddCommGroup V] [Module ℚ V] {m h : ℕ}

theorem g32c_eigenspace_iSupIndep [NeZero m] (e : V ≃ₗ[ℚ] (Fin h → cyc_Field m)) :
    iSupIndep (cyc_eigenspace e) := by
  let ζ := IsCyclotomicExtension.zeta m ℚ (cyc_Field m)
  have hinj : Function.Injective (fun t : cyc_Field m →ₐ[ℚ] ℂ => t ζ) := by
    intro t s h1
    refine AlgHom.ext_of_adjoin_eq_top (IsCyclotomicExtension.adjoin_primitive_root_eq_top
      (IsCyclotomicExtension.zeta_spec m ℚ (cyc_Field m))) ?_
    intro y hy
    rw [Set.mem_singleton_iff.mp hy]
    exact h1
  exact ((Module.End.eigenspaces_iSupIndep ((cyc_scalar e ζ).baseChange ℂ)).comp hinj).mono
    fun t => iInf_le _ ζ

variable [Module.Finite ℚ V]

theorem g32c_coLine_mul_ne_zero_pos [NeZero m] (hh : 0 < h)
    (e : V ≃ₗ[ℚ] (Fin h → cyc_Field m)) (t : cyc_Field m →ₐ[ℚ] ℂ) (n : ℕ)
    (Z : ⋀[ℂ]^n (ℂ ⊗[ℚ] V)) (hZ : Z ∈ g32c_coLine e t n) (hZ0 : Z ≠ 0) (w : ⋀[ℚ]^h V)
    (hw : w ∈ cyc_wedges e) (hw0 : w ≠ 0) :
    (Z : ExteriorAlgebra ℂ (ℂ ⊗[ℚ] V)) *
      (HodgeBlocks.complexifyWedge h w : ExteriorAlgebra ℂ (ℂ ⊗[ℚ] V)) ≠ 0 := by
  classical
  let Vt := cyc_eigenspace e t
  let Wt := ⨆ (s) (_ : s ≠ t), cyc_eigenspace e s
  obtain ⟨C, hWC, hC⟩ := ((g32c_eigenspace_iSupIndep e) t).symm.exists_isCompl
  let P := Submodule.projectionOnto Vt C hC.symm
  let b := Module.finBasisOfFinrankEq ℂ Vt (cyc_finrank_eigenspace e t)
  let φ : Fin h → Module.Dual ℂ (ℂ ⊗[ℚ] V) := fun i => b.coord i ∘ₗ P
  have hφb : ∀ i j, φ i (b j) = if j = i then 1 else 0 := by
    intro i j
    simp only [φ, P, LinearMap.comp_apply, Submodule.projectionOnto_apply_left,
      Module.Basis.coord_apply, Module.Basis.repr_self, Finsupp.single_apply]
  have hφW : ∀ i, ∀ x ∈ Wt, φ i x = 0 := by
    intro i x hx
    simp only [φ, LinearMap.comp_apply]
    rw [show P x = 0 from Submodule.projectionOnto_apply_right hC.symm ⟨x, hWC hx⟩, map_zero]
  let L : List ((ℂ ⊗[ℚ] V) × Module.Dual ℂ (ℂ ⊗[ℚ] V)) :=
    List.ofFn fun i => ((b i : ℂ ⊗[ℚ] V), φ i)
  let Γ := g32c_contractList (L.map Prod.snd)
  let B : ExteriorAlgebra ℂ (ℂ ⊗[ℚ] V) := ((L.map Prod.fst).map (ExteriorAlgebra.ι ℂ)).prod
  have key1 : ∀ y ∈ g32c_prodSpan Wt, Γ (y * B) = y := by
    intro y hy
    induction hy using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨l, hl, rfl⟩ := hy
      refine g32c_contractList_prod L ?_ ?_ l ?_
      · intro p hp
        obtain ⟨i, rfl⟩ := List.mem_ofFn.mp hp
        simp [hφb]
      · refine List.pairwise_ofFn.mpr fun i j hij => ?_
        simp [hφb, Fin.ne_of_lt hij]
      · intro a ha p hp
        obtain ⟨i, rfl⟩ := List.mem_ofFn.mp hp
        exact hφW i a (hl a ha)
    | zero => rw [zero_mul, map_zero]
    | add x y _ _ hx hy => rw [add_mul, map_add, hx, hy]
    | smul c x _ hx => rw [smul_mul_assoc, map_smul, hx]
  have key2 : ∀ y ∈ g32c_prodSpan Wt, Γ y = 0 := by
    intro y hy
    rcases List.eq_nil_or_concat (L.map Prod.snd) with hL | ⟨L0, d, hL⟩
    · have := congrArg List.length hL
      simp [L] at this
      omega
    · have hd : d ∈ L.map Prod.snd := by rw [hL]; simp
      obtain ⟨p, hp, rfl⟩ := List.mem_map.mp hd
      obtain ⟨i, rfl⟩ := List.mem_ofFn.mp hp
      change g32c_contractList (L.map Prod.snd) y = 0
      rw [hL, List.concat_eq_append, g32c_contractList_append, g32c_contract_eq_zero_of_mem _ (hφW i) hy, map_zero]
  have hZW : (Z : ExteriorAlgebra ℂ (ℂ ⊗[ℚ] V)) ∈ g32c_prodSpan Wt := by
    obtain ⟨z, rfl⟩ := hZ
    exact g32c_coe_map_mem_prodSpan Wt n z
  have hZne : (Z : ExteriorAlgebra ℂ (ℂ ⊗[ℚ] V)) ≠ 0 := fun h0 => hZ0 (Subtype.ext h0)
  -- the decomposition `w_ℂ = x_t + x'`
  have hwtop : HodgeBlocks.complexifyWedge h w ∈ cyc_topLines e := hw
  rw [cyc_topLines, iSup_split_single _ t] at hwtop
  obtain ⟨xt, hxt, x', hx', hsum⟩ := Submodule.mem_sup.mp hwtop
  have hxt0 : xt ≠ 0 := by
    rintro rfl
    rw [zero_add] at hsum
    exact cyc_projection_ne_zero hh e hw hw0 t (hsum ▸ hx')
  have hx'W : (x' : ExteriorAlgebra ℂ (ℂ ⊗[ℚ] V)) ∈ g32c_prodSpan Wt := by
    have hle : (⨆ (s) (_ : s ≠ t), cyc_line e s) ≤
        (g32c_prodSpan Wt).comap (ExteriorAlgebra.exteriorPower ℂ h (ℂ ⊗[ℚ] V)).subtype := by
      refine iSup₂_le fun s hs => ?_
      rintro _ ⟨z, rfl⟩
      exact g32c_prodSpan_mono
        (le_iSup₂ (f := fun s (_ : s ≠ t) => cyc_eigenspace e s) s hs)
        (g32c_coe_map_mem_prodSpan _ h z)
    exact hle hx'
  -- the line of `t` is spanned by the wedge of the basis
  let v0 : cyc_line e t := ⟨exteriorPower.ιMulti ℂ h (fun i => (b i : ℂ ⊗[ℚ] V)),
    cyc_ιMulti_mem_line e t _ fun i => (b i).2⟩
  have hv0 : ((v0 : ⋀[ℂ]^h (ℂ ⊗[ℚ] V)) : ExteriorAlgebra ℂ (ℂ ⊗[ℚ] V)) = B := by
    simp only [v0, B, L, exteriorPower.ιMulti_apply_coe, ExteriorAlgebra.ιMulti_apply,
      List.map_ofFn]
    rfl
  have hv0ne : v0 ≠ 0 := by
    intro h0
    have h1 := key1 _ hZW
    rw [← hv0, h0] at h1
    simp only [ZeroMemClass.coe_zero, mul_zero, map_zero] at h1
    exact hZne h1.symm
  obtain ⟨c, hc⟩ := (finrank_eq_one_iff_of_nonzero' v0 hv0ne).mp
    (cyc_finrank_line e t) ⟨xt, hxt⟩
  have hc0 : c ≠ 0 := by
    rintro rfl
    rw [zero_smul] at hc
    exact hxt0 (congrArg Subtype.val hc).symm
  intro hprod
  have hxtB : (xt : ExteriorAlgebra ℂ (ℂ ⊗[ℚ] V)) = c • B := by
    have h1 := congrArg (fun z : cyc_line e t =>
      ((z : ⋀[ℂ]^h (ℂ ⊗[ℚ] V)) : ExteriorAlgebra ℂ (ℂ ⊗[ℚ] V))) hc
    rw [← hv0]
    exact h1.symm
  have hcoe : (HodgeBlocks.complexifyWedge h w : ExteriorAlgebra ℂ (ℂ ⊗[ℚ] V)) =
      (xt : ExteriorAlgebra ℂ (ℂ ⊗[ℚ] V)) + x' := by
    rw [← hsum]
    rfl
  have hΓ := congrArg Γ hprod
  rw [hcoe, mul_add, map_add, key2 _ (g32c_prodSpan_mul hZW hx'W), add_zero, hxtB,
    mul_smul_comm, map_smul, key1 _ hZW, map_zero] at hΓ
  exact smul_ne_zero hc0 hZne hΓ

theorem g32c_coLine_mul_ne_zero_main [NeZero m] (e : V ≃ₗ[ℚ] (Fin h → cyc_Field m))
    (t : cyc_Field m →ₐ[ℚ] ℂ) (n : ℕ) (Z : ⋀[ℂ]^n (ℂ ⊗[ℚ] V)) (hZ : Z ∈ g32c_coLine e t n)
    (hZ0 : Z ≠ 0) (w : ⋀[ℚ]^h V) (hw : w ∈ cyc_wedges e) (hw0 : w ≠ 0) :
    (Z : ExteriorAlgebra ℂ (ℂ ⊗[ℚ] V)) *
      (HodgeBlocks.complexifyWedge h w : ExteriorAlgebra ℂ (ℂ ⊗[ℚ] V)) ≠ 0 := by
  rcases Nat.eq_zero_or_pos h with rfl | hh
  · have hmem := (HodgeBlocks.complexifyWedge 0 w).2
    change _ ∈ LinearMap.range (ExteriorAlgebra.ι ℂ) ^ 0 at hmem
    rw [pow_zero] at hmem
    obtain ⟨c, hc⟩ := Submodule.mem_one.mp hmem
    have hc0 : c ≠ 0 := by
      rintro rfl
      rw [map_zero] at hc
      exact hw0 (HodgeBlocks.complexifyWedge_injective 0
        (by rw [map_zero]; exact Subtype.ext hc.symm))
    rw [← hc, ← Algebra.commutes, ← Algebra.smul_def]
    exact smul_ne_zero hc0 fun h0 => hZ0 (Subtype.ext h0)
  · exact g32c_coLine_mul_ne_zero_pos hh e t n Z hZ hZ0 w hw hw0

end Cyclotomic

end HodgeLean.Foundations.Program
