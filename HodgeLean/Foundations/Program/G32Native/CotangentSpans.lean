import Mathlib.RingTheory.Ideal.Cotangent
import Mathlib.LinearAlgebra.Span.Basic

/-! The cotangent span depends on the ideal generated by the equations. -/
noncomputable section
set_option maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
open IsLocalRing
namespace HodgeLean.Foundations.Program

/-- Two families generating one ideal have the same span of classes in the cotangent space. -/
theorem g32l4_cotangent_span_eq_of_ideal_span_eq
    {R : Type*} [CommRing R] [IsLocalRing R]
    {ι κ : Type*} (f : ι → R) (g : κ → R)
    (hf : ∀ i, f i ∈ maximalIdeal R) (hg : ∀ j, g j ∈ maximalIdeal R)
    (hfg : Ideal.span (Set.range f) = Ideal.span (Set.range g)) :
    Submodule.span (ResidueField R)
      (Set.range fun i => (maximalIdeal R).toCotangent ⟨f i, hf i⟩) =
    Submodule.span (ResidueField R)
      (Set.range fun j => (maximalIdeal R).toCotangent ⟨g j, hg j⟩) := by
  let f' : ι → maximalIdeal R := fun i => ⟨f i, hf i⟩
  let g' : κ → maximalIdeal R := fun j => ⟨g j, hg j⟩
  have hspan : Submodule.span R (Set.range f') = Submodule.span R (Set.range g') := by
    apply Submodule.map_injective_of_injective (Submodule.injective_subtype (maximalIdeal R))
    simpa only [Submodule.map_span, ← Set.range_comp, f', g', Function.comp_def, Submodule.subtype_apply, Ideal.submodule_span_eq] using hfg
  have hmap := congrArg (Submodule.map (maximalIdeal R).toCotangent) hspan
  simp only [Submodule.map_span, ← Set.range_comp] at hmap
  have h := congrArg
    (fun N : Submodule R (CotangentSpace R) =>
      Submodule.span (ResidueField R) (N : Set (CotangentSpace R))) hmap
  simpa only [Submodule.span_span_of_tower, f', g', Function.comp_def] using h

end HodgeLean.Foundations.Program
