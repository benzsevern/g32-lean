import HodgeLean.Foundations.Program.G32Native.NormalFibreTransport
import HodgeConjecture.Lemmas.AlgebraicGeometry.ComplexPoint.Open
import Mathlib.Topology.VectorBundle.Basic

/-! # Evaluation topology and continuous transport of actual normal fibres -/
noncomputable section
set_option maxHeartbeats 200000
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
open CategoryTheory AlgebraicGeometry TopologicalSpace Bundle
namespace HodgeLean.Foundations.Program.G32Native

/-- Specialize a local module section at its specified complex point.
Source: Hartshorne, Algebraic Geometry, II.5, fibres of module sheaves. -/
def moduleSectionValue {Q : Over (Spec ↧ℂ)} (M : Q.left.Modules)
    (U : Q.left.Opens)
    (s : SheafOfModules.unit U.toScheme.ringCatSheaf ⟶
      (Scheme.Modules.pullback U.ι).obj M)
    (x : ComplexPoint Q) (hx : x ∈ Point.overOpen U) :
    (moduleSpecΓFunctor (R := CommRingCat.of ℂ)).obj
      ((Scheme.Modules.pullback x.left).obj M) := by
  let a := ComplexPoint.liftToOpen Q U x hx
  letI : (SheafOfModules.pushforward a.toRingCatSheafHom).IsRightAdjoint :=
    (inferInstance : (Scheme.Modules.pushforward a).IsRightAdjoint)
  let t : SheafOfModules.unit (Spec ↧ℂ).ringCatSheaf ⟶
      (Scheme.Modules.pullback x.left).obj M :=
    inv (SheafOfModules.pullbackObjUnitToUnit a.toRingCatSheafHom) ≫
      (Scheme.Modules.pullback a).map s ≫
      (Scheme.Modules.pullbackComp a U.ι).hom.app M ≫
      (Scheme.Modules.pullbackCongr (ComplexPoint.liftToOpen_fac Q U x hx)).hom.app M
  exact (moduleSpecΓFunctor (R := CommRingCat.of ℂ)).map t (1 : Γ(Spec ↧ℂ, ⊤))

/-- Local section specialization retains the actual module morphism.
Source: Hartshorne, Algebraic Geometry, II.5, functoriality of pullback. -/
theorem moduleSectionValue_transport {Q : Over (Spec ↧ℂ)} {M N : Q.left.Modules}
    (E : M ⟶ N) (U : Q.left.Opens)
    (s : SheafOfModules.unit U.toScheme.ringCatSheaf ⟶
      (Scheme.Modules.pullback U.ι).obj M)
    (x : ComplexPoint Q) (hx : x ∈ Point.overOpen U) :
    moduleSectionValue N U (s ≫ (Scheme.Modules.pullback U.ι).map E) x hx =
      ((moduleSpecΓFunctor (R := CommRingCat.of ℂ)).map
        ((Scheme.Modules.pullback x.left).map E)) (moduleSectionValue M U s x hx) := by
  unfold moduleSectionValue
  rw [← ModuleCat.comp_apply, ← Functor.map_comp]
  apply congrArg (fun f : SheafOfModules.unit (Spec ↧ℂ).ringCatSheaf ⟶
      (Scheme.Modules.pullback x.left).obj N =>
    (moduleSpecΓFunctor (R := CommRingCat.of ℂ)).map f (1 : Γ(Spec ↧ℂ, ⊤)))
  simp only [Functor.map_comp, Category.assoc]
  have h₁ := (Scheme.Modules.pullbackComp (ComplexPoint.liftToOpen Q U x hx) U.ι).hom.naturality E
  have h₂ := (Scheme.Modules.pullbackCongr (ComplexPoint.liftToOpen_fac Q U x hx)).hom.naturality E
  change (Scheme.Modules.pullback (ComplexPoint.liftToOpen Q U x hx)).map
      ((Scheme.Modules.pullback U.ι).map E) ≫ _ = _ at h₁
  rw [reassoc_of% h₁, h₂]

/-- Total topology generated by analytic base opens and local section evaluations.
Source: Hartshorne, Algebraic Geometry, II.5 and II.8, evaluation coordinates on dual fibres. -/
def normalEvaluationTopology {Q : Over (Spec ↧ℂ)} (M : Q.left.Modules) (k : ℕ) :
    TopologicalSpace (TotalSpace (Fin k → ℂ) (normalFibreOfModule M)) :=
  TopologicalSpace.generateFrom {A | (∃ O : Set (ComplexPoint Q), IsOpen O ∧
    A = TotalSpace.proj ⁻¹' O) ∨
    ∃ (U : Q.left.Opens)
      (s : SheafOfModules.unit U.toScheme.ringCatSheaf ⟶ (Scheme.Modules.pullback U.ι).obj M)
      (O : Set ℂ), IsOpen O ∧ A = {v | ∃ hx : v.proj ∈ Point.overOpen U,
        v.2 (moduleSectionValue M U s v.proj hx) ∈ O}}

/-- The same actual sheaf isomorphism gives continuous dual-fibre transport.
Source: Hartshorne, Algebraic Geometry, II.5 and II.8, local evaluation coordinates. -/
theorem normalFibreTransport_continuous {Q : Over (Spec ↧ℂ)} {M N : Q.left.Modules}
    (E : M ≅ N) (k : ℕ) :
    @Continuous (TotalSpace (Fin k → ℂ) (normalFibreOfModule M))
      (TotalSpace (Fin k → ℂ) (normalFibreOfModule N))
      (normalEvaluationTopology M k) (normalEvaluationTopology N k)
      (fun z => ⟨z.proj, normalFibreTransport E z.proj z.2⟩) := by
  letI := normalEvaluationTopology M k
  letI := normalEvaluationTopology N k
  apply continuous_generateFrom_iff.mpr
  intro A hA
  rcases hA with ⟨O, hO, rfl⟩ | ⟨U, s, O, hO, rfl⟩
  · exact isOpen_generateFrom_of_mem (Or.inl ⟨O, hO, rfl⟩)
  · have heq :
        (fun z : TotalSpace (Fin k → ℂ) (normalFibreOfModule M) =>
          (⟨z.proj, normalFibreTransport E z.proj z.2⟩ :
            TotalSpace (Fin k → ℂ) (normalFibreOfModule N))) ⁻¹'
          {v | ∃ hx : v.proj ∈ Point.overOpen U,
            v.2 (moduleSectionValue N U s v.proj hx) ∈ O} =
        {v | ∃ hx : v.proj ∈ Point.overOpen U,
          v.2 (moduleSectionValue M U (s ≫ (Scheme.Modules.pullback U.ι).map E.inv)
            v.proj hx) ∈ O} := by
      ext v
      constructor <;> rintro ⟨hx, hv⟩ <;> refine ⟨hx, ?_⟩
      · rw [moduleSectionValue_transport]
        exact hv
      · rw [moduleSectionValue_transport] at hv
        exact hv
    rw [heq]
    exact isOpen_generateFrom_of_mem
      (Or.inr ⟨U, s ≫ (Scheme.Modules.pullback U.ι).map E.inv, O, hO, rfl⟩)

#print axioms moduleSectionValue
#print axioms moduleSectionValue_transport
#print axioms normalEvaluationTopology
#print axioms normalFibreTransport_continuous
end HodgeLean.Foundations.Program.G32Native
