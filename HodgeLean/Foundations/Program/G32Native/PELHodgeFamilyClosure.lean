import HodgeLean.Foundations.HodgeGroupAlgebraic

noncomputable section
namespace HodgeLean.Foundations
open scoped TensorProduct
set_option warn.classDefReducibility false in
attribute [local instance] g1_zariski

/-- The rational algebraic group generated by a family of rational algebraic
subgroups is the rational closure of the subgroup generated by their union.
Source: Borel, Linear Algebraic Groups, second edition, §§1.3, 2.2 and AG.14.4. -/
theorem pel_family_group_eq_ratClosure {I : Type*} {n : ℕ}
    (H : I → Set (Matrix.GeneralLinearGroup (Fin n) ℂ))
    (ha : ∀ i, g2_IsRatAlgSubgroup (H i)) :
    ⋂₀ {G | g2_IsRatAlgSubgroup G ∧ ∀ i, H i ⊆ G} =
      g2_ratClosure (Subgroup.closure (⋃ i, H i) : Set (Matrix.GeneralLinearGroup (Fin n) ℂ)) := by
  have hgal : g2h_GaloisStable (⋃ i, H i) := by
    intro σ g hg
    obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hg
    obtain ⟨S, hS⟩ := (ha i).1
    exact Set.mem_iUnion.mpr ⟨i, hS.symm ▸ g2h_galoisStable_ratZeroSet S σ g (hS ▸ hi)⟩
  have hc := g2h_galoisStable_closure hgal
  have hr := g2h_isRatAlgSubgroup_ratClosure (Subgroup.closure (⋃ i, H i)) hc
  apply Set.Subset.antisymm
  · intro g hg
    apply hg _ ⟨hr, ?_⟩
    intro i x hx f hf
    exact hf x (Subgroup.subset_closure (Set.mem_iUnion.mpr ⟨i, hx⟩))
  · intro g hg G hG
    let Γ : Subgroup (Matrix.GeneralLinearGroup (Fin n) ℂ) :=
      { carrier := G
        one_mem' := hG.1.2.1
        mul_mem' := fun hx hy => hG.1.2.2.1 _ hx _ hy
        inv_mem' := fun hx => hG.1.2.2.2 _ hx }
    have hΓ : Subgroup.closure (⋃ i, H i) ≤ Γ := by
      apply (Subgroup.closure_le Γ).mpr
      rintro x hx
      obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hx
      exact hG.2 i hi
    obtain ⟨S, hS⟩ := hG.1.1
    rw [hS]
    intro f hf
    apply hg f
    intro x hx
    have hxG : x ∈ G := hΓ hx
    rw [hS] at hxG
    exact hxG f hf

/-- Rationality of the independently generated family group.
Source: Borel, Linear Algebraic Groups, second edition, §1.3 and AG.14.4. -/
theorem pel_family_group_isRatAlg {I : Type*} {n : ℕ}
    (H : I → Set (Matrix.GeneralLinearGroup (Fin n) ℂ))
    (ha : ∀ i, g2_IsRatAlgSubgroup (H i)) :
    g2_IsRatAlgSubgroup (⋂₀ {G | g2_IsRatAlgSubgroup G ∧ ∀ i, H i ⊆ G}) := by
  have hgal : g2h_GaloisStable (⋃ i, H i) := by
    intro σ g hg
    obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hg
    obtain ⟨S, hS⟩ := (ha i).1
    rw [hS] at hi
    exact Set.mem_iUnion.mpr ⟨i, hS.symm ▸ g2h_galoisStable_ratZeroSet S σ g hi⟩
  rw [pel_family_group_eq_ratClosure H ha]
  exact g2h_isRatAlgSubgroup_ratClosure _ (g2h_galoisStable_closure hgal)

/-- A nonempty family of connected rational algebraic subgroups generates a
connected rational algebraic group. No assumption about a generic fibre enters.
Source: Borel, Linear Algebraic Groups, second edition, §2.2. -/
theorem pel_family_group_isConnected {I : Type*} [Nonempty I] {n : ℕ}
    (H : I → Set (Matrix.GeneralLinearGroup (Fin n) ℂ))
    (ha : ∀ i, g2_IsRatAlgSubgroup (H i))
    (hc : ∀ i, IsConnected (H i)) :
    IsConnected (⋂₀ {G | g2_IsRatAlgSubgroup G ∧ ∀ i, H i ⊆ G}) := by
  have h1 : (1 : Matrix.GeneralLinearGroup (Fin n) ℂ) ∈ ⋃ i, H i :=
    Set.mem_iUnion.mpr ⟨Classical.arbitrary I, (ha _).2.1⟩
  have hU : IsConnected (⋃ i, H i) :=
    ⟨⟨1, h1⟩, isPreconnected_iUnion
      ⟨1, Set.mem_iInter.mpr fun i => (ha i).2.1⟩ fun i => (hc i).isPreconnected⟩
  have hi : ∀ x ∈ ⋃ i, H i, x⁻¹ ∈ ⋃ i, H i := by
    intro x hx
    obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hx
    exact Set.mem_iUnion.mpr ⟨i, (ha i).2.2.2 x hi⟩
  have hgal : g2h_GaloisStable (⋃ i, H i) := by
    intro σ g hg
    obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hg
    obtain ⟨S, hS⟩ := (ha i).1
    rw [hS] at hi
    exact Set.mem_iUnion.mpr ⟨i, hS.symm ▸ g2h_galoisStable_ratZeroSet S σ g hi⟩
  rw [pel_family_group_eq_ratClosure H ha,
    g2h_ratClosure_eq_closure (g2h_galoisStable_closure hgal)]
  exact (g2h_isConnected_closure_of_connected hU h1 hi).closure

#print axioms pel_family_group_eq_ratClosure
#print axioms pel_family_group_isConnected
#print axioms pel_family_group_isRatAlg
end HodgeLean.Foundations
