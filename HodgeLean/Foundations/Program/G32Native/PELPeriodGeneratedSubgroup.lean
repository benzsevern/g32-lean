import HodgeLean.Foundations.Program.G32Native.PELPeriodConjugationEquivariance

noncomputable section
set_option maxHeartbeats 400000
open HodgeLean.Foundations
namespace HodgeLean.Foundations.Program.GeneralTypeIII

/-- The abstract subgroup generated by the actual period matrices in the
retained component. No identification with an ambient isometry group is
part of this construction. -/
def pelPeriodGeneratedSubgroup (R : PELSplitReference) :
    Subgroup (Matrix.GeneralLinearGroup (Fin 12) ℂ) :=
  Subgroup.closure (Set.range fun z : PELSplitComponent R => pelPeriodMatrix R z.val)

/-- Every retained period matrix belongs to the generated subgroup. -/
theorem pelPeriodMatrix_mem_generated (R : PELSplitReference) (z : PELSplitComponent R) :
    pelPeriodMatrix R z.val ∈ pelPeriodGeneratedSubgroup R :=
  Subgroup.subset_closure ⟨z, rfl⟩

/-- Any rational algebraic group containing all retained period matrices
contains their abstract generated subgroup. -/
theorem pelPeriodGeneratedSubgroup_subset (R : PELSplitReference)
    (G : Set (Matrix.GeneralLinearGroup (Fin 12) ℂ))
    (hG : g2_IsRatAlgSubgroup G)
    (hperiod : ∀ z : PELSplitComponent R, pelPeriodMatrix R z.val ∈ G) :
    (pelPeriodGeneratedSubgroup R : Set _) ⊆ G := by
  let H : Subgroup (Matrix.GeneralLinearGroup (Fin 12) ℂ) :=
    { carrier := G
      one_mem' := hG.2.1
      mul_mem' := fun hx hy => hG.2.2.1 _ hx _ hy
      inv_mem' := fun hx => hG.2.2.2 _ hx }
  exact (Subgroup.closure_le H).mpr (by rintro _ ⟨z, rfl⟩; exact hperiod z)

/-- Rational polynomial equations extend from the generated subgroup to
its rational algebraic hull. -/
theorem pelPeriodGenerated_ratClosure_subset (R : PELSplitReference)
    (G : Set (Matrix.GeneralLinearGroup (Fin 12) ℂ))
    (hG : g2_IsRatAlgSubgroup G)
    (hperiod : ∀ z : PELSplitComponent R, pelPeriodMatrix R z.val ∈ G) :
    g2_ratClosure (pelPeriodGeneratedSubgroup R : Set _) ⊆ G := by
  obtain ⟨S, hS⟩ := hG.1
  intro x hx
  rw [hS]
  intro f hf
  apply hx f
  intro y hy
  have hyG := pelPeriodGeneratedSubgroup_subset R G hG hperiod hy
  rw [hS] at hyG
  exact hyG f hf

/-- Real identity-component conjugation preserves the generated subgroup.
Only orbit containment is used; transitivity is unnecessary for this step. -/
theorem pelPeriodGeneratedSubgroup_conjugate (R : PELSplitReference)
    (g : pelRealIsometries R) (hg : g ∈ connectedComponent (1 : pelRealIsometries R))
    (x : Matrix.GeneralLinearGroup (Fin 12) ℂ)
    (hx : x ∈ pelPeriodGeneratedSubgroup R) :
    (Matrix.GeneralLinearGroup.map (algebraMap ℝ ℂ) g.val)⁻¹ * x *
      Matrix.GeneralLinearGroup.map (algebraMap ℝ ℂ) g.val ∈ pelPeriodGeneratedSubgroup R := by
  let c := Matrix.GeneralLinearGroup.map (algebraMap ℝ ℂ) g.val
  have hh : pelPeriodGeneratedSubgroup R ≤
      (pelPeriodGeneratedSubgroup R).comap (MulAut.conj c⁻¹).toMonoidHom := by
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨z, rfl⟩
    change c⁻¹ * pelPeriodMatrix R z.val * (c⁻¹)⁻¹ ∈ pelPeriodGeneratedSubgroup R
    rw [inv_inv]
    change (Matrix.GeneralLinearGroup.map (algebraMap ℝ ℂ) g.val)⁻¹ *
      pelPeriodMatrix R z.val * Matrix.GeneralLinearGroup.map (algebraMap ℝ ℂ) g.val ∈ _
    rw [← pelPeriodMatrix_realConjugate]
    exact pelPeriodMatrix_mem_generated R
      ⟨_, pelRealConjugate_mem_component R g hg z⟩
  exact hh hx

#print axioms pelPeriodGeneratedSubgroup_conjugate
#print axioms pelPeriodGeneratedSubgroup
#print axioms pelPeriodMatrix_mem_generated
#print axioms pelPeriodGeneratedSubgroup_subset
#print axioms pelPeriodGenerated_ratClosure_subset
end HodgeLean.Foundations.Program.GeneralTypeIII
