import HodgeLean.Foundations.HodgeGroupAlgebraicDefs
import Mathlib.RingTheory.Polynomial.Basic

noncomputable section
namespace HodgeLean.Foundations
open MvPolynomial

/-- Passing to the ideal generated by rational equations preserves their zero set. -/
theorem pel_ratZeroSet_span {n : ℕ} (S : Set (MvPolynomial (Fin n × Fin n) ℚ)) :
    g2_ratZeroSet (Ideal.span S : Set (MvPolynomial (Fin n × Fin n) ℚ)) =
      g2_ratZeroSet S := by
  ext g
  constructor
  · intro h f hf
    exact h f (Ideal.subset_span hf)
  · intro h f hf
    have hle : Ideal.span S ≤ RingHom.ker (aeval (g1_coords g)).toRingHom :=
      Ideal.span_le.mpr h
    exact hle hf

/-- Every rational matrix zero set has a finite list of rational equations. -/
theorem pel_ratZeroSet_finite {n : ℕ} (S : Set (MvPolynomial (Fin n × Fin n) ℚ)) :
    ∃ T : Finset (MvPolynomial (Fin n × Fin n) ℚ), g2_ratZeroSet S = g2_ratZeroSet T := by
  obtain ⟨T, hT⟩ := IsNoetherian.noetherian (Ideal.span S)
  refine ⟨T, ?_⟩
  rw [← pel_ratZeroSet_span S, ← hT, pel_ratZeroSet_span]

/-- Rational algebraic subgroups of a fixed matrix group form a countable set. -/
theorem pel_countable_ratAlgSubgroups (n : ℕ) :
    Set.Countable {G : Set (Matrix.GeneralLinearGroup (Fin n) ℂ) |
      g2_IsRatAlgSubgroup G} := by
  apply (Set.countable_range (fun T : Finset (MvPolynomial (Fin n × Fin n) ℚ) =>
    g2_ratZeroSet (T : Set _))).mono
  intro G hG
  obtain ⟨S, rfl⟩ := hG.1
  obtain ⟨T, hT⟩ := pel_ratZeroSet_finite S
  exact ⟨T, hT.symm⟩

end HodgeLean.Foundations
