import HodgeLean.Ported.Hironaka.Scheme.Snc.Defs
import HodgeLean.Ported.Hironaka.Resolution.Algebraic.Order.SupPow

/-! A pairwise branch intersection is an SNC centre for an SNC family. -/
noncomputable section
set_option maxHeartbeats 400000
open CategoryTheory AlgebraicGeometry
namespace HodgeLean.Foundations.Program

/-- The sum of two branch ideals is generated by the corresponding SNC parameters. -/
theorem g32l4_pair_centre_hasSncWith {X : Scheme}
    (E : Scheme.DivisorFamily X) (hE : E.IsSnc) (u v : E.ι) :
    E.HasSncWith (E.component u ⊔ E.component v) := by
  classical
  intro x hx
  have hx' : x ∈ (E.component u).support ⊓ (E.component v).support := by
    rwa [Scheme.IdealSheafData.support_sup] at hx
  have hu : x ∈ (E.component u).support := hx'.1
  have hv : x ∈ (E.component v).support := hx'.2
  obtain ⟨n, z, hparam, c, hc, hI⟩ := hE.2 x
  refine ⟨n, z, ⟨hparam, c, hc, hI⟩, {c ⟨u, hu⟩, c ⟨v, hv⟩}, ?_⟩
  rw [Scheme.IdealSheafData.stalkIdeal_sup, hI ⟨u, hu⟩, hI ⟨v, hv⟩]
  simp only [Finset.coe_pair, Set.image_pair, Ideal.span_insert]

end HodgeLean.Foundations.Program
