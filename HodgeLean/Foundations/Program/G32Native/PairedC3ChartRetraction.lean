import HodgeLean.Foundations.Program.G32Native.PairedC3ReesEquationIso
import HodgeLean.Foundations.Program.G32Native.PairedLastBlowupChartIdeals
import Mathlib.Algebra.Polynomial.Div

/-! # Retraction of a Rees chart to the retained slice -/
noncomputable section
set_option maxHeartbeats 200000
open Polynomial
namespace HodgeLean.Foundations.Program.G32Native

/-- A branch relation modulo the slice ideal gives a retraction of the
actual Rees chart to the slice quotient, preserving the coefficient map.
Source: Hartshorne, Algebraic Geometry, II.7.13. -/
theorem paired_c3_chart_retraction
    {A B : Type*} [CommRing A] [CommRing B]
    (f : A →+* B) (u v a : A) (t : B) (I : Ideal A)
    (hs : Function.Surjective (eval₂RingHom f t))
    (hk : RingHom.ker (eval₂RingHom f t) = Ideal.span {C v - X * C u})
    (ha : v - a * u ∈ I) :
    ∃ g : B →+* A ⧸ I, g.comp f = Ideal.Quotient.mk I ∧
      g t = Ideal.Quotient.mk I a := by
  let e := eval₂RingHom (Ideal.Quotient.mk I) (Ideal.Quotient.mk I a)
  have he : RingHom.ker (eval₂RingHom f t) ≤ RingHom.ker e := by
    rw [hk]
    apply Ideal.span_le.mpr
    intro p hp
    obtain rfl := Set.mem_singleton_iff.mp hp
    change eval₂ (Ideal.Quotient.mk I) (Ideal.Quotient.mk I a) (C v - X * C u) = 0
    simpa only [eval₂_sub, eval₂_C, eval₂_mul, eval₂_X, ← map_mul, ← map_sub,
      Ideal.Quotient.eq_zero_iff_mem] using ha
  let g := (eval₂RingHom f t).liftOfSurjective hs ⟨e, he⟩
  have hg (p : A[X]) : g (eval₂ f t p) = e p :=
    RingHom.liftOfSurjective_comp_apply _ hs ⟨e, he⟩ p
  refine ⟨g, ?_, ?_⟩
  · ext b
    simpa only [RingHom.comp_apply, e, coe_eval₂RingHom, eval₂_C] using hg (C b)
  · simpa only [e, coe_eval₂RingHom, eval₂_X] using hg X

#print axioms paired_c3_chart_retraction
/-- The retraction kernel is generated by the whole slice ideal and the
translated ratio; no transverse generating sequence is required.
Source: Hartshorne, Algebraic Geometry, II.7.13. -/
theorem paired_c3_chart_retraction_kernel
    {A B : Type*} [CommRing A] [CommRing B]
    (f : A →+* B) (a : A) (t : B) (I : Ideal A)
    (hs : Function.Surjective (eval₂RingHom f t))
    (g : B →+* A ⧸ I) (hf : g.comp f = Ideal.Quotient.mk I)
    (ht : g t = Ideal.Quotient.mk I a) :
    RingHom.ker g = I.map f ⊔ Ideal.span {t - f a} := by
  have hgf (b : A) : g (f b) = Ideal.Quotient.mk I b :=
    DFunLike.congr_fun hf b
  have he (p : A[X]) : g (eval₂ f t p) = Ideal.Quotient.mk I (p.eval a) := by
    have h : g.comp (eval₂RingHom f t) =
        (Ideal.Quotient.mk I).comp (evalRingHom a) := by
      apply Polynomial.ringHom_ext
      · intro b
        simpa only [RingHom.comp_apply, coe_eval₂RingHom, eval₂_C, coe_evalRingHom, eval_C] using hgf b
      · simpa only [RingHom.comp_apply, coe_eval₂RingHom, eval₂_X, coe_evalRingHom, eval_X] using ht
    exact DFunLike.congr_fun h p
  apply le_antisymm
  · intro b hb
    obtain ⟨p, rfl⟩ := hs b
    have hp : p.eval a ∈ I := by
      rw [← Ideal.Quotient.eq_zero_iff_mem, ← he]
      exact hb
    obtain ⟨q, hq⟩ := (X_sub_C_dvd_sub_C_eval (p := p) (a := a))
    have hdiff : eval₂ f t p - f (p.eval a) =
        (t - f a) * eval₂ f t q := by
      have h := congrArg (eval₂RingHom f t) hq
      simpa only [coe_eval₂RingHom, eval₂_sub, eval₂_C, eval₂_mul, eval₂_X] using h
    have hmem : eval₂ f t p - f (p.eval a) ∈
        I.map f ⊔ Ideal.span {t - f a} := by
      rw [hdiff]
      exact Submodule.mem_sup_right (Ideal.mem_span_singleton.mpr ⟨eval₂ f t q, rfl⟩)
    have hc : f (p.eval a) ∈ I.map f ⊔ Ideal.span {t - f a} :=
      Submodule.mem_sup_left (Ideal.mem_map_of_mem f hp)
    simpa only [sub_add_cancel, coe_eval₂RingHom] using (I.map f ⊔ Ideal.span {t - f a}).add_mem hmem hc
  · apply sup_le
    · rw [Ideal.map_le_iff_le_comap]
      intro b hb
      change g (f b) = 0
      rw [hgf, Ideal.Quotient.eq_zero_iff_mem]
      exact hb
    · apply Ideal.span_le.mpr
      intro b hb
      obtain rfl := Set.mem_singleton_iff.mp hb
      change g (t - f a) = 0
      rw [map_sub, ht, hgf, sub_self]

#print axioms paired_c3_chart_retraction_kernel
/-- Cancellation of a branch generator on the slice quotient transfers to
the translated-ratio kernel in the actual chart ring.
Source: Hartshorne, Algebraic Geometry, II.7.13. -/
theorem paired_c3_chart_kernel_cancel
    {A B : Type*} [CommRing A] [CommRing B]
    (f : A →+* B) (u : A) (I : Ideal A)
    (g : B →+* A ⧸ I) (hf : g.comp f = Ideal.Quotient.mk I)
    (hu : ∀ x : A, u * x ∈ I → x ∈ I) :
    ∀ x : B, f u * x ∈ RingHom.ker g → x ∈ RingHom.ker g := by
  intro x hx
  obtain ⟨z, hz⟩ := Ideal.Quotient.mk_surjective (g x)
  have hzmem : u * z ∈ I := by
    rw [← Ideal.Quotient.eq_zero_iff_mem, map_mul, hz]
    have hfu : g (f u) = Ideal.Quotient.mk I u := DFunLike.congr_fun hf u
    rw [← hfu, ← map_mul]
    exact hx
  change g x = 0
  rw [← hz, Ideal.Quotient.eq_zero_iff_mem]
  exact hu z hzmem

#print axioms paired_c3_chart_kernel_cancel
end HodgeLean.Foundations.Program.G32Native
