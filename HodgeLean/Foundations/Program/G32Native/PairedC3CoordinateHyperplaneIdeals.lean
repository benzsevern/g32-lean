import HodgeLean.Foundations.Program.G32Native.PairedConormalNativeHyperplane
import HodgeLean.Foundations.Program.G32Native.PairedConormalPolynomialOpens
import HodgeLean.Foundations.Program.G32Native.PairedConormalNativeRatio
import HodgeLean.Foundations.Program.G32Native.PairedC3HyperplaneKernelTransport

/-! # Every actual coordinate hyperplane on polynomial projective space -/
noncomputable section
set_option maxHeartbeats 200000
set_option synthInstance.maxHeartbeats 20000
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
open CategoryTheory CategoryTheory.Limits AlgebraicGeometry TopologicalSpace
attribute [local instance] MvPolynomial.gradedAlgebra
namespace HodgeLean.Foundations.Program.G32Native
open HodgeLean.Foundations.Program

/-- The reduced coordinate hyperplane with its specified omitted coordinate. -/
def pairedC3CoordinateHyperplaneIdeal (k : ℕ) (j : Fin (k + 1)) :
    (pairedC3Proj k).IdealSheafData :=
  Scheme.IdealSheafData.vanishingIdeal
    ⟨(Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (k + 1)) ℂ)
      (MvPolynomial.X j)).carrierᶜ,
      (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (k + 1)) ℂ)
        (MvPolynomial.X j)).isOpen.isClosed_compl⟩

/-- The supplied residue hyperplane pulls back to its literal coordinate
hyperplane, for every coordinate index, through the specified scheme map. -/
theorem paired_c3_coordinate_hyperplane_comap (k : ℕ) (j : Fin (k + 1)) :
    (s2e_s2b_residueIdeal k j).comap
      (s2_polynomialProjectiveSpaceIso ℂ (Fin (k + 1))).hom =
        pairedC3CoordinateHyperplaneIdeal k j := by
  unfold s2e_s2b_residueIdeal pairedC3CoordinateHyperplaneIdeal
  rw [s2e_open_comap_vanishingIdeal]
  apply congrArg Scheme.IdealSheafData.vanishingIdeal
  apply Closeds.ext
  ext x
  change x ∉ ((s2_polynomialProjectiveSpaceIso ℂ (Fin (k + 1))).hom ⁻¹ᵁ
      AlgebraicGeometry.ComplexProjectiveSpace.projectiveSpaceBasicOpen k (MvPolynomial.X j)) ↔
        x ∉ ProjSpace.standardOpen ℂ k j
  rw [conormal_polynomialProjectiveSpaceIso_preimage_coordinate]

/-- The actual relation kernel is identified with the literal native
coordinate ideal through the existing natural ideal-pullback comparison. -/
def pairedC3HyperplaneKernelNativeIso (k : ℕ) (j : Fin (k + 1))
    (Q : (pairedC3Proj k).Modules) (eQ : Q ≅ pairedC3HyperplaneQuotient k j) :
    kernel (pairedC3HyperplaneUnit k j ≫ eQ.inv) ≅
      Conormal.idealModule (pairedC3CoordinateHyperplaneIdeal k j).subschemeι :=
  pairedC3HyperplaneKernelTransport k j Q eQ ≪≫
    HodgeLean.Foundations.Curves.Picard.LineBundles.idealModuleTransportIso
      (paired_c3_coordinate_hyperplane_comap k j)
      (paired_idealPullbackIso_of_iso
        (s2_polynomialProjectiveSpaceIso ℂ (Fin (k + 1))) (s2e_s2b_residueIdeal k j))

#print axioms pairedC3HyperplaneKernelNativeIso

section
variable (k : ℕ)
local notation "𝒢" => MvPolynomial.homogeneousSubmodule (Fin (k + 1)) ℂ

/-- The actual native hyperplane ideal on the specified affine chart is
generated by its same coordinate ratio, with its scale retained. -/
theorem paired_c3_coordinate_hyperplane_away (i j : Fin (k + 1)) :
    Ideal.map (Scheme.ΓSpecIso (.of (HomogeneousLocalization.Away 𝒢
      (MvPolynomial.X i)))).hom.hom
      (((pairedC3CoordinateHyperplaneIdeal k j).comap
        (Proj.awayι 𝒢 (MvPolynomial.X i) (ProjSpace.X_mem_one ℂ k i) one_pos)).ideal
          ⟨⊤, isAffineOpen_top _⟩) = Ideal.span {ProjSpace.ratio ℂ k i j} := by
  let f := Proj.awayι 𝒢 (MvPolynomial.X i) (ProjSpace.X_mem_one ℂ k i) one_pos
  have hpre : f ⁻¹ᵁ Proj.basicOpen 𝒢 (MvPolynomial.X j) =
      PrimeSpectrum.basicOpen (ProjSpace.ratio ℂ k i j) := by
    dsimp only [f]
    erw [Proj.awayι_preimage_basicOpen (𝒜 := 𝒢) (f := MvPolynomial.X i)
      (g := MvPolynomial.X j) (m := 1) (m' := 1)
      (ProjSpace.X_mem_one ℂ k i) one_pos (ProjSpace.X_mem_one ℂ k j) one_pos]
    congr 1
    apply HomogeneousLocalization.val_injective
    simp only [HomogeneousLocalization.Away.isLocalizationElem,
      HomogeneousLocalization.Away.val_mk, ProjSpace.ratio, pow_one]
  have hclosed :
      (⟨(Proj.basicOpen 𝒢 (MvPolynomial.X j)).carrierᶜ,
        (Proj.basicOpen 𝒢 (MvPolynomial.X j)).isOpen.isClosed_compl⟩ : Closeds (Proj 𝒢)).preimage
        f.continuous =
      ⟨(PrimeSpectrum.basicOpen (ProjSpace.ratio ℂ k i j)).carrierᶜ,
        (PrimeSpectrum.basicOpen (ProjSpace.ratio ℂ k i j)).isOpen.isClosed_compl⟩ := by
    apply Closeds.ext
    change f ⁻¹' (Proj.basicOpen 𝒢 (MvPolynomial.X j)).carrierᶜ = _
    rw [Set.preimage_compl]
    exact congrArg (fun U => U.carrierᶜ) hpre
  unfold pairedC3CoordinateHyperplaneIdeal
  erw [s2e_open_comap_vanishingIdeal, hclosed]
  exact s2e_spec_principal_vanishingIdeal _ _ (paired_nativeRatio_span_radical ℂ k i j)

end

#print axioms paired_c3_coordinate_hyperplane_away
#print axioms pairedC3CoordinateHyperplaneIdeal
#print axioms paired_c3_coordinate_hyperplane_comap
end HodgeLean.Foundations.Program.G32Native
