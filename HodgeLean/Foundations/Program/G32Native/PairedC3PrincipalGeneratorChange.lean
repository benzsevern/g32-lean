import HodgeLean.Foundations.Program.G32Native.PairedC3ResidualGeneratorIndependence

/-! # Unit changes from equality of the actual branch ideals -/
noncomputable section
set_option maxHeartbeats 200000
namespace HodgeLean.Foundations.Program.G32Native

/-- Equality of principal ideals generated by regular elements determines a
unit change of generator, even when the ambient ring has zero divisors. -/
theorem pairedC3_principal_generator_unit
    {A : Type*} [CommRing A] (u u' : A) (hu : IsRegular u)
    (h : Ideal.span {u} = Ideal.span {u'}) :
    ∃ a : Aˣ, u' = (a : A) * u := by
  have hu' : u' ∈ Ideal.span {u} := h.symm ▸ Ideal.subset_span rfl
  have hum : u ∈ Ideal.span {u'} := h ▸ Ideal.subset_span rfl
  obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp hu'
  obtain ⟨b, hb⟩ := Ideal.mem_span_singleton'.mp hum
  have hab : a * b = 1 := by
    apply hu.right
    calc
      (a * b) * u = b * (a * u) := by ring
      _ = b * u' := by rw [ha]
      _ = u := hb
      _ = 1 * u := (one_mul _).symm
  exact ⟨Units.mkOfMulEqOne a b hab, ha.symm⟩

/-- Equal branch ideals on an overlap supply both units required for
independence of the normalized residual parameter. Only the original branch
ideals and the actual Rees and slice equations enter the comparison. -/
theorem pairedC3_residual_parameter_of_equal_branch_ideals
    {A B C : Type*} [CommRing A] [CommRing B] [CommRing C]
    (I : Ideal A) (f : A →+* B) (g : B →+* C)
    (hI : I ≤ RingHom.ker (g.comp f))
    (u v u' v' α α' : A) (t t' : B)
    (hu : IsRegular u) (hv : IsRegular v)
    (huf : IsRegular (f u)) (hqu : IsRegular (Ideal.Quotient.mk I u))
    (hu' : Ideal.span {u} = Ideal.span {u'})
    (hv' : Ideal.span {v} = Ideal.span {v'})
    (ht : f v = t * f u) (ht' : f v' = t' * f u')
    (hα : v - α * u ∈ I) (hα' : v' - α' * u' ∈ I)
    (c c' : Cˣ) (hc : (c : C) = g (f α)) (hc' : (c' : C) = g (f α')) :
    (↑c'⁻¹ : C) * g t' = (↑c⁻¹ : C) * g t := by
  obtain ⟨a, ha⟩ := pairedC3_principal_generator_unit u u' hu hu'
  obtain ⟨b, hb⟩ := pairedC3_principal_generator_unit v v' hv hv'
  apply pairedC3_residual_parameter_generator_independent I f g hI u v α α'
    a b t t' huf hqu ht
  · simpa only [← ha, ← hb] using ht'
  · exact hα
  · simpa only [← ha, ← hb] using hα'
  · exact hc
  · exact hc'

#print axioms pairedC3_principal_generator_unit
#print axioms pairedC3_residual_parameter_of_equal_branch_ideals
end HodgeLean.Foundations.Program.G32Native
