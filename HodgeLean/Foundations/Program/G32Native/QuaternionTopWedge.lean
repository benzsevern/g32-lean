import Mathlib.LinearAlgebra.ExteriorPower.Basis
import Mathlib.LinearAlgebra.Determinant
import Mathlib.LinearAlgebra.FiniteDimensional.Basic

noncomputable section
set_option maxHeartbeats 200000
namespace HodgeLean.Foundations.Program.QuaternionGraph
variable {K E V : Type*} [Field K] [AddCommGroup E] [Module K E]
  [AddCommGroup V] [Module K V]

/-- The top wedge of a basis is nonzero, detected by its determinant. -/
theorem basis_topWedge_ne_zero {n : ℕ} (b : Module.Basis (Fin n) K E) :
    exteriorPower.ιMulti K n b ≠ 0 := by
  intro h
  have he := congrArg (exteriorPower.alternatingMapLinearEquiv b.det) h
  rw [exteriorPower.alternatingMapLinearEquiv_apply_ιMulti, Module.Basis.det_self,
    map_zero] at he
  exact one_ne_zero he

/-- The exterior power in the basis degree is generated by the top basis wedge. -/
theorem basis_topWedge_span {n : ℕ} (b : Module.Basis (Fin n) K E) :
    Submodule.span K {exteriorPower.ιMulti K n b} = ⊤ := by
  letI : Module.Finite K E := Module.Finite.of_basis b
  apply Submodule.eq_top_of_finrank_eq
  rw [finrank_span_singleton (basis_topWedge_ne_zero b), exteriorPower.finrank_eq,
    Module.finrank_eq_card_basis b, Fintype.card_fin, Nat.choose_self]

/-- The top exterior image of a framed space is the line generated by its frame wedge. -/
theorem range_topExterior_eq_span {n : ℕ} (b : Module.Basis (Fin n) K E) (f : E →ₗ[K] V) :
    LinearMap.range (exteriorPower.map n f) =
      Submodule.span K {exteriorPower.ιMulti K n (fun i => f (b i))} := by
  rw [← Submodule.map_top, ← basis_topWedge_span b, Submodule.map_span]
  simp only [Set.image_singleton, exteriorPower.map_apply_ιMulti, Function.comp_def]

#print axioms range_topExterior_eq_span
end HodgeLean.Foundations.Program.QuaternionGraph
