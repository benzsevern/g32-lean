import Mathlib.RingTheory.Ideal.Cotangent
import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.Algebra.Exact.Basic

/-! # Ideal algebra for the union/intersection conormal maps -/
noncomputable section
set_option maxHeartbeats 400000
namespace HodgeLean.Foundations.Program.G32Native

variable {R : Type*} [CommRing R]

/-- The ideal intersection identity governing the middle kernel. -/
lemma unionConormal_square_intersection (I J : Ideal R) :
    I ⊓ (I ^ 2 ⊔ J) = I ^ 2 ⊔ (I ⊓ J) := by
  rw [inf_comm, sup_inf_assoc_of_le J (Ideal.pow_le_self (by decide : 2 ≠ 0)),
    inf_comm J I]

/-- The map of ideals obtained by reducing modulo the second component. -/
def unionIdealReduction (I J : Ideal R) : I →ₗ[R] I.map (Ideal.Quotient.mk J) where
  toFun x := ⟨Ideal.Quotient.mk J x, Ideal.mem_map_of_mem _ x.2⟩
  map_add' x y := by ext; exact map_add _ _ _
  map_smul' r x := by ext; exact map_mul _ _ _

/-- Reduction onto the image ideal is surjective. -/
lemma unionIdealReduction_surjective (I J : Ideal R) :
    Function.Surjective (unionIdealReduction I J) := by
  intro x
  obtain ⟨y, hy, he⟩ := (Ideal.mem_map_iff_of_surjective _
    Ideal.Quotient.mk_surjective).mp x.2
  exact ⟨⟨y, hy⟩, Subtype.ext he⟩

/-- A lift is square-zero in the image ideal precisely modulo the square and J. -/
lemma unionIdealReduction_mem_square (I J : Ideal R) (x : I) :
    (unionIdealReduction I J x : R ⧸ J) ∈ (I.map (Ideal.Quotient.mk J)) ^ 2 ↔
      (x : R) ∈ I ^ 2 ⊔ J := by
  rw [← Ideal.map_pow]
  change Ideal.Quotient.mk J (x : R) ∈ (I ^ 2).map (Ideal.Quotient.mk J) ↔ _
  rw [Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective]
  constructor
  · rintro ⟨y, hy, he⟩
    have hxy : (x : R) - y ∈ J := Ideal.Quotient.eq.mp he.symm
    exact Submodule.mem_sup.mpr ⟨y, hy, (x : R) - y, hxy, by abel⟩
  · rintro hx
    obtain ⟨y, hy, z, hz, he⟩ := Submodule.mem_sup.mp hx
    refine ⟨y, hy, Ideal.Quotient.eq.mpr ?_⟩
    rw [← he]
    simpa only [sub_add_cancel_left] using J.neg_mem hz

/-- The union conormal restricted to the first component, in ideal coordinates. -/
abbrev UnionConormalSource (I J : Ideal R) :=
  ↥(I ⊓ J) ⧸ (I • ⊤ : Submodule R ↥(I ⊓ J))

/-- The first map in ideal coordinates. -/
def unionConormalAlgebraFirst (I J : Ideal R) :
    UnionConormalSource I J →ₗ[R] I.Cotangent :=
  (I • ⊤ : Submodule R ↥(I ⊓ J)).liftQ
    (I.toCotangent.comp (Submodule.inclusion inf_le_left)) (by
      intro x hx
      refine Submodule.smul_induction_on hx ?_ ?_
      · intro r hr m _
        change I.toCotangent ⟨r * (m : R), _⟩ = 0
        exact (I.toCotangent_eq_zero _).mpr (by
          rw [pow_two]
          exact Ideal.mul_mem_mul hr m.2.1)
      · intro x y hx hy
        exact (LinearMap.ker _).add_mem hx hy)

/-- The second map in ideal coordinates. -/
def unionConormalAlgebraLast (I J : Ideal R) :
    I.Cotangent →ₗ[R] (I.map (Ideal.Quotient.mk J)).Cotangent :=
  (I • ⊤ : Submodule R I).liftQ
    (((I.map (Ideal.Quotient.mk J)).toCotangent.restrictScalars R).comp
      (unionIdealReduction I J)) (by
      intro x hx
      change (I.map (Ideal.Quotient.mk J)).toCotangent (unionIdealReduction I J x) = 0
      apply (Ideal.toCotangent_eq_zero _ _).mpr
      apply (unionIdealReduction_mem_square I J x).mpr
      have hx' : I.toCotangent x = 0 :=
        (Submodule.Quotient.mk_eq_zero _).mpr hx
      exact (show I ^ 2 ≤ I ^ 2 ⊔ J from le_sup_left) ((I.toCotangent_eq_zero x).mp hx'))

/-- Evaluation of the first map on an ideal representative. -/
lemma unionConormalAlgebraFirst_mk (I J : Ideal R) (x : ↥(I ⊓ J)) :
    unionConormalAlgebraFirst I J
      ((I • ⊤ : Submodule R ↥(I ⊓ J)).mkQ x) = I.toCotangent ⟨x, x.2.1⟩ := rfl

/-- Evaluation of the second map on a conormal representative. -/
lemma unionConormalAlgebraLast_mk (I J : Ideal R) (x : I) :
    unionConormalAlgebraLast I J (I.toCotangent x) =
      (I.map (Ideal.Quotient.mk J)).toCotangent (unionIdealReduction I J x) := rfl

/-- The two ideal-coordinate maps form a complex. -/
lemma unionConormalAlgebra_comp (I J : Ideal R) :
    (unionConormalAlgebraLast I J).comp (unionConormalAlgebraFirst I J) = 0 := by
  apply LinearMap.ext
  intro x
  obtain ⟨x, rfl⟩ := (I • ⊤ : Submodule R ↥(I ⊓ J)).mkQ_surjective x
  rw [LinearMap.comp_apply, unionConormalAlgebraFirst_mk, unionConormalAlgebraLast_mk]
  have hx : unionIdealReduction I J ⟨x, x.2.1⟩ = 0 :=
    Subtype.ext (Ideal.Quotient.eq_zero_iff_mem.mpr x.2.2)
  rw [hx, map_zero, LinearMap.zero_apply]

/-- The intersection conormal is generated by the first component ideal. -/
lemma unionConormalAlgebraLast_surjective (I J : Ideal R) :
    Function.Surjective (unionConormalAlgebraLast I J) := by
  intro x
  obtain ⟨x, rfl⟩ := (I.map (Ideal.Quotient.mk J)).toCotangent_surjective x
  obtain ⟨y, rfl⟩ := unionIdealReduction_surjective I J x
  exact ⟨I.toCotangent y, unionConormalAlgebraLast_mk I J y⟩

/-- Right exactness holds for every pair of ideals, before freeness assumptions. -/
lemma unionConormalAlgebra_exact (I J : Ideal R) :
    Function.Exact (unionConormalAlgebraFirst I J) (unionConormalAlgebraLast I J) := by
  apply LinearMap.exact_of_comp_of_mem_range (unionConormalAlgebra_comp I J)
  intro x hx
  obtain ⟨x, rfl⟩ := I.toCotangent_surjective x
  rw [unionConormalAlgebraLast_mk, Ideal.toCotangent_eq_zero,
    unionIdealReduction_mem_square] at hx
  have hx' : (x : R) ∈ I ^ 2 ⊔ (I ⊓ J) := by
    rw [← unionConormal_square_intersection]
    exact ⟨x.2, hx⟩
  obtain ⟨y, hy, z, hz, he⟩ := Submodule.mem_sup.mp hx'
  refine ⟨(I • ⊤ : Submodule R ↥(I ⊓ J)).mkQ ⟨z, hz⟩, ?_⟩
  rw [unionConormalAlgebraFirst_mk, Ideal.toCotangent_eq]
  change z - (x : R) ∈ I ^ 2
  rw [← he]
  simpa only [sub_add_cancel_right] using (I ^ 2).neg_mem hy

/-- Every element of J multiplies the middle term into the first image. -/
lemma unionConormalAlgebra_scalar_mem_range (I J : Ideal R) (c : R) (hc : c ∈ J)
    (x : I.Cotangent) : c • x ∈ LinearMap.range (unionConormalAlgebraFirst I J) := by
  obtain ⟨x, rfl⟩ := I.toCotangent_surjective x
  let y : ↥(I ⊓ J) := ⟨c * (x : R), I.mul_mem_left c x.2, J.mul_mem_right _ hc⟩
  refine ⟨(I • ⊤ : Submodule R ↥(I ⊓ J)).mkQ y, ?_⟩
  rw [unionConormalAlgebraFirst_mk, ← map_smul]
  rfl

/-- The first map is linear over the coordinate ring of the first component. -/
def unionConormalAlgebraFirstOver (I J : Ideal R) :
    UnionConormalSource I J →ₗ[R ⧸ I] I.Cotangent where
  toFun := unionConormalAlgebraFirst I J
  map_add' := (unionConormalAlgebraFirst I J).map_add
  map_smul' c x := by
    obtain ⟨c, rfl⟩ := Ideal.Quotient.mk_surjective c
    obtain ⟨x, rfl⟩ := (I • ⊤ : Submodule R ↥(I ⊓ J)).mkQ_surjective x
    change I.toCotangent ⟨c * (x : R), _⟩ =
      Ideal.Quotient.mk I c • I.toCotangent ⟨x, x.2.1⟩
    rfl

/-- The scalar image assertion over the component's quotient ring. -/
lemma unionConormalAlgebraFirstOver_scalar_mem_range
    (I J : Ideal R) (c : R) (hc : c ∈ J) (x : I.Cotangent) :
    Ideal.Quotient.mk I c • x ∈ LinearMap.range (unionConormalAlgebraFirstOver I J) := by
  obtain ⟨x, rfl⟩ := I.toCotangent_surjective x
  exact unionConormalAlgebra_scalar_mem_range I J c hc (I.toCotangent x)

end HodgeLean.Foundations.Program.G32Native
