import HodgeLean.Foundations.Program.CyclotomicWeilDefs
import HodgeLean.Foundations.Program.PrymTheoremAOpenSupply
import HodgeLean.Foundations.Program.PrymFamilyB4Defs
import HodgeLean.Papers.PapersG32Certificates
import HodgeLean.Papers.PapersSupply
import HodgeLean.Adapters.PWTheorem42NoPull

/-! # Carriers for G32 Proposition 4.6 as an assembly

The G32 group and its natural representation, cyclic suppliers and their exponents, the
geometric realization of one fibre inside the Jacobian of its cover, Schoen's supplier input,
and Milne's invariance input on the powers of that Jacobian. The two literature inputs are
structures of propositions; no field asserts algebraicity of the Weil classes of the fibre, a
character identity, or a contraction. HC no distance; AV milestone no distance.
-/

noncomputable section

open scoped TensorProduct CategoryTheory.MonObj
open CategoryTheory AlgebraicGeometry AlgebraicGeometry.ComplexPoint
open HodgeLean.RealDefs HodgeLean.Adapters HodgeLean.Papers HodgeLean.Foundations
open HodgeLean.Foundations.Symplectic

namespace HodgeLean.Foundations.Program

/-! ## Numerical accounting -/

/-- The cyclotomic determinant degree and the quadratic determinant degree on a
primitive supplier with cyclotomic rank `h`. The second coordinate is the dimension
of the primitive abelian variety, hence its quadratic middle determinant degree
when the restricted action is of Weil type. This is numerical accounting only;
no realization or field action is supplied by this definition.
Source: G32 v0.16, Section 4.1 (the spaces `V_t` and `W_F`) and Proposition 4.6,
proof, paragraph Degrees; `HodgeLean.RealDefs.weilClassOf`.
-/
def g32p_supplierDegrees (m h : ℕ) : ℕ × ℕ :=
  (h, Nat.totient m * h / 2)

example : g32p_supplierDegrees 3 10 = (10, 10) := by decide

example : g32p_supplierDegrees 6 226 = (226, 226) := by decide

example : g32p_supplierDegrees 12 42120 = (42120, 84240) := by decide

example : g32p_supplierDegrees 15 67392 = (67392, 269568) := by decide

example : (g32p_supplierDegrees 12 42120).1 ≠
    (g32p_supplierDegrees 12 42120).2 := by decide

example : (g32p_supplierDegrees 15 67392).1 ≠
    (g32p_supplierDegrees 15 67392).2 := by decide

/-! ## The group and its representations -/

/-- The group `G = G₃₂`, the finite matrix group generated by the printed `r₁, r₂, x, y`.
Source: G32 v0.16, Subsection 3.3 and Appendix A; `b4b_Group`. -/
abbrev g32p_G : Type := b4b_Group

example : Fintype g32p_G := inferInstance

/-- The natural representation `ρ` of `G` on `ℂ⁴`, by the matrices themselves.
Source: G32 v0.16, Subsection 3.3 ("its natural representation `ρ` on `V_ρ = K⁴`"). -/
def g32p_rho : FDRep ℂ g32p_G :=
  FDRep.of ((Matrix.toLinAlgEquiv' : Matrix (Fin 4) (Fin 4) ℂ ≃ₐ[ℂ] _).toMonoidHom.comp
    b4b_toMatrix)

example (g : g32p_G) (v : Fin 4 → ℂ) :
    g32p_rho.ρ g v = (b4b_toMatrix g).mulVec v := rfl

/-- The thirteen representatives of the class datum, as elements of `G`: `r₁` six times, `r₂`
six times and `x²` once.
Source: G32 v0.16, Definition 3.5; `g32h_classRep`. -/
def g32p_classDatum (j : Fin 13) : g32p_G :=
  ⟨g32h_classRep g32h_omega j, by
    unfold g32h_classRep
    split_ifs
    · exact Submonoid.subset_closure (by simp)
    · exact Submonoid.subset_closure (by simp)
    · exact Submonoid.mul_mem _ (Submonoid.subset_closure (by simp))
        (Submonoid.subset_closure (by simp))⟩

example : (g32p_classDatum 12 : Matrix (Fin 4) (Fin 4) ℂ) =
    g32X g32h_omega * g32X g32h_omega := rfl

/-- The class datum as a list, the format of `papersExpsList`.
Source: G32 v0.16, Definition 3.5. -/
def g32p_classList : List g32p_G := List.ofFn g32p_classDatum

example : g32p_classList.length = 13 := List.length_ofFn

/-- The Chevalley–Weil multiplicity `m_τ = -2 d + Σ_j c_τ(g_j)` of a representation over the
class datum, with `c_τ(g) = rk(τ(g) - 1)`. For a nontrivial irreducible `τ` this is the
multiplicity of `τ` in `H¹(C, ℂ)` of every cover with this class datum.
Source: G32 v0.16, Proposition 3.1 (first formula) and Definition 3.5. -/
def g32p_cwMult (τ : FDRep ℂ g32p_G) : ℤ :=
  -2 * (Module.finrank ℂ τ : ℤ) +
    ∑ j : Fin 13, (Module.finrank ℂ (LinearMap.range (τ.ρ (g32p_classDatum j) - 1)) : ℤ)

example (τ : FDRep ℂ g32p_G) : g32p_cwMult τ =
    -2 * (Module.finrank ℂ τ : ℤ) +
      ∑ j : Fin 13, (Module.finrank ℂ (LinearMap.range (τ.ρ (g32p_classDatum j) - 1)) : ℤ) :=
  rfl

/-- Nondegeneracy check: the natural representation has multiplicity `m_ρ = 6`, the rank of the
sixfolds, rather than zero.
Source: G32 v0.16, proof of Lemma 3.6 ("`m_ρ = -8 + 12 + 2 = 6`"); `g32h_multCW_classRep`. -/
example : g32p_cwMult g32p_rho = 6 := by
  have h := g32h_multCW_classRep g32h_omega g32h_omega_sq_add
  unfold g32h_multCW at h
  unfold g32p_cwMult
  have hd : Module.finrank ℂ g32p_rho = 4 := by
    change Module.finrank ℂ (Fin 4 → ℂ) = 4
    simp
  have key : ∀ M : Matrix (Fin 4) (Fin 4) ℂ,
      Module.finrank ℂ (LinearMap.range (Matrix.toLin' M - 1)) = (M - 1).rank := by
    intro M
    have hM : Matrix.toLin' M - 1 = Matrix.toLin' (M - 1) := by
      rw [map_sub, Matrix.toLin'_one, Module.End.one_eq_id]
    rw [hM]
    rfl
  have hr : ∀ j, Module.finrank ℂ (LinearMap.range (g32p_rho.ρ (g32p_classDatum j) - 1)) =
      (g32h_classRep g32h_omega j - 1).rank := fun j => key _
  rw [hd]
  simp only [hr]
  push_cast
  linarith

/-- A representation is self-dual when its character is real.
Source: G32 v0.16, Subsection 4.2 (orthogonal, quaternionic and non-self-dual `τ`). -/
def g32p_SelfDual (τ : FDRep ℂ g32p_G) : Prop :=
  ∀ g, star (τ.character g) = τ.character g

example (τ : FDRep ℂ g32p_G) (h : g32p_SelfDual τ) (g : g32p_G) :
    star (τ.character g) = τ.character g := h g

/-- A quaternionic representation: self-dual with Frobenius–Schur indicator `-1`.
Source: G32 v0.16, Subsection 4.2; Serre, *Linear representations of finite groups*, §13.2,
Proposition 39. -/
def g32p_Quaternionic (τ : FDRep ℂ g32p_G) : Prop :=
  g32p_SelfDual τ ∧ ∑ g, τ.character (g * g) = -(Fintype.card g32p_G : ℂ)

example (τ : FDRep ℂ g32p_G) (h : g32p_Quaternionic τ) : g32p_SelfDual τ := h.1

/-! ## Suppliers -/

/-- A supplier `(H′, χ)`: a subgroup and a surjective character onto `ℤ/m`, `m ≥ 3`, written
additively as in `papersExps`.
Source: G32 v0.16, Definition 4.1. -/
structure g32p_Supplier where
  H : Subgroup g32p_G
  m : ℕ
  three_le : 3 ≤ m
  χ : H →* Multiplicative (ZMod m)
  surjective : Function.Surjective χ

/-- A supplier of order three on the whole group, provided a surjective character exists. -/
example (χ : (⊤ : Subgroup g32p_G) →* Multiplicative (ZMod 3)) (hχ : Function.Surjective χ) :
    g32p_Supplier := ⟨⊤, 3, le_rfl, χ, hχ⟩

instance g32p_Supplier.neZero (S : g32p_Supplier) : NeZero S.m :=
  ⟨by have := S.three_le; omega⟩

/-- The primitive root `ζ_m` of the coefficient field `F = ℚ(μ_m)`.
Source: G32 v0.16, Subsection 4.1 (`F_χ = ℚ(μ_m)`); Mathlib `IsCyclotomicExtension.zeta`. -/
def g32p_zeta (S : g32p_Supplier) : cyc_Field S.m :=
  IsCyclotomicExtension.zeta S.m ℚ (cyc_Field S.m)

example (S : g32p_Supplier) : IsPrimitiveRoot (g32p_zeta S) S.m :=
  IsCyclotomicExtension.zeta_spec S.m ℚ (cyc_Field S.m)

/-- The value of the supplier character in `F`: `ζ_m` to the power `χ(h)`.
Source: G32 v0.16, Subsection 4.1 (the action of `F_χ` through `H′/ker χ ≅ ℤ/m`). -/
def g32p_fieldValue (S : g32p_Supplier) (h : S.H) : cyc_Field S.m :=
  g32p_zeta S ^ (Multiplicative.toAdd (S.χ h)).val

example (S : g32p_Supplier) : g32p_fieldValue S 1 = 1 := by
  simp [g32p_fieldValue]

/-- The complex primitive root `exp(2πi/m)`.
Source: G32 v0.16, Subsection 4.1 (complex characters of `ℤ/m`). -/
def g32p_root (m : ℕ) : ℂ := Complex.exp (2 * Real.pi * Complex.I / m)

example : g32p_root 3 = Complex.exp (2 * Real.pi * Complex.I / 3) := by
  simp [g32p_root]

/-- The exponents of a supplier over the class datum, in `1, …, m - 1`.
Source: G32 v0.16, Subsection 4.1 (branch points of `C/ker χ → C/H′` and their exponents);
`papersExpsList`. -/
def g32p_exponents (S : g32p_Supplier) : List ℕ :=
  papersExpsList S.H S.χ g32p_classList

example (S : g32p_Supplier) :
    g32p_exponents S = papersExpsList S.H S.χ g32p_classList := rfl

/-- The case where Schoen's Sublemma 2.9 applies: every exponent `α` has a prime `p ∣ m` with
`p ∤ α`. Otherwise (for instance `m = 12` with every exponent `6`, rows 13–15) the prime it
chooses does not exist, and G32 Lemma 4.3 replaces that step.
Source: Schoen (1988), Sublemma 2.9, p. 19; G32 v0.16, Lemma 4.3 and the paragraph before it. -/
def g32p_PrimeAvailable (S : g32p_Supplier) : Prop :=
  ∀ a ∈ g32p_exponents S, ∃ p, p.Prime ∧ p ∣ S.m ∧ ¬ p ∣ a

example (S : g32p_Supplier) (h : g32p_PrimeAvailable S) (a : ℕ) (ha : a ∈ g32p_exponents S) :
    ∃ p, p.Prime ∧ p ∣ S.m ∧ ¬ p ∣ a := h a ha

/-! ## Cohomology of a variety with a `G`-action -/

/-- The multiplicity `⟨χ_{H¹}, χ_τ⟩` of a complex representation `τ` in `H¹(J; ℂ)`, for `G`
acting on `J` through `aut`, computed from the traces of the pullbacks.
Source: Serre, *Linear representations of finite groups*, §2.3, Theorem 4. -/
def g32p_multiplicity {J : Over (Spec ↧ℂ)} [IsIntegral J.left] [Smooth J.hom]
    [IsProjective J.hom] (aut : g32p_G → (J ⟶ J)) (τ : FDRep ℂ g32p_G) : ℂ :=
  (Fintype.card g32p_G : ℂ)⁻¹ *
    ∑ g, ((LinearMap.trace ℚ (HQ J 1) (homPullback (aut g) 1) : ℚ) : ℂ) * star (τ.character g)

example {J : Over (Spec ↧ℂ)} [IsIntegral J.left] [Smooth J.hom] [IsProjective J.hom]
    (aut : g32p_G → (J ⟶ J)) (τ : FDRep ℂ g32p_G) :
    g32p_multiplicity aut τ = (Fintype.card g32p_G : ℂ)⁻¹ *
      ∑ g, ((LinearMap.trace ℚ (HQ J 1) (homPullback (aut g) 1) : ℚ) : ℂ) *
        star (τ.character g) := rfl

/-- The projector onto the sum of the `ρ`- and `ρ̄`-isotypic parts of `H¹(J; ℂ)`:
`(4/|G|) Σ_g (χ_ρ(g) + χ̄_ρ(g)) g^*`.
Source: Serre, *Linear representations of finite groups*, §2.6, Theorem 8. -/
def g32p_rhoProjector {J : Over (Spec ↧ℂ)} [IsIntegral J.left] [Smooth J.hom]
    [IsProjective J.hom] (aut : g32p_G → (J ⟶ J)) : Module.End ℂ (ℂ ⊗[ℚ] HQ J 1) :=
  ((4 : ℂ) / Fintype.card g32p_G) • ∑ g,
    ((b4b_toMatrix g).trace + star (b4b_toMatrix g).trace) •
      (homPullback (aut g) 1).baseChange ℂ

example {J : Over (Spec ↧ℂ)} [IsIntegral J.left] [Smooth J.hom] [IsProjective J.hom]
    (aut : g32p_G → (J ⟶ J)) : g32p_rhoProjector aut 0 = 0 := map_zero _

/-- The rational primitive part of `H¹(J; ℚ)` for a supplier: classes fixed by `ker χ` and
killed by the `m`-th cyclotomic polynomial of every element mapped to the generator of `ℤ/m`.
Its complexification is the sum of the `χ^t`-eigenspaces, `t ∈ (ℤ/m)ˣ`.
Source: G32 v0.16, Subsection 4.1 (the primitive part `P_χ ⊆ J(C)`). -/
def g32p_primitive {J : Over (Spec ↧ℂ)} [IsIntegral J.left] [Smooth J.hom]
    [IsProjective J.hom] (aut : g32p_G → (J ⟶ J)) (S : g32p_Supplier) :
    Submodule ℚ (HQ J 1) :=
  (⨅ (h : S.H) (_ : S.χ h = 1), LinearMap.eqLocus (homPullback (aut h) 1) LinearMap.id) ⊓
    ⨅ (h : S.H) (_ : S.χ h = Multiplicative.ofAdd 1),
      LinearMap.ker (Polynomial.aeval (homPullback (aut h) 1) (Polynomial.cyclotomic S.m ℚ))

example {J : Over (Spec ↧ℂ)} [IsIntegral J.left] [Smooth J.hom] [IsProjective J.hom]
    (aut : g32p_G → (J ⟶ J)) (S : g32p_Supplier) : (0 : HQ J 1) ∈ g32p_primitive aut S :=
  Submodule.zero_mem _

/-- An admissible supplier for a cover: simple exponents over the class datum and a nonzero
primitive part, which is `h > 0`.
Source: G32 v0.16, Subsection 4.1 ("admissible if `h > 0` and `α` is simple"). -/
def g32p_Admissible {J : Over (Spec ↧ℂ)} [IsIntegral J.left] [Smooth J.hom]
    [IsProjective J.hom] (aut : g32p_G → (J ⟶ J)) (S : g32p_Supplier) : Prop :=
  IsSimpleExps S.m (g32p_exponents S) ∧ g32p_primitive aut S ≠ ⊥

example {J : Over (Spec ↧ℂ)} [IsIntegral J.left] [Smooth J.hom] [IsProjective J.hom]
    (aut : g32p_G → (J ⟶ J)) (S : g32p_Supplier) (h : g32p_Admissible aut S) :
    IsSimpleExps S.m (g32p_exponents S) := h.1

/-! ## The realization of one fibre -/

/-- The primitive part `P_χ` of a supplier, as an abelian variety with a retraction to `J`, a
cyclotomic action on `H¹(P_χ; ℚ)` through which `H′` acts by `χ`, and pullback image equal to the
rational primitive part. No algebraicity is recorded.
Source: G32 v0.16, Subsection 4.1 (`P_χ` is the image of `N π_χ`, with `F_χ` acting); Schoen
(1988), §1. -/
structure g32p_Part (J : Over (Spec ↧ℂ)) [GrpObj J] [IsCommMonObj J] [IsIntegral J.left]
    [Smooth J.hom] [IsProjective J.hom] (aut : g32p_G → (J ⟶ J)) (S : g32p_Supplier) where
  /-- The primitive abelian variety. -/
  P : Over (Spec ↧ℂ)
  [grp : GrpObj P]
  [comm : IsCommMonObj P]
  [integral : IsIntegral P.left]
  [smooth : Smooth P.hom]
  [projective : IsProjective P.hom]
  /-- Inclusion into the Jacobian. -/
  incl : P ⟶ J
  /-- The endomorphism `N π_χ` with its target restricted. -/
  proj : J ⟶ P
  incl_hom : IsMonHom incl
  proj_hom : IsMonHom proj
  /-- The retraction degree. -/
  N : ℕ
  N_pos : 0 < N
  retract : incl ≫ proj = 𝟙 P ^ N
  /-- Half the cyclotomic rank `h`. -/
  k : ℕ
  /-- The balanced action of `F = ℚ(μ_m)` on `H¹(P_χ; ℚ)`. -/
  act : letI := (torusCohomology_cupProductOf P).finite
    cyc_Action (abelianVarietyCohomologyOf (finiteBetti_abelian P)
      (spec_bettiDeRhamIso_abelian P) (hodgeDecomposition_of_abelian P)
      (torusCohomology_cupProductOf P)).weight1 S.m k
  /-- `H′` acts on the image through `χ`, by the field values. -/
  equivariant : ∀ h : S.H, homPullback proj 1 ∘ₗ cyc_scalar act.cyc_coordinates
    (g32p_fieldValue S h) = homPullback (aut h) 1 ∘ₗ homPullback proj 1
  /-- The pullback image is the primitive part. -/
  image : LinearMap.range (homPullback proj 1) = g32p_primitive aut S

attribute [instance] g32p_Part.grp g32p_Part.comm g32p_Part.integral g32p_Part.smooth
  g32p_Part.projective

/-- A part has a positive cyclotomic rank. -/
example {J : Over (Spec ↧ℂ)} [GrpObj J] [IsCommMonObj J] [IsIntegral J.left] [Smooth J.hom]
    [IsProjective J.hom] {aut : g32p_G → (J ⟶ J)} {S : g32p_Supplier} (P : g32p_Part J aut S) : 0 < 2 * P.k :=
  Nat.mul_pos (by norm_num) P.act.cyc_positive

/-- **The realization of a fibre `A` as `A_ρ(C)` inside the Jacobian of a `G₃₂`-cover with the
class datum.** The Jacobian `J`, the action of `G` by group automorphisms, Chevalley–Weil
multiplicities, an invariant polarization, the factor `A` as the image of an element
of `ℤ[G]` in the `ρ`-block with a central element `λI` inducing the Weil action, and the
primitive part of every admissible supplier. No field asserts algebraicity, a character identity
or a contraction.
Source: G32 v0.16, Subsection 3.2 (Definition 3.2 and Lemma 3.3), Proposition 3.1, Lemma 3.6,
Subsection 4.1; Birkenhake–Lange, *Complex Abelian Varieties*, §11.2 (Jacobians) and Ch. 12. -/
structure g32p_Cover (A : g32t_Sixfold) where
  /-- The Jacobian `J(C)`. -/
  J : Over (Spec ↧ℂ)
  [grp : GrpObj J]
  [comm : IsCommMonObj J]
  [integral : IsIntegral J.left]
  [smooth : Smooth J.hom]
  [projective : IsProjective J.hom]
  /-- The action of `G`. -/
  aut : g32p_G → (J ⟶ J)
  aut_hom : ∀ g, IsMonHom (aut g)
  aut_one : aut 1 = 𝟙 J
  aut_mul : ∀ g h, aut (g * h) = aut g ≫ aut h
  /-- Chevalley–Weil: each nontrivial irreducible `τ` occurs with multiplicity `m_τ`. -/
  mult : ∀ τ : FDRep ℂ g32p_G, Simple τ → (∃ g, τ.ρ g ≠ 1) →
    g32p_multiplicity aut τ = g32p_cwMult τ
  /-- An invariant polarization (the theta polarization). -/
  pol : HQ J 2
  pol_nondeg : IsNondegenerate (polarizationVec (torusCohomology_cupProductOf J) pol)
  pol_pos : PolarizationPositive (finiteBetti_abelian J) (spec_bettiDeRhamIso_abelian J)
    (hodgeDecomposition_of_abelian J) (torusCohomology_cupProductOf J) pol_nondeg
  pol_inv : ∀ g, homPullback (aut g) 2 pol = pol
  /-- The factor `A_ρ(C)`. -/
  inclA : A.X ⟶ J
  projA : J ⟶ A.X
  inclA_hom : IsMonHom inclA
  projA_hom : IsMonHom projA
  NA : ℕ
  NA_pos : 0 < NA
  retractA : inclA ≫ projA = 𝟙 A.X ^ NA
  /-- `projA ≫ inclA` is `N₀ e` for an element `e` of `ℚ[G]`. -/
  groupRing : ∃ c : g32p_G → ℤ, projA ≫ inclA = ∏ g, aut g ^ c g
  /-- The image of `H¹(A)` lies in the `ρ`- and `ρ̄`-isotypic parts. -/
  rhoBlock : ∀ x, g32p_rhoProjector aut ((1 : ℂ) ⊗ₜ[ℚ] homPullback projA 1 x) =
    (1 : ℂ) ⊗ₜ[ℚ] homPullback projA 1 x
  dimA : Module.finrank ℚ (HQ A.X 1) = 12
  /-- A central scalar `λI` with `λ` a primitive cube root of unity (`ωI` or `ω²I`). -/
  centre : g32p_G
  centre_eq : ∃ c : ℂ, c ^ 2 + c + 1 = 0 ∧ b4b_toMatrix centre = c • 1
  /-- The Weil action of `√-3` is induced by `1 + 2 λI`. -/
  weil : ∀ x, homPullback projA 1 (A.W.J x) =
    homPullback projA 1 x + (2 : ℚ) • homPullback (aut centre) 1 (homPullback projA 1 x)
  /-- The primitive part of every admissible supplier. -/
  part : ∀ S, g32p_Admissible aut S → g32p_Part J aut S

attribute [instance] g32p_Cover.grp g32p_Cover.comm g32p_Cover.integral g32p_Cover.smooth
  g32p_Cover.projective

example {A : g32t_Sixfold} (X : g32p_Cover A) : X.inclA ≫ X.projA = 𝟙 A.X ^ X.NA := X.retractA

/-! ## The two literature inputs -/

/-- **Schoen's supplier conclusion**, for the primitive parts of the admissible suppliers of a
cover: every cyclotomic determinant class is algebraic. The first field is Schoen's theorem where
his Sublemma 2.9 applies; the second is the remaining case (rows 13–15 among the fifty-one),
where that step is replaced by G32 Lemma 4.3.
Source: C. Schoen, *Hodge classes on self-products of a variety with an automorphism*, Compositio
Math. 65 (1988), 3–32, Theorem 2.0 and Corollary 3.1; G32 v0.16, Lemmas 4.2 and 4.3. -/
structure g32p_SchoenSupplier {A : g32t_Sixfold} (X : g32p_Cover A) : Prop where
  schoen : ∀ S (hS : g32p_Admissible X.aut S), g32p_PrimeAvailable S →
    cyc_Algebraic (cupProductOf (X.part S hS).P) (X.part S hS).act.cyc_coordinates
  withoutPrime : ∀ S (hS : g32p_Admissible X.aut S), ¬ g32p_PrimeAvailable S →
    cyc_Algebraic (cupProductOf (X.part S hS).P) (X.part S hS).act.cyc_coordinates

example {A : g32t_Sixfold} (X : g32p_Cover A) (h : g32p_SchoenSupplier X) (S : g32p_Supplier)
    (hS : g32p_Admissible X.aut S) :
    cyc_Algebraic (cupProductOf (X.part S hS).P) (X.part S hS).act.cyc_coordinates := by
  by_cases hE : g32p_PrimeAvailable S
  · exact h.schoen S hS hE
  · exact h.withoutPrime S hS hE

/-- The complex points of Milne's group `S(J)`: invertible `ℂ`-linear maps of `H¹(J; ℂ)`
commuting with the pullback of every endomorphism and fixing the polarization in
`⋀² H¹(J; ℂ)`.
Source: J. S. Milne, *Lefschetz classes on abelian varieties*, Duke Math. J. 96 (1999), §1
(`S(A)`, the largest algebraic subgroup of `Sp` commuting with `End⁰(A)`); G32 v0.16, proof of
Proposition 4.6. -/
def g32p_lefschetz (J : Over (Spec ↧ℂ)) [GrpObj J] [IsCommMonObj J] [IsIntegral J.left]
    [Smooth J.hom] [IsProjective J.hom] (pol : HQ J 2) :
    Set (Module.End ℂ (ℂ ⊗[ℚ] HQ J 1)) :=
  {u | IsUnit u ∧
    (∀ f : J ⟶ J, IsMonHom f → u ∘ₗ (homPullback f 1).baseChange ℂ =
      (homPullback f 1).baseChange ℂ ∘ₗ u) ∧
    exteriorPower.map 2 u (HodgeBlocks.complexifyWedge 2
      (polarizationVec (torusCohomology_cupProductOf J) pol)) =
      HodgeBlocks.complexifyWedge 2 (polarizationVec (torusCohomology_cupProductOf J) pol)}

example (J : Over (Spec ↧ℂ)) [GrpObj J] [IsCommMonObj J] [IsIntegral J.left]
    [Smooth J.hom] [IsProjective J.hom] (pol : HQ J 2) : 1 ∈ g32p_lefschetz J pol :=
  ⟨isUnit_one, fun _ _ => by rw [Module.End.one_eq_id, LinearMap.id_comp, LinearMap.comp_id],
    by rw [Module.End.one_eq_id, exteriorPower.map_id, LinearMap.id_apply]⟩

/-- Nondegeneracy check: `-1` lies in `S(J)`, so invariance is a genuine condition; it kills every
class of odd degree.
Source: Milne (1999), §1 (`S(A)` contains the scalars `±1`). -/
example (J : Over (Spec ↧ℂ)) [GrpObj J] [IsCommMonObj J] [IsIntegral J.left]
    [Smooth J.hom] [IsProjective J.hom] (pol : HQ J 2) : -1 ∈ g32p_lefschetz J pol := by
  have h2 : exteriorPower.map 2 (-1 : Module.End ℂ (ℂ ⊗[ℚ] HQ J 1)) = LinearMap.id := by
    apply exteriorPower.linearMap_ext
    ext v
    simp only [LinearMap.compAlternatingMap_apply, exteriorPower.map_apply_ιMulti,
      LinearMap.id_apply]
    have hv : (⇑(-1 : Module.End ℂ (ℂ ⊗[ℚ] HQ J 1)) ∘ v) = fun i => (-1 : ℂ) • v i := by
      funext i
      simp
    rw [hv, AlternatingMap.map_smul_univ]
    simp
  refine ⟨isUnit_one.neg, fun f _ => LinearMap.ext fun x => by simp, ?_⟩
  rw [h2, LinearMap.id_apply]

/-- The degree-one classes of `J^r`: the sum of the pullbacks along the projections.
Source: Birkenhake–Lange, *Complex Abelian Varieties*, §1.3 (`H¹(J^r) = H¹(J)^r`). -/
def g32p_powerOne (J : Over (Spec ↧ℂ)) [GrpObj J] [IsCommMonObj J] [IsIntegral J.left]
    [Smooth J.hom] [IsProjective J.hom] (r : ℕ) :
    (Fin r → ℂ ⊗[ℚ] HQ J 1) →ₗ[ℂ] ℂ ⊗[ℚ] HQ (g3_power J r) 1 :=
  ∑ i, ((homPullback (g3_proj J r i) 1).baseChange ℂ) ∘ₗ LinearMap.proj i

example (J : Over (Spec ↧ℂ)) [GrpObj J] [IsCommMonObj J] [IsIntegral J.left]
    [Smooth J.hom] [IsProjective J.hom] : g32p_powerOne J 0 = 0 := by
  simp [g32p_powerOne]

/-- The cup map from `⋀ⁿ (H¹(J; ℂ)^r)` to `H^n(J^r; ℂ)`.
Source: Birkenhake–Lange, *Complex Abelian Varieties*, Lemma 1.3.1. -/
def g32p_powerClass (J : Over (Spec ↧ℂ)) [GrpObj J] [IsCommMonObj J] [IsIntegral J.left]
    [Smooth J.hom] [IsProjective J.hom] (r n : ℕ) :
    ⋀[ℂ]^n (Fin r → ℂ ⊗[ℚ] HQ J 1) →ₗ[ℂ] ℂ ⊗[ℚ] HQ (g3_power J r) n :=
  letI := (torusCohomology_cupProductOf (g3_power J r)).finite
  ((cupProductOf (g3_power J r)).cupWedgeMap n).baseChange ℂ ∘ₗ
    (HodgeBlocks.WeilAction.exteriorPowerBaseChangeEquiv n).symm.toLinearMap ∘ₗ
      exteriorPower.map n (g32p_powerOne J r)

example (J : Over (Spec ↧ℂ)) [GrpObj J] [IsCommMonObj J] [IsIntegral J.left]
    [Smooth J.hom] [IsProjective J.hom] (r n : ℕ) : g32p_powerClass J r n 0 = 0 := map_zero _

/-- The diagonal action of an endomorphism of `H¹(J; ℂ)` on `H¹(J; ℂ)^r`.
Source: Milne (1999), §1 (the action of `S(A)` on `H*(A^r)`). -/
def g32p_diag (J : Over (Spec ↧ℂ)) [IsIntegral J.left] [Smooth J.hom] [IsProjective J.hom]
    (u : Module.End ℂ (ℂ ⊗[ℚ] HQ J 1)) (r : ℕ) : Module.End ℂ (Fin r → ℂ ⊗[ℚ] HQ J 1) :=
  LinearMap.pi fun i => u ∘ₗ LinearMap.proj i

example (J : Over (Spec ↧ℂ)) [IsIntegral J.left] [Smooth J.hom] [IsProjective J.hom]
    (u : Module.End ℂ (ℂ ⊗[ℚ] HQ J 1)) (r : ℕ) (v : Fin r → ℂ ⊗[ℚ] HQ J 1) (i : Fin r) :
    g32p_diag J u r v i = u (v i) := rfl

/-- The `S(J)`-invariant classes of `H^n(J^r; ℂ)`: the cup images of the invariant vectors of
`⋀ⁿ (H¹(J; ℂ)^r)` under the diagonal action.
Source: Milne (1999), §1 and Theorem 3.2; G32 v0.16, proof of Proposition 4.6. -/
def g32p_invariants (J : Over (Spec ↧ℂ)) [GrpObj J] [IsCommMonObj J] [IsIntegral J.left]
    [Smooth J.hom] [IsProjective J.hom] (pol : HQ J 2) (r n : ℕ) :
    Submodule ℂ (ℂ ⊗[ℚ] HQ (g3_power J r) n) :=
  (⨅ u ∈ g32p_lefschetz J pol,
    LinearMap.eqLocus (exteriorPower.map n (g32p_diag J u r)) LinearMap.id).map
      (g32p_powerClass J r n)

example (J : Over (Spec ↧ℂ)) [GrpObj J] [IsCommMonObj J] [IsIntegral J.left]
    [Smooth J.hom] [IsProjective J.hom] (pol : HQ J 2) (r n : ℕ) :
    (0 : ℂ ⊗[ℚ] HQ (g3_power J r) n) ∈ g32p_invariants J pol r n :=
  Submodule.zero_mem _

/-- **Milne's invariance** for a polarized abelian variety: on every power `J^r`, every
`S(J)`-invariant class of even degree lies in the complex span of algebraic classes. Milne's
Theorem 3.2 says the invariants are generated by divisor classes, and his Lemma 3.1 compares the
complex and rational invariants.
Source: J. S. Milne, *Lefschetz classes on abelian varieties*, Duke Math. J. 96 (1999),
Theorem 3.2 and Lemma 3.1; G32 v0.16, proof of Proposition 4.6, lines 310–314. -/
structure g32p_MilneInvariance (J : Over (Spec ↧ℂ)) [GrpObj J] [IsCommMonObj J]
    [IsIntegral J.left] [Smooth J.hom] [IsProjective J.hom] (pol : HQ J 2)
    (hη : IsNondegenerate (polarizationVec (torusCohomology_cupProductOf J) pol))
    (hpos : PolarizationPositive (finiteBetti_abelian J) (spec_bettiDeRhamIso_abelian J)
      (hodgeDecomposition_of_abelian J) (torusCohomology_cupProductOf J) hη) : Prop where
  invariant : ∀ r p, g32p_invariants J pol r (2 * p) ≤
    (algebraicCycleClassSpan (g3_power J r) p).baseChange ℂ

example {A : g32t_Sixfold} (X : g32p_Cover A)
    (h : g32p_MilneInvariance X.J X.pol X.pol_nondeg X.pol_pos) :
    g32p_invariants X.J X.pol 57 6 ≤ (algebraicCycleClassSpan (g3_power X.J 57) 3).baseChange ℂ :=
  h.invariant 57 3

/-! ## Determinant classes of a complex subspace -/

/-- The cup images of `⋀ⁿ S` for a complex subspace `S ⊆ H¹(X; ℂ)`, in `H^n(X; ℂ)`.
Source: Birkenhake–Lange, *Complex Abelian Varieties*, Lemma 1.3.1; G32 v0.16, Section 2 (the
Weil lines `det V`). -/
def g32p_wedgeClasses (X : Over (Spec ↧ℂ)) [GrpObj X] [IsCommMonObj X] [IsIntegral X.left]
    [Smooth X.hom] [IsProjective X.hom] (S : Submodule ℂ (ℂ ⊗[ℚ] HQ X 1)) (n : ℕ) :
    Submodule ℂ (ℂ ⊗[ℚ] HQ X n) :=
  letI := (torusCohomology_cupProductOf X).finite
  (LinearMap.range (exteriorPower.map n S.subtype)).map
    (((cupProductOf X).cupWedgeMap n).baseChange ℂ ∘ₗ
      (HodgeBlocks.WeilAction.exteriorPowerBaseChangeEquiv n).symm.toLinearMap)

example (X : Over (Spec ↧ℂ)) [GrpObj X] [IsCommMonObj X] [IsIntegral X.left]
    [Smooth X.hom] [IsProjective X.hom] (n : ℕ) :
    (0 : ℂ ⊗[ℚ] HQ X n) ∈ g32p_wedgeClasses X ⊥ n := Submodule.zero_mem _

end HodgeLean.Foundations.Program
