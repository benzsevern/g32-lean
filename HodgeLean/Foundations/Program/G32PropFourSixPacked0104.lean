theorem g32p_row22_groupEnumeration :
    ∃ e : Fin 576 ≃ Subgroup.closure (Set.range g32p_row22_groupGenerators),
      ∀ i, b4b_toMatrix (e i : g32p_G) =
        HurwitzPrymRex_g32conj (HurwitzPrymRex_evM g32h_omega
          (g32p_row22_groupNodes i)) := by
  apply g32p_matrixPathEnumeration b4b_toMatrix Subtype.val_injective
    (fun a => HurwitzPrymRex_g32conj (HurwitzPrymRex_evM g32h_omega a))
    (by rw [HurwitzPrymRex_evM_mone, map_one])
    (by intro a b; rw [HurwitzPrymRex_evM_mmul g32h_omega_sq_add, map_mul])
    (HurwitzPrymRex_g32conj_injective.comp
      (HurwitzPrymRex_evM_injective g32h_omega_sq_add))
    g32p_row22_groupGenerators g32p_row22_groupMatrices g32p_row22_groupGenerator_map
    g32p_row22_groupNodes 0 g32p_row22_groupParent g32p_row22_groupLabel Fin.val
    g32p_row22_groupNext g32p_row22_groupInjective (by decide)
    g32p_row22_groupParent_lt
  · intro i hi
    have hs := g32p_row22_groupStep
      (g32p_row22_groupParent i) (g32p_row22_groupLabel i)
    rw [g32p_row22_groupParent_step i hi] at hs
    exact hs.symm
  · exact g32p_row22_groupStep

theorem g32p_row22_groupOrder :
    Nat.card (Subgroup.closure (Set.range g32p_row22_groupGenerators)) = 576 := by
  obtain ⟨e, _⟩ := g32p_row22_groupEnumeration
  simpa only [Nat.card_fin] using (Nat.card_congr e).symm

def g32p_row22_groupEquiv : Fin 576 ≃ Subgroup.closure (Set.range g32p_row22_groupGenerators) :=
  Classical.choose g32p_row22_groupEnumeration

theorem g32p_row22_groupEquiv_map (i : Fin 576) :
    b4b_toMatrix (g32p_row22_groupEquiv i : g32p_G) =
      HurwitzPrymRex_g32conj (HurwitzPrymRex_evM g32h_omega (g32p_row22_groupNodes i)) :=
  Classical.choose_spec g32p_row22_groupEnumeration i

theorem g32p_row22_groupEquiv_one : g32p_row22_groupEquiv 0 = 1 := by
  apply Subtype.ext
  apply Subtype.val_injective
  change b4b_toMatrix (g32p_row22_groupEquiv 0 : g32p_G) = b4b_toMatrix 1
  rw [g32p_row22_groupEquiv_map, map_one,
    show g32p_row22_groupNodes 0 = HurwitzPrymRex_mone by decide,
    HurwitzPrymRex_evM_mone, map_one]

theorem g32p_row22_groupEquiv_step (i : Fin 576) (s : Fin 4) :
    g32p_row22_groupEquiv (g32p_row22_groupNext i s) =
      g32p_row22_groupEquiv i *
        ⟨g32p_row22_groupGenerators s, Subgroup.subset_closure (Set.mem_range_self s)⟩ := by
  apply Subtype.ext
  apply Subtype.val_injective
  change b4b_toMatrix (g32p_row22_groupEquiv (g32p_row22_groupNext i s) : g32p_G) =
    b4b_toMatrix ((g32p_row22_groupEquiv i : g32p_G) * g32p_row22_groupGenerators s)
  rw [map_mul, g32p_row22_groupEquiv_map, g32p_row22_groupEquiv_map,
    g32p_row22_groupGenerator_map, ← map_mul, ← HurwitzPrymRex_evM_mmul g32h_omega_sq_add]
  exact congrArg (fun a => HurwitzPrymRex_g32conj (HurwitzPrymRex_evM g32h_omega a))
    (g32p_row22_groupStep i s).symm


