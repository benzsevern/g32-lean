theorem g32p_exps_of_no_conjugate {G : Type*} [Group G] [Finite G]
    {m p : ℕ} (hp : p.Prime) (H : Subgroup G)
    (χ : H →* Multiplicative (ZMod m)) (g : G) (hg : g ^ p = 1)
    (havoid : ∀ x : G, x⁻¹ * g * x ∉ H) : papersExps H χ g = 0 := by
  have hperiod (c : G ⧸ H) : Function.minimalPeriod (g • ·) c = p := by
    have hper : Function.IsPeriodicPt (g • ·) p c := by
      rw [isPeriodicPt_smul_iff, hg, one_smul]
    have hfix : ¬ Function.IsFixedPt (g • ·) c := by
      induction c using Quotient.inductionOn' with
      | h x =>
        intro hx
        have he : (QuotientGroup.mk x : G ⧸ H) = QuotientGroup.mk (g * x) := hx.symm
        exact havoid x (by simpa only [mul_assoc] using (QuotientGroup.eq.mp he))
    have hd := hper.minimalPeriod_dvd
    rcases (Nat.dvd_prime hp).mp hd with h | h
    · exact (hfix (Function.minimalPeriod_eq_one_iff_isFixedPt.mp h)).elim
    · exact h
  have hlocal (q : Quotient (orbitRel (Subgroup.zpowers g) (G ⧸ H))) :
      papersLocalMonodromy H g q = 1 := by
    apply Subtype.ext
    change q.out.out⁻¹ * g ^ Function.minimalPeriod (g • ·) q.out * q.out.out = 1
    rw [hperiod, hg, mul_one, inv_mul_cancel]
  simp only [papersExps, hlocal, map_one, toAdd_one,
    Multiset.map_const', Multiset.filter_eq_nil]
  intro a ha
  have ha0 : a = 0 := (Multiset.mem_replicate.mp ha).2
  exact not_ne_iff.mpr ha0

theorem g32p_exps_of_character_avoid {G : Type} [Group G] [Finite G]
    {m p : ℕ} (hp : p.Prime) (H : Subgroup G)
    (χ : H →* Multiplicative (ZMod m)) (g : G) (hg : g ^ p = 1)
    (V : FDRep ℂ G) (htrace : ∀ h : H, V.character h ≠ V.character g) :
    papersExps H χ g = 0 := by
  apply g32p_exps_of_no_conjugate hp H χ g hg
  intro x hx
  apply htrace ⟨x⁻¹ * g * x, hx⟩
  simpa only [inv_inv] using FDRep.char_conj V g x⁻¹

theorem g32p_archive_trace (M : Matrix (Fin 4) (Fin 4) ℂ) :
    Matrix.trace (HurwitzPrymRex_g32conj M) = Matrix.trace M := by
  change Matrix.trace (HurwitzPrymRex_g32P * M * HurwitzPrymRex_g32Pinv) = _
  rw [Matrix.trace_mul_cycle, HurwitzPrymRex_g32_Pinv_P, one_mul]

theorem g32p_integral_trace (w : ℂ) (M : HurwitzPrymRex_Mat) :
    Matrix.trace (HurwitzPrymRex_evM w M) =
      HurwitzPrymRex_ev w ⟨∑ i : Fin 4, (M i i).re, ∑ i : Fin 4, (M i i).om⟩ := by
  simp only [Matrix.trace, Matrix.diag, HurwitzPrymRex_evM, Matrix.of_apply,
    HurwitzPrymRex_ev, Finset.sum_add_distrib, Finset.sum_mul, Int.cast_sum]

end HodgeLean.Foundations.Program

