theorem g32p_matrix_invariant_of_archive
    (S : Set (Matrix (Fin 4) (Fin 4) ℂ))
    (hS : ∀ (k : Fin 4) x, x ∈ S →
      (g32p_archiveGenerators k).submatrix g32p_archiveCoordinates
        g32p_archiveCoordinates * x ∈ S)
    (g : g32p_G) (x : Matrix (Fin 4) (Fin 4) ℂ) (hx : x ∈ S) :
    b4b_toMatrix g * x ∈ S := by
  have hg : b4b_toMatrix g ∈ Submonoid.closure (Set.range (fun i : Fin 4 =>
      (g32p_archiveGenerators i).submatrix g32p_archiveCoordinates
        g32p_archiveCoordinates)) := by
    rw [g32p_archive_matrix_closure]
    exact g.property
  generalize hm : b4b_toMatrix g = m at hg ⊢
  clear hm
  induction hg using Submonoid.closure_induction generalizing x with
  | mem a ha =>
    obtain ⟨k, rfl⟩ := ha
    exact hS k x hx
  | one => simpa only [Matrix.one_mul] using hx
  | mul a b ha hb iha ihb =>
    rw [Matrix.mul_assoc]
    exact iha _ (ihb _ hx)

def g32p_eigenpointEquiv
    (S : Set (Matrix (Fin 4) (Fin 4) ℂ))
    (hS : ∀ (g : g32p_G) x, x ∈ S → b4b_toMatrix g * x ∈ S)
    (a b u : g32p_G) (hu : u * a * u⁻¹ = b) (z : ℂ) :
    {x // x ∈ S ∧ b4b_toMatrix a * x = z • x} ≃
      {x // x ∈ S ∧ b4b_toMatrix b * x = z • x} where
  toFun x := ⟨b4b_toMatrix u * x.val, hS u _ x.property.1, by
    have h : b * u = u * a := by rw [← hu]; group
    calc
      b4b_toMatrix b * (b4b_toMatrix u * x.val) =
          b4b_toMatrix u * (b4b_toMatrix a * x.val) := by
        rw [← Matrix.mul_assoc, ← map_mul, h, map_mul, Matrix.mul_assoc]
      _ = z • (b4b_toMatrix u * x.val) := by
        rw [x.property.2, Matrix.mul_smul]⟩
  invFun x := ⟨b4b_toMatrix u⁻¹ * x.val, hS u⁻¹ _ x.property.1, by
    have h : a * u⁻¹ = u⁻¹ * b := by rw [← hu]; group
    calc
      b4b_toMatrix a * (b4b_toMatrix u⁻¹ * x.val) =
          b4b_toMatrix u⁻¹ * (b4b_toMatrix b * x.val) := by
        rw [← Matrix.mul_assoc, ← map_mul, h, map_mul, Matrix.mul_assoc]
      _ = z • (b4b_toMatrix u⁻¹ * x.val) := by
        rw [x.property.2, Matrix.mul_smul]⟩
  left_inv x := by
    apply Subtype.ext
    change b4b_toMatrix u⁻¹ * (b4b_toMatrix u * x.val) = x.val
    rw [← Matrix.mul_assoc, ← map_mul, inv_mul_cancel, map_one, Matrix.one_mul]
  right_inv x := by
    apply Subtype.ext
    change b4b_toMatrix u * (b4b_toMatrix u⁻¹ * x.val) = x.val
    rw [← Matrix.mul_assoc, ← map_mul, mul_inv_cancel, map_one, Matrix.one_mul]

theorem g32p_eigenpoint_card_eq_of_isConj
    (S : Set (Matrix (Fin 4) (Fin 4) ℂ))
    (hS : ∀ (g : g32p_G) x, x ∈ S → b4b_toMatrix g * x ∈ S)
    {a b : g32p_G} (h : IsConj a b) (z : ℂ) :
    Nat.card {x // x ∈ S ∧ b4b_toMatrix a * x = z • x} =
      Nat.card {x // x ∈ S ∧ b4b_toMatrix b * x = z • x} := by
  obtain ⟨u, hu⟩ := isConj_iff.mp h
  exact Nat.card_congr (g32p_eigenpointEquiv S hS a b u hu z)

end HodgeLean.Foundations.Program

