theorem g32p_group_card_le_of_orbit_codes {C X I : Type*} [Group C] [Finite C]
    [MulAction C X] [Fintype I] (b : X) (points : I → X) (allowed : Finset I)
    (hcodes : ∀ g : C, ∃ i ∈ allowed, g • b = points i)
    (s : ℕ) (hs : Nat.card (MulAction.stabilizer C b) ≤ s) :
    Nat.card C ≤ allowed.card * s := by
  classical
  let := Fintype.ofFinite C
  let : Finite (MulAction.orbit C b) := (Finite.finite_mulAction_orbit (M := C) b).to_subtype
  let := Fintype.ofFinite (MulAction.orbit C b)
  let := Fintype.ofFinite (MulAction.stabilizer C b)
  have h : ∀ x : MulAction.orbit C b, ∃ i ∈ allowed, points i = x.val := by
    intro x
    obtain ⟨g, hg⟩ := MulAction.mem_orbit_iff.mp x.property
    obtain ⟨i, hi, he⟩ := hcodes g
    exact ⟨i, hi, he.symm.trans hg⟩
  choose code hmem hpoint using h
  let f : MulAction.orbit C b → ↥allowed := fun x => ⟨code x, hmem x⟩
  have hf : Function.Injective f := by
    intro x y he
    have hi : code x = code y := congrArg Subtype.val he
    apply Subtype.ext
    exact (hpoint x).symm.trans ((congrArg points hi).trans (hpoint y))
  have ho : Fintype.card (MulAction.orbit C b) ≤ allowed.card := by
    simpa only [Nat.card_eq_fintype_card, Fintype.card_coe] using
      Nat.card_le_card_of_injective f hf
  have hst : Fintype.card (MulAction.stabilizer C b) ≤ s := by
    simpa only [Fintype.card_eq_nat_card] using hs
  rw [← Fintype.card_eq_nat_card,
    ← MulAction.card_orbit_mul_card_stabilizer_eq_card_group C b]
  exact Nat.mul_le_mul ho hst

end HodgeLean.Foundations.Program

