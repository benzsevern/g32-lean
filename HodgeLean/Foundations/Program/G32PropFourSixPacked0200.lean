def g32p_classifier_fiberEquiv {G I : Type*} [Group G]
    (reps : I → G) (classify : G → I)
    (hconj : ∀ g, IsConj g (reps (classify g)))
    (hsep : ∀ c d, IsConj (reps c) (reps d) → c = d) (c : I) :
    {g : G // classify g = c} ≃ conjugatesOf (reps c) := by
  refine (Equiv.refl G).subtypeEquiv (fun g => ?_)
  change classify g = c ↔ IsConj (reps c) g
  constructor
  · intro hg
    have h := hconj g
    rw [hg] at h
    exact h.symm
  · intro hg
    exact hsep _ _ ((hconj g).symm.trans hg.symm)

theorem g32p_literal_class_fibres_of_cardinalities
    (hcard : ∀ c, Nat.card (conjugatesOf (g32p_literalRepresentative c)) =
      g32p_literalSize c) :
    ∃ classify : g32p_G → Fin 102,
      (∀ g, IsConj g (g32p_literalRepresentative (classify g))) ∧
      ∀ c, Nat.card {g : g32p_G // classify g = c} = g32p_literalSize c := by
  obtain ⟨classify, hc⟩ := g32p_literal_class_coverage_of_cardinalities hcard
  refine ⟨classify, hc, fun c => ?_⟩
  rw [← hcard c]
  apply Nat.card_congr
  apply g32p_classifier_fiberEquiv g32p_literalRepresentative classify hc
  intro c d h
  exact g32p_literalRepresentative_classes_injective (ConjClasses.mk_eq_mk_iff_isConj.mpr h)

end HodgeLean.Foundations.Program

