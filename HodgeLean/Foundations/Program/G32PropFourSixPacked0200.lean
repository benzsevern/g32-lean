  rcases g32p_powerTraceCanonical_fibres c d he with h | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ |
    ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
  · exact h
  · exact (g32p_representative_separation_025_050 hc).elim
  · exact (g32p_representative_separation_025_050 hc.symm).elim
  · exact (g32p_representative_separation_029_059 hc).elim
  · exact (g32p_representative_separation_029_059 hc.symm).elim
  · exact (g32p_representative_separation_043_074 hc).elim
  · exact (g32p_representative_separation_043_074 hc.symm).elim

