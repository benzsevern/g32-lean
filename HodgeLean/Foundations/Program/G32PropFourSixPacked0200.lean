theorem g32p_rootEigen_nonconj (c d : Fin 102) (z : HurwitzPrymRex_Zw)
    (i : Fin 240)
    (hi : HurwitzPrymRex_mmul (g32p_literalRepresentativeMatrix c) (g32p_rootMatrix i) =
      (fun r s => HurwitzPrymRex_Zw.mul z (g32p_rootMatrix i r s)))
    (hd : ∀ j : Fin 240,
      HurwitzPrymRex_mmul (g32p_literalRepresentativeMatrix d) (g32p_rootMatrix j) ≠
        (fun r s => HurwitzPrymRex_Zw.mul z (g32p_rootMatrix j r s))) :
    ¬ IsConj (g32p_literalRepresentative c) (g32p_literalRepresentative d) := by
  intro h
  obtain ⟨u, hu⟩ := isConj_iff.mp h
  let x : {x // x ∈ Set.range g32p_rootPoint ∧
      b4b_toMatrix (g32p_literalRepresentative c) * x =
        HurwitzPrymRex_ev g32h_omega z • x} :=
    ⟨g32p_rootPoint i, ⟨i, rfl⟩, (g32p_rootPoint_eigen_iff c i z).mpr hi⟩
  let y := g32p_eigenpointEquiv (Set.range g32p_rootPoint) g32p_rootPoint_invariant
    (g32p_literalRepresentative c) (g32p_literalRepresentative d) u hu
      (HurwitzPrymRex_ev g32h_omega z) x
  obtain ⟨j, hj⟩ := y.property.1
  apply hd j
  apply (g32p_rootPoint_eigen_iff d j z).mp
  rw [hj]
  exact y.property.2

