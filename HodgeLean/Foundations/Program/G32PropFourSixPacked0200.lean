theorem g32p_pointStabilizerEquiv_centralizer_iff
    (p : Fin HurwitzPrymRex_g32TTwo.length × Fin HurwitzPrymRex_g32TThree.length)
    (c : Fin 102) :
    (g32p_pointStabilizerEquiv p : g32p_G) ∈
        Subgroup.centralizer {g32p_literalRepresentative c} ↔
      HurwitzPrymRex_mmul (g32p_pointStabilizerIntegral p) (g32p_literalRepresentativeMatrix c) =
        HurwitzPrymRex_mmul (g32p_literalRepresentativeMatrix c) (g32p_pointStabilizerIntegral p) := by
  rw [Subgroup.mem_centralizer_singleton_iff]
  constructor
  · intro h
    apply HurwitzPrymRex_evM_injective g32h_omega_sq_add
    apply HurwitzPrymRex_g32conj_injective
    simpa only [HurwitzPrymRex_evM_mmul g32h_omega_sq_add, map_mul,
      ← g32p_pointStabilizerEquiv_matrix, ← g32p_literalRepresentative_matrix] using
        congrArg b4b_toMatrix h
  · intro h
    apply Subtype.val_injective
    change b4b_toMatrix (_ * _) = b4b_toMatrix (_ * _)
    rw [map_mul, map_mul, g32p_pointStabilizerEquiv_matrix, g32p_literalRepresentative_matrix,
      ← map_mul, ← map_mul, ← HurwitzPrymRex_evM_mmul g32h_omega_sq_add,
      ← HurwitzPrymRex_evM_mmul g32h_omega_sq_add, h]

def g32p_pointStabilizerCentralizerEquiv (c : Fin 102) :
    {p : Fin HurwitzPrymRex_g32TTwo.length × Fin HurwitzPrymRex_g32TThree.length //
      HurwitzPrymRex_mmul (g32p_pointStabilizerIntegral p) (g32p_literalRepresentativeMatrix c) =
        HurwitzPrymRex_mmul (g32p_literalRepresentativeMatrix c) (g32p_pointStabilizerIntegral p)} ≃
    {x : g32p_pointStabilizer // (x : g32p_G) ∈
      Subgroup.centralizer {g32p_literalRepresentative c}} :=
  g32p_pointStabilizerEquiv.subtypeEquiv (fun p =>
    (g32p_pointStabilizerEquiv_centralizer_iff p c).symm)


theorem g32p_centralizer_card_le_of_index_codes (c : Fin 102)
    (allowed : Finset (Fin 240))
    (stabilizers : Finset (Fin HurwitzPrymRex_g32TTwo.length ×
      Fin HurwitzPrymRex_g32TThree.length))
    (hcodes : ∀ x : Subgroup.centralizer {g32p_literalRepresentative c}, ∃ i ∈ allowed,
      b4b_toMatrix (x : g32p_G) * g32p_basePoint = g32p_rootPoint i)
    (hstab : ∀ p, HurwitzPrymRex_mmul (g32p_pointStabilizerIntegral p)
        (g32p_literalRepresentativeMatrix c) =
      HurwitzPrymRex_mmul (g32p_literalRepresentativeMatrix c) (g32p_pointStabilizerIntegral p) →
      p ∈ stabilizers) :
    Nat.card (Subgroup.centralizer {g32p_literalRepresentative c}) ≤
      allowed.card * stabilizers.card := by
  apply g32p_centralizer_card_le_from_point_codes _ allowed stabilizers.card hcodes
  rw [← Nat.card_congr (g32p_pointStabilizerCentralizerEquiv c)]
  let f : {p : Fin HurwitzPrymRex_g32TTwo.length × Fin HurwitzPrymRex_g32TThree.length //
      HurwitzPrymRex_mmul (g32p_pointStabilizerIntegral p) (g32p_literalRepresentativeMatrix c) =
        HurwitzPrymRex_mmul (g32p_literalRepresentativeMatrix c) (g32p_pointStabilizerIntegral p)} →
      ↥stabilizers := fun p => ⟨p.val, hstab p.val p.property⟩
  have hi : Function.Injective f := by
    intro p q hpq
    exact Subtype.ext (congrArg (fun z : ↥stabilizers => z.val) hpq)
  simpa only [Nat.card_eq_fintype_card, Fintype.card_coe] using
    Nat.card_le_card_of_injective f hi

end HodgeLean.Foundations.Program

