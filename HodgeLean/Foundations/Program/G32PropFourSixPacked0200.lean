    g32p_powerTraceCanonical c = g32p_powerTraceCanonical d →
      c = d ∨ (c = 25 ∧ d = 50) ∨ (c = 50 ∧ d = 25) ∨
        (c = 29 ∧ d = 59) ∨ (c = 59 ∧ d = 29) ∨
        (c = 43 ∧ d = 74) ∨ (c = 74 ∧ d = 43) := by
