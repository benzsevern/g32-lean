theorem g32p_class_coverage_of_card_sum {G I : Type*} [Group G] [Finite G] [Fintype I]
    (reps : I → G) (hsep : ∀ c d, IsConj (reps c) (reps d) → c = d)
    (hsum : ∑ c, Nat.card (conjugatesOf (reps c)) = Nat.card G) :
    ∃ classify : G → I, ∀ g, IsConj g (reps (classify g)) := by
  classical
  let := Fintype.ofFinite G
  let (c : I) := Fintype.ofFinite (conjugatesOf (reps c))
  let f : (Σ c, conjugatesOf (reps c)) → G := fun x => x.2.val
  have hi : Function.Injective f := by
    rintro ⟨c, g⟩ ⟨d, h⟩ he
    have he' : g.val = h.val := he
    have hg : IsConj (reps c) h.val := he' ▸ g.property
    have hcd := hsep c d (hg.trans h.property.symm)
    subst d
    congr 1
    exact Subtype.ext he'
  have hn : Fintype.card (Σ c, conjugatesOf (reps c)) = Fintype.card G := by
    rw [Fintype.card_eq_nat_card, Nat.card_sigma]
    simpa only [Fintype.card_eq_nat_card] using hsum
  have hs : Function.Surjective f :=
    ((Fintype.bijective_iff_injective_and_card f).mpr ⟨hi, hn⟩).surjective
  choose x hx using hs
  refine ⟨fun g => (x g).1, fun g => ?_⟩
  have hg : IsConj (reps (x g).1) (f (x g)) := (x g).2.property
  rw [hx g] at hg
  exact hg.symm

theorem g32p_literal_class_coverage_of_cardinalities
    (hcard : ∀ c, Nat.card (conjugatesOf (g32p_literalRepresentative c)) =
      g32p_literalSize c) :
    ∃ classify : g32p_G → Fin 102,
      ∀ g, IsConj g (g32p_literalRepresentative (classify g)) := by
  apply g32p_class_coverage_of_card_sum g32p_literalRepresentative
  · intro c d h
    exact g32p_literalRepresentative_classes_injective
      (ConjClasses.mk_eq_mk_iff_isConj.mpr h)
  · simp only [hcard]
    rw [← List.sum_ofFn, g32p_literalSize_sum]
    exact ((Nat.card_coe_set_eq (g32h_G : Set (Matrix (Fin 4) (Fin 4) ℂ))).trans
      HurwitzPrymRex_g32_ncard).symm

