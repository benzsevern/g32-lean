def g32p_integralMatrixPow (M : HurwitzPrymRex_Mat) : ℕ → HurwitzPrymRex_Mat
  | 0 => HurwitzPrymRex_mone
  | n + 1 => HurwitzPrymRex_mmul M (g32p_integralMatrixPow M n)

theorem g32p_integralMatrixPow_eval (M : HurwitzPrymRex_Mat) (n : ℕ) :
    HurwitzPrymRex_evM g32h_omega (g32p_integralMatrixPow M n) =
      HurwitzPrymRex_evM g32h_omega M ^ n := by
  induction n with
  | zero => exact HurwitzPrymRex_evM_mone
  | succ n ih =>
    rw [g32p_integralMatrixPow, HurwitzPrymRex_evM_mmul g32h_omega_sq_add, ih, pow_succ']

theorem g32p_integralMatrixPow_conj (M : HurwitzPrymRex_Mat) (n : ℕ) :
    HurwitzPrymRex_g32conj (HurwitzPrymRex_evM g32h_omega (g32p_integralMatrixPow M n)) =
      HurwitzPrymRex_g32conj (HurwitzPrymRex_evM g32h_omega M) ^ n := by
  rw [g32p_integralMatrixPow_eval, map_pow]

def g32p_pointMoments (M V : HurwitzPrymRex_Mat) : Fin 4 → HurwitzPrymRex_Zw :=
  fun k => g32p_integralPointMoment (g32p_integralMatrixPow M (k.val + 1)) V

theorem g32p_centralizer_point_moments (c : Fin 102)
    (x : Subgroup.centralizer {g32p_literalRepresentative c}) (i : Fin 240)
    (hi : b4b_toMatrix (x : g32p_G) * g32p_basePoint = g32p_rootPoint i) :
    g32p_pointMoments (g32p_literalRepresentativeMatrix c) (g32p_rootMatrix i) =
      g32p_pointMoments (g32p_literalRepresentativeMatrix c) (g32p_rootMatrix 58) := by
  have hcomm : Commute (b4b_toMatrix (g32p_literalRepresentative c))
      (b4b_toMatrix (x : g32p_G)) := by
    apply (commute_iff_eq _ _).mpr
    have h := Subgroup.mem_centralizer_singleton_iff.mp x.property
    simpa only [map_mul] using congrArg b4b_toMatrix h.symm
  funext k
  apply HurwitzPrymRex_ev_injective g32h_omega_sq_add
  dsimp only [g32p_pointMoments]
  simp only [g32p_integralPointMoment_eval, g32p_integralMatrixPow_conj,
    ← g32p_literalRepresentative_matrix]
  change (9 : ℂ) * (star (g32p_rootPoint i) *
      b4b_toMatrix (g32p_literalRepresentative c) ^ (k.val + 1) * g32p_rootPoint i) 0 0 =
    (9 : ℂ) * (star (g32p_rootPoint 58) *
      b4b_toMatrix (g32p_literalRepresentative c) ^ (k.val + 1) * g32p_rootPoint 58) 0 0
  rw [← g32p_basePoint_root, ← hi,
    g32p_unitaryMoment_invariant _ _ _ (g32p_actual_matrix_unitary x)
      ((hcomm.pow_left (k.val + 1)).eq)]

end HodgeLean.Foundations.Program

