theorem g32p_archive_step_lift (node parent : HurwitzPrymRex_Mat)
    (c : Fin 102) (label : Fin 4)
    (hedge : HurwitzPrymRex_mmul node (g32p_archiveIntegralGenerators label) =
      HurwitzPrymRex_mmul (g32p_archiveIntegralGenerators label) parent)
    (hp : ∃ g : g32p_G,
      b4b_toMatrix g = HurwitzPrymRex_g32conj (HurwitzPrymRex_evM g32h_omega parent) ∧
        IsConj g (g32p_literalRepresentative c)) :
    ∃ g : g32p_G,
      b4b_toMatrix g = HurwitzPrymRex_g32conj (HurwitzPrymRex_evM g32h_omega node) ∧
        IsConj g (g32p_literalRepresentative c) := by
  obtain ⟨g, hg, hc⟩ := hp
  let a := g32p_word (g32p_archiveWords label)
  have hs : HurwitzPrymRex_g32conj (HurwitzPrymRex_evM g32h_omega node) *
      b4b_toMatrix a = b4b_toMatrix a * b4b_toMatrix g := by
    rw [hg]
    dsimp only [a]
    simp only [g32p_integralWord_map, g32p_archiveWordIntegral, ← map_mul,
      ← HurwitzPrymRex_evM_mmul g32h_omega_sq_add]
    rw [hedge]
  refine ⟨a * g * a⁻¹, ?_, ?_⟩
  · rw [map_mul, map_mul, ← hs, mul_assoc, ← map_mul, mul_inv_cancel,
      map_one, mul_one]
  · exact (isConj_iff.mpr ⟨a, rfl⟩ : IsConj g (a * g * a⁻¹)).symm.trans hc

end HodgeLean.Foundations.Program

end
