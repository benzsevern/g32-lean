theorem g32p_matrixForest_lift {G M : Type*} [Group G] [Monoid M]
    {n c s : ℕ} (φ : G →* M) (nodes : Fin n → M)
    (reps : Fin c → G) (classify : Fin n → Fin c)
    (parent : Fin n → Fin n) (depth : Fin n → ℕ)
    (generators : Fin s → G) (label : Fin n → Fin s)
    (hroot : ∀ i, depth i = 0 → nodes i = φ (reps (classify i)))
    (hdepth : ∀ i, depth i ≠ 0 → depth (parent i) < depth i)
    (hclass : ∀ i, depth i ≠ 0 → classify (parent i) = classify i)
    (hstep : ∀ i, depth i ≠ 0 →
      nodes i * φ (generators (label i)) =
        φ (generators (label i)) * nodes (parent i)) :
    ∀ i, ∃ g : G, φ g = nodes i ∧ IsConj g (reps (classify i)) := by
  have h (d : ℕ) : ∀ i, depth i = d →
      ∃ g : G, φ g = nodes i ∧ IsConj g (reps (classify i)) := by
    induction d using Nat.strong_induction_on with
    | h d ih =>
      intro i hi
      by_cases hz : depth i = 0
      · exact ⟨reps (classify i), (hroot i hz).symm, IsConj.refl _⟩
      · obtain ⟨g, hg, hc⟩ := ih (depth (parent i))
          (hi ▸ hdepth i hz) (parent i) rfl
        rw [hclass i hz] at hc
        let a := generators (label i)
        refine ⟨a * g * a⁻¹, ?_, ?_⟩
        · calc
            φ (a * g * a⁻¹) = φ a * nodes (parent i) * φ a⁻¹ := by
              rw [map_mul, map_mul, hg]
            _ = nodes i := by
              rw [← hstep i hz, mul_assoc, ← map_mul, mul_inv_cancel,
                map_one, mul_one]
        · have ha : IsConj g (a * g * a⁻¹) := isConj_iff.mpr ⟨a, rfl⟩
          exact ha.symm.trans hc
  exact fun i => h (depth i) i rfl

theorem g32p_matrixForest_enumeration {G M : Type*} [Group G] [Finite G] [Monoid M]
    {n c s : ℕ} (φ : G →* M)
    (nodes : Fin n → M) (hinj : Function.Injective nodes)
    (reps : Fin c → G) (classify : Fin n → Fin c)
    (parent : Fin n → Fin n) (depth : Fin n → ℕ)
    (generators : Fin s → G) (label : Fin n → Fin s)
    (hroot : ∀ i, depth i = 0 → nodes i = φ (reps (classify i)))
    (hdepth : ∀ i, depth i ≠ 0 → depth (parent i) < depth i)
    (hclass : ∀ i, depth i ≠ 0 → classify (parent i) = classify i)
    (hstep : ∀ i, depth i ≠ 0 →
      nodes i * φ (generators (label i)) =
        φ (generators (label i)) * nodes (parent i))
    (hcard : Nat.card G = n) :
    ∃ e : Fin n ≃ G, (∀ i, φ (e i) = nodes i) ∧
      ∀ i, IsConj (e i) (reps (classify i)) := by
  choose actual hactual hconj using g32p_matrixForest_lift φ nodes reps classify
    parent depth generators label hroot hdepth hclass hstep
  have hi : Function.Injective actual := by
    intro i j hij
    apply hinj
    rw [← hactual i, ← hactual j, hij]
  let := Fintype.ofFinite G
  have hb : Function.Bijective actual := by
    apply (Fintype.bijective_iff_injective_and_card actual).mpr
    exact ⟨hi, by simpa only [← Nat.card_eq_fintype_card, Nat.card_fin] using hcard.symm⟩
  exact ⟨Equiv.ofBijective actual hb, hactual, hconj⟩

theorem g32p_conjugates_card_of_enumeration {G I : Type*} [Group G]
    {n : ℕ} (e : Fin n ≃ G) (reps : I → G) (classify : Fin n → I)
    (hconj : ∀ i, IsConj (e i) (reps (classify i)))
    (hsep : ∀ c d, IsConj (reps c) (reps d) → c = d) (c : I) :
    Nat.card {i : Fin n // classify i = c} = Nat.card (conjugatesOf (reps c)) := by
  apply Nat.card_congr
  refine e.subtypeEquiv (fun i => ?_)
  change classify i = c ↔ IsConj (reps c) (e i)
  constructor
  · intro hi
    rw [← hi]
    exact (hconj i).symm
  · intro hc
    exact (hsep c (classify i) (hc.trans (hconj i))).symm

end HodgeLean.Foundations.Program

