theorem g32p_supplier_class_of_matrix (a : g32p_G) (node : HurwitzPrymRex_Mat)
    (c : Fin 102)
    (ha : b4b_toMatrix a = HurwitzPrymRex_g32conj (HurwitzPrymRex_evM g32h_omega node))
    (hn : ∃ g : g32p_G,
      b4b_toMatrix g = HurwitzPrymRex_g32conj (HurwitzPrymRex_evM g32h_omega node) ∧
        IsConj g (g32p_literalRepresentative c)) :
    IsConj a (g32p_literalRepresentative c) := by
  obtain ⟨g, hg, hc⟩ := hn
  have he : a = g := Subtype.val_injective (ha.trans hg.symm)
  exact he.symm ▸ hc

end HodgeLean.Foundations.Program

end
