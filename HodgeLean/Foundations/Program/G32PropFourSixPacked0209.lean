theorem g32p_archiveForest_lift {n : ℕ}
    (nodes : Fin n → HurwitzPrymRex_Mat) (classify : Fin n → Fin 102)
    (parent : Fin n → Fin n) (depth : Fin n → ℕ) (label : Fin n → Fin 4)
    (hroot : ∀ i, depth i = 0 → nodes i = g32p_literalRepresentativeMatrix (classify i))
    (hdepth : ∀ i, depth i ≠ 0 → depth (parent i) < depth i)
    (hclass : ∀ i, depth i ≠ 0 → classify (parent i) = classify i)
    (hstep : ∀ i, depth i ≠ 0 →
      HurwitzPrymRex_mmul (nodes i) (g32p_archiveIntegralGenerators (label i)) =
        HurwitzPrymRex_mmul (g32p_archiveIntegralGenerators (label i)) (nodes (parent i))) :
    ∀ i, ∃ g : g32p_G,
      b4b_toMatrix g = HurwitzPrymRex_g32conj (HurwitzPrymRex_evM g32h_omega (nodes i)) ∧
        IsConj g (g32p_literalRepresentative (classify i)) := by
  apply g32p_matrixForest_lift b4b_toMatrix
    (fun i => HurwitzPrymRex_g32conj (HurwitzPrymRex_evM g32h_omega (nodes i)))
    g32p_literalRepresentative classify parent depth
    (fun k => g32p_word (g32p_archiveWords k)) label
  · intro i hi
    change HurwitzPrymRex_g32conj (HurwitzPrymRex_evM g32h_omega (nodes i)) = _
    rw [hroot i hi, g32p_literalRepresentative_matrix]
  · exact hdepth
  · exact hclass
  · intro i hi
    change HurwitzPrymRex_g32conj (HurwitzPrymRex_evM g32h_omega (nodes i)) *
      b4b_toMatrix (g32p_word (g32p_archiveWords (label i))) =
        b4b_toMatrix (g32p_word (g32p_archiveWords (label i))) *
          HurwitzPrymRex_g32conj (HurwitzPrymRex_evM g32h_omega (nodes (parent i)))
    simp only [g32p_integralWord_map, g32p_archiveWordIntegral, ← map_mul,
      ← HurwitzPrymRex_evM_mmul g32h_omega_sq_add]
    rw [hstep i hi]

end HodgeLean.Foundations.Program

end
