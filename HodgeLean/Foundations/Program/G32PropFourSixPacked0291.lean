section

noncomputable section
namespace HodgeLean.Foundations.Program
open HodgeLean.Papers
set_option maxHeartbeats 400000

def g32p_fastOfFn {α : Type} {n : ℕ} (f : Fin n → α) : List α :=
  match n, f with
  | 0, _ => []
  | n+1, f => (List.range (n+1)).map (fun i => f (Fin.ofNat (n+1) i))
theorem g32p_fastOfFn_eq {α : Type} {n : ℕ} (f : Fin n → α) :
    g32p_fastOfFn f = List.ofFn f := by
  cases n with
  | zero => simp [g32p_fastOfFn]
  | succ n =>
    apply List.ext_getElem
    · simp [g32p_fastOfFn]
    · intro i hi hj
      simp only [g32p_fastOfFn, List.getElem_map, List.getElem_range, List.getElem_ofFn]
      congr 1
      apply Fin.ext
      exact Nat.mod_eq_of_lt (by simpa using hj)

def g32p_supplierTraceCoefficients {n : ℕ} (classify : Fin n → Fin 102)
    (exponents : Fin n → ℕ) (c : Fin 102) : List ℤ :=
  (g32p_fastOfFn fun i => if classify i = c then g32p_coeffMonomial (exponents i) 1 else []).foldr
    g32p_coeffAdd []

theorem g32p_coeffAdd_nil (xs : List ℤ) : g32p_coeffAdd xs [] = xs := by
  cases xs <;> rfl

theorem g32p_coeffAdd_assoc (xs ys zs : List ℤ) :
    g32p_coeffAdd (g32p_coeffAdd xs ys) zs = g32p_coeffAdd xs (g32p_coeffAdd ys zs) := by
  induction xs generalizing ys zs with
  | nil => rfl
  | cons x xs ih =>
    cases ys with
    | nil => rfl
    | cons y ys =>
      cases zs with
      | nil => rfl
      | cons z zs => simp only [g32p_coeffAdd, ih, add_assoc]

theorem g32p_coeffFold_tail (xs : List (List ℤ)) (ys : List ℤ) :
    xs.foldr g32p_coeffAdd ys = g32p_coeffAdd (xs.foldr g32p_coeffAdd []) ys := by
  induction xs with
  | nil => rfl
  | cons x xs ih => simp only [List.foldr_cons, ih, g32p_coeffAdd_assoc]

def g32p_coeffSegment (f : ℕ → List ℤ) (start len : ℕ) : List ℤ :=
  ((List.range' start len).map f).foldr g32p_coeffAdd []

theorem g32p_coeffSegment_add (f : ℕ → List ℤ) (start m n : ℕ) :
    g32p_coeffSegment f start (m+n) =
      g32p_coeffAdd (g32p_coeffSegment f start m) (g32p_coeffSegment f (start+m) n) := by
  unfold g32p_coeffSegment
  rw [← List.range'_append_1, List.map_append, List.foldr_append, g32p_coeffFold_tail]

theorem g32p_supplierTraceCoefficients_segment {n : ℕ} (classify : Fin (n+1) → Fin 102)
    (exponents : Fin (n+1) → ℕ) (c : Fin 102) :
    g32p_supplierTraceCoefficients classify exponents c =
      g32p_coeffSegment (fun i => if classify (Fin.ofNat (n+1) i) = c then
        g32p_coeffMonomial (exponents (Fin.ofNat (n+1) i)) 1 else []) 0 (n+1) := by
  simp only [g32p_supplierTraceCoefficients, g32p_fastOfFn, g32p_coeffSegment,
    List.range_eq_range', List.map_map, Function.comp_def]

theorem g32p_coeffEval_fold_add (z : ℂ) (xs : List (List ℤ)) :
    g32p_coeffEval z (xs.foldr g32p_coeffAdd []) = (xs.map (g32p_coeffEval z)).sum := by
  induction xs with
  | nil => rfl
  | cons x xs ih =>
    simp only [List.foldr_cons, List.map_cons, List.sum_cons, g32p_coeffEval_add, ih]

theorem g32p_supplierTraceCoefficients_eval {n : ℕ} (classify : Fin n → Fin 102)
    (exponents : Fin n → ℕ) (c : Fin 102) (z : ℂ) :
    g32p_coeffEval z (g32p_supplierTraceCoefficients classify exponents c) =
      ∑ i : Fin n, if classify i = c then z ^ exponents i else 0 := by
  rw [g32p_supplierTraceCoefficients, g32p_fastOfFn_eq, g32p_coeffEval_fold_add, List.map_ofFn, List.sum_ofFn]
  apply Finset.sum_congr rfl
  intro i _
  simp only [Function.comp_apply]
  by_cases hi : classify i = c
  · simp only [ite_eq_left hi, g32p_coeffEval_monomial, Int.cast_one, one_mul]
  · simp only [ite_eq_right hi, g32p_coeffEval]

def g32p_supplierTracePolynomialCheck (order centralizer m : ℕ)
    (coefficients : List ℤ) (trace : HurwitzPrymRex_Zw) (modulus quotient : List ℤ) : Bool :=
  decide (g32p_coeffTrim (coefficients.map ((centralizer : ℤ) * ·)) =
    g32p_coeffTrim (g32p_coeffAdd
      (g32p_coeffAdd (g32p_coeffMonomial 0 ((order : ℤ) * trace.re))
        (g32p_coeffMonomial (m / 3) ((order : ℤ) * trace.om)))
      (g32p_coeffMul modulus quotient)))

theorem g32p_supplierTracePolynomialCheck_sound (order centralizer m : ℕ)
    (coefficients : List ℤ) (trace : HurwitzPrymRex_Zw) (modulus quotient : List ℤ)
    (z : ℂ) (hroot : g32p_coeffEval z modulus = 0)
    (hcheck : g32p_supplierTracePolynomialCheck order centralizer m coefficients trace
      modulus quotient = true) :
    (centralizer : ℂ) * g32p_coeffEval z coefficients =
      (order : ℂ) * HurwitzPrymRex_ev (z ^ (m / 3)) trace := by
  have h := congrArg (g32p_coeffEval z) (of_decide_eq_true hcheck)
  rw [g32p_coeffEval_trim, g32p_coeffEval_trim, g32p_coeffEval_scale,
    g32p_coeffEval_add, g32p_coeffEval_add, g32p_coeffEval_mul, hroot] at h
  simpa only [g32p_coeffEval_monomial, Int.cast_mul, Int.cast_natCast,
    pow_zero, mul_one, mul_zero, zero_mul, add_zero, HurwitzPrymRex_ev, mul_add, mul_assoc] using h


theorem g32p_coinduced_character_of_polynomial {G : Type} [Group G] [Fintype G]
    {n : ℕ} (H : Subgroup G) (χ : H →* ℂˣ) (g : G) (e : Fin n ≃ H)
    (classify : Fin n → Fin 102) (exponents : Fin n → ℕ) (c : Fin 102)
    (m order centralizer : ℕ) (trace : HurwitzPrymRex_Zw) (modulus quotient : List ℤ)
    (z : ℂ) (horder0 : order ≠ 0)
    (horder : Nat.card H = order)
    (hcentralizer : Nat.card (Subgroup.centralizer {g}) = centralizer)
    (hclass : ∀ j, IsConj g (e j : G) ↔ classify j = c)
    (hcharacter : ∀ j, (χ (e j) : ℂ) = z ^ exponents j)
    (hroot : g32p_coeffEval z modulus = 0)
    (hcheck : g32p_supplierTracePolynomialCheck order centralizer m
      (g32p_supplierTraceCoefficients classify exponents c) trace modulus quotient = true) :
    (g32p_coinduced H χ).character g = HurwitzPrymRex_ev (z ^ (m / 3)) trace := by
  rw [g32p_coinduced_character_by_enumeration H χ g e classify c hclass,
    horder, hcentralizer]
  simp only [hcharacter]
  rw [← g32p_supplierTraceCoefficients_eval, mul_assoc,
    g32p_supplierTracePolynomialCheck_sound order centralizer m _ trace modulus quotient z
      hroot hcheck, ← mul_assoc,
    inv_mul_cancel₀ (Nat.cast_ne_zero.mpr horder0), one_mul]


theorem g32p_root_three_mul_pow (k : ℕ) (hk : k ≠ 0) :
    g32p_root (3 * k) ^ k = g32h_omega := by
  rw [g32p_root, ← Complex.exp_nat_mul, g32h_omega]
  congr 1
  push_cast
  have hkc : (k : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr hk
  field_simp

theorem g32p_root_div_three_omega (m : ℕ)
    (hm : m = 3 ∨ m = 6 ∨ m = 12 ∨ m = 15) :
    g32p_root m ^ (m / 3) = g32h_omega := by
  rcases hm with rfl | rfl | rfl | rfl
  · exact g32p_root_three_mul_pow 1 (by decide)
  · exact g32p_root_three_mul_pow 2 (by decide)
  · exact g32p_root_three_mul_pow 4 (by decide)
  · exact g32p_root_three_mul_pow 5 (by decide)

theorem g32p_coinduced_character_inverse {G : Type} [Group G] [Fintype G]
    (H : Subgroup G) (χ : H →* ℂˣ) (g : G) :
    (g32p_coinduced H χ⁻¹).character g = star ((g32p_coinduced H χ).character g) := by
  classical
  have hχ (h : H) : star (χ h : ℂ) = ((χ⁻¹) h : ℂˣ) := by
    simp only [MonoidHom.inv_apply, Units.val_inv_eq_inv_val]
    exact (Complex.inv_eq_conj
      (((Units.coeHom ℂ).comp χ).isOfFinOrder (isOfFinOrder_of_finite h)).norm_eq_one).symm
  rw [g32p_coinduced_character_direct, g32p_coinduced_character_direct]
  simp only [star_mul, star_inv₀, star_natCast, star_sum]
  conv_rhs => rw [mul_comm]
  congr 1
  apply Finset.sum_congr rfl
  intro x _
  by_cases hx : x * g * x⁻¹ ∈ H
  · rw [dite_eq_left hx, dite_eq_left hx, hχ]
  · rw [dite_eq_right hx, dite_eq_right hx, star_zero]

end HodgeLean.Foundations.Program

