namespace HodgeLean.Foundations.Program
open HodgeLean.Papers
set_option maxHeartbeats 400000
set_option maxRecDepth 2048

def g32p_row02_supplierClassifier : Fin 3456 → Fin 102 := g32p_supplierGroup00_classify

theorem g32p_row02_groupEquiv_isConj (i : Fin 3456) :
    IsConj (g32p_row02_groupEquiv i : g32p_G)
      (g32p_literalRepresentative (g32p_row02_supplierClassifier i)) := by
  have h := g32p_supplierForest_actual (g32p_supplierGroup00_source i).1 (g32p_supplierGroup00_source i).2
  rw [g32p_supplierGroup00_class] at h
  apply g32p_supplier_class_of_matrix _ _ _ ?_ h
  rw [g32p_row02_groupEquiv_map]
  exact congrArg (fun m : HurwitzPrymRex_Mat =>
    HurwitzPrymRex_g32conj (HurwitzPrymRex_evM g32h_omega m)) (g32p_supplierGroup00_matrix i)

def g32p_row02_supplierClass (h : (g32p_recordedSuppliers 1).H) : Fin 102 :=
  g32p_row02_supplierClassifier (g32p_row02_groupEquiv.symm h)

theorem g32p_row02_supplierClass_isConj (h : (g32p_recordedSuppliers 1).H) :
    IsConj (h : g32p_G) (g32p_literalRepresentative (g32p_row02_supplierClass h)) := by
  have he : (g32p_row02_groupEquiv (g32p_row02_groupEquiv.symm h) : g32p_G) = (h : g32p_G) :=
    congrArg (fun a : (g32p_recordedSuppliers 1).H => (a : g32p_G))
      (g32p_row02_groupEquiv.apply_symm_apply h)
  change IsConj (h : g32p_G) (g32p_literalRepresentative
    (g32p_row02_supplierClassifier (g32p_row02_groupEquiv.symm h)))
  rw [← he]
  exact g32p_row02_groupEquiv_isConj (g32p_row02_groupEquiv.symm h)

theorem g32p_row02_supplierClass_iff (h : (g32p_recordedSuppliers 1).H) (c : Fin 102) :
    IsConj (g32p_literalRepresentative c) (h : g32p_G) ↔ c = g32p_row02_supplierClass h := by
  constructor
  · intro hc
    apply g32p_literalRepresentative_classes_injective
    exact ConjClasses.mk_eq_mk_iff_isConj.mpr (hc.trans (g32p_row02_supplierClass_isConj h))
  · intro hc
    rw [hc]
    exact (g32p_row02_supplierClass_isConj h).symm

theorem g32p_row02_supplierClass_mem_support (h : (g32p_recordedSuppliers 1).H) :
    g32p_row02_supplierClass h ∈ g32p_supplierGroup00_support :=
  g32p_supplierGroup00_support_mem (g32p_row02_groupEquiv.symm h)

end HodgeLean.Foundations.Program

