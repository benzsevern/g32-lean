def g32p_row25_supplierClassifier : Fin 576 → Fin 102 := g32p_supplierGroup17_classify

theorem g32p_row25_groupEquiv_isConj (i : Fin 576) :
    IsConj (g32p_row22_groupEquiv i : g32p_G)
      (g32p_literalRepresentative (g32p_row25_supplierClassifier i)) := by
  have h := g32p_supplierForest_actual (g32p_supplierGroup17_source i).1 (g32p_supplierGroup17_source i).2
  rw [g32p_supplierGroup17_class] at h
  apply g32p_supplier_class_of_matrix _ _ _ ?_ h
  rw [g32p_row22_groupEquiv_map]
  exact congrArg (fun m : HurwitzPrymRex_Mat =>
    HurwitzPrymRex_g32conj (HurwitzPrymRex_evM g32h_omega m)) (g32p_supplierGroup17_matrix i)

def g32p_row25_supplierClass (h : (g32p_recordedSuppliers 24).H) : Fin 102 :=
  g32p_row25_supplierClassifier (g32p_row22_groupEquiv.symm h)

theorem g32p_row25_supplierClass_isConj (h : (g32p_recordedSuppliers 24).H) :
    IsConj (h : g32p_G) (g32p_literalRepresentative (g32p_row25_supplierClass h)) := by
  have he : (g32p_row22_groupEquiv (g32p_row22_groupEquiv.symm h) : g32p_G) = (h : g32p_G) :=
    congrArg (fun a : (g32p_recordedSuppliers 24).H => (a : g32p_G))
      (g32p_row22_groupEquiv.apply_symm_apply h)
  change IsConj (h : g32p_G) (g32p_literalRepresentative
    (g32p_row25_supplierClassifier (g32p_row22_groupEquiv.symm h)))
  rw [← he]
  exact g32p_row25_groupEquiv_isConj (g32p_row22_groupEquiv.symm h)

