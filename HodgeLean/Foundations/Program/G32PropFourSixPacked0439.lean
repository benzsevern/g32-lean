    congrArg (fun a : (g32p_recordedSuppliers 50).H => (a : g32p_G))
      (g32p_row51_groupEquiv.apply_symm_apply h)
  change IsConj (h : g32p_G) (g32p_literalRepresentative
    (g32p_row51_supplierClassifier (g32p_row51_groupEquiv.symm h)))
