/-! Representation realization from explicit finite class data and supplier traces.
HC no distance; AV milestone no distance. -/

noncomputable section

namespace HodgeLean.Foundations.Program

open CategoryTheory HodgeLean.Papers
open scoped Classical

set_option maxHeartbeats 400000

/-- Class labels, fibre sizes and inversion for the literal table.
Source: G32 v0.16, Appendix A; `g32p_literalSize`, `g32p_literalInverseClass`. -/
structure g32p_familiesClassData where
  label : g32p_G → Fin 102
  identity : label 1 = 0
  card : ∀ c, Fintype.card {g : g32p_G // label g = c} = g32p_literalSize c
  inverse : ∀ g, label g⁻¹ = g32p_literalInverseClass (label g)

/-- Realization of all 102 table rows from actual generator traces.
Source: Serre, Linear Representations of Finite Groups, §2.3;
`g32p_reconstruction_of_class_fibers`. -/
theorem g32p_families_realization (D : g32p_familiesClassData)
    (htrace : ∀ k g, (g32p_recordedInductionGenerators k).character g =
      HurwitzPrymRex_ev g32h_omega (g32p_literalTraceValue k (D.label g))) :
    ∃ W : Fin 102 → FDRep ℂ g32p_G, (∀ i, Simple (W i)) ∧
      ∀ i g, (W i).character g = g32p_literalComplexValue i (D.label g) := by
  have horder : Nat.card g32p_G = 155520 :=
    (Nat.card_coe_set_eq (g32h_G : Set (Matrix (Fin 4) (Fin 4) ℂ))).trans
      HurwitzPrymRex_g32_ncard
  apply g32p_reconstruction_of_class_fibers D.label g32p_literalSize
    g32p_literalInverseClass g32p_literalComplexValue g32p_recordedInductionGenerators
    g32p_literalA g32p_literalQ
    (fun c => by simpa only [← Nat.card_eq_fintype_card] using D.card c) D.inverse
  · intro k g
    rw [htrace]
    exact g32p_literalTrace_complex_expansion k (D.label g)
  · intro i j
    by_cases h : i = j <;> simpa [h] using g32p_literalQA i j
  · intro i
    rw [horder]
    exact g32p_literalCharacter_norm i
  · intro i
    rw [D.identity]
    exact g32p_literalComplexValue_positive i

end HodgeLean.Foundations.Program

end
