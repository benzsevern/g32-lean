noncomputable section

namespace HodgeLean.Foundations.Program

open HodgeLean.Papers

set_option maxHeartbeats 400000

theorem g32p_literalExpansion_eval (cs : List (Fin 102 × ℤ)) (c : Fin 102) :
    HurwitzPrymRex_ev g32h_omega (g32p_literalExpansion cs c) =
      (cs.map fun p => (p.2 : ℂ) *
        HurwitzPrymRex_ev g32h_omega (g32p_literalCharacterValue p.1 c)).sum := by
  induction cs with
  | nil => simp [g32p_literalExpansion, HurwitzPrymRex_ev]
  | cons p cs ih =>
      rcases p with ⟨j, a⟩
      simp only [g32p_literalExpansion, HurwitzPrymRex_ev_add,
        HurwitzPrymRex_ev_mul g32h_omega_sq_add, List.map_cons, List.sum_cons, ih]
      simp [HurwitzPrymRex_ev]

theorem g32p_literalCoefficient_sum (cs : List (Fin 102 × ℤ)) (f : Fin 102 → ℂ) :
    ∑ i, (g32p_literalCoefficient cs i : ℂ) * f i =
      (cs.map fun p => (p.2 : ℂ) * f p.1).sum := by
  induction cs with
  | nil => simp [g32p_literalCoefficient]
  | cons p cs ih =>
      rcases p with ⟨j, a⟩
      simp only [g32p_literalCoefficient, Int.cast_add, add_mul,
        Finset.sum_add_distrib, List.map_cons, List.sum_cons, ih]
      simp

theorem g32p_literalTrace_complex_expansion (k : Fin 408) (c : Fin 102) :
    HurwitzPrymRex_ev g32h_omega (g32p_literalTraceValue k c) =
      ∑ i : Fin 102,
        (g32p_literalCoefficient (g32p_literalGeneratorCoefficients k) i : ℂ) *
          g32p_literalComplexValue i c := by
  rw [← g32p_literalTrace_expansion, g32p_literalExpansion_eval]
  exact (g32p_literalCoefficient_sum (g32p_literalGeneratorCoefficients k)
    (fun i => g32p_literalComplexValue i c)).symm

end HodgeLean.Foundations.Program

