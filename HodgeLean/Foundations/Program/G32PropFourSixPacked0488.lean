    (τ τbar : Fin 44 → FDRep ℂ g32p_G) (θ : Fin 4 → FDRep ℂ g32p_G)
    (hτ : ∀ j g, (τ j).character g =
      g32p_literalComplexValue (g32p_restrictionFamilyPair j) (classify g))
    (hbar : ∀ j g, (τbar j).character g =
      g32p_literalComplexValue (g32p_restrictionFamilyBar j) (classify g))
    (hθ : ∀ j g, (θ j).character g =
      g32p_literalComplexValue (g32p_restrictionFamilyQuat j) (classify g)) :
    ∃ v ∈ g32VectorTable, v.i = 10 ∧
      papersA τ τbar θ g32p_row10_finiteSupplier.H
        (g32p_complexCharacter g32p_row10_finiteSupplier) = g32SparseVec v.coords := by
  apply g32p_row10_restriction_from_buckets τ τbar θ
  intro j i
  rw [g32p_row10_restrictionFamily, ← hclass]
  exact g32p_restriction_family_trace τ τbar θ _ _
    (fun j => hτ j _) (fun j => hbar j _) (fun j => hθ j _) j


theorem g32p_row10_restriction_supplier_witness
    (hsupplier : ∃ r ∈ g32WitnessTable, r.i = 10 ∧ r.m = g32p_row10_finiteSupplier.m ∧
      r.orderH = Nat.card g32p_row10_finiteSupplier.H ∧
      (g32p_exponents g32p_row10_finiteSupplier).Perm (expandExps r.exps))
    (τ τbar : Fin 44 → FDRep ℂ g32p_G) (θ : Fin 4 → FDRep ℂ g32p_G)
    (htrace : ∀ (j : Fin 48) (i : Fin 486),
      g32p_restrictionTrace τ τbar θ j (g32p_row09_groupEquiv i) =
        HurwitzPrymRex_ev g32h_omega (g32p_row10_restrictionCoefficients j (g32p_row10_restrictionBucket i))) :
    ∃ (S : g32p_Supplier) (χc : S.H →* ℂˣ),
