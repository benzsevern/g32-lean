theorem g32p_row21_restriction_from_buckets
    (τ τbar : Fin 44 → FDRep ℂ g32p_G) (θ : Fin 4 → FDRep ℂ g32p_G)
    (htrace : ∀ (j : Fin 48) (i : Fin 972),
      g32p_restrictionTrace τ τbar θ j (g32p_row21_groupEquiv i) =
        HurwitzPrymRex_ev g32h_omega (g32p_row21_restrictionCoefficients j (g32p_row21_restrictionBucket i))) :
    ∃ v ∈ g32VectorTable, v.i = 21 ∧
      papersA τ τbar θ g32p_row21_finiteSupplier.H (g32p_complexCharacter g32p_row21_finiteSupplier) =
        g32SparseVec v.coords := by
  classical
  let H := g32p_row21_finiteSupplier.H
  letI : Fintype H := Fintype.ofFinite H
  have hsum (j : Fin 48) :
      (∑ h : H, g32p_restrictionTrace τ τbar θ j h *
        ((g32p_complexCharacter g32p_row21_finiteSupplier) h⁻¹ : ℂ)) =
      ((g32p_row21_pairingTerms j).map (fun x => (x.1 : ℂ) *
        HurwitzPrymRex_ev (g32p_root 3 ^ (3 / 3)) x.2.1 *
          g32p_root 3 ^ x.2.2)).sum := by
    exact g32p_restriction_bucket_sums g32p_row21_finiteSupplier
      g32p_row21_groupEquiv g32p_row21_characterValues g32p_row21_finiteSupplier_value
      g32p_row21_restrictionBucket g32p_row21_restrictionSizes g32p_row21_restrictionExponents
      g32p_row21_restrictionCounts g32p_row21_restrictionExponent
      τ τbar θ g32p_row21_pairingTerms g32p_row21_restrictionCoefficients
      g32p_row21_restrictionLabels (g32p_restriction_root_omega 3 (by decide)) htrace
      g32p_row21_restrictionDecode g32p_row21_restrictionTerms j
  apply g32p_row21_restriction_of_sums _ τ τbar θ (g32p_complexCharacter g32p_row21_finiteSupplier)
    (g32p_root 3) (g32p_root_primitive g32p_row21_finiteSupplier)
    (by rw [Fintype.card_eq_nat_card]; exact g32p_row21_finiteSupplier_order)
  · intro j
    simpa only [g32p_restrictionTrace, dite_eq_left j.isLt] using hsum ⟨j.val, by omega⟩
  · intro j
    have hn : ¬ 44 + j.val < 44 := by omega
    simpa only [g32p_restrictionTrace, dite_eq_right hn, Nat.add_sub_cancel_left] using
