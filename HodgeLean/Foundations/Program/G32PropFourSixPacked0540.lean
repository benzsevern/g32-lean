      ((g32p_row25_pairingTerms j).map (fun x => (x.1 : ℂ) *
        HurwitzPrymRex_ev (g32p_root 6 ^ (6 / 3)) x.2.1 *
          g32p_root 6 ^ x.2.2)).sum := by
    exact g32p_restriction_bucket_sums g32p_row25_finiteSupplier
      g32p_row22_groupEquiv g32p_row25_characterValues g32p_row25_finiteSupplier_value
      g32p_row25_restrictionBucket g32p_row25_restrictionSizes g32p_row25_restrictionExponents
      g32p_row25_restrictionCounts g32p_row25_restrictionExponent
      τ τbar θ g32p_row25_pairingTerms g32p_row25_restrictionCoefficients
      g32p_row25_restrictionLabels (g32p_restriction_root_omega 6 (by decide)) htrace
      g32p_row25_restrictionDecode g32p_row25_restrictionTerms j
  apply g32p_row25_restriction_of_sums _ τ τbar θ (g32p_complexCharacter g32p_row25_finiteSupplier)
    (g32p_root 6) (g32p_root_primitive g32p_row25_finiteSupplier)
