theorem g32p_row35_restriction_from_buckets
    (τ τbar : Fin 44 → FDRep ℂ g32p_G) (θ : Fin 4 → FDRep ℂ g32p_G)
    (htrace : ∀ (j : Fin 48) (i : Fin 432),
      g32p_restrictionTrace τ τbar θ j (g32p_row33_groupEquiv i) =
        HurwitzPrymRex_ev g32h_omega (g32p_row35_restrictionCoefficients j (g32p_row35_restrictionBucket i))) :
    ∃ v ∈ g32VectorTable, v.i = 35 ∧
      papersA τ τbar θ g32p_row35_finiteSupplier.H (g32p_complexCharacter g32p_row35_finiteSupplier) =
        g32SparseVec v.coords := by
  classical
  let H := g32p_row35_finiteSupplier.H
  letI : Fintype H := Fintype.ofFinite H
  have hsum (j : Fin 48) :
      (∑ h : H, g32p_restrictionTrace τ τbar θ j h *
        ((g32p_complexCharacter g32p_row35_finiteSupplier) h⁻¹ : ℂ)) =
      ((g32p_row35_pairingTerms j).map (fun x => (x.1 : ℂ) *
        HurwitzPrymRex_ev (g32p_root 3 ^ (3 / 3)) x.2.1 *
          g32p_root 3 ^ x.2.2)).sum := by
    exact g32p_restriction_bucket_sums g32p_row35_finiteSupplier
      g32p_row33_groupEquiv g32p_row35_characterValues g32p_row35_finiteSupplier_value
      g32p_row35_restrictionBucket g32p_row35_restrictionSizes g32p_row35_restrictionExponents
      g32p_row35_restrictionCounts g32p_row35_restrictionExponent
      τ τbar θ g32p_row35_pairingTerms g32p_row35_restrictionCoefficients
      g32p_row35_restrictionLabels (g32p_restriction_root_omega 3 (by decide)) htrace
      g32p_row35_restrictionDecode g32p_row35_restrictionTerms j
  apply g32p_row35_restriction_of_sums _ τ τbar θ (g32p_complexCharacter g32p_row35_finiteSupplier)
    (g32p_root 3) (g32p_root_primitive g32p_row35_finiteSupplier)
    (by rw [Fintype.card_eq_nat_card]; exact g32p_row35_finiteSupplier_order)
  · intro j
    simpa only [g32p_restrictionTrace, dite_eq_left j.isLt] using hsum ⟨j.val, by omega⟩
  · intro j
    have hn : ¬ 44 + j.val < 44 := by omega
    simpa only [g32p_restrictionTrace, dite_eq_right hn, Nat.add_sub_cancel_left] using
      hsum ⟨44 + j.val, by omega⟩


theorem g32p_row35_restriction_from_family
    (classify : g32p_G → Fin 102)
    (hclass : ∀ i, classify (g32p_row33_groupEquiv i) =
      g32p_row35_restrictionClasses (g32p_row35_restrictionBucket i))
    (τ τbar : Fin 44 → FDRep ℂ g32p_G) (θ : Fin 4 → FDRep ℂ g32p_G)
    (hτ : ∀ j g, (τ j).character g =
      g32p_literalComplexValue (g32p_restrictionFamilyPair j) (classify g))
    (hbar : ∀ j g, (τbar j).character g =
      g32p_literalComplexValue (g32p_restrictionFamilyBar j) (classify g))
    (hθ : ∀ j g, (θ j).character g =
      g32p_literalComplexValue (g32p_restrictionFamilyQuat j) (classify g)) :
    ∃ v ∈ g32VectorTable, v.i = 35 ∧
      papersA τ τbar θ g32p_row35_finiteSupplier.H
        (g32p_complexCharacter g32p_row35_finiteSupplier) = g32SparseVec v.coords := by
  apply g32p_row35_restriction_from_buckets τ τbar θ
  intro j i
  rw [g32p_row35_restrictionFamily, ← hclass]
  exact g32p_restriction_family_trace τ τbar θ _ _
    (fun j => hτ j _) (fun j => hbar j _) (fun j => hθ j _) j


theorem g32p_row35_restriction_supplier_witness
    (hsupplier : ∃ r ∈ g32WitnessTable, r.i = 35 ∧ r.m = g32p_row35_finiteSupplier.m ∧
      r.orderH = Nat.card g32p_row35_finiteSupplier.H ∧
      (g32p_exponents g32p_row35_finiteSupplier).Perm (expandExps r.exps))
    (τ τbar : Fin 44 → FDRep ℂ g32p_G) (θ : Fin 4 → FDRep ℂ g32p_G)
    (htrace : ∀ (j : Fin 48) (i : Fin 432),
      g32p_restrictionTrace τ τbar θ j (g32p_row33_groupEquiv i) =
        HurwitzPrymRex_ev g32h_omega (g32p_row35_restrictionCoefficients j (g32p_row35_restrictionBucket i))) :
    ∃ (S : g32p_Supplier) (χc : S.H →* ℂˣ),
      (∀ h, (χc h : ℂ) = g32p_root S.m ^ (Multiplicative.toAdd (S.χ h)).val) ∧
      (∃ r ∈ g32WitnessTable, r.i = 35 ∧ r.m = S.m ∧ r.orderH = Nat.card S.H ∧
        (g32p_exponents S).Perm (expandExps r.exps)) ∧
      (∃ v ∈ g32VectorTable, v.i = 35 ∧ papersA τ τbar θ S.H χc = g32SparseVec v.coords) := by
  exact ⟨g32p_row35_finiteSupplier, g32p_complexCharacter g32p_row35_finiteSupplier,
    g32p_complexCharacter_apply _, hsupplier, g32p_row35_restriction_from_buckets τ τbar θ htrace⟩

