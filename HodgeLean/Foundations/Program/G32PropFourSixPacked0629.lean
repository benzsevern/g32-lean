namespace HodgeLean.Foundations.Program

open HodgeLean.Papers

set_option maxHeartbeats 200000

/-- Finite transitions give a surjection onto the actual coset space. -/
theorem g32p_coset_surjective {G : Type*} [Group G] [Finite G] {n k : ℕ}
    (H : Subgroup G) (gens : Fin k → G)
    (hgen : Subgroup.closure (Set.range gens) = ⊤)
    (reps : Fin n → G) (origin : Fin n) (h1 : reps origin = 1)
    (next : Fin k → Fin n → Fin n)
    (factor : Fin k → Fin n → H)
    (hstep : ∀ s i, gens s * reps i = reps (next s i) * factor s i) :
    Function.Surjective (fun i => (QuotientGroup.mk (reps i) : G ⧸ H)) := by
  classical
  let T : Submonoid G :=
    { carrier := {g | ∀ i, ∃ j, ∃ h : H, g * reps i = reps j * h}
      one_mem' := by intro i; exact ⟨i, 1, by simp⟩
      mul_mem' := by
        intro a b ha hb i
        obtain ⟨j, h, hj⟩ := hb i
        obtain ⟨l, h', hl⟩ := ha j
        exact ⟨l, h' * h, by simp only [Subgroup.coe_mul]; rw [mul_assoc, hj,
          ← mul_assoc, hl, mul_assoc]⟩ }
  have hT : Submonoid.closure (Set.range gens) ≤ T := by
    apply Submonoid.closure_le.mpr
    rintro _ ⟨s, rfl⟩ i
    exact ⟨next s i, factor s i, hstep s i⟩
  intro q
  induction q using Quotient.inductionOn' with
  | h g =>
    have hg : g ∈ Submonoid.closure (Set.range gens) := by
      rw [← Subgroup.closure_toSubmonoid_of_finite, hgen]
      trivial
    obtain ⟨i, h, hi⟩ := hT hg origin
    refine ⟨i, QuotientGroup.eq.mpr ?_⟩
    have he : g = reps i * h := by simpa only [h1, mul_one] using hi
    rw [he, ← mul_assoc, inv_mul_cancel, one_mul]
    exact h.property

/-- The group order turns the transition surjection into an enumeration. -/
theorem g32p_coset_bijective {G : Type*} [Group G] [Finite G] {n : ℕ}
    (H : Subgroup G) (reps : Fin n → G)
    (hsurj : Function.Surjective (fun i => (QuotientGroup.mk (reps i) : G ⧸ H)))
    (hcard : n * Nat.card H = Nat.card G) :
    Function.Bijective (fun i => (QuotientGroup.mk (reps i) : G ⧸ H)) := by
  classical
  letI := Fintype.ofFinite G
  letI := Fintype.ofFinite (G ⧸ H)
  apply (Fintype.bijective_iff_surjective_and_card _).mpr
  refine ⟨hsurj, ?_⟩
  have he : n = H.index := by
    apply Nat.eq_of_mul_eq_mul_right (Nat.card_pos (α := H))
    exact hcard.trans H.index_mul_card.symm
  simpa only [Fintype.card_fin, ← Nat.card_eq_fintype_card, Nat.card_fin, Subgroup.index] using he

theorem g32p_archive_generators_top :
    Subgroup.closure (Set.range (fun i : Fin 4 =>
      g32p_word (g32p_archiveWords i))) = ⊤ := by
  let H := Subgroup.closure (Set.range (fun i : Fin 4 =>
    g32p_word (g32p_archiveWords i)))
  apply eq_top_iff.mpr
  intro g _
  have hg : b4b_toMatrix g ∈ Submonoid.closure (Set.range (fun i : Fin 4 =>
      (g32p_archiveGenerators i).submatrix g32p_archiveCoordinates g32p_archiveCoordinates)) := by
    rw [g32p_archive_matrix_closure]
    exact g.property
  have hmem : ∀ M ∈ Submonoid.closure (Set.range (fun i : Fin 4 =>
      (g32p_archiveGenerators i).submatrix g32p_archiveCoordinates g32p_archiveCoordinates)),
      ∀ x : g32p_G, b4b_toMatrix x = M → x ∈ H := by
    intro M hM
    induction hM using Submonoid.closure_induction with
    | mem M hM =>
      obtain ⟨i, rfl⟩ := hM
      intro x hx
      have he : x = g32p_word (g32p_archiveWords i) := by
        apply Subtype.ext
        exact hx.trans (g32p_archiveGenerator_word i).symm
      rw [he]
      exact Subgroup.subset_closure (Set.mem_range_self i)
    | one =>
      intro x hx
      have he : x = 1 := Subtype.ext hx
      rw [he]
      exact H.one_mem
    | mul a b ha hb iha ihb =>
      intro x hx
      have ha' : a ∈ g32h_G := g32p_archive_matrix_closure ▸ ha
      have hb' : b ∈ g32h_G := g32p_archive_matrix_closure ▸ hb
      let xa : g32p_G := ⟨a, ha'⟩
      let xb : g32p_G := ⟨b, hb'⟩
      have he : x = xa * xb := Subtype.ext hx
      rw [he]
      exact H.mul_mem (iha xa rfl) (ihb xb rfl)
  exact hmem _ hg g rfl

end HodgeLean.Foundations.Program

end

