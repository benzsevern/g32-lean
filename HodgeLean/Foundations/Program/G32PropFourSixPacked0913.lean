  change b4b_toMatrix (g32p_cosetBranches b * g32p_row32_cosetActualRepresentatives i) =
    b4b_toMatrix (g32p_row32_cosetActualRepresentatives (g32p_row32_cosetBranchNext b i) *
      (g32p_row32_groupEquiv (g32p_row32_cosetBranchFactor b i) : g32p_G))
  rw [map_mul, map_mul, g32p_row32_cosetBranchMap, g32p_row32_cosetActualRepresentatives_map,
    g32p_row32_cosetActualRepresentatives_map, g32p_row32_groupEquiv_map,
    ← map_mul, ← map_mul, ← HurwitzPrymRex_evM_mmul g32h_omega_sq_add,
