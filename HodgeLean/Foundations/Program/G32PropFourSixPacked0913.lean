  change (QuotientGroup.mk (g32p_row32_cosetActualRepresentatives (g32p_row32_cosetBranchNext b i)) : g32p_G ⧸ g32p_row32_finiteSupplier.H) =
    g32p_cosetBranches b • (QuotientGroup.mk (g32p_row32_cosetActualRepresentatives i) : g32p_G ⧸ g32p_row32_finiteSupplier.H)
  rw [MulAction.Quotient.smul_coe, smul_eq_mul]
  apply QuotientGroup.eq.mpr
  rw [g32p_row32_cosetActualBranchStep, ← mul_assoc, inv_mul_cancel, one_mul]
  exact (g32p_row32_groupEquiv (g32p_row32_cosetBranchFactor b i)).property

