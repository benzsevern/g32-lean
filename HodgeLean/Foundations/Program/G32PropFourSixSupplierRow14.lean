    g32p_row14_characterValues (g32p_row14_groupNext i s) =
      g32p_row14_characterValues i * g32p_row14_characterValues (g32p_row14_groupNext 0 s) := by
  decide +kernel

theorem g32p_row14_characterSurjective : Function.Surjective g32p_row14_characterValues := by
  decide +kernel

def g32p_row14_finiteSupplier : g32p_Supplier :=
  g32p_supplierOfFiniteTransitions (by decide) g32p_row14_groupGenerators
    g32p_row14_groupEquiv 0 g32p_row14_groupEquiv_one
    g32p_row14_groupNext g32p_row14_groupEquiv_step g32p_row14_characterValues
    (by rfl) g32p_row14_characterTransition g32p_row14_characterSurjective

theorem g32p_row14_finiteSupplier_order : Nat.card g32p_row14_finiteSupplier.H = 24 :=
  g32p_row14_groupOrder

theorem g32p_row14_finiteSupplier_value (i : Fin 24) :
    g32p_row14_finiteSupplier.χ (g32p_row14_groupEquiv i) = g32p_row14_characterValues i :=
  g32p_supplierOfFiniteTransitions_value ..

