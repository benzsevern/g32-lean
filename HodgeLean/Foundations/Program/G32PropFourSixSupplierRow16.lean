theorem g32p_row16_groupEnumeration :
    ∃ e : Fin 15 ≃ Subgroup.closure (Set.range g32p_row16_groupGenerators),
      ∀ i, b4b_toMatrix (e i : g32p_G) =
        HurwitzPrymRex_g32conj (HurwitzPrymRex_evM g32h_omega
          (g32p_row16_groupNodes i)) := by
  apply g32p_matrixPathEnumeration b4b_toMatrix Subtype.val_injective
    (fun a => HurwitzPrymRex_g32conj (HurwitzPrymRex_evM g32h_omega a))
    (by rw [HurwitzPrymRex_evM_mone, map_one])
    (by intro a b; rw [HurwitzPrymRex_evM_mmul g32h_omega_sq_add, map_mul])
    (HurwitzPrymRex_g32conj_injective.comp
      (HurwitzPrymRex_evM_injective g32h_omega_sq_add))
    g32p_row16_groupGenerators g32p_row16_groupMatrices g32p_row16_groupGenerator_map
    g32p_row16_groupNodes 0 g32p_row16_groupParent g32p_row16_groupLabel Fin.val
    g32p_row16_groupNext g32p_row16_groupInjective (by decide)
    g32p_row16_groupParent_lt
  · intro i hi
    have hs := (of_decide_eq_true g32p_row16_groupTransition)
      (g32p_row16_groupParent i) (g32p_row16_groupLabel i)
    rw [g32p_row16_groupParent_step i hi] at hs
    exact hs.symm
  · exact of_decide_eq_true g32p_row16_groupTransition

