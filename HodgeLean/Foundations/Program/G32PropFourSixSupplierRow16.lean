  obtain ⟨e, _⟩ := g32p_row16_groupEnumeration
  simpa only [Nat.card_fin] using (Nat.card_congr e).symm

def g32p_row16_groupEquiv : Fin 15 ≃ Subgroup.closure (Set.range g32p_row16_groupGenerators) :=
