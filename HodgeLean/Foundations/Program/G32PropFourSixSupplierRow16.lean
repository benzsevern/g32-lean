      HurwitzPrymRex_g32conj (HurwitzPrymRex_evM g32h_omega (g32p_row16_groupNodes i)) :=
  Classical.choose_spec g32p_row16_groupEnumeration i

theorem g32p_row16_groupEquiv_one : g32p_row16_groupEquiv 0 = 1 := by
  apply Subtype.ext
  apply Subtype.val_injective
  change b4b_toMatrix (g32p_row16_groupEquiv 0 : g32p_G) = b4b_toMatrix 1
  rw [g32p_row16_groupEquiv_map, map_one,
    show g32p_row16_groupNodes 0 = HurwitzPrymRex_mone by decide,
    HurwitzPrymRex_evM_mone, map_one]

theorem g32p_row16_groupEquiv_step (i : Fin 15) (s : Fin 1) :
    g32p_row16_groupEquiv (g32p_row16_groupNext i s) =
      g32p_row16_groupEquiv i *
        ⟨g32p_row16_groupGenerators s, Subgroup.subset_closure (Set.mem_range_self s)⟩ := by
  apply Subtype.ext
  apply Subtype.val_injective
  change b4b_toMatrix (g32p_row16_groupEquiv (g32p_row16_groupNext i s) : g32p_G) =
    b4b_toMatrix ((g32p_row16_groupEquiv i : g32p_G) * g32p_row16_groupGenerators s)
  rw [map_mul, g32p_row16_groupEquiv_map, g32p_row16_groupEquiv_map,
    g32p_row16_groupGenerator_map, ← map_mul, ← HurwitzPrymRex_evM_mmul g32h_omega_sq_add]
  exact congrArg (fun a => HurwitzPrymRex_g32conj (HurwitzPrymRex_evM g32h_omega a))
    ((of_decide_eq_true g32p_row16_groupTransition) i s).symm

