  exact congrArg (fun a => HurwitzPrymRex_g32conj (HurwitzPrymRex_evM g32h_omega a))
    ((of_decide_eq_true g32p_row18_groupTransition) i s).symm

def g32p_row18_characterValues : Fin 36 → Multiplicative (ZMod 6) :=
  fun i => Multiplicative.ofAdd (![0, 3, 2, 0, 0, 5, 3, 4, 2, 3, 2, 0, 1, 5, 4, 0, 5, 3, 4, 2, 1, 3, 2, 0, 1, 5, 4, 5, 3, 4, 2, 1, 1, 5, 4, 1] i)

theorem g32p_row18_characterTransition : ∀ i : Fin 36, ∀ s : Fin 3,
    g32p_row18_characterValues (g32p_row18_groupNext i s) =
