  decide +kernel

def g32p_row18_finiteSupplier : g32p_Supplier :=
  g32p_supplierOfFiniteTransitions (by decide) g32p_row18_groupGenerators
    g32p_row18_groupEquiv 0 g32p_row18_groupEquiv_one
    g32p_row18_groupNext g32p_row18_groupEquiv_step g32p_row18_characterValues
    (by rfl) g32p_row18_characterTransition g32p_row18_characterSurjective

theorem g32p_row18_finiteSupplier_order : Nat.card g32p_row18_finiteSupplier.H = 36 :=
  g32p_row18_groupOrder

theorem g32p_row18_finiteSupplier_value (i : Fin 36) :
    g32p_row18_finiteSupplier.χ (g32p_row18_groupEquiv i) = g32p_row18_characterValues i :=
  g32p_supplierOfFiniteTransitions_value ..

