    (by intro a b; rw [HurwitzPrymRex_evM_mmul g32h_omega_sq_add, map_mul])
    (HurwitzPrymRex_g32conj_injective.comp
      (HurwitzPrymRex_evM_injective g32h_omega_sq_add))
    g32p_row41_groupGenerators g32p_row41_groupMatrices g32p_row41_groupGenerator_map
    g32p_row41_groupNodes 0 g32p_row41_groupParent g32p_row41_groupLabel Fin.val
    g32p_row41_groupNext g32p_row41_groupInjective (by decide)
    g32p_row41_groupParent_lt
  · intro i hi
    have hs := (of_decide_eq_true g32p_row41_groupTransition)
      (g32p_row41_groupParent i) (g32p_row41_groupLabel i)
    rw [g32p_row41_groupParent_step i hi] at hs
    exact hs.symm
  · exact of_decide_eq_true g32p_row41_groupTransition

theorem g32p_row41_groupOrder :
    Nat.card (Subgroup.closure (Set.range g32p_row41_groupGenerators)) = 54 := by
  obtain ⟨e, _⟩ := g32p_row41_groupEnumeration
  simpa only [Nat.card_fin] using (Nat.card_congr e).symm

def g32p_row41_groupEquiv : Fin 54 ≃ Subgroup.closure (Set.range g32p_row41_groupGenerators) :=
