import HodgeLean.Foundations.Program.CurveJacobian
import HodgeLean.Papers.G32FamilyDefs

/-!
# Track B4, Hurwitz covers, isotypic Prym factors and Chevalley–Weil: definitions

Everything here is constructed from B3's Riemann surfaces (a type `C` with `ChartedSpace E C` and
`IsManifold 𝓘(ℂ, E) ω C`), from B2's tori, or from finite group data. Nothing is stored.

* **Monodromy tuples**: the Nielsen condition `b4_Nielsen` (ordered product one, generating), the
  simultaneous conjugation `b4_conjTuple`, the braid move `b4_braid`, one Hurwitz move, the
  Hurwitz component `b4_SameComponent` (the equivalence relation they generate) and the multiset
  `b4_classes` of conjugacy classes of a tuple.
* **Branched covers** `f : C → Y`: the ramification index `b4_ramIndex` (order of the first
  nonvanishing derivative of `f` in charts, the local degree), the fibre degree
  `b4_fiberDegree` (fibre count with multiplicity), the branch set `b4_branchSet`, the restriction
  `b4_restrict` of `f` over the complement of the branch set, and its monodromy `b4_monodromy`
  (Mathlib's `IsCoveringMap.monodromyPerm` when the restriction is a covering map).
* **Group actions**: Galois covers `b4_IsGaloisCover`, the rotation generator `b4_IsRotGen` of a
  stabilizer (the element acting on the tangent line by `e^{2πi/n}`), the action `b4_formAct` on
  functions on the tangent bundle (`g ↦ (g⁻¹)^*`), the invariant forms `b4_invariantForms`, the
  space `b4_HomG` of `G`-maps from a representation, the age `b4_age` of a linear map.
* **The lattice action and Prym factors**: `b4_latticeAct g`, the pushforward of `g` on B3's
  period lattice, its complexification `b4_cplxAct`, the endomorphism `b4_groupEnd a` of an element
  `a ∈ ℤ[G]`, and the factor `A_a(C) = b4_Prym a`, B2's image torus of `b4_groupEnd a`, with its
  filtration `b4_prymF a` and restricted form `b4_prymQ Q a`.
* **An explicit instance**: the action of `μ₄ = Multiplicative (ZMod 4)` on B3's elliptic curve
  `ℂ ⧸ (ℤ + iℤ)` by multiplication by `i`, and the characters `b4_char4 a` of `μ₄`.

HC no distance; AV milestone no distance.
-/

noncomputable section

open Manifold HodgeLean.Papers
open scoped TensorProduct ContDiff

namespace HodgeLean.Foundations.Program

/-! ## Monodromy tuples -/

section Tuples

variable {G : Type*} [Group G]

/-- **The Nielsen condition** on a tuple `(g₁, …, g_r)`: ordered product one and the entries
generate `G`. These are the monodromy tuples of connected `G`-covers of `ℙ¹` branched over `r`
ordered points.
Source: Fried–Völklein, *The inverse Galois problem and rational points on moduli spaces*,
Math. Ann. 290 (1991), §1 (Nielsen classes); Völklein, *Groups as Galois Groups*, Cambridge Stud.
Adv. Math. 53 (1996), Ch. 2. -/
def b4_Nielsen {r : ℕ} (g : Fin r → G) : Prop :=
  (List.ofFn g).prod = 1 ∧ Subgroup.closure (Set.range g) = ⊤

/-- A tuple with product `≠ 1` is not Nielsen (the first degenerate case). -/
example {r : ℕ} (g : Fin r → G) (h : (List.ofFn g).prod ≠ 1) : ¬ b4_Nielsen g :=
  fun hg ↦ h hg.1

/-- A tuple in a proper subgroup is not Nielsen (the second degenerate case). -/
example {r : ℕ} (g : Fin r → G) (h : Subgroup.closure (Set.range g) ≠ ⊤) : ¬ b4_Nielsen g :=
  fun hg ↦ h hg.2

/-- **Simultaneous conjugation** of a tuple, `gᵢ ↦ a gᵢ a⁻¹`.
Source: Fried–Völklein, Math. Ann. 290 (1991), §1 (inner Nielsen classes). -/
def b4_conjTuple {r : ℕ} (a : G) (g : Fin r → G) : Fin r → G :=
  fun i ↦ a * g i * a⁻¹

example {r : ℕ} (g : Fin r → G) : b4_conjTuple 1 g = g := by
  funext i
  simp [b4_conjTuple]

/-- **The braid move** at positions `a`, `b` (adjacent when `b = a + 1`):
`(…, g_a, g_b, …) ↦ (…, g_a g_b g_a⁻¹, g_a, …)`, the action of the standard braid generator.
Source: Völklein, *Groups as Galois Groups*, Ch. 9–10 (the braid action on Nielsen classes);
Fried–Völklein, Math. Ann. 290 (1991), §1. -/
def b4_braid {r : ℕ} (a b : Fin r) (g : Fin r → G) : Fin r → G :=
  Function.update (g ∘ Equiv.swap a b) a (g a * g b * (g a)⁻¹)

example {r : ℕ} (a b : Fin r) (g : Fin r → G) : b4_braid a b g a = g a * g b * (g a)⁻¹ := by
  simp [b4_braid]

/-- **One Hurwitz move**: a simultaneous conjugation or an adjacent braid move.
Source: Völklein, *Groups as Galois Groups*, Ch. 10 (Hurwitz spaces as covers of configuration
space; their components are braid orbits of Nielsen classes modulo conjugation). -/
def b4_HurwitzMove {r : ℕ} (g g' : Fin r → G) : Prop :=
  (∃ a : G, g' = b4_conjTuple a g) ∨
    ∃ a b : Fin r, (b : ℕ) = (a : ℕ) + 1 ∧ g' = b4_braid a b g

example {r : ℕ} (g : Fin r → G) : b4_HurwitzMove g g :=
  Or.inl ⟨1, by funext i; simp [b4_conjTuple]⟩

/-- **The Hurwitz component relation**: the equivalence relation generated by Hurwitz moves; its
classes inside a Nielsen class are the components of the Hurwitz space (`S = Hur°` in G32).
Source: Völklein, *Groups as Galois Groups*, Ch. 10; G32 v0.16, Subsection 3.1. -/
def b4_SameComponent {r : ℕ} (g g' : Fin r → G) : Prop :=
  Relation.EqvGen b4_HurwitzMove g g'

example {r : ℕ} (g : Fin r → G) : b4_SameComponent g g := Relation.EqvGen.refl g

/-- **The classes of a tuple**: the multiset of conjugacy classes of its entries.
Source: Fried–Völklein, Math. Ann. 290 (1991), §1 (the class vector of a Nielsen class). -/
def b4_classes {r : ℕ} (g : Fin r → G) : Multiset (ConjClasses G) :=
  ((List.ofFn g).map ConjClasses.mk : Multiset (ConjClasses G))

example : b4_classes (fun _ : Fin 0 ↦ (1 : G)) = 0 := rfl

end Tuples

/-- **The cyclic triple tuple** `(σ, σ, σ)` in `μ₃ = Multiplicative (ZMod 3)`, `σ` a generator:
the branch data of `y³ = x(x - 1)` over `0, 1, ∞`.
Source: Forster, *Lectures on Riemann Surfaces*, GTM 81, §8 (cyclic covers of `ℙ¹`). -/
def b4_cyc3 : Fin 3 → Multiplicative (ZMod 3) :=
  fun _ ↦ Multiplicative.ofAdd 1

example : (List.ofFn b4_cyc3).prod = 1 := by decide

/-- `(σ, σ)` has product `σ² ≠ 1`: excluded by the Nielsen condition. -/
example : ¬ b4_Nielsen (fun _ : Fin 2 ↦ Multiplicative.ofAdd (1 : ZMod 3)) :=
  fun h ↦ absurd h.1 (by decide)

/-! ## Branched covers -/

section Covers

variable (E : Type) [NormedAddCommGroup E] [NormedSpace ℂ E]
variable {C : Type} [TopologicalSpace C] [ChartedSpace E C]
variable (E' : Type) [NormedAddCommGroup E'] [NormedSpace ℂ E']
variable {Y : Type} [TopologicalSpace Y] [ChartedSpace E' Y]

/-- **The ramification index** (local degree) of `f : C → Y` at `x`: the least `n ≥ 1` such that
the `n`-th derivative of `f` written in the charts at `x` and `f x` is nonzero at `x`. In local
coordinates with `f = z^e`, it is `e`. It is `0` when every derivative vanishes (`f` locally
constant).
Source: Forster, *Lectures on Riemann Surfaces*, GTM 81, §2.1 and Theorem 2.1 (local normal form
`z ↦ z^k`; the multiplicity `v(f, x)`); Mathlib `writtenInExtChartAt`, `iteratedFDeriv`. -/
def b4_ramIndex (f : C → Y) (x : C) : ℕ :=
  sInf {n : ℕ | 1 ≤ n ∧ iteratedFDeriv ℂ n (writtenInExtChartAt 𝓘(ℂ, E) 𝓘(ℂ, E') x f)
    (extChartAt 𝓘(ℂ, E) x x) ≠ 0}

example (f : C → Y) (x : C) (h : iteratedFDeriv ℂ 1 (writtenInExtChartAt 𝓘(ℂ, E) 𝓘(ℂ, E') x f)
    (extChartAt 𝓘(ℂ, E) x x) ≠ 0) : b4_ramIndex E E' f x = 1 :=
  le_antisymm (Nat.sInf_le ⟨le_rfl, h⟩) (le_csInf ⟨1, le_rfl, h⟩ fun _ hn ↦ hn.1)

/-- **The fibre degree** of `f` over `y`: the number of preimages counted with ramification
index. For a non-constant holomorphic map of compact connected surfaces it is the degree of `f`.
Source: Forster, *Lectures on Riemann Surfaces*, §4.23–4.24 (the degree of a proper holomorphic
map). -/
def b4_fiberDegree (f : C → Y) (y : Y) : ℕ :=
  ∑ᶠ x ∈ f ⁻¹' {y}, b4_ramIndex E E' f x

example (f : C → Y) (y : Y) (h : f ⁻¹' {y} = ∅) : b4_fiberDegree E E' f y = 0 := by
  simp [b4_fiberDegree, h]

/-- **The branch set** of `f`: the images of the ramification points (`e_x ≥ 2`).
Source: Forster, *Lectures on Riemann Surfaces*, §4.23 (branch points). -/
def b4_branchSet (f : C → Y) : Set Y :=
  f '' {x | 2 ≤ b4_ramIndex E E' f x}

example (f : C → Y) (h : ∀ x, b4_ramIndex E E' f x ≤ 1) : b4_branchSet E E' f = ∅ := by
  refine Set.eq_empty_of_forall_notMem fun y ⟨x, hx, _⟩ ↦ ?_
  have := h x
  change 2 ≤ _ at hx
  omega

/-- **The restriction of `f` over the complement of the branch set**,
`C ∖ f⁻¹(B) → Y ∖ B`.
Source: Forster, *Lectures on Riemann Surfaces*, §4.22–4.23 (an unbranched proper map is a
covering). -/
def b4_restrict (f : C → Y) :
    {x : C // f x ∉ b4_branchSet E E' f} → {y : Y // y ∉ b4_branchSet E E' f} :=
  fun x ↦ ⟨f x.1, x.2⟩

example (f : C → Y) (x : {x : C // f x ∉ b4_branchSet E E' f}) :
    (b4_restrict E E' f x : Y) = f x := rfl

/-- **The monodromy** of `f` at a regular value `y₀`: the action of `π₁(Y ∖ B, y₀)` on the fibre,
Mathlib's `IsCoveringMap.monodromyPerm` of the restriction when it is a covering map (and the
trivial action otherwise).
Source: Forster, *Lectures on Riemann Surfaces*, §4 (covering spaces and the action of the
fundamental group on fibres); Mathlib `IsCoveringMap.monodromyPerm`. -/
def b4_monodromy (f : C → Y) (y₀ : {y : Y // y ∉ b4_branchSet E E' f}) :
    FundamentalGroup {y : Y // y ∉ b4_branchSet E E' f} y₀ →*
      Equiv.Perm (b4_restrict E E' f ⁻¹' {y₀}) :=
  haveI := Classical.propDecidable (IsCoveringMap (b4_restrict E E' f))
  if h : IsCoveringMap (b4_restrict E E' f) then h.monodromyPerm y₀ else 1

example (f : C → Y) (y₀ : {y : Y // y ∉ b4_branchSet E E' f}) :
    b4_monodromy E E' f y₀ 1 = 1 := map_one _

end Covers

/-! ## Group actions on a surface -/

section Actions

variable (E : Type) [NormedAddCommGroup E] [NormedSpace ℂ E]
variable {C : Type} [TopologicalSpace C] [ChartedSpace E C]
variable (G : Type*) [Group G] [MulAction G C]

/-- **A Galois cover with group `G`**: `f` is constant on `G`-orbits and its fibres are exactly
the orbits.
Source: Forster, *Lectures on Riemann Surfaces*, §5 (Galois coverings, the deck group acting
transitively on fibres); Miranda, *Algebraic Curves and Riemann Surfaces*, Ch. III.3 (quotients by
finite groups). -/
def b4_IsGaloisCover {Y : Type*} (f : C → Y) : Prop :=
  (∀ (g : G) (x : C), f (g • x) = f x) ∧ ∀ x x' : C, f x = f x' → ∃ g : G, g • x = x'

example : b4_IsGaloisCover G (fun _ : C ↦ ()) ↔ ∀ x x' : C, ∃ g : G, g • x = x' :=
  ⟨fun h x x' ↦ h.2 x x' rfl, fun h ↦ ⟨fun _ _ ↦ rfl, fun x x' _ ↦ h x x'⟩⟩

variable {G}

/-- **The rotation generator at `x`**: an element `h` fixing `x`, whose order is the order of
the stabilizer of `x` (so it generates the cyclic stabilizer), and whose derivative at `x` is
multiplication by `e^{2πi/n}`, `n = ord h`. Its conjugacy class is the local monodromy at `f x`
of the quotient map, for a positively oriented loop.
Source: Miranda, *Algebraic Curves and Riemann Surfaces*, Ch. III, Proposition 3.1 (stabilizers
are cyclic, acting faithfully on the tangent line); Frediani–Ghigi–Penegini, *Shimura varieties
in the Torelli locus via Galois coverings*, IMRN 2015, §2 (the local monodromies). -/
def b4_IsRotGen (x : C) (h : G) : Prop :=
  h • x = x ∧ orderOf h = Nat.card (MulAction.stabilizer G x) ∧
    ∀ v : E, mfderiv 𝓘(ℂ, E) 𝓘(ℂ, E) (fun z : C ↦ h • z) x v =
      Complex.exp (2 * Real.pi * Complex.I / (orderOf h : ℂ)) • v

example (x : C) (h : G) (hh : b4_IsRotGen E x h) : h ∈ MulAction.stabilizer G x := hh.1

variable [IsManifold 𝓘(ℂ, E) ω C]

/-- **The action on functions on the tangent bundle**, `g ↦ (g⁻¹)^*`, B3's pullback along
`x ↦ g⁻¹ • x`. On holomorphic forms it is the (left) action of `G` on `Ω¹(C)`.
Source: Forster, *Lectures on Riemann Surfaces*, §9 (pullback of forms); Frediani–Ghigi–Penegini,
IMRN 2015, §2 (the representation of `G` on `H⁰(C, K_C)`). -/
def b4_formAct (g : G) :
    (TangentBundle 𝓘(ℂ, E) C → ℂ) →ₗ[ℂ] (TangentBundle 𝓘(ℂ, E) C → ℂ) :=
  b3_pullback E E (fun x : C ↦ g⁻¹ • x)

example (g : G) : b4_formAct E g (0 : TangentBundle 𝓘(ℂ, E) C → ℂ) = 0 := map_zero _

variable (G C)

/-- **The `G`-invariant holomorphic forms**, `Ω¹(C)^G`; its dimension is the genus of the
quotient `C ⧸ G`.
Source: Farkas–Kra, *Riemann Surfaces*, 2nd ed., GTM 71, Ch. V.2 (invariant differentials and the
quotient surface). -/
def b4_invariantForms : Submodule ℂ (TangentBundle 𝓘(ℂ, E) C → ℂ) :=
  b3_HolForm E C ⊓ ⨅ g : G, LinearMap.ker (b4_formAct E g - LinearMap.id)

example : (0 : TangentBundle 𝓘(ℂ, E) C → ℂ) ∈ b4_invariantForms E C G :=
  (b4_invariantForms E C G).zero_mem

end Actions

/-! ## Equivariant maps and ages -/

section Equivariant

variable {G : Type*} [Group G]
variable {V M : Type*} [AddCommGroup V] [Module ℂ V] [AddCommGroup M] [Module ℂ M]

/-- **The `G`-maps from a representation into a subspace**: linear `φ : V → M` with values in
`W` and `φ (ρ g v) = act g (φ v)`. For `ρ` irreducible and `act` a representation preserving `W`,
its dimension is the multiplicity of `ρ` in `W`.
Source: Serre, *Linear Representations of Finite Groups*, GTM 42, §2.3 and §2.6 (multiplicities
as dimensions of `Hom_G`); Mathlib `Representation.IntertwiningMap`. -/
def b4_HomG (ρ : Representation ℂ G V) (act : G → M →ₗ[ℂ] M) (W : Submodule ℂ M) :
    Submodule ℂ (V →ₗ[ℂ] M) where
  carrier := {φ | (∀ v, φ v ∈ W) ∧ ∀ (g : G) (v : V), φ (ρ g v) = act g (φ v)}
  add_mem' := by
    rintro φ ψ ⟨hφ, hφ'⟩ ⟨hψ, hψ'⟩
    exact ⟨fun v ↦ W.add_mem (hφ v) (hψ v), fun g v ↦ by simp [hφ', hψ']⟩
  zero_mem' := ⟨fun _ ↦ W.zero_mem, fun _ _ ↦ by simp⟩
  smul_mem' := by
    rintro c φ ⟨hφ, hφ'⟩
    exact ⟨fun v ↦ W.smul_mem c (hφ v), fun g v ↦ by simp [hφ']⟩

example (ρ : Representation ℂ G V) (act : G → M →ₗ[ℂ] M) :
    (0 : V →ₗ[ℂ] M) ∈ b4_HomG ρ act ⊥ := (b4_HomG ρ act ⊥).zero_mem

/-- **The age** of a linear map of a finite-dimensional complex space: `Σ_k α_k` over its
eigenvalues `e^{2πiα_k}`, `0 ≤ α_k < 1`, with multiplicity (G32's `g32h_angle` of the roots of
the characteristic polynomial).
Source: G32 v0.16, Subsection 3.1 (`age`); Frediani–Ghigi–Penegini, IMRN 2015, §2. -/
def b4_age [FiniteDimensional ℂ V] (T : V →ₗ[ℂ] V) : ℝ :=
  (T.charpoly.roots.map g32h_angle).sum

example [FiniteDimensional ℂ V] (T : V →ₗ[ℂ] V) :
    b4_age T = (T.charpoly.roots.map g32h_angle).sum := rfl

end Equivariant

/-! ## The action on the period lattice and the Prym factors -/

section Lattice

variable (E : Type) [NormedAddCommGroup E] [NormedSpace ℂ E]
variable {C : Type} [TopologicalSpace C] [ChartedSpace E C] [IsManifold 𝓘(ℂ, E) ω C]
variable {G : Type*} [Group G] [MulAction G C]

/-- **The action of `g` on the period lattice** `Λ_C`: the pushforward of `x ↦ g • x` (B3's
`b3_IsPushforward`), chosen when one exists (B3's `b3_exists_pushforward` and
`b3_pushforward_unique`: for a holomorphic action it exists and is unique), and `0` otherwise.
Source: Birkenhake–Lange, *Complex Abelian Varieties*, 2nd ed., Grundlehren 302, §11.4 and §12.1
(the action of automorphisms of `C` on `J(C)`). -/
def b4_latticeAct (g : G) : b3_periodLattice E C →+ b3_periodLattice E C :=
  haveI := Classical.propDecidable (∃ φ, b3_IsPushforward E E (fun x : C ↦ g • x) φ)
  if h : ∃ φ, b3_IsPushforward E E (fun x : C ↦ g • x) φ then h.choose else 0

example (g : G) (h : ¬ ∃ φ, b3_IsPushforward E E (fun x : C ↦ g • x) φ) :
    b4_latticeAct E (C := C) g = 0 := by
  simp only [b4_latticeAct, h, dite_false]

/-- **The complexified action** `g_* ⊗ ℂ` on `ℂ ⊗ Λ_C ≅ H₁(C, ℂ)`.
Source: Birkenhake–Lange, §1.2 (rational and analytic representations). -/
def b4_cplxAct (g : G) : (ℂ ⊗[ℤ] b3_periodLattice E C) →ₗ[ℂ] (ℂ ⊗[ℤ] b3_periodLattice E C) :=
  b2_cplxMap (b4_latticeAct E g)

example (g : G) (c : ℂ) (l : b3_periodLattice E C) :
    b4_cplxAct E g (c ⊗ₜ[ℤ] l) = c ⊗ₜ[ℤ] b4_latticeAct E g l := rfl

variable [Fintype G]

/-- **The endomorphism of an element `a = Σ a_g g` of `ℤ[G]`**, `Σ a_g g_*` on `Λ_C`.
Source: Birkenhake–Lange, §12.1 (the group algebra acting on `J(C)`) and §12.2 (Prym–Tyurin
varieties as images of `ℚ[G]`-idempotents). -/
def b4_groupEnd (a : G → ℤ) : b3_periodLattice E C →+ b3_periodLattice E C :=
  ∑ g, a g • b4_latticeAct E g

example : b4_groupEnd E (C := C) (G := G) 0 = 0 := by
  simp [b4_groupEnd]

/-- **The filtration of the factor `A_a(C)`**, B2's preimage filtration on the image lattice
`a(Λ_C)`.
Source: Birkenhake–Lange, §5.3 and §12.2. -/
def b4_prymF (a : G → ℤ) : Submodule ℂ (ℂ ⊗[ℤ] (b4_groupEnd E (C := C) a).range) :=
  b2_imageF (b3_periodF E C) (b4_groupEnd E a)

/-- **The factor `A_a(C)`**, B2's image torus of `b4_groupEnd a`; for `a = N e` with `e` an
idempotent of `ℚ[G]` attached to `ρ` it is the Prym–Tyurin factor `A_ρ(C)` of G32.
Source: Birkenhake–Lange, §12.2 (Prym–Tyurin varieties); G32 v0.16, Subsection 3.2
(`A_ρ(C) = im(N₀ e)`). -/
abbrev b4_Prym (a : G → ℤ) : Type :=
  b2_torus (b4_groupEnd E (C := C) a).range (b4_prymF E a)

/-- **The restricted form** on the image lattice `a(Λ_C)`.
Source: Birkenhake–Lange, §5.3 (the induced polarization). -/
def b4_prymQ (Q : LinearMap.BilinForm ℤ (b3_periodLattice E C)) (a : G → ℤ) :
    LinearMap.BilinForm ℤ (b4_groupEnd E (C := C) a).range :=
  b2_imageQ Q (b4_groupEnd E a)

example (a : G → ℤ) : (b2_subTorus (b3_periodF E C) (b4_groupEnd E a) 0 : b3_Jacobian E C) = 0 :=
  map_zero _

end Lattice

/-! ## The explicit instance: `μ₄` acting on `ℂ ⧸ (ℤ + iℤ)` -/

section Elliptic

/-- The class of `i ⊗ x` is the class of the lattice vector `J x = (-x₁, x₀)` in
`(ℂ ⊗ ℤ²) ⧸ F`: multiplication by `i` preserves the lattice `ℤ + iℤ`.
Source: Birkenhake–Lange, §1.1 (`ℂ ⧸ (ℤ + iℤ)` has complex multiplication by `ℤ[i]`). -/
theorem b4_I_smul_latticeMap (x : Fin 2 → ℤ) :
    Complex.I • b2_latticeMap (Fin 2 → ℤ) b2_stdF x =
      b2_latticeMap (Fin 2 → ℤ) b2_stdF ![-x 1, x 0] := by
  have key : ∀ v : Fin 2 → ℤ, (1 : ℂ) ⊗ₜ[ℤ] v =
      (v 0 : ℂ) • ((1 : ℂ) ⊗ₜ[ℤ] (Pi.single 0 1 : Fin 2 → ℤ)) +
        (v 1 : ℂ) • ((1 : ℂ) ⊗ₜ[ℤ] (Pi.single 1 1 : Fin 2 → ℤ)) := by
    intro v
    conv_lhs => rw [show v = v 0 • (Pi.single 0 1 : Fin 2 → ℤ) + v 1 • (Pi.single 1 1 : Fin 2 → ℤ) by
      ext i; fin_cases i <;> simp]
    rw [TensorProduct.tmul_add, TensorProduct.tmul_smul, TensorProduct.tmul_smul,
      Int.cast_smul_eq_zsmul, Int.cast_smul_eq_zsmul]
  have hw : (1 : ℂ) ⊗ₜ[ℤ] (Pi.single 0 1 : Fin 2 → ℤ) + Complex.I ⊗ₜ[ℤ] (Pi.single 1 1 : Fin 2 → ℤ) =
      (1 : ℂ) ⊗ₜ[ℤ] (Pi.single 0 1 : Fin 2 → ℤ) +
        Complex.I • ((1 : ℂ) ⊗ₜ[ℤ] (Pi.single 1 1 : Fin 2 → ℤ)) := by
    rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
  show Complex.I • Submodule.Quotient.mk ((1 : ℂ) ⊗ₜ[ℤ] x) =
    Submodule.Quotient.mk ((1 : ℂ) ⊗ₜ[ℤ] (![-x 1, x 0] : Fin 2 → ℤ))
  rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.eq, key x, key ![-x 1, x 0]]
  refine Submodule.mem_span_singleton.2 ⟨(x 0 : ℂ) * Complex.I + x 1, ?_⟩
  rw [hw]
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Int.cast_neg]
  match_scalars
  · ring
  · linear_combination (x 0 : ℂ) * Complex.I_mul_I

/-- Multiplication by `iᵏ` preserves the lattice of `ℂ ⧸ (ℤ + iℤ)`.
Source: Birkenhake–Lange, §1.1. -/
theorem b4_I_pow_smul_mem (k : ℕ) (q : (ℂ ⊗[ℤ] (Fin 2 → ℤ)) ⧸ b2_stdF)
    (hq : q ∈ (b2_latticeMap (Fin 2 → ℤ) b2_stdF).range) :
    Complex.I ^ k • q ∈ (b2_latticeMap (Fin 2 → ℤ) b2_stdF).range := by
  induction k with
  | zero => simpa using hq
  | succ k ih =>
    obtain ⟨x, hx⟩ := ih
    rw [pow_succ', mul_smul, ← hx, b4_I_smul_latticeMap]
    exact ⟨_, rfl⟩

/-- **Multiplication by `iᵏ`** on the elliptic curve `ℂ ⧸ (ℤ + iℤ)`.
Source: Birkenhake–Lange, §1.1 (complex multiplication by `ℤ[i]`). -/
def b4_ellipticScale (k : ℕ) : b3_Elliptic →+ b3_Elliptic :=
  QuotientAddGroup.map _ _
    (Complex.I ^ k • (LinearMap.id : (ℂ ⊗[ℤ] (Fin 2 → ℤ)) ⧸ b2_stdF →ₗ[ℂ] _)).toAddMonoidHom
    (fun q hq ↦ b4_I_pow_smul_mem k q hq)

example (k : ℕ) : b4_ellipticScale k 0 = 0 := map_zero _

theorem b4_I_pow_mod (n : ℕ) : Complex.I ^ n = Complex.I ^ (n % 4) :=
  pow_eq_pow_mod n Complex.I_pow_four

/-- **The action of `μ₄ = Multiplicative (ZMod 4)` on `ℂ ⧸ (ℤ + iℤ)`**, the generator acting by
`z ↦ i z`. It fixes `0` and `(1 + i) / 2`, and its square `z ↦ -z` also fixes `1 / 2` and `i / 2`;
the quotient is `ℙ¹` with branching `(4, 4, 2)`.
Source: Birkenhake–Lange, §1.1; Miranda, *Algebraic Curves and Riemann Surfaces*, Ch. III.3
(the quotient of an elliptic curve by its automorphism group). -/
instance b4_ellipticAction : MulAction (Multiplicative (ZMod 4)) b3_Elliptic where
  smul g x := b4_ellipticScale (Multiplicative.toAdd g).val x
  one_smul x := by
    induction x using QuotientAddGroup.induction_on with
    | H q =>
      change QuotientAddGroup.mk (Complex.I ^ (0 : ZMod 4).val • q) = QuotientAddGroup.mk q
      simp
  mul_smul g h x := by
    induction x using QuotientAddGroup.induction_on with
    | H q =>
      change QuotientAddGroup.mk (Complex.I ^ (Multiplicative.toAdd g + Multiplicative.toAdd h).val • q) =
        QuotientAddGroup.mk (Complex.I ^ (Multiplicative.toAdd g).val •
          Complex.I ^ (Multiplicative.toAdd h).val • q)
      rw [smul_smul, ← pow_add, ZMod.val_add, ← b4_I_pow_mod]

example (x : b3_Elliptic) : (Multiplicative.ofAdd (2 : ZMod 4)) • x = -x := by
  induction x using QuotientAddGroup.induction_on with
  | H q =>
    change QuotientAddGroup.mk (Complex.I ^ (2 : ZMod 4).val • q) = -QuotientAddGroup.mk q
    rw [show (2 : ZMod 4).val = 2 from rfl, Complex.I_sq, neg_one_smul]
    rfl

/-- **The characters of `μ₄`**, `g ↦ i^{a k}` for `g = σᵏ`, as representations on `ℂ`.
Source: Serre, *Linear Representations of Finite Groups*, GTM 42, §3.1 (abelian groups). -/
def b4_char4 (a : ℕ) : Representation ℂ (Multiplicative (ZMod 4)) ℂ where
  toFun g := (Complex.I ^ (a * (Multiplicative.toAdd g).val)) • LinearMap.id
  map_one' := by
    simp only [toAdd_one, ZMod.val_zero, mul_zero, pow_zero, one_smul]
    rfl
  map_mul' g h := by
    ext
    simp only [toAdd_mul, LinearMap.smul_apply, LinearMap.id_apply, smul_eq_mul, mul_one,
      Module.End.mul_apply]
    rw [b4_I_pow_mod (a * _), ZMod.val_add, Nat.mul_mod, Nat.mod_mod, ← Nat.mul_mod,
      ← b4_I_pow_mod, ← pow_add, ← mul_add]

example (a : ℕ) (v : ℂ) : b4_char4 a 1 v = v := by simp

end Elliptic

