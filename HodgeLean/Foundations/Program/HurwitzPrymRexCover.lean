import Mathlib.Topology.Homotopy.Lifting
import Mathlib.Topology.Covering.Quotient
import Mathlib.Topology.Subpath
import Mathlib.AlgebraicTopology.FundamentalGroupoid.FundamentalGroup

set_option maxHeartbeats 400000

/-! # Track B4, lane `b4-rex`: the covering space of a homomorphism `π₁ → Gᵐᵒᵖ`

For a path-connected space `X` in which every point has small *good* neighborhoods (open,
path-connected, and any two paths in them with the same endpoints are homotopic in `X`), and a
surjective `φ : π₁(X, x₀) →* Gᵐᵒᵖ`, we build a connected Galois `G`-covering `U → X` whose
monodromy at a base point is `φ`. The fibre over `x` consists of the functions `s` on homotopy
classes of paths `x₀ → x` with `s (ℓ c) = ψ(ℓ) s(c)` (`ψ = unop ∘ φ`), on which `G` acts on the
right; a path class `γ : x → y` transports `s` to `c ↦ s (c γ⁻¹)`. The topology is generated by the
sheets over good neighborhoods.
HC no distance; AV milestone no distance.
-/

noncomputable section

open Topology unitInterval

namespace HodgeLean.Foundations.Program

local notation "PQ" => Path.Homotopic.Quotient

namespace HurwitzPrymRexCover

open Path.Homotopic.Quotient

variable {X : Type} [TopologicalSpace X] {x₀ : X} {G : Type} [Group G]

/-! ## Fibres and transport -/

section Fibre

variable (φ : FundamentalGroup X x₀ →* Gᵐᵒᵖ)

/-- **The monodromy of a loop class**, `ψ ℓ = unop (φ ℓ)`; `ψ (ℓ ℓ') = ψ ℓ ψ ℓ'`.
Source: Hatcher, *Algebraic Topology*, §1.3 (the classification of covering spaces). -/
def psi (c : PQ x₀ x₀) : G := (φ (FundamentalGroup.fromPath c)).unop

example : psi φ (refl x₀) = 1 := by
  simp only [psi]
  exact congrArg MulOpposite.unop (map_one φ)

theorem psi_trans (c d : PQ x₀ x₀) : psi φ (c.trans d) = psi φ c * psi φ d := by
  have h : FundamentalGroup.fromPath (c.trans d) =
      FundamentalGroup.fromPath d * FundamentalGroup.fromPath c := rfl
  simp only [psi, h, map_mul, MulOpposite.unop_mul]

theorem psi_refl : psi φ (refl x₀) = 1 := by
  simp only [psi]
  exact congrArg MulOpposite.unop (map_one φ)

theorem psi_symm (c : PQ x₀ x₀) : psi φ c.symm = (psi φ c)⁻¹ := by
  have h := psi_trans φ c c.symm
  rw [trans_symm, psi_refl] at h
  exact (eq_inv_of_mul_eq_one_right h.symm)

/-- **The fibre over `x`**: functions `s` on path classes `x₀ → x` with `s (ℓ c) = ψ ℓ · s c`.
Source: Hatcher, *Algebraic Topology*, §1.3 (the construction of covering spaces). -/
structure Fib (x : X) : Type where
  /-- The function on path classes. -/
  val : PQ x₀ x → G
  prop : ∀ ℓ c, val (ℓ.trans c) = psi φ ℓ * val c

example : Fib φ x₀ := ⟨psi φ, fun ℓ c ↦ psi_trans φ ℓ c⟩

variable {φ}

theorem Fib.ext {x : X} {s s' : Fib φ x} (h : ∀ c, s.1 c = s'.1 c) : s = s' := by
  obtain ⟨f, hf⟩ := s
  obtain ⟨f', hf'⟩ := s'
  have : f = f' := funext h
  subst this
  rfl

theorem symm_trans_distrib {a b c : X} (γ : PQ a b) (δ : PQ b c) :
    (γ.trans δ).symm = δ.symm.trans γ.symm := by
  induction γ using Path.Homotopic.Quotient.ind with | mk γ =>
  induction δ using Path.Homotopic.Quotient.ind with | mk δ =>
  rw [← mk_trans, ← mk_symm, ← mk_symm, ← mk_symm, ← mk_trans, Path.trans_symm]

theorem symm_refl' (a : X) : (refl a).symm = refl a := by
  rw [← mk_refl, ← mk_symm, Path.refl_symm]

variable (φ) in
/-- **Transport** along a path class `γ : x → y`: `s ↦ (c ↦ s (c γ⁻¹))`.
Source: Hatcher, *Algebraic Topology*, §1.3. -/
def tr {x y : X} (γ : PQ x y) (s : Fib φ x) : Fib φ y :=
  ⟨fun c ↦ s.1 (c.trans γ.symm), fun ℓ c ↦ by rw [trans_assoc, s.2]⟩

example {x : X} (s : Fib φ x) : tr φ (refl x) s = s := by
  apply Fib.ext
  intro c
  simp [tr, symm_refl']

@[simp] theorem tr_refl {x : X} (s : Fib φ x) : tr φ (refl x) s = s :=
  Fib.ext fun c ↦ by simp [tr, symm_refl']

theorem tr_trans {x y z : X} (γ : PQ x y) (δ : PQ y z) (s : Fib φ x) :
    tr φ (γ.trans δ) s = tr φ δ (tr φ γ s) :=
  Fib.ext fun c ↦ by simp only [tr, symm_trans_distrib, trans_assoc]

instance {x : X} : MulAction G (Fib φ x) where
  smul g s := ⟨fun c ↦ s.1 c * g⁻¹, fun ℓ c ↦ by rw [s.2, mul_assoc]⟩
  one_smul s := Fib.ext fun c ↦ by change s.1 c * 1⁻¹ = s.1 c; simp
  mul_smul g h s := Fib.ext fun c ↦ by
    change s.1 c * (g * h)⁻¹ = s.1 c * h⁻¹ * g⁻¹
    rw [mul_inv_rev, mul_assoc]

theorem smul_apply {x : X} (g : G) (s : Fib φ x) (c : PQ x₀ x) : (g • s).1 c = s.1 c * g⁻¹ := rfl

theorem tr_smul {x y : X} (γ : PQ x y) (g : G) (s : Fib φ x) : tr φ γ (g • s) = g • tr φ γ s := rfl

theorem fib_apply {x : X} (s : Fib φ x) (c d : PQ x₀ x) :
    s.1 d = psi φ (d.trans c.symm) * s.1 c := by
  rw [← s.2, trans_assoc, symm_trans, trans_refl]

theorem fib_eq_of {x : X} {s s' : Fib φ x} (c : PQ x₀ x) (h : s.1 c = s'.1 c) : s = s' :=
  Fib.ext fun d ↦ by rw [fib_apply s c d, fib_apply s' c d, h]

theorem fib_exists_smul {x : X} (c : PQ x₀ x) (s s' : Fib φ x) : ∃ g : G, g • s' = s :=
  ⟨(s.1 c)⁻¹ * s'.1 c, fib_eq_of c (by rw [smul_apply]; simp [mul_inv_rev, mul_assoc])⟩

theorem fib_free {x : X} (c : PQ x₀ x) {g : G} {s : Fib φ x} (h : g • s = s) : g = 1 := by
  have := congrArg (fun t : Fib φ x ↦ t.1 c) h
  simp only [smul_apply] at this
  simpa using this

variable (φ) in
/-- The base fibre element `ψ` over `x₀`.
Source: Hatcher, *Algebraic Topology*, §1.3 (the base point of the covering). -/
def s₀ : Fib φ x₀ := ⟨psi φ, fun ℓ c ↦ psi_trans φ ℓ c⟩

example : (s₀ φ).val = psi φ := rfl

theorem tr_s₀ (ℓ : PQ x₀ x₀) : tr φ ℓ (s₀ φ) = psi φ ℓ • s₀ φ :=
  Fib.ext fun c ↦ by
    rw [smul_apply]
    simp only [tr, s₀, psi_trans, psi_symm]

end Fibre

/-! ## Good neighborhoods -/

section Good

/-- **A good set**: open, path-connected, and any two paths in it with the same endpoints are
homotopic (in `X`).
Source: Hatcher, *Algebraic Topology*, §1.3 (semilocally simply connected, locally path-connected
spaces). -/
def Good (V : Set X) : Prop :=
  IsOpen V ∧ IsPathConnected V ∧
    ∀ ⦃x y : X⦄ (γ γ' : Path x y), (∀ t, γ t ∈ V) → (∀ t, γ' t ∈ V) → γ.Homotopic γ'

example (V : Set X) (h : Good V) : IsOpen V := h.1

variable {V W : Set X} (hV : Good V)

/-- The class of any path inside a good set.
Source: Hatcher, *Algebraic Topology*, §1.3 (paths in a simply connected neighborhood). -/
def pathIn {x y : X} (hx : x ∈ V) (hy : y ∈ V) : PQ x y :=
  mk (hV.2.1.joinedIn x hx y hy).somePath

theorem mk_eq_pathIn {x y : X} (hx : x ∈ V) (hy : y ∈ V) (γ : Path x y) (hγ : ∀ t, γ t ∈ V) :
    mk γ = pathIn hV hx hy :=
  Path.Homotopic.Quotient.eq.2 (hV.2.2 _ _ hγ (JoinedIn.somePath_mem _))

theorem pathIn_spec {x y : X} (hx : x ∈ V) (hy : y ∈ V) :
    ∃ γ : Path x y, (∀ t, γ t ∈ V) ∧ mk γ = pathIn hV hx hy :=
  ⟨_, JoinedIn.somePath_mem _, rfl⟩

theorem pathIn_trans {x y z : X} (hx : x ∈ V) (hy : y ∈ V) (hz : z ∈ V) :
    (pathIn hV hx hy).trans (pathIn hV hy hz) = pathIn hV hx hz := by
  obtain ⟨γ, hγ, h1⟩ := pathIn_spec hV hx hy
  obtain ⟨δ, hδ, h2⟩ := pathIn_spec hV hy hz
  rw [← h1, ← h2, ← mk_trans]
  apply mk_eq_pathIn
  intro t
  have : (γ.trans δ) t ∈ Set.range (γ.trans δ) := ⟨t, rfl⟩
  rw [Path.trans_range] at this
  rcases this with ⟨s, hs⟩ | ⟨s, hs⟩
  · rw [← hs]; exact hγ s
  · rw [← hs]; exact hδ s

theorem pathIn_refl {x : X} (hx : x ∈ V) : pathIn hV hx hx = refl x := by
  rw [← mk_eq_pathIn hV hx hx (Path.refl x) (fun _ ↦ hx), mk_refl]

example {x : X} (hx : x ∈ V) : pathIn hV hx hx = refl x := pathIn_refl hV hx

theorem pathIn_mono (hW : Good W) (hWV : W ⊆ V) {x y : X} (hx : x ∈ W) (hy : y ∈ W) :
    pathIn hW hx hy = pathIn hV (hWV hx) (hWV hy) := by
  obtain ⟨γ, hγ, h⟩ := pathIn_spec hW hx hy
  rw [← h]
  exact mk_eq_pathIn hV _ _ γ fun t ↦ hWV (hγ t)

end Good

/-! ## The covering space -/

section Space

variable (φ : FundamentalGroup X x₀ →* Gᵐᵒᵖ)

/-- **The covering space**: pairs of a point `x` and a fibre element over it.
Source: Hatcher, *Algebraic Topology*, §1.3. -/
def Cov : Type := Σ x : X, Fib φ x

example (s : Fib φ x₀) : Cov φ := ⟨x₀, s⟩

variable {φ}

/-- The projection `U → X`.
Source: Hatcher, *Algebraic Topology*, §1.3. -/
def proj (u : Cov φ) : X := u.1

instance : MulAction G (Cov φ) where
  smul g u := ⟨u.1, g • u.2⟩
  one_smul u := by
    obtain ⟨x, s⟩ := u
    change (⟨x, (1 : G) • s⟩ : Cov φ) = ⟨x, s⟩
    rw [one_smul]
  mul_smul g h u := by
    obtain ⟨x, s⟩ := u
    change (⟨x, (g * h) • s⟩ : Cov φ) = ⟨x, g • h • s⟩
    rw [mul_smul]

/-- A point of the covering space.
Source: Hatcher, *Algebraic Topology*, §1.3. -/
def Cov.mk (x : X) (s : Fib φ x) : Cov φ := ⟨x, s⟩

example (x : X) (s : Fib φ x) : proj (Cov.mk x s) = x := rfl

theorem smul_mk (g : G) (x : X) (s : Fib φ x) : g • Cov.mk x s = Cov.mk x (g • s) := rfl

/-- **The sheet** over a good `V` through `u`: the transports of `u` along paths in `V`.
Source: Hatcher, *Algebraic Topology*, §1.3. -/
def sheet {V : Set X} (hV : Good V) (u : Cov φ) (hu : u.1 ∈ V) : Set (Cov φ) :=
  {v | ∃ hv : v.1 ∈ V, v.2 = tr φ (pathIn hV hu hv) u.2}

theorem mem_sheet_self {V : Set X} (hV : Good V) (u : Cov φ) (hu : u.1 ∈ V) :
    u ∈ sheet hV u hu :=
  ⟨hu, by rw [pathIn_refl, tr_refl]⟩

example {V : Set X} (hV : Good V) (u : Cov φ) (hu : u.1 ∈ V) : u ∈ sheet hV u hu :=
  mem_sheet_self hV u hu

theorem sheet_subset {V W : Set X} (hV : Good V) (hW : Good W) (hWV : W ⊆ V) {u v : Cov φ}
    (hu : u.1 ∈ V) (hv : v ∈ sheet hV u hu) (hvW : v.1 ∈ W) :
    sheet hW v hvW ⊆ sheet hV u hu := by
  obtain ⟨hvV, hv2⟩ := hv
  rintro w ⟨hwW, hw2⟩
  refine ⟨hWV hwW, ?_⟩
  rw [hw2, hv2, ← tr_trans, pathIn_mono hV hW hWV, pathIn_trans]

theorem smul_mem_sheet {V : Set X} (hV : Good V) (u : Cov φ) (hu : u.1 ∈ V) (g : G) {v : Cov φ}
    (hv : v ∈ sheet hV u hu) : g • v ∈ sheet hV (g • u) hu := by
  obtain ⟨hvV, hv2⟩ := hv
  exact ⟨hvV, by change g • v.2 = tr φ _ (g • u.2); rw [hv2, tr_smul]⟩

/-- The sheets.
Source: Hatcher, *Algebraic Topology*, §1.3 (the basis of the topology). -/
def sheets : Set (Set (Cov φ)) :=
  {S | ∃ (V : Set X) (hV : Good V) (u : Cov φ) (hu : u.1 ∈ V), S = sheet hV u hu}

example {V : Set X} (hV : Good V) (u : Cov φ) (hu : u.1 ∈ V) : sheet hV u hu ∈ sheets :=
  ⟨V, hV, u, hu, rfl⟩

instance : TopologicalSpace (Cov φ) := TopologicalSpace.generateFrom sheets

variable (hX : ∀ x : X, ∀ N ∈ 𝓝 x, ∃ V, Good V ∧ x ∈ V ∧ V ⊆ N)
include hX

theorem isTopologicalBasis_sheets : TopologicalSpace.IsTopologicalBasis (sheets (φ := φ)) where
  exists_subset_inter := by
    rintro _ ⟨V₁, hV₁, u₁, hu₁, rfl⟩ _ ⟨V₂, hV₂, u₂, hu₂, rfl⟩ v ⟨hv₁, hv₂⟩
    obtain ⟨W, hW, hvW, hWsub⟩ := hX v.1 (V₁ ∩ V₂)
      (Filter.inter_mem (hV₁.1.mem_nhds hv₁.1) (hV₂.1.mem_nhds hv₂.1))
    exact ⟨_, ⟨W, hW, v, hvW, rfl⟩, mem_sheet_self hW v hvW,
      Set.subset_inter (sheet_subset hV₁ hW (hWsub.trans Set.inter_subset_left) hu₁ hv₁ hvW)
        (sheet_subset hV₂ hW (hWsub.trans Set.inter_subset_right) hu₂ hv₂ hvW)⟩
  sUnion_eq := by
    refine Set.eq_univ_of_forall fun u ↦ ?_
    obtain ⟨V, hV, hu, -⟩ := hX u.1 Set.univ Filter.univ_mem
    exact ⟨_, ⟨V, hV, u, hu, rfl⟩, mem_sheet_self hV u hu⟩
  eq_generateFrom := rfl

omit hX in
theorem isOpen_sheet {V : Set X} (hV : Good V) (u : Cov φ) (hu : u.1 ∈ V) :
    IsOpen (sheet hV u hu) :=
  TopologicalSpace.isOpen_generateFrom_of_mem ⟨V, hV, u, hu, rfl⟩

theorem continuous_proj : Continuous (proj (φ := φ)) := by
  rw [continuous_def]
  intro O hO
  rw [(isTopologicalBasis_sheets hX).isOpen_iff]
  intro u hu
  obtain ⟨V, hV, huV, hVO⟩ := hX u.1 O (hO.mem_nhds hu)
  exact ⟨_, ⟨V, hV, u, huV, rfl⟩, mem_sheet_self hV u huV, fun v hv ↦ hVO hv.1⟩

omit hX in
theorem proj_sheet {V : Set X} (hV : Good V) (u : Cov φ) (hu : u.1 ∈ V) :
    proj '' sheet hV u hu = V := by
  apply Set.Subset.antisymm
  · rintro _ ⟨v, hv, rfl⟩
    exact hv.1
  · intro y hy
    exact ⟨⟨y, tr φ (pathIn hV hu hy) u.2⟩, ⟨hy, rfl⟩, rfl⟩

theorem isOpenMap_proj : IsOpenMap (proj (φ := φ)) := by
  rw [(isTopologicalBasis_sheets hX).isOpenMap_iff]
  rintro _ ⟨V, hV, u, hu, rfl⟩
  rw [proj_sheet]
  exact hV.1

end Space

/-! ## The covering map -/

section Covering

variable {φ : FundamentalGroup X x₀ →* Gᵐᵒᵖ}

theorem sheet_congr {V : Set X} (hV : Good V) {u u' : Cov φ} (h : u = u') (hu : u.1 ∈ V)
    (hu' : u'.1 ∈ V) : sheet hV u hu = sheet hV u' hu' := by
  subst h
  rfl

theorem preimage_smul_sheet {V : Set X} (hV : Good V) (u : Cov φ) (hu : u.1 ∈ V) (g : G) :
    (fun v : Cov φ ↦ g • v) ⁻¹' sheet hV u hu = sheet hV (g⁻¹ • u) hu := by
  ext v
  constructor
  · intro hv
    have := smul_mem_sheet hV u hu g⁻¹ hv
    rwa [inv_smul_smul] at this
  · intro hv
    have := smul_mem_sheet hV (g⁻¹ • u) hu g hv
    rwa [sheet_congr hV (smul_inv_smul g u) _ hu] at this

theorem continuous_smul' (g : G) : Continuous (fun v : Cov φ ↦ g • v) := by
  rw [continuous_generateFrom_iff]
  rintro _ ⟨V, hV, u, hu, rfl⟩
  rw [preimage_smul_sheet]
  exact isOpen_sheet hV _ _

variable [PathConnectedSpace X]

theorem proj_surjective : Function.Surjective (proj (φ := φ)) := fun y ↦
  ⟨Cov.mk y (tr φ (mk (PathConnectedSpace.somePath x₀ y)) (s₀ φ)), rfl⟩

variable (hX : ∀ x : X, ∀ N ∈ 𝓝 x, ∃ V, Good V ∧ x ∈ V ∧ V ⊆ N)
include hX

/-- **`U → X` is a Galois `G`-covering.** -/
theorem isQuotientCoveringMap : IsQuotientCoveringMap (proj (φ := φ)) G where
  toIsQuotientMap := (isOpenMap_proj hX).isQuotientMap (continuous_proj hX) proj_surjective
  continuous_const_smul := continuous_smul'
  apply_eq_iff_mem_orbit {e₁ e₂} := by
    obtain ⟨x, s⟩ := e₁
    obtain ⟨x', s'⟩ := e₂
    change x = x' ↔ _
    constructor
    · rintro rfl
      obtain ⟨g, hg⟩ := fib_exists_smul (mk (PathConnectedSpace.somePath x₀ x)) s s'
      exact ⟨g, by change Cov.mk x (g • s') = Cov.mk x s; rw [hg]⟩
    · rintro ⟨g, hg⟩
      exact (congrArg Sigma.fst hg).symm
  disjoint e := by
    obtain ⟨V, hV, he, -⟩ := hX e.1 Set.univ Filter.univ_mem
    refine ⟨sheet hV e he, (isOpen_sheet hV e he).mem_nhds (mem_sheet_self hV e he), ?_⟩
    rintro g ⟨_, ⟨v, hv, rfl⟩, hgv⟩
    obtain ⟨hvV, hv2⟩ := hv
    obtain ⟨hgvV, hgv2⟩ := hgv
    apply fib_free (mk (PathConnectedSpace.somePath x₀ v.1)) (s := v.2)
    change g • v.2 = v.2
    exact hgv2.trans hv2.symm

end Covering

/-! ## Lifting paths -/

section Lift

variable {φ : FundamentalGroup X x₀ →* Gᵐᵒᵖ}

theorem cast_trans_left {a a' b c : X} (h : a' = a) (P : PQ a b) (R : PQ b c) :
    (P.trans R).cast h rfl = (P.cast h rfl).trans R := by
  subst h
  rw [cast_rfl_rfl, cast_rfl_rfl]

/-- The class of `γ` on `[0, t]`, starting at `x`.
Source: Hatcher, *Algebraic Topology*, Proposition 1.30 (path lifting). -/
def initClass {x y : X} (γ : Path x y) (t : I) : PQ x (γ t) :=
  (mk (γ.subpath 0 t)).cast γ.source.symm rfl

theorem initClass_trans {x y : X} (γ : Path x y) (t t' : I) :
    initClass γ t' = (initClass γ t).trans (mk (γ.subpath t t')) := by
  rw [initClass, initClass, ← Path.Homotopic.mk_subpath_trans_mk_subpath γ 0 t t', cast_trans_left]

theorem mk_tr_initClass_zero_aux {a : X} (x : X) (h : x = a) (s : Fib φ x) :
    Cov.mk a (tr φ ((refl a).cast h rfl) s) = Cov.mk x s := by
  subst h
  rw [cast_rfl_rfl, tr_refl]

theorem mk_tr_initClass_one_aux {a b x y : X} (hs : a = x) (ht : b = y) (h : x = a) (P : PQ x y)
    (s : Fib φ x) :
    Cov.mk b (tr φ ((P.cast hs ht).cast h rfl) s) = Cov.mk y (tr φ P s) := by
  subst hs
  subst ht
  rw [cast_rfl_rfl, cast_rfl_rfl]

/-- The explicit lift `t ↦ (γ t, transport of s along γ|[0,t])`.
Source: Hatcher, *Algebraic Topology*, Proposition 1.30 (path lifting). -/
def liftFun {x y : X} (γ : Path x y) (s : Fib φ x) (t : I) : Cov φ :=
  Cov.mk (γ t) (tr φ (initClass γ t) s)

theorem liftFun_zero {x y : X} (γ : Path x y) (s : Fib φ x) : liftFun γ s 0 = Cov.mk x s := by
  have h : initClass γ 0 = (refl (γ 0)).cast γ.source.symm rfl := by
    rw [initClass, Path.subpath_self, mk_refl]
  rw [liftFun, h, mk_tr_initClass_zero_aux]

theorem liftFun_one {x y : X} (γ : Path x y) (s : Fib φ x) :
    liftFun γ s 1 = Cov.mk y (tr φ (mk γ) s) := by
  have h : initClass γ 1 = ((mk γ).cast γ.source γ.target).cast γ.source.symm rfl := by
    rw [initClass, Path.subpath_zero_one, mk_cast]
  rw [liftFun, h, mk_tr_initClass_one_aux]

theorem mk_mem_sheet {V : Set X} (hV : Good V) {a b : X} (sa : Fib φ a) (sb : Fib φ b)
    (ha : a ∈ V) (hb : b ∈ V) (h : sb = tr φ (pathIn hV ha hb) sa) :
    Cov.mk b sb ∈ sheet hV (Cov.mk a sa) ha :=
  ⟨hb, h⟩

example {x y : X} (γ : Path x y) (s : Fib φ x) : liftFun γ s 0 = Cov.mk x s :=
  liftFun_zero γ s

theorem dist_le_of_mem_uIcc {t₀ t r : I} (hr : r ∈ Set.uIcc t₀ t) : dist r t₀ ≤ dist t t₀ := by
  rw [Subtype.dist_eq, Subtype.dist_eq, Real.dist_eq, Real.dist_eq]
  rcases Set.mem_uIcc.1 hr with ⟨h1, h2⟩ | ⟨h1, h2⟩
  · have h1' : (t₀ : ℝ) ≤ r := h1
    have h2' : (r : ℝ) ≤ t := h2
    rw [abs_of_nonneg (by linarith), abs_of_nonneg (by linarith)]
    linarith
  · have h1' : (t : ℝ) ≤ r := h1
    have h2' : (r : ℝ) ≤ t₀ := h2
    rw [abs_of_nonpos (by linarith), abs_of_nonpos (by linarith)]
    linarith

variable (hX : ∀ x : X, ∀ N ∈ 𝓝 x, ∃ V, Good V ∧ x ∈ V ∧ V ⊆ N)
include hX

theorem continuous_liftFun {x y : X} (γ : Path x y) (s : Fib φ x) :
    Continuous (liftFun γ s) := by
  rw [(isTopologicalBasis_sheets hX).continuous_iff]
  rintro _ ⟨V, hV, w, hw, rfl⟩
  rw [isOpen_iff_mem_nhds]
  intro t₀ ht₀
  have hu₀ : (liftFun γ s t₀).1 ∈ V := ht₀.1
  have hsub := sheet_subset hV hV le_rfl hw ht₀ hu₀
  have hpre : γ ⁻¹' V ∈ 𝓝 t₀ := γ.continuous.continuousAt.preimage_mem_nhds (hV.1.mem_nhds hu₀)
  obtain ⟨ε, hε, hball⟩ := Metric.mem_nhds_iff.1 hpre
  refine Filter.mem_of_superset (Metric.ball_mem_nhds t₀ hε) fun t ht ↦ hsub ?_
  have hseg : ∀ r : I, (γ.subpath t₀ t) r ∈ V := by
    intro r
    have : (γ.subpath t₀ t) r ∈ Set.range (γ.subpath t₀ t) := ⟨r, rfl⟩
    rw [Path.range_subpath] at this
    obtain ⟨q, hq, hq'⟩ := this
    rw [← hq']
    exact hball (lt_of_le_of_lt (dist_le_of_mem_uIcc hq) ht)
  have htV : γ t ∈ V := by
    have := hseg 1
    simpa [Path.subpath] using this
  have hu₀' : γ t₀ ∈ V := hu₀
  exact mk_mem_sheet hV _ _ hu₀' htV (by
    rw [← tr_trans, initClass_trans γ t₀ t, mk_eq_pathIn hV hu₀' htV _ hseg])

/-- **The lift** of `γ` through `(x, s)`.
Source: Hatcher, *Algebraic Topology*, Proposition 1.30. -/
def lift {x y : X} (γ : Path x y) (s : Fib φ x) : C(I, Cov φ) :=
  ⟨liftFun γ s, continuous_liftFun hX γ s⟩

theorem proj_lift {x y : X} (γ : Path x y) (s : Fib φ x) : proj ∘ lift hX γ s = γ := rfl

example {x y : X} (γ : Path x y) (s : Fib φ x) : lift hX γ s 0 = Cov.mk x s := liftFun_zero γ s

end Lift

/-! ## Connectedness and monodromy -/

section Main

variable {φ : FundamentalGroup X x₀ →* Gᵐᵒᵖ} [PathConnectedSpace X]
variable (hX : ∀ x : X, ∀ N ∈ 𝓝 x, ∃ V, Good V ∧ x ∈ V ∧ V ⊆ N)
include hX

theorem liftFun_one_s₀ (γ : Path x₀ x₀) :
    liftFun γ (s₀ φ) 1 = psi φ (mk γ) • Cov.mk x₀ (s₀ φ) := by
  rw [liftFun_one, tr_s₀, smul_mk]

theorem joined_base (hφ : Function.Surjective φ) (u : Cov φ) : Joined (Cov.mk x₀ (s₀ φ)) u := by
  obtain ⟨x, s⟩ := u
  let c : PQ x₀ x := mk (PathConnectedSpace.somePath x₀ x)
  obtain ⟨g, hg⟩ := fib_exists_smul c s (tr φ c (s₀ φ))
  obtain ⟨a, ha⟩ := hφ (MulOpposite.op g)
  have hψ : psi φ a.asHom = g := by
    simp only [psi]
    change (φ a).unop = g
    rw [ha, MulOpposite.unop_op]
  obtain ⟨δ, hδ⟩ := Path.Homotopic.Quotient.mk_surjective (a.asHom.trans c)
  have hend : liftFun δ (s₀ φ) 1 = Cov.mk x s := by
    rw [liftFun_one, hδ, tr_trans, tr_s₀, hψ, tr_smul, hg]
  exact ⟨{ toContinuousMap := lift hX δ (s₀ φ)
           source' := liftFun_zero δ (s₀ φ)
           target' := hend }⟩

theorem pathConnectedSpace_cov (hφ : Function.Surjective φ) : PathConnectedSpace (Cov φ) where
  nonempty := ⟨Cov.mk x₀ (s₀ φ)⟩
  joined u v := (joined_base hX hφ u).symm.trans (joined_base hX hφ v)

/-- **The monodromy of the covering at `(x₀, ψ)` is `φ`.** -/
theorem fundamentalGroupToMulOpposite_eq :
    (isQuotientCoveringMap (φ := φ) hX).fundamentalGroupToMulOpposite
      ⟨Cov.mk x₀ (s₀ φ), rfl⟩ = φ := by
  ext a
  obtain ⟨γ, hγ⟩ := Path.Homotopic.Quotient.mk_surjective a.asHom
  have ha : a = .of (.mk γ) := by rw [hγ]
  subst ha
  rw [(isQuotientCoveringMap hX).fundamentalGroupToMulOpposite_apply_mk_eq
    (e := ⟨Cov.mk x₀ (s₀ φ), rfl⟩) (Γ := lift hX γ (s₀ φ)) (proj_lift hX γ (s₀ φ))
    (liftFun_zero γ (s₀ φ)) (liftFun_one_s₀ hX γ)]
  simp only [psi, MulOpposite.op_unop]

end Main

/-- **Existence of the Galois covering with monodromy `φ`**: for a path-connected `X` with small
good neighborhoods and a surjection `φ : π₁(X, x₀) →* Gᵐᵒᵖ`, there is a connected `G`-covering
`p : U → X` with a point over `x₀` at which the monodromy is `φ`.
Source: Hatcher, *Algebraic Topology*, Theorem 1.38 and Proposition 1.40. -/
theorem exists_galoisCovering [PathConnectedSpace X]
    (hX : ∀ x : X, ∀ N ∈ 𝓝 x, ∃ V, Good V ∧ x ∈ V ∧ V ⊆ N)
    (φ : FundamentalGroup X x₀ →* Gᵐᵒᵖ) (hφ : Function.Surjective φ) :
    ∃ (U : Type) (_ : TopologicalSpace U) (_ : MulAction G U) (p : U → X)
      (hp : IsQuotientCoveringMap p G),
      ConnectedSpace U ∧ ∃ e : p ⁻¹' {x₀}, hp.fundamentalGroupToMulOpposite e = φ := by
  have := pathConnectedSpace_cov hX hφ
  exact ⟨Cov φ, inferInstance, inferInstance, proj, isQuotientCoveringMap hX, inferInstance,
    ⟨Cov.mk x₀ (s₀ φ), rfl⟩, fundamentalGroupToMulOpposite_eq hX⟩

end HurwitzPrymRexCover

