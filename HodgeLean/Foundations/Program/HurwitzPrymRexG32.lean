import HodgeLean.Foundations.Program.HurwitzPrymRexG32Cert
import HodgeLean.Papers.G32FamilyDefs

set_option maxHeartbeats 400000

/-! # Track B4, lane `b4-rex`: the order of the G32 matrix group

The kernel-checked stabilizer chain of `HurwitzPrymRexG32Cert` shows that the monoid generated by
the integral generators is `T₁ T₂ T₃` with unique factorization, of order `240 · 72 · 9 = 155 520`.
Conjugating by the lattice basis `P` carries it onto G32's `g32h_G`, which is therefore a finite
group of order `155 520`.
HC no distance; AV milestone no distance.
-/

noncomputable section

open scoped Pointwise
open HodgeLean.Papers

namespace HodgeLean.Foundations.Program

local notation "𝕄" => Matrix (Fin 4) (Fin 4) ℂ

theorem HurwitzPrymRex_omega_pow :
    g32h_omega ^ 2 = -g32h_omega - 1 ∧ g32h_omega ^ 3 = 1 := by
  have h := g32h_omega_sq_add
  exact ⟨by linear_combination h, by linear_combination (g32h_omega - 1) * h⟩

/-- Reduce modulo `ω² + ω + 1 = 0`. -/
local macro "rex_omega" : tactic => `(tactic| (ring_nf; all_goals (try simp only [HurwitzPrymRex_omega_pow.1, HurwitzPrymRex_omega_pow.2]); all_goals ring_nf))

/-! ## The chain in `ℂ` -/

section Chain

local notation "ι" => HurwitzPrymRex_img g32h_omega

theorem HurwitzPrymRex_img_sub {S D : List HurwitzPrymRex_Mat}
    (h : S.all (fun s ↦ D.any (HurwitzPrymRex_mbeq s)) = true) : ι S ⊆ ι D := by
  rintro _ ⟨A, hA, rfl⟩
  rw [List.all_eq_true] at h
  obtain ⟨B, hB, hAB⟩ := List.any_eq_true.1 (h A hA)
  exact ⟨B, hB, by rw [HurwitzPrymRex_mbeq_sound hAB]⟩

/-- **Counting one level**: if the later factors fix `e_b`, the transversal has distinct
`b`-columns and consists of units, then `|T Q| = |T| |Q|`. -/
theorem HurwitzPrymRex_ncard_level {b : Fin 4} (T Q : Set 𝕄)
    (hfix : ∀ q ∈ Q, ∀ i, q i b = (1 : 𝕄) i b)
    (hinj : Set.InjOn (fun X : 𝕄 ↦ fun i ↦ X i b) T) (hunit : ∀ t ∈ T, IsUnit t) :
    (T * Q).ncard = T.ncard * Q.ncard := by
  refine HurwitzPrymRex_ncard_mul T Q fun t ht t' ht' q hq q' hq' h ↦ ?_
  have hcol : (fun i ↦ t i b) = (fun i ↦ t' i b) := by
    funext i
    rw [← HurwitzPrymRex_mul_col t q (hfix q hq) i, ← HurwitzPrymRex_mul_col t' q' (hfix q' hq') i,
      h]
  have htt : t = t' := hinj ht ht' hcol
  subst htt
  exact ⟨rfl, (hunit t ht).mul_left_cancel h⟩

theorem HurwitzPrymRex_g32_units : ∀ X ∈ Submonoid.closure (ι HurwitzPrymRex_g32SOne), IsUnit X :=
  HurwitzPrymRex_closure_isUnit _ (HurwitzPrymRex_invCheck_eval g32h_omega_sq_add HurwitzPrymRex_g32_inv)

theorem HurwitzPrymRex_g32_le21 :
    Submonoid.closure (ι HurwitzPrymRex_g32STwo) ≤ Submonoid.closure (ι HurwitzPrymRex_g32SOne) :=
  Submonoid.closure_le.2 fun _ hx ↦ HurwitzPrymRex_derivCheck_eval g32h_omega_sq_add
    HurwitzPrymRex_g32_derivD1 (HurwitzPrymRex_img_sub HurwitzPrymRex_g32_sub2 hx)

theorem HurwitzPrymRex_g32_le32 :
    Submonoid.closure (ι HurwitzPrymRex_g32SThree) ≤ Submonoid.closure (ι HurwitzPrymRex_g32STwo) :=
  Submonoid.closure_le.2 fun _ hx ↦ HurwitzPrymRex_derivCheck_eval g32h_omega_sq_add
    HurwitzPrymRex_g32_derivD2 (HurwitzPrymRex_img_sub HurwitzPrymRex_g32_sub3 hx)

theorem HurwitzPrymRex_g32_H3 :
    (Submonoid.closure (ι HurwitzPrymRex_g32SThree) : Set 𝕄) =
      ι HurwitzPrymRex_g32TThree * {1} := by
  have h := HurwitzPrymRex_closure_eq_mul (ι HurwitzPrymRex_g32SThree) (ι HurwitzPrymRex_g32TThree)
    ⊥ (HurwitzPrymRex_derivCheck_one HurwitzPrymRex_g32_derivT3
      (by rw [HurwitzPrymRex_g32_lengths.2.2]; norm_num))
    (HurwitzPrymRex_derivCheck_eval g32h_omega_sq_add HurwitzPrymRex_g32_derivT3) bot_le
    (fun s hs t ht ↦ by
      obtain ⟨t', ht', u, hu, he⟩ :=
        HurwitzPrymRex_stepCheck_eval g32h_omega_sq_add HurwitzPrymRex_g32_step3 s hs t ht
      refine ⟨t', ht', u, ?_, he⟩
      change u ∈ ({1} : Set 𝕄) at hu
      rw [Set.mem_singleton_iff] at hu
      rw [hu]
      exact one_mem _)
  rwa [Submonoid.coe_bot] at h

theorem HurwitzPrymRex_g32_H2 :
    (Submonoid.closure (ι HurwitzPrymRex_g32STwo) : Set 𝕄) =
      ι HurwitzPrymRex_g32TTwo * (Submonoid.closure (ι HurwitzPrymRex_g32SThree) : Set 𝕄) :=
  HurwitzPrymRex_closure_eq_mul (ι HurwitzPrymRex_g32STwo) (ι HurwitzPrymRex_g32TTwo) _
    (HurwitzPrymRex_derivCheck_one HurwitzPrymRex_g32_derivT2
      (by rw [HurwitzPrymRex_g32_lengths.2.1]; norm_num))
    (HurwitzPrymRex_derivCheck_eval g32h_omega_sq_add HurwitzPrymRex_g32_derivT2)
    HurwitzPrymRex_g32_le32
    (fun s hs t ht ↦ by
      obtain ⟨t', ht', u, hu, he⟩ :=
        HurwitzPrymRex_stepCheck_eval g32h_omega_sq_add HurwitzPrymRex_g32_step2 s hs t ht
      refine ⟨t', ht', u, ?_, he⟩
      change u ∈ (Submonoid.closure (ι HurwitzPrymRex_g32SThree) : Set 𝕄)
      rw [HurwitzPrymRex_g32_H3]
      exact hu)

theorem HurwitzPrymRex_g32_H1 :
    (Submonoid.closure (ι HurwitzPrymRex_g32SOne) : Set 𝕄) =
      ι HurwitzPrymRex_g32TOne * (Submonoid.closure (ι HurwitzPrymRex_g32STwo) : Set 𝕄) :=
  HurwitzPrymRex_closure_eq_mul (ι HurwitzPrymRex_g32SOne) (ι HurwitzPrymRex_g32TOne) _
    (HurwitzPrymRex_derivCheck_one HurwitzPrymRex_g32_derivT1
      (by rw [HurwitzPrymRex_g32_lengths.1]; norm_num))
    (HurwitzPrymRex_derivCheck_eval g32h_omega_sq_add HurwitzPrymRex_g32_derivT1)
    HurwitzPrymRex_g32_le21
    (fun s hs t ht ↦ by
      obtain ⟨t', ht', u, hu, he⟩ :=
        HurwitzPrymRex_stepCheck_eval g32h_omega_sq_add HurwitzPrymRex_g32_step1 s hs t ht
      refine ⟨t', ht', u, ?_, he⟩
      change u ∈ (Submonoid.closure (ι HurwitzPrymRex_g32STwo) : Set 𝕄)
      rw [HurwitzPrymRex_g32_H2, HurwitzPrymRex_g32_H3]
      exact hu)

theorem HurwitzPrymRex_g32_T3_units : ∀ t ∈ ι HurwitzPrymRex_g32TThree, IsUnit t := fun t ht ↦
  HurwitzPrymRex_g32_units t (HurwitzPrymRex_g32_le21 (HurwitzPrymRex_g32_le32
    (HurwitzPrymRex_derivCheck_eval g32h_omega_sq_add HurwitzPrymRex_g32_derivT3 ht)))

theorem HurwitzPrymRex_g32_T2_units : ∀ t ∈ ι HurwitzPrymRex_g32TTwo, IsUnit t := fun t ht ↦
  HurwitzPrymRex_g32_units t (HurwitzPrymRex_g32_le21
    (HurwitzPrymRex_derivCheck_eval g32h_omega_sq_add HurwitzPrymRex_g32_derivT2 ht))

theorem HurwitzPrymRex_g32_T1_units : ∀ t ∈ ι HurwitzPrymRex_g32TOne, IsUnit t := fun t ht ↦
  HurwitzPrymRex_g32_units t
    (HurwitzPrymRex_derivCheck_eval g32h_omega_sq_add HurwitzPrymRex_g32_derivT1 ht)

theorem HurwitzPrymRex_g32_card3 :
    (Submonoid.closure (ι HurwitzPrymRex_g32SThree) : Set 𝕄).ncard = 9 := by
  have hn := HurwitzPrymRex_nodup_eval (w := g32h_omega) g32h_omega_sq_add HurwitzPrymRex_g32_nodup3
  rw [HurwitzPrymRex_g32_H3, HurwitzPrymRex_ncard_level (b := 0) _ _
    (fun q hq i ↦ by rw [Set.mem_singleton_iff.1 hq]) hn.1 HurwitzPrymRex_g32_T3_units,
    hn.2, HurwitzPrymRex_g32_lengths.2.2, Set.ncard_singleton]

theorem HurwitzPrymRex_g32_card2 :
    (Submonoid.closure (ι HurwitzPrymRex_g32STwo) : Set 𝕄).ncard = 648 := by
  have hn := HurwitzPrymRex_nodup_eval (w := g32h_omega) g32h_omega_sq_add HurwitzPrymRex_g32_nodup2
  rw [HurwitzPrymRex_g32_H2, HurwitzPrymRex_ncard_level (b := 3) _ _
    (HurwitzPrymRex_closure_fix _ (HurwitzPrymRex_fixCheck_eval HurwitzPrymRex_g32_fix3)) hn.1
    HurwitzPrymRex_g32_T2_units, hn.2, HurwitzPrymRex_g32_lengths.2.1, HurwitzPrymRex_g32_card3]

theorem HurwitzPrymRex_g32_card1 :
    (Submonoid.closure (ι HurwitzPrymRex_g32SOne) : Set 𝕄).ncard = 155520 := by
  have hn := HurwitzPrymRex_nodup_eval (w := g32h_omega) g32h_omega_sq_add HurwitzPrymRex_g32_nodup1
  rw [HurwitzPrymRex_g32_H1, HurwitzPrymRex_ncard_level (b := 2) _ _
    (HurwitzPrymRex_closure_fix _ (HurwitzPrymRex_fixCheck_eval HurwitzPrymRex_g32_fix2)) hn.1
    HurwitzPrymRex_g32_T1_units, hn.2, HurwitzPrymRex_g32_lengths.1, HurwitzPrymRex_g32_card2]

end Chain

/-! ## Conjugation onto the printed matrices -/

section Conj


/-- **The lattice basis** `P`: columns `(1-ω)/3 · (1,1,1,0)`, `(1-ω)/3 · (0,1,1+ω,1)`, `e₂`, `e₃`,
a `ℤ[ω]`-basis of the lattice spanned by the orbit of `e₀` under G32.
Source: computed (Hermite reduction of the orbit of `e₀` under G32 v0.16, Appendix A). -/
def HurwitzPrymRex_g32P : 𝕄 :=
  !![(1 - g32h_omega) / 3, 0, 0, 0;
     (1 - g32h_omega) / 3, (1 - g32h_omega) / 3, 0, 0;
     (1 - g32h_omega) / 3, (1 - g32h_omega) / 3 * (1 + g32h_omega), 1, 0;
     0, (1 - g32h_omega) / 3, 0, 1]

example : HurwitzPrymRex_g32P 2 2 = 1 := rfl

/-- The inverse of `P`, with entries in `ℤ[ω]`.
Source: computed (inverse of `HurwitzPrymRex_g32P`). -/
def HurwitzPrymRex_g32Pinv : 𝕄 :=
  !![2 + g32h_omega, 0, 0, 0;
     -2 - g32h_omega, 2 + g32h_omega, 0, 0;
     g32h_omega, -1 - g32h_omega, 1, 0;
     1, -1, 0, 1]

example : HurwitzPrymRex_g32Pinv 3 3 = 1 := rfl

theorem HurwitzPrymRex_g32_Pinv_P : HurwitzPrymRex_g32Pinv * HurwitzPrymRex_g32P = 1 := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [HurwitzPrymRex_g32P, HurwitzPrymRex_g32Pinv, Matrix.mul_apply, Fin.sum_univ_four,
      Matrix.one_apply] <;> rex_omega

theorem HurwitzPrymRex_g32_P_Pinv : HurwitzPrymRex_g32P * HurwitzPrymRex_g32Pinv = 1 := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [HurwitzPrymRex_g32P, HurwitzPrymRex_g32Pinv, Matrix.mul_apply, Fin.sum_univ_four,
      Matrix.one_apply] <;> rex_omega

/-- **Conjugation by `P`**, `X ↦ P X P⁻¹`, as a monoid map.
Source: conjugation by an invertible matrix. -/
def HurwitzPrymRex_g32conj : 𝕄 →* 𝕄 where
  toFun X := HurwitzPrymRex_g32P * X * HurwitzPrymRex_g32Pinv
  map_one' := by rw [mul_one, HurwitzPrymRex_g32_P_Pinv]
  map_mul' X Y := by
    rw [show HurwitzPrymRex_g32P * X * HurwitzPrymRex_g32Pinv *
        (HurwitzPrymRex_g32P * Y * HurwitzPrymRex_g32Pinv) =
        HurwitzPrymRex_g32P * X * (HurwitzPrymRex_g32Pinv * HurwitzPrymRex_g32P) * Y *
          HurwitzPrymRex_g32Pinv by noncomm_ring, HurwitzPrymRex_g32_Pinv_P, mul_one]
    simp only [mul_assoc]

example : HurwitzPrymRex_g32conj 1 = 1 := map_one _

theorem HurwitzPrymRex_g32conj_injective : Function.Injective HurwitzPrymRex_g32conj := by
  intro X Y h
  have h' := congrArg (fun Z ↦ HurwitzPrymRex_g32Pinv * Z * HurwitzPrymRex_g32P) h
  simp only [HurwitzPrymRex_g32conj, MonoidHom.coe_mk, OneHom.coe_mk] at h'
  rwa [show ∀ Z : 𝕄, HurwitzPrymRex_g32Pinv * (HurwitzPrymRex_g32P * Z * HurwitzPrymRex_g32Pinv) *
      HurwitzPrymRex_g32P = (HurwitzPrymRex_g32Pinv * HurwitzPrymRex_g32P) * Z *
        (HurwitzPrymRex_g32Pinv * HurwitzPrymRex_g32P) by intro Z; noncomm_ring,
    show ∀ Z : 𝕄, HurwitzPrymRex_g32Pinv * (HurwitzPrymRex_g32P * Z * HurwitzPrymRex_g32Pinv) *
      HurwitzPrymRex_g32P = (HurwitzPrymRex_g32Pinv * HurwitzPrymRex_g32P) * Z *
        (HurwitzPrymRex_g32Pinv * HurwitzPrymRex_g32P) by intro Z; noncomm_ring,
    HurwitzPrymRex_g32_Pinv_P, one_mul, mul_one, one_mul, mul_one] at h'

theorem HurwitzPrymRex_g32conj_of_mul {X Y : 𝕄}
    (h : HurwitzPrymRex_g32P * X = Y * HurwitzPrymRex_g32P) : HurwitzPrymRex_g32conj X = Y := by
  change HurwitzPrymRex_g32P * X * HurwitzPrymRex_g32Pinv = Y
  rw [h, mul_assoc, HurwitzPrymRex_g32_P_Pinv, mul_one]

end Conj

/-! ## The printed group -/

section Group

local notation "ι" => HurwitzPrymRex_img g32h_omega

theorem HurwitzPrymRex_g32SOne_eq : HurwitzPrymRex_g32SOne =
    [HurwitzPrymRex_nth HurwitzPrymRex_g32SOne 0, HurwitzPrymRex_nth HurwitzPrymRex_g32SOne 1,
      HurwitzPrymRex_nth HurwitzPrymRex_g32SOne 2, HurwitzPrymRex_nth HurwitzPrymRex_g32SOne 3] :=
  rfl

theorem HurwitzPrymRex_g32_conj0 :
    HurwitzPrymRex_g32conj (HurwitzPrymRex_evM g32h_omega (HurwitzPrymRex_nth HurwitzPrymRex_g32SOne 0)) =
      g32R1 g32h_omega := by
  apply HurwitzPrymRex_g32conj_of_mul
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [HurwitzPrymRex_g32P, HurwitzPrymRex_nth, HurwitzPrymRex_g32SOne, HurwitzPrymRex_evM,
      HurwitzPrymRex_ev, g32R1, Matrix.mul_apply, Fin.sum_univ_four] <;> rex_omega

theorem HurwitzPrymRex_g32_conj1 :
    HurwitzPrymRex_g32conj (HurwitzPrymRex_evM g32h_omega (HurwitzPrymRex_nth HurwitzPrymRex_g32SOne 1)) =
      g32R2 g32h_omega := by
  apply HurwitzPrymRex_g32conj_of_mul
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [HurwitzPrymRex_g32P, HurwitzPrymRex_nth, HurwitzPrymRex_g32SOne, HurwitzPrymRex_evM,
      HurwitzPrymRex_ev, g32R2, Matrix.mul_apply, Fin.sum_univ_four] <;> rex_omega

theorem HurwitzPrymRex_g32_conj2 :
    HurwitzPrymRex_g32conj (HurwitzPrymRex_evM g32h_omega (HurwitzPrymRex_nth HurwitzPrymRex_g32SOne 2)) =
      g32X g32h_omega := by
  apply HurwitzPrymRex_g32conj_of_mul
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [HurwitzPrymRex_g32P, HurwitzPrymRex_nth, HurwitzPrymRex_g32SOne, HurwitzPrymRex_evM,
      HurwitzPrymRex_ev, g32X, Matrix.mul_apply, Fin.sum_univ_four] <;> rex_omega

theorem HurwitzPrymRex_g32_conj3 :
    HurwitzPrymRex_g32conj (HurwitzPrymRex_evM g32h_omega (HurwitzPrymRex_nth HurwitzPrymRex_g32SOne 3)) =
      g32Y g32h_omega := by
  apply HurwitzPrymRex_g32conj_of_mul
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [HurwitzPrymRex_g32P, HurwitzPrymRex_nth, HurwitzPrymRex_g32SOne, HurwitzPrymRex_evM,
      HurwitzPrymRex_ev, g32Y, Matrix.mul_apply, Fin.sum_univ_four] <;> rex_omega

theorem HurwitzPrymRex_g32_image :
    HurwitzPrymRex_g32conj '' ι HurwitzPrymRex_g32SOne =
      {g32R1 g32h_omega, g32R2 g32h_omega, g32X g32h_omega, g32Y g32h_omega} := by
  rw [HurwitzPrymRex_g32SOne_eq]
  ext X
  simp only [HurwitzPrymRex_img, List.mem_cons, List.not_mem_nil, or_false, Set.mem_image,
    Set.mem_setOf_eq, Set.mem_insert_iff, Set.mem_singleton_iff]
  constructor
  · rintro ⟨_, ⟨A, hA, rfl⟩, rfl⟩
    rcases hA with rfl | rfl | rfl | rfl
    · exact Or.inl HurwitzPrymRex_g32_conj0
    · exact Or.inr (Or.inl HurwitzPrymRex_g32_conj1)
    · exact Or.inr (Or.inr (Or.inl HurwitzPrymRex_g32_conj2))
    · exact Or.inr (Or.inr (Or.inr HurwitzPrymRex_g32_conj3))
  · rintro (rfl | rfl | rfl | rfl)
    · exact ⟨_, ⟨_, Or.inl rfl, rfl⟩, HurwitzPrymRex_g32_conj0⟩
    · exact ⟨_, ⟨_, Or.inr (Or.inl rfl), rfl⟩, HurwitzPrymRex_g32_conj1⟩
    · exact ⟨_, ⟨_, Or.inr (Or.inr (Or.inl rfl)), rfl⟩, HurwitzPrymRex_g32_conj2⟩
    · exact ⟨_, ⟨_, Or.inr (Or.inr (Or.inr rfl)), rfl⟩, HurwitzPrymRex_g32_conj3⟩

/-- **`g32h_G` is the conjugate of the integral group.** -/
theorem HurwitzPrymRex_g32_G_eq :
    g32h_G = (Submonoid.closure (ι HurwitzPrymRex_g32SOne)).map HurwitzPrymRex_g32conj := by
  rw [MonoidHom.map_mclosure, HurwitzPrymRex_g32_image]
  rfl

/-- **The order of G32**: `|⟨r₁, r₂, x, y⟩| = 155 520`.
Source: G32 v0.16, Subsection 3.3 (`|G| = 155 520`); Shephard–Todd, *Finite unitary reflection
groups*, Canad. J. Math. 6 (1954), Table VII (group 32). -/
theorem HurwitzPrymRex_g32_ncard : (g32h_G : Set 𝕄).ncard = 155520 := by
  rw [HurwitzPrymRex_g32_G_eq, Submonoid.coe_map,
    Set.ncard_image_of_injective _ HurwitzPrymRex_g32conj_injective, HurwitzPrymRex_g32_card1]

theorem HurwitzPrymRex_g32_isUnit : ∀ X ∈ g32h_G, IsUnit X := by
  rw [HurwitzPrymRex_g32_G_eq]
  rintro _ ⟨Y, hY, rfl⟩
  exact (HurwitzPrymRex_g32_units Y hY).map HurwitzPrymRex_g32conj

/-- `g32h_G` is left cancellative: its elements are invertible matrices. -/
instance HurwitzPrymRex_g32_leftCancel : LeftCancelMonoid g32h_G :=
  { (inferInstance : Monoid g32h_G) with
    mul_left_cancel := fun a b c h ↦
      Subtype.ext ((HurwitzPrymRex_g32_isUnit a.1 a.2).mul_left_cancel (congrArg Subtype.val h)) }

instance HurwitzPrymRex_g32_finite : Finite g32h_G :=
  (Set.finite_of_ncard_ne_zero (s := (g32h_G : Set 𝕄))
    (by rw [HurwitzPrymRex_g32_ncard]; norm_num)).to_subtype

/-- **G32 as a finite group**: `g32h_G` with the matrix product is a group of order `155 520`,
realized faithfully by its matrices. This is `b4_g32_group_realization` with `toMatrix` injective
(onto `g32h_G`) in place of bijective.
Source: G32 v0.16, Subsection 3.3 and Appendix A. -/
theorem HurwitzPrymRex_g32_group_realization :
    ∃ (G : Type) (_ : Group G) (_ : Finite G)
      (toMatrix : G → Matrix (Fin 4) (Fin 4) ℂ),
      Function.Injective toMatrix ∧ Set.range toMatrix = (g32h_G : Set _) ∧
      toMatrix 1 = 1 ∧ (∀ g h, toMatrix (g * h) = toMatrix g * toMatrix h) ∧
      Nat.card G = 155520 := by
  letI : Group g32h_G := LeftCancelMonoid.groupOfFinite
  refine ⟨g32h_G, inferInstance, inferInstance, Subtype.val, Subtype.val_injective,
    Subtype.range_coe, rfl, fun _ _ ↦ rfl, ?_⟩
  exact (Nat.card_coe_set_eq (g32h_G : Set 𝕄)).trans HurwitzPrymRex_g32_ncard

/-- **No finite group maps bijectively onto all `4 × 4` complex matrices**, so the realization
cannot ask `toMatrix` to be bijective onto `Matrix (Fin 4) (Fin 4) ℂ`. -/
theorem HurwitzPrymRex_g32_bijective_false :
    ¬ ∃ (G : Type) (_ : Group G) (_ : Finite G)
      (toMatrix : G → Matrix (Fin 4) (Fin 4) ℂ),
      Function.Bijective toMatrix ∧ Set.range toMatrix = (g32h_G : Set _) ∧
      toMatrix 1 = 1 ∧ (∀ g h, toMatrix (g * h) = toMatrix g * toMatrix h) ∧
      Nat.card G = 155520 := by
  rintro ⟨G, _, _, f, hf, -⟩
  have : Finite (Matrix (Fin 4) (Fin 4) ℂ) := Finite.of_surjective f hf.2
  have : Finite ℂ := Finite.of_injective (β := Matrix (Fin 4) (Fin 4) ℂ)
    (fun c ↦ Matrix.of fun _ _ ↦ c) fun a b h ↦ congrFun (congrFun h 0) 0
  exact not_finite ℂ

end Group

end HodgeLean.Foundations.Program
