Source: G32 v0.16, Lemma kernel(1), Subsection 5.5(4). -/
def b65k_principal (c : Fin 36 → ℚ) (j : Fin 4) : RatFunc ℚ :=
  ∑ a : Fin 9, RatFunc.C (c ⟨4*a.val+j.val, by omega⟩) /
    (RatFunc.X - RatFunc.C (b65k_fixed (b65k_poleIndex a))) ^ b65k_poleOrder a
example (j : Fin 4) : b65k_principal 0 j = 0 := by
  simp [b65k_principal]

/-- The two degree-six fibre polynomials, made monic, for `e ≠ 1`; this lane uses only
`e = 5` and `e = -7`. At `e = 1` the normalizing factor `(1-e)⁻¹` is `0` in `ℚ`, so the
definition returns the zero polynomial there.
Source: G32 v0.16, displayed P₅ and P₋₇, Subsection 5.5(7). -/
def b65k_fibrePoly (e : ℚ) : Polynomial ℚ :=
  Polynomial.C ((1-e)⁻¹) * (Polynomial.X^2 * (Polynomial.X-3)^4 -
    Polynomial.C e * (Polynomial.X-1)^3 * (Polynomial.X+2)^3)
example (e : ℚ) : b65k_fibrePoly e =
  Polynomial.C ((1-e)⁻¹) * (Polynomial.X^2 * (Polynomial.X-3)^4 -
    Polynomial.C e * (Polynomial.X-1)^3 * (Polynomial.X+2)^3) := rfl

/-- For `e ≠ 1`: multiplication by the root coordinate in the power basis of the degree-six
algebra `ℚ[s]/(Pₑ)`. At `e = 1` the fibre polynomial is zero and this matrix is a nilpotent
shift, with no quotient-algebra meaning; this lane uses only `e = 5` and `e = -7`.
Source: G32 v0.16, Subsection 5.5(1), Eε = ℚ[s]/(Pε). -/
def b65k_companion (e : ℚ) : Matrix (Fin 6) (Fin 6) ℚ := fun i j =>
  if j = 5 then -(b65k_fibrePoly e).coeff i.val
  else if i.val = j.val+1 then 1 else 0
example (e : ℚ) : b65k_companion e 1 0 = 1 := rfl

/-- For `e ≠ 1`: the sum over the six roots `t` of `Pₑ` of `tᵏ/(s-t)`, expressed by
polynomial division of `sᵏ-tᵏ`. The root-trace reading needs `e ≠ 1`; this lane uses only
`e = 5` and `e = -7`.
Source: G32 v0.16, Subsection 5.5(1), traces over the six reflection poles. -/
def b65k_rootSum (e : ℚ) (k : ℕ) : RatFunc ℚ :=
  RatFunc.X^k *
    (algebraMap (Polynomial ℚ) (RatFunc ℚ) (b65k_fibrePoly e).derivative /
      algebraMap (Polynomial ℚ) (RatFunc ℚ) (b65k_fibrePoly e)) -
    ∑ j ∈ Finset.range k, RatFunc.X^(k-1-j) *
      RatFunc.C (Matrix.trace (b65k_companion e ^ j))
example (e : ℚ) : b65k_rootSum e 0 =
    algebraMap (Polynomial ℚ) (RatFunc ℚ) (b65k_fibrePoly e).derivative /
      algebraMap (Polynomial ℚ) (RatFunc ℚ) (b65k_fibrePoly e) := by
  simp [b65k_rootSum]

/-- The two initial left eigenvectors at reflection poles.
Source: G32 v0.16, Appendix A, v₁ and v₂; Subsection 5.5(3). -/
def b65k_left : Fin 2 → Fin 4 → ℚ :=
  ![![119/648, 28/135, -41472/289, -187/3240],
    ![-2648107/3627970560, -1090397/755827200, 56/135, -2648107/18139852800]]
example : b65k_left 0 2 = -41472/289 := rfl

/-- The rational r-frame at the base parameter, from the chosen kernel columns.
Source: G32 v0.16, Lemma kernel(1),(3), Subsection 5.5(4),(6). -/
def b65k_rBase (a : Fin 3) (j : Fin 4) : RatFunc ℚ :=
  b65k_principal (fun i => b65k_rKernel i a) j
example (a : Fin 3) (j : Fin 4) : b65k_rBase a j =
    b65k_principal (fun i => b65k_rKernel i a) j := rfl

/-- The rational q-frame at the base parameter, including the interpolated reflection residues.
Source: G32 v0.16, Lemma kernel(1),(3), Subsection 5.5(3),(4),(6). -/
def b65k_qBase (b : Fin 3) (j : Fin 4) : RatFunc ℚ :=
  b65k_principal (fun i => b65k_qKernel ⟨i.val, by omega⟩ b) j +
    ∑ e : Fin 2, ∑ k : Fin 6,
      RatFunc.C (b65k_left e j * b65k_qKernel ⟨36+6*e.val+k.val, by omega⟩ b) *
        b65k_rootSum ((![(5 : ℚ), -7] : Fin 2 → ℚ) e) k.val
example (b : Fin 3) (j : Fin 4) : b65k_qBase b j =
  b65k_principal (fun i => b65k_qKernel ⟨i.val, by omega⟩ b) j +
    ∑ e : Fin 2, ∑ k : Fin 6,
      RatFunc.C (b65k_left e j * b65k_qKernel ⟨36+6*e.val+k.val, by omega⟩ b) *
        b65k_rootSum ((![(5 : ℚ), -7] : Fin 2 → ℚ) e) k.val := rfl

/-- The monic degree-thirteen base branch polynomial.
Source: G32 v0.16, Subsection 5.5(7). -/
def b65k_baseDenominator : Polynomial ℚ :=
  Polynomial.X * b65k_fibrePoly 5 * b65k_fibrePoly (-7)
example : b65k_baseDenominator =
    Polynomial.X * b65k_fibrePoly 5 * b65k_fibrePoly (-7) := rfl

/-- Contraction after multiplication by the base branch polynomial.
Source: G32 v0.16, Lemma dictionary, Subsection 5.5(7). -/
def b65k_baseProduct (a b : Fin 3) : RatFunc ℚ :=
  algebraMap (Polynomial ℚ) (RatFunc ℚ) b65k_baseDenominator *
    ∑ j : Fin 4, b65k_qBase b j * b65k_rBase a j
example (a b : Fin 3) : b65k_baseProduct a b =
  algebraMap (Polynomial ℚ) (RatFunc ℚ) b65k_baseDenominator *
    ∑ j : Fin 4, b65k_qBase b j * b65k_rBase a j := rfl

/-- The reduced polynomial numerator of the base contraction.
Its denominator-one and degree assertions are separate targets.
Source: G32 v0.16, Lemma numerators, Subsection 5.5(7). -/
def b65k_baseNumerator (a b : Fin 3) : Polynomial ℚ :=
  (b65k_baseProduct a b).num
example (a b : Fin 3) : b65k_baseNumerator a b = (b65k_baseProduct a b).num := rfl

/-- Base numerator coefficient rows in the ordered r-then-q convention.
Source: G32 v0.16, Subsection 5.5(7), columns s⁰ through s⁹. -/
def b65k_baseMatrix : Matrix (Fin 9) (Fin 10) ℚ := fun i j =>
  let ab := (finProdFinEquiv : Fin 3 × Fin 3 ≃ Fin 9).symm i
  (b65k_baseNumerator ab.1 ab.2).coeff j.val
example (a b : Fin 3) (j : Fin 10) :
    b65k_baseMatrix (finProdFinEquiv (a,b)) j =
      (b65k_baseNumerator a b).coeff j.val := by
  simp only [b65k_baseMatrix, Equiv.symm_apply_apply]

end HodgeLean.Foundations.Program
