/-- The selected square block in the base Laurent system.
Source: G32 v0.16, Lemma kernel(3), Subsection 5.5(6). -/
def b65k_rBlock : Matrix (Fin 33) (Fin 33) ℚ :=
  b65k_rSystem.submatrix b65k_rRows b65k_rPivot

example (i j : Fin 33) : b65k_rBlock i j =
    b65k_rSystem (b65k_rRows i) (b65k_rPivot j) := rfl

/-- Columns with prescribed free coordinates and inverse-block pivot coordinates.
Source: G32 v0.16, Lemma kernel(3), Subsection 5.5(6). -/
def b65k_rKernel : Matrix (Fin 36) (Fin 3) ℚ := fun i f =>
  (∑ a : Fin 3, if i = b65k_rFree a then (if a = f then 1 else 0) else 0) -
    ∑ a : Fin 33, if i = b65k_rPivot a then
      (b65k_rBlock⁻¹ * b65k_rSystem.submatrix b65k_rRows b65k_rFree) a f else 0

example (i : Fin 36) (f : Fin 3) : b65k_rKernel i f =
  (∑ a : Fin 3, if i = b65k_rFree a then (if a = f then 1 else 0) else 0) -
    ∑ a : Fin 33, if i = b65k_rPivot a then
      (b65k_rBlock⁻¹ * b65k_rSystem.submatrix b65k_rRows b65k_rFree) a f else 0 := rfl

