/-- The selected square block in the base Laurent system.
Source: G32 v0.16, Lemma kernel(3), Subsection 5.5(6). -/
def b65k_qBlock : Matrix (Fin 45) (Fin 45) ℚ :=
  b65k_qSystem.submatrix b65k_qRows b65k_qPivot

example (i j : Fin 45) : b65k_qBlock i j =
    b65k_qSystem (b65k_qRows i) (b65k_qPivot j) := rfl

/-- Columns with prescribed free coordinates and inverse-block pivot coordinates.
Source: G32 v0.16, Lemma kernel(3), Subsection 5.5(6). -/
def b65k_qKernel : Matrix (Fin 48) (Fin 3) ℚ := fun i f =>
  (∑ a : Fin 3, if i = b65k_qFree a then (if a = f then 1 else 0) else 0) -
    ∑ a : Fin 45, if i = b65k_qPivot a then
      (b65k_qBlock⁻¹ * b65k_qSystem.submatrix b65k_qRows b65k_qFree) a f else 0

example (i : Fin 48) (f : Fin 3) : b65k_qKernel i f =
  (∑ a : Fin 3, if i = b65k_qFree a then (if a = f then 1 else 0) else 0) -
    ∑ a : Fin 45, if i = b65k_qPivot a then
      (b65k_qBlock⁻¹ * b65k_qSystem.submatrix b65k_qRows b65k_qFree) a f else 0 := rfl

