/-- Polynomial quotients in the weight recursion certificates. -/
def b65e_fixedWeightQuotQ (n : Fin 7) (e : Fin 2) (k : Fin 4) : ℚ[X] :=
  ∑ c : Fin 10, C (b65e_fixedWeightQuotCoeffQ n e k c) * X ^ (c : ℕ)

set_option maxHeartbeats 400000 in
/-- Rational polynomial identity for weight 0, fibre 0, fixed pole 0. -/
theorem b65e_fixedWeight_certificate_0_0_0 :
    b65e_velocityPolynomialQ 0 * b65e_fixedInverseQ 0 0 =
      b65e_reducedFixedWeightQ 0 0 0 + b65e_fibrePolynomialQ 0 *
        b65e_fixedWeightQuotQ 0 0 0 := by
  have h := b65e_polynomial_mul_certificate (b65e_velocityQ 0) (b65e_fixedInverseCoeffQ 0 0)
    (b65e_fixedWeightCoeffQ 0 0 0) (b65q_fibreCoeff 0)
    (b65e_fixedWeightQuotCoeffQ 0 0 0) (by decide +kernel)
  simpa only [b65e_ofFn_eq_sum, b65e_velocityPolynomialQ, b65e_fixedInverseQ,
    b65e_reducedFixedWeightQ, b65e_fibrePolynomialQ, b65e_fixedWeightQuotQ,
    map_neg, neg_mul, Finset.sum_neg_distrib] using h

