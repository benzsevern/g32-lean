theorem b65e_fixedWeight_certificate_1_1_3 :
    -(b65e_reducedFixedWeightQ 0 1 3) * b65e_reducedFixedWeightQ 0 1 3 =
      b65e_reducedFixedWeightQ 1 1 3 + b65e_fibrePolynomialQ 1 *
        b65e_fixedWeightQuotQ 1 1 3 := by
  have h := b65e_polynomial_mul_certificate (fun c ↦ -b65e_fixedWeightCoeffQ 0 1 3 c) (b65e_fixedWeightCoeffQ 0 1 3)
    (b65e_fixedWeightCoeffQ 1 1 3) (b65q_fibreCoeff 1)
    (b65e_fixedWeightQuotCoeffQ 1 1 3) (by decide +kernel)
  simpa only [b65e_ofFn_eq_sum, b65e_velocityPolynomialQ, b65e_fixedInverseQ,
    b65e_reducedFixedWeightQ, b65e_fibrePolynomialQ, b65e_fixedWeightQuotQ,
    map_neg, neg_mul, Finset.sum_neg_distrib] using h

