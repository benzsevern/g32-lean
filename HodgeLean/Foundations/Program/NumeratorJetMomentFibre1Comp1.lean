import HodgeLean.Foundations.Program.NumeratorJetNumeratorDefs

/-! # Checks of the moving-moment coordinates, fibre 1, component 1 -/

namespace HodgeLean.Foundations.Program

set_option maxHeartbeats 400000 in
/-- The stored moving-moment coordinates satisfy their convolution formula. -/
theorem b65e_WT_table_1_1_0 :
    ∀ n : Fin 8, ∀ c : Fin 6, b65e_WTQ 1 1 0 n c = b65e_WTFormulaQ 1 1 0 n.val c := by
  decide +kernel

