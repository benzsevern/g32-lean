/-- Every stored moving coordinate through order seven satisfies its rational contraction. -/
theorem b65e_movingContraction_table (n : Fin 7) (e : Fin 2) (c : Fin 6) (i j : Fin 4) :
    b65e_movingContractionCoordsQ n e c i j =
      ((n : ℕ) + 1 : ℚ) * b65e_movingJet (Fin.ofNat 8 ((n : ℕ) + 1)) e c i j := by
  fin_cases n <;> fin_cases e
  · show b65e_movingContractionCoordsQ 0 0 c i j =
      (((0 : ℕ) : ℚ) + 1) * b65e_movingJet 1 0 c i j
    rw [b65e_movingContraction_table_0_0]
    norm_num
  · show b65e_movingContractionCoordsQ 0 1 c i j =
      (((0 : ℕ) : ℚ) + 1) * b65e_movingJet 1 1 c i j
    rw [b65e_movingContraction_table_0_1]
    norm_num
  · show b65e_movingContractionCoordsQ 1 0 c i j =
      (((1 : ℕ) : ℚ) + 1) * b65e_movingJet 2 0 c i j
    rw [b65e_movingContraction_table_1_0]
    norm_num
  · show b65e_movingContractionCoordsQ 1 1 c i j =
      (((1 : ℕ) : ℚ) + 1) * b65e_movingJet 2 1 c i j
    rw [b65e_movingContraction_table_1_1]
    norm_num
  · show b65e_movingContractionCoordsQ 2 0 c i j =
      (((2 : ℕ) : ℚ) + 1) * b65e_movingJet 3 0 c i j
    rw [b65e_movingContraction_table_2_0]
    norm_num
  · show b65e_movingContractionCoordsQ 2 1 c i j =
      (((2 : ℕ) : ℚ) + 1) * b65e_movingJet 3 1 c i j
    rw [b65e_movingContraction_table_2_1]
    norm_num
  · show b65e_movingContractionCoordsQ 3 0 c i j =
      (((3 : ℕ) : ℚ) + 1) * b65e_movingJet 4 0 c i j
    rw [b65e_movingContraction_table_3_0]
    norm_num
  · show b65e_movingContractionCoordsQ 3 1 c i j =
      (((3 : ℕ) : ℚ) + 1) * b65e_movingJet 4 1 c i j
    rw [b65e_movingContraction_table_3_1]
    norm_num
  · show b65e_movingContractionCoordsQ 4 0 c i j =
      (((4 : ℕ) : ℚ) + 1) * b65e_movingJet 5 0 c i j
    rw [b65e_movingContraction_table_4_0]
    norm_num
  · show b65e_movingContractionCoordsQ 4 1 c i j =
      (((4 : ℕ) : ℚ) + 1) * b65e_movingJet 5 1 c i j
    rw [b65e_movingContraction_table_4_1]
    norm_num
  · show b65e_movingContractionCoordsQ 5 0 c i j =
      (((5 : ℕ) : ℚ) + 1) * b65e_movingJet 6 0 c i j
    rw [b65e_movingContraction_table_5_0]
    norm_num
  · show b65e_movingContractionCoordsQ 5 1 c i j =
      (((5 : ℕ) : ℚ) + 1) * b65e_movingJet 6 1 c i j
    rw [b65e_movingContraction_table_5_1]
    norm_num
  · show b65e_movingContractionCoordsQ 6 0 c i j =
      (((6 : ℕ) : ℚ) + 1) * b65e_movingJet 7 0 c i j
    rw [b65e_movingContraction_table_6_0]
    norm_num
  · show b65e_movingContractionCoordsQ 6 1 c i j =
      (((6 : ℕ) : ℚ) + 1) * b65e_movingJet 7 1 c i j
    rw [b65e_movingContraction_table_6_1]
    norm_num

/-- The stored moving-pole entries satisfy the actual finite field recurrence. -/
theorem b65e_moving_stored_step (p : Fin 12 → ℂ) (O : b65p_Outputs p)
    (n : Fin 7) (x : Fin 12) (i j : Fin 4) :
    b65e_fieldCoeff p (b65e_storedResidue p) n (.inr x) i j =
      ((n : ℕ) + 1 : ℂ) * b65e_storedResidue p ((n : ℕ) + 1) (.inr x) i j := by
  rw [← b65e_movingContraction_field p O n x i j]
  simp only [b65e_movingContraction_table]
  rw [b65e_coordinateEvalQ_scale, b65e_movingJet_coordinateEval]
  push_cast
  rfl

