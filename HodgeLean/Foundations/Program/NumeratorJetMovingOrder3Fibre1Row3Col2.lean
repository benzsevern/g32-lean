import HodgeLean.Foundations.Program.NumeratorJetMovingCoordinateField

/-! # Rational moving-pole contractions at order 3, fibre 1, row 3 -/

noncomputable section
namespace HodgeLean.Foundations.Program

set_option maxHeartbeats 400000 in
/-- Stored order-3 moving-residue coordinate satisfies its rational field contraction. -/
theorem b65e_movingContractionCoordsQ_table_2_1_0_3_2 :
    b65e_movingContractionCoordsQ 2 1 0 3 2 = 3 * b65e_movingJet 3 1 0 3 2 := by
  decide +kernel

