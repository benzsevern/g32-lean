set_option maxHeartbeats 400000 in
/-- Stored order-4 moving-residue coordinate satisfies its rational field contraction. -/
theorem b65e_movingContractionCoordsQ_table_3_0_0_1_3 :
    b65e_movingContractionCoordsQ 3 0 0 1 3 = 4 * b65e_movingJet 4 0 0 1 3 := by
  decide +kernel

