/-- Stored order-4 moving-residue coordinate satisfies its rational field contraction. -/
theorem b65e_movingContractionCoordsQ_table_3_0_0_2_3 :
    b65e_movingContractionCoordsQ 3 0 0 2 3 = 4 * b65e_movingJet 4 0 0 2 3 := by
  decide +kernel

