import HodgeLean.Foundations.Program.NumeratorJetMovingCoordinateField

/-! # Rational moving-pole contractions at order 4, fibre 1, row 2 -/

noncomputable section
namespace HodgeLean.Foundations.Program

set_option maxHeartbeats 400000 in
/-- Stored order-4 moving-residue coordinate satisfies its rational field contraction. -/
theorem b65e_movingContractionCoordsQ_table_3_1_0_2_2 :
    b65e_movingContractionCoordsQ 3 1 0 2 2 = 4 * b65e_movingJet 4 1 0 2 2 := by
  decide +kernel

