set_option maxHeartbeats 400000 in
/-- Stored order-4 moving-residue coordinate satisfies its rational field contraction. -/
theorem b65e_movingContractionCoordsQ_table_3_1_0_3_1 :
    b65e_movingContractionCoordsQ 3 1 0 3 1 = 4 * b65e_movingJet 4 1 0 3 1 := by
  decide +kernel

