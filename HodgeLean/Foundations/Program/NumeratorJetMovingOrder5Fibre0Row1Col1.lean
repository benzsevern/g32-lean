/-- Stored order-5 moving-residue coordinate satisfies its rational field contraction. -/
theorem b65e_movingContractionCoordsQ_table_4_0_0_1_1 :
    b65e_movingContractionCoordsQ 4 0 0 1 1 = 5 * b65e_movingJet 5 0 0 1 1 := by
  decide +kernel

