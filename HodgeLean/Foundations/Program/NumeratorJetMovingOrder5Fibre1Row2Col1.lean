set_option maxHeartbeats 400000 in
/-- Stored order-5 moving-residue coordinate satisfies its rational field contraction. -/
theorem b65e_movingContractionCoordsQ_table_4_1_0_2_1 :
    b65e_movingContractionCoordsQ 4 1 0 2 1 = 5 * b65e_movingJet 5 1 0 2 1 := by
  decide +kernel

