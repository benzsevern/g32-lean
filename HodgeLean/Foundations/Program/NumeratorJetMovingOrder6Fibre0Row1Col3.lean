/-- Stored order-6 moving-residue coordinate satisfies its rational field contraction. -/
theorem b65e_movingContractionCoordsQ_table_5_0_0_1_3 :
    b65e_movingContractionCoordsQ 5 0 0 1 3 = 6 * b65e_movingJet 6 0 0 1 3 := by
  decide +kernel

