/-- Stored order-6 moving-residue coordinate satisfies its rational field contraction. -/
theorem b65e_movingContractionCoordsQ_table_5_1_0_2_0 :
    b65e_movingContractionCoordsQ 5 1 0 2 0 = 6 * b65e_movingJet 6 1 0 2 0 := by
  decide +kernel

