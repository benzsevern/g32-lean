set_option maxHeartbeats 400000 in
/-- Stored order-7 moving-residue coordinate satisfies its rational field contraction. -/
theorem b65e_movingContractionCoordsQ_table_6_1_0_1_0 :
    b65e_movingContractionCoordsQ 6 1 0 1 0 = 7 * b65e_movingJet 7 1 0 1 0 := by
  decide +kernel

