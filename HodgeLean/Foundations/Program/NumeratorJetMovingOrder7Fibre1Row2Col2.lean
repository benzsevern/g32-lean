set_option maxHeartbeats 400000 in
/-- Stored order-7 moving-residue coordinate satisfies its rational field contraction. -/
theorem b65e_movingContractionCoordsQ_table_6_1_0_2_2 :
    b65e_movingContractionCoordsQ 6 1 0 2 2 = 7 * b65e_movingJet 7 1 0 2 2 := by
  decide +kernel

