import HodgeLean.Foundations.Program.NumeratorJetTensorCoordinates
import HodgeLean.Foundations.Program.NumeratorJetPoleWeights

/-! # Rational tensor weights for the finite geometric recurrences -/

noncomputable section
namespace HodgeLean.Foundations.Program

/-- Divided-difference coordinates from seven polynomial coefficients. -/
def b65e_tensorDifferenceCoordsQ (g : Fin 7 → ℚ) (a b : Fin 6) : ℚ :=
  if h : a.val + b.val + 1 < 7 then g ⟨a.val + b.val + 1, h⟩ else 0

/-- Seven-coordinate extension of the velocity coefficient vector. -/
def b65e_velocitySevenQ (e : Fin 2) (a : Fin 7) : ℚ :=
  if h : a.val < 6 then b65e_velocityQ e ⟨a.val, h⟩ else 0

/-- Initial tensor-weight coordinates assembled from the rational velocity and inverse. -/
def b65e_initialTensorCoordsQ (e d : Fin 2) (c h : Fin 6) : ℚ :=
  if d = e then b65e_tensorDifferenceCoordsQ (b65e_velocitySevenQ e) c h else
    b65e_coordinateMulQ e
      (b65e_coordinateMulQ e (fun a ↦ b65e_velocityQ e a - b65e_velocityQ d a)
        (b65e_crossInverseCoeffQ e))
      (fun a ↦ b65e_tensorDifferenceCoordsQ (b65q_fibreCoeff d) a h) c +
    b65e_tensorDifferenceCoordsQ (b65e_velocitySevenQ d) c h

