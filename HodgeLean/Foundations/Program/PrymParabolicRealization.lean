/-! ## Cellular homology -/

/-- **The lifted complex is a chain complex** when `g₀ ⋯ g_{r−1} = 1`: `∂₁ ∘ ∂₂ = 0`, over any
commutative ring. Product one enters only at `B_{r−1}`, whose faces `h_{r−1}` and `f₀` end at
`b_∞(x (g₀ ⋯ g_{r−1})⁻¹)` and `b_∞(x)`.
Source: Hatcher, *Algebraic Topology*, §2.1; G32 v0.16, Figure 1 and §3.1. -/
theorem hg2_boundary_comp (R : Type*) [CommRing R] {G : Type*} [Group G] {r : ℕ}
    (g : Fin r → G) (hprod : (List.ofFn g).prod = 1) :
    hg2_bd1 R g ∘ₗ hg2_bd2 R g = 0 :=
  hg2_boundary_comp_aux R g hprod

example (R : Type*) [CommRing R] {G : Type*} [Group G] {r : ℕ}
    (g : Fin r → G) (hprod : (List.ofFn g).prod = 1) :
    hg2_bd1 R g ∘ₗ hg2_bd2 R g = 0 :=
  hg2_boundary_comp R g hprod

/-! ## The combinatorial monodromy -/

/-- **Endpoint transport along `ℓ_i = f_i f_{i+1}⁻¹`.** Under product one, the lift of `f_i` from
`b₀(x)` and the lift of `f_{i+1}` from `b₀(y)` reach the same point over `b_∞` exactly when
`y = x g_i`. So the lift of `ℓ_i` from `b₀(x)` ends at `b₀(x g_i)`: sheet `x` goes to `x g_i`,
the convention of H6 and of the marked root cover (monodromy `op (g_i)` in `Gᵐᵒᵖ`).
Source: Hatcher, §1.3 (path lifting and the monodromy action on a fibre); G32 v0.16, Figure 1. -/
theorem hg2_loop_transport {G : Type*} [Group G] {r : ℕ} (g : Fin r → G)
    (hprod : (List.ofFn g).prod = 1) (i : Fin r) (x y : G) :
    hg2_tgt g (Sum.inr (Sum.inl (finRotate r i, y))) = hg2_tgt g (Sum.inr (Sum.inl (i, x))) ↔
      y = x * g i :=
  hg2_loop_transport_aux g hprod i x y

example {G : Type*} [Group G] {r : ℕ} (g : Fin r → G)
    (hprod : (List.ofFn g).prod = 1) (i : Fin r) (x y : G) :
    hg2_tgt g (Sum.inr (Sum.inl (finRotate r i, y))) = hg2_tgt g (Sum.inr (Sum.inl (i, x))) ↔
      y = x * g i :=
  hg2_loop_transport g hprod i x y

/-- **Ramification over `p_i`.** Every point `p_i(c)` over the `i`-th branch vertex is the end
of exactly `ord(g_i)` of the lifts `e_i(y)` of the edge `b₀ → p_i` (`Nat.card` and `orderOf` are
both `0` for an element of infinite order).
Source: Hatcher, §1.3; Forster, *Lectures on Riemann Surfaces*, Theorem 4.23 (local normal form
of a branched covering). -/
theorem hg2_ramification {G : Type*} [Group G] {r : ℕ} (g : Fin r → G) (i : Fin r)
    (c : G ⧸ Subgroup.zpowers (g i)) :
    Nat.card {y : G // hg2_tgt g (Sum.inl (i, y)) = Sum.inr (Sum.inr ⟨i, c⟩)} =
      orderOf (g i) :=
  hg2_ramification_aux g i c

example {G : Type*} [Group G] {r : ℕ} (g : Fin r → G) (i : Fin r)
    (c : G ⧸ Subgroup.zpowers (g i)) :
    Nat.card {y : G // hg2_tgt g (Sum.inl (i, y)) = Sum.inr (Sum.inr ⟨i, c⟩)} =
      orderOf (g i) :=
  hg2_ramification g i c

/-! ## The surface -/

/-- **The integral `2`-cycles are the multiples of the orientation chain** for a finite group, a
generating tuple and product one. Each edge lies on exactly two triangles, with opposite signs
in `Σ (A − B)`, and the triangles are connected through edges.
Source: Hatcher, §3.3 (Theorem 3.26: `H_n` of a compact connected orientable `n`-manifold
without boundary); G32 v0.16, Figure 1. -/
theorem hg2_cycles2 {G : Type*} [Group G] [Fintype G] {r : ℕ} (g : Fin r → G)
    (hprod : (List.ofFn g).prod = 1) (hg : Subgroup.closure (Set.range g) = ⊤) :
    LinearMap.ker (hg2_bd2 ℤ g) = Submodule.span ℤ {hg2_orient} :=
  hg2_cycles2_aux g hprod hg

example {G : Type*} [Group G] [Fintype G] {r : ℕ} (g : Fin r → G)
    (hprod : (List.ofFn g).prod = 1) (hg : Subgroup.closure (Set.range g) = ⊤) :
    LinearMap.ker (hg2_bd2 ℤ g) = Submodule.span ℤ {hg2_orient} :=
  hg2_cycles2 g hprod hg

/-- **Integral `H₁` and Riemann–Hurwitz.** For a finite group, a generating tuple and product
one, cellular `H₁(X̃; ℤ)` is free and finite, of rank `2·genus`, where
`rank + 2|G| + Σ_i |G/⟨g_i⟩| = r|G| + 2`.
Source: Hatcher, §2.2 (Euler characteristic) and §3.3 (`H₁` of a compact orientable surface
without boundary is free); Forster, *Lectures on Riemann Surfaces*, Theorem 17.14. -/
theorem hg2_H1_rank {G : Type*} [Group G] [Finite G] {r : ℕ} (g : Fin r → G)
    (hprod : (List.ofFn g).prod = 1) (hg : Subgroup.closure (Set.range g) = ⊤) :
    Module.Free ℤ (hg2_H1 ℤ g) ∧ Module.Finite ℤ (hg2_H1 ℤ g) ∧
      (Module.finrank ℤ (hg2_H1 ℤ g) : ℤ) + 2 * Nat.card G +
          ∑ i, (Nat.card (G ⧸ Subgroup.zpowers (g i)) : ℤ) =
        r * Nat.card G + 2 :=
  hg2_H1_rank_aux g hprod hg

example {G : Type*} [Group G] [Finite G] {r : ℕ} (g : Fin r → G)
    (hprod : (List.ofFn g).prod = 1) (hg : Subgroup.closure (Set.range g) = ⊤) :
    Module.Free ℤ (hg2_H1 ℤ g) ∧ Module.Finite ℤ (hg2_H1 ℤ g) ∧
      (Module.finrank ℤ (hg2_H1 ℤ g) : ℤ) + 2 * Nat.card G +
          ∑ i, (Nat.card (G ⧸ Subgroup.zpowers (g i)) : ℤ) =
        r * Nat.card G + 2 :=
  hg2_H1_rank g hprod hg

/-- **Universal coefficients on the lifted complex.** Under product one and for any field `K`,
the evaluation pairing `⟨c, z⟩ = Σ_ε z(ε) c(ε)` induces a `K`-linear isomorphism from cellular
`H¹(X̃; K)` to `Hom_ℤ(H₁(X̃; ℤ), K)`. (`H₀` of a graph is free, so the `Ext` term vanishes.)
Source: Hatcher, §3.1, Theorem 3.2 (universal coefficient theorem for cohomology). -/
theorem hg2_uct (K : Type*) [Field K] {G : Type*} [Group G] {r : ℕ} (g : Fin r → G)
    (hprod : (List.ofFn g).prod = 1) :
    ∃ e : hg2_coH1 K g ≃ₗ[K] (hg2_H1 ℤ g →ₗ[ℤ] K),
      ∀ (c : LinearMap.ker (hg2_delta1 K K g)) (z : LinearMap.ker (hg2_bd1 ℤ g)),
        e (Submodule.Quotient.mk c) (Submodule.Quotient.mk z) = hg2_pair K c.1 z.1 :=
  hg2_uct_aux K g hprod

example (K : Type*) [Field K] {G : Type*} [Group G] {r : ℕ} (g : Fin r → G)
    (hprod : (List.ofFn g).prod = 1) :
    ∃ e : hg2_coH1 K g ≃ₗ[K] (hg2_H1 ℤ g →ₗ[ℤ] K),
      ∀ (c : LinearMap.ker (hg2_delta1 K K g)) (z : LinearMap.ker (hg2_bd1 ℤ g)),
        e (Submodule.Quotient.mk c) (Submodule.Quotient.mk z) = hg2_pair K c.1 z.1 :=
  hg2_uct K g hprod

/-! ## The B6-3b projector on the G32 complex -/

/-- **The B6-3b projector has image of rank twelve** on cellular `H₁(X̃(b4b_root); ℤ)`. Over `ℂ`
the operator is `3(|G|/4)(e_ρ + e_ρ̄)` for primitive idempotents of the natural representation
`ρ` and its conjugate, so the rank is `m_ρ + m_ρ̄`; by Shapiro's lemma on `X̃` (H3a, first and
second chain checks) and universal coefficients each multiplicity is `dim pc_Vpar = 6`.
Source: G32 v0.16, Definition 3.2, Proposition 3.1 and Lemma 6.2; Serre, *Linear
Representations of Finite Groups*, §2.2 and §2.6; `b63d_projectorCoeff_complex`. -/
theorem hg2_projector_rank : Module.finrank ℤ (LinearMap.range hg2_projector) = 12 :=
  hg2_projector_rank_aux

example : Module.finrank ℤ (LinearMap.range hg2_projector) = 12 := hg2_projector_rank

/-! ## Satisfiability against `b4b_root` -/

/-- The G32 root satisfies every hypothesis on the tuple: product one, generation, a finite
group. -/
example : (List.ofFn b4b_root).prod = 1 ∧ Subgroup.closure (Set.range b4b_root) = ⊤ ∧
    Finite b4b_Group :=
  ⟨b63d_root_product, b63d_root_subgroup, inferInstance⟩

/-- **The monodromy at `b4b_root` is nowhere trivial**: from statement 2, the lift of every loop
`ℓ_i` from every sheet `b₀(x)` ends on a different sheet, since no `b4b_root i` is `1`. -/
example (i : Fin 13) (x : b4b_Group) :
    hg2_tgt b4b_root (Sum.inr (Sum.inl (finRotate 13 i, x))) ≠
      hg2_tgt b4b_root (Sum.inr (Sum.inl (i, x))) := by
  intro h
  have h1 := (hg2_loop_transport b4b_root b63d_root_product i x x).mp h
  have h2 : b4b_root i = 1 := by
    have := congrArg (x⁻¹ * ·) h1
    simpa using this.symm
  have h3 := b63_root_order i
  rw [h2, orderOf_one] at h3
  split_ifs at h3 <;> omega

/-- **Ramification at `b4b_root`** (statement 3 with `b63_root_order`): index `3` over the twelve
finite marks and `2` over the last one. -/
example (i : Fin 13) (c : b4b_Group ⧸ Subgroup.zpowers (b4b_root i)) :
    Nat.card {y : b4b_Group //
        hg2_tgt b4b_root (Sum.inl (i, y)) = Sum.inr (Sum.inr ⟨i, c⟩)} =
      if i = 12 then 2 else 3 := by
  rw [hg2_ramification, b63_root_order]

/-- Statements 1, 4, 5 and 6 apply to `b4b_root`. -/
example : hg2_bd1 ℤ b4b_root ∘ₗ hg2_bd2 ℤ b4b_root = 0 ∧
    LinearMap.ker (hg2_bd2 ℤ b4b_root) = Submodule.span ℤ {hg2_orient} ∧
    Module.Free ℤ (hg2_H1 ℤ b4b_root) ∧ Module.Finite ℤ (hg2_H1 ℤ b4b_root) ∧
    Nonempty (hg2_coH1 ℚ b4b_root ≃ₗ[ℚ] (hg2_H1 ℤ b4b_root →ₗ[ℤ] ℚ)) :=
  ⟨hg2_boundary_comp ℤ b4b_root b63d_root_product,
    hg2_cycles2 b4b_root b63d_root_product b63d_root_subgroup,
    (hg2_H1_rank b4b_root b63d_root_product b63d_root_subgroup).1,
    (hg2_H1_rank b4b_root b63d_root_product b63d_root_subgroup).2.1,
    ⟨(hg2_uct ℚ b4b_root b63d_root_product).choose⟩⟩

/-! ## A non-degenerate instance: the elliptic double cover -/

/-- The tuple `(−1, −1, −1, −1)` in `ℤˣ`: the double cover of the sphere branched at four
points.
Source: Forster, *Lectures on Riemann Surfaces*, Theorem 17.14 (Riemann–Hurwitz);
Hatcher, *Algebraic Topology*, §1.3 (covering monodromy). -/
def hg2_ellTuple : Fin 4 → ℤˣ := fun _ => -1

example : hg2_ellTuple 0 = -1 := rfl

theorem hg2_ell_zpowers : Subgroup.zpowers (-1 : ℤˣ) = ⊤ := by
  rw [Subgroup.eq_top_iff']
  intro u
  rcases Int.units_eq_one_or u with h | h
  · rw [h]; exact Subgroup.one_mem _
  · rw [h]; exact Subgroup.mem_zpowers _

theorem hg2_ell_hyps : (List.ofFn hg2_ellTuple).prod = 1 ∧
    Subgroup.closure (Set.range hg2_ellTuple) = ⊤ := by
  refine ⟨by simp [hg2_ellTuple, List.ofFn_succ], ?_⟩
  rw [eq_top_iff, ← hg2_ell_zpowers, Subgroup.zpowers_eq_closure]
  exact Subgroup.closure_mono (Set.singleton_subset_iff.mpr ⟨0, rfl⟩)

/-- **Rank two, not zero**: from statement 5, `H₁` of the elliptic double cover is free of rank
`2` (genus one). -/
theorem hg2_ell_rank : Module.finrank ℤ (hg2_H1 ℤ hg2_ellTuple) = 2 := by
  have h := (hg2_H1_rank hg2_ellTuple hg2_ell_hyps.1 hg2_ell_hyps.2).2.2
  have hG : Nat.card ℤˣ = 2 := by
    rw [Nat.card_eq_fintype_card, Fintype.card_units_int]
  have hQ : ∀ i, Nat.card (ℤˣ ⧸ Subgroup.zpowers (hg2_ellTuple i)) = 1 := fun i => by
    change (Subgroup.zpowers (-1 : ℤˣ)).index = 1
    rw [Subgroup.index_eq_one]
    exact hg2_ell_zpowers
  simp only [hG, hQ, Finset.sum_const, Finset.card_univ, Fintype.card_fin] at h
  push_cast at h
  simp only [nsmul_eq_mul] at h
  omega

example : Module.finrank ℤ (hg2_H1 ℤ hg2_ellTuple) ≠ 0 := by
  rw [hg2_ell_rank]; omega

/-! ## Chain checks -/

/-- **Chain check 1 (universal coefficients and Riemann–Hurwitz).** Under the hypotheses of
statement 5, `dim_ℚ H¹(X̃; ℚ) = rank_ℤ H₁(X̃; ℤ)`, from statements 5 and 6. -/
theorem hg2_coH1_finrank {G : Type*} [Group G] [Finite G] {r : ℕ} (g : Fin r → G)
    (hprod : (List.ofFn g).prod = 1) (hg : Subgroup.closure (Set.range g) = ⊤) :
    Module.finrank ℚ (hg2_coH1 ℚ g) = Module.finrank ℤ (hg2_H1 ℤ g) := by
  obtain ⟨hfree, hfin, -⟩ := hg2_H1_rank g hprod hg
  obtain ⟨e, -⟩ := hg2_uct ℚ g hprod
  let b := Module.finBasis ℤ (hg2_H1 ℤ g)
  rw [e.finrank_eq, ← (b.constr ℚ).finrank_eq, Module.finrank_fin_fun]

/-- The elliptic instance: `dim_ℚ H¹ = 2`. -/
example : Module.finrank ℚ (hg2_coH1 ℚ hg2_ellTuple) = 2 := by
  rw [hg2_coH1_finrank hg2_ellTuple hg2_ell_hyps.1 hg2_ell_hyps.2, hg2_ell_rank]

/-- **Chain check 2 (toward `b63d_lattice_rank`).** The image of the B6-3b projector on cellular
`H₁(X̃(b4b_root); ℤ)` has a `ℤ`-basis indexed by `Fin 12`, from statements 5 and 7. -/
theorem hg2_projector_basis :
    Nonempty (Module.Basis (Fin 12) ℤ (LinearMap.range hg2_projector)) := by
  obtain ⟨hfree, hfin, -⟩ := hg2_H1_rank b4b_root b63d_root_product b63d_root_subgroup
  exact ⟨Module.finBasisOfFinrankEq ℤ _ hg2_projector_rank⟩

/-- **Chain check 3 (toward H5).** For any fibre satisfying the hypotheses of
`b63d_lattice_rank`, the projected cellular lattice and the B6-3 parameter lattice are
isomorphic as `ℤ`-modules (both free of rank `12`). This is only the rank comparison H5
refines to an equivariant, isometric one. -/
theorem hg2_lattice_rank_match (b : Fin 10 → ℂ) (C : Type) [TopologicalSpace C]
    [MulAction b4b_Group C]
    (hC : ∀ g : b4b_Group, Continuous (fun x : C ↦ g • x))
    (V : Set (Fin 10 → ℂ)) (hV : V ⊆ b6t_polydisc b) (t : V)
    [ChartedSpace ℂ (b63l_parameterFibre b C V hV t)]
    [IsManifold 𝓘(ℂ, ℂ) ω (b63l_parameterFibre b C V hV t)]
    [T2Space (b63l_parameterFibre b C V hV t)] [CompactSpace (b63l_parameterFibre b C V hV t)]
    [ConnectedSpace (b63l_parameterFibre b C V hV t)]
    (hG : ∀ g : b4b_Group, ContMDiff 𝓘(ℂ, ℂ) 𝓘(ℂ, ℂ) ω
      (fun x : b63l_parameterFibre b C V hV t ↦ g • x))
    [FaithfulSMul b4b_Group (b63l_parameterFibre b C V hV t)]
    (hb : b ∈ b6_chart) (f : C → OnePoint ℂ)
    (hf : ContMDiff 𝓘(ℂ, ℂ) 𝓘(ℂ, ℂ) ω (b63d_projection b C f V hV t))
    (hs : Function.Surjective (b63d_projection b C f V hV t))
    (hgal : b4_IsGaloisCover b4b_Group (b63d_projection b C f V hV t))
    (hbranch : b4_branchSet ℂ ℂ (b63d_projection b C f V hV t) = Set.range (b6_branch t.val))
    (hrot : ∀ i : Fin 13, ∃ x : b63l_parameterFibre b C V hV t,
      b63d_projection b C f V hV t x = b6_branch t.val i ∧ b4_IsRotGen ℂ x (b4b_root i)) :
    Nonempty (LinearMap.range hg2_projector ≃ₗ[ℤ] b63l_parameterLattice b C hC V hV t) := by
  obtain ⟨b₁⟩ := hg2_projector_basis
  obtain ⟨⟨b₂⟩, -⟩ := b63d_lattice_rank b C hC V hV t hG hb f hf hs hgal hbranch hrot
  exact ⟨b₁.equiv b₂ (Equiv.refl _)⟩

end HodgeLean.Foundations.Program
