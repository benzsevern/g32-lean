import HodgeLean.Foundations.Program.PrymParabolicSkeletaCells

/-! # Model cells for stage H3b step C: the edge `(I, {0, 1})` and the triangle `(Δ², ∂Δ²)`

The relative homology of the model edge: `H₁(I, {0, 1}; ℤ)` is infinite cyclic, generated by the
class of the identity path (`hg8_I_H1_span`, `hg8_Igen_smul_eq_zero`), and `H_k(I, {0, 1}) = 0`
for `k ≠ 1` (`hg8_I_H_eq_zero`), from the long exact sequence of the pair, contractibility of `I`
and `H₀` of a finite discrete space (`hg8_pointClass_bijective`). The deformation of
`I ∖ {1/2}` onto the endpoints makes `(I, {0, 1})` a model cell (`hg8_Imodel`).

The boundary `∂Δ²` is a graph with three edges over the vertices (`hg8_bdCells`), so
`H₁(∂Δ², vertices)` is free on the faces and `H_k(∂Δ²) = 0` for `k ≥ 2`; with the long exact
sequence and contractibility of `Δ²`, `H₂(Δ², ∂Δ²; ℤ)` is infinite cyclic, generated by the class of
the identity triangle (`hg8_T_H2_span`, `hg8_Tgen_smul_eq_zero`), and `H_k(Δ², ∂Δ²) = 0` for
`k ≠ 2` (`hg8_T_H_eq_zero`). The radial deformation of `Δ² ∖ {barycentre}` onto `∂Δ²` makes it a
model cell (`hg8_Tmodel`).
HC no distance; AV milestone no distance.
-/

noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicTopology AlgebraicTopology.Singular Convexity

namespace HodgeLean.Foundations.Program

/-- Naturality of explicit relative classes. -/
theorem hg8_relClass_map (R : Type) [CommRing R] {P Q : TopPair.{0}} (f : P ⟶ Q) (n : ℕ)
    (w : hg8_relCycles R P n)
    (hw : ((((singularChainComplexFunctor (ModuleCat.{0} R)).obj (ModuleCat.of R R)).map
      (TopPair.Hom.fst f)).f (n + 1)).hom w.1 ∈ hg8_relCycles R Q n) :
    relativeHomologyMap R (n + 1) f (hg8_relClass R P n w) =
      hg8_relClass R Q n ⟨_, hw⟩ := by
  refine (ShortComplex.moduleCatHomologyClass_naturality
    ((HomologicalComplex.shortComplexFunctor (ModuleCat R) (.down ℕ) (n + 1)).map
      ((relativeChainFunctor R).map f)) _).trans
    (congrArg (ShortComplex.moduleCatHomologyClass _) (Subtype.ext ?_))
  exact ConcreteCategory.congr_hom
    (congrArg (fun g => g.f (n + 1))
      (TopPair.Homotopy.relativeChainProjection_naturality (R := R) f)) w.1

/-- The classes of points in `H₀`: `c ↦ [Σ c(i) v(i)]`. -/
def hg8_pointClass {X ι : Type} [TopologicalSpace X] (v : ι → X) :=
  ((SingularChainComplex ℤ (TopCat.of X)).sc 0).moduleCatHomologyClass ∘ₗ
    LinearMap.codRestrict (LinearMap.ker ((SingularChainComplex ℤ (TopCat.of X)).sc 0).g.hom)
      (hg5_chain0 v : (ι →₀ ℤ) →ₗ[ℤ] ((SingularChainComplex ℤ (TopCat.of X)).sc 0).X₂)
      (fun _ ↦ hg8_d_zero_eq_zero _ _ _)

/-- **`H₀` of a discrete space** is free on its points.
Source: Hatcher, *Algebraic Topology*, Proposition 2.7. -/
theorem hg8_pointClass_bijective {X ι : Type} [TopologicalSpace X] [DiscreteTopology X]
    (v : ι → X) (hv : Function.Bijective v) : Function.Bijective (hg8_pointClass v) := by
  classical
  let K := SingularChainComplex ℤ (TopCat.of X)
  have hd : ∀ i (a : K.X i), (K.d i 0).hom a = 0 := by
    intro i a
    by_cases hi : i = 1
    · subst hi
      change Simplicial.boundary ℤ 0 (X := TopCat.toSSet.obj (TopCat.of X)) a = 0
      rw [hg8_boundary_discrete X]
      rfl
    · rw [HomologicalComplex.shape _ _ _ (by simp only [ComplexShape.down_Rel]; omega)]
      rfl
  constructor
  · intro c₁ c₂ hc
    rw [← sub_eq_zero, ← map_sub] at hc
    rw [← sub_eq_zero]
    set c := c₁ - c₂
    have h1 : hg5_chain0 v c = 0 := by
      obtain ⟨a, ha⟩ := (hg8_homologyClass_eq_zero_iff (K.sc 0) _).1 hc
      exact ha.symm.trans (hd _ a)
    ext i
    rw [Finsupp.zero_apply]
    let f : (TopCat.toSSet.obj (TopCat.of X)).obj (Opposite.op (SimplexCategory.mk 0)) → ℤ :=
      fun σ ↦ if TopCat.toSSetObj₀Equiv σ = v i then 1 else 0
    have h2 := congrArg (hg8_simplexFun ℤ _ 0 f) h1
    rw [map_zero] at h2
    rw [← h2]
    induction c using Finsupp.induction_linear with
    | zero => simp
    | add a b ha hb => rw [map_add, map_add, Finsupp.add_apply, ha, hb]
    | single u n =>
      simp only [hg5_chain0, Finsupp.linearCombination_single]
      erw [LinearMap.map_smul, hg8_simplexFun_chainOfSimplex]
      simp only [f, hg5_pointSimplex, Equiv.apply_symm_apply, hv.1.eq_iff, Finsupp.single_apply,
        smul_eq_mul]
      split_ifs <;> simp_all
  · have htop : LinearMap.range (hg5_chain0 v) = ⊤ := by
      apply hg8_range_eq_top
      intro σ
      obtain ⟨i, hi⟩ := hv.2 (TopCat.toSSetObj₀Equiv σ)
      refine ⟨Finsupp.single i 1, ?_⟩
      rw [hg5_chain0, Finsupp.linearCombination_single, hg5_pointSimplex, hi,
        Equiv.symm_apply_apply]
      erw [one_smul]
    intro y
    obtain ⟨w, rfl⟩ := ShortComplex.moduleCatHomologyClass_surjective _ y
    obtain ⟨c, hc⟩ := LinearMap.range_eq_top.1 htop w.1
    refine ⟨c, ?_⟩
    change ShortComplex.moduleCatHomologyClass _ (LinearMap.codRestrict _ _ _ c) = _
    congr 1
    exact Subtype.ext hc

/-! ## The model edge `(I, {0, 1})` -/

/-- The endpoints of `[0, 1]`. -/
def hg8_Iends : Set unitInterval := {0, 1}

/-- The midpoint of `[0, 1]`. -/
def hg8_half : unitInterval := ⟨1 / 2, by norm_num, by norm_num⟩

/-- Points other than the midpoint. -/
theorem hg8_half_ne (s : ({hg8_half}ᶜ : Set unitInterval)) : (s : ℝ) ≠ 1 / 2 := fun h ↦
  s.2 (Subtype.ext h)

/-- The deformation of `[0, 1] ∖ {1/2}` onto the endpoints: each half moves linearly to its end. -/
def hg8_Ideform : C(unitInterval × ({hg8_half}ᶜ : Set unitInterval), ({hg8_half}ᶜ : Set unitInterval)) where
  toFun p := ⟨⟨if (p.2 : ℝ) ≤ 1 / 2 then (1 - p.1) * p.2 else (1 - p.1) * p.2 + p.1, by
      split_ifs with h
      · exact ⟨mul_nonneg (by linarith [p.1.2.2]) p.2.1.2.1,
          by nlinarith [p.1.2.1, p.1.2.2, p.2.1.2.1, p.2.1.2.2]⟩
      · exact ⟨by nlinarith [p.1.2.1, p.1.2.2, p.2.1.2.1, p.2.1.2.2],
          by nlinarith [p.1.2.1, p.1.2.2, p.2.1.2.1, p.2.1.2.2]⟩⟩, by
      intro h
      have h' := congrArg Subtype.val (Set.mem_singleton_iff.1 h)
      have hs := hg8_half_ne p.2
      change (if (p.2 : ℝ) ≤ 1 / 2 then (1 - p.1) * p.2 else (1 - p.1) * p.2 + p.1 : ℝ) = 1 / 2
        at h'
      split_ifs at h' with hle
      · have hlt : (p.2 : ℝ) < 1 / 2 := lt_of_le_of_ne hle hs
        nlinarith [p.1.2.1, p.1.2.2, p.2.1.2.1]
      · push Not at hle
        nlinarith [p.1.2.1, p.1.2.2, p.2.1.2.2]⟩
  continuous_toFun := by
    refine Continuous.subtype_mk (Continuous.subtype_mk ?_ _) _
    refine Continuous.if_le (by fun_prop) (by fun_prop) (by fun_prop) continuous_const ?_
    intro p hp
    exact absurd hp (hg8_half_ne p.2)

/-- The model edge with its deformation.
Source: Hatcher, *Algebraic Topology*, §2.1 (the pair `(Δ¹, ∂Δ¹)`). -/
def hg8_Imodel : hg8_Model hg8_Iends hg8_half where
  ρ := hg8_Ideform
  closed := (Set.finite_singleton _).insert _ |>.isClosed
  centre := by
    rintro (h | h) <;> have := congrArg Subtype.val h <;> norm_num [hg8_half] at this
  zero y := by
    apply Subtype.ext; apply Subtype.ext
    change (if (y : ℝ) ≤ 1 / 2 then (1 - 0) * y else (1 - 0) * y + 0 : ℝ) = y
    split_ifs <;> ring
  one y := by
    change (⟨if (y : ℝ) ≤ 1 / 2 then (1 - 1) * y else (1 - 1) * y + 1, _⟩ : unitInterval) ∈
      hg8_Iends
    split_ifs
    · left; apply Subtype.ext; simp
    · right; apply Subtype.ext; simp
  fix t y hy := by
    apply Subtype.ext; apply Subtype.ext
    change (if (y : ℝ) ≤ 1 / 2 then (1 - t) * y else (1 - t) * y + t : ℝ) = y
    rcases hy with h | h <;> rw [show (y : unitInterval) = _ from h] <;> norm_num

/-- The pair `(I, {0, 1})`. -/
abbrev hg8_IPair : TopPair.{0} := TopPair.ofSubset (X := TopCat.of unitInterval) hg8_Iends

/-- The two endpoints. -/
def hg8_Iv : Fin 2 → hg8_Iends := ![⟨0, Or.inl rfl⟩, ⟨1, Or.inr rfl⟩]

/-- The endpoints are the points of `{0, 1}`. -/
theorem hg8_Iv_bijective : Function.Bijective hg8_Iv := by
  constructor
  · intro a b h
    fin_cases a <;> fin_cases b
    · rfl
    · exact absurd (congrArg (fun x : hg8_Iends ↦ ((x : unitInterval) : ℝ)) h) (by simp [hg8_Iv])
    · exact absurd (congrArg (fun x : hg8_Iends ↦ ((x : unitInterval) : ℝ)) h) (by simp [hg8_Iv])
    · rfl
  · rintro ⟨x, hx | hx⟩
    · exact ⟨0, Subtype.ext hx.symm⟩
    · exact ⟨1, Subtype.ext hx.symm⟩

instance hg8_Iends_finite : Finite hg8_Iends :=
  ((Set.finite_singleton _).insert _).to_subtype

/-- The identity path of `[0, 1]` as a relative cycle of `(I, {0, 1})`. -/
theorem hg8_Iid_relCycle :
    (hg5_chain1 (fun _ : Unit ↦ ContinuousMap.id unitInterval) (Finsupp.single () 1) :
      (SingularChainComplex ℤ hg8_IPair.fst).X (0 + 1)) ∈ hg8_relCycles ℤ hg8_IPair 0 := by
  refine ⟨hg5_chain0 hg8_Iv (Finsupp.single 1 1 - Finsupp.single 0 1), ?_⟩
  change hg8_chainMap ⟨Subtype.val, continuous_subtype_val⟩ 0
      (hg5_chain0 hg8_Iv (Finsupp.single 1 1 - Finsupp.single 0 1)) =
    Simplicial.boundary ℤ 0 (hg5_chain1 (fun _ : Unit ↦ ContinuousMap.id unitInterval)
      (Finsupp.single () 1))
  rw [hg8_chain0_map, hg5_bd_chain1 (fun _ : Unit ↦ ContinuousMap.id unitInterval)
    (Subtype.val ∘ hg8_Iv) (fun _ ↦ 0) (fun _ ↦ 1) (fun _ ↦ ⟨rfl, rfl⟩)]
  simp

/-- The generator `[id] ∈ H₁(I, {0, 1})`. -/
def hg8_Igen : RelativeHomology ℤ hg8_IPair 1 :=
  hg8_relClass ℤ hg8_IPair 0 ⟨_, hg8_Iid_relCycle⟩

/-- The boundary of `[id]` is `[1] − [0]`. -/
theorem hg8_delta_Igen :
    hg8_delta hg8_IPair 0 hg8_Igen = hg8_pointClass hg8_Iv (Finsupp.single 1 1 - Finsupp.single 0 1) := by
  refine hg8_delta_class _ (relativeChainShortComplex_shortExact ℤ hg8_IPair) 0 _
    (hg5_chain1 (fun _ : Unit ↦ ContinuousMap.id unitInterval) (Finsupp.single () 1)) rfl _ ?_
  change hg8_chainMap ⟨Subtype.val, continuous_subtype_val⟩ 0
      (hg5_chain0 hg8_Iv (Finsupp.single 1 1 - Finsupp.single 0 1)) =
    Simplicial.boundary ℤ 0 (hg5_chain1 (fun _ : Unit ↦ ContinuousMap.id unitInterval)
      (Finsupp.single () 1))
  rw [hg8_chain0_map, hg5_bd_chain1 (fun _ : Unit ↦ ContinuousMap.id unitInterval)
    (Subtype.val ∘ hg8_Iv) (fun _ ↦ 0) (fun _ ↦ 1) (fun _ ↦ ⟨rfl, rfl⟩)]
  simp

/-- Singular homology of a contractible space vanishes in positive degrees. -/
theorem hg8_homology_contractible (X : Type) [TopologicalSpace X] [ContractibleSpace X] {k : ℕ}
    (hk : k ≠ 0) (x : Homology ℤ (TopCat.of X) k) : x = 0 := by
  have h := (singularChainComplex_exactAt_of_contractible ℤ X k hk).isZero_homology
  exact (ModuleCat.isZero_iff_subsingleton.1 h).elim x 0

instance hg8_I_contractible : ContractibleSpace unitInterval :=
  (convex_Icc (0 : ℝ) 1).contractibleSpace ⟨0, by simp⟩

/-- Relative `H₀` vanishes for a nonempty subspace of a path-connected space. -/
theorem hg8_relHomology_zero (P : TopPair.{0}) [Nonempty P.snd] [PathConnectedSpace P.fst]
    (x : RelativeHomology ℤ P 0) : x = 0 := by
  have h : IsZero (RelativeHomology ℤ P 0) := by
    apply HomologicalComplex.ExactAt.isZero_homology
    refine (relativeChainShortComplex_shortExact ℤ P).exactAt_X₃ 0 ?_ ?_
    · exact TopCat.singularHomologyMap_zero_epi (X := P.snd) (Y := P.fst)
        P.map (ModuleCat.of ℤ ℤ)
    · intro j hj
      simp [ComplexShape.down_Rel] at hj
  exact (ModuleCat.isZero_iff_subsingleton.1 h).elim x 0

/-- Relative `H_{k+1}` vanishes when `H_{k+1}` of the space and `H_k` of the subspace vanish. -/
theorem hg8_relHomology_succ_eq_zero (P : TopPair.{0}) (k : ℕ)
    (h₁ : ∀ x : Homology ℤ P.fst (k + 1), x = 0) (h₂ : ∀ x : Homology ℤ P.snd k, x = 0)
    (x : RelativeHomology ℤ P (k + 1)) : x = 0 := by
  have hS := relativeChainShortComplex_shortExact ℤ P
  have hex := (ShortComplex.moduleCat_exact_iff _).1 (hS.homology_exact₃ (k + 1) k (by simp))
  obtain ⟨a, ha⟩ := hex x (h₂ _)
  obtain rfl : a = 0 := h₁ a
  exact ha.symm.trans (map_zero _)

/-- The connecting map is injective when the ambient space has no homology in that degree. -/
theorem hg8_delta_injective (P : TopPair.{0}) (k : ℕ)
    (h : ∀ x : Homology ℤ P.fst (k + 1), x = 0) : Function.Injective (hg8_delta P k) := by
  rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
  intro x hx
  have hS := relativeChainShortComplex_shortExact ℤ P
  have hex := (ShortComplex.moduleCat_exact_iff _).1 (hS.homology_exact₃ (k + 1) k (by simp))
  obtain ⟨a, ha⟩ := hex x hx
  obtain rfl : a = 0 := h a
  exact ha.symm.trans (map_zero _)

/-- Naturality of point classes. -/
theorem hg8_pointClass_map {X Y ι : Type} [TopologicalSpace X] [TopologicalSpace Y] (φ : C(X, Y))
    (v : ι → X) (c : ι →₀ ℤ) :
    (HomologicalComplex.homologyMap (((singularChainComplexFunctor (ModuleCat.{0} ℤ)).obj
      (ModuleCat.of ℤ ℤ)).map (TopCat.ofHom φ)) 0).hom (hg8_pointClass v c) =
      hg8_pointClass (φ ∘ v) c := by
  refine (ShortComplex.moduleCatHomologyClass_naturality _ _).trans
    (congrArg (ShortComplex.moduleCatHomologyClass _) (Subtype.ext ?_))
  exact hg8_chain0_map φ v c

/-- Point chains along a composite. -/
theorem hg8_chain0_mapDomain {X ι κ : Type} [TopologicalSpace X] (u : ι → κ) (w : κ → X)
    (c : ι →₀ ℤ) : hg5_chain0 (w ∘ u) c = hg5_chain0 w (Finsupp.mapDomain u c) := by
  simp only [hg5_chain0, Finsupp.linearCombination_mapDomain]
  rfl

/-- A point class in a space mapping to a point vanishes only if its coefficients sum to zero. -/
theorem hg8_pointClass_sum {X ι : Type} [TopologicalSpace X] (v : ι → X) (c : ι →₀ ℤ)
    (h : hg8_pointClass v c = 0) : c.sum (fun _ n ↦ n) = 0 := by
  have h1 := congrArg (HomologicalComplex.homologyMap (((singularChainComplexFunctor
    (ModuleCat.{0} ℤ)).obj (ModuleCat.of ℤ ℤ)).map (TopCat.ofHom
      (ContinuousMap.const X ()))) 0).hom h
  rw [hg8_pointClass_map] at h1
  replace h1 := h1.trans (map_zero _)
  have h2 : hg8_pointClass (id : Unit → Unit) (Finsupp.mapDomain (fun _ ↦ ()) c) = 0 := by
    refine Eq.trans ?_ h1
    change ShortComplex.moduleCatHomologyClass _ (LinearMap.codRestrict _ _ _ _) =
      ShortComplex.moduleCatHomologyClass _ (LinearMap.codRestrict _ _ _ _)
    congr 1
    apply Subtype.ext
    exact (hg8_chain0_mapDomain (fun _ ↦ ()) id c).symm
  have h3 := (hg8_pointClass_bijective (id : Unit → Unit) Function.bijective_id).1
    (h2.trans (map_zero _).symm)
  have h4 := congrArg (fun d : Unit →₀ ℤ ↦ d ()) h3
  simpa [Finsupp.mapDomain, Finsupp.sum_apply] using h4

/-- The boundary of a relative class lies in the kernel of the inclusion on homology. -/
theorem hg8_incl_delta (P : TopPair.{0}) (k : ℕ) (y : RelativeHomology ℤ P (k + 1)) :
    (HomologicalComplex.homologyMap (relativeChainShortComplex ℤ P).f k).hom
      (hg8_delta P k y) = 0 :=
  ConcreteCategory.congr_hom ((relativeChainShortComplex_shortExact ℤ P).δ_comp (k + 1) k
    (by simp)) y

/-- **`H₁(I, {0, 1})` is generated by `[id]`.** -/
theorem hg8_I_H1_span (y : RelativeHomology ℤ hg8_IPair 1) : ∃ n : ℤ, y = n • hg8_Igen := by
  have hinj := hg8_delta_injective hg8_IPair 0 fun x ↦ hg8_homology_contractible unitInterval
    one_ne_zero x
  obtain ⟨c, hc⟩ := (hg8_pointClass_bijective hg8_Iv hg8_Iv_bijective).2 (hg8_delta hg8_IPair 0 y)
  have h0 := hg8_incl_delta hg8_IPair 0 y
  rw [← hc] at h0
  have h0' := (hg8_pointClass_map ⟨Subtype.val, continuous_subtype_val⟩ hg8_Iv c).symm.trans h0
  have hsum := hg8_pointClass_sum _ c h0'
  rw [Finsupp.sum_fintype _ _ (by simp), Fin.sum_univ_two] at hsum
  refine ⟨c 1, hinj ?_⟩
  rw [map_zsmul, hg8_delta_Igen, ← hc]
  have hcd : c = c 1 • (Finsupp.single 1 1 - Finsupp.single 0 1 : Fin 2 →₀ ℤ) := by
    ext i
    fin_cases i <;> (simp; try linarith)
  exact (congrArg (hg8_pointClass hg8_Iv) hcd).trans (map_zsmul (hg8_pointClass hg8_Iv) (c 1) _)

/-- **`[id]` has infinite order.** -/
theorem hg8_Igen_smul_eq_zero (n : ℤ) (h : n • hg8_Igen = 0) : n = 0 := by
  have h1 := congrArg (hg8_delta hg8_IPair 0) h
  rw [map_zsmul, hg8_delta_Igen] at h1
  have h1' := (map_zsmul (hg8_pointClass hg8_Iv) n _).trans (h1.trans (map_zero _))
  have h2 := (hg8_pointClass_bijective hg8_Iv hg8_Iv_bijective).1 (h1'.trans (map_zero _).symm)
  simpa using congrArg (fun d : Fin 2 →₀ ℤ ↦ d 1) h2

/-- **`H_k(I, {0, 1}) = 0` for `k ≠ 1`.** -/
theorem hg8_I_H_eq_zero (k : ℕ) (hk : k ≠ 1) (y : RelativeHomology ℤ hg8_IPair k) : y = 0 := by
  rcases k with _ | k
  · have : Nonempty hg8_IPair.snd := ⟨hg8_Iv 0⟩
    have : PathConnectedSpace hg8_IPair.fst := inferInstanceAs (PathConnectedSpace unitInterval)
    exact hg8_relHomology_zero hg8_IPair y
  · refine hg8_relHomology_succ_eq_zero hg8_IPair k
      (fun x ↦ hg8_homology_contractible unitInterval (Nat.succ_ne_zero k) x) (fun x ↦ ?_) y
    exact hg8_homology_discrete_eq_zero hg8_Iends (by omega) x

/-! ## The model triangle `(Δ², ∂Δ²)` -/

/-- The point of face `k` of `Δ²` at parameter `t`. -/
def hg8_facePt (k : Fin 3) (t : unitInterval) : StdSimplex ℝ (Fin 3) :=
  StdSimplex.map k.succAbove (StdSimplex.homeomorphI.symm t)

/-- The weights of the point of `Δ¹` at parameter `t`. -/
theorem hg8_homeomorphI_symm_weights (t : unitInterval) :
    (StdSimplex.homeomorphI.symm t).weights 1 = t ∧
      (StdSimplex.homeomorphI.symm t).weights 0 = 1 - t := by
  have h1 : (StdSimplex.homeomorphI (StdSimplex.homeomorphI.symm t) : ℝ) = t := by
    rw [Homeomorph.apply_symm_apply]
  rw [StdSimplex.homeomorphI_apply_coe] at h1
  refine ⟨h1, ?_⟩
  have := (StdSimplex.homeomorphI.symm t).total_fin_two
  linarith

/-- A face point has weight `0` at the face index. -/
theorem hg8_facePt_weight_self (k : Fin 3) (t : unitInterval) : (hg8_facePt k t).weights k = 0 := by
  simp only [hg8_facePt, StdSimplex.weights_map]
  exact Finsupp.mapDomain_of_notMem_range _ _ (by simp)

/-- The other weights of a face point. -/
theorem hg8_facePt_weight_succAbove (k : Fin 3) (t : unitInterval) (j : Fin 2) :
    (hg8_facePt k t).weights (k.succAbove j) = (StdSimplex.homeomorphI.symm t).weights j := by
  simp only [hg8_facePt, StdSimplex.weights_map]
  exact Finsupp.mapDomain_apply_of_injective Fin.succAbove_right_injective _ _

/-- Face points depend continuously on the parameter. -/
theorem hg8_facePt_continuous (k : Fin 3) : Continuous (hg8_facePt k) :=
  (StdSimplex.continuous_map (R := ℝ) _).comp StdSimplex.homeomorphI.symm.continuous

/-- Each face is injective. -/
theorem hg8_facePt_injective (k : Fin 3) : Function.Injective (hg8_facePt k) := by
  intro t t' h
  have := congrArg (fun a : StdSimplex ℝ (Fin 3) ↦ a.weights (k.succAbove 1)) h
  simp only [hg8_facePt_weight_succAbove, (hg8_homeomorphI_symm_weights _).1] at this
  exact Subtype.ext this

/-- The start of face `k`. -/
theorem hg8_facePt_zero (k : Fin 3) : hg8_facePt k 0 = StdSimplex.single (k.succAbove 0) := by
  simp [hg8_facePt, StdSimplex.homeomorphI_symm_zero, StdSimplex.map_single]

/-- The end of face `k`. -/
theorem hg8_facePt_one (k : Fin 3) : hg8_facePt k 1 = StdSimplex.single (k.succAbove 1) := by
  simp [hg8_facePt, StdSimplex.homeomorphI_symm_one, StdSimplex.map_single]

/-- The boundary `∂Δ²`: points with a zero weight. -/
def hg8_bd : Set (StdSimplex ℝ (Fin 3)) := {a | ∃ k, a.weights k = 0}

/-- The vertices of `Δ²`. -/
def hg8_vtx : Set (StdSimplex ℝ (Fin 3)) := Set.range StdSimplex.single

/-- Vertices lie on the boundary. -/
theorem hg8_vtx_sub_bd : hg8_vtx ⊆ hg8_bd := by
  rintro _ ⟨i, rfl⟩
  refine ⟨i.succAbove 0, ?_⟩
  simp [StdSimplex.single]

/-- Interior points of a face have positive weights off the face index. -/
theorem hg8_facePt_interior_pos (k : Fin 3) (t : unitInterval) (ht : t ∈ Set.Ioo 0 1) (j : Fin 2) :
    0 < (hg8_facePt k t).weights (k.succAbove j) := by
  rw [hg8_facePt_weight_succAbove]
  obtain ⟨h1, h0⟩ := hg8_homeomorphI_symm_weights t
  fin_cases j
  · simp only [Fin.zero_eta, Fin.isValue] at h0 ⊢
    rw [h0]
    have : (t : ℝ) < 1 := ht.2
    linarith
  · simp only [Fin.mk_one, Fin.isValue] at h1 ⊢
    rw [h1]
    exact ht.1

/-- An interior point of a face has its only zero weight at the face index. -/
theorem hg8_facePt_weight_eq_zero (k : Fin 3) (t : unitInterval) (ht : t ∈ Set.Ioo 0 1) (i : Fin 3)
    (hi : (hg8_facePt k t).weights i = 0) : i = k := by
  rcases Fin.eq_self_or_eq_succAbove k i with h | ⟨j, rfl⟩
  · exact h
  · exact absurd hi (hg8_facePt_interior_pos k t ht j).ne'

/-- An interior point of a face is not a vertex. -/
theorem hg8_facePt_not_vtx (k : Fin 3) (t : unitInterval) (ht : t ∈ Set.Ioo 0 1) :
    hg8_facePt k t ∉ hg8_vtx := by
  rintro ⟨i, hi⟩
  obtain ⟨j, hj⟩ : ∃ j : Fin 2, k.succAbove j ≠ i := by
    by_cases h : k.succAbove 0 = i
    · exact ⟨1, fun h' ↦ Fin.succAbove_right_injective.ne (by decide : (0 : Fin 2) ≠ 1)
        (h.trans h'.symm)⟩
    · exact ⟨0, h⟩
  have := hg8_facePt_interior_pos k t ht j
  rw [← hi] at this
  simp [StdSimplex.single, hj.symm] at this

/-- Face `k` as a path in `∂Δ²`. -/
def hg8_bdFace (k : Fin 3) : C(unitInterval, hg8_bd) :=
  ⟨fun t ↦ ⟨hg8_facePt k t, k, hg8_facePt_weight_self k t⟩,
    (hg8_facePt_continuous k).subtype_mk _⟩

/-- The three faces make `∂Δ²` a graph over the vertices. -/
theorem hg8_bdCells : hg8_Cells (Subtype.val ⁻¹' hg8_vtx : Set hg8_bd) hg8_Iends hg8_bdFace := by
  have hint : ∀ s : unitInterval, s ∉ hg8_Iends → s ∈ Set.Ioo 0 1 := fun s hs ↦ by
    rcases hg8_unit_endpoint' s with h | h | h
    · exact absurd (Or.inl h) hs
    · exact absurd (Or.inr h) hs
    · exact h
  refine ⟨?_, fun k ↦ ?_, fun k s hs ↦ ?_, fun k s hs ↦ hg8_facePt_not_vtx k s (hint s hs),
    fun k k' s s' hs hs' h ↦ ?_, fun x hx ↦ ?_⟩
  · exact ((Set.finite_range _).isClosed).preimage continuous_subtype_val
  · exact (hg8_bdFace k).continuous.isClosedEmbedding fun s s' h ↦
      hg8_facePt_injective k (congrArg Subtype.val h)
  · rcases hs with rfl | rfl
    · exact ⟨_, (hg8_facePt_zero k).symm⟩
    · exact ⟨_, (hg8_facePt_one k).symm⟩
  · have h' : hg8_facePt k s = hg8_facePt k' s' := congrArg Subtype.val h
    have := hg8_facePt_weight_self k' s'
    rw [← h'] at this
    exact (hg8_facePt_weight_eq_zero k s (hint s hs) k' this).symm
  · obtain ⟨k, hk⟩ := x.2
    obtain ⟨b, hb⟩ := hg8_face_preimage x.1 k hk
    refine ⟨k, StdSimplex.homeomorphI b, Subtype.ext ?_⟩
    change StdSimplex.map k.succAbove (StdSimplex.homeomorphI.symm (StdSimplex.homeomorphI b)) = _
    rw [Homeomorph.symm_apply_apply, hb]

/-- **Graphs.** For cells modelled on `(I, {0, 1})`, the edge classes `Φ j_* [id]` form a basis
of `H₁(X, A)`. -/
theorem hg8_graph_H1 {X J : Type} [TopologicalSpace X] [T2Space X] [Fintype J] {A : Set X}
    {Φ : J → C(unitInterval, X)} (hC : hg8_Cells A hg8_Iends Φ) :
    Function.Bijective (fun c : J →₀ ℤ ↦
      ∑ j, relativeHomologyMap ℤ 1 (hg8_cellMap hC j) (c j • hg8_Igen)) := by
  refine ⟨fun c c' h ↦ ?_, fun x ↦ ?_⟩
  · rw [← sub_eq_zero, ← Finset.sum_sub_distrib] at h
    have h' : ∑ j, relativeHomologyMap ℤ 1 (hg8_cellMap hC j) ((c - c') j • hg8_Igen) = 0 := by
      rw [← h]
      refine Finset.sum_congr rfl fun j _ ↦ ?_
      rw [Finsupp.sub_apply]
      exact (congrArg (relativeHomologyMap ℤ 1 (hg8_cellMap hC j))
        (sub_zsmul hg8_Igen (c j) (c' j))).trans (by rw [map_add, map_neg, sub_eq_add_neg])
    rw [← sub_eq_zero]
    ext j
    exact hg8_Igen_smul_eq_zero _ (hg8_cells_independent ℤ hC hg8_Imodel 1 _ h' j)
  · obtain ⟨y, hy⟩ := hg8_cells_span ℤ hC hg8_Imodel 1 x
    choose n hn using fun j ↦ hg8_I_H1_span (y j)
    refine ⟨Finsupp.equivFunOnFinite.symm n, ?_⟩
    rw [hy]
    refine Finset.sum_congr rfl fun j _ ↦ ?_
    rw [hn j]
    rfl

/-- **Graphs.** For cells modelled on `(I, {0, 1})`, `H_k(X, A) = 0` for `k ≠ 1`. -/
theorem hg8_graph_Hk {X J : Type} [TopologicalSpace X] [T2Space X] [Fintype J] {A : Set X}
    {Φ : J → C(unitInterval, X)} (hC : hg8_Cells A hg8_Iends Φ) (k : ℕ) (hk : k ≠ 1)
    (x : RelativeHomology ℤ (TopPair.ofSubset (X := TopCat.of X) A) k) : x = 0 := by
  obtain ⟨y, hy⟩ := hg8_cells_span ℤ hC hg8_Imodel k x
  rw [hy]
  refine Finset.sum_eq_zero fun j _ ↦ ?_
  rw [hg8_I_H_eq_zero k hk (y j), map_zero]

/-- The vertices as points of `∂Δ²`. -/
def hg8_bv (i : Fin 3) : hg8_bd := ⟨StdSimplex.single i, hg8_vtx_sub_bd ⟨i, rfl⟩⟩

/-- The vertices as points of the vertex subspace of `∂Δ²`. -/
def hg8_bw (i : Fin 3) : (Subtype.val ⁻¹' hg8_vtx : Set hg8_bd) := ⟨hg8_bv i, i, rfl⟩

/-- The vertices are the points of the vertex subspace. -/
theorem hg8_bw_bijective : Function.Bijective hg8_bw := by
  constructor
  · intro i i' h
    have := congrArg (fun x : (Subtype.val ⁻¹' hg8_vtx : Set hg8_bd) ↦ (x.1.1 : StdSimplex ℝ (Fin 3)).weights i) h
    by_contra hii
    simp [hg8_bw, hg8_bv, StdSimplex.single, hii] at this
  · rintro ⟨x, i, hi⟩
    exact ⟨i, Subtype.ext (Subtype.ext hi)⟩

instance hg8_bvtx_discrete : DiscreteTopology (Subtype.val ⁻¹' hg8_vtx : Set hg8_bd) := by
  have : Finite (Subtype.val ⁻¹' hg8_vtx : Set hg8_bd) := Finite.of_surjective _ hg8_bw_bijective.2
  infer_instance

/-- The endpoints of the faces. -/
theorem hg8_bdFace_ends (k : Fin 3) :
    hg8_bdFace k 0 = hg8_bv (k.succAbove 0) ∧ hg8_bdFace k 1 = hg8_bv (k.succAbove 1) :=
  ⟨Subtype.ext (hg8_facePt_zero k), Subtype.ext (hg8_facePt_one k)⟩

/-- The pair `(∂Δ², vertices)`. -/
abbrev hg8_BPair : TopPair.{0} := TopPair.ofSubset (X := TopCat.of hg8_bd) (Subtype.val ⁻¹' hg8_vtx)

/-- The boundary of a chain of faces. -/
theorem hg8_bd_boundary (c : Fin 3 →₀ ℤ) :
    Simplicial.boundary ℤ 0 (hg5_chain1 hg8_bdFace c) =
      hg5_chain0 hg8_bv (Finsupp.lmapDomain ℤ ℤ (fun k : Fin 3 ↦ k.succAbove 1) c -
        Finsupp.lmapDomain ℤ ℤ (fun k : Fin 3 ↦ k.succAbove 0) c) :=
  hg5_bd_chain1 hg8_bdFace hg8_bv _ _ hg8_bdFace_ends c

/-- Chains of faces are relative cycles of `(∂Δ², vertices)`. -/
theorem hg8_bdFace_relCycle (c : Fin 3 →₀ ℤ) :
    (hg5_chain1 hg8_bdFace c : (SingularChainComplex ℤ hg8_BPair.fst).X (0 + 1)) ∈
      hg8_relCycles ℤ hg8_BPair 0 := by
  refine ⟨hg5_chain0 hg8_bw (Finsupp.lmapDomain ℤ ℤ (fun k : Fin 3 ↦ k.succAbove 1) c -
    Finsupp.lmapDomain ℤ ℤ (fun k : Fin 3 ↦ k.succAbove 0) c), ?_⟩
  change hg8_chainMap ⟨Subtype.val, continuous_subtype_val⟩ 0 (hg5_chain0 hg8_bw _) =
    Simplicial.boundary ℤ 0 (hg5_chain1 hg8_bdFace c)
  rw [hg8_chain0_map, hg8_bd_boundary]
  rfl

/-- The edge classes of `∂Δ²` in `H₁(∂Δ², vertices)`. -/
def hg8_bdRel : (Fin 3 →₀ ℤ) →ₗ[ℤ] RelativeHomology ℤ hg8_BPair 1 :=
  hg8_relClass ℤ hg8_BPair 0 ∘ₗ LinearMap.codRestrict (hg8_relCycles ℤ hg8_BPair 0)
    (hg5_chain1 hg8_bdFace : (Fin 3 →₀ ℤ) →ₗ[ℤ] (SingularChainComplex ℤ hg8_BPair.fst).X (0 + 1))
    hg8_bdFace_relCycle

/-- The connecting map on the edge classes of `∂Δ²`. -/
theorem hg8_delta_bdRel (c : Fin 3 →₀ ℤ) :
    hg8_delta hg8_BPair 0 (hg8_bdRel c) = hg8_pointClass hg8_bw
      (Finsupp.lmapDomain ℤ ℤ (fun k : Fin 3 ↦ k.succAbove 1) c -
        Finsupp.lmapDomain ℤ ℤ (fun k : Fin 3 ↦ k.succAbove 0) c) := by
  refine hg8_delta_class _ (relativeChainShortComplex_shortExact ℤ hg8_BPair) 0 _
    (hg5_chain1 hg8_bdFace c) rfl _ ?_
  change hg8_chainMap ⟨Subtype.val, continuous_subtype_val⟩ 0 (hg5_chain0 hg8_bw _) =
    Simplicial.boundary ℤ 0 (hg5_chain1 hg8_bdFace c)
  rw [hg8_chain0_map, hg8_bd_boundary]
  rfl

/-- The image of `[id]` under face `k` is its edge class. -/
theorem hg8_bdCell_Igen (k : Fin 3) :
    relativeHomologyMap ℤ 1 (hg8_cellMap hg8_bdCells k) hg8_Igen =
      hg8_bdRel (Finsupp.single k 1) := by
  have hchain : hg8_chainMap (hg8_bdFace k) 1
      (hg5_chain1 (fun _ : Unit ↦ ContinuousMap.id unitInterval) (Finsupp.single () 1)) =
      hg5_chain1 hg8_bdFace (Finsupp.single k 1) := by
    rw [hg8_chain1_map]
    simp only [hg5_chain1, Finsupp.linearCombination_single]
    rfl
  refine (hg8_relClass_map ℤ (hg8_cellMap hg8_bdCells k) 0 ⟨_, hg8_Iid_relCycle⟩
    (by
      have h := hg8_bdFace_relCycle (Finsupp.single k 1)
      rw [← hchain] at h
      exact h)).trans ?_
  exact congrArg (hg8_relClass ℤ hg8_BPair 0) (Subtype.ext hchain)

/-- The edge classes as sums over the cells. -/
theorem hg8_bdRel_eq_sum (c : Fin 3 →₀ ℤ) :
    hg8_bdRel c = ∑ k, relativeHomologyMap ℤ 1 (hg8_cellMap hg8_bdCells k) (c k • hg8_Igen) := by
  conv_lhs => rw [← Finsupp.univ_sum_single c]
  rw [map_sum]
  refine Finset.sum_congr rfl fun k _ ↦ ?_
  rw [map_zsmul, hg8_bdCell_Igen]
  refine (congrArg hg8_bdRel ?_).trans (map_zsmul hg8_bdRel (c k) _)
  rw [Finsupp.smul_single, smul_eq_mul, mul_one]

/-- The edge classes form a basis of `H₁(∂Δ², vertices)`. -/
theorem hg8_bdRel_bijective : Function.Bijective hg8_bdRel := by
  have h := hg8_graph_H1 hg8_bdCells
  have heq : (hg8_bdRel : (Fin 3 →₀ ℤ) → _) = fun c ↦
      ∑ k, relativeHomologyMap ℤ 1 (hg8_cellMap hg8_bdCells k) (c k • hg8_Igen) :=
    funext hg8_bdRel_eq_sum
  rw [heq]
  exact h

/-- `H_k(∂Δ², vertices) = 0` for `k ≠ 1`. -/
theorem hg8_B_H_eq_zero (k : ℕ) (hk : k ≠ 1) (x : RelativeHomology ℤ hg8_BPair k) : x = 0 :=
  hg8_graph_Hk hg8_bdCells k hk x

/-- `H_k(∂Δ²) → H_k(∂Δ², vertices)` is injective for `k ≥ 1`. -/
theorem hg8_bd_proj_injective (k : ℕ) (hk : k ≠ 0) :
    Function.Injective (hg8_proj hg8_BPair k) := by
  rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
  intro x hx
  have hS := relativeChainShortComplex_shortExact ℤ hg8_BPair
  obtain ⟨a, ha⟩ := (ShortComplex.moduleCat_exact_iff _).1 (hS.homology_exact₂ k) x hx
  obtain rfl : a = 0 := hg8_homology_discrete_eq_zero (Subtype.val ⁻¹' hg8_vtx : Set hg8_bd) hk a
  exact ha.symm.trans (map_zero _)

/-- `H_k(∂Δ²) = 0` for `k ≥ 2`. -/
theorem hg8_bd_homology_eq_zero (k : ℕ) (hk : 2 ≤ k) (x : Homology ℤ (TopCat.of hg8_bd) k) :
    x = 0 :=
  hg8_bd_proj_injective k (by omega) ((hg8_B_H_eq_zero k (by omega) _).trans (map_zero _).symm)

/-- In `H₀(∂Δ²)`, a combination of vertices with zero coefficient sum vanishes. -/
theorem hg8_bd_pointClass_eq_zero (c : Fin 3 →₀ ℤ) (hc : c 0 + c 1 + c 2 = 0) :
    hg8_pointClass hg8_bv c = 0 := by
  have hface : ∀ k : Fin 3, hg8_pointClass hg8_bv
      (Finsupp.single (k.succAbove 1) 1 - Finsupp.single (k.succAbove 0) 1) = 0 := by
    intro k
    refine hg8_class_eq_zero_of_d _ 0 _ (hg5_chain1 hg8_bdFace (Finsupp.single k 1)) ?_
    change Simplicial.boundary ℤ 0 (hg5_chain1 hg8_bdFace (Finsupp.single k 1)) = _
    rw [hg8_bd_boundary]
    simp
    rfl
  have hc' : c = c 1 • (Finsupp.single ((2 : Fin 3).succAbove 1) 1 -
      Finsupp.single ((2 : Fin 3).succAbove 0) 1) + c 2 • (Finsupp.single ((1 : Fin 3).succAbove 1) 1 -
      Finsupp.single ((1 : Fin 3).succAbove 0) 1) := by
    ext i
    fin_cases i <;> (simp [Fin.succAbove]; try omega)
  rw [hc', map_add, map_zsmul, map_zsmul, hface, hface, zsmul_zero, zsmul_zero, add_zero]

/-- The pair `(Δ², ∂Δ²)`. -/
abbrev hg8_TPair : TopPair.{0} := TopPair.ofSubset (X := TopCat.of (StdSimplex ℝ (Fin 3))) hg8_bd

/-- The boundary cycle `e₀ − e₁ + e₂` of the faces. -/
def hg8_bdCycle : Fin 3 →₀ ℤ := Finsupp.single 0 1 - Finsupp.single 1 1 + Finsupp.single 2 1

/-- The faces of the identity triangle give the boundary cycle. -/
theorem hg8_bdCycle_faces :
    Finsupp.lmapDomain ℤ ℤ (fun _ : Unit ↦ (0 : Fin 3)) (Finsupp.single () 1) -
      Finsupp.lmapDomain ℤ ℤ (fun _ : Unit ↦ (1 : Fin 3)) (Finsupp.single () 1) +
      Finsupp.lmapDomain ℤ ℤ (fun _ : Unit ↦ (2 : Fin 3)) (Finsupp.single () 1) = hg8_bdCycle := by
  simp [hg8_bdCycle]

/-- The faces of the identity triangle are the face paths. -/
theorem hg8_id_faces (k : Fin 3) :
    hg5_face (ContinuousMap.id (StdSimplex ℝ (Fin 3))) k =
      (⟨Subtype.val, continuous_subtype_val⟩ : C(hg8_bd, StdSimplex ℝ (Fin 3))).comp (hg8_bdFace k) :=
  rfl

/-- The identity triangle is a relative cycle of `(Δ², ∂Δ²)`. -/
theorem hg8_Tid_relCycle :
    (hg5_chain2 (fun _ : Unit ↦ ContinuousMap.id (StdSimplex ℝ (Fin 3))) (Finsupp.single () 1) :
      (SingularChainComplex ℤ hg8_TPair.fst).X (1 + 1)) ∈ hg8_relCycles ℤ hg8_TPair 1 := by
  refine ⟨hg5_chain1 hg8_bdFace hg8_bdCycle, ?_⟩
  change hg8_chainMap ⟨Subtype.val, continuous_subtype_val⟩ 1 (hg5_chain1 hg8_bdFace _) =
    Simplicial.boundary ℤ 1 (hg5_chain2 (fun _ : Unit ↦ ContinuousMap.id _) (Finsupp.single () 1))
  rw [hg8_chain1_map, hg5_bd_chain2 (fun _ : Unit ↦ ContinuousMap.id (StdSimplex ℝ (Fin 3)))
    (fun k ↦ (⟨Subtype.val, continuous_subtype_val⟩ : C(hg8_bd, StdSimplex ℝ (Fin 3))).comp
      (hg8_bdFace k)) (fun _ ↦ 0) (fun _ ↦ 1) (fun _ ↦ 2)
    (fun _ ↦ ⟨hg8_id_faces 0, hg8_id_faces 1, hg8_id_faces 2⟩), hg8_bdCycle_faces]

/-- The generator `[id] ∈ H₂(Δ², ∂Δ²)`. -/
def hg8_Tgen : RelativeHomology ℤ hg8_TPair 2 :=
  hg8_relClass ℤ hg8_TPair 1 ⟨_, hg8_Tid_relCycle⟩

instance hg8_tri_contractible : ContractibleSpace (StdSimplex ℝ (Fin 3)) :=
  standardTopologicalSimplex_contractibleSpace 2

/-- The boundary of `[id]`, seen in `H₁(∂Δ², vertices)`, is `e₀ − e₁ + e₂`. -/
theorem hg8_proj_delta_Tgen :
    hg8_proj hg8_BPair 1 (hg8_delta hg8_TPair 1 hg8_Tgen) = hg8_bdRel hg8_bdCycle := by
  have hS := relativeChainShortComplex_shortExact ℤ hg8_TPair
  have hx₁ : ((relativeChainShortComplex ℤ hg8_TPair).f.f 1).hom (hg5_chain1 hg8_bdFace hg8_bdCycle) =
      ((relativeChainShortComplex ℤ hg8_TPair).X₂.d (1 + 1) 1).hom
        (hg5_chain2 (fun _ : Unit ↦ ContinuousMap.id (StdSimplex ℝ (Fin 3))) (Finsupp.single () 1)) := by
    change hg8_chainMap ⟨Subtype.val, continuous_subtype_val⟩ 1 (hg5_chain1 hg8_bdFace _) =
      Simplicial.boundary ℤ 1 (hg5_chain2 (fun _ : Unit ↦ ContinuousMap.id _) (Finsupp.single () 1))
    rw [hg8_chain1_map, hg5_bd_chain2 (fun _ : Unit ↦ ContinuousMap.id (StdSimplex ℝ (Fin 3)))
      (fun k ↦ (⟨Subtype.val, continuous_subtype_val⟩ : C(hg8_bd, StdSimplex ℝ (Fin 3))).comp
        (hg8_bdFace k)) (fun _ ↦ 0) (fun _ ↦ 1) (fun _ ↦ 2)
      (fun _ ↦ ⟨hg8_id_faces 0, hg8_id_faces 1, hg8_id_faces 2⟩), hg8_bdCycle_faces]
  have hk : (hg5_chain1 hg8_bdFace hg8_bdCycle : (SingularChainComplex ℤ hg8_BPair.fst).X 1) ∈
      LinearMap.ker ((SingularChainComplex ℤ hg8_BPair.fst).sc 1).g.hom :=
    hS.d_eq_zero_of_f_eq_d_apply _ _ _ _ hx₁ _
  have e : hg8_delta hg8_TPair 1 hg8_Tgen =
      ((SingularChainComplex ℤ hg8_BPair.fst).sc 1).moduleCatHomologyClass ⟨_, hk⟩ :=
    hg8_delta_class _ hS 1 _ _ rfl ⟨_, hk⟩ hx₁
  rw [e]
  unfold hg8_proj relativeHomologyProjection
  exact ShortComplex.moduleCatHomologyClass_naturality _ _

/-- The connecting map of `(Δ², ∂Δ²)` is injective in degree two. -/
theorem hg8_T_delta_injective : Function.Injective (hg8_delta hg8_TPair 1) :=
  hg8_delta_injective hg8_TPair 1 fun x ↦
    hg8_homology_contractible (StdSimplex ℝ (Fin 3)) (by norm_num) x

/-- **`H₂(Δ², ∂Δ²)` is generated by `[id]`.** -/
theorem hg8_T_H2_span (y : RelativeHomology ℤ hg8_TPair 2) : ∃ n : ℤ, y = n • hg8_Tgen := by
  obtain ⟨c, hc⟩ := hg8_bdRel_bijective.2 (hg8_proj hg8_BPair 1 (hg8_delta hg8_TPair 1 y))
  have h0 : hg8_delta hg8_BPair 0 (hg8_bdRel c) = 0 := by
    rw [hc]
    exact ConcreteCategory.congr_hom ((relativeChainShortComplex_shortExact ℤ hg8_BPair).comp_δ
      1 0 (by simp)) _
  rw [hg8_delta_bdRel] at h0
  have h1 := (hg8_pointClass_bijective hg8_bw hg8_bw_bijective).1 (h0.trans (map_zero _).symm)
  have e0 := congrArg (fun d : Fin 3 →₀ ℤ ↦ d 0) h1
  have e1 := congrArg (fun d : Fin 3 →₀ ℤ ↦ d 1) h1
  have e2 := congrArg (fun d : Fin 3 →₀ ℤ ↦ d 2) h1
  simp [Finsupp.lmapDomain_apply, Finsupp.mapDomain, Finsupp.sum_fintype, Fin.sum_univ_three,
    Fin.succAbove] at e0 e1 e2
  refine ⟨c 0, hg8_T_delta_injective (hg8_bd_proj_injective 1 one_ne_zero ?_)⟩
  rw [← hc, map_zsmul]
  refine Eq.trans ?_ (map_zsmul (hg8_proj hg8_BPair 1) (c 0) (hg8_delta hg8_TPair 1 hg8_Tgen)).symm
  have hcd : c = c 0 • hg8_bdCycle := by
    ext i
    fin_cases i <;> (simp [hg8_bdCycle]; try omega)
  exact (congrArg hg8_bdRel hcd).trans ((map_zsmul hg8_bdRel (c 0) _).trans
    (congrArg (c 0 • ·) hg8_proj_delta_Tgen.symm))

/-- **`[id]` has infinite order.** -/
theorem hg8_Tgen_smul_eq_zero (n : ℤ) (h : n • hg8_Tgen = 0) : n = 0 := by
  have h1 : hg8_proj hg8_BPair 1 (hg8_delta hg8_TPair 1 (n • hg8_Tgen)) = 0 := by
    rw [h, map_zero]
    exact map_zero _
  have h2 : hg8_bdRel (n • hg8_bdCycle) = 0 := by
    rw [map_zsmul, ← hg8_proj_delta_Tgen]
    refine Eq.trans ?_ h1
    exact ((map_zsmul (hg8_proj hg8_BPair 1) n (hg8_delta hg8_TPair 1 hg8_Tgen)).symm.trans
      (congrArg (hg8_proj hg8_BPair 1) (map_zsmul (hg8_delta hg8_TPair 1) n hg8_Tgen).symm))
  have h3 := hg8_bdRel_bijective.1 (h2.trans (map_zero _).symm)
  simpa [hg8_bdCycle] using congrArg (fun d : Fin 3 →₀ ℤ ↦ d 0) h3

instance hg8_bd_nonempty : Nonempty hg8_bd := ⟨hg8_bv 0⟩

/-- **`H_k(Δ², ∂Δ²) = 0` for `k ≠ 2`.** -/
theorem hg8_T_H_eq_zero (k : ℕ) (hk : k ≠ 2) (y : RelativeHomology ℤ hg8_TPair k) : y = 0 := by
  rcases k with _ | _ | k
  · have : Nonempty hg8_TPair.snd := inferInstanceAs (Nonempty hg8_bd)
    have : PathConnectedSpace hg8_TPair.fst :=
      inferInstanceAs (PathConnectedSpace (StdSimplex ℝ (Fin 3)))
    exact hg8_relHomology_zero hg8_TPair y
  · apply hg8_delta_injective hg8_TPair 0 fun x ↦
      hg8_homology_contractible (StdSimplex ℝ (Fin 3)) (by norm_num) x
    rw [map_zero]
    have hS := relativeChainShortComplex_shortExact ℤ hg8_BPair
    obtain ⟨a, ha⟩ := (ShortComplex.moduleCat_exact_iff _).1 (hS.homology_exact₂ 0)
      (hg8_delta hg8_TPair 0 y) (hg8_B_H_eq_zero 0 (by norm_num) _)
    obtain ⟨c, rfl⟩ := (hg8_pointClass_bijective hg8_bw hg8_bw_bijective).2 a
    have hinc : (HomologicalComplex.homologyMap (relativeChainShortComplex ℤ hg8_BPair).f 0).hom
        (hg8_pointClass hg8_bw c) = hg8_pointClass hg8_bv c :=
      hg8_pointClass_map ⟨Subtype.val, continuous_subtype_val⟩ hg8_bw c
    have h0 := hg8_incl_delta hg8_TPair 0 y
    rw [← ha, hinc] at h0
    have h0' := (hg8_pointClass_map ⟨Subtype.val, continuous_subtype_val⟩ hg8_bv c).symm.trans h0
    have hsum := hg8_pointClass_sum _ c h0'
    rw [Finsupp.sum_fintype _ _ (by simp), Fin.sum_univ_three] at hsum
    rw [← ha, hinc]
    exact hg8_bd_pointClass_eq_zero c hsum
  · refine hg8_relHomology_succ_eq_zero hg8_TPair (k + 1)
      (fun x ↦ hg8_homology_contractible (StdSimplex ℝ (Fin 3)) (by omega) x) (fun x ↦ ?_) y
    exact hg8_bd_homology_eq_zero (k + 1) (by omega) x

/-! ## The radial deformation of `Δ² ∖ {barycentre}` -/

/-- A point of `Δ²` from weights. -/
def hg8_mkTri (w : Fin 3 → ℝ) (h0 : ∀ k, 0 ≤ w k) (h1 : w 0 + w 1 + w 2 = 1) :
    StdSimplex ℝ (Fin 3) :=
  ⟨Finsupp.equivFunOnFinite.symm w, fun k ↦ h0 k, by
    rw [Finsupp.sum_fintype _ _ (by simp), Fin.sum_univ_three]; exact h1⟩

/-- The weights of `hg8_mkTri`. -/
theorem hg8_mkTri_weights (w : Fin 3 → ℝ) (h0 : ∀ k, 0 ≤ w k) (h1 : w 0 + w 1 + w 2 = 1)
    (k : Fin 3) : (hg8_mkTri w h0 h1).weights k = w k := rfl

/-- The barycentre of `Δ²`. -/
def hg8_bary : StdSimplex ℝ (Fin 3) :=
  hg8_mkTri (fun _ ↦ 1 / 3) (fun _ ↦ by norm_num) (by norm_num)

/-- The least weight. -/
def hg8_minW (a : StdSimplex ℝ (Fin 3)) : ℝ := min (a.weights 0) (min (a.weights 1) (a.weights 2))

/-- Weights are continuous. -/
theorem hg8_weights_continuous (k : Fin 3) :
    Continuous fun a : StdSimplex ℝ (Fin 3) ↦ a.weights k :=
  (continuous_apply k).comp (StdSimplex.isEmbedding_toFun_comp_weights ℝ (Fin 3)).continuous

/-- The least weight is continuous. -/
theorem hg8_minW_continuous : Continuous hg8_minW :=
  (hg8_weights_continuous 0).min ((hg8_weights_continuous 1).min (hg8_weights_continuous 2))

/-- The least weight is a lower bound. -/
theorem hg8_minW_le (a : StdSimplex ℝ (Fin 3)) (k : Fin 3) : hg8_minW a ≤ a.weights k := by
  unfold hg8_minW
  fin_cases k
  · exact min_le_left _ _
  · exact (min_le_right _ _).trans (min_le_left _ _)
  · exact (min_le_right _ _).trans (min_le_right _ _)

/-- The least weight is nonnegative. -/
theorem hg8_minW_nonneg (a : StdSimplex ℝ (Fin 3)) : 0 ≤ hg8_minW a :=
  le_min (a.weights_nonneg 0) (le_min (a.weights_nonneg 1) (a.weights_nonneg 2))

/-- The three weights sum to one. -/
theorem hg8_sum_three (a : StdSimplex ℝ (Fin 3)) : a.weights 0 + a.weights 1 + a.weights 2 = 1 := by
  rw [← Fin.sum_univ_three]; exact a.total_of_fintype

/-- Away from the barycentre the least weight is below `1/3`. -/
theorem hg8_minW_lt (a : StdSimplex ℝ (Fin 3)) (ha : a ≠ hg8_bary) : hg8_minW a < 1 / 3 := by
  by_contra h
  push Not at h
  apply ha
  have hs := hg8_sum_three a
  have h0 := (hg8_minW_le a 0).trans' h
  have h1 := (hg8_minW_le a 1).trans' h
  have h2 := (hg8_minW_le a 2).trans' h
  ext k
  rw [show hg8_bary.weights k = 1 / 3 from rfl]
  fin_cases k <;> simp <;> linarith

/-- The least weight is attained. -/
theorem hg8_minW_exists (a : StdSimplex ℝ (Fin 3)) : ∃ k, a.weights k = hg8_minW a := by
  unfold hg8_minW
  rcases min_choice (a.weights 1) (a.weights 2) with h | h <;>
    rcases min_choice (a.weights 0) (min (a.weights 1) (a.weights 2)) with h' | h'
  · exact ⟨0, h'.symm⟩
  · exact ⟨1, by rw [h', h]⟩
  · exact ⟨0, h'.symm⟩
  · exact ⟨2, by rw [h', h]⟩

/-- The weights of the radial deformation at time `t`. -/
def hg8_radW (t : ℝ) (a : StdSimplex ℝ (Fin 3)) (k : Fin 3) : ℝ :=
  (1 - t) * a.weights k + t * ((a.weights k - hg8_minW a) / (1 - 3 * hg8_minW a))

/-- The deformed weights are nonnegative. -/
theorem hg8_radW_nonneg (t : unitInterval) (a : StdSimplex ℝ (Fin 3)) (ha : a ≠ hg8_bary)
    (k : Fin 3) : 0 ≤ hg8_radW t a k := by
  have hm := hg8_minW_lt a ha
  have hd : 0 < 1 - 3 * hg8_minW a := by linarith
  have := hg8_minW_le a k
  unfold hg8_radW
  refine add_nonneg (mul_nonneg (by linarith [t.2.2]) (a.weights_nonneg k))
    (mul_nonneg t.2.1 (div_nonneg (by linarith) hd.le))

/-- The deformed weights sum to one. -/
theorem hg8_radW_sum (t : ℝ) (a : StdSimplex ℝ (Fin 3)) (ha : a ≠ hg8_bary) :
    hg8_radW t a 0 + hg8_radW t a 1 + hg8_radW t a 2 = 1 := by
  have hm := hg8_minW_lt a ha
  have hd : 1 - 3 * hg8_minW a ≠ 0 := by linarith
  have hs := hg8_sum_three a
  have key : (a.weights 0 - hg8_minW a) / (1 - 3 * hg8_minW a) +
      (a.weights 1 - hg8_minW a) / (1 - 3 * hg8_minW a) +
      (a.weights 2 - hg8_minW a) / (1 - 3 * hg8_minW a) = 1 := by
    rw [← add_div, ← add_div, div_eq_one_iff_eq hd]
    linarith
  unfold hg8_radW
  linear_combination (1 - t) * hs + t * key

/-- The deformation is radial from the barycentre. -/
theorem hg8_radW_sub (t : ℝ) (a : StdSimplex ℝ (Fin 3)) (ha : a ≠ hg8_bary) (k : Fin 3) :
    hg8_radW t a k - 1 / 3 =
      (a.weights k - 1 / 3) * ((1 - t) + t / (1 - 3 * hg8_minW a)) := by
  have hm := hg8_minW_lt a ha
  have hd : 1 - 3 * hg8_minW a ≠ 0 := by linarith
  unfold hg8_radW
  have e : (a.weights k - hg8_minW a) / (1 - 3 * hg8_minW a) =
      (a.weights k - 1 / 3) / (1 - 3 * hg8_minW a) + 1 / 3 := by
    rw [eq_comm, div_add' _ _ _ hd, div_left_inj' hd]
    ring
  rw [e]
  ring

/-- The radial deformation of `Δ² ∖ {barycentre}` onto `∂Δ²`. -/
def hg8_Tdeform :
    C(unitInterval × ({hg8_bary}ᶜ : Set (StdSimplex ℝ (Fin 3))), ({hg8_bary}ᶜ : Set (StdSimplex ℝ (Fin 3)))) where
  toFun p := ⟨hg8_mkTri (hg8_radW p.1 p.2) (hg8_radW_nonneg p.1 p.2 p.2.2)
      (hg8_radW_sum p.1 p.2 p.2.2), by
    intro h
    have h' := Set.mem_singleton_iff.1 h
    apply p.2.2
    have hm := hg8_minW_lt p.2.1 p.2.2
    have hd : 0 < 1 - 3 * hg8_minW p.2.1 := by linarith
    have hfac : 0 < (1 - (p.1 : ℝ)) + p.1 / (1 - 3 * hg8_minW p.2.1) := by
      have := p.1.2.1; have := p.1.2.2
      rcases eq_or_lt_of_le p.1.2.2 with h1 | h1
      · rw [h1]; simp [hd]
      · have : 0 ≤ (p.1 : ℝ) / (1 - 3 * hg8_minW p.2.1) := div_nonneg p.1.2.1 hd.le
        linarith
    ext k
    have hk := hg8_radW_sub p.1 p.2 p.2.2 k
    have hk' : hg8_radW p.1 p.2 k = 1 / 3 := by
      have := congrArg (fun b : StdSimplex ℝ (Fin 3) ↦ b.weights k) h'
      exact this
    rw [hk', sub_self] at hk
    have := (mul_eq_zero.1 hk.symm).resolve_right hfac.ne'
    rw [show hg8_bary.weights k = 1 / 3 from rfl]
    linarith⟩
  continuous_toFun := by
    refine Continuous.subtype_mk ?_ _
    rw [(StdSimplex.isEmbedding_toFun_comp_weights ℝ (Fin 3)).continuous_iff]
    refine continuous_pi fun k ↦ ?_
    change Continuous fun p : unitInterval × ({hg8_bary}ᶜ : Set (StdSimplex ℝ (Fin 3))) ↦
      hg8_radW p.1 p.2 k
    unfold hg8_radW
    have hw : Continuous fun p : unitInterval × ({hg8_bary}ᶜ : Set (StdSimplex ℝ (Fin 3))) ↦
        (p.2 : StdSimplex ℝ (Fin 3)).weights k :=
      (hg8_weights_continuous k).comp (continuous_subtype_val.comp continuous_snd)
    have hmin : Continuous fun p : unitInterval × ({hg8_bary}ᶜ : Set (StdSimplex ℝ (Fin 3))) ↦
        hg8_minW p.2 := hg8_minW_continuous.comp (continuous_subtype_val.comp continuous_snd)
    have ht : Continuous fun p : unitInterval × ({hg8_bary}ᶜ : Set (StdSimplex ℝ (Fin 3))) ↦
        (p.1 : ℝ) := continuous_subtype_val.comp continuous_fst
    refine ((continuous_const.sub ht).mul hw).add (ht.mul ((hw.sub hmin).div
      (continuous_const.sub (continuous_const.mul hmin)) fun p ↦ ?_))
    have := hg8_minW_lt p.2 p.2.2
    linarith

/-- The boundary is closed. -/
theorem hg8_bd_isClosed : IsClosed hg8_bd := by
  have : hg8_bd = ⋃ k, {a : StdSimplex ℝ (Fin 3) | a.weights k = 0} := by
    ext a; simp [hg8_bd]
  rw [this]
  exact isClosed_iUnion_of_finite fun k ↦ isClosed_eq (hg8_weights_continuous k) continuous_const

/-- The weights of the deformation. -/
theorem hg8_Tdeform_weights (t : unitInterval) (y : ({hg8_bary}ᶜ : Set (StdSimplex ℝ (Fin 3))))
    (k : Fin 3) : ((hg8_Tdeform (t, y) : StdSimplex ℝ (Fin 3))).weights k = hg8_radW t y k := rfl

/-- The model triangle with its radial deformation.
Source: Hatcher, *Algebraic Topology*, Example 2.23 (the pair `(Δⁿ, ∂Δⁿ)`). -/
def hg8_Tmodel : hg8_Model hg8_bd hg8_bary where
  ρ := hg8_Tdeform
  closed := hg8_bd_isClosed
  centre := by
    rintro ⟨k, hk⟩
    have : hg8_bary.weights k = 1 / 3 := rfl
    rw [this] at hk
    norm_num at hk
  zero y := by
    apply Subtype.ext
    ext k
    rw [hg8_Tdeform_weights]
    simp [hg8_radW]
  one y := by
    obtain ⟨k, hk⟩ := hg8_minW_exists y
    refine ⟨k, ?_⟩
    rw [hg8_Tdeform_weights]
    simp [hg8_radW, hk]
  fix t y hy := by
    obtain ⟨k₀, hk₀⟩ := hy
    have hm : hg8_minW y = 0 := le_antisymm (hk₀ ▸ hg8_minW_le y k₀) (hg8_minW_nonneg y)
    apply Subtype.ext
    ext k
    rw [hg8_Tdeform_weights]
    simp only [hg8_radW, hm, sub_zero, mul_zero, div_one]
    ring

end HodgeLean.Foundations.Program
