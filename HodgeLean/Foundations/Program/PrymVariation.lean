import HodgeLean.Foundations.Program.PrymVariationProofs

/-! # B6-3a: printed root calculations for Prym variation

The implication from these finite root calculations to the Nielsen input of B4
is described in `docs/specs/PrymVariation.md`. The statements concern the fixed
printed matrices, with no geometric hypothesis. Moving covers, image lattices,
holomorphic frames and the period-map record remain later stages.
HC no distance; AV milestone no distance.
-/

noncomputable section
open HodgeLean.Papers
namespace HodgeLean.Foundations.Program

/-- The first four inverse pairs have product one.
Source: `b4b_root`; group inverse laws. -/
theorem b63_root_prefix_product  :
    ((List.ofFn b4b_root).take 8).prod = 1 :=
  b63_root_prefix_product_aux

example  :
    ((List.ofFn b4b_root).take 8).prod = 1 :=
  b63_root_prefix_product

/-- The final four reflections multiply to the printed involution.
Source: `b4b_root`; G32 v0.16, Appendix A, exact matrix multiplication. -/
theorem b63_root_tail_product  :
    ((List.ofFn b4b_root).drop 8 |>.take 4).prod = (b4b_generators 2) ^ 2 :=
  b63_root_tail_product_aux

example  :
    ((List.ofFn b4b_root).drop 8 |>.take 4).prod = (b4b_generators 2) ^ 2 :=
  b63_root_tail_product

/-- Each printed generator lies in the subgroup generated by the root entries.
Source: G32 v0.16, Appendix A; the explicit words in `b4b_root`. -/
theorem b63_root_generators (k : Fin 4) :
    b4b_generators k ∈ Subgroup.closure (Set.range b4b_root) :=
  b63_root_generators_aux k

example (k : Fin 4) :
    b4b_generators k ∈ Subgroup.closure (Set.range b4b_root) :=
  b63_root_generators k

/-- Each even reflection slot belongs to the first printed conjugacy class.
Source: G32 v0.16, Definition 3.5 and Appendix A; `b4b_root`. -/
theorem b63_root_positive_class (j : Fin 6) :
    g32h_ConjIn (g32R1 g32h_omega)
      (b4b_toMatrix (b4b_root (b63_positiveSlot j))) :=
  b63_root_positive_class_aux j

example (j : Fin 6) :
    g32h_ConjIn (g32R1 g32h_omega)
      (b4b_toMatrix (b4b_root (b63_positiveSlot j))) :=
  b63_root_positive_class j

/-- Each odd reflection slot belongs to the inverse printed conjugacy class.
Source: G32 v0.16, Definition 3.5 and Appendix A; `b4b_root`. -/
theorem b63_root_negative_class (j : Fin 6) :
    g32h_ConjIn (g32R2 g32h_omega)
      (b4b_toMatrix (b4b_root (b63_negativeSlot j))) :=
  b63_root_negative_class_aux j

example (j : Fin 6) :
    g32h_ConjIn (g32R2 g32h_omega)
      (b4b_toMatrix (b4b_root (b63_negativeSlot j))) :=
  b63_root_negative_class j

/-- Every local generator has the specified nontrivial ramification order.
Source: G32 v0.16, §3.3 and Appendix A; reflection and involution characteristic polynomials. -/
theorem b63_root_order (j : Fin 13) :
    orderOf (b4b_root j) = if j = 12 then 2 else 3 :=
  b63_root_order_aux j

example (j : Fin 13) :
    orderOf (b4b_root j) = if j = 12 then 2 else 3 :=
  b63_root_order j

end HodgeLean.Foundations.Program
