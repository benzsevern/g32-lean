import HodgeLean.Foundations.Program.PullbackMonodromyFoundationsProofs

/-! # Foundations for the pullback monodromy

Implication from holomorphic coefficients to change of variables for path transport;
implication from a finite puncture set in an open set of the sphere to surjectivity of
filling on fundamental groups, its peripheral kernel and descent; implication from a
covering map with finite fibre to an index bound; a conjugacy statement for the first
reflection of G32 and its occurrence in any representation matching pullback transport;
and the surjective pullback representation of stage 5b′, set aside there, restated here.
Not claimed: the selected-component comparison, Schlesinger deformation or any curve in
the marked family. HC no distance; AV milestone no distance.
-/

noncomputable section
open Set Metric Filter
open scoped Topology
namespace HodgeLean.Foundations.Program

/-- Transport of a pulled-back coefficient along a path is transport of the coefficient along the image path. Mathlib-only.
Source: Ilyashenko–Yakovenko, Lectures on Analytic Differential Equations, §15, continuation along paths and change of the independent variable; b65f_disc_transport. -/
theorem b65t_transport_pullback (E : Type*) [NormedAddCommGroup E] [NormedSpace ℂ E]
    [FiniteDimensional ℂ E]
    (U V : Set ℂ) (hU : IsOpen U) (hV : IsOpen V) (A : ℂ → E →L[ℂ] E)
    (hA : AnalyticOnNhd ℂ A U) (φ : ℂ → ℂ) (hφ : AnalyticOnNhd ℂ φ V)
    (hmaps : MapsTo φ V U) (x y : V) (γ : Path x y) :
    b65f_transport E (b65t_pull E φ A) (fun t ↦ (γ.extend t).val) =
      b65f_transport E A (fun t ↦ φ (γ.extend t).val) :=
  b65t_transport_pullback_aux E U V hU hV A hA φ hφ hmaps x y γ

example (E : Type*) [NormedAddCommGroup E] [NormedSpace ℂ E]
    [FiniteDimensional ℂ E]
    (U V : Set ℂ) (hU : IsOpen U) (hV : IsOpen V) (A : ℂ → E →L[ℂ] E)
    (hA : AnalyticOnNhd ℂ A U) (φ : ℂ → ℂ) (hφ : AnalyticOnNhd ℂ φ V)
    (hmaps : MapsTo φ V U) (x y : V) (γ : Path x y) :
    b65f_transport E (b65t_pull E φ A) (fun t ↦ (γ.extend t).val) =
      b65f_transport E A (fun t ↦ φ (γ.extend t).val) :=
  b65t_transport_pullback E U V hU hV A hA φ hφ hmaps x y γ

/-- The printed pullback coefficient has the transport of the four-point coefficient along the image of each regular path.
Source: G32 v0.16, §5.4; b65r_pullback_identity and b65t_transport_pullback. -/
theorem b65t_pullback_transport (x y : b65s_regular) (γ : Path x y) :
    b65f_transport (Fin 4 → ℂ) b65r_pullback (fun t ↦ (γ.extend t).val) =
      b65f_transport (Fin 4 → ℂ) b65r_A (fun t ↦ b65r_phi (γ.extend t).val) :=
  b65t_pullback_transport_aux x y γ

example (x y : b65s_regular) (γ : Path x y) :
    b65f_transport (Fin 4 → ℂ) b65r_pullback (fun t ↦ (γ.extend t).val) =
      b65f_transport (Fin 4 → ℂ) b65r_A (fun t ↦ b65r_phi (γ.extend t).val) :=
  b65t_pullback_transport x y γ

/-- Filling finitely many points of an open set of the sphere: surjective on fundamental groups, kernel normally generated by peripheral loops, and descent of representations trivial on them. Mathlib-only.
Source: Hatcher, Algebraic Topology, §1.2, Theorem 1.20 (van Kampen) and Proposition 1.26; Mathlib QuotientGroup.lift. -/
theorem b65t_puncture_fill (X : Set (OnePoint ℂ)) (hX : IsOpen X)
    (F : Finset (OnePoint ℂ)) (x : ↥(X \ (F : Set (OnePoint ℂ)))) :
    Function.Surjective (FundamentalGroup.map (b65t_fill X F) x) ∧
      (FundamentalGroup.map (b65t_fill X F) x).ker =
        Subgroup.normalClosure (b65t_peripheral X F x) ∧
      ∀ (G : Type) [Group G] (ρ : FundamentalGroup ↥(X \ (F : Set (OnePoint ℂ))) x →* G),
        (∀ c ∈ b65t_peripheral X F x, ρ c = 1) →
          ∃! σ : FundamentalGroup ↥X (b65t_fill X F x) →* G,
            σ.comp (FundamentalGroup.map (b65t_fill X F) x) = ρ :=
  b65t_puncture_fill_aux X hX F x

example (X : Set (OnePoint ℂ)) (hX : IsOpen X)
    (F : Finset (OnePoint ℂ)) (x : ↥(X \ (F : Set (OnePoint ℂ)))) :
    Function.Surjective (FundamentalGroup.map (b65t_fill X F) x) ∧
      (FundamentalGroup.map (b65t_fill X F) x).ker =
        Subgroup.normalClosure (b65t_peripheral X F x) ∧
      ∀ (G : Type) [Group G] (ρ : FundamentalGroup ↥(X \ (F : Set (OnePoint ℂ))) x →* G),
        (∀ c ∈ b65t_peripheral X F x, ρ c = 1) →
          ∃! σ : FundamentalGroup ↥X (b65t_fill X F x) →* G,
            σ.comp (FundamentalGroup.map (b65t_fill X F) x) = ρ :=
  b65t_puncture_fill X hX F x

/-- The image of the fundamental group under a covering map with finite fibre has positive index at most the fibre cardinality. Mathlib-only.
Source: Hatcher, Algebraic Topology, §1.3, Proposition 1.32; Mathlib IsCoveringMap.monodromyPerm. -/
theorem b65t_covering_index {E B : Type*} [TopologicalSpace E] [TopologicalSpace B]
    (p : E → B) (hp : IsCoveringMap p) (e : E) (hfin : (p ⁻¹' {p e}).Finite) :
    0 < (FundamentalGroup.map ⟨p, hp.continuous⟩ e).range.index ∧
      (FundamentalGroup.map ⟨p, hp.continuous⟩ e).range.index ≤ Nat.card (p ⁻¹' {p e}) :=
  b65t_covering_index_aux p hp e hfin

example {E B : Type*} [TopologicalSpace E] [TopologicalSpace B]
    (p : E → B) (hp : IsCoveringMap p) (e : E) (hfin : (p ⁻¹' {p e}).Finite) :
    0 < (FundamentalGroup.map ⟨p, hp.continuous⟩ e).range.index ∧
      (FundamentalGroup.map ⟨p, hp.continuous⟩ e).range.index ≤ Nat.card (p ⁻¹' {p e}) :=
  b65t_covering_index p hp e hfin

/-- An element of G32 whose matrix is linearly conjugate to that of the first reflection is conjugate to it in the group.
Source: G32 is the Shephard–Todd group 32, with 40 reflecting hyperplanes in one orbit and cyclic hyperplane stabilizers of order three; Lehrer–Taylor, Unitary Reflection Groups, Appendix D, group G32. -/
theorem b65t_reflection_class (g : b4b_Group)
    (K : ((Fin 4 → ℂ) →L[ℂ] (Fin 4 → ℂ))ˣ)
    (hK : b65r_operator (b4b_toMatrix g) =
      (K : (Fin 4 → ℂ) →L[ℂ] (Fin 4 → ℂ)) *
        b65r_operator (b4b_toMatrix (b4b_generators 0)) * ↑(K⁻¹)) :
    ∃ h : b4b_Group, h * b4b_generators 0 * h⁻¹ = g :=
  b65t_reflection_class_aux g K hK

example (g : b4b_Group)
    (K : ((Fin 4 → ℂ) →L[ℂ] (Fin 4 → ℂ))ˣ)
    (hK : b65r_operator (b4b_toMatrix g) =
      (K : (Fin 4 → ℂ) →L[ℂ] (Fin 4 → ℂ)) *
        b65r_operator (b4b_toMatrix (b4b_generators 0)) * ↑(K⁻¹)) :
    ∃ h : b4b_Group, h * b4b_generators 0 * h⁻¹ = g :=
  b65t_reflection_class g K hK

/-- A representation matching pullback transport on regular loops contains a conjugate of the first reflection.
Source: G32 v0.16, §5.2, proof of Lemma surj, local monodromy at a simple root over 5; b65r_pullback_local_monodromy and b65t_reflection_class. -/
theorem b65t_reflection_in_image (x : b65s_regular)
    (ρ : FundamentalGroup b65s_regular x →* b4b_Group)
    (C : ((Fin 4 → ℂ) →L[ℂ] (Fin 4 → ℂ))ˣ)
    (hρ : ∀ γ : Path x x,
      b65f_transport (Fin 4 → ℂ) b65r_pullback (fun t ↦ (γ.extend t).val) =
        (C : (Fin 4 → ℂ) →L[ℂ] (Fin 4 → ℂ)) *
          b65r_operator (b4b_toMatrix (ρ (FundamentalGroup.fromPath ⟦γ⟧))) * ↑(C⁻¹)) :
    ∃ g : b4b_Group, g * b4b_generators 0 * g⁻¹ ∈ ρ.range :=
  b65t_reflection_in_image_aux x ρ C hρ

example (x : b65s_regular)
    (ρ : FundamentalGroup b65s_regular x →* b4b_Group)
    (C : ((Fin 4 → ℂ) →L[ℂ] (Fin 4 → ℂ))ˣ)
    (hρ : ∀ γ : Path x x,
      b65f_transport (Fin 4 → ℂ) b65r_pullback (fun t ↦ (γ.extend t).val) =
        (C : (Fin 4 → ℂ) →L[ℂ] (Fin 4 → ℂ)) *
          b65r_operator (b4b_toMatrix (ρ (FundamentalGroup.fromPath ⟦γ⟧))) * ↑(C⁻¹)) :
    ∃ g : b4b_Group, g * b4b_generators 0 * g⁻¹ ∈ ρ.range :=
  b65t_reflection_in_image x ρ C hρ

/-- The degree-six pullback has a surjective G32 representation on the thirteen-punctured sphere.
Source: G32 v0.16, §5.2, Lemma surj and its separate subgroup-index argument; b65r_four_point_monodromy, b65s_small_index and b65t_transport_pullback through b65t_reflection_in_image. -/
theorem b65t_pullback_monodromy (x : b65s_regular) :
    ∃ ρ : FundamentalGroup b65s_sphere (b65s_inclusion x) →* b4b_Group,
      Function.Surjective ρ ∧
      ∃ C : ((Fin 4 → ℂ) →L[ℂ] (Fin 4 → ℂ))ˣ,
        ∀ γ : Path x x,
          b65f_transport (Fin 4 → ℂ) b65r_pullback (fun t ↦ (γ.extend t).val) =
            (C : (Fin 4 → ℂ) →L[ℂ] (Fin 4 → ℂ)) *
              b65r_operator (b4b_toMatrix
                (ρ (FundamentalGroup.map b65s_inclusion x
                  (FundamentalGroup.fromPath ⟦γ⟧)))) * ↑(C⁻¹) :=
  b65t_pullback_monodromy_aux x

example (x : b65s_regular) :
    ∃ ρ : FundamentalGroup b65s_sphere (b65s_inclusion x) →* b4b_Group,
      Function.Surjective ρ ∧
      ∃ C : ((Fin 4 → ℂ) →L[ℂ] (Fin 4 → ℂ))ˣ,
        ∀ γ : Path x x,
          b65f_transport (Fin 4 → ℂ) b65r_pullback (fun t ↦ (γ.extend t).val) =
            (C : (Fin 4 → ℂ) →L[ℂ] (Fin 4 → ℂ)) *
              b65r_operator (b4b_toMatrix
                (ρ (FundamentalGroup.map b65s_inclusion x
                  (FundamentalGroup.fromPath ⟦γ⟧)))) * ↑(C⁻¹) :=
  b65t_pullback_monodromy x

/-- Chain check toward the generator data: a surjective representation of the sphere
reaches each printed generator operator through the column action.
Source: b65s_action; G32 v0.16, Appendix A. -/
example (x : b65s_regular)
    (ρ : FundamentalGroup b65s_sphere (b65s_inclusion x) →* b4b_Group)
    (hρ : Function.Surjective ρ) (i : Fin 4) :
    ∃ c, b65s_action (ρ c) = b65r_operator (b4b_toMatrix (b4b_generators i)) := by
  obtain ⟨c, hc⟩ := hρ (b4b_generators i)
  exact ⟨c, by rw [hc]; rfl⟩

/-- Field-type check from a continuous normalized parameter curve to the two path fields.
Source: HodgeLean/Papers/G32DominanceDefs.lean, curve_cont and curve_zero;
b6t_polydisc_neighbourhood. -/
example (c : C(ℂ, b6_chart)) :
    ContinuousAt (fun θ ↦ (c θ).val) 0 ∧
      (c 0).val ∈ b6t_polydisc (c 0).val :=
  ⟨(continuous_subtype_val.comp c.continuous).continuousAt,
    (b6t_polydisc_neighbourhood (c 0).val (c 0).property).1⟩

end HodgeLean.Foundations.Program
