/-- RiemannRochAna: vanishing of a smooth Dolbeault class is equivalent to existence of a smooth potential. -/
theorem RiemannRochAna_class_eq_zero_iff (hE : Module.finrank ℂ E = 1)
    (β : b4c_Smooth01 E C) :
    (Submodule.Quotient.mk β : b4c_Dolbeault01 E C) = 0 ↔
      ∃ u : b4c_SmoothFun E C, b4c_dbar E C u = β.1 := by
  rw [Submodule.Quotient.mk_eq_zero]
  change β.1 ∈ Submodule.span ℂ
    (b4c_dbar E C '' (b4c_SmoothFun E C : Set (C → ℂ))) ↔ _
  rw [← SetLike.mem_coe, b4c_dbar_image_eq_aux hE]
  constructor
  · rintro ⟨u, hu, he⟩
    exact ⟨⟨u, hu⟩, he⟩
  · rintro ⟨u, hu⟩
    exact ⟨u, u.property, hu⟩

/-- RiemannRochAna: in genus zero every smooth Dolbeault form has a smooth potential. -/
theorem RiemannRochAna_dbar_surjective_of_genus_zero [T2Space C] [CompactSpace C]
    [ConnectedSpace C] (hE : Module.finrank ℂ E = 1)
    (hg : Module.finrank ℂ (b3_HolForm E C) = 0) (β : b4c_Smooth01 E C) :
    ∃ u : b4c_SmoothFun E C, b4c_dbar E C u = β.1 := by
  obtain ⟨hf, hd⟩ := b4c_dolbeault_finite_aux (C := C) hE
  letI := hf
  have hz : Module.finrank ℂ (b4c_Dolbeault01 E C) = 0 := hd.trans hg
  haveI : Subsingleton (b4c_Dolbeault01 E C) :=
    (Module.finrank_eq_zero_iff_of_free ℂ _).mp hz
  exact (RiemannRochAna_class_eq_zero_iff hE β).mp (Subsingleton.elim _ _)

/-- RiemannRochAna: any genus-plus-one smooth Dolbeault forms have a nontrivial linear combination with a smooth potential. -/
theorem RiemannRochAna_obstruction_dependence [T2Space C] [CompactSpace C]
    [ConnectedSpace C] (hE : Module.finrank ℂ E = 1)
    (β : Fin (Module.finrank ℂ (b3_HolForm E C) + 1) → b4c_Smooth01 E C) :
    ∃ c : Fin (Module.finrank ℂ (b3_HolForm E C) + 1) → ℂ,
      (∃ j, c j ≠ 0) ∧ ∃ u : b4c_SmoothFun E C,
        b4c_dbar E C u = (∑ j, c j • β j).1 := by
  obtain ⟨hf, hd⟩ := b4c_dolbeault_finite_aux (C := C) hE
  letI := hf
  let P := (Submodule.span ℂ (b4c_dbar E C '' (b4c_SmoothFun E C : Set (C → ℂ)))).comap
    (b4c_Smooth01 E C).subtype
  have hdep : ¬ LinearIndependent ℂ (fun j ↦ P.mkQ (β j)) := by
    intro hi
    have hh := hi.fintype_card_le_finrank
    simp only [Fintype.card_fin] at hh
    change Module.finrank ℂ (b3_HolForm E C) + 1 ≤ Module.finrank ℂ (b4c_Dolbeault01 E C) at hh
    omega
  obtain ⟨c, hc, j, hj⟩ := Fintype.not_linearIndependent_iff.mp hdep
  refine ⟨c, ⟨j, hj⟩, (RiemannRochAna_class_eq_zero_iff hE _).mp ?_⟩
  change P.mkQ (∑ j, c j • β j) = 0
  simpa only [map_sum, map_smul] using hc

