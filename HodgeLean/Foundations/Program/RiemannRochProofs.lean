        ∃ (y : {y : OnePoint ℂ // y ∉ B}) (k : Path y₀ y) (d : Path y y),
          (∀ t, (d t : OnePoint ℂ) =
            (((a : ℂ) + Complex.exp ((((t : ℝ) * (2 * Real.pi) : ℝ) : ℂ) * Complex.I) * w : ℂ) : OnePoint ℂ)) ∧
          FundamentalGroup.fromPath ⟦(k.trans d).trans k.symm⟧ = γ a) ∧
      ∀ (G : Type) [Group G] (v : {a : ℂ // (a : OnePoint ℂ) ∈ B} → G),
        ∃! φ : FundamentalGroup {y : OnePoint ℂ // y ∉ B} y₀ →* G, ∀ a, φ (γ a) = v a := by
  let A := ((↑) : ℂ → OnePoint ℂ) ⁻¹' B
  have hA : A.Finite := hB.preimage OnePoint.coe_injective.injOn
  obtain ⟨e, he⟩ := RiemannRochTop_affine_complement_homeomorph B hinfty
  obtain ⟨γ₀, hgeom, hu⟩ := RiemannRochTop_finite_positive_circles_free A hA (e.symm y₀)
  obtain ⟨g, hg⟩ := RiemannRochTop_homeomorph_pi1_map e (e.symm y₀)
  rw [← e.apply_symm_apply y₀]
  refine ⟨fun a ↦ g (γ₀ a), ?_, ?_⟩
  · intro a
    obtain ⟨R, w, hw, hR, hdisk, y, k, d, hd, hclass⟩ := hgeom a
    refine ⟨R, w, hw, hR, hdisk, e y, k.map e.continuous, d.map e.continuous, ?_, ?_⟩
    · intro t
      change (e (d t) : OnePoint ℂ) = _
      rw [he, hd]
    · have hm := (hg ((k.trans d).trans k.symm)).symm.trans (congrArg g hclass)
      simpa only [Path.map_trans, Path.map_symm] using hm
  · intro G _ v
    obtain ⟨φ, hφ, huniq⟩ := hu G v
    refine ⟨φ.comp g.symm.toMonoidHom, ?_, ?_⟩
    · intro a
      simpa using hφ a
    · intro ψ hψ
      have heq : ψ.comp g.toMonoidHom = φ := huniq _ hψ
      ext z
      have h := congrArg (fun f ↦ f (g.symm z)) heq
      simpa using h

/-- RiemannRochTop: finite affine puncture generators have the universal property and rotation monodromy. -/
lemma RiemannRochTop_sphere_affine_monodromy_basis
    (B : Set (OnePoint ℂ)) (hB : B.Finite) (hinfty : OnePoint.infty ∈ B)
    (y₀ : {y : OnePoint ℂ // y ∉ B}) :
    ∃ γ : {a : ℂ // (a : OnePoint ℂ) ∈ B} → FundamentalGroup {y : OnePoint ℂ // y ∉ B} y₀,
      (∀ (H : Type) [Group H] (v : {a : ℂ // (a : OnePoint ℂ) ∈ B} → H),
        ∃! φ : FundamentalGroup {y : OnePoint ℂ // y ∉ B} y₀ →* H, ∀ a, φ (γ a) = v a) ∧
      ∀ (E' : Type) [NormedAddCommGroup E'] [NormedSpace ℂ E']
        (hE' : Module.finrank ℂ E' = 1) (C' : Type) [TopologicalSpace C']
        [ChartedSpace E' C'] [IsManifold 𝓘(ℂ, E') ω C']
        [T2Space C'] [CompactSpace C'] [ConnectedSpace C'] (G : Type) [Group G] [Finite G]
        [MulAction G C'] [FaithfulSMul G C'],
        (∀ g : G, ContMDiff 𝓘(ℂ, E') 𝓘(ℂ, E') ω (fun x : C' ↦ g • x)) →
        ∀ f : C' → OnePoint ℂ, ContMDiff 𝓘(ℂ, E') 𝓘(ℂ, ℂ) ω f → b4_IsGaloisCover G f →
        (∀ x, f x ∉ B → MulAction.stabilizer G x = ⊥) →
        ∀ (a : {a : ℂ // (a : OnePoint ℂ) ∈ B}) (c : Path y₀ y₀),
          FundamentalGroup.fromPath ⟦c⟧ = γ a →
        ∀ (Γ : C(unitInterval, C')) (l : G), (∀ t, f (Γ t) = (c t : OnePoint ℂ)) →
          Γ 1 = l • Γ 0 → ∃ q, f q = ((a : ℂ) : OnePoint ℂ) ∧ b4_IsRotGen E' q l := by
  obtain ⟨γ, hgeom, hu⟩ := RiemannRochTop_sphere_affine_positive_basis B hB hinfty y₀
  refine ⟨γ, hu, ?_⟩
  intro E' _ _ hE' C' _ _ _ _ _ _ G _ _ _ _ hG f hf hgal hfree a c hc Γ l hΓ hend
  obtain ⟨R, w, hw0, hw, havoid, y, k, d, hd, hclass⟩ := hgeom a
  exact RiemannRochTop_rotGen_affine_circle hE' hG f hf hgal B hB hfree
    a R havoid w hw hw0 k d hd c (hc.trans hclass.symm) Γ l hΓ hend

/-- RiemannRochTop: the exponential covering identifies the punctured-plane group with integers. -/
lemma RiemannRochTop_punctured_plane_group (z : {z : ℂ // z ≠ 0}) :
    Nonempty (FundamentalGroup {z : ℂ // z ≠ 0} z ≃* Multiplicative ℤ) := by
  have hperiod : (2 * Real.pi * Complex.I : ℂ) ≠ 0 := by
    exact mul_ne_zero (mul_ne_zero (by norm_num) (Complex.ofReal_ne_zero.mpr Real.pi_ne_zero))
      Complex.I_ne_zero
  exact ⟨(Complex.isAddQuotientCoveringMap_exp.fundamentalGroupEquiv
    ⟨Complex.log z, Subtype.ext (Complex.exp_log z.property)⟩).trans
      (MulOpposite.opMulEquiv.symm.trans
        (AddSubgroup.zmultiplesEquivInt hperiod).toMultiplicative)⟩

/-- RiemannRochTop: two distinct sphere punctures have punctured-plane complement. -/
lemma RiemannRochTop_two_punctures_homeomorph (b : Fin 2 → OnePoint ℂ)
    (hb : Function.Injective b) :
    Nonempty ({y : OnePoint ℂ // y ∉ Set.range b} ≃ₜ {z : ℂ // z ≠ 0}) := by
  obtain ⟨e, he⟩ := RiemannRochTop_move_puncture (b 0)
  have hne : e (b 1) ≠ OnePoint.infty := by
    rw [← he]
    exact fun h ↦ (by decide : (1 : Fin 2) ≠ 0) (hb (e.injective h))
  obtain ⟨a, ha⟩ := OnePoint.ne_infty_iff_exists.mp hne
  let T : Set (OnePoint ℂ) := {OnePoint.infty, (a : OnePoint ℂ)}
  have himage : e '' Set.range b = T := by
    ext y
    simp only [Set.mem_image, Set.mem_range, exists_exists_eq_and, T, Set.mem_insert_iff,
      Set.mem_singleton_iff]
    constructor
    · rintro ⟨j, rfl⟩
      fin_cases j
      · exact Or.inl he
      · exact Or.inr ha.symm
    · rintro (rfl | rfl)
      · exact ⟨0, he⟩
      · exact ⟨1, ha.symm⟩
  let ep := e.subtype (p := fun y ↦ y ∉ Set.range b) (q := fun y ↦ y ∉ T)
    (fun y ↦ by rw [← himage]; simp)
  have hsub : Tᶜ ⊆ Set.range ((↑) : ℂ → OnePoint ℂ) := by
    intro y hy
    exact OnePoint.ne_infty_iff_exists.mp (fun h ↦ hy (by simp [T, h]))
  let ea := OnePoint.isOpenEmbedding_coe.isEmbedding.homeomorphOfSubsetRange hsub
  let et := (Homeomorph.addRight (-a)).subtype
    (p := fun z : ℂ ↦ (z : OnePoint ℂ) ∉ T) (q := fun z : ℂ ↦ z ≠ 0)
    (fun z ↦ by simp [T, ← sub_eq_add_neg, sub_eq_zero])
  exact ⟨ep.trans (ea.symm.trans et)⟩

/-- RiemannRochTop: the two-puncture fundamental group is infinite cyclic. -/
lemma RiemannRochTop_two_punctures_group (b : Fin 2 → OnePoint ℂ)
    (hb : Function.Injective b) (y₀ : {y : OnePoint ℂ // y ∉ Set.range b}) :
    Nonempty (FundamentalGroup {y : OnePoint ℂ // y ∉ Set.range b} y₀ ≃*
      Multiplicative ℤ) := by
  obtain ⟨e⟩ := RiemannRochTop_two_punctures_homeomorph b hb
  let F := FundamentalGroupoidFunctor.equivOfHomotopyEquiv e.toHomotopyEquiv
  obtain ⟨q⟩ := RiemannRochTop_punctured_plane_group (e y₀)
  let q₀ : FundamentalGroup {y : OnePoint ℂ // y ∉ Set.range b} y₀ ≃*
      FundamentalGroup {z : ℂ // z ≠ 0} (e y₀) :=
    F.fullyFaithfulFunctor.mulEquivEnd (FundamentalGroupoid.mk y₀)
  exact ⟨q₀.trans q⟩

/-- RiemannRochTop: an infinite cyclic group has the presentation by two inverse generators. -/
lemma RiemannRochTop_cyclic_pair_presentation (Γ : Type) [Group Γ]
    (e : Γ ≃* Multiplicative ℤ) :
    ∃ γ : Fin 2 → Γ, (List.ofFn γ).prod = 1 ∧
      (∀ (H : Type) [Group H] (k : Fin 2 → H), (List.ofFn k).prod = 1 →
        ∃! φ : Γ →* H, ∀ j, φ (γ j) = k j) := by
  let g : Γ := e.symm (Multiplicative.ofAdd 1)
  let γ : Fin 2 → Γ := ![g, g⁻¹]
  refine ⟨γ, by simp [γ, List.ofFn_succ], ?_⟩
  intro H _ k hk
  have hk' : k 0 * k 1 = 1 := by simpa [List.ofFn_succ] using hk
  have hk1 : k 1 = (k 0)⁻¹ := eq_inv_of_mul_eq_one_right hk'
  let φ : Γ →* H := (zpowersHom H (k 0)).comp e.toMonoidHom
  have hφ0 : φ g = k 0 := by simp [φ, g]
  refine ⟨φ, ?_, ?_⟩
  · intro j
    fin_cases j
    · exact hφ0
    · change φ g⁻¹ = k 1
      rw [map_inv, hφ0, hk1]
  · intro ψ hψ
    have hψ0 : ψ g = k 0 := hψ 0
    have hcomp : ψ.comp e.symm.toMonoidHom = zpowersHom H (k 0) := by
      apply (zpowersHom H).symm.injective
      change ψ (e.symm (Multiplicative.ofAdd 1)) = k 0 ^ (1 : ℤ)
      rw [zpow_one]
      exact hψ0
    ext x
    have hx := congrArg (fun f : Multiplicative ℤ →* H ↦ f (e x)) hcomp
    change ψ x = zpowersHom H (k 0) (e x)
    simpa only [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom,
      MulEquiv.symm_apply_apply] using hx

/-- RiemannRochTop: the two-puncture sphere has the two-generator universal property. -/
lemma RiemannRochTop_two_punctures_presentation (b : Fin 2 → OnePoint ℂ)
    (hb : Function.Injective b) (y₀ : {y : OnePoint ℂ // y ∉ Set.range b}) :
    ∃ γ : Fin 2 → FundamentalGroup {y : OnePoint ℂ // y ∉ Set.range b} y₀,
      (List.ofFn γ).prod = 1 ∧
      (∀ (H : Type) [Group H] (k : Fin 2 → H), (List.ofFn k).prod = 1 →
        ∃! φ : FundamentalGroup {y : OnePoint ℂ // y ∉ Set.range b} y₀ →* H,
          ∀ j, φ (γ j) = k j) := by
  obtain ⟨e⟩ := RiemannRochTop_two_punctures_group b hb y₀
  exact RiemannRochTop_cyclic_pair_presentation _ e

/-- RiemannRochTop: adjoining the inverse product turns a free basis into a one-relation presentation. -/
lemma RiemannRochTop_adjoin_inverse_product {r : ℕ} {Γ : Type} [Group Γ]
    (γ : Fin r → Γ)
    (hu : ∀ (H : Type) [Group H] (v : Fin r → H), ∃! φ : Γ →* H, ∀ j, φ (γ j) = v j) :
    let δ : Fin (r + 1) → Γ := Fin.cases ((List.ofFn γ).prod)⁻¹ γ
    (List.ofFn δ).prod = 1 ∧
      ∀ (H : Type) [Group H] (v : Fin (r + 1) → H), (List.ofFn v).prod = 1 →
        ∃! φ : Γ →* H, ∀ j, φ (δ j) = v j := by
  dsimp only
  constructor
  · simp [List.ofFn_succ]
  · intro H _ v hv
    obtain ⟨φ, hφ, huniq⟩ := hu H (fun j ↦ v j.succ)
    have hfirst : v 0 = ((List.ofFn (fun j : Fin r ↦ v j.succ)).prod)⁻¹ := by
      apply eq_inv_of_mul_eq_one_left
      simpa only [List.ofFn_succ, List.prod_cons] using hv
    refine ⟨φ, ?_, ?_⟩
    · intro j
      induction j using Fin.cases with
      | zero =>
        simpa only [Fin.cases_zero, map_inv, map_list_prod, List.map_ofFn,
          Function.comp_def, hφ] using hfirst.symm
      | succ j => exact hφ j
    · intro ψ hψ
      exact huniq ψ (fun j ↦ hψ j.succ)

/-- RiemannRochTop: the abstract group with one generator per puncture and their product as relation. -/
abbrev RiemannRochTop_sphereGroup (r : ℕ) :=
  PresentedGroup ({(List.ofFn (FreeGroup.of : Fin r → FreeGroup (Fin r))).prod} :
    Set (FreeGroup (Fin r)))

/-- RiemannRochTop: the defining generators have product one and the required universal property. -/
lemma RiemannRochTop_sphereGroup_presentation (r : ℕ) :
    (List.ofFn (PresentedGroup.of : Fin r → RiemannRochTop_sphereGroup r)).prod = 1 ∧
    (∀ (H : Type) [Group H] (k : Fin r → H), (List.ofFn k).prod = 1 →
      ∃! φ : RiemannRochTop_sphereGroup r →* H, ∀ j, φ (PresentedGroup.of j) = k j) := by
  constructor
  · have h := PresentedGroup.one_of_mem
      (Set.mem_singleton (List.ofFn (FreeGroup.of : Fin r → FreeGroup (Fin r))).prod)
    rw [map_list_prod, List.map_ofFn] at h
    exact h
  · intro H _ k hk
    have hrel : ∀ w ∈ ({(List.ofFn (FreeGroup.of : Fin r → FreeGroup (Fin r))).prod} :
        Set (FreeGroup (Fin r))), FreeGroup.lift k w = 1 := by
      intro w hw
      rw [Set.mem_singleton_iff] at hw
      subst w
      simpa only [map_list_prod, List.map_ofFn, Function.comp_def, FreeGroup.lift_apply_of] using hk
    refine ⟨PresentedGroup.toGroup hrel, fun _ ↦ PresentedGroup.toGroup.of hrel, ?_⟩
    intro φ hφ
    exact PresentedGroup.ext fun j ↦ (hφ j).trans (PresentedGroup.toGroup.of hrel).symm

/-- RiemannRochTop: eliminating one puncture generator gives the free group on the others. -/
lemma RiemannRochTop_sphereGroup_free (r : ℕ) :
    Nonempty (RiemannRochTop_sphereGroup (r + 1) ≃* FreeGroup (Fin r)) := by
  let k : Fin (r + 1) → FreeGroup (Fin r) :=
    Fin.cases ((List.ofFn (FreeGroup.of : Fin r → FreeGroup (Fin r))).prod)⁻¹ FreeGroup.of
  have hk : (List.ofFn k).prod = 1 := by
    simp [k, List.ofFn_succ]
  obtain ⟨φ, hφ, -⟩ := (RiemannRochTop_sphereGroup_presentation (r + 1)).2
    (FreeGroup (Fin r)) k hk
  let ψ : FreeGroup (Fin r) →* RiemannRochTop_sphereGroup (r + 1) :=
    FreeGroup.lift (fun j ↦ PresentedGroup.of j.succ)
  have hleft : ψ.comp φ = MonoidHom.id _ := by
    apply PresentedGroup.ext
    intro j
    induction j using Fin.cases with
    | zero =>
      have hrel : (PresentedGroup.of (0 : Fin (r + 1)) :
          RiemannRochTop_sphereGroup (r + 1)) *
          (List.ofFn (fun j : Fin r ↦ (PresentedGroup.of j.succ :
            RiemannRochTop_sphereGroup (r + 1)))).prod = 1 := by
        simpa only [List.ofFn_succ, List.prod_cons] using
          (RiemannRochTop_sphereGroup_presentation (r + 1)).1
      simp only [MonoidHom.comp_apply, MonoidHom.id_apply, hφ, k, Fin.cases_zero,
        map_inv, map_list_prod, List.map_ofFn]
      change ((List.ofFn (fun j : Fin r ↦ (PresentedGroup.of j.succ :
        RiemannRochTop_sphereGroup (r + 1)))).prod)⁻¹ = PresentedGroup.of 0
      exact (eq_inv_of_mul_eq_one_left hrel).symm
    | succ j =>
      simp only [MonoidHom.comp_apply, MonoidHom.id_apply, hφ, k, Fin.cases_succ,
        ψ, FreeGroup.lift_apply_of]
  have hright : φ.comp ψ = MonoidHom.id _ := by
    apply FreeGroup.ext_hom
    intro j
    simp only [MonoidHom.comp_apply, MonoidHom.id_apply, ψ, FreeGroup.lift_apply_of,
      hφ, k, Fin.cases_succ]
  exact ⟨{
    toFun := φ
    invFun := ψ
    left_inv := fun x ↦ congrArg (fun h : RiemannRochTop_sphereGroup (r + 1) →*
      RiemannRochTop_sphereGroup (r + 1) ↦ h x) hleft
    right_inv := fun x ↦ congrArg (fun h : FreeGroup (Fin r) →* FreeGroup (Fin r) ↦ h x) hright
    map_mul' := φ.map_mul }⟩

/-- RiemannRochTop: transport the puncture presentation across a group isomorphism. -/
lemma RiemannRochTop_presentation_transport (r : ℕ) (Γ : Type) [Group Γ]
    (e : Γ ≃* RiemannRochTop_sphereGroup r) :
    (List.ofFn (fun j : Fin r ↦ e.symm (PresentedGroup.of j))).prod = 1 ∧
    (∀ (H : Type) [Group H] (k : Fin r → H), (List.ofFn k).prod = 1 →
      ∃! φ : Γ →* H, ∀ j, φ (e.symm (PresentedGroup.of j)) = k j) := by
  obtain ⟨hprod, hlift⟩ := RiemannRochTop_sphereGroup_presentation r
  constructor
  · have h := congrArg e.symm hprod
    simpa only [map_list_prod, List.map_ofFn, Function.comp_def, map_one] using h
  · intro H _ k hk
    obtain ⟨ψ, hψ, huniq⟩ := hlift H k hk
    refine ⟨ψ.comp e.toMonoidHom, ?_, ?_⟩
    · intro j
      simpa only [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, MulEquiv.apply_symm_apply]
        using hψ j
    · intro φ hφ
      have h := huniq (φ.comp e.symm.toMonoidHom) hφ
      ext x
      have hx := congrArg (fun f : RiemannRochTop_sphereGroup r →* H ↦ f (e x)) h
      simpa only [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, MulEquiv.symm_apply_apply]
        using hx

/-- RiemannRochTop: the once-punctured presentation with its rotation-generator clause. -/
lemma RiemannRochTop_single_puncture_full (b : Fin 1 → OnePoint ℂ)
    (hb : Function.Injective b) (y₀ : {y : OnePoint ℂ // y ∉ Set.range b}) :
    ∃ γ : Fin 1 → FundamentalGroup {y : OnePoint ℂ // y ∉ Set.range b} y₀,
      (List.ofFn γ).prod = 1 ∧
      (∀ (H : Type) [Group H] (k : Fin 1 → H), (List.ofFn k).prod = 1 →
        ∃! φ : FundamentalGroup {y : OnePoint ℂ // y ∉ Set.range b} y₀ →* H, ∀ j, φ (γ j) = k j) ∧
      ∀ (E' : Type) [NormedAddCommGroup E'] [NormedSpace ℂ E']
        (hE' : Module.finrank ℂ E' = 1) (C' : Type) [TopologicalSpace C'] [ChartedSpace E' C'] [IsManifold 𝓘(ℂ, E') ω C']
        [T2Space C'] [CompactSpace C'] [ConnectedSpace C'] (G : Type) [Group G] [Finite G]
        [MulAction G C'] [FaithfulSMul G C'],
        (∀ g : G, ContMDiff 𝓘(ℂ, E') 𝓘(ℂ, E') ω (fun x : C' ↦ g • x)) →
        ∀ f : C' → OnePoint ℂ, ContMDiff 𝓘(ℂ, E') 𝓘(ℂ, ℂ) ω f → b4_IsGaloisCover G f →
        (∀ x, f x ∉ Set.range b → MulAction.stabilizer G x = ⊥) →
        ∀ (j : Fin 1) (c : Path y₀ y₀), FundamentalGroup.fromPath ⟦c⟧ = γ j →
        ∀ (Γ : C(unitInterval, C')) (k : G), (∀ t, f (Γ t) = (c t : OnePoint ℂ)) →
          Γ 1 = k • Γ 0 → ∃ x, f x = b j ∧ b4_IsRotGen E' x k := by
  obtain ⟨γ, hprod, huniv⟩ := RiemannRochTop_single_puncture_presentation b y₀
  refine ⟨γ, hprod, huniv, ?_⟩
  intro E' _ _ hE' C' _ _ _ _ _ _ G _ _ _ _ hG f hf hgal hfree j c _hc Γ k hΓ _hk
  have hfree' : ∀ x, f x ≠ b 0 → MulAction.stabilizer G x = ⊥ := by
    intro x hx
    apply hfree x
    rintro ⟨i, hi⟩
    exact hx (hi.symm.trans (congrArg b (Subsingleton.elim i 0)))
  have hu : f (Γ 0) ≠ b 0 := by
    rw [hΓ 0]
    intro h
    exact (c 0).property ⟨0, h.symm⟩
  have hall := RiemannRochTop_single_branch_trivial hE' hG f hf hgal (b 0) hfree' (Γ 0) hu
  have hsurj : Function.Surjective f := b4cov_surjective (by simp) f hf
    (b4cov_nonconst_of_galois hE' f hgal (Γ 0))
  obtain ⟨x, hx⟩ := hsurj (b j)
  obtain ⟨g, hg⟩ := b4cov_exists_rotGen hE' hG x
  refine ⟨x, hx, ?_⟩
  simpa only [hall g, hall k] using hg

/-- RiemannRochTop: the presentation of the sphere with no punctures. -/
lemma RiemannRochTop_unpunctured_full (b : Fin 0 → OnePoint ℂ)
    (hb : Function.Injective b) (y₀ : {y : OnePoint ℂ // y ∉ Set.range b}) :
    ∃ γ : Fin 0 → FundamentalGroup {y : OnePoint ℂ // y ∉ Set.range b} y₀,
      (List.ofFn γ).prod = 1 ∧
      (∀ (H : Type) [Group H] (k : Fin 0 → H), (List.ofFn k).prod = 1 →
        ∃! φ : FundamentalGroup {y : OnePoint ℂ // y ∉ Set.range b} y₀ →* H, ∀ j, φ (γ j) = k j) ∧
      ∀ (E' : Type) [NormedAddCommGroup E'] [NormedSpace ℂ E']
        (hE' : Module.finrank ℂ E' = 1) (C' : Type) [TopologicalSpace C'] [ChartedSpace E' C'] [IsManifold 𝓘(ℂ, E') ω C']
        [T2Space C'] [CompactSpace C'] [ConnectedSpace C'] (G : Type) [Group G] [Finite G]
        [MulAction G C'] [FaithfulSMul G C'],
        (∀ g : G, ContMDiff 𝓘(ℂ, E') 𝓘(ℂ, E') ω (fun x : C' ↦ g • x)) →
        ∀ f : C' → OnePoint ℂ, ContMDiff 𝓘(ℂ, E') 𝓘(ℂ, ℂ) ω f → b4_IsGaloisCover G f →
        (∀ x, f x ∉ Set.range b → MulAction.stabilizer G x = ⊥) →
        ∀ (j : Fin 0) (c : Path y₀ y₀), FundamentalGroup.fromPath ⟦c⟧ = γ j →
        ∀ (Γ : C(unitInterval, C')) (k : G), (∀ t, f (Γ t) = (c t : OnePoint ℂ)) →
          Γ 1 = k • Γ 0 → ∃ x, f x = b j ∧ b4_IsRotGen E' x k := by
  have : SimplyConnectedSpace (OnePoint ℂ) := RiemannRochTop_sphere_simplyConnected
  have : SimplyConnectedSpace {y : OnePoint ℂ // y ∉ Set.range b} := by
    have hrange : Set.range b = ∅ := by simp
    change IsSimplyConnected (Set.range b)ᶜ
    rw [hrange, Set.compl_empty]
    exact (Homeomorph.Set.univ (OnePoint ℂ)).toHomotopyEquiv.simplyConnectedSpace
  refine ⟨Fin.elim0, by simp, ?_, ?_⟩
  · intro H _ k _
    refine ⟨1, fun j ↦ Fin.elim0 j, ?_⟩
    intro φ _
    ext x
    have hx : x = 1 := Subsingleton.elim _ _
    simp only [hx, map_one]
  · intro E' _ _ hE' C' _ _ _ _ _ _ G _ _ _ _ hG f hf hgal hfree j
    exact Fin.elim0 j

/-- RiemannRochTop: scalar endomorphisms commute with a change of tangent coordinates. -/
lemma RiemannRochTop_scalar_conjugate (hE : Module.finrank ℂ E = 1)
    (A B T : E →L[ℂ] E) (hAB : A.comp B = ContinuousLinearMap.id ℂ E) :
    A.comp (T.comp B) = T := by
  ext v
  change A (T (B v)) = T v
  rw [b4cov_eq_smul hE T (B v), map_smul]
  have hv : A (B v) = v := congrArg (fun L : E →L[ℂ] E ↦ L v) hAB
  rw [hv, b4cov_eq_smul hE T v]

theorem b4c_rotation_chart_independent_aux (hE : Module.finrank ℂ E = 1) (s : C → C)
    (hs : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω s) (p : C) (hp : s p = p)
    (φ : OpenPartialHomeomorph C E) (hφ : φ ∈ atlas E C) (hpφ : p ∈ φ.source) :
    b4c_rotation hE s p = (b4cov_lineEquiv hE).symm
      (fderiv ℂ (φ ∘ s ∘ φ.symm) (φ p) (b4cov_lineEquiv hE 1)) := by
  have hφd := mdifferentiable_of_mem_atlas (I := 𝓘(ℂ, E)) hφ
  have hd := (hs p).mdifferentiableAt (by simp)
  have hleft := φ.left_inv hpφ
  have hsd : MDifferentiableAt 𝓘(ℂ, E) 𝓘(ℂ, E) s (φ.symm (φ p)) := by
    rw [hleft]
    exact hd
  have hφs : MDifferentiableAt 𝓘(ℂ, E) 𝓘(ℂ, E) φ (s (φ.symm (φ p))) := by
    rw [hleft, hp]
    exact hφd.mdifferentiableAt hpφ
  have hsym := hφd.mdifferentiableAt_symm (φ.map_source hpφ)
  have hchain := mfderiv_comp (φ p) hφs (hsd.comp (φ p) hsym)
  rw [mfderiv_comp (φ p) hsd hsym] at hchain
  simp only [Function.comp_apply, mfderiv_eq_fderiv] at hchain
  have hAB := hφd.comp_symm_deriv (φ.map_source hpφ)
  have hAB' : (mfderiv 𝓘(ℂ, E) 𝓘(ℂ, E) φ p : E →L[ℂ] E).comp
      (mfderiv 𝓘(ℂ, E) 𝓘(ℂ, E) φ.symm (φ p)) = ContinuousLinearMap.id ℂ E := by
    convert hAB using 1 <;> rw [hleft]
    rfl
  have hchain' : fderiv ℂ (φ ∘ s ∘ φ.symm) (φ p) =
      (mfderiv 𝓘(ℂ, E) 𝓘(ℂ, E) φ p : E →L[ℂ] E).comp
        ((mfderiv 𝓘(ℂ, E) 𝓘(ℂ, E) s p : E →L[ℂ] E).comp
          (mfderiv 𝓘(ℂ, E) 𝓘(ℂ, E) φ.symm (φ p))) := by
    convert hchain using 1 <;> rw [hleft, hp]
    rfl
  have heq := hchain'.trans (RiemannRochTop_scalar_conjugate hE _ _ _ hAB')
  exact congrArg (fun T : E →L[ℂ] E ↦
    (b4cov_lineEquiv hE).symm (T (b4cov_lineEquiv hE 1))) heq.symm

/-- RiemannRochTop: fixed points of a nonidentity holomorphic map are isolated. -/
lemma RiemannRochTop_fixed_isolated [T2Space C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1)
    (s : C → C) (hs : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω s)
    (hne : s ≠ id) (x : C) (hx : s x = x) : ∀ᶠ z in 𝓝 x, s z = z → z = x := by
  have : FiniteDimensional ℂ E := Module.finite_of_finrank_eq_succ hE
  have := FiniteDimensional.complete ℂ E
  by_contra hcon
  rw [Filter.not_eventually] at hcon
  have hfr : ∃ᶠ z in 𝓝[≠] x, s z = z := by
    rw [frequently_nhdsWithin_iff]
    exact hcon.mono fun z hz ↦ ⟨(not_imp.1 hz).1, (not_imp.1 hz).2⟩
  set φ := extChartAt 𝓘(ℂ, E) x
  have hfr' := b4cov_frequently_chart (E := E) (E' := E) (id : C → C) continuous_id x hfr
  let T : E → E := fun w ↦ φ (s (φ.symm w)) - w
  have hT : AnalyticAt ℂ T (φ x) := by
    have := b4cov_analyticAt_chart (fun z : C ↦ s z) hs x x (φ x) (mem_extChartAt_target x)
      (by simp only [φ, extChartAt_to_inv, hx]; exact mem_extChartAt_source x)
    exact this.sub analyticAt_id
  have hTz : ∃ᶠ w in 𝓝[≠] (φ x), T w = 0 := by
    refine hfr'.mono fun w ⟨hw, hP⟩ ↦ ?_
    have hP' : s (φ.symm w) = φ.symm w := hP
    simp only [T]
    rw [hP', φ.right_inv hw.1, sub_self]
  have hev := b4cov_eventually_zero_of_frequently hE hT hTz
  have hcont : ContinuousAt (fun z ↦ s z) x := hs.continuous.continuousAt
  have hloc : ∀ᶠ z in 𝓝 x, s z = z := by
    have h1 := (continuousAt_extChartAt x).preimage_mem_nhds hev
    have h2 : ∀ᶠ z in 𝓝 x, s z ∈ φ.source :=
      hcont.preimage_mem_nhds (by rw [hx]; exact extChartAt_source_mem_nhds x)
    filter_upwards [h1, h2, extChartAt_source_mem_nhds (I := 𝓘(ℂ, E)) x] with z hz1 hz2 hz3
    have : φ (s (φ.symm (φ z))) - φ z = 0 := hz1
    rw [φ.left_inv hz3, sub_eq_zero] at this
    exact φ.injOn hz2 hz3 this
  have hall := b4cov_eq_of_eventuallyEq (fun z : C ↦ s z) id hs contMDiff_id x hloc
  exact hne hall

/-- RiemannRochTop: a nonidentity holomorphic self-map of a compact surface has finitely many fixed points. -/
lemma RiemannRochTop_fixed_finite [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (s : C → C)
    (hs : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω s) (hne : s ≠ id) :
    {x : C | s x = x}.Finite := by
  have hcl : IsClosed {x : C | s x = x} := isClosed_eq hs.continuous continuous_id
  refine hcl.isCompact.finite ?_
  rw [isDiscrete_iff_discreteTopology, discreteTopology_subtype_iff]
  intro x hx
  have hiso := RiemannRochTop_fixed_isolated hE s hs hne x hx
  rw [Filter.inf_principal_eq_bot]
  exact Filter.mem_inf_of_inter hiso (Filter.mem_principal_self {x}ᶜ) fun z ⟨hz, hzx⟩ hfix ↦
    hzx (hz hfix)

/-- RiemannRochTop: a nonidentity finite-order automorphism has no unit tangent rotation at a fixed point. -/
lemma RiemannRochTop_rotation_ne_one [T2Space C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (s : C ≃ₜ C)
    (hs : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω s) (hne : s ≠ Homeomorph.refl C)
    (n : ℕ) (hn : 0 < n) (hord : s^[n] = id) (p : C) (hp : s p = p) :
    b4c_rotation hE s p ≠ 1 := by
  let e : Equiv.Perm C := s.toEquiv
  have he : e ^ n = 1 := by
    ext x
    exact congrFun hord x
  have hfinite : IsOfFinOrder e := isOfFinOrder_iff_pow_eq_one.mpr ⟨n, hn, he⟩
  have hfin : (Subgroup.zpowers e : Set (Equiv.Perm C)).Finite := by
    rw [← hfinite.powers_eq_zpowers]
    exact hfinite.finite_powers
  letI : Finite (Subgroup.zpowers e) := hfin.to_subtype
  have hG : ∀ g : Subgroup.zpowers e,
      ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω (fun x : C ↦ g • x) := by
    intro g
    obtain ⟨m, hm⟩ := hfinite.mem_powers_iff_mem_zpowers.mpr g.property
    have heq : (fun x : C ↦ g • x) = s^[m] := by
      funext x
      change g.val x = s^[m] x
      rw [← hm]
      rfl
    rw [heq]
    exact hs.iterate m
  let k : Subgroup.zpowers e := ⟨e, Subgroup.mem_zpowers e⟩
  intro hl
  have hk := b4cov_eq_one_of_lam hE hG p k hp hl
  apply hne
  ext x
  exact congrArg (fun g : Subgroup.zpowers e ↦ g.val x) hk

/-- RiemannRochTop: tangent rotations multiply under composition when the inner map fixes the point. -/
lemma RiemannRochTop_rotation_comp (hE : Module.finrank ℂ E = 1) (f g : C → C)
    (hf : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω f)
    (hg : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω g) (p : C) (hgp : g p = p) :
    b4c_rotation hE (f ∘ g) p = b4c_rotation hE f p * b4c_rotation hE g p := by
  have hchain : (mfderiv 𝓘(ℂ, E) 𝓘(ℂ, E) (f ∘ g) p : E →L[ℂ] E) =
      (mfderiv 𝓘(ℂ, E) 𝓘(ℂ, E) f p : E →L[ℂ] E).comp
        (mfderiv 𝓘(ℂ, E) 𝓘(ℂ, E) g p) := by
    convert mfderiv_comp p ((hf _).mdifferentiableAt (by simp))
      ((hg _).mdifferentiableAt (by simp)) using 1 <;> rw [hgp]
  have hscalar (A B : E →L[ℂ] E) :
      (b4cov_lineEquiv hE).symm ((A.comp B) (b4cov_lineEquiv hE 1)) =
        (b4cov_lineEquiv hE).symm (A (b4cov_lineEquiv hE 1)) *
          (b4cov_lineEquiv hE).symm (B (b4cov_lineEquiv hE 1)) := by
    rw [ContinuousLinearMap.comp_apply, b4cov_eq_smul hE B, map_smul, map_smul]
    simp only [map_smul, ContinuousLinearEquiv.symm_apply_apply, smul_eq_mul, mul_one, one_mul, mul_comm]
  exact (congrArg (fun T : E →L[ℂ] E ↦
    (b4cov_lineEquiv hE).symm (T (b4cov_lineEquiv hE 1))) hchain).trans (hscalar _ _)

/-- RiemannRochTop: the identity map has tangent rotation one. -/
lemma RiemannRochTop_rotation_id (hE : Module.finrank ℂ E = 1) (p : C) :
    b4c_rotation hE id p = 1 := by
  unfold b4c_rotation
  rw [mfderiv_id]
  exact (b4cov_lineEquiv hE).symm_apply_apply 1

/-- RiemannRochTop: tangent rotation of an iterate is a power at a fixed point. -/
lemma RiemannRochTop_rotation_iterate (hE : Module.finrank ℂ E = 1) (f : C → C)
    (hf : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω f) (p : C) (hp : f p = p) (n : ℕ) :
    b4c_rotation hE (f^[n]) p = b4c_rotation hE f p ^ n := by
  induction n with
  | zero => simpa only [Function.iterate_zero, pow_zero] using RiemannRochTop_rotation_id hE p
  | succ n ih =>
    rw [Function.iterate_succ,
      RiemannRochTop_rotation_comp hE (f^[n]) f (hf.iterate n) hf p hp, ih, pow_succ]

/-- RiemannRochTop: periodic maps have root-of-unity tangent rotations at fixed points. -/
lemma RiemannRochTop_rotation_pow (hE : Module.finrank ℂ E = 1) (f : C → C)
    (hf : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω f) (p : C) (hp : f p = p)
    (n : ℕ) (hord : f^[n] = id) : b4c_rotation hE f p ^ n = 1 := by
  rw [← RiemannRochTop_rotation_iterate hE f hf p hp n, hord,
    RiemannRochTop_rotation_id]

/-- RiemannRochTop: periodic maps have unit-norm tangent rotations at fixed points. -/
lemma RiemannRochTop_rotation_norm (hE : Module.finrank ℂ E = 1) (f : C → C)
    (hf : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω f) (p : C) (hp : f p = p)
    (n : ℕ) (hn : 0 < n) (hord : f^[n] = id) : ‖b4c_rotation hE f p‖ = 1 := by
  exact Complex.norm_eq_one_of_pow_eq_one
    (RiemannRochTop_rotation_pow hE f hf p hp n hord) (Nat.ne_of_gt hn)

/-- RiemannRochTop: the inverse of a periodic holomorphic homeomorphism is holomorphic. -/
lemma RiemannRochTop_symm_holomorphic (s : C ≃ₜ C)
    (hs : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω s)
    (n : ℕ) (hn : 0 < n) (hord : s^[n] = id) :
    ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω s.symm := by
  have heq : (s.symm : C → C) = s^[n.pred] := by
    funext p
    apply s.injective
    rw [s.apply_symm_apply]
    have h := congrFun (Function.comp_iterate_pred_of_pos (f := (s : C → C)) hn) p
    rw [hord] at h
    exact h.symm
  rw [heq]
  exact hs.iterate n.pred

/-- RiemannRochTop: inverse maps have inverse tangent rotations at fixed points. -/
lemma RiemannRochTop_rotation_symm (hE : Module.finrank ℂ E = 1) (s : C ≃ₜ C)
    (hs : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω s)
    (hi : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω s.symm) (p : C) (hp : s p = p) :
    b4c_rotation hE s.symm p = (b4c_rotation hE s p)⁻¹ := by
  have h := RiemannRochTop_rotation_comp hE s.symm s hi hs p hp
  have heq : (s.symm : C → C) ∘ s = id := funext s.symm_apply_apply
  rw [heq, RiemannRochTop_rotation_id] at h
  exact eq_inv_of_mul_eq_one_left h.symm

/-- RiemannRochTop: inversion conjugates the tangent rotation of a periodic map. -/
lemma RiemannRochTop_rotation_symm_conj (hE : Module.finrank ℂ E = 1) (s : C ≃ₜ C)
    (hs : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω s) (p : C) (hp : s p = p)
    (n : ℕ) (hn : 0 < n) (hord : s^[n] = id) :
    b4c_rotation hE s.symm p = starRingEnd ℂ (b4c_rotation hE s p) := by
  rw [RiemannRochTop_rotation_symm hE s hs
    (RiemannRochTop_symm_holomorphic s hs n hn hord) p hp]
  exact Complex.inv_eq_conj (RiemannRochTop_rotation_norm hE s hs p hp n hn hord)

/-- RiemannRochTop: a unit rotation different from one has local contribution of real part minus one half. -/
lemma RiemannRochTop_local_trace_re (z : ℂ) (hz : ‖z‖ = 1) (hne : z ≠ 1) :
    (z / (1 - z)).re = -(1 / 2 : ℝ) := by
  have hz0 : z ≠ 0 := by
    intro h
    simpa only [h, norm_zero, zero_ne_one] using hz
  have hsum : z / (1 - z) + starRingEnd ℂ (z / (1 - z)) = -1 := by
    rw [map_div₀, map_sub, map_one, ← Complex.inv_eq_conj hz]
    field_simp [hz0, sub_ne_zero.mpr (Ne.symm hne)]
    <;> ring
  have hr := congrArg Complex.re hsum
  simp only [Complex.add_re, Complex.conj_re, Complex.neg_re, Complex.one_re] at hr
  linarith

/-- RiemannRochTop: the support of the local trace contributions is the fixed-point set. -/
lemma RiemannRochTop_local_trace_support [T2Space C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (s : C ≃ₜ C)
    (hs : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω s) (hne : s ≠ Homeomorph.refl C)
    (n : ℕ) (hn : 0 < n) (hord : s^[n] = id) :
    Function.support (fun p : C ↦
      if s p = p then b4c_rotation hE s p / (1 - b4c_rotation hE s p) else 0) =
      {p : C | s p = p} := by
  ext p
  by_cases hp : s p = p
  · have hz : b4c_rotation hE s p ≠ 0 := by
      intro hz
      have hnorm := RiemannRochTop_rotation_norm hE s hs p hp n hn hord
      simpa only [hz, norm_zero, zero_ne_one] using hnorm
    have hden : 1 - b4c_rotation hE s p ≠ 0 :=
      sub_ne_zero.mpr (Ne.symm (RiemannRochTop_rotation_ne_one hE s hs hne n hn hord p hp))
    simp only [Function.mem_support, Set.mem_ofPred_eq, hp, ite_true, iff_true]
    exact div_ne_zero hz hden
  · simp only [Function.mem_support, Set.mem_ofPred_eq, hp, ite_false, ne_eq,
      not_true_eq_false]

/-- RiemannRochTop: the real part of the fixed-point expression counts fixed points. -/
lemma RiemannRochTop_fixed_sum_re [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (s : C ≃ₜ C)
    (hs : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω s) (hne : s ≠ Homeomorph.refl C)
    (n : ℕ) (hn : 0 < n) (hord : s^[n] = id) :
    (1 + ∑ᶠ p : C,
      if s p = p then b4c_rotation hE s p / (1 - b4c_rotation hE s p) else 0).re =
      1 - ({p : C | s p = p}.ncard : ℝ) / 2 := by
  have hne' : (s : C → C) ≠ id := by
    intro heq
    exact hne (Homeomorph.ext (congrFun heq))
  have hfin := RiemannRochTop_fixed_finite hE s hs hne'
  rw [finsum_eq_sum_of_support_subset_of_finite _
    (RiemannRochTop_local_trace_support hE s hs hne n hn hord).subset hfin]
  rw [Complex.add_re, Complex.one_re, Complex.re_sum,
    Set.ncard_eq_toFinset_card _ hfin]
  have heq : ∀ p ∈ hfin.toFinset,
      (if s p = p then b4c_rotation hE s p / (1 - b4c_rotation hE s p) else 0).re =
        -(1 / 2 : ℝ) := by
    intro p hp
    have hp' : s p = p := hfin.mem_toFinset.mp hp
    rw [if_pos hp']
    exact RiemannRochTop_local_trace_re _
      (RiemannRochTop_rotation_norm hE s hs p hp' n hn hord)
      (RiemannRochTop_rotation_ne_one hE s hs hne n hn hord p hp')
  rw [Finset.sum_congr rfl heq, Finset.sum_const, nsmul_eq_mul]
  ring

/-- RiemannRochTop: the local fixed-point contribution is a simple-pole residue. -/
lemma RiemannRochTop_local_trace_residue (f : ℂ → ℂ) (z : ℂ)
    (hf : AnalyticAt ℂ f z) (hz : f z = z) (hd : deriv f z ≠ 1) :
    residue (fun w ↦ deriv f w / (w - f w)) z = deriv f z / (1 - deriv f z) := by
  have hden : deriv (fun w ↦ w - f w) z = 1 - deriv f z :=
    (hasDerivAt_id z |>.sub hf.differentiableAt.hasDerivAt).deriv
  have hne : deriv (fun w ↦ w - f w) z ≠ 0 := by
    rw [hden, sub_ne_zero]
    exact Ne.symm hd
  have hres := residue_div_of_zero_deriv_ne_zero hf.deriv (analyticAt_id.sub hf)
    (by change z - f z = 0; rw [hz, sub_self]) hne
  change residue (fun w ↦ deriv f w / (w - f w)) z =
    deriv f z / deriv (fun w ↦ w - f w) z at hres
  rw [hden] at hres
  exact hres

/-- RiemannRochTop: pullback reverses composition of holomorphic self-maps. -/
lemma RiemannRochTop_pullback_comp (f g : C → C)
    (hf : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω f)
    (hg : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω g) :
    b4c_formPullbackEnd (f ∘ g) (hf.comp hg) =
      (b4c_formPullbackEnd g hg) * (b4c_formPullbackEnd f hf) := by
  apply LinearMap.ext
  intro w
  apply Subtype.ext
  funext p
  change w.val ⟨f (g p.1), mfderiv 𝓘(ℂ, E) 𝓘(ℂ, E) (f ∘ g) p.1 p.2⟩ =
    w.val ⟨f (g p.1), mfderiv 𝓘(ℂ, E) 𝓘(ℂ, E) f (g p.1)
      (mfderiv 𝓘(ℂ, E) 𝓘(ℂ, E) g p.1 p.2)⟩
  rw [mfderiv_comp p.1 ((hf _).mdifferentiableAt (by simp))
    ((hg _).mdifferentiableAt (by simp))]
  rfl

/-- RiemannRochTop: identity pullback is the identity on holomorphic forms. -/
lemma RiemannRochTop_pullback_id :
    b4c_formPullbackEnd (E := E) (id : C → C) contMDiff_id = 1 := by
  apply LinearMap.ext
  intro w
  apply Subtype.ext
  funext p
  change w.val ⟨p.1, mfderiv 𝓘(ℂ, E) 𝓘(ℂ, E) id p.1 p.2⟩ = w.val p
  rw [mfderiv_id]
  rfl

/-- RiemannRochTop: iterating a map iterates its action on holomorphic forms. -/
lemma RiemannRochTop_pullback_iterate (f : C → C)
    (hf : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω f) (n : ℕ) :
    b4c_formPullbackEnd (f^[n]) (hf.iterate n) = (b4c_formPullbackEnd f hf) ^ n := by
  induction n with
  | zero => exact RiemannRochTop_pullback_id
  | succ n ih =>
    calc
      _ = (b4c_formPullbackEnd f hf) *
          (b4c_formPullbackEnd (f^[n]) (hf.iterate n)) := by
        simpa only [Function.iterate_succ] using
          RiemannRochTop_pullback_comp (f^[n]) f (hf.iterate n) hf
      _ = _ := by rw [ih, pow_succ']

/-- RiemannRochTop: a periodic holomorphic map acts periodically on holomorphic forms. -/
lemma RiemannRochTop_pullback_pow (f : C → C)
    (hf : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω f) (n : ℕ) (hn : f^[n] = id) :
    (b4c_formPullbackEnd f hf) ^ n = 1 := by
  rw [← RiemannRochTop_pullback_iterate]
  simpa only [hn] using (RiemannRochTop_pullback_id (E := E) (C := C))

/-- RiemannRochTop: finite-order pullback on holomorphic forms is semisimple. -/
lemma RiemannRochTop_pullback_semisimple (f : C → C)
    (hf : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω f) (n : ℕ) (hn : 0 < n)
    (hord : f^[n] = id) : (b4c_formPullbackEnd f hf).IsSemisimple := by
  apply Module.End.isSemisimple_of_squarefree_aeval_eq_zero
    (p := (Polynomial.X : Polynomial ℂ) ^ n - 1)
  · simpa only [Polynomial.C_1] using
      (Polynomial.separable_X_pow_sub_C (1 : ℂ)
        (Nat.cast_ne_zero.mpr (Nat.ne_of_gt hn)) one_ne_zero).squarefree
  · simp only [map_sub, map_pow, Polynomial.aeval_X, map_one,
      RiemannRochTop_pullback_pow f hf n hord, sub_self]

/-- RiemannRochTop: the trace of an inverse periodic complex endomorphism is the conjugate trace. -/
lemma RiemannRochTop_periodic_trace_inverse {V : Type*} [AddCommGroup V] [Module ℂ V]
    [Module.Finite ℂ V] (f g : Module.End ℂ V) (hgf : g * f = 1)
    (n : ℕ) (hn : 0 < n) (hf : f ^ n = 1) :
    LinearMap.trace ℂ V g = starRingEnd ℂ (LinearMap.trace ℂ V f) := by
  classical
  have hss : f.IsSemisimple := by
    apply Module.End.isSemisimple_of_squarefree_aeval_eq_zero
      (p := Polynomial.X ^ n - 1)
    · simpa only [Polynomial.C_1] using
        (Polynomial.separable_X_pow_sub_C (1 : ℂ)
          (Nat.cast_ne_zero.mpr (Nat.ne_of_gt hn)) one_ne_zero).squarefree
    · simp only [map_sub, map_pow, Polynomial.aeval_X, map_one, hf, sub_self]
  let S : Set V := {v | ∃ μ : ℂ, f v = μ • v}
  have hspan : ⊤ ≤ Submodule.span ℂ S := by
    rw [← hss.iSup_eigenspace_eq_top]
    refine iSup_le fun μ ↦ ?_
    intro v hv
    exact Submodule.subset_span ⟨μ, Module.End.mem_eigenspace_iff.mp hv⟩
  let b := Module.Basis.ofSpan hspan
  letI := FiniteDimensional.fintypeBasisIndex b
  have hb : ∀ i, ∃ μ : ℂ, f (b i) = μ • b i := fun i ↦
    Module.Basis.ofSpan_subset hspan (Set.mem_range_self i)
  choose μ hμ using hb
  have hμpow : ∀ i, μ i ^ n = 1 := by
    intro i
    have hv : f.HasEigenvector (μ i) (b i) :=
      ⟨Module.End.mem_eigenspace_iff.mpr (hμ i), b.ne_zero i⟩
    apply smul_left_injective ℂ (b.ne_zero i)
    simpa only [hf, Module.End.one_apply, one_smul] using (hv.pow_apply n).symm
  have hμnorm : ∀ i, ‖μ i‖ = 1 := fun i ↦
    Complex.norm_eq_one_of_pow_eq_one (hμpow i) (Nat.ne_of_gt hn)
  have hg : ∀ i, g (b i) = starRingEnd ℂ (μ i) • b i := by
    intro i
    have hz : μ i ≠ 0 := by
      intro hz
      simpa only [hz, norm_zero, zero_ne_one] using hμnorm i
    have h := congrArg (fun T : Module.End ℂ V ↦ T (b i)) hgf
    change g (f (b i)) = b i at h
    rw [hμ i, map_smul] at h
    calc
      g (b i) = (μ i)⁻¹ • (μ i • g (b i)) := (inv_smul_smul₀ hz _).symm
      _ = starRingEnd ℂ (μ i) • b i := by rw [h, Complex.inv_eq_conj (hμnorm i)]
  rw [LinearMap.trace_eq_matrix_trace ℂ b, LinearMap.trace_eq_matrix_trace ℂ b]
  simp only [Matrix.trace, Matrix.diag_apply, LinearMap.toMatrix_apply, hg, hμ, map_smul,
    Module.Basis.repr_self, Finsupp.smul_apply, Finsupp.single_eq_same, smul_eq_mul,
    mul_one, map_sum]

/-- RiemannRochTop: inverse pullback has conjugate trace on holomorphic forms. -/
lemma RiemannRochTop_pullback_trace_symm [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (s : C ≃ₜ C)
    (hs : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω s)
    (n : ℕ) (hn : 0 < n) (hord : s^[n] = id) :
    LinearMap.trace ℂ (b3_HolForm E C)
      (b4c_formPullbackEnd s.symm (RiemannRochTop_symm_holomorphic s hs n hn hord)) =
      starRingEnd ℂ (LinearMap.trace ℂ (b3_HolForm E C) (b4c_formPullbackEnd s hs)) := by
  have : FiniteDimensional ℂ E := Module.finite_of_finrank_eq_succ hE
  have : Module.Finite ℂ (b3_HolForm E C) := b3Forms_holForm_finiteDimensional hE
  have hi := RiemannRochTop_symm_holomorphic s hs n hn hord
  apply RiemannRochTop_periodic_trace_inverse (b4c_formPullbackEnd s hs)
    (b4c_formPullbackEnd s.symm hi) _ n hn (RiemannRochTop_pullback_pow s hs n hord)
  rw [← RiemannRochTop_pullback_comp s s.symm hs hi]
  have hid : (s : C → C) ∘ s.symm = id := funext s.apply_symm_apply
  simpa only [hid] using (RiemannRochTop_pullback_id (E := E) (C := C))

/-- RiemannRochTop: inversion conjugates the entire fixed-point expression. -/
lemma RiemannRochTop_fixed_sum_symm (hE : Module.finrank ℂ E = 1) (s : C ≃ₜ C)
    (hs : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω s)
    (n : ℕ) (hn : 0 < n) (hord : s^[n] = id) :
    (1 + ∑ᶠ p : C, if s.symm p = p then
      b4c_rotation hE s.symm p / (1 - b4c_rotation hE s.symm p) else 0) =
    starRingEnd ℂ (1 + ∑ᶠ p : C, if s p = p then
      b4c_rotation hE s p / (1 - b4c_rotation hE s p) else 0) := by
  rw [map_add, map_one]
  have hsum := (starRingEnd ℂ).toAddMonoidHom.map_finsum_of_injective
    (starRingEnd ℂ).injective (fun p : C ↦ if s p = p then
      b4c_rotation hE s p / (1 - b4c_rotation hE s p) else 0)
  change starRingEnd ℂ (∑ᶠ p : C, if s p = p then
      b4c_rotation hE s p / (1 - b4c_rotation hE s p) else 0) = _ at hsum
  rw [hsum]
  congr 1
  apply finsum_congr
  intro p
  have hfix : s.symm p = p ↔ s p = p := by
    constructor
    · intro h
      simpa only [s.apply_symm_apply] using (congrArg s h).symm
    · intro h
      simpa only [s.symm_apply_apply] using (congrArg s.symm h).symm
  by_cases hp : s p = p
  · rw [if_pos hp, if_pos (hfix.mpr hp),
      RiemannRochTop_rotation_symm_conj hE s hs p hp n hn hord]
    simp only [map_div₀, map_sub, map_one, RingHom.toAddMonoidHom_eq_coe, AddMonoidHom.coe_coe]
  · rw [if_neg hp, if_neg (mt hfix.mp hp)]
    exact (map_zero (starRingEnd ℂ).toAddMonoidHom).symm

theorem b4c_dz_elliptic_loc_eventuallyEq_one (x : b3_Elliptic) :
    HurwitzPrymRR_loc b3_ellipticModel_finrank b4c_dz_elliptic x =ᶠ[nhds 0]
      (fun _ ↦ (1 : ℂ)) := by
  let e := extChartAt (modelWithCornersSelf ℂ b3_EllipticModel) x
  let L := b4cov_lineEquiv b3_ellipticModel_finrank
  have hxs : x ∈ e.source := mem_extChartAt_source x
  have hxt : e x ∈ e.target := e.map_source hxs
  have hcont : Continuous (fun t : ℂ ↦ e x + L t) := continuous_const.add L.continuous
  have hev : ∀ᶠ t in nhds (0 : ℂ), e x + L t ∈ e.target :=
    hcont.continuousAt.preimage_mem_nhds
      (by simpa [e] using (isOpen_extChartAt_target x).mem_nhds hxt)
  filter_upwards [hev] with t ht
  have hys : e.symm (e x + L t) ∈ e.source := e.map_target ht
  have hys' : e.symm (e x + L t) ∈ (chartAt b3_EllipticModel x).source := by
    rw [← extChartAt_source (I := modelWithCornersSelf ℂ b3_EllipticModel) x]
    exact hys
  have hvec : b4cov_vec x (e.symm (e x + L t)) (L 1) = L 1 := by
    have h := b4cov_vec_triv x (e.symm (e x + L t)) hys (L 1)
    rw [b3A_torus_triv_snd b2_stdF x ⟨e.symm (e x + L t), L 1⟩ hys'] at h
    exact h
  dsimp only [HurwitzPrymRR_loc, b4cov_coef, b4c_dz_elliptic]
  rw [hvec, ContinuousLinearEquiv.symm_apply_apply]

theorem b4c_dz_elliptic_ordForm_eq_zero (x : b3_Elliptic) :
    b4c_ordForm (hE := b3_ellipticModel_finrank) b4c_dz_elliptic x = 0 := by
  unfold b4c_ordForm
  rw [meromorphicOrderAt_congr
    ((b4c_dz_elliptic_loc_eventuallyEq_one x).filter_mono nhdsWithin_le_nhds)]
  rw [meromorphicOrderAt_const]
  simp

theorem b4c_dz_sphere_secInf {w : ℂ} (hw : w ≠ 0) :
    b4c_dz_sphere (b4cov_secInf w) = -1 / w ^ 2 := by
  have hpt : (b4cov_secInf w).proj = ((w⁻¹ : ℂ) : OnePoint ℂ) := by
    change b4cov_chartInf.symm w = _
    rw [b4cov_chartInf_symm, b4cov_sphInv_coe hw]
  have key : ∀ (pt : OnePoint ℂ) (_ : pt = ((w⁻¹ : ℂ) : OnePoint ℂ)) (c : ℂ),
      (trivializationAt ℂ (TangentSpace (modelWithCornersSelf ℂ ℂ))
        (OnePoint.infty : OnePoint ℂ) ⟨pt, c⟩).2 = 1 →
        b4c_dz_sphere ⟨pt, c⟩ = -1 / w ^ 2 := by
    rintro _ rfl c hc
    rw [TangentBundle.trivializationAt_apply] at hc
    simp only [b4cov_chartAt_coe, b4cov_chartAt_infty, modelWithCornersSelf_coe,
      Set.range_id, fderivWithin_univ] at hc
    have hF :
        (⇑(b4cov_chartInf.extend (modelWithCornersSelf ℂ ℂ)) ∘
          ⇑(b4cov_chart0.extend (modelWithCornersSelf ℂ ℂ)).symm) =ᶠ[nhds w⁻¹]
          fun u ↦ u⁻¹ := by
      filter_upwards [isOpen_ne.mem_nhds (inv_ne_zero hw)] with u hu
      simp only [Function.comp_apply, OpenPartialHomeomorph.extend_coe,
        OpenPartialHomeomorph.extend_coe_symm, modelWithCornersSelf_coe,
        modelWithCornersSelf_coe_symm, Function.id_comp, Function.comp_id,
        b4cov_chart0_symm, b4cov_chartInf_apply, b4cov_chart0_sphInv hu]
    have hz : (b4cov_chart0.extend (modelWithCornersSelf ℂ ℂ))
        ((w⁻¹ : ℂ) : OnePoint ℂ) = w⁻¹ := by
      simp [OpenPartialHomeomorph.extend_coe, b4cov_chart0_coe]
    rw [hz, hF.fderiv_eq, fderiv_inv] at hc
    change c * -(w⁻¹ ^ 2)⁻¹ = 1 at hc
    simp only [b4c_dz_sphere, OnePoint.coe_ne_infty, ↓reduceIte]
    have hw2 : w ^ 2 ≠ 0 := pow_ne_zero 2 hw
    field_simp at hc ⊢
    linear_combination -hc
  exact key _ hpt _ (b4cov_triv_secInf w)

theorem b4c_dz_sphere_smul (x : OnePoint ℂ) (a : ℂ)
    (v : TangentSpace (modelWithCornersSelf ℂ ℂ) x) :
    b4c_dz_sphere ⟨x, a • v⟩ = a * b4c_dz_sphere ⟨x, v⟩ := by
  induction x using OnePoint.rec with
  | infty => simp [b4c_dz_sphere]
  | coe z =>
      simp only [b4c_dz_sphere, OnePoint.coe_ne_infty, ↓reduceIte]
      rfl

theorem b4c_dz_sphere_loc_infty_eventuallyEq :
    HurwitzPrymRR_loc (by simp) b4c_dz_sphere (OnePoint.infty : OnePoint ℂ) =ᶠ[nhdsWithin 0 {0}ᶜ]
      (fun w ↦ (b4cov_lineEquiv (by simp : Module.finrank ℂ ℂ = 1) 1) *
        (-1 / (b4cov_lineEquiv (by simp : Module.finrank ℂ ℂ = 1) w) ^ 2)) := by
  let L := b4cov_lineEquiv (by simp : Module.finrank ℂ ℂ = 1)
  filter_upwards [self_mem_nhdsWithin] with w hw
  have hw0 : w ≠ 0 := hw
  have hLw : L w ≠ 0 := by simpa using L.injective.ne hw0
  have hpoint :
      (extChartAt (modelWithCornersSelf ℂ ℂ) (OnePoint.infty : OnePoint ℂ)).symm
        ((extChartAt (modelWithCornersSelf ℂ ℂ) (OnePoint.infty : OnePoint ℂ))
          OnePoint.infty + L w) = b4cov_chartInf.symm (L w) := by
    change b4cov_chartInf.symm (b4cov_chartInf OnePoint.infty + L w) = _
    rw [b4cov_chartInf_apply, b4cov_sphInv_infty, b4cov_chart0_coe]
    simp
  have hsrc : b4cov_chartInf.symm (L w) ∈
      (extChartAt (modelWithCornersSelf ℂ ℂ) (OnePoint.infty : OnePoint ℂ)).source := by
    rw [extChartAt_source, b4cov_chartAt_infty]
    exact b4cov_chartInf_symm_mem (L w)
  have hc : L 1 • b4cov_vec OnePoint.infty (b4cov_chartInf.symm (L w)) 1 =
      b4cov_vec OnePoint.infty (b4cov_chartInf.symm (L w)) (L 1) := by
    rw [← b4cov_vec_smul OnePoint.infty _ hsrc]
    congr 1
    simp [smul_eq_mul]
  simp only [HurwitzPrymRR_loc, b4cov_coef]
  rw [hpoint]
  rw [← hc]
  rw [b4c_dz_sphere_smul]
  change L 1 * b4c_dz_sphere (b4cov_secInf (L w)) = _
  rw [b4c_dz_sphere_secInf hLw]

theorem b4c_dz_sphere_loc_coe_eventuallyEq (z : ℂ) :
    HurwitzPrymRR_loc (by simp) b4c_dz_sphere (z : OnePoint ℂ) =ᶠ[nhds 0]
      (fun _ ↦ b4cov_lineEquiv (by simp : Module.finrank ℂ ℂ = 1) 1) := by
  let e := extChartAt (modelWithCornersSelf ℂ ℂ) (z : OnePoint ℂ)
  let L := b4cov_lineEquiv (by simp : Module.finrank ℂ ℂ = 1)
  have hxs : (z : OnePoint ℂ) ∈ e.source := mem_extChartAt_source _
  have hxt : e (z : OnePoint ℂ) ∈ e.target := e.map_source hxs
  have hcont : Continuous (fun t : ℂ ↦ e (z : OnePoint ℂ) + L t) :=
    continuous_const.add L.continuous
  have hev : ∀ᶠ t in nhds (0 : ℂ), e (z : OnePoint ℂ) + L t ∈ e.target :=
    hcont.continuousAt.preimage_mem_nhds
      (by simpa [e] using (isOpen_extChartAt_target (z : OnePoint ℂ)).mem_nhds hxt)
  filter_upwards [hev] with t ht
  let y := e.symm (e (z : OnePoint ℂ) + L t)
  have hys : y ∈ e.source := e.map_target ht
  have hycoe : ∃ u : ℂ, y = (u : OnePoint ℂ) := by
    rw [extChartAt_source, b4cov_chartAt_coe, b4cov_chart0_source] at hys
    obtain ⟨u, hu⟩ := hys
    exact ⟨u, hu.symm⟩
  have htriv :
      (trivializationAt ℂ (TangentSpace (modelWithCornersSelf ℂ ℂ))
        (z : OnePoint ℂ) ⟨y, L 1⟩).2 = L 1 := by
    obtain ⟨u, hu⟩ := hycoe
    rw [hu]
    rw [TangentBundle.trivializationAt_apply]
    simp only [b4cov_chartAt_coe, modelWithCornersSelf_coe, Set.range_id,
      fderivWithin_univ]
    have hid :
        ⇑(b4cov_chart0.extend (modelWithCornersSelf ℂ ℂ)) ∘
          ⇑(b4cov_chart0.extend (modelWithCornersSelf ℂ ℂ)).symm = id := by
      funext w
      simp [OpenPartialHomeomorph.extend_coe, OpenPartialHomeomorph.extend_coe_symm,
        b4cov_chart0_symm, b4cov_chart0_coe]
    rw [hid, fderiv_id]
    rfl
  have hvec : b4cov_vec (z : OnePoint ℂ) y (L 1) = L 1 := by
    have h := b4cov_vec_triv (z : OnePoint ℂ) y hys (L 1)
    rw [htriv] at h
    exact h
  dsimp only [HurwitzPrymRR_loc, b4cov_coef]
  rw [hvec]
  obtain ⟨u, hu⟩ := hycoe
  change b4c_dz_sphere ⟨y, L 1⟩ = L 1
  rw [hu]
  simp [b4c_dz_sphere]

theorem b4c_dz_sphere_ordForm_coe (z : ℂ) :
    b4c_ordForm (hE := by simp) b4c_dz_sphere (z : OnePoint ℂ) = 0 := by
  unfold b4c_ordForm
  rw [meromorphicOrderAt_congr
    ((b4c_dz_sphere_loc_coe_eventuallyEq z).filter_mono nhdsWithin_le_nhds)]
  rw [meromorphicOrderAt_const]
  simp [b4cov_lineEquiv_one_ne_zero]

theorem b4c_dz_sphere_ordForm_infty :
    b4c_ordForm (hE := by simp) b4c_dz_sphere (OnePoint.infty : OnePoint ℂ) = -2 := by
  let L := b4cov_lineEquiv (by simp : Module.finrank ℂ ℂ = 1)
  let c := L 1
  have hc : c ≠ 0 := by
    dsimp [c]
    simpa using L.injective.ne one_ne_zero
  have hev : (fun w : ℂ ↦ L 1 * (-1 / (L w) ^ 2)) =ᶠ[nhdsWithin 0 {0}ᶜ]
      (fun w ↦ (-c⁻¹) * w ^ (-2 : ℤ)) := by
    filter_upwards [self_mem_nhdsWithin] with w hw
    have hw0 : w ≠ 0 := hw
    have hL : L w = w * c := by
      dsimp [c]
      calc
        L w = L (w • (1 : ℂ)) := by simp
        _ = w • L 1 := map_smul L w 1
        _ = w * L 1 := by rfl
    rw [hL]
    dsimp [c]
    field_simp
  unfold b4c_ordForm
  rw [meromorphicOrderAt_congr b4c_dz_sphere_loc_infty_eventuallyEq]
  rw [meromorphicOrderAt_congr hev]
  change (meromorphicOrderAt ((-c⁻¹) • (fun w : ℂ ↦ w ^ (-2 : ℤ))) 0).untop₀ = -2
  rw [meromorphicOrderAt_const_smul_eq_meromorphicOrderAt]
  · rw [show (fun w : ℂ ↦ w ^ (-2 : ℤ)) = (fun w : ℂ ↦ w - 0) ^ (-2 : ℤ) by
      funext w
      simp]
    rw [meromorphicOrderAt_zpow_id_sub_const]
    rfl
  · simp [hc]

theorem b4c_sphere_dz_aux : b4c_divForm (hE := by simp) b4c_dz_sphere =
    -2 • Finsupp.single OnePoint.infty 1 ∧
      b4c_deg (b4c_divForm (hE := by simp) b4c_dz_sphere) = -2 := by
  have hsupp : (Function.support
      (b4c_ordForm (hE := by simp) b4c_dz_sphere)).Finite := by
    refine Set.Finite.subset (Set.finite_singleton (OnePoint.infty : OnePoint ℂ)) ?_
    intro x hx
    induction x using OnePoint.rec with
    | infty => simp
    | coe z =>
        exfalso
        exact hx (b4c_dz_sphere_ordForm_coe z)
  have hd : b4c_divForm (hE := by simp) b4c_dz_sphere =
      -2 • Finsupp.single OnePoint.infty 1 := by
    unfold b4c_divForm
    rw [dif_pos hsupp]
    ext x
    induction x using OnePoint.rec with
    | infty => simp [b4c_dz_sphere_ordForm_infty]
    | coe z => simp [b4c_dz_sphere_ordForm_coe]
  refine ⟨hd, ?_⟩
  rw [hd]
  unfold b4c_deg
  rw [Finsupp.sum_smul_index (by simp)]
  simp
theorem b4c_elliptic_dz_aux :
    b4c_divForm (hE := b3_ellipticModel_finrank) b4c_dz_elliptic = 0 := by
  unfold b4c_divForm
  split_ifs with h
  · ext x
    simp [b4c_dz_elliptic_ordForm_eq_zero]
  · rfl
theorem b4c_dz_sphere_mem_aux : b4c_IsMeroForm (E := ℂ) (C := OnePoint ℂ) (by simp) b4c_dz_sphere := by
  refine ⟨?_, ?_⟩
  · intro x a v w
    induction x using OnePoint.rec with
    | infty => simp [b4c_dz_sphere]
    | coe z =>
        simp only [b4c_dz_sphere, OnePoint.coe_ne_infty, ↓reduceIte]
        rfl
  · intro x
    induction x using OnePoint.rec with
    | infty =>
        let L := b4cov_lineEquiv (by simp : Module.finrank ℂ ℂ = 1)
        have hm : MeromorphicAt (fun w : ℂ ↦ L 1 * (-1 / (L w) ^ 2)) 0 := by
          have hL : MeromorphicAt (fun w : ℂ ↦ L w) 0 :=
            (L.toContinuousLinearMap.analyticAt 0).meromorphicAt
          exact (MeromorphicAt.const (L 1) 0).mul
            ((MeromorphicAt.const (-1) 0).div (hL.pow 2))
        exact hm.congr b4c_dz_sphere_loc_infty_eventuallyEq.symm
    | coe z =>
        exact (MeromorphicAt.const
          (b4cov_lineEquiv (by simp : Module.finrank ℂ ℂ = 1) 1) 0).congr
            ((b4c_dz_sphere_loc_coe_eventuallyEq z).filter_mono nhdsWithin_le_nhds).symm

theorem b4c_dz_elliptic_mem_aux : b4c_IsMeroForm b3_ellipticModel_finrank b4c_dz_elliptic := by
  refine ⟨?_, ?_⟩
  · intro x a v w
    change b3A_invForm b2_stdF (b4cov_lineEquiv b3_ellipticModel_finrank).symm
      ⟨x, a • v + w⟩ = _
    exact (b3A_invForm_mem b2_stdF
      (b4cov_lineEquiv b3_ellipticModel_finrank).symm).2 x a v w
  · intro x
    exact (MeromorphicAt.const 1 0).congr
      ((b4c_dz_elliptic_loc_eventuallyEq_one x).filter_mono nhdsWithin_le_nhds).symm

theorem b4c_dbar_mem_aux (u : b4c_SmoothFun E C) :
    b4c_dbar E C u ∈ b4c_Smooth01 E C := by
  refine ⟨RiemannRochAna_dbar_smooth u, ?_⟩
  intro x a v w
  exact RiemannRochAna_antilinear (E := E)
    (mfderiv 𝓘(ℝ, E) 𝓘(ℝ, ℂ) (u : C → ℂ) x) a v w

theorem b4c_dbar_image_eq_aux (hE : Module.finrank ℂ E = 1) :
    (Submodule.span ℂ (b4c_dbar E C '' (b4c_SmoothFun E C : Set (C → ℂ))) :
      Set (TangentBundle 𝓘(ℂ, E) C → ℂ)) =
      b4c_dbar E C '' (b4c_SmoothFun E C : Set (C → ℂ)) := by
  have hr : b4c_dbar E C '' (b4c_SmoothFun E C : Set (C → ℂ)) =
      (LinearMap.range (RiemannRochAna_dbarLinear (E := E) (C := C)) : Set _) := by
    ext w
    constructor
    · rintro ⟨u, hu, rfl⟩
      exact ⟨⟨u, hu⟩, rfl⟩
    · rintro ⟨u, rfl⟩
      exact ⟨u, u.property, rfl⟩
  rw [hr, Submodule.span_eq]

theorem b4c_dbar_holomorphic_aux (u : C → ℂ) (hu : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω u) :
    b4c_dbar E C u = 0 := by
  funext p
  let du : E →L[ℝ] ℂ := mfderiv 𝓘(ℝ, E) 𝓘(ℝ, ℂ) u p.1
  change (du p.2 + Complex.I * du (Complex.I • (show E from p.2))) / 2 = 0
  have h : du (Complex.I • (show E from p.2)) = Complex.I * du p.2 :=
    RiemannRochAna_real_derivative_smul u hu p.1 Complex.I p.2
  rw [h]
  simp only [← mul_assoc, Complex.I_mul_I, neg_one_mul, add_neg_cancel, zero_div]

section RiemannRochAnaDolbeault

open ContinuousAlternatingMap

attribute [local instance] b3Forms_isManifold_real
set_option backward.isDefEq.respectTransparency false

/-- RiemannRochAna: the exterior differential of a smooth real function evaluates as its manifold derivative. -/
theorem RiemannRochAna_d_fun_apply (g : C → ℝ)
    (hg : ContMDiff 𝓘(ℝ, E) 𝓘(ℝ, ℝ) ∞ g) (x : C) (v : E) :
    b3Forms_d (b3Forms_fun (E := E) g) x (fun _ ↦ v) =
      mfderiv 𝓘(ℝ, E) 𝓘(ℝ, ℝ) g x v := by
  rw [b3Forms_d_fun, mfderiv_eq_fderiv_comp_chartAt_symm
    (hg.mdifferentiable (by simp) x)]
  rfl
/-- RiemannRochAna: the real part of the Dolbeault differential is half an exact plus a coexact form. -/
theorem RiemannRochAna_dbar_re (u : b4c_SmoothFun E C) (x : C) (v : E) :
    (b4c_dbar E C u ⟨x, v⟩).re =
      (1 / 2 : ℝ) * (b3Forms_d (b3Forms_fun (E := E) (fun x ↦ ((u : C → ℂ) x).re)) x (fun _ ↦ v) +
        b3Forms_star (b3Forms_d (b3Forms_fun (E := E) (fun x ↦ ((u : C → ℂ) x).im))) x (fun _ ↦ v)) := by
  have hr : ContMDiff 𝓘(ℝ, E) 𝓘(ℝ, ℝ) ∞ (fun x ↦ ((u : C → ℂ) x).re) := Complex.reCLM.contMDiff.comp u.property
  have hi : ContMDiff 𝓘(ℝ, E) 𝓘(ℝ, ℝ) ∞ (fun x ↦ ((u : C → ℂ) x).im) := Complex.imCLM.contMDiff.comp u.property
  rw [RiemannRochAna_d_fun_apply _ hr, b3Forms_star, b3Forms_starPt_apply,
    RiemannRochAna_d_fun_apply _ hi]
  have hdu := u.property.mdifferentiable (by simp)
  have hre := mfderiv_comp x Complex.reCLM.mdifferentiableAt (hdu x)
  have him := mfderiv_comp x Complex.imCLM.mdifferentiableAt (hdu x)
  rw [ContinuousLinearMap.mfderiv_eq] at hre him
  change mfderiv 𝓘(ℝ, E) 𝓘(ℝ, ℝ) (fun x ↦ ((u : C → ℂ) x).re) x = _ at hre
  change mfderiv 𝓘(ℝ, E) 𝓘(ℝ, ℝ) (fun x ↦ ((u : C → ℂ) x).im) x = _ at him
  rw [hre, him]
  let du : E →L[ℝ] ℂ := mfderiv 𝓘(ℝ, E) 𝓘(ℝ, ℂ) (u : C → ℂ) x
  change ((du v + Complex.I * du (Complex.I • v)) / 2).re =
    (1 / 2 : ℝ) * ((du v).re + -(du (Complex.I • v)).im)
  simp [Complex.mul_re]
  ring
section
variable [FiniteDimensional ℂ E] [T2Space C] [CompactSpace C]
  [MeasurableSpace E] [BorelSpace E] [hE1 : Fact (Module.finrank ℂ E = 1)]
/-- RiemannRochAna: a conjugate holomorphic form in the Dolbeault image vanishes. -/
theorem RiemannRochAna_conj_hol_dbar_eq_zero (θ : b3_HolForm E C)
    (u : b4c_SmoothFun E C) (hu : b4c_dbar E C u = fun p ↦ star (θ.1 p)) : θ = 0 := by
  have hr : b3Forms_IsSmooth (b3Forms_fun (E := E) (fun x ↦ ((u : C → ℂ) x).re)) := b3Forms_isSmooth_fun (Complex.reCLM.contMDiff.comp u.property)
  have hi : b3Forms_IsSmooth (b3Forms_fun (E := E) (fun x ↦ ((u : C → ℂ) x).im)) := b3Forms_isSmooth_fun (Complex.imCLM.contMDiff.comp u.property)
  let a : b3Rest_SF E C := b3Rest_SF.mk (b3Forms_reForm θ) (b3Forms_isSmooth_reForm θ)
  have ha : a = (1 / 2 : ℝ) • (b3Rest_dSF hr + b3Rest_sdSF hi) := by
    apply b3Rest_SF.ext
    ext x v
    have hv : v = fun _ ↦ v 0 := funext fun i ↦ by fin_cases i; rfl
    rw [hv]
    change b3Forms_reForm θ x (fun _ ↦ v 0) = _
    rw [b3Forms_reForm_apply]
    have h := RiemannRochAna_dbar_re u x (v 0)
    rw [hu] at h
    simpa only [Complex.star_def, Complex.conj_re, b3Rest_SF.form_smul,
      b3Rest_SF.form_add, b3Rest_dSF, b3Rest_sdSF, b3Rest_SF.form_mk,
      Pi.smul_apply, Pi.add_apply, ContinuousAlternatingMap.smul_apply,
      ContinuousAlternatingMap.add_apply, smul_eq_mul, Complex.reCLM_apply,
      Complex.imCLM_apply, Function.comp_apply] using h
  have hd : ((b3Rest_dSF hr : b3Rest_SF E C) : b3Rest_L2 E C) ∈ b3Rest_Ex E C :=
    Submodule.le_topologicalClosure _ (Submodule.subset_span ⟨⟨_, hr⟩, rfl⟩)
  have hs : ((b3Rest_sdSF hi : b3Rest_SF E C) : b3Rest_L2 E C) ∈ b3Rest_Co E C :=
    Submodule.le_topologicalClosure _ (Submodule.subset_span ⟨⟨_, hi⟩, rfl⟩)
  have hamem : RiemannRochAna_holRealL2 θ ∈ b3Rest_Ex E C ⊔ b3Rest_Co E C := by
    change (a : b3Rest_L2 E C) ∈ _
    rw [ha, UniformSpace.Completion.coe_smul, UniformSpace.Completion.coe_add]
    exact Submodule.smul_mem _ _ (Submodule.add_mem _
      (Submodule.mem_sup_left hd) (Submodule.mem_sup_right hs))
  apply RiemannRochAna_hilbert_quotient_injective
  rw [_root_.map_zero]
  exact (Submodule.Quotient.mk_eq_zero _).mpr hamem
end
/-- RiemannRochAna: conjugation sends holomorphic forms to smooth forms of type `(0,1)`. -/
theorem RiemannRochAna_conj_hol_mem (θ : b3_HolForm E C) :
    (fun p ↦ star (θ.1 p)) ∈ b4c_Smooth01 E C := by
  let : ChartedSpace (E × E) (TangentBundle 𝓘(ℂ, E) C) :=
    inferInstanceAs (ChartedSpace (ModelProd E E) (TangentBundle 𝓘(ℂ, E) C))
  constructor
  · have hθ : ContMDiff 𝓘(ℝ, E).tangent 𝓘(ℝ, ℂ) ∞ θ.1 := by
      intro p
      have h := θ.2.1 p
      simp only [ModelWithCorners.tangent, ← modelWithCornersSelf_prod] at h ⊢
      exact (b3A_contMDiffWithinAt_real h).of_le (by simp)
    exact Complex.conjCLE.contDiff.contMDiff.comp hθ
  · intro x a v w
    simpa only [star_add, star_mul, mul_comm] using congrArg star (θ.2.2 x a v w)
/-- RiemannRochAna: conjugating holomorphic forms gives a real linear map to smooth `(0,1)` forms. -/
def RiemannRochAna_conjHol : b3_HolForm E C →ₗ[ℝ] b4c_Smooth01 E C where
  toFun θ := ⟨fun p ↦ star (θ.1 p), RiemannRochAna_conj_hol_mem θ⟩
  map_add' θ η := by
    apply Subtype.ext
    funext p
    exact star_add _ _
  map_smul' r θ := by
    apply Subtype.ext
    funext p
    change star (r • θ.1 p) = r • star (θ.1 p)
    exact star_smul r (θ.1 p)
/-- RiemannRochAna: the real linear map from conjugate holomorphic forms to Dolbeault classes. -/
def RiemannRochAna_holDolbeault : b3_HolForm E C →ₗ[ℝ] b4c_Dolbeault01 E C :=
  (((Submodule.span ℂ (b4c_dbar E C '' (b4c_SmoothFun E C : Set (C → ℂ)))).comap
    (b4c_Smooth01 E C).subtype).mkQ.restrictScalars ℝ).comp RiemannRochAna_conjHol

/-- RiemannRochAna: distinct holomorphic forms give distinct Dolbeault classes after conjugation. -/
theorem RiemannRochAna_holDolbeault_injective [T2Space C] [CompactSpace C]
    (hE : Module.finrank ℂ E = 1) :
    Function.Injective (RiemannRochAna_holDolbeault (E := E) (C := C)) := by
  letI : FiniteDimensional ℂ E := Module.finite_of_finrank_pos (by omega)
  letI : MeasurableSpace E := borel E
  letI : BorelSpace E := ⟨rfl⟩
  letI : Fact (Module.finrank ℂ E = 1) := ⟨hE⟩
  apply LinearMap.ker_eq_bot.mp
  apply LinearMap.ker_eq_bot'.mpr
  intro θ hθ
  have hm := (Submodule.Quotient.mk_eq_zero _).mp hθ
  change (fun p ↦ star (θ.1 p)) ∈ Submodule.span ℂ
    (b4c_dbar E C '' (b4c_SmoothFun E C : Set (C → ℂ))) at hm
  rw [← SetLike.mem_coe, b4c_dbar_image_eq_aux hE] at hm
  obtain ⟨u, hu, he⟩ := hm
  exact RiemannRochAna_conj_hol_dbar_eq_zero θ ⟨u, hu⟩ he
section
variable [FiniteDimensional ℂ E]
/-- RiemannRochAna: evaluation at zero in a fibre of a `(0,1)` form vanishes. -/
theorem RiemannRochAna_zero_fibre (β : b4c_Smooth01 E C) (x : C) : β.1 ⟨x, 0⟩ = 0 := by
  have h := β.2.2 x 1 0 0
  simp only [one_smul, add_zero, star_one, one_mul] at h
  linear_combination -h
/-- RiemannRochAna: the real part of a `(0,1)` form is a real continuous linear functional on each fibre. -/
def RiemannRochAna_re01CLM (β : b4c_Smooth01 E C) (x : C) : E →L[ℝ] ℝ :=
  LinearMap.toContinuousLinearMap
    { toFun := fun v ↦ (β.1 ⟨x, v⟩).re
      map_add' := fun v w ↦ by
        have h := β.2.2 x 1 v w
        simp only [one_smul, star_one, one_mul] at h
        exact congrArg Complex.re h |>.trans (Complex.add_re _ _)
      map_smul' := fun r v ↦ by
        have h := β.2.2 x (r : ℂ) v 0
        simp only [add_zero, RiemannRochAna_zero_fibre, Complex.star_def,
          Complex.conj_ofReal] at h
        have h' := congrArg Complex.re h
        simpa using h' }
/-- RiemannRochAna: the real differential form underlying a smooth `(0,1)` form. -/
def RiemannRochAna_re01 (β : b4c_Smooth01 E C) : C → E [⋀^Fin 1]→L[ℝ] ℝ :=
  fun x ↦ ofSubsingleton ℝ E ℝ (0 : Fin 1) (RiemannRochAna_re01CLM β x)
/-- RiemannRochAna: the real part in local coordinates evaluates the tangent-bundle function. -/
theorem RiemannRochAna_loc_re01 (β : b4c_Smooth01 E C) {x : C} {u : E}
    (hu : u ∈ (chartAt E x).target) (v : E) :
    b3Forms_loc (RiemannRochAna_re01 β) x u (fun _ ↦ v) =
      (β.1 (b3Forms_chartVec x v u)).re := by
  simp only [b3Forms_loc, compContinuousLinearMap_apply]
  rw [b3Forms_fderiv_tr_real (b3Forms_mem_trDom_self hu)]
  rfl
/-- RiemannRochAna: taking the real part of a `(0,1)` form preserves smoothness. -/
theorem RiemannRochAna_re01_smooth (β : b4c_Smooth01 E C) :
    b3Forms_IsSmooth (RiemannRochAna_re01 β) := by
  let : ChartedSpace (E × E) (TangentBundle 𝓘(ℂ, E) C) :=
    inferInstanceAs (ChartedSpace (ModelProd E E) (TangentBundle 𝓘(ℂ, E) C))
  intro x
  refine b3Forms_contDiffOn_of_apply fun v ↦ ?_
  have hc : ContMDiffOn 𝓘(ℝ, E) 𝓘(ℝ, E).tangent ∞
      (b3Forms_chartVec x v) (chartAt E x).target := by
    intro u hu
    have h := b3Forms_contMDiffOn_chartVec x v u hu
    simp only [ModelWithCorners.tangent, ← modelWithCornersSelf_prod] at h ⊢
    exact (b3A_contMDiffWithinAt_real h).of_le (by simp)
  have h := β.2.1.comp_contMDiffOn hc
  have hr := Complex.reCLM.contDiff.comp_contDiffOn h.contDiffOn
  exact hr.congr fun u hu ↦ RiemannRochAna_loc_re01 β hu v
end

section
variable [FiniteDimensional ℂ E] [T2Space C] [CompactSpace C]
  [MeasurableSpace E] [BorelSpace E] [hE1 : Fact (Module.finrank ℂ E = 1)]
/-- RiemannRochAna: taking real parts as a linear map into the Hilbert space. -/
def RiemannRochAna_re01L2 : b4c_Smooth01 E C →ₗ[ℝ] b3Rest_L2 E C where
  toFun β := (b3Rest_SF.mk (RiemannRochAna_re01 β) (RiemannRochAna_re01_smooth β) : b3Rest_L2 E C)
  map_add' β γ := by
    rw [← UniformSpace.Completion.coe_add]
    apply congrArg (fun a : b3Rest_SF E C ↦ (a : b3Rest_L2 E C))
    apply b3Rest_SF.ext
    ext x v
    exact Complex.add_re _ _
  map_smul' r β := by
    rw [← UniformSpace.Completion.coe_smul]
    apply congrArg (fun a : b3Rest_SF E C ↦ (a : b3Rest_L2 E C))
    apply b3Rest_SF.ext
    ext x v
    change (r • β.1 ⟨x, v 0⟩).re = r * (β.1 ⟨x, v 0⟩).re
    simp
/-- RiemannRochAna: the real part of a Dolbeault boundary is a sum of exact and coexact forms. -/
theorem RiemannRochAna_re01_dbar_mem (u : b4c_SmoothFun E C) :
    RiemannRochAna_re01L2 ⟨b4c_dbar E C u, b4c_dbar_mem_aux u⟩ ∈
      b3Rest_Ex E C ⊔ b3Rest_Co E C := by
  have hr : b3Forms_IsSmooth (b3Forms_fun (E := E) (fun x ↦ ((u : C → ℂ) x).re)) :=
    b3Forms_isSmooth_fun (Complex.reCLM.contMDiff.comp u.property)
  have hi : b3Forms_IsSmooth (b3Forms_fun (E := E) (fun x ↦ ((u : C → ℂ) x).im)) :=
    b3Forms_isSmooth_fun (Complex.imCLM.contMDiff.comp u.property)
  let a : b3Rest_SF E C := b3Rest_SF.mk
    (RiemannRochAna_re01 ⟨b4c_dbar E C u, b4c_dbar_mem_aux u⟩)
    (RiemannRochAna_re01_smooth _)
  have ha : a = (1 / 2 : ℝ) • (b3Rest_dSF hr + b3Rest_sdSF hi) := by
    apply b3Rest_SF.ext
    ext x v
    have hv : v = fun _ ↦ v 0 := funext fun i ↦ by fin_cases i; rfl
    rw [hv]
    exact RiemannRochAna_dbar_re u x (v 0)
  change (a : b3Rest_L2 E C) ∈ _
  rw [ha, UniformSpace.Completion.coe_smul, UniformSpace.Completion.coe_add]
  apply Submodule.smul_mem
  apply Submodule.add_mem
  · apply Submodule.mem_sup_left
    exact Submodule.le_topologicalClosure _ (Submodule.subset_span ⟨⟨_, hr⟩, rfl⟩)
  · apply Submodule.mem_sup_right
    exact Submodule.le_topologicalClosure _ (Submodule.subset_span ⟨⟨_, hi⟩, rfl⟩)
/-- RiemannRochAna: the Hilbert class of the real part annihilates Dolbeault boundaries. -/
theorem RiemannRochAna_dolbeault_le_ker :
    ((Submodule.span ℂ (b4c_dbar E C '' (b4c_SmoothFun E C : Set (C → ℂ)))).comap
      (b4c_Smooth01 E C).subtype).restrictScalars ℝ ≤
      LinearMap.ker (((b3Rest_Ex E C ⊔ b3Rest_Co E C).mkQ).comp
        (RiemannRochAna_re01L2 (E := E) (C := C))) := by
  intro β hβ
  change β.1 ∈ Submodule.span ℂ
    (b4c_dbar E C '' (b4c_SmoothFun E C : Set (C → ℂ))) at hβ
  rw [← SetLike.mem_coe, b4c_dbar_image_eq_aux hE1.out] at hβ
  obtain ⟨u, hu, he⟩ := hβ
  have hb : β = ⟨b4c_dbar E C u, b4c_dbar_mem_aux ⟨u, hu⟩⟩ := Subtype.ext he.symm
  rw [hb]
  exact (Submodule.Quotient.mk_eq_zero _).mpr (RiemannRochAna_re01_dbar_mem ⟨u, hu⟩)
/-- RiemannRochAna: the comparison from smooth Dolbeault classes to the Hilbert quotient. -/
def RiemannRochAna_dolbeaultToHilbert : b4c_Dolbeault01 E C →ₗ[ℝ]
    b3Rest_L2 E C ⧸ (b3Rest_Ex E C ⊔ b3Rest_Co E C) :=
  let P := (Submodule.span ℂ
    (b4c_dbar E C '' (b4c_SmoothFun E C : Set (C → ℂ)))).comap (b4c_Smooth01 E C).subtype
  ((P.restrictScalars ℝ).liftQ
    (((b3Rest_Ex E C ⊔ b3Rest_Co E C).mkQ).comp RiemannRochAna_re01L2)
    RiemannRochAna_dolbeault_le_ker).comp
      (Submodule.Quotient.restrictScalarsEquiv ℝ P).symm.toLinearMap
/-- RiemannRochAna: the Hilbert comparison takes conjugate holomorphic forms to their real parts. -/
theorem RiemannRochAna_dolbeaultToHilbert_hol (θ : b3_HolForm E C) :
    RiemannRochAna_dolbeaultToHilbert (RiemannRochAna_holDolbeault θ) =
      (b3Rest_Ex E C ⊔ b3Rest_Co E C).mkQ (RiemannRochAna_holRealL2 θ) := by
  change (b3Rest_Ex E C ⊔ b3Rest_Co E C).mkQ
    (RiemannRochAna_re01L2 (RiemannRochAna_conjHol θ)) = _
  congr 1
/-- RiemannRochAna: every Hilbert quotient class comes from a smooth Dolbeault class. -/
theorem RiemannRochAna_dolbeaultToHilbert_surjective :
    Function.Surjective (RiemannRochAna_dolbeaultToHilbert (E := E) (C := C)) := by
  intro q
  obtain ⟨θ, hθ⟩ := RiemannRochAna_hilbert_quotient_surjective q
  exact ⟨RiemannRochAna_holDolbeault θ, (RiemannRochAna_dolbeaultToHilbert_hol θ).trans hθ⟩

end

/-- RiemannRochAna: a smooth function annihilated by the Dolbeault operator is complex differentiable. -/
theorem RiemannRochAna_mdifferentiable_of_dbar_eq_zero (u : b4c_SmoothFun E C)
    (hu : b4c_dbar E C u = 0) : MDifferentiable 𝓘(ℂ, E) 𝓘(ℂ, ℂ) (u : C → ℂ) := by
  intro x
  let g : E → ℂ := (u : C → ℂ) ∘ (chartAt E x).symm
  have hd : DifferentiableAt ℝ g (chartAt E x x) :=
    differentiableAt_comp_chartAt_symm (by simp) (u.property x)
  have hm := mfderiv_eq_fderiv_comp_chartAt_symm
    (u.property.mdifferentiable (by simp) x)
  have ha : antiLinearPart (fderiv ℝ g (chartAt E x x)) = 0 := by
    ext v
    have h := congrFun hu ⟨x, v⟩
    let du : E →L[ℝ] ℂ := mfderiv 𝓘(ℝ, E) 𝓘(ℝ, ℂ) (u : C → ℂ) x
    change (du v + Complex.I * du (Complex.I • v)) / 2 = 0 at h
    dsimp only [du] at h
    rw [hm] at h
    simpa only [antiLinearPart_apply, _root_.zero_apply, Complex.real_smul,
      Complex.ofReal_div, Complex.ofReal_inv, Complex.ofReal_one, Complex.ofReal_ofNat, div_eq_mul_inv, mul_comm, g] using h
  obtain ⟨L, hL⟩ := exists_restrictScalars_eq_of_antiLinearPart_eq_zero _ ha
  have hc := (hasFDerivAt_of_restrictScalars ℝ hd.hasFDerivAt hL).differentiableAt
  rw [mdifferentiableAt_iff]
  refine ⟨u.property.continuous.continuousAt, ?_⟩
  simpa only [mfld_simps] using hc.differentiableWithinAt (s := Set.univ)

/-- RiemannRochAna: a smooth function annihilated by the Dolbeault operator is holomorphic. -/
theorem RiemannRochAna_holomorphic_of_dbar_eq_zero (hE : Module.finrank ℂ E = 1)
    (u : b4c_SmoothFun E C) (hu : b4c_dbar E C u = 0) :
    ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω (u : C → ℂ) := by
  have hd := RiemannRochAna_mdifferentiable_of_dbar_eq_zero u hu
  intro x
  let e := chartAt E x
  let φ := b4cov_lineEquiv hE
  have hg : DifferentiableOn ℂ ((u : C → ℂ) ∘ e.symm) e.target :=
    (hd.comp_mdifferentiableOn ((contMDiffOn_chart_symm (I := 𝓘(ℂ, E)) (n := ω) (x := x)).mdifferentiableOn (by simp))).differentiableOn
  have hg' : DifferentiableOn ℂ (((u : C → ℂ) ∘ e.symm) ∘ φ) (φ ⁻¹' e.target) :=
    hg.comp φ.differentiableOn (fun _ hz ↦ hz)
  have hn : φ ⁻¹' e.target ∈ 𝓝 (φ.symm (e x)) :=
    (e.open_target.preimage φ.continuous).mem_nhds (by simpa only [mem_preimage, ContinuousLinearEquiv.apply_symm_apply] using mem_chart_target E x)
  have ha := (hg'.analyticAt hn).comp (φ.symm.toContinuousLinearMap.analyticAt (e x))
  have he : (((u : C → ℂ) ∘ e.symm) ∘ φ) ∘ φ.symm = (u : C → ℂ) ∘ e.symm := by
    funext z
    simp
  rw [he] at ha
  rw [contMDiffAt_iff]
  refine ⟨u.property.continuous.continuousAt, ?_⟩
  simpa only [mfld_simps] using ha.contDiffAt.contDiffWithinAt (s := Set.univ)

/-- RiemannRochAna: the smooth kernel of the Dolbeault operator consists of constant functions on a compact connected surface. -/
theorem RiemannRochAna_dbar_eq_zero_iff_const [CompactSpace C] [ConnectedSpace C]
    (u : b4c_SmoothFun E C) :
    b4c_dbar E C u = 0 ↔ ∃ a : ℂ, (u : C → ℂ) = Function.const C a := by
  constructor
  · intro hu
    exact (RiemannRochAna_mdifferentiable_of_dbar_eq_zero u hu).exists_eq_const_of_compactSpace
  · rintro ⟨a, ha⟩
    rw [ha]
    exact b4c_dbar_holomorphic_aux _ contMDiff_const

section
variable [FiniteDimensional ℂ E]
/-- RiemannRochAna: the real part of a conjugate-linear form determines its imaginary part. -/
theorem RiemannRochAna_re01_I (β : b4c_Smooth01 E C) (x : C) (v : E) :
    RiemannRochAna_re01 β x (fun _ ↦ Complex.I • v) = (β.1 ⟨x, v⟩).im := by
  have h := β.2.2 x Complex.I v 0
  simp only [add_zero, RiemannRochAna_zero_fibre, Complex.star_def, Complex.conj_I] at h
  have hh := congrArg Complex.re h
  change (β.1 ⟨x, Complex.I • v⟩).re = _
  simpa using hh
/-- RiemannRochAna: the real-part map on smooth `(0,1)` forms is injective. -/
theorem RiemannRochAna_re01_injective :
    Function.Injective (RiemannRochAna_re01 (E := E) (C := C)) := by
  intro β γ h
  apply Subtype.ext
  funext p
  apply Complex.ext
  · exact congrArg (fun a : C → E [⋀^Fin 1]→L[ℝ] ℝ ↦ a p.1 (fun _ ↦ p.2)) h
  · rw [← RiemannRochAna_re01_I β p.1 p.2, ← RiemannRochAna_re01_I γ p.1 p.2, h]
/-- RiemannRochAna: a smooth real zero-form is a smooth real-valued function. -/
theorem RiemannRochAna_contMDiff_of_smooth_fun {g : C → ℝ}
    (hg : b3Forms_IsSmooth (b3Forms_fun (E := E) g)) :
    ContMDiff 𝓘(ℝ, E) 𝓘(ℝ, ℝ) ∞ g := by
  intro x
  rw [contMDiffAt_iff_source_of_mem_source (mem_chart_source E x)]
  have h := ((b3Forms_isSmooth_fun_iff g).mp hg x).contDiffAt
    ((chartAt E x).open_target.mem_nhds (mem_chart_target E x))
  simpa only [mfld_simps] using h.contMDiffAt.contMDiffWithinAt (s := Set.univ)

variable [T2Space C] [CompactSpace C] [ConnectedSpace C]
  [MeasurableSpace E] [BorelSpace E] [hE1 : Fact (Module.finrank ℂ E = 1)]
/-- RiemannRochAna: a smooth real form in the exact Hilbert subspace with vanishing exterior differential has a smooth primitive. -/
theorem RiemannRochAna_primitive_of_exact (a : b3Rest_SF E C)
    (hd : b3Forms_d a.form = 0) (ha : (a : b3Rest_L2 E C) ∈ b3Rest_Ex E C) :
    ∃ g : C → ℝ, ContMDiff 𝓘(ℝ, E) 𝓘(ℝ, ℝ) ∞ g ∧
      b3Forms_d (b3Forms_fun (E := E) g) = a.form := by
  obtain ⟨g, hg, he⟩ := b3Forms_exists_primitive a.isSmooth hd
    (b3Rest_periodsVanish_of_mem_Ex hd ha)
  exact ⟨g, RiemannRochAna_contMDiff_of_smooth_fun hg, he⟩
/-- RiemannRochAna: for a smooth real form with zero exterior differential, membership in the exact-plus-coexact Hilbert subspace implies membership in the exact subspace. -/
theorem RiemannRochAna_exact_of_sum (a : b3Rest_SF E C)
    (hd : b3Forms_d a.form = 0)
    (ha : (a : b3Rest_L2 E C) ∈ b3Rest_Ex E C ⊔ b3Rest_Co E C) :
    (a : b3Rest_L2 E C) ∈ b3Rest_Ex E C := by
  obtain ⟨e, he, c, hc, hec⟩ := Submodule.mem_sup.mp ha
  have hac : inner ℝ (a : b3Rest_L2 E C) c = 0 := b3Rest_closed_inner_Co hd hc
  have hec0 : inner ℝ e c = 0 := b3Rest_Ex_inner_Co he hc
  rw [← hec, inner_add_left, hec0, zero_add, inner_self_eq_zero] at hac
  have hec' : e = (a : b3Rest_L2 E C) := by simpa only [hac, add_zero] using hec
  exact hec' ▸ he
/-- RiemannRochAna: the real part of the Dolbeault differential of a real-valued function is half its real differential. -/
theorem RiemannRochAna_dbar_ofReal_re (g : C → ℝ)
    (hg : ContMDiff 𝓘(ℝ, E) 𝓘(ℝ, ℝ) ∞ g) (x : C) (v : E) :
    (b4c_dbar E C (fun x ↦ (g x : ℂ)) ⟨x, v⟩).re =
      (1 / 2 : ℝ) * b3Forms_d (b3Forms_fun (E := E) g) x (fun _ ↦ v) := by
  let u : b4c_SmoothFun E C := ⟨fun x ↦ (g x : ℂ), Complex.ofRealCLM.contMDiff.comp hg⟩
  have h := RiemannRochAna_dbar_re u x v
  change (b4c_dbar E C (fun x ↦ (g x : ℂ)) ⟨x, v⟩).re =
    (1 / 2 : ℝ) * (b3Forms_d (b3Forms_fun (E := E) g) x (fun _ ↦ v) +
      b3Forms_star (b3Forms_d (b3Forms_fun (E := E) (fun _ : C ↦ (0 : ℝ)))) x (fun _ ↦ v)) at h
  rw [b3Forms_star, b3Forms_starPt_apply,
    RiemannRochAna_d_fun_apply _ contMDiff_const, mfderiv_const] at h
  simpa using h
/-- RiemannRochAna: a smooth Dolbeault form with zero real exterior differential and zero Hilbert class has a smooth potential. -/
theorem RiemannRochAna_potential_of_real_closed (β : b4c_Smooth01 E C)
    (hd : b3Forms_d (RiemannRochAna_re01 β) = 0)
    (hβ : RiemannRochAna_re01L2 β ∈ b3Rest_Ex E C ⊔ b3Rest_Co E C) :
    ∃ u : b4c_SmoothFun E C, b4c_dbar E C u = β.1 := by
  let a : b3Rest_SF E C := b3Rest_SF.mk (RiemannRochAna_re01 β) (RiemannRochAna_re01_smooth β)
  obtain ⟨g, hg, he⟩ := RiemannRochAna_primitive_of_exact a hd
    (RiemannRochAna_exact_of_sum a hd hβ)
  let u : b4c_SmoothFun E C := ⟨fun x ↦ (g x : ℂ), Complex.ofRealCLM.contMDiff.comp hg⟩
  refine ⟨(2 : ℂ) • u, ?_⟩
  have heq : (⟨b4c_dbar E C ((2 : ℂ) • u), b4c_dbar_mem_aux ((2 : ℂ) • u)⟩ : b4c_Smooth01 E C) = β := by
    apply RiemannRochAna_re01_injective
    ext x v
    have hv : v = fun _ ↦ v 0 := funext fun i ↦ by fin_cases i; rfl
    rw [hv]
    change (b4c_dbar E C ((2 : ℂ) • u) ⟨x, v 0⟩).re = _
    rw [RiemannRochAna_dbar_smul]
    change ((2 : ℂ) * b4c_dbar E C (fun x ↦ (g x : ℂ)) ⟨x, v 0⟩).re = _
    rw [Complex.mul_re, show (2 : ℂ).re = 2 from rfl, show (2 : ℂ).im = 0 from rfl, zero_mul, sub_zero,
      RiemannRochAna_dbar_ofReal_re g hg, he]
    change 2 * (1 / 2 * RiemannRochAna_re01 β x (fun _ ↦ v 0)) = _
    ring
  exact congrArg Subtype.val heq
/-- RiemannRochAna: a smooth `(0,1)` form with zero real exterior differential is a conjugate holomorphic form plus a Dolbeault differential. -/
theorem RiemannRochAna_decomposition_of_real_closed (β : b4c_Smooth01 E C)
    (hd : b3Forms_d (RiemannRochAna_re01 β) = 0) :
    ∃ θ : b3_HolForm E C, ∃ u : b4c_SmoothFun E C,
      β.1 = (fun p ↦ star (θ.1 p)) + b4c_dbar E C u := by
  obtain ⟨θ, g, hg, he⟩ := b3Rest_hodge (RiemannRochAna_re01_smooth β) hd
  have hg' := RiemannRochAna_contMDiff_of_smooth_fun hg
  let u : b4c_SmoothFun E C := ⟨fun x ↦ (g x : ℂ), Complex.ofRealCLM.contMDiff.comp hg'⟩
  refine ⟨θ, (2 : ℂ) • u, ?_⟩
  have hh : β = RiemannRochAna_conjHol θ +
      (⟨b4c_dbar E C ((2 : ℂ) • u), b4c_dbar_mem_aux ((2 : ℂ) • u)⟩ : b4c_Smooth01 E C) := by
    apply RiemannRochAna_re01_injective
    ext x v
    have hv : v = fun _ ↦ v 0 := funext fun i ↦ by fin_cases i; rfl
    rw [hv]
    change (β.1 ⟨x, v 0⟩).re = (star (θ.1 ⟨x, v 0⟩) + b4c_dbar E C ((2 : ℂ) • u) ⟨x, v 0⟩).re
    rw [Complex.add_re, RiemannRochAna_dbar_smul]
    change (β.1 ⟨x, v 0⟩).re = (θ.1 ⟨x, v 0⟩).re +
      ((2 : ℂ) * b4c_dbar E C (fun x ↦ (g x : ℂ)) ⟨x, v 0⟩).re
    rw [Complex.mul_re, show (2 : ℂ).re = 2 from rfl,
      show (2 : ℂ).im = 0 from rfl, zero_mul, sub_zero,
      RiemannRochAna_dbar_ofReal_re g hg']
    have hh := congrArg (fun a : C → E [⋀^Fin 1]→L[ℝ] ℝ ↦ a x (fun _ ↦ v 0)) he
    change (β.1 ⟨x, v 0⟩).re = (θ.1 ⟨x, v 0⟩).re +
      b3Forms_d (b3Forms_fun (E := E) g) x (fun _ ↦ v 0) at hh
    rw [hh]
    ring
  exact congrArg Subtype.val hh

end

end RiemannRochAnaDolbeault

section RiemannRochAnaRegularity

open MeasureTheory Metric

/-- RiemannRochAna: integration by parts for the plane conjugate derivative. -/
theorem RiemannRochAna_integral_dbar_parts {u ψ : ℂ → ℂ}
    (hu : ContDiff ℝ ∞ u) (hψ : ContDiff ℝ ∞ ψ) (hc : HasCompactSupport ψ) :
    (∫ z, u z * b3Rest_dbar ψ z) = -∫ z, b3Rest_dbar u z * ψ z := by
  have hu' := hu.continuous_fderiv (by simp)
  have hψ' := hψ.continuous_fderiv (by simp)
  have hi₁ (v : ℂ) : Integrable (fun z ↦ u z * fderiv ℝ ψ z v) :=
    (hu.continuous.mul (hψ'.clm_apply continuous_const)).integrable_of_hasCompactSupport
      ((hc.fderiv_apply (𝕜 := ℝ) v).mul_left)
  have hi₂ (v : ℂ) : Integrable (fun z ↦ fderiv ℝ u z v * ψ z) :=
    ((hu'.clm_apply continuous_const).mul hψ.continuous).integrable_of_hasCompactSupport
      hc.mul_left
  have hp (v : ℂ) := integral_mul_fderiv_eq_neg_fderiv_mul_of_integrable
    (μ := volume) (v := v) (hi₂ v) (hi₁ v)
    ((hu.continuous.mul hψ.continuous).integrable_of_hasCompactSupport hc.mul_left)
    (fun z _ ↦ hu.differentiable (by simp) z)
    (fun z _ ↦ hψ.differentiable (by simp) z)
  have he₁ (z : ℂ) : u z * b3Rest_dbar ψ z =
      u z * fderiv ℝ ψ z 1 + Complex.I * (u z * fderiv ℝ ψ z Complex.I) := by
    unfold b3Rest_dbar
    ring
  have he₂ (z : ℂ) : b3Rest_dbar u z * ψ z =
      fderiv ℝ u z 1 * ψ z + Complex.I * (fderiv ℝ u z Complex.I * ψ z) := by
    unfold b3Rest_dbar
    ring
  simp_rw [he₁, he₂]
  rw [integral_add (hi₁ 1) ((hi₁ Complex.I).const_mul _),
    integral_add (hi₂ 1) ((hi₂ Complex.I).const_mul _),
    integral_const_mul, integral_const_mul, hp 1, hp Complex.I]
  ring

/-- RiemannRochAna: a local integrable coefficient pairs integrably with test derivatives. -/
theorem RiemannRochAna_integrable_mul_dbar {c : ℂ} {R : ℝ} {u ψ : ℂ → ℂ}
    (hu : IntegrableOn u (ball c R)) (hψ : ContDiff ℝ ∞ ψ)
    (hc : HasCompactSupport ψ) (hs : tsupport ψ ⊆ ball c R) :
    Integrable (fun z ↦ u z * b3Rest_dbar ψ z) := by
  have hd : Continuous (b3Rest_dbar ψ) :=
    ((hψ.continuous_fderiv (by simp)).clm_apply continuous_const).add
      (continuous_const.mul ((hψ.continuous_fderiv (by simp)).clm_apply continuous_const))
  apply (integrableOn_iff_integrable_of_support_subset (s := tsupport ψ) ?_).mp
    ((hu.mono_set hs).mul_continuousOn hd.continuousOn hc)
  intro z hz
  by_contra hn
  have he := b3Rest_fderiv_eq_zero_of_notMem hn
  exact hz (by simp [b3Rest_dbar, he])

/-- RiemannRochAna: subtracting a smooth weak solution gives a smooth representative on a smaller disc. -/
theorem RiemannRochAna_weyl_sub_smooth {c : ℂ} {R : ℝ} (hR : 0 < R)
    {u v : ℂ → ℂ} (hu : IntegrableOn u (ball c R)) (hv : ContDiff ℝ ∞ v)
    (hw : ∀ ψ : ℂ → ℂ, ContDiff ℝ ∞ ψ → HasCompactSupport ψ →
      tsupport ψ ⊆ ball c R →
      (∫ z, u z * b3Rest_dbar ψ z) = ∫ z, v z * b3Rest_dbar ψ z) :
    ∃ F : ℂ → ℂ, ContDiffOn ℝ ∞ F (ball c (R / 2)) ∧
      ∀ᵐ z, z ∈ ball c (R / 2) → u z = F z := by
  have hvi : IntegrableOn v (ball c R) :=
    (hv.continuous.continuousOn.integrableOn_compact (isCompact_closedBall c R)).mono_set ball_subset_closedBall
  obtain ⟨G, hG, he⟩ := b3Rest_weyl hR (hu.sub hvi) (fun ψ hψ hc hs ↦ by
    simp only [Pi.sub_apply, sub_mul]
    rw [integral_sub (RiemannRochAna_integrable_mul_dbar hu hψ hc hs)
      (RiemannRochAna_integrable_mul_dbar hvi hψ hc hs), hw ψ hψ hc hs, sub_self])
  refine ⟨fun z ↦ G z + v z, ?_, ?_⟩
  · exact ((hG.contDiffOn isOpen_ball).restrict_scalars ℝ).add hv.contDiffOn
  · filter_upwards [he] with z hz hzr
    have hez := hz hzr
    change u z - v z = G z at hez
    exact sub_eq_iff_eq_add.mp hez

/-- RiemannRochAna: the two plane derivative normalizations differ by a factor of two. -/
theorem RiemannRochAna_dbar_normalization (v : ℂ → ℂ) (z : ℂ) :
    b3Rest_dbar v z = 2 * b4c_dbar ℂ ℂ v ⟨z, (1 : ℂ)⟩ := by
  rw [RiemannRochAna_plane_dbar]
  simp only [star_one, one_mul, wirtingerDbar, antiLinearPart_apply, Complex.real_smul,
    Complex.ofReal_inv, Complex.ofReal_ofNat, smul_eq_mul, mul_one, b3Rest_dbar]
  ring

/-- RiemannRochAna: weak solutions with smooth right-hand side have local smooth representatives. -/
theorem RiemannRochAna_weyl_inhomogeneous {c : ℂ} {R : ℝ} (hR : 0 < R)
    {u g : ℂ → ℂ} (hu : IntegrableOn u (ball c R))
    (hg : ContDiffOn ℝ ∞ g (ball c R))
    (hw : ∀ ψ : ℂ → ℂ, ContDiff ℝ ∞ ψ → HasCompactSupport ψ →
      tsupport ψ ⊆ ball c R →
      (∫ z, u z * b3Rest_dbar ψ z) = -∫ z, (2 * g z) * ψ z) :
    ∃ r : ℝ, 0 < r ∧ ∃ F : ℂ → ℂ, ContDiffOn ℝ ∞ F (ball c r) ∧
      ∀ᵐ z, z ∈ ball c r → u z = F z := by
  obtain ⟨v, hv⟩ := RiemannRochAna_plane_local_solution isOpen_ball hg
    (mem_ball_self hR)
  have hvsm : ContDiff ℝ ∞ (v : ℂ → ℂ) := v.property.contDiff
  have he : ∀ᶠ z in 𝓝 c, z ∈ ball c R ∧ b3Rest_dbar v z = 2 * g z := by
    filter_upwards [hv, isOpen_ball.mem_nhds (mem_ball_self hR)] with z hz hzr
    refine ⟨hzr, ?_⟩
    rw [RiemannRochAna_dbar_normalization, hz 1]
    simp
  obtain ⟨ε, hε, hεs⟩ := Metric.mem_nhds_iff.mp he
  have hs : ball c ε ⊆ ball c R := fun z hz ↦ (hεs hz).1
  obtain ⟨F, hF, hFe⟩ := RiemannRochAna_weyl_sub_smooth hε (hu.mono_set hs) hvsm
    (fun ψ hψ hc hψs ↦ by
      rw [hw ψ hψ hc (hψs.trans hs), RiemannRochAna_integral_dbar_parts hvsm hψ hc]
      congr 1
      apply integral_congr_ae
      exact Filter.Eventually.of_forall fun z ↦ by
        change (2 * g z) * ψ z = b3Rest_dbar v z * ψ z
        by_cases hz : z ∈ ball c ε
        · rw [(hεs hz).2]
        · have hzψ : ψ z = 0 := image_eq_zero_of_notMem_tsupport
            (fun h ↦ hz (hψs h))
          rw [hzψ, mul_zero, mul_zero])
  exact ⟨ε / 2, by positivity, F, hF, hFe⟩

end RiemannRochAnaRegularity

section RiemannRochAnaGlue

open ContinuousAlternatingMap MeasureTheory
attribute [local instance] b3Forms_isManifold_real
variable [FiniteDimensional ℂ E] [T2Space C] [CompactSpace C]
  [MeasurableSpace E] [BorelSpace E] [hE1 : Fact (Module.finrank ℂ E = 1)]

/-- RiemannRochAna: local smooth representatives of a Hilbert form glue to a global smooth representative. -/
theorem RiemannRochAna_smooth_of_local (h : b3Rest_L2 E C)
    (hlocal : ∀ p : C, ∃ β : b3Rest_SF E C, ∃ U : Set C,
      IsOpen U ∧ p ∈ U ∧ ∀ φ : b3Rest_SF E C, tsupport φ.form ⊆ U →
        inner ℝ h (φ : b3Rest_L2 E C) = inner ℝ (β : b3Rest_L2 E C) φ) :
    ∃ α : b3Rest_SF E C, h = (α : b3Rest_L2 E C) := by
  choose β U hUo hpU hpair using hlocal
  have hcons : ∀ p q, ∀ x ∈ U p ∩ U q, (β p).form x = (β q).form x := by
    intro p q
    refine b3Rest_eq_of_inner_eq ((hUo p).inter (hUo q)) fun φ hφ ↦ ?_
    rw [← UniformSpace.Completion.inner_coe (β p) φ, ← hpair p φ (hφ.trans inter_subset_left),
      hpair q φ (hφ.trans inter_subset_right), UniformSpace.Completion.inner_coe]
  set α₀ : C → E [⋀^Fin 1]→L[ℝ] ℝ := fun p ↦ (β p).form p
  have hloc : ∀ p, ∀ p' ∈ U p, α₀ p' = (β p).form p' := fun p p' hp' ↦
    hcons p' p p' ⟨hpU p', hp'⟩
  have hsm : b3Forms_IsSmooth α₀ := by
    intro x
    refine contDiffOn_of_locally_contDiffOn fun u hu ↦ ?_
    set p := (chartAt E x).symm u
    refine ⟨(chartAt E x).target ∩ (chartAt E x).symm ⁻¹' U p,
      (chartAt E x).continuousOn_symm.isOpen_inter_preimage (chartAt E x).open_target (hUo p),
      ⟨hu, hpU p⟩, ?_⟩
    refine ((β p).isSmooth x).mono inter_subset_left |>.congr fun u' hu' ↦ ?_
    simp only [b3Forms_loc, hloc p _ hu'.2.2]
  let α : b3Rest_SF E C := b3Rest_SF.mk α₀ hsm
  refine ⟨α, ?_⟩
  -- the pairings agree, by a partition of unity
  obtain ⟨ρ, hρ⟩ := SmoothPartitionOfUnity.exists_isSubordinate 𝓘(ℝ, E) isClosed_univ U hUo
    (fun x _ ↦ mem_iUnion.2 ⟨x, hpU x⟩)
  set S := (ρ.locallyFinite.finite_nonempty_of_compact).toFinset
  have hρ0 : ∀ i ∉ S, ∀ z, ρ i z = 0 := by
    intro i hi z
    by_contra hz
    exact hi ((Set.Finite.mem_toFinset _).2 ⟨z, hz⟩)
  have hsum : ∀ z, ∑ i ∈ S, ρ i z = 1 := by
    intro z
    rw [← ρ.sum_eq_one (mem_univ z)]
    refine (finsum_eq_sum_of_support_subset _ fun i hi ↦ ?_).symm
    by_contra h'
    exact hi (hρ0 i h' z)
  have hall : ∀ φ : b3Rest_SF E C, inner ℝ h (φ : b3Rest_L2 E C) = inner ℝ (α : b3Rest_L2 E C) φ := by
    intro φ
    let piece : C → b3Rest_SF E C := fun i ↦
      b3Rest_SF.mk (b3Forms_smulFun (ρ i) φ.form) (φ.isSmooth.smulFun (ρ i).contMDiff)
    have hφsum : φ = ∑ i ∈ S, piece i := by
      refine b3Rest_SF.ext ?_
      rw [b3Rest_SF.form_sum]
      funext z
      simp only [piece, b3Rest_SF.form_mk, Finset.sum_apply, b3Forms_smulFun, ← Finset.sum_smul,
        hsum, one_smul]
    have hcoe : ((φ : b3Rest_SF E C) : b3Rest_L2 E C) = ∑ i ∈ S, ((piece i : b3Rest_SF E C) : b3Rest_L2 E C) := by
      conv_lhs => rw [hφsum]
      exact map_sum (UniformSpace.Completion.toCompl (α := b3Rest_SF E C)) _ _
    rw [hcoe, inner_sum, inner_sum]
    refine Finset.sum_congr rfl fun i _ ↦ ?_
    have hsupp : tsupport (piece i).form ⊆ U i :=
      (b3Forms_tsupport_smulFun_subset_left _ _).trans (hρ i)
    rw [hpair i (piece i) hsupp, UniformSpace.Completion.inner_coe,
      UniformSpace.Completion.inner_coe, b3Rest_SF.inner_def, b3Rest_SF.inner_def, b3Rest_inner,
      b3Rest_inner]
    congr 1
    funext z
    by_cases hz : z ∈ U i
    · have hα : α.form z = (β i).form z := hloc i z hz
      simp only [b3Forms_wedgeForm, hα]
    · have hz0 : (piece i).form z = 0 := by
        have : z ∉ tsupport (ρ i) := fun h' ↦ hz (hρ i h')
        simp [piece, b3Forms_smulFun, image_eq_zero_of_notMem_tsupport this]
      rw [b3Rest_wedge_star_eq_zero hz0, b3Rest_wedge_star_eq_zero hz0]
  -- density
  set v := h - (α : b3Rest_L2 E C)
  have hv : ∀ w : b3Rest_L2 E C, inner ℝ v w = 0 := by
    intro w
    induction w using UniformSpace.Completion.induction_on with
    | hp => exact isClosed_eq (continuous_const.inner continuous_id) continuous_const
    | ih φ => rw [inner_sub_left, hall φ, sub_self]
  have := hv v
  rw [inner_self_eq_zero, sub_eq_zero] at this
  exact this

open Metric
open scoped ComplexConjugate

/-- RiemannRochAna: local almost-everywhere coefficients determine pairings on any smaller disc. -/
theorem RiemannRochAna_inner_eq_coefficient (D : b3Rest_Disc (E := E) C)
    (h : b3Rest_L2 E C) {r : ℝ} (hr : r ≤ D.r') {G : ℂ → ℂ}
    (hG : ∀ᵐ z, z ∈ Metric.ball (0 : ℂ) r → (D.restrL2 h : ℂ → ℂ) z = G z)
    (φ : b3Rest_SF E C) (hφ : tsupport φ.form ⊆ b3Rest_reg hE1.out D.q r) :
    inner ℝ h (φ : b3Rest_L2 E C) =
      ∫ z in Metric.ball 0 r, (G z * conj (b3Rest_coef hE1.out φ.form D.q z)).re := by
  have hsub : ball (0 : ℂ) r ⊆ ball 0 D.r' := ball_subset_ball hr
  have hreg : b3Rest_reg hE1.out D.q r ⊆ b3Rest_reg hE1.out D.q D.r' := by
    rintro p ⟨hp, w, hw, hw'⟩
    exact ⟨hp, w, hsub hw, hw'⟩
  rw [D.inner_eq_restrL2 h φ (hφ.trans hreg), D.re_inner_Lp]
  have hae : (fun z ↦ ((D.restrL2 h : ℂ → ℂ) z * conj ((D.restr φ : ℂ → ℂ) z)).re) =ᵐ[D.μ]
      fun z ↦ ((D.restrL2 h : ℂ → ℂ) z * conj (b3Rest_coef hE1.out φ.form D.q z)).re := by
    filter_upwards [D.restr_ae φ] with z hz
    rw [hz]
  rw [integral_congr_ae hae]
  have hzero : ∀ z ∈ ball (0 : ℂ) D.r' \ ball 0 r,
      ((D.restrL2 h : ℂ → ℂ) z * conj (b3Rest_coef hE1.out φ.form D.q z)).re = 0 := by
    rintro z ⟨hz, hz'⟩
    rw [D.coef_eq_zero_of_notMem (fun hmem ↦ ?_), _root_.map_zero, mul_zero, Complex.zero_re]
    obtain ⟨-, w, hw, hw'⟩ := hφ hmem
    rw [(chartAt E D.q).right_inv (D.mem' (mem_ball_zero_iff.1 hz))] at hw'
    exact hz' (b3Rest_ζ_injective hE1.out D.q hw' ▸ hw)
  rw [setIntegral_eq_of_subset_of_forall_sdiff_eq_zero measurableSet_ball hsub hzero]
  refine setIntegral_congr_ae measurableSet_ball ?_
  filter_upwards [hG] with z hz hzb
  rw [hz hzb]


/-- RiemannRochAna: a smooth local coefficient supplies a smooth form with the same local pairings. -/
theorem RiemannRochAna_local_of_coefficient (D : b3Rest_Disc (E := E) C)
    (h : b3Rest_L2 E C) {ρ : ℝ} (hρ0 : 0 < ρ) (hρle : ρ ≤ D.r')
    {G : ℂ → ℂ} (hGd : ContDiffOn ℝ ∞ G (ball 0 ρ))
    (hGae : ∀ᵐ z, z ∈ ball (0 : ℂ) ρ → (D.restrL2 h : ℂ → ℂ) z = G z) :
    ∃ β : b3Rest_SF E C, ∃ U : Set C, IsOpen U ∧ D.q ∈ U ∧
      ∀ φ : b3Rest_SF E C, tsupport φ.form ⊆ U →
        inner ℝ h (φ : b3Rest_L2 E C) = inner ℝ (β : b3Rest_L2 E C) φ := by
  have hE := hE1.out
  set p₀ := D.q
  set R := D.r
  have hρR : ρ < R := hρle.trans_lt D.lt
  have hR : ∀ z : ℂ, ‖z‖ < R → b3Rest_ζ hE p₀ z ∈ (chartAt E p₀).target := D.mem
  obtain ⟨g, hg, hgc, hgs, hg01, hg1⟩ := b3Rest_exists_bump (r₁ := ρ / 2) (r₂ := 3 * ρ / 4)
    (by positivity) (by linarith)
  have hgs' : tsupport g ⊆ ball 0 ρ := hgs.trans (ball_subset_ball (by linarith))
  set W : ℂ → ℂ := fun z ↦ (g z : ℂ) * G z
  have hW : ContDiff ℝ ∞ W := by
    rw [contDiff_iff_contDiffAt]
    intro z
    by_cases hz : z ∈ ball (0 : ℂ) ρ
    · exact (Complex.ofRealCLM.contDiff.comp hg).contDiffAt.mul
        (hGd.contDiffAt (isOpen_ball.mem_nhds hz))
    · have hz' : z ∉ tsupport g := fun h ↦ hz (hgs' h)
      refine (contDiffAt_const (c := (0 : ℂ))).congr_of_eventuallyEq ?_
      filter_upwards [notMem_tsupport_iff_eventuallyEq.1 hz'] with w hw
      simp only [W, hw, Pi.zero_apply, Complex.ofReal_zero, zero_mul]
  set c := chartAt E p₀ p₀
  set ψ : E → ℂ := fun u ↦ (b3Rest_L hE).symm (u - c)
  have hψ : ContDiff ℝ ∞ ψ := (b3Rest_L hE).symm.contDiff.comp (contDiff_id.sub contDiff_const)
  set A : E → E [⋀^Fin 1]→L[ℝ] ℝ := fun u ↦ b3Rest_ell hE (W (ψ u))
  have hA : ContDiff ℝ ∞ A := (b3Rest_ell hE).contDiff.comp (hW.comp hψ)
  have hR' : ∀ z : ℂ, ‖z‖ < R → b3Rest_ζ hE p₀ z ∈ (chartAt E p₀).target := hR
  have hψζ : ∀ z, ψ (b3Rest_ζ hE p₀ z) = z := b3Rest_L_symm_ζ hE p₀
  have hζψ : ∀ u, b3Rest_ζ hE p₀ (ψ u) = u := fun u ↦ by
    show c + ψ u • b3Rest_e hE = u
    rw [← b3Rest_L_apply, ContinuousLinearEquiv.apply_symm_apply, add_sub_cancel]
  have hζc : Continuous (b3Rest_ζ hE p₀) := by
    show Continuous fun z : ℂ ↦ c + z • b3Rest_e hE
    fun_prop
  -- support of `A`
  have hAsupp : tsupport A ⊆ b3Rest_ζ hE p₀ '' tsupport g := by
    refine closure_minimal (fun u hu ↦ ?_) (hgc.isCompact.image hζc).isClosed
    have hgu : g (ψ u) ≠ 0 := by
      intro h0
      apply hu
      simp [A, W, h0]
    exact ⟨ψ u, subset_closure hgu, hζψ u⟩
  have hAc : HasCompactSupport A :=
    (hgc.isCompact.image hζc).of_isClosed_subset (isClosed_tsupport _) hAsupp
  have hAt : tsupport A ⊆ (chartAt E p₀).target := by
    refine hAsupp.trans ?_
    rintro _ ⟨z, hz, rfl⟩
    exact hR z (by have := mem_ball_zero_iff.1 (hgs' hz); linarith)
  let β : b3Rest_SF E C := b3Rest_SF.mk (b3Rest_ofLoc p₀ A) (b3Rest_isSmooth_ofLoc p₀ hA hAc hAt)
  have hlocβ : ∀ u ∈ (chartAt E p₀).target, b3Forms_loc β.form p₀ u = A u := fun u hu ↦
    b3Rest_loc_ofLoc_self p₀ A hu
  have hcoefβ : ∀ z : ℂ, ‖z‖ < R → b3Rest_coef hE β.form p₀ z = W z := by
    intro z hz
    rw [b3Rest_coef, hlocβ (b3Rest_ζ hE p₀ z) (hR z hz)]
    simp only [A, hψζ]
    exact b3Rest_ell_coef hE (W z)
  -- the open set `U`
  have hregeq : ∀ r, b3Rest_reg hE p₀ r = (chartAt E p₀).source ∩ chartAt E p₀ ⁻¹' (ψ ⁻¹' ball 0 r) := by
    intro r
    ext p
    simp only [b3Rest_reg, mem_inter_iff, mem_preimage, mem_image]
    constructor
    · rintro ⟨hp, z, hz, hzp⟩
      exact ⟨hp, by rw [← hzp, hψζ]; exact hz⟩
    · rintro ⟨hp, hpz⟩
      exact ⟨hp, ψ (chartAt E p₀ p), hpz, hζψ _⟩
  refine ⟨β, b3Rest_reg hE p₀ (ρ / 2), ?_, ?_, ?_⟩
  · rw [hregeq]
    exact (chartAt E p₀).continuousOn.isOpen_inter_preimage (chartAt E p₀).open_source
      (isOpen_ball.preimage hψ.continuous)
  · rw [hregeq]
    refine ⟨mem_chart_source E p₀, ?_⟩
    simp [ψ, c, hρ0]
  · intro φ hφ
    have hsub : b3Rest_reg hE p₀ (ρ / 2) ⊆ b3Rest_reg hE p₀ ρ := by
      rintro p ⟨hp, w, hw, hw'⟩
      exact ⟨hp, w, ball_subset_ball (by linarith) hw, hw'⟩
    have h1 := RiemannRochAna_inner_eq_coefficient D h hρle hGae φ (hφ.trans hsub)
    rw [h1, UniformSpace.Completion.inner_coe, b3Rest_SF.inner_def,
      b3Rest_inner_eq_disc hE β.isSmooth φ.isSmooth p₀
        (fun z hz ↦ hR z (by linarith)) (hφ.trans hsub)]
    refine setIntegral_congr_fun measurableSet_ball fun z hz ↦ ?_
    rw [hcoefβ z (by have := mem_ball_zero_iff.1 hz; linarith)]
    by_cases hz2 : z ∈ ball (0 : ℂ) (ρ / 2)
    · simp only [W, hg1 z (ball_subset_closedBall hz2), Complex.ofReal_one, one_mul]
      rfl
    · rw [D.coef_eq_zero_of_notMem (z := z) (φ := φ.form) (fun hmem ↦ ?_)]
      · simp
      obtain ⟨-, w, hw, hw'⟩ := hφ hmem
      have hw2 : b3Rest_ζ hE p₀ w = chartAt E p₀ ((chartAt E p₀).symm (b3Rest_ζ hE p₀ z)) := hw'
      rw [(chartAt E p₀).right_inv (hR' z (by have := mem_ball_zero_iff.1 hz; linarith))] at hw2
      exact hz2 (b3Rest_ζ_injective hE p₀ hw2 ▸ hw)

/-- RiemannRochAna: smooth weak chart equations give a smooth global Hilbert representative. -/
theorem RiemannRochAna_smooth_of_weak_chart_equations (h : b3Rest_L2 E C)
    (hw : ∀ p : C, ∃ D : b3Rest_Disc (E := E) C, D.q = p ∧ ∃ g : ℂ → ℂ,
      ContDiffOn ℝ ∞ g (ball 0 D.r') ∧
      ∀ ψ : ℂ → ℂ, ContDiff ℝ ∞ ψ → HasCompactSupport ψ →
        tsupport ψ ⊆ ball 0 D.r' →
        (∫ z, (D.restrL2 h : ℂ → ℂ) z * b3Rest_dbar ψ z) =
          -∫ z, (2 * g z) * ψ z) :
    ∃ α : b3Rest_SF E C, h = (α : b3Rest_L2 E C) := by
  apply RiemannRochAna_smooth_of_local h
  intro p
  obtain ⟨D, hDp, g, hg, hwg⟩ := hw p
  have hu : IntegrableOn (D.restrL2 h : ℂ → ℂ) (ball 0 D.r') :=
    (Lp.memLp (D.restrL2 h)).integrable one_le_two
  obtain ⟨r, hr, F, hF, he⟩ := RiemannRochAna_weyl_inhomogeneous D.pos hu hg hwg
  have hr' : 0 < min r D.r' := lt_min hr D.pos
  have hF' : ContDiffOn ℝ ∞ F (ball 0 (min r D.r')) :=
    hF.mono (ball_subset_ball (min_le_left _ _))
  have he' : ∀ᵐ z, z ∈ ball (0 : ℂ) (min r D.r') → (D.restrL2 h : ℂ → ℂ) z = F z := by
    filter_upwards [he] with z hz hzr
    exact hz (ball_subset_ball (min_le_left _ _) hzr)
  obtain ⟨β, U, hU, hDU, hpair⟩ :=
    RiemannRochAna_local_of_coefficient D h hr' (min_le_right _ _) hF' he'
  exact ⟨β, U, hU, hDp ▸ hDU, hpair⟩

/-- RiemannRochAna: real test derivatives recover the exact and coexact Hilbert pairings. -/
theorem RiemannRochAna_weak_pairings (D : b3Rest_Disc (E := E) C)
    (h : b3Rest_L2 E C) {g : ℂ → ℝ} (hg : ContDiff ℝ ∞ g)
    (hgc : HasCompactSupport g) (hgs : tsupport g ⊆ ball 0 D.r') :
    ∃ hFs : b3Rest_SmoothFun (E := E) (b3Rest_cfun hE1.out D.q g),
      (∫ z in ball 0 D.r', (D.restrL2 h : ℂ → ℂ) z *
        b3Rest_dbar (fun w ↦ (g w : ℂ)) z).re =
          inner ℝ h ((b3Rest_dSF hFs : b3Rest_SF E C) : b3Rest_L2 E C) ∧
      (∫ z in ball 0 D.r', (D.restrL2 h : ℂ → ℂ) z *
        b3Rest_dbar (fun w ↦ (g w : ℂ)) z).im =
          -inner ℝ h ((b3Rest_sdSF hFs : b3Rest_SF E C) : b3Rest_L2 E C) := by
  have hgd : Differentiable ℝ g := hg.differentiable (by simp)
  have hr' : ∀ z : ℂ, ‖z‖ < D.r' → b3Rest_ζ hE1.out D.q z ∈ (chartAt E D.q).target :=
    fun z hz ↦ D.mem' hz
  have hFs : b3Rest_SmoothFun (E := E) (b3Rest_cfun hE1.out D.q g) :=
    b3Rest_smoothFun_cfun hE1.out D.q hg hgc fun z hz ↦ hr' z (mem_ball_zero_iff.1 (hgs hz))
  have hFreg : tsupport (b3Rest_cfun hE1.out D.q g) ⊆ b3Rest_reg hE1.out D.q D.r' :=
    b3Rest_tsupport_cfun_reg hE1.out D.q hgc hgs hr'
  have hdreg : tsupport (b3Rest_dSF hFs).form ⊆ b3Rest_reg hE1.out D.q D.r' :=
    (b3Forms_tsupport_d_subset _).trans ((b3Rest_Disc.tsupport_fun_subset _).trans hFreg)
  have hsdreg : tsupport (b3Rest_sdSF hFs).form ⊆ b3Rest_reg hE1.out D.q D.r' :=
    (b3Rest_Disc.tsupport_star_subset _).trans hdreg
  have h1 := D.inner_eq_restrL2 h (b3Rest_dSF hFs) hdreg
  have h2 := D.inner_eq_restrL2 h (b3Rest_sdSF hFs) hsdreg
  rw [D.re_inner_Lp] at h1 h2
  set u := (D.restrL2 h : ℂ → ℂ)
  have hcd : ∀ z ∈ ball (0 : ℂ) D.r', b3Rest_coef hE1.out (b3Rest_dSF hFs).form D.q z =
      conj (b3Rest_dbar (fun w ↦ (g w : ℂ)) z) := by
    intro z hz
    rw [b3Rest_Disc.dbar_ofReal hgd]
    simp only [b3Rest_dSF, b3Rest_SF.form_mk]
    rw [b3Rest_coef_d_cfun hE1.out D.q hgd hFs (hr' z (mem_ball_zero_iff.1 hz))]
    simp [map_add, map_mul, Complex.conj_ofReal, Complex.conj_I]
    ring
  have hcsd : ∀ z ∈ ball (0 : ℂ) D.r', b3Rest_coef hE1.out (b3Rest_sdSF hFs).form D.q z =
      -Complex.I * conj (b3Rest_dbar (fun w ↦ (g w : ℂ)) z) := by
    intro z hz
    simp only [b3Rest_sdSF, b3Rest_SF.form_mk]
    rw [b3Rest_coef_star hE1.out _ D.q (hr' z (mem_ball_zero_iff.1 hz)), ← hcd z hz]
    rfl
  have hint := D.integrable_mul_dbar h hg hgc
  set W := ∫ z in ball 0 D.r', u z * b3Rest_dbar (fun w ↦ (g w : ℂ)) z
  refine ⟨hFs, ?_, ?_⟩
  · rw [h1]
    have hir := integral_re hint
    simp only [RCLike.re_to_complex] at hir
    change W.re = _
    rw [show W = ∫ z, u z * b3Rest_dbar (fun w ↦ (g w : ℂ)) z ∂D.μ from rfl, ← hir]
    refine integral_congr_ae ?_
    filter_upwards [D.restr_ae (b3Rest_dSF hFs), ae_restrict_mem measurableSet_ball] with z hz hzb
    rw [hz, hcd z hzb, Complex.conj_conj]
  · rw [h2, ← integral_neg]
    have hii := integral_im hint
    simp only [RCLike.im_to_complex] at hii
    change W.im = _
    rw [show W = ∫ z, u z * b3Rest_dbar (fun w ↦ (g w : ℂ)) z ∂D.μ from rfl, ← hii]
    refine integral_congr_ae ?_
    filter_upwards [D.restr_ae (b3Rest_sdSF hFs), ae_restrict_mem measurableSet_ball] with z hz hzb
    rw [hz, hcsd z hzb]
    simp only [map_mul, map_neg, Complex.conj_I, Complex.conj_conj, Complex.mul_re,
      Complex.mul_im, Complex.neg_re, Complex.neg_im, Complex.I_re, Complex.I_im]
    ring

/-- RiemannRochAna: the exact projection has the real weak derivative of the original smooth form. -/
theorem RiemannRochAna_exact_weak_real (D : b3Rest_Disc (E := E) C)
    (a : b3Rest_SF E C) (e : b3Rest_L2 E C) (he : e ∈ b3Rest_Ex E C)
    (hae : (a : b3Rest_L2 E C) - e ∈ (b3Rest_Ex E C)ᗮ)
    {g : ℂ → ℝ} (hg : ContDiff ℝ ∞ g) (hgc : HasCompactSupport g)
    (hgs : tsupport g ⊆ ball 0 D.r') :
    (∫ z in ball 0 D.r', (D.restrL2 e : ℂ → ℂ) z * b3Rest_dbar (fun w ↦ (g w : ℂ)) z) =
      ((∫ z in ball 0 D.r', (D.restrL2 (a : b3Rest_L2 E C) : ℂ → ℂ) z *
        b3Rest_dbar (fun w ↦ (g w : ℂ)) z).re : ℂ) := by
  obtain ⟨hFs, her, hei⟩ := RiemannRochAna_weak_pairings D e hg hgc hgs
  obtain ⟨hFs', har, hai⟩ := RiemannRochAna_weak_pairings D (a : b3Rest_L2 E C) hg hgc hgs
  have hd : ((b3Rest_dSF hFs : b3Rest_SF E C) : b3Rest_L2 E C) ∈ b3Rest_Ex E C :=
    Submodule.le_topologicalClosure _ (Submodule.subset_span ⟨⟨_, hFs⟩, rfl⟩)
  have hsd : ((b3Rest_sdSF hFs : b3Rest_SF E C) : b3Rest_L2 E C) ∈ b3Rest_Co E C :=
    Submodule.le_topologicalClosure _ (Submodule.subset_span ⟨⟨_, hFs⟩, rfl⟩)
  have hsame := (Submodule.mem_orthogonal' _ _).1 hae _ hd
  rw [inner_sub_left, sub_eq_zero] at hsame
  apply Complex.ext
  · simp only [Complex.ofReal_re]
    exact her.trans (hsame.symm.trans har.symm)
  · simp only [Complex.ofReal_im]
    rw [hei, b3Rest_Ex_inner_Co he hsd, neg_zero]

/-- RiemannRochAna: the plane derivative splits into its real and imaginary test functions. -/
theorem RiemannRochAna_dbar_split {ψ : ℂ → ℂ} (hψ : ContDiff ℝ ∞ ψ) (z : ℂ) :
    b3Rest_dbar ψ z = b3Rest_dbar (fun w ↦ ((ψ w).re : ℂ)) z +
      Complex.I * b3Rest_dbar (fun w ↦ ((ψ w).im : ℂ)) z := by
  have h1s : ContDiff ℝ ∞ (fun z ↦ (ψ z).re) := Complex.reCLM.contDiff.comp hψ
  have h2s : ContDiff ℝ ∞ (fun z ↦ (ψ z).im) := Complex.imCLM.contDiff.comp hψ
  have hψe : ψ = (fun w ↦ ((ψ w).re : ℂ)) +
      Complex.I • (fun w ↦ ((ψ w).im : ℂ)) := by
    funext w
    simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
    rw [mul_comm]
    exact (Complex.re_add_im _).symm
  have hd1 : DifferentiableAt ℝ (fun w ↦ ((ψ w).re : ℂ)) z :=
    Complex.ofRealCLM.differentiableAt.comp z ((h1s.differentiable (by simp)) z)
  have hd2 : DifferentiableAt ℝ (fun w ↦ ((ψ w).im : ℂ)) z :=
    Complex.ofRealCLM.differentiableAt.comp z ((h2s.differentiable (by simp)) z)
  have hf : fderiv ℝ ψ z = fderiv ℝ (fun w ↦ ((ψ w).re : ℂ)) z +
      Complex.I • fderiv ℝ (fun w ↦ ((ψ w).im : ℂ)) z := by
    conv_lhs => rw [hψe]
    rw [fderiv_add hd1 (hd2.const_smul Complex.I), fderiv_const_smul hd2]
  simp only [b3Rest_dbar, hf, _root_.add_apply, _root_.smul_apply, smul_eq_mul]
  ring

/-- RiemannRochAna: exact projections pair with complex test derivatives through two real pairings. -/
theorem RiemannRochAna_exact_weak_complex (D : b3Rest_Disc (E := E) C)
    (a : b3Rest_SF E C) (e : b3Rest_L2 E C) (he : e ∈ b3Rest_Ex E C)
    (hae : (a : b3Rest_L2 E C) - e ∈ (b3Rest_Ex E C)ᗮ)
    {ψ : ℂ → ℂ} (hψ : ContDiff ℝ ∞ ψ) (hc : HasCompactSupport ψ)
    (hs : tsupport ψ ⊆ ball 0 D.r') :
    (∫ z, (D.restrL2 e : ℂ → ℂ) z * b3Rest_dbar ψ z) =
      ((∫ z in ball 0 D.r', (D.restrL2 (a : b3Rest_L2 E C) : ℂ → ℂ) z *
        b3Rest_dbar (fun w ↦ ((ψ w).re : ℂ)) z).re : ℂ) +
      Complex.I * ((∫ z in ball 0 D.r', (D.restrL2 (a : b3Rest_L2 E C) : ℂ → ℂ) z *
        b3Rest_dbar (fun w ↦ ((ψ w).im : ℂ)) z).re : ℂ) := by
  have h1s : ContDiff ℝ ∞ (fun z ↦ (ψ z).re) := Complex.reCLM.contDiff.comp hψ
  have h2s : ContDiff ℝ ∞ (fun z ↦ (ψ z).im) := Complex.imCLM.contDiff.comp hψ
  have hts1 : tsupport (fun z ↦ (ψ z).re) ⊆ tsupport ψ :=
    tsupport_comp_subset (g := Complex.re) rfl ψ
  have hts2 : tsupport (fun z ↦ (ψ z).im) ⊆ tsupport ψ :=
    tsupport_comp_subset (g := Complex.im) rfl ψ
  have hc1 := hc.mono' ((subset_tsupport _).trans hts1)
  have hc2 := hc.mono' ((subset_tsupport _).trans hts2)
  have hzero : ∀ z ∉ ball (0 : ℂ) D.r',
      (D.restrL2 e : ℂ → ℂ) z * b3Rest_dbar ψ z = 0 := by
    intro z hz
    have hn : z ∉ tsupport ψ := fun h ↦ hz (hs h)
    simp [b3Rest_dbar, b3Rest_fderiv_eq_zero_of_notMem hn]
  rw [← setIntegral_eq_integral_of_forall_compl_eq_zero hzero]
  simp only [RiemannRochAna_dbar_split hψ, mul_add]
  have i1 := D.integrable_mul_dbar e h1s hc1
  have i2 := D.integrable_mul_dbar e h2s hc2
  rw [integral_add i1 (by simpa only [mul_left_comm] using i2.const_mul Complex.I)]
  simp only [mul_left_comm ((D.restrL2 e : ℂ → ℂ) _) Complex.I]
  rw [integral_const_mul, RiemannRochAna_exact_weak_real D a e he hae h1s hc1 (hts1.trans hs),
    RiemannRochAna_exact_weak_real D a e he hae h2s hc2 (hts2.trans hs)]

/-- RiemannRochAna: smooth real forms have smooth complex chart coefficients. -/
theorem RiemannRochAna_coefficient_smooth (D : b3Rest_Disc (E := E) C)
    (a : b3Rest_SF E C) : ContDiffOn ℝ ∞ (b3Rest_coef hE1.out a.form D.q) (ball 0 D.r) := by
  have hζ : ContDiff ℝ ∞ (b3Rest_ζ hE1.out D.q) := by
    show ContDiff ℝ ∞ (fun z : ℂ ↦ chartAt E D.q D.q + z • b3Rest_e hE1.out)
    exact contDiff_const.add (contDiff_id.smul contDiff_const)
  have hl := (a.isSmooth D.q).comp hζ.contDiffOn
    (fun z hz ↦ D.mem z (mem_ball_zero_iff.mp hz))
  have hev (v : Fin 1 → E) :=
    (ContinuousAlternatingMap.apply ℝ E ℝ v).contDiff.comp_contDiffOn hl
  exact (Complex.ofRealCLM.contDiff.comp_contDiffOn (hev _)).sub
    (contDiffOn_const.mul (Complex.ofRealCLM.contDiff.comp_contDiffOn (hev _)))

/-- RiemannRochAna: a chart coefficient extends smoothly from the smaller chart disc. -/
theorem RiemannRochAna_coefficient_extension (D : b3Rest_Disc (E := E) C)
    (a : b3Rest_SF E C) : ∃ A : ℂ → ℂ, ContDiff ℝ ∞ A ∧
      ∀ z ∈ ball (0 : ℂ) D.r', A z = b3Rest_coef hE1.out a.form D.q z := by
  obtain ⟨g, hg, hgc, hgs, hg01, hg1⟩ := b3Rest_exists_bump
    (r₁ := D.r') (r₂ := (D.r' + D.r) / 2) D.pos (by linarith [D.lt])
  have hgs' : tsupport g ⊆ ball (0 : ℂ) D.r :=
    hgs.trans (ball_subset_ball (by linarith [D.lt]))
  have hG := RiemannRochAna_coefficient_smooth D a
  refine ⟨fun z ↦ (g z : ℂ) * b3Rest_coef hE1.out a.form D.q z, ?_, ?_⟩
  · rw [contDiff_iff_contDiffAt]
    intro z
    by_cases hz : z ∈ ball (0 : ℂ) D.r
    · exact (Complex.ofRealCLM.contDiff.comp hg).contDiffAt.mul
        (hG.contDiffAt (isOpen_ball.mem_nhds hz))
    · have hz' : z ∉ tsupport g := fun h ↦ hz (hgs' h)
      refine (contDiffAt_const (c := (0 : ℂ))).congr_of_eventuallyEq ?_
      filter_upwards [notMem_tsupport_iff_eventuallyEq.1 hz'] with w hw
      simp [hw]
  · intro z hz
    dsimp only
    rw [hg1 z (ball_subset_closedBall hz), Complex.ofReal_one, one_mul]

/-- RiemannRochAna: smooth Hilbert coefficients have the classical integral pairing. -/
theorem RiemannRochAna_smooth_coefficient_pairing (D : b3Rest_Disc (E := E) C)
    (a : b3Rest_SF E C) {A : ℂ → ℂ}
    (hA : ∀ z ∈ ball (0 : ℂ) D.r', A z = b3Rest_coef hE1.out a.form D.q z)
    {ψ : ℂ → ℂ} (hs : tsupport ψ ⊆ ball 0 D.r') :
    (∫ z in ball 0 D.r', (D.restrL2 (a : b3Rest_L2 E C) : ℂ → ℂ) z * b3Rest_dbar ψ z) =
      ∫ z, A z * b3Rest_dbar ψ z := by
  have hae : (D.restrL2 (a : b3Rest_L2 E C) : ℂ → ℂ) =ᵐ[D.μ] A := by
    have he : D.restrL2 (a : b3Rest_L2 E C) = D.restr a := D.restrL2_coe a
    rw [he]
    filter_upwards [D.restr_ae a, ae_restrict_mem measurableSet_ball] with z hz hzb
    exact hz.trans (hA z hzb).symm
  rw [integral_congr_ae (hae.mono fun z hz ↦ congrArg (fun w ↦ w * b3Rest_dbar ψ z) hz)]
  apply setIntegral_eq_integral_of_forall_compl_eq_zero
  intro z hz
  have hn : z ∉ tsupport ψ := fun h ↦ hz (hs h)
  simp [b3Rest_dbar, b3Rest_fderiv_eq_zero_of_notMem hn]

/-- RiemannRochAna: the real pairing of a smooth coefficient is its real divergence against the test function. -/
theorem RiemannRochAna_real_parts {A : ℂ → ℂ} (hA : ContDiff ℝ ∞ A)
    {g : ℂ → ℝ} (hg : ContDiff ℝ ∞ g) (hc : HasCompactSupport g) :
    (((∫ z, A z * b3Rest_dbar (fun w ↦ (g w : ℂ)) z).re : ℝ) : ℂ) =
      -∫ z, ((b3Rest_dbar A z).re : ℂ) * (g z : ℂ) := by
  have hgc : HasCompactSupport (fun w ↦ (g w : ℂ)) :=
    hc.comp_left (g := Complex.ofReal) rfl
  have hgs : ContDiff ℝ ∞ (fun w ↦ (g w : ℂ)) := Complex.ofRealCLM.contDiff.comp hg
  rw [RiemannRochAna_integral_dbar_parts hA hgs hgc, Complex.neg_re, Complex.ofReal_neg]
  congr 1
  have hd : Continuous (b3Rest_dbar A) :=
    ((hA.continuous_fderiv (by simp)).clm_apply continuous_const).add
      (continuous_const.mul ((hA.continuous_fderiv (by simp)).clm_apply continuous_const))
  have hi : Integrable (fun z ↦ b3Rest_dbar A z * (g z : ℂ)) :=
    (hd.mul hgs.continuous).integrable_of_hasCompactSupport hgc.mul_left
  have hr := integral_re hi
  simp only [RCLike.re_to_complex] at hr
  rw [← hr]
  calc
    _ = ∫ z, ((b3Rest_dbar A z * (g z : ℂ)).re : ℂ) :=
      (integral_ofReal (𝕜 := ℂ) (μ := volume)
        (f := fun z ↦ (b3Rest_dbar A z * (g z : ℂ)).re)).symm
    _ = _ := by
      apply integral_congr_ae
      exact Filter.Eventually.of_forall fun z ↦ by simp [Complex.mul_re]

/-- RiemannRochAna: the exact projection satisfies a smooth inhomogeneous chart equation. -/
theorem RiemannRochAna_exact_chart_equation (D : b3Rest_Disc (E := E) C)
    (a : b3Rest_SF E C) (e : b3Rest_L2 E C) (he : e ∈ b3Rest_Ex E C)
    (hae : (a : b3Rest_L2 E C) - e ∈ (b3Rest_Ex E C)ᗮ) :
    ∃ g : ℂ → ℂ, ContDiff ℝ ∞ g ∧
      ∀ ψ : ℂ → ℂ, ContDiff ℝ ∞ ψ → HasCompactSupport ψ →
        tsupport ψ ⊆ ball 0 D.r' →
        (∫ z, (D.restrL2 e : ℂ → ℂ) z * b3Rest_dbar ψ z) =
          -∫ z, (2 * g z) * ψ z := by
  obtain ⟨A, hA, hAe⟩ := RiemannRochAna_coefficient_extension D a
  have hd : ContDiff ℝ ∞ (b3Rest_dbar A) :=
    ((hA.fderiv_right le_rfl).clm_apply contDiff_const).add
      (contDiff_const.mul ((hA.fderiv_right le_rfl).clm_apply contDiff_const))
  let G : ℂ → ℂ := fun z ↦ ((b3Rest_dbar A z).re : ℂ)
  have hG : ContDiff ℝ ∞ G :=
    Complex.ofRealCLM.contDiff.comp (Complex.reCLM.contDiff.comp hd)
  refine ⟨fun z ↦ G z / 2, hG.div_const _, ?_⟩
  intro ψ hψ hc hs
  have h1s : ContDiff ℝ ∞ (fun z ↦ (ψ z).re) := Complex.reCLM.contDiff.comp hψ
  have h2s : ContDiff ℝ ∞ (fun z ↦ (ψ z).im) := Complex.imCLM.contDiff.comp hψ
  have hts1 : tsupport (fun z ↦ (ψ z).re) ⊆ tsupport ψ :=
    tsupport_comp_subset (g := Complex.re) rfl ψ
  have hts2 : tsupport (fun z ↦ (ψ z).im) ⊆ tsupport ψ :=
    tsupport_comp_subset (g := Complex.im) rfl ψ
  have hc1 := hc.mono' ((subset_tsupport _).trans hts1)
  have hc2 := hc.mono' ((subset_tsupport _).trans hts2)
  have hs1 : tsupport (fun z ↦ ((ψ z).re : ℂ)) ⊆ ball 0 D.r' :=
    (tsupport_comp_subset (g := Complex.ofReal) rfl _).trans (hts1.trans hs)
  have hs2 : tsupport (fun z ↦ ((ψ z).im : ℂ)) ⊆ ball 0 D.r' :=
    (tsupport_comp_subset (g := Complex.ofReal) rfl _).trans (hts2.trans hs)
  rw [RiemannRochAna_exact_weak_complex D a e he hae hψ hc hs,
    RiemannRochAna_smooth_coefficient_pairing D a hAe hs1,
    RiemannRochAna_smooth_coefficient_pairing D a hAe hs2,
    RiemannRochAna_real_parts hA h1s hc1, RiemannRochAna_real_parts hA h2s hc2]
  have hi1 : Integrable (fun z ↦ G z * ((ψ z).re : ℂ)) :=
    (hG.continuous.mul (Complex.ofRealCLM.continuous.comp h1s.continuous)).integrable_of_hasCompactSupport
      (hc1.comp_left rfl).mul_left
  have hi2 : Integrable (fun z ↦ G z * ((ψ z).im : ℂ)) :=
    (hG.continuous.mul (Complex.ofRealCLM.continuous.comp h2s.continuous)).integrable_of_hasCompactSupport
      (hc2.comp_left rfl).mul_left
  change -(∫ z, G z * ((ψ z).re : ℂ)) + Complex.I * -(∫ z, G z * ((ψ z).im : ℂ)) = _
  rw [mul_neg, ← neg_add, ← integral_const_mul, ← integral_add hi1 (hi2.const_mul _)]
  congr 1
  apply integral_congr_ae
  exact Filter.Eventually.of_forall fun z ↦ by
    have hψz := Complex.re_add_im (ψ z)
    dsimp only
    rw [show 2 * (G z / 2) = G z by ring]
    calc
      _ = G z * (((ψ z).re : ℂ) + ((ψ z).im : ℂ) * Complex.I) := by ring
      _ = G z * ψ z := congrArg (fun w ↦ G z * w) hψz

/-- RiemannRochAna: an exact Hilbert projection of a smooth form has a smooth representative. -/
theorem RiemannRochAna_exact_projection_smooth
    (a : b3Rest_SF E C) (e : b3Rest_L2 E C) (he : e ∈ b3Rest_Ex E C)
    (hae : (a : b3Rest_L2 E C) - e ∈ (b3Rest_Ex E C)ᗮ) :
    ∃ α : b3Rest_SF E C, e = (α : b3Rest_L2 E C) := by
  apply RiemannRochAna_smooth_of_weak_chart_equations e
  intro p
  obtain ⟨R, hR0, hR⟩ := b3A_chart_radius (b3Rest_e hE1.out) (b3Rest_e_ne_zero hE1.out) p
  let D : b3Rest_Disc (E := E) C := ⟨p, R, R / 2, by positivity, by linarith, hR⟩
  obtain ⟨g, hg, hw⟩ := RiemannRochAna_exact_chart_equation D a e he hae
  exact ⟨D, rfl, g, hg.contDiffOn, hw⟩

/-- RiemannRochAna: a smooth member of the exact Hilbert subspace has zero exterior derivative. -/
theorem RiemannRochAna_exact_d_eq_zero (a : b3Rest_SF E C)
    (ha : (a : b3Rest_L2 E C) ∈ b3Rest_Ex E C) : b3Forms_d a.form = 0 := by
  apply b3Rest2_d_eq_zero_of_wedge_d hE1.out a.isSmooth
  intro g hg
  have hc : ((b3Rest_sdSF hg : b3Rest_SF E C) : b3Rest_L2 E C) ∈ b3Rest_Co E C :=
    Submodule.le_topologicalClosure _ (Submodule.subset_span ⟨⟨_, hg⟩, rfl⟩)
  have hi := b3Rest_Ex_inner_Co ha hc
  rw [UniformSpace.Completion.inner_coe, b3Rest_SF.inner_def, b3Rest_inner] at hi
  change b3Forms_integral (b3Rest_b hE1.out)
    (b3Forms_wedgeForm a.form (b3Forms_star (b3Forms_star (b3Forms_d (b3Forms_fun g))))) = 0 at hi
  rw [b3Forms_star_star] at hi
  have he : b3Forms_wedgeForm a.form (-b3Forms_d (b3Forms_fun (E := E) g)) =
      b3Forms_wedgeForm (b3Forms_d (b3Forms_fun (E := E) g)) a.form := by
    funext z
    simp only [b3Forms_wedgeForm, Pi.neg_apply]
    rw [show -b3Forms_d (b3Forms_fun (E := E) g) z = (-1 : ℝ) • b3Forms_d (b3Forms_fun g) z by
      simp, b3Forms_wedge_smul_right, b3Forms_wedge_comm, neg_one_smul, neg_neg]
  rwa [he] at hi

/-- RiemannRochAna: a smooth member of the coexact Hilbert subspace has zero exterior derivative after star. -/
theorem RiemannRochAna_coexact_star_d_eq_zero (a : b3Rest_SF E C)
    (ha : (a : b3Rest_L2 E C) ∈ b3Rest_Co E C) :
    b3Forms_d (b3Forms_star a.form) = 0 := by
  apply b3Rest2_d_eq_zero_of_wedge_d hE1.out a.isSmooth.star
  intro g hg
  have he : ((b3Rest_dSF hg : b3Rest_SF E C) : b3Rest_L2 E C) ∈ b3Rest_Ex E C :=
    Submodule.le_topologicalClosure _ (Submodule.subset_span ⟨⟨_, hg⟩, rfl⟩)
  have hi := b3Rest_Ex_inner_Co he ha
  rw [UniformSpace.Completion.inner_coe, b3Rest_SF.inner_def, b3Rest_inner] at hi
  exact hi

/-- RiemannRochAna: an exact Hilbert projection of a smooth form has a smooth potential. -/
theorem RiemannRochAna_exact_projection_potential [ConnectedSpace C]
    (a : b3Rest_SF E C) (e : b3Rest_L2 E C) (he : e ∈ b3Rest_Ex E C)
    (hae : (a : b3Rest_L2 E C) - e ∈ (b3Rest_Ex E C)ᗮ) :
    ∃ g : C → ℝ, ∃ hg : ContMDiff 𝓘(ℝ, E) 𝓘(ℝ, ℝ) ∞ g,
      e = ((b3Rest_dSF (b3Forms_isSmooth_fun hg) : b3Rest_SF E C) : b3Rest_L2 E C) := by
  obtain ⟨α, hα⟩ := RiemannRochAna_exact_projection_smooth a e he hae
  have hαe : (α : b3Rest_L2 E C) ∈ b3Rest_Ex E C := hα ▸ he
  obtain ⟨g, hg, hge⟩ := RiemannRochAna_primitive_of_exact α
    (RiemannRochAna_exact_d_eq_zero α hαe) hαe
  refine ⟨g, hg, hα.trans ?_⟩
  apply congrArg (fun β : b3Rest_SF E C ↦ (β : b3Rest_L2 E C))
  exact b3Rest_SF.ext hge.symm

/-- RiemannRochAna: star is a real linear operator on smooth real forms. -/
def RiemannRochAna_starSF : b3Rest_SF E C →ₗ[ℝ] b3Rest_SF E C where
  toFun a := b3Rest_SF.mk (b3Forms_star a.form) a.isSmooth.star
  map_add' a b := by
    apply b3Rest_SF.ext
    funext x
    exact (b3Forms_starL (E := E)).map_add (a.form x) (b.form x)
  map_smul' r a := by
    apply b3Rest_SF.ext
    funext x
    exact (b3Forms_starL (E := E)).map_smul r (a.form x)

/-- RiemannRochAna: applying star twice negates a smooth real form. -/
theorem RiemannRochAna_starSF_sq (a : b3Rest_SF E C) :
    RiemannRochAna_starSF (RiemannRochAna_starSF a) = -a :=
  b3Rest_SF.ext (b3Forms_star_star a.form)

/-- RiemannRochAna: a smooth coexact form has a smooth primitive after applying star. -/
theorem RiemannRochAna_coexact_primitive [ConnectedSpace C] (a : b3Rest_SF E C)
    (ha : (a : b3Rest_L2 E C) ∈ b3Rest_Co E C) :
    ∃ g : C → ℝ, ContMDiff 𝓘(ℝ, E) 𝓘(ℝ, ℝ) ∞ g ∧
      b3Forms_d (b3Forms_fun (E := E) g) = b3Forms_star a.form := by
  obtain ⟨θ, g, hg, he⟩ := b3Rest_hodge a.isSmooth.star
    (RiemannRochAna_coexact_star_d_eq_zero a ha)
  let h : b3Rest_SF E C := b3Rest_SF.mk (b3Forms_reForm θ) (b3Forms_isSmooth_reForm θ)
  have he' : RiemannRochAna_starSF a = h + b3Rest_dSF hg := b3Rest_SF.ext he
  have hes := congrArg RiemannRochAna_starSF he'
  rw [RiemannRochAna_starSF_sq, map_add] at hes
  have hstar : (RiemannRochAna_starSF h : b3Rest_L2 E C) =
      RiemannRochAna_holRealL2 ((-Complex.I) • θ) := by
    apply congrArg (fun β : b3Rest_SF E C ↦ (β : b3Rest_L2 E C))
    apply b3Rest_SF.ext
    exact (b3Forms_star_reForm θ).trans (b3Forms_imForm_eq θ)
  have hsd : ((b3Rest_sdSF hg : b3Rest_SF E C) : b3Rest_L2 E C) ∈ b3Rest_Co E C :=
    Submodule.le_topologicalClosure _ (Submodule.subset_span ⟨⟨_, hg⟩, rfl⟩)
  have hh : RiemannRochAna_holRealL2 ((-Complex.I) • θ) ∈ b3Rest_Co E C := by
    rw [← hstar]
    have hh' : RiemannRochAna_starSF h = -a - b3Rest_sdSF hg := by
      change -a = RiemannRochAna_starSF h + b3Rest_sdSF hg at hes
      exact eq_sub_of_add_eq hes.symm
    rw [hh', UniformSpace.Completion.coe_sub, UniformSpace.Completion.coe_neg]
    exact (b3Rest_Co E C).sub_mem ((b3Rest_Co E C).neg_mem ha) hsd
  have hθ : (-Complex.I) • θ = 0 := by
    apply RiemannRochAna_hilbert_quotient_injective
    rw [_root_.map_zero]
    exact (Submodule.Quotient.mk_eq_zero _).mpr (Submodule.mem_sup_right hh)
  have hθ0 : θ = 0 := (smul_eq_zero.mp hθ).resolve_left (neg_ne_zero.mpr Complex.I_ne_zero)
  refine ⟨g, RiemannRochAna_contMDiff_of_smooth_fun hg, ?_⟩
  rw [hθ0, show b3Forms_reForm (0 : b3_HolForm E C) = 0 from rfl, zero_add] at he
  exact he.symm

/-- RiemannRochAna: every smooth real form is harmonic plus exact and coexact smooth differentials. -/
theorem RiemannRochAna_smooth_decomposition [ConnectedSpace C] (a : b3Rest_SF E C) :
    ∃ θ : b3_HolForm E C, ∃ u v : C → ℝ,
      ContMDiff 𝓘(ℝ, E) 𝓘(ℝ, ℝ) ∞ u ∧ ContMDiff 𝓘(ℝ, E) 𝓘(ℝ, ℝ) ∞ v ∧
      a.form = b3Forms_reForm θ + b3Forms_d (b3Forms_fun (E := E) u) -
        b3Forms_star (b3Forms_d (b3Forms_fun (E := E) v)) := by
  obtain ⟨e, he, c, hc, h, hd, hsd, hae⟩ := RiemannRochAna_hilbert_decomposition (a : b3Rest_L2 E C)
  let θ := b3Forms_harmonicHol hE1.out ⟨h.isSmooth, hd, hsd⟩
  have hθ : RiemannRochAna_holRealL2 θ = (h : b3Rest_L2 E C) := by
    apply congrArg (fun t : b3Rest_SF E C ↦ (t : b3Rest_L2 E C))
    exact b3Rest_SF.ext (b3Forms_reForm_harmonicHol hE1.out _)
  have hhEx : (h : b3Rest_L2 E C) ∈ (b3Rest_Ex E C)ᗮ := by
    rw [← hθ]
    exact (RiemannRochAna_range_le_harmonic ⟨θ, rfl⟩).1
  have hcEx : c ∈ (b3Rest_Ex E C)ᗮ := by
    rw [Submodule.mem_orthogonal']
    intro x hx
    rw [real_inner_comm]
    exact b3Rest_Ex_inner_Co hx hc
  have heperp : (a : b3Rest_L2 E C) - e ∈ (b3Rest_Ex E C)ᗮ := by
    have heq : (a : b3Rest_L2 E C) - e = c + h := by rw [hae]; abel
    rw [heq]
    exact (b3Rest_Ex E C)ᗮ.add_mem hcEx hhEx
  obtain ⟨α, hα⟩ := RiemannRochAna_exact_projection_smooth a e he heperp
  have hαe : (α : b3Rest_L2 E C) ∈ b3Rest_Ex E C := hα ▸ he
  obtain ⟨u, hu, hue⟩ := RiemannRochAna_primitive_of_exact α
    (RiemannRochAna_exact_d_eq_zero α hαe) hαe
  let γ : b3Rest_SF E C := a - α - h
  have hγ : (γ : b3Rest_L2 E C) = c := by
    simp only [γ, UniformSpace.Completion.coe_sub, ← hα]
    rw [hae]
    abel
  obtain ⟨v, hv, hve⟩ := RiemannRochAna_coexact_primitive γ (hγ.symm ▸ hc)
  have hγform : b3Forms_star (b3Forms_d (b3Forms_fun (E := E) v)) = -γ.form := by
    rw [hve, b3Forms_star_star]
  refine ⟨θ, u, v, hu, hv, ?_⟩
  have hr : b3Forms_reForm θ = h.form :=
    b3Forms_reForm_harmonicHol hE1.out ⟨h.isSmooth, hd, hsd⟩
  rw [hr, hue, hγform]
  change a.form = h.form + α.form - -(a.form - α.form - h.form)
  abel

/-- RiemannRochAna: the imaginary part of the Dolbeault differential of a real function is minus half its starred differential. -/
theorem RiemannRochAna_dbar_ofReal_im [ConnectedSpace C] (g : C → ℝ)
    (hg : ContMDiff 𝓘(ℝ, E) 𝓘(ℝ, ℝ) ∞ g) (x : C) (v : E) :
    (b4c_dbar E C (fun x ↦ (g x : ℂ)) ⟨x, v⟩).im =
      -(1 / 2 : ℝ) * b3Forms_star (b3Forms_d (b3Forms_fun (E := E) g)) x (fun _ ↦ v) := by
  let u : b4c_SmoothFun E C := ⟨fun x ↦ (g x : ℂ), Complex.ofRealCLM.contMDiff.comp hg⟩
  let β : b4c_Smooth01 E C := ⟨b4c_dbar E C u, b4c_dbar_mem_aux u⟩
  have hi := RiemannRochAna_re01_I β x v
  change (b4c_dbar E C (fun x ↦ (g x : ℂ)) ⟨x, Complex.I • v⟩).re =
    (b4c_dbar E C (fun x ↦ (g x : ℂ)) ⟨x, v⟩).im at hi
  rw [← hi, RiemannRochAna_dbar_ofReal_re g hg, b3Forms_star, b3Forms_starPt_apply]
  ring

set_option backward.isDefEq.respectTransparency false in
/-- RiemannRochAna: every smooth Dolbeault form is a conjugate holomorphic form plus a smooth Dolbeault differential. -/
theorem RiemannRochAna_dolbeault_decomposition [ConnectedSpace C] (β : b4c_Smooth01 E C) :
    ∃ θ : b3_HolForm E C, ∃ u : b4c_SmoothFun E C,
      β.1 = (fun p ↦ star (θ.1 p)) + b4c_dbar E C u := by
  let a : b3Rest_SF E C := b3Rest_SF.mk (RiemannRochAna_re01 β) (RiemannRochAna_re01_smooth β)
  obtain ⟨θ, f, g, hf, hg, he⟩ := RiemannRochAna_smooth_decomposition a
  let uf : b4c_SmoothFun E C := ⟨fun x ↦ (f x : ℂ), Complex.ofRealCLM.contMDiff.comp hf⟩
  let ug : b4c_SmoothFun E C := ⟨fun x ↦ (g x : ℂ), Complex.ofRealCLM.contMDiff.comp hg⟩
  let u : b4c_SmoothFun E C := (2 : ℂ) • uf + (-2 * Complex.I) • ug
  refine ⟨θ, u, ?_⟩
  have hβ : β = RiemannRochAna_conjHol θ +
      (⟨b4c_dbar E C u, b4c_dbar_mem_aux u⟩ : b4c_Smooth01 E C) := by
    apply RiemannRochAna_re01_injective
    ext x v
    have hv : v = fun _ ↦ v 0 := funext fun i ↦ by fin_cases i; rfl
    rw [hv]
    have hx := congrArg (fun α : C → E [⋀^Fin 1]→L[ℝ] ℝ ↦ α x (fun _ ↦ v 0)) he
    change (β.1 ⟨x, v 0⟩).re = (star (θ.1 ⟨x, v 0⟩) + b4c_dbar E C u ⟨x, v 0⟩).re
    rw [Complex.add_re]
    change (β.1 ⟨x, v 0⟩).re = (θ.1 ⟨x, v 0⟩).re + _
    dsimp only [u]
    simp only [Submodule.coe_add, Submodule.coe_smul]
    erw [RiemannRochAna_dbar_add ((2 : ℂ) • uf) ((-2 * Complex.I) • ug),
      RiemannRochAna_dbar_smul (2 : ℂ) uf, RiemannRochAna_dbar_smul (-2 * Complex.I) ug]
    change (β.1 ⟨x, v 0⟩).re = (θ.1 ⟨x, v 0⟩).re +
      ((2 : ℂ) * b4c_dbar E C (fun x ↦ (f x : ℂ)) ⟨x, v 0⟩ +
        (-2 * Complex.I) * b4c_dbar E C (fun x ↦ (g x : ℂ)) ⟨x, v 0⟩).re
    simp only [Complex.add_re, Complex.mul_re, Complex.mul_im, Complex.neg_re, Complex.neg_im,
      show (2 : ℂ).re = 2 from rfl, show (2 : ℂ).im = 0 from rfl,
      Complex.I_re, Complex.I_im, mul_zero, zero_mul,
      sub_zero, zero_sub, neg_zero, mul_one, neg_mul, neg_neg]
    rw [RiemannRochAna_dbar_ofReal_re f hf, RiemannRochAna_dbar_ofReal_im g hg]
    change (β.1 ⟨x, v 0⟩).re = (θ.1 ⟨x, v 0⟩).re +
      b3Forms_d (b3Forms_fun (E := E) f) x (fun _ ↦ v 0) -
      b3Forms_star (b3Forms_d (b3Forms_fun (E := E) g)) x (fun _ ↦ v 0) at hx
    linarith
  exact congrArg Subtype.val hβ

/-- RiemannRochAna: conjugate holomorphic forms represent every smooth Dolbeault class. -/
theorem RiemannRochAna_holDolbeault_surjective [ConnectedSpace C] :
    Function.Surjective (RiemannRochAna_holDolbeault (E := E) (C := C)) := by
  intro q
  let P := (Submodule.span ℂ (b4c_dbar E C '' (b4c_SmoothFun E C : Set (C → ℂ)))).comap
    (b4c_Smooth01 E C).subtype
  obtain ⟨β, rfl⟩ := P.mkQ_surjective q
  obtain ⟨θ, u, he⟩ := RiemannRochAna_dolbeault_decomposition β
  refine ⟨θ, ?_⟩
  have hβ : β = RiemannRochAna_conjHol θ +
      (⟨b4c_dbar E C u, b4c_dbar_mem_aux u⟩ : b4c_Smooth01 E C) := Subtype.ext he
  change P.mkQ (RiemannRochAna_conjHol θ) = P.mkQ β
  rw [hβ, map_add]
  have hzero : P.mkQ ⟨b4c_dbar E C u, b4c_dbar_mem_aux u⟩ = 0 := by
    apply (Submodule.Quotient.mk_eq_zero _).mpr
    exact Submodule.subset_span ⟨u, u.property, rfl⟩
  rw [hzero, add_zero]

end RiemannRochAnaGlue

theorem b4c_dolbeault_finite_aux [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) : Module.Finite ℂ (b4c_Dolbeault01 E C) ∧
      Module.finrank ℂ (b4c_Dolbeault01 E C) = Module.finrank ℂ (b3_HolForm E C) := by
  letI : FiniteDimensional ℂ E := Module.finite_of_finrank_pos (by omega)
  letI : MeasurableSpace E := borel E
  letI : BorelSpace E := ⟨rfl⟩
  letI : Fact (Module.finrank ℂ E = 1) := ⟨hE⟩
  let e := LinearEquiv.ofBijective (RiemannRochAna_holDolbeault (E := E) (C := C))
    ⟨RiemannRochAna_holDolbeault_injective hE, RiemannRochAna_holDolbeault_surjective⟩
  letI := b3Forms_holForm_finiteDimensional_real (C := C) hE
  letI : Module.Finite ℝ (b4c_Dolbeault01 E C) := e.finiteDimensional
  refine ⟨Module.Finite.of_restrictScalars_finite ℝ ℂ _, ?_⟩
  have hh := Module.finrank_mul_finrank ℝ ℂ (b3_HolForm E C)
  have hd := Module.finrank_mul_finrank ℝ ℂ (b4c_Dolbeault01 E C)
  have he := e.finrank_eq
  simp only [Complex.finrank_real_complex] at hh hd
  omega

