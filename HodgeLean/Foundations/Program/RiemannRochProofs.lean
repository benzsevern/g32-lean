/-- RiemannRochAna: the reciprocal affine coordinate defines a holomorphic sphere-valued map at its pole. -/
theorem RiemannRochAna_inverse_coe_holomorphic :
    ContMDiff 𝓘(ℂ, ℂ) 𝓘(ℂ, ℂ) ω
      (fun z : ℂ ↦ b4cov_sphInv (z : OnePoint ℂ)) := by
  have ht : b4cov_chartInf.target = Set.univ := by
    ext z
    simp only [b4cov_chartInf, OpenPartialHomeomorph.trans_target,
      Homeomorph.toOpenPartialHomeomorph_target, Set.preimage_univ, Set.inter_univ,
      b4cov_chart0_target, Set.mem_univ]
  have h := contMDiffOn_chart_symm (I := 𝓘(ℂ, ℂ)) (n := ω)
    (x := (OnePoint.infty : OnePoint ℂ))
  rw [b4cov_chartAt_infty, ht] at h
  have he : (fun z : ℂ ↦ b4cov_sphInv (z : OnePoint ℂ)) = b4cov_chartInf.symm :=
    funext fun z ↦ (b4cov_chartInf_symm z).symm
  rw [he]
  exact contMDiffOn_univ.mp h

#print axioms RiemannRochAna_inverse_coe_holomorphic

/-- RiemannRochAna: a nonzero simple principal part minus an analytic function extends holomorphically to the sphere. -/
theorem RiemannRochAna_simple_pole_extension {a : ℂ} (ha : a ≠ 0)
    {u : ℂ → ℂ} (hu : AnalyticAt ℂ u 0) :
    ∃ F : ℂ → OnePoint ℂ, ContMDiffAt 𝓘(ℂ, ℂ) 𝓘(ℂ, ℂ) ω F 0 ∧
      F 0 = OnePoint.infty ∧ ∀ᶠ z in 𝓝[≠] (0 : ℂ),
        F z = ((a / z - u z : ℂ) : OnePoint ℂ) := by
  let d : ℂ → ℂ := fun z ↦ a - z * u z
  have hd : AnalyticAt ℂ d 0 := analyticAt_const.sub (analyticAt_id.mul hu)
  have hd0 : d 0 ≠ 0 := by simpa [d] using ha
  have hq : AnalyticAt ℂ (fun z ↦ z / d z) 0 := analyticAt_id.div hd hd0
  refine ⟨fun z ↦ b4cov_sphInv ((z / d z : ℂ) : OnePoint ℂ), ?_, ?_, ?_⟩
  · exact RiemannRochAna_inverse_coe_holomorphic.contMDiffAt.comp 0
      hq.contDiffAt.contMDiffAt
  · simp
  · filter_upwards [nhdsWithin_le_nhds (hd.continuousAt.eventually_ne hd0),
      self_mem_nhdsWithin] with z hdz hz
    have hz0 : z ≠ 0 := hz
    rw [b4cov_sphInv_coe (div_ne_zero hz0 hdz)]
    congr 1
    dsimp only [d]
    field_simp

