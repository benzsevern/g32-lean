section
set_option backward.isDefEq.respectTransparency false

/-- RiemannRochAna: a simple pole with analytic regular part extends to a sphere-valued analytic germ on the surface. -/
theorem RiemannRochAna_surface_simple_pole_extension
    (hE : Module.finrank ℂ E = 1) (x : C) {a : ℂ} (ha : a ≠ 0)
    (u : C → ℂ) (hu : ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω u x) :
    ∃ F : C → OnePoint ℂ, ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω F x ∧
      F x = OnePoint.infty ∧ ∀ᶠ y in 𝓝[≠] x,
        F y = ((a / RiemannRochAna_coordinate hE x y - u y : ℂ) : OnePoint ℂ) := by
  let z := RiemannRochAna_coordinate hE x
  let d : C → ℂ := fun y ↦ a - z y * u y
  have hz : ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω z x :=
    RiemannRochAna_coordinate_analytic hE x x (mem_extChartAt_source x)
  have hd : ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω d x :=
    contMDiffAt_const.sub (hz.mul hu)
  have hd0 : d x ≠ 0 := by
    simpa only [d, z, RiemannRochAna_coordinate_self, zero_mul, sub_zero] using ha
  have hi : ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω (fun y ↦ (d y)⁻¹) x :=
    (contDiffAt_inv (𝕜 := ℂ) hd0).contMDiffAt.comp x hd
  refine ⟨fun y ↦ b4cov_sphInv (((z y / d y : ℂ)) : OnePoint ℂ), ?_, ?_, ?_⟩
  · exact RiemannRochAna_inverse_coe_holomorphic.contMDiffAt.comp x (hz.mul hi)
  · simp only [z, RiemannRochAna_coordinate_self, zero_div, b4cov_sphInv_zero]
  · have hsrc : (extChartAt 𝓘(ℂ, E) x).source ∈ 𝓝 x := by
      rw [extChartAt_source]
      exact (chartAt E x).open_source.mem_nhds (mem_chart_source E x)
    filter_upwards [nhdsWithin_le_nhds (hd.continuousAt.eventually_ne hd0),
      nhdsWithin_le_nhds hsrc, self_mem_nhdsWithin] with y hdy hys hy
    have hzy : z y ≠ 0 := RiemannRochAna_coordinate_ne hE x y hys hy
    rw [b4cov_sphInv_coe (div_ne_zero hzy hdy)]
    congr 1
    change (z y / (a - z y * u y))⁻¹ = a / z y - u y
    field_simp

/-- RiemannRochAna: near a marked point the nonzero-pole predicate tests only that point. -/
theorem RiemannRochAna_pole_test_germ [T2Space C] {ι : Type} [Finite ι]
    (p : ι → C) (hp : Function.Injective p) (c : ι → ℂ) (j : ι) :
    ∀ᶠ y in 𝓝 (p j), (∃ i, p i = y ∧ c i ≠ 0) ↔ (y = p j ∧ c j ≠ 0) := by
  have hc : IsClosed (p '' {i | i ≠ j}) := ((Set.toFinite _).image p).isClosed
  have hn : p j ∈ (p '' {i | i ≠ j})ᶜ := by
    rintro ⟨i, hi, he⟩
    exact hi (hp he)
  filter_upwards [hc.isOpen_compl.mem_nhds hn] with y hy
  constructor
  · rintro ⟨i, hi, hci⟩
    have hij : i = j := by
      by_contra hn
      exact hy ⟨i, hn, hi⟩
    subst i
    exact ⟨hi.symm, hci⟩
  · rintro ⟨rfl, hcj⟩
    exact ⟨j, rfl, hcj⟩

/-- RiemannRochAna: a finite collection of simple-pole germs extends to a global sphere-valued holomorphic map. -/
theorem RiemannRochAna_sphere_extension [T2Space C]
    (hE : Module.finrank ℂ E = 1) {ι : Type} [Fintype ι]
    (p : ι → C) (hp : Function.Injective p) (c : ι → ℂ) (A : C → ℂ)
    (hA : ∀ y, y ∉ Set.range p → ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω A y)
    (hloc : ∀ j, ∃ u : C → ℂ, ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω u (p j) ∧
      A =ᶠ[𝓝 (p j)] fun y ↦ c j / RiemannRochAna_coordinate hE (p j) y - u y) :
    ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω
      (fun y ↦ if ∃ i, p i = y ∧ c i ≠ 0 then OnePoint.infty else (A y : OnePoint ℂ)) := by
  classical
  intro x
  by_cases hx : x ∈ Set.range p
  · obtain ⟨j, rfl⟩ := hx
    obtain ⟨u, hu, hAu⟩ := hloc j
    have htest := RiemannRochAna_pole_test_germ p hp c j
    by_cases hc : c j = 0
    · apply (b4cov_coe_contMDiff.contMDiffAt.comp (p j) hu.neg).congr_of_eventuallyEq
      filter_upwards [htest, hAu] with y hy hAy
      have hn : ¬ ∃ i, p i = y ∧ c i ≠ 0 := fun h ↦ (hy.mp h).2 hc
      rw [if_neg hn, hAy, hc, zero_div, zero_sub]
      rfl
    · obtain ⟨F, hF, hFx, hFg⟩ := RiemannRochAna_surface_simple_pole_extension hE (p j) hc u hu
      apply hF.congr_of_eventuallyEq
      have hFg' : ∀ᶠ y in 𝓝 (p j), y ≠ p j →
          F y = ((c j / RiemannRochAna_coordinate hE (p j) y - u y : ℂ) : OnePoint ℂ) :=
        eventually_nhdsWithin_iff.mp hFg
      filter_upwards [htest, hAu, hFg'] with y hy hAy hFy
      by_cases hyj : y = p j
      · subst y
        rw [if_pos (hy.mpr ⟨rfl, hc⟩), hFx]
      · rw [if_neg (fun h ↦ hyj (hy.mp h).1), hAy, hFy hyj]
  · apply (b4cov_coe_contMDiff.contMDiffAt.comp x (hA x hx)).congr_of_eventuallyEq
    filter_upwards [(Set.finite_range p).isClosed.isOpen_compl.mem_nhds hx] with y hy
    rw [if_neg (fun h ↦ hy ⟨h.choose, h.choose_spec.1⟩)]
    rfl

/-- RiemannRochAna: a one-dimensional complex manifold has points outside any finite marked set. -/
theorem RiemannRochAna_exists_unmarked (hE : Module.finrank ℂ E = 1)
    (x : C) {ι : Type} [Finite ι] (p : ι → C) : ∃ y : C, y ∉ Set.range p := by
  letI : Nontrivial E := Module.nontrivial_of_finrank_eq_succ hE
  let e := chartAt E x
  have hi : e.target.Infinite := infinite_of_mem_nhds (e x)
    (e.open_target.mem_nhds (mem_chart_target E x))
  obtain ⟨z, hz, hzp⟩ := hi.exists_notMem_finite ((Set.finite_range p).image e)
  refine ⟨e.symm z, ?_⟩
  rintro ⟨i, he⟩
  apply hzp
  refine ⟨p i, ⟨i, rfl⟩, ?_⟩
  rw [he, e.right_inv hz]

/-- RiemannRochAna: the Dolbeault obstruction relation supplies a nonconstant meromorphic function with poles among the marked points. -/
theorem RiemannRochAna_exists_meroFun_supported [T2Space C] [CompactSpace C]
    [ConnectedSpace C] (hE : Module.finrank ℂ E = 1)
    (p : Fin (Module.finrank ℂ (b3_HolForm E C) + 1) → C) (hp : Function.Injective p) :
    ∃ f : b4c_MeroFun E C, (∃ x y, f x ≠ f y) ∧
      ∀ y, y ∉ Set.range p → f y ≠ OnePoint.infty := by
  obtain ⟨χ, hχ, c, ⟨j, hcj⟩, u, hu⟩ := RiemannRochAna_principal_obstruction_relation hE p hp
  let A : C → ℂ := fun z ↦ (∑ i, c i * ((χ i z : ℂ) /
    RiemannRochAna_coordinate hE (p i) z)) - (u : C → ℂ) z
  let f : C → OnePoint ℂ := fun y ↦
    if ∃ i, p i = y ∧ c i ≠ 0 then OnePoint.infty else (A y : OnePoint ℂ)
  have hf : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω f := by
    have hh := RiemannRochAna_sphere_extension hE p hp c A
    apply ContMDiff.congr (hh ?_ ?_)
    · intro y
      dsimp only [f]
      split_ifs <;> rfl
    · intro y hy
      exact RiemannRochAna_corrected_principal_analytic hE p χ
        (fun i ↦ ⟨(hχ i).1, (hχ i).2.2.1⟩) c u hu y hy
    · intro k
      refine ⟨u, RiemannRochAna_potential_analytic_at_poles hE p χ
        (fun i ↦ ⟨(hχ i).2.1, (hχ i).2.2.2⟩) c u hu k, ?_⟩
      exact RiemannRochAna_corrected_principal_germ hE p χ
        (fun i ↦ ⟨(hχ i).2.1, (hχ i).2.2.2⟩) c u k
  have hout (y : C) (hy : y ∉ Set.range p) : f y ≠ OnePoint.infty := by
    have hn : ¬ ∃ i, p i = y ∧ c i ≠ 0 := by
      rintro ⟨i, hi, _⟩
      exact hy ⟨i, hi⟩
    simp only [f, if_neg hn]
    exact OnePoint.coe_ne_infty _
  obtain ⟨y, hy⟩ := RiemannRochAna_exists_unmarked hE (p j) p
  have hj : f (p j) = OnePoint.infty := if_pos ⟨j, rfl, hcj⟩
  refine ⟨⟨f, hf, y, hout y hy⟩, ⟨p j, y, ?_⟩, hout⟩
  change f (p j) ≠ f y
  rw [hj]
  exact (hout y hy).symm


