section RiemannRochAnaMeromorphicDifferential
set_option backward.isDefEq.respectTransparency false

/-- RiemannRochAna: the affine sphere differential is linear in each tangent fibre. -/
theorem RiemannRochAna_sphere_differential_linear :
    HurwitzPrymRR_IsLinear b4c_dz_sphere := by
  intro x a v w
  dsimp only [b4c_dz_sphere]
  split_ifs <;> simp_all [smul_eq_mul]

/-- RiemannRochAna: the affine coefficient of the sphere differential is constant. -/
theorem RiemannRochAna_sphere_differential_affine (z t v : ℂ) :
    b4cov_coef b4c_dz_sphere (z : OnePoint ℂ) v t = v := by
  have ht : (t : OnePoint ℂ) ∈
      (extChartAt 𝓘(ℂ, ℂ) (z : OnePoint ℂ)).source := by
    rw [extChartAt_source, b4cov_chartAt_coe]
    rw [b4cov_chart0_source]
    exact ⟨t, rfl⟩
  have hv := b4cov_triv_vec (z : OnePoint ℂ) (t : OnePoint ℂ) ht v
  rw [TangentBundle.trivializationAt_apply] at hv
  simp only [b4cov_chartAt_coe, modelWithCornersSelf_coe, range_id,
    fderivWithin_univ] at hv
  have hid : ⇑(b4cov_chart0.extend 𝓘(ℂ, ℂ)) ∘
      ⇑(b4cov_chart0.extend 𝓘(ℂ, ℂ)).symm = id := by
    funext w
    simp [b4cov_chart0_symm, b4cov_chart0_coe]
  rw [hid, fderiv_id] at hv
  unfold b4cov_coef
  rw [extChartAt_coe_symm, b4cov_chartAt_coe]
  simp only [Function.comp_apply, modelWithCornersSelf_coe_symm, id_eq, b4cov_chart0_symm]
  change b4c_dz_sphere ⟨b4cov_chart0.symm t, b4cov_vec (z : OnePoint ℂ) (b4cov_chart0.symm t) v⟩ = v
  rw [b4cov_chart0_symm]
  simpa [b4c_dz_sphere] using hv

#print axioms RiemannRochAna_sphere_differential_linear
#print axioms RiemannRochAna_sphere_differential_affine

/-- RiemannRochAna: the reciprocal-chart coefficient of the sphere differential has a double pole. -/
theorem RiemannRochAna_sphere_differential_reciprocal (t v : ℂ) (ht : t ≠ 0) :
    b4cov_coef b4c_dz_sphere OnePoint.infty v t = -(t⁻¹)^2 * v := by
  have hpt : b4cov_chartInf.symm t = (t⁻¹ : ℂ) := by
    rw [b4cov_chartInf_symm, b4cov_sphInv_coe ht]
  have hs : ((t⁻¹ : ℂ) : OnePoint ℂ) ∈
      (extChartAt 𝓘(ℂ, ℂ) OnePoint.infty).source := by
    rw [extChartAt_source, b4cov_chartAt_infty]
    rw [← hpt]
    exact b4cov_chartInf_symm_mem t
  have hv := b4cov_triv_vec OnePoint.infty ((t⁻¹ : ℂ) : OnePoint ℂ) hs v
  rw [TangentBundle.trivializationAt_apply] at hv
  simp only [b4cov_chartAt_coe, b4cov_chartAt_infty, modelWithCornersSelf_coe,
    range_id, fderivWithin_univ] at hv
  have hF : (⇑(b4cov_chartInf.extend 𝓘(ℂ, ℂ)) ∘
      ⇑(b4cov_chart0.extend 𝓘(ℂ, ℂ)).symm) =ᶠ[𝓝 t⁻¹] fun u ↦ u⁻¹ := by
    filter_upwards [isOpen_ne.mem_nhds (inv_ne_zero ht)] with u hu
    simp only [Function.comp_apply, OpenPartialHomeomorph.extend_coe,
      OpenPartialHomeomorph.extend_coe_symm, modelWithCornersSelf_coe,
      modelWithCornersSelf_coe_symm, Function.id_comp, Function.comp_id,
      b4cov_chart0_symm, b4cov_chartInf_apply, b4cov_chart0_sphInv hu]
  have hz : (b4cov_chart0.extend 𝓘(ℂ, ℂ)) ((t⁻¹ : ℂ) : OnePoint ℂ) = t⁻¹ := by
    simp [b4cov_chart0_coe]
  rw [hz, hF.fderiv_eq, fderiv_inv] at hv
  change (show ℂ from b4cov_vec OnePoint.infty ((t⁻¹ : ℂ) : OnePoint ℂ) v) * -((t⁻¹)^2)⁻¹ = v at hv
  have he : (show ℂ from b4cov_vec OnePoint.infty ((t⁻¹ : ℂ) : OnePoint ℂ) v) = -(t⁻¹)^2 * v := by
    calc
      _ = ((show ℂ from b4cov_vec OnePoint.infty ((t⁻¹ : ℂ) : OnePoint ℂ) v) *
          -((t⁻¹)^2)⁻¹) * (-(t⁻¹)^2) := by field_simp
      _ = _ := by rw [hv]; ring
  unfold b4cov_coef
  rw [extChartAt_coe_symm, b4cov_chartAt_infty]
  simp only [Function.comp_apply, modelWithCornersSelf_coe_symm, id_eq, hpt]
  change b4c_dz_sphere ⟨b4cov_chartInf.symm t, b4cov_vec OnePoint.infty (b4cov_chartInf.symm t) v⟩ = _
  rw [hpt]
  simpa [b4c_dz_sphere] using he

#print axioms RiemannRochAna_sphere_differential_reciprocal

/-- RiemannRochAna: in a centred affine coordinate the sphere differential has nonzero constant coefficient. -/
theorem RiemannRochAna_sphere_differential_loc_finite (z : ℂ) :
    HurwitzPrymRR_loc (by simp) b4c_dz_sphere (z : OnePoint ℂ) =
      fun _ ↦ b4cov_lineEquiv (show Module.finrank ℂ ℂ = 1 by simp) 1 := by
  funext t
  exact RiemannRochAna_sphere_differential_affine z _ _

/-- RiemannRochAna: the affine sphere differential has meromorphic coefficients in both charts. -/
theorem RiemannRochAna_sphere_differential_meromorphic (x : OnePoint ℂ) :
    MeromorphicAt (HurwitzPrymRR_loc (by simp) b4c_dz_sphere x) 0 := by
  induction x using OnePoint.rec with
  | coe z =>
    rw [RiemannRochAna_sphere_differential_loc_finite]
    exact analyticAt_const.meromorphicAt
  | infty =>
    let L := b4cov_lineEquiv (show Module.finrank ℂ ℂ = 1 by simp)
    have hm : MeromorphicAt (fun t : ℂ ↦ -((L t)⁻¹)^2 * L 1) 0 :=
      (((L.analyticAt 0).meromorphicAt.inv.pow 2).neg).mul analyticAt_const.meromorphicAt
    apply hm.congr
    filter_upwards [self_mem_nhdsWithin] with t ht
    have ht0 : t ≠ 0 := ht
    have hLt : L t ≠ 0 := L.map_ne_zero_iff.mpr ht0
    have hzero : extChartAt 𝓘(ℂ, ℂ) (OnePoint.infty : OnePoint ℂ) OnePoint.infty = 0 := by
      change b4cov_chartInf OnePoint.infty = 0
      rw [b4cov_chartInf_apply, b4cov_sphInv_infty, b4cov_chart0_coe]
    simp only [HurwitzPrymRR_loc, hzero, zero_add]
    exact (RiemannRochAna_sphere_differential_reciprocal (L t) (L 1) hLt).symm

#print axioms RiemannRochAna_sphere_differential_meromorphic

/-- RiemannRochAna: the local pullback formula preserves meromorphic coefficients. -/
theorem RiemannRochAna_pullback_meromorphic
    (hE : Module.finrank ℂ E = 1) {E' Y : Type} [NormedAddCommGroup E'] [NormedSpace ℂ E']
    [TopologicalSpace Y] [ChartedSpace E' Y] [IsManifold 𝓘(ℂ, E') ω Y]
    (hE' : Module.finrank ℂ E' = 1) (f : C → Y)
    (hf : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E') ω f)
    (θ : TangentBundle 𝓘(ℂ, E') Y → ℂ) (hθ : b4c_IsMeroForm hE' θ) (x : C) :
    MeromorphicAt (HurwitzPrymRR_loc hE (b3_pullback E E' f θ) x) 0 := by
  letI : FiniteDimensional ℂ E' := Module.finite_of_finrank_eq_succ hE'
  letI : CompleteSpace E' := FiniteDimensional.complete ℂ E'
  let T := b4cov_transport hE hE' (b4cov_expr E E' f x (f x))
    (extChartAt 𝓘(ℂ, E) x x)
  have hG := b4cov_analyticAt_chart f hf x (f x)
    (extChartAt 𝓘(ℂ, E) x x) (mem_extChartAt_target x) (by
      rw [extChartAt_to_inv]; exact mem_extChartAt_source (f x))
  have hT : AnalyticAt ℂ T 0 := b4cov_transport_analyticAt hE hE' hG
  have hT0 : T 0 = 0 := b4cov_transport_zero hE hE' _ _
  have hm : MeromorphicAt (HurwitzPrymRR_loc hE' θ (f x)) (T 0) := by
    rw [hT0]; exact hθ.2 (f x)
  have hp := (hm.comp_analyticAt hT).mul hT.deriv.meromorphicAt
  apply hp.congr
  have he := HurwitzPrymRR_loc_pullback hE hE' f hf x (f x)
    (mem_extChartAt_source (f x)) θ hθ.1
  filter_upwards [he.filter_mono nhdsWithin_le_nhds] with t ht
  simpa only [T, Pi.mul_apply, Function.comp_apply, sub_self, map_zero, zero_add] using ht.symm

#print axioms RiemannRochAna_pullback_meromorphic

/-- RiemannRochAna: a nonconstant sphere map pulls the affine differential back to a form with a nonzero germ. -/
theorem RiemannRochAna_pullback_sphere_differential [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (f : C → OnePoint ℂ)
    (hf : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω f) (hnc : ∃ x y, f x ≠ f y) :
    ∃ w : b4c_MeroForm E C hE,
      (w : TangentBundle 𝓘(ℂ, E) C → ℂ) ≠ 0 ∧
      ∃ x, meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 ≠ ⊤ := by
  let θ := b3_pullback E ℂ f b4c_dz_sphere
  have hθ : b4c_IsMeroForm hE θ := by
    refine ⟨?_, RiemannRochAna_pullback_meromorphic hE (by simp) f hf _
      ⟨RiemannRochAna_sphere_differential_linear,
        RiemannRochAna_sphere_differential_meromorphic⟩⟩
    intro x a v w
    change b4c_dz_sphere ⟨f x, (mfderiv 𝓘(ℂ, E) 𝓘(ℂ, ℂ) f x) (a • v + w)⟩ = _
    rw [map_add, map_smul]
    exact RiemannRochAna_sphere_differential_linear (f x) a _ _
  obtain ⟨x, hx⟩ := b4cov_surjective (by simp : Module.finrank ℂ ℂ = 1) f hf hnc (0 : ℂ)
  have ho := HurwitzPrymRR_ord_pullback hE (by simp) f hf hnc x b4c_dz_sphere
    RiemannRochAna_sphere_differential_linear
    (RiemannRochAna_sphere_differential_meromorphic (f x))
  have hL : b4cov_lineEquiv (show Module.finrank ℂ ℂ = 1 by simp) 1 ≠ 0 :=
    (b4cov_lineEquiv _).map_ne_zero_iff.mpr one_ne_zero
  rw [hx, RiemannRochAna_sphere_differential_loc_finite,
    meromorphicOrderAt_const, if_neg hL, zero_mul, zero_add] at ho
  have horder : meromorphicOrderAt (HurwitzPrymRR_loc hE θ x) 0 ≠ ⊤ := by
    rw [ho]
    exact WithTop.coe_ne_top
  refine ⟨⟨θ, hθ⟩, ?_, x, horder⟩
  intro he
  change θ = 0 at he
  apply horder
  rw [he]
  change meromorphicOrderAt (fun _ : ℂ ↦ (0 : ℂ)) 0 = ⊤
  rw [meromorphicOrderAt_const, if_pos rfl]

theorem b4c_exists_meroForm_aux [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) : ∃ w : b4c_MeroForm E C hE,
      (w : TangentBundle 𝓘(ℂ, E) C → ℂ) ≠ 0 ∧
      ∃ x, meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 ≠ ⊤ := by
  haveI : Infinite C := not_finite_iff_infinite.mp (by
    intro h
    letI := h
    obtain ⟨y, hy⟩ := RiemannRochAna_exists_unmarked hE (Classical.arbitrary C) (id : C → C)
    exact hy ⟨y, rfl⟩)
  let p : Fin (Module.finrank ℂ (b3_HolForm E C) + 1) ↪ C :=
    ⟨fun i ↦ Infinite.natEmbedding C i.val,
      (Infinite.natEmbedding C).injective.comp Fin.val_injective⟩
  obtain ⟨f, hnc, _⟩ := b4c_exists_meroFun_aux hE p p.injective
  exact RiemannRochAna_pullback_sphere_differential hE f f.property.1 hnc

#print axioms RiemannRochAna_pullback_sphere_differential
#print axioms b4c_exists_meroForm_aux

/-- RiemannRochAna: every scalar meromorphic germ has an analytic sphere-valued extension. -/
theorem RiemannRochAna_meromorphic_germ_sphere_extension {f : ℂ → ℂ} {x : ℂ}
    (hf : MeromorphicAt f x) :
    ∃ F : ℂ → OnePoint ℂ, ContMDiffAt 𝓘(ℂ, ℂ) 𝓘(ℂ, ℂ) ω F x ∧
      ∀ᶠ z in 𝓝[≠] x, F z = ((f z : ℂ) : OnePoint ℂ) := by
  by_cases ho : 0 ≤ meromorphicOrderAt f x
  · obtain ⟨g, hg, hfg⟩ := hf.meromorphicOrderAt_nonneg_iff.mp ho
    refine ⟨fun z ↦ (g z : OnePoint ℂ),
      b4cov_coe_contMDiff.contMDiffAt.comp x hg.contDiffAt.contMDiffAt, ?_⟩
    filter_upwards [hfg] with z hz
    rw [hz]
  · have hneg : meromorphicOrderAt f x < 0 := lt_of_not_ge ho
    obtain ⟨n, hn⟩ := WithTop.ne_top_iff_exists.mp hneg.ne_top
    have hnneg : n < 0 := by exact_mod_cast (hn ▸ hneg)
    have hinv : 0 ≤ meromorphicOrderAt f⁻¹ x := by
      rw [meromorphicOrderAt_inv, ← hn]
      exact_mod_cast neg_nonneg.mpr hnneg.le
    obtain ⟨g, hg, hfg⟩ := hf.inv.meromorphicOrderAt_nonneg_iff.mp hinv
    refine ⟨fun z ↦ b4cov_sphInv (g z : OnePoint ℂ),
      RiemannRochAna_inverse_coe_holomorphic.contMDiffAt.comp x hg.contDiffAt.contMDiffAt, ?_⟩
    have hne := (meromorphicOrderAt_ne_top_iff_eventually_ne_zero hf).mp hneg.ne_top
    filter_upwards [hfg, hne] with z hz hzf
    have hgz : g z = (f z)⁻¹ := hz.symm
    rw [hgz, b4cov_sphInv_coe (inv_ne_zero hzf), inv_inv]

#print axioms RiemannRochAna_meromorphic_germ_sphere_extension

/-- RiemannRochAna: punctured neighbourhoods on a complex curve are nonempty filters. -/
theorem RiemannRochAna_punctured_neBot (hE : Module.finrank ℂ E = 1) (x : C) :
    (𝓝[≠] x).NeBot := by
  letI : Nontrivial E := Module.nontrivial_of_finrank_eq_succ hE
  let e := chartAt E x
  have hx : x ∈ e.source := mem_chart_source E x
  have hc : Tendsto e.symm (𝓝 (e x)) (𝓝 x) := by
    simpa only [e.left_inv hx] using (e.symm.continuousAt (e.map_source hx)).tendsto
  have hn : ∀ᶠ z in 𝓝[≠] (e x), e.symm z ≠ x := by
    filter_upwards [nhdsWithin_le_nhds (e.open_target.mem_nhds (e.map_source hx)),
      self_mem_nhdsWithin] with z hz hzx
    intro he
    have hzx' : z ≠ e x := hzx
    apply hzx'
    rw [← e.right_inv hz, he]
  have ht : Tendsto e.symm (𝓝[≠] (e x)) (𝓝[≠] x) :=
    tendsto_nhdsWithin_iff.mpr ⟨hc.mono_left nhdsWithin_le_nhds, hn⟩
  exact ht.neBot

/-- RiemannRochAna: analytic extensions of compatible punctured germs agree near their centres. -/
theorem RiemannRochAna_glue_punctured_germs [T1Space C]
    [∀ x : C, (𝓝[≠] x).NeBot] (f : C → OnePoint ℂ) (F : C → C → OnePoint ℂ)
    (hF : ∀ x, ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω (F x) x)
    (hfg : ∀ x, F x =ᶠ[𝓝[≠] x] f) :
    ∀ x, (fun y ↦ F y y) =ᶠ[𝓝 x] F x := by
  intro x
  have he : ∀ᶠ z in 𝓝 x, z ≠ x → F x z = f z := by
    simpa only [Filter.EventuallyEq, eventually_nhdsWithin_iff, mem_compl_iff, mem_singleton_iff] using hfg x
  have ha := (contMDiffAt_iff_contMDiffAt_nhds (by simp)).mp (hF x)
  filter_upwards [he.eventually_nhds, ha] with y hy hya
  by_cases hyx : y = x
  · subst y; rfl
  have hxy : F x =ᶠ[𝓝 y] f := by
    filter_upwards [hy, eventually_ne_nhds hyx] with z hz hzx
    exact hz hzx
  have hsame : F y =ᶠ[𝓝[≠] y] F x :=
    (hfg y).trans (hxy.filter_mono nhdsWithin_le_nhds).symm
  exact ((hF y).continuousAt.eventuallyEq_nhds_iff_eventuallyEq_nhdsNE
    hya.continuousAt).mp hsame |>.self_of_nhds

/-- RiemannRochAna: compatible analytic punctured extensions define a global analytic map. -/
theorem RiemannRochAna_analytic_of_punctured_extensions [T1Space C]
    [∀ x : C, (𝓝[≠] x).NeBot] (f : C → OnePoint ℂ)
    (h : ∀ x, ∃ F : C → OnePoint ℂ,
      ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω F x ∧ F =ᶠ[𝓝[≠] x] f) :
    ∃ F : C → OnePoint ℂ, ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω F ∧
      ∀ x, F =ᶠ[𝓝[≠] x] f := by
  choose F hF hg using h
  have he := RiemannRochAna_glue_punctured_germs f F hF hg
  refine ⟨fun x ↦ F x x, fun x ↦ (hF x).congr_of_eventuallyEq (he x), ?_⟩
  intro x
  exact ((he x).filter_mono nhdsWithin_le_nhds).trans (hg x)

/-- RiemannRochAna: a scalar meromorphic germ in a centred surface chart extends to the sphere. -/
theorem RiemannRochAna_surface_meromorphic_extension
    (hE : Module.finrank ℂ E = 1) (f : C → ℂ) (x : C)
    (hf : MeromorphicAt (fun t : ℂ ↦ f ((extChartAt 𝓘(ℂ, E) x).symm
      (extChartAt 𝓘(ℂ, E) x x + b4cov_lineEquiv hE t))) 0) :
    ∃ F : C → OnePoint ℂ, ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω F x ∧
      ∀ᶠ y in 𝓝[≠] x, F y = ((f y : ℂ) : OnePoint ℂ) := by
  obtain ⟨F, hF, hfg⟩ := RiemannRochAna_meromorphic_germ_sphere_extension hf
  let z := RiemannRochAna_coordinate hE x
  have hz : ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω z x :=
    RiemannRochAna_coordinate_analytic hE x x (mem_extChartAt_source x)
  have hz0 : z x = 0 := RiemannRochAna_coordinate_self hE x
  have hs : ∀ᶠ y in 𝓝 x, y ∈ (extChartAt 𝓘(ℂ, E) x).source :=
    (isOpen_extChartAt_source x).mem_nhds (mem_extChartAt_source x)
  have ht : Tendsto z (𝓝[≠] x) (𝓝[≠] (0 : ℂ)) := by
    refine tendsto_nhdsWithin_iff.mpr ⟨?_, ?_⟩
    · simpa only [hz0] using hz.continuousAt.tendsto.mono_left nhdsWithin_le_nhds
    · filter_upwards [hs.filter_mono nhdsWithin_le_nhds, self_mem_nhdsWithin] with y hys hyx
      exact RiemannRochAna_coordinate_ne hE x y hys hyx
  refine ⟨F ∘ z, ?_, ?_⟩
  · apply ContMDiffAt.comp x _ hz
    rwa [hz0]
  · filter_upwards [ht hfg, hs.filter_mono nhdsWithin_le_nhds] with y hy hys
    change F (z y) = _
    rw [hy]
    congr 2
    have he : extChartAt 𝓘(ℂ, E) x x + b4cov_lineEquiv hE (z y) =
        extChartAt 𝓘(ℂ, E) x y := by
      dsimp only [z, RiemannRochAna_coordinate]
      rw [ContinuousLinearEquiv.apply_symm_apply]
      abel
    rw [he, (extChartAt 𝓘(ℂ, E) x).left_inv hys]

/-- RiemannRochAna: scalar meromorphic representatives in surface charts normalize to analytic sphere maps. -/
theorem RiemannRochAna_normalize_meromorphic [T1Space C]
    (hE : Module.finrank ℂ E = 1) (f : C → ℂ)
    (hf : ∀ x, MeromorphicAt (fun t : ℂ ↦ f ((extChartAt 𝓘(ℂ, E) x).symm
      (extChartAt 𝓘(ℂ, E) x x + b4cov_lineEquiv hE t))) 0) :
    ∃ F : C → OnePoint ℂ, ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω F ∧
      ∀ x, ∀ᶠ y in 𝓝[≠] x, F y = ((f y : ℂ) : OnePoint ℂ) := by
  letI : ∀ x : C, (𝓝[≠] x).NeBot := RiemannRochAna_punctured_neBot hE
  exact RiemannRochAna_analytic_of_punctured_extensions (fun y ↦ (f y : OnePoint ℂ))
    (fun x ↦ RiemannRochAna_surface_meromorphic_extension hE f x (hf x))

