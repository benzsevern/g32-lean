/-- RiemannRochAna: the target chart expression in a centred source coordinate. -/
def RiemannRochAna_targetLocal (hE : Module.finrank ℂ E = 1)
    (F : C → OnePoint ℂ) (x : C) : ℂ → ℂ :=
  fun t ↦ b4cov_expr E ℂ F x (F x)
    (extChartAt 𝓘(ℂ, E) x x + b4cov_lineEquiv hE t)

/-- RiemannRochAna: the centred target chart expression is analytic. -/
theorem RiemannRochAna_targetLocal_analytic (hE : Module.finrank ℂ E = 1)
    (F : C → OnePoint ℂ) (hF : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω F) (x : C) :
    AnalyticAt ℂ (RiemannRochAna_targetLocal hE F x) 0 := by
  have hG := b4cov_analyticAt_chart F hF x (F x)
    (extChartAt 𝓘(ℂ, E) x x) (mem_extChartAt_target x) (by
      rw [extChartAt_to_inv]; exact mem_extChartAt_source (F x))
  exact hG.comp_of_eq (analyticAt_const.add ((b4cov_lineEquiv hE).analyticAt 0)) (by simp)

#print axioms RiemannRochAna_targetLocal_analytic

/-- RiemannRochAna: scalar representatives agree with the target coordinate, inverted at a pole. -/
theorem RiemannRochAna_functionLocal_target_germ (hE : Module.finrank ℂ E = 1)
    (F : C → OnePoint ℂ) (hF : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω F) (x : C) :
    RiemannRochAna_functionLocal hE F x =ᶠ[𝓝[≠] 0]
      if F x = OnePoint.infty then (RiemannRochAna_targetLocal hE F x)⁻¹
      else RiemannRochAna_targetLocal hE F x := by
  classical
  let φ := extChartAt 𝓘(ℂ, E) x
  let ψ := extChartAt 𝓘(ℂ, ℂ) (F x)
  let L := b4cov_lineEquiv hE
  have hs : ∀ᶠ y in 𝓝 x, F y ∈ ψ.source :=
    hF.continuous.continuousAt.preimage_mem_nhds
      ((isOpen_extChartAt_source (F x)).mem_nhds (mem_extChartAt_source (F x)))
  have ht := RiemannRochAna_inverse_coordinate_punctured hE x
    (hs.filter_mono nhdsWithin_le_nhds)
  by_cases hx : F x = OnePoint.infty
  · rw [if_pos hx]
    filter_upwards [ht] with t htp
    have hp : F (φ.symm (φ x + L t)) ∈ b4cov_chartInf.source := by
      simpa only [mem_preimage, mem_ofPred_eq, φ, L, ψ, hx, extChartAt_source,
        b4cov_chartAt_infty] using htp
    change (F (φ.symm (φ x + L t))).elim 0 id =
      (ψ (F (φ.symm (φ x + L t))))⁻¹
    simpa only [ψ, hx, extChartAt_coe, b4cov_chartAt_infty,
      modelWithCornersSelf_coe, Function.comp_apply, id_eq]
      using RiemannRochAna_finiteValue_chartInf _ hp
  · rw [if_neg hx]
    obtain ⟨a, ha⟩ := OnePoint.ne_infty_iff_exists.mp hx
    filter_upwards [ht] with t htp
    have hp : F (φ.symm (φ x + L t)) ∈ b4cov_chart0.source := by
      simpa only [mem_preimage, mem_ofPred_eq, φ, L, ψ, ← ha, extChartAt_source,
        b4cov_chartAt_coe] using htp
    change (F (φ.symm (φ x + L t))).elim 0 id =
      ψ (F (φ.symm (φ x + L t)))
    simpa only [ψ, ← ha, extChartAt_coe, b4cov_chartAt_coe,
      modelWithCornersSelf_coe, Function.comp_apply, id_eq]
      using RiemannRochAna_finiteValue_chart0 _ hp

#print axioms RiemannRochAna_functionLocal_target_germ

/-- RiemannRochAna: a target coordinate vanishing at the centre has order equal to the ramification index. -/
theorem RiemannRochAna_targetLocal_order [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (F : C → OnePoint ℂ)
    (hF : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω F) (hnc : ∃ x y, F x ≠ F y) (x : C)
    (hzero : RiemannRochAna_targetLocal hE F x 0 = 0) :
    meromorphicOrderAt (RiemannRochAna_targetLocal hE F x) 0 =
      ((b4_ramIndex E ℂ F x : ℤ) : WithTop ℤ) := by
  classical
  let G := b4cov_expr E ℂ F x (F x)
  let z := extChartAt 𝓘(ℂ, E) x x
  let L := b4cov_lineEquiv (show Module.finrank ℂ ℂ = 1 by simp)
  let T := b4cov_transport hE (show Module.finrank ℂ ℂ = 1 by simp) G z
  have hG := b4cov_analyticAt_chart F hF x (F x) z (mem_extChartAt_target x) (by
    rw [extChartAt_to_inv]; exact mem_extChartAt_source (F x))
  have hT : AnalyticAt ℂ T 0 := b4cov_transport_analyticAt hE (by simp) hG
  obtain ⟨he, hne, hlow⟩ := b4cov_ramIndex_spec F hF hnc x
  have hTo : analyticOrderAt T 0 = b4_ramIndex E ℂ F x :=
    b4cov_analyticOrderAt_transport hE (by simp) hG he hlow hne
  have hG0 : G z = 0 := by
    simpa only [RiemannRochAna_targetLocal, map_zero, add_zero] using hzero
  have hL (t : ℂ) : L t = L 1 * t := by
    simpa only [smul_eq_mul, mul_one, mul_comm] using L.map_smul t 1
  have hA : RiemannRochAna_targetLocal hE F x = (fun _ : ℂ ↦ L 1) * T := by
    funext t
    change G (z + b4cov_lineEquiv hE t) = L 1 * T t
    rw [← hL]
    simp only [T, b4cov_transport, hG0, map_zero, sub_zero]
    exact (L.apply_symm_apply _).symm
  have hc : L 1 ≠ 0 := L.map_ne_zero_iff.mpr one_ne_zero
  rw [hA, meromorphicOrderAt_mul (MeromorphicAt.const (L 1) 0) hT.meromorphicAt,
    meromorphicOrderAt_const, if_neg hc, zero_add, hT.meromorphicOrderAt_eq, hTo]
  simp only [ENat.map_natCast]

#print axioms RiemannRochAna_targetLocal_order

/-- RiemannRochAna: the target coordinate at the centre equals the finite-value representative. -/
theorem RiemannRochAna_targetLocal_zero (hE : Module.finrank ℂ E = 1)
    (F : C → OnePoint ℂ) (x : C) :
    RiemannRochAna_targetLocal hE F x 0 = (F x).elim 0 id := by
  simp only [RiemannRochAna_targetLocal, b4cov_expr, Function.comp_apply,
    map_zero, add_zero, extChartAt_to_inv]
  generalize F x = p
  induction p using OnePoint.rec with
  | infty =>
    change b4cov_chartInf OnePoint.infty = 0
    rw [b4cov_chartInf_apply, b4cov_sphInv_infty, b4cov_chart0_coe]
  | coe a => exact b4cov_chart0_coe a

#print axioms RiemannRochAna_targetLocal_zero

/-- RiemannRochAna: the integer order of a nonzero meromorphic function is its
local scalar meromorphic order. -/
theorem RiemannRochAna_ord_eq_local [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (F : b4c_MeroFun E C)
    (hF : ∃ y, F y ≠ (0 : ℂ)) (x : C) :
    ((b4c_ord E F x : ℤ) : WithTop ℤ) =
      meromorphicOrderAt (RiemannRochAna_functionLocal hE F x) 0 := by
  classical
  by_cases hnc : ∃ y z, F y ≠ F z
  · have hg := RiemannRochAna_functionLocal_target_germ hE F F.property.1 x
    by_cases hzero : F x = (0 : ℂ)
    · have ht := RiemannRochAna_targetLocal_order hE F F.property.1 hnc x (by
        rw [RiemannRochAna_targetLocal_zero, hzero]
        rfl)
      rw [b4c_ord, if_pos hzero, meromorphicOrderAt_congr hg]
      simp only [hzero, OnePoint.coe_ne_infty, if_false]
      exact ht.symm
    · by_cases hinf : F x = OnePoint.infty
      · have ht := RiemannRochAna_targetLocal_order hE F F.property.1 hnc x (by
          rw [RiemannRochAna_targetLocal_zero, hinf]
          rfl)
        rw [b4c_ord, if_neg hzero, if_pos hinf, meromorphicOrderAt_congr hg,
          if_pos hinf, meromorphicOrderAt_inv, ht]
        simp
      · rw [b4c_ord, if_neg hzero, if_neg hinf, meromorphicOrderAt_congr hg,
          if_neg hinf]
        have ha := RiemannRochAna_targetLocal_analytic hE F F.property.1 x
        rw [ha.meromorphicOrderAt_eq, ha.analyticOrderAt_eq_zero.2]
        · simp
        · rw [RiemannRochAna_targetLocal_zero]
          obtain ⟨a, ha⟩ := OnePoint.ne_infty_iff_exists.mp hinf
          rw [← ha]
          change a ≠ 0
          intro ha0
          apply hzero
          rw [← ha, ha0]
  · push_neg at hnc
    obtain ⟨y, hy⟩ := hF
    have hxy : F x = F y := hnc x y
    have hx0 : F x ≠ (0 : ℂ) := hxy ▸ hy
    have hxi : F x ≠ OnePoint.infty := by
      obtain ⟨z, hz⟩ := F.property.2
      exact hnc x z ▸ hz
    have heq : RiemannRochAna_functionLocal hE F x =
        fun _ : ℂ ↦ (F x).elim 0 id := by
      funext t
      simp only [RiemannRochAna_functionLocal, hnc _ x]
    rw [b4c_ord, if_neg hx0, if_neg hxi, heq, meromorphicOrderAt_const]
    obtain ⟨a, ha⟩ := OnePoint.ne_infty_iff_exists.mp hxi
    have ha0 : a ≠ 0 := by
      intro ha0
      apply hx0
      rw [← ha, ha0]
    rw [← ha]
    simp [ha0]

theorem b4c_L_eq_restrictions_aux [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ) :
    (b4c_L (E := E) D : Set ({x : C // x ∉ D.support} → ℂ)) =
      {g | g = 0 ∨ ∃ f : b4c_MeroFun E C,
        (∃ x, f x ≠ (0 : ℂ)) ∧
        (∀ x, x ∉ D.support → f x ≠ OnePoint.infty) ∧
        (∀ x, 0 ≤ b4c_ord E f x + D x) ∧
        g = fun x ↦ (f x.1).elim 0 id} := by
  classical
  let S : Set ({x : C // x ∉ D.support} → ℂ) := {g | ∃ f : b4c_MeroFun E C,
    (∃ x, f x ≠ (0 : ℂ)) ∧ (∀ x, x ∉ D.support → f x ≠ OnePoint.infty) ∧
    (∀ x, 0 ≤ b4c_ord E f x + D x) ∧ g = fun x ↦ (f x.1).elim 0 id}
  change (Submodule.span ℂ S : Set _) = {g | g = 0 ∨ g ∈ S}
  apply Set.Subset.antisymm
  · intro g hg
    refine Submodule.span_induction (p := fun g _ ↦ g = 0 ∨ g ∈ S) ?_ ?_ ?_ ?_ hg
    · exact fun g hg ↦ Or.inr hg
    · exact Or.inl rfl
    · intro g h _ _ hg hh
      rcases hg with rfl | ⟨F, hFn, hFfin, hFord, rfl⟩
      · simpa using hh
      rcases hh with rfl | ⟨G, hGn, hGfin, hGord, rfl⟩
      · exact Or.inr ⟨F, hFn, hFfin, hFord, by simp⟩
      haveI : Infinite C := not_finite_iff_infinite.mp (by
        intro h
        letI := h
        obtain ⟨y, hy⟩ := RiemannRochAna_exists_unmarked hE (Classical.arbitrary C) (id : C → C)
        exact hy ⟨y, rfl⟩)
      obtain ⟨x₀, hx₀'⟩ := RiemannRochAna_exists_unmarked hE
        (Classical.arbitrary C) (fun i : D.support ↦ i.1)
      have hx₀ : x₀ ∉ D.support := by
        intro hx
        exact hx₀' ⟨⟨x₀, hx⟩, rfl⟩
      obtain ⟨H, hHgerm, hHval⟩ := RiemannRochAna_meroFun_add hE F G x₀
        (hFfin x₀ hx₀) (hGfin x₀ hx₀)
      by_cases hz : (fun x : {x : C // x ∉ D.support} ↦
          (F x.1).elim 0 id + (G x.1).elim 0 id) = 0
      · left
        ext x
        exact congrFun hz x
      · right
        have hHfin (x : C) (hx : x ∉ D.support) : H x ≠ OnePoint.infty := by
          rw [hHval x (hFfin x hx) (hGfin x hx)]
          exact OnePoint.coe_ne_infty _
        have hHn : ∃ x, H x ≠ (0 : ℂ) := by
          obtain ⟨x, hx⟩ := Function.ne_iff.mp hz
          refine ⟨x.1, ?_⟩
          change (H : C → OnePoint ℂ) x.1 ≠ ((0 : ℂ) : OnePoint ℂ)
          rw [hHval x.1 (hFfin x.1 x.2) (hGfin x.1 x.2)]
          exact_mod_cast hx
        refine ⟨H, hHn, hHfin, ?_, ?_⟩
        · intro x
          have ho := RiemannRochAna_meroFun_add_order hE F G H x (hHgerm x)
          rw [← RiemannRochAna_ord_eq_local hE F hFn x,
            ← RiemannRochAna_ord_eq_local hE G hGn x,
            ← RiemannRochAna_ord_eq_local hE H hHn x] at ho
          have hoZ : min (b4c_ord E F x) (b4c_ord E G x) ≤ b4c_ord E H x := by
            exact_mod_cast ho
          have hm : 0 ≤ min (b4c_ord E F x) (b4c_ord E G x) + D x := by
            simpa using min_le_min (hFord x) (hGord x)
          omega
        · funext x
          rw [hHval x.1 (hFfin x.1 x.2) (hGfin x.1 x.2)]
          rfl
    · intro a g _ hg
      rcases hg with rfl | ⟨F, hFn, hFfin, hFord, heqF⟩
      · exact Or.inl (smul_zero a)
      by_cases ha : a = 0
      · exact Or.inl (by simp [ha])
      · obtain ⟨H, hHgerm, hHval⟩ := RiemannRochAna_meroFun_smul hE a F
        right
        have hHn : ∃ x, H x ≠ (0 : ℂ) := by
          by_contra hn
          push_neg at hn
          have hFn' := hFn
          obtain ⟨x, _⟩ := hFn
          have ho := RiemannRochAna_meroFun_smul_order hE a ha F H x (hHgerm x)
          have hz : RiemannRochAna_functionLocal hE H x = fun _ : ℂ ↦ 0 := by
            funext t
            simp only [RiemannRochAna_functionLocal, hn]
            rfl
          rw [hz, meromorphicOrderAt_const, if_pos rfl,
            ← RiemannRochAna_ord_eq_local hE F hFn' x] at ho
          exact WithTop.coe_ne_top ho.symm
        refine ⟨H, hHn, ?_, ?_, ?_⟩
        · intro x hx
          rw [hHval x (hFfin x hx)]
          exact OnePoint.coe_ne_infty _
        · intro x
          have ho := RiemannRochAna_meroFun_smul_order hE a ha F H x (hHgerm x)
          rw [← RiemannRochAna_ord_eq_local hE H hHn x,
            ← RiemannRochAna_ord_eq_local hE F hFn x] at ho
          have hoZ : b4c_ord E H x = b4c_ord E F x := by exact_mod_cast ho
          rw [hoZ]
          exact hFord x
        · funext x
          rw [heqF]
          simp only [Pi.smul_apply, smul_eq_mul]
          rw [hHval x.1 (hFfin x.1 x.2)]
          rfl
  · rintro g (rfl | hg)
    · exact Submodule.zero_mem _
    · exact Submodule.subset_span hg

/-- RiemannRochAna: coefficients of polar parts allowed by the positive part of a divisor. -/
abbrev RiemannRochAna_PrincipalData (D : C →₀ ℤ) :=
  (x : D.support) → Fin (Int.toNat (D x.1)) → ℂ

/-- RiemannRochAna: the principal-data space has one dimension for every allowed polar coefficient. -/
theorem RiemannRochAna_principalData_finrank (D : C →₀ ℤ) :
    Module.finrank ℂ (RiemannRochAna_PrincipalData D) =
      D.sum fun _ n ↦ Int.toNat n := by
  classical
  rw [Module.finrank_pi_fintype]
  simp only [Module.finrank_pi, Fintype.card_fin, Finsupp.sum]
  exact Finset.sum_attach D.support (fun x ↦ Int.toNat (D x))

/-- RiemannRochAna: for an effective divisor, principal-data dimension is its degree. -/
theorem RiemannRochAna_principalData_finrank_effective (D : C →₀ ℤ)
    (hD : ∀ x, 0 ≤ D x) :
    (Module.finrank ℂ (RiemannRochAna_PrincipalData D) : ℤ) = b4c_deg D := by
  rw [RiemannRochAna_principalData_finrank]
  simp only [b4c_deg, Finsupp.sum, Nat.cast_sum]
  apply Finset.sum_congr rfl
  intro x _
  exact Int.toNat_of_nonneg (hD x)

attribute [local instance] b3Forms_isManifold_real

/-- RiemannRochAna: the smooth obstruction associated with a cutoff polar monomial. -/
def RiemannRochAna_principalObstructionPow (hE : Module.finrank ℂ E = 1)
    (x : C) (χ : C → ℝ) (n : ℕ) : TangentBundle 𝓘(ℂ, E) C → ℂ :=
  fun p ↦ b4c_dbar E C (fun y ↦ (χ y : ℂ)) p /
    RiemannRochAna_coordinate hE x p.1 ^ (n + 1)

/-- RiemannRochAna: cutoff polar monomials define smooth antiholomorphic obstruction forms. -/
theorem RiemannRochAna_principalObstructionPow_mem [T2Space C]
    (hE : Module.finrank ℂ E = 1) (x : C) (χ : C → ℝ) (n : ℕ)
    (hχ : ContMDiff 𝓘(ℝ, E) 𝓘(ℝ, ℝ) ∞ χ)
    (hχx : χ =ᶠ[𝓝 x] 1)
    (hs : tsupport χ ⊆ (extChartAt 𝓘(ℂ, E) x).source) :
    RiemannRochAna_principalObstructionPow hE x χ n ∈ b4c_Smooth01 E C := by
  let u : b4c_SmoothFun E C := ⟨fun y ↦ (χ y : ℂ), Complex.ofRealCLM.contMDiff.comp hχ⟩
  have hd := b4c_dbar_mem_aux u
  refine ⟨?_, ?_⟩
  · intro p
    have hzero (a : ℝ) (hc : χ =ᶠ[𝓝 p.1] fun _ ↦ a) :
        ContMDiffAt 𝓘(ℝ, E).tangent 𝓘(ℝ, ℂ) ∞
          (RiemannRochAna_principalObstructionPow hE x χ n) p := by
      apply (contMDiffAt_const (c := (0 : ℂ))).congr_of_eventuallyEq
      have hh := RiemannRochAna_dbar_eventually_zero (E := E)
        (hc.mono fun z hz ↦ congrArg Complex.ofReal hz)
      have hp := (FiberBundle.continuous_proj E
        (TangentSpace 𝓘(ℂ, E) : C → Type)).continuousAt (x := p)
      filter_upwards [hp.preimage_mem_nhds hh] with q hq
      simp only [RiemannRochAna_principalObstructionPow, hq q.2, zero_div]
    by_cases hpx : p.1 = x
    · apply hzero 1
      rw [hpx]
      exact hχx
    by_cases hps : p.1 ∈ tsupport χ
    · have hc := RiemannRochAna_coordinate_analytic hE x p.1 (hs hps)
      have hcr : ContMDiffAt 𝓘(ℝ, E) 𝓘(ℝ, ℂ) ∞
          (RiemannRochAna_coordinate hE x) p.1 :=
        (b3A_contMDiffWithinAt_real hc).of_le (by simp)
      have hi := ((contDiffAt_inv (𝕜 := ℝ)
        (RiemannRochAna_coordinate_ne hE x p.1 (hs hps) hpx)).pow (n + 1)).contMDiffAt.comp p.1 hcr
      convert hd.1.contMDiffAt.mul
        (hi.comp p RiemannRochAna_projection_smooth.contMDiffAt) using 1
      funext q
      simp only [u, RiemannRochAna_principalObstructionPow, Function.comp_apply,
        Pi.mul_apply, div_eq_mul_inv, inv_pow]
    · exact hzero 0 (notMem_tsupport_iff_eventuallyEq.mp hps)
  · intro y a v z
    simp only [RiemannRochAna_principalObstructionPow]
    have hh := hd.2 y a v z
    change b4c_dbar E C (fun y ↦ (χ y : ℂ)) ⟨y, a • v + z⟩ = _ at hh
    rw [hh]
    ring

/-- RiemannRochAna: separated cutoff functions attached to the support of a divisor. -/
noncomputable def RiemannRochAna_divisorCutoff [T2Space C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ) : D.support → C → ℝ :=
  Classical.choose (RiemannRochAna_separated_cutoffs hE
    (fun x : D.support ↦ x.1) Subtype.val_injective)

/-- RiemannRochAna: divisor cutoffs are smooth, equal one at their centre, and separated. -/
theorem RiemannRochAna_divisorCutoff_spec [T2Space C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ) (i : D.support) :
    ContMDiff 𝓘(ℝ, E) 𝓘(ℝ, ℝ) ∞ (RiemannRochAna_divisorCutoff hE D i) ∧
      RiemannRochAna_divisorCutoff hE D i =ᶠ[𝓝 i.1] 1 ∧
      tsupport (RiemannRochAna_divisorCutoff hE D i) ⊆
        (extChartAt 𝓘(ℂ, E) i.1).source ∧
      ∀ j, j ≠ i → j.1 ∉ tsupport (RiemannRochAna_divisorCutoff hE D i) :=
  Classical.choose_spec (RiemannRochAna_separated_cutoffs hE
    (fun x : D.support ↦ x.1) Subtype.val_injective) i

/-- RiemannRochAna: a collection of polar coefficients determines its smooth obstruction form. -/
noncomputable def RiemannRochAna_principalObstructionLinear [T2Space C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ) :
    RiemannRochAna_PrincipalData D →ₗ[ℂ] b4c_Smooth01 E C where
  toFun c := ∑ i, ∑ n, c i n •
    (⟨RiemannRochAna_principalObstructionPow hE i.1
        (RiemannRochAna_divisorCutoff hE D i) n,
      RiemannRochAna_principalObstructionPow_mem hE i.1
        (RiemannRochAna_divisorCutoff hE D i) n
        (RiemannRochAna_divisorCutoff_spec hE D i).1
        (RiemannRochAna_divisorCutoff_spec hE D i).2.1
        (RiemannRochAna_divisorCutoff_spec hE D i).2.2.1⟩ : b4c_Smooth01 E C)
  map_add' c d := by
    simp only [Pi.add_apply, add_smul, Finset.sum_add_distrib]
  map_smul' a c := by
    simp only [Pi.smul_apply, smul_eq_mul, mul_smul, Finset.smul_sum,
      RingHom.id_apply]

/-- RiemannRochAna: the Dolbeault class obstructing a collection of principal parts. -/
noncomputable def RiemannRochAna_principalClassLinear [T2Space C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ) :
    RiemannRochAna_PrincipalData D →ₗ[ℂ] b4c_Dolbeault01 E C :=
  (((Submodule.span ℂ
      (b4c_dbar E C '' (b4c_SmoothFun E C : Set (C → ℂ)))).comap
        (b4c_Smooth01 E C).subtype).mkQ).comp
    (RiemannRochAna_principalObstructionLinear hE D)

/-- RiemannRochAna: away from its pole, a higher cutoff obstruction is the
conjugate differential of the corresponding polar monomial. -/
theorem RiemannRochAna_principalObstructionPow_eq_dbar [T2Space C]
    (hE : Module.finrank ℂ E = 1) (x : C) (χ : C → ℝ) (n : ℕ)
    (hχ : ContMDiff 𝓘(ℝ, E) 𝓘(ℝ, ℝ) ∞ χ)
    (hs : tsupport χ ⊆ (extChartAt 𝓘(ℂ, E) x).source)
    (y : C) (hy : y ≠ x) (v : E) :
    b4c_dbar E C (fun z ↦ (χ z : ℂ) /
      RiemannRochAna_coordinate hE x z ^ (n + 1)) ⟨y, v⟩ =
      RiemannRochAna_principalObstructionPow hE x χ n ⟨y, v⟩ := by
  by_cases hys : y ∈ tsupport χ
  · have hc := RiemannRochAna_coordinate_analytic hE x y (hs hys)
    have hi : ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω
        (fun z ↦ (RiemannRochAna_coordinate hE x z)⁻¹ ^ (n + 1)) y :=
      ((contDiffAt_inv (𝕜 := ℂ)
        (RiemannRochAna_coordinate_ne hE x y (hs hys) hy)).pow (n + 1)).contMDiffAt.comp y hc
    have hh := hi.mdifferentiableAt (by simp)
    have hr := (b3A_mdifferentiableAt_real hh).1
    have hχr : MDifferentiableAt 𝓘(ℝ, E) 𝓘(ℝ, ℂ) (fun z ↦ (χ z : ℂ)) y :=
      (Complex.ofRealCLM.contMDiff.comp hχ).mdifferentiable (by simp) y
    rw [show (fun z ↦ (χ z : ℂ) /
        RiemannRochAna_coordinate hE x z ^ (n + 1)) =
      fun z ↦ (χ z : ℂ) * (RiemannRochAna_coordinate hE x z)⁻¹ ^ (n + 1) by
        funext z
        rw [div_eq_mul_inv, inv_pow]]
    rw [RiemannRochAna_dbar_mul_at (fun z ↦ (χ z : ℂ)) _ y hχr hr v,
      RiemannRochAna_dbar_holomorphic_at _ y hh v]
    simp only [mul_zero, zero_add, RiemannRochAna_principalObstructionPow,
      div_eq_mul_inv, inv_pow]
    exact mul_comm _ _
  · have hz : χ =ᶠ[𝓝 y] 0 := notMem_tsupport_iff_eventuallyEq.mp hys
    have hquot : (fun z ↦ (χ z : ℂ) /
        RiemannRochAna_coordinate hE x z ^ (n + 1)) =ᶠ[𝓝 y]
        fun _ ↦ (0 : ℂ) := by
      filter_upwards [hz] with z hz
      simp only [show χ z = 0 from hz, Complex.ofReal_zero, zero_div]
    rw [RiemannRochAna_dbar_const_germ hquot v]
    have hc : χ =ᶠ[𝓝 y] fun _ ↦ (0 : ℝ) := hz
    have hh := RiemannRochAna_dbar_eventually_zero (E := E)
      (hc.mono fun z hz ↦ congrArg Complex.ofReal hz)
    have := (hh.self_of_nhds v)
    simp only [RiemannRochAna_principalObstructionPow, this, zero_div]

/-- RiemannRochAna: a cutoff polar monomial is smooth away from its centre. -/
theorem RiemannRochAna_cutoff_principalPow_smooth [T2Space C]
    (hE : Module.finrank ℂ E = 1) (x : C) (χ : C → ℝ) (n : ℕ)
    (hχ : ContMDiff 𝓘(ℝ, E) 𝓘(ℝ, ℝ) ∞ χ)
    (hs : tsupport χ ⊆ (extChartAt 𝓘(ℂ, E) x).source) (y : C) (hy : y ≠ x) :
    ContMDiffAt 𝓘(ℝ, E) 𝓘(ℝ, ℂ) ∞
      (fun z ↦ (χ z : ℂ) / RiemannRochAna_coordinate hE x z ^ (n + 1)) y := by
  by_cases hys : y ∈ tsupport χ
  · have hc := RiemannRochAna_coordinate_analytic hE x y (hs hys)
    have hcr : ContMDiffAt 𝓘(ℝ, E) 𝓘(ℝ, ℂ) ∞
        (RiemannRochAna_coordinate hE x) y :=
      (b3A_contMDiffWithinAt_real hc).of_le (by simp)
    have hi := (((contDiffAt_inv (𝕜 := ℝ)
      (RiemannRochAna_coordinate_ne hE x y (hs hys) hy)).pow (n + 1)).contMDiffAt.comp y hcr)
    convert (Complex.ofRealCLM.contMDiff.contMDiffAt.comp y hχ.contMDiffAt).mul hi using 1
    funext z
    simp [Function.comp_apply, div_eq_mul_inv, inv_pow]
  · apply (contMDiffAt_const (c := (0 : ℂ))).congr_of_eventuallyEq
    filter_upwards [notMem_tsupport_iff_eventuallyEq.mp hys] with z hz
    simp only [show χ z = 0 from hz, Complex.ofReal_zero, zero_div]

/-- RiemannRochAna: the cutoff scalar representative of a collection of principal parts. -/
noncomputable def RiemannRochAna_principalScalar [T2Space C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (c : RiemannRochAna_PrincipalData D) : C → ℂ :=
  fun y ↦ ∑ i, ∑ n, c i n * ((RiemannRochAna_divisorCutoff hE D i y : ℂ) /
    RiemannRochAna_coordinate hE i.1 y ^ ((n : ℕ) + 1))

/-- RiemannRochAna: off the divisor support, the cutoff scalar has the prescribed obstruction form. -/
theorem RiemannRochAna_principalScalar_dbar [T2Space C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (c : RiemannRochAna_PrincipalData D) (y : C) (hy : y ∉ D.support) (v : E) :
    b4c_dbar E C (RiemannRochAna_principalScalar hE D c) ⟨y, v⟩ =
      (RiemannRochAna_principalObstructionLinear hE D c).1 ⟨y, v⟩ := by
  classical
  have hne (i : D.support) : y ≠ i.1 := fun h ↦ hy (h ▸ i.2)
  have hq (i : D.support) (n : Fin (Int.toNat (D i.1))) :
      MDifferentiableAt 𝓘(ℝ, E) 𝓘(ℝ, ℂ)
        (fun z ↦ c i n * ((RiemannRochAna_divisorCutoff hE D i z : ℂ) /
          RiemannRochAna_coordinate hE i.1 z ^ ((n : ℕ) + 1))) y :=
    mdifferentiableAt_const.mul
      ((RiemannRochAna_cutoff_principalPow_smooth hE i.1
        (RiemannRochAna_divisorCutoff hE D i) n
        (RiemannRochAna_divisorCutoff_spec hE D i).1
        (RiemannRochAna_divisorCutoff_spec hE D i).2.2.1 y (hne i)).mdifferentiableAt (by simp))
  rw [show RiemannRochAna_principalScalar hE D c =
      ∑ i, fun z ↦ ∑ n, c i n * ((RiemannRochAna_divisorCutoff hE D i z : ℂ) /
        RiemannRochAna_coordinate hE i.1 z ^ ((n : ℕ) + 1)) by
    funext z
    simp only [RiemannRochAna_principalScalar, Finset.sum_apply]]
  have hob (q : TangentBundle (modelWithCornersSelf ℂ E) C) :
      (RiemannRochAna_principalObstructionLinear hE D c).1 q =
        ∑ i, ∑ n, c i n *
          RiemannRochAna_principalObstructionPow hE i.1
            (RiemannRochAna_divisorCutoff hE D i) n q := by
    change (∑ i, ∑ n, c i n •
      (⟨RiemannRochAna_principalObstructionPow hE i.1
          (RiemannRochAna_divisorCutoff hE D i) n,
        RiemannRochAna_principalObstructionPow_mem hE i.1
          (RiemannRochAna_divisorCutoff hE D i) n
          (RiemannRochAna_divisorCutoff_spec hE D i).1
          (RiemannRochAna_divisorCutoff_spec hE D i).2.1
          (RiemannRochAna_divisorCutoff_spec hE D i).2.2.1⟩ : b4c_Smooth01 E C)).1 q = _
    simp only [Submodule.coe_sum, Submodule.coe_smul, Finset.sum_apply,
      Pi.smul_apply, smul_eq_mul]
  rw [hob]
  rw [RiemannRochAna_dbar_sum_at Finset.univ _ y]
  · apply Finset.sum_congr rfl
    intro i _
    rw [show (fun z ↦ ∑ n, c i n * ((RiemannRochAna_divisorCutoff hE D i z : ℂ) /
        RiemannRochAna_coordinate hE i.1 z ^ ((n : ℕ) + 1))) =
      ∑ n, fun z ↦ c i n * ((RiemannRochAna_divisorCutoff hE D i z : ℂ) /
        RiemannRochAna_coordinate hE i.1 z ^ ((n : ℕ) + 1)) by
        funext z
        simp only [Finset.sum_apply]]
    rw [RiemannRochAna_dbar_sum_at Finset.univ _ y]
    · apply Finset.sum_congr rfl
      intro n _
      rw [show (fun z ↦ c i n * ((RiemannRochAna_divisorCutoff hE D i z : ℂ) /
          RiemannRochAna_coordinate hE i.1 z ^ ((n : ℕ) + 1))) =
        c i n • (fun z ↦ (RiemannRochAna_divisorCutoff hE D i z : ℂ) /
          RiemannRochAna_coordinate hE i.1 z ^ ((n : ℕ) + 1)) by rfl]
      rw [RiemannRochAna_dbar_smul_at (c i n) _ y
        ((RiemannRochAna_cutoff_principalPow_smooth hE i.1
          (RiemannRochAna_divisorCutoff hE D i) n
          (RiemannRochAna_divisorCutoff_spec hE D i).1
          (RiemannRochAna_divisorCutoff_spec hE D i).2.2.1 y (hne i)).mdifferentiableAt (by simp)) v,
        RiemannRochAna_principalObstructionPow_eq_dbar hE i.1
          (RiemannRochAna_divisorCutoff hE D i) n
          (RiemannRochAna_divisorCutoff_spec hE D i).1
          (RiemannRochAna_divisorCutoff_spec hE D i).2.2.1 y (hne i) v]
    · intro n _
      exact hq i n
  · intro i _
    rw [show (fun z ↦ ∑ n, c i n * ((RiemannRochAna_divisorCutoff hE D i z : ℂ) /
        RiemannRochAna_coordinate hE i.1 z ^ ((n : ℕ) + 1))) =
      ∑ n, fun z ↦ c i n * ((RiemannRochAna_divisorCutoff hE D i z : ℂ) /
        RiemannRochAna_coordinate hE i.1 z ^ ((n : ℕ) + 1)) by
        funext z
        simp only [Finset.sum_apply]]
    exact MDifferentiableAt.sum fun n _ ↦ hq i n

/-- RiemannRochAna: a higher principal-part obstruction vanishes near the centre
of a cutoff which is locally one. -/
theorem RiemannRochAna_principalObstructionPow_zero_germ
    (hE : Module.finrank ℂ E = 1) (x : C) (χ : C → ℝ) (n : ℕ)
    (hχ : χ =ᶠ[𝓝 x] 1) :
    ∀ᶠ y in 𝓝 x, ∀ v : E,
      RiemannRochAna_principalObstructionPow hE x χ n ⟨y, v⟩ = 0 := by
  have hd := RiemannRochAna_dbar_eventually_zero (E := E)
    (hχ.mono fun y hy ↦ congrArg Complex.ofReal hy)
  filter_upwards [hd] with y hy v
  simp only [RiemannRochAna_principalObstructionPow, hy v, zero_div]

/-- RiemannRochAna: principal data have zero obstruction class exactly when
their assembled obstruction have a smooth potential. -/
theorem RiemannRochAna_principalClass_eq_zero_iff [T2Space C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (c : RiemannRochAna_PrincipalData D) :
    RiemannRochAna_principalClassLinear hE D c = 0 ↔
      ∃ u : b4c_SmoothFun E C,
        b4c_dbar E C u = (RiemannRochAna_principalObstructionLinear hE D c).1 := by
  change (Submodule.Quotient.mk
    (RiemannRochAna_principalObstructionLinear hE D c) :
      b4c_Dolbeault01 E C) = 0 ↔ _
  exact RiemannRochAna_class_eq_zero_iff hE _

/-- RiemannRochAna: a higher principal-part obstruction vanishes near every
point where its cutoff is locally constant. -/
theorem RiemannRochAna_principalObstructionPow_zero_germ_of_const
    (hE : Module.finrank ℂ E = 1) (x y : C) (χ : C → ℝ) (n : ℕ) (a : ℝ)
    (hχ : χ =ᶠ[𝓝 y] fun _ ↦ a) :
    ∀ᶠ z in 𝓝 y, ∀ v : E,
      RiemannRochAna_principalObstructionPow hE x χ n ⟨z, v⟩ = 0 := by
  have hd := RiemannRochAna_dbar_eventually_zero (E := E)
    (hχ.mono fun z hz ↦ congrArg Complex.ofReal hz)
  filter_upwards [hd] with z hz v
  simp only [RiemannRochAna_principalObstructionPow, hz v, zero_div]

/-- RiemannRochAna: evaluation of the assembled obstruction is the finite sum
of the coefficient-weighted polar obstructions. -/
theorem RiemannRochAna_principalObstructionLinear_apply [T2Space C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (c : RiemannRochAna_PrincipalData D)
    (q : TangentBundle (modelWithCornersSelf ℂ E) C) :
    (RiemannRochAna_principalObstructionLinear hE D c).1 q =
      ∑ i, ∑ n, c i n *
        RiemannRochAna_principalObstructionPow hE i.1
          (RiemannRochAna_divisorCutoff hE D i) n q := by
  change (∑ i, ∑ n, c i n •
    (⟨RiemannRochAna_principalObstructionPow hE i.1
        (RiemannRochAna_divisorCutoff hE D i) n,
      RiemannRochAna_principalObstructionPow_mem hE i.1
        (RiemannRochAna_divisorCutoff hE D i) n
        (RiemannRochAna_divisorCutoff_spec hE D i).1
        (RiemannRochAna_divisorCutoff_spec hE D i).2.1
        (RiemannRochAna_divisorCutoff_spec hE D i).2.2.1⟩ : b4c_Smooth01 E C)).1 q = _
  simp only [Submodule.coe_sum, Submodule.coe_smul, Finset.sum_apply,
    Pi.smul_apply, smul_eq_mul]

/-- RiemannRochAna: a smooth potential for divisor principal data is analytic
at every point in the divisor support. -/
theorem RiemannRochAna_principalPotential_analytic [T2Space C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (c : RiemannRochAna_PrincipalData D) (u : b4c_SmoothFun E C)
    (hu : b4c_dbar E C u =
      (RiemannRochAna_principalObstructionLinear hE D c).1)
    (i : D.support) :
    ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω (u : C → ℂ) i.1 := by
  classical
  have hh (j : D.support) (n : Fin (Int.toNat (D j.1))) :
      ∀ᶠ y in 𝓝 i.1, ∀ v : E,
        RiemannRochAna_principalObstructionPow hE j.1
          (RiemannRochAna_divisorCutoff hE D j) n ⟨y, v⟩ = 0 := by
    by_cases hji : j = i
    · subst j
      exact RiemannRochAna_principalObstructionPow_zero_germ hE i.1
        (RiemannRochAna_divisorCutoff hE D i) n
        (RiemannRochAna_divisorCutoff_spec hE D i).2.1
    · exact RiemannRochAna_principalObstructionPow_zero_germ_of_const hE j.1 i.1
        (RiemannRochAna_divisorCutoff hE D j) n 0
        (notMem_tsupport_iff_eventuallyEq.mp
          ((RiemannRochAna_divisorCutoff_spec hE D j).2.2.2 i (Ne.symm hji)))
  apply RiemannRochAna_analyticAt_of_dbar_germ hE u i.1
  filter_upwards [(Filter.eventually_all_finset Finset.univ).mpr fun j _ ↦
    (Filter.eventually_all_finset Finset.univ).mpr fun n _ ↦ hh j n] with y hy
  refine ⟨u.property.contMDiffAt, ?_⟩
  intro v
  rw [congrFun hu ⟨y, v⟩,
    RiemannRochAna_principalObstructionLinear_apply]
  apply Finset.sum_eq_zero
  intro j _
  apply Finset.sum_eq_zero
  intro n _
  rw [hy j (Finset.mem_univ j) n (Finset.mem_univ n) v, mul_zero]

/-- RiemannRochAna: subtracting a potential from the cutoff scalar produces
the scalar representative with its obstruction removed. -/
noncomputable def RiemannRochAna_correctedPrincipal [T2Space C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (c : RiemannRochAna_PrincipalData D) (u : C → ℂ) : C → ℂ :=
  fun y ↦ RiemannRochAna_principalScalar hE D c y - u y

/-- RiemannRochAna: the corrected scalar representative is analytic away from
the divisor support. -/
theorem RiemannRochAna_correctedPrincipal_analytic [T2Space C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (c : RiemannRochAna_PrincipalData D) (u : b4c_SmoothFun E C)
    (hu : b4c_dbar E C u =
      (RiemannRochAna_principalObstructionLinear hE D c).1)
    (y : C) (hy : y ∉ D.support) :
    ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω
      (RiemannRochAna_correctedPrincipal hE D c u) y := by
  classical
  have hn : (D.support : Set C)ᶜ ∈ 𝓝 y :=
    D.support.finite_toSet.isClosed.isOpen_compl.mem_nhds hy
  apply RiemannRochAna_analyticAt_of_dbar_germ hE _ y
  filter_upwards [hn] with z hz
  have hsc : ContMDiffAt 𝓘(ℝ, E) 𝓘(ℝ, ℂ) ∞
      (RiemannRochAna_principalScalar hE D c) z := by
    change ContMDiffAt 𝓘(ℝ, E) 𝓘(ℝ, ℂ) ∞ (fun z ↦
      ∑ i, ∑ n, c i n * ((RiemannRochAna_divisorCutoff hE D i z : ℂ) /
        RiemannRochAna_coordinate hE i.1 z ^ ((n : ℕ) + 1))) z
    apply ContMDiffAt.sum
    intro i _
    apply ContMDiffAt.sum
    intro n _
    exact contMDiffAt_const.mul
      ((RiemannRochAna_cutoff_principalPow_smooth hE i.1
        (RiemannRochAna_divisorCutoff hE D i) n
        (RiemannRochAna_divisorCutoff_spec hE D i).1
        (RiemannRochAna_divisorCutoff_spec hE D i).2.2.1 z
        (fun h ↦ hz (h ▸ i.2))))
  have hs := hsc.mdifferentiableAt (by simp)
  refine ⟨?_, ?_⟩
  · exact hsc.sub u.property.contMDiffAt
  intro v
  rw [show RiemannRochAna_correctedPrincipal hE D c u =
      RiemannRochAna_principalScalar hE D c + (-1 : ℂ) • (u : C → ℂ) by
    funext x
    change RiemannRochAna_principalScalar hE D c x - (u : C → ℂ) x =
      RiemannRochAna_principalScalar hE D c x + (-1 : ℂ) * (u : C → ℂ) x
    ring]
  have hneg : MDifferentiableAt 𝓘(ℝ, E) 𝓘(ℝ, ℂ)
      ((-1 : ℂ) • (u : C → ℂ)) z := by
    change MDifferentiableAt 𝓘(ℝ, E) 𝓘(ℝ, ℂ)
      (fun x ↦ (-1 : ℂ) * (u : C → ℂ) x) z
    exact mdifferentiableAt_const.mul (u.property.mdifferentiableAt (by simp))
  rw [RiemannRochAna_dbar_add_at _ _ z hs
      hneg v,
    RiemannRochAna_dbar_smul_at (-1) (u : C → ℂ) z
      (u.property.mdifferentiableAt (by simp)) v,
    RiemannRochAna_principalScalar_dbar hE D c z hz v,
    congrFun hu ⟨z, v⟩]
  ring

/-- RiemannRochAna: the polar polynomial encoded by principal data at one
divisor point. -/
noncomputable def RiemannRochAna_principalPartAt
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (c : RiemannRochAna_PrincipalData D) (i : D.support) : C → ℂ :=
  fun y ↦ ∑ n, c i n /
    RiemannRochAna_coordinate hE i.1 y ^ ((n : ℕ) + 1)

/-- RiemannRochAna: near a divisor point, the corrected representative is its
polar polynomial minus the analytic potential. -/
theorem RiemannRochAna_correctedPrincipal_germ [T2Space C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (c : RiemannRochAna_PrincipalData D) (u : C → ℂ) (i : D.support) :
    RiemannRochAna_correctedPrincipal hE D c u =ᶠ[𝓝 i.1]
      fun y ↦ RiemannRochAna_principalPartAt hE D c i y - u y := by
  classical
  have hh (j : D.support) :
      RiemannRochAna_divisorCutoff hE D j =ᶠ[𝓝 i.1]
        fun _ ↦ if j = i then (1 : ℝ) else 0 := by
    by_cases hji : j = i
    · subst j
      filter_upwards [(RiemannRochAna_divisorCutoff_spec hE D i).2.1] with y hy
      have hy' : RiemannRochAna_divisorCutoff hE D i y = 1 := by simpa using hy
      simp [hy']
    · filter_upwards [notMem_tsupport_iff_eventuallyEq.mp
        ((RiemannRochAna_divisorCutoff_spec hE D j).2.2.2 i (Ne.symm hji))] with y hy
      have hy' : RiemannRochAna_divisorCutoff hE D j y = 0 := by simpa using hy
      simpa only [hy', if_neg hji]
  filter_upwards [(Filter.eventually_all_finset Finset.univ).mpr
    fun j _ ↦ hh j] with y hy
  simp only [RiemannRochAna_correctedPrincipal,
    RiemannRochAna_principalScalar, RiemannRochAna_principalPartAt]
  congr 1
  rw [Finset.sum_eq_single i]
  · apply Finset.sum_congr rfl
    intro n _
    simp [hy i (Finset.mem_univ i), div_eq_mul_inv]
  · intro j _ hji
    apply Finset.sum_eq_zero
    intro n _
    simp only [hy j (Finset.mem_univ j), if_neg hji, Complex.ofReal_zero,
      zero_div, mul_zero]
  · intro hi
    exact (hi (Finset.mem_univ i)).elim

/-- RiemannRochAna: rank-nullity expresses the kernel dimension of the
principal-class map for an effective divisor. -/
theorem RiemannRochAna_principalClass_kernel_finrank [T2Space C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (hD : ∀ x, 0 ≤ D x) :
    (Module.finrank ℂ
        (LinearMap.ker (RiemannRochAna_principalClassLinear hE D)) : ℤ) =
      b4c_deg D - Module.finrank ℂ
        (LinearMap.range (RiemannRochAna_principalClassLinear hE D)) := by
  have hr := (RiemannRochAna_principalClassLinear hE D).finrank_range_add_finrank_ker
  have hrZ := congrArg (fun n : ℕ ↦ (n : ℤ)) hr
  push_cast at hrZ
  rw [RiemannRochAna_principalData_finrank_effective D hD] at hrZ
  omega

/-- RiemannRochAna: the cokernel dimension of the principal-class map is the
genus minus the dimension of its range. -/
theorem RiemannRochAna_principalClass_cokernel_finrank [T2Space C]
    [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ) :
    (Module.finrank ℂ
        (b4c_Dolbeault01 E C ⧸
          LinearMap.range (RiemannRochAna_principalClassLinear hE D)) : ℤ) =
      Module.finrank ℂ (b3_HolForm E C) -
        Module.finrank ℂ
          (LinearMap.range (RiemannRochAna_principalClassLinear hE D)) := by
  letI := (b4c_dolbeault_finite_aux (E := E) (C := C) hE).1
  have hr := (LinearMap.range
    (RiemannRochAna_principalClassLinear hE D)).finrank_quotient_add_finrank
  have hrZ := congrArg (fun n : ℕ ↦ (n : ℤ)) hr
  push_cast at hrZ
  rw [(b4c_dolbeault_finite_aux (E := E) (C := C) hE).2] at hrZ
  omega

/-- RiemannRochAna: the index of the principal-class map for an effective
divisor equals its degree minus the genus. -/
theorem RiemannRochAna_principalClass_index [T2Space C]
    [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (hD : ∀ x, 0 ≤ D x) :
    (Module.finrank ℂ
        (LinearMap.ker (RiemannRochAna_principalClassLinear hE D)) : ℤ) -
      Module.finrank ℂ
        (b4c_Dolbeault01 E C ⧸
          LinearMap.range (RiemannRochAna_principalClassLinear hE D)) =
      b4c_deg D - Module.finrank ℂ (b3_HolForm E C) := by
  rw [RiemannRochAna_principalClass_kernel_finrank hE D hD,
    RiemannRochAna_principalClass_cokernel_finrank hE D]
  ring

/-- RiemannRochAna: a fixed linear choice of smooth potential for every
conjugate differential in the range. -/
noncomputable def RiemannRochAna_dbarRangeLift :
    LinearMap.range (RiemannRochAna_dbarLinear (E := E) (C := C)) →ₗ[ℂ]
      b4c_SmoothFun E C :=
  Classical.choose
    ((RiemannRochAna_dbarLinear (E := E) (C := C)).rangeRestrict.exists_rightInverse_of_surjective
      (RiemannRochAna_dbarLinear (E := E) (C := C)).range_rangeRestrict)

/-- RiemannRochAna: the selected range potential differentiates to its input. -/
theorem RiemannRochAna_dbarRangeLift_spec
    (β : LinearMap.range (RiemannRochAna_dbarLinear (E := E) (C := C))) :
    RiemannRochAna_dbarLinear
        (RiemannRochAna_dbarRangeLift (E := E) (C := C) β) = β.1 := by
  have h := Classical.choose_spec
    ((RiemannRochAna_dbarLinear (E := E) (C := C)).rangeRestrict.exists_rightInverse_of_surjective
      (RiemannRochAna_dbarLinear (E := E) (C := C)).range_rangeRestrict)
  exact congrArg Subtype.val (LinearMap.congr_fun h β)

/-- RiemannRochAna: zero-class principal data, viewed in the range of the
Dolbeault operator. -/
noncomputable def RiemannRochAna_principalKernelToDbarRange [T2Space C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ) :
    LinearMap.ker (RiemannRochAna_principalClassLinear hE D) →ₗ[ℂ]
      LinearMap.range (RiemannRochAna_dbarLinear (E := E) (C := C)) where
  toFun c := ⟨(RiemannRochAna_principalObstructionLinear hE D c.1).1, by
    obtain ⟨u, hu⟩ := (RiemannRochAna_principalClass_eq_zero_iff hE D c.1).mp c.2
    exact ⟨u, hu⟩⟩
  map_add' c d := by
    apply Subtype.ext
    change (RiemannRochAna_principalObstructionLinear hE D (c.1 + d.1)).1 =
      (RiemannRochAna_principalObstructionLinear hE D c.1).1 +
        (RiemannRochAna_principalObstructionLinear hE D d.1).1
    exact congrArg Subtype.val
      (map_add (RiemannRochAna_principalObstructionLinear hE D) c.1 d.1)
  map_smul' a c := by
    apply Subtype.ext
    change (RiemannRochAna_principalObstructionLinear hE D (a • c.1)).1 =
      a • (RiemannRochAna_principalObstructionLinear hE D c.1).1
    exact congrArg Subtype.val
      (map_smul (RiemannRochAna_principalObstructionLinear hE D) a c.1)

/-- RiemannRochAna: the linearly selected potential for zero-class principal
data has the assembled obstruction as its conjugate differential. -/
theorem RiemannRochAna_principalKernelPotential_spec [T2Space C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (c : LinearMap.ker (RiemannRochAna_principalClassLinear hE D)) :
    b4c_dbar E C
      (RiemannRochAna_dbarRangeLift (E := E) (C := C)
        (RiemannRochAna_principalKernelToDbarRange hE D c)) =
      (RiemannRochAna_principalObstructionLinear hE D c.1).1 := by
  exact RiemannRochAna_dbarRangeLift_spec
    (RiemannRochAna_principalKernelToDbarRange hE D c)

/-- RiemannRochAna: cutoff principal scalars depend linearly on their polar
coefficients. -/
noncomputable def RiemannRochAna_principalScalarLinear [T2Space C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ) :
    RiemannRochAna_PrincipalData D →ₗ[ℂ] C → ℂ where
  toFun c := RiemannRochAna_principalScalar hE D c
  map_add' c d := by
    funext y
    simp only [RiemannRochAna_principalScalar, Pi.add_apply, add_mul,
      Finset.sum_add_distrib]
  map_smul' a c := by
    funext y
    simp only [RiemannRochAna_principalScalar, Pi.smul_apply, smul_eq_mul,
      mul_assoc, Finset.mul_sum, RingHom.id_apply]

/-- RiemannRochAna: evaluation of the linear principal-scalar construction. -/
theorem RiemannRochAna_principalScalarLinear_apply [T2Space C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (c : RiemannRochAna_PrincipalData D) :
    RiemannRochAna_principalScalarLinear hE D c =
      RiemannRochAna_principalScalar hE D c := rfl

/-- RiemannRochAna: restriction of scalar functions to the complement of a
divisor support. -/
def RiemannRochAna_restrictLinear (D : C →₀ ℤ) :
    (C → ℂ) →ₗ[ℂ] ({x : C // x ∉ D.support} → ℂ) where
  toFun f x := f x.1
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- RiemannRochAna: the corrected scalar restriction associated linearly to
zero-class principal data. -/
noncomputable def RiemannRochAna_principalKernelRestriction [T2Space C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ) :
    LinearMap.ker (RiemannRochAna_principalClassLinear hE D) →ₗ[ℂ]
      ({x : C // x ∉ D.support} → ℂ) :=
  ((RiemannRochAna_restrictLinear D).comp
      ((RiemannRochAna_principalScalarLinear hE D).comp
        (LinearMap.ker (RiemannRochAna_principalClassLinear hE D)).subtype)) -
    ((RiemannRochAna_restrictLinear D).comp
      ((b4c_SmoothFun E C).subtype.comp
        ((RiemannRochAna_dbarRangeLift (E := E) (C := C)).comp
          (RiemannRochAna_principalKernelToDbarRange hE D))))

/-- RiemannRochAna: evaluation of the corrected restriction uses the selected
linear Dolbeault potential. -/
theorem RiemannRochAna_principalKernelRestriction_apply [T2Space C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (c : LinearMap.ker (RiemannRochAna_principalClassLinear hE D))
    (x : {x : C // x ∉ D.support}) :
    RiemannRochAna_principalKernelRestriction hE D c x =
      RiemannRochAna_correctedPrincipal hE D c.1
        (RiemannRochAna_dbarRangeLift (E := E) (C := C)
          (RiemannRochAna_principalKernelToDbarRange hE D c)) x.1 := by
  rfl

/-- RiemannRochAna: the centered coordinate composed with the centered inverse
chart is locally the identity. -/
theorem RiemannRochAna_coordinate_centered_symm_germ
    (hE : Module.finrank ℂ E = 1) (x : C) :
    (fun t : ℂ ↦ RiemannRochAna_coordinate hE x
      ((extChartAt 𝓘(ℂ, E) x).symm
        (extChartAt 𝓘(ℂ, E) x x + b4cov_lineEquiv hE t))) =ᶠ[𝓝 0]
      id := by
  have ht : ∀ᶠ t in 𝓝 (0 : ℂ),
      extChartAt 𝓘(ℂ, E) x x + b4cov_lineEquiv hE t ∈
        (extChartAt 𝓘(ℂ, E) x).target := by
    apply (continuousAt_const.add
      (b4cov_lineEquiv hE).continuous.continuousAt).preimage_mem_nhds
    convert (isOpen_extChartAt_target (I := 𝓘(ℂ, E)) x).mem_nhds
      (mem_extChartAt_target (I := 𝓘(ℂ, E)) x) using 1 <;> simp
  filter_upwards [ht] with t ht
  simp only [RiemannRochAna_coordinate, id_eq]
  rw [(extChartAt 𝓘(ℂ, E) x).right_inv ht]
  rw [add_sub_cancel_left, ContinuousLinearEquiv.symm_apply_apply]

/-- RiemannRochAna: the centered inverse chart is analytic at the origin. -/
theorem RiemannRochAna_centered_symm_analytic
    (hE : Module.finrank ℂ E = 1) (x : C) :
    ContMDiffAt 𝓘(ℂ, ℂ) 𝓘(ℂ, E) ω
      (fun t : ℂ ↦ (extChartAt 𝓘(ℂ, E) x).symm
        (extChartAt 𝓘(ℂ, E) x x + b4cov_lineEquiv hE t)) 0 := by
  have hs : ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, E) ω
      (extChartAt 𝓘(ℂ, E) x).symm (extChartAt 𝓘(ℂ, E) x x) :=
    (contMDiffWithinAt_extChartAt_symm_target_self (I := 𝓘(ℂ, E)) x).contMDiffAt
      ((isOpen_extChartAt_target (I := 𝓘(ℂ, E)) x).mem_nhds
        (mem_extChartAt_target (I := 𝓘(ℂ, E)) x))
  have hs' : ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, E) ω
      (extChartAt 𝓘(ℂ, E) x).symm
        (extChartAt 𝓘(ℂ, E) x x + b4cov_lineEquiv hE 0) := by
    simpa only [map_zero, add_zero] using hs
  exact hs'.comp 0 (contMDiffAt_const.add
    (b4cov_lineEquiv hE).contDiff.contMDiff.contMDiffAt)

/-- RiemannRochAna: a finite polar polynomial is meromorphic in its centered
surface coordinate. -/
theorem RiemannRochAna_principalPartAt_meromorphic
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (c : RiemannRochAna_PrincipalData D) (i : D.support) :
    MeromorphicAt (fun t : ℂ ↦ RiemannRochAna_principalPartAt hE D c i
      ((extChartAt 𝓘(ℂ, E) i.1).symm
        (extChartAt 𝓘(ℂ, E) i.1 i.1 + b4cov_lineEquiv hE t))) 0 := by
  let g : ℂ → ℂ := fun t ↦ ∑ n, c i n / t ^ ((n : ℕ) + 1)
  have hg : MeromorphicAt g 0 := by
    rw [show g = ∑ n, fun t ↦ c i n / t ^ ((n : ℕ) + 1) by
      funext t
      simp only [g, Finset.sum_apply]]
    apply MeromorphicAt.sum
    intro n _
    exact analyticAt_const.meromorphicAt.div
      ((analyticAt_id (𝕜 := ℂ)).pow ((n : ℕ) + 1)).meromorphicAt
  apply (MeromorphicAt.meromorphicAt_congr ?_).mpr hg
  filter_upwards [(RiemannRochAna_coordinate_centered_symm_germ hE i.1).filter_mono
    nhdsWithin_le_nhds] with t ht
  simp only [RiemannRochAna_principalPartAt, g, ht, id_eq]

/-- RiemannRochAna: a corrected zero-class principal representative is
meromorphic in the centered chart at each divisor point. -/
theorem RiemannRochAna_correctedPrincipal_meromorphic_at_support [T2Space C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (c : LinearMap.ker (RiemannRochAna_principalClassLinear hE D))
    (i : D.support) :
    MeromorphicAt (fun t : ℂ ↦
      RiemannRochAna_correctedPrincipal hE D c.1
        (RiemannRochAna_dbarRangeLift (E := E) (C := C)
          (RiemannRochAna_principalKernelToDbarRange hE D c))
        ((extChartAt 𝓘(ℂ, E) i.1).symm
          (extChartAt 𝓘(ℂ, E) i.1 i.1 + b4cov_lineEquiv hE t))) 0 := by
  let u := RiemannRochAna_dbarRangeLift (E := E) (C := C)
    (RiemannRochAna_principalKernelToDbarRange hE D c)
  let A : ℂ → C := fun t ↦ (extChartAt 𝓘(ℂ, E) i.1).symm
    (extChartAt 𝓘(ℂ, E) i.1 i.1 + b4cov_lineEquiv hE t)
  have hA := RiemannRochAna_centered_symm_analytic hE i.1
  have hA0 : A 0 = i.1 := by
    simp only [A, map_zero, add_zero]
    exact (extChartAt 𝓘(ℂ, E) i.1).left_inv (mem_extChartAt_source i.1)
  have hu : ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω (u : C → ℂ) i.1 :=
    RiemannRochAna_principalPotential_analytic hE D c.1 u
      (RiemannRochAna_principalKernelPotential_spec hE D c) i
  have huA : AnalyticAt ℂ (fun t ↦ (u : C → ℂ) (A t)) 0 := by
    have hA' : ContMDiffAt 𝓘(ℂ, ℂ) 𝓘(ℂ, E) ω A 0 := hA
    have hu' : ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω (u : C → ℂ) (A 0) := by
      rw [hA0]
      exact hu
    have hc : ContMDiffAt 𝓘(ℂ, ℂ) 𝓘(ℂ, ℂ) ω
        (fun t ↦ (u : C → ℂ) (A t)) 0 := by
      exact hu'.comp 0 hA'
    exact (contMDiffAt_iff_contDiffAt.mp hc).analyticAt
  have hm := (RiemannRochAna_principalPartAt_meromorphic hE D c.1 i).sub
    huA.meromorphicAt
  apply (MeromorphicAt.meromorphicAt_congr ?_).mpr hm
  have ht : Tendsto A (𝓝 0) (𝓝 i.1) := by
    have hA' : ContMDiffAt 𝓘(ℂ, ℂ) 𝓘(ℂ, E) ω A 0 := hA
    have ht' := hA'.continuousAt.tendsto
    rwa [hA0] at ht'
  exact ((RiemannRochAna_correctedPrincipal_germ hE D c.1 u i).comp_tendsto ht).filter_mono
    nhdsWithin_le_nhds

/-- RiemannRochAna: a corrected zero-class principal representative is
meromorphic in the centered chart at every surface point. -/
theorem RiemannRochAna_correctedPrincipal_meromorphic [T2Space C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (c : LinearMap.ker (RiemannRochAna_principalClassLinear hE D)) (x : C) :
    MeromorphicAt (fun t : ℂ ↦
      RiemannRochAna_correctedPrincipal hE D c.1
        (RiemannRochAna_dbarRangeLift (E := E) (C := C)
          (RiemannRochAna_principalKernelToDbarRange hE D c))
        ((extChartAt 𝓘(ℂ, E) x).symm
          (extChartAt 𝓘(ℂ, E) x x + b4cov_lineEquiv hE t))) 0 := by
  by_cases hx : x ∈ D.support
  · exact RiemannRochAna_correctedPrincipal_meromorphic_at_support hE D c ⟨x, hx⟩
  · let u := RiemannRochAna_dbarRangeLift (E := E) (C := C)
      (RiemannRochAna_principalKernelToDbarRange hE D c)
    let A : ℂ → C := fun t ↦ (extChartAt 𝓘(ℂ, E) x).symm
      (extChartAt 𝓘(ℂ, E) x x + b4cov_lineEquiv hE t)
    have hA : ContMDiffAt 𝓘(ℂ, ℂ) 𝓘(ℂ, E) ω A 0 :=
      RiemannRochAna_centered_symm_analytic hE x
    have hA0 : A 0 = x := by
      simp only [A, map_zero, add_zero]
      exact (extChartAt 𝓘(ℂ, E) x).left_inv (mem_extChartAt_source x)
    have hc := RiemannRochAna_correctedPrincipal_analytic hE D c.1 u
      (RiemannRochAna_principalKernelPotential_spec hE D c) x hx
    have hc' : ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω
        (RiemannRochAna_correctedPrincipal hE D c.1 u) (A 0) := by
      rw [hA0]
      exact hc
    exact (contMDiffAt_iff_contDiffAt.mp (hc'.comp 0 hA)).analyticAt.meromorphicAt

/-- RiemannRochAna: a corrected zero-class principal representative
normalizes to a meromorphic sphere map with the same regular values. -/
theorem RiemannRochAna_principalKernel_normalize [T2Space C] [Nonempty C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (c : LinearMap.ker (RiemannRochAna_principalClassLinear hE D)) :
    ∃ F : b4c_MeroFun E C, ∀ x, x ∉ D.support →
      F x = ((RiemannRochAna_correctedPrincipal hE D c.1
        (RiemannRochAna_dbarRangeLift (E := E) (C := C)
          (RiemannRochAna_principalKernelToDbarRange hE D c)) x : ℂ) : OnePoint ℂ) := by
  let u := RiemannRochAna_dbarRangeLift (E := E) (C := C)
    (RiemannRochAna_principalKernelToDbarRange hE D c)
  let f := RiemannRochAna_correctedPrincipal hE D c.1 (u : C → ℂ)
  obtain ⟨x₀, hx₀⟩ := RiemannRochAna_exists_unmarked hE (Classical.arbitrary C)
    (fun i : D.support ↦ i.1)
  have hx₀' : x₀ ∉ D.support := by
    intro hx
    exact hx₀ ⟨⟨x₀, hx⟩, rfl⟩
  have hcont (x : C) (hx : x ∉ D.support) : ContinuousAt f x :=
    (RiemannRochAna_correctedPrincipal_analytic hE D c.1 u
      (RiemannRochAna_principalKernelPotential_spec hE D c) x hx).continuousAt
  obtain ⟨F, _, hF⟩ := RiemannRochAna_normalize_to_meroFun hE f
    (RiemannRochAna_correctedPrincipal_meromorphic hE D c) x₀ (hcont x₀ hx₀')
  refine ⟨F, ?_⟩
  intro x hx
  exact hF x (hcont x hx)

/-- RiemannRochAna: normalization of a corrected principal representative
also retains its punctured scalar germs. -/
theorem RiemannRochAna_principalKernel_normalize_germ [T2Space C] [Nonempty C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (c : LinearMap.ker (RiemannRochAna_principalClassLinear hE D)) :
    ∃ F : b4c_MeroFun E C,
      (∀ x, ∀ᶠ y in 𝓝[≠] x, F y =
        ((RiemannRochAna_correctedPrincipal hE D c.1
          (RiemannRochAna_dbarRangeLift (E := E) (C := C)
            (RiemannRochAna_principalKernelToDbarRange hE D c)) y : ℂ) : OnePoint ℂ)) ∧
      ∀ x, x ∉ D.support → F x =
        ((RiemannRochAna_correctedPrincipal hE D c.1
          (RiemannRochAna_dbarRangeLift (E := E) (C := C)
            (RiemannRochAna_principalKernelToDbarRange hE D c)) x : ℂ) : OnePoint ℂ) := by
  let u := RiemannRochAna_dbarRangeLift (E := E) (C := C)
    (RiemannRochAna_principalKernelToDbarRange hE D c)
  let f := RiemannRochAna_correctedPrincipal hE D c.1 (u : C → ℂ)
  obtain ⟨x₀, hx₀⟩ := RiemannRochAna_exists_unmarked hE (Classical.arbitrary C)
    (fun i : D.support ↦ i.1)
  have hx₀' : x₀ ∉ D.support := by
    intro hx
    exact hx₀ ⟨⟨x₀, hx⟩, rfl⟩
  have hcont (x : C) (hx : x ∉ D.support) : ContinuousAt f x :=
    (RiemannRochAna_correctedPrincipal_analytic hE D c.1 u
      (RiemannRochAna_principalKernelPotential_spec hE D c) x hx).continuousAt
  obtain ⟨F, hFgerm, hFval⟩ := RiemannRochAna_normalize_to_meroFun hE f
    (RiemannRochAna_correctedPrincipal_meromorphic hE D c) x₀ (hcont x₀ hx₀')
  exact ⟨F, hFgerm, fun x hx ↦ hFval x (hcont x hx)⟩

/-- RiemannRochAna: a common lower bound for the orders of finitely many
meromorphic functions is a lower bound for the order of their sum. -/
theorem RiemannRochAna_meromorphicOrderAt_sum_lower {ι : Type} [DecidableEq ι]
    (s : Finset ι) (f : ι → ℂ → ℂ) (m : WithTop ℤ)
    (hf : ∀ i ∈ s, MeromorphicAt (f i) 0)
    (hm : ∀ i ∈ s, m ≤ meromorphicOrderAt (f i) 0) :
    m ≤ meromorphicOrderAt (∑ i ∈ s, f i) 0 := by
  induction s using Finset.induction_on with
  | empty => simp
  | @insert i s hi ih =>
      rw [Finset.sum_insert hi]
      exact le_trans (le_min (hm i (Finset.mem_insert_self i s))
          (ih (fun j hj ↦ hf j (Finset.mem_insert_of_mem hj))
            (fun j hj ↦ hm j (Finset.mem_insert_of_mem hj))))
        (meromorphicOrderAt_add (hf i (Finset.mem_insert_self i s))
          (MeromorphicAt.sum fun j hj ↦ hf j (Finset.mem_insert_of_mem hj)))

/-- RiemannRochAna: every polar monomial indexed below an effective
multiplicity has order at least the negative multiplicity. -/
theorem RiemannRochAna_polarMonomial_order_lower (d : ℤ) (hd : 0 ≤ d)
    (n : Fin (Int.toNat d)) (a : ℂ) :
    ((-d : ℤ) : WithTop ℤ) ≤
      meromorphicOrderAt (fun t : ℂ ↦ a / t ^ ((n : ℕ) + 1)) 0 := by
  by_cases ha : a = 0
  · subst a
    rw [show (fun t : ℂ ↦ 0 / t ^ ((n : ℕ) + 1)) = 0 by
      funext t
      simp]
    simp
  change ((-d : ℤ) : WithTop ℤ) ≤
    meromorphicOrderAt ((fun _ : ℂ ↦ a) / (id ^ ((n : ℕ) + 1))) 0
  rw [meromorphicOrderAt_div analyticAt_const.meromorphicAt
    ((analyticAt_id (𝕜 := ℂ)).pow ((n : ℕ) + 1)).meromorphicAt,
    meromorphicOrderAt_const, if_neg ha,
    meromorphicOrderAt_pow ((analyticAt_id (𝕜 := ℂ)).meromorphicAt)]
  simp only [meromorphicOrderAt_id, WithTop.coe_zero, ENat.some_eq_coe,
    nsmul_eq_mul, zero_sub]
  have hn : (n : ℕ) + 1 ≤ Int.toNat d := n.isLt
  have hnZ : (((n : ℕ) + 1 : ℕ) : ℤ) ≤ d := by
    calc
      (((n : ℕ) + 1 : ℕ) : ℤ) ≤ (Int.toNat d : ℕ) := by exact_mod_cast hn
      _ = d := Int.toNat_of_nonneg hd
  have hw : ((-d : ℤ) : WithTop ℤ) ≤
      ((-(((n : ℕ) + 1 : ℕ) : ℤ) : ℤ) : WithTop ℤ) :=
    WithTop.coe_le_coe.mpr (neg_le_neg hnZ)
  convert hw using 1 <;> simp

/-- RiemannRochAna: the polar polynomial at a point of an effective divisor
has order at least the negative divisor multiplicity. -/
theorem RiemannRochAna_principalPartAt_order_lower
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (hD : ∀ x, 0 ≤ D x) (c : RiemannRochAna_PrincipalData D)
    (i : D.support) :
    ((-D i.1 : ℤ) : WithTop ℤ) ≤
      meromorphicOrderAt (fun t : ℂ ↦ RiemannRochAna_principalPartAt hE D c i
        ((extChartAt 𝓘(ℂ, E) i.1).symm
          (extChartAt 𝓘(ℂ, E) i.1 i.1 + b4cov_lineEquiv hE t))) 0 := by
  let g : ℂ → ℂ := fun t ↦ ∑ n, c i n / t ^ ((n : ℕ) + 1)
  have hg : ((-D i.1 : ℤ) : WithTop ℤ) ≤ meromorphicOrderAt g 0 := by
    rw [show g = ∑ n, fun t ↦ c i n / t ^ ((n : ℕ) + 1) by
      funext t
      simp only [g, Finset.sum_apply]]
    apply RiemannRochAna_meromorphicOrderAt_sum_lower Finset.univ _ _
    · intro n _
      exact analyticAt_const.meromorphicAt.div
        ((analyticAt_id (𝕜 := ℂ)).pow ((n : ℕ) + 1)).meromorphicAt
    · intro n _
      exact RiemannRochAna_polarMonomial_order_lower (D i.1) (hD i.1) n (c i n)
  have he : (fun t : ℂ ↦ RiemannRochAna_principalPartAt hE D c i
      ((extChartAt 𝓘(ℂ, E) i.1).symm
        (extChartAt 𝓘(ℂ, E) i.1 i.1 + b4cov_lineEquiv hE t))) =ᶠ[𝓝[≠] 0] g := by
    filter_upwards [(RiemannRochAna_coordinate_centered_symm_germ hE i.1).filter_mono
      nhdsWithin_le_nhds] with t ht
    simp only [RiemannRochAna_principalPartAt, g, ht, id_eq]
  rw [meromorphicOrderAt_congr he]
  exact hg

/-- RiemannRochAna: subtracting the analytic potential preserves the divisor
order bound of a corrected principal representative. -/
theorem RiemannRochAna_correctedPrincipal_order_lower [T2Space C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (hD : ∀ x, 0 ≤ D x)
    (c : LinearMap.ker (RiemannRochAna_principalClassLinear hE D))
    (i : D.support) :
    ((-D i.1 : ℤ) : WithTop ℤ) ≤ meromorphicOrderAt (fun t : ℂ ↦
      RiemannRochAna_correctedPrincipal hE D c.1
        (RiemannRochAna_dbarRangeLift (E := E) (C := C)
          (RiemannRochAna_principalKernelToDbarRange hE D c))
        ((extChartAt 𝓘(ℂ, E) i.1).symm
          (extChartAt 𝓘(ℂ, E) i.1 i.1 + b4cov_lineEquiv hE t))) 0 := by
  let u := RiemannRochAna_dbarRangeLift (E := E) (C := C)
    (RiemannRochAna_principalKernelToDbarRange hE D c)
  let A : ℂ → C := fun t ↦ (extChartAt 𝓘(ℂ, E) i.1).symm
    (extChartAt 𝓘(ℂ, E) i.1 i.1 + b4cov_lineEquiv hE t)
  have hA := RiemannRochAna_centered_symm_analytic hE i.1
  have hA0 : A 0 = i.1 := by
    simp only [A, map_zero, add_zero]
    exact (extChartAt 𝓘(ℂ, E) i.1).left_inv (mem_extChartAt_source i.1)
  have hu : ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω (u : C → ℂ) i.1 :=
    RiemannRochAna_principalPotential_analytic hE D c.1 u
      (RiemannRochAna_principalKernelPotential_spec hE D c) i
  have huA : AnalyticAt ℂ (fun t ↦ (u : C → ℂ) (A t)) 0 := by
    have hu' : ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω (u : C → ℂ) (A 0) := by
      rw [hA0]
      exact hu
    exact (contMDiffAt_iff_contDiffAt.mp (hu'.comp 0 hA)).analyticAt
  have hp := RiemannRochAna_principalPartAt_order_lower hE D hD c.1 i
  have hm0 : ((-D i.1 : ℤ) : WithTop ℤ) ≤ 0 := by
    exact_mod_cast (neg_nonpos.mpr (hD i.1))
  have hmu : ((-D i.1 : ℤ) : WithTop ℤ) ≤
      meromorphicOrderAt (-(fun t ↦ (u : C → ℂ) (A t))) 0 := by
    apply hm0.trans
    rw [← meromorphicOrderAt_neg]
    exact huA.meromorphicOrderAt_nonneg
  have hs : ((-D i.1 : ℤ) : WithTop ℤ) ≤ meromorphicOrderAt
      ((fun t ↦ RiemannRochAna_principalPartAt hE D c.1 i (A t)) +
        -(fun t ↦ (u : C → ℂ) (A t))) 0 :=
    (le_min hp hmu).trans (meromorphicOrderAt_add
      (RiemannRochAna_principalPartAt_meromorphic hE D c.1 i)
      huA.neg.meromorphicAt)
  have he : (fun t : ℂ ↦ RiemannRochAna_correctedPrincipal hE D c.1 u (A t))
      =ᶠ[𝓝[≠] 0] (fun t ↦ RiemannRochAna_principalPartAt hE D c.1 i (A t)) +
        -(fun t ↦ (u : C → ℂ) (A t)) := by
    have ht : Tendsto A (𝓝 0) (𝓝 i.1) := by
      convert hA.continuousAt.tendsto using 1
      exact congrArg (fun x ↦ 𝓝 x) hA0.symm
    filter_upwards [((RiemannRochAna_correctedPrincipal_germ hE D c.1 u i).comp_tendsto
      ht).filter_mono nhdsWithin_le_nhds] with t ht
    simpa only [Function.comp_apply, Pi.add_apply, Pi.neg_apply, sub_eq_add_neg] using ht
  rw [meromorphicOrderAt_congr he]
  exact hs

/-- RiemannRochAna: a normalized sphere map has the local scalar order of
the corrected principal representative whose germs it retains. -/
theorem RiemannRochAna_principalNormalization_order
    [T2Space C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (c : LinearMap.ker (RiemannRochAna_principalClassLinear hE D))
    (F : b4c_MeroFun E C)
    (hF : ∀ x, ∀ᶠ y in 𝓝[≠] x, F y =
      ((RiemannRochAna_correctedPrincipal hE D c.1
        (RiemannRochAna_dbarRangeLift (E := E) (C := C)
          (RiemannRochAna_principalKernelToDbarRange hE D c)) y : ℂ) : OnePoint ℂ))
    (x : C) :
    meromorphicOrderAt (RiemannRochAna_functionLocal hE F x) 0 =
      meromorphicOrderAt (fun t : ℂ ↦
        RiemannRochAna_correctedPrincipal hE D c.1
          (RiemannRochAna_dbarRangeLift (E := E) (C := C)
            (RiemannRochAna_principalKernelToDbarRange hE D c))
          ((extChartAt 𝓘(ℂ, E) x).symm
            (extChartAt 𝓘(ℂ, E) x x + b4cov_lineEquiv hE t))) 0 := by
  apply meromorphicOrderAt_congr
  exact RiemannRochAna_normalization_local_germ hE _ F x (hF x)

/-- RiemannRochAna: an effective divisor bounds the corrected principal
representative in every centred chart. -/
theorem RiemannRochAna_correctedPrincipal_order_lower_all [T2Space C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (hD : ∀ x, 0 ≤ D x)
    (c : LinearMap.ker (RiemannRochAna_principalClassLinear hE D))
    (x : C) :
    ((-D x : ℤ) : WithTop ℤ) ≤ meromorphicOrderAt (fun t : ℂ ↦
      RiemannRochAna_correctedPrincipal hE D c.1
        (RiemannRochAna_dbarRangeLift (E := E) (C := C)
          (RiemannRochAna_principalKernelToDbarRange hE D c))
        ((extChartAt 𝓘(ℂ, E) x).symm
          (extChartAt 𝓘(ℂ, E) x x + b4cov_lineEquiv hE t))) 0 := by
  by_cases hx : x ∈ D.support
  · exact RiemannRochAna_correctedPrincipal_order_lower hE D hD c ⟨x, hx⟩
  · have hx0 : D x = 0 := by
      simpa [Finsupp.mem_support_iff] using hx
    rw [hx0]
    simp only [neg_zero, WithTop.coe_zero]
    let u := RiemannRochAna_dbarRangeLift (E := E) (C := C)
      (RiemannRochAna_principalKernelToDbarRange hE D c)
    let A : ℂ → C := fun t ↦ (extChartAt 𝓘(ℂ, E) x).symm
      (extChartAt 𝓘(ℂ, E) x x + b4cov_lineEquiv hE t)
    have hA : ContMDiffAt 𝓘(ℂ, ℂ) 𝓘(ℂ, E) ω A 0 :=
      RiemannRochAna_centered_symm_analytic hE x
    have hA0 : A 0 = x := by
      simp only [A, map_zero, add_zero]
      exact (extChartAt 𝓘(ℂ, E) x).left_inv (mem_extChartAt_source x)
    have hc := RiemannRochAna_correctedPrincipal_analytic hE D c.1 u
      (RiemannRochAna_principalKernelPotential_spec hE D c) x hx
    have hc' : ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω
        (RiemannRochAna_correctedPrincipal hE D c.1 u) (A 0) := by
      rw [hA0]
      exact hc
    exact (contMDiffAt_iff_contDiffAt.mp (hc'.comp 0 hA)).analyticAt
      |>.meromorphicOrderAt_nonneg

/-- RiemannRochAna: a nonzero normalization of effective principal data
satisfies the integral divisor-order inequalities. -/
theorem RiemannRochAna_principalNormalization_divisor_bound
    [T2Space C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (hD : ∀ x, 0 ≤ D x)
    (c : LinearMap.ker (RiemannRochAna_principalClassLinear hE D))
    (F : b4c_MeroFun E C)
    (hFgerm : ∀ x, ∀ᶠ y in 𝓝[≠] x, F y =
      ((RiemannRochAna_correctedPrincipal hE D c.1
        (RiemannRochAna_dbarRangeLift (E := E) (C := C)
          (RiemannRochAna_principalKernelToDbarRange hE D c)) y : ℂ) : OnePoint ℂ))
    (hFn : ∃ x, F x ≠ (0 : ℂ)) (x : C) :
    0 ≤ b4c_ord E F x + D x := by
  have hw := RiemannRochAna_correctedPrincipal_order_lower_all hE D hD c x
  rw [← RiemannRochAna_principalNormalization_order hE D c F hFgerm x,
    ← RiemannRochAna_ord_eq_local hE F hFn x] at hw
  have hwZ : -D x ≤ b4c_ord E F x := WithTop.coe_le_coe.mp hw
  omega

/-- RiemannRochAna: corrected zero-class principal data for an effective
divisor restricts to its Riemann--Roch space. -/
theorem RiemannRochAna_principalKernelRestriction_mem
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (hD : ∀ x, 0 ≤ D x)
    (c : LinearMap.ker (RiemannRochAna_principalClassLinear hE D)) :
    RiemannRochAna_principalKernelRestriction hE D c ∈ b4c_L (E := E) D := by
  change RiemannRochAna_principalKernelRestriction hE D c ∈
    (b4c_L (E := E) D : Set ({x : C // x ∉ D.support} → ℂ))
  rw [b4c_L_eq_restrictions_aux hE D]
  by_cases hg : RiemannRochAna_principalKernelRestriction hE D c = 0
  · exact Or.inl hg
  · right
    have hx : ∃ x, RiemannRochAna_principalKernelRestriction hE D c x ≠ 0 := by
      by_contra hn
      apply hg
      funext x
      exact not_ne_iff.mp (not_exists.mp hn x)
    obtain ⟨x, hx⟩ := hx
    letI : Nonempty C := ⟨x.1⟩
    obtain ⟨F, hFgerm, hFval⟩ :=
      RiemannRochAna_principalKernel_normalize_germ hE D c
    have hFn : ∃ y, F y ≠ (0 : ℂ) := by
      refine ⟨x.1, ?_⟩
      rw [hFval x.1 x.2]
      intro hz
      apply hx
      rw [RiemannRochAna_principalKernelRestriction_apply]
      exact OnePoint.coe_injective hz
    refine ⟨F, hFn, ?_, ?_, ?_⟩
    · intro y hy
      rw [hFval y hy]
      exact OnePoint.coe_ne_infty _
    · exact RiemannRochAna_principalNormalization_divisor_bound
        hE D hD c F hFgerm hFn
    · funext y
      rw [RiemannRochAna_principalKernelRestriction_apply, hFval y.1 y.2]
      rfl

/-- RiemannRochAna: constant restrictions belong to the Riemann--Roch space
of an effective divisor. -/
theorem RiemannRochAna_constantRestriction_mem
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (hD : ∀ x, 0 ≤ D x) (a : ℂ) :
    (fun _ : {x : C // x ∉ D.support} ↦ a) ∈ b4c_L (E := E) D := by
  classical
  by_cases hC : Nonempty C
  · letI := hC
    by_cases ha : a = 0
    · subst a
      exact (b4c_L (E := E) D).zero_mem
    · change (fun _ : {x : C // x ∉ D.support} ↦ a) ∈
        (b4c_L (E := E) D : Set ({x : C // x ∉ D.support} → ℂ))
      rw [b4c_L_eq_restrictions_aux hE D]
      right
      let F : b4c_MeroFun E C :=
        ⟨fun _ ↦ (a : OnePoint ℂ), contMDiff_const, Classical.arbitrary C,
          OnePoint.coe_ne_infty a⟩
      have hFn : ∃ x, F x ≠ (0 : ℂ) := by
        exact ⟨Classical.arbitrary C, OnePoint.coe_injective.ne ha⟩
      refine ⟨F, hFn, fun _ _ ↦ OnePoint.coe_ne_infty a, ?_, ?_⟩
      · intro x
        have ho := RiemannRochAna_ord_eq_local hE F hFn x
        have he : RiemannRochAna_functionLocal hE F x = fun _ ↦ a := by
          funext t
          rfl
        rw [he, meromorphicOrderAt_const, if_neg ha] at ho
        have ho0 : b4c_ord E F x = 0 := by
          exact_mod_cast ho
        rw [ho0, zero_add]
        exact hD x
      · funext x
        rfl
  · haveI : IsEmpty C := not_nonempty_iff.mp hC
    convert (b4c_L (E := E) D).zero_mem using 1
    funext x
    exact isEmptyElim x.1

/-- RiemannRochAna: constants and corrected principal data combine linearly
inside the space of an effective divisor. -/
noncomputable def RiemannRochAna_effectiveParameterLinear
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (hD : ∀ x, 0 ≤ D x) :
    ℂ × LinearMap.ker (RiemannRochAna_principalClassLinear hE D) →ₗ[ℂ]
      b4c_L (E := E) D where
  toFun p := ⟨fun x ↦ p.1 + RiemannRochAna_principalKernelRestriction hE D p.2 x,
    (b4c_L (E := E) D).add_mem
      (RiemannRochAna_constantRestriction_mem hE D hD p.1)
      (RiemannRochAna_principalKernelRestriction_mem hE D hD p.2)⟩
  map_add' p q := by
    ext x
    have hr : RiemannRochAna_principalKernelRestriction hE D (p.2 + q.2) x =
        RiemannRochAna_principalKernelRestriction hE D p.2 x +
          RiemannRochAna_principalKernelRestriction hE D q.2 x := by
      simpa only [Pi.add_apply] using congrArg (fun f ↦ f x)
        (map_add (RiemannRochAna_principalKernelRestriction hE D) p.2 q.2)
    simp only [Prod.fst_add, Prod.snd_add, Submodule.coe_add, Pi.add_apply]
    rw [hr]
    ring
  map_smul' a p := by
    ext x
    have hr : RiemannRochAna_principalKernelRestriction hE D (a • p.2) x =
        a * RiemannRochAna_principalKernelRestriction hE D p.2 x := by
      simpa only [Pi.smul_apply, smul_eq_mul] using congrArg (fun f ↦ f x)
        (map_smul (RiemannRochAna_principalKernelRestriction hE D) a p.2)
    simp only [Prod.smul_fst, Prod.smul_snd, Submodule.coe_smul,
      Pi.smul_apply, smul_eq_mul, RingHom.id_apply]
    rw [hr]
    ring

@[simp] theorem RiemannRochAna_effectiveParameterLinear_apply
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (hD : ∀ x, 0 ≤ D x)
    (p : ℂ × LinearMap.ker (RiemannRochAna_principalClassLinear hE D))
    (x : {x : C // x ∉ D.support}) :
    ((RiemannRochAna_effectiveParameterLinear hE D hD p : b4c_L (E := E) D) :
      {x : C // x ∉ D.support} → ℂ) x =
      p.1 + RiemannRochAna_principalKernelRestriction hE D p.2 x := rfl

/-- RiemannRochAna: a strict common lower bound for finitely many meromorphic
orders remains strict for their sum. -/
theorem RiemannRochAna_meromorphicOrderAt_sum_strict_lower
    {ι : Type} [DecidableEq ι] (s : Finset ι) (f : ι → ℂ → ℂ)
    (m : WithTop ℤ) (hmTop : m ≠ ⊤) (hf : ∀ i ∈ s, MeromorphicAt (f i) 0)
    (hm : ∀ i ∈ s, m < meromorphicOrderAt (f i) 0) :
    m < meromorphicOrderAt (∑ i ∈ s, f i) 0 := by
  induction s using Finset.induction_on with
  | empty => simpa using (WithTop.lt_top_iff_ne_top.mpr hmTop)
  | @insert i s hi ih =>
      rw [Finset.sum_insert hi]
      exact lt_of_lt_of_le (lt_min (hm i (Finset.mem_insert_self i s))
          (ih (fun j hj ↦ hf j (Finset.mem_insert_of_mem hj))
            (fun j hj ↦ hm j (Finset.mem_insert_of_mem hj))))
        (meromorphicOrderAt_add (hf i (Finset.mem_insert_self i s))
          (MeromorphicAt.sum fun j hj ↦ hf j (Finset.mem_insert_of_mem hj)))

/-- RiemannRochAna: a unique finite summand of lowest meromorphic order
determines the order of the sum. -/
theorem RiemannRochAna_meromorphicOrderAt_sum_eq_of_unique_min
    {ι : Type} [DecidableEq ι] (s : Finset ι) (f : ι → ℂ → ℂ) (i : ι)
    (hi : i ∈ s) (hf : ∀ j ∈ s, MeromorphicAt (f j) 0)
    (hfin : meromorphicOrderAt (f i) 0 ≠ ⊤)
    (hmin : ∀ j ∈ s, j ≠ i →
      meromorphicOrderAt (f i) 0 < meromorphicOrderAt (f j) 0) :
    meromorphicOrderAt (∑ j ∈ s, f j) 0 = meromorphicOrderAt (f i) 0 := by
  have hr : meromorphicOrderAt (f i) 0 <
      meromorphicOrderAt (∑ j ∈ s.erase i, f j) 0 :=
    RiemannRochAna_meromorphicOrderAt_sum_strict_lower (s.erase i) f _ hfin
      (fun j hj ↦ hf j (Finset.mem_of_mem_erase hj))
      (fun j hj ↦ hmin j (Finset.mem_of_mem_erase hj)
        (Finset.ne_of_mem_erase hj))
  rw [← Finset.add_sum_erase _ _ hi]
  exact meromorphicOrderAt_add_eq_left_of_lt
    (MeromorphicAt.sum fun j hj ↦ hf j (Finset.mem_of_mem_erase hj)) hr

/-- RiemannRochAna: a nonzero polar monomial has the expected negative
meromorphic order. -/
theorem RiemannRochAna_polarMonomial_order_eq (n : ℕ) (a : ℂ) (ha : a ≠ 0) :
    meromorphicOrderAt (fun t : ℂ ↦ a / t ^ (n + 1)) 0 =
      ((-((n + 1 : ℕ) : ℤ) : ℤ) : WithTop ℤ) := by
  change meromorphicOrderAt ((fun _ : ℂ ↦ a) / (id ^ (n + 1))) 0 = _
  rw [meromorphicOrderAt_div analyticAt_const.meromorphicAt
    ((analyticAt_id (𝕜 := ℂ)).pow (n + 1)).meromorphicAt,
    meromorphicOrderAt_const, if_neg ha,
    meromorphicOrderAt_pow ((analyticAt_id (𝕜 := ℂ)).meromorphicAt)]
  simp

/-- RiemannRochAna: a nonzero finite polar polynomial has negative order at
the origin. -/
theorem RiemannRochAna_polarPolynomial_order_neg (d : ℕ) (c : Fin d → ℂ)
    (hc : c ≠ 0) :
    meromorphicOrderAt (fun t : ℂ ↦ ∑ n, c n / t ^ ((n : ℕ) + 1)) 0 < 0 := by
  classical
  let s : Finset (Fin d) := Finset.univ.filter fun n ↦ c n ≠ 0
  have hs : s.Nonempty := by
    by_contra hs0
    apply hc
    funext n
    by_contra hn
    exact hs0 ⟨n, Finset.mem_filter.mpr ⟨Finset.mem_univ n, hn⟩⟩
  obtain ⟨n, hn, hnmax⟩ := Finset.exists_max_image s (fun j ↦ (j : ℕ)) hs
  have hn0 : c n ≠ 0 := (Finset.mem_filter.mp hn).2
  have heq : (fun t : ℂ ↦ ∑ j, c j / t ^ ((j : ℕ) + 1)) =
      ∑ j ∈ s, fun t : ℂ ↦ c j / t ^ ((j : ℕ) + 1) := by
    funext t
    simp only [Finset.sum_apply]
    rw [Finset.sum_filter]
    apply Finset.sum_congr rfl
    intro j _
    by_cases hj : c j ≠ 0
    · rw [if_pos hj]
    · rw [if_neg hj, not_ne_iff.mp hj, zero_div]
  rw [heq, RiemannRochAna_meromorphicOrderAt_sum_eq_of_unique_min s
    (fun j t ↦ c j / t ^ ((j : ℕ) + 1)) n hn]
  · rw [RiemannRochAna_polarMonomial_order_eq n (c n) hn0]
    norm_cast
    omega
  · intro j hj
    exact analyticAt_const.meromorphicAt.div
      ((analyticAt_id (𝕜 := ℂ)).pow ((j : ℕ) + 1)).meromorphicAt
  · rw [RiemannRochAna_polarMonomial_order_eq n (c n) hn0]
    simp
  · intro j hj hji
    have hj0 : c j ≠ 0 := (Finset.mem_filter.mp hj).2
    rw [RiemannRochAna_polarMonomial_order_eq n (c n) hn0,
      RiemannRochAna_polarMonomial_order_eq j (c j) hj0]
    apply WithTop.coe_lt_coe.mpr
    have hjle : (j : ℕ) ≤ (n : ℕ) := hnmax j hj
    have hjlt : (j : ℕ) < (n : ℕ) := lt_of_le_of_ne hjle (by
      intro h
      apply hji
      exact Fin.ext h)
    omega

/-- RiemannRochAna: a nonzero principal coefficient vector forces the
corrected representative to have negative order at that divisor point. -/
theorem RiemannRochAna_correctedPrincipal_order_neg_of_coeff_ne [T2Space C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (c : LinearMap.ker (RiemannRochAna_principalClassLinear hE D))
    (i : D.support) (hi : c.1 i ≠ 0) :
    meromorphicOrderAt (fun t : ℂ ↦
      RiemannRochAna_correctedPrincipal hE D c.1
        (RiemannRochAna_dbarRangeLift (E := E) (C := C)
          (RiemannRochAna_principalKernelToDbarRange hE D c))
        ((extChartAt 𝓘(ℂ, E) i.1).symm
          (extChartAt 𝓘(ℂ, E) i.1 i.1 + b4cov_lineEquiv hE t))) 0 < 0 := by
  let u := RiemannRochAna_dbarRangeLift (E := E) (C := C)
    (RiemannRochAna_principalKernelToDbarRange hE D c)
  let A : ℂ → C := fun t ↦ (extChartAt 𝓘(ℂ, E) i.1).symm
    (extChartAt 𝓘(ℂ, E) i.1 i.1 + b4cov_lineEquiv hE t)
  let g : ℂ → ℂ := fun t ↦ ∑ n, c.1 i n / t ^ ((n : ℕ) + 1)
  have hg : meromorphicOrderAt g 0 < 0 :=
    RiemannRochAna_polarPolynomial_order_neg _ (c.1 i) hi
  have hpcongr : (fun t ↦ RiemannRochAna_principalPartAt hE D c.1 i (A t))
      =ᶠ[𝓝[≠] 0] g := by
    filter_upwards [(RiemannRochAna_coordinate_centered_symm_germ hE i.1).filter_mono
      nhdsWithin_le_nhds] with t ht
    simp only [RiemannRochAna_principalPartAt, g, A, ht, id_eq]
  have hp : meromorphicOrderAt
      (fun t ↦ RiemannRochAna_principalPartAt hE D c.1 i (A t)) 0 < 0 := by
    rw [meromorphicOrderAt_congr hpcongr]
    exact hg
  have hA := RiemannRochAna_centered_symm_analytic hE i.1
  have hA0 : A 0 = i.1 := by
    simp only [A, map_zero, add_zero]
    exact (extChartAt 𝓘(ℂ, E) i.1).left_inv (mem_extChartAt_source i.1)
  have hu : ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω (u : C → ℂ) i.1 :=
    RiemannRochAna_principalPotential_analytic hE D c.1 u
      (RiemannRochAna_principalKernelPotential_spec hE D c) i
  have huA : AnalyticAt ℂ (fun t ↦ (u : C → ℂ) (A t)) 0 := by
    have hu' : ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω (u : C → ℂ) (A 0) := by
      rw [hA0]
      exact hu
    exact (contMDiffAt_iff_contDiffAt.mp (hu'.comp 0 hA)).analyticAt
  have hlt : meromorphicOrderAt
      (fun t ↦ RiemannRochAna_principalPartAt hE D c.1 i (A t)) 0 <
      meromorphicOrderAt (-(fun t ↦ (u : C → ℂ) (A t))) 0 := by
    apply hp.trans_le
    rw [← meromorphicOrderAt_neg]
    exact huA.meromorphicOrderAt_nonneg
  have hadd := meromorphicOrderAt_add_eq_left_of_lt huA.neg.meromorphicAt hlt
  have he : (fun t : ℂ ↦ RiemannRochAna_correctedPrincipal hE D c.1 u (A t))
      =ᶠ[𝓝[≠] 0] (fun t ↦ RiemannRochAna_principalPartAt hE D c.1 i (A t)) +
        -(fun t ↦ (u : C → ℂ) (A t)) := by
    have ht : Tendsto A (𝓝 0) (𝓝 i.1) := by
      convert hA.continuousAt.tendsto using 1
      exact congrArg (fun x ↦ 𝓝 x) hA0.symm
    filter_upwards [((RiemannRochAna_correctedPrincipal_germ hE D c.1 u i).comp_tendsto
      ht).filter_mono nhdsWithin_le_nhds] with t ht
    simpa only [Function.comp_apply, Pi.add_apply, Pi.neg_apply, sub_eq_add_neg] using ht
  rw [meromorphicOrderAt_congr he, hadd]
  exact hp

/-- RiemannRochAna: a corrected principal restriction which is constant off
the divisor has zero principal data. -/
theorem RiemannRochAna_principalKernel_eq_zero_of_restriction_const
    [T2Space C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (c : LinearMap.ker (RiemannRochAna_principalClassLinear hE D)) (a : ℂ)
    (hc : RiemannRochAna_principalKernelRestriction hE D c = fun _ ↦ a) :
    c = 0 := by
  apply Subtype.ext
  funext i
  by_contra hi
  have hneg := RiemannRochAna_correctedPrincipal_order_neg_of_coeff_ne hE D c i hi
  let A : ℂ → C := fun t ↦ (extChartAt 𝓘(ℂ, E) i.1).symm
    (extChartAt 𝓘(ℂ, E) i.1 i.1 + b4cov_lineEquiv hE t)
  have hopen : ((D.support.erase i.1 : Finset C) : Set C)ᶜ ∈ 𝓝 i.1 :=
    ((D.support.erase i.1).finite_toSet.isClosed.isOpen_compl).mem_nhds (by simp)
  have hopen' : ∀ᶠ y in 𝓝[≠] i.1,
      y ∈ ((D.support.erase i.1 : Finset C) : Set C)ᶜ :=
    Filter.Eventually.filter_mono nhdsWithin_le_nhds hopen
  have haway : ∀ᶠ y in 𝓝[≠] i.1, y ∉ D.support := by
    filter_upwards [hopen',
      (self_mem_nhdsWithin : {i.1}ᶜ ∈ 𝓝[≠] i.1)] with y hy hyi
    intro hys
    have hy' : y ∉ ((D.support.erase i.1 : Finset C) : Set C) := hy
    exact hy' (show y ∈ ((D.support.erase i.1 : Finset C) : Set C) from
      Finset.mem_erase.mpr ⟨hyi, hys⟩)
  have hAaway : ∀ᶠ t in 𝓝[≠] 0, A t ∉ D.support :=
    RiemannRochAna_inverse_coordinate_punctured hE i.1 haway
  have he : (fun t : ℂ ↦
      RiemannRochAna_correctedPrincipal hE D c.1
        (RiemannRochAna_dbarRangeLift (E := E) (C := C)
          (RiemannRochAna_principalKernelToDbarRange hE D c)) (A t))
      =ᶠ[𝓝[≠] 0] fun _ ↦ a := by
    filter_upwards [hAaway] with t ht
    have hv := congrFun hc ⟨A t, ht⟩
    rw [RiemannRochAna_principalKernelRestriction_apply] at hv
    exact hv
  have hnonneg : 0 ≤ meromorphicOrderAt (fun t : ℂ ↦
      RiemannRochAna_correctedPrincipal hE D c.1
        (RiemannRochAna_dbarRangeLift (E := E) (C := C)
          (RiemannRochAna_principalKernelToDbarRange hE D c)) (A t)) 0 := by
    rw [meromorphicOrderAt_congr he]
    exact analyticAt_const.meromorphicOrderAt_nonneg
  exact (not_lt_of_ge hnonneg) hneg

/-- RiemannRochAna: the effective constant-plus-principal parameter map is
injective on a nonempty surface. -/
theorem RiemannRochAna_effectiveParameterLinear_injective
    [T2Space C] [CompactSpace C] [ConnectedSpace C] [Nonempty C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (hD : ∀ x, 0 ≤ D x) :
    Function.Injective (RiemannRochAna_effectiveParameterLinear hE D hD) := by
  rw [← LinearMap.ker_eq_bot]
  apply LinearMap.ker_eq_bot'.mpr
  intro p hp
  have hcconst : RiemannRochAna_principalKernelRestriction hE D p.2 =
      fun _ ↦ -p.1 := by
    funext x
    have hx := congrArg (fun z : b4c_L (E := E) D ↦
      ((z : {x : C // x ∉ D.support} → ℂ) x)) hp
    simp only [RiemannRochAna_effectiveParameterLinear_apply, Submodule.coe_zero,
      Pi.zero_apply] at hx
    exact eq_neg_of_add_eq_zero_right hx
  have hc : p.2 = 0 :=
    RiemannRochAna_principalKernel_eq_zero_of_restriction_const hE D p.2 (-p.1) hcconst
  obtain ⟨x, hx⟩ := RiemannRochAna_exists_unmarked hE (Classical.arbitrary C)
    (fun i : D.support ↦ i.1)
  have hx' : x ∉ D.support := by
    intro hxs
    exact hx ⟨⟨x, hxs⟩, rfl⟩
  have hp0 := congrArg (fun z : b4c_L (E := E) D ↦
    ((z : {x : C // x ∉ D.support} → ℂ) ⟨x, hx'⟩)) hp
  rw [RiemannRochAna_effectiveParameterLinear_apply, hc, map_zero] at hp0
  simp only [Pi.zero_apply, add_zero, Submodule.coe_zero] at hp0
  apply Prod.ext
  · exact hp0
  · exact hc

/-- RiemannRochAna: a meromorphic germ of nonnegative order have an
analytic representative on its punctured germ. -/
theorem RiemannRochAna_analytic_extension_of_order_nonnegative
    (f : ℂ → ℂ) (hf : MeromorphicAt f 0)
    (hord : 0 ≤ meromorphicOrderAt f 0) :
    ∃ g : ℂ → ℂ, AnalyticAt ℂ g 0 ∧ f =ᶠ[𝓝[≠] 0] g :=
  (hf.meromorphicOrderAt_nonneg_iff).mp hord

/-- RiemannRochAna: meromorphic orders are integral, so improving beyond one
allowed polar order reaches the next integral bound. -/
theorem RiemannRochAna_order_step (n : ℕ) (m : WithTop ℤ)
    (h : (((-((n + 1 : ℕ) : ℤ) : ℤ)) : WithTop ℤ) < m) :
    (((-(n : ℤ) : ℤ)) : WithTop ℤ) ≤ m := by
  induction m using WithTop.recTopCoe with
  | top => simp
  | coe z =>
      norm_cast at h ⊢
      omega

/-- RiemannRochAna: when a germ has the lowest allowed polar order,
subtracting its leading polar monomial strictly raises that order. -/
theorem RiemannRochAna_cancel_lowest_polar_order (n : ℕ) (f : ℂ → ℂ)
    (hf : MeromorphicAt f 0)
    (ho : meromorphicOrderAt f 0 =
      (((-((n + 1 : ℕ) : ℤ) : ℤ)) : WithTop ℤ)) :
    ∃ a : ℂ, meromorphicOrderAt
      (fun t ↦ f t - a / t ^ (n + 1)) 0 >
        (((-((n + 1 : ℕ) : ℤ) : ℤ)) : WithTop ℤ) := by
  let m : ℤ := -((n + 1 : ℕ) : ℤ)
  have hom : meromorphicOrderAt f 0 = (m : WithTop ℤ) := ho
  obtain ⟨g, hg, hg0, hfg⟩ := (meromorphicOrderAt_eq_int_iff hf).mp hom
  refine ⟨g 0, ?_⟩
  let h : ℂ → ℂ := fun t ↦ g t - g 0
  have hha : AnalyticAt ℂ h 0 := hg.sub analyticAt_const
  have hht : Tendsto h (𝓝[≠] 0) (𝓝 0) := by
    apply tendsto_nhdsWithin_of_tendsto_nhds
    simpa only [h, sub_self] using hha.continuousAt.tendsto
  have hhpos : 0 < meromorphicOrderAt h 0 :=
    (tendsto_zero_iff_meromorphicOrderAt_pos hha.meromorphicAt).mp hht
  have he : (fun t ↦ f t - g 0 / t ^ (n + 1)) =ᶠ[𝓝[≠] 0]
      (fun t ↦ t ^ m * h t) := by
    filter_upwards [hfg, (self_mem_nhdsWithin : {0}ᶜ ∈ 𝓝[≠] (0 : ℂ))]
      with t ht ht0
    rw [ht]
    simp only [sub_zero, smul_eq_mul, h, m]
    rw [zpow_neg, zpow_natCast]
    rw [div_eq_mul_inv]
    ring
  rw [meromorphicOrderAt_congr he]
  change (((-((n + 1 : ℕ) : ℤ) : ℤ)) : WithTop ℤ) <
    meromorphicOrderAt ((fun t : ℂ ↦ t ^ m) * h) 0
  rw [show (fun t : ℂ ↦ t ^ m) = id ^ m by rfl]
  rw [
    meromorphicOrderAt_mul ((analyticAt_id (𝕜 := ℂ)).meromorphicAt.zpow m)
      hha.meromorphicAt,
    meromorphicOrderAt_zpow ((analyticAt_id (𝕜 := ℂ)).meromorphicAt)]
  simp only [meromorphicOrderAt_id, nsmul_eq_mul, mul_one]
  cases hq : meromorphicOrderAt h 0 with
  | top =>
      constructor <;> exact WithTop.coe_lt_top _
  | coe z =>
      rw [hq] at hhpos
      norm_cast at hhpos ⊢
      simp only [m]
      omega

/-- RiemannRochAna: one coefficient removes the lowest allowed pole and
raises the remainder to the next integral order bound. -/
theorem RiemannRochAna_raise_polar_order (n : ℕ) (f : ℂ → ℂ)
    (hf : MeromorphicAt f 0)
    (ho : (((-((n + 1 : ℕ) : ℤ) : ℤ)) : WithTop ℤ) ≤
      meromorphicOrderAt f 0) :
    ∃ a : ℂ, (((-(n : ℤ) : ℤ)) : WithTop ℤ) ≤
      meromorphicOrderAt (fun t ↦ f t - a / t ^ (n + 1)) 0 := by
  rcases ho.eq_or_lt with heq | hlt
  · obtain ⟨a, ha⟩ := RiemannRochAna_cancel_lowest_polar_order n f hf heq.symm
    exact ⟨a, RiemannRochAna_order_step n _ ha⟩
  · refine ⟨0, ?_⟩
    simpa only [zero_div, sub_zero] using RiemannRochAna_order_step n _ hlt

/-- RiemannRochAna: every germ whose pole order is bounded by `d` has a
finite principal polynomial of length `d` with analytic-order remainder. -/
theorem RiemannRochAna_extract_principal_polynomial (d : ℕ) (f : ℂ → ℂ)
    (hf : MeromorphicAt f 0)
    (ho : (((-(d : ℤ) : ℤ)) : WithTop ℤ) ≤ meromorphicOrderAt f 0) :
    ∃ c : Fin d → ℂ, 0 ≤ meromorphicOrderAt
      (fun t ↦ f t - ∑ n, c n / t ^ ((n : ℕ) + 1)) 0 := by
  induction d generalizing f with
  | zero =>
      refine ⟨fun i ↦ Fin.elim0 i, ?_⟩
      simpa using ho
  | succ d ih =>
      obtain ⟨a, ha⟩ := RiemannRochAna_raise_polar_order d f hf (by simpa using ho)
      let f₁ : ℂ → ℂ := fun t ↦ f t - a / t ^ (d + 1)
      have hf₁ : MeromorphicAt f₁ 0 := hf.sub
        (analyticAt_const.meromorphicAt.div
          ((analyticAt_id (𝕜 := ℂ)).pow (d + 1)).meromorphicAt)
      obtain ⟨c, hc⟩ := ih f₁ hf₁ (by simpa only [f₁] using ha)
      refine ⟨Fin.lastCases a c, ?_⟩
      have he : (fun t ↦ f t - ∑ n : Fin (d + 1),
          Fin.lastCases a c n / t ^ ((n : ℕ) + 1)) =
          fun t ↦ f₁ t - ∑ n : Fin d, c n / t ^ ((n : ℕ) + 1) := by
        funext t
        rw [Fin.sum_univ_castSucc]
        simp only [Fin.lastCases_castSucc, Fin.coe_castSucc, Fin.lastCases_last,
          Fin.val_last, f₁]
        ring
      rw [he]
      exact hc

/-- RiemannRochAna: a bounded meromorphic germ is a finite principal
polynomial plus an analytic punctured-germ representative. -/
theorem RiemannRochAna_principal_polynomial_decomposition (d : ℕ) (f : ℂ → ℂ)
    (hf : MeromorphicAt f 0)
    (ho : (((-(d : ℤ) : ℤ)) : WithTop ℤ) ≤ meromorphicOrderAt f 0) :
    ∃ (c : Fin d → ℂ) (g : ℂ → ℂ), AnalyticAt ℂ g 0 ∧
      f =ᶠ[𝓝[≠] 0] fun t ↦ (∑ n, c n / t ^ ((n : ℕ) + 1)) + g t := by
  obtain ⟨c, hc⟩ := RiemannRochAna_extract_principal_polynomial d f hf ho
  let r : ℂ → ℂ := fun t ↦ f t - ∑ n, c n / t ^ ((n : ℕ) + 1)
  have hp : MeromorphicAt (fun t : ℂ ↦ ∑ n, c n / t ^ ((n : ℕ) + 1)) 0 := by
    rw [show (fun t : ℂ ↦ ∑ n, c n / t ^ ((n : ℕ) + 1)) =
        ∑ n, fun t : ℂ ↦ c n / t ^ ((n : ℕ) + 1) by
      funext t
      simp only [Finset.sum_apply]]
    exact MeromorphicAt.sum fun n _ ↦ analyticAt_const.meromorphicAt.div
      ((analyticAt_id (𝕜 := ℂ)).pow ((n : ℕ) + 1)).meromorphicAt
  have hr : MeromorphicAt r 0 := hf.sub hp
  obtain ⟨g, hg, hrg⟩ :=
    RiemannRochAna_analytic_extension_of_order_nonnegative r hr hc
  refine ⟨c, g, hg, ?_⟩
  filter_upwards [hrg] with t ht
  dsimp only [r] at ht
  rw [← ht]
  ring

/-- RiemannRochAna: a meromorphic function satisfying an effective divisor
bound has finite principal coefficients and an analytic remainder at every
divisor point. -/
theorem RiemannRochAna_meroFun_principal_decomposition
    [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (hD : ∀ x, 0 ≤ D x) (F : b4c_MeroFun E C)
    (hFn : ∃ x, F x ≠ (0 : ℂ))
    (hord : ∀ x, 0 ≤ b4c_ord E F x + D x) (i : D.support) :
    ∃ (c : Fin (Int.toNat (D i.1)) → ℂ) (g : ℂ → ℂ),
      AnalyticAt ℂ g 0 ∧ RiemannRochAna_functionLocal hE F i.1 =ᶠ[𝓝[≠] 0]
        fun t ↦ (∑ n, c n / t ^ ((n : ℕ) + 1)) + g t := by
  have hm : ((-D i.1 : ℤ) : WithTop ℤ) ≤
      meromorphicOrderAt (RiemannRochAna_functionLocal hE F i.1) 0 := by
    rw [← RiemannRochAna_ord_eq_local hE F hFn i.1]
    apply WithTop.coe_le_coe.mpr
    have hi := hord i.1
    omega
  have hnat : (Int.toNat (D i.1) : ℤ) = D i.1 := Int.toNat_of_nonneg (hD i.1)
  apply RiemannRochAna_principal_polynomial_decomposition
    (Int.toNat (D i.1)) (RiemannRochAna_functionLocal hE F i.1)
    (RiemannRochAna_sphere_map_meromorphic hE F F.property.1 i.1)
  simpa only [hnat] using hm

/-- RiemannRochAna: selected principal coefficient data of a divisor-bounded
meromorphic function. -/
noncomputable def RiemannRochAna_meroFunPrincipalData
    [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (hD : ∀ x, 0 ≤ D x) (F : b4c_MeroFun E C)
    (hFn : ∃ x, F x ≠ (0 : ℂ))
    (hord : ∀ x, 0 ≤ b4c_ord E F x + D x) :
    RiemannRochAna_PrincipalData D :=
  fun i ↦ Classical.choose
    (RiemannRochAna_meroFun_principal_decomposition hE D hD F hFn hord i)

/-- RiemannRochAna: the selected principal coefficients leave an analytic
local remainder. -/
theorem RiemannRochAna_meroFunPrincipalData_spec
    [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (hD : ∀ x, 0 ≤ D x) (F : b4c_MeroFun E C)
    (hFn : ∃ x, F x ≠ (0 : ℂ))
    (hord : ∀ x, 0 ≤ b4c_ord E F x + D x) (i : D.support) :
    ∃ g : ℂ → ℂ, AnalyticAt ℂ g 0 ∧
      RiemannRochAna_functionLocal hE F i.1 =ᶠ[𝓝[≠] 0] fun t ↦
        (∑ n, RiemannRochAna_meroFunPrincipalData hE D hD F hFn hord i n /
          t ^ ((n : ℕ) + 1)) + g t := by
  let h := RiemannRochAna_meroFun_principal_decomposition hE D hD F hFn hord i
  exact ⟨Classical.choose (Classical.choose_spec h),
    (Classical.choose_spec (Classical.choose_spec h)).1,
    (Classical.choose_spec (Classical.choose_spec h)).2⟩

/-- RiemannRochAna: the finite principal coefficient vector in an
analytic-remainder decomposition is unique. -/
theorem RiemannRochAna_principal_polynomial_unique (d : ℕ) (f : ℂ → ℂ)
    (c₁ c₂ : Fin d → ℂ) (g₁ g₂ : ℂ → ℂ)
    (hg₁ : AnalyticAt ℂ g₁ 0) (hg₂ : AnalyticAt ℂ g₂ 0)
    (h₁ : f =ᶠ[𝓝[≠] 0] fun t ↦ (∑ n, c₁ n / t ^ ((n : ℕ) + 1)) + g₁ t)
    (h₂ : f =ᶠ[𝓝[≠] 0] fun t ↦ (∑ n, c₂ n / t ^ ((n : ℕ) + 1)) + g₂ t) :
    c₁ = c₂ := by
  by_contra hc
  have hcd : c₁ - c₂ ≠ 0 := sub_ne_zero.mpr hc
  have hneg := RiemannRochAna_polarPolynomial_order_neg d (c₁ - c₂) hcd
  have he : (fun t : ℂ ↦ ∑ n, (c₁ - c₂) n / t ^ ((n : ℕ) + 1))
      =ᶠ[𝓝[≠] 0] fun t ↦ g₂ t - g₁ t := by
    filter_upwards [h₁, h₂] with t ht₁ ht₂
    simp only [Pi.sub_apply]
    rw [show (∑ n, (c₁ n - c₂ n) / t ^ ((n : ℕ) + 1)) =
        (∑ n, c₁ n / t ^ ((n : ℕ) + 1)) -
          ∑ n, c₂ n / t ^ ((n : ℕ) + 1) by
      rw [← Finset.sum_sub_distrib]
      apply Finset.sum_congr rfl
      intro n _
      exact sub_div _ _ _]
    have hh := ht₁.symm.trans ht₂
    linear_combination hh
  have hnonneg : 0 ≤ meromorphicOrderAt
      (fun t : ℂ ↦ ∑ n, (c₁ - c₂) n / t ^ ((n : ℕ) + 1)) 0 := by
    rw [meromorphicOrderAt_congr he]
    exact (hg₂.sub hg₁).meromorphicOrderAt_nonneg
  exact (not_lt_of_ge hnonneg) hneg

/-- RiemannRochAna: the assembled cutoff scalar has the prescribed principal
part germ at each divisor point. -/
theorem RiemannRochAna_principalScalar_germ [T2Space C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (c : RiemannRochAna_PrincipalData D) (i : D.support) :
    RiemannRochAna_principalScalar hE D c =ᶠ[𝓝 i.1]
      RiemannRochAna_principalPartAt hE D c i := by
  have h := RiemannRochAna_correctedPrincipal_germ hE D c (fun _ ↦ 0) i
  change (fun y ↦ RiemannRochAna_principalScalar hE D c y - 0) =ᶠ[𝓝 i.1]
    (fun y ↦ RiemannRochAna_principalPartAt hE D c i y - 0) at h
  simpa only [sub_zero] using h

/-- RiemannRochAna: selected analytic remainder of a bounded meromorphic
function after removing its local principal polynomial. -/
noncomputable def RiemannRochAna_meroFunPrincipalRemainder
    [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (hD : ∀ x, 0 ≤ D x) (F : b4c_MeroFun E C)
    (hFn : ∃ x, F x ≠ (0 : ℂ))
    (hord : ∀ x, 0 ≤ b4c_ord E F x + D x) (i : D.support) : ℂ → ℂ :=
  Classical.choose
    (RiemannRochAna_meroFunPrincipalData_spec hE D hD F hFn hord i)

/-- RiemannRochAna: the selected local remainder is analytic and realizes
the principal decomposition germ. -/
theorem RiemannRochAna_meroFunPrincipalRemainder_spec
    [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (hD : ∀ x, 0 ≤ D x) (F : b4c_MeroFun E C)
    (hFn : ∃ x, F x ≠ (0 : ℂ))
    (hord : ∀ x, 0 ≤ b4c_ord E F x + D x) (i : D.support) :
    AnalyticAt ℂ (RiemannRochAna_meroFunPrincipalRemainder hE D hD F hFn hord i) 0 ∧
      RiemannRochAna_functionLocal hE F i.1 =ᶠ[𝓝[≠] 0] fun t ↦
        (∑ n, RiemannRochAna_meroFunPrincipalData hE D hD F hFn hord i n /
          t ^ ((n : ℕ) + 1)) +
            RiemannRochAna_meroFunPrincipalRemainder hE D hD F hFn hord i t :=
  Classical.choose_spec
    (RiemannRochAna_meroFunPrincipalData_spec hE D hD F hFn hord i)

/-- RiemannRochAna: the finite-value representative minus its assembled
principal scalar, filled at divisor points by the selected analytic remainder. -/
noncomputable def RiemannRochAna_regularizedMeroFun
    [T2Space C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (hD : ∀ x, 0 ≤ D x) (F : b4c_MeroFun E C)
    (hFn : ∃ x, F x ≠ (0 : ℂ))
    (hord : ∀ x, 0 ≤ b4c_ord E F x + D x) : C → ℂ :=
  fun y ↦ if hy : y ∈ D.support then
      RiemannRochAna_meroFunPrincipalRemainder hE D hD F hFn hord ⟨y, hy⟩ 0
    else (F y).elim 0 id - RiemannRochAna_principalScalar hE D
      (RiemannRochAna_meroFunPrincipalData hE D hD F hFn hord) y

theorem RiemannRochAna_regularizedMeroFun_of_not_mem
    [T2Space C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (hD : ∀ x, 0 ≤ D x) (F : b4c_MeroFun E C)
    (hFn : ∃ x, F x ≠ (0 : ℂ))
    (hord : ∀ x, 0 ≤ b4c_ord E F x + D x) (y : C) (hy : y ∉ D.support) :
    RiemannRochAna_regularizedMeroFun hE D hD F hFn hord y =
      (F y).elim 0 id - RiemannRochAna_principalScalar hE D
        (RiemannRochAna_meroFunPrincipalData hE D hD F hFn hord) y := by
  simp only [RiemannRochAna_regularizedMeroFun, dif_neg hy]

theorem RiemannRochAna_regularizedMeroFun_of_mem
    [T2Space C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (hD : ∀ x, 0 ≤ D x) (F : b4c_MeroFun E C)
    (hFn : ∃ x, F x ≠ (0 : ℂ))
    (hord : ∀ x, 0 ≤ b4c_ord E F x + D x) (i : D.support) :
    RiemannRochAna_regularizedMeroFun hE D hD F hFn hord i.1 =
      RiemannRochAna_meroFunPrincipalRemainder hE D hD F hFn hord i 0 := by
  simp only [RiemannRochAna_regularizedMeroFun, dif_pos i.2]

/-- RiemannRochAna: in a centered chart at a divisor point, the regularized
scalar has the selected analytic remainder as its full local germ. -/
theorem RiemannRochAna_regularizedMeroFun_centered_germ
    [T2Space C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (hD : ∀ x, 0 ≤ D x) (F : b4c_MeroFun E C)
    (hFn : ∃ x, F x ≠ (0 : ℂ))
    (hord : ∀ x, 0 ≤ b4c_ord E F x + D x) (i : D.support) :
    (fun t : ℂ ↦ RiemannRochAna_regularizedMeroFun hE D hD F hFn hord
      ((extChartAt 𝓘(ℂ, E) i.1).symm
        (extChartAt 𝓘(ℂ, E) i.1 i.1 + b4cov_lineEquiv hE t))) =ᶠ[𝓝 0]
      RiemannRochAna_meroFunPrincipalRemainder hE D hD F hFn hord i := by
  let A : ℂ → C := fun t ↦ (extChartAt 𝓘(ℂ, E) i.1).symm
    (extChartAt 𝓘(ℂ, E) i.1 i.1 + b4cov_lineEquiv hE t)
  let c := RiemannRochAna_meroFunPrincipalData hE D hD F hFn hord
  let g := RiemannRochAna_meroFunPrincipalRemainder hE D hD F hFn hord i
  have hA0 : A 0 = i.1 := by
    simp only [A, map_zero, add_zero]
    exact (extChartAt 𝓘(ℂ, E) i.1).left_inv (mem_extChartAt_source i.1)
  have hAt : Tendsto A (𝓝 0) (𝓝 i.1) := by
    have hA := RiemannRochAna_centered_symm_analytic hE i.1
    convert hA.continuousAt.tendsto using 1
    exact congrArg (fun x ↦ 𝓝 x) hA0.symm
  have hopen : ((D.support.erase i.1 : Finset C) : Set C)ᶜ ∈ 𝓝 i.1 :=
    ((D.support.erase i.1).finite_toSet.isClosed.isOpen_compl).mem_nhds (by simp)
  have hopen' : ∀ᶠ y in 𝓝[≠] i.1,
      y ∈ ((D.support.erase i.1 : Finset C) : Set C)ᶜ :=
    Filter.Eventually.filter_mono nhdsWithin_le_nhds hopen
  have haway : ∀ᶠ y in 𝓝[≠] i.1, y ∉ D.support := by
    filter_upwards [hopen',
      (self_mem_nhdsWithin : {i.1}ᶜ ∈ 𝓝[≠] i.1)] with y hy hyi
    intro hys
    have hy' : y ∉ ((D.support.erase i.1 : Finset C) : Set C) := hy
    exact hy' (show y ∈ ((D.support.erase i.1 : Finset C) : Set C) from
      Finset.mem_erase.mpr ⟨hyi, hys⟩)
  have hAaway : ∀ᶠ t in 𝓝[≠] 0, A t ∉ D.support :=
    RiemannRochAna_inverse_coordinate_punctured hE i.1 haway
  have hdec := (RiemannRochAna_meroFunPrincipalRemainder_spec
    hE D hD F hFn hord i).2
  have hcoord : (fun t : ℂ ↦ RiemannRochAna_coordinate hE i.1 (A t))
      =ᶠ[𝓝[≠] 0] id :=
    (RiemannRochAna_coordinate_centered_symm_germ hE i.1).filter_mono
      nhdsWithin_le_nhds
  have hscalar : (fun t : ℂ ↦ RiemannRochAna_principalScalar hE D c (A t))
      =ᶠ[𝓝[≠] 0] fun t ↦ RiemannRochAna_principalPartAt hE D c i (A t) :=
    ((RiemannRochAna_principalScalar_germ hE D c i).comp_tendsto hAt).filter_mono
      nhdsWithin_le_nhds
  have hne : (fun t : ℂ ↦ RiemannRochAna_regularizedMeroFun hE D hD F hFn hord
      (A t)) =ᶠ[𝓝[≠] 0] g := by
    filter_upwards [hAaway, hdec, hcoord, hscalar] with t ht hdt hct hst
    rw [RiemannRochAna_regularizedMeroFun_of_not_mem hE D hD F hFn hord (A t) ht,
      hst]
    change RiemannRochAna_functionLocal hE F i.1 t -
      RiemannRochAna_principalPartAt hE D c i (A t) = g t
    rw [hdt]
    simp only [RiemannRochAna_principalPartAt, hct, id_eq, c, g]
    ring
  rw [Filter.EventuallyEq] at hne ⊢
  apply mem_of_superset (insert_mem_nhds_iff.mpr hne)
  intro t ht
  rcases ht with rfl | ht
  · change RiemannRochAna_regularizedMeroFun hE D hD F hFn hord (A 0) = g 0
    rw [hA0]
    exact RiemannRochAna_regularizedMeroFun_of_mem hE D hD F hFn hord i
  · exact ht

/-- RiemannRochAna: the assembled principal scalar is real-smooth away from
the divisor support. -/
theorem RiemannRochAna_principalScalar_smooth_off_support [T2Space C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (c : RiemannRochAna_PrincipalData D) (y : C) (hy : y ∉ D.support) :
    ContMDiffAt 𝓘(ℝ, E) 𝓘(ℝ, ℂ) ∞
      (RiemannRochAna_principalScalar hE D c) y := by
  change ContMDiffAt 𝓘(ℝ, E) 𝓘(ℝ, ℂ) ∞ (fun z ↦
    ∑ i, ∑ n, c i n * ((RiemannRochAna_divisorCutoff hE D i z : ℂ) /
      RiemannRochAna_coordinate hE i.1 z ^ ((n : ℕ) + 1))) y
  apply ContMDiffAt.sum
  intro i _
  apply ContMDiffAt.sum
  intro n _
  exact contMDiffAt_const.mul
    ((RiemannRochAna_cutoff_principalPow_smooth hE i.1
      (RiemannRochAna_divisorCutoff hE D i) n
      (RiemannRochAna_divisorCutoff_spec hE D i).1
      (RiemannRochAna_divisorCutoff_spec hE D i).2.2.1 y
      (fun h ↦ hy (h ▸ i.2))).contMDiffAt (by simp))

/-- RiemannRochAna: the regularized scalar is complex analytic at every
divisor point. -/
theorem RiemannRochAna_regularizedMeroFun_analytic_at_support
    [T2Space C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (hD : ∀ x, 0 ≤ D x) (F : b4c_MeroFun E C)
    (hFn : ∃ x, F x ≠ (0 : ℂ))
    (hord : ∀ x, 0 ≤ b4c_ord E F x + D x) (i : D.support) :
    ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω
      (RiemannRochAna_regularizedMeroFun hE D hD F hFn hord) i.1 := by
  let z : C → ℂ := RiemannRochAna_coordinate hE i.1
  let A : ℂ → C := fun t ↦ (extChartAt 𝓘(ℂ, E) i.1).symm
    (extChartAt 𝓘(ℂ, E) i.1 i.1 + b4cov_lineEquiv hE t)
  let g := RiemannRochAna_meroFunPrincipalRemainder hE D hD F hFn hord i
  have hz : ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω z i.1 :=
    RiemannRochAna_coordinate_analytic hE i.1 i.1 (mem_extChartAt_source i.1)
  have hz0 : z i.1 = 0 := RiemannRochAna_coordinate_self hE i.1
  have hzt : Tendsto z (𝓝 i.1) (𝓝 0) := by
    convert hz.continuousAt.tendsto using 1
    exact congrArg (fun x ↦ 𝓝 x) hz0.symm
  have hc := (RiemannRochAna_regularizedMeroFun_centered_germ
    hE D hD F hFn hord i).comp_tendsto hzt
  have hs : ∀ᶠ y in 𝓝 i.1, y ∈ (extChartAt 𝓘(ℂ, E) i.1).source :=
    (isOpen_extChartAt_source i.1).mem_nhds (mem_extChartAt_source i.1)
  have hAz : (fun y ↦ A (z y)) =ᶠ[𝓝 i.1] id := by
    filter_upwards [hs] with y hy
    simp only [A, z, RiemannRochAna_coordinate, id_eq]
    rw [ContinuousLinearEquiv.apply_symm_apply,
      show extChartAt 𝓘(ℂ, E) i.1 i.1 +
          (extChartAt 𝓘(ℂ, E) i.1 y - extChartAt 𝓘(ℂ, E) i.1 i.1) =
        extChartAt 𝓘(ℂ, E) i.1 y by abel,
      (extChartAt 𝓘(ℂ, E) i.1).left_inv hy]
  have he : RiemannRochAna_regularizedMeroFun hE D hD F hFn hord =ᶠ[𝓝 i.1]
      fun y ↦ g (z y) := by
    filter_upwards [hc, hAz] with y hcy hAy
    have hAy' : A (z y) = y := by simpa only [id_eq] using hAy
    calc
      RiemannRochAna_regularizedMeroFun hE D hD F hFn hord y =
          RiemannRochAna_regularizedMeroFun hE D hD F hFn hord (A (z y)) := by
            rw [hAy']
      _ = g (z y) := by
        simpa only [Function.comp_apply, A, g] using hcy
  have hg := (RiemannRochAna_meroFunPrincipalRemainder_spec
    hE D hD F hFn hord i).1
  have hg' : ContMDiffAt 𝓘(ℂ, ℂ) 𝓘(ℂ, ℂ) ω g (z i.1) := by
    rw [hz0]
    exact hg.contDiffAt.contMDiffAt
  exact (hg'.comp i.1 hz).congr_of_eventuallyEq he

/-- RiemannRochAna: the regularized scalar of a divisor-bounded meromorphic
function is globally real-smooth. -/
theorem RiemannRochAna_regularizedMeroFun_smooth
    [T2Space C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (hD : ∀ x, 0 ≤ D x) (F : b4c_MeroFun E C)
    (hFn : ∃ x, F x ≠ (0 : ℂ))
    (hfin : ∀ x, x ∉ D.support → F x ≠ OnePoint.infty)
    (hord : ∀ x, 0 ≤ b4c_ord E F x + D x) :
    ContMDiff 𝓘(ℝ, E) 𝓘(ℝ, ℂ) ∞
      (RiemannRochAna_regularizedMeroFun hE D hD F hFn hord) := by
  intro y
  by_cases hy : y ∈ D.support
  · exact (b3A_contMDiffWithinAt_real
      (RiemannRochAna_regularizedMeroFun_analytic_at_support
        hE D hD F hFn hord ⟨y, hy⟩)).of_le (by simp)
  · have hn : (D.support : Set C)ᶜ ∈ 𝓝 y :=
      D.support.finite_toSet.isClosed.isOpen_compl.mem_nhds hy
    have he : RiemannRochAna_regularizedMeroFun hE D hD F hFn hord =ᶠ[𝓝 y]
        fun z ↦ (F z).elim 0 id - RiemannRochAna_principalScalar hE D
          (RiemannRochAna_meroFunPrincipalData hE D hD F hFn hord) z := by
      filter_upwards [hn] with z hz
      exact RiemannRochAna_regularizedMeroFun_of_not_mem
        hE D hD F hFn hord z hz
    have hfinite : ContMDiffAt 𝓘(ℝ, E) 𝓘(ℝ, ℂ) ∞
        (fun z ↦ (F z).elim 0 id) y :=
      (b3A_contMDiffWithinAt_real
        (RiemannRochAna_finiteValue_analytic F F.property.1 y (hfin y hy))).of_le (by simp)
    have hprincipal := RiemannRochAna_principalScalar_smooth_off_support hE D
      (RiemannRochAna_meroFunPrincipalData hE D hD F hFn hord) y hy
    exact (hfinite.sub hprincipal).congr_of_eventuallyEq he

/-- RiemannRochAna: the assembled principal obstruction vanishes at each
center where the separated cutoff is locally constant. -/
theorem RiemannRochAna_principalObstructionLinear_zero_at_support [T2Space C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (c : RiemannRochAna_PrincipalData D) (i : D.support) (v : E) :
    (RiemannRochAna_principalObstructionLinear hE D c).1 ⟨i.1, v⟩ = 0 := by
  rw [RiemannRochAna_principalObstructionLinear_apply]
  apply Finset.sum_eq_zero
  intro j _
  apply Finset.sum_eq_zero
  intro n _
  by_cases hji : j = i
  · subst j
    have hz := RiemannRochAna_principalObstructionPow_zero_germ hE i.1
      (RiemannRochAna_divisorCutoff hE D i) n
      (RiemannRochAna_divisorCutoff_spec hE D i).2.1
    rw [hz.self_of_nhds v, mul_zero]
  · have hz := RiemannRochAna_principalObstructionPow_zero_germ_of_const
      hE j.1 i.1 (RiemannRochAna_divisorCutoff hE D j) n 0
      (notMem_tsupport_iff_eventuallyEq.mp
        ((RiemannRochAna_divisorCutoff_spec hE D j).2.2.2 i (Ne.symm hji)))
    rw [hz.self_of_nhds v, mul_zero]

/-- RiemannRochAna: principal data extracted from a divisor-bounded
meromorphic function have zero Dolbeault obstruction class. -/
theorem RiemannRochAna_meroFunPrincipalData_mem_kernel
    [T2Space C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (hD : ∀ x, 0 ≤ D x) (F : b4c_MeroFun E C)
    (hFn : ∃ x, F x ≠ (0 : ℂ))
    (hfin : ∀ x, x ∉ D.support → F x ≠ OnePoint.infty)
    (hord : ∀ x, 0 ≤ b4c_ord E F x + D x) :
    RiemannRochAna_meroFunPrincipalData hE D hD F hFn hord ∈
      LinearMap.ker (RiemannRochAna_principalClassLinear hE D) := by
  let r := RiemannRochAna_regularizedMeroFun hE D hD F hFn hord
  let u : b4c_SmoothFun E C := ⟨fun y ↦ -r y,
    (RiemannRochAna_regularizedMeroFun_smooth hE D hD F hFn hfin hord).neg⟩
  apply (RiemannRochAna_principalClass_eq_zero_iff hE D _).mpr
  refine ⟨u, ?_⟩
  ext q
  obtain ⟨y, v⟩ := q
  let c := RiemannRochAna_meroFunPrincipalData hE D hD F hFn hord
  by_cases hy : y ∈ D.support
  · have ha := RiemannRochAna_regularizedMeroFun_analytic_at_support
      hE D hD F hFn hord ⟨y, hy⟩
    have ha' : ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω r y := ha
    have hr : MDifferentiableAt 𝓘(ℝ, E) 𝓘(ℝ, ℂ) r y :=
      (b3A_mdifferentiableAt_real (ha.mdifferentiableAt (by simp))).1
    change b4c_dbar E C (fun z ↦ -r z) ⟨y, v⟩ =
      (RiemannRochAna_principalObstructionLinear hE D c).1 ⟨y, v⟩
    rw [show (fun z ↦ -r z) = (-1 : ℂ) • r by
      funext z
      simp]
    rw [RiemannRochAna_dbar_smul_at (-1) r y hr v,
      RiemannRochAna_dbar_holomorphic_at r y (ha'.mdifferentiableAt (by simp)) v,
      RiemannRochAna_principalObstructionLinear_zero_at_support hE D c ⟨y, hy⟩ v]
    simp

  · have hn : (D.support : Set C)ᶜ ∈ 𝓝 y :=
      D.support.finite_toSet.isClosed.isOpen_compl.mem_nhds hy
    have he : (fun z ↦ -r z) =ᶠ[𝓝 y] fun z ↦
        RiemannRochAna_principalScalar hE D c z - (F z).elim 0 id := by
      filter_upwards [hn] with z hz
      dsimp only [r]
      rw [RiemannRochAna_regularizedMeroFun_of_not_mem hE D hD F hFn hord z hz]
      ring
    change b4c_dbar E C (fun z ↦ -r z) ⟨y, v⟩ =
      (RiemannRochAna_principalObstructionLinear hE D c).1 ⟨y, v⟩
    rw [RiemannRochAna_dbar_congr (E := E) (C := C) he v]
    have hp := RiemannRochAna_principalScalar_smooth_off_support hE D c y hy
    have hf := RiemannRochAna_finiteValue_analytic F F.property.1 y (hfin y hy)
    have hfr : MDifferentiableAt 𝓘(ℝ, E) 𝓘(ℝ, ℂ)
        (fun z ↦ (F z).elim 0 id) y :=
      (b3A_mdifferentiableAt_real (hf.mdifferentiableAt (by simp))).1
    have hneg : MDifferentiableAt 𝓘(ℝ, E) 𝓘(ℝ, ℂ)
        ((-1 : ℂ) • (fun z ↦ (F z).elim 0 id)) y := by
      change MDifferentiableAt 𝓘(ℝ, E) 𝓘(ℝ, ℂ)
        (fun z ↦ (-1 : ℂ) * (F z).elim 0 id) y
      exact mdifferentiableAt_const.mul hfr
    rw [show (fun z ↦ RiemannRochAna_principalScalar hE D c z - (F z).elim 0 id) =
        RiemannRochAna_principalScalar hE D c +
          (-1 : ℂ) • (fun z ↦ (F z).elim 0 id) by
      funext z
      change _ - _ = _ + (-1 : ℂ) * _
      ring,
      RiemannRochAna_dbar_add_at (RiemannRochAna_principalScalar hE D c)
        ((-1 : ℂ) • (fun z ↦ (F z).elim 0 id)) y
        (hp.mdifferentiableAt (by simp)) hneg v,
      RiemannRochAna_dbar_smul_at (-1) (fun z ↦ (F z).elim 0 id) y hfr v,
      RiemannRochAna_principalScalar_dbar hE D c y hy v,
      RiemannRochAna_dbar_holomorphic_at (fun z ↦ (F z).elim 0 id) y
        (hf.mdifferentiableAt (by simp)) v]
    simp

/-- RiemannRochAna: the explicit smooth potential associated to the selected
principal data of a bounded meromorphic function. -/
noncomputable def RiemannRochAna_meroFunPrincipalPotential
    [T2Space C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (hD : ∀ x, 0 ≤ D x) (F : b4c_MeroFun E C)
    (hFn : ∃ x, F x ≠ (0 : ℂ))
    (hfin : ∀ x, x ∉ D.support → F x ≠ OnePoint.infty)
    (hord : ∀ x, 0 ≤ b4c_ord E F x + D x) : b4c_SmoothFun E C :=
  ⟨fun y ↦ -RiemannRochAna_regularizedMeroFun hE D hD F hFn hord y,
    (RiemannRochAna_regularizedMeroFun_smooth hE D hD F hFn hfin hord).neg⟩

@[simp] theorem RiemannRochAna_meroFunPrincipalPotential_apply
    [T2Space C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (hD : ∀ x, 0 ≤ D x) (F : b4c_MeroFun E C)
    (hFn : ∃ x, F x ≠ (0 : ℂ))
    (hfin : ∀ x, x ∉ D.support → F x ≠ OnePoint.infty)
    (hord : ∀ x, 0 ≤ b4c_ord E F x + D x) (y : C) :
    (RiemannRochAna_meroFunPrincipalPotential hE D hD F hFn hfin hord : C → ℂ) y =
      -RiemannRochAna_regularizedMeroFun hE D hD F hFn hord y := rfl

/-- RiemannRochAna: the explicit principal potential differentiates to the
assembled principal obstruction. -/
theorem RiemannRochAna_meroFunPrincipalPotential_spec
    [T2Space C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (hD : ∀ x, 0 ≤ D x) (F : b4c_MeroFun E C)
    (hFn : ∃ x, F x ≠ (0 : ℂ))
    (hfin : ∀ x, x ∉ D.support → F x ≠ OnePoint.infty)
    (hord : ∀ x, 0 ≤ b4c_ord E F x + D x) :
    b4c_dbar E C (RiemannRochAna_meroFunPrincipalPotential
      hE D hD F hFn hfin hord : C → ℂ) =
      (RiemannRochAna_principalObstructionLinear hE D
        (RiemannRochAna_meroFunPrincipalData hE D hD F hFn hord)).1 := by
  ext q
  obtain ⟨y, v⟩ := q
  let r := RiemannRochAna_regularizedMeroFun hE D hD F hFn hord
  let c := RiemannRochAna_meroFunPrincipalData hE D hD F hFn hord
  by_cases hy : y ∈ D.support
  · have ha := RiemannRochAna_regularizedMeroFun_analytic_at_support
      hE D hD F hFn hord ⟨y, hy⟩
    have ha' : ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω r y := ha
    have hr : MDifferentiableAt 𝓘(ℝ, E) 𝓘(ℝ, ℂ) r y :=
      (b3A_mdifferentiableAt_real (ha.mdifferentiableAt (by simp))).1
    change b4c_dbar E C (fun z ↦ -r z) ⟨y, v⟩ =
      (RiemannRochAna_principalObstructionLinear hE D c).1 ⟨y, v⟩
    rw [show (fun z ↦ -r z) = (-1 : ℂ) • r by
      funext z
      simp]
    rw [RiemannRochAna_dbar_smul_at (-1) r y hr v,
      RiemannRochAna_dbar_holomorphic_at r y (ha'.mdifferentiableAt (by simp)) v,
      RiemannRochAna_principalObstructionLinear_zero_at_support hE D c ⟨y, hy⟩ v]
    simp
  · have hn : (D.support : Set C)ᶜ ∈ 𝓝 y :=
      D.support.finite_toSet.isClosed.isOpen_compl.mem_nhds hy
    have he : (fun z ↦ -r z) =ᶠ[𝓝 y] fun z ↦
        RiemannRochAna_principalScalar hE D c z - (F z).elim 0 id := by
      filter_upwards [hn] with z hz
      dsimp only [r]
      rw [RiemannRochAna_regularizedMeroFun_of_not_mem hE D hD F hFn hord z hz]
      ring
    change b4c_dbar E C (fun z ↦ -r z) ⟨y, v⟩ =
      (RiemannRochAna_principalObstructionLinear hE D c).1 ⟨y, v⟩
    rw [RiemannRochAna_dbar_congr (E := E) (C := C) he v]
    have hp := RiemannRochAna_principalScalar_smooth_off_support hE D c y hy
    have hf := RiemannRochAna_finiteValue_analytic F F.property.1 y (hfin y hy)
    have hfr : MDifferentiableAt 𝓘(ℝ, E) 𝓘(ℝ, ℂ)
        (fun z ↦ (F z).elim 0 id) y :=
      (b3A_mdifferentiableAt_real (hf.mdifferentiableAt (by simp))).1
    have hneg : MDifferentiableAt 𝓘(ℝ, E) 𝓘(ℝ, ℂ)
        ((-1 : ℂ) • (fun z ↦ (F z).elim 0 id)) y := by
      change MDifferentiableAt 𝓘(ℝ, E) 𝓘(ℝ, ℂ)
        (fun z ↦ (-1 : ℂ) * (F z).elim 0 id) y
      exact mdifferentiableAt_const.mul hfr
    rw [show (fun z ↦ RiemannRochAna_principalScalar hE D c z - (F z).elim 0 id) =
        RiemannRochAna_principalScalar hE D c +
          (-1 : ℂ) • (fun z ↦ (F z).elim 0 id) by
      funext z
      change _ - _ = _ + (-1 : ℂ) * _
      ring,
      RiemannRochAna_dbar_add_at (RiemannRochAna_principalScalar hE D c)
        ((-1 : ℂ) • (fun z ↦ (F z).elim 0 id)) y
        (hp.mdifferentiableAt (by simp)) hneg v,
      RiemannRochAna_dbar_smul_at (-1) (fun z ↦ (F z).elim 0 id) y hfr v,
      RiemannRochAna_principalScalar_dbar hE D c y hy v,
      RiemannRochAna_dbar_holomorphic_at (fun z ↦ (F z).elim 0 id) y
        (hf.mdifferentiableAt (by simp)) v]
    simp

/-- RiemannRochAna: the selected linear principal potential differs from the
explicit regularizing potential by a constant. -/
theorem RiemannRochAna_principalPotential_sub_explicit_const
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (hD : ∀ x, 0 ≤ D x) (F : b4c_MeroFun E C)
    (hFn : ∃ x, F x ≠ (0 : ℂ))
    (hfin : ∀ x, x ∉ D.support → F x ≠ OnePoint.infty)
    (hord : ∀ x, 0 ≤ b4c_ord E F x + D x) :
    ∃ a : ℂ,
      ((RiemannRochAna_dbarRangeLift (E := E) (C := C)
          (RiemannRochAna_principalKernelToDbarRange hE D
            ⟨RiemannRochAna_meroFunPrincipalData hE D hD F hFn hord,
              RiemannRochAna_meroFunPrincipalData_mem_kernel
                hE D hD F hFn hfin hord⟩) -
        RiemannRochAna_meroFunPrincipalPotential hE D hD F hFn hfin hord :
          b4c_SmoothFun E C) : C → ℂ) = Function.const C a := by
  let c : LinearMap.ker (RiemannRochAna_principalClassLinear hE D) :=
    ⟨RiemannRochAna_meroFunPrincipalData hE D hD F hFn hord,
      RiemannRochAna_meroFunPrincipalData_mem_kernel hE D hD F hFn hfin hord⟩
  let u := RiemannRochAna_dbarRangeLift (E := E) (C := C)
    (RiemannRochAna_principalKernelToDbarRange hE D c)
  let p := RiemannRochAna_meroFunPrincipalPotential hE D hD F hFn hfin hord
  apply (RiemannRochAna_dbar_eq_zero_iff_const (u - p)).mp
  have hpneg : -p = (-1 : ℂ) • p := by
    ext y
    simp
  rw [sub_eq_add_neg, hpneg]
  calc
    b4c_dbar E C (u + (-1 : ℂ) • p) =
        b4c_dbar E C u + b4c_dbar E C ((-1 : ℂ) • p) :=
      RiemannRochAna_dbar_add u ((-1 : ℂ) • p)
    _ = b4c_dbar E C u + (-1 : ℂ) • b4c_dbar E C p := by
      rw [RiemannRochAna_dbar_smul]
    _ = 0 := by
      rw [RiemannRochAna_principalKernelPotential_spec hE D c,
        RiemannRochAna_meroFunPrincipalPotential_spec hE D hD F hFn hfin hord]
      simp [c]

/-- RiemannRochAna: a divisor-bounded meromorphic restriction is obtained
from its constant term and its selected principal data. -/
theorem RiemannRochAna_finiteValue_eq_effective_parameters
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (hD : ∀ x, 0 ≤ D x) (F : b4c_MeroFun E C)
    (hFn : ∃ x, F x ≠ (0 : ℂ))
    (hfin : ∀ x, x ∉ D.support → F x ≠ OnePoint.infty)
    (hord : ∀ x, 0 ≤ b4c_ord E F x + D x) :
    ∃ a : ℂ, ∀ x : {x : C // x ∉ D.support},
      (F x.1).elim 0 id = a +
        RiemannRochAna_principalKernelRestriction hE D
          ⟨RiemannRochAna_meroFunPrincipalData hE D hD F hFn hord,
            RiemannRochAna_meroFunPrincipalData_mem_kernel
              hE D hD F hFn hfin hord⟩ x := by
  obtain ⟨a, ha⟩ := RiemannRochAna_principalPotential_sub_explicit_const
    hE D hD F hFn hfin hord
  refine ⟨a, fun x ↦ ?_⟩
  have hax := congrFun ha x.1
  rw [RiemannRochAna_principalKernelRestriction_apply]
  simp only [RiemannRochAna_correctedPrincipal,
    RiemannRochAna_meroFunPrincipalPotential_apply, Function.const_apply,
    Pi.sub_apply, Submodule.coe_sub] at hax ⊢
  rw [RiemannRochAna_regularizedMeroFun_of_not_mem
    hE D hD F hFn hord x.1 x.2] at hax
  linear_combination hax

/-- RiemannRochAna: constants together with zero-class principal data
parameterize the Riemann--Roch space of an effective divisor. -/
theorem RiemannRochAna_effectiveParameterLinear_surjective
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (hD : ∀ x, 0 ≤ D x) :
    Function.Surjective (RiemannRochAna_effectiveParameterLinear hE D hD) := by
  intro g
  have hg : ((g : {x : C // x ∉ D.support} → ℂ) = 0) ∨
      ∃ f : b4c_MeroFun E C,
        (∃ x, f x ≠ (0 : ℂ)) ∧
        (∀ x, x ∉ D.support → f x ≠ OnePoint.infty) ∧
        (∀ x, 0 ≤ b4c_ord E f x + D x) ∧
        (g : {x : C // x ∉ D.support} → ℂ) =
          fun x ↦ (f x.1).elim 0 id := by
    have hm : (g : {x : C // x ∉ D.support} → ℂ) ∈
        (b4c_L (E := E) D : Set ({x : C // x ∉ D.support} → ℂ)) := g.property
    rw [b4c_L_eq_restrictions_aux hE D] at hm
    exact hm
  rcases hg with hg0 | ⟨F, hFn, hfin, hord, hgF⟩
  · refine ⟨0, ?_⟩
    apply Subtype.ext
    simpa using hg0.symm
  · obtain ⟨a, ha⟩ := RiemannRochAna_finiteValue_eq_effective_parameters
      hE D hD F hFn hfin hord
    let c : LinearMap.ker (RiemannRochAna_principalClassLinear hE D) :=
      ⟨RiemannRochAna_meroFunPrincipalData hE D hD F hFn hord,
        RiemannRochAna_meroFunPrincipalData_mem_kernel hE D hD F hFn hfin hord⟩
    refine ⟨(a, c), ?_⟩
    apply Subtype.ext
    funext x
    rw [RiemannRochAna_effectiveParameterLinear_apply]
    change a + RiemannRochAna_principalKernelRestriction hE D c x =
      (g : {x : C // x ∉ D.support} → ℂ) x
    rw [hgF]
    simpa only [c] using (ha x).symm

/-- RiemannRochAna: the dimension of an effective Riemann--Roch space is one
plus the dimension of the zero-obstruction principal data. -/
theorem RiemannRochAna_effective_L_finrank
    [T2Space C] [CompactSpace C] [ConnectedSpace C] [Nonempty C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (hD : ∀ x, 0 ≤ D x) :
    Module.finrank ℂ (b4c_L (E := E) D) = 1 +
      Module.finrank ℂ
        (LinearMap.ker (RiemannRochAna_principalClassLinear hE D)) := by
  let e := LinearEquiv.ofBijective
    (RiemannRochAna_effectiveParameterLinear hE D hD)
    ⟨RiemannRochAna_effectiveParameterLinear_injective hE D hD,
      RiemannRochAna_effectiveParameterLinear_surjective hE D hD⟩
  rw [← e.finrank_eq, Module.finrank_prod, Module.finrank_self]

/-- RiemannRochAna: for an effective divisor, the Riemann--Roch dimension
minus the principal-obstruction cokernel dimension has the expected index. -/
theorem RiemannRochAna_effective_L_index
    [T2Space C] [CompactSpace C] [ConnectedSpace C] [Nonempty C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (hD : ∀ x, 0 ≤ D x) :
    (Module.finrank ℂ (b4c_L (E := E) D) : ℤ) -
      Module.finrank ℂ
        (b4c_Dolbeault01 E C ⧸
          LinearMap.range (RiemannRochAna_principalClassLinear hE D)) =
      b4c_deg D - Module.finrank ℂ (b3_HolForm E C) + 1 := by
  have hL := congrArg (fun n : ℕ ↦ (n : ℤ))
    (RiemannRochAna_effective_L_finrank hE D hD)
  push_cast at hL
  have hi := RiemannRochAna_principalClass_index hE D hD
  omega

/-- RiemannRochAna: the residue pairing of finite principal data with a
holomorphic differential. -/
noncomputable def RiemannRochAna_principalResiduePairing
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (c : RiemannRochAna_PrincipalData D) (θ : b3_HolForm E C) : ℂ :=
  ∑ i, ∑ n, c i n * residue (fun z : ℂ ↦
    HurwitzPrymRR_loc (Y := C) hE θ i.1 z / z ^ ((n : ℕ) + 1)) 0

/-- RiemannRochAna: the principal residue pairing is evaluation on the
finite holomorphic jets at the divisor support. -/
theorem RiemannRochAna_principalResiduePairing_eq_jets
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (c : RiemannRochAna_PrincipalData D) (θ : b3_HolForm E C) :
    RiemannRochAna_principalResiduePairing hE D c θ =
      ∑ i, ∑ n, c i n *
        (iteratedDeriv (n : ℕ) (HurwitzPrymRR_loc (Y := C) hE θ i.1) 0 /
          ((n : ℕ).factorial : ℂ)) := by
  simp only [RiemannRochAna_principalResiduePairing]
  apply Finset.sum_congr rfl
  intro i _
  apply Finset.sum_congr rfl
  intro n _
  rw [show (fun z : ℂ ↦ HurwitzPrymRR_loc (Y := C) hE θ i.1 z /
      z ^ ((n : ℕ) + 1)) = fun z : ℂ ↦
        HurwitzPrymRR_loc (Y := C) hE θ i.1 z /
          (z - 0) ^ ((n : ℕ) + 1) by
      funext z
      rw [sub_zero],
    residue_div_sub_pow_of_analyticAt
      (RiemannRochAna_hol_loc_analytic hE θ i.1)]

/-- RiemannRochAna: a coordinate principal part extracts one normalized
holomorphic jet. -/
theorem RiemannRochAna_principalResiduePairing_single
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (i : D.support) (n : Fin (Int.toNat (D i.1)))
    (θ : b3_HolForm E C) :
    RiemannRochAna_principalResiduePairing hE D
        (Pi.single i (Pi.single n 1)) θ =
      iteratedDeriv (n : ℕ) (HurwitzPrymRR_loc (Y := C) hE θ i.1) 0 /
        ((n : ℕ).factorial : ℂ) := by
  rw [RiemannRochAna_principalResiduePairing_eq_jets]
  classical
  rw [Finset.sum_eq_single i]
  · rw [Pi.single_eq_same]
    rw [Finset.sum_eq_single n]
    · rw [Pi.single_eq_same, one_mul]
    · intro m hm hmn
      rw [Pi.single_eq_of_ne hmn, zero_mul]
    · simp
  · intro j hj hji
    rw [Pi.single_eq_of_ne hji]
    simp
  · simp

/-- RiemannRochAna: principal-part residues define a linear functional on
holomorphic differentials, linearly in the principal data. -/
noncomputable def RiemannRochAna_principalResidueLinear
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ) :
    RiemannRochAna_PrincipalData D →ₗ[ℂ] Module.Dual ℂ (b3_HolForm E C) where
  toFun c :=
    { toFun := RiemannRochAna_principalResiduePairing hE D c
      map_add' := by
        intro θ η
        simp only [RiemannRochAna_principalResiduePairing, Submodule.coe_add]
        rw [← Finset.sum_add_distrib]
        apply Finset.sum_congr rfl
        intro i _
        rw [← Finset.sum_add_distrib]
        apply Finset.sum_congr rfl
        intro n _
        let f : ℂ → ℂ := fun z ↦
          HurwitzPrymRR_loc (Y := C) hE θ i.1 z / z ^ ((n : ℕ) + 1)
        let g : ℂ → ℂ := fun z ↦
          HurwitzPrymRR_loc (Y := C) hE η i.1 z / z ^ ((n : ℕ) + 1)
        rw [show (fun z : ℂ ↦
            HurwitzPrymRR_loc (Y := C) hE (θ + η) i.1 z /
              z ^ ((n : ℕ) + 1)) = f + g by
              funext z
              simp only [f, g, Pi.add_apply, HurwitzPrymRR_loc, b4cov_coef]
              ring,
          residue_add]
        · ring
        · exact (RiemannRochAna_hol_loc_analytic hE θ i.1).meromorphicAt.div
            ((analyticAt_id.pow _).meromorphicAt)
        · exact (RiemannRochAna_hol_loc_analytic hE η i.1).meromorphicAt.div
            ((analyticAt_id.pow _).meromorphicAt)
      map_smul' := by
        intro a θ
        simp only [RiemannRochAna_principalResiduePairing, Submodule.coe_smul,
          smul_eq_mul]
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro i _
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro n _
        rw [show (fun z : ℂ ↦
            HurwitzPrymRR_loc (Y := C) hE (a • θ) i.1 z /
              z ^ ((n : ℕ) + 1)) = fun z ↦ a *
                (HurwitzPrymRR_loc (Y := C) hE θ i.1 z /
                  z ^ ((n : ℕ) + 1)) by
              funext z
              simp only [HurwitzPrymRR_loc, b4cov_coef, Pi.smul_apply,
                smul_eq_mul]
              ring,
          residue_const_mul]
        rw [RingHom.id_apply]
        ring }
  map_add' c d := by
    ext θ
    change RiemannRochAna_principalResiduePairing hE D (c + d) θ =
      RiemannRochAna_principalResiduePairing hE D c θ +
        RiemannRochAna_principalResiduePairing hE D d θ
    simp only [RiemannRochAna_principalResiduePairing, Pi.add_apply]
    rw [← Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro i _
    rw [← Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro n _
    ring
  map_smul' a c := by
    ext θ
    change RiemannRochAna_principalResiduePairing hE D (a • c) θ =
      a * RiemannRochAna_principalResiduePairing hE D c θ
    simp only [RiemannRochAna_principalResiduePairing, Pi.smul_apply,
      smul_eq_mul]
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i _
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro n _
    ring

/-- RiemannRochAna: holomorphic differentials act on allowed principal parts
through the transposed residue pairing. -/
noncomputable def RiemannRochAna_holPrincipalResidueLinear
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ) :
    b3_HolForm E C →ₗ[ℂ] Module.Dual ℂ (RiemannRochAna_PrincipalData D) :=
  (RiemannRochAna_principalResidueLinear hE D).flip

/-- RiemannRochAna: evaluation of the transposed residue map is the finite
principal residue pairing. -/
theorem RiemannRochAna_holPrincipalResidueLinear_apply
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (θ : b3_HolForm E C) (c : RiemannRochAna_PrincipalData D) :
    RiemannRochAna_holPrincipalResidueLinear hE D θ c =
      RiemannRochAna_principalResiduePairing hE D c θ := rfl

/-- RiemannRochAna: a holomorphic differential lies in the transposed
residue kernel exactly when it annihilates every allowed principal part. -/
theorem RiemannRochAna_mem_holPrincipalResidueKernel_iff
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (θ : b3_HolForm E C) :
    θ ∈ LinearMap.ker (RiemannRochAna_holPrincipalResidueLinear hE D) ↔
      ∀ c : RiemannRochAna_PrincipalData D,
        RiemannRochAna_principalResiduePairing hE D c θ = 0 := by
  rw [LinearMap.mem_ker]
  constructor
  · intro h c
    exact LinearMap.congr_fun h c
  · intro h
    apply DFunLike.ext _ _
    intro c
    exact h c

/-- RiemannRochAna: the transposed principal residue kernel consists exactly
of holomorphic forms whose permitted jets vanish at every support point. -/
theorem RiemannRochAna_mem_holPrincipalResidueKernel_iff_jets
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (θ : b3_HolForm E C) :
    θ ∈ LinearMap.ker (RiemannRochAna_holPrincipalResidueLinear hE D) ↔
      ∀ (i : D.support) (n : Fin (Int.toNat (D i.1))),
        iteratedDeriv (n : ℕ) (HurwitzPrymRR_loc (Y := C) hE θ i.1) 0 = 0 := by
  rw [RiemannRochAna_mem_holPrincipalResidueKernel_iff]
  constructor
  · intro h i n
    have hs := h (Pi.single i (Pi.single n 1))
    rw [RiemannRochAna_principalResiduePairing_single] at hs
    exact (div_eq_zero_iff.mp hs).resolve_right
      (by exact_mod_cast (n : ℕ).factorial_ne_zero)
  · intro h c
    rw [RiemannRochAna_principalResiduePairing_eq_jets]
    apply Finset.sum_eq_zero
    intro i hi
    apply Finset.sum_eq_zero
    intro n hn
    rw [h i n, zero_div, mul_zero]

/-- RiemannRochAna: the residue-kernel condition is the corresponding lower
bound on the analytic order of every centered holomorphic coefficient. -/
theorem RiemannRochAna_mem_holPrincipalResidueKernel_iff_analyticOrder
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (θ : b3_HolForm E C) :
    θ ∈ LinearMap.ker (RiemannRochAna_holPrincipalResidueLinear hE D) ↔
      ∀ i : D.support, Int.toNat (D i.1) ≤
        analyticOrderAt (HurwitzPrymRR_loc (Y := C) hE θ i.1) 0 := by
  rw [RiemannRochAna_mem_holPrincipalResidueKernel_iff_jets]
  constructor
  · intro h i
    apply (natCast_le_analyticOrderAt_iff_iteratedDeriv_eq_zero
      (RiemannRochAna_hol_loc_analytic hE θ i.1)).mpr
    intro n hn
    exact h i ⟨n, hn⟩
  · intro h i n
    exact (natCast_le_analyticOrderAt_iff_iteratedDeriv_eq_zero
      (RiemannRochAna_hol_loc_analytic hE θ i.1)).mp (h i) n n.isLt

/-- RiemannRochAna: for an analytic germ, a natural lower bound on analytic
order is the same lower bound on its meromorphic order. -/
theorem RiemannRochAna_nat_le_analyticOrder_iff_le_meromorphicOrder
    (f : ℂ → ℂ) (hf : AnalyticAt ℂ f 0) (m : ℕ) :
    m ≤ analyticOrderAt f 0 ↔
      ((m : ℤ) : WithTop ℤ) ≤ meromorphicOrderAt f 0 := by
  rw [hf.meromorphicOrderAt_eq]
  cases h : analyticOrderAt f 0 <;> simp [h]

/-- RiemannRochAna: for an effective divisor, the residue kernel imposes
the divisor multiplicity as a meromorphic-order lower bound. -/
theorem RiemannRochAna_mem_holPrincipalResidueKernel_iff_meromorphicOrder
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (hD : ∀ x, 0 ≤ D x) (θ : b3_HolForm E C) :
    θ ∈ LinearMap.ker (RiemannRochAna_holPrincipalResidueLinear hE D) ↔
      ∀ i : D.support, ((D i.1 : ℤ) : WithTop ℤ) ≤
        meromorphicOrderAt (HurwitzPrymRR_loc (Y := C) hE θ i.1) 0 := by
  rw [RiemannRochAna_mem_holPrincipalResidueKernel_iff_analyticOrder]
  apply forall_congr'
  intro i
  rw [RiemannRochAna_nat_le_analyticOrder_iff_le_meromorphicOrder _
    (RiemannRochAna_hol_loc_analytic hE θ i.1)]
  have hi : (Int.toNat (D i.1) : ℤ) = D i.1 := by
    exact Int.toNat_of_nonneg (hD i.1)
  rw [hi]

theorem b4c_meroFun_orderSupport_finite_aux [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (f : b4c_MeroFun E C) :
    (Function.support (b4c_ord E f)).Finite := by
  by_cases hnc : ∃ x x', f x ≠ f x'
  · have hzero := b4_fiber_finite_aux hE (by simp) f f.property.1 hnc
      ((0 : ℂ) : OnePoint ℂ)
    have hinfty := b4_fiber_finite_aux hE (by simp) f f.property.1 hnc OnePoint.infty
    exact (hzero.union hinfty).subset (by
      intro x hx
      simp only [Function.mem_support] at hx
      simp only [mem_union, mem_preimage, mem_singleton_iff]
      by_cases h0 : f x = (0 : ℂ)
      · exact Or.inl h0
      · right
        simp only [b4c_ord, h0, if_false] at hx
        by_contra hi
        simp [hi] at hx)
  · push_neg at hnc
    obtain ⟨x₀, hx₀⟩ := f.property.2
    have hf : ∀ x, f x = f x₀ := fun x ↦ hnc x x₀
    have hne0 : f x₀ ≠ OnePoint.infty := hx₀
    have hord : ∀ x, b4c_ord E f x = 0 := by
      intro x
      rw [b4c_ord]
      split_ifs with h0 hi
      · rw [b4_ramIndex]
        have hw : writtenInExtChartAt (modelWithCornersSelf ℂ E)
            (modelWithCornersSelf ℂ ℂ) x
            (f : C → OnePoint ℂ) =
            fun _ ↦ extChartAt (modelWithCornersSelf ℂ ℂ) (f x) (f x₀) := by
          funext z
          simp only [writtenInExtChartAt, Function.comp_apply]
          congr 1
          exact hf _
        rw [hw]
        have hs : {n : ℕ | 1 ≤ n ∧ iteratedFDeriv ℂ n
            (fun _ : E ↦ extChartAt (modelWithCornersSelf ℂ ℂ) (f x) (f x₀))
              (extChartAt (modelWithCornersSelf ℂ E) x x) ≠ 0} = ∅ := by
          ext n
          constructor
          · rintro ⟨hn, hder⟩
            exact hder (congrFun (iteratedFDeriv_const_of_ne (n := n)
              (by omega : n ≠ 0) (extChartAt (modelWithCornersSelf ℂ ℂ) (f x) (f x₀))) _)
          · simp
        rw [hs, Nat.sInf_empty]
        simp
      · exact False.elim (hne0 ((hf x).symm.trans hi))
      · rfl
    simp [Function.support, hord]
theorem b4c_meroForm_orderSupport_finite_aux [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (w : b4c_MeroForm E C hE) :
    (Function.support (b4c_ordForm (hE := hE) w)).Finite := by
  let S := Function.support (b4c_ordForm (hE := hE) w)
  have hcod : Sᶜ ∈ Filter.codiscrete C :=
    mem_codiscrete_iff_forall_mem_nhdsNE.mpr fun x ↦ by
      let F := HurwitzPrymRR_loc hE w x
      have hmer : MeromorphicAt F 0 := w.property.2 x
      have horder : ∀ᶠ z in nhdsWithin 0 (({(0 : ℂ)} : Set ℂ)ᶜ),
          meromorphicOrderAt F z = 0 ∨ meromorphicOrderAt F z = ⊤ := by
        rcases hmer.eventually_eq_zero_or_eventually_ne_zero with hz | hz
        · filter_upwards [eventually_eventually_nhdsWithin.2 hz,
            self_mem_nhdsWithin] with z hFz hz0
          right
          rw [meromorphicOrderAt_eq_top_iff]
          rw [nhdsWithin_eq_nhds.2
            (isOpen_compl_singleton.mem_nhds hz0)] at hFz
          exact Filter.Eventually.filter_mono inf_le_left hFz
        · filter_upwards [hmer.eventually_analyticAt, hz] with z haz hnz
          left
          rw [haz.meromorphicOrderAt_eq, haz.analyticOrderAt_eq_zero.2 hnz]
          rfl
      let q : C → ℂ := fun y ↦ (b4cov_lineEquiv hE).symm
        (extChartAt (modelWithCornersSelf ℂ E) x y -
          extChartAt (modelWithCornersSelf ℂ E) x x)
      have hqx : q x = 0 := by simp [q]
      have hqcont : ContinuousAt q x := by
        exact (b4cov_lineEquiv hE).symm.continuous.continuousAt.comp
          ((continuousAt_extChartAt x).sub continuousAt_const)
      have hqne : ∀ᶠ y in nhdsWithin x (({x} : Set C)ᶜ), q y ≠ 0 := by
        filter_upwards [self_mem_nhdsWithin,
          Filter.Eventually.filter_mono inf_le_left
            ((isOpen_extChartAt_source (I := modelWithCornersSelf ℂ E) x).mem_nhds
              (mem_extChartAt_source x))] with y hyx hys hyq
        have heq : extChartAt (modelWithCornersSelf ℂ E) x y =
            extChartAt (modelWithCornersSelf ℂ E) x x := by
          apply sub_eq_zero.mp
          apply (b4cov_lineEquiv hE).symm.injective
          simpa [map_sub, q] using hyq
        exact hyx ((extChartAt (modelWithCornersSelf ℂ E) x).injOn hys
          (mem_extChartAt_source x) heq)
      have hqt : Filter.Tendsto q (nhdsWithin x (({x} : Set C)ᶜ))
          (nhdsWithin 0 (({(0 : ℂ)} : Set ℂ)ᶜ)) :=
        tendsto_nhdsWithin_iff.mpr ⟨by
          rw [← hqx]
          exact hqcont.tendsto.mono_left inf_le_left,
          by simpa using hqne⟩
      filter_upwards [hqt.eventually horder,
        Filter.Eventually.filter_mono inf_le_left
          ((isOpen_extChartAt_source (I := modelWithCornersSelf ℂ E) x).mem_nhds
            (mem_extChartAt_source x))] with y hy hys
      simp only [mem_compl_iff, Function.mem_support, not_not, S]
      rw [b4c_ordForm, WithTop.untop₀_eq_zero]
      rw [HurwitzPrymRR_ord_chart hE w w.property.1 x y hys]
      exact hy
  rw [codiscrete_eq_cofinite] at hcod
  simpa [S] using hcod
theorem b4c_formRatio_spec_aux [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (w₁ w₂ : b4c_MeroForm E C hE)
    (hw₁ : (w₁ : TangentBundle 𝓘(ℂ, E) C → ℂ) ≠ 0)
    (hw₂ : (w₂ : TangentBundle 𝓘(ℂ, E) C → ℂ) ≠ 0)
    (hg₁ : ∃ x, meromorphicOrderAt (HurwitzPrymRR_loc hE w₁ x) 0 ≠ ⊤)
    (hg₂ : ∃ x, meromorphicOrderAt (HurwitzPrymRR_loc hE w₂ x) 0 ≠ ⊤) :
    (Function.support (b4c_ord E (b4c_formRatio (hE := hE) w₁ w₂))).Finite := by
  have hfin₁ := b4c_meroForm_orderSupport_finite_aux hE w₁
  have hfin₂ := b4c_meroForm_orderSupport_finite_aux hE w₂
  have htop₁ := b4c_meroForm_order_ne_top hE w₁ hg₁
  have htop₂ := b4c_meroForm_order_ne_top hE w₂ hg₂
  refine (hfin₁.union hfin₂).subset ?_
  intro x hx
  by_contra hmem
  simp only [mem_union, Function.mem_support, not_or, not_not] at hmem
  rcases hmem with ⟨hord₁, hord₂⟩
  have ho₁ : meromorphicOrderAt (HurwitzPrymRR_loc hE w₁ x) 0 = 0 := by
    have hn := htop₁ x
    lift meromorphicOrderAt (HurwitzPrymRR_loc hE w₁ x) 0 to ℤ using hn with n hn'
    unfold b4c_ordForm at hord₁
    rw [← hn'] at hord₁
    simp only [WithTop.untop₀_coe] at hord₁
    exact congrArg ((↑) : ℤ → WithTop ℤ) hord₁
  have ho₂ : meromorphicOrderAt (HurwitzPrymRR_loc hE w₂ x) 0 = 0 := by
    have hn := htop₂ x
    lift meromorphicOrderAt (HurwitzPrymRR_loc hE w₂ x) 0 to ℤ using hn with n hn'
    unfold b4c_ordForm at hord₂
    rw [← hn'] at hord₂
    simp only [WithTop.untop₀_coe] at hord₂
    exact congrArg ((↑) : ℤ → WithTop ℤ) hord₂
  let q := fun z ↦ HurwitzPrymRR_loc hE w₁ x z / HurwitzPrymRR_loc hE w₂ x z
  have hq : MeromorphicAt q 0 := (w₁.2.2 x).div (w₂.2.2 x)
  have hqo : meromorphicOrderAt q 0 = 0 := by
    simpa only [q, b4c_formRatio_germ_order hE w₁ w₂ x, ho₁, ho₂, sub_zero]
  have hqc : meromorphicTrailingCoeffAt q 0 ≠ 0 :=
    hq.meromorphicTrailingCoeffAt_ne_zero (by rw [hqo]; exact WithTop.coe_ne_top)
  apply hx
  have hval : b4c_formRatio (hE := hE) w₁ w₂ x =
      ((meromorphicTrailingCoeffAt q 0 : ℂ) : OnePoint ℂ) := by
    unfold b4c_formRatio
    change (if meromorphicOrderAt q 0 < 0 then OnePoint.infty
      else if meromorphicOrderAt q 0 = 0 then
        ((meromorphicTrailingCoeffAt q 0 : ℂ) : OnePoint ℂ) else (0 : ℂ)) = _
    rw [hqo]
    simp
  unfold b4c_ord
  rw [hval]
  simp [hqc]
theorem b4c_pullback_mem_aux [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) {E' Y : Type} [NormedAddCommGroup E'] [NormedSpace ℂ E']
    [TopologicalSpace Y] [ChartedSpace E' Y] [IsManifold 𝓘(ℂ, E') ω Y]
    (hE' : Module.finrank ℂ E' = 1) (f : C → Y)
    (hf : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E') ω f) (hnc : ∃ x x', f x ≠ f x')
    (w : b4c_MeroForm E' Y hE') :
    (Function.support (b4c_ordForm (hE := hE)
      (b4c_pullback (hE := hE) (hE' := hE') f w))).Finite := by
  exact b4c_meroForm_orderSupport_finite_aux hE
    ⟨b4c_pullback (hE := hE) (hE' := hE') f w,
      b4c_pullback_isMeroForm_aux hE hE' f hf hnc w⟩

theorem b4c_deg_div_meroFun_aux [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (f : b4c_MeroFun E C)
    (hf : ∃ x, f x ≠ (0 : ℂ)) : b4c_deg (b4c_div E f) = 0 := by
  have hfin := b4c_meroFun_orderSupport_finite_aux hE f
  simp only [b4c_div, dif_pos hfin, b4c_deg, Finsupp.sum_onFinset]
  rw [show (Finsupp.onFinset hfin.toFinset (b4c_ord E f)
      (fun x hx ↦ hfin.mem_toFinset.mpr hx)).sum (fun _ n ↦ n) =
      ∑ x ∈ hfin.toFinset, b4c_ord E f x by simp]
  rw [← finsum_eq_finsetSum_of_support_subset (b4c_ord E f) (by
    intro x hx
    exact hfin.mem_toFinset.mpr hx)]
  by_cases hnc : ∃ x x', f x ≠ f x'
  · let A : C → ℤ := fun x ↦ if f x = ((0 : ℂ) : OnePoint ℂ) then b4_ramIndex E ℂ f x else 0
    let B : C → ℤ := fun x ↦ if f x = OnePoint.infty then b4_ramIndex E ℂ f x else 0
    have hAf : (Function.support A).Finite :=
      (b4_fiber_finite_aux hE (by simp) f f.property.1 hnc ((0 : ℂ) : OnePoint ℂ)).subset (by
        intro x hx
        simp only [Function.mem_support, A] at hx
        simp only [mem_preimage, mem_singleton_iff]
        by_contra h
        simp [h] at hx)
    have hBf : (Function.support B).Finite :=
      (b4_fiber_finite_aux hE (by simp) f f.property.1 hnc OnePoint.infty).subset (by
        intro x hx
        simp only [Function.mem_support, B] at hx
        simp only [mem_preimage, mem_singleton_iff]
        by_contra h
        simp [h] at hx)
    rw [show b4c_ord E f = fun x ↦ A x - B x by
      funext x
      simp only [b4c_ord, A, B]
      split_ifs <;> simp_all]
    rw [finsum_sub_distrib hAf hBf]
    have hA : ∑ᶠ x, A x = (b4_fiberDegree E ℂ f ((0 : ℂ) : OnePoint ℂ) : ℤ) := by
      rw [b4_fiberDegree, Nat.cast_finsum_mem
        (b4_fiber_finite_aux hE (by simp) f f.property.1 hnc ((0 : ℂ) : OnePoint ℂ))]
      rw [finsum_mem_def]
      apply finsum_congr
      intro x
      by_cases hx : f x = ((0 : ℂ) : OnePoint ℂ) <;> simp [A, Set.indicator, hx]
    have hB : ∑ᶠ x, B x = (b4_fiberDegree E ℂ f OnePoint.infty : ℤ) := by
      rw [b4_fiberDegree, Nat.cast_finsum_mem
        (b4_fiber_finite_aux hE (by simp) f f.property.1 hnc OnePoint.infty)]
      rw [finsum_mem_def]
      apply finsum_congr
      intro x
      by_cases hx : f x = OnePoint.infty <;> simp [B, Set.indicator, hx]
    rw [hA, hB, b4_fiberDegree_eq_aux hE (by simp) f f.property.1 hnc
      ((0 : ℂ) : OnePoint ℂ) OnePoint.infty]
    simp
  · push_neg at hnc
    obtain ⟨x₀, hx₀⟩ := f.property.2
    have hconst : ∀ x, f x = f x₀ := fun x ↦ hnc x x₀
    have hne0 : f x₀ ≠ OnePoint.infty := hx₀
    have hord : ∀ x, b4c_ord E f x = 0 := by
      intro x
      rw [b4c_ord]
      split_ifs with h0 hi
      · rw [b4_ramIndex]
        have hw : writtenInExtChartAt (modelWithCornersSelf ℂ E)
            (modelWithCornersSelf ℂ ℂ) x (f : C → OnePoint ℂ) =
            fun _ ↦ extChartAt (modelWithCornersSelf ℂ ℂ) (f x) (f x₀) := by
          funext z
          simp only [writtenInExtChartAt, Function.comp_apply]
          congr 1
          exact hconst _
        rw [hw]
        have hs : {n : ℕ | 1 ≤ n ∧ iteratedFDeriv ℂ n
            (fun _ : E ↦ extChartAt (modelWithCornersSelf ℂ ℂ) (f x) (f x₀))
              (extChartAt (modelWithCornersSelf ℂ E) x x) ≠ 0} = ∅ := by
          ext n
          constructor
          · rintro ⟨hn, hder⟩
            exact hder (congrFun (iteratedFDeriv_const_of_ne (n := n)
              (by omega : n ≠ 0) (extChartAt (modelWithCornersSelf ℂ ℂ) (f x) (f x₀))) _)
          · simp
        rw [hs, Nat.sInf_empty]
        simp
      · exact False.elim (hne0 ((hconst x).symm.trans hi))
      · rfl
    simp [hord]
theorem b4c_targetLocal_zero (hE : Module.finrank ℂ E = 1)
    (F : C → OnePoint ℂ) (x : C) :
    b4c_targetLocal hE F x 0 = (F x).elim 0 id := by
  simp only [b4c_targetLocal, b4cov_expr, Function.comp_apply,
    map_zero, add_zero, extChartAt_to_inv]
  generalize F x = p
  induction p using OnePoint.rec with
  | infty =>
    change b4cov_chartInf OnePoint.infty = 0
    rw [b4cov_chartInf_apply, b4cov_sphInv_infty, b4cov_chart0_coe]
  | coe a => exact b4cov_chart0_coe a

theorem b4c_targetLocal_formRatio_zero_germ (hE : Module.finrank ℂ E = 1)
    (w₁ w₂ : b4c_MeroForm E C hE)
    (htop₁ : ∀ x, meromorphicOrderAt (HurwitzPrymRR_loc hE w₁ x) 0 ≠ ⊤)
    (htop₂ : ∀ x, meromorphicOrderAt (HurwitzPrymRR_loc hE w₂ x) 0 ≠ ⊤)
    (x : C) (hx : b4c_formRatio (hE := hE) w₁ w₂ x = (0 : ℂ)) :
    b4c_targetLocal hE (b4c_formRatio (hE := hE) w₁ w₂) x =ᶠ[nhdsWithin 0 {0}ᶜ]
      (fun t ↦ HurwitzPrymRR_loc hE w₁ x t / HurwitzPrymRR_loc hE w₂ x t) := by
  have hp := b4c_inverse_centeredCoordinate_punctured hE x
    (b4c_formRatio_punctured_chart hE w₁ w₂ htop₁ htop₂ x)
  have hc : (fun t : ℂ ↦ b4c_centeredCoordinate hE x
      ((extChartAt 𝓘(ℂ, E) x).symm
        (extChartAt 𝓘(ℂ, E) x x + b4cov_lineEquiv hE t))) =ᶠ[nhdsWithin 0 {0}ᶜ]
      id := (b4c_centeredCoordinate_inverse_eventuallyEq hE x).filter_mono
        nhdsWithin_le_nhds
  filter_upwards [hp, hc] with t ht hc
  simp only [b4c_targetLocal, b4cov_expr, Function.comp_apply]
  rw [ht, hc]
  simp only [hx, extChartAt_coe,
    b4cov_chartAt_coe, modelWithCornersSelf_coe, Function.comp_apply, id_eq,
    b4cov_chart0_coe]

theorem b4c_targetLocal_formRatio_infty_germ (hE : Module.finrank ℂ E = 1)
    (w₁ w₂ : b4c_MeroForm E C hE)
    (htop₁ : ∀ x, meromorphicOrderAt (HurwitzPrymRR_loc hE w₁ x) 0 ≠ ⊤)
    (htop₂ : ∀ x, meromorphicOrderAt (HurwitzPrymRR_loc hE w₂ x) 0 ≠ ⊤)
    (x : C) (hx : b4c_formRatio (hE := hE) w₁ w₂ x = OnePoint.infty) :
    b4c_targetLocal hE (b4c_formRatio (hE := hE) w₁ w₂) x =ᶠ[nhdsWithin 0 {0}ᶜ]
      (fun t ↦ (HurwitzPrymRR_loc hE w₁ x t /
        HurwitzPrymRR_loc hE w₂ x t)⁻¹) := by
  let q := fun t ↦ HurwitzPrymRR_loc hE w₁ x t / HurwitzPrymRR_loc hE w₂ x t
  have hq : MeromorphicAt q 0 := (w₁.2.2 x).div (w₂.2.2 x)
  have hqo : meromorphicOrderAt q 0 ≠ ⊤ := by
    rw [b4c_formRatio_germ_order hE w₁ w₂ x]
    lift meromorphicOrderAt (HurwitzPrymRR_loc hE w₁ x) 0 to ℤ using htop₁ x with a ha
    lift meromorphicOrderAt (HurwitzPrymRR_loc hE w₂ x) 0 to ℤ using htop₂ x with b hb
    simp
  have hn := (meromorphicOrderAt_ne_top_iff_eventually_ne_zero hq).mp hqo
  have hp := b4c_inverse_centeredCoordinate_punctured hE x
    (b4c_formRatio_punctured_chart hE w₁ w₂ htop₁ htop₂ x)
  have hc : (fun t : ℂ ↦ b4c_centeredCoordinate hE x
      ((extChartAt 𝓘(ℂ, E) x).symm
        (extChartAt 𝓘(ℂ, E) x x + b4cov_lineEquiv hE t))) =ᶠ[nhdsWithin 0 {0}ᶜ]
      id := (b4c_centeredCoordinate_inverse_eventuallyEq hE x).filter_mono
        nhdsWithin_le_nhds
  filter_upwards [hp, hc, hn] with t ht hc hn
  simp only [b4c_targetLocal, b4cov_expr, Function.comp_apply]
  rw [ht, hc]
  simp only [hx, extChartAt_coe, b4cov_chartAt_infty,
    modelWithCornersSelf_coe, Function.comp_apply, id_eq]
  change b4cov_chartInf ((q t : ℂ) : OnePoint ℂ) = (q t)⁻¹
  rw [b4cov_chartInf_apply, b4cov_sphInv_coe hn, b4cov_chart0_coe]

theorem b4c_formRatio_order_aux [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (w₁ w₂ : b4c_MeroForm E C hE)
    (hw₁ : (w₁ : TangentBundle 𝓘(ℂ, E) C → ℂ) ≠ 0)
    (hw₂ : (w₂ : TangentBundle 𝓘(ℂ, E) C → ℂ) ≠ 0)
    (hg₁ : ∃ x, meromorphicOrderAt (HurwitzPrymRR_loc hE w₁ x) 0 ≠ ⊤)
    (hg₂ : ∃ x, meromorphicOrderAt (HurwitzPrymRR_loc hE w₂ x) 0 ≠ ⊤)
    (x : C) :
    b4c_ord E (b4c_formRatio (hE := hE) w₁ w₂) x =
      b4c_ordForm (hE := hE) w₁ x - b4c_ordForm (hE := hE) w₂ x := by
  let F := b4c_formRatio (hE := hE) w₁ w₂
  let q := fun t ↦ HurwitzPrymRR_loc hE w₁ x t / HurwitzPrymRR_loc hE w₂ x t
  have htop₁ := b4c_meroForm_order_ne_top hE w₁ hg₁
  have htop₂ := b4c_meroForm_order_ne_top hE w₂ hg₂
  have hF := (b4c_formRatio_isMeroFun_aux hE w₁ w₂ hw₁ hw₂ hg₁ hg₂).1
  have hq : MeromorphicAt q 0 := (w₁.2.2 x).div (w₂.2.2 x)
  lift meromorphicOrderAt (HurwitzPrymRR_loc hE w₁ x) 0 to ℤ using htop₁ x with a ha
  lift meromorphicOrderAt (HurwitzPrymRR_loc hE w₂ x) 0 to ℤ using htop₂ x with b hb
  have hqo : meromorphicOrderAt q 0 = ((a - b : ℤ) : WithTop ℤ) := by
    rw [b4c_formRatio_germ_order hE w₁ w₂ x, ← ha, ← hb]
    norm_cast
  have hordform : b4c_ordForm (hE := hE) w₁ x - b4c_ordForm (hE := hE) w₂ x =
      a - b := by
    simp [b4c_ordForm, ← ha, ← hb]
  rw [hordform]
  have hreg := b4c_formRatio_punctured_chart hE w₁ w₂ htop₁ htop₂ x
  letI : (nhdsWithin x {x}ᶜ).NeBot := b4c_punctured_nhds_neBot hE x
  have hz : Tendsto (b4c_centeredCoordinate hE x) (nhdsWithin x {x}ᶜ)
      (nhdsWithin 0 {0}ᶜ) := by
    refine tendsto_nhdsWithin_iff.mpr ⟨?_, ?_⟩
    · simpa only [b4c_centeredCoordinate_self hE x] using
        (b4c_centeredCoordinate_contMDiffAt hE x x
          (mem_extChartAt_source x)).continuousAt.tendsto.mono_left nhdsWithin_le_nhds
    · have hs : ∀ᶠ y in nhds x, y ∈ (extChartAt 𝓘(ℂ, E) x).source :=
        (isOpen_extChartAt_source x).mem_nhds (mem_extChartAt_source x)
      filter_upwards [hs.filter_mono nhdsWithin_le_nhds,
        self_mem_nhdsWithin] with y hys hyx
      exact b4c_centeredCoordinate_ne hE x y hys hyx
  have hnq := hz.eventually
    ((meromorphicOrderAt_ne_top_iff_eventually_ne_zero hq).mp (by rw [hqo]; simp))
  obtain ⟨y, hy, hny⟩ := (hreg.and hnq).exists
  have hFyfin : F y ≠ OnePoint.infty := by
    rw [show F y = _ from hy]
    exact OnePoint.coe_ne_infty _
  have hFyne : F y ≠ (0 : ℂ) := by
    rw [show F y = _ from hy]
    exact_mod_cast hny
  by_cases hn : a - b < 0
  · have hFx : F x = OnePoint.infty := by
      unfold F b4c_formRatio
      change (if meromorphicOrderAt q 0 < 0 then OnePoint.infty else _) = _
      rw [hqo, if_pos]
      exact_mod_cast hn
    have hnc : ∃ u v, F u ≠ F v := ⟨x, y, by rw [hFx]; exact hFyfin.symm⟩
    have ht := b4c_targetLocal_order hE F hF hnc x (by
      rw [b4c_targetLocal_zero, hFx]
      rfl)
    have hgerm := b4c_targetLocal_formRatio_infty_germ hE w₁ w₂ htop₁ htop₂ x hFx
    have hi : meromorphicOrderAt (b4c_targetLocal hE F x) 0 = -(a - b) := by
      rw [meromorphicOrderAt_congr hgerm]
      change meromorphicOrderAt q⁻¹ 0 = _
      rw [meromorphicOrderAt_inv, hqo]
      simp
    dsimp only [F] at ht hi
    have hram : (b4_ramIndex E ℂ (b4c_formRatio (hE := hE) w₁ w₂) x : ℤ) =
        -(a - b) := by
      exact WithTop.coe_eq_coe.mp (ht.symm.trans hi)
    unfold b4c_ord
    change (if F x = (0 : ℂ) then _ else if F x = OnePoint.infty then _ else _) = _
    rw [hFx, if_neg (by simp), if_pos rfl, hram]
    omega
  · by_cases hz : a - b = 0
    · have hFx0 : F x ≠ (0 : ℂ) := by
        unfold F b4c_formRatio
        change (if meromorphicOrderAt q 0 < 0 then OnePoint.infty
          else if meromorphicOrderAt q 0 = 0 then
            ((meromorphicTrailingCoeffAt q 0 : ℂ) : OnePoint ℂ) else (0 : ℂ)) ≠ _
        rw [hqo]
        simp [hz, hq.meromorphicTrailingCoeffAt_ne_zero (by rw [hqo, hz]; simp)]
      have hFxi : F x ≠ OnePoint.infty := by
        unfold F b4c_formRatio
        change (if meromorphicOrderAt q 0 < 0 then OnePoint.infty
          else if meromorphicOrderAt q 0 = 0 then
            ((meromorphicTrailingCoeffAt q 0 : ℂ) : OnePoint ℂ) else (0 : ℂ)) ≠ _
        rw [hqo]
        simp [hz]
      unfold b4c_ord
      change (if F x = (0 : ℂ) then _ else if F x = OnePoint.infty then _ else _) = _
      rw [if_neg hFx0, if_neg hFxi, hz]
    · have hp : 0 < a - b := lt_of_le_of_ne (le_of_not_gt hn) (Ne.symm hz)
      have hFx : F x = (0 : ℂ) := by
        unfold F b4c_formRatio
        change (if meromorphicOrderAt q 0 < 0 then OnePoint.infty
          else if meromorphicOrderAt q 0 = 0 then
            ((meromorphicTrailingCoeffAt q 0 : ℂ) : OnePoint ℂ) else (0 : ℂ)) = _
        rw [hqo]
        have hnl0 : ¬a - b < 0 := not_lt.mpr hp.le
        have hnl : ¬((a - b : ℤ) : WithTop ℤ) < 0 := by exact_mod_cast hnl0
        have hnz : ((a - b : ℤ) : WithTop ℤ) ≠ 0 := by exact_mod_cast hz
        rw [if_neg hnl, if_neg hnz]
      have hnc : ∃ u v, F u ≠ F v := ⟨x, y, by rw [hFx]; exact hFyne.symm⟩
      have ht := b4c_targetLocal_order hE F hF hnc x (by
        rw [b4c_targetLocal_zero, hFx]
        rfl)
      have hgerm := b4c_targetLocal_formRatio_zero_germ hE w₁ w₂ htop₁ htop₂ x hFx
      have heq : meromorphicOrderAt (b4c_targetLocal hE F x) 0 = (a - b : ℤ) := by
        rw [meromorphicOrderAt_congr hgerm, hqo]
      dsimp only [F] at ht heq
      have hram : (b4_ramIndex E ℂ (b4c_formRatio (hE := hE) w₁ w₂) x : ℤ) =
          a - b := by
        exact WithTop.coe_eq_coe.mp (ht.symm.trans heq)
      unfold b4c_ord
      change (if F x = (0 : ℂ) then _ else if F x = OnePoint.infty then _ else _) = _
      rw [hFx, if_pos rfl, hram]
lemma RiemannRochTop_sphere_ordered_monodromy
    (B : Set (OnePoint ℂ)) (hB : B.Finite) (hinfty : OnePoint.infty ∈ B)
    (hne : ∃ a : ℂ, (a : OnePoint ℂ) ∈ B) (y₀ : {y : OnePoint ℂ // y ∉ B}) :
    ∃ n : ℕ, ∃ j : Fin (n + 1) ≃ {a : ℂ // (a : OnePoint ℂ) ∈ B},
    let β : Fin (n + 2) → OnePoint ℂ :=
      Fin.cases OnePoint.infty (fun i ↦ ((j i : ℂ) : OnePoint ℂ))
    ∃ γ : Fin (n + 2) → FundamentalGroup {y : OnePoint ℂ // y ∉ B} y₀,
      (List.ofFn γ).prod = 1 ∧
      (∀ (H : Type) [Group H] (v : Fin (n + 2) → H), (List.ofFn v).prod = 1 →
        ∃! φ : FundamentalGroup {y : OnePoint ℂ // y ∉ B} y₀ →* H,
          ∀ i, φ (γ i) = v i) ∧
      ∀ (E' : Type) [NormedAddCommGroup E'] [NormedSpace ℂ E']
        (hE' : Module.finrank ℂ E' = 1) (C' : Type) [TopologicalSpace C'] [ChartedSpace E' C'] [IsManifold 𝓘(ℂ, E') ω C']
        [T2Space C'] [CompactSpace C'] [ConnectedSpace C'] (G : Type) [Group G] [Finite G]
        [MulAction G C'] [FaithfulSMul G C'],
        (∀ g : G, ContMDiff 𝓘(ℂ, E') 𝓘(ℂ, E') ω (fun x : C' ↦ g • x)) →
        ∀ f : C' → OnePoint ℂ, ContMDiff 𝓘(ℂ, E') 𝓘(ℂ, ℂ) ω f → b4_IsGaloisCover G f →
        (∀ x, f x ∉ B → MulAction.stabilizer G x = ⊥) →
        ∀ (j : Fin (n + 2)) (c : Path y₀ y₀), FundamentalGroup.fromPath ⟦c⟧ = γ j →
        ∀ (Γ : C(unitInterval, C')) (k : G), (∀ t, f (Γ t) = (c t : OnePoint ℂ)) →
          Γ 1 = k • Γ 0 → ∃ x, f x = β j ∧ b4_IsRotGen E' x k := by
  obtain ⟨g, hgeom, hout, hu⟩ := RiemannRochTop_sphere_positive_basis_outer B hB hinfty hne y₀
  obtain ⟨n, j, R, hR, w, hw0, hw, havoid, y, k, d, hd, hclass⟩ := hout
  have hu' : ∀ (H : Type) [Group H] (v : Fin (n + 1) → H),
      ∃! φ : FundamentalGroup {y : OnePoint ℂ // y ∉ B} y₀ →* H,
        ∀ i, φ (g (j i)) = v i := by
    intro H _ v
    obtain ⟨φ, hφ, huniq⟩ := hu H (fun a ↦ v (j.symm a))
    refine ⟨φ, fun i ↦ by simpa using hφ (j i), ?_⟩
    intro ψ hψ
    apply huniq
    intro a
    simpa using hψ (j.symm a)
  obtain ⟨hprod, huniv⟩ := RiemannRochTop_adjoin_inverse_product (fun i ↦ g (j i)) hu'
  refine ⟨n, j, _, hprod, huniv, ?_⟩
  intro E' _ _ hE' C' _ _ _ _ _ _ G _ _ _ _ hG f hf hgal hfree i c hc Γ l hΓ hend
  induction i using Fin.cases with
  | zero =>
    apply RiemannRochTop_rotGen_infinity_circle hE' hG f hf hgal B hB hfree
      0 R (by simpa only [zero_add] using havoid) w hw hw0 k d
      (fun t ↦ by rw [zero_add]; exact hd t) c (hc.trans hclass.symm) Γ l hΓ hend
  | succ i =>
    obtain ⟨ρ, v, hv0, hv, hav, z, a, e, he, heclass⟩ := hgeom (j i)
    exact RiemannRochTop_rotGen_affine_circle hE' hG f hf hgal B hB hfree
      (j i) ρ hav v hv hv0 a e he c (hc.trans heclass.symm) Γ l hΓ hend

/-- RiemannRochTop: conjugating one free generator by another is an automorphism. -/
lemma RiemannRochTop_free_conjugate_generator {α : Type} (a b : α) (hab : a ≠ b) :
    ∃ e : FreeGroup α ≃* FreeGroup α, ∀ z,
      e (FreeGroup.of z) = if z = b then
        (FreeGroup.of a)⁻¹ * FreeGroup.of b * FreeGroup.of a else FreeGroup.of z := by
  classical
  let f : FreeGroup α →* FreeGroup α := FreeGroup.lift (fun z ↦ if z = b then
    (FreeGroup.of a)⁻¹ * FreeGroup.of b * FreeGroup.of a else FreeGroup.of z)
  let g : FreeGroup α →* FreeGroup α := FreeGroup.lift (fun z ↦ if z = b then
    FreeGroup.of a * FreeGroup.of b * (FreeGroup.of a)⁻¹ else FreeGroup.of z)
  have hf : f.comp g = MonoidHom.id _ := by
    apply FreeGroup.ext_hom
    intro z
    by_cases hz : z = b
    · subst z
      simp [f, g, hab, mul_assoc]
    · simp [f, g, hz]
  have hg : g.comp f = MonoidHom.id _ := by
    apply FreeGroup.ext_hom
    intro z
    by_cases hz : z = b
    · subst z
      simp [f, g, hab, mul_assoc]
    · simp [f, g, hz]
  refine ⟨{
    toFun := f
    invFun := g
    left_inv := fun x ↦ congrArg (fun h : FreeGroup α →* FreeGroup α ↦ h x) hg,
    right_inv := fun x ↦ congrArg (fun h : FreeGroup α →* FreeGroup α ↦ h x) hf,
    map_mul' := f.map_mul }, ?_⟩
  intro z
  exact FreeGroup.lift_apply_of

/-- RiemannRochTop: permuting distinct free generators preserves their product up to a basis-conjugating automorphism. -/
lemma RiemannRochTop_free_reorder {α : Type} {l₁ l₂ : List α}
    (h : l₁.Perm l₂) (hn : l₁.Nodup) :
    ∃ e : FreeGroup α ≃* FreeGroup α,
      e (l₂.map FreeGroup.of).prod = (l₁.map FreeGroup.of).prod ∧
      (∀ a, IsConj (FreeGroup.of a) (e (FreeGroup.of a))) ∧
      (∀ a, a ∉ l₁ → e (FreeGroup.of a) = FreeGroup.of a) := by
  classical
  induction h with
  | nil => exact ⟨MulEquiv.refl _, rfl, (fun _ ↦ IsConj.refl _), fun _ _ ↦ rfl⟩
  | @cons a l₁ l₂ h ih =>
    obtain ⟨e, he, hc, hs⟩ := ih hn.of_cons
    refine ⟨e, ?_, hc, fun z hz ↦ hs z (fun hz' ↦ hz (List.mem_cons_of_mem _ hz'))⟩
    simp only [List.map_cons, List.prod_cons, map_mul, hs a (List.nodup_cons.mp hn).1, he]
  | swap a b l =>
    have hba : b ≠ a := fun hba ↦ (List.nodup_cons.mp hn).1 (by simp [hba])
    obtain ⟨e, he⟩ := RiemannRochTop_free_conjugate_generator a b hba.symm
    have hs : e (l.map FreeGroup.of).prod = (l.map FreeGroup.of).prod := by
      rw [map_list_prod, List.map_map]
      congr 1
      apply List.map_congr_left
      intro z hz
      rw [Function.comp_apply, he, ite_eq_right]
      intro hzb
      exact (List.nodup_cons.mp hn).1 (List.mem_cons_of_mem _ (hzb ▸ hz))
    refine ⟨e, ?_, ?_, ?_⟩
    · simp [List.map_cons, List.prod_cons, map_mul, he, hba.symm, hs, mul_assoc]
    · intro z
      rw [he]
      split_ifs with hz
      · subst z
        exact isConj_iff.mpr ⟨(FreeGroup.of a)⁻¹, by simp⟩
      · exact IsConj.refl _
    · intro z hz
      rw [he, ite_eq_right]
      intro hzb
      exact hz (by simp [hzb])
  | @trans l₁ l₂ l₃ h₁ h₂ ih₁ ih₂ =>
    obtain ⟨e₁, he₁, hc₁, hs₁⟩ := ih₁ hn
    obtain ⟨e₂, he₂, hc₂, hs₂⟩ := ih₂ (h₁.nodup_iff.mp hn)
    refine ⟨e₂.trans e₁, ?_, ?_, ?_⟩
    · change e₁ (e₂ _) = _
      rw [he₂, he₁]
    · intro a
      exact (hc₁ a).trans (e₁.toMonoidHom.map_isConj (hc₂ a))
    · intro a ha
      change e₁ (e₂ _) = _
      rw [hs₂ a (fun ha₂ ↦ ha (h₁.mem_iff.mpr ha₂)), hs₁ a ha]

/-- RiemannRochTop: a one-relation presentation can be reordered by conjugating its generators. -/
lemma RiemannRochTop_presentation_reorder {α Γ : Type} [Group Γ]
    {l₁ l₂ : List α} (h : l₁.Perm l₂) (hn : l₁.Nodup) (γ : α → Γ)
    (hp : (l₁.map γ).prod = 1)
    (hu : ∀ (H : Type) [Group H] (v : α → H), (l₁.map v).prod = 1 →
      ∃! φ : Γ →* H, ∀ a, φ (γ a) = v a) :
    ∃ δ : α → Γ, (l₂.map δ).prod = 1 ∧
      (∀ a, IsConj (γ a) (δ a)) ∧
      ∀ (H : Type) [Group H] (v : α → H), (l₂.map v).prod = 1 →
        ∃! φ : Γ →* H, ∀ a, φ (δ a) = v a := by
  obtain ⟨e, he, hc, _⟩ := RiemannRochTop_free_reorder h hn
  let F : FreeGroup α →* Γ := FreeGroup.lift γ
  let δ : α → Γ := fun a ↦ F (e (FreeGroup.of a))
  have hmap : (l₂.map δ).prod = F (e (l₂.map FreeGroup.of).prod) := by
    simp only [map_list_prod, List.map_map, Function.comp_def, δ]
  refine ⟨δ, ?_, ?_, ?_⟩
  · rw [hmap, he]
    simpa only [F, map_list_prod, List.map_map, Function.comp_def, FreeGroup.lift_apply_of] using hp
  · intro a
    simpa only [F, FreeGroup.lift_apply_of] using F.map_isConj (hc a)
  · intro H _ v hv
    let K : FreeGroup α →* H := FreeGroup.lift v
    let V : FreeGroup α →* H := K.comp e.symm.toMonoidHom
    have hV : (l₁.map (fun a ↦ V (FreeGroup.of a))).prod = 1 := by
      have hv' : K (l₂.map FreeGroup.of).prod = 1 := by simpa only [K, map_list_prod, List.map_map, Function.comp_def, FreeGroup.lift_apply_of] using hv
      have he' : V (l₁.map FreeGroup.of).prod = K (l₂.map FreeGroup.of).prod := by
        rw [← he]
        exact congrArg K (e.symm_apply_apply _)
      simpa only [map_list_prod, List.map_map, Function.comp_def] using he'.trans hv'
    obtain ⟨φ, hφ, huniq⟩ := hu H (fun a ↦ V (FreeGroup.of a)) hV
    have hφF : φ.comp F = V := by
      apply FreeGroup.ext_hom
      simpa only [MonoidHom.comp_apply, F, FreeGroup.lift_apply_of] using hφ
    have hφδ : ∀ a, φ (δ a) = v a := by
      intro a
      change (φ.comp F) (e (FreeGroup.of a)) = v a
      rw [hφF]
      simp [V, K]
    refine ⟨φ, hφδ, ?_⟩
    intro ψ hψ
    have hψK : (ψ.comp F).comp e.toMonoidHom = K := by
      apply FreeGroup.ext_hom
      simpa only [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, K,
        FreeGroup.lift_apply_of, δ] using hψ
    apply huniq
    intro a
    have hEq := congrArg (fun f : FreeGroup α →* H ↦ f (e.symm (FreeGroup.of a))) hψK
    simpa [V, F] using hEq

/-- RiemannRochTop: conjugate loop classes transfer deck endpoints through a covering. -/
lemma RiemannRochTop_coveringOn_conjugate_class_lift
    {X U : Type} [TopologicalSpace X] [TopologicalSpace U]
    (f : U → X) (B : Set X) (hf : IsCoveringMapOn f Bᶜ)
    (T : C(U, U)) (hT : ∀ u, f (T u) = f u)
    {x : ↥Bᶜ} (c d : Path x x)
    (hc : IsConj (FundamentalGroup.fromPath ⟦d⟧) (FundamentalGroup.fromPath ⟦c⟧))
    (Δ : C(unitInterval, U)) (hΔ : ∀ t, f (Δ t) = (c t : X))
    (hend : Δ 1 = T (Δ 0)) :
    ∃ Γ : C(unitInterval, U), (∀ t, f (Γ t) = (d t : X)) ∧ Γ 1 = T (Γ 0) := by
  obtain ⟨u, hu⟩ := isConj_iff.mp hc
  obtain ⟨a, ha⟩ := Quotient.exists_rep u.toPath
  have hu' : FundamentalGroup.fromPath ⟦a⟧ = u := congrArg FundamentalGroup.fromPath ha
  subst u
  have hclass : FundamentalGroup.fromPath ⟦c⟧ =
      FundamentalGroup.fromPath ⟦a.symm.trans (d.trans a.symm.symm)⟧ := by
    change FundamentalGroup.fromPath ⟦a.symm.trans (d.trans a)⟧ =
      FundamentalGroup.fromPath ⟦c⟧ at hu
    simpa only [Path.symm_symm] using hu.symm
  obtain ⟨Λ, hΛ, hΛ0, hΛ1⟩ := RiemannRochTop_coveringOn_replace_loop f B hf
    c (a.symm.trans (d.trans a.symm.symm)) hclass Δ hΔ
  apply RiemannRochTop_coveringOn_conjugated_loop_lift f B hf T hT a.symm d Λ hΛ
  rw [hΛ1, hΛ0]
  exact hend

/-- RiemannRochTop: adjoining infinity to an affine puncture enumeration enumerates the sphere punctures. -/
lemma RiemannRochTop_puncture_enumeration
    (B : Set (OnePoint ℂ)) (hi : OnePoint.infty ∈ B) {n : ℕ}
    (j : Fin n ≃ {a : ℂ // (a : OnePoint ℂ) ∈ B}) :
    ∃ e : Fin (n + 1) ≃ B, ∀ i,
      (e i : OnePoint ℂ) = Fin.cases OnePoint.infty (fun k ↦ ((j k : ℂ) : OnePoint ℂ)) i := by
  let β : Fin (n + 1) → B := Fin.cases ⟨OnePoint.infty, hi⟩
    (fun k ↦ ⟨((j k : ℂ) : OnePoint ℂ), (j k).property⟩)
  have hβ : Function.Bijective β := by
    constructor
    · intro i k h
      induction i using Fin.cases with
      | zero =>
        induction k using Fin.cases with
        | zero => rfl
        | succ k => exact False.elim (OnePoint.coe_ne_infty _ (congrArg Subtype.val h).symm)
      | succ i =>
        induction k using Fin.cases with
        | zero => exact False.elim (OnePoint.coe_ne_infty _ (congrArg Subtype.val h))
        | succ k =>
          congr 1
          apply j.injective
          exact Subtype.ext (OnePoint.coe_injective (congrArg Subtype.val h))
    · intro y
      by_cases hy : (y : OnePoint ℂ) = OnePoint.infty
      · exact ⟨0, Subtype.ext hy.symm⟩
      · obtain ⟨z, hz⟩ := OnePoint.ne_infty_iff_exists.mp hy
        let a : {a : ℂ // (a : OnePoint ℂ) ∈ B} := ⟨z, hz ▸ y.property⟩
        refine ⟨(j.symm a).succ, ?_⟩
        apply Subtype.ext
        change ((j (j.symm a) : ℂ) : OnePoint ℂ) = y
        rw [j.apply_symm_apply]
        exact hz
  refine ⟨Equiv.ofBijective β hβ, ?_⟩
  intro i
  induction i using Fin.cases <;> rfl

/-- RiemannRochTop: any enumeration of a sphere puncture set supports the ordered monodromy presentation. -/
lemma RiemannRochTop_sphere_enumerated_full
    (B : Set (OnePoint ℂ)) (hB : B.Finite) (hinfty : OnePoint.infty ∈ B)
    (hne : ∃ a : ℂ, (a : OnePoint ℂ) ∈ B) {r : ℕ} (b : Fin r ≃ B)
    (y₀ : {y : OnePoint ℂ // y ∉ B}) :
    ∃ γ : Fin r → FundamentalGroup {y : OnePoint ℂ // y ∉ B} y₀,
      (List.ofFn γ).prod = 1 ∧
      (∀ (H : Type) [Group H] (k : Fin r → H), (List.ofFn k).prod = 1 →
        ∃! φ : FundamentalGroup {y : OnePoint ℂ // y ∉ B} y₀ →* H, ∀ j, φ (γ j) = k j) ∧
      ∀ (E' : Type) [NormedAddCommGroup E'] [NormedSpace ℂ E']
        (hE' : Module.finrank ℂ E' = 1) (C' : Type) [TopologicalSpace C'] [ChartedSpace E' C'] [IsManifold 𝓘(ℂ, E') ω C']
        [T2Space C'] [CompactSpace C'] [ConnectedSpace C'] (G : Type) [Group G] [Finite G]
        [MulAction G C'] [FaithfulSMul G C'],
        (∀ g : G, ContMDiff 𝓘(ℂ, E') 𝓘(ℂ, E') ω (fun x : C' ↦ g • x)) →
        ∀ f : C' → OnePoint ℂ, ContMDiff 𝓘(ℂ, E') 𝓘(ℂ, ℂ) ω f → b4_IsGaloisCover G f →
        (∀ x, f x ∉ B → MulAction.stabilizer G x = ⊥) →
        ∀ (j : Fin r) (c : Path y₀ y₀), FundamentalGroup.fromPath ⟦c⟧ = γ j →
        ∀ (Γ : C(unitInterval, C')) (k : G), (∀ t, f (Γ t) = (c t : OnePoint ℂ)) →
          Γ 1 = k • Γ 0 → ∃ x, f x = (b j : OnePoint ℂ) ∧ b4_IsRotGen E' x k := by
  obtain ⟨n, j, γ, hp, hu, hm⟩ :=
    RiemannRochTop_sphere_ordered_monodromy B hB hinfty hne y₀
  obtain ⟨e, he⟩ := RiemannRochTop_puncture_enumeration B hinfty j
  let g : B → FundamentalGroup {y : OnePoint ℂ // y ∉ B} y₀ := fun a ↦ γ (e.symm a)
  have hn : (List.ofFn e).Nodup := List.nodup_ofFn.mpr e.injective
  have hb : (List.ofFn b).Nodup := List.nodup_ofFn.mpr b.injective
  have hperm : (List.ofFn e).Perm (List.ofFn b) := by
    apply (List.perm_ext_iff_of_nodup hn hb).mpr
    intro a
    constructor
    · intro _
      exact List.mem_ofFn.mpr ⟨b.symm a, b.apply_symm_apply a⟩
    · intro _
      exact List.mem_ofFn.mpr ⟨e.symm a, e.apply_symm_apply a⟩
  have hp' : ((List.ofFn e).map g).prod = 1 := by
    simpa only [List.map_ofFn, Function.comp_def, g, e.symm_apply_apply] using hp
  have hu' : ∀ (H : Type) [Group H] (v : B → H), ((List.ofFn e).map v).prod = 1 →
      ∃! φ : FundamentalGroup {y : OnePoint ℂ // y ∉ B} y₀ →* H,
        ∀ a, φ (g a) = v a := by
    intro H _ v hv
    obtain ⟨φ, hφ, huniq⟩ := hu H (fun i ↦ v (e i))
      (by simpa only [List.map_ofFn, Function.comp_def] using hv)
    refine ⟨φ, ?_, ?_⟩
    · intro a
      simpa only [e.apply_symm_apply] using hφ (e.symm a)
    · intro ψ hψ
      apply huniq
      intro i
      simpa only [g, e.symm_apply_apply] using hψ (e i)
  obtain ⟨δ, hδ, hconj, hδu⟩ := RiemannRochTop_presentation_reorder hperm hn g hp' hu'
  refine ⟨fun i ↦ δ (b i), ?_, ?_, ?_⟩
  · simpa only [List.map_ofFn, Function.comp_def] using hδ
  · intro H _ v hv
    obtain ⟨φ, hφ, huniq⟩ := hδu H (fun a ↦ v (b.symm a))
      (by simpa only [List.map_ofFn, Function.comp_def, b.symm_apply_apply] using hv)
    refine ⟨φ, fun i ↦ by simpa only [b.symm_apply_apply] using hφ (b i), ?_⟩
    intro ψ hψ
    apply huniq
    intro a
    simpa only [b.apply_symm_apply] using hψ (b.symm a)
  · intro E' _ _ hE' C' _ _ _ _ _ _ G _ _ _ _ hG f hf hgal hfree i c hc Γ l hΓ hend
    obtain ⟨d, hd⟩ := Quotient.exists_rep (γ (e.symm (b i))).toPath
    have hd' : FundamentalGroup.fromPath ⟦d⟧ = γ (e.symm (b i)) :=
      congrArg FundamentalGroup.fromPath hd
    have hcd : IsConj (FundamentalGroup.fromPath ⟦d⟧) (FundamentalGroup.fromPath ⟦c⟧) := by
      rw [hd', hc]
      exact hconj (b i)
    obtain ⟨Λ, hΛ, hendΛ⟩ := RiemannRochTop_coveringOn_conjugate_class_lift f B
      (RiemannRochTop_galois_coveringOn hE' hG f hf hgal B hfree)
      ⟨fun x ↦ l • x, (hG l).continuous⟩ (hgal.1 l) c d hcd Γ hΓ hend
    obtain ⟨q, hq, hrot⟩ := hm E' hE' C' G hG f hf hgal hfree
      (e.symm (b i)) d hd' Λ l hΛ hendΛ
    refine ⟨q, hq.trans ?_, hrot⟩
    exact (he _).symm.trans (congrArg Subtype.val (e.apply_symm_apply (b i)))

/-- RiemannRochTop: the defining generators have product one and the required universal property. -/
theorem b4c_pi1_puncturedSphere_aux {r : ℕ} (b : Fin r → OnePoint ℂ)
    (hb : Function.Injective b) (y₀ : {y : OnePoint ℂ // y ∉ Set.range b}) :
    ∃ γ : Fin r → FundamentalGroup {y : OnePoint ℂ // y ∉ Set.range b} y₀,
      (List.ofFn γ).prod = 1 ∧
      (∀ (H : Type) [Group H] (k : Fin r → H), (List.ofFn k).prod = 1 →
        ∃! φ : FundamentalGroup {y : OnePoint ℂ // y ∉ Set.range b} y₀ →* H, ∀ j, φ (γ j) = k j) ∧
      ∀ (E' : Type) [NormedAddCommGroup E'] [NormedSpace ℂ E']
        (hE' : Module.finrank ℂ E' = 1) (C' : Type) [TopologicalSpace C'] [ChartedSpace E' C'] [IsManifold 𝓘(ℂ, E') ω C']
        [T2Space C'] [CompactSpace C'] [ConnectedSpace C'] (G : Type) [Group G] [Finite G]
        [MulAction G C'] [FaithfulSMul G C'],
        (∀ g : G, ContMDiff 𝓘(ℂ, E') 𝓘(ℂ, E') ω (fun x : C' ↦ g • x)) →
        ∀ f : C' → OnePoint ℂ, ContMDiff 𝓘(ℂ, E') 𝓘(ℂ, ℂ) ω f → b4_IsGaloisCover G f →
        (∀ x, f x ∉ Set.range b → MulAction.stabilizer G x = ⊥) →
        ∀ (j : Fin r) (c : Path y₀ y₀), FundamentalGroup.fromPath ⟦c⟧ = γ j →
        ∀ (Γ : C(unitInterval, C')) (k : G), (∀ t, f (Γ t) = (c t : OnePoint ℂ)) →
          Γ 1 = k • Γ 0 → ∃ x, f x = b j ∧ b4_IsRotGen E' x k := by
  by_cases hr0 : r = 0
  · subst r
    exact RiemannRochTop_unpunctured_full b hb y₀
  by_cases hr1 : r = 1
  · subst r
    exact RiemannRochTop_single_puncture_full b hb y₀
  have hr : 2 ≤ r := by omega
  let i₀ : Fin r := ⟨0, by omega⟩
  let i₁ : Fin r := ⟨1, by omega⟩
  obtain ⟨e, he, hehol, _⟩ := RiemannRochTop_move_puncture_biholomorphic (b i₀)
  let b' : Fin r → OnePoint ℂ := e ∘ b
  have hb' : Function.Injective b' := e.injective.comp hb
  have hi : OnePoint.infty ∈ Set.range b' := ⟨i₀, he⟩
  have hn : ∃ a : ℂ, (a : OnePoint ℂ) ∈ Set.range b' := by
    have hne : b' i₁ ≠ OnePoint.infty := by
      rw [← he]
      intro h
      have hh := hb (e.injective h)
      have := congrArg Fin.val hh
      simp only [i₀, i₁] at this
      omega
    obtain ⟨a, ha⟩ := OnePoint.ne_infty_iff_exists.mp hne
    exact ⟨a, ⟨i₁, ha.symm⟩⟩
  let eB : {y : OnePoint ℂ // y ∉ Set.range b} ≃ₜ
      {y : OnePoint ℂ // y ∉ Set.range b'} :=
    e.subtype (fun y ↦ by simp [b', Set.mem_range, Function.comp_def])
  obtain ⟨δ, hp, hu, hm⟩ := RiemannRochTop_sphere_enumerated_full
    (Set.range b') (Set.finite_range b') hi hn (Equiv.ofInjective b' hb') (eB y₀)
  obtain ⟨g, hg⟩ := RiemannRochTop_homeomorph_pi1_map eB y₀
  refine ⟨fun i ↦ g.symm (δ i), ?_, ?_, ?_⟩
  · have h := congrArg g.symm hp
    simpa only [map_list_prod, List.map_ofFn, Function.comp_def, map_one] using h
  · intro H _ v hv
    obtain ⟨φ, hφ, huniq⟩ := hu H v hv
    refine ⟨φ.comp g.toMonoidHom, ?_, ?_⟩
    · intro i
      simpa only [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, g.apply_symm_apply] using hφ i
    · intro ψ hψ
      have heq : ψ.comp g.symm.toMonoidHom = φ := huniq _ hψ
      ext x
      have hx := congrArg (fun f ↦ f (g x)) heq
      simpa only [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, g.symm_apply_apply] using hx
  · intro E' _ _ hE' C' _ _ _ _ _ _ G _ _ _ _ hG f hf hgal hfree i c hc Γ l hΓ hend
    have hgal' : b4_IsGaloisCover G (e ∘ f) := by
      refine ⟨fun k x ↦ congrArg e (hgal.1 k x), ?_⟩
      intro x y hxy
      exact hgal.2 x y (e.injective hxy)
    have hfree' : ∀ x, (e ∘ f) x ∉ Set.range b' → MulAction.stabilizer G x = ⊥ := by
      intro x hx
      apply hfree x
      rintro ⟨j, hj⟩
      exact hx ⟨j, congrArg e hj⟩
    have hc' : FundamentalGroup.fromPath ⟦c.map eB.continuous⟧ = δ i := by
      rw [← hg, hc, g.apply_symm_apply]
    obtain ⟨q, hq, hrot⟩ := hm E' hE' C' G hG (e ∘ f) (hehol.comp hf) hgal' hfree'
      i (c.map eB.continuous) hc' Γ l (fun t ↦ congrArg e (hΓ t)) hend
    exact ⟨q, e.injective hq, hrot⟩

/-- Evaluation of a holomorphic form on the chosen generator of a tangent line. -/
def RiemannRochEichler_eval (hE : Module.finrank ℂ E = 1) (p : C) :
    b3_HolForm E C →ₗ[ℂ] ℂ where
  toFun w := w.1 ⟨p, b4cov_lineEquiv hE 1⟩
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

omit [IsManifold 𝓘(ℂ, E) ω C] in
/-- A complex curve has nontrivial punctured neighborhoods. -/
lemma RiemannRochEichler_nhdsNE_neBot (hE : Module.finrank ℂ E = 1) (p : C) :
    NeBot (𝓝[≠] p) := by
  have : Nontrivial E := Module.nontrivial_of_finrank_eq_succ hE
  refine ⟨fun h ↦ ?_⟩
  have hp : IsOpen ({p} : Set C) := (isOpen_singleton_iff_punctured_nhds p).mpr h
  have he : IsOpen ({chartAt E p p} : Set E) := by
    simpa only [Set.image_singleton] using
      (chartAt E p).isOpen_image_of_subset_source hp
        (Set.singleton_subset_iff.mpr (mem_chart_source E p))
  exact not_isOpen_singleton (chartAt E p p) he

/-- Evaluations on any dense set still span the dual of the holomorphic forms. -/
lemma RiemannRochEichler_eval_span_dense [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (S : Set C) (hS : Dense S) :
    Submodule.span ℂ (Set.range (fun p : S ↦ RiemannRochEichler_eval hE p.1)) = ⊤ := by
  have : FiniteDimensional ℂ E := Module.finite_of_finrank_eq_succ hE
  have : Module.Finite ℂ (b3_HolForm E C) := b3Forms_holForm_finiteDimensional hE
  apply Submodule.span_eq_top_of_ne_zero
  intro w hw
  by_contra h
  push Not at h
  apply hw
  apply Subtype.ext
  have hd := hS.preimage (FiberBundle.isOpenMap_proj E (TangentSpace 𝓘(ℂ, E)))
  apply Continuous.ext_on hd w.property.1.continuous continuous_zero
  intro v hv
  have hp : w.1 ⟨v.1, b4cov_lineEquiv hE 1⟩ = 0 :=
    h (RiemannRochEichler_eval hE v.1) ⟨⟨v.1, hv⟩, rfl⟩
  have hv' : v.2 = (b4cov_lineEquiv hE).symm v.2 • b4cov_lineEquiv hE 1 := by
    rw [← map_smul, smul_eq_mul, mul_one]
    exact ((b4cov_lineEquiv hE).apply_symm_apply (v.2 : E)).symm
  change w.1 ⟨v.1, v.2⟩ = 0
  calc
    w.1 ⟨v.1, v.2⟩ = w.1 ⟨v.1, (b4cov_lineEquiv hE).symm v.2 •
        b4cov_lineEquiv hE 1⟩ := congrArg (fun u : E ↦ w.1 ⟨v.1, u⟩) hv'
    _ = (b4cov_lineEquiv hE).symm v.2 * w.1 ⟨v.1, b4cov_lineEquiv hE 1⟩ :=
      HurwitzPrymRR_IsLinear.smul w.property.2 _ _ _
    _ = 0 := mul_eq_zero_of_right _ hp

/-- Distinct auxiliary points give a normalized basis of holomorphic differentials. -/
lemma RiemannRochEichler_normalized_basis_away
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (F : Set C) (hF : F.Finite) :
    ∃ (ι : Type) (p : ι → C) (b : Module.Basis ι ℂ (b3_HolForm E C)),
      Finite ι ∧ Function.Injective p ∧ (∀ i, p i ∉ F) ∧
      ∀ i j, RiemannRochEichler_eval hE (p i) (b j) = if i = j then 1 else 0 := by
  classical
  have : FiniteDimensional ℂ E := Module.finite_of_finrank_eq_succ hE
  have : Module.Finite ℂ (b3_HolForm E C) := b3Forms_holForm_finiteDimensional hE
  have : ∀ p : C, NeBot (𝓝[≠] p) := RiemannRochEichler_nhdsNE_neBot hE
  have hd : Dense Fᶜ := by
    simpa only [← Set.compl_eq_univ_sdiff] using dense_univ.sdiff_finite hF
  let v := fun p : (Fᶜ : Set C) ↦ RiemannRochEichler_eval hE p.1
  obtain ⟨ι, a, ha, hspan, hlin⟩ := exists_linearIndependent' ℂ v
  have htop : Submodule.span ℂ (Set.range (v ∘ a)) = ⊤ :=
    hspan.trans (RiemannRochEichler_eval_span_dense hE Fᶜ hd)
  let d : Module.Basis ι ℂ (Module.Dual ℂ (b3_HolForm E C)) :=
    Module.Basis.mk hlin (by rw [htop])
  have : Finite ι := hlin.finite
  letI : Fintype ι := Fintype.ofFinite ι
  let b := d.dualBasis.map (Module.evalEquiv ℂ (b3_HolForm E C)).symm
  refine ⟨ι, fun i ↦ (a i).1, b, inferInstance, Subtype.val_injective.comp ha,
    fun i ↦ (a i).2, ?_⟩
  intro i j
  have hdi : d i = RiemannRochEichler_eval hE (a i).1 := by
    simp only [d, Module.Basis.mk_apply, Function.comp_apply, v]
  change RiemannRochEichler_eval hE (a i).1
    ((Module.evalEquiv ℂ (b3_HolForm E C)).symm (d.dualBasis j)) = _
  rw [← hdi, Module.apply_evalEquiv_symm_apply, Module.Basis.dualBasis_apply_self]


theorem RiemannRochEichler_inverse_coordinate_punctured
    (hE : Module.finrank ℂ E = 1) (x : C) :
    Tendsto (fun t : ℂ ↦ (extChartAt 𝓘(ℂ, E) x).symm
      (extChartAt 𝓘(ℂ, E) x x + b4cov_lineEquiv hE t)) (𝓝[≠] 0) (𝓝[≠] x) := by
  let φ := extChartAt 𝓘(ℂ, E) x
  let L := b4cov_lineEquiv hE
  have hx : x ∈ φ.source := mem_extChartAt_source x
  have ha : Continuous (fun t : ℂ ↦ φ x + L t) := continuous_const.add L.continuous
  have ht : ∀ᶠ t : ℂ in 𝓝 0, φ x + L t ∈ φ.target :=
    ha.continuousAt.preimage_mem_nhds (by
      have hh : φ.target ∈ 𝓝 (φ x) :=
        (isOpen_extChartAt_target x).mem_nhds (φ.map_source hx)
      simpa only [map_zero, add_zero] using hh)
  have hc : Tendsto φ.symm (𝓝 (φ x)) (𝓝 x) := by
    have hh := ((continuousOn_extChartAt_symm x).continuousAt
      ((isOpen_extChartAt_target x).mem_nhds (φ.map_source hx))).tendsto
    change Tendsto φ.symm (𝓝 (φ x)) (𝓝 (φ.symm (φ x))) at hh
    rwa [φ.left_inv hx] at hh
  refine tendsto_nhdsWithin_iff.mpr ⟨?_, ?_⟩
  · apply hc.comp
    simpa only [map_zero, add_zero] using (ha.continuousAt (x := 0)).tendsto.mono_left nhdsWithin_le_nhds
  · filter_upwards [ht.filter_mono nhdsWithin_le_nhds, self_mem_nhdsWithin] with t ht hne
    change φ.symm (φ x + L t) ≠ x
    intro he
    have hh := congrArg φ he
    rw [φ.right_inv ht] at hh
    have hz : L t = 0 := add_left_cancel (hh.trans (add_zero (φ x)).symm)
    exact hne (L.map_eq_zero_iff.mp hz)


/-- Punctured centred coordinates avoid every finite subset of the surface. -/
lemma RiemannRochEichler_coordinate_avoid_finite [T1Space C]
    (hE : Module.finrank ℂ E = 1) (S : Set C) (hS : S.Finite) (p : C) :
    ∀ᶠ z in 𝓝[≠] (0 : ℂ), (extChartAt 𝓘(ℂ, E) p).symm
      (extChartAt 𝓘(ℂ, E) p p + b4cov_lineEquiv hE z) ∉ S := by
  have ha : ∀ᶠ x in 𝓝[≠] p, x ∉ S := by
    have hs : (S \ {p})ᶜ ∈ 𝓝 p :=
      hS.sdiff.isClosed.isOpen_compl.mem_nhds (fun h ↦ h.2 rfl)
    filter_upwards [nhdsWithin_le_nhds hs, self_mem_nhdsWithin] with x hx hxp
    exact fun h ↦ hx ⟨h, hxp⟩
  exact RiemannRochEichler_inverse_coordinate_punctured hE p ha


/-- In a planar parameter, a holomorphic sphere-valued map has a meromorphic affine value. -/
lemma RiemannRochEichler_affine_meromorphic (f : ℂ → OnePoint ℂ) (z : ℂ)
    (hf : ContMDiffAt 𝓘(ℂ, ℂ) 𝓘(ℂ, ℂ) ω f z) :
    MeromorphicAt (fun t ↦ (f t).elim 0 id) z := by
  have h := (contMDiffAt_iff.mp hf).2
  simp only [modelWithCornersSelf_coe, Set.range_id, contDiffWithinAt_univ,
    extChartAt_model_space_eq_id, PartialEquiv.refl_symm, Function.comp_id,
    PartialEquiv.refl_coe, id_eq] at h
  have hA : AnalyticAt ℂ (chartAt ℂ (f z) ∘ f) z := by
    simpa only [extChartAt_coe, modelWithCornersSelf_coe, Function.id_comp] using h.analyticAt
  cases hp : f z using OnePoint.rec with
  | coe a =>
    rw [hp, b4cov_chartAt_coe] at hA
    have hev : ∀ᶠ t in 𝓝 z, f t ≠ OnePoint.infty :=
      hf.continuousAt.eventually_ne (by rw [hp]; exact OnePoint.coe_ne_infty a)
    apply hA.meromorphicAt.congr
    filter_upwards [hev.filter_mono nhdsWithin_le_nhds] with t ht
    obtain ⟨b, hb⟩ := OnePoint.ne_infty_iff_exists.mp ht
    rw [Function.comp_apply, ← hb, b4cov_chart0_coe]
    rfl
  | infty =>
    rw [hp, b4cov_chartAt_infty] at hA
    have hev : ∀ᶠ t in 𝓝 z, f t ≠ ((0 : ℂ) : OnePoint ℂ) :=
      hf.continuousAt.eventually_ne (by rw [hp]; exact (OnePoint.coe_ne_infty 0).symm)
    apply hA.meromorphicAt.inv.congr
    filter_upwards [hev.filter_mono nhdsWithin_le_nhds] with t ht
    change (b4cov_chartInf (f t))⁻¹ = (f t).elim 0 id
    cases hft : f t using OnePoint.rec with
    | infty => simp only [b4cov_chartInf_apply, b4cov_sphInv_infty, b4cov_chart0_coe,
        inv_zero, OnePoint.elim_infty]
    | coe b =>
      have hb : b ≠ 0 := fun hb ↦ ht (hft.trans (congrArg (fun w : ℂ ↦ (w : OnePoint ℂ)) hb))
      rw [b4cov_chartInf_apply, b4cov_chart0_sphInv hb, inv_inv]
      rfl

/-- A meromorphic function has a meromorphic coefficient in each centred line coordinate. -/
lemma RiemannRochEichler_fun_loc_meromorphic (hE : Module.finrank ℂ E = 1)
    (f : b4c_MeroFun E C) (p : C) :
    MeromorphicAt (fun z : ℂ ↦
      (f ((extChartAt 𝓘(ℂ, E) p).symm
        (extChartAt 𝓘(ℂ, E) p p + b4cov_lineEquiv hE z))).elim 0 id) 0 := by
  let A : ℂ → E := fun z ↦ extChartAt 𝓘(ℂ, E) p p + b4cov_lineEquiv hE z
  have hA : ContDiff ℂ ω A :=
    contDiff_const.add (b4cov_lineEquiv hE).toContinuousLinearMap.contDiff
  have hA0 : A 0 = extChartAt 𝓘(ℂ, E) p p := by simp only [A, map_zero, add_zero]
  have ht : A 0 ∈ (extChartAt 𝓘(ℂ, E) p).target := by
    rw [hA0]
    exact mem_extChartAt_target p
  have hi : ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, E) ω
      (extChartAt 𝓘(ℂ, E) p).symm (A 0) :=
    (contMDiffOn_extChartAt_symm p).contMDiffAt
      ((isOpen_extChartAt_target p).mem_nhds ht)
  apply RiemannRochEichler_affine_meromorphic
  exact (f.property.1 _).comp 0 (hi.comp 0 hA.contMDiff.contMDiffAt)


/-- Multiplication by a meromorphic function preserves meromorphic differentials. -/
lemma RiemannRochEichler_mul_meroForm (hE : Module.finrank ℂ E = 1)
    (f : b4c_MeroFun E C) (w : b4c_MeroForm E C hE) :
    b4c_IsMeroForm hE (fun v : TangentBundle 𝓘(ℂ, E) C ↦
      (f v.1).elim 0 id * w v) := by
  refine ⟨?_, fun p ↦ ?_⟩
  · intro x a v u
    change (f x).elim 0 id * w ⟨x, a • v + u⟩ =
      a * ((f x).elim 0 id * w ⟨x, v⟩) + (f x).elim 0 id * w ⟨x, u⟩
    rw [w.property.1 x a v u]
    ring
  · exact (RiemannRochEichler_fun_loc_meromorphic hE f p).mul (w.property.2 p)


/-- Changes on finitely many fibres preserve every punctured differential coefficient germ. -/
lemma RiemannRochEichler_loc_congr_off_finite [T1Space C]
    (hE : Module.finrank ℂ E = 1) (S : Set C) (hS : S.Finite)
    (v w : TangentBundle 𝓘(ℂ, E) C → ℂ)
    (he : ∀ p ∉ S, ∀ u : TangentSpace 𝓘(ℂ, E) p, v ⟨p, u⟩ = w ⟨p, u⟩) :
    ∀ p, HurwitzPrymRR_loc hE v p =ᶠ[𝓝[≠] 0] HurwitzPrymRR_loc hE w p := by
  intro p
  let L := b4cov_lineEquiv hE
  let e := extChartAt 𝓘(ℂ, E) p
  let A : ℂ → E := fun z ↦ e p + L z
  let k : ℂ → C := fun z ↦ e.symm (A z)
  have hA : ContinuousAt A 0 := continuous_const.continuousAt.add L.continuous.continuousAt
  have hA0 : A 0 = e p := by simp [A]
  have hk0 : k 0 = p := by simp [k, hA0, e]
  have hAt : A 0 ∈ e.target := by rw [hA0]; exact mem_extChartAt_target p
  have hk : ContinuousAt k 0 :=
    ((continuousOn_extChartAt_symm p).continuousAt
      ((isOpen_extChartAt_target p).mem_nhds hAt)).comp hA
  have hav : ∀ᶠ z in 𝓝 (0 : ℂ), A z ∈ e.target :=
    hA.preimage_mem_nhds ((isOpen_extChartAt_target p).mem_nhds hAt)
  have havoid : ∀ᶠ z in 𝓝 (0 : ℂ), k z ∉ S \ {p} := by
    change k ⁻¹' (S \ {p})ᶜ ∈ 𝓝 (0 : ℂ)
    apply hk.preimage_mem_nhds
    apply hS.sdiff.isClosed.isOpen_compl.mem_nhds
    rw [hk0]
    exact fun h ↦ h.2 rfl
  filter_upwards [hav.filter_mono nhdsWithin_le_nhds,
    havoid.filter_mono nhdsWithin_le_nhds, self_mem_nhdsWithin] with z hzt hzs hz0
  have hkp : k z ≠ p := by
    intro hkp
    have hAz : A z = e p := (e.right_inv hzt).symm.trans (congrArg e hkp)
    have hL : L z = 0 := by
      have h : e p + L z = e p + 0 := by simpa only [add_zero] using hAz
      exact add_left_cancel h
    exact hz0 (L.injective (hL.trans (map_zero L).symm))
  exact he (k z) (fun h ↦ hzs ⟨h, hkp⟩) (b4cov_vec p (k z) (L 1))


/-- Multiplication realizes the span defining a Riemann--Roch space as meromorphic differentials. -/
lemma RiemannRochEichler_L_mul_linear [T1Space C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ) (w : b4c_MeroForm E C hE) :
    ∃ M : b4c_L (E := E) D →ₗ[ℂ] (TangentBundle 𝓘(ℂ, E) C → ℂ),
      (∀ g t, M g t = if ht : t.1 ∉ D.support then g.1 ⟨t.1, ht⟩ * w t else 0) ∧
      ∀ g, b4c_IsMeroForm hE (M g) := by
  classical
  let M : ({x : C // x ∉ D.support} → ℂ) →ₗ[ℂ] (TangentBundle 𝓘(ℂ, E) C → ℂ) :=
    { toFun := fun g t ↦ if ht : t.1 ∉ D.support then g ⟨t.1, ht⟩ * w t else 0
      map_add' := by
        intro f g
        funext t
        by_cases ht : t.1 ∉ D.support
        · simp only [dite_eq_left ht, Pi.add_apply, add_mul]
        · simp only [dite_eq_right ht, Pi.add_apply, add_zero]
      map_smul' := by
        intro a g
        funext t
        by_cases ht : t.1 ∉ D.support
        · simp only [dite_eq_left ht, Pi.smul_apply, smul_eq_mul, mul_assoc, RingHom.id_apply]
        · simp only [dite_eq_right ht, Pi.smul_apply, smul_zero] }
  refine ⟨M.comp (b4c_L (E := E) D).subtype, fun _ _ ↦ rfl, ?_⟩
  intro g
  refine ⟨?_, ?_⟩
  · intro x a u v
    change (if hx : x ∉ D.support then g.1 ⟨x, hx⟩ * w ⟨x, a • u + v⟩ else 0) =
      a * (if hx : x ∉ D.support then g.1 ⟨x, hx⟩ * w ⟨x, u⟩ else 0) +
      (if hx : x ∉ D.support then g.1 ⟨x, hx⟩ * w ⟨x, v⟩ else 0)
    by_cases hx : x ∉ D.support
    · simp only [dite_eq_left hx]
      rw [w.property.1 x a u v]
      ring
    · simp only [dite_eq_right hx, mul_zero, add_zero]
  · intro p
    change MeromorphicAt (HurwitzPrymRR_loc hE (M g.1) p) 0
    generalize heq : g.1 = f
    have hg : f ∈ b4c_L (E := E) D := heq ▸ g.property
    clear heq
    induction hg using Submodule.span_induction with
    | mem f hf =>
      obtain ⟨f, _, _, _, rfl⟩ := hf
      have hm := RiemannRochEichler_mul_meroForm hE f w
      have he := RiemannRochEichler_loc_congr_off_finite hE (D.support : Set C)
        D.support.finite_toSet
        (M (fun x ↦ (f x.1).elim 0 id)) (fun t ↦ (f t.1).elim 0 id * w t)
        (by
          intro x hx u
          change x ∉ D.support at hx
          exact dite_eq_left hx) p
      exact (hm.2 p).congr he.symm
    | zero =>
      simp only [map_zero]
      exact analyticAt_const.meromorphicAt
    | add f g _ _ hf hg =>
      have he : HurwitzPrymRR_loc hE (M (f + g)) p =
          HurwitzPrymRR_loc hE (M f) p + HurwitzPrymRR_loc hE (M g) p := by
        funext z
        exact congrFun (M.map_add f g) _
      rw [he]
      exact hf.add hg
    | smul a f _ hf =>
      have he : HurwitzPrymRR_loc hE (M (a • f)) p =
          a • HurwitzPrymRR_loc hE (M f) p := by
        funext z
        exact congrFun (M.map_smul a f) _
      rw [he]
      exact hf.const_smul a


def RiemannRochEichler_functionLocal (hE : Module.finrank ℂ E = 1)
    (F : C → OnePoint ℂ) (x : C) : ℂ → ℂ :=
  fun t ↦ (F ((extChartAt 𝓘(ℂ, E) x).symm
    (extChartAt 𝓘(ℂ, E) x x + b4cov_lineEquiv hE t))).elim 0 id


def RiemannRochEichler_targetLocal (hE : Module.finrank ℂ E = 1)
    (F : C → OnePoint ℂ) (x : C) : ℂ → ℂ :=
  fun t ↦ b4cov_expr E ℂ F x (F x)
    (extChartAt 𝓘(ℂ, E) x x + b4cov_lineEquiv hE t)


theorem RiemannRochEichler_finiteValue_chartInf (p : OnePoint ℂ) (hp : p ∈ b4cov_chartInf.source) :
    p.elim 0 id = (b4cov_chartInf p)⁻¹ := by
  induction p using OnePoint.rec with
  | infty =>
    rw [b4cov_chartInf_apply, b4cov_sphInv_infty, b4cov_chart0_coe]
    simp
  | coe z =>
    have hz : z ≠ 0 := b4cov_sphInv_ne_infty_iff z |>.mp (by
      simpa only [b4cov_chartInf_source, mem_ofPred_eq] using hp)
    rw [b4cov_chartInf_apply, b4cov_chart0_sphInv hz, inv_inv]
    rfl


theorem RiemannRochEichler_finiteValue_chart0 (p : OnePoint ℂ) (hp : p ∈ b4cov_chart0.source) :
    p.elim 0 id = b4cov_chart0 p := by
  rw [b4cov_chart0_source] at hp
  obtain ⟨z, rfl⟩ := hp
  exact (b4cov_chart0_coe z).symm


theorem RiemannRochEichler_functionLocal_target_germ (hE : Module.finrank ℂ E = 1)
    (F : C → OnePoint ℂ) (hF : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω F) (x : C) :
    RiemannRochEichler_functionLocal hE F x =ᶠ[𝓝[≠] 0]
      if F x = OnePoint.infty then (RiemannRochEichler_targetLocal hE F x)⁻¹
      else RiemannRochEichler_targetLocal hE F x := by
  classical
  let φ := extChartAt 𝓘(ℂ, E) x
  let ψ := extChartAt 𝓘(ℂ, ℂ) (F x)
  let L := b4cov_lineEquiv hE
  have hs : ∀ᶠ y in 𝓝 x, F y ∈ ψ.source :=
    hF.continuous.continuousAt.preimage_mem_nhds
      ((isOpen_extChartAt_source (F x)).mem_nhds (mem_extChartAt_source (F x)))
  have ht := RiemannRochEichler_inverse_coordinate_punctured hE x
    (hs.filter_mono nhdsWithin_le_nhds)
  by_cases hx : F x = OnePoint.infty
  · rw [if_pos hx]
    filter_upwards [ht] with t htp
    have hp : F (φ.symm (φ x + L t)) ∈ b4cov_chartInf.source := by
      simpa only [mem_preimage, mem_ofPred_eq, φ, L, ψ, hx, extChartAt_source,
        b4cov_chartAt_infty] using htp
    change (F (φ.symm (φ x + L t))).elim 0 id =
      (ψ (F (φ.symm (φ x + L t))))⁻¹
    simpa only [ψ, hx, extChartAt_coe, b4cov_chartAt_infty,
      modelWithCornersSelf_coe, Function.comp_apply, id_eq]
      using RiemannRochEichler_finiteValue_chartInf _ hp
  · rw [if_neg hx]
    obtain ⟨a, ha⟩ := OnePoint.ne_infty_iff_exists.mp hx
    filter_upwards [ht] with t htp
    have hp : F (φ.symm (φ x + L t)) ∈ b4cov_chart0.source := by
      simpa only [mem_preimage, mem_ofPred_eq, φ, L, ψ, ← ha, extChartAt_source,
        b4cov_chartAt_coe] using htp
    change (F (φ.symm (φ x + L t))).elim 0 id =
      ψ (F (φ.symm (φ x + L t)))
    simpa only [ψ, ← ha, extChartAt_coe, b4cov_chartAt_coe,
      modelWithCornersSelf_coe, Function.comp_apply, id_eq]
      using RiemannRochEichler_finiteValue_chart0 _ hp


theorem RiemannRochEichler_targetLocal_order [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (F : C → OnePoint ℂ)
    (hF : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω F) (hnc : ∃ x y, F x ≠ F y) (x : C)
    (hzero : RiemannRochEichler_targetLocal hE F x 0 = 0) :
    meromorphicOrderAt (RiemannRochEichler_targetLocal hE F x) 0 =
      ((b4_ramIndex E ℂ F x : ℤ) : WithTop ℤ) := by
  classical
  let G := b4cov_expr E ℂ F x (F x)
  let z := extChartAt 𝓘(ℂ, E) x x
  let L := b4cov_lineEquiv (show Module.finrank ℂ ℂ = 1 by simp)
  let T := b4cov_transport hE (show Module.finrank ℂ ℂ = 1 by simp) G z
  have hG := b4cov_analyticAt_chart F hF x (F x) z (mem_extChartAt_target x) (by
    rw [extChartAt_to_inv]; exact mem_extChartAt_source (F x))
  have hT : AnalyticAt ℂ T 0 := b4cov_transport_analyticAt hE (by simp) hG
  obtain ⟨he, hne, hlow⟩ := b4cov_ramIndex_spec F hF hnc x
  have hTo : analyticOrderAt T 0 = b4_ramIndex E ℂ F x :=
    b4cov_analyticOrderAt_transport hE (by simp) hG he hlow hne
  have hG0 : G z = 0 := by
    simpa only [RiemannRochEichler_targetLocal, map_zero, add_zero] using hzero
  have hL (t : ℂ) : L t = L 1 * t := by
    simpa only [smul_eq_mul, mul_one, mul_comm] using L.map_smul t 1
  have hA : RiemannRochEichler_targetLocal hE F x = (fun _ : ℂ ↦ L 1) * T := by
    funext t
    change G (z + b4cov_lineEquiv hE t) = L 1 * T t
    rw [← hL]
    simp only [T, b4cov_transport, hG0, map_zero, sub_zero]
    exact (L.apply_symm_apply _).symm
  have hc : L 1 ≠ 0 := L.map_ne_zero_iff.mpr one_ne_zero
  rw [hA, meromorphicOrderAt_mul (MeromorphicAt.const (L 1) 0) hT.meromorphicAt,
    meromorphicOrderAt_const, if_neg hc, zero_add, hT.meromorphicOrderAt_eq, hTo]
  simp only [ENat.map_natCast]


theorem RiemannRochEichler_targetLocal_zero (hE : Module.finrank ℂ E = 1)
    (F : C → OnePoint ℂ) (x : C) :
    RiemannRochEichler_targetLocal hE F x 0 = (F x).elim 0 id := by
  simp only [RiemannRochEichler_targetLocal, b4cov_expr, Function.comp_apply,
    map_zero, add_zero, extChartAt_to_inv]
  generalize F x = p
  induction p using OnePoint.rec with
  | infty =>
    change b4cov_chartInf OnePoint.infty = 0
    rw [b4cov_chartInf_apply, b4cov_sphInv_infty, b4cov_chart0_coe]
  | coe a => exact b4cov_chart0_coe a


theorem RiemannRochEichler_targetLocal_analytic (hE : Module.finrank ℂ E = 1)
    (F : C → OnePoint ℂ) (hF : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω F) (x : C) :
    AnalyticAt ℂ (RiemannRochEichler_targetLocal hE F x) 0 := by
  have hG := b4cov_analyticAt_chart F hF x (F x)
    (extChartAt 𝓘(ℂ, E) x x) (mem_extChartAt_target x) (by
      rw [extChartAt_to_inv]; exact mem_extChartAt_source (F x))
  exact hG.comp_of_eq (analyticAt_const.add ((b4cov_lineEquiv hE).analyticAt 0)) (by simp)


theorem RiemannRochEichler_ord_eq_local [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (F : b4c_MeroFun E C)
    (hF : ∃ y, F y ≠ (0 : ℂ)) (x : C) :
    ((b4c_ord E F x : ℤ) : WithTop ℤ) =
      meromorphicOrderAt (RiemannRochEichler_functionLocal hE F x) 0 := by
  classical
  by_cases hnc : ∃ y z, F y ≠ F z
  · have hg := RiemannRochEichler_functionLocal_target_germ hE F F.property.1 x
    by_cases hzero : F x = (0 : ℂ)
    · have ht := RiemannRochEichler_targetLocal_order hE F F.property.1 hnc x (by
        rw [RiemannRochEichler_targetLocal_zero, hzero]
        rfl)
      rw [b4c_ord, if_pos hzero, meromorphicOrderAt_congr hg]
      simp only [hzero, OnePoint.coe_ne_infty, if_false]
      exact ht.symm
    · by_cases hinf : F x = OnePoint.infty
      · have ht := RiemannRochEichler_targetLocal_order hE F F.property.1 hnc x (by
          rw [RiemannRochEichler_targetLocal_zero, hinf]
          rfl)
        rw [b4c_ord, if_neg hzero, if_pos hinf, meromorphicOrderAt_congr hg,
          if_pos hinf, meromorphicOrderAt_inv, ht]
        simp
      · rw [b4c_ord, if_neg hzero, if_neg hinf, meromorphicOrderAt_congr hg,
          if_neg hinf]
        have ha := RiemannRochEichler_targetLocal_analytic hE F F.property.1 x
        rw [ha.meromorphicOrderAt_eq, ha.analyticOrderAt_eq_zero.2]
        · simp
        · rw [RiemannRochEichler_targetLocal_zero]
          obtain ⟨a, ha⟩ := OnePoint.ne_infty_iff_exists.mp hinf
          rw [← ha]
          change a ≠ 0
          intro ha0
          apply hzero
          rw [← ha, ha0]
  · push_neg at hnc
    obtain ⟨y, hy⟩ := hF
    have hxy : F x = F y := hnc x y
    have hx0 : F x ≠ (0 : ℂ) := hxy ▸ hy
    have hxi : F x ≠ OnePoint.infty := by
      obtain ⟨z, hz⟩ := F.property.2
      exact hnc x z ▸ hz
    have heq : RiemannRochEichler_functionLocal hE F x =
        fun _ : ℂ ↦ (F x).elim 0 id := by
      funext t
      simp only [RiemannRochEichler_functionLocal, hnc _ x]
    rw [b4c_ord, if_neg hx0, if_neg hxi, heq, meromorphicOrderAt_const]
    obtain ⟨a, ha⟩ := OnePoint.ne_infty_iff_exists.mp hxi
    have ha0 : a ≠ 0 := by
      intro ha0
      apply hx0
      rw [← ha, ha0]
    rw [← ha]
    simp [ha0]


/-- One nonzero meromorphic germ forces finite orders everywhere on a connected curve. -/
lemma RiemannRochEichler_finite_orders [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (w : b4c_MeroForm E C hE)
    (hw : ∃ p, meromorphicOrderAt (HurwitzPrymRR_loc hE w p) 0 ≠ ⊤) :
    ∀ p, meromorphicOrderAt (HurwitzPrymRR_loc hE w p) 0 ≠ ⊤ := by
  have hstatus {f : ℂ → ℂ} {x : ℂ} (hf : MeromorphicAt f x) :
      ∀ᶠ y in 𝓝 x, (meromorphicOrderAt f y = ⊤ ↔ meromorphicOrderAt f x = ⊤) := by
    by_cases hx : meromorphicOrderAt f x = ⊤
    · have hzero := meromorphicOrderAt_eq_top_iff.mp hx
      have hspread : ∀ᶠ y in 𝓝 x, ∀ᶠ z in 𝓝[{x}ᶜ] y, f z = 0 :=
        eventually_nhds_nhdsWithin.mpr hzero
      filter_upwards [hspread] with y hy
      have hyTop : meromorphicOrderAt f y = ⊤ := by
        by_cases hyx : y = x
        · simpa only [hyx] using hx
        · rw [meromorphicOrderAt_eq_top_iff]
          have hy' := eventually_nhdsWithin_iff.mp hy
          have hz : ∀ᶠ z in 𝓝 y, f z = 0 := by
            filter_upwards [hy', eventually_ne_nhds hyx] with z hz hzx
            exact hz hzx
          exact hz.filter_mono nhdsWithin_le_nhds
      exact iff_of_true hyTop hx
    · have hn := (meromorphicOrderAt_ne_top_iff_eventually_ne_zero hf).mp hx
      have hp : ∀ᶠ y in 𝓝[≠] x, meromorphicOrderAt f y ≠ ⊤ := by
        filter_upwards [hf.eventually_analyticAt, hn] with y hay hny
        rw [hay.meromorphicOrderAt_eq, hay.analyticOrderAt_eq_zero.mpr hny]
        simp
      filter_upwards [eventually_nhdsWithin_iff.mp hp] with y hy
      have hny : meromorphicOrderAt f y ≠ ⊤ := by
        by_cases hyx : y = x
        · simpa only [hyx] using hx
        · exact hy hyx
      exact iff_of_false hny hx
  have hlocal (p : C) : ∀ᶠ q in 𝓝 p,
      (meromorphicOrderAt (HurwitzPrymRR_loc hE w q) 0 = ⊤ ↔
        meromorphicOrderAt (HurwitzPrymRR_loc hE w p) 0 = ⊤) := by
    let e := extChartAt 𝓘(ℂ, E) p
    let z : C → ℂ := fun q ↦ (b4cov_lineEquiv hE).symm (e q - e p)
    have hz0 : z p = 0 := by simp [z]
    have hz : ContinuousAt z p :=
      (b4cov_lineEquiv hE).symm.continuous.continuousAt.comp
        ((continuousAt_extChartAt p).sub continuousAt_const)
    have ht : Tendsto z (𝓝 p) (𝓝 0) := by simpa only [hz0] using hz.tendsto
    have hs : ∀ᶠ q in 𝓝 p, q ∈ e.source :=
      (isOpen_extChartAt_source p).mem_nhds (mem_extChartAt_source p)
    filter_upwards [hs, ht (hstatus (w.property.2 p))] with q hqs hq
    rw [HurwitzPrymRR_ord_chart hE w w.property.1 p q hqs]
    exact hq
  let S := {p : C | meromorphicOrderAt (HurwitzPrymRR_loc hE w p) 0 ≠ ⊤}
  have hSo : IsOpen S := by
    rw [isOpen_iff_mem_nhds]
    intro p hp
    filter_upwards [hlocal p] with q hq
    exact fun h ↦ hp (hq.mp h)
  have hSc : IsClosed S := by
    apply isOpen_compl_iff.mp
    rw [isOpen_iff_mem_nhds]
    intro p hp
    have hp' : meromorphicOrderAt (HurwitzPrymRR_loc hE w p) 0 = ⊤ := not_not.mp hp
    filter_upwards [hlocal p] with q hq
    exact not_not.mpr (hq.mpr hp')
  rcases isClopen_iff.mp ⟨hSc, hSo⟩ with hs | hs
  · obtain ⟨p, hp⟩ := hw
    have hpS : p ∈ S := hp
    rw [hs] at hpS
    exact hpS.elim
  · intro p
    have hp : p ∈ S := by rw [hs]; trivial
    exact hp


/-- Canonical divisor coefficients recover the finite orders of differential germs. -/
lemma RiemannRochEichler_divForm_order [T1Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (w : b4c_MeroForm E C hE)
    (hw : ∃ p, meromorphicOrderAt (HurwitzPrymRR_loc hE w p) 0 ≠ ⊤) (x : C) :
    ((b4c_divForm (hE := hE) w x : ℤ) : WithTop ℤ) =
      meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 := by
  have hfinite := RiemannRochEichler_finite_orders hE w hw
  have hg : {p : C | b4c_ordForm (hE := hE) w p = 0} ∈ codiscrete C := by
    rw [mem_codiscrete_iff_forall_mem_nhdsNE]
    intro p
    let e := extChartAt 𝓘(ℂ, E) p
    let z : C → ℂ := fun q ↦ (b4cov_lineEquiv hE).symm (e q - e p)
    have hz0 : z p = 0 := by simp [z]
    have he : ContinuousAt e p := continuousAt_extChartAt p
    have hz : ContinuousAt z p :=
      (b4cov_lineEquiv hE).symm.continuous.continuousAt.comp (he.sub continuousAt_const)
    have hs : ∀ᶠ q in 𝓝 p, q ∈ e.source :=
      (isOpen_extChartAt_source p).mem_nhds (mem_extChartAt_source p)
    have ht : Tendsto z (𝓝[≠] p) (𝓝[≠] (0 : ℂ)) := by
      refine tendsto_nhdsWithin_iff.mpr ⟨?_, ?_⟩
      · simpa only [hz0] using hz.tendsto.mono_left nhdsWithin_le_nhds
      · filter_upwards [hs.filter_mono nhdsWithin_le_nhds, self_mem_nhdsWithin] with q hq hqp
        change z q ≠ 0
        intro hzero
        have heq : e q = e p := by
          apply sub_eq_zero.mp
          have h := congrArg (b4cov_lineEquiv hE) hzero
          simpa only [z, ContinuousLinearEquiv.apply_symm_apply, map_zero] using h
        exact hqp (e.injOn hq (mem_extChartAt_source p) heq)
    have ho : ∀ᶠ z in 𝓝[≠] (0 : ℂ),
        meromorphicOrderAt (HurwitzPrymRR_loc hE w p) z = 0 := by
      filter_upwards [(w.property.2 p).eventually_analyticAt,
        (meromorphicOrderAt_ne_top_iff_eventually_ne_zero (w.property.2 p)).mp
          (hfinite p)] with z ha hn
      rw [ha.meromorphicOrderAt_eq, ha.analyticOrderAt_eq_zero.mpr hn]
      rfl
    filter_upwards [ht ho, hs.filter_mono nhdsWithin_le_nhds] with q hqo hqs
    change (meromorphicOrderAt (HurwitzPrymRR_loc hE w q) 0).untop₀ = 0
    rw [HurwitzPrymRR_ord_chart hE w w.property.1 p q hqs, hqo]
    rfl
  have hs : (Function.support (b4c_ordForm (hE := hE) w)).Finite :=
    mem_cofinite.mp (cofinite_le_codiscrete hg)
  simp only [b4c_divForm, dite_eq_left hs, Finsupp.onFinset_apply, b4c_ordForm]
  exact WithTop.coe_untop₀_of_ne_top (hfinite x)


/-- Divisor inequalities bound the orders of every differential in the multiplication family. -/
lemma RiemannRochEichler_L_mul_order [T1Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ) (w : b4c_MeroForm E C hE)
    (hw : ∃ p, meromorphicOrderAt (HurwitzPrymRR_loc hE w p) 0 ≠ ⊤)
    (g : b4c_L (E := E) D) (p : C) :
    (((b4c_divForm (hE := hE) w p - D p : ℤ)) : WithTop ℤ) ≤
      meromorphicOrderAt (HurwitzPrymRR_loc hE
        (fun t ↦ if ht : t.1 ∉ D.support then g.1 ⟨t.1, ht⟩ * w t else 0) p) 0 := by
  classical
  let M : ({x : C // x ∉ D.support} → ℂ) →ₗ[ℂ] (TangentBundle 𝓘(ℂ, E) C → ℂ) :=
    { toFun := fun g t ↦ if ht : t.1 ∉ D.support then g ⟨t.1, ht⟩ * w t else 0
      map_add' := by
        intro f g
        funext t
        by_cases ht : t.1 ∉ D.support
        · simp only [dite_eq_left ht, Pi.add_apply, add_mul]
        · simp only [dite_eq_right ht, Pi.add_apply, add_zero]
      map_smul' := by
        intro a g
        funext t
        by_cases ht : t.1 ∉ D.support
        · simp only [dite_eq_left ht, Pi.smul_apply, smul_eq_mul, mul_assoc, RingHom.id_apply]
        · simp only [dite_eq_right ht, Pi.smul_apply, smul_zero] }
  suffices hh : MeromorphicAt (HurwitzPrymRR_loc hE (M g.1) p) 0 ∧
      ((b4c_divForm (hE := hE) w p - D p : ℤ) : WithTop ℤ) ≤
        meromorphicOrderAt (HurwitzPrymRR_loc hE (M g.1) p) 0 from hh.2
  generalize heq : g.1 = f
  have hg : f ∈ b4c_L (E := E) D := heq ▸ g.property
  clear heq
  induction hg using Submodule.span_induction with
  | mem f hf =>
    obtain ⟨f, hf0, _, hfo, rfl⟩ := hf
    have hm := RiemannRochEichler_mul_meroForm hE f w
    have he := RiemannRochEichler_loc_congr_off_finite hE (D.support : Set C)
      D.support.finite_toSet
      (M (fun x ↦ (f x.1).elim 0 id)) (fun t ↦ (f t.1).elim 0 id * w t)
      (by
        intro x hx u
        change x ∉ D.support at hx
        exact dite_eq_left hx) p
    refine ⟨(hm.2 p).congr he.symm, ?_⟩
    rw [meromorphicOrderAt_congr he]
    change ((b4c_divForm (hE := hE) w p - D p : ℤ) : WithTop ℤ) ≤
      meromorphicOrderAt (RiemannRochEichler_functionLocal hE f p *
        HurwitzPrymRR_loc hE w p) 0
    have hfm : MeromorphicAt (RiemannRochEichler_functionLocal hE f p) 0 :=
      RiemannRochEichler_fun_loc_meromorphic hE f p
    rw [meromorphicOrderAt_mul hfm (w.property.2 p), ← RiemannRochEichler_ord_eq_local hE f hf0 p,
      ← RiemannRochEichler_divForm_order hE w hw p, ← WithTop.coe_add]
    apply WithTop.coe_le_coe.mpr
    have := hfo p
    omega
  | zero =>
    simp only [map_zero]
    refine ⟨analyticAt_const.meromorphicAt, ?_⟩
    change _ ≤ meromorphicOrderAt (fun _ : ℂ ↦ (0 : ℂ)) 0
    rw [meromorphicOrderAt_const, if_pos rfl]
    exact le_top
  | add f g _ _ hf hg =>
    have he : HurwitzPrymRR_loc hE (M (f + g)) p =
        HurwitzPrymRR_loc hE (M f) p + HurwitzPrymRR_loc hE (M g) p := by
      funext z
      exact congrFun (M.map_add f g) _
    rw [he]
    exact ⟨hf.1.add hg.1, (le_min hf.2 hg.2).trans (meromorphicOrderAt_add hf.1 hg.1)⟩
  | smul a f _ hf =>
    have he : HurwitzPrymRR_loc hE (M (a • f)) p =
        a • HurwitzPrymRR_loc hE (M f) p := by
      funext z
      exact congrFun (M.map_smul a f) _
    rw [he]
    refine ⟨hf.1.const_smul a, ?_⟩
    by_cases ha : a = 0
    · simp [ha]
    · rw [meromorphicOrderAt_const_smul_eq_meromorphicOrderAt ha]
      exact hf.2


/-- A coefficient with at most a simple pole splits into its residue and an analytic remainder. -/
lemma RiemannRochEichler_simple_pole_split {f : ℂ → ℂ} {a : ℂ}
    (hf : MeromorphicAt f a) (ho : (-1 : WithTop ℤ) ≤ meromorphicOrderAt f a) :
    ∃ g : ℂ → ℂ, AnalyticAt ℂ g a ∧
      f =ᶠ[𝓝[≠] a] fun z ↦ residue f a / (z - a) + g z := by
  obtain ⟨φ, hφ, heq⟩ := exists_analyticAt_eventuallyEq_zpow_smul hf ho
  have heq' : f =ᶠ[𝓝[≠] a] fun z ↦ φ z / (z - a) := by
    simpa only [zpow_neg_one, smul_eq_mul, div_eq_mul_inv, mul_comm] using heq
  have hr : residue f a = φ a := by
    rw [residue_congr_nhdsNE heq']
    simpa using residue_div_sub_pow_of_analyticAt hφ 0
  obtain ⟨P, hP⟩ := hφ
  refine ⟨dslope φ a, ⟨P.fslope, hP.has_fpower_series_dslope_fslope⟩, ?_⟩
  filter_upwards [heq', self_mem_nhdsWithin] with z hz hza
  rw [hz, hr, dslope_of_ne φ hza]
  simp only [slope, smul_eq_mul, vsub_eq_sub, div_eq_mul_inv]
  ring


/-- Vanishing residue removes a pole of order at most one at the level of analytic germs. -/
lemma RiemannRochEichler_simple_pole_removable {f : ℂ → ℂ} {a : ℂ}
    (hf : MeromorphicAt f a) (ho : (-1 : WithTop ℤ) ≤ meromorphicOrderAt f a) :
    residue f a = 0 ↔ ∃ g : ℂ → ℂ, AnalyticAt ℂ g a ∧ f =ᶠ[𝓝[≠] a] g := by
  constructor
  · intro hr
    obtain ⟨g, hg, he⟩ := RiemannRochEichler_simple_pole_split hf ho
    exact ⟨g, hg, by simpa only [hr, zero_div, zero_add] using he⟩
  · rintro ⟨g, hg, he⟩
    rw [residue_congr_nhdsNE he]
    exact residue_eq_zero_of_analyticAt hg


/-- An analytic differential coefficient remains analytic when recentered in another chart. -/
lemma RiemannRochEichler_loc_analytic_of_chart (hE : Module.finrank ℂ E = 1)
    (w : TangentBundle 𝓘(ℂ, E) C → ℂ) (hw : HurwitzPrymRR_IsLinear w)
    (p q : C) (hq : q ∈ (extChartAt 𝓘(ℂ, E) p).source)
    (ha : AnalyticAt ℂ (HurwitzPrymRR_loc hE w p)
      ((b4cov_lineEquiv hE).symm (extChartAt 𝓘(ℂ, E) p q - extChartAt 𝓘(ℂ, E) p p))) :
    AnalyticAt ℂ (HurwitzPrymRR_loc hE w q) 0 := by
  have hid : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω (id : C → C) := contMDiff_id
  have he := HurwitzPrymRR_loc_pullback hE hE id hid q p hq w hw
  rw [HurwitzPrymRR_pullback_id] at he
  let G := b4cov_expr E E (id : C → C) q p
  let T := b4cov_transport hE hE G (extChartAt 𝓘(ℂ, E) q q)
  let c := (b4cov_lineEquiv hE).symm
    (extChartAt 𝓘(ℂ, E) p q - extChartAt 𝓘(ℂ, E) p p)
  have hG : AnalyticAt ℂ G (extChartAt 𝓘(ℂ, E) q q) :=
    b4cov_analyticAt_chart id hid q p _ (mem_extChartAt_target q)
      (by simpa only [extChartAt_to_inv, id_eq] using hq)
  have hT : AnalyticAt ℂ T 0 := b4cov_transport_analyticAt hE hE hG
  have hA : AnalyticAt ℂ (fun z ↦ c + T z) 0 := analyticAt_const.add hT
  have hc : c + T 0 = c := by simp only [T, b4cov_transport_zero, add_zero]
  have ha' : AnalyticAt ℂ (HurwitzPrymRR_loc hE w p) (c + T 0) := by
    rw [hc]
    exact ha
  have hcomp : AnalyticAt ℂ (fun z ↦ HurwitzPrymRR_loc hE w p (c + T z)) 0 :=
    AnalyticAt.comp (g := HurwitzPrymRR_loc hE w p) (f := fun z : ℂ ↦ c + T z) ha' hA
  exact (hcomp.mul hT.deriv).congr he.symm


/-- A meromorphic differential on a compact curve has only finitely many nonanalytic centres. -/
lemma RiemannRochEichler_nonanalytic_finite [T1Space C] [CompactSpace C]
    (hE : Module.finrank ℂ E = 1) (w : b4c_MeroForm E C hE) :
    {p : C | ¬ AnalyticAt ℂ (HurwitzPrymRR_loc hE w p) 0}.Finite := by
  have hg : {p : C | AnalyticAt ℂ (HurwitzPrymRR_loc hE w p) 0} ∈ codiscrete C := by
    rw [mem_codiscrete_iff_forall_mem_nhdsNE]
    intro p
    let e := extChartAt 𝓘(ℂ, E) p
    let z : C → ℂ := fun q ↦ (b4cov_lineEquiv hE).symm (e q - e p)
    have hz0 : z p = 0 := by simp [z]
    have he : ContinuousAt e p := continuousAt_extChartAt p
    have hz : ContinuousAt z p :=
      (b4cov_lineEquiv hE).symm.continuous.continuousAt.comp (he.sub continuousAt_const)
    have hs : ∀ᶠ q in 𝓝 p, q ∈ e.source :=
      (isOpen_extChartAt_source p).mem_nhds (mem_extChartAt_source p)
    have ht : Tendsto z (𝓝[≠] p) (𝓝[≠] (0 : ℂ)) := by
      refine tendsto_nhdsWithin_iff.mpr ⟨?_, ?_⟩
      · simpa only [hz0] using hz.tendsto.mono_left nhdsWithin_le_nhds
      · filter_upwards [hs.filter_mono nhdsWithin_le_nhds, self_mem_nhdsWithin] with q hq hqp
        change z q ≠ 0
        intro hzero
        have heq : e q = e p := by
          apply sub_eq_zero.mp
          have h := congrArg (b4cov_lineEquiv hE) hzero
          simpa only [z, ContinuousLinearEquiv.apply_symm_apply, map_zero] using h
        exact hqp (e.injOn hq (mem_extChartAt_source p) heq)
    filter_upwards [ht (w.property.2 p).eventually_analyticAt,
      hs.filter_mono nhdsWithin_le_nhds] with q hqa hqs
    exact RiemannRochEichler_loc_analytic_of_chart hE w w.property.1 p q hqs hqa
  exact mem_cofinite.mp (cofinite_le_codiscrete hg)


/-- Analytic centred coefficients characterize holomorphic fibrewise linear differentials. -/
lemma RiemannRochEichler_holForm_of_loc_analytic (hE : Module.finrank ℂ E = 1)
    (w : TangentBundle 𝓘(ℂ, E) C → ℂ) (hw : HurwitzPrymRR_IsLinear w)
    (ha : ∀ p, AnalyticAt ℂ (HurwitzPrymRR_loc hE w p) 0) :
    w ∈ b3_HolForm E C := by
  apply b4cov_mem_holForm_of_coef hE w hw
  intro p
  let c := extChartAt 𝓘(ℂ, E) p p
  let A : E → ℂ := fun t ↦ (b4cov_lineEquiv hE).symm (t - c)
  have hA : AnalyticAt ℂ A c :=
    ((b4cov_lineEquiv hE).symm.toContinuousLinearMap.analyticAt _).comp (analyticAt_id.sub analyticAt_const)
  have hA0 : A c = 0 := by simp [A]
  have hp : AnalyticAt ℂ (HurwitzPrymRR_loc hE w p) (A c) := by
    rw [hA0]
    exact ha p
  have h := hp.comp hA
  convert h using 1
  funext t
  simp only [Function.comp_apply, HurwitzPrymRR_loc, A,
    ContinuousLinearEquiv.apply_symm_apply]
  congr 1
  dsimp only [c]
  abel


/-- A meromorphic differential without poles has a holomorphic representative with the same germs. -/
lemma RiemannRochEichler_regularize_no_poles [T1Space C] [CompactSpace C]
    (hE : Module.finrank ℂ E = 1) (w : b4c_MeroForm E C hE)
    (ho : ∀ p, 0 ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE w p) 0) :
    ∃ v : b3_HolForm E C, ∀ p,
      HurwitzPrymRR_loc hE v p =ᶠ[𝓝[≠] 0] HurwitzPrymRR_loc hE w p := by
  classical
  choose g hg he using fun p ↦ (w.property.2 p).meromorphicOrderAt_nonneg_iff.mp (ho p)
  let S := {p : C | ¬ AnalyticAt ℂ (HurwitzPrymRR_loc hE w p) 0}
  have hS : S.Finite := RiemannRochEichler_nonanalytic_finite hE w
  let L := b4cov_lineEquiv hE
  let W : TangentBundle 𝓘(ℂ, E) C → ℂ := fun t ↦ L.symm t.2 * g t.1 0
  have hW : HurwitzPrymRR_IsLinear W := by
    intro p a u v
    change E at u v
    change L.symm (a • (u : E) + (v : E)) * g p 0 =
      a * (L.symm (u : E) * g p 0) + L.symm (v : E) * g p 0
    rw [map_add, map_smul]
    simp only [smul_eq_mul]
    ring
  have hgood (p : C) (hp : p ∉ S) (v : TangentSpace 𝓘(ℂ, E) p) :
      W ⟨p, v⟩ = w ⟨p, v⟩ := by
    have ha : AnalyticAt ℂ (HurwitzPrymRR_loc hE w p) 0 := not_not.mp hp
    have hv0 : HurwitzPrymRR_loc hE w p 0 = g p 0 :=
      (ha.continuousAt.eventuallyEq_nhds_iff_eventuallyEq_nhdsNE
        (hg p).continuousAt).mp (he p) |>.self_of_nhds
    have hloc0 : HurwitzPrymRR_loc hE w p 0 = w ⟨p, L 1⟩ := by
      change w ⟨(extChartAt 𝓘(ℂ, E) p).symm
        (extChartAt 𝓘(ℂ, E) p p + b4cov_lineEquiv hE 0), _⟩ = _
      rw [map_zero, add_zero, extChartAt_to_inv, b4cov_vec_self]
    have hv : v = L.symm v • L 1 := by
      change (v : E) = L.symm (v : E) • L 1
      rw [← map_smul, smul_eq_mul, mul_one]
      exact (L.apply_symm_apply (v : E)).symm
    change L.symm v * g p 0 = w ⟨p, v⟩
    rw [← hv0, hloc0]
    exact (w.property.1.smul p (L.symm v) (L 1)).symm.trans
      (congrArg (fun u : E ↦ w ⟨p, u⟩) hv.symm)
  have hloc (p : C) : HurwitzPrymRR_loc hE W p =ᶠ[𝓝[≠] 0]
      HurwitzPrymRR_loc hE w p := by
    let e := extChartAt 𝓘(ℂ, E) p
    let A : ℂ → E := fun z ↦ e p + L z
    let k : ℂ → C := fun z ↦ e.symm (A z)
    have hA : ContinuousAt A 0 := continuous_const.continuousAt.add L.continuous.continuousAt
    have hA0 : A 0 = e p := by simp [A]
    have hk0 : k 0 = p := by simp [k, hA0, e]
    have hAt : A 0 ∈ e.target := by rw [hA0]; exact mem_extChartAt_target p
    have hk : ContinuousAt k 0 :=
      ((continuousOn_extChartAt_symm p).continuousAt
        ((isOpen_extChartAt_target p).mem_nhds hAt)).comp hA
    have hav : ∀ᶠ z in 𝓝 (0 : ℂ), A z ∈ e.target :=
      hA.preimage_mem_nhds ((isOpen_extChartAt_target p).mem_nhds hAt)
    have havoid : ∀ᶠ z in 𝓝 (0 : ℂ), k z ∉ S \ {p} := by
      change k ⁻¹' (S \ {p})ᶜ ∈ 𝓝 (0 : ℂ)
      apply hk.preimage_mem_nhds
      apply hS.sdiff.isClosed.isOpen_compl.mem_nhds
      rw [hk0]
      exact fun h ↦ h.2 rfl
    filter_upwards [hav.filter_mono nhdsWithin_le_nhds,
      havoid.filter_mono nhdsWithin_le_nhds, self_mem_nhdsWithin] with z hzt hzs hz0
    have hkp : k z ≠ p := by
      intro hkp
      have hAz : A z = e p := (e.right_inv hzt).symm.trans (congrArg e hkp)
      have hL : L z = 0 := by
        have h : e p + L z = e p + 0 := by simpa only [add_zero] using hAz
        exact add_left_cancel h
      exact hz0 (L.injective (hL.trans (map_zero L).symm))
    have hkS : k z ∉ S := fun h ↦ hzs ⟨h, hkp⟩
    exact hgood (k z) hkS (b4cov_vec p (k z) (L 1))
  have haW (p : C) : AnalyticAt ℂ (HurwitzPrymRR_loc hE W p) 0 := by
    have heq : HurwitzPrymRR_loc hE W p =ᶠ[𝓝[≠] 0] g p := (hloc p).trans (he p)
    have hzero : HurwitzPrymRR_loc hE W p 0 = g p 0 := by
      change W ⟨(extChartAt 𝓘(ℂ, E) p).symm
        (extChartAt 𝓘(ℂ, E) p p + b4cov_lineEquiv hE 0), _⟩ = _
      rw [map_zero, add_zero, extChartAt_to_inv, b4cov_vec_self]
      change L.symm (L 1) * g p 0 = g p 0
      rw [ContinuousLinearEquiv.symm_apply_apply, one_mul]
    exact (hg p).congr (eventuallyEq_nhds_of_eventuallyEq_nhdsNE heq hzero).symm
  exact ⟨⟨W, RiemannRochEichler_holForm_of_loc_analytic hE W hW haW⟩, hloc⟩


/-- A holomorphic form has an analytic coefficient in the centred line chart. -/
lemma RiemannRochEichler_loc_analytic (hE : Module.finrank ℂ E = 1)
    (w : b3_HolForm E C) (p : C) : AnalyticAt ℂ (HurwitzPrymRR_loc hE w p) 0 := by
  have hA := b4cov_coef_analyticAt w w.property.1 p (b4cov_lineEquiv hE 1)
    (extChartAt 𝓘(ℂ, E) p p) (mem_extChartAt_target p)
  have hB : AnalyticAt ℂ (fun z : ℂ ↦ extChartAt 𝓘(ℂ, E) p p +
      b4cov_lineEquiv hE z) 0 :=
    analyticAt_const.add ((b4cov_lineEquiv hE).toContinuousLinearMap.analyticAt 0)
  have hA' : AnalyticAt ℂ (b4cov_coef w p (b4cov_lineEquiv hE 1))
      (extChartAt 𝓘(ℂ, E) p p + b4cov_lineEquiv hE 0) := by
    simpa only [map_zero, add_zero] using hA
  exact AnalyticAt.comp (f := fun z : ℂ ↦ extChartAt 𝓘(ℂ, E) p p +
    b4cov_lineEquiv hE z) (g := b4cov_coef w p (b4cov_lineEquiv hE 1)) hA' hB

/-- Punctured centred coefficient germs determine a holomorphic differential. -/
lemma RiemannRochEichler_holForm_germ_ext (hE : Module.finrank ℂ E = 1)
    (v w : b3_HolForm E C)
    (he : ∀ p, HurwitzPrymRR_loc hE v.1 p =ᶠ[𝓝[≠] 0] HurwitzPrymRR_loc hE w.1 p) :
    v = w := by
  apply Subtype.ext
  funext t
  have hp : v.1 ⟨t.1, b4cov_lineEquiv hE 1⟩ = w.1 ⟨t.1, b4cov_lineEquiv hE 1⟩ := by
    have hc := (RiemannRochEichler_loc_analytic hE v t.1).continuousAt
    have h := (hc.eventuallyEq_nhds_iff_eventuallyEq_nhdsNE
      (RiemannRochEichler_loc_analytic hE w t.1).continuousAt).mp (he t.1) |>.self_of_nhds
    change v.1 ⟨(extChartAt 𝓘(ℂ, E) t.1).symm
      (extChartAt 𝓘(ℂ, E) t.1 t.1 + b4cov_lineEquiv hE 0), _⟩ =
      w.1 ⟨(extChartAt 𝓘(ℂ, E) t.1).symm
      (extChartAt 𝓘(ℂ, E) t.1 t.1 + b4cov_lineEquiv hE 0), _⟩ at h
    rw [map_zero, add_zero, extChartAt_to_inv, b4cov_vec_self] at h
    exact h
  have ht : t.2 = (b4cov_lineEquiv hE).symm t.2 • b4cov_lineEquiv hE 1 := by
    rw [← map_smul, smul_eq_mul, mul_one]
    exact ((b4cov_lineEquiv hE).apply_symm_apply (t.2 : E)).symm
  change v.1 ⟨t.1, t.2⟩ = w.1 ⟨t.1, t.2⟩
  calc
    v.1 ⟨t.1, t.2⟩ = v.1 ⟨t.1, (b4cov_lineEquiv hE).symm t.2 • b4cov_lineEquiv hE 1⟩ :=
      congrArg (fun u : E ↦ v.1 ⟨t.1, u⟩) ht
    _ = (b4cov_lineEquiv hE).symm t.2 * v.1 ⟨t.1, b4cov_lineEquiv hE 1⟩ :=
      HurwitzPrymRR_IsLinear.smul v.property.2 _ _ _
    _ = (b4cov_lineEquiv hE).symm t.2 * w.1 ⟨t.1, b4cov_lineEquiv hE 1⟩ := by rw [hp]
    _ = w.1 ⟨t.1, (b4cov_lineEquiv hE).symm t.2 • b4cov_lineEquiv hE 1⟩ :=
      (HurwitzPrymRR_IsLinear.smul w.property.2 _ _ _).symm
    _ = w.1 ⟨t.1, t.2⟩ := congrArg (fun u : E ↦ w.1 ⟨t.1, u⟩) ht.symm


/-- Regularization of a linear family without poles is linear. -/
lemma RiemannRochEichler_linear_regularize [T1Space C] [CompactSpace C]
    (hE : Module.finrank ℂ E = 1) {V : Type*} [AddCommGroup V] [Module ℂ V]
    (F : V →ₗ[ℂ] (TangentBundle 𝓘(ℂ, E) C → ℂ))
    (hF : ∀ v, b4c_IsMeroForm hE (F v))
    (ho : ∀ v p, 0 ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (F v) p) 0) :
    ∃ R : V →ₗ[ℂ] b3_HolForm E C, ∀ v p,
      HurwitzPrymRR_loc hE (R v).1 p =ᶠ[𝓝[≠] 0] HurwitzPrymRR_loc hE (F v) p := by
  choose R hR using fun v ↦ RiemannRochEichler_regularize_no_poles hE ⟨F v, hF v⟩ (ho v)
  refine ⟨{ toFun := R, map_add' := ?_, map_smul' := ?_ }, hR⟩
  · intro u v
    apply RiemannRochEichler_holForm_germ_ext hE
    intro p
    filter_upwards [hR (u + v) p, hR u p, hR v p] with z huv hu hv
    change HurwitzPrymRR_loc hE (R (u + v)).1 p z =
      HurwitzPrymRR_loc hE (R u).1 p z + HurwitzPrymRR_loc hE (R v).1 p z
    rw [huv, hu, hv]
    exact congrFun (F.map_add u v) _
  · intro a v
    apply RiemannRochEichler_holForm_germ_ext hE
    intro p
    filter_upwards [hR (a • v) p, hR v p] with z hav hv
    change HurwitzPrymRR_loc hE (R (a • v)).1 p z =
      a • HurwitzPrymRR_loc hE (R v).1 p z
    rw [hav, hv]
    exact congrFun (F.map_smul a v) _


/-- A family without poles that is separated by its germs has dimension at most the genus. -/
lemma RiemannRochEichler_no_poles_finrank_le [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) {V : Type*} [AddCommGroup V] [Module ℂ V]
    (F : V →ₗ[ℂ] (TangentBundle 𝓘(ℂ, E) C → ℂ))
    (hF : ∀ v, b4c_IsMeroForm hE (F v))
    (ho : ∀ v p, 0 ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (F v) p) 0)
    (hsep : ∀ v, (∀ p, HurwitzPrymRR_loc hE (F v) p =ᶠ[𝓝[≠] 0] 0) → v = 0) :
    Module.finrank ℂ V ≤ Module.finrank ℂ (b3_HolForm E C) := by
  haveI : FiniteDimensional ℂ E := Module.finite_of_finrank_eq_succ hE
  haveI : Module.Finite ℂ (b3_HolForm E C) := b3Forms_holForm_finiteDimensional hE
  obtain ⟨R, hR⟩ := RiemannRochEichler_linear_regularize hE F hF ho
  apply LinearMap.finrank_le_finrank_of_injective (f := R)
  apply LinearMap.ker_eq_bot.mp
  apply LinearMap.ker_eq_bot'.mpr
  intro v hv
  apply hsep v
  intro p
  have h := hR v p
  rw [hv] at h
  exact h.symm


/-- A simple-pole family larger than the holomorphic space has a nonzero residue. -/
lemma RiemannRochEichler_exists_nonzero_residue [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) {V : Type*} [AddCommGroup V] [Module ℂ V]
    (F : V →ₗ[ℂ] (TangentBundle 𝓘(ℂ, E) C → ℂ))
    (hF : ∀ v, b4c_IsMeroForm hE (F v))
    (ho : ∀ v p, (-1 : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (F v) p) 0)
    (hsep : ∀ v, (∀ p, HurwitzPrymRR_loc hE (F v) p =ᶠ[𝓝[≠] 0] 0) → v = 0)
    (hdim : Module.finrank ℂ (b3_HolForm E C) < Module.finrank ℂ V) :
    ∃ v p, b4c_res (hE := hE) (F v) p ≠ 0 := by
  by_contra h
  push_neg at h
  have hn : ∀ v p, 0 ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (F v) p) 0 := by
    intro v p
    apply ((hF v).2 p).meromorphicOrderAt_nonneg_iff.mpr
    exact (RiemannRochEichler_simple_pole_removable ((hF v).2 p) (ho v p)).mp (h v p)
  exact (not_lt_of_ge (RiemannRochEichler_no_poles_finrank_le hE F hF hn hsep)) hdim


/-- A sufficiently large two-pole family supplies a differential with residues minus one and one. -/
lemma RiemannRochEichler_third_kind_of_family [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) {V : Type*} [AddCommGroup V] [Module ℂ V]
    (F : V →ₗ[ℂ] (TangentBundle 𝓘(ℂ, E) C → ℂ))
    (hF : ∀ v, b4c_IsMeroForm hE (F v)) (p q : C) (hpq : p ≠ q)
    (ho : ∀ v x, (-1 : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (F v) x) 0)
    (hout : ∀ v x, x ≠ p → x ≠ q →
      0 ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (F v) x) 0)
    (hsep : ∀ v, (∀ x, HurwitzPrymRR_loc hE (F v) x =ᶠ[𝓝[≠] 0] 0) → v = 0)
    (hdim : Module.finrank ℂ (b3_HolForm E C) < Module.finrank ℂ V) :
    ∃ w : b4c_MeroForm E C hE,
      b4c_res (hE := hE) w p = -1 ∧ b4c_res (hE := hE) w q = 1 ∧
      (∀ x, (-1 : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0) ∧
      ∀ x, x ≠ p → x ≠ q → 0 ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 := by
  classical
  obtain ⟨v, x, hx⟩ := RiemannRochEichler_exists_nonzero_residue hE F hF ho hsep hdim
  let w : b4c_MeroForm E C hE := ⟨F v, hF v⟩
  have hs : Function.support (b4c_res (hE := hE) w) ⊆ ({p, q} : Finset C) := by
    intro y hy
    change y ∈ ({p, q} : Finset C)
    simp only [Finset.mem_insert, Finset.mem_singleton]
    by_contra h
    push_neg at h
    exact hy (residue_eq_zero_of_meromorphicOrderAt_nonneg (hout v y h.1 h.2))
  have hsum : b4c_res (hE := hE) w p + b4c_res (hE := hE) w q = 0 := by
    have h := b4c_residue_sum_aux hE w
    rw [finsum_eq_sum_of_support_subset _ hs, Finset.sum_pair hpq] at h
    exact h
  have hp : b4c_res (hE := hE) w p ≠ 0 := by
    intro hp
    have hq : b4c_res (hE := hE) w q = 0 := by simpa only [hp, zero_add] using hsum
    have hm := hs hx
    simp only [Finset.mem_coe, Finset.mem_insert, Finset.mem_singleton] at hm
    rcases hm with rfl | rfl
    · exact hx hp
    · exact hx hq
  let c : ℂ := -(b4c_res (hE := hE) w p)⁻¹
  have hc : c ≠ 0 := neg_ne_zero.mpr (inv_ne_zero hp)
  have hmw : b4c_IsMeroForm hE (fun t ↦ c * w t) := by
    refine ⟨?_, fun y ↦ (w.property.2 y).const_smul c⟩
    intro y a u t
    change c * w ⟨y, a • u + t⟩ = _
    rw [w.property.1 y a u t]
    ring
  let w' : b4c_MeroForm E C hE := ⟨fun t ↦ c * w t, hmw⟩
  have hr (y : C) : b4c_res (hE := hE) w' y = c * b4c_res (hE := hE) w y := by
    change residue (fun z ↦ c * HurwitzPrymRR_loc hE w y z) 0 =
      c * residue (HurwitzPrymRR_loc hE w y) 0
    exact residue_const_mul c
  have hord (y : C) : meromorphicOrderAt (HurwitzPrymRR_loc hE w' y) 0 =
      meromorphicOrderAt (HurwitzPrymRR_loc hE w y) 0 :=
    meromorphicOrderAt_const_smul_eq_meromorphicOrderAt hc
  refine ⟨w', ?_, ?_, ?_, ?_⟩
  · rw [hr]
    simp only [c, neg_mul, inv_mul_cancel₀ hp]
  · rw [hr, eq_neg_of_add_eq_zero_right hsum]
    simp only [c, neg_mul_neg, inv_mul_cancel₀ hp]
  · intro y
    rw [hord]
    exact ho v y
  · intro y hyp hyq
    rw [hord]
    exact hout v y hyp hyq


/-- Elements of a Riemann--Roch space are continuous on the complement of the divisor support. -/
lemma RiemannRochEichler_L_continuous (D : C →₀ ℤ) (g : b4c_L (E := E) D) :
    Continuous g.1 := by
  rcases g with ⟨g, hg⟩
  induction hg using Submodule.span_induction with
  | mem g hg =>
    obtain ⟨f, _, hf, _, rfl⟩ := hg
    have hsrc (x : {x : C // x ∉ D.support}) : f x.1 ∈ b4cov_chart0.source := by
      rw [b4cov_chart0_source]
      exact OnePoint.ne_infty_iff_exists.mp (hf x.1 x.2)
    have hc := b4cov_chart0.continuousOn.comp_continuous
      (f.property.1.continuous.comp continuous_subtype_val) hsrc
    apply hc.congr
    intro x
    obtain ⟨z, hz⟩ := OnePoint.ne_infty_iff_exists.mp (hf x.1 x.2)
    change b4cov_chart0 (f x.1) = (f x.1).elim 0 id
    rw [← hz, b4cov_chart0_coe]
    rfl
  | zero => exact continuous_const
  | add f g _ _ hf hg => exact hf.add hg
  | smul a f _ hf => exact continuous_const.smul hf


/-- Multiplication by a differential with finite orders separates Riemann--Roch restrictions in germs. -/
lemma RiemannRochEichler_L_mul_germ_separating [T1Space C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ) (w : b4c_MeroForm E C hE)
    (hw : ∀ p, meromorphicOrderAt (HurwitzPrymRR_loc hE w p) 0 ≠ ⊤)
    (M : b4c_L (E := E) D →ₗ[ℂ] (TangentBundle 𝓘(ℂ, E) C → ℂ))
    (hM : ∀ g t, M g t = if ht : t.1 ∉ D.support then g.1 ⟨t.1, ht⟩ * w t else 0)
    (g : b4c_L (E := E) D)
    (hg : ∀ p, HurwitzPrymRR_loc hE (M g) p =ᶠ[𝓝[≠] 0] 0) : g = 0 := by
  classical
  let G : C → ℂ := fun x ↦ if hx : x ∉ D.support then g.1 ⟨x, hx⟩ else 0
  have hGc : ContinuousOn G {x : C | x ∉ D.support} := by
    apply continuousOn_iff_continuous_domRestrict.mpr
    apply (RiemannRochEichler_L_continuous D g).congr
    intro x
    change g.1 x = if hx : x.1 ∉ D.support then g.1 ⟨x.1, hx⟩ else 0
    simp only [dite_eq_left x.2]
  apply Subtype.ext
  funext x
  let p := x.1
  let L := b4cov_lineEquiv hE
  let e := extChartAt 𝓘(ℂ, E) p
  let A : ℂ → E := fun z ↦ e p + L z
  let k : ℂ → C := fun z ↦ e.symm (A z)
  have hA : ContinuousAt A 0 := continuous_const.continuousAt.add L.continuous.continuousAt
  have hA0 : A 0 = e p := by simp [A]
  have hk0 : k 0 = p := by simp [k, hA0, e]
  have hAt : A 0 ∈ e.target := by rw [hA0]; exact mem_extChartAt_target p
  have hk : ContinuousAt k 0 :=
    ((continuousOn_extChartAt_symm p).continuousAt
      ((isOpen_extChartAt_target p).mem_nhds hAt)).comp hA
  have hGp : ContinuousAt G p := hGc.continuousAt
    (D.support.finite_toSet.isClosed.isOpen_compl.mem_nhds x.2)
  have hGk : ContinuousAt (fun z ↦ G (k z)) 0 := by
    have hc : ContinuousAt G (k 0) := by rw [hk0]; exact hGp
    exact hc.comp hk
  have hmul (z : ℂ) : HurwitzPrymRR_loc hE (M g) p z =
      G (k z) * HurwitzPrymRR_loc hE w p z := by
    rw [HurwitzPrymRR_loc, b4cov_coef, hM]
    change (if ht : k z ∉ D.support then g.1 ⟨k z, ht⟩ * _ else 0) = _
    by_cases hz : k z ∉ D.support
    · simp only [dite_eq_left hz, G]
      rfl
    · simp only [dite_eq_right hz, G]
      exact (zero_mul _).symm
  have he : (fun z ↦ G (k z)) =ᶠ[𝓝[≠] 0] 0 := by
    filter_upwards [hg p,
      (meromorphicOrderAt_ne_top_iff_eventually_ne_zero (w.property.2 p)).mp (hw p)] with z hz hn
    rw [hmul] at hz
    exact (mul_eq_zero.mp hz).resolve_right hn
  have hz := (hGk.eventuallyEq_nhds_iff_eventuallyEq_nhdsNE continuousAt_const).mp he |>.self_of_nhds
  change G (k 0) = 0 at hz
  rw [hk0] at hz
  change (if hx : x.1 ∉ D.support then g.1 ⟨x.1, hx⟩ else 0) = 0 at hz
  rw [dite_eq_left x.2] at hz
  exact hz


structure RiemannRochRR_GenusZeroMapData (E C : Type) [NormedAddCommGroup E] [NormedSpace ℂ E]
    [TopologicalSpace C] [ChartedSpace E C] [IsManifold 𝓘(ℂ, E) ω C] where
  toFun : C → OnePoint ℂ
  contMDiff_toFun : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω toFun
  bijective : Function.Bijective toFun
  ramIndex_one : ∀ x, b4_ramIndex E ℂ toFun x = 1

noncomputable def RiemannRochRR_genusZeroMapData [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (hg : Module.finrank ℂ (b3_HolForm E C) = 0) :
    RiemannRochRR_GenusZeroMapData E C := by
  let p₀ : C := Classical.choice (inferInstance : Nonempty C)
  let p : Fin (Module.finrank ℂ (b3_HolForm E C) + 1) → C := fun _ ↦ p₀
  have hp : Function.Injective p := by
    intro i j _
    apply Fin.eq_of_val_eq
    omega
  let hex := b4c_exists_meroFun_aux hE p hp
  let f := Classical.choose hex
  have hfSpec := Classical.choose_spec hex
  have hnc := hfSpec.1
  have hord := hfSpec.2
  change ∃ x y, f x ≠ f y at hnc
  change ∀ x, -(1 : ℤ) ≤ b4c_ord E f x ∧
    (x ∉ Set.range p → 0 ≤ b4c_ord E f x) at hord
  have hf := f.2.1
  have hsurj : Function.Surjective f := b4cov_surjective (by simp) f hf hnc
  let xInf := Classical.choose (hsurj OnePoint.infty)
  have hxInf := Classical.choose_spec (hsurj OnePoint.infty)
  have hinf0 : OnePoint.infty ≠ ((0 : ℂ) : OnePoint ℂ) := (OnePoint.coe_ne_infty 0).symm
  have hxInf0 : f xInf ≠ ((0 : ℂ) : OnePoint ℂ) := by rw [hxInf]; exact hinf0
  have hxInfRange : xInf ∈ Set.range p := by
    by_contra hx
    have hord0 := (hord xInf).2 hx
    have hpos : 1 ≤ b4_ramIndex E ℂ f xInf := b4cov_ramIndex_pos f hf hnc xInf
    simp only [b4c_ord] at hord0
    rw [hxInf] at hord0
    simp at hord0
    omega
  have hxInfP : xInf = p₀ := by
    let i := Classical.choose hxInfRange
    have hi := Classical.choose_spec hxInfRange
    simpa [p] using hi.symm
  have hramInf : b4_ramIndex E ℂ f xInf = 1 := by
    have hlower := (hord xInf).1
    have hpos : 1 ≤ b4_ramIndex E ℂ f xInf := b4cov_ramIndex_pos f hf hnc xInf
    simp only [b4c_ord] at hlower
    rw [hxInf] at hlower
    simp at hlower
    exact Nat.le_antisymm hlower hpos
  have hfiberInf : f ⁻¹' {OnePoint.infty} = {xInf} := by
    ext x
    simp only [Set.mem_preimage, Set.mem_singleton_iff]
    constructor
    · intro hx
      have hxrange : x ∈ Set.range p := by
        by_contra hxr
        have hord0 := (hord x).2 hxr
        have hpos : 1 ≤ b4_ramIndex E ℂ f x := b4cov_ramIndex_pos f hf hnc x
        have hx0 : f x ≠ ((0 : ℂ) : OnePoint ℂ) := by rw [hx]; exact hinf0
        simp only [b4c_ord] at hord0
        rw [hx] at hord0
        simp at hord0
        omega
      let i := Classical.choose hxrange
      have hi := Classical.choose_spec hxrange
      have hxp : x = p₀ := by simpa [p] using hi.symm
      exact hxp.trans hxInfP.symm
    · rintro rfl
      exact hxInf
  have hdegInf : b4_fiberDegree E ℂ f OnePoint.infty = 1 := by
    simp [b4_fiberDegree, hfiberInf, hramInf]
  have hdeg (y : OnePoint ℂ) : b4_fiberDegree E ℂ f y = 1 :=
    (b4cov_fiberDegree_eq hE (by simp) f hf hnc y OnePoint.infty).trans hdegInf
  have hram (x : C) : b4_ramIndex E ℂ f x = 1 := by
    have hfin := b4cov_fiber_finite hE f hf hnc (f x)
    have hxmem : x ∈ f ⁻¹' {f x} := by simp
    have hle : b4_ramIndex E ℂ f x ≤ b4_fiberDegree E ℂ f (f x) := by
      rw [b4_fiberDegree]
      rw [finsum_mem_def]
      have hsupp : Function.HasFiniteSupport
          (fun z ↦ if z ∈ f ⁻¹' {f x} then b4_ramIndex E ℂ f z else 0) := by
        apply hfin.subset
        intro z hz
        by_contra hzm
        change (if z ∈ f ⁻¹' {f x} then b4_ramIndex E ℂ f z else 0) ≠ 0 at hz
        rw [if_neg hzm] at hz
        exact hz rfl
      simpa [Set.indicator, hxmem] using
        single_le_finsum x hsupp (fun z ↦ by positivity)
    rw [hdeg] at hle
    exact Nat.le_antisymm hle (b4cov_ramIndex_pos f hf hnc x)
  have hcard (y : OnePoint ℂ) : (f ⁻¹' {y}).ncard = 1 := by
    rw [← hdeg y, b4_fiberDegree, ← finsum_one]
    exact finsum_mem_congr rfl fun x _ ↦ (hram x).symm
  have hinj : Function.Injective f := by
    intro x x' hxx'
    let a := Classical.choose (Set.ncard_eq_one.mp (hcard (f x)))
    have ha := Classical.choose_spec (Set.ncard_eq_one.mp (hcard (f x)))
    have hx : x ∈ f ⁻¹' {f x} := by simp
    have hx' : x' ∈ f ⁻¹' {f x} := by simpa [hxx']
    rw [ha] at hx hx'
    simpa using hx.trans hx'.symm
  exact ⟨f, hf, ⟨hinj, hsurj⟩, hram⟩


/-- RiemannRochAna: a meromorphic-form divisor with finite order support
evaluates to the local meromorphic order. -/
theorem RiemannRochAna_divForm_apply_of_finite
    (hE : Module.finrank ℂ E = 1)
    (w : TangentBundle 𝓘(ℂ, E) C → ℂ)
    (hfin : (Function.support (b4c_ordForm (hE := hE) w)).Finite)
    (x : C) :
    b4c_divForm (hE := hE) w x = b4c_ordForm (hE := hE) w x := by
  simp only [b4c_divForm, dif_pos hfin, Finsupp.onFinset_apply]

/-- RiemannRochAna: a punctured neighborhood eventually avoids any
fixed finite set. -/
theorem RiemannRochAna_punctured_eventually_not_mem_finset [T1Space C]
    (S : Finset C) (x : C) : ∀ᶠ y in 𝓝[≠] x, y ∉ S := by
  classical
  have hn (z : C) (_ : z ∈ S) : ∀ᶠ y in 𝓝[≠] x, y ≠ z := by
    by_cases hz : z = x
    · subst z
      exact self_mem_nhdsWithin
    · exact (eventually_ne_nhds (Ne.symm hz)).filter_mono nhdsWithin_le_nhds
  filter_upwards [(Filter.eventually_all_finset S).mpr hn] with y hy
  intro hys
  exact hy y hys rfl

/-- RiemannRochAna: at a finite-order germ, the integer coefficient of the
meromorphic-form divisor coerces back to the local meromorphic order. -/
theorem RiemannRochAna_coe_divForm_apply
    (hE : Module.finrank ℂ E = 1)
    (w : TangentBundle 𝓘(ℂ, E) C → ℂ)
    (hfin : (Function.support (b4c_ordForm (hE := hE) w)).Finite)
    (x : C)
    (hx : meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 ≠ ⊤) :
    ((b4c_divForm (hE := hE) w x : ℤ) : WithTop ℤ) =
      meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 := by
  rw [RiemannRochAna_divForm_apply_of_finite hE w hfin x]
  exact WithTop.coe_untop₀_of_ne_top hx

/-- RiemannRochAna: the self-ratio of a meromorphic form detects whether
its local germ vanishes. -/
theorem RiemannRochAna_formRatio_self
    (hE : Module.finrank ℂ E = 1) (w : b4c_MeroForm E C hE) (x : C) :
    b4c_formRatio (hE := hE) w w x =
      if meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 = ⊤ then
        (0 : ℂ) else (1 : ℂ) := by
  by_cases hx : meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 = ⊤
  · have hg : (fun z ↦ HurwitzPrymRR_loc hE w x z /
        HurwitzPrymRR_loc hE w x z) =ᶠ[𝓝[≠] 0] fun _ ↦ (0 : ℂ) := by
      filter_upwards [meromorphicOrderAt_eq_top_iff.mp hx] with z hz
      simp [hz]
    rw [if_pos hx, b4c_formRatio, meromorphicOrderAt_congr hg]
    simp [meromorphicOrderAt_const]
  · have hg : (fun z ↦ HurwitzPrymRR_loc hE w x z /
        HurwitzPrymRR_loc hE w x z) =ᶠ[𝓝[≠] 0] fun _ ↦ (1 : ℂ) := by
      filter_upwards [(meromorphicOrderAt_ne_top_iff_eventually_ne_zero
        (w.property.2 x)).mp hx] with z hz
      exact div_self hz
    rw [if_neg hx, b4c_formRatio, meromorphicOrderAt_congr hg,
      meromorphicTrailingCoeffAt_congr_nhdsNE hg]
    simp [meromorphicOrderAt_const, meromorphicTrailingCoeffAt_const]

/-- RiemannRochAna: on a connected surface, one nonzero meromorphic-form
germ forces every local germ to have finite order. -/
theorem RiemannRochAna_meroForm_order_ne_top
    [ConnectedSpace C] (hE : Module.finrank ℂ E = 1)
    (w : b4c_MeroForm E C hE)
    (hw : (w : TangentBundle 𝓘(ℂ, E) C → ℂ) ≠ 0)
    (hgw : ∃ x, meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 ≠ ⊤)
    (x : C) : meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 ≠ ⊤ := by
  let F : C → OnePoint ℂ := b4c_formRatio (hE := hE) w w
  have hc : Continuous F :=
    (b4c_formRatio_isMeroFun_aux hE w w hw hw hgw hgw).1.continuous
  have hr : (Set.range F).Finite := by
    apply ((Set.finite_singleton ((1 : ℂ) : OnePoint ℂ)).insert
      ((0 : ℂ) : OnePoint ℂ)).subset
    rintro z ⟨y, rfl⟩
    change b4c_formRatio (hE := hE) w w y ∈ _
    rw [RiemannRochAna_formRatio_self hE w y]
    split_ifs <;> simp
  obtain ⟨y, hy⟩ := hgw
  intro hx
  have hxy : F x ≠ F y := by
    dsimp only [F]
    rw [RiemannRochAna_formRatio_self hE w x,
      RiemannRochAna_formRatio_self hE w y, if_pos hx, if_neg hy]
    exact OnePoint.coe_injective.ne zero_ne_one
  exact (isPreconnected_range hc).infinite_of_nontrivial
    ⟨F x, ⟨x, rfl⟩, F y, ⟨y, rfl⟩, hxy⟩ hr

theorem b4c_divForm_sub_aux [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (w₁ w₂ : b4c_MeroForm E C hE)
    (hw₁ : (w₁ : TangentBundle 𝓘(ℂ, E) C → ℂ) ≠ 0)
    (hw₂ : (w₂ : TangentBundle 𝓘(ℂ, E) C → ℂ) ≠ 0)
    (hg₁ : ∃ x, meromorphicOrderAt (HurwitzPrymRR_loc hE w₁ x) 0 ≠ ⊤)
    (hg₂ : ∃ x, meromorphicOrderAt (HurwitzPrymRR_loc hE w₂ x) 0 ≠ ⊤) :
    b4c_divForm (hE := hE) w₁ - b4c_divForm (hE := hE) w₂ =
      b4c_div E (b4c_formRatio (hE := hE) w₁ w₂) := by
  have hfin₁ := b4c_meroForm_orderSupport_finite_aux hE w₁
  have hfin₂ := b4c_meroForm_orderSupport_finite_aux hE w₂
  have hfinr := b4c_formRatio_spec_aux hE w₁ w₂ hw₁ hw₂ hg₁ hg₂
  unfold b4c_divForm b4c_div
  rw [dif_pos hfin₁, dif_pos hfin₂, dif_pos hfinr]
  ext x
  simp only [Finsupp.sub_apply, Finsupp.onFinset_apply]
  rw [b4c_formRatio_order_aux hE w₁ w₂ hw₁ hw₂ hg₁ hg₂ x]

/-- RiemannRochAna: divisor degree is additive. -/
theorem RiemannRochAna_deg_add (A B : C →₀ ℤ) :
    b4c_deg (A + B) = b4c_deg A + b4c_deg B := by
  classical
  exact Finsupp.sum_add_index (by simp) (by simp)

/-- RiemannRochAna: negating a divisor negates its degree. -/
theorem RiemannRochAna_deg_neg (A : C →₀ ℤ) :
    b4c_deg (-A) = -b4c_deg A := by
  classical
  simp [b4c_deg, Finsupp.sum_neg_index]

/-- RiemannRochAna: subtracting divisors subtracts their degrees. -/
theorem RiemannRochAna_deg_sub (A B : C →₀ ℤ) :
    b4c_deg (A - B) = b4c_deg A - b4c_deg B := by
  rw [sub_eq_add_neg, RiemannRochAna_deg_add, RiemannRochAna_deg_neg,
    sub_eq_add_neg]

/-- RiemannRochRR: two nonzero meromorphic forms have divisors of equal degree. -/
theorem RiemannRochRR_canonical_degree_eq
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (v w : b4c_MeroForm E C hE)
    (hv : (v : TangentBundle 𝓘(ℂ, E) C → ℂ) ≠ 0)
    (hw : (w : TangentBundle 𝓘(ℂ, E) C → ℂ) ≠ 0)
    (hgv : ∃ x, meromorphicOrderAt (HurwitzPrymRR_loc hE v x) 0 ≠ ⊤)
    (hgw : ∃ x, meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 ≠ ⊤) :
    b4c_deg (b4c_divForm (hE := hE) v) = b4c_deg (b4c_divForm (hE := hE) w) := by
  classical
  let S := (b4c_divForm (hE := hE) v).support ∪ (b4c_divForm (hE := hE) w).support
  let x₀ := Classical.choose hgv
  letI := RiemannRochAna_punctured_neBot hE x₀
  obtain ⟨x, hx⟩ := (RiemannRochAna_punctured_eventually_not_mem_finset S x₀).exists
  have hvo : meromorphicOrderAt (HurwitzPrymRR_loc hE v x) 0 = 0 := by
    rw [← RiemannRochAna_coe_divForm_apply hE v
      (b4c_meroForm_orderSupport_finite_aux hE v) x
      (RiemannRochAna_meroForm_order_ne_top hE v hv hgv x),
      Finsupp.notMem_support_iff.mp (fun h ↦ hx (Finset.mem_union_left _ h))]
    rfl
  have hwo : meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 = 0 := by
    rw [← RiemannRochAna_coe_divForm_apply hE w
      (b4c_meroForm_orderSupport_finite_aux hE w) x
      (RiemannRochAna_meroForm_order_ne_top hE w hw hgw x),
      Finsupp.notMem_support_iff.mp (fun h ↦ hx (Finset.mem_union_right _ h))]
    rfl
  let F : b4c_MeroFun E C := ⟨b4c_formRatio (hE := hE) v w,
    b4c_formRatio_isMeroFun_aux hE v w hv hw hgv hgw⟩
  have hq : meromorphicOrderAt
      (fun z ↦ HurwitzPrymRR_loc hE v x z / HurwitzPrymRR_loc hE w x z) 0 = 0 := by
    rw [b4c_formRatio_germ_order, hvo, hwo]
    rfl
  have hFn : ∃ x, F x ≠ (0 : ℂ) := by
    refine ⟨x, ?_⟩
    change b4c_formRatio (hE := hE) v w x ≠ (0 : ℂ)
    simp only [b4c_formRatio, hq, lt_self_iff_false, ite_false, ite_true]
    exact OnePoint.coe_injective.ne
      (((v.property.2 x).div (w.property.2 x)).meromorphicTrailingCoeffAt_ne_zero
        (by change meromorphicOrderAt (fun z ↦ HurwitzPrymRR_loc hE v x z / HurwitzPrymRR_loc hE w x z) 0 ≠ ⊤
            rw [hq]; simp))
  have hdeg := b4c_deg_div_meroFun_aux hE F hFn
  have he := congrArg b4c_deg (b4c_divForm_sub_aux hE v w hv hw hgv hgw)
  rw [RiemannRochAna_deg_sub] at he
  change b4c_deg (b4c_div E (b4c_formRatio (hE := hE) v w)) = 0 at hdeg
  omega


/-- RiemannRochRR: in genus zero, the degree-one sphere map pulls the affine
differential back to a form with one double pole and no zeros. -/
theorem RiemannRochRR_canonical_degree_of_genus_zero
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (w : b4c_MeroForm E C hE)
    (hw : (w : TangentBundle 𝓘(ℂ, E) C → ℂ) ≠ 0)
    (hgw : ∃ x, meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 ≠ ⊤)
    (hg : Module.finrank ℂ (b3_HolForm E C) = 0) :
    b4c_deg (b4c_divForm (hE := hE) w) = -2 := by
  classical
  let d := RiemannRochRR_genusZeroMapData (C := C) hE hg
  let f := d.toFun
  have hf : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω f := d.contMDiff_toFun
  have hnc : ∃ x y, f x ≠ f y := by
    obtain ⟨x, hx⟩ := d.bijective.2 (0 : ℂ)
    obtain ⟨y, hy⟩ := d.bijective.2 OnePoint.infty
    exact ⟨x, y, by change d.toFun x ≠ d.toFun y; rw [hx, hy]; exact OnePoint.coe_ne_infty _⟩
  let v : b4c_MeroForm E C hE := ⟨b3_pullback E ℂ f b4c_dz_sphere, by
    refine ⟨?_, RiemannRochAna_pullback_meromorphic hE (by simp) f hf _
      ⟨RiemannRochAna_sphere_differential_linear,
        RiemannRochAna_sphere_differential_meromorphic⟩⟩
    intro x a u v
    change b4c_dz_sphere ⟨f x, (mfderiv 𝓘(ℂ, E) 𝓘(ℂ, ℂ) f x) (a • u + v)⟩ = _
    rw [map_add, map_smul]
    exact RiemannRochAna_sphere_differential_linear (f x) a _ _⟩
  have ho (x : C) : meromorphicOrderAt (HurwitzPrymRR_loc hE v x) 0 =
      meromorphicOrderAt (HurwitzPrymRR_loc (by simp) b4c_dz_sphere (f x)) 0 := by
    have hh := HurwitzPrymRR_ord_pullback hE (by simp) f hf hnc x b4c_dz_sphere
      RiemannRochAna_sphere_differential_linear
      (RiemannRochAna_sphere_differential_meromorphic (f x))
    have hr : b4_ramIndex E ℂ f x = 1 := d.ramIndex_one x
    simpa only [hr, Nat.cast_one, WithTop.coe_one, mul_one, sub_self, WithTop.coe_zero, add_zero] using hh
  have hoi (x : C) : b4c_ordForm (hE := hE) v x =
      b4c_ordForm (hE := by simp) b4c_dz_sphere (f x) := congrArg WithTop.untop₀ (ho x)
  obtain ⟨x, hx⟩ := d.bijective.2 (0 : ℂ)
  have hx0 : meromorphicOrderAt (HurwitzPrymRR_loc hE v x) 0 = 0 := by
    change f x = (0 : ℂ) at hx
    rw [ho, hx, RiemannRochAna_sphere_differential_loc_finite, meromorphicOrderAt_const,
      if_neg (b4cov_lineEquiv_one_ne_zero _)]
  have hgv : ∃ x, meromorphicOrderAt (HurwitzPrymRR_loc hE v x) 0 ≠ ⊤ :=
    ⟨x, hx0.trans_ne (by simp)⟩
  have hv : (v : TangentBundle 𝓘(ℂ, E) C → ℂ) ≠ 0 := by
    intro hh
    have ht : meromorphicOrderAt (HurwitzPrymRR_loc hE v x) 0 ≠ ⊤ := hx0.trans_ne (by simp)
    rw [hh] at ht
    apply ht
    change meromorphicOrderAt (fun _ : ℂ ↦ (0 : ℂ)) 0 = ⊤
    rw [meromorphicOrderAt_const, if_pos rfl]
  obtain ⟨p, hp⟩ := d.bijective.2 OnePoint.infty
  change f p = OnePoint.infty at hp
  have hdiv : b4c_divForm (hE := hE) v = Finsupp.single p (-2) := by
    ext y
    rw [RiemannRochAna_divForm_apply_of_finite hE v
      (b4c_meroForm_orderSupport_finite_aux hE v), hoi]
    by_cases hy : y = p
    · subst y
      rw [hp, b4c_dz_sphere_ordForm_infty, Finsupp.single_eq_same]
    · have hfy : f y ≠ OnePoint.infty := fun h ↦ hy (d.bijective.1 (h.trans hp.symm))
      obtain ⟨z, hz⟩ := OnePoint.ne_infty_iff_exists.mp hfy
      rw [← hz, b4c_dz_sphere_ordForm_coe, Finsupp.single_eq_of_ne hy]
  rw [← RiemannRochRR_canonical_degree_eq hE v w hv hw hgv hgw, hdiv]
  exact Finsupp.sum_single_index (by simp)


/-- RiemannRochAna: multiplying a corrected zero-class principal scalar
by a holomorphic differential gives a meromorphic differential. -/
noncomputable def RiemannRochAna_principalKernelProduct [T2Space C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (c : LinearMap.ker (RiemannRochAna_principalClassLinear hE D))
    (θ : b3_HolForm E C) : b4c_MeroForm E C hE :=
  ⟨fun p ↦ RiemannRochAna_correctedPrincipal hE D c.1
      (RiemannRochAna_dbarRangeLift (E := E) (C := C)
        (RiemannRochAna_principalKernelToDbarRange hE D c)) p.proj * θ.1 p, by
    refine ⟨?_, ?_⟩
    · intro x a v u
      dsimp only
      rw [θ.property.2 x a v u]
      ring
    · intro x
      exact (RiemannRochAna_correctedPrincipal_meromorphic hE D c x).mul
        (RiemannRochAna_hol_loc_analytic hE θ x).meromorphicAt⟩

/-- RiemannRochAna: an analytic scalar on the surface is analytic in
the centered inverse coordinate. -/
theorem RiemannRochAna_scalar_centered_analytic
    (hE : Module.finrank ℂ E = 1) (f : C → ℂ) (x : C)
    (hf : ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω f x) :
    AnalyticAt ℂ (fun t ↦ f ((extChartAt 𝓘(ℂ, E) x).symm
      (extChartAt 𝓘(ℂ, E) x x + b4cov_lineEquiv hE t))) 0 := by
  let A : ℂ → C := fun t ↦ (extChartAt 𝓘(ℂ, E) x).symm
    (extChartAt 𝓘(ℂ, E) x x + b4cov_lineEquiv hE t)
  have hA0 : A 0 = x := by
    simp only [A, map_zero, add_zero]
    exact (extChartAt 𝓘(ℂ, E) x).left_inv (mem_extChartAt_source x)
  have hf' : ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω f (A 0) := by
    rwa [hA0]
  exact (contMDiffAt_iff_contDiffAt.mp
    (hf'.comp 0 (RiemannRochAna_centered_symm_analytic hE x))).analyticAt

/-- RiemannRochAna: corrected principal products have zero residues away
from the support of the prescribed principal data. -/
theorem RiemannRochAna_principalKernelProduct_residue_off_support [T2Space C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (c : LinearMap.ker (RiemannRochAna_principalClassLinear hE D))
    (θ : b3_HolForm E C) (x : C) (hx : x ∉ D.support) :
    b4c_res (hE := hE) (RiemannRochAna_principalKernelProduct hE D c θ) x = 0 := by
  let u := RiemannRochAna_dbarRangeLift (E := E) (C := C)
    (RiemannRochAna_principalKernelToDbarRange hE D c)
  have hf := RiemannRochAna_scalar_centered_analytic hE
    (RiemannRochAna_correctedPrincipal hE D c.1 u) x
    (RiemannRochAna_correctedPrincipal_analytic hE D c.1 u
      (RiemannRochAna_principalKernelPotential_spec hE D c) x hx)
  exact residue_eq_zero_of_analyticAt
    (hf.mul (RiemannRochAna_hol_loc_analytic hE θ x))

/-- RiemannRochAna: analytic corrections do not affect the residue of
a finite polar polynomial multiplied by an analytic coefficient. -/
theorem RiemannRochAna_polarProduct_residue (m : ℕ) (a : Fin m → ℂ)
    (b u : ℂ → ℂ) (hb : AnalyticAt ℂ b 0) (hu : AnalyticAt ℂ u 0) :
    residue (fun z ↦ ((∑ n, a n / z ^ ((n : ℕ) + 1)) - u z) * b z) 0 =
      ∑ n, a n * residue (fun z ↦ b z / z ^ ((n : ℕ) + 1)) 0 := by
  let f : Fin m → ℂ → ℂ := fun n z ↦ a n * (b z / z ^ ((n : ℕ) + 1))
  have hf (n : Fin m) : MeromorphicAt (f n) 0 :=
    analyticAt_const.meromorphicAt.mul
      (hb.meromorphicAt.div ((analyticAt_id (𝕜 := ℂ)).pow ((n : ℕ) + 1)).meromorphicAt)
  have he : (fun z ↦ ((∑ n, a n / z ^ ((n : ℕ) + 1)) - u z) * b z) =
      (∑ n, f n) - (fun z ↦ u z * b z) := by
    funext z
    simp only [Finset.sum_apply, Pi.sub_apply, sub_mul, Finset.sum_mul]
    congr 1
    apply Finset.sum_congr rfl
    intro n _
    dsimp only [f]
    ring
  have hsum : MeromorphicAt (∑ n, f n) 0 := MeromorphicAt.sum fun n _ ↦ hf n
  rw [he]
  change residue ((∑ n, f n) - u * b) 0 = _
  rw [residue_sub hsum (hu.mul hb).meromorphicAt,
    residue_eq_zero_of_analyticAt (hu.mul hb), sub_zero,
    residue_sum Finset.univ (fun n _ ↦ hf n)]
  simp only [f, residue_const_mul]

/-- RiemannRochAna: at a support point the residue of a corrected
principal product is the local principal residue pairing. -/
theorem RiemannRochAna_principalKernelProduct_residue_at_support [T2Space C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (c : LinearMap.ker (RiemannRochAna_principalClassLinear hE D))
    (θ : b3_HolForm E C) (i : D.support) :
    b4c_res (hE := hE) (RiemannRochAna_principalKernelProduct hE D c θ) i.1 =
      ∑ n, c.1 i n * residue (fun z : ℂ ↦
        HurwitzPrymRR_loc hE θ i.1 z / z ^ ((n : ℕ) + 1)) 0 := by
  let u := RiemannRochAna_dbarRangeLift (E := E) (C := C)
    (RiemannRochAna_principalKernelToDbarRange hE D c)
  let A : ℂ → C := fun t ↦ (extChartAt 𝓘(ℂ, E) i.1).symm
    (extChartAt 𝓘(ℂ, E) i.1 i.1 + b4cov_lineEquiv hE t)
  have hA0 : A 0 = i.1 := by
    simp only [A, map_zero, add_zero]
    exact (extChartAt 𝓘(ℂ, E) i.1).left_inv (mem_extChartAt_source i.1)
  have ht : Tendsto A (𝓝 0) (𝓝 i.1) := by
    have ha : ContMDiffAt 𝓘(ℂ, ℂ) 𝓘(ℂ, E) ω A 0 :=
      RiemannRochAna_centered_symm_analytic hE i.1
    simpa only [hA0] using ha.continuousAt.tendsto
  have hu : AnalyticAt ℂ (fun z ↦ u.1 (A z)) 0 :=
    RiemannRochAna_scalar_centered_analytic hE u i.1
      (RiemannRochAna_principalPotential_analytic hE D c.1 u
        (RiemannRochAna_principalKernelPotential_spec hE D c) i)
  have hg : HurwitzPrymRR_loc hE (RiemannRochAna_principalKernelProduct hE D c θ) i.1
      =ᶠ[𝓝[≠] 0] fun z ↦
        ((∑ n, c.1 i n / z ^ ((n : ℕ) + 1)) - u.1 (A z)) *
          HurwitzPrymRR_loc hE θ i.1 z := by
    filter_upwards [((RiemannRochAna_correctedPrincipal_germ hE D c.1 u i).comp_tendsto ht).filter_mono
      nhdsWithin_le_nhds,
      (RiemannRochAna_coordinate_centered_symm_germ hE i.1).filter_mono
        nhdsWithin_le_nhds] with z hz hc
    change RiemannRochAna_correctedPrincipal hE D c.1 u (A z) *
      HurwitzPrymRR_loc hE θ i.1 z = _
    dsimp only [Function.comp_apply] at hz
    change RiemannRochAna_coordinate hE i.1 (A z) = z at hc
    rw [hz]
    simp only [RiemannRochAna_principalPartAt, hc, id_eq]
  change residue _ 0 = _
  rw [residue_congr_nhdsNE hg]
  exact RiemannRochAna_polarProduct_residue _ (c.1 i) _ _
    (RiemannRochAna_hol_loc_analytic hE θ i.1) hu

/-- RiemannRochAna: the global residue theorem annihilates the principal
residue pairing of every zero-obstruction datum. -/
theorem RiemannRochAna_principalClassKernel_residuePairing_eq_zero
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (c : LinearMap.ker (RiemannRochAna_principalClassLinear hE D))
    (θ : b3_HolForm E C) :
    RiemannRochAna_principalResiduePairing hE D c.1 θ = 0 := by
  let w := RiemannRochAna_principalKernelProduct hE D c θ
  have hs : Function.support (fun x ↦ b4c_res (hE := hE) w x) ⊆ (D.support : Set C) := by
    intro x hx
    by_contra hn
    exact hx (RiemannRochAna_principalKernelProduct_residue_off_support hE D c θ x hn)
  calc
    _ = ∑ i : D.support, b4c_res (hE := hE) w i.1 := by
      unfold RiemannRochAna_principalResiduePairing
      apply Finset.sum_congr rfl
      intro i _
      exact (RiemannRochAna_principalKernelProduct_residue_at_support hE D c θ i).symm
    _ = ∑ x ∈ D.support, b4c_res (hE := hE) w x := Finset.sum_coe_sort _ _
    _ = ∑ᶠ x, b4c_res (hE := hE) w x := (finsum_eq_sum_of_support_subset _ hs).symm
    _ = 0 := b4c_residue_sum_aux hE w

/-- RiemannRochAna: zero-class principal data belong to the kernel of
the principal residue map. -/
theorem RiemannRochAna_principalClass_kernel_le_residueKernel
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ) :
    LinearMap.ker (RiemannRochAna_principalClassLinear hE D) ≤
      LinearMap.ker (RiemannRochAna_principalResidueLinear hE D) := by
  intro c hc
  rw [LinearMap.mem_ker]
  ext θ
  exact RiemannRochAna_principalClassKernel_residuePairing_eq_zero hE D ⟨c, hc⟩ θ

/-- RiemannRochAna: a decreasing family of subspaces in finite dimension
that excludes every nonzero vector reaches the zero subspace. -/
theorem RiemannRochAna_antitone_submodules_reach_bot
    {V : Type*} [AddCommGroup V] [Module ℂ V] [FiniteDimensional ℂ V]
    (K : ℕ → Submodule ℂ V) (hK : Antitone K)
    (hsep : ∀ v : V, v ≠ 0 → ∃ n, v ∉ K n) :
    ∃ m, K m = ⊥ := by
  have hex : ∃ r : ℕ, ∃ m : ℕ, Module.finrank ℂ (K m) = r := ⟨_, 0, rfl⟩
  obtain ⟨m, hm⟩ := Nat.find_spec hex
  have hmin (n : ℕ) : Module.finrank ℂ (K m) ≤ Module.finrank ℂ (K n) := by
    rw [hm]
    exact Nat.find_min' hex ⟨n, rfl⟩
  refine ⟨m, le_antisymm ?_ bot_le⟩
  intro v hv
  change v = 0
  by_contra hn
  obtain ⟨n, hn⟩ := hsep v hn
  have he : K (max m n) = K m :=
    Submodule.eq_of_le_of_finrank_le (hK (le_max_left m n)) (hmin (max m n))
  have hv' : v ∈ K (max m n) := by rwa [he]
  exact hn (hK (le_max_right m n) hv')

/-- RiemannRochAna: increasing an effective divisor decreases its
holomorphic principal residue kernel. -/
theorem RiemannRochAna_holPrincipalResidueKernel_antitone
    (hE : Module.finrank ℂ E = 1) (D B : C →₀ ℤ)
    (hD : ∀ x, 0 ≤ D x) (hB : ∀ x, 0 ≤ B x) (hDB : ∀ x, D x ≤ B x) :
    LinearMap.ker (RiemannRochAna_holPrincipalResidueLinear hE B) ≤
      LinearMap.ker (RiemannRochAna_holPrincipalResidueLinear hE D) := by
  intro θ hθ
  apply (RiemannRochAna_mem_holPrincipalResidueKernel_iff_meromorphicOrder hE D hD θ).mpr
  intro i
  have hi : D i.1 ≠ 0 := Finsupp.mem_support_iff.mp i.2
  have hib : i.1 ∈ B.support := by
    apply Finsupp.mem_support_iff.mpr
    have hd := hD i.1
    have hb := hDB i.1
    omega
  have ho := (RiemannRochAna_mem_holPrincipalResidueKernel_iff_meromorphicOrder
    hE B hB θ).mp hθ ⟨i.1, hib⟩
  have hle : (D i.1 : WithTop ℤ) ≤ (B i.1 : WithTop ℤ) := by exact_mod_cast hDB i.1
  exact hle.trans ho

/-- RiemannRochAna: at a finite holomorphic germ, a `WithTop` order bound is
equivalent to the corresponding integer form-order bound. -/
theorem RiemannRochAna_le_hol_order_iff_le_ordForm
    (hE : Module.finrank ℂ E = 1) (θ : b3_HolForm E C)
    (x : C) (m : ℤ)
    (hx : meromorphicOrderAt (HurwitzPrymRR_loc hE θ x) 0 ≠ ⊤) :
    (m : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE θ x) 0 ↔
      m ≤ b4c_ordForm (hE := hE) θ x := by
  rw [← WithTop.coe_untop₀_of_ne_top hx, WithTop.coe_le_coe]
  rfl

/-- RiemannRochAna: the zero set of a nonzero holomorphic differential does
not contain a neighborhood of any point. -/
theorem RiemannRochAna_hol_not_eventually_zero
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (θ : b3_HolForm E C) (hθ : θ ≠ 0)
    (x : C) : ¬∀ᶠ y in 𝓝 x, y ∈ b3Unimod_Z θ := by
  letI : FiniteDimensional ℂ E := Module.finite_of_finrank_pos (by omega)
  haveI : NeBot (𝓝[≠] x) := by
    rw [← mem_closure_iff_nhdsWithin_neBot, mem_closure_iff_nhds]
    intro N hN
    obtain ⟨U, hUN, -, -, -, z, hzU, hzx⟩ := b4cov_goodPoint hE x N hN
    exact ⟨z, hUN hzU, hzx⟩
  intro hz
  exact (infinite_of_mem_nhds x hz) (b3Unimod_Z_finite hE hθ)

/-- RiemannRochAna: neighborhood vanishing of a centered coefficient forces
the holomorphic differential to vanish on a neighborhood of its centre. -/
theorem RiemannRochAna_eventually_hol_zero_of_loc_zero
    (hE : Module.finrank ℂ E = 1) (θ : b3_HolForm E C) (x : C)
    (hz : ∀ᶠ t in 𝓝 (0 : ℂ), HurwitzPrymRR_loc hE θ x t = 0) :
    ∀ᶠ y in 𝓝 x, y ∈ b3Unimod_Z θ := by
  let L := b4cov_lineEquiv hE
  let τ : C → ℂ := fun y ↦ L.symm
    (extChartAt 𝓘(ℂ, E) x y - extChartAt 𝓘(ℂ, E) x x)
  have hτ : Tendsto τ (𝓝 x) (𝓝 0) := by
    have hc := (continuousAt_extChartAt (I := 𝓘(ℂ, E)) x).sub
      (continuousAt_const : ContinuousAt
        (fun _ : C ↦ extChartAt 𝓘(ℂ, E) x x) x)
    have ht := L.symm.continuous.continuousAt.comp hc
    convert ht.tendsto using 1 <;> simp [τ]
    ext y
    rfl
  filter_upwards [hτ.eventually hz,
    extChartAt_source_mem_nhds (I := 𝓘(ℂ, E)) x] with y hy hys
  have hb : θ.1 ⟨y, b4cov_vec x y (L 1)⟩ = 0 := by
    have he : extChartAt 𝓘(ℂ, E) x x + L (τ y) =
        extChartAt 𝓘(ℂ, E) x y := by
      dsimp only [τ]
      rw [L.apply_symm_apply]
      abel
    change θ.1 ⟨(extChartAt 𝓘(ℂ, E) x).symm
      (extChartAt 𝓘(ℂ, E) x x + L (τ y)),
        b4cov_vec x ((extChartAt 𝓘(ℂ, E) x).symm
          (extChartAt 𝓘(ℂ, E) x x + L (τ y))) (L 1)⟩ = 0 at hy
    rw [he, (extChartAt 𝓘(ℂ, E) x).left_inv hys] at hy
    exact hy
  intro v
  let u : E := (trivializationAt E (TangentSpace 𝓘(ℂ, E)) x ⟨y, v⟩).2
  have hv : b4cov_vec x y u = v := b4cov_vec_triv x y hys v
  have hu : u = L.symm u • L 1 := by
    rw [← map_smul, smul_eq_mul, mul_one]
    exact (L.apply_symm_apply u).symm
  rw [← hv, hu, b4cov_vec_smul x y hys,
    HurwitzPrymRR_IsLinear.smul θ.2.2, hb, mul_zero]

/-- RiemannRochAna: every centered coefficient germ of a nonzero
holomorphic differential has finite meromorphic order. -/
theorem RiemannRochAna_hol_order_ne_top
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (θ : b3_HolForm E C) (hθ : θ ≠ 0)
    (x : C) :
    meromorphicOrderAt (HurwitzPrymRR_loc hE θ x) 0 ≠ ⊤ := by
  intro hx
  have ha := RiemannRochAna_hol_loc_analytic hE θ x
  have ho : analyticOrderAt (HurwitzPrymRR_loc hE θ x) 0 = ⊤ := by
    rw [ha.meromorphicOrderAt_eq] at hx
    exact ENat.map_eq_top_iff.mp hx
  apply RiemannRochAna_hol_not_eventually_zero hE θ hθ x
  apply RiemannRochAna_eventually_hol_zero_of_loc_zero hE θ x
  exact analyticOrderAt_eq_top.mp ho

/-- RiemannRochAna: a holomorphic differential has nonnegative integer
meromorphic order at every point. -/
theorem RiemannRochAna_hol_ordForm_nonneg
    (hE : Module.finrank ℂ E = 1) (θ : b3_HolForm E C) (x : C) :
    0 ≤ b4c_ordForm (hE := hE) θ x := by
  exact WithTop.untop₀_nonneg.mpr
    (RiemannRochAna_hol_loc_analytic hE θ x).meromorphicOrderAt_nonneg

/-- RiemannRochAna: a nonzero form in the effective residue kernel has
integer form order at least the divisor multiplicity at every point. -/
theorem RiemannRochAna_holKernel_divisor_bound
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (hD : ∀ x, 0 ≤ D x) (θ : b3_HolForm E C) (hθ : θ ≠ 0)
    (hker : θ ∈ LinearMap.ker
      (RiemannRochAna_holPrincipalResidueLinear hE D)) (x : C) :
    D x ≤ b4c_ordForm (hE := hE) θ x := by
  by_cases hx : x ∈ D.support
  · have hm :=
      (RiemannRochAna_mem_holPrincipalResidueKernel_iff_meromorphicOrder
        hE D hD θ).mp hker ⟨x, hx⟩
    exact (RiemannRochAna_le_hol_order_iff_le_ordForm hE θ x (D x)
      (RiemannRochAna_hol_order_ne_top hE θ hθ x)).mp hm
  · have hx0 : D x = 0 := by simpa [Finsupp.mem_support_iff] using hx
    rw [hx0]
    exact RiemannRochAna_hol_ordForm_nonneg hE θ x

/-- RiemannRochAna: sufficiently many jets at one point distinguish all
holomorphic differentials on the compact connected surface. -/
theorem RiemannRochAna_exists_single_holResidueKernel_bot
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (x : C) :
    ∃ m : ℕ, LinearMap.ker
      (RiemannRochAna_holPrincipalResidueLinear hE (Finsupp.single x (m : ℤ))) = ⊥ := by
  letI : FiniteDimensional ℂ E := Module.finite_of_finrank_pos (by omega)
  letI : FiniteDimensional ℂ (b3_HolForm E C) := b3Forms_holForm_finiteDimensional hE
  have heff (m : ℕ) (y : C) : 0 ≤ (Finsupp.single x (m : ℤ)) y := by
    simp only [Finsupp.single_apply]
    split_ifs <;> positivity
  apply RiemannRochAna_antitone_submodules_reach_bot
  · intro m n hmn
    apply RiemannRochAna_holPrincipalResidueKernel_antitone hE _ _ (heff m) (heff n)
    intro y
    simp only [Finsupp.single_apply]
    split_ifs <;> omega
  · intro θ hθ
    let n := (b4c_ordForm (hE := hE) θ x).toNat + 1
    refine ⟨n, ?_⟩
    intro hk
    have hb := RiemannRochAna_holKernel_divisor_bound hE
      (Finsupp.single x (n : ℤ)) (heff n) θ hθ hk x
    rw [Finsupp.single_eq_same] at hb
    have hn := RiemannRochAna_hol_ordForm_nonneg hE θ x
    dsimp only [n] at hb
    omega

/-- RiemannRochAna: every effective divisor is dominated by an effective
divisor with zero holomorphic residue kernel. -/
theorem RiemannRochAna_exists_dominating_holResidueKernel_bot
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ) (hD : ∀ y, 0 ≤ D y) (x : C) :
    ∃ B : C →₀ ℤ, (∀ y, 0 ≤ B y) ∧ (∀ y, D y ≤ B y) ∧
      LinearMap.ker (RiemannRochAna_holPrincipalResidueLinear hE B) = ⊥ := by
  obtain ⟨m, hm⟩ := RiemannRochAna_exists_single_holResidueKernel_bot hE x
  let S : C →₀ ℤ := Finsupp.single x (m : ℤ)
  have hS (y : C) : 0 ≤ S y := by
    simp only [S, Finsupp.single_apply]
    split_ifs <;> positivity
  refine ⟨D + S, ?_, ?_, ?_⟩
  · intro y
    exact add_nonneg (hD y) (hS y)
  · intro y
    change D y ≤ D y + S y
    exact le_add_of_nonneg_right (hS y)
  · apply le_antisymm _ bot_le
    rw [← hm]
    apply RiemannRochAna_holPrincipalResidueKernel_antitone hE S (D + S) hS
      (fun y ↦ add_nonneg (hD y) (hS y))
    intro y
    change S y ≤ D y + S y
    exact le_add_of_nonneg_left (hD y)

/-- RiemannRochAna: principal coefficients extend by zero to the slots
of another divisor. -/
noncomputable def RiemannRochAna_principalDataExtend (D B : C →₀ ℤ) :
    RiemannRochAna_PrincipalData D →ₗ[ℂ] RiemannRochAna_PrincipalData B := by
  classical
  exact
    { toFun := fun c i n ↦ if hi : i.1 ∈ D.support then
        if hn : (n : ℕ) < (D i.1).toNat then c ⟨i.1, hi⟩ ⟨n, hn⟩ else 0 else 0
      map_add' := by
        intro c d
        funext i n
        dsimp only
        by_cases hi : i.1 ∈ D.support <;>
          by_cases hn : (n : ℕ) < (D i.1).toNat <;>
          simp only [Pi.add_apply, hi, hn, dite_true, dite_false, zero_add]
      map_smul' := by
        intro a c
        funext i n
        dsimp only
        by_cases hi : i.1 ∈ D.support <;>
          by_cases hn : (n : ℕ) < (D i.1).toNat <;>
          simp only [Pi.smul_apply, RingHom.id_apply, hi, hn, dite_true, dite_false, smul_zero] }

/-- RiemannRochAna: extension by zero preserves the principal residue
pairing under effective divisor enlargement. -/
theorem RiemannRochAna_principalDataExtend_residuePairing
    (hE : Module.finrank ℂ E = 1) (D B : C →₀ ℤ)
    (hD : ∀ x, 0 ≤ D x) (hDB : ∀ x, D x ≤ B x)
    (c : RiemannRochAna_PrincipalData D) (θ : b3_HolForm E C) :
    RiemannRochAna_principalResiduePairing hE B (RiemannRochAna_principalDataExtend D B c) θ =
      RiemannRochAna_principalResiduePairing hE D c θ := by
  classical
  have hs (i : D.support) : i.1 ∈ B.support := by
    apply Finsupp.mem_support_iff.mpr
    have hn := Finsupp.mem_support_iff.mp i.2
    have hd := hD i.1
    have hb := hDB i.1
    omega
  let e : D.support → B.support := fun i ↦ ⟨i.1, hs i⟩
  have he : Function.Injective e := by
    intro i j hij
    exact Subtype.ext (congrArg (fun j : B.support ↦ j.1) hij)
  unfold RiemannRochAna_principalResiduePairing
  symm
  apply Fintype.sum_of_injective e he
  · intro i hi
    have hnot : i.1 ∉ D.support := by
      intro hiD
      apply hi
      exact ⟨⟨i.1, hiD⟩, Subtype.ext rfl⟩
    apply Finset.sum_eq_zero
    intro n _
    simp only [RiemannRochAna_principalDataExtend, LinearMap.coe_mk, AddHom.coe_mk,
      dif_neg hnot, zero_mul]
  · intro i
    let h : (D i.1).toNat ≤ (B i.1).toNat := Int.toNat_le_toNat (hDB i.1)
    apply Fintype.sum_of_injective (Fin.castLE h) (Fin.castLE_injective h)
    · intro n hn
      have hnd : ¬(n : ℕ) < (D i.1).toNat := by
        intro hn'
        exact hn ⟨⟨n, hn'⟩, rfl⟩
      simp only [e, RiemannRochAna_principalDataExtend, LinearMap.coe_mk, AddHom.coe_mk,
        dif_pos i.2, dif_neg hnd, zero_mul]
    · intro n
      simp only [e, RiemannRochAna_principalDataExtend, LinearMap.coe_mk, AddHom.coe_mk,
        dif_pos i.2, Fin.coe_castLE, dif_pos n.isLt]

/-- RiemannRochAna: transposing the finite principal residue pairing
preserves the dimension of its range. -/
theorem RiemannRochAna_holPrincipalResidue_range_finrank
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ) :
    Module.finrank ℂ
        (LinearMap.range (RiemannRochAna_holPrincipalResidueLinear hE D)) =
      Module.finrank ℂ
        (LinearMap.range (RiemannRochAna_principalResidueLinear hE D)) := by
  letI : FiniteDimensional ℂ E := Module.finite_of_finrank_pos (by omega)
  letI : FiniteDimensional ℂ (b3_HolForm E C) :=
    b3Forms_holForm_finiteDimensional hE
  let B := RiemannRochAna_principalResidueLinear hE D
  change Module.finrank ℂ
      (LinearMap.range (B.dualMap.comp
        (Module.evalEquiv ℂ (b3_HolForm E C)).toLinearMap)) =
    Module.finrank ℂ (LinearMap.range B)
  rw [LinearMap.range_comp_of_range_eq_top _ (LinearEquiv.range _),
    LinearMap.finrank_range_dualMap_eq_finrank_range]

/-- RiemannRochAna: the rank of the principal residue map and the dimension
of its transposed holomorphic kernel add to the holomorphic dimension. -/
theorem RiemannRochAna_principalResidue_rank_add_holKernel
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ) :
    Module.finrank ℂ
        (LinearMap.range (RiemannRochAna_principalResidueLinear hE D)) +
      Module.finrank ℂ
        (LinearMap.ker (RiemannRochAna_holPrincipalResidueLinear hE D)) =
      Module.finrank ℂ (b3_HolForm E C) := by
  letI : FiniteDimensional ℂ E := Module.finite_of_finrank_pos (by omega)
  letI : FiniteDimensional ℂ (b3_HolForm E C) :=
    b3Forms_holForm_finiteDimensional hE
  rw [← RiemannRochAna_holPrincipalResidue_range_finrank hE D]
  exact (RiemannRochAna_holPrincipalResidueLinear hE D).finrank_range_add_finrank_ker

/-- RiemannRochAna: the principal residue rank is bounded by the
Dolbeault principal-obstruction rank. -/
theorem RiemannRochAna_principalResidue_rank_le_principalClass_rank
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ) :
    Module.finrank ℂ (LinearMap.range (RiemannRochAna_principalResidueLinear hE D)) ≤
      Module.finrank ℂ (LinearMap.range (RiemannRochAna_principalClassLinear hE D)) := by
  have hk := Submodule.finrank_mono
    (RiemannRochAna_principalClass_kernel_le_residueKernel hE D)
  have hc := (RiemannRochAna_principalClassLinear hE D).finrank_range_add_finrank_ker
  have hr := (RiemannRochAna_principalResidueLinear hE D).finrank_range_add_finrank_ker
  omega

/-- RiemannRochAna: when holomorphic jets distinguish all forms, the
principal obstruction kernel equals the principal residue kernel. -/
theorem RiemannRochAna_principalClass_kernel_eq_of_holKernel_bot
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (hbot : LinearMap.ker (RiemannRochAna_holPrincipalResidueLinear hE D) = ⊥) :
    LinearMap.ker (RiemannRochAna_principalClassLinear hE D) =
      LinearMap.ker (RiemannRochAna_principalResidueLinear hE D) := by
  letI := (b4c_dolbeault_finite_aux (E := E) (C := C) hE).1
  have hr := RiemannRochAna_principalResidue_rank_add_holKernel hE D
  rw [hbot, finrank_bot, add_zero] at hr
  have hc := (LinearMap.range (RiemannRochAna_principalClassLinear hE D)).finrank_le
  rw [(b4c_dolbeault_finite_aux (E := E) (C := C) hE).2] at hc
  have hrc := RiemannRochAna_principalResidue_rank_le_principalClass_rank hE D
  apply Submodule.eq_of_le_of_finrank_eq
    (RiemannRochAna_principalClass_kernel_le_residueKernel hE D)
  have hc' := (RiemannRochAna_principalClassLinear hE D).finrank_range_add_finrank_ker
  have hr' := (RiemannRochAna_principalResidueLinear hE D).finrank_range_add_finrank_ker
  omega

/-- RiemannRochAna: extending coefficients to a dominating divisor
preserves the polar polynomial at every original support point. -/
theorem RiemannRochAna_principalDataExtend_principalPart
    (hE : Module.finrank ℂ E = 1) (D B : C →₀ ℤ)
    (hDB : ∀ x, D x ≤ B x) (c : RiemannRochAna_PrincipalData D)
    (x : C) (hxD : x ∈ D.support) (hxB : x ∈ B.support) :
    RiemannRochAna_principalPartAt hE B (RiemannRochAna_principalDataExtend D B c) ⟨x, hxB⟩ =
      RiemannRochAna_principalPartAt hE D c ⟨x, hxD⟩ := by
  classical
  funext y
  unfold RiemannRochAna_principalPartAt
  symm
  let h : (D x).toNat ≤ (B x).toNat := Int.toNat_le_toNat (hDB x)
  apply Fintype.sum_of_injective (Fin.castLE h) (Fin.castLE_injective h)
  · intro n hn
    have hnd : ¬(n : ℕ) < (D x).toNat := by
      intro hn'
      exact hn ⟨⟨n, hn'⟩, rfl⟩
    simp only [RiemannRochAna_principalDataExtend, LinearMap.coe_mk, AddHom.coe_mk,
      dif_pos hxD, dif_neg hnd, zero_div]
  · intro n
    simp only [RiemannRochAna_principalDataExtend, LinearMap.coe_mk, AddHom.coe_mk,
      dif_pos hxD, Fin.coe_castLE, dif_pos n.isLt]

/-- RiemannRochAna: extended principal data have zero polar polynomial
at newly added support points. -/
theorem RiemannRochAna_principalDataExtend_principalPart_zero
    (hE : Module.finrank ℂ E = 1) (D B : C →₀ ℤ)
    (c : RiemannRochAna_PrincipalData D) (i : B.support) (hi : i.1 ∉ D.support) :
    RiemannRochAna_principalPartAt hE B (RiemannRochAna_principalDataExtend D B c) i = 0 := by
  funext y
  simp only [RiemannRochAna_principalPartAt, RiemannRochAna_principalDataExtend,
    LinearMap.coe_mk, AddHom.coe_mk, dif_neg hi, zero_div, Finset.sum_const_zero,
    Pi.zero_apply]

/-- RiemannRochAna: cutoff scalars for the same extended principal data
differ by a globally smooth function. -/
theorem RiemannRochAna_principalScalar_extension_difference_smooth [T2Space C]
    (hE : Module.finrank ℂ E = 1) (D B : C →₀ ℤ)
    (hD : ∀ x, 0 ≤ D x) (hDB : ∀ x, D x ≤ B x)
    (c : RiemannRochAna_PrincipalData D) :
    ContMDiff 𝓘(ℝ, E) 𝓘(ℝ, ℂ) ∞
      (RiemannRochAna_principalScalar hE D c -
        RiemannRochAna_principalScalar hE B (RiemannRochAna_principalDataExtend D B c)) := by
  intro x
  let e := RiemannRochAna_principalDataExtend D B c
  by_cases hxD : x ∈ D.support
  · have hxB : x ∈ B.support := by
      apply Finsupp.mem_support_iff.mpr
      have hn := Finsupp.mem_support_iff.mp hxD
      have hd := hD x
      have hb := hDB x
      omega
    apply (contMDiffAt_const (c := (0 : ℂ))).congr_of_eventuallyEq
    filter_upwards [RiemannRochAna_principalScalar_germ hE D c ⟨x, hxD⟩,
      RiemannRochAna_principalScalar_germ hE B e ⟨x, hxB⟩] with y hyD hyB
    change RiemannRochAna_principalScalar hE D c y -
      RiemannRochAna_principalScalar hE B e y = 0
    rw [hyD, hyB, RiemannRochAna_principalDataExtend_principalPart hE D B hDB c x hxD hxB]
    exact sub_self _
  · have hsD := RiemannRochAna_principalScalar_smooth_off_support hE D c x hxD
    have hsB : ContMDiffAt 𝓘(ℝ, E) 𝓘(ℝ, ℂ) ∞
        (RiemannRochAna_principalScalar hE B e) x := by
      by_cases hxB : x ∈ B.support
      · apply (contMDiffAt_const (c := (0 : ℂ))).congr_of_eventuallyEq
        have hg := RiemannRochAna_principalScalar_germ hE B e ⟨x, hxB⟩
        rwa [RiemannRochAna_principalDataExtend_principalPart_zero hE D B c ⟨x, hxB⟩ hxD] at hg
      · exact RiemannRochAna_principalScalar_smooth_off_support hE B e x hxB
    exact hsD.sub hsB

/-- RiemannRochAna: a constant vector in a chart trivialization gives
an analytic local section through the central tangent fibre. -/
theorem RiemannRochAna_chartVectorSection_analyticAt (x : C) (v : E) :
    ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, E).tangent ω
      (fun y : C ↦ (⟨y, b4cov_vec x y v⟩ : TangentBundle 𝓘(ℂ, E) C)) x := by
  let e := trivializationAt E (TangentSpace 𝓘(ℂ, E)) x
  have hs : (⟨x, b4cov_vec x x v⟩ : TangentBundle 𝓘(ℂ, E) C) ∈ e.source :=
    e.mem_source.mpr (b4cov_mem_baseSet x x (mem_extChartAt_source x))
  rw [e.contMDiffAt_iff (f := fun y : C ↦
    (⟨y, b4cov_vec x y v⟩ : TangentBundle 𝓘(ℂ, E) C)) hs]
  refine ⟨contMDiffAt_id, ?_⟩
  apply (contMDiffAt_const (c := v)).congr_of_eventuallyEq
  filter_upwards [extChartAt_source_mem_nhds (I := 𝓘(ℂ, E)) x] with y hy
  exact b4cov_triv_vec x y hy v

/-- RiemannRochAna: continuous differentials agreeing on punctured base
fibres agree on the central fibre as well. -/
theorem RiemannRochAna_fibre_eq_of_punctured_germ
    (hE : Module.finrank ℂ E = 1) (η θ : TangentBundle 𝓘(ℂ, E) C → ℂ)
    (x : C) (v : E) (hη : ContinuousAt η ⟨x, v⟩) (hθ : ContinuousAt θ ⟨x, v⟩)
    (hg : ∀ᶠ y in 𝓝[≠] x, ∀ u : E, η ⟨y, u⟩ = θ ⟨y, u⟩) :
    η ⟨x, v⟩ = θ ⟨x, v⟩ := by
  letI := RiemannRochAna_punctured_neBot hE x
  let σ : C → TangentBundle 𝓘(ℂ, E) C := fun y ↦ ⟨y, b4cov_vec x y v⟩
  have hs : σ x = ⟨x, v⟩ := by simp only [σ, b4cov_vec_self]
  have hc : ContinuousAt σ x := (RiemannRochAna_chartVectorSection_analyticAt x v).continuousAt
  rw [← hs] at hη hθ
  have he : (η ∘ σ) =ᶠ[𝓝[≠] x] (θ ∘ σ) := by
    filter_upwards [hg] with y hy
    exact hy (b4cov_vec x y v)
  have he0 := ((hη.comp hc).eventuallyEq_nhds_iff_eventuallyEq_nhdsNE
    (hθ.comp hc)).mp he |>.self_of_nhds
  simpa only [Function.comp_apply, hs] using he0

/-- RiemannRochAna: subtraction commutes with the conjugate differential
at real differentiable points. -/
theorem RiemannRochAna_dbar_sub_at (u v : C → ℂ) (x : C)
    (hu : MDifferentiableAt 𝓘(ℝ, E) 𝓘(ℝ, ℂ) u x)
    (hv : MDifferentiableAt 𝓘(ℝ, E) 𝓘(ℝ, ℂ) v x) (w : E) :
    b4c_dbar E C (u - v) ⟨x, w⟩ =
      b4c_dbar E C u ⟨x, w⟩ - b4c_dbar E C v ⟨x, w⟩ := by
  unfold b4c_dbar
  rw [mfderiv_sub hu hv]
  simp only [ContinuousLinearMap.sub_apply]
  ring

/-- RiemannRochAna: the difference between extended principal obstruction
forms is the conjugate differential of their smooth scalar difference. -/
theorem RiemannRochAna_principalScalar_extension_difference_dbar [T2Space C]
    (hE : Module.finrank ℂ E = 1) (D B : C →₀ ℤ)
    (hD : ∀ x, 0 ≤ D x) (hDB : ∀ x, D x ≤ B x)
    (c : RiemannRochAna_PrincipalData D) :
    b4c_dbar E C (RiemannRochAna_principalScalar hE D c -
        RiemannRochAna_principalScalar hE B (RiemannRochAna_principalDataExtend D B c)) =
      (RiemannRochAna_principalObstructionLinear hE D c).1 -
        (RiemannRochAna_principalObstructionLinear hE B
          (RiemannRochAna_principalDataExtend D B c)).1 := by
  let e := RiemannRochAna_principalDataExtend D B c
  let u : b4c_SmoothFun E C := ⟨RiemannRochAna_principalScalar hE D c -
    RiemannRochAna_principalScalar hE B e,
    RiemannRochAna_principalScalar_extension_difference_smooth hE D B hD hDB c⟩
  let βD := RiemannRochAna_principalObstructionLinear hE D c
  let βB := RiemannRochAna_principalObstructionLinear hE B e
  funext p
  apply RiemannRochAna_fibre_eq_of_punctured_germ hE
    (b4c_dbar E C u) (βD.1 - βB.1) p.proj p.2
    (b4c_dbar_mem_aux u).1.continuous.continuousAt
    (βD.property.1.sub βB.property.1).continuous.continuousAt
  filter_upwards [RiemannRochAna_punctured_eventually_not_mem_finset B.support p.proj] with y hy
  intro v
  have hyD : y ∉ D.support := by
    intro hyD
    have hd := hD y
    have hb := hDB y
    have hn := Finsupp.mem_support_iff.mp hyD
    have hz : B y = 0 := by simpa [Finsupp.mem_support_iff] using hy
    omega
  have hd := (RiemannRochAna_principalScalar_smooth_off_support hE D c y hyD).mdifferentiableAt
    (by simp)
  have hb := (RiemannRochAna_principalScalar_smooth_off_support hE B e y hy).mdifferentiableAt
    (by simp)
  change b4c_dbar E C (RiemannRochAna_principalScalar hE D c -
    RiemannRochAna_principalScalar hE B e) ⟨y, v⟩ = βD.1 ⟨y, v⟩ - βB.1 ⟨y, v⟩
  rw [RiemannRochAna_dbar_sub_at _ _ y hd hb v,
    RiemannRochAna_principalScalar_dbar hE D c y hyD v,
    RiemannRochAna_principalScalar_dbar hE B e y hy v]

/-- RiemannRochAna: extension by zero preserves the Dolbeault class
of principal data under effective divisor enlargement. -/
theorem RiemannRochAna_principalDataExtend_class [T2Space C]
    (hE : Module.finrank ℂ E = 1) (D B : C →₀ ℤ)
    (hD : ∀ x, 0 ≤ D x) (hDB : ∀ x, D x ≤ B x)
    (c : RiemannRochAna_PrincipalData D) :
    RiemannRochAna_principalClassLinear hE D c =
      RiemannRochAna_principalClassLinear hE B (RiemannRochAna_principalDataExtend D B c) := by
  let e := RiemannRochAna_principalDataExtend D B c
  let u : b4c_SmoothFun E C := ⟨RiemannRochAna_principalScalar hE D c -
    RiemannRochAna_principalScalar hE B e,
    RiemannRochAna_principalScalar_extension_difference_smooth hE D B hD hDB c⟩
  let βD := RiemannRochAna_principalObstructionLinear hE D c
  let βB := RiemannRochAna_principalObstructionLinear hE B e
  have hz : (Submodule.Quotient.mk (βD - βB) : b4c_Dolbeault01 E C) = 0 := by
    apply (RiemannRochAna_class_eq_zero_iff hE (βD - βB)).mpr
    exact ⟨u, RiemannRochAna_principalScalar_extension_difference_dbar hE D B hD hDB c⟩
  rw [Submodule.Quotient.mk_sub] at hz
  exact sub_eq_zero.mp hz

/-- RiemannRochAna: for effective divisors, vanishing of all principal
residue pairings is equivalent to vanishing of the Dolbeault obstruction. -/
theorem RiemannRochAna_principalClass_kernel_eq_residueKernel_effective
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ) (hD : ∀ x, 0 ≤ D x) (x : C) :
    LinearMap.ker (RiemannRochAna_principalClassLinear hE D) =
      LinearMap.ker (RiemannRochAna_principalResidueLinear hE D) := by
  apply le_antisymm (RiemannRochAna_principalClass_kernel_le_residueKernel hE D)
  intro c hc
  obtain ⟨B, -, hDB, hbot⟩ :=
    RiemannRochAna_exists_dominating_holResidueKernel_bot hE D hD x
  have hb : RiemannRochAna_principalDataExtend D B c ∈
      LinearMap.ker (RiemannRochAna_principalResidueLinear hE B) := by
    rw [LinearMap.mem_ker]
    ext θ
    change RiemannRochAna_principalResiduePairing hE B
      (RiemannRochAna_principalDataExtend D B c) θ = 0
    rw [RiemannRochAna_principalDataExtend_residuePairing hE D B hD hDB c θ]
    exact congrArg (fun f : Module.Dual ℂ (b3_HolForm E C) ↦ f θ)
      (LinearMap.mem_ker.mp hc)
  have hbC : RiemannRochAna_principalDataExtend D B c ∈
      LinearMap.ker (RiemannRochAna_principalClassLinear hE B) := by
    rw [RiemannRochAna_principalClass_kernel_eq_of_holKernel_bot hE B hbot]
    exact hb
  change RiemannRochAna_principalClassLinear hE D c = 0
  rw [RiemannRochAna_principalDataExtend_class hE D B hD hDB c]
  exact hbC

/-- RiemannRochAna: constant Laurent coefficients of form ratios depend
linearly on the holomorphic numerator. -/
noncomputable def RiemannRochAna_holRatioValueLinear
    (hE : Module.finrank ℂ E = 1) (w : b4c_MeroForm E C hE) :
    b3_HolForm E C →ₗ[ℂ] (C → ℂ) where
  toFun θ x := residue (fun z : ℂ ↦
    (HurwitzPrymRR_loc hE θ x z / HurwitzPrymRR_loc hE w x z) / z) 0
  map_add' θ η := by
    funext x
    change residue (fun z : ℂ ↦
      (HurwitzPrymRR_loc hE (θ + η) x z / HurwitzPrymRR_loc hE w x z) / z) 0 = _
    rw [show (fun z : ℂ ↦
        (HurwitzPrymRR_loc hE (θ + η) x z / HurwitzPrymRR_loc hE w x z) / z) =
      (fun z : ℂ ↦ (HurwitzPrymRR_loc hE θ x z / HurwitzPrymRR_loc hE w x z) / z) +
      (fun z : ℂ ↦ (HurwitzPrymRR_loc hE η x z / HurwitzPrymRR_loc hE w x z) / z) by
        funext z
        simp only [HurwitzPrymRR_loc, b4cov_coef, Submodule.coe_add, Pi.add_apply]
        ring]
    exact residue_add
      (((RiemannRochAna_hol_loc_analytic hE θ x).meromorphicAt.div
        (w.property.2 x)).div analyticAt_id.meromorphicAt)
      (((RiemannRochAna_hol_loc_analytic hE η x).meromorphicAt.div
        (w.property.2 x)).div analyticAt_id.meromorphicAt)
  map_smul' a θ := by
    funext x
    change residue (fun z : ℂ ↦
      (HurwitzPrymRR_loc hE (a • θ) x z / HurwitzPrymRR_loc hE w x z) / z) 0 = _
    rw [show (fun z : ℂ ↦
        (HurwitzPrymRR_loc hE (a • θ) x z / HurwitzPrymRR_loc hE w x z) / z) =
      (fun z : ℂ ↦ a *
        ((HurwitzPrymRR_loc hE θ x z / HurwitzPrymRR_loc hE w x z) / z)) by
        funext z
        simp only [HurwitzPrymRR_loc, b4cov_coef, Submodule.coe_smul,
          Pi.smul_apply, smul_eq_mul]
        ring,
      residue_const_mul]
    rfl

/-- RiemannRochAna: a meromorphic function of nonnegative order cannot
take the value at infinity. -/
theorem RiemannRochAna_ne_infty_of_ord_nonneg
    [T2Space C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (F : b4c_MeroFun E C) (x : C)
    (hx : 0 ≤ b4c_ord E F x) : F x ≠ OnePoint.infty := by
  intro hxi
  have hx0 : F x ≠ (0 : ℂ) := by
    intro hxz
    exact OnePoint.coe_ne_infty (0 : ℂ) (hxz.symm.trans hxi)
  obtain ⟨y, hy⟩ := F.property.2
  have hnc : ∃ a b, F a ≠ F b := by
    refine ⟨x, y, ?_⟩
    intro hxy
    apply hy
    rw [← hxy, hxi]
  have hr := b4cov_ramIndex_pos F F.property.1 hnc x
  rw [b4c_ord, if_neg hx0, if_pos hxi] at hx
  omega

/-- RiemannRochAna: a meromorphic-function divisor with finite order support
evaluates to the local integer order. -/
theorem RiemannRochAna_div_apply_of_finite
    (F : C → OnePoint ℂ)
    (hfin : (Function.support (b4c_ord E F)).Finite) (x : C) :
    b4c_div E F x = b4c_ord E F x := by
  simp only [b4c_div, dif_pos hfin, Finsupp.onFinset_apply]

/-- RiemannRochAna: the global meromorphic form ratio has local integer
order equal to the difference of numerator and denominator form orders. -/
theorem RiemannRochAna_formRatio_ord
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (θ : b3_HolForm E C) (hθ : θ ≠ 0)
    (w : b4c_MeroForm E C hE)
    (hw : (w : TangentBundle 𝓘(ℂ, E) C → ℂ) ≠ 0)
    (hgw : ∃ x, meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 ≠ ⊤)
    (x : C) :
    b4c_ord E (b4c_formRatio (hE := hE) θ w) x =
      b4c_ordForm (hE := hE) θ x - b4c_ordForm (hE := hE) w x := by
  let η : b4c_MeroForm E C hE := ⟨θ, RiemannRochAna_hol_isMeroForm hE θ⟩
  have hη : (η : TangentBundle 𝓘(ℂ, E) C → ℂ) ≠ 0 := by
    intro hz
    apply hθ
    exact Subtype.ext hz
  obtain ⟨y, hy⟩ := RiemannRochAna_hol_nonzero_germ hE θ hθ
  have hgη : ∃ y, meromorphicOrderAt (HurwitzPrymRR_loc hE η y) 0 ≠ ⊤ :=
    ⟨y, hy.trans_ne (by simp)⟩
  have hd := congrArg (fun A : C →₀ ℤ ↦ A x)
    (b4c_divForm_sub_aux hE η w hη hw hgη hgw)
  rw [Finsupp.sub_apply,
    RiemannRochAna_divForm_apply_of_finite hE η
      (b4c_meroForm_orderSupport_finite_aux hE η),
    RiemannRochAna_divForm_apply_of_finite hE w
      (b4c_meroForm_orderSupport_finite_aux hE w),
    RiemannRochAna_div_apply_of_finite
      (b4c_formRatio (hE := hE) η w)
      (b4c_formRatio_spec_aux hE η w hη hw hgη hgw)] at hd
  exact hd.symm

/-- RiemannRochAna: adding the canonical-divisor coefficient to the local
form-ratio order cancels the denominator order. -/
theorem RiemannRochAna_hol_ratio_add_canonical_sub
    (hE : Module.finrank ℂ E = 1) (θ : b3_HolForm E C)
    (w : b4c_MeroForm E C hE)
    (hfin : (Function.support (b4c_ordForm (hE := hE) w)).Finite)
    (D : C →₀ ℤ) (x : C) :
    b4c_ordForm (hE := hE) θ x - b4c_ordForm (hE := hE) w x +
        (b4c_divForm (hE := hE) w - D) x =
      b4c_ordForm (hE := hE) θ x - D x := by
  rw [Finsupp.sub_apply, RiemannRochAna_divForm_apply_of_finite hE w hfin]
  ring

/-- RiemannRochAna: the ratio of an effective-kernel form by a fixed
meromorphic form is bounded by the corresponding canonical divisor. -/
theorem RiemannRochAna_formRatio_canonical_bound
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (hD : ∀ x, 0 ≤ D x) (θ : b3_HolForm E C) (hθ : θ ≠ 0)
    (hker : θ ∈ LinearMap.ker
      (RiemannRochAna_holPrincipalResidueLinear hE D))
    (w : b4c_MeroForm E C hE)
    (hw : (w : TangentBundle 𝓘(ℂ, E) C → ℂ) ≠ 0)
    (hgw : ∃ x, meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 ≠ ⊤)
    (x : C) :
    0 ≤ b4c_ord E (b4c_formRatio (hE := hE) θ w) x +
      (b4c_divForm (hE := hE) w - D) x := by
  rw [RiemannRochAna_formRatio_ord hE θ hθ w hw hgw x,
    RiemannRochAna_hol_ratio_add_canonical_sub hE θ w
      (b4c_meroForm_orderSupport_finite_aux hE w) D x]
  exact sub_nonneg.mpr
    (RiemannRochAna_holKernel_divisor_bound hE D hD θ hθ hker x)

/-- RiemannRochAna: a nonnegative-order germ has its normalized value
given by the residue of its quotient by the coordinate. -/
theorem RiemannRochAna_residue_coordinate_value
    (f : ℂ → ℂ) (hf : MeromorphicAt f 0)
    (ho : 0 ≤ meromorphicOrderAt f 0) :
    residue (fun z ↦ f z / z) 0 =
      if meromorphicOrderAt f 0 = 0 then meromorphicTrailingCoeffAt f 0 else 0 := by
  obtain ⟨g, hg, hfg⟩ :=
    RiemannRochAna_analytic_extension_of_order_nonnegative f hf ho
  have hr : residue (fun z ↦ f z / z) 0 = g 0 := by
    calc
      _ = residue (fun z ↦ g z / z) 0 := by
        apply residue_congr_nhdsNE
        filter_upwards [hfg] with z hz
        rw [hz]
      _ = g 0 := by
        simpa using residue_div_sub_pow_of_analyticAt hg 0
  rw [hr, meromorphicOrderAt_congr hfg,
    meromorphicTrailingCoeffAt_congr_nhdsNE hfg]
  have hz : meromorphicOrderAt g 0 = 0 ↔ g 0 ≠ 0 := by
    rw [hg.meromorphicOrderAt_eq, ENat.map_natCast_eq_zero,
      hg.analyticOrderAt_eq_zero]
  by_cases hg0 : g 0 = 0
  · rw [if_neg (by simpa [hz] using hg0), hg0]
  · rw [if_pos (hz.mpr hg0), hg.meromorphicTrailingCoeffAt_of_ne_zero hg0]

/-- RiemannRochAna: at finite ratio values, the constant Laurent
coefficient agrees with the normalized sphere-valued ratio. -/
theorem RiemannRochAna_holRatioValueLinear_eq
    (hE : Module.finrank ℂ E = 1) (w : b4c_MeroForm E C hE)
    (θ : b3_HolForm E C) (x : C)
    (hx : b4c_formRatio (hE := hE) θ w x ≠ OnePoint.infty) :
    RiemannRochAna_holRatioValueLinear hE w θ x =
      (b4c_formRatio (hE := hE) θ w x).elim 0 id := by
  let q : ℂ → ℂ := fun z ↦
    HurwitzPrymRR_loc hE θ x z / HurwitzPrymRR_loc hE w x z
  have hq : MeromorphicAt q 0 :=
    (RiemannRochAna_hol_loc_analytic hE θ x).meromorphicAt.div (w.property.2 x)
  have ho : 0 ≤ meromorphicOrderAt q 0 := by
    apply le_of_not_gt
    intro hn
    apply hx
    simp only [b4c_formRatio, show meromorphicOrderAt
      (fun z ↦ HurwitzPrymRR_loc hE θ x z / HurwitzPrymRR_loc hE w x z) 0 < 0
        from hn, if_true]
  change residue (fun z ↦ q z / z) 0 = _
  rw [RiemannRochAna_residue_coordinate_value q hq ho]
  change (if meromorphicOrderAt q 0 = 0 then meromorphicTrailingCoeffAt q 0 else 0) =
    (if meromorphicOrderAt q 0 < 0 then OnePoint.infty
      else if meromorphicOrderAt q 0 = 0 then
        ((meromorphicTrailingCoeffAt q 0 : ℂ) : OnePoint ℂ) else (0 : ℂ)).elim 0 id
  rw [if_neg (not_lt.mpr ho)]
  split_ifs <;> rfl

/-- RiemannRochAna: division by the fixed meromorphic form sends the
effective residue kernel into the complementary Riemann--Roch space. -/
theorem RiemannRochAna_holKernelRatio_mem
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (hD : ∀ x, 0 ≤ D x) (θ : b3_HolForm E C) (hθ : θ ≠ 0)
    (hker : θ ∈ LinearMap.ker
      (RiemannRochAna_holPrincipalResidueLinear hE D))
    (w : b4c_MeroForm E C hE)
    (hw : (w : TangentBundle 𝓘(ℂ, E) C → ℂ) ≠ 0)
    (hgw : ∃ x, meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 ≠ ⊤) :
    (fun x : {x : C // x ∉ (b4c_divForm (hE := hE) w - D).support} ↦
      (b4c_formRatio (hE := hE) θ w x.1).elim 0 id) ∈
        b4c_L (E := E) (b4c_divForm (hE := hE) w - D) := by
  let η : b4c_MeroForm E C hE :=
    ⟨θ, RiemannRochAna_hol_isMeroForm hE θ⟩
  have hη : (η : TangentBundle 𝓘(ℂ, E) C → ℂ) ≠ 0 := by
    intro hz
    apply hθ
    exact Subtype.ext hz
  obtain ⟨y, hy⟩ := RiemannRochAna_hol_nonzero_germ hE θ hθ
  have hgη : ∃ y, meromorphicOrderAt (HurwitzPrymRR_loc hE η y) 0 ≠ ⊤ :=
    ⟨y, hy.trans_ne (by simp)⟩
  let F : b4c_MeroFun E C :=
    ⟨b4c_formRatio (hE := hE) η w,
      b4c_formRatio_isMeroFun_aux hE η w hη hw hgη hgw⟩
  change (fun x : {x : C // x ∉ (b4c_divForm (hE := hE) w - D).support} ↦
      (F x.1).elim 0 id) ∈
    (b4c_L (E := E) (b4c_divForm (hE := hE) w - D) : Set _)
  rw [b4c_L_eq_restrictions_aux hE]
  by_cases hz : (fun x : {x : C // x ∉
      (b4c_divForm (hE := hE) w - D).support} ↦
        (F x.1).elim 0 id) = 0
  · exact Or.inl hz
  · right
    have hFn : ∃ x, F x ≠ (0 : ℂ) := by
      have hxn : ∃ x : {x : C // x ∉
          (b4c_divForm (hE := hE) w - D).support}, (F x.1).elim 0 id ≠ 0 := by
        by_contra hn
        apply hz
        funext x
        exact not_ne_iff.mp (not_exists.mp hn x)
      obtain ⟨x, hx⟩ := hxn
      refine ⟨x.1, ?_⟩
      intro hx0
      apply hx
      simp [hx0]
    refine ⟨F, hFn, ?_, ?_, rfl⟩
    · intro x hx
      apply RiemannRochAna_ne_infty_of_ord_nonneg hE F x
      have hb := RiemannRochAna_formRatio_canonical_bound
        hE D hD θ hθ hker w hw hgw x
      have hx0 : (b4c_divForm (hE := hE) w - D) x = 0 := by
        simpa [Finsupp.mem_support_iff] using hx
      rw [hx0, add_zero] at hb
      exact hb
    · exact RiemannRochAna_formRatio_canonical_bound
        hE D hD θ hθ hker w hw hgw

/-- RiemannRochAna: the linear Laurent-coefficient construction takes
the effective residue kernel into the complementary divisor space. -/
theorem RiemannRochAna_holRatioValueLinear_mem
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (hD : ∀ x, 0 ≤ D x) (θ : b3_HolForm E C)
    (hker : θ ∈ LinearMap.ker
      (RiemannRochAna_holPrincipalResidueLinear hE D))
    (w : b4c_MeroForm E C hE)
    (hw : (w : TangentBundle 𝓘(ℂ, E) C → ℂ) ≠ 0)
    (hgw : ∃ x, meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 ≠ ⊤) :
    (fun x : {x : C // x ∉ (b4c_divForm (hE := hE) w - D).support} ↦
      RiemannRochAna_holRatioValueLinear hE w θ x.1) ∈
        b4c_L (E := E) (b4c_divForm (hE := hE) w - D) := by
  by_cases hθ : θ = 0
  · subst θ
    have hz : (fun x : {x : C // x ∉
        (b4c_divForm (hE := hE) w - D).support} ↦
        RiemannRochAna_holRatioValueLinear hE w 0 x.1) = 0 := by
      funext x
      exact congrFun (map_zero (RiemannRochAna_holRatioValueLinear hE w)) x.1
    rw [hz]
    exact (b4c_L (E := E) (b4c_divForm (hE := hE) w - D)).zero_mem
  let η : b4c_MeroForm E C hE := ⟨θ, RiemannRochAna_hol_isMeroForm hE θ⟩
  have hη : (η : TangentBundle 𝓘(ℂ, E) C → ℂ) ≠ 0 := by
    intro hz
    exact hθ (Subtype.ext hz)
  obtain ⟨y, hy⟩ := RiemannRochAna_hol_nonzero_germ hE θ hθ
  have hgη : ∃ y, meromorphicOrderAt (HurwitzPrymRR_loc hE η y) 0 ≠ ⊤ :=
    ⟨y, hy.trans_ne (by simp)⟩
  let F : b4c_MeroFun E C := ⟨b4c_formRatio (hE := hE) η w,
    b4c_formRatio_isMeroFun_aux hE η w hη hw hgη hgw⟩
  have hfin (x : {x : C // x ∉ (b4c_divForm (hE := hE) w - D).support}) :
      b4c_formRatio (hE := hE) θ w x.1 ≠ OnePoint.infty := by
    apply RiemannRochAna_ne_infty_of_ord_nonneg hE F x.1
    have hb := RiemannRochAna_formRatio_canonical_bound
      hE D hD θ hθ hker w hw hgw x.1
    have hx0 : (b4c_divForm (hE := hE) w - D) x.1 = 0 := by
      simpa [Finsupp.mem_support_iff] using x.2
    simpa only [hx0, add_zero] using hb
  have heq : (fun x : {x : C // x ∉ (b4c_divForm (hE := hE) w - D).support} ↦
      RiemannRochAna_holRatioValueLinear hE w θ x.1) =
      fun x ↦ (b4c_formRatio (hE := hE) θ w x.1).elim 0 id := by
    funext x
    exact RiemannRochAna_holRatioValueLinear_eq hE w θ x.1 (hfin x)
  rw [heq]
  exact RiemannRochAna_holKernelRatio_mem hE D hD θ hθ hker w hw hgw

/-- RiemannRochAna: division by a fixed meromorphic differential defines
a linear map from the effective residue kernel to the complementary space. -/
noncomputable def RiemannRochAna_holKernelRatioLinear
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (hD : ∀ x, 0 ≤ D x) (w : b4c_MeroForm E C hE)
    (hw : (w : TangentBundle 𝓘(ℂ, E) C → ℂ) ≠ 0)
    (hgw : ∃ x, meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 ≠ ⊤) :
    LinearMap.ker (RiemannRochAna_holPrincipalResidueLinear hE D) →ₗ[ℂ]
      b4c_L (E := E) (b4c_divForm (hE := hE) w - D) where
  toFun θ := ⟨fun x ↦ RiemannRochAna_holRatioValueLinear hE w θ.1 x.1,
    RiemannRochAna_holRatioValueLinear_mem hE D hD θ.1 θ.2 w hw hgw⟩
  map_add' θ η := by
    apply Subtype.ext
    funext x
    exact congrFun ((RiemannRochAna_holRatioValueLinear hE w).map_add θ.1 η.1) x.1
  map_smul' a θ := by
    apply Subtype.ext
    funext x
    exact congrFun ((RiemannRochAna_holRatioValueLinear hE w).map_smul a θ.1) x.1

/-- RiemannRochAna: locally dividing a holomorphic differential by a
meromorphic differential subtracts their meromorphic orders. -/
theorem RiemannRochAna_hol_div_form_local_order
    (hE : Module.finrank ℂ E = 1) (θ : b3_HolForm E C)
    (w : b4c_MeroForm E C hE) (x : C) :
    meromorphicOrderAt (fun z : ℂ ↦
        HurwitzPrymRR_loc hE θ x z / HurwitzPrymRR_loc hE w x z) 0 =
      meromorphicOrderAt (HurwitzPrymRR_loc hE θ x) 0 -
        meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 := by
  exact meromorphicOrderAt_div
    (RiemannRochAna_hol_loc_analytic hE θ x).meromorphicAt (w.2.2 x)

/-- RiemannRochAna: a nonzero holomorphic numerator has a nonzero
constant ratio coefficient outside any prescribed finite set. -/
theorem RiemannRochAna_holRatioValue_nonzero_off_finset
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (θ : b3_HolForm E C) (hθ : θ ≠ 0)
    (w : b4c_MeroForm E C hE)
    (hw : (w : TangentBundle 𝓘(ℂ, E) C → ℂ) ≠ 0)
    (hgw : ∃ x, meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 ≠ ⊤)
    (S : Finset C) :
    ∃ x, x ∉ S ∧ RiemannRochAna_holRatioValueLinear hE w θ x ≠ 0 := by
  classical
  let η : b4c_MeroForm E C hE := ⟨θ, RiemannRochAna_hol_isMeroForm hE θ⟩
  let A := b4c_divForm (hE := hE) η
  let B := b4c_divForm (hE := hE) w
  let T := S ∪ (A.support ∪ B.support)
  obtain ⟨y, hy⟩ := hgw
  obtain ⟨x, hx⟩ := RiemannRochAna_exists_unmarked hE y (fun i : T ↦ i.1)
  have hxT : x ∉ T := by
    intro hxT
    exact hx ⟨⟨x, hxT⟩, rfl⟩
  have hxS : x ∉ S := fun h ↦ hxT (Finset.mem_union_left _ h)
  have hxA : x ∉ A.support := fun h ↦
    hxT (Finset.mem_union_right _ (Finset.mem_union_left _ h))
  have hxB : x ∉ B.support := fun h ↦
    hxT (Finset.mem_union_right _ (Finset.mem_union_right _ h))
  have ha0 : A x = 0 := by simpa [Finsupp.mem_support_iff] using hxA
  have hb0 : B x = 0 := by simpa [Finsupp.mem_support_iff] using hxB
  have ha : meromorphicOrderAt (HurwitzPrymRR_loc hE θ x) 0 = 0 := by
    have hh := RiemannRochAna_coe_divForm_apply hE η
      (b4c_meroForm_orderSupport_finite_aux hE η) x
      (RiemannRochAna_hol_order_ne_top hE θ hθ x)
    change ((A x : ℤ) : WithTop ℤ) = _ at hh
    rw [ha0] at hh
    exact hh.symm
  have hb : meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 = 0 := by
    have hh := RiemannRochAna_coe_divForm_apply hE w
      (b4c_meroForm_orderSupport_finite_aux hE w) x
      (RiemannRochAna_meroForm_order_ne_top hE w hw ⟨y, hy⟩ x)
    change ((B x : ℤ) : WithTop ℤ) = _ at hh
    rw [hb0] at hh
    exact hh.symm
  let q : ℂ → ℂ := fun z ↦
    HurwitzPrymRR_loc hE θ x z / HurwitzPrymRR_loc hE w x z
  have hq : MeromorphicAt q 0 :=
    (RiemannRochAna_hol_loc_analytic hE θ x).meromorphicAt.div (w.property.2 x)
  have hqo : meromorphicOrderAt q 0 = 0 := by
    change meromorphicOrderAt (fun z ↦
      HurwitzPrymRR_loc hE θ x z / HurwitzPrymRR_loc hE w x z) 0 = 0
    rw [RiemannRochAna_hol_div_form_local_order, ha, hb]
    simp
  refine ⟨x, hxS, ?_⟩
  change residue (fun z ↦ q z / z) 0 ≠ 0
  rw [RiemannRochAna_residue_coordinate_value q hq (le_of_eq hqo.symm), if_pos hqo]
  exact hq.meromorphicTrailingCoeffAt_ne_zero (by rw [hqo]; simp)

/-- RiemannRochAna: dividing holomorphic forms by the fixed meromorphic
differential is injective on the effective residue kernel. -/
theorem RiemannRochAna_holKernelRatioLinear_injective
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (hD : ∀ x, 0 ≤ D x) (w : b4c_MeroForm E C hE)
    (hw : (w : TangentBundle 𝓘(ℂ, E) C → ℂ) ≠ 0)
    (hgw : ∃ x, meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 ≠ ⊤) :
    Function.Injective (RiemannRochAna_holKernelRatioLinear hE D hD w hw hgw) := by
  apply LinearMap.ker_eq_bot.mp
  apply LinearMap.ker_eq_bot'.mpr
  intro θ hzero
  apply Subtype.ext
  change θ.1 = 0
  by_contra hθ
  obtain ⟨x, hx, hne⟩ := RiemannRochAna_holRatioValue_nonzero_off_finset
    hE θ.1 hθ w hw hgw (b4c_divForm (hE := hE) w - D).support
  apply hne
  exact congrArg (fun f : b4c_L (E := E) (b4c_divForm (hE := hE) w - D) ↦
    (f : {x : C // x ∉ (b4c_divForm (hE := hE) w - D).support} → ℂ) ⟨x, hx⟩)
    hzero

/-- RiemannRochAna: local analytic differential extensions of common
punctured fibre data agree near each centre. -/
theorem RiemannRochAna_glue_differential_germs [T1Space C]
    (hE : Module.finrank ℂ E = 1)
    (f : TangentBundle 𝓘(ℂ, E) C → ℂ)
    (η : C → TangentBundle 𝓘(ℂ, E) C → ℂ)
    (hη : ∀ x, ∀ᶠ y in 𝓝 x, ∀ v : E,
      ContMDiffAt (𝓘(ℂ, E).prod 𝓘(ℂ, E)) 𝓘(ℂ, ℂ) ω (η x) ⟨y, v⟩)
    (hg : ∀ x, ∀ᶠ y in 𝓝[≠] x, ∀ v : E, η x ⟨y, v⟩ = f ⟨y, v⟩) :
    ∀ x, ∀ᶠ y in 𝓝 x, ∀ v : E, η y ⟨y, v⟩ = η x ⟨y, v⟩ := by
  intro x
  have he : ∀ᶠ z in 𝓝 x, z ≠ x → ∀ v : E, η x ⟨z, v⟩ = f ⟨z, v⟩ := by
    simpa only [eventually_nhdsWithin_iff, mem_compl_iff, mem_singleton_iff] using hg x
  filter_upwards [he.eventually_nhds, hη x] with y hy hya
  intro v
  by_cases hyx : y = x
  · subst y; rfl
  have hxy : ∀ᶠ z in 𝓝 y, ∀ u : E, η x ⟨z, u⟩ = f ⟨z, u⟩ := by
    filter_upwards [hy, eventually_ne_nhds hyx] with z hz hzx
    exact hz hzx
  have hsame : ∀ᶠ z in 𝓝[≠] y, ∀ u : E, η y ⟨z, u⟩ = η x ⟨z, u⟩ := by
    filter_upwards [hg y, hxy.filter_mono nhdsWithin_le_nhds] with z hz hzx u
    exact (hz u).trans (hzx u).symm
  exact RiemannRochAna_fibre_eq_of_punctured_germ hE (η y) (η x) y v
    (((hη y).self_of_nhds v).continuousAt) ((hya v).continuousAt) hsame

/-- RiemannRochAna: compatible analytic local differential extensions
assemble into a global holomorphic differential. -/
theorem RiemannRochAna_holForm_of_punctured_extensions [T1Space C]
    (hE : Module.finrank ℂ E = 1)
    (f : TangentBundle 𝓘(ℂ, E) C → ℂ)
    (h : ∀ x, ∃ η : TangentBundle 𝓘(ℂ, E) C → ℂ,
      HurwitzPrymRR_IsLinear η ∧
      (∀ᶠ y in 𝓝 x, ∀ v : E,
        ContMDiffAt 𝓘(ℂ, E).tangent 𝓘(ℂ, ℂ) ω η ⟨y, v⟩) ∧
      ∀ᶠ y in 𝓝[≠] x, ∀ v : E, η ⟨y, v⟩ = f ⟨y, v⟩) :
    ∃ θ : b3_HolForm E C,
      ∀ x, ∀ᶠ y in 𝓝[≠] x, ∀ v : E, θ.1 ⟨y, v⟩ = f ⟨y, v⟩ := by
  choose η hlin hhol hg using h
  have hglue := RiemannRochAna_glue_differential_germs hE f η hhol hg
  let Θ : TangentBundle 𝓘(ℂ, E) C → ℂ := fun p ↦ η p.proj p
  have hΘ : Θ ∈ b3_HolForm E C := by
    refine ⟨?_, ?_⟩
    · intro p
      have hp : ContMDiffAt 𝓘(ℂ, E).tangent 𝓘(ℂ, ℂ) ω (η p.proj) p :=
        (hhol p.proj).self_of_nhds p.2
      apply hp.congr_of_eventuallyEq
      have hproj := (FiberBundle.continuous_proj E
        (TangentSpace 𝓘(ℂ, E) : C → Type)).continuousAt (x := p)
      filter_upwards [hproj.preimage_mem_nhds (hglue p.proj)] with q hq
      exact hq q.2
    · intro y a v u
      exact hlin y y a v u
  refine ⟨⟨Θ, hΘ⟩, ?_⟩
  intro x
  filter_upwards [(hglue x).filter_mono nhdsWithin_le_nhds, hg x] with y hy hgy
  intro v
  exact (hy v).trans (hgy v)

/-- RiemannRochAna: multiplying a function bounded by the complementary
divisor by the fixed differential gives the required local form order. -/
theorem RiemannRochAna_canonicalProduct_local_order_bound
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (w : b4c_MeroForm E C hE)
    (hw : (w : TangentBundle 𝓘(ℂ, E) C → ℂ) ≠ 0)
    (hgw : ∃ x, meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 ≠ ⊤)
    (F : b4c_MeroFun E C) (hFn : ∃ x, F x ≠ (0 : ℂ))
    (hbound : ∀ x, 0 ≤ b4c_ord E F x + (b4c_divForm (hE := hE) w - D) x)
    (x : C) :
    (D x : WithTop ℤ) ≤ meromorphicOrderAt (fun z : ℂ ↦
      RiemannRochAna_functionLocal hE F x z * HurwitzPrymRR_loc hE w x z) 0 := by
  have hf : MeromorphicAt (RiemannRochAna_functionLocal hE F x) 0 :=
    RiemannRochAna_sphere_map_meromorphic hE F F.property.1 x
  change (D x : WithTop ℤ) ≤ meromorphicOrderAt
    (RiemannRochAna_functionLocal hE F x * HurwitzPrymRR_loc hE w x) 0
  rw [meromorphicOrderAt_mul hf (w.property.2 x),
    ← RiemannRochAna_ord_eq_local hE F hFn x,
    ← RiemannRochAna_coe_divForm_apply hE w
      (b4c_meroForm_orderSupport_finite_aux hE w) x
      (RiemannRochAna_meroForm_order_ne_top hE w hw hgw x)]
  have hb : D x ≤ b4c_ord E F x + b4c_divForm (hE := hE) w x := by
    have hb := hbound x
    rw [Finsupp.sub_apply] at hb
    omega
  exact_mod_cast hb

/-- RiemannRochAna: effective complementary bounds give analytic local
product extensions with the prescribed vanishing jets. -/
theorem RiemannRochAna_canonicalProduct_analytic_extension
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ) (hD : ∀ x, 0 ≤ D x)
    (w : b4c_MeroForm E C hE)
    (hw : (w : TangentBundle 𝓘(ℂ, E) C → ℂ) ≠ 0)
    (hgw : ∃ x, meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 ≠ ⊤)
    (F : b4c_MeroFun E C) (hFn : ∃ x, F x ≠ (0 : ℂ))
    (hbound : ∀ x, 0 ≤ b4c_ord E F x + (b4c_divForm (hE := hE) w - D) x)
    (x : C) :
    ∃ g : ℂ → ℂ, AnalyticAt ℂ g 0 ∧
      (fun z : ℂ ↦ RiemannRochAna_functionLocal hE F x z *
        HurwitzPrymRR_loc hE w x z) =ᶠ[𝓝[≠] 0] g ∧
      ∀ n : ℕ, n < (D x).toNat → iteratedDeriv n g 0 = 0 := by
  let f : ℂ → ℂ := fun z ↦ RiemannRochAna_functionLocal hE F x z *
    HurwitzPrymRR_loc hE w x z
  have hf : MeromorphicAt f 0 :=
    (RiemannRochAna_sphere_map_meromorphic hE F F.property.1 x).mul (w.property.2 x)
  have ho : (D x : WithTop ℤ) ≤ meromorphicOrderAt f 0 :=
    RiemannRochAna_canonicalProduct_local_order_bound hE D w hw hgw F hFn hbound x
  have hn : (0 : WithTop ℤ) ≤ (D x : WithTop ℤ) := by exact_mod_cast hD x
  obtain ⟨g, hg, hfg⟩ :=
    RiemannRochAna_analytic_extension_of_order_nonnegative f hf (hn.trans ho)
  refine ⟨g, hg, hfg, ?_⟩
  apply (natCast_le_analyticOrderAt_iff_iteratedDeriv_eq_zero hg).mp
  apply (RiemannRochAna_nat_le_analyticOrder_iff_le_meromorphicOrder
    g hg (D x).toNat).mpr
  rw [Int.toNat_of_nonneg (hD x)]
  rwa [meromorphicOrderAt_congr hfg] at ho

/-- RiemannRochAna: a scalar coefficient in a centered chart determines
a fibrewise linear differential on its chart domain. -/
noncomputable def RiemannRochAna_chartDifferential
    (hE : Module.finrank ℂ E = 1) (x : C) (g : ℂ → ℂ) :
    TangentBundle 𝓘(ℂ, E) C → ℂ :=
  fun p ↦ g (RiemannRochAna_coordinate hE x p.proj) *
    (b4cov_lineEquiv hE).symm
      ((trivializationAt E (TangentSpace 𝓘(ℂ, E)) x).linearMapAt ℂ p.proj p.2)

/-- RiemannRochAna: the differential constructed in a chart is linear
on every tangent fibre. -/
theorem RiemannRochAna_chartDifferential_linear
    (hE : Module.finrank ℂ E = 1) (x : C) (g : ℂ → ℂ) :
    HurwitzPrymRR_IsLinear (RiemannRochAna_chartDifferential hE x g) := by
  intro y a v w
  simp only [RiemannRochAna_chartDifferential, map_add, map_smul, smul_eq_mul]
  ring

/-- RiemannRochAna: agreement of centered scalar germs gives agreement
of the reconstructed differentials on punctured fibres. -/
theorem RiemannRochAna_chartDifferential_germ
    (hE : Module.finrank ℂ E = 1) (x : C) (g : ℂ → ℂ)
    (θ : TangentBundle 𝓘(ℂ, E) C → ℂ) (hθ : HurwitzPrymRR_IsLinear θ)
    (hg : HurwitzPrymRR_loc hE θ x =ᶠ[𝓝[≠] 0] g) :
    ∀ᶠ y in 𝓝[≠] x, ∀ v : E,
      RiemannRochAna_chartDifferential hE x g ⟨y, v⟩ = θ ⟨y, v⟩ := by
  let L := b4cov_lineEquiv hE
  let z := RiemannRochAna_coordinate hE x
  let φ := extChartAt 𝓘(ℂ, E) x
  have hz : ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω z x :=
    RiemannRochAna_coordinate_analytic hE x x (mem_extChartAt_source x)
  have hz0 : z x = 0 := RiemannRochAna_coordinate_self hE x
  have hs : ∀ᶠ y in 𝓝 x, y ∈ φ.source :=
    (isOpen_extChartAt_source x).mem_nhds (mem_extChartAt_source x)
  have ht : Tendsto z (𝓝[≠] x) (𝓝[≠] (0 : ℂ)) := by
    refine tendsto_nhdsWithin_iff.mpr ⟨?_, ?_⟩
    · simpa only [hz0] using hz.continuousAt.tendsto.mono_left nhdsWithin_le_nhds
    · filter_upwards [hs.filter_mono nhdsWithin_le_nhds, self_mem_nhdsWithin] with y hys hyx
      exact RiemannRochAna_coordinate_ne hE x y hys hyx
  filter_upwards [ht hg, hs.filter_mono nhdsWithin_le_nhds] with y hy hys
  have he : φ x + L (z y) = φ y := by
    dsimp only [z, RiemannRochAna_coordinate]
    rw [L.apply_symm_apply]
    abel
  have hcoef : θ ⟨y, b4cov_vec x y (L 1)⟩ = g (z y) := by
    change θ ⟨φ.symm (φ x + L (z y)),
      b4cov_vec x (φ.symm (φ x + L (z y))) (L 1)⟩ = g (z y) at hy
    rw [he, φ.left_inv hys] at hy
    exact hy
  intro v
  let u := (trivializationAt E (TangentSpace 𝓘(ℂ, E)) x ⟨y, v⟩).2
  have hu : u = L.symm u • L 1 := by
    rw [← map_smul, smul_eq_mul, mul_one]
    exact (L.apply_symm_apply u).symm
  have hv : L.symm u • b4cov_vec x y (L 1) = v := by
    rw [← b4cov_vec_smul x y hys, ← hu]
    exact b4cov_vec_triv x y hys v
  dsimp only [RiemannRochAna_chartDifferential]
  rw [Bundle.Trivialization.linearMapAt_apply, if_pos (b4cov_mem_baseSet x y hys)]
  change g (z y) * L.symm u = θ ⟨y, v⟩
  rw [← hcoef, mul_comm, ← hθ.smul y (L.symm u) (b4cov_vec x y (L 1)), hv]

/-- RiemannRochAna: an analytic chart coefficient gives an analytic
differential at every vector over a point of that chart. -/
theorem RiemannRochAna_chartDifferential_analyticAt
    (hE : Module.finrank ℂ E = 1) (x y : C) (g : ℂ → ℂ)
    (hy : y ∈ (extChartAt 𝓘(ℂ, E) x).source)
    (hg : AnalyticAt ℂ g (RiemannRochAna_coordinate hE x y)) (v : E) :
    ContMDiffAt 𝓘(ℂ, E).tangent 𝓘(ℂ, ℂ) ω
      (RiemannRochAna_chartDifferential hE x g) ⟨y, v⟩ := by
  let e := trivializationAt E (TangentSpace 𝓘(ℂ, E)) x
  let p : TangentBundle 𝓘(ℂ, E) C := ⟨y, v⟩
  have hp : p ∈ e.source := e.mem_source.mpr (b4cov_mem_baseSet x y hy)
  have heq : RiemannRochAna_chartDifferential hE x g =ᶠ[𝓝 p]
      fun q ↦ g (RiemannRochAna_coordinate hE x q.proj) *
        (b4cov_lineEquiv hE).symm (e q).2 := by
    filter_upwards [e.open_source.mem_nhds hp] with q hq
    dsimp only [RiemannRochAna_chartDifferential]
    rw [Bundle.Trivialization.linearMapAt_apply, if_pos (e.mem_source.mp hq)]
  have hcoord : ContMDiffAt 𝓘(ℂ, E).tangent 𝓘(ℂ, ℂ) ω
      (fun q : TangentBundle 𝓘(ℂ, E) C ↦ RiemannRochAna_coordinate hE x q.proj) p :=
    ContMDiffAt.comp (g := RiemannRochAna_coordinate hE x)
      (f := fun q : TangentBundle 𝓘(ℂ, E) C ↦ q.proj) p
      (RiemannRochAna_coordinate_analytic hE x y hy)
      (Bundle.contMDiffAt_proj (TangentSpace 𝓘(ℂ, E)))
  have hcoef := hg.contDiffAt.contMDiffAt.comp p hcoord
  have ht := (e.contMDiffOn (IB := 𝓘(ℂ, E)) (n := ω)).contMDiffAt
    (e.open_source.mem_nhds hp)
  have hv : ContMDiffAt 𝓘(ℂ, E).tangent 𝓘(ℂ, ℂ) ω
      (fun q : TangentBundle 𝓘(ℂ, E) C ↦ (b4cov_lineEquiv hE).symm (e q).2) p :=
    (b4cov_lineEquiv hE).symm.contDiff.contMDiff.contMDiffAt.comp p
      (contMDiffAt_snd.comp p ht)
  exact (hcoef.mul hv).congr_of_eventuallyEq heq

/-- RiemannRochAna: bounded canonical products have analytic differential
extensions on a neighborhood of each base point. -/
theorem RiemannRochAna_canonicalProduct_local_differential
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ) (hD : ∀ x, 0 ≤ D x)
    (w : b4c_MeroForm E C hE)
    (hw : (w : TangentBundle 𝓘(ℂ, E) C → ℂ) ≠ 0)
    (hgw : ∃ x, meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 ≠ ⊤)
    (F : b4c_MeroFun E C) (hFn : ∃ x, F x ≠ (0 : ℂ))
    (hbound : ∀ x, 0 ≤ b4c_ord E F x + (b4c_divForm (hE := hE) w - D) x)
    (x : C) :
    ∃ η : TangentBundle 𝓘(ℂ, E) C → ℂ, HurwitzPrymRR_IsLinear η ∧
      (∀ᶠ y in 𝓝 x, ∀ v : E, ContMDiffAt 𝓘(ℂ, E).tangent 𝓘(ℂ, ℂ) ω η ⟨y, v⟩) ∧
      ∀ᶠ y in 𝓝[≠] x, ∀ v : E, η ⟨y, v⟩ = (F y).elim 0 id * w ⟨y, v⟩ := by
  obtain ⟨g, hg, hfg, -⟩ :=
    RiemannRochAna_canonicalProduct_analytic_extension hE D hD w hw hgw F hFn hbound x
  let θ : TangentBundle 𝓘(ℂ, E) C → ℂ := fun p ↦ (F p.proj).elim 0 id * w p
  have hθ : HurwitzPrymRR_IsLinear θ := by
    intro y a v u
    dsimp only [θ]
    rw [w.property.1 y a v u]
    ring
  change HurwitzPrymRR_loc hE θ x =ᶠ[𝓝[≠] 0] g at hfg
  refine ⟨RiemannRochAna_chartDifferential hE x g,
    RiemannRochAna_chartDifferential_linear hE x g, ?_,
    RiemannRochAna_chartDifferential_germ hE x g θ hθ hfg⟩
  have ht : Tendsto (RiemannRochAna_coordinate hE x) (𝓝 x) (𝓝 0) := by
    simpa only [RiemannRochAna_coordinate_self] using
      (RiemannRochAna_coordinate_analytic hE x x (mem_extChartAt_source x)).continuousAt.tendsto
  filter_upwards [ht hg.eventually_analyticAt,
    extChartAt_source_mem_nhds (I := 𝓘(ℂ, E)) x] with y hgy hy
  intro v
  exact RiemannRochAna_chartDifferential_analyticAt hE x y g hy hgy v

/-- RiemannRochAna: effective complementary divisor bounds give a global
holomorphic extension of the canonical product. -/
theorem RiemannRochAna_canonicalProduct_holForm
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ) (hD : ∀ x, 0 ≤ D x)
    (w : b4c_MeroForm E C hE)
    (hw : (w : TangentBundle 𝓘(ℂ, E) C → ℂ) ≠ 0)
    (hgw : ∃ x, meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 ≠ ⊤)
    (F : b4c_MeroFun E C) (hFn : ∃ x, F x ≠ (0 : ℂ))
    (hbound : ∀ x, 0 ≤ b4c_ord E F x + (b4c_divForm (hE := hE) w - D) x) :
    ∃ θ : b3_HolForm E C, ∀ x, ∀ᶠ y in 𝓝[≠] x, ∀ v : E,
      θ.1 ⟨y, v⟩ = (F y).elim 0 id * w ⟨y, v⟩ := by
  exact RiemannRochAna_holForm_of_punctured_extensions hE
    (fun p ↦ (F p.proj).elim 0 id * w p)
    (RiemannRochAna_canonicalProduct_local_differential hE D hD w hw hgw F hFn hbound)

/-- RiemannRochAna: punctured fibre agreement induces punctured agreement
of the scalar coefficients in centered coordinates. -/
theorem RiemannRochAna_loc_eq_of_punctured_fibres
    (hE : Module.finrank ℂ E = 1)
    (η θ : TangentBundle 𝓘(ℂ, E) C → ℂ) (x : C)
    (hg : ∀ᶠ y in 𝓝[≠] x, ∀ v : E, η ⟨y, v⟩ = θ ⟨y, v⟩) :
    HurwitzPrymRR_loc hE η x =ᶠ[𝓝[≠] 0] HurwitzPrymRR_loc hE θ x := by
  filter_upwards [RiemannRochAna_inverse_coordinate_punctured hE x hg] with z hz
  exact hz _

/-- RiemannRochAna: the global extension of a bounded canonical product
lies in the effective principal residue kernel. -/
theorem RiemannRochAna_canonicalProduct_kernel
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ) (hD : ∀ x, 0 ≤ D x)
    (w : b4c_MeroForm E C hE)
    (hw : (w : TangentBundle 𝓘(ℂ, E) C → ℂ) ≠ 0)
    (hgw : ∃ x, meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 ≠ ⊤)
    (F : b4c_MeroFun E C) (hFn : ∃ x, F x ≠ (0 : ℂ))
    (hbound : ∀ x, 0 ≤ b4c_ord E F x + (b4c_divForm (hE := hE) w - D) x) :
    ∃ θ : b3_HolForm E C,
      θ ∈ LinearMap.ker (RiemannRochAna_holPrincipalResidueLinear hE D) ∧
      ∀ x, HurwitzPrymRR_loc hE θ x =ᶠ[𝓝[≠] 0]
        fun z ↦ RiemannRochAna_functionLocal hE F x z * HurwitzPrymRR_loc hE w x z := by
  obtain ⟨θ, hθ⟩ := RiemannRochAna_canonicalProduct_holForm hE D hD w hw hgw F hFn hbound
  have hloc (x : C) : HurwitzPrymRR_loc hE θ x =ᶠ[𝓝[≠] 0]
      fun z ↦ RiemannRochAna_functionLocal hE F x z * HurwitzPrymRR_loc hE w x z :=
    RiemannRochAna_loc_eq_of_punctured_fibres hE θ
      (fun p ↦ (F p.proj).elim 0 id * w p) x (hθ x)
  refine ⟨θ, ?_, hloc⟩
  apply (RiemannRochAna_mem_holPrincipalResidueKernel_iff_meromorphicOrder hE D hD θ).mpr
  intro i
  rw [meromorphicOrderAt_congr (hloc i.1)]
  exact RiemannRochAna_canonicalProduct_local_order_bound hE D w hw hgw F hFn hbound i.1

/-- RiemannRochAna: division by a finite-order canonical germ recovers
the scalar factor of a product germ. -/
theorem RiemannRochAna_canonicalProduct_ratio_germ
    (hE : Module.finrank ℂ E = 1) (w : b4c_MeroForm E C hE)
    (θ : b3_HolForm E C) (F : b4c_MeroFun E C) (x : C)
    (hw : meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 ≠ ⊤)
    (hg : HurwitzPrymRR_loc hE θ x =ᶠ[𝓝[≠] 0]
      fun z ↦ RiemannRochAna_functionLocal hE F x z * HurwitzPrymRR_loc hE w x z) :
    (fun z ↦ HurwitzPrymRR_loc hE θ x z / HurwitzPrymRR_loc hE w x z)
      =ᶠ[𝓝[≠] 0] RiemannRochAna_functionLocal hE F x := by
  filter_upwards [hg,
    (meromorphicOrderAt_ne_top_iff_eventually_ne_zero (w.property.2 x)).mp hw] with z hz hn
  rw [hz, mul_div_cancel_right₀ _ hn]

/-- RiemannRochAna: centered scalar representatives are analytic at
points where the meromorphic function is finite. -/
theorem RiemannRochAna_functionLocal_analytic_of_finite
    (hE : Module.finrank ℂ E = 1) (F : b4c_MeroFun E C) (x : C)
    (hx : F x ≠ OnePoint.infty) :
    AnalyticAt ℂ (RiemannRochAna_functionLocal hE F x) 0 := by
  let A : ℂ → C := fun t ↦ (extChartAt 𝓘(ℂ, E) x).symm
    (extChartAt 𝓘(ℂ, E) x x + b4cov_lineEquiv hE t)
  have hA0 : A 0 = x := by
    simp only [A, map_zero, add_zero]
    exact (extChartAt 𝓘(ℂ, E) x).left_inv (mem_extChartAt_source x)
  have hF : ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω
      (fun y ↦ (F y).elim 0 id) (A 0) := by
    rw [hA0]
    exact RiemannRochAna_finiteValue_analytic F F.property.1 x hx
  have hc : ContMDiffAt 𝓘(ℂ, ℂ) 𝓘(ℂ, ℂ) ω
      (RiemannRochAna_functionLocal hE F x) 0 :=
    hF.comp 0 (RiemannRochAna_centered_symm_analytic hE x)
  exact (contMDiffAt_iff_contDiffAt.mp hc).analyticAt

/-- RiemannRochAna: the linear ratio value of a canonical product
recovers its scalar factor at every finite point. -/
theorem RiemannRochAna_canonicalProduct_ratio_value
    (hE : Module.finrank ℂ E = 1) (w : b4c_MeroForm E C hE)
    (θ : b3_HolForm E C) (F : b4c_MeroFun E C) (x : C)
    (hw : meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 ≠ ⊤)
    (hx : F x ≠ OnePoint.infty)
    (hg : HurwitzPrymRR_loc hE θ x =ᶠ[𝓝[≠] 0]
      fun z ↦ RiemannRochAna_functionLocal hE F x z * HurwitzPrymRR_loc hE w x z) :
    RiemannRochAna_holRatioValueLinear hE w θ x = (F x).elim 0 id := by
  have hr := RiemannRochAna_canonicalProduct_ratio_germ hE w θ F x hw hg
  change residue (fun z : ℂ ↦
    (HurwitzPrymRR_loc hE θ x z / HurwitzPrymRR_loc hE w x z) / z) 0 = _
  calc
    _ = residue (fun z ↦ RiemannRochAna_functionLocal hE F x z / z) 0 := by
      apply residue_congr_nhdsNE
      filter_upwards [hr] with z hz
      rw [hz]
    _ = RiemannRochAna_functionLocal hE F x 0 := by
      simpa using residue_div_sub_pow_of_analyticAt
        (RiemannRochAna_functionLocal_analytic_of_finite hE F x hx) 0
    _ = (F x).elim 0 id := by
      simp only [RiemannRochAna_functionLocal, map_zero, add_zero]
      rw [(extChartAt 𝓘(ℂ, E) x).left_inv (mem_extChartAt_source x)]

/-- RiemannRochAna: the canonical ratio map onto the effective
complementary divisor space is surjective. -/
theorem RiemannRochAna_holKernelRatioLinear_surjective
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ) (hD : ∀ x, 0 ≤ D x)
    (w : b4c_MeroForm E C hE)
    (hw : (w : TangentBundle 𝓘(ℂ, E) C → ℂ) ≠ 0)
    (hgw : ∃ x, meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 ≠ ⊤) :
    Function.Surjective (RiemannRochAna_holKernelRatioLinear hE D hD w hw hgw) := by
  intro g
  let B := b4c_divForm (hE := hE) w - D
  have hg : ((g : {x : C // x ∉ B.support} → ℂ) = 0) ∨
      ∃ F : b4c_MeroFun E C,
        (∃ x, F x ≠ (0 : ℂ)) ∧
        (∀ x, x ∉ B.support → F x ≠ OnePoint.infty) ∧
        (∀ x, 0 ≤ b4c_ord E F x + B x) ∧
        (g : {x : C // x ∉ B.support} → ℂ) = fun x ↦ (F x.1).elim 0 id := by
    have hm : (g : {x : C // x ∉ B.support} → ℂ) ∈
        (b4c_L (E := E) B : Set ({x : C // x ∉ B.support} → ℂ)) := g.property
    rw [b4c_L_eq_restrictions_aux hE B] at hm
    exact hm
  rcases hg with hg0 | ⟨F, hFn, hfin, hbound, hgF⟩
  · refine ⟨0, ?_⟩
    rw [map_zero]
    exact Subtype.ext hg0.symm
  · obtain ⟨θ, hker, hθ⟩ :=
      RiemannRochAna_canonicalProduct_kernel hE D hD w hw hgw F hFn hbound
    refine ⟨⟨θ, hker⟩, ?_⟩
    apply Subtype.ext
    funext x
    change RiemannRochAna_holRatioValueLinear hE w θ x.1 =
      (g : {x : C // x ∉ B.support} → ℂ) x
    rw [hgF]
    exact RiemannRochAna_canonicalProduct_ratio_value hE w θ F x.1
      (RiemannRochAna_meroForm_order_ne_top hE w hw hgw x.1)
      (hfin x.1 x.2) (hθ x.1)

/-- RiemannRochAna: the effective holomorphic residue kernel has the
dimension of the complementary Riemann--Roch space. -/
theorem RiemannRochAna_holPrincipalResidueKernel_finrank
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ) (hD : ∀ x, 0 ≤ D x)
    (w : b4c_MeroForm E C hE)
    (hw : (w : TangentBundle 𝓘(ℂ, E) C → ℂ) ≠ 0)
    (hgw : ∃ x, meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 ≠ ⊤) :
    Module.finrank ℂ (LinearMap.ker (RiemannRochAna_holPrincipalResidueLinear hE D)) =
      Module.finrank ℂ (b4c_L (E := E) (b4c_divForm (hE := hE) w - D)) := by
  exact (LinearEquiv.ofBijective (RiemannRochAna_holKernelRatioLinear hE D hD w hw hgw)
    ⟨RiemannRochAna_holKernelRatioLinear_injective hE D hD w hw hgw,
      RiemannRochAna_holKernelRatioLinear_surjective hE D hD w hw hgw⟩).finrank_eq

/-- RiemannRochAna: for an effective divisor the principal residue rank
and the complementary space dimension add to the holomorphic dimension. -/
theorem RiemannRochAna_principalResidue_rank_add_complement
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ) (hD : ∀ x, 0 ≤ D x)
    (w : b4c_MeroForm E C hE)
    (hw : (w : TangentBundle 𝓘(ℂ, E) C → ℂ) ≠ 0)
    (hgw : ∃ x, meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 ≠ ⊤) :
    Module.finrank ℂ (LinearMap.range (RiemannRochAna_principalResidueLinear hE D)) +
      Module.finrank ℂ (b4c_L (E := E) (b4c_divForm (hE := hE) w - D)) =
      Module.finrank ℂ (b3_HolForm E C) := by
  rw [← RiemannRochAna_holPrincipalResidueKernel_finrank hE D hD w hw hgw]
  exact RiemannRochAna_principalResidue_rank_add_holKernel hE D

/-- RiemannRochAna: the effective principal-obstruction cokernel has
the dimension of the complementary Riemann--Roch space. -/
theorem RiemannRochAna_principalClass_cokernel_eq_complement_finrank
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ) (hD : ∀ x, 0 ≤ D x)
    (w : b4c_MeroForm E C hE)
    (hw : (w : TangentBundle 𝓘(ℂ, E) C → ℂ) ≠ 0)
    (hgw : ∃ x, meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 ≠ ⊤) :
    Module.finrank ℂ (b4c_Dolbeault01 E C ⧸
        LinearMap.range (RiemannRochAna_principalClassLinear hE D)) =
      Module.finrank ℂ (b4c_L (E := E) (b4c_divForm (hE := hE) w - D)) := by
  have hk := congrArg (fun S : Submodule ℂ (RiemannRochAna_PrincipalData D) ↦
      Module.finrank ℂ S)
    (RiemannRochAna_principalClass_kernel_eq_residueKernel_effective
      hE D hD (Classical.choose hgw))
  have hc := (RiemannRochAna_principalClassLinear hE D).finrank_range_add_finrank_ker
  have hr := (RiemannRochAna_principalResidueLinear hE D).finrank_range_add_finrank_ker
  have heq : Module.finrank ℂ (LinearMap.range (RiemannRochAna_principalClassLinear hE D)) =
      Module.finrank ℂ (LinearMap.range (RiemannRochAna_principalResidueLinear hE D)) := by
    omega
  have hco := RiemannRochAna_principalClass_cokernel_finrank hE D
  rw [heq] at hco
  have hs := congrArg (fun n : ℕ ↦ (n : ℤ))
    (RiemannRochAna_principalResidue_rank_add_complement hE D hD w hw hgw)
  push_cast at hs
  omega

/-- RiemannRochAna: the Riemann--Roch dimension identity for effective divisors. -/
theorem RiemannRochAna_riemannRoch_effective
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ) (hD : ∀ x, 0 ≤ D x)
    (w : b4c_MeroForm E C hE)
    (hw : (w : TangentBundle 𝓘(ℂ, E) C → ℂ) ≠ 0)
    (hgw : ∃ x, meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 ≠ ⊤) :
    (Module.finrank ℂ (b4c_L (E := E) D) : ℤ) - Module.finrank ℂ
      (b4c_L (E := E) (b4c_divForm (hE := hE) w - D)) =
        b4c_deg D - Module.finrank ℂ (b3_HolForm E C) + 1 := by
  letI : Nonempty C := ⟨Classical.choose hgw⟩
  have hi := RiemannRochAna_effective_L_index hE D hD
  rwa [RiemannRochAna_principalClass_cokernel_eq_complement_finrank hE D hD w hw hgw] at hi

/-- RiemannRochRR: an effective canonical divisor has the expected degree,
by applying the effective identity at it and at zero. -/
theorem RiemannRochRR_degree_of_effective_canonical
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (w : b4c_MeroForm E C hE)
    (hw : (w : TangentBundle 𝓘(ℂ, E) C → ℂ) ≠ 0)
    (hgw : ∃ x, meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 ≠ ⊤)
    (hK : ∀ x, 0 ≤ b4c_divForm (hE := hE) w x) :
    b4c_deg (b4c_divForm (hE := hE) w) =
      2 * (Module.finrank ℂ (b3_HolForm E C) : ℤ) - 2 := by
  let K := b4c_divForm (hE := hE) w
  have ha : (Module.finrank ℂ (b4c_L (E := E) K) : ℤ) -
      Module.finrank ℂ (b4c_L (E := E) (K - K)) =
      b4c_deg K - Module.finrank ℂ (b3_HolForm E C) + 1 :=
    RiemannRochAna_riemannRoch_effective hE K hK w hw hgw
  have hb : (Module.finrank ℂ (b4c_L (E := E) (0 : C →₀ ℤ)) : ℤ) -
      Module.finrank ℂ (b4c_L (E := E) (K - 0)) =
      b4c_deg (0 : C →₀ ℤ) - Module.finrank ℂ (b3_HolForm E C) + 1 :=
    RiemannRochAna_riemannRoch_effective hE 0 (by simp) w hw hgw
  rw [sub_self] at ha
  rw [sub_zero] at hb
  have hz : b4c_deg (0 : C →₀ ℤ) = 0 := by simp [b4c_deg]
  rw [hz] at hb
  change b4c_deg K = _
  omega


/-- RiemannRochRR: positive genus supplies an effective canonical representative. -/
theorem RiemannRochRR_canonical_degree_of_genus_pos
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (w : b4c_MeroForm E C hE)
    (hw : (w : TangentBundle 𝓘(ℂ, E) C → ℂ) ≠ 0)
    (hgw : ∃ x, meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 ≠ ⊤)
    (hg : 0 < Module.finrank ℂ (b3_HolForm E C)) :
    b4c_deg (b4c_divForm (hE := hE) w) =
      2 * (Module.finrank ℂ (b3_HolForm E C) : ℤ) - 2 := by
  letI := Module.finite_of_finrank_pos hg
  obtain ⟨θ, hθ⟩ := (Module.finrank_pos_iff_exists_ne_zero.mp hg)
  let v : b4c_MeroForm E C hE := ⟨θ, RiemannRochAna_hol_isMeroForm hE θ⟩
  have hv : (v : TangentBundle 𝓘(ℂ, E) C → ℂ) ≠ 0 := fun h ↦ hθ (Subtype.ext h)
  obtain ⟨x, hx⟩ := RiemannRochAna_hol_nonzero_germ hE θ hθ
  have hgv : ∃ x, meromorphicOrderAt (HurwitzPrymRR_loc hE v x) 0 ≠ ⊤ :=
    ⟨x, hx.trans_ne (by simp)⟩
  rw [← RiemannRochRR_canonical_degree_eq hE v w hv hw hgv hgw]
  apply RiemannRochRR_degree_of_effective_canonical hE v hv hgv
  intro x
  rw [RiemannRochAna_divForm_apply_of_finite hE v
    (b4c_meroForm_orderSupport_finite_aux hE v)]
  exact RiemannRochAna_hol_ordForm_nonneg hE θ x

/-- RiemannRochRR: the difference of complementary section dimensions. -/
def RiemannRochRR_chi (K D : C →₀ ℤ) : ℤ :=
  (Module.finrank ℂ (b4c_L (E := E) D) : ℤ) -
    Module.finrank ℂ (b4c_L (E := E) (K - D))

/-- RiemannRochRR: a unit point bound sums over any nonnegative point multiplicity. -/
theorem RiemannRochRR_point_multiple (χ : (C →₀ ℤ) → ℤ)
    (hχ : ∀ (D : C →₀ ℤ) (p : C), χ (D + Finsupp.single p 1) ≤ χ D + 1)
    (D : C →₀ ℤ) (p : C) (n : ℕ) :
    χ (D + Finsupp.single p (n : ℤ)) ≤ χ D + n := by
  induction n with
  | zero => simp only [Nat.cast_zero, Finsupp.single_zero, add_zero, le_refl]
  | succ n ih =>
    have hh := hχ (D + Finsupp.single p (n : ℤ)) p
    rw [Nat.cast_add, Nat.cast_one, Finsupp.single_add, ← add_assoc]
    omega


/-- RiemannRochRR: the point bound sums over every effective divisor. -/
theorem RiemannRochRR_effective_increment (χ : (C →₀ ℤ) → ℤ)
    (hχ : ∀ (D : C →₀ ℤ) (p : C), χ (D + Finsupp.single p 1) ≤ χ D + 1)
    (D A : C →₀ ℤ) (hA : ∀ x, 0 ≤ A x) :
    χ (D + A) ≤ χ D + b4c_deg A := by
  classical
  induction A using Finsupp.induction with
  | zero => simp [b4c_deg]
  | @single_add p a A hp ha ih =>
    have hpa : A p = 0 := Finsupp.notMem_support_iff.mp hp
    have ha0 : 0 ≤ a := by simpa [hpa] using hA p
    have hA0 : ∀ x, 0 ≤ A x := by
      intro x
      by_cases hx : p = x
      · subst x; simp [hpa]
      · simpa [Finsupp.single_apply, hx] using hA x
    have h₁ := ih hA0
    have h₂ := RiemannRochRR_point_multiple χ hχ (D + A) p a.toNat
    rw [Int.toNat_of_nonneg ha0] at h₂
    have he : D + (Finsupp.single p a + A) = (D + A) + Finsupp.single p a := by abel
    rw [he, RiemannRochAna_deg_add]
    have hd : b4c_deg (Finsupp.single p a) = a := by simp [b4c_deg]
    rw [hd]
    omega


/-- RiemannRochAna: restrict a section to the complement of a larger
finite marked set. -/
def RiemannRochAna_L_restrictOffFinset (D : C →₀ ℤ) (S : Finset C)
    (hDS : D.support ⊆ S) :
    b4c_L (E := E) D →ₗ[ℂ] ({x : C // x ∉ S} → ℂ) where
  toFun g x := g.1 ⟨x.1, fun hx ↦ x.2 (hDS hx)⟩
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- RiemannRochAna: extend section representatives by zero at the
divisor support, preserving their linear operations and punctured germs. -/
noncomputable def RiemannRochAna_L_scalarLinear (D : C →₀ ℤ) :
    b4c_L (E := E) D →ₗ[ℂ] (C → ℂ) where
  toFun g x := if hx : x ∈ D.support then 0 else g.1 ⟨x, hx⟩
  map_add' g h := by
    funext x
    by_cases hx : x ∈ D.support <;>
      simp only [hx, dite_true, dite_false, Submodule.coe_add, Pi.add_apply, zero_add]
  map_smul' a g := by
    funext x
    by_cases hx : x ∈ D.support <;>
      simp only [hx, dite_true, dite_false, Submodule.coe_smul, Pi.smul_apply,
        RingHom.id_apply, smul_zero]

/-- RiemannRochAna: the zero-filled scalar representative has the
same punctured local germ as any meromorphic representative of a section. -/
theorem RiemannRochAna_L_scalar_germ [T1Space C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ) (g : b4c_L (E := E) D)
    (F : C → OnePoint ℂ)
    (hg : g.1 = fun y ↦ (F y.1).elim 0 id) (x : C) :
    (fun z : ℂ ↦ RiemannRochAna_L_scalarLinear D g
      ((extChartAt 𝓘(ℂ, E) x).symm
        (extChartAt 𝓘(ℂ, E) x x + b4cov_lineEquiv hE z))) =ᶠ[𝓝[≠] 0]
      RiemannRochAna_functionLocal hE F x := by
  have ht := RiemannRochAna_inverse_coordinate_punctured hE x
    (RiemannRochAna_punctured_eventually_not_mem_finset D.support x)
  filter_upwards [ht] with z hz
  simp only [RiemannRochAna_L_scalarLinear, LinearMap.coe_mk, AddHom.coe_mk,
    dif_neg hz, hg, RiemannRochAna_functionLocal]

/-- RiemannRochAna: zero-filled section representatives are locally
meromorphic in every centered coordinate. -/
theorem RiemannRochAna_L_scalar_meromorphic
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (g : b4c_L (E := E) D) (x : C) :
    MeromorphicAt (fun z : ℂ ↦ RiemannRochAna_L_scalarLinear D g
      ((extChartAt 𝓘(ℂ, E) x).symm
        (extChartAt 𝓘(ℂ, E) x x + b4cov_lineEquiv hE z))) 0 := by
  have hm : g.1 ∈ (b4c_L (E := E) D : Set _) := g.property
  rw [b4c_L_eq_restrictions_aux hE D] at hm
  rcases hm with hzero | ⟨F, _, _, _, hval⟩
  · have hg : g = 0 := Subtype.ext hzero
    rw [hg, map_zero]
    exact MeromorphicAt.const (0 : ℂ) (0 : ℂ)
  · exact (RiemannRochAna_sphere_map_meromorphic hE F F.property.1 x).congr
      (RiemannRochAna_L_scalar_germ hE D g F hval x).symm

/-- RiemannRochRR: an integral Laurent coefficient is linear on divisor sections. -/
noncomputable def RiemannRochRR_L_coefficientLinear
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ) (x : C) (m : ℤ) :
    b4c_L (E := E) D →ₗ[ℂ] ℂ where
  toFun g := residue (fun z : ℂ ↦ RiemannRochAna_L_scalarLinear D g
    ((extChartAt 𝓘(ℂ, E) x).symm
      (extChartAt 𝓘(ℂ, E) x x + b4cov_lineEquiv hE z)) * z ^ (-m - 1)) 0
  map_add' g h := by
    simp only [map_add, Pi.add_apply, add_mul]
    exact residue_add
      ((RiemannRochAna_L_scalar_meromorphic hE D g x).mul
        (analyticAt_id.meromorphicAt.zpow _))
      ((RiemannRochAna_L_scalar_meromorphic hE D h x).mul
        (analyticAt_id.meromorphicAt.zpow _))
  map_smul' a g := by
    simp only [map_smul, Pi.smul_apply, RingHom.id_apply, smul_eq_mul,
      mul_assoc, residue_const_mul]


/-- RiemannRochAna: effective section spaces are finite dimensional. -/
theorem RiemannRochAna_effective_L_finite
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ) (hD : ∀ x, 0 ≤ D x) :
    Module.Finite ℂ (b4c_L (E := E) D) := by
  exact Module.Finite.of_surjective
    (RiemannRochAna_effectiveParameterLinear hE D hD)
    (RiemannRochAna_effectiveParameterLinear_surjective hE D hD)

/-- RiemannRochAna: increasing a divisor increases its section space
after both are restricted to a common finite-set complement. -/
theorem RiemannRochAna_L_restriction_range_mono
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D B : C →₀ ℤ) (hDB : ∀ x, D x ≤ B x)
    (S : Finset C) (hDS : D.support ⊆ S) (hBS : B.support ⊆ S) :
    LinearMap.range (RiemannRochAna_L_restrictOffFinset (E := E) D S hDS) ≤
      LinearMap.range (RiemannRochAna_L_restrictOffFinset (E := E) B S hBS) := by
  rintro g ⟨a, rfl⟩
  have hm : a.1 ∈ (b4c_L (E := E) D : Set _) := a.property
  rw [b4c_L_eq_restrictions_aux hE D] at hm
  rcases hm with hzero | ⟨F, hFn, _, hbound, hval⟩
  · have ha : a = 0 := Subtype.ext hzero
    rw [ha, map_zero]
    exact Submodule.zero_mem _
  · have hboundB : ∀ x, 0 ≤ b4c_ord E F x + B x := by
      intro x
      have hd := hDB x
      have hf := hbound x
      omega
    have hfinB : ∀ x, x ∉ B.support → F x ≠ OnePoint.infty := by
      intro x hx
      apply RiemannRochAna_ne_infty_of_ord_nonneg hE F x
      simpa only [Finsupp.notMem_support_iff.mp hx, add_zero] using hboundB x
    have hb : (fun x : {x : C // x ∉ B.support} ↦ (F x.1).elim 0 id) ∈
        b4c_L (E := E) B := by
      change (fun x : {x : C // x ∉ B.support} ↦ (F x.1).elim 0 id) ∈
        (b4c_L (E := E) B : Set ({x : C // x ∉ B.support} → ℂ))
      rw [b4c_L_eq_restrictions_aux hE B]
      exact Or.inr ⟨F, hFn, hfinB, hboundB, rfl⟩
    refine ⟨⟨_, hb⟩, ?_⟩
    funext x
    change (F x.1).elim 0 id = a.1 ⟨x.1, _⟩
    rw [hval]

/-- RiemannRochAna: continuous maps on a complex curve are determined
by their values away from a finite set. -/
theorem RiemannRochAna_continuous_eq_of_eq_off_finset [T1Space C]
    (hE : Module.finrank ℂ E = 1) {Y : Type*} [TopologicalSpace Y] [T2Space Y]
    (f g : C → Y) (hf : Continuous f) (hg : Continuous g)
    (S : Finset C) (he : ∀ x, x ∉ S → f x = g x) : f = g := by
  funext x
  letI := RiemannRochAna_punctured_neBot hE x
  have hp : f =ᶠ[𝓝[≠] x] g := by
    filter_upwards [RiemannRochAna_punctured_eventually_not_mem_finset S x] with y hy
    exact he y hy
  exact ((hf.continuousAt.eventuallyEq_nhds_iff_eventuallyEq_nhdsNE
    hg.continuousAt).mp hp).self_of_nhds

/-- RiemannRochAna: removing finitely many more points does not identify
distinct meromorphic sections. -/
theorem RiemannRochAna_L_restrictOffFinset_injective
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ) (S : Finset C)
    (hDS : D.support ⊆ S) :
    Function.Injective (RiemannRochAna_L_restrictOffFinset (E := E) D S hDS) := by
  rw [← LinearMap.ker_eq_bot]
  apply LinearMap.ker_eq_bot'.mpr
  intro g hg
  have hm : g.1 ∈ (b4c_L (E := E) D : Set _) := g.property
  rw [b4c_L_eq_restrictions_aux hE D] at hm
  rcases hm with hzero | ⟨F, hFn, hfin, _, hval⟩
  · exact Subtype.ext hzero
  · have hFzero : (F : C → OnePoint ℂ) = fun _ ↦ ((0 : ℂ) : OnePoint ℂ) := by
      apply RiemannRochAna_continuous_eq_of_eq_off_finset hE _ _
        F.property.1.continuous continuous_const S
      intro x hx
      have hv := congrFun hg ⟨x, hx⟩
      change g.1 ⟨x, fun hd ↦ hx (hDS hd)⟩ = 0 at hv
      rw [hval] at hv
      change (F x).elim 0 id = 0 at hv
      obtain ⟨a, ha⟩ := OnePoint.ne_infty_iff_exists.mp
        (hfin x (fun hd ↦ hx (hDS hd)))
      rw [← ha] at hv ⊢
      exact congrArg (fun z : ℂ ↦ (z : OnePoint ℂ)) hv
    obtain ⟨x, hx⟩ := hFn
    exact (hx (congrFun hFzero x)).elim

/-- RiemannRochAna: the section space of any divisor is finite dimensional. -/
theorem RiemannRochAna_L_finite
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ) :
    Module.Finite ℂ (b4c_L (E := E) D) := by
  classical
  let B : C →₀ ℤ := D ⊔ 0
  have hB : ∀ x, 0 ≤ B x := fun _ ↦ le_sup_right
  have hDB : ∀ x, D x ≤ B x := fun _ ↦ le_sup_left
  let S := D.support ∪ B.support
  have hDS : D.support ⊆ S := Finset.subset_union_left
  have hBS : B.support ⊆ S := Finset.subset_union_right
  let f := RiemannRochAna_L_restrictOffFinset (E := E) D S hDS
  let g := RiemannRochAna_L_restrictOffFinset (E := E) B S hBS
  letI := RiemannRochAna_effective_L_finite hE B hB
  have hfg : LinearMap.range f ≤ LinearMap.range g :=
    RiemannRochAna_L_restriction_range_mono hE D B hDB S hDS hBS
  letI : Module.Finite ℂ (LinearMap.range f) :=
    Module.Finite.of_injective (Submodule.inclusion hfg)
      (Submodule.inclusion_injective hfg)
  let e := LinearEquiv.ofInjective f
    (RiemannRochAna_L_restrictOffFinset_injective hE D S hDS)
  exact Module.Finite.of_injective e.toLinearMap e.injective

/-- RiemannRochAna: scalar section representatives retain their divisor
order bounds, including at the filled support points. -/
theorem RiemannRochAna_L_scalar_order_bound
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (g : b4c_L (E := E) D) (x : C) :
    ((-D x : ℤ) : WithTop ℤ) ≤ meromorphicOrderAt
      (fun z : ℂ ↦ RiemannRochAna_L_scalarLinear D g
        ((extChartAt 𝓘(ℂ, E) x).symm
          (extChartAt 𝓘(ℂ, E) x x + b4cov_lineEquiv hE z))) 0 := by
  have hm : g.1 ∈ (b4c_L (E := E) D : Set _) := g.property
  rw [b4c_L_eq_restrictions_aux hE D] at hm
  rcases hm with hzero | ⟨F, hFn, _, hbound, hval⟩
  · have hg : g = 0 := Subtype.ext hzero
    rw [hg, map_zero]
    simp only [Pi.zero_apply, meromorphicOrderAt_const, ite_true, le_top]
  · rw [meromorphicOrderAt_congr (RiemannRochAna_L_scalar_germ hE D g F hval x),
      ← RiemannRochAna_ord_eq_local hE F hFn x]
    have hb : -D x ≤ b4c_ord E F x := by
      have hh := hbound x
      omega
    exact_mod_cast hb

set_option backward.isDefEq.respectTransparency false in
/-- RiemannRochRR: a Laurent coefficient detects the lowest allowed integral order. -/
theorem RiemannRochRR_coefficient_zero_iff (f : ℂ → ℂ) (hf : MeromorphicAt f 0)
    (m : ℤ) (hm : (m : WithTop ℤ) ≤ meromorphicOrderAt f 0) :
    residue (fun z ↦ f z * z ^ (-m - 1)) 0 = 0 ↔
      ((m + 1 : ℤ) : WithTop ℤ) ≤ meromorphicOrderAt f 0 := by
  let g : ℂ → ℂ := fun z ↦ f z * z ^ (-m - 1)
  have hg : MeromorphicAt g 0 := hf.mul (analyticAt_id.meromorphicAt.zpow (-m - 1))
  have horder : meromorphicOrderAt g 0 =
      meromorphicOrderAt f 0 + ((-m - 1 : ℤ) : WithTop ℤ) := by
    have hz : MeromorphicAt (fun z : ℂ ↦ z ^ (-m - 1)) 0 :=
      analyticAt_id.meromorphicAt.zpow (-m - 1)
    change meromorphicOrderAt (f * (fun z : ℂ ↦ z ^ (-m - 1))) 0 = _
    rw [meromorphicOrderAt_mul hf hz]
    congr 1
    simpa only [Pi.pow_apply, sub_zero] using (fun_meromorphicOrderAt_zpow_id_sub_const (𝕜 := ℂ) (x := 0) (n := -m - 1))
  constructor
  · intro hr
    by_contra hn
    have he : meromorphicOrderAt f 0 = (m : WithTop ℤ) := by
      cases ho : meromorphicOrderAt f 0 with
      | top => simp [ho] at hn
      | coe z =>
        rw [ho] at hm hn
        norm_cast at hm hn ⊢
        omega
    have hgo : meromorphicOrderAt g 0 = -1 := by
      rw [horder, he, ← WithTop.coe_add]
      rw [show m + (-m - 1) = (-1 : ℤ) by omega]
      rfl
    change residue g 0 = 0 at hr
    rw [residue_eq_meromorphicTrailingCoeffAt_of_order_eq_neg_one hgo] at hr
    exact hg.meromorphicTrailingCoeffAt_ne_zero (by rw [hgo]; simp) hr
  · intro hn
    apply residue_eq_zero_of_meromorphicOrderAt_nonneg
    change 0 ≤ meromorphicOrderAt g 0
    rw [horder]
    calc
      (0 : WithTop ℤ) = ((m + 1 : ℤ) : WithTop ℤ) + ((-m - 1 : ℤ) : WithTop ℤ) := by
        rw [← WithTop.coe_add]; simp
      _ ≤ _ := add_le_add hn le_rfl

/-- RiemannRochRR: vanishing of the new point coefficient places the restriction
in the smaller divisor's section range. -/
theorem RiemannRochRR_coefficient_kernel_restriction
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ) (p : C)
    (S : Finset C) (hDS : D.support ⊆ S)
    (hBS : (D + Finsupp.single p 1).support ⊆ S)
    (a : b4c_L (E := E) (D + Finsupp.single p 1))
    (ha : RiemannRochRR_L_coefficientLinear hE (D + Finsupp.single p 1) p
      (-(D p) - 1) a = 0) :
    RiemannRochAna_L_restrictOffFinset (E := E) (D + Finsupp.single p 1) S hBS a ∈
      LinearMap.range (RiemannRochAna_L_restrictOffFinset (E := E) D S hDS) := by
  have hm : a.1 ∈ (b4c_L (E := E) (D + Finsupp.single p 1) : Set _) := a.property
  rw [b4c_L_eq_restrictions_aux hE] at hm
  rcases hm with hz | ⟨F, hFn, _, hbound, hval⟩
  · have ha0 : a = 0 := Subtype.ext hz
    rw [ha0, map_zero]
    exact Submodule.zero_mem _
  · have hbp : ((-D p - 1 : ℤ) : WithTop ℤ) ≤ meromorphicOrderAt
        (fun z : ℂ ↦ RiemannRochAna_L_scalarLinear (D + Finsupp.single p 1) a
          ((extChartAt 𝓘(ℂ, E) p).symm
            (extChartAt 𝓘(ℂ, E) p p + b4cov_lineEquiv hE z))) 0 := by
      simpa [Finsupp.add_apply, Finsupp.single_eq_same, neg_add_rev, sub_eq_add_neg,
        add_comm] using RiemannRochAna_L_scalar_order_bound hE
          (D + Finsupp.single p 1) a p
    have hp := (RiemannRochRR_coefficient_zero_iff _
      (RiemannRochAna_L_scalar_meromorphic hE (D + Finsupp.single p 1) a p)
      (-D p - 1) hbp).mp ha
    rw [meromorphicOrderAt_congr
      (RiemannRochAna_L_scalar_germ hE (D + Finsupp.single p 1) a F hval p),
      ← RiemannRochAna_ord_eq_local hE F hFn p] at hp
    have hboundD : ∀ x, 0 ≤ b4c_ord E F x + D x := by
      intro x
      by_cases hx : x = p
      · subst x
        norm_cast at hp
        omega
      · have hh := hbound x
        simpa [Finsupp.add_apply, Finsupp.single_apply, Ne.symm hx] using hh
    have hmem : (fun x : {x : C // x ∉ D.support} ↦ (F x.1).elim 0 id) ∈
        b4c_L (E := E) D := by
      change (fun x : {x : C // x ∉ D.support} ↦ (F x.1).elim 0 id) ∈
        (b4c_L (E := E) D : Set ({x : C // x ∉ D.support} → ℂ))
      rw [b4c_L_eq_restrictions_aux hE D]
      refine Or.inr ⟨F, hFn, ?_, hboundD, rfl⟩
      intro x hx
      apply RiemannRochAna_ne_infty_of_ord_nonneg hE F x
      simpa only [Finsupp.notMem_support_iff.mp hx, add_zero] using hboundD x
    refine ⟨⟨_, hmem⟩, ?_⟩
    funext x
    change (F x.1).elim 0 id = a.1 ⟨x.1, _⟩
    rw [hval]

/-- RiemannRochRR: A point increases section dimension by at most one. -/
theorem RiemannRochRR_step_le
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ) (p : C) :
    Module.finrank ℂ (b4c_L (E := E) (D + Finsupp.single p 1)) ≤ Module.finrank ℂ (b4c_L (E := E) (D)) + 1 := by
  classical
  let B := D + Finsupp.single p 1
  let S := D.support ∪ B.support
  have hDS : D.support ⊆ S := Finset.subset_union_left
  have hBS : B.support ⊆ S := Finset.subset_union_right
  let f := RiemannRochAna_L_restrictOffFinset (E := E) D S hDS
  let g := RiemannRochAna_L_restrictOffFinset (E := E) B S hBS
  let T := RiemannRochRR_L_coefficientLinear hE B p (-D p - 1)
  letI := RiemannRochAna_L_finite hE B
  letI := RiemannRochAna_L_finite hE D
  have hf : Function.Injective f :=
    RiemannRochAna_L_restrictOffFinset_injective hE D S hDS
  have hg : Function.Injective g :=
    RiemannRochAna_L_restrictOffFinset_injective hE B S hBS
  let j : LinearMap.ker T →ₗ[ℂ] LinearMap.range f :=
    (g.comp (LinearMap.ker T).subtype).codRestrict _ (by
      intro a
      exact RiemannRochRR_coefficient_kernel_restriction hE D p S hDS hBS a.1
        (LinearMap.mem_ker.mp a.property))
  have hj : Function.Injective j := by
    intro a b h
    apply Subtype.ext
    apply hg
    exact congrArg Subtype.val h
  have hk := LinearMap.finrank_le_finrank_of_injective hj
  have he := (LinearEquiv.ofInjective f hf).finrank_eq
  have hr := T.finrank_range_add_finrank_ker
  have ht := Submodule.finrank_le (LinearMap.range T)
  have ht' : Module.finrank ℂ (LinearMap.range T) ≤ 1 := by
    simpa using ht
  change Module.finrank ℂ (LinearMap.ker T) ≤ Module.finrank ℂ (LinearMap.range f) at hk
  change Module.finrank ℂ (b4c_L (E := E) B) ≤ Module.finrank ℂ (b4c_L (E := E) D) + 1
  omega

/-- RiemannRochRR: the coefficient kernel has at most the smaller section dimension. -/
theorem RiemannRochRR_coefficient_ker_finrank_le
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ) (p : C) :
    Module.finrank ℂ (LinearMap.ker
      (RiemannRochRR_L_coefficientLinear hE (D + Finsupp.single p 1) p (-D p - 1))) ≤
      Module.finrank ℂ (b4c_L (E := E) D) := by
  classical
  let B := D + Finsupp.single p 1
  let S := D.support ∪ B.support
  have hDS : D.support ⊆ S := Finset.subset_union_left
  have hBS : B.support ⊆ S := Finset.subset_union_right
  let f := RiemannRochAna_L_restrictOffFinset (E := E) D S hDS
  let g := RiemannRochAna_L_restrictOffFinset (E := E) B S hBS
  let T := RiemannRochRR_L_coefficientLinear hE B p (-D p - 1)
  letI := RiemannRochAna_L_finite hE B
  letI := RiemannRochAna_L_finite hE D
  have hf : Function.Injective f :=
    RiemannRochAna_L_restrictOffFinset_injective hE D S hDS
  have hg : Function.Injective g :=
    RiemannRochAna_L_restrictOffFinset_injective hE B S hBS
  let j : LinearMap.ker T →ₗ[ℂ] LinearMap.range f :=
    (g.comp (LinearMap.ker T).subtype).codRestrict _ (by
      intro a
      exact RiemannRochRR_coefficient_kernel_restriction hE D p S hDS hBS a.1
        (LinearMap.mem_ker.mp a.property))
  have hj : Function.Injective j := by
    intro a b h
    apply Subtype.ext
    apply hg
    exact congrArg Subtype.val h
  have hk := LinearMap.finrank_le_finrank_of_injective hj
  have he := (LinearEquiv.ofInjective f hf).finrank_eq
  change Module.finrank ℂ (LinearMap.ker T) ≤ Module.finrank ℂ (b4c_L (E := E) D)
  omega

/-- RiemannRochRR: a strict point increment supplies a meromorphic section
whose order reaches the new bound at that point. -/
theorem RiemannRochRR_exists_exact_order
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ) (p : C)
    (hlt : Module.finrank ℂ (b4c_L (E := E) D) <
      Module.finrank ℂ (b4c_L (E := E) (D + Finsupp.single p 1))) :
    ∃ F : b4c_MeroFun E C, (∃ x, F x ≠ (0 : ℂ)) ∧
      (∀ x : C, 0 ≤ b4c_ord E F x + (D + Finsupp.single p 1 : C →₀ ℤ) x) ∧
      b4c_ord E F p = -D p - 1 := by
  let B := D + Finsupp.single p 1
  let T := RiemannRochRR_L_coefficientLinear hE B p (-D p - 1)
  have hk := RiemannRochRR_coefficient_ker_finrank_le hE D p
  have hex : ∃ a, T a ≠ 0 := by
    by_contra hn
    have hT : T = 0 := by
      ext a
      exact not_not.mp (fun h ↦ hn ⟨a, h⟩)
    change Module.finrank ℂ (LinearMap.ker T) ≤ _ at hk
    rw [hT, LinearMap.ker_zero, finrank_top] at hk
    exact (not_le.mpr hlt) hk
  obtain ⟨a, ha⟩ := hex
  have hm : a.1 ∈ (b4c_L (E := E) B : Set _) := a.property
  rw [b4c_L_eq_restrictions_aux hE] at hm
  rcases hm with hz | ⟨F, hFn, _, hbound, hval⟩
  · have ha0 : a = 0 := Subtype.ext hz
    exact (ha (by rw [ha0, map_zero])).elim
  · refine ⟨F, hFn, hbound, ?_⟩
    have hb : -D p - 1 ≤ b4c_ord E F p := by
      have hh := hbound p
      simp only [B, Finsupp.add_apply, Finsupp.single_eq_same] at hh
      omega
    have he : meromorphicOrderAt
        (fun z : ℂ ↦ RiemannRochAna_L_scalarLinear B a
          ((extChartAt 𝓘(ℂ, E) p).symm
            (extChartAt 𝓘(ℂ, E) p p + b4cov_lineEquiv hE z))) 0 =
        (b4c_ord E F p : WithTop ℤ) := by
      rw [meromorphicOrderAt_congr (RiemannRochAna_L_scalar_germ hE B a F hval p),
        ← RiemannRochAna_ord_eq_local hE F hFn p]
    have hbp : ((-D p - 1 : ℤ) : WithTop ℤ) ≤ meromorphicOrderAt
        (fun z : ℂ ↦ RiemannRochAna_L_scalarLinear B a
          ((extChartAt 𝓘(ℂ, E) p).symm
            (extChartAt 𝓘(ℂ, E) p p + b4cov_lineEquiv hE z))) 0 := by
      rw [he]
      exact_mod_cast hb
    have hh := (RiemannRochRR_coefficient_zero_iff _
      (RiemannRochAna_L_scalar_meromorphic hE B a p) (-D p - 1) hbp).not.mp ha
    rw [he] at hh
    norm_cast at hh
    omega


/-- RiemannRochRR: multiplying two meromorphic functions and a meromorphic
form gives a meromorphic form, with its scalar values filled by zero at poles. -/
noncomputable def RiemannRochRR_productForm
    (hE : Module.finrank ℂ E = 1) (F G : b4c_MeroFun E C)
    (w : b4c_MeroForm E C hE) : b4c_MeroForm E C hE :=
  ⟨fun p ↦ (F p.proj).elim 0 id * (G p.proj).elim 0 id * w p, by
    refine ⟨?_, ?_⟩
    · intro x a v u
      dsimp only
      rw [w.property.1 x a v u]
      ring
    · intro x
      exact ((RiemannRochAna_sphere_map_meromorphic hE F F.property.1 x).mul
        (RiemannRochAna_sphere_map_meromorphic hE G G.property.1 x)).mul (w.property.2 x)⟩

/-- RiemannRochRR: Complementary point increments cannot both increase dimension. -/
theorem RiemannRochRR_not_both
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ) (p : C)
    (w : b4c_MeroForm E C hE)
    (hw : (w : TangentBundle 𝓘(ℂ, E) C → ℂ) ≠ 0)
    (hgw : ∃ x, meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 ≠ ⊤) :
    ¬ (Module.finrank ℂ (b4c_L (E := E) (D)) < Module.finrank ℂ (b4c_L (E := E) (D + Finsupp.single p 1)) ∧
      Module.finrank ℂ (b4c_L (E := E) (b4c_divForm (hE := hE) w - D - Finsupp.single p 1)) < Module.finrank ℂ (b4c_L (E := E) (b4c_divForm (hE := hE) w - D))) := by
  rintro ⟨hD, hK⟩
  obtain ⟨F, hFn, hF, hFp⟩ := RiemannRochRR_exists_exact_order hE D p hD
  have hK' : Module.finrank ℂ (b4c_L (E := E)
      (b4c_divForm (hE := hE) w - D - Finsupp.single p 1)) <
      Module.finrank ℂ (b4c_L (E := E)
        ((b4c_divForm (hE := hE) w - D - Finsupp.single p 1) + Finsupp.single p 1)) := by
    rw [sub_add_cancel]
    exact hK
  obtain ⟨G, hGn, hG, hGp⟩ := RiemannRochRR_exists_exact_order hE
    (b4c_divForm (hE := hE) w - D - Finsupp.single p 1) p hK'
  simp only [sub_add_cancel] at hG
  let η := RiemannRochRR_productForm hE F G w
  have ho (x : C) : meromorphicOrderAt (HurwitzPrymRR_loc hE η x) 0 =
      ((b4c_ord E F x + b4c_ord E G x + b4c_divForm (hE := hE) w x : ℤ) : WithTop ℤ) := by
    change meromorphicOrderAt
      ((RiemannRochAna_functionLocal hE F x * RiemannRochAna_functionLocal hE G x) *
        HurwitzPrymRR_loc hE w x) 0 = _
    have hf : MeromorphicAt (RiemannRochAna_functionLocal hE F x) 0 :=
      RiemannRochAna_sphere_map_meromorphic hE F F.property.1 x
    have hg : MeromorphicAt (RiemannRochAna_functionLocal hE G x) 0 :=
      RiemannRochAna_sphere_map_meromorphic hE G G.property.1 x
    rw [meromorphicOrderAt_mul (hf.mul hg) (w.property.2 x),
      meromorphicOrderAt_mul hf hg,
      ← RiemannRochAna_ord_eq_local hE F hFn x,
      ← RiemannRochAna_ord_eq_local hE G hGn x,
      ← RiemannRochAna_coe_divForm_apply hE w
        (b4c_meroForm_orderSupport_finite_aux hE w) x
        (RiemannRochAna_meroForm_order_ne_top hE w hw hgw x),
      ← WithTop.coe_add, ← WithTop.coe_add]
  have hp : meromorphicOrderAt (HurwitzPrymRR_loc hE η p) 0 = -1 := by
    rw [ho]
    have he : b4c_ord E F p + b4c_ord E G p + b4c_divForm (hE := hE) w p = -1 := by
      simp only [Finsupp.sub_apply, Finsupp.single_eq_same] at hGp
      omega
    rw [he]
    rfl
  have hz (x : C) (hx : x ≠ p) : b4c_res (hE := hE) η x = 0 := by
    apply residue_eq_zero_of_meromorphicOrderAt_nonneg
    rw [ho]
    have hf := hF x
    have hg := hG x
    simp only [Finsupp.add_apply, Finsupp.single_apply, if_neg (Ne.symm hx), add_zero] at hf
    simp only [Finsupp.sub_apply] at hg
    exact_mod_cast (show 0 ≤ b4c_ord E F x + b4c_ord E G x + b4c_divForm (hE := hE) w x by omega)
  have hs : b4c_res (hE := hE) η p = 0 := by
    have hh := b4c_residue_sum_aux hE η
    rwa [finsum_eq_single _ p hz] at hh
  change residue (HurwitzPrymRR_loc hE η p) 0 = 0 at hs
  rw [residue_eq_meromorphicTrailingCoeffAt_of_order_eq_neg_one hp] at hs
  exact (η.property.2 p).meromorphicTrailingCoeffAt_ne_zero (by rw [hp]; simp) hs

/-- RiemannRochRR: The dimension difference increases by at most one. -/
theorem RiemannRochRR_chi_step
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ) (p : C)
    (w : b4c_MeroForm E C hE)
    (hw : (w : TangentBundle 𝓘(ℂ, E) C → ℂ) ≠ 0)
    (hgw : ∃ x, meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 ≠ ⊤) :
    RiemannRochRR_chi (E := E) (b4c_divForm (hE := hE) w) (D + Finsupp.single p 1) -
      RiemannRochRR_chi (E := E) (b4c_divForm (hE := hE) w) (D) ≤ 1 := by
  have h₁ := RiemannRochRR_step_le hE D p
  have h₂ := RiemannRochRR_step_le hE
    (b4c_divForm (hE := hE) w - D - Finsupp.single p 1) p
  rw [sub_add_cancel] at h₂
  have hn := RiemannRochRR_not_both hE D p w hw hgw
  unfold RiemannRochRR_chi
  rw [sub_add_eq_sub_sub]
  omega

/-- RiemannRochRR: The effective identity in dimension-difference notation. -/
theorem RiemannRochRR_chi_effective
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ) (hD : ∀ x, 0 ≤ D x)
    (w : b4c_MeroForm E C hE)
    (hw : (w : TangentBundle 𝓘(ℂ, E) C → ℂ) ≠ 0)
    (hgw : ∃ x, meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 ≠ ⊤) :
    RiemannRochRR_chi (E := E) (b4c_divForm (hE := hE) w) (D) =
      b4c_deg D - Module.finrank ℂ (b3_HolForm E C) + 1 := by
  exact RiemannRochAna_riemannRoch_effective hE D hD w hw hgw

/-- RiemannRochRR: summing the point inequality up to an effective majorant
gives the Riemann--Roch lower bound for any divisor. -/
theorem RiemannRochRR_chi_lower
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (w : b4c_MeroForm E C hE)
    (hw : (w : TangentBundle 𝓘(ℂ, E) C → ℂ) ≠ 0)
    (hgw : ∃ x, meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 ≠ ⊤) :
    b4c_deg D - Module.finrank ℂ (b3_HolForm E C) + 1 ≤
      RiemannRochRR_chi (E := E) (b4c_divForm (hE := hE) w) D := by
  let B : C →₀ ℤ := D ⊔ 0
  have hB : ∀ x, 0 ≤ B x := fun _ ↦ le_sup_right
  have hDB : ∀ x, 0 ≤ (B - D) x := fun x ↦ sub_nonneg.mpr le_sup_left
  have hs := RiemannRochRR_effective_increment
    (RiemannRochRR_chi (E := E) (b4c_divForm (hE := hE) w))
    (fun A p ↦ by have hh := RiemannRochRR_chi_step hE A p w hw hgw; omega)
    D (B - D) hDB
  rw [add_sub_cancel, RiemannRochRR_chi_effective hE B hB w hw hgw,
    RiemannRochAna_deg_sub] at hs
  omega


/-- RiemannRochRR: Exchanging complementary divisors negates their dimension difference. -/
theorem RiemannRochRR_chi_dual
    (K D : C →₀ ℤ) :
    RiemannRochRR_chi (E := E) K (K - D) = -RiemannRochRR_chi (E := E) K D := by
  unfold RiemannRochRR_chi
  rw [sub_sub_cancel]
  omega

/-- RiemannRochRR: duality converts the lower bound into an upper bound
that retains the canonical degree. -/
theorem RiemannRochRR_chi_upper
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (w : b4c_MeroForm E C hE)
    (hw : (w : TangentBundle 𝓘(ℂ, E) C → ℂ) ≠ 0)
    (hgw : ∃ x, meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 ≠ ⊤) :
    RiemannRochRR_chi (E := E) (b4c_divForm (hE := hE) w) D ≤
      b4c_deg D - b4c_deg (b4c_divForm (hE := hE) w) +
        Module.finrank ℂ (b3_HolForm E C) - 1 := by
  have h := RiemannRochRR_chi_lower hE (b4c_divForm (hE := hE) w - D) w hw hgw
  rw [RiemannRochRR_chi_dual, RiemannRochAna_deg_sub] at h
  omega

theorem b4c_riemannRoch_aux [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ) (w : b4c_MeroForm E C hE)
    (hw : (w : TangentBundle 𝓘(ℂ, E) C → ℂ) ≠ 0)
    (hgw : ∃ x, meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 ≠ ⊤) :
    (Module.finrank ℂ (b4c_L (E := E) D) : ℤ) - Module.finrank ℂ
      (b4c_L (E := E) (b4c_divForm (hE := hE) w - D)) =
        b4c_deg D - Module.finrank ℂ (b3_HolForm E C) + 1 := by
  have hdeg : b4c_deg (b4c_divForm (hE := hE) w) =
      2 * (Module.finrank ℂ (b3_HolForm E C) : ℤ) - 2 := by
    by_cases hg : Module.finrank ℂ (b3_HolForm E C) = 0
    · simpa only [hg, Nat.cast_zero, mul_zero, zero_sub] using
        RiemannRochRR_canonical_degree_of_genus_zero hE w hw hgw hg
    · exact RiemannRochRR_canonical_degree_of_genus_pos hE w hw hgw (Nat.pos_of_ne_zero hg)
  have hlo := RiemannRochRR_chi_lower hE D w hw hgw
  have hhi := RiemannRochRR_chi_upper hE D w hw hgw
  rw [hdeg] at hhi
  change RiemannRochRR_chi (E := E) (b4c_divForm (hE := hE) w) D = _
  omega

/-- The Riemann--Roch space of the zero divisor consists of constants and has dimension one. -/
lemma RiemannRochEichler_L_zero_finrank [CompactSpace C] [ConnectedSpace C] :
    Module.finrank ℂ (b4c_L (E := E) (0 : C →₀ ℤ)) = 1 := by
  classical
  let x₀ : C := Classical.choice inferInstance
  let U := {x : C // x ∉ (0 : C →₀ ℤ).support}
  have hspace : b4c_L (E := E) (0 : C →₀ ℤ) = ℂ ∙ (1 : U → ℂ) := by
    apply le_antisymm
    · apply Submodule.span_le.mpr
      rintro g ⟨f, _, hf, _, rfl⟩
      have hconst (x : C) : f x = f x₀ := by
        by_contra hx
        obtain ⟨y, hy⟩ := b4cov_surjective (by simp : Module.finrank ℂ ℂ = 1)
          f f.property.1 ⟨x, x₀, hx⟩ OnePoint.infty
        exact hf y (by simp) hy
      refine Submodule.mem_span_singleton.mpr ⟨(f x₀).elim 0 id, ?_⟩
      funext x
      simp only [Pi.smul_apply, Pi.one_apply, smul_eq_mul, mul_one, hconst x.1]
    · apply Submodule.span_le.mpr
      rintro g (rfl : g = 1)
      apply Submodule.subset_span
      let f : b4c_MeroFun E C :=
        ⟨fun _ ↦ (1 : ℂ), contMDiff_const, x₀, OnePoint.coe_ne_infty 1⟩
      refine ⟨f, ?_, ?_, ?_, ?_⟩
      · refine ⟨x₀, ?_⟩
        change ((1 : ℂ) : OnePoint ℂ) ≠ ((0 : ℂ) : OnePoint ℂ)
        simp
      · intro x hx
        exact OnePoint.coe_ne_infty 1
      · intro x
        change 0 ≤ b4c_ord E (fun _ : C ↦ ((1 : ℂ) : OnePoint ℂ)) x + 0
        simp [b4c_ord]
      · rfl
  rw [hspace]
  apply finrank_span_singleton
  intro h
  have hx := congrFun h (⟨x₀, by simp⟩ : U)
  exact one_ne_zero hx


/-- Riemann--Roch gives at least genus plus one sections after adding two points to a canonical divisor. -/
lemma RiemannRochEichler_two_point_finrank [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (w : b4c_MeroForm E C hE)
    (hw : (w : TangentBundle 𝓘(ℂ, E) C → ℂ) ≠ 0)
    (hgw : ∃ x, meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 ≠ ⊤)
    (p q : C) :
    Module.finrank ℂ (b3_HolForm E C) + 1 ≤ Module.finrank ℂ
      (b4c_L (E := E) (b4c_divForm (hE := hE) w + Finsupp.single p 1 + Finsupp.single q 1)) := by
  let K := b4c_divForm (hE := hE) w
  let D := K + Finsupp.single p 1 + Finsupp.single q 1
  have h0 := b4c_riemannRoch_aux hE (0 : C →₀ ℤ) w hw hgw
  have hK := b4c_riemannRoch_aux hE K w hw hgw
  have hD := b4c_riemannRoch_aux hE D w hw hgw
  have hzero : b4c_deg (0 : C →₀ ℤ) = 0 := rfl
  rw [sub_zero, RiemannRochEichler_L_zero_finrank, hzero] at h0
  change (Module.finrank ℂ (b4c_L (E := E) K) : ℤ) -
    Module.finrank ℂ (b4c_L (E := E) (K - K)) = _ at hK
  rw [sub_self, RiemannRochEichler_L_zero_finrank] at hK
  have hdeg : b4c_deg D = b4c_deg K + 1 + 1 := by
    simp [D, b4c_deg, Finsupp.sum_add_index]
  rw [hdeg] at hD
  have hn : (0 : ℤ) ≤ Module.finrank ℂ (b4c_L (E := E) (K - D)) := Int.natCast_nonneg _
  change Module.finrank ℂ (b3_HolForm E C) + 1 ≤ Module.finrank ℂ (b4c_L (E := E) D)
  change (1 : ℤ) - Module.finrank ℂ (b4c_L (E := E) K) = _ at h0
  change (Module.finrank ℂ (b4c_L (E := E) D) : ℤ) -
    Module.finrank ℂ (b4c_L (E := E) (K - D)) = _ at hD
  omega


/-- Two distinct points support a meromorphic differential with prescribed opposite unit residues. -/
lemma RiemannRochEichler_third_kind [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (p q : C) (hpq : p ≠ q) :
    ∃ w : b4c_MeroForm E C hE,
      b4c_res (hE := hE) w p = -1 ∧ b4c_res (hE := hE) w q = 1 ∧
      (∀ x, (-1 : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0) ∧
      ∀ x, x ≠ p → x ≠ q → 0 ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 := by
  classical
  obtain ⟨w, hw, hgw⟩ := b4c_exists_meroForm_aux (C := C) hE
  let K := b4c_divForm (hE := hE) w
  let D := K + Finsupp.single p 1 + Finsupp.single q 1
  obtain ⟨M, hM, hm⟩ := RiemannRochEichler_L_mul_linear hE D w
  have hbound (g : b4c_L (E := E) D) (x : C) :
      ((K x - D x : ℤ) : WithTop ℤ) ≤
        meromorphicOrderAt (HurwitzPrymRR_loc hE (M g) x) 0 := by
    have he : M g = fun t ↦ if ht : t.1 ∉ D.support then g.1 ⟨t.1, ht⟩ * w t else 0 :=
      funext (hM g)
    rw [he]
    exact RiemannRochEichler_L_mul_order hE D w hgw g x
  apply RiemannRochEichler_third_kind_of_family hE M hm p q hpq
  · intro g x
    apply le_trans (b := ((K x - D x : ℤ) : WithTop ℤ)) _ (hbound g x)
    have hi : (-1 : ℤ) ≤ K x - D x := by
      by_cases hxp : x = p
      · subst x
        simp [D, Finsupp.single_apply, hpq, Ne.symm hpq]
      · by_cases hxq : x = q
        · subst x
          simp [D, Finsupp.single_apply, hpq, Ne.symm hpq]
        · simp [D, Finsupp.single_apply, Ne.symm hxp, Ne.symm hxq]
    have hc : (-1 : WithTop ℤ) = ((-1 : ℤ) : WithTop ℤ) := by norm_cast
    rw [hc]
    exact WithTop.coe_le_coe.mpr hi
  · intro g x hxp hxq
    have he : K x - D x = 0 := by
      simp [D, Finsupp.single_apply, Ne.symm hxp, Ne.symm hxq]
    simpa only [he, WithTop.coe_zero] using hbound g x
  · exact RiemannRochEichler_L_mul_germ_separating hE D w
      (RiemannRochEichler_finite_orders hE w hgw) M hM
  · have hd := RiemannRochEichler_two_point_finrank hE w hw hgw p q
    exact Nat.lt_of_succ_le hd


/-- At finitely many points without poles, changing fibre values makes the coefficients analytic. -/
lemma RiemannRochEichler_regularize_finite [T1Space C]
    (hE : Module.finrank ℂ E = 1) (w : b4c_MeroForm E C hE)
    (S : Set C) (hS : S.Finite)
    (ho : ∀ p ∈ S, 0 ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE w p) 0) :
    ∃ w' : b4c_MeroForm E C hE,
      (∀ p, HurwitzPrymRR_loc hE w' p =ᶠ[𝓝[≠] 0] HurwitzPrymRR_loc hE w p) ∧
      ∀ p ∈ S, AnalyticAt ℂ (HurwitzPrymRR_loc hE w' p) 0 := by
  classical
  have hex (p : C) : ∃ g : ℂ → ℂ, p ∈ S →
      AnalyticAt ℂ g 0 ∧ HurwitzPrymRR_loc hE w p =ᶠ[𝓝[≠] 0] g := by
    by_cases hp : p ∈ S
    · obtain ⟨g, hg, he⟩ := (w.property.2 p).meromorphicOrderAt_nonneg_iff.mp (ho p hp)
      exact ⟨g, fun _ ↦ ⟨hg, he⟩⟩
    · exact ⟨0, fun h ↦ (hp h).elim⟩
  choose g hg using hex
  let L := b4cov_lineEquiv hE
  let W : TangentBundle 𝓘(ℂ, E) C → ℂ :=
    fun t ↦ if t.1 ∈ S then L.symm t.2 * g t.1 0 else w t
  have hW : HurwitzPrymRR_IsLinear W := by
    intro p a u v
    change E at u v
    by_cases hp : p ∈ S
    · change (if p ∈ S then _ else _) = a * (if p ∈ S then _ else _) +
        (if p ∈ S then _ else _)
      simp only [if_pos hp]
      change L.symm (a • (u : E) + (v : E)) * g p 0 =
        a * (L.symm (u : E) * g p 0) + L.symm (v : E) * g p 0
      rw [map_add, map_smul]
      simp only [smul_eq_mul]
      ring
    · change (if p ∈ S then _ else _) = a * (if p ∈ S then _ else _) +
        (if p ∈ S then _ else _)
      simp only [if_neg hp]
      exact w.property.1 p a u v
  have he : ∀ p, HurwitzPrymRR_loc hE W p =ᶠ[𝓝[≠] 0] HurwitzPrymRR_loc hE w p :=
    RiemannRochEichler_loc_congr_off_finite hE S hS W w (by
      intro p hp u
      exact if_neg hp)
  refine ⟨⟨W, hW, fun p ↦ (w.property.2 p).congr (he p).symm⟩, he, ?_⟩
  intro p hp
  have heq := (he p).trans (hg p hp).2
  have hz : HurwitzPrymRR_loc hE W p 0 = g p 0 := by
    change W ⟨(extChartAt 𝓘(ℂ, E) p).symm
      (extChartAt 𝓘(ℂ, E) p p + b4cov_lineEquiv hE 0), _⟩ = _
    rw [map_zero, add_zero, extChartAt_to_inv, b4cov_vec_self]
    change (if p ∈ S then L.symm (L 1) * g p 0 else _) = _
    rw [if_pos hp, ContinuousLinearEquiv.symm_apply_apply, one_mul]
  exact (hg p hp).1.congr (eventuallyEq_nhds_of_eventuallyEq_nhdsNE heq hz).symm


/-- Subtracting a holomorphic differential preserves meromorphy and every residue. -/
lemma RiemannRochEichler_sub_holForm (hE : Module.finrank ℂ E = 1)
    (w : b4c_MeroForm E C hE) (v : b3_HolForm E C) :
    b4c_IsMeroForm hE (fun t ↦ w t - v.1 t) ∧
      ∀ p, b4c_res (hE := hE) (fun t ↦ w t - v.1 t) p = b4c_res (hE := hE) w p := by
  have hloc (p : C) : HurwitzPrymRR_loc hE (fun t ↦ w t - v.1 t) p =
      HurwitzPrymRR_loc hE w p - HurwitzPrymRR_loc hE v p := rfl
  constructor
  · refine ⟨?_, fun p ↦ ?_⟩
    · intro x a u t
      change w ⟨x, a • u + t⟩ - v.1 ⟨x, a • u + t⟩ = _
      rw [w.property.1 x a u t, v.property.2 x a u t]
      ring
    · rw [hloc]
      exact (w.property.2 p).sub (RiemannRochEichler_loc_analytic hE v p).meromorphicAt
  · intro p
    change residue (HurwitzPrymRR_loc hE (fun t ↦ w t - v.1 t) p) 0 = _
    rw [hloc, residue_sub (w.property.2 p)
      (RiemannRochEichler_loc_analytic hE v p).meromorphicAt,
      residue_eq_zero_of_analyticAt (RiemannRochEichler_loc_analytic hE v p), sub_zero]
    rfl


/-- A normalized evaluation basis removes auxiliary values without altering residues. -/
lemma RiemannRochEichler_normalize_meroForm (hE : Module.finrank ℂ E = 1)
    {ι : Type} [Fintype ι] (p : ι → C) (b : Module.Basis ι ℂ (b3_HolForm E C))
    (hb : ∀ i j, RiemannRochEichler_eval hE (p i) (b j) = if i = j then 1 else 0)
    (w : b4c_MeroForm E C hE) :
    ∃ (v : b3_HolForm E C) (w' : b4c_MeroForm E C hE),
      (∀ t, w' t = w t - v.1 t) ∧
      (∀ i, w' ⟨p i, b4cov_lineEquiv hE 1⟩ = 0) ∧
      ∀ x, b4c_res (hE := hE) w' x = b4c_res (hE := hE) w x := by
  classical
  let v : b3_HolForm E C := ∑ j, w ⟨p j, b4cov_lineEquiv hE 1⟩ • b j
  obtain ⟨hm, hr⟩ := RiemannRochEichler_sub_holForm hE w v
  refine ⟨v, ⟨fun t ↦ w t - v.1 t, hm⟩, fun _ ↦ rfl, ?_, hr⟩
  intro i
  change w ⟨p i, b4cov_lineEquiv hE 1⟩ - RiemannRochEichler_eval hE (p i) v = 0
  have hv : RiemannRochEichler_eval hE (p i) v = w ⟨p i, b4cov_lineEquiv hE 1⟩ := by
    simp only [v, map_sum, map_smul, hb, smul_eq_mul, mul_ite, mul_one, mul_zero,
      Finset.sum_ite_eq, Finset.mem_univ, ite_true]
  rw [hv, sub_self]


/-- Holomorphic normalization preserves simple poles and regularity at the auxiliary points. -/
lemma RiemannRochEichler_normalize_simple_poles (hE : Module.finrank ℂ E = 1)
    {ι : Type} [Fintype ι] (p : ι → C) (b : Module.Basis ι ℂ (b3_HolForm E C))
    (hb : ∀ i j, RiemannRochEichler_eval hE (p i) (b j) = if i = j then 1 else 0)
    (w : b4c_MeroForm E C hE)
    (ho : ∀ x, (-1 : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0)
    (ha : ∀ i, AnalyticAt ℂ (HurwitzPrymRR_loc hE w (p i)) 0) :
    ∃ w' : b4c_MeroForm E C hE,
      (∀ x, (-1 : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE w' x) 0) ∧
      (∀ i, AnalyticAt ℂ (HurwitzPrymRR_loc hE w' (p i)) 0) ∧
      (∀ i, w' ⟨p i, b4cov_lineEquiv hE 1⟩ = 0) ∧
      ∀ x, b4c_res (hE := hE) w' x = b4c_res (hE := hE) w x := by
  obtain ⟨v, w', he, hz, hr⟩ := RiemannRochEichler_normalize_meroForm hE p b hb w
  have hloc (x : C) : HurwitzPrymRR_loc hE w' x =
      HurwitzPrymRR_loc hE w x - HurwitzPrymRR_loc hE v x := by
    funext z
    exact he _
  refine ⟨w', ?_, ?_, hz, hr⟩
  · intro x
    rw [hloc, sub_eq_add_neg]
    have hv := (RiemannRochEichler_loc_analytic hE v x).neg
    have hn : (-1 : WithTop ℤ) ≤ 0 := by
      have hc : (-1 : WithTop ℤ) = ((-1 : ℤ) : WithTop ℤ) := by norm_cast
      rw [hc, show (0 : WithTop ℤ) = ((0 : ℤ) : WithTop ℤ) from rfl, WithTop.coe_le_coe]
      omega
    exact (le_min (ho x) (hn.trans hv.meromorphicOrderAt_nonneg)).trans
        (meromorphicOrderAt_add (w.property.2 x) hv.meromorphicAt)
  · intro i
    rw [hloc]
    exact (ha i).sub (RiemannRochEichler_loc_analytic hE v (p i))


/-- Third-kind differentials can be normalized at a prescribed holomorphic evaluation basis. -/
lemma RiemannRochEichler_normalized_third_kind
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) {ι : Type} [Fintype ι]
    (a : ι → C) (b : Module.Basis ι ℂ (b3_HolForm E C))
    (hb : ∀ i j, RiemannRochEichler_eval hE (a i) (b j) = if i = j then 1 else 0)
    (p q : C) (hpq : p ≠ q) (hap : ∀ i, a i ≠ p) (haq : ∀ i, a i ≠ q) :
    ∃ w : b4c_MeroForm E C hE,
      b4c_res (hE := hE) w p = -1 ∧ b4c_res (hE := hE) w q = 1 ∧
      (∀ x, (-1 : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0) ∧
      (∀ x, x ≠ p → x ≠ q → 0 ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0) ∧
      (∀ i, AnalyticAt ℂ (HurwitzPrymRR_loc hE w (a i)) 0) ∧
      ∀ i, w ⟨a i, b4cov_lineEquiv hE 1⟩ = 0 := by
  obtain ⟨w, hp, hq, ho, hout⟩ := RiemannRochEichler_third_kind hE p q hpq
  obtain ⟨v, he, ha⟩ := RiemannRochEichler_regularize_finite hE w (Set.range a)
    (Set.finite_range a) (by rintro x ⟨i, rfl⟩; exact hout (a i) (hap i) (haq i))
  have hvord (x : C) : meromorphicOrderAt (HurwitzPrymRR_loc hE v x) 0 =
      meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 := meromorphicOrderAt_congr (he x)
  have hvres (x : C) : b4c_res (hE := hE) v x = b4c_res (hE := hE) w x :=
    residue_congr_nhdsNE (he x)
  obtain ⟨u, huo, hua, huz, hur⟩ := RiemannRochEichler_normalize_simple_poles hE a b hb v
    (fun x ↦ by rw [hvord]; exact ho x) (fun i ↦ ha (a i) ⟨i, rfl⟩)
  refine ⟨u, (hur p).trans ((hvres p).trans hp),
    (hur q).trans ((hvres q).trans hq), huo, ?_, hua, huz⟩
  intro x hxp hxq
  apply (u.property.2 x).meromorphicOrderAt_nonneg_iff.mpr
  apply (RiemannRochEichler_simple_pole_removable (u.property.2 x) (huo x)).mp
  change b4c_res (hE := hE) u x = 0
  rw [hur, hvres]
  exact residue_eq_zero_of_meromorphicOrderAt_nonneg (hout x hxp hxq)


/-- The centred coefficient at zero is the differential evaluated on the chosen unit vector. -/
lemma RiemannRochEichler_loc_zero (hE : Module.finrank ℂ E = 1)
    (w : TangentBundle 𝓘(ℂ, E) C → ℂ) (p : C) :
    HurwitzPrymRR_loc hE w p 0 = w ⟨p, b4cov_lineEquiv hE 1⟩ := by
  change w ⟨(extChartAt 𝓘(ℂ, E) p).symm
    (extChartAt 𝓘(ℂ, E) p p + b4cov_lineEquiv hE 0), _⟩ = _
  rw [map_zero, add_zero, extChartAt_to_inv, b4cov_vec_self]


/-- Differential germs have representatives analytic away from a prescribed pole set. -/
lemma RiemannRochEichler_regularize_off_poles [T1Space C] [CompactSpace C]
    (hE : Module.finrank ℂ E = 1) (w : b4c_MeroForm E C hE) (P : Set C)
    (ho : ∀ p ∉ P, 0 ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE w p) 0) :
    ∃ v : b4c_MeroForm E C hE,
      (∀ p, HurwitzPrymRR_loc hE v p =ᶠ[𝓝[≠] 0] HurwitzPrymRR_loc hE w p) ∧
      (∀ p ∉ P, AnalyticAt ℂ (HurwitzPrymRR_loc hE v p) 0) ∧
      ∀ p, AnalyticAt ℂ (HurwitzPrymRR_loc hE w p) 0 →
        ∀ u, v ⟨p, u⟩ = w ⟨p, u⟩ := by
  classical
  let S := {p : C | ¬ AnalyticAt ℂ (HurwitzPrymRR_loc hE w p) 0} \ P
  have hS : S.Finite := (RiemannRochEichler_nonanalytic_finite hE w).sdiff
  obtain ⟨v, hv, hva⟩ := RiemannRochEichler_regularize_finite hE w S hS
    (fun p hp ↦ ho p hp.2)
  let W : TangentBundle 𝓘(ℂ, E) C → ℂ := fun t ↦ if t.1 ∈ S then v t else w t
  have hW : HurwitzPrymRR_IsLinear W := by
    intro p a u t
    change (if p ∈ S then _ else _) = a * (if p ∈ S then _ else _) +
      (if p ∈ S then _ else _)
    by_cases hp : p ∈ S
    · simp only [if_pos hp]
      exact v.property.1 p a u t
    · simp only [if_neg hp]
      exact w.property.1 p a u t
  have he : ∀ p, HurwitzPrymRR_loc hE W p =ᶠ[𝓝[≠] 0] HurwitzPrymRR_loc hE w p :=
    RiemannRochEichler_loc_congr_off_finite hE S hS W w (by
      intro p hp u
      exact if_neg hp)
  refine ⟨⟨W, hW, fun p ↦ (w.property.2 p).congr (he p).symm⟩, he, ?_, ?_⟩
  · intro p hp
    by_cases hpS : p ∈ S
    · have heq := (he p).trans (hv p).symm
      have hz : HurwitzPrymRR_loc hE W p 0 = HurwitzPrymRR_loc hE v p 0 := by
        rw [RiemannRochEichler_loc_zero, RiemannRochEichler_loc_zero]
        exact if_pos hpS
      exact (hva p hpS).congr (eventuallyEq_nhds_of_eventuallyEq_nhdsNE heq hz).symm
    · have ha : AnalyticAt ℂ (HurwitzPrymRR_loc hE w p) 0 := by
        by_contra h
        exact hpS ⟨h, hp⟩
      have hz : HurwitzPrymRR_loc hE W p 0 = HurwitzPrymRR_loc hE w p 0 := by
        rw [RiemannRochEichler_loc_zero, RiemannRochEichler_loc_zero]
        exact if_neg hpS
      exact ha.congr (eventuallyEq_nhds_of_eventuallyEq_nhdsNE (he p) hz).symm
  · intro p hp u
    have hpS : p ∉ S := fun h ↦ h.1 hp
    exact if_neg hpS


/-- Normalized third-kind differentials have representatives analytic at every point other than their poles. -/
lemma RiemannRochEichler_regular_third_kind
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) {ι : Type} [Fintype ι]
    (a : ι → C) (b : Module.Basis ι ℂ (b3_HolForm E C))
    (hb : ∀ i j, RiemannRochEichler_eval hE (a i) (b j) = if i = j then 1 else 0)
    (p q : C) (hpq : p ≠ q) (hap : ∀ i, a i ≠ p) (haq : ∀ i, a i ≠ q) :
    ∃ w : b4c_MeroForm E C hE,
      b4c_res (hE := hE) w p = -1 ∧ b4c_res (hE := hE) w q = 1 ∧
      (∀ x, (-1 : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0) ∧
      (∀ x, x ≠ p → x ≠ q → AnalyticAt ℂ (HurwitzPrymRR_loc hE w x) 0) ∧
      ∀ i, w ⟨a i, b4cov_lineEquiv hE 1⟩ = 0 := by
  obtain ⟨w, hp, hq, ho, hout, ha, hz⟩ :=
    RiemannRochEichler_normalized_third_kind hE a b hb p q hpq hap haq
  obtain ⟨v, he, hva, hv⟩ := RiemannRochEichler_regularize_off_poles hE w ({p, q} : Set C)
    (by intro x hx; exact hout x (fun h ↦ hx (Or.inl h)) (fun h ↦ hx (Or.inr h)))
  refine ⟨v, (residue_congr_nhdsNE (he p)).trans hp,
    (residue_congr_nhdsNE (he q)).trans hq, ?_, ?_, ?_⟩
  · intro x
    rw [meromorphicOrderAt_congr (he x)]
    exact ho x
  · intro x hxp hxq
    exact hva x (by simpa only [Set.mem_insert_iff, Set.mem_singleton_iff, not_or] using And.intro hxp hxq)
  · intro i
    exact (hv (a i) (ha i) (b4cov_lineEquiv hE 1)).trans (hz i)


/-- A Riemann--Roch space of dimension at least two contains a nonconstant meromorphic generator. -/
lemma RiemannRochEichler_meroFun_of_two_le_finrank [Nonempty C]
    (D : C →₀ ℤ) (hD : 2 ≤ Module.finrank ℂ (b4c_L (E := E) D)) :
    ∃ f : b4c_MeroFun E C, (∃ x y, f x ≠ f y) ∧
      (∀ x, x ∉ D.support → f x ≠ OnePoint.infty) ∧
      (∀ x, 0 ≤ b4c_ord E f x + D x) := by
  classical
  by_contra h
  let x₀ : C := Classical.choice inferInstance
  have hconst (f : b4c_MeroFun E C)
      (hf : ∀ x, x ∉ D.support → f x ≠ OnePoint.infty)
      (ho : ∀ x, 0 ≤ b4c_ord E f x + D x) : ∀ x y, f x = f y := by
    intro x y
    by_contra hxy
    exact h ⟨f, ⟨x, y, hxy⟩, hf, ho⟩
  have hle : b4c_L (E := E) D ≤
      ℂ ∙ (1 : {x : C // x ∉ D.support} → ℂ) := by
    apply Submodule.span_le.mpr
    rintro g ⟨f, _, hf, ho, rfl⟩
    apply Submodule.mem_span_singleton.mpr
    refine ⟨(f x₀).elim 0 id, ?_⟩
    funext x
    simp only [Pi.smul_apply, Pi.one_apply, smul_eq_mul, mul_one, hconst f hf ho x.1 x₀]
  have hdim := Submodule.finrank_mono hle
  have hone : Module.finrank ℂ (ℂ ∙ (1 : {x : C // x ∉ D.support} → ℂ)) ≤ 1 := by
    simpa using finrank_span_le_card ({(1 : {x : C // x ∉ D.support} → ℂ)} : Set _)
  omega


/-- Riemann--Roch supplies a nonconstant meromorphic function with poles bounded by a large divisor. -/
lemma RiemannRochEichler_meroFun_of_large_degree
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (hD : (Module.finrank ℂ (b3_HolForm E C) : ℤ) + 1 ≤ b4c_deg D) :
    ∃ f : b4c_MeroFun E C, (∃ x y, f x ≠ f y) ∧
      (∀ x, x ∉ D.support → f x ≠ OnePoint.infty) ∧
      (∀ x, 0 ≤ b4c_ord E f x + D x) := by
  obtain ⟨w, hw, hgw⟩  := b4c_exists_meroForm_aux (C := C) hE
  have hRR := b4c_riemannRoch_aux hE D w hw hgw
  have hnonneg : (0 : ℤ) ≤ Module.finrank ℂ
      (b4c_L (E := E) (b4c_divForm (hE := hE) w - D)) := Int.natCast_nonneg _
  apply RiemannRochEichler_meroFun_of_two_le_finrank D
  omega


/-- An analytic factor multiplies a simple-pole residue by its value at the centre. -/
lemma RiemannRochEichler_residue_mul_analytic {f g : ℂ → ℂ} {z : ℂ}
    (hf : MeromorphicAt f z) (ho : (-1 : WithTop ℤ) ≤ meromorphicOrderAt f z)
    (hg : AnalyticAt ℂ g z) :
    residue (f * g) z = residue f z * g z := by
  apply residue_eq_of_tendsto_sub_mul (hf.mul hg.meromorphicAt)
  have h := (tendsto_sub_mul_nhds_residue hf ho).mul
    (hg.continuousAt.tendsto.mono_left nhdsWithin_le_nhds)
  convert h using 1
  funext t
  simp only [Pi.mul_apply]
  ring


/-- A meromorphic function with only simple poles at normalized evaluation points is constant. -/
lemma RiemannRochEichler_constant_of_auxiliary_poles
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) {ι : Type}
    (a : ι → C) (b : Module.Basis ι ℂ (b3_HolForm E C))
    (hb : ∀ i j, RiemannRochEichler_eval hE (a i) (b j) = if i = j then 1 else 0)
    (f : b4c_MeroFun E C)
    (ho : ∀ x, (-1 : WithTop ℤ) ≤ meromorphicOrderAt
      (RiemannRochEichler_functionLocal hE f x) 0)
    (hout : ∀ x, x ∉ Set.range a → 0 ≤ meromorphicOrderAt
      (RiemannRochEichler_functionLocal hE f x) 0) :
    ∀ x y, f x = f y := by
  classical
  have hres (i : ι) : residue (RiemannRochEichler_functionLocal hE f (a i)) 0 = 0 := by
    let v : b4c_MeroForm E C hE := ⟨(b i).1, (b i).property.2,
      fun x ↦ (RiemannRochEichler_loc_analytic hE (b i) x).meromorphicAt⟩
    let w : b4c_MeroForm E C hE := ⟨fun t ↦ (f t.1).elim 0 id * v t,
      RiemannRochEichler_mul_meroForm hE f v⟩
    have hr (x : C) : b4c_res (hE := hE) w x =
        residue (RiemannRochEichler_functionLocal hE f x) 0 *
          RiemannRochEichler_eval hE x (b i) := by
      have hf : MeromorphicAt (RiemannRochEichler_functionLocal hE f x) 0 :=
        RiemannRochEichler_fun_loc_meromorphic hE f x
      have h := RiemannRochEichler_residue_mul_analytic hf (ho x)
        (RiemannRochEichler_loc_analytic hE (b i) x)
      change residue (RiemannRochEichler_functionLocal hE f x *
        HurwitzPrymRR_loc hE (b i).1 x) 0 = _
      rw [h]
      congr 1
      change (b i).1 ⟨(extChartAt 𝓘(ℂ, E) x).symm
        (extChartAt 𝓘(ℂ, E) x x + b4cov_lineEquiv hE 0), _⟩ = _
      rw [map_zero, add_zero, extChartAt_to_inv, b4cov_vec_self]
      rfl
    have hs : Function.support (b4c_res (hE := hE) w) ⊆ ({a i} : Finset C) := by
      intro x hx
      by_contra hn
      have hxi : x ≠ a i := by simpa only [Finset.mem_coe, Finset.mem_singleton] using hn
      apply hx
      rw [hr]
      by_cases hxA : x ∈ Set.range a
      · obtain ⟨j, rfl⟩ := hxA
        have hji : j ≠ i := fun h ↦ hxi (congrArg a h)
        rw [hb, if_neg hji, mul_zero]
      · rw [residue_eq_zero_of_meromorphicOrderAt_nonneg (hout x hxA), zero_mul]
    have hsum := b4c_residue_sum_aux hE w
    rw [finsum_eq_sum_of_support_subset _ hs, Finset.sum_singleton, hr, hb,
      if_pos rfl, mul_one] at hsum
    exact hsum
  have hn (x : C) : 0 ≤ meromorphicOrderAt (RiemannRochEichler_functionLocal hE f x) 0 := by
    by_cases hx : x ∈ Set.range a
    · obtain ⟨i, rfl⟩ := hx
      apply (RiemannRochEichler_fun_loc_meromorphic hE f (a i)).meromorphicOrderAt_nonneg_iff.mpr
      exact (RiemannRochEichler_simple_pole_removable
        (RiemannRochEichler_fun_loc_meromorphic hE f (a i)) (ho (a i))).mp (hres i)
    · exact hout x hx
  by_contra h
  push_neg at h
  have hf0 : ∃ x, f x ≠ (0 : ℂ) := by
    obtain ⟨x, y, hxy⟩ := h
    by_cases hx : f x = (0 : ℂ)
    · exact ⟨y, fun hy ↦ hxy (hx.trans hy.symm)⟩
    · exact ⟨x, hx⟩
  obtain ⟨x, hx⟩ := b4cov_surjective (by simp : Module.finrank ℂ ℂ = 1)
    f f.property.1 h OnePoint.infty
  have hpos := b4cov_ramIndex_pos f f.property.1 h x
  have hn' := hn x
  rw [← RiemannRochEichler_ord_eq_local hE f hf0 x] at hn'
  have hx0 : f x ≠ (0 : ℂ) := by rw [hx]; exact OnePoint.infty_ne_coe 0
  rw [b4c_ord, if_neg hx0, if_pos hx] at hn'
  have hi : (0 : ℤ) ≤ -(b4_ramIndex E ℂ f x : ℤ) := WithTop.coe_le_coe.mp hn'
  omega


/-- Adding one point to normalized evaluation points supplies a function with a genuine pole there. -/
lemma RiemannRochEichler_function_with_extra_pole
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) {ι : Type} [Fintype ι]
    (a : ι → C) (ha : Function.Injective a) (b : Module.Basis ι ℂ (b3_HolForm E C))
    (hb : ∀ i j, RiemannRochEichler_eval hE (a i) (b j) = if i = j then 1 else 0)
    (y : C) (hy : y ∉ Set.range a) :
    ∃ f : b4c_MeroFun E C, f y = OnePoint.infty ∧
      (∀ x, (-1 : WithTop ℤ) ≤ meromorphicOrderAt
        (RiemannRochEichler_functionLocal hE f x) 0) ∧
      (∀ x, x ∉ Set.range a → x ≠ y → 0 ≤ meromorphicOrderAt
        (RiemannRochEichler_functionLocal hE f x) 0) ∧
      residue (RiemannRochEichler_functionLocal hE f y) 0 ≠ 0 := by
  classical
  let A : C →₀ ℤ := ∑ i, Finsupp.single (a i) 1
  let D := A + Finsupp.single y 1
  have hdeg (s : Finset ι) : b4c_deg (∑ i ∈ s, Finsupp.single (a i) 1) = (s.card : ℤ) := by
    induction s using Finset.induction_on with
    | empty => simp [b4c_deg]
    | @insert i s hi ih =>
      rw [Finset.sum_insert hi]
      have he : b4c_deg (Finsupp.single (a i) 1 + ∑ j ∈ s, Finsupp.single (a j) 1) =
          1 + b4c_deg (∑ j ∈ s, Finsupp.single (a j) 1) := by
        simp [b4c_deg, Finsupp.sum_add_index]
      rw [he, ih, Finset.card_insert_of_notMem hi]
      simp only [Nat.cast_add, Nat.cast_one]
      omega
  have hDdeg : (Module.finrank ℂ (b3_HolForm E C) : ℤ) + 1 ≤ b4c_deg D := by
    have hAdeg : b4c_deg A = Fintype.card ι := hdeg Finset.univ
    have he : b4c_deg D = b4c_deg A + 1 := by simp [D, b4c_deg, Finsupp.sum_add_index]
    rw [he, hAdeg, Module.finrank_eq_card_basis b]
  have hAval (x : C) : A x = if x ∈ Set.range a then 1 else 0 := by
    change (∑ i, Finsupp.single (a i) (1 : ℤ)) x = _
    rw [Finsupp.finset_sum_apply]
    by_cases hx : x ∈ Set.range a
    · obtain ⟨i, rfl⟩ := hx
      rw [if_pos ⟨i, rfl⟩, Finset.sum_eq_single i]
      · simp
      · intro j hj hji
        simp [Finsupp.single_apply, ha.ne hji]
      · simp
    · rw [if_neg hx]
      apply Finset.sum_eq_zero
      intro i hi
      exact Finsupp.single_eq_of_ne (fun h ↦ hx ⟨i, h.symm⟩)
  have hDle (x : C) : D x ≤ 1 := by
    change A x + Finsupp.single y 1 x ≤ 1
    rw [hAval]
    by_cases hxy : x = y
    · subst x
      simp [hy]
    · simp only [Finsupp.single_eq_of_ne hxy]
      split <;> omega
  obtain ⟨f, hnc, _, hfo⟩ := RiemannRochEichler_meroFun_of_large_degree hE D hDdeg
  have hf0 : ∃ x, f x ≠ (0 : ℂ) := by
    obtain ⟨x, z, hxz⟩ := hnc
    by_cases hx : f x = (0 : ℂ)
    · exact ⟨z, fun hz ↦ hxz (hx.trans hz.symm)⟩
    · exact ⟨x, hx⟩
  have ho (x : C) : (-1 : WithTop ℤ) ≤ meromorphicOrderAt
      (RiemannRochEichler_functionLocal hE f x) 0 := by
    rw [← RiemannRochEichler_ord_eq_local hE f hf0 x]
    have hi : (-1 : ℤ) ≤ b4c_ord E f x := by have := hfo x; have := hDle x; omega
    have hc : (-1 : WithTop ℤ) = ((-1 : ℤ) : WithTop ℤ) := by norm_cast
    rw [hc]
    exact WithTop.coe_le_coe.mpr hi
  have hout (x : C) (hx : x ∉ Set.range a) (hxy : x ≠ y) :
      0 ≤ meromorphicOrderAt (RiemannRochEichler_functionLocal hE f x) 0 := by
    rw [← RiemannRochEichler_ord_eq_local hE f hf0 x]
    have he : D x = 0 := by
      change A x + Finsupp.single y 1 x = 0
      rw [hAval, if_neg hx, Finsupp.single_eq_of_ne hxy, add_zero]
    have hi : (0 : ℤ) ≤ b4c_ord E f x := by simpa only [he, add_zero] using hfo x
    exact WithTop.coe_le_coe.mpr hi
  have hny : ¬ 0 ≤ meromorphicOrderAt (RiemannRochEichler_functionLocal hE f y) 0 := by
    intro hn
    have hc := RiemannRochEichler_constant_of_auxiliary_poles hE a b hb f ho (by
      intro x hx
      by_cases hxy : x = y
      · simpa only [hxy] using hn
      · exact hout x hx hxy)
    obtain ⟨x, z, hxz⟩ := hnc
    exact hxz (hc x z)
  have hfy : f y = OnePoint.infty := by
    by_contra h
    apply hny
    rw [← RiemannRochEichler_ord_eq_local hE f hf0 y]
    have hi : (0 : ℤ) ≤ b4c_ord E f y := by
      rw [b4c_ord]
      split
      · exact Int.natCast_nonneg _
      · exact le_rfl
    exact WithTop.coe_le_coe.mpr hi
  refine ⟨f, hfy, ho, hout, ?_⟩
  intro hr
  apply hny
  apply (RiemannRochEichler_fun_loc_meromorphic hE f y).meromorphicOrderAt_nonneg_iff.mpr
  exact (RiemannRochEichler_simple_pole_removable
    (RiemannRochEichler_fun_loc_meromorphic hE f y) (ho y)).mp hr


/-- Away from infinity, a sphere-valued meromorphic function has an analytic scalar coefficient. -/
lemma RiemannRochEichler_functionLocal_analytic
    (hE : Module.finrank ℂ E = 1) (f : b4c_MeroFun E C) (x : C)
    (hx : f x ≠ OnePoint.infty) :
    AnalyticAt ℂ (RiemannRochEichler_functionLocal hE f x) 0 := by
  have he := RiemannRochEichler_functionLocal_target_germ hE f f.property.1 x
  rw [if_neg hx] at he
  have hz : RiemannRochEichler_functionLocal hE f x 0 =
      RiemannRochEichler_targetLocal hE f x 0 := by
    rw [RiemannRochEichler_targetLocal_zero]
    simp only [RiemannRochEichler_functionLocal, map_zero, add_zero, extChartAt_to_inv]
  exact (RiemannRochEichler_targetLocal_analytic hE f f.property.1 x).congr
    (eventuallyEq_nhds_of_eventuallyEq_nhdsNE he hz).symm


/-- The scalar germ of a sphere-valued meromorphic function has no pole exactly at finite values. -/
lemma RiemannRochEichler_functionLocal_nonneg_iff [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (f : b4c_MeroFun E C) (x : C) :
    0 ≤ meromorphicOrderAt (RiemannRochEichler_functionLocal hE f x) 0 ↔
      f x ≠ OnePoint.infty := by
  constructor
  · intro hn hx
    obtain ⟨z, hz⟩ := f.property.2
    have hnc : ∃ p q, f p ≠ f q := ⟨x, z, fun h ↦ hz (h.symm.trans hx)⟩
    have hf0 : ∃ p, f p ≠ (0 : ℂ) := ⟨x, by rw [hx]; exact OnePoint.infty_ne_coe 0⟩
    have hp := b4cov_ramIndex_pos f f.property.1 hnc x
    rw [← RiemannRochEichler_ord_eq_local hE f hf0 x] at hn
    have hx0 : f x ≠ (0 : ℂ) := by rw [hx]; exact OnePoint.infty_ne_coe 0
    rw [b4c_ord, if_neg hx0, if_pos hx] at hn
    have hi : (0 : ℤ) ≤ -(b4_ramIndex E ℂ f x : ℤ) := WithTop.coe_le_coe.mp hn
    omega
  · intro hx
    exact (RiemannRochEichler_functionLocal_analytic hE f x hx).meromorphicOrderAt_nonneg


/-- The residue after division by the coordinate recovers the value of an analytic representative. -/
lemma RiemannRochEichler_residue_germ_value {f g : ℂ → ℂ}
    (hg : AnalyticAt ℂ g 0) (he : f =ᶠ[𝓝[≠] 0] g) :
    residue (fun z ↦ f z / z) 0 = g 0 := by
  have he' : (fun z ↦ f z / z) =ᶠ[𝓝[≠] 0] (fun z ↦ g z / z) := by
    filter_upwards [he] with z hz
    rw [hz]
  rw [residue_congr_nhdsNE he']
  simpa using residue_div_sub_pow_of_analyticAt hg 0


/-- A pole-free meromorphic factor contributes its analytic germ value to a simple-pole residue. -/
lemma RiemannRochEichler_residue_mul_regular {f g : ℂ → ℂ}
    (hf : MeromorphicAt f 0) (ho : (-1 : WithTop ℤ) ≤ meromorphicOrderAt f 0)
    (hg : MeromorphicAt g 0) (hgo : 0 ≤ meromorphicOrderAt g 0) :
    residue (f * g) 0 = residue f 0 * residue (fun z ↦ g z / z) 0 := by
  obtain ⟨g', ha, he⟩ := hg.meromorphicOrderAt_nonneg_iff.mp hgo
  have hp : f * g =ᶠ[𝓝[≠] 0] f * g' := by
    filter_upwards [he] with z hz
    exact congrArg (fun t ↦ f z * t) hz
  rw [residue_congr_nhdsNE hp, RiemannRochEichler_residue_mul_analytic hf ho ha,
    RiemannRochEichler_residue_germ_value ha he]


/-- The residue theorem expresses a normalized third-kind coefficient using an extra-pole function. -/
lemma RiemannRochEichler_third_kind_reciprocity
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) {ι : Type} (a : ι → C)
    (p q y : C) (hpq : p ≠ q) (hyp : y ≠ p) (hyq : y ≠ q)
    (f : b4c_MeroFun E C) (w : b4c_MeroForm E C hE)
    (hfp : f p ≠ OnePoint.infty) (hfq : f q ≠ OnePoint.infty)
    (hfo : ∀ x, (-1 : WithTop ℤ) ≤ meromorphicOrderAt
      (RiemannRochEichler_functionLocal hE f x) 0)
    (hfout : ∀ x, x ∉ Set.range a → x ≠ y → 0 ≤ meromorphicOrderAt
      (RiemannRochEichler_functionLocal hE f x) 0)
    (hwp : b4c_res (hE := hE) w p = -1) (hwq : b4c_res (hE := hE) w q = 1)
    (hwo : ∀ x, (-1 : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0)
    (hwout : ∀ x, x ≠ p → x ≠ q → 0 ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0)
    (hwa : ∀ i, AnalyticAt ℂ (HurwitzPrymRR_loc hE w (a i)) 0)
    (hwz : ∀ i, w ⟨a i, b4cov_lineEquiv hE 1⟩ = 0) :
    residue (RiemannRochEichler_functionLocal hE f y) 0 *
        residue (fun z ↦ HurwitzPrymRR_loc hE w y z / z) 0 =
      (f p).elim 0 id - (f q).elim 0 id := by
  classical
  let v : b4c_MeroForm E C hE := ⟨fun t ↦ (f t.1).elim 0 id * w t,
    RiemannRochEichler_mul_meroForm hE f w⟩
  have hfm (x : C) : MeromorphicAt (RiemannRochEichler_functionLocal hE f x) 0 :=
    RiemannRochEichler_fun_loc_meromorphic hE f x
  have hloc (x : C) : HurwitzPrymRR_loc hE v x =
      RiemannRochEichler_functionLocal hE f x * HurwitzPrymRR_loc hE w x := rfl
  have hr (x : C) (hx : f x ≠ OnePoint.infty) :
      b4c_res (hE := hE) v x = b4c_res (hE := hE) w x * (f x).elim 0 id := by
    change residue (HurwitzPrymRR_loc hE v x) 0 = _
    rw [hloc, mul_comm, RiemannRochEichler_residue_mul_analytic (w.property.2 x)
      (hwo x) (RiemannRochEichler_functionLocal_analytic hE f x hx)]
    simp only [RiemannRochEichler_functionLocal, map_zero, add_zero, extChartAt_to_inv]
    rfl
  have hry : b4c_res (hE := hE) v y =
      residue (RiemannRochEichler_functionLocal hE f y) 0 *
        residue (fun z ↦ HurwitzPrymRR_loc hE w y z / z) 0 :=
    RiemannRochEichler_residue_mul_regular (hfm y) (hfo y) (w.property.2 y) (hwout y hyp hyq)
  have hs : Function.support (b4c_res (hE := hE) v) ⊆ ({p, q, y} : Finset C) := by
    intro x hx
    by_contra hn
    have hx' : x ≠ p ∧ x ≠ q ∧ x ≠ y := by
      simpa only [Finset.mem_coe, Finset.mem_insert, Finset.mem_singleton, not_or] using hn
    apply hx
    change residue (HurwitzPrymRR_loc hE v x) 0 = 0
    rw [hloc]
    by_cases hxA : x ∈ Set.range a
    · obtain ⟨i, rfl⟩ := hxA
      rw [RiemannRochEichler_residue_mul_analytic (hfm (a i)) (hfo (a i)) (hwa i)]
      have hz : HurwitzPrymRR_loc hE w (a i) 0 = 0 := by
        change w ⟨(extChartAt 𝓘(ℂ, E) (a i)).symm
          (extChartAt 𝓘(ℂ, E) (a i) (a i) + b4cov_lineEquiv hE 0), _⟩ = _
        rw [map_zero, add_zero, extChartAt_to_inv, b4cov_vec_self]
        exact hwz i
      rw [hz, mul_zero]
    · apply residue_eq_zero_of_meromorphicOrderAt_nonneg
      rw [meromorphicOrderAt_mul (hfm x) (w.property.2 x)]
      exact add_nonneg (hfout x hxA hx'.2.2) (hwout x hx'.1 hx'.2.1)
  have hsum := b4c_residue_sum_aux hE v
  rw [finsum_eq_sum_of_support_subset _ hs] at hsum
  have hpmem : p ∉ ({q, y} : Finset C) := by simp [hpq, Ne.symm hyp]
  rw [Finset.sum_insert hpmem, Finset.sum_pair (Ne.symm hyq),
    hr p hfp, hr q hfq, hwp, hwq, hry] at hsum
  linear_combination hsum


/-- At a fixed regular point, normalized third-kind coefficients are represented by one meromorphic function. -/
lemma RiemannRochEichler_normalized_coefficient_representation
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) {ι : Type} [Fintype ι]
    (a : ι → C) (ha : Function.Injective a) (b : Module.Basis ι ℂ (b3_HolForm E C))
    (hb : ∀ i j, RiemannRochEichler_eval hE (a i) (b j) = if i = j then 1 else 0)
    (q y : C) (hq : q ∉ Set.range a) (hy : y ∉ Set.range a) (hyq : y ≠ q) :
    ∃ f : b4c_MeroFun E C,
      residue (RiemannRochEichler_functionLocal hE f y) 0 ≠ 0 ∧
      ∀ (p : C), p ∉ Set.range a → p ≠ q → p ≠ y →
      ∀ (w : b4c_MeroForm E C hE),
      b4c_res (hE := hE) w p = -1 → b4c_res (hE := hE) w q = 1 →
      (∀ x, (-1 : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0) →
      (∀ x, x ≠ p → x ≠ q → 0 ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0) →
      (∀ i, AnalyticAt ℂ (HurwitzPrymRR_loc hE w (a i)) 0) →
      (∀ i, w ⟨a i, b4cov_lineEquiv hE 1⟩ = 0) →
      residue (fun z ↦ HurwitzPrymRR_loc hE w y z / z) 0 =
        ((f p).elim 0 id - (f q).elim 0 id) /
          residue (RiemannRochEichler_functionLocal hE f y) 0 := by
  obtain ⟨f, _, hfo, hfout, hr⟩ := RiemannRochEichler_function_with_extra_pole hE a ha b hb y hy
  refine ⟨f, hr, ?_⟩
  intro p hp hpq hpy w hwp hwq hwo hwout hwa hwz
  have hfp := (RiemannRochEichler_functionLocal_nonneg_iff hE f p).mp (hfout p hp hpy)
  have hfq := (RiemannRochEichler_functionLocal_nonneg_iff hE f q).mp (hfout q hq (Ne.symm hyq))
  have he := RiemannRochEichler_third_kind_reciprocity hE a p q y hpq (Ne.symm hpy) hyq
    f w hfp hfq hfo hfout hwp hwq hwo hwout hwa hwz
  apply (eq_div_iff hr).mpr
  simpa only [mul_comm] using he


/-- Finite changes of scalar surface functions preserve their punctured centred coordinate germs. -/
lemma RiemannRochEichler_scalar_loc_congr_off_finite [T1Space C]
    (hE : Module.finrank ℂ E = 1) (S : Set C) (hS : S.Finite)
    (f g : C → ℂ) (he : ∀ x ∉ S, f x = g x) (p : C) :
    (fun z ↦ f ((extChartAt 𝓘(ℂ, E) p).symm
      (extChartAt 𝓘(ℂ, E) p p + b4cov_lineEquiv hE z))) =ᶠ[𝓝[≠] 0]
    (fun z ↦ g ((extChartAt 𝓘(ℂ, E) p).symm
      (extChartAt 𝓘(ℂ, E) p p + b4cov_lineEquiv hE z))) := by
  have ha : ∀ᶠ x in 𝓝[≠] p, x ∉ S := by
    have hs : (S \ {p})ᶜ ∈ 𝓝 p :=
      hS.sdiff.isClosed.isOpen_compl.mem_nhds (fun h ↦ h.2 rfl)
    have hs' : ∀ᶠ x in 𝓝 p, x ∉ S \ {p} := hs
    filter_upwards [hs'.filter_mono nhdsWithin_le_nhds, self_mem_nhdsWithin] with x hx hxp
    exact fun h ↦ hx ⟨h, hxp⟩
  filter_upwards [RiemannRochEichler_inverse_coordinate_punctured hE p ha] with z hz
  exact he _ hz


/-- Normalized third-kind coefficients at a fixed regular point vary meromorphically with the pole. -/
lemma RiemannRochEichler_normalized_parameter_meromorphic
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) {ι : Type} [Fintype ι]
    (a : ι → C) (ha : Function.Injective a) (b : Module.Basis ι ℂ (b3_HolForm E C))
    (hb : ∀ i j, RiemannRochEichler_eval hE (a i) (b j) = if i = j then 1 else 0)
    (q y : C) (hq : q ∉ Set.range a) (hy : y ∉ Set.range a) (hyq : y ≠ q)
    (K : C → b4c_MeroForm E C hE)
    (hK : ∀ p, p ∉ Set.range a → p ≠ q →
      b4c_res (hE := hE) (K p) p = -1 ∧ b4c_res (hE := hE) (K p) q = 1 ∧
      (∀ x, (-1 : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (K p) x) 0) ∧
      (∀ x, x ≠ p → x ≠ q → 0 ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (K p) x) 0) ∧
      (∀ i, AnalyticAt ℂ (HurwitzPrymRR_loc hE (K p) (a i)) 0) ∧
      ∀ i, K p ⟨a i, b4cov_lineEquiv hE 1⟩ = 0) (r : C) :
    MeromorphicAt (fun t ↦ residue (fun z ↦
      HurwitzPrymRR_loc hE
        (K ((extChartAt 𝓘(ℂ, E) r).symm
          (extChartAt 𝓘(ℂ, E) r r + b4cov_lineEquiv hE t))) y z / z) 0) 0 := by
  obtain ⟨f, hr, hf⟩ := RiemannRochEichler_normalized_coefficient_representation hE a ha b hb
    q y hq hy hyq
  let S := Set.range a ∪ ({q, y} : Set C)
  have hS : S.Finite := (Set.finite_range a).union (Set.toFinite _)
  have he : ∀ p ∉ S,
      residue (fun z ↦ HurwitzPrymRR_loc hE (K p) y z / z) 0 =
        ((f p).elim 0 id - (f q).elim 0 id) /
          residue (RiemannRochEichler_functionLocal hE f y) 0 := by
    intro p hp
    have hpA : p ∉ Set.range a := fun h ↦ hp (Or.inl h)
    have hpq : p ≠ q := fun h ↦ hp (Or.inr (Or.inl h))
    have hpy : p ≠ y := fun h ↦ hp (Or.inr (Or.inr h))
    obtain ⟨h₁, h₂, h₃, h₄, h₅, h₆⟩ := hK p hpA hpq
    exact hf p hpA hpq hpy (K p) h₁ h₂ h₃ h₄ h₅ h₆
  have hloc := RiemannRochEichler_scalar_loc_congr_off_finite hE S hS _ _ he r
  have hm : MeromorphicAt (fun t ↦
      (RiemannRochEichler_functionLocal hE f r t - (f q).elim 0 id) /
        residue (RiemannRochEichler_functionLocal hE f y) 0) 0 :=
    ((RiemannRochEichler_fun_loc_meromorphic hE f r).sub (MeromorphicAt.const _ _)).div
      (MeromorphicAt.const _ _)
  exact hm.congr hloc.symm


/-- A normalized family can be chosen analytic away from its two poles with meromorphic parameter coefficients. -/
lemma RiemannRochEichler_regular_kernel_family
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) {ι : Type} [Fintype ι]
    (a : ι → C) (ha : Function.Injective a) (b : Module.Basis ι ℂ (b3_HolForm E C))
    (hb : ∀ i j, RiemannRochEichler_eval hE (a i) (b j) = if i = j then 1 else 0)
    (q : C) (hq : q ∉ Set.range a) :
    ∃ K : C → b4c_MeroForm E C hE,
      (∀ p, p ∉ Set.range a → p ≠ q →
        b4c_res (hE := hE) (K p) p = -1 ∧ b4c_res (hE := hE) (K p) q = 1 ∧
        (∀ x, (-1 : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (K p) x) 0) ∧
        (∀ x, x ≠ p → x ≠ q → AnalyticAt ℂ (HurwitzPrymRR_loc hE (K p) x) 0) ∧
        ∀ i, K p ⟨a i, b4cov_lineEquiv hE 1⟩ = 0) ∧
      ∀ y, y ∉ Set.range a → y ≠ q → ∀ r,
        MeromorphicAt (fun t ↦ residue (fun z ↦
          HurwitzPrymRR_loc hE
            (K ((extChartAt 𝓘(ℂ, E) r).symm
              (extChartAt 𝓘(ℂ, E) r r + b4cov_lineEquiv hE t))) y z / z) 0) 0 := by
  classical
  let w₀ : b4c_MeroForm E C hE := ⟨fun _ ↦ 0, by
    constructor
    · intro x c u v
      simp
    · intro x
      exact analyticAt_const.meromorphicAt⟩
  have hex (p : C) : ∃ w : b4c_MeroForm E C hE,
      p ∉ Set.range a → p ≠ q →
      b4c_res (hE := hE) w p = -1 ∧ b4c_res (hE := hE) w q = 1 ∧
      (∀ x, (-1 : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0) ∧
      (∀ x, x ≠ p → x ≠ q → AnalyticAt ℂ (HurwitzPrymRR_loc hE w x) 0) ∧
      ∀ i, w ⟨a i, b4cov_lineEquiv hE 1⟩ = 0 := by
    by_cases hp : p ∉ Set.range a
    · by_cases hpq : p ≠ q
      · obtain ⟨w, hw⟩ := RiemannRochEichler_regular_third_kind hE a b hb p q hpq
          (fun i h ↦ hp ⟨i, h⟩) (fun i h ↦ hq ⟨i, h⟩)
        exact ⟨w, fun _ _ ↦ hw⟩
      · exact ⟨w₀, fun _ h ↦ (hpq h).elim⟩
    · exact ⟨w₀, fun h _ ↦ (hp h).elim⟩
  choose K hK using hex
  refine ⟨K, hK, ?_⟩
  intro y hy hyq r
  apply RiemannRochEichler_normalized_parameter_meromorphic hE a ha b hb q y hq hy hyq K _ r
  intro p hp hpq
  obtain ⟨h₁, h₂, h₃, h₄, h₅⟩ := hK p hp hpq
  exact ⟨h₁, h₂, h₃, fun x hxp hxq ↦ (h₄ x hxp hxq).meromorphicOrderAt_nonneg,
    fun i ↦ h₄ (a i) (fun h ↦ hp ⟨i, h⟩) (fun h ↦ hq ⟨i, h⟩), h₅⟩


/-- Riemann--Roch supplies a nonconstant meromorphic function whose only pole is a prescribed point. -/
lemma RiemannRochEichler_function_with_single_pole
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (q : C) :
    ∃ f : b4c_MeroFun E C, (∃ x y, f x ≠ f y) ∧ f q = OnePoint.infty ∧
      (∀ x, x ≠ q → f x ≠ OnePoint.infty) ∧
      ∀ x, -((Module.finrank ℂ (b3_HolForm E C) + 1 : ℕ) : ℤ) ≤ b4c_ord E f x := by
  classical
  let m := Module.finrank ℂ (b3_HolForm E C) + 1
  let D : C →₀ ℤ := Finsupp.single q (m : ℤ)
  have hdeg : (Module.finrank ℂ (b3_HolForm E C) : ℤ) + 1 ≤ b4c_deg D := by
    have he : b4c_deg D = (m : ℤ) := by simp [D, b4c_deg]
    rw [he]
    simp only [m, Nat.cast_add, Nat.cast_one]
    exact le_rfl
  obtain ⟨f, hnc, hf, ho⟩ := RiemannRochEichler_meroFun_of_large_degree hE D hdeg
  have hout (x : C) (hx : x ≠ q) : f x ≠ OnePoint.infty := by
    apply hf x
    simp only [Finsupp.mem_support_iff, not_not]
    exact Finsupp.single_eq_of_ne hx
  have hq : f q = OnePoint.infty := by
    obtain ⟨x, hx⟩ := b4cov_surjective (by simp : Module.finrank ℂ ℂ = 1)
      f f.property.1 hnc OnePoint.infty
    by_cases hxq : x = q
    · simpa only [hxq] using hx
    · exact (hout x hxq hx).elim
  refine ⟨f, hnc, hq, hout, ?_⟩
  intro x
  have hb : D x ≤ (m : ℤ) := by
    by_cases hx : x = q
    · subst x
      simp [D]
    · rw [show D x = 0 from Finsupp.single_eq_of_ne hx]
      exact Int.natCast_nonneg m
  have := ho x
  change -(m : ℤ) ≤ b4c_ord E f x
  omega


/-- Centred source and target coordinates intertwine a holomorphic map near the source centre. -/
lemma RiemannRochEichler_graph_coordinates
    (hE : Module.finrank ℂ E = 1) (f : C → C)
    (hf : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω f) (p e : C) (hfp : f p = e) :
    let k := fun z ↦ (extChartAt 𝓘(ℂ, E) p).symm
      (extChartAt 𝓘(ℂ, E) p p + b4cov_lineEquiv hE z)
    let j := fun z ↦ (extChartAt 𝓘(ℂ, E) e).symm
      (extChartAt 𝓘(ℂ, E) e e + b4cov_lineEquiv hE z)
    let T := b4cov_transport hE hE (b4cov_expr E E f p e) (extChartAt 𝓘(ℂ, E) p p)
    (fun z ↦ j (T z)) =ᶠ[𝓝 0] (fun z ↦ f (k z)) := by
  let φ := extChartAt 𝓘(ℂ, E) p
  let ψ := extChartAt 𝓘(ℂ, E) e
  let j := fun z ↦ ψ.symm (ψ e + b4cov_lineEquiv hE z)
  let k := fun z ↦ φ.symm (φ p + b4cov_lineEquiv hE z)
  let T := b4cov_transport hE hE (b4cov_expr E E f p e) (φ p)
  have hes : e ∈ ψ.source := mem_extChartAt_source e
  have hps : p ∈ φ.source := mem_extChartAt_source p
  have hkp : k 0 = p := by simp [k, φ]
  have hlin : ContinuousAt (fun z : ℂ ↦ φ p + b4cov_lineEquiv hE z) 0 :=
    continuous_const.continuousAt.add (b4cov_lineEquiv hE).continuous.continuousAt
  have hk : ContinuousAt k 0 := by
    apply ((continuousOn_extChartAt_symm p).continuousAt _).comp hlin
    apply (isOpen_extChartAt_target p).mem_nhds
    simpa only [map_zero, add_zero] using mem_extChartAt_target p
  have hnear : ∀ᶠ z in 𝓝 (0 : ℂ),
      φ p + b4cov_lineEquiv hE z ∈ φ.target ∧ f (k z) ∈ ψ.source := by
    have h₁ : ∀ᶠ z in 𝓝 (0 : ℂ), φ p + b4cov_lineEquiv hE z ∈ φ.target :=
      hlin.preimage_mem_nhds
        (by simpa only [map_zero, add_zero] using (isOpen_extChartAt_target p).mem_nhds (φ.map_source hps))
    have h₂ : ∀ᶠ z in 𝓝 (0 : ℂ), f (k z) ∈ ψ.source :=
      (hf.continuous.continuousAt.comp hk).preimage_mem_nhds
        (by change ψ.source ∈ 𝓝 (f (k 0)); rw [hkp, hfp]; exact (isOpen_extChartAt_source e).mem_nhds hes)
    exact h₁.and h₂
  filter_upwards [hnear] with z hn
  have hT : T z = (b4cov_lineEquiv hE).symm (ψ (f (k z)) - ψ e) := by
    change (b4cov_lineEquiv hE).symm (ψ (f (k z))) -
      (b4cov_lineEquiv hE).symm (ψ (f (φ.symm (φ p)))) = _
    rw [φ.left_inv hps, hfp, map_sub]
  have hkT : j (T z) = f (k z) := by
    rw [hT]
    dsimp only [j]
    rw [ContinuousLinearEquiv.apply_symm_apply, add_sub_cancel, ψ.left_inv hn.2]
  exact hkT


/-- Locally meromorphic scalar functions remain locally meromorphic after holomorphic pullback. -/
lemma RiemannRochEichler_scalar_pullback_meromorphic
    (hE : Module.finrank ℂ E = 1) (u : C → ℂ)
    (hu : ∀ p, MeromorphicAt (fun z ↦ u ((extChartAt 𝓘(ℂ, E) p).symm
      (extChartAt 𝓘(ℂ, E) p p + b4cov_lineEquiv hE z))) 0)
    (f : C → C) (hf : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω f) (p : C) :
    MeromorphicAt (fun z ↦ u (f ((extChartAt 𝓘(ℂ, E) p).symm
      (extChartAt 𝓘(ℂ, E) p p + b4cov_lineEquiv hE z)))) 0 := by
  let T := b4cov_transport hE hE (b4cov_expr E E f p (f p)) (extChartAt 𝓘(ℂ, E) p p)
  have hTa : AnalyticAt ℂ T 0 := by
    apply b4cov_transport_analyticAt
    apply b4cov_analyticAt_chart f hf p (f p) _ (mem_extChartAt_target p)
    rw [extChartAt_to_inv]
    exact mem_extChartAt_source (f p)
  have hT0 : T 0 = 0 := b4cov_transport_zero _ _ _ _
  have hm := hu (f p)
  rw [← hT0] at hm
  have hc := hm.comp_analyticAt hTa
  apply hc.congr
  filter_upwards [nhdsWithin_le_nhds (RiemannRochEichler_graph_coordinates hE f hf p (f p) rfl)] with z hz
  exact congrArg u hz


/-- Analytic scalar germs pull back analytically in centred coordinates. -/
lemma RiemannRochEichler_scalar_pullback_analytic
    (hE : Module.finrank ℂ E = 1) (u : C → ℂ)
    (f : C → C) (hf : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω f) (p : C)
    (hu : AnalyticAt ℂ (fun z ↦ u ((extChartAt 𝓘(ℂ, E) (f p)).symm
      (extChartAt 𝓘(ℂ, E) (f p) (f p) + b4cov_lineEquiv hE z))) 0) :
    AnalyticAt ℂ (fun z ↦ u (f ((extChartAt 𝓘(ℂ, E) p).symm
      (extChartAt 𝓘(ℂ, E) p p + b4cov_lineEquiv hE z)))) 0 := by
  let T := b4cov_transport hE hE (b4cov_expr E E f p (f p)) (extChartAt 𝓘(ℂ, E) p p)
  have hTa : AnalyticAt ℂ T 0 := by
    apply b4cov_transport_analyticAt
    apply b4cov_analyticAt_chart f hf p (f p) _ (mem_extChartAt_target p)
    rw [extChartAt_to_inv]
    exact mem_extChartAt_source (f p)
  have hT0 : T 0 = 0 := b4cov_transport_zero _ _ _ _
  have hm := hu
  rw [← hT0] at hm
  have hc := hm.comp hTa
  apply hc.congr
  filter_upwards [RiemannRochEichler_graph_coordinates hE f hf p (f p) rfl] with z hz
  exact congrArg u hz


/-- Sphere inversion agrees with inversion of the scalar representative, including zero and infinity. -/
lemma RiemannRochEichler_inversion_value (p : OnePoint ℂ) :
    (b4cov_sphInv p).elim 0 id = ((p.elim 0 id : ℂ))⁻¹ := by
  cases p using OnePoint.rec with
  | infty => simp only [b4cov_sphInv_infty]; exact inv_zero.symm
  | coe z =>
    by_cases hz : z = 0
    · subst z
      rw [b4cov_sphInv_zero]
      exact inv_zero.symm
    · rw [b4cov_sphInv_coe hz]
      rfl


/-- A nonzero residue at a pole of order at most one forces order exactly minus one. -/
lemma RiemannRochEichler_simple_pole_order {f : ℂ → ℂ} {a : ℂ}
    (ho : (-1 : WithTop ℤ) ≤ meromorphicOrderAt f a) (hr : residue f a ≠ 0) :
    meromorphicOrderAt f a = -1 := by
  have hn : meromorphicOrderAt f a < 0 := lt_of_not_ge
    (fun h ↦ hr (residue_eq_zero_of_meromorphicOrderAt_nonneg h))
  obtain ⟨m, hm⟩ := WithTop.ne_top_iff_exists.mp hn.ne_top
  have hmneg : m < 0 := by simpa [← hm] using hn
  have hc : (-1 : WithTop ℤ) = ((-1 : ℤ) : WithTop ℤ) := by norm_cast
  rw [hc, ← hm] at ho
  have hmbound : (-1 : ℤ) ≤ m := WithTop.coe_le_coe.mp ho
  have he : m = -1 := by omega
  rw [← hm, he, hc]


/-- An analytic germ of meromorphic order one has nonzero derivative. -/
lemma RiemannRochEichler_order_one_derivative {f : ℂ → ℂ} {a : ℂ}
    (hf : AnalyticAt ℂ f a) (ho : meromorphicOrderAt f a = 1) : deriv f a ≠ 0 := by
  have hd : meromorphicOrderAt (deriv f) a = ((0 : ℤ) : WithTop ℤ) := by
    simpa using meromorphicOrderAt_deriv_eq_sub_one (f := f) (x := a) (n := 1)
      (by norm_num) (by simpa using ho)
  obtain ⟨g, hg, hgz, he⟩ := (meromorphicOrderAt_eq_int_iff hf.deriv.meromorphicAt).mp hd
  simp only [zpow_zero, one_smul] at he
  have hv := (hf.deriv.continuousAt.eventuallyEq_nhds_iff_eventuallyEq_nhdsNE
    hg.continuousAt).mp he |>.self_of_nhds
  exact fun h ↦ hgz (hv.symm.trans h)


/-- Every point has a global meromorphic function that is a local analytic coordinate there. -/
lemma RiemannRochEichler_unramified_function
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (p : C) :
    ∃ g : b4c_MeroFun E C, (∃ x y, g x ≠ g y) ∧ g p = (0 : ℂ) ∧
      AnalyticAt ℂ (RiemannRochEichler_functionLocal hE g p) 0 ∧
      deriv (RiemannRochEichler_functionLocal hE g p) 0 ≠ 0 := by
  classical
  obtain ⟨ι, a, b, hι, ha, havoid, hb⟩ :=
    RiemannRochEichler_normalized_basis_away hE ({p} : Set C) (Set.finite_singleton p)
  letI : Finite ι := hι
  letI : Fintype ι := Fintype.ofFinite ι
  have hp : p ∉ Set.range a := by
    rintro ⟨i, hi⟩
    exact havoid i (by simpa only [Set.mem_singleton_iff] using hi)
  obtain ⟨f, hfp, ho, _, hr⟩ := RiemannRochEichler_function_with_extra_pole hE a ha b hb p hp
  let g : b4c_MeroFun E C := ⟨b4cov_sphInv ∘ f,
    RiemannRochTop_sphere_inversion_holomorphic.comp f.property.1,
    p, by
      change b4cov_sphInv (f p) ≠ OnePoint.infty
      rw [hfp, b4cov_sphInv_infty]
      exact OnePoint.coe_ne_infty 0⟩
  have hgp : g p = (0 : ℂ) := by
    change b4cov_sphInv (f p) = (0 : ℂ)
    rw [hfp, b4cov_sphInv_infty]
  have hg : AnalyticAt ℂ (RiemannRochEichler_functionLocal hE g p) 0 :=
    RiemannRochEichler_functionLocal_analytic hE g p (by rw [hgp]; exact OnePoint.coe_ne_infty 0)
  have he : RiemannRochEichler_functionLocal hE g p =
      (RiemannRochEichler_functionLocal hE f p)⁻¹ := by
    funext z
    exact RiemannRochEichler_inversion_value _
  have horder : meromorphicOrderAt (RiemannRochEichler_functionLocal hE g p) 0 = 1 := by
    rw [he, meromorphicOrderAt_inv, RiemannRochEichler_simple_pole_order (ho p) hr]
    simp
  have hnc : ∃ x y, g x ≠ g y := by
    obtain ⟨z, hz⟩ := f.property.2
    refine ⟨p, z, ?_⟩
    intro heq
    have h : f p = f z := b4cov_sphInv_involutive.injective heq
    exact hz (h.symm.trans hfp)
  exact ⟨g, hnc, hgp, hg, RiemannRochEichler_order_one_derivative hg horder⟩


/-- A global meromorphic differential can be made analytic and nonzero at any prescribed point. -/
lemma RiemannRochEichler_local_unit_form
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (p : C) :
    ∃ η : b4c_MeroForm E C hE,
      AnalyticAt ℂ (HurwitzPrymRR_loc hE η p) 0 ∧ HurwitzPrymRR_loc hE η p 0 ≠ 0 := by
  obtain ⟨w, _, hw⟩ := b4c_exists_meroForm_aux (C := C) hE
  obtain ⟨m, hm⟩ := WithTop.ne_top_iff_exists.mp (RiemannRochEichler_finite_orders hE w hw p)
  obtain ⟨G, _, hGp, hGa, hGd⟩ := RiemannRochEichler_unramified_function hE p
  have hG0 : RiemannRochEichler_functionLocal hE G p 0 = 0 := by
    simp [RiemannRochEichler_functionLocal, hGp]
  have hGo : meromorphicOrderAt (RiemannRochEichler_functionLocal hE G p) 0 = 1 := by
    rw [hGa.meromorphicOrderAt_eq, hGa.analyticOrderAt_eq_one_of_zero_deriv_ne_zero hG0 hGd]
    rfl
  let v : TangentBundle 𝓘(ℂ, E) C → ℂ := fun t ↦ ((G t.1).elim 0 id) ^ (-m) * w t
  have hv : b4c_IsMeroForm hE v := by
    refine ⟨?_, fun r ↦ ((RiemannRochEichler_fun_loc_meromorphic hE G r).zpow (-m)).mul
      (w.property.2 r)⟩
    intro r c u t
    change ((G r).elim 0 id) ^ (-m) * w ⟨r, c • u + t⟩ =
      c * (((G r).elim 0 id) ^ (-m) * w ⟨r, u⟩) + ((G r).elim 0 id) ^ (-m) * w ⟨r, t⟩
    rw [w.property.1 r c u t]
    ring
  have hvo : meromorphicOrderAt (HurwitzPrymRR_loc hE v p) 0 = 0 := by
    change meromorphicOrderAt
      ((RiemannRochEichler_functionLocal hE G p) ^ (-m) * HurwitzPrymRR_loc hE w p) 0 = 0
    rw [meromorphicOrderAt_mul (f := (RiemannRochEichler_functionLocal hE G p) ^ (-m))
      (g := HurwitzPrymRR_loc hE w p) ((RiemannRochEichler_fun_loc_meromorphic hE G p).zpow (-m))
      (w.property.2 p), meromorphicOrderAt_zpow (f := RiemannRochEichler_functionLocal hE G p)
        (RiemannRochEichler_fun_loc_meromorphic hE G p), hGo, ← hm, mul_one]
    exact congrArg (fun z : ℤ ↦ (z : WithTop ℤ)) (neg_add_cancel m)
  obtain ⟨η, he, ha⟩ := RiemannRochEichler_regularize_finite hE ⟨v, hv⟩ {p}
    (Set.finite_singleton p) (by intro r hr; rcases hr with rfl; exact hvo.ge)
  have hηa := ha p rfl
  have hηo : meromorphicOrderAt (HurwitzPrymRR_loc hE η p) 0 = 0 :=
    (meromorphicOrderAt_congr (he p)).trans hvo
  obtain ⟨f, hf, hf0, hef⟩ := (meromorphicOrderAt_eq_int_iff hηa.meromorphicAt).mp hηo
  simp only [zpow_zero, one_smul] at hef
  have hval := (hηa.continuousAt.eventuallyEq_nhds_iff_eventuallyEq_nhdsNE
    hf.continuousAt).mp hef |>.self_of_nhds
  exact ⟨η, hηa, fun h ↦ hf0 (hval.symm.trans h)⟩


/-- A nonzero scalar meromorphic germ stays nonzero throughout a compact connected curve. -/
lemma RiemannRochEichler_scalar_finite_orders
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (u : C → ℂ)
    (hu : ∀ p, MeromorphicAt (fun z ↦ u ((extChartAt 𝓘(ℂ, E) p).symm
      (extChartAt 𝓘(ℂ, E) p p + b4cov_lineEquiv hE z))) 0)
    (hne : ∃ p, meromorphicOrderAt (fun z ↦ u ((extChartAt 𝓘(ℂ, E) p).symm
      (extChartAt 𝓘(ℂ, E) p p + b4cov_lineEquiv hE z))) 0 ≠ ⊤) :
    ∀ p, ∀ᶠ z in 𝓝[≠] (0 : ℂ), u ((extChartAt 𝓘(ℂ, E) p).symm
      (extChartAt 𝓘(ℂ, E) p p + b4cov_lineEquiv hE z)) ≠ 0 := by
  obtain ⟨q, hq⟩ := hne
  obtain ⟨η, hηa, hη0⟩ := RiemannRochEichler_local_unit_form hE q
  let w : TangentBundle 𝓘(ℂ, E) C → ℂ := fun t ↦ u t.1 * η t
  have hw : b4c_IsMeroForm hE w := by
    refine ⟨?_, fun p ↦ (hu p).mul (η.property.2 p)⟩
    intro p c v t
    change u p * η ⟨p, c • v + t⟩ = _
    rw [η.property.1 p c v t]
    change u p * (c * η ⟨p, v⟩ + η ⟨p, t⟩) = c * (u p * η ⟨p, v⟩) + u p * η ⟨p, t⟩
    ring
  have hwq : meromorphicOrderAt (HurwitzPrymRR_loc hE w q) 0 ≠ ⊤ := by
    have he : meromorphicOrderAt (HurwitzPrymRR_loc hE η q) 0 = 0 := by
      rw [hηa.meromorphicOrderAt_eq, hηa.analyticOrderAt_eq_zero.mpr hη0]
      rfl
    change meromorphicOrderAt ((fun z ↦ u ((extChartAt 𝓘(ℂ, E) q).symm
      (extChartAt 𝓘(ℂ, E) q q + b4cov_lineEquiv hE z))) * HurwitzPrymRR_loc hE η q) 0 ≠ ⊤
    rw [meromorphicOrderAt_mul (hu q) (η.property.2 q), he, add_zero]
    exact hq
  intro p
  have hp := RiemannRochEichler_finite_orders hE ⟨w, hw⟩ ⟨q, hwq⟩ p
  have hev := (meromorphicOrderAt_ne_top_iff_eventually_ne_zero (hw.2 p)).mp hp
  filter_upwards [hev] with z hz
  exact fun h ↦ hz (by change u _ * η _ = 0; rw [h, zero_mul])


/-- A function with one moved pole separates a nonidentity map in every punctured coordinate germ. -/
lemma RiemannRochEichler_graph_separating_function
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (f : C → C)
    (hf : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω f) (hne : f ≠ id) :
    ∃ G : b4c_MeroFun E C, (∃ x y, G x ≠ G y) ∧
      ∀ p, ∀ᶠ z in 𝓝[≠] (0 : ℂ),
        let x := (extChartAt 𝓘(ℂ, E) p).symm
          (extChartAt 𝓘(ℂ, E) p p + b4cov_lineEquiv hE z)
        (G x).elim 0 id ≠ (G (f x)).elim 0 id := by
  obtain ⟨q, hq⟩ : ∃ q, f q ≠ q := by
    by_contra h
    push Not at h
    exact hne (funext h)
  obtain ⟨G, hnc, hGq, hGout, _⟩ := RiemannRochEichler_function_with_single_pole hE q
  let u : C → ℂ := fun x ↦ (G x).elim 0 id - (G (f x)).elim 0 id
  have hGf (p : C) : MeromorphicAt (fun z ↦ (G (f ((extChartAt 𝓘(ℂ, E) p).symm
      (extChartAt 𝓘(ℂ, E) p p + b4cov_lineEquiv hE z)))).elim 0 id) 0 :=
    RiemannRochEichler_scalar_pullback_meromorphic hE (fun x ↦ (G x).elim 0 id)
      (RiemannRochEichler_fun_loc_meromorphic hE G) f hf p
  have hu (p : C) : MeromorphicAt (fun z ↦ u ((extChartAt 𝓘(ℂ, E) p).symm
      (extChartAt 𝓘(ℂ, E) p p + b4cov_lineEquiv hE z))) 0 :=
    (RiemannRochEichler_fun_loc_meromorphic hE G p).sub (hGf p)
  have hneq : meromorphicOrderAt (fun z ↦ u ((extChartAt 𝓘(ℂ, E) q).symm
      (extChartAt 𝓘(ℂ, E) q q + b4cov_lineEquiv hE z))) 0 ≠ ⊤ := by
    intro ht
    have he : RiemannRochEichler_functionLocal hE G q =ᶠ[𝓝[≠] 0]
        (fun z ↦ (G (f ((extChartAt 𝓘(ℂ, E) q).symm
          (extChartAt 𝓘(ℂ, E) q q + b4cov_lineEquiv hE z)))).elim 0 id) := by
      filter_upwards [meromorphicOrderAt_eq_top_iff.mp ht] with z hz
      exact sub_eq_zero.mp hz
    have ha := RiemannRochEichler_scalar_pullback_analytic hE (fun x ↦ (G x).elim 0 id) f hf q
      (RiemannRochEichler_functionLocal_analytic hE G (f q) (hGout (f q) hq))
    have ho : 0 ≤ meromorphicOrderAt (RiemannRochEichler_functionLocal hE G q) 0 := by
      rw [meromorphicOrderAt_congr he]
      exact ha.meromorphicOrderAt_nonneg
    exact (RiemannRochEichler_functionLocal_nonneg_iff hE G q).mp ho hGq
  refine ⟨G, hnc, fun p ↦ ?_⟩
  filter_upwards [RiemannRochEichler_scalar_finite_orders hE u hu ⟨q, hneq⟩ p] with z hz
  exact sub_ne_zero.mp hz


lemma RiemannRochEichler_function_pole_bounds
    [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (f : b4c_MeroFun E C) (hnc : ∃ x y, f x ≠ f y) :
    ∃ (S : Finset C) (N : ℕ), (∀ x, x ∈ S ↔ f x = OnePoint.infty) ∧
      ∀ x, ((-(N : ℤ)) : WithTop ℤ) ≤ meromorphicOrderAt
        (RiemannRochEichler_functionLocal hE f x) 0 := by
  classical
  have hfin := b4cov_fiber_finite hE f f.property.1 hnc OnePoint.infty
  let S := hfin.toFinset
  have hS (x : C) : x ∈ S ↔ f x = OnePoint.infty := by
    simp only [S, Set.Finite.mem_toFinset, Set.mem_preimage, Set.mem_singleton_iff]
  let N := S.sup (fun x ↦ b4_ramIndex E ℂ f x)
  have hf0 : ∃ x, f x ≠ (0 : ℂ) := by
    obtain ⟨x, y, hxy⟩ := hnc
    by_cases hx : f x = (0 : ℂ)
    · exact ⟨y, fun hy ↦ hxy (hx.trans hy.symm)⟩
    · exact ⟨x, hx⟩
  refine ⟨S, N, hS, ?_⟩
  intro x
  rw [← RiemannRochEichler_ord_eq_local hE f hf0 x]
  apply WithTop.coe_le_coe.mpr
  by_cases hx : x ∈ S
  · have hfx := (hS x).mp hx
    have hx0 : f x ≠ (0 : ℂ) := by rw [hfx]; exact OnePoint.infty_ne_coe 0
    rw [b4c_ord, if_neg hx0, if_pos hfx]
    have hi : b4_ramIndex E ℂ f x ≤ N := Finset.le_sup hx
    change -(N : ℤ) ≤ -(b4_ramIndex E ℂ f x : ℤ)
    exact neg_le_neg (Int.ofNat_le.mpr hi)
  · have hfx : f x ≠ OnePoint.infty := fun h ↦ hx ((hS x).mpr h)
    have hn : (0 : ℤ) ≤ b4c_ord E f x := by
      rw [b4c_ord]
      split
      · exact Int.natCast_nonneg _
      · exact le_rfl
    change -(N : ℤ) ≤ b4c_ord E f x
    exact le_trans (neg_nonpos.mpr (Int.natCast_nonneg N)) hn


/-- A differential with a nonzero germ on a compact connected curve has a uniform integer pole bound. -/
lemma RiemannRochEichler_uniform_form_order [T1Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (w : b4c_MeroForm E C hE)
    (hw : ∃ p, meromorphicOrderAt (HurwitzPrymRR_loc hE w p) 0 ≠ ⊤) :
    ∃ N : ℕ, ∀ p, ((-(N : ℤ)) : WithTop ℤ) ≤
      meromorphicOrderAt (HurwitzPrymRR_loc hE w p) 0 := by
  obtain ⟨z, hz⟩ := (b4c_divForm (hE := hE) w).finite_range.bddBelow
  refine ⟨(-z).toNat, ?_⟩
  intro p
  rw [← RiemannRochEichler_divForm_order hE w hw p]
  apply WithTop.coe_le_coe.mpr
  have hp := hz ⟨p, rfl⟩
  by_cases hz0 : 0 ≤ -z
  · have hc : (((-z).toNat : ℕ) : ℤ) = -z := Int.toNat_of_nonneg hz0
    rw [hc]
    change -(-z) ≤ b4c_divForm (hE := hE) w p
    simpa only [neg_neg] using hp
  · have hc : (-z).toNat = 0 := Int.toNat_eq_zero.mpr (by omega)
    rw [hc]
    simp only [Nat.cast_zero, neg_zero]
    omega


/-- Residues of a linear family of meromorphic germs form a linear functional. -/
def RiemannRochEichler_residueLinearMap {V : Type*} [AddCommGroup V] [Module ℂ V]
    (a : V →ₗ[ℂ] (ℂ → ℂ)) (z : ℂ) (ha : ∀ v, MeromorphicAt (a v) z) :
    V →ₗ[ℂ] ℂ where
  toFun v := residue (a v) z
  map_add' v w := by rw [map_add, residue_add (ha v) (ha w)]
  map_smul' c v := by rw [map_smul, residue_const_smul]; rfl

/-- Vanishing of all bounded principal-part residues removes a meromorphic pole. -/
lemma RiemannRochEichler_principal_parts_remove {f : ℂ → ℂ} (N : ℕ)
    (hf : MeromorphicAt f 0)
    (ho : ((-(N : ℤ)) : WithTop ℤ) ≤ meromorphicOrderAt f 0)
    (hr : ∀ j : Fin N, residue (fun z ↦ z ^ j.val * f z) 0 = 0) :
    0 ≤ meromorphicOrderAt f 0 := by
  by_contra hn
  have hneg : meromorphicOrderAt f 0 < 0 := lt_of_not_ge hn
  obtain ⟨m, hm⟩ := WithTop.ne_top_iff_exists.mp hneg.ne_top
  have hmneg : m < 0 := by simpa [← hm] using hneg
  have hmbound : -(N : ℤ) ≤ m := by
    rw [← hm] at ho
    exact WithTop.coe_le_coe.mp ho
  let j := (-m - 1).toNat
  have hj : (j : ℤ) = -m - 1 := Int.toNat_of_nonneg (by omega)
  have hjN : j < N := by omega
  have hp : MeromorphicAt (fun z : ℂ ↦ z ^ j) 0 := (analyticAt_id.pow j).meromorphicAt
  have hpord : meromorphicOrderAt (fun z : ℂ ↦ z ^ j) 0 = (j : WithTop ℤ) := by
    change meromorphicOrderAt ((id : ℂ → ℂ) ^ j) 0 = _
    rw [meromorphicOrderAt_pow analyticAt_id.meromorphicAt, meromorphicOrderAt_id, mul_one]
  have hprod : meromorphicOrderAt ((fun z : ℂ ↦ z ^ j) * f) 0 = -1 := by
    rw [meromorphicOrderAt_mul hp hf, hpord, ← hm]
    change ((j : ℤ) : WithTop ℤ) + (m : WithTop ℤ) = -1
    rw [← WithTop.coe_add, show (j : ℤ) + m = -1 by omega]
    norm_cast
  have hnonneg : 0 ≤ meromorphicOrderAt ((fun z : ℂ ↦ z ^ j) * f) 0 := by
    apply (hp.mul hf).meromorphicOrderAt_nonneg_iff.mpr
    exact (RiemannRochEichler_simple_pole_removable (hp.mul hf)
      (by rw [hprod])).mp (hr ⟨j, hjN⟩)
  rw [hprod] at hnonneg
  have hc : (-1 : WithTop ℤ) = ((-1 : ℤ) : WithTop ℤ) := by norm_cast
  rw [hc] at hnonneg
  have hi : (0 : ℤ) ≤ -1 := WithTop.coe_le_coe.mp hnonneg
  omega


/-- Germ-separated families with uniformly bounded poles on a finite set are finite-dimensional. -/
lemma RiemannRochEichler_bounded_pole_family_finite
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) {V : Type*} [AddCommGroup V] [Module ℂ V]
    (F : V →ₗ[ℂ] (TangentBundle 𝓘(ℂ, E) C → ℂ))
    (hF : ∀ v, b4c_IsMeroForm hE (F v)) (S : Finset C) (N : ℕ)
    (ho : ∀ v p, ((-(N : ℤ)) : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (F v) p) 0)
    (hout : ∀ v p, p ∉ S → 0 ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (F v) p) 0)
    (hsep : ∀ v, (∀ p, HurwitzPrymRR_loc hE (F v) p =ᶠ[𝓝[≠] 0] 0) → v = 0) :
    Module.Finite ℂ V := by
  classical
  haveI : FiniteDimensional ℂ E := Module.finite_of_finrank_eq_succ hE
  haveI : Module.Finite ℂ (b3_HolForm E C) := b3Forms_holForm_finiteDimensional hE
  let A (p : S) (j : Fin N) : V →ₗ[ℂ] (ℂ → ℂ) :=
    { toFun := fun v z ↦ z ^ j.val * HurwitzPrymRR_loc hE (F v) p.1 z
      map_add' := by
        intro v w
        funext z
        simp only [map_add, HurwitzPrymRR_loc, b4cov_coef, Pi.add_apply, mul_add]
      map_smul' := by
        intro c v
        funext z
        simp only [map_smul, HurwitzPrymRR_loc, b4cov_coef, Pi.smul_apply,
          smul_eq_mul, RingHom.id_apply]
        ring }
  have hA (p : S) (j : Fin N) (v : V) : MeromorphicAt (A p j v) 0 :=
    ((analyticAt_id.pow j.val).meromorphicAt).mul ((hF v).2 p.1)
  let Q : V →ₗ[ℂ] (S → Fin N → ℂ) :=
    LinearMap.pi fun p ↦ LinearMap.pi fun j ↦ RiemannRochEichler_residueLinearMap (A p j) 0 (hA p j)
  let F₀ : Q.ker →ₗ[ℂ] (TangentBundle 𝓘(ℂ, E) C → ℂ) := F.comp Q.ker.subtype
  have hF₀ (v : Q.ker) : b4c_IsMeroForm hE (F₀ v) := hF v.1
  have ho₀ (v : Q.ker) (p : C) : 0 ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (F₀ v) p) 0 := by
    by_cases hp : p ∈ S
    · apply RiemannRochEichler_principal_parts_remove N ((hF v.1).2 p) (ho v.1 p)
      intro j
      have hv : Q v.1 = 0 := v.property
      have hj := congrFun (congrFun hv (⟨p, hp⟩ : S)) j
      exact hj
    · exact hout v.1 p hp
  obtain ⟨R, hR⟩ := RiemannRochEichler_linear_regularize hE F₀ hF₀ ho₀
  have hRi : Function.Injective R := by
    apply LinearMap.ker_eq_bot.mp
    apply LinearMap.ker_eq_bot'.mpr
    intro v hv
    apply Subtype.ext
    apply hsep v.1
    intro p
    have h := hR v p
    rw [hv] at h
    exact h.symm
  haveI : Module.Finite ℂ Q.ker := Module.Finite.of_injective R hRi
  haveI : Module.Finite ℂ (V ⧸ Q.ker) := Q.quotKerEquivRange.symm.finiteDimensional
  exact Module.Finite.of_submodule_quotient Q.ker


/-- A differential regular off a set and zero on that set is determined by its punctured germs. -/
lemma RiemannRochEichler_regular_zero_of_zero_germs
    (hE : Module.finrank ℂ E = 1) (w : TangentBundle 𝓘(ℂ, E) C → ℂ)
    (hw : HurwitzPrymRR_IsLinear w) (S : Set C)
    (ha : ∀ p ∉ S, AnalyticAt ℂ (HurwitzPrymRR_loc hE w p) 0)
    (hz : ∀ p ∈ S, ∀ u, w ⟨p, u⟩ = 0)
    (hg : ∀ p, HurwitzPrymRR_loc hE w p =ᶠ[𝓝[≠] 0] 0) : w = 0 := by
  funext t
  by_cases ht : t.1 ∈ S
  · exact hz t.1 ht t.2
  have hloc : HurwitzPrymRR_loc hE w t.1 0 = 0 :=
    ((ha t.1 ht).continuousAt.eventuallyEq_nhds_iff_eventuallyEq_nhdsNE
      continuousAt_const).mp (hg t.1) |>.self_of_nhds
  rw [RiemannRochEichler_loc_zero] at hloc
  have hv : t.2 = (b4cov_lineEquiv hE).symm t.2 • b4cov_lineEquiv hE 1 := by
    change (t.2 : E) = (b4cov_lineEquiv hE).symm t.2 • b4cov_lineEquiv hE 1
    rw [← map_smul, smul_eq_mul, mul_one]
    exact ((b4cov_lineEquiv hE).apply_symm_apply (t.2 : E)).symm
  have he := hw.smul t.1 ((b4cov_lineEquiv hE).symm t.2) (b4cov_lineEquiv hE 1)
  rw [hloc, mul_zero] at he
  exact (congrArg (fun u : E ↦ w ⟨t.1, u⟩) hv).trans he


/-- Differentials with fixed pole bounds and zero assigned pole values form a finite-dimensional space. -/
lemma RiemannRochEichler_exists_bounded_pole_space
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (S : Finset C) (N : ℕ) :
    ∃ W : Submodule ℂ (TangentBundle 𝓘(ℂ, E) C → ℂ), Module.Finite ℂ W ∧
      ∀ w, w ∈ W ↔ b4c_IsMeroForm hE w ∧
        (∀ p, ((-(N : ℤ)) : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE w p) 0) ∧
        (∀ p, p ∉ S → AnalyticAt ℂ (HurwitzPrymRR_loc hE w p) 0) ∧
        ∀ p ∈ S, ∀ u, w ⟨p, u⟩ = 0 := by
  classical
  let W : Submodule ℂ (TangentBundle 𝓘(ℂ, E) C → ℂ) :=
    { carrier := {w | b4c_IsMeroForm hE w ∧
        (∀ p, ((-(N : ℤ)) : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE w p) 0) ∧
        (∀ p, p ∉ S → AnalyticAt ℂ (HurwitzPrymRR_loc hE w p) 0) ∧
        ∀ p ∈ S, ∀ u, w ⟨p, u⟩ = 0}
      zero_mem' := by
        refine ⟨⟨?_, fun _ ↦ analyticAt_const.meromorphicAt⟩, ?_, fun _ _ ↦ analyticAt_const, ?_⟩
        · intro p c u v
          simp
        · intro p
          change _ ≤ meromorphicOrderAt (fun _ : ℂ ↦ (0 : ℂ)) 0
          rw [meromorphicOrderAt_const, if_pos rfl]
          exact le_top
        · intro p hp u
          rfl
      add_mem' := by
        intro w v hw hv
        refine ⟨⟨?_, fun p ↦ (hw.1.2 p).add (hv.1.2 p)⟩, ?_, ?_, ?_⟩
        · intro p c u t
          change w ⟨p, c • u + t⟩ + v ⟨p, c • u + t⟩ = _
          rw [hw.1.1 p c u t, hv.1.1 p c u t]
          change _ = c * (w ⟨p, u⟩ + v ⟨p, u⟩) + (w ⟨p, t⟩ + v ⟨p, t⟩)
          ring
        · intro p
          change _ ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE w p + HurwitzPrymRR_loc hE v p) 0
          exact (le_min (hw.2.1 p) (hv.2.1 p)).trans (meromorphicOrderAt_add (hw.1.2 p) (hv.1.2 p))
        · intro p hp
          exact (hw.2.2.1 p hp).add (hv.2.2.1 p hp)
        · intro p hp u
          change w ⟨p, u⟩ + v ⟨p, u⟩ = 0
          rw [hw.2.2.2 p hp u, hv.2.2.2 p hp u, add_zero]
      smul_mem' := by
        intro c w hw
        refine ⟨⟨?_, fun p ↦ (hw.1.2 p).const_smul c⟩, ?_, ?_, ?_⟩
        · intro p a u t
          change c * w ⟨p, a • u + t⟩ = a * (c * w ⟨p, u⟩) + c * w ⟨p, t⟩
          rw [hw.1.1 p a u t]
          ring
        · intro p
          change _ ≤ meromorphicOrderAt (c • HurwitzPrymRR_loc hE w p) 0
          by_cases hc : c = 0
          · rw [hc, zero_smul]
            change _ ≤ meromorphicOrderAt (fun _ : ℂ ↦ (0 : ℂ)) 0
            rw [meromorphicOrderAt_const, if_pos rfl]
            exact le_top
          · rw [meromorphicOrderAt_const_smul_eq_meromorphicOrderAt hc]
            exact hw.2.1 p
        · intro p hp
          exact (hw.2.2.1 p hp).const_smul
        · intro p hp u
          change c * w ⟨p, u⟩ = 0
          rw [hw.2.2.2 p hp u, mul_zero] }
  refine ⟨W, ?_, fun _ ↦ Iff.rfl⟩
  apply RiemannRochEichler_bounded_pole_family_finite hE W.subtype
    (fun v ↦ v.property.1) S N (fun v ↦ v.property.2.1)
    (fun v p hp ↦ (v.property.2.2.1 p hp).meromorphicOrderAt_nonneg)
  intro v hv
  apply Subtype.ext
  exact RiemannRochEichler_regular_zero_of_zero_germs hE v.1 v.property.1.1 (S : Set C)
    v.property.2.2.1 v.property.2.2.2 hv


/-- Every differential with prescribed finite pole bounds has a representative in one fixed finite-dimensional space. -/
lemma RiemannRochEichler_bounded_space_representatives
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (S : Finset C) (N : ℕ) :
    ∃ W : Submodule ℂ (TangentBundle 𝓘(ℂ, E) C → ℂ), Module.Finite ℂ W ∧
      (∀ v ∈ W, b4c_IsMeroForm hE v ∧
        ∀ p ∉ S, AnalyticAt ℂ (HurwitzPrymRR_loc hE v p) 0) ∧
      ∀ w : b4c_MeroForm E C hE,
        (∀ p, ((-(N : ℤ)) : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE w p) 0) →
        (∀ p ∉ S, 0 ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE w p) 0) →
        ∃ v ∈ W, ∀ p, HurwitzPrymRR_loc hE v p =ᶠ[𝓝[≠] 0] HurwitzPrymRR_loc hE w p := by
  obtain ⟨W, hfin, hW⟩ := RiemannRochEichler_exists_bounded_pole_space hE S N
  refine ⟨W, hfin, ?_, ?_⟩
  · intro v hv
    have h := (hW v).mp hv
    exact ⟨h.1, h.2.2.1⟩
  · intro w ho hout
    obtain ⟨v, he, ha, _⟩ := RiemannRochEichler_regularize_off_poles hE w (S : Set C) hout
    let V : TangentBundle 𝓘(ℂ, E) C → ℂ := fun t ↦ if t.1 ∈ S then 0 else v t
    have hlin : HurwitzPrymRR_IsLinear V := by
      intro p c u t
      change (if p ∈ S then _ else _) = c * (if p ∈ S then _ else _) +
        (if p ∈ S then _ else _)
      by_cases hp : p ∈ S
      · simp only [if_pos hp, mul_zero, add_zero]
      · simp only [if_neg hp]
        exact v.property.1 p c u t
    have hev : ∀ p, HurwitzPrymRR_loc hE V p =ᶠ[𝓝[≠] 0] HurwitzPrymRR_loc hE v p :=
      RiemannRochEichler_loc_congr_off_finite hE (S : Set C) S.finite_toSet V v (by
        intro p hp u
        exact if_neg hp)
    have hew (p : C) := (hev p).trans (he p)
    refine ⟨V, (hW V).mpr ⟨⟨hlin, fun p ↦ (w.property.2 p).congr (hew p).symm⟩,
      ?_, ?_, ?_⟩, hew⟩
    · intro p
      rw [meromorphicOrderAt_congr (hew p)]
      exact ho p
    · intro p hp
      have hz : HurwitzPrymRR_loc hE V p 0 = HurwitzPrymRR_loc hE v p 0 := by
        rw [RiemannRochEichler_loc_zero, RiemannRochEichler_loc_zero]
        exact if_neg hp
      exact (ha p hp).congr (eventuallyEq_nhds_of_eventuallyEq_nhdsNE (hev p) hz).symm
    · intro p hp u
      exact if_pos hp


/-- Scalar meromorphic germs with fixed pole bounds embed, after multiplication by a differential, into one finite-dimensional space. -/
lemma RiemannRochEichler_scalar_bounded_space
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (S : Finset C) (N M : ℕ)
    (η : b4c_MeroForm E C hE)
    (hη : ∀ p, ((-(M : ℤ)) : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE η p) 0)
    (hηout : ∀ p ∉ S, 0 ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE η p) 0) :
    ∃ W : Submodule ℂ (TangentBundle 𝓘(ℂ, E) C → ℂ), Module.Finite ℂ W ∧
      (∀ v ∈ W, b4c_IsMeroForm hE v ∧
        ∀ p ∉ S, AnalyticAt ℂ (HurwitzPrymRR_loc hE v p) 0) ∧
      ∀ f : C → ℂ,
        let F := fun p z ↦ f ((extChartAt 𝓘(ℂ, E) p).symm
          (extChartAt 𝓘(ℂ, E) p p + b4cov_lineEquiv hE z))
        (∀ p, MeromorphicAt (F p) 0) →
        (∀ p, ((-(N : ℤ)) : WithTop ℤ) ≤ meromorphicOrderAt (F p) 0) →
        (∀ p ∉ S, 0 ≤ meromorphicOrderAt (F p) 0) →
        ∃ v ∈ W, ∀ p, HurwitzPrymRR_loc hE v p =ᶠ[𝓝[≠] 0]
          F p * HurwitzPrymRR_loc hE η p := by
  obtain ⟨W, hfin, hW, hrep⟩ := RiemannRochEichler_bounded_space_representatives hE S (N + M)
  refine ⟨W, hfin, hW, ?_⟩
  intro f
  dsimp only
  intro hm ho hout
  let w : TangentBundle 𝓘(ℂ, E) C → ℂ := fun t ↦ f t.1 * η t
  have hw : b4c_IsMeroForm hE w := by
    refine ⟨?_, fun p ↦ (hm p).mul (η.property.2 p)⟩
    intro p c u t
    change f p * η ⟨p, c • u + t⟩ = c * (f p * η ⟨p, u⟩) + f p * η ⟨p, t⟩
    rw [η.property.1 p c u t]
    ring
  have hloc (p : C) : HurwitzPrymRR_loc hE w p =
      (fun z ↦ f ((extChartAt 𝓘(ℂ, E) p).symm
        (extChartAt 𝓘(ℂ, E) p p + b4cov_lineEquiv hE z))) *
      HurwitzPrymRR_loc hE η p := rfl
  have hwo (p : C) : ((-((N + M : ℕ) : ℤ)) : WithTop ℤ) ≤
      meromorphicOrderAt (HurwitzPrymRR_loc hE w p) 0 := by
    rw [hloc, meromorphicOrderAt_mul (hm p) (η.property.2 p)]
    have he : ((-((N + M : ℕ) : ℤ)) : WithTop ℤ) =
        ((-(N : ℤ)) : WithTop ℤ) + ((-(M : ℤ)) : WithTop ℤ) := by
      exact congrArg (fun z : ℤ ↦ (z : WithTop ℤ))
        (show -((N + M : ℕ) : ℤ) = -(N : ℤ) + -(M : ℤ) by push_cast; ring)
    rw [he]
    exact add_le_add (ho p) (hη p)
  have hwout (p : C) (hp : p ∉ S) : 0 ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE w p) 0 := by
    rw [hloc, meromorphicOrderAt_mul (hm p) (η.property.2 p)]
    exact add_nonneg (hout p hp) (hηout p hp)
  obtain ⟨v, hv, he⟩ := hrep ⟨w, hw⟩ hwo hwout
  exact ⟨v, hv, fun p ↦ (he p).trans (Filter.EventuallyEq.of_eq (hloc p))⟩


/-- A single bounded-pole function represents every parameter germ of a normalized coefficient. -/
lemma RiemannRochEichler_parameter_germ_representation
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) {ι : Type} [Fintype ι]
    (a : ι → C) (ha : Function.Injective a) (b : Module.Basis ι ℂ (b3_HolForm E C))
    (hb : ∀ i j, RiemannRochEichler_eval hE (a i) (b j) = if i = j then 1 else 0)
    (q y : C) (hq : q ∉ Set.range a) (hy : y ∉ Set.range a) (hyq : y ≠ q)
    (K : C → b4c_MeroForm E C hE)
    (hK : ∀ p, p ∉ Set.range a → p ≠ q →
      b4c_res (hE := hE) (K p) p = -1 ∧ b4c_res (hE := hE) (K p) q = 1 ∧
      (∀ x, (-1 : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (K p) x) 0) ∧
      (∀ x, x ≠ p → x ≠ q → 0 ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (K p) x) 0) ∧
      (∀ i, AnalyticAt ℂ (HurwitzPrymRR_loc hE (K p) (a i)) 0) ∧
      ∀ i, K p ⟨a i, b4cov_lineEquiv hE 1⟩ = 0) :
    ∃ f : b4c_MeroFun E C,
      (∀ x, (-1 : WithTop ℤ) ≤ meromorphicOrderAt
        (RiemannRochEichler_functionLocal hE f x) 0) ∧
      (∀ x, x ∉ Set.range a → x ≠ y → 0 ≤ meromorphicOrderAt
        (RiemannRochEichler_functionLocal hE f x) 0) ∧
      residue (RiemannRochEichler_functionLocal hE f y) 0 ≠ 0 ∧
      ∀ r, (fun t ↦ residue (fun z ↦ HurwitzPrymRR_loc hE
        (K ((extChartAt 𝓘(ℂ, E) r).symm
          (extChartAt 𝓘(ℂ, E) r r + b4cov_lineEquiv hE t))) y z / z) 0)
        =ᶠ[𝓝[≠] 0] (fun t ↦
          (RiemannRochEichler_functionLocal hE f r t - (f q).elim 0 id) /
            residue (RiemannRochEichler_functionLocal hE f y) 0) := by
  obtain ⟨f, _, hfo, hfout, hres⟩ := RiemannRochEichler_function_with_extra_pole hE a ha b hb y hy
  let S := Set.range a ∪ ({q, y} : Set C)
  have hS : S.Finite := (Set.finite_range a).union (Set.toFinite _)
  have he : ∀ p ∉ S,
      residue (fun z ↦ HurwitzPrymRR_loc hE (K p) y z / z) 0 =
        ((f p).elim 0 id - (f q).elim 0 id) /
          residue (RiemannRochEichler_functionLocal hE f y) 0 := by
    intro p hp
    have hpA : p ∉ Set.range a := fun h ↦ hp (Or.inl h)
    have hpq : p ≠ q := fun h ↦ hp (Or.inr (Or.inl h))
    have hpy : p ≠ y := fun h ↦ hp (Or.inr (Or.inr h))
    obtain ⟨h₁, h₂, h₃, h₄, h₅, h₆⟩ := hK p hpA hpq
    have hfp := (RiemannRochEichler_functionLocal_nonneg_iff hE f p).mp (hfout p hpA hpy)
    have hfq := (RiemannRochEichler_functionLocal_nonneg_iff hE f q).mp (hfout q hq (Ne.symm hyq))
    apply (eq_div_iff hres).mpr
    simpa only [mul_comm] using RiemannRochEichler_third_kind_reciprocity hE a p q y hpq
      (Ne.symm hpy) hyq f (K p) hfp hfq hfo hfout h₁ h₂ h₃ h₄ h₅ h₆
  refine ⟨f, hfo, hfout, hres, ?_⟩
  intro r
  exact RiemannRochEichler_scalar_loc_congr_off_finite hE S hS _ _ he r


/-- Parameter coefficient germs have only simple auxiliary and diagonal poles, with diagonal residue one. -/
lemma RiemannRochEichler_parameter_pole_data
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) {ι : Type} [Fintype ι]
    (a : ι → C) (ha : Function.Injective a) (b : Module.Basis ι ℂ (b3_HolForm E C))
    (hb : ∀ i j, RiemannRochEichler_eval hE (a i) (b j) = if i = j then 1 else 0)
    (q y : C) (hq : q ∉ Set.range a) (hy : y ∉ Set.range a) (hyq : y ≠ q)
    (K : C → b4c_MeroForm E C hE)
    (hK : ∀ p, p ∉ Set.range a → p ≠ q →
      b4c_res (hE := hE) (K p) p = -1 ∧ b4c_res (hE := hE) (K p) q = 1 ∧
      (∀ x, (-1 : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (K p) x) 0) ∧
      (∀ x, x ≠ p → x ≠ q → 0 ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (K p) x) 0) ∧
      (∀ i, AnalyticAt ℂ (HurwitzPrymRR_loc hE (K p) (a i)) 0) ∧
      ∀ i, K p ⟨a i, b4cov_lineEquiv hE 1⟩ = 0) :
    let F := fun r t ↦ residue (fun z ↦ HurwitzPrymRR_loc hE
      (K ((extChartAt 𝓘(ℂ, E) r).symm
        (extChartAt 𝓘(ℂ, E) r r + b4cov_lineEquiv hE t))) y z / z) 0
    (∀ r, MeromorphicAt (F r) 0) ∧
    (∀ r, (-1 : WithTop ℤ) ≤ meromorphicOrderAt (F r) 0) ∧
    (∀ r, r ∉ Set.range a → r ≠ y → 0 ≤ meromorphicOrderAt (F r) 0) ∧
    residue (F y) 0 = 1 := by
  dsimp only
  obtain ⟨f, hfo, hfout, hr, he⟩ :=
    RiemannRochEichler_parameter_germ_representation hE a ha b hb q y hq hy hyq K hK
  let d := residue (RiemannRochEichler_functionLocal hE f y) 0
  let c := (f q).elim 0 id
  let H := fun r ↦ d⁻¹ • (RiemannRochEichler_functionLocal hE f r + fun _ ↦ -c)
  have hH (r : C) : H r = (fun t ↦
      (RiemannRochEichler_functionLocal hE f r t - c) / d) := by
    funext t
    simp only [H, Pi.smul_apply, Pi.add_apply, smul_eq_mul, div_eq_mul_inv, sub_eq_add_neg]
    exact mul_comm _ _
  have hm (r : C) : MeromorphicAt (H r) 0 :=
    ((RiemannRochEichler_fun_loc_meromorphic hE f r).add (MeromorphicAt.const _ _)).const_smul _
  have hbnd (r : C) (m : WithTop ℤ) (hm0 : m ≤ 0)
      (hmf : m ≤ meromorphicOrderAt (RiemannRochEichler_functionLocal hE f r) 0) :
      m ≤ meromorphicOrderAt (H r) 0 := by
    dsimp only [H]
    rw [meromorphicOrderAt_const_smul_eq_meromorphicOrderAt (inv_ne_zero hr)]
    exact (le_min hmf (hm0.trans (analyticAt_const.meromorphicOrderAt_nonneg))).trans
      (meromorphicOrderAt_add (RiemannRochEichler_fun_loc_meromorphic hE f r)
        (MeromorphicAt.const _ _))
  have heH (r : C) : (fun t ↦ residue (fun z ↦ HurwitzPrymRR_loc hE
      (K ((extChartAt 𝓘(ℂ, E) r).symm
        (extChartAt 𝓘(ℂ, E) r r + b4cov_lineEquiv hE t))) y z / z) 0)
      =ᶠ[𝓝[≠] 0] H r := by
    rw [hH]
    exact he r
  refine ⟨fun r ↦ (hm r).congr (heH r).symm, ?_, ?_, ?_⟩
  · intro r
    rw [meromorphicOrderAt_congr (heH r)]
    exact hbnd r (-1) (by change ((-1 : ℤ) : WithTop ℤ) ≤ (0 : ℤ); exact WithTop.coe_le_coe.mpr (by omega)) (hfo r)
  · intro r hrA hry
    rw [meromorphicOrderAt_congr (heH r)]
    exact hbnd r 0 le_rfl (hfout r hrA hry)
  · rw [residue_congr_nhdsNE (heH y)]
    dsimp only [H]
    rw [residue_const_smul, residue_add (f := RiemannRochEichler_functionLocal hE f y) (g := fun _ ↦ -c)
      (RiemannRochEichler_fun_loc_meromorphic hE f y)
      (MeromorphicAt.const _ _), residue_eq_zero_of_analyticAt analyticAt_const, add_zero]
    change d⁻¹ * d = 1
    exact inv_mul_cancel₀ hr


/-- Multiplication by an analytic function vanishing at the pole has a removable germ with a derivative value. -/
lemma RiemannRochEichler_cancel_simple_pole {f g : ℂ → ℂ} {a : ℂ}
    (hf : MeromorphicAt f a) (ho : (-1 : WithTop ℤ) ≤ meromorphicOrderAt f a)
    (hg : AnalyticAt ℂ g a) (hz : g a = 0) :
    ∃ h : ℂ → ℂ, AnalyticAt ℂ h a ∧
      f * g =ᶠ[𝓝[≠] a] h ∧ h a = residue f a * deriv g a := by
  obtain ⟨k, hk, he⟩ := RiemannRochEichler_simple_pole_split hf ho
  have hd : AnalyticAt ℂ (dslope g a) a := by
    obtain ⟨P, hP⟩ := hg
    exact ⟨P.fslope, hP.has_fpower_series_dslope_fslope⟩
  refine ⟨fun z ↦ residue f a * dslope g a z + k z * g z,
    (analyticAt_const.mul hd).add (hk.mul hg), ?_, ?_⟩
  · filter_upwards [he, self_mem_nhdsWithin] with z hzf hza
    change f z * g z = _
    rw [hzf, dslope_of_ne g hza]
    simp only [slope, smul_eq_mul, vsub_eq_sub, hz, sub_zero, div_eq_mul_inv]
    ring
  · simp only [dslope_same, hz, mul_zero, add_zero]


/-- Multiplication by a difference of meromorphic values removes the moving pole with uniform remaining bounds. -/
lemma RiemannRochEichler_modified_parameter_orders
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) {ι : Type} [Fintype ι]
    (a : ι → C) (ha : Function.Injective a) (b : Module.Basis ι ℂ (b3_HolForm E C))
    (hb : ∀ i j, RiemannRochEichler_eval hE (a i) (b j) = if i = j then 1 else 0)
    (q y : C) (hq : q ∉ Set.range a) (hy : y ∉ Set.range a) (hyq : y ≠ q)
    (K : C → b4c_MeroForm E C hE)
    (hK : ∀ p, p ∉ Set.range a → p ≠ q →
      b4c_res (hE := hE) (K p) p = -1 ∧ b4c_res (hE := hE) (K p) q = 1 ∧
      (∀ x, (-1 : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (K p) x) 0) ∧
      (∀ x, x ≠ p → x ≠ q → 0 ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (K p) x) 0) ∧
      (∀ i, AnalyticAt ℂ (HurwitzPrymRR_loc hE (K p) (a i)) 0) ∧
      ∀ i, K p ⟨a i, b4cov_lineEquiv hE 1⟩ = 0)
    (G : b4c_MeroFun E C) (hGy : G y ≠ OnePoint.infty) (N : ℕ)
    (hG : ∀ r, ((-(N : ℤ)) : WithTop ℤ) ≤ meromorphicOrderAt
      (RiemannRochEichler_functionLocal hE G r) 0) :
    let H := fun r t ↦ (residue (fun z ↦ HurwitzPrymRR_loc hE
      (K ((extChartAt 𝓘(ℂ, E) r).symm
        (extChartAt 𝓘(ℂ, E) r r + b4cov_lineEquiv hE t))) y z / z) 0) *
          (RiemannRochEichler_functionLocal hE G r t - (G y).elim 0 id)
    ∀ r, MeromorphicAt (H r) 0 ∧
      ((-((N : ℤ) + 1)) : WithTop ℤ) ≤ meromorphicOrderAt (H r) 0 ∧
      (r ∉ Set.range a → G r ≠ OnePoint.infty → 0 ≤ meromorphicOrderAt (H r) 0) := by
  dsimp only
  let F := fun r t ↦ residue (fun z ↦ HurwitzPrymRR_loc hE
    (K ((extChartAt 𝓘(ℂ, E) r).symm
      (extChartAt 𝓘(ℂ, E) r r + b4cov_lineEquiv hE t))) y z / z) 0
  let B := fun r t ↦ RiemannRochEichler_functionLocal hE G r t - (G y).elim 0 id
  obtain ⟨hm, ho, hout, _⟩ :=
    RiemannRochEichler_parameter_pole_data hE a ha b hb q y hq hy hyq K hK
  have hB (r : C) : MeromorphicAt (B r) 0 :=
    (RiemannRochEichler_fun_loc_meromorphic hE G r).sub (MeromorphicAt.const _ _)
  have hBo (r : C) : ((-(N : ℤ)) : WithTop ℤ) ≤ meromorphicOrderAt (B r) 0 := by
    have hc : ((-(N : ℤ)) : WithTop ℤ) ≤ 0 :=
      WithTop.coe_le_coe.mpr (neg_nonpos.mpr (Int.natCast_nonneg N))
    have he : B r = RiemannRochEichler_functionLocal hE G r + fun _ ↦ -(G y).elim 0 id := by
      funext t
      exact sub_eq_add_neg _ _
    rw [he]
    exact (le_min (hG r) (hc.trans analyticAt_const.meromorphicOrderAt_nonneg)).trans
      (meromorphicOrderAt_add (RiemannRochEichler_fun_loc_meromorphic hE G r)
        (MeromorphicAt.const _ _))
  intro r
  change MeromorphicAt (F r * B r) 0 ∧ _ ≤ meromorphicOrderAt (F r * B r) 0 ∧ _
  refine ⟨(hm r).mul (hB r), ?_, ?_⟩
  · rw [meromorphicOrderAt_mul (hm r) (hB r)]
    have he : ((-((N : ℤ) + 1)) : WithTop ℤ) =
        (-1 : WithTop ℤ) + ((-(N : ℤ)) : WithTop ℤ) := by
      exact congrArg (fun z : ℤ ↦ (z : WithTop ℤ))
        (show -((N : ℤ) + 1) = (-1 : ℤ) + -(N : ℤ) by ring)
    rw [he]
    exact add_le_add (ho r) (hBo r)
  · intro hr hGr
    by_cases hry : r = y
    · subst r
      have haB : AnalyticAt ℂ (B y) 0 :=
        (RiemannRochEichler_functionLocal_analytic hE G y hGy).sub analyticAt_const
      have hzB : B y 0 = 0 := by
        simp [B, RiemannRochEichler_functionLocal, extChartAt_to_inv]
      obtain ⟨v, hv, he, _⟩ := RiemannRochEichler_cancel_simple_pole (hm y) (ho y) haB hzB
      change 0 ≤ meromorphicOrderAt (F y * B y) 0
      rw [meromorphicOrderAt_congr he]
      exact hv.meromorphicOrderAt_nonneg
    · change 0 ≤ meromorphicOrderAt (F r * B r) 0
      rw [meromorphicOrderAt_mul (hm r) (hB r)]
      exact add_nonneg (hout r hr hry)
        ((RiemannRochEichler_functionLocal_analytic hE G r hGr).sub
          analyticAt_const).meromorphicOrderAt_nonneg


/-- Modified normalized kernel coefficients lie, as differential germs, in one fixed finite-dimensional space. -/
lemma RiemannRochEichler_modified_kernel_in_space
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) {ι : Type} [Fintype ι]
    (a : ι → C) (ha : Function.Injective a) (b : Module.Basis ι ℂ (b3_HolForm E C))
    (hb : ∀ i j, RiemannRochEichler_eval hE (a i) (b j) = if i = j then 1 else 0)
    (q : C) (hq : q ∉ Set.range a)
    (K : C → b4c_MeroForm E C hE)
    (hK : ∀ p, p ∉ Set.range a → p ≠ q →
      b4c_res (hE := hE) (K p) p = -1 ∧ b4c_res (hE := hE) (K p) q = 1 ∧
      (∀ x, (-1 : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (K p) x) 0) ∧
      (∀ x, x ≠ p → x ≠ q → 0 ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (K p) x) 0) ∧
      (∀ i, AnalyticAt ℂ (HurwitzPrymRR_loc hE (K p) (a i)) 0) ∧
      ∀ i, K p ⟨a i, b4cov_lineEquiv hE 1⟩ = 0)
    (S : Finset C) (hSa : ∀ i, a i ∈ S) (hSq : q ∈ S)
    (G : b4c_MeroFun E C) (N M : ℕ)
    (hG : ∀ r, ((-(N : ℤ)) : WithTop ℤ) ≤ meromorphicOrderAt
      (RiemannRochEichler_functionLocal hE G r) 0)
    (hGout : ∀ r ∉ S, G r ≠ OnePoint.infty)
    (η : b4c_MeroForm E C hE)
    (hη : ∀ r, ((-(M : ℤ)) : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE η r) 0)
    (hηout : ∀ r ∉ S, 0 ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE η r) 0) :
    ∃ W : Submodule ℂ (TangentBundle 𝓘(ℂ, E) C → ℂ), Module.Finite ℂ W ∧
      (∀ v ∈ W, b4c_IsMeroForm hE v ∧
        ∀ p ∉ S, AnalyticAt ℂ (HurwitzPrymRR_loc hE v p) 0) ∧
      ∀ y ∉ S, ∃ v ∈ W, ∀ r,
        HurwitzPrymRR_loc hE v r =ᶠ[𝓝[≠] 0] (fun t ↦
          (residue (fun z ↦ HurwitzPrymRR_loc hE
            (K ((extChartAt 𝓘(ℂ, E) r).symm
              (extChartAt 𝓘(ℂ, E) r r + b4cov_lineEquiv hE t))) y z / z) 0) *
            (RiemannRochEichler_functionLocal hE G r t - (G y).elim 0 id) *
              HurwitzPrymRR_loc hE η r t) := by
  obtain ⟨W, hfin, hW, hrep⟩ :=
    RiemannRochEichler_scalar_bounded_space hE S (N + 1) M η hη hηout
  refine ⟨W, hfin, hW, ?_⟩
  intro y hyS
  have hy : y ∉ Set.range a := by
    rintro ⟨i, rfl⟩
    exact hyS (hSa i)
  have hyq : y ≠ q := fun he ↦ hyS (he ▸ hSq)
  have hdata := RiemannRochEichler_modified_parameter_orders hE a ha b hb q y hq hy hyq
    K hK G (hGout y hyS) N hG
  let f : C → ℂ := fun p ↦ (residue (fun z ↦ HurwitzPrymRR_loc hE (K p) y z / z) 0) *
    ((G p).elim 0 id - (G y).elim 0 id)
  apply hrep f
  · intro r
    exact (hdata r).1
  · intro r
    have hc : ((-((N + 1 : ℕ) : ℤ)) : WithTop ℤ) =
        ((-((N : ℤ) + 1)) : WithTop ℤ) :=
      congrArg (fun z : ℤ ↦ (z : WithTop ℤ))
        (show -((N + 1 : ℕ) : ℤ) = -((N : ℤ) + 1) by simp only [Nat.cast_add, Nat.cast_one])
    rw [hc]
    exact (hdata r).2.1
  · intro r hr
    have hrA : r ∉ Set.range a := by
      rintro ⟨i, rfl⟩
      exact hr (hSa i)
    exact (hdata r).2.2 hrA (hGout r hr)


/-- Zeroing finitely many fibres gives a finite-dimensional space with the same differential germs. -/
lemma RiemannRochEichler_zero_finite_fibres_space [T1Space C]
    (hE : Module.finrank ℂ E = 1) (S : Set C) (hS : S.Finite)
    (W : Submodule ℂ (TangentBundle 𝓘(ℂ, E) C → ℂ)) [Module.Finite ℂ W]
    (hW : ∀ w ∈ W, b4c_IsMeroForm hE w ∧
      ∀ p ∉ S, AnalyticAt ℂ (HurwitzPrymRR_loc hE w p) 0) :
    ∃ V : Submodule ℂ (TangentBundle 𝓘(ℂ, E) C → ℂ), Module.Finite ℂ V ∧
      (∀ v ∈ V, b4c_IsMeroForm hE v ∧
        (∀ p ∉ S, AnalyticAt ℂ (HurwitzPrymRR_loc hE v p) 0) ∧
        ∀ p ∈ S, ∀ u, v ⟨p, u⟩ = 0) ∧
      ∀ w ∈ W, ∃ v ∈ V, ∀ p,
        HurwitzPrymRR_loc hE v p =ᶠ[𝓝[≠] 0] HurwitzPrymRR_loc hE w p := by
  let R : W →ₗ[ℂ] (TangentBundle 𝓘(ℂ, E) C → ℂ) :=
    { toFun := fun w t ↦ if t.1 ∈ S then 0 else w.1 t
      map_add' := by
        intro v w
        funext t
        by_cases ht : t.1 ∈ S <;> simp [ht]
      map_smul' := by
        intro c w
        funext t
        by_cases ht : t.1 ∈ S <;> simp [ht] }
  have he (w : W) : ∀ p,
      HurwitzPrymRR_loc hE (R w) p =ᶠ[𝓝[≠] 0] HurwitzPrymRR_loc hE w.1 p :=
    RiemannRochEichler_loc_congr_off_finite hE S hS (R w) w.1 (by
      intro p hp u
      exact if_neg hp)
  refine ⟨R.range, inferInstance, ?_, ?_⟩
  · rintro v ⟨w, rfl⟩
    have hw := hW w.1 w.property
    refine ⟨⟨?_, fun p ↦ (hw.1.2 p).congr (he w p).symm⟩, ?_, ?_⟩
    · intro p c u t
      change (if p ∈ S then _ else _) = c * (if p ∈ S then _ else _) +
        (if p ∈ S then _ else _)
      by_cases hp : p ∈ S
      · simp only [if_pos hp, mul_zero, add_zero]
      · simp only [if_neg hp]
        exact hw.1.1 p c u t
    · intro p hp
      have hz : HurwitzPrymRR_loc hE (R w) p 0 = HurwitzPrymRR_loc hE w.1 p 0 := by
        rw [RiemannRochEichler_loc_zero, RiemannRochEichler_loc_zero]
        exact if_neg hp
      exact (hw.2 p hp).congr (eventuallyEq_nhds_of_eventuallyEq_nhdsNE (he w p) hz).symm
    · intro p hp u
      exact if_pos hp
  · intro w hw
    exact ⟨R ⟨w, hw⟩, ⟨⟨w, hw⟩, rfl⟩, he ⟨w, hw⟩⟩


/-- Modified kernel germs have representatives in a fixed finite-dimensional space with zero assigned pole values. -/
lemma RiemannRochEichler_modified_kernel_regular_space
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) {ι : Type} [Fintype ι]
    (a : ι → C) (ha : Function.Injective a) (b : Module.Basis ι ℂ (b3_HolForm E C))
    (hb : ∀ i j, RiemannRochEichler_eval hE (a i) (b j) = if i = j then 1 else 0)
    (q : C) (hq : q ∉ Set.range a)
    (K : C → b4c_MeroForm E C hE)
    (hK : ∀ p, p ∉ Set.range a → p ≠ q →
      b4c_res (hE := hE) (K p) p = -1 ∧ b4c_res (hE := hE) (K p) q = 1 ∧
      (∀ x, (-1 : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (K p) x) 0) ∧
      (∀ x, x ≠ p → x ≠ q → 0 ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (K p) x) 0) ∧
      (∀ i, AnalyticAt ℂ (HurwitzPrymRR_loc hE (K p) (a i)) 0) ∧
      ∀ i, K p ⟨a i, b4cov_lineEquiv hE 1⟩ = 0)
    (S : Finset C) (hSa : ∀ i, a i ∈ S) (hSq : q ∈ S)
    (G : b4c_MeroFun E C) (N M : ℕ)
    (hG : ∀ r, ((-(N : ℤ)) : WithTop ℤ) ≤ meromorphicOrderAt
      (RiemannRochEichler_functionLocal hE G r) 0)
    (hGout : ∀ r ∉ S, G r ≠ OnePoint.infty)
    (η : b4c_MeroForm E C hE)
    (hη : ∀ r, ((-(M : ℤ)) : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE η r) 0)
    (hηout : ∀ r ∉ S, 0 ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE η r) 0) :
    ∃ W : Submodule ℂ (TangentBundle 𝓘(ℂ, E) C → ℂ), Module.Finite ℂ W ∧
      (∀ v ∈ W, b4c_IsMeroForm hE v ∧
        (∀ p ∉ S, AnalyticAt ℂ (HurwitzPrymRR_loc hE v p) 0) ∧
        ∀ p ∈ S, ∀ u, v ⟨p, u⟩ = 0) ∧
      ∀ y ∉ S, ∃ v ∈ W, ∀ r,
        HurwitzPrymRR_loc hE v r =ᶠ[𝓝[≠] 0] (fun t ↦
          (residue (fun z ↦ HurwitzPrymRR_loc hE
            (K ((extChartAt 𝓘(ℂ, E) r).symm
              (extChartAt 𝓘(ℂ, E) r r + b4cov_lineEquiv hE t))) y z / z) 0) *
            (RiemannRochEichler_functionLocal hE G r t - (G y).elim 0 id) *
              HurwitzPrymRR_loc hE η r t) := by
  obtain ⟨W, hfin, hW, hrep⟩ := RiemannRochEichler_modified_kernel_in_space hE a ha b hb q hq
    K hK S hSa hSq G N M hG hGout η hη hηout
  letI : Module.Finite ℂ W := hfin
  obtain ⟨V, hVfin, hV, hR⟩ := RiemannRochEichler_zero_finite_fibres_space hE
    (S : Set C) S.finite_toSet W hW
  refine ⟨V, hVfin, hV, ?_⟩
  intro y hy
  obtain ⟨w, hw, he⟩ := hrep y hy
  obtain ⟨v, hv, hev⟩ := hR w hw
  exact ⟨v, hv, fun r ↦ (hev r).trans (he r)⟩


/-- Evaluations away from finitely many points determine a regular differential with fixed zero pole values. -/
lemma RiemannRochEichler_evaluations_separate_off_finite [T1Space C]
    (hE : Module.finrank ℂ E = 1) (w : TangentBundle 𝓘(ℂ, E) C → ℂ)
    (hw : HurwitzPrymRR_IsLinear w) (S T : Set C) (hS : S.Finite) (hT : T.Finite)
    (ha : ∀ p ∉ S, AnalyticAt ℂ (HurwitzPrymRR_loc hE w p) 0)
    (hz : ∀ p ∈ S, ∀ u, w ⟨p, u⟩ = 0)
    (he : ∀ p ∉ S ∪ T, w ⟨p, b4cov_lineEquiv hE 1⟩ = 0) : w = 0 := by
  apply RiemannRochEichler_regular_zero_of_zero_germs hE w hw S ha hz
  have hf : ∀ p ∉ S ∪ T, ∀ u : TangentSpace 𝓘(ℂ, E) p, w ⟨p, u⟩ = 0 := by
    intro p hp u
    have hu : (u : E) = (b4cov_lineEquiv hE).symm u • b4cov_lineEquiv hE 1 := by
      rw [← map_smul, smul_eq_mul, mul_one]
      exact ((b4cov_lineEquiv hE).apply_symm_apply (u : E)).symm
    have hs := hw.smul p ((b4cov_lineEquiv hE).symm u) (b4cov_lineEquiv hE 1)
    rw [he p hp, mul_zero] at hs
    exact (congrArg (fun t : E ↦ w ⟨p, t⟩) hu).trans hs
  exact RiemannRochEichler_loc_congr_off_finite hE (S ∪ T) (hS.union hT) w 0 hf


/-- Separating evaluations suffice for joint analyticity of a finite-dimensional family. -/
lemma RiemannRochEichler_joint_analytic_of_separating_evaluations
    {V X : Type*} [AddCommGroup V] [Module ℂ V] [Module.Finite ℂ V]
    (ev : X → Module.Dual ℂ V) (hsep : ∀ v, (∀ x, ev x v = 0) → v = 0)
    (J : V →ₗ[ℂ] (ℂ → ℂ)) (F : ℂ → V) (x y : ℂ)
    (hx : ∀ z, AnalyticAt ℂ (fun t ↦ ev z (F t)) x)
    (hy : ∀ v, AnalyticAt ℂ (J v) y) :
    AnalyticAt ℂ (fun z : ℂ × ℂ ↦ J (F z.1) z.2) (x, y) := by
  classical
  have hs : Submodule.span ℂ (Set.range ev) = ⊤ := by
    apply Submodule.span_eq_top_of_ne_zero
    intro v hv
    by_contra h
    push Not at h
    exact hv (hsep v (fun z ↦ h (ev z) ⟨z, rfl⟩))
  have hl (l : Module.Dual ℂ V) : AnalyticAt ℂ (fun t ↦ l (F t)) x := by
    have hm : l ∈ Submodule.span ℂ (Set.range ev) := by rw [hs]; exact Submodule.mem_top
    induction hm using Submodule.span_induction with
    | mem l hm =>
      obtain ⟨z, rfl⟩ := hm
      exact hx z
    | zero => exact analyticAt_const
    | add l m _ _ hl hm => exact hl.add hm
    | smul c l _ hl => exact hl.const_smul
  let b := Module.finBasis ℂ V
  have he (t u : ℂ) : J (F t) u = ∑ i, b.coord i (F t) * J (b i) u := by
    have h := congrArg (fun v : V ↦ J v u) (b.sum_repr (F t))
    simpa only [map_sum, map_smul, Finset.sum_apply, Pi.smul_apply, smul_eq_mul,
      Module.Basis.coord_apply] using h.symm
  have hsum : AnalyticAt ℂ
      (fun z : ℂ × ℂ ↦ ∑ i, b.coord i (F z.1) * J (b i) z.2) (x, y) := by
    apply Finset.analyticAt_fun_sum
    intro i hi
    have h₁ : AnalyticAt ℂ (fun z : ℂ × ℂ ↦ b.coord i (F z.1)) (x, y) :=
      AnalyticAt.comp (g := fun t ↦ b.coord i (F t)) (f := Prod.fst)
        (hl (b.coord i)) analyticAt_fst
    have h₂ : AnalyticAt ℂ (fun z : ℂ × ℂ ↦ J (b i) z.2) (x, y) :=
      AnalyticAt.comp (g := J (b i)) (f := Prod.snd) (hy (b i)) analyticAt_snd
    exact h₁.mul h₂
  simpa only [← he] using hsum


/-- A regular differential family is jointly analytic when its evaluations away from a finite set are analytic. -/
lemma RiemannRochEichler_joint_analytic_differential_family [T1Space C]
    (hE : Module.finrank ℂ E = 1)
    (W : Submodule ℂ (TangentBundle 𝓘(ℂ, E) C → ℂ)) [Module.Finite ℂ W]
    (S T : Set C) (hS : S.Finite) (hT : T.Finite)
    (hw : ∀ w : W, HurwitzPrymRR_IsLinear w.1)
    (ha : ∀ w : W, ∀ p ∉ S, AnalyticAt ℂ (HurwitzPrymRR_loc hE w.1 p) 0)
    (hz : ∀ w : W, ∀ p ∈ S, ∀ u, w.1 ⟨p, u⟩ = 0)
    (F : ℂ → W) (x : ℂ) (p : C) (hp : p ∉ S)
    (hF : ∀ r ∉ S ∪ T, AnalyticAt ℂ (fun t ↦ (F t).1 ⟨r, b4cov_lineEquiv hE 1⟩) x) :
    AnalyticAt ℂ (fun z : ℂ × ℂ ↦ HurwitzPrymRR_loc hE (F z.1).1 p z.2) (x, 0) := by
  let ev : {r : C // r ∉ S ∪ T} → Module.Dual ℂ W :=
    fun r ↦ (LinearMap.proj ⟨r.1, b4cov_lineEquiv hE 1⟩).comp W.subtype
  have hsep : ∀ w : W, (∀ r, ev r w = 0) → w = 0 := by
    intro w he
    apply Subtype.ext
    apply RiemannRochEichler_evaluations_separate_off_finite hE w.1 (hw w) S T hS hT
      (ha w) (hz w)
    intro r hr
    exact he ⟨r, hr⟩
  let J : W →ₗ[ℂ] (ℂ → ℂ) :=
    { toFun := fun w ↦ HurwitzPrymRR_loc hE w.1 p
      map_add' := fun _ _ ↦ rfl
      map_smul' := fun _ _ ↦ rfl }
  exact RiemannRochEichler_joint_analytic_of_separating_evaluations ev hsep J F x 0
    (fun r ↦ hF r.1 r.2) (fun w ↦ ha w p hp)


/-- A centred chart transition is analytic with nonzero derivative. -/
lemma RiemannRochEichler_chart_transition_unit (hE : Module.finrank ℂ E = 1)
    (p q : C) (hq : q ∈ (extChartAt 𝓘(ℂ, E) p).source) :
    let G := b4cov_expr E E (id : C → C) q p
    let T := b4cov_transport hE hE G (extChartAt 𝓘(ℂ, E) q q)
    AnalyticAt ℂ T 0 ∧ deriv T 0 ≠ 0 := by
  have : FiniteDimensional ℂ E := Module.finite_of_finrank_eq_succ hE
  have := FiniteDimensional.complete ℂ E
  have : Nontrivial E := Module.nontrivial_of_finrank_eq_succ hE
  have hid : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω (id : C → C) := contMDiff_id
  set G := b4cov_expr E E (id : C → C) q p
  set T := b4cov_transport hE hE G (extChartAt 𝓘(ℂ, E) q q)
  have hqs : q ∈ (extChartAt 𝓘(ℂ, E) q).source := mem_extChartAt_source q
  have hGan : AnalyticAt ℂ G (extChartAt 𝓘(ℂ, E) q q) :=
    b4cov_analyticAt_chart id hid q p _ ((extChartAt 𝓘(ℂ, E) q).map_source hqs)
      (by rw [(extChartAt 𝓘(ℂ, E) q).left_inv hqs]; exact hq)
  have hTan : AnalyticAt ℂ T 0 := b4cov_transport_analyticAt hE hE hGan
  have hG' : fderiv ℂ G (extChartAt 𝓘(ℂ, E) q q) ≠ 0 := by
    refine (b4cov_mfderiv_ne_zero_iff_expr id hid q p q hqs hq).1 ?_
    rw [mfderiv_id]
    intro h0
    obtain ⟨v, hv⟩ := exists_ne (0 : E)
    exact hv (congrArg (fun T : E →L[ℂ] E ↦ T v) h0)
  have hT' : deriv T 0 ≠ 0 := by
    rw [b4cov_transport_deriv hE hE 0 (by simpa using hGan.differentiableAt)]
    simp only [map_zero, add_zero]
    intro h0
    apply hG'
    ext v
    have h1 : fderiv ℂ G (extChartAt 𝓘(ℂ, E) q q) (b4cov_lineEquiv hE 1) = 0 := by
      simpa using congrArg (b4cov_lineEquiv hE) h0
    have hv : v = (b4cov_lineEquiv hE).symm v • b4cov_lineEquiv hE 1 := by
      rw [← map_smul, smul_eq_mul, mul_one, ContinuousLinearEquiv.apply_symm_apply]
    rw [hv, map_smul, h1, smul_zero]
    rfl
  exact ⟨hTan, hT'⟩


/-- Coefficient values in overlapping charts differ by the derivative of the centred transition. -/
lemma RiemannRochEichler_chart_value (hE : Module.finrank ℂ E = 1)
    (w : TangentBundle 𝓘(ℂ, E) C → ℂ) (hw : HurwitzPrymRR_IsLinear w)
    (p q : C) (hq : q ∈ (extChartAt 𝓘(ℂ, E) p).source) :
    let G := b4cov_expr E E (id : C → C) q p
    let T := b4cov_transport hE hE G (extChartAt 𝓘(ℂ, E) q q)
    HurwitzPrymRR_loc hE w q 0 =
      HurwitzPrymRR_loc hE w p
        ((b4cov_lineEquiv hE).symm (extChartAt 𝓘(ℂ, E) p q - extChartAt 𝓘(ℂ, E) p p)) *
        deriv T 0 := by
  have hid : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω (id : C → C) := contMDiff_id
  have he := HurwitzPrymRR_loc_pullback hE hE id hid q p hq w hw
  rw [HurwitzPrymRR_pullback_id] at he
  have hz := he.self_of_nhds
  simpa only [b4cov_transport_zero, add_zero, id_eq] using hz


/-- A fixed evaluation chart gives joint analyticity of a finite-dimensional kernel representative family. -/
lemma RiemannRochEichler_joint_analytic_chart_scaled_family [T1Space C]
    (hE : Module.finrank ℂ E = 1) (S : Set C) (hS : S.Finite)
    (W : Submodule ℂ (TangentBundle 𝓘(ℂ, E) C → ℂ)) [Module.Finite ℂ W]
    (hw : ∀ w : W, HurwitzPrymRR_IsLinear w.1)
    (ha : ∀ w : W, ∀ p ∉ S, AnalyticAt ℂ (HurwitzPrymRR_loc hE w.1 p) 0)
    (hz : ∀ w : W, ∀ p ∈ S, ∀ u, w.1 ⟨p, u⟩ = 0)
    (K : C → b4c_MeroForm E C hE)
    (hK : ∀ r ∉ S, ∀ y ∉ S, y ≠ r → AnalyticAt ℂ (HurwitzPrymRR_loc hE (K r) y) 0)
    (G : b4c_MeroFun E C) (hG : ∀ r ∉ S, G r ≠ OnePoint.infty)
    (β : C → ℂ) (F : C → W)
    (hF : ∀ y ∉ S, ∀ r ∉ S, r ≠ y →
      (F y).1 ⟨r, b4cov_lineEquiv hE 1⟩ = HurwitzPrymRR_loc hE (K r) y 0 *
        ((G r).elim 0 id - (G y).elim 0 id) * β r)
    (e p : C) (he : e ∉ S) (hp : p ∉ S) :
    let k := fun t ↦ (extChartAt 𝓘(ℂ, E) e).symm
      (extChartAt 𝓘(ℂ, E) e e + b4cov_lineEquiv hE t)
    let d := fun t ↦ deriv (b4cov_transport hE hE
      (b4cov_expr E E (id : C → C) (k t) e) (extChartAt 𝓘(ℂ, E) (k t) (k t))) 0
    AnalyticAt ℂ (fun z : ℂ × ℂ ↦
      HurwitzPrymRR_loc hE ((d z.1)⁻¹ • (F (k z.1)).1) p z.2) (0, 0) := by
  let k := fun t ↦ (extChartAt 𝓘(ℂ, E) e).symm
    (extChartAt 𝓘(ℂ, E) e e + b4cov_lineEquiv hE t)
  let d := fun t ↦ deriv (b4cov_transport hE hE
    (b4cov_expr E E (id : C → C) (k t) e) (extChartAt 𝓘(ℂ, E) (k t) (k t))) 0
  let A : ℂ → W := fun t ↦ (d t)⁻¹ • F (k t)
  change AnalyticAt ℂ (fun z : ℂ × ℂ ↦ HurwitzPrymRR_loc hE (A z.1).1 p z.2) (0, 0)
  apply RiemannRochEichler_joint_analytic_differential_family hE W S {e} hS (Set.finite_singleton e)
    hw ha hz A 0 p hp
  intro r hr
  have hrS : r ∉ S := fun h ↦ hr (Or.inl h)
  have hre : r ≠ e := fun h ↦ hr (Or.inr h)
  have hlin : ContinuousAt (fun t : ℂ ↦ extChartAt 𝓘(ℂ, E) e e + b4cov_lineEquiv hE t) 0 :=
    continuous_const.continuousAt.add (b4cov_lineEquiv hE).continuous.continuousAt
  have ht : ∀ᶠ t : ℂ in 𝓝 0,
      extChartAt 𝓘(ℂ, E) e e + b4cov_lineEquiv hE t ∈ (extChartAt 𝓘(ℂ, E) e).target := by
    apply hlin.preimage_mem_nhds
    simpa only [map_zero, add_zero] using
      (isOpen_extChartAt_target e).mem_nhds (mem_extChartAt_target e)
  have hk0 : k 0 = e := by simp [k]
  have hk : ContinuousAt k 0 := by
    apply ((continuousOn_extChartAt_symm e).continuousAt _).comp hlin
    apply (isOpen_extChartAt_target e).mem_nhds
    simpa only [map_zero, add_zero] using mem_extChartAt_target e
  have hav : ∀ᶠ t : ℂ in 𝓝 0, k t ∉ S ∧ k t ≠ r := by
    have h₁ : ∀ᶠ t : ℂ in 𝓝 0, k t ∉ S :=
      hk.preimage_mem_nhds (hS.isClosed.isOpen_compl.mem_nhds (by change k 0 ∉ S; rw [hk0]; exact he))
    have h₂ : ∀ᶠ t : ℂ in 𝓝 0, k t ≠ r := hk.eventually_ne (by simpa only [hk0] using Ne.symm hre)
    exact h₁.and h₂
  have han : AnalyticAt ℂ (fun t ↦ HurwitzPrymRR_loc hE (K r) e t *
      ((G r).elim 0 id - RiemannRochEichler_functionLocal hE G e t) * β r) 0 :=
    ((hK r hrS e he (Ne.symm hre)).mul
      (analyticAt_const.sub (RiemannRochEichler_functionLocal_analytic hE G e (hG e he)))).mul
      analyticAt_const
  apply han.congr
  filter_upwards [ht, hav] with t ht hav
  have hks : k t ∈ (extChartAt 𝓘(ℂ, E) e).source :=
    (extChartAt 𝓘(ℂ, E) e).map_target ht
  have hcoord : (b4cov_lineEquiv hE).symm
      (extChartAt 𝓘(ℂ, E) e (k t) - extChartAt 𝓘(ℂ, E) e e) = t := by
    rw [(extChartAt 𝓘(ℂ, E) e).right_inv ht]
    simp only [add_sub_cancel_left, ContinuousLinearEquiv.symm_apply_apply]
  have hd : d t ≠ 0 := (RiemannRochEichler_chart_transition_unit hE e (k t) hks).2
  have hv := hF (k t) hav.1 r hrS (Ne.symm hav.2)
  have hc := RiemannRochEichler_chart_value hE (K r) (K r).property.1 e (k t) hks
  dsimp only at hc
  rw [hcoord] at hc
  change HurwitzPrymRR_loc hE (K r) e t *
      ((G r).elim 0 id - (G (k t)).elim 0 id) * β r =
    (d t)⁻¹ * (F (k t)).1 ⟨r, b4cov_lineEquiv hE 1⟩
  rw [hv, hc]
  change _ = (d t)⁻¹ * (HurwitzPrymRR_loc hE (K r) e t * d t * _ * _)
  field_simp


/-- Away from the exceptional points and the diagonal, normalized germ values are analytic in the pole parameter. -/
lemma RiemannRochEichler_normalized_parameter_analytic
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) {ι : Type} [Fintype ι]
    (a : ι → C) (ha : Function.Injective a) (b : Module.Basis ι ℂ (b3_HolForm E C))
    (hb : ∀ i j, RiemannRochEichler_eval hE (a i) (b j) = if i = j then 1 else 0)
    (q y : C) (hq : q ∉ Set.range a) (hy : y ∉ Set.range a) (hyq : y ≠ q)
    (K : C → b4c_MeroForm E C hE)
    (hK : ∀ p, p ∉ Set.range a → p ≠ q →
      b4c_res (hE := hE) (K p) p = -1 ∧ b4c_res (hE := hE) (K p) q = 1 ∧
      (∀ x, (-1 : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (K p) x) 0) ∧
      (∀ x, x ≠ p → x ≠ q → 0 ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (K p) x) 0) ∧
      (∀ i, AnalyticAt ℂ (HurwitzPrymRR_loc hE (K p) (a i)) 0) ∧
      ∀ i, K p ⟨a i, b4cov_lineEquiv hE 1⟩ = 0)
    (r : C) (hr : r ∉ Set.range a) (hrq : r ≠ q) (hry : r ≠ y) :
    AnalyticAt ℂ (fun t ↦ residue (fun z ↦
      HurwitzPrymRR_loc hE
        (K ((extChartAt 𝓘(ℂ, E) r).symm
          (extChartAt 𝓘(ℂ, E) r r + b4cov_lineEquiv hE t))) y z / z) 0) 0 := by
  obtain ⟨f, _, hfo, hfout, hres⟩ := RiemannRochEichler_function_with_extra_pole hE a ha b hb y hy
  let S := Set.range a ∪ ({q, y} : Set C)
  have hS : S.Finite := (Set.finite_range a).union (Set.toFinite _)
  have he : ∀ p ∉ S,
      residue (fun z ↦ HurwitzPrymRR_loc hE (K p) y z / z) 0 =
        ((f p).elim 0 id - (f q).elim 0 id) /
          residue (RiemannRochEichler_functionLocal hE f y) 0 := by
    intro p hp
    have hpA : p ∉ Set.range a := fun h ↦ hp (Or.inl h)
    have hpq : p ≠ q := fun h ↦ hp (Or.inr (Or.inl h))
    have hpy : p ≠ y := fun h ↦ hp (Or.inr (Or.inr h))
    obtain ⟨h₁, h₂, h₃, h₄, h₅, h₆⟩ := hK p hpA hpq
    have hfp := (RiemannRochEichler_functionLocal_nonneg_iff hE f p).mp (hfout p hpA hpy)
    have hfq := (RiemannRochEichler_functionLocal_nonneg_iff hE f q).mp (hfout q hq (Ne.symm hyq))
    apply (eq_div_iff hres).mpr
    simpa only [mul_comm] using RiemannRochEichler_third_kind_reciprocity hE a p q y hpq
      (Ne.symm hpy) hyq f (K p) hfp hfq hfo hfout h₁ h₂ h₃ h₄ h₅ h₆
  have hloc := RiemannRochEichler_scalar_loc_congr_off_finite hE S hS _ _ he r
  have hfr := (RiemannRochEichler_functionLocal_nonneg_iff hE f r).mp (hfout r hr hry)
  have hm : AnalyticAt ℂ (fun t ↦
      (RiemannRochEichler_functionLocal hE f r t - (f q).elim 0 id) /
        residue (RiemannRochEichler_functionLocal hE f y) 0) 0 :=
    ((RiemannRochEichler_functionLocal_analytic hE f r hfr).sub analyticAt_const).div
      analyticAt_const hres
  apply hm.congr
  apply (eventuallyEq_nhds_of_eventuallyEq_nhdsNE hloc _).symm
  simp only [map_zero, add_zero, extChartAt_to_inv]
  exact he r (by simpa only [S, Set.mem_union, Set.mem_range, Set.mem_insert_iff,
    Set.mem_singleton_iff, not_or] using And.intro hr (And.intro hrq hry))


/-- A regular representative of a modified kernel germ has its expected value away from the diagonal. -/
lemma RiemannRochEichler_modified_representative_value
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) {ι : Type} [Fintype ι]
    (a : ι → C) (ha : Function.Injective a) (b : Module.Basis ι ℂ (b3_HolForm E C))
    (hb : ∀ i j, RiemannRochEichler_eval hE (a i) (b j) = if i = j then 1 else 0)
    (q y : C) (hq : q ∉ Set.range a) (hy : y ∉ Set.range a) (hyq : y ≠ q)
    (K : C → b4c_MeroForm E C hE)
    (hK : ∀ p, p ∉ Set.range a → p ≠ q →
      b4c_res (hE := hE) (K p) p = -1 ∧ b4c_res (hE := hE) (K p) q = 1 ∧
      (∀ x, (-1 : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (K p) x) 0) ∧
      (∀ x, x ≠ p → x ≠ q → 0 ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (K p) x) 0) ∧
      (∀ i, AnalyticAt ℂ (HurwitzPrymRR_loc hE (K p) (a i)) 0) ∧
      ∀ i, K p ⟨a i, b4cov_lineEquiv hE 1⟩ = 0)
    (r : C) (hr : r ∉ Set.range a) (hrq : r ≠ q) (hry : r ≠ y)
    (G : b4c_MeroFun E C) (hGr : G r ≠ OnePoint.infty)
    (η : b4c_MeroForm E C hE) (hη : AnalyticAt ℂ (HurwitzPrymRR_loc hE η r) 0)
    (v : TangentBundle 𝓘(ℂ, E) C → ℂ) (hv : AnalyticAt ℂ (HurwitzPrymRR_loc hE v r) 0)
    (he : HurwitzPrymRR_loc hE v r =ᶠ[𝓝[≠] 0] (fun t ↦
      (residue (fun z ↦ HurwitzPrymRR_loc hE
        (K ((extChartAt 𝓘(ℂ, E) r).symm
          (extChartAt 𝓘(ℂ, E) r r + b4cov_lineEquiv hE t))) y z / z) 0) *
        (RiemannRochEichler_functionLocal hE G r t - (G y).elim 0 id) *
          HurwitzPrymRR_loc hE η r t)) :
    v ⟨r, b4cov_lineEquiv hE 1⟩ =
      (residue (fun z ↦ HurwitzPrymRR_loc hE (K r) y z / z) 0) *
        ((G r).elim 0 id - (G y).elim 0 id) * η ⟨r, b4cov_lineEquiv hE 1⟩ := by
  have hF := RiemannRochEichler_normalized_parameter_analytic hE a ha b hb q y hq hy hyq
    K hK r hr hrq hry
  have hG : AnalyticAt ℂ (fun t ↦ RiemannRochEichler_functionLocal hE G r t - (G y).elim 0 id) 0 :=
    (RiemannRochEichler_functionLocal_analytic hE G r hGr).sub analyticAt_const
  have hprod := (hF.mul hG).mul hη
  have hv0 := ((hv.continuousAt.eventuallyEq_nhds_iff_eventuallyEq_nhdsNE
    hprod.continuousAt).mp he).self_of_nhds
  simpa only [Pi.mul_apply, RiemannRochEichler_loc_zero, RiemannRochEichler_functionLocal,
    map_zero, add_zero, extChartAt_to_inv] using hv0


/-- Modified normalized kernel germs have finite-dimensional representatives jointly analytic in fixed local charts. -/
lemma RiemannRochEichler_joint_modified_kernel_family
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) {ι : Type} [Fintype ι]
    (a : ι → C) (ha : Function.Injective a) (b : Module.Basis ι ℂ (b3_HolForm E C))
    (hb : ∀ i j, RiemannRochEichler_eval hE (a i) (b j) = if i = j then 1 else 0)
    (q : C) (hq : q ∉ Set.range a)
    (K : C → b4c_MeroForm E C hE)
    (hK : ∀ p, p ∉ Set.range a → p ≠ q →
      b4c_res (hE := hE) (K p) p = -1 ∧ b4c_res (hE := hE) (K p) q = 1 ∧
      (∀ x, (-1 : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (K p) x) 0) ∧
      (∀ x, x ≠ p → x ≠ q → AnalyticAt ℂ (HurwitzPrymRR_loc hE (K p) x) 0) ∧
      ∀ i, K p ⟨a i, b4cov_lineEquiv hE 1⟩ = 0)
    (S : Finset C) (hSa : ∀ i, a i ∈ S) (hSq : q ∈ S)
    (G : b4c_MeroFun E C) (N M : ℕ)
    (hG : ∀ r, ((-(N : ℤ)) : WithTop ℤ) ≤ meromorphicOrderAt
      (RiemannRochEichler_functionLocal hE G r) 0)
    (hGout : ∀ r ∉ S, G r ≠ OnePoint.infty)
    (η : b4c_MeroForm E C hE)
    (hη : ∀ r, ((-(M : ℤ)) : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE η r) 0)
    (hηout : ∀ r ∉ S, AnalyticAt ℂ (HurwitzPrymRR_loc hE η r) 0) :
    ∃ W : Submodule ℂ (TangentBundle 𝓘(ℂ, E) C → ℂ), Module.Finite ℂ W ∧
      ∃ F : C → W,
      (∀ v ∈ W, b4c_IsMeroForm hE v ∧
        (∀ p ∉ S, AnalyticAt ℂ (HurwitzPrymRR_loc hE v p) 0) ∧
        ∀ p ∈ S, ∀ u, v ⟨p, u⟩ = 0) ∧
      (∀ y ∉ S, ∀ r, HurwitzPrymRR_loc hE (F y).1 r =ᶠ[𝓝[≠] 0] (fun t ↦
        (residue (fun z ↦ HurwitzPrymRR_loc hE
          (K ((extChartAt 𝓘(ℂ, E) r).symm
            (extChartAt 𝓘(ℂ, E) r r + b4cov_lineEquiv hE t))) y z / z) 0) *
          (RiemannRochEichler_functionLocal hE G r t - (G y).elim 0 id) *
            HurwitzPrymRR_loc hE η r t)) ∧
      ∀ e ∉ S, ∀ p ∉ S,
        let k := fun t ↦ (extChartAt 𝓘(ℂ, E) e).symm
          (extChartAt 𝓘(ℂ, E) e e + b4cov_lineEquiv hE t)
        let d := fun t ↦ deriv (b4cov_transport hE hE
          (b4cov_expr E E (id : C → C) (k t) e) (extChartAt 𝓘(ℂ, E) (k t) (k t))) 0
        AnalyticAt ℂ (fun z : ℂ × ℂ ↦
          HurwitzPrymRR_loc hE ((d z.1)⁻¹ • (F (k z.1)).1) p z.2) (0, 0) := by
  classical
  have hnorm : ∀ p, p ∉ Set.range a → p ≠ q →
      b4c_res (hE := hE) (K p) p = -1 ∧ b4c_res (hE := hE) (K p) q = 1 ∧
      (∀ x, (-1 : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (K p) x) 0) ∧
      (∀ x, x ≠ p → x ≠ q → 0 ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (K p) x) 0) ∧
      (∀ i, AnalyticAt ℂ (HurwitzPrymRR_loc hE (K p) (a i)) 0) ∧
      ∀ i, K p ⟨a i, b4cov_lineEquiv hE 1⟩ = 0 := by
    intro p hp hpq
    obtain ⟨h₁, h₂, h₃, h₄, h₅⟩ := hK p hp hpq
    exact ⟨h₁, h₂, h₃, fun x hxp hxq ↦ (h₄ x hxp hxq).meromorphicOrderAt_nonneg,
      fun i ↦ h₄ (a i) (fun h ↦ hp ⟨i, h⟩) (fun h ↦ hq ⟨i, h⟩), h₅⟩
  obtain ⟨W, hfin, hW, hrep⟩ := RiemannRochEichler_modified_kernel_regular_space hE a ha b hb q hq
    K hnorm S hSa hSq G N M hG hGout η hη (fun r hr ↦ (hηout r hr).meromorphicOrderAt_nonneg)
  letI : Module.Finite ℂ W := hfin
  choose v hv hvrep using hrep
  let F : C → W := fun y ↦ if hy : y ∈ S then 0 else ⟨v y hy, hv y hy⟩
  have hF (y : C) (hy : y ∉ S) : (F y).1 = v y hy := by simp only [F, dif_neg hy]
  have hFA (y : C) (hy : y ∉ S) : y ∉ Set.range a := by
    rintro ⟨i, rfl⟩
    exact hy (hSa i)
  have hFq (y : C) (hy : y ∉ S) : y ≠ q := fun he ↦ hy (he ▸ hSq)
  refine ⟨W, hfin, F, hW, ?_, ?_⟩
  · intro y hy r
    rw [hF y hy]
    exact hvrep y hy r
  · intro e he p hp
    apply RiemannRochEichler_joint_analytic_chart_scaled_family hE (S : Set C) S.finite_toSet W
      (fun w ↦ (hW w.1 w.property).1.1) (fun w ↦ (hW w.1 w.property).2.1)
      (fun w ↦ (hW w.1 w.property).2.2) K
      (fun r hr y hy hyr ↦ (hK r (hFA r hr) (hFq r hr)).2.2.2.1 y hyr (hFq y hy))
      G hGout (fun r ↦ η ⟨r, b4cov_lineEquiv hE 1⟩) F _ e p he hp
    intro y hy r hr hry
    have hvreg := (hW (F y).1 (F y).property).2.1 r hr
    have hval := RiemannRochEichler_modified_representative_value hE a ha b hb q y hq
      (hFA y hy) (hFq y hy) K hnorm r (hFA r hr) (hFq r hr) hry G (hGout r hr)
      η (hηout r hr) (F y).1 hvreg (by rw [hF y hy]; exact hvrep y hy r)
    rw [RiemannRochEichler_residue_germ_value
      ((hK r (hFA r hr) (hFq r hr)).2.2.2.1 y (Ne.symm hry) (hFq y hy))
      Filter.EventuallyEq.rfl] at hval
    exact hval


/-- Restricting a differential family to a map graph is linear in the tangent vector. -/
lemma RiemannRochEichler_graph_linear
    (K : C → TangentBundle 𝓘(ℂ, E) C → ℂ)
    (hK : ∀ p, HurwitzPrymRR_IsLinear (K p)) (s : C → C) :
    HurwitzPrymRR_IsLinear (fun t : TangentBundle 𝓘(ℂ, E) C ↦
      K t.1 ⟨s t.1, mfderiv 𝓘(ℂ, E) 𝓘(ℂ, E) s t.1 t.2⟩) := by
  intro p c u v
  change K p ⟨s p, mfderiv 𝓘(ℂ, E) 𝓘(ℂ, E) s p (c • u + v)⟩ = _
  rw [map_add, map_smul]
  exact hK p (s p) c _ _


/-- Meromorphic separating evaluations give meromorphic graph restrictions in finite dimension. -/
lemma RiemannRochEichler_finite_family_graph_meromorphic
    {V X : Type*} [AddCommGroup V] [Module ℂ V] [Module.Finite ℂ V]
    (ev : X → Module.Dual ℂ V) (hsep : ∀ v, (∀ z, ev z v = 0) → v = 0)
    (J : V →ₗ[ℂ] (ℂ → ℂ)) (F : ℂ → V) (x : ℂ)
    (hF : ∀ z, MeromorphicAt (fun t ↦ ev z (F t)) x)
    (hJ : ∀ v, MeromorphicAt (J v) x) :
    MeromorphicAt (fun z ↦ J (F z) z) x := by
  classical
  have hs : Submodule.span ℂ (Set.range ev) = ⊤ := by
    apply Submodule.span_eq_top_of_ne_zero
    intro v hv
    by_contra h
    push Not at h
    exact hv (hsep v (fun z ↦ h (ev z) ⟨z, rfl⟩))
  have hl (l : Module.Dual ℂ V) : MeromorphicAt (fun t ↦ l (F t)) x := by
    have hm : l ∈ Submodule.span ℂ (Set.range ev) := by rw [hs]; exact Submodule.mem_top
    induction hm using Submodule.span_induction with
    | mem l hm =>
      obtain ⟨z, rfl⟩ := hm
      exact hF z
    | zero => exact MeromorphicAt.const _ _
    | add l m _ _ hl hm => exact hl.add hm
    | smul c l _ hl => exact hl.const_smul c
  let b := Module.finBasis ℂ V
  let Q := fun i z ↦ b.coord i (F z) * J (b i) z
  have hQ (i : Fin (Module.finrank ℂ V)) : MeromorphicAt (Q i) x :=
    (hl (b.coord i)).mul (hJ (b i))
  have he : (fun z ↦ J (F z) z) = ∑ i, Q i := by
    funext z
    have h := congrArg (fun v : V ↦ J v z) (b.sum_repr (F z))
    simpa only [Q, map_sum, map_smul, Finset.sum_apply, Pi.smul_apply, smul_eq_mul,
      Module.Basis.coord_apply] using h.symm
  exact he ▸ MeromorphicAt.sum (fun i hi ↦ hQ i)


/-- Fixed-chart evaluations of modified families remain meromorphic at exceptional evaluation centres. -/
lemma RiemannRochEichler_chart_scaled_evaluation_meromorphic [T1Space C]
    (hE : Module.finrank ℂ E = 1) (S : Set C) (hS : S.Finite)
    (K : C → b4c_MeroForm E C hE) (G : b4c_MeroFun E C) (β : C → ℂ)
    (F : C → TangentBundle 𝓘(ℂ, E) C → ℂ)
    (hF : ∀ y ∉ S, ∀ r ∉ S, r ≠ y →
      F y ⟨r, b4cov_lineEquiv hE 1⟩ = HurwitzPrymRR_loc hE (K r) y 0 *
        ((G r).elim 0 id - (G y).elim 0 id) * β r)
    (e r : C) (hrS : r ∉ S) :
    let k := fun t ↦ (extChartAt 𝓘(ℂ, E) e).symm
      (extChartAt 𝓘(ℂ, E) e e + b4cov_lineEquiv hE t)
    let d := fun t ↦ deriv (b4cov_transport hE hE
      (b4cov_expr E E (id : C → C) (k t) e) (extChartAt 𝓘(ℂ, E) (k t) (k t))) 0
    MeromorphicAt (fun t ↦ (d t)⁻¹ * F (k t) ⟨r, b4cov_lineEquiv hE 1⟩) 0 := by
  let k := fun t ↦ (extChartAt 𝓘(ℂ, E) e).symm
    (extChartAt 𝓘(ℂ, E) e e + b4cov_lineEquiv hE t)
  let d := fun t ↦ deriv (b4cov_transport hE hE
    (b4cov_expr E E (id : C → C) (k t) e) (extChartAt 𝓘(ℂ, E) (k t) (k t))) 0
  have hlin : ContinuousAt (fun t : ℂ ↦ extChartAt 𝓘(ℂ, E) e e + b4cov_lineEquiv hE t) 0 :=
    continuous_const.continuousAt.add (b4cov_lineEquiv hE).continuous.continuousAt
  have ht : ∀ᶠ t : ℂ in 𝓝 0,
      extChartAt 𝓘(ℂ, E) e e + b4cov_lineEquiv hE t ∈ (extChartAt 𝓘(ℂ, E) e).target := by
    apply hlin.preimage_mem_nhds
    simpa only [map_zero, add_zero] using
      (isOpen_extChartAt_target e).mem_nhds (mem_extChartAt_target e)
  have havoid : ∀ᶠ y in 𝓝[≠] e, y ∉ S ∪ {r} := by
    have hs : ((S ∪ {r}) \ {e})ᶜ ∈ 𝓝 e :=
      (hS.union (Set.finite_singleton r)).sdiff.isClosed.isOpen_compl.mem_nhds (fun h ↦ h.2 rfl)
    filter_upwards [nhdsWithin_le_nhds hs, self_mem_nhdsWithin] with y hy hye
    exact fun h ↦ hy ⟨h, hye⟩
  have hav : ∀ᶠ t in 𝓝[≠] (0 : ℂ), k t ∉ S ∪ {r} :=
    RiemannRochEichler_inverse_coordinate_punctured hE e havoid
  have hm : MeromorphicAt (fun t ↦ HurwitzPrymRR_loc hE (K r) e t *
      ((G r).elim 0 id - RiemannRochEichler_functionLocal hE G e t) * β r) 0 :=
    (((K r).property.2 e).mul ((MeromorphicAt.const _ _).sub
      (RiemannRochEichler_fun_loc_meromorphic hE G e))).mul (MeromorphicAt.const _ _)
  apply hm.congr
  filter_upwards [nhdsWithin_le_nhds ht, hav] with t ht hav
  have hks : k t ∈ (extChartAt 𝓘(ℂ, E) e).source :=
    (extChartAt 𝓘(ℂ, E) e).map_target ht
  have hcoord : (b4cov_lineEquiv hE).symm
      (extChartAt 𝓘(ℂ, E) e (k t) - extChartAt 𝓘(ℂ, E) e e) = t := by
    rw [(extChartAt 𝓘(ℂ, E) e).right_inv ht]
    simp only [add_sub_cancel_left, ContinuousLinearEquiv.symm_apply_apply]
  have hd : d t ≠ 0 := (RiemannRochEichler_chart_transition_unit hE e (k t) hks).2
  have hv := hF (k t) (fun h ↦ hav (Or.inl h)) r hrS (fun h ↦ hav (Or.inr h.symm))
  have hc := RiemannRochEichler_chart_value hE (K r) (K r).property.1 e (k t) hks
  dsimp only at hc
  rw [hcoord] at hc
  change HurwitzPrymRR_loc hE (K r) e t *
      ((G r).elim 0 id - (G (k t)).elim 0 id) * β r =
    (d t)⁻¹ * (F (k t)) ⟨r, b4cov_lineEquiv hE 1⟩
  rw [hv, hc]
  change _ = (d t)⁻¹ * (HurwitzPrymRR_loc hE (K r) e t * d t * _ * _)
  field_simp


/-- A modified finite-dimensional kernel has meromorphic graph restrictions at all chart centres. -/
lemma RiemannRochEichler_modified_graph_meromorphic [T1Space C]
    (hE : Module.finrank ℂ E = 1) (S : Set C) (hS : S.Finite)
    (W : Submodule ℂ (TangentBundle 𝓘(ℂ, E) C → ℂ)) [Module.Finite ℂ W]
    (hw : ∀ w : W, b4c_IsMeroForm hE w.1)
    (ha : ∀ w : W, ∀ p ∉ S, AnalyticAt ℂ (HurwitzPrymRR_loc hE w.1 p) 0)
    (hz : ∀ w : W, ∀ p ∈ S, ∀ u, w.1 ⟨p, u⟩ = 0)
    (K : C → b4c_MeroForm E C hE) (G : b4c_MeroFun E C) (β : C → ℂ)
    (F : C → W)
    (hF : ∀ y ∉ S, ∀ r ∉ S, r ≠ y →
      (F y).1 ⟨r, b4cov_lineEquiv hE 1⟩ = HurwitzPrymRR_loc hE (K r) y 0 *
        ((G r).elim 0 id - (G y).elim 0 id) * β r)
    (e p : C) (T : ℂ → ℂ) (hT : AnalyticAt ℂ T 0) (hT0 : T 0 = 0) :
    let k := fun t ↦ (extChartAt 𝓘(ℂ, E) e).symm
      (extChartAt 𝓘(ℂ, E) e e + b4cov_lineEquiv hE t)
    let d := fun t ↦ deriv (b4cov_transport hE hE
      (b4cov_expr E E (id : C → C) (k t) e) (extChartAt 𝓘(ℂ, E) (k t) (k t))) 0
    MeromorphicAt (fun z ↦ HurwitzPrymRR_loc hE ((d (T z))⁻¹ • (F (k (T z))).1) p z) 0 := by
  let k := fun t ↦ (extChartAt 𝓘(ℂ, E) e).symm
    (extChartAt 𝓘(ℂ, E) e e + b4cov_lineEquiv hE t)
  let d := fun t ↦ deriv (b4cov_transport hE hE
    (b4cov_expr E E (id : C → C) (k t) e) (extChartAt 𝓘(ℂ, E) (k t) (k t))) 0
  let A : ℂ → W := fun z ↦ (d (T z))⁻¹ • F (k (T z))
  let ev : {r : C // r ∉ S} → Module.Dual ℂ W :=
    fun r ↦ (LinearMap.proj ⟨r.1, b4cov_lineEquiv hE 1⟩).comp W.subtype
  have hsep : ∀ w : W, (∀ r, ev r w = 0) → w = 0 := by
    intro w he
    apply Subtype.ext
    apply RiemannRochEichler_evaluations_separate_off_finite hE w.1 (hw w).1 S ∅ hS
      Set.finite_empty (ha w) (hz w)
    intro r hr
    exact he ⟨r, fun h ↦ hr (Or.inl h)⟩
  let J : W →ₗ[ℂ] (ℂ → ℂ) :=
    { toFun := fun w ↦ HurwitzPrymRR_loc hE w.1 p
      map_add' := fun _ _ ↦ rfl
      map_smul' := fun _ _ ↦ rfl }
  apply RiemannRochEichler_finite_family_graph_meromorphic ev hsep J A 0 _ (fun w ↦ (hw w).2 p)
  intro r
  have hm := RiemannRochEichler_chart_scaled_evaluation_meromorphic hE S hS K G β
    (fun y ↦ (F y).1) hF e r.1 r.2
  change MeromorphicAt (fun t ↦ (d t)⁻¹ * (F (k t)).1 ⟨r.1, b4cov_lineEquiv hE 1⟩) 0 at hm
  have hmT : MeromorphicAt (fun t ↦ (d t)⁻¹ * (F (k t)).1 ⟨r.1, b4cov_lineEquiv hE 1⟩) (T 0) :=
    hT0.symm ▸ hm
  exact hmT.comp_analyticAt hT


/-- The graph differential has the expected pullback coefficient with a varying parameter. -/
lemma RiemannRochEichler_graph_loc
    (hE : Module.finrank ℂ E = 1)
    (K : C → TangentBundle 𝓘(ℂ, E) C → ℂ)
    (hK : ∀ p, HurwitzPrymRR_IsLinear (K p))
    (f : C → C) (hf : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω f) (x₀ y₀ : C)
    (hx₀ : f x₀ ∈ (extChartAt 𝓘(ℂ, E) y₀).source) :
    HurwitzPrymRR_loc hE
      (fun t : TangentBundle 𝓘(ℂ, E) C ↦ K t.1
        ⟨f t.1, mfderiv 𝓘(ℂ, E) 𝓘(ℂ, E) f t.1 t.2⟩) x₀ =ᶠ[𝓝 0]
      (fun τ ↦ HurwitzPrymRR_loc hE
        (K ((extChartAt 𝓘(ℂ, E) x₀).symm
          (extChartAt 𝓘(ℂ, E) x₀ x₀ + b4cov_lineEquiv hE τ))) y₀
        ((b4cov_lineEquiv hE).symm (extChartAt 𝓘(ℂ, E) y₀ (f x₀) -
          extChartAt 𝓘(ℂ, E) y₀ y₀) +
          b4cov_transport hE hE (b4cov_expr E E f x₀ y₀) (extChartAt 𝓘(ℂ, E) x₀ x₀) τ) *
        deriv (b4cov_transport hE hE (b4cov_expr E E f x₀ y₀)
          (extChartAt 𝓘(ℂ, E) x₀ x₀)) τ) := by
  set φ := extChartAt 𝓘(ℂ, E) x₀
  set ψ := extChartAt 𝓘(ℂ, E) y₀
  set G := b4cov_expr E E f x₀ y₀
  have hx₀s : x₀ ∈ φ.source := mem_extChartAt_source x₀
  let T₀ : Set E := φ.target ∩ φ.symm ⁻¹' (f ⁻¹' ψ.source)
  have hTo : IsOpen T₀ := (continuousOn_extChartAt_symm x₀).isOpen_inter_preimage
    (isOpen_extChartAt_target x₀) (hf.continuous.isOpen_preimage _ (isOpen_extChartAt_source _))
  have ht₀ : φ x₀ ∈ T₀ := ⟨φ.map_source hx₀s, by
    simp only [mem_preimage, φ.left_inv hx₀s]; exact hx₀⟩
  have hcont : Continuous (fun τ : ℂ ↦ φ x₀ + b4cov_lineEquiv hE τ) :=
    continuous_const.add (b4cov_lineEquiv hE).continuous
  have hev : ∀ᶠ τ in 𝓝 (0 : ℂ), φ x₀ + b4cov_lineEquiv hE τ ∈ T₀ :=
    hcont.continuousAt.preimage_mem_nhds (by simpa using hTo.mem_nhds ht₀)
  filter_upwards [hev] with τ hτ
  have hGd : DifferentiableAt ℂ G (φ x₀ + b4cov_lineEquiv hE τ) :=
    (b4cov_analyticAt_chart f hf x₀ y₀ _ hτ.1 hτ.2).differentiableAt
  have hG0 : G (φ x₀) = ψ (f x₀) := by
    show ψ (f (φ.symm (φ x₀))) = ψ (f x₀)
    rw [φ.left_inv hx₀s]
  rw [b4cov_transport_deriv hE hE τ hGd]
  have hloc : HurwitzPrymRR_loc hE
      (fun t : TangentBundle 𝓘(ℂ, E) C ↦ K t.1
        ⟨f t.1, mfderiv 𝓘(ℂ, E) 𝓘(ℂ, E) f t.1 t.2⟩) x₀ τ =
      b4cov_coef (b3_pullback E E f (K (φ.symm (φ x₀ + b4cov_lineEquiv hE τ))))
        x₀ (b4cov_lineEquiv hE 1) (φ x₀ + b4cov_lineEquiv hE τ) := rfl
  rw [hloc]
  simp only [HurwitzPrymRR_loc]
  rw [HurwitzPrymRR_coef_pullback hE hE f hf x₀ y₀ _ (hK _) _ hτ.1 hτ.2]
  congr 2
  simp only [b4cov_transport, map_add, map_sub, ContinuousLinearEquiv.apply_symm_apply]
  rw [hG0]
  abel


/-- The two chart transition factors cancel in the value identity for a modified differential representative. -/
lemma RiemannRochEichler_fixed_chart_modified_value
    (hE : Module.finrank ℂ E = 1)
    (v w η : TangentBundle 𝓘(ℂ, E) C → ℂ)
    (hvlin : HurwitzPrymRR_IsLinear v) (hwlin : HurwitzPrymRR_IsLinear w)
    (hηlin : HurwitzPrymRR_IsLinear η)
    (p e x y : C) (hx : x ∈ (extChartAt 𝓘(ℂ, E) p).source)
    (hy : y ∈ (extChartAt 𝓘(ℂ, E) e).source) (δ : ℂ)
    (hv : v ⟨x, b4cov_lineEquiv hE 1⟩ =
      w ⟨y, b4cov_lineEquiv hE 1⟩ * δ * η ⟨x, b4cov_lineEquiv hE 1⟩) :
    let cx := (b4cov_lineEquiv hE).symm (extChartAt 𝓘(ℂ, E) p x - extChartAt 𝓘(ℂ, E) p p)
    let cy := (b4cov_lineEquiv hE).symm (extChartAt 𝓘(ℂ, E) e y - extChartAt 𝓘(ℂ, E) e e)
    let dy := deriv (b4cov_transport hE hE (b4cov_expr E E (id : C → C) y e)
      (extChartAt 𝓘(ℂ, E) y y)) 0
    HurwitzPrymRR_loc hE (dy⁻¹ • v) p cx =
      HurwitzPrymRR_loc hE w e cy * δ * HurwitzPrymRR_loc hE η p cx := by
  let cx := (b4cov_lineEquiv hE).symm (extChartAt 𝓘(ℂ, E) p x - extChartAt 𝓘(ℂ, E) p p)
  let cy := (b4cov_lineEquiv hE).symm (extChartAt 𝓘(ℂ, E) e y - extChartAt 𝓘(ℂ, E) e e)
  let dx := deriv (b4cov_transport hE hE (b4cov_expr E E (id : C → C) x p)
    (extChartAt 𝓘(ℂ, E) x x)) 0
  let dy := deriv (b4cov_transport hE hE (b4cov_expr E E (id : C → C) y e)
    (extChartAt 𝓘(ℂ, E) y y)) 0
  have hdx : dx ≠ 0 := (RiemannRochEichler_chart_transition_unit hE p x hx).2
  have hdy : dy ≠ 0 := (RiemannRochEichler_chart_transition_unit hE e y hy).2
  have hvx := RiemannRochEichler_chart_value hE v hvlin p x hx
  have hηx := RiemannRochEichler_chart_value hE η hηlin p x hx
  have hwy := RiemannRochEichler_chart_value hE w hwlin e y hy
  dsimp only at hvx hηx hwy
  rw [RiemannRochEichler_loc_zero] at hvx hηx hwy
  rw [hvx, hηx, hwy] at hv
  have he : HurwitzPrymRR_loc hE v p cx =
      HurwitzPrymRR_loc hE w e cy * dy * δ * HurwitzPrymRR_loc hE η p cx := by
    apply mul_right_cancel₀ hdx
    calc
      _ = (HurwitzPrymRR_loc hE w e cy * dy) * δ *
          (HurwitzPrymRR_loc hE η p cx * dx) := hv
      _ = _ := by ring
  change dy⁻¹ * HurwitzPrymRR_loc hE v p cx = _
  rw [he]
  field_simp
  dsimp only [cx, cy]
  ring


/-- Distinct source and target charts give the modified graph product identity. -/
lemma RiemannRochEichler_graph_modified_product_charts
    (hE : Module.finrank ℂ E = 1)
    (K F : C → TangentBundle 𝓘(ℂ, E) C → ℂ)
    (hK : ∀ p, HurwitzPrymRR_IsLinear (K p))
    (hF : ∀ p, HurwitzPrymRR_IsLinear (F p))
    (η : TangentBundle 𝓘(ℂ, E) C → ℂ) (hη : HurwitzPrymRR_IsLinear η)
    (G : C → ℂ) (U : Set C)
    (hval : ∀ x ∈ U, ∀ y ∈ U, x ≠ y →
      F y ⟨x, b4cov_lineEquiv hE 1⟩ =
        K x ⟨y, b4cov_lineEquiv hE 1⟩ * (G x - G y) * η ⟨x, b4cov_lineEquiv hE 1⟩)
    (f : C → C) (hf : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω f) (p e : C) (hfp : f p = e)
    (hpoints : ∀ᶠ z in 𝓝[≠] (0 : ℂ),
      let x := (extChartAt 𝓘(ℂ, E) p).symm
        (extChartAt 𝓘(ℂ, E) p p + b4cov_lineEquiv hE z)
      x ∈ U ∧ f x ∈ U ∧ x ≠ f x) :
    let k := fun z ↦ (extChartAt 𝓘(ℂ, E) p).symm
      (extChartAt 𝓘(ℂ, E) p p + b4cov_lineEquiv hE z)
    let j := fun z ↦ (extChartAt 𝓘(ℂ, E) e).symm
      (extChartAt 𝓘(ℂ, E) e e + b4cov_lineEquiv hE z)
    let T := b4cov_transport hE hE (b4cov_expr E E f p e) (extChartAt 𝓘(ℂ, E) p p)
    let d := fun y ↦ deriv (b4cov_transport hE hE (b4cov_expr E E (id : C → C) y e)
      (extChartAt 𝓘(ℂ, E) y y)) 0
    (fun z ↦ HurwitzPrymRR_loc hE ((d (j (T z)))⁻¹ • F (j (T z))) p z * deriv T z)
      =ᶠ[𝓝[≠] 0]
    (fun z ↦ HurwitzPrymRR_loc hE
      (fun t : TangentBundle 𝓘(ℂ, E) C ↦ K t.1
        ⟨f t.1, mfderiv 𝓘(ℂ, E) 𝓘(ℂ, E) f t.1 t.2⟩) p z *
      (HurwitzPrymRR_loc hE η p z * (G (k z) - G (j (T z))))) := by
  let φ := extChartAt 𝓘(ℂ, E) p
  let ψ := extChartAt 𝓘(ℂ, E) e
  let j := fun z ↦ ψ.symm (ψ e + b4cov_lineEquiv hE z)
  let k := fun z ↦ φ.symm (φ p + b4cov_lineEquiv hE z)
  let T := b4cov_transport hE hE (b4cov_expr E E f p e) (φ p)
  have hes : e ∈ ψ.source := mem_extChartAt_source e
  have hps : p ∈ φ.source := mem_extChartAt_source p
  have hkp : k 0 = p := by simp [k, φ]
  have hlin : ContinuousAt (fun z : ℂ ↦ φ p + b4cov_lineEquiv hE z) 0 :=
    continuous_const.continuousAt.add (b4cov_lineEquiv hE).continuous.continuousAt
  have hk : ContinuousAt k 0 := by
    apply ((continuousOn_extChartAt_symm p).continuousAt _).comp hlin
    apply (isOpen_extChartAt_target p).mem_nhds
    simpa only [map_zero, add_zero] using mem_extChartAt_target p
  have hnear : ∀ᶠ z in 𝓝 (0 : ℂ),
      φ p + b4cov_lineEquiv hE z ∈ φ.target ∧ f (k z) ∈ ψ.source := by
    have h₁ : ∀ᶠ z in 𝓝 (0 : ℂ), φ p + b4cov_lineEquiv hE z ∈ φ.target :=
      hlin.preimage_mem_nhds
        (by simpa only [map_zero, add_zero] using (isOpen_extChartAt_target p).mem_nhds (φ.map_source hps))
    have h₂ : ∀ᶠ z in 𝓝 (0 : ℂ), f (k z) ∈ ψ.source :=
      (hf.continuous.continuousAt.comp hk).preimage_mem_nhds
        (by change ψ.source ∈ 𝓝 (f (k 0)); rw [hkp, hfp]; exact (isOpen_extChartAt_source e).mem_nhds hes)
    exact h₁.and h₂
  have hloc := RiemannRochEichler_graph_loc hE K hK f hf p e (by rw [hfp]; exact hes)
  simp only [hfp, sub_self, map_zero, zero_add] at hloc
  filter_upwards [hpoints, nhdsWithin_le_nhds hnear, nhdsWithin_le_nhds hloc] with z hz hn hl
  have hcx : (b4cov_lineEquiv hE).symm (φ (k z) - φ p) = z := by
    rw [φ.right_inv hn.1, add_sub_cancel_left]
    exact (b4cov_lineEquiv hE).symm_apply_apply z
  have hT : T z = (b4cov_lineEquiv hE).symm (ψ (f (k z)) - ψ e) := by
    change (b4cov_lineEquiv hE).symm (ψ (f (k z))) -
      (b4cov_lineEquiv hE).symm (ψ (f (φ.symm (φ p)))) = _
    rw [φ.left_inv hps, hfp, map_sub]
  have hkT : j (T z) = f (k z) := by
    rw [hT]
    dsimp only [j]
    rw [ContinuousLinearEquiv.apply_symm_apply, add_sub_cancel, ψ.left_inv hn.2]
  have hv := RiemannRochEichler_fixed_chart_modified_value hE (F (f (k z))) (K (k z)) η
    (hF _) (hK _) hη p e (k z) (f (k z)) (φ.map_target hn.1) hn.2
    (G (k z) - G (f (k z))) (hval _ hz.1 _ hz.2.1 hz.2.2)
  dsimp only at hv
  rw [hcx, ← hT] at hv
  change HurwitzPrymRR_loc hE
    ((deriv (b4cov_transport hE hE (b4cov_expr E E (id : C → C) (j (T z)) e)
      (extChartAt 𝓘(ℂ, E) (j (T z)) (j (T z)))) 0)⁻¹ • F (j (T z))) p z * deriv T z =
    HurwitzPrymRR_loc hE
      (fun t : TangentBundle 𝓘(ℂ, E) C ↦ K t.1
        ⟨f t.1, mfderiv 𝓘(ℂ, E) 𝓘(ℂ, E) f t.1 t.2⟩) p z *
      (HurwitzPrymRR_loc hE η p z * (G (k z) - G (j (T z))))
  rw [hkT, hv, hl]
  dsimp only [k, j, T, φ, ψ]
  ring


/-- A separating scalar factor transfers meromorphy from a modified kernel to its graph differential. -/
lemma RiemannRochEichler_graph_meromorphic_of_modified
    [T1Space C] (hE : Module.finrank ℂ E = 1) (S : Set C) (hS : S.Finite)
    (W : Submodule ℂ (TangentBundle 𝓘(ℂ, E) C → ℂ)) [Module.Finite ℂ W]
    (hw : ∀ w : W, b4c_IsMeroForm hE w.1)
    (ha : ∀ w : W, ∀ p ∉ S, AnalyticAt ℂ (HurwitzPrymRR_loc hE w.1 p) 0)
    (hz : ∀ w : W, ∀ p ∈ S, ∀ u, w.1 ⟨p, u⟩ = 0)
    (K : C → b4c_MeroForm E C hE) (G : b4c_MeroFun E C)
    (η : b4c_MeroForm E C hE) (F : C → W)
    (hF : ∀ y ∉ S, ∀ r ∉ S, r ≠ y →
      (F y).1 ⟨r, b4cov_lineEquiv hE 1⟩ = HurwitzPrymRR_loc hE (K r) y 0 *
        ((G r).elim 0 id - (G y).elim 0 id) * η ⟨r, b4cov_lineEquiv hE 1⟩)
    (f : C → C) (hf : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω f) (hfi : Function.Injective f)
    (p : C)
    (hη : ∀ᶠ z in 𝓝[≠] (0 : ℂ), HurwitzPrymRR_loc hE η p z ≠ 0)
    (hG : ∀ᶠ z in 𝓝[≠] (0 : ℂ),
      let x := (extChartAt 𝓘(ℂ, E) p).symm
        (extChartAt 𝓘(ℂ, E) p p + b4cov_lineEquiv hE z)
      (G x).elim 0 id ≠ (G (f x)).elim 0 id) :
    MeromorphicAt (HurwitzPrymRR_loc hE
      (fun t : TangentBundle 𝓘(ℂ, E) C ↦ K t.1
        ⟨f t.1, mfderiv 𝓘(ℂ, E) 𝓘(ℂ, E) f t.1 t.2⟩) p) 0 := by
  let k := fun z ↦ (extChartAt 𝓘(ℂ, E) p).symm
    (extChartAt 𝓘(ℂ, E) p p + b4cov_lineEquiv hE z)
  let j := fun z ↦ (extChartAt 𝓘(ℂ, E) (f p)).symm
    (extChartAt 𝓘(ℂ, E) (f p) (f p) + b4cov_lineEquiv hE z)
  let T := b4cov_transport hE hE (b4cov_expr E E f p (f p)) (extChartAt 𝓘(ℂ, E) p p)
  let d := fun t ↦ deriv (b4cov_transport hE hE
    (b4cov_expr E E (id : C → C) (j t) (f p)) (extChartAt 𝓘(ℂ, E) (j t) (j t))) 0
  let N := fun z ↦ HurwitzPrymRR_loc hE ((d (T z))⁻¹ • (F (j (T z))).1) p z * deriv T z
  let D := fun z ↦ HurwitzPrymRR_loc hE η p z *
    ((G (k z)).elim 0 id - (G (f (k z))).elim 0 id)
  have hTa : AnalyticAt ℂ T 0 := by
    apply b4cov_transport_analyticAt
    apply b4cov_analyticAt_chart f hf p (f p) _ (mem_extChartAt_target p)
    rw [extChartAt_to_inv]
    exact mem_extChartAt_source (f p)
  have hT0 : T 0 = 0 := b4cov_transport_zero _ _ _ _
  have hN : MeromorphicAt N 0 :=
    (RiemannRochEichler_modified_graph_meromorphic hE S hS W hw ha hz K G
      (fun r ↦ η ⟨r, b4cov_lineEquiv hE 1⟩) F hF (f p) p T hTa hT0).mul hTa.deriv.meromorphicAt
  have hD : MeromorphicAt D 0 := (η.property.2 p).mul
    ((RiemannRochEichler_fun_loc_meromorphic hE G p).sub
      (RiemannRochEichler_scalar_pullback_meromorphic hE (fun x ↦ (G x).elim 0 id)
        (RiemannRochEichler_fun_loc_meromorphic hE G) f hf p))
  have hpoints : ∀ᶠ z in 𝓝[≠] (0 : ℂ), k z ∈ Sᶜ ∧ f (k z) ∈ Sᶜ ∧ k z ≠ f (k z) := by
    filter_upwards [RiemannRochEichler_coordinate_avoid_finite hE (S ∪ f ⁻¹' S)
      (hS.union (Set.Finite.preimage hfi.injOn hS)) p, hG] with z hz hg
    refine ⟨fun h ↦ hz (Or.inl h), fun h ↦ hz (Or.inr h), ?_⟩
    exact fun h ↦ hg (congrArg (fun x ↦ (G x).elim 0 id) h)
  have he := RiemannRochEichler_graph_modified_product_charts hE (fun x ↦ (K x).1)
    (fun y ↦ (F y).1) (fun x ↦ (K x).property.1) (fun y ↦ (hw (F y)).1)
    η η.property.1 (fun x ↦ (G x).elim 0 id) Sᶜ
    (fun x hx y hy hxy ↦ by simpa only [RiemannRochEichler_loc_zero] using hF y hy x hx hxy)
    f hf p (f p) rfl hpoints
  have hc := RiemannRochEichler_graph_coordinates hE f hf p (f p) rfl
  apply (hN.div hD).congr
  filter_upwards [he, nhdsWithin_le_nhds hc, hη, hG] with z he hc hη hg
  have hdn : D z ≠ 0 := mul_ne_zero hη (sub_ne_zero.mpr hg)
  change N z / D z = _
  change N z = _ at he
  change j (T z) = f (k z) at hc
  change N z = HurwitzPrymRR_loc hE
    (fun t : TangentBundle 𝓘(ℂ, E) C ↦ K t.1
      ⟨f t.1, mfderiv 𝓘(ℂ, E) 𝓘(ℂ, E) f t.1 t.2⟩) p z *
    (HurwitzPrymRR_loc hE η p z * ((G (k z)).elim 0 id - (G (j (T z))).elim 0 id)) at he
  rw [hc] at he
  change N z = _ * D z at he
  rw [he, mul_div_cancel_right₀ _ hdn]


/-- The normalized third-kind family defines a global meromorphic graph differential. -/
lemma RiemannRochEichler_normalized_graph_meromorphic
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) {ι : Type} [Fintype ι]
    (a : ι → C) (ha : Function.Injective a) (b : Module.Basis ι ℂ (b3_HolForm E C))
    (hb : ∀ i j, RiemannRochEichler_eval hE (a i) (b j) = if i = j then 1 else 0)
    (q : C) (hq : q ∉ Set.range a)
    (K : C → b4c_MeroForm E C hE)
    (hK : ∀ p, p ∉ Set.range a → p ≠ q →
      b4c_res (hE := hE) (K p) p = -1 ∧ b4c_res (hE := hE) (K p) q = 1 ∧
      (∀ x, (-1 : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (K p) x) 0) ∧
      (∀ x, x ≠ p → x ≠ q → AnalyticAt ℂ (HurwitzPrymRR_loc hE (K p) x) 0) ∧
      ∀ i, K p ⟨a i, b4cov_lineEquiv hE 1⟩ = 0)
    (f : C ≃ₜ C) (hf : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω f) (hne : f ≠ Homeomorph.refl C) :
    b4c_IsMeroForm hE (fun t : TangentBundle 𝓘(ℂ, E) C ↦ K t.1
      ⟨f t.1, mfderiv 𝓘(ℂ, E) 𝓘(ℂ, E) f t.1 t.2⟩) := by
  classical
  have hnorm : ∀ p, p ∉ Set.range a → p ≠ q →
      b4c_res (hE := hE) (K p) p = -1 ∧ b4c_res (hE := hE) (K p) q = 1 ∧
      (∀ x, (-1 : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (K p) x) 0) ∧
      (∀ x, x ≠ p → x ≠ q → 0 ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (K p) x) 0) ∧
      (∀ i, AnalyticAt ℂ (HurwitzPrymRR_loc hE (K p) (a i)) 0) ∧
      ∀ i, K p ⟨a i, b4cov_lineEquiv hE 1⟩ = 0 := by
    intro p hp hpq
    obtain ⟨h₁, h₂, h₃, h₄, h₅⟩ := hK p hp hpq
    exact ⟨h₁, h₂, h₃, fun x hxp hxq ↦ (h₄ x hxp hxq).meromorphicOrderAt_nonneg,
      fun i ↦ h₄ (a i) (fun h ↦ hp ⟨i, h⟩) (fun h ↦ hq ⟨i, h⟩), h₅⟩
  have hfi : (f : C → C) ≠ id := by
    intro h
    apply hne
    ext x
    exact congrFun h x
  obtain ⟨G, hnc, hsep⟩ := RiemannRochEichler_graph_separating_function hE f hf hfi
  obtain ⟨P, N, hP, hGo⟩ := RiemannRochEichler_function_pole_bounds hE G hnc
  obtain ⟨η, _, hη⟩ := b4c_exists_meroForm_aux (C := C) hE
  obtain ⟨M, hηo⟩ := RiemannRochEichler_uniform_form_order hE η hη
  let B := {r : C | ¬ AnalyticAt ℂ (HurwitzPrymRR_loc hE η r) 0}
  have hB : B.Finite := RiemannRochEichler_nonanalytic_finite hE η
  let A : Set C := ((Set.range a ∪ {q}) ∪ (P : Set C)) ∪ B
  have hA : A.Finite := (((Set.finite_range a).union (Set.finite_singleton q)).union
    P.finite_toSet).union hB
  let S := hA.toFinset
  have hSa : ∀ i, a i ∈ S := fun i ↦ hA.mem_toFinset.mpr (Or.inl (Or.inl (Or.inl ⟨i, rfl⟩)))
  have hSq : q ∈ S := hA.mem_toFinset.mpr (Or.inl (Or.inl (Or.inr rfl)))
  have hGout : ∀ r ∉ S, G r ≠ OnePoint.infty := by
    intro r hr h
    exact hr (hA.mem_toFinset.mpr (Or.inl (Or.inr ((hP r).mpr h))))
  have hηout : ∀ r ∉ S, AnalyticAt ℂ (HurwitzPrymRR_loc hE η r) 0 := by
    intro r hr
    by_contra h
    exact hr (hA.mem_toFinset.mpr (Or.inr h))
  have hFA (y : C) (hy : y ∉ S) : y ∉ Set.range a := by
    rintro ⟨i, rfl⟩
    exact hy (hSa i)
  have hFq (y : C) (hy : y ∉ S) : y ≠ q := fun he ↦ hy (he ▸ hSq)
  obtain ⟨W, hfin, F, hW, hrep, _⟩ :=
    RiemannRochEichler_joint_modified_kernel_family hE a ha b hb q hq K hK
      S hSa hSq G N M hGo hGout η hηo hηout
  letI : Module.Finite ℂ W := hfin
  have hF : ∀ y ∉ S, ∀ r ∉ S, r ≠ y →
      (F y).1 ⟨r, b4cov_lineEquiv hE 1⟩ = HurwitzPrymRR_loc hE (K r) y 0 *
        ((G r).elim 0 id - (G y).elim 0 id) * η ⟨r, b4cov_lineEquiv hE 1⟩ := by
    intro y hy r hr hry
    have hv := RiemannRochEichler_modified_representative_value hE a ha b hb q y hq
      (hFA y hy) (hFq y hy) K hnorm r (hFA r hr) (hFq r hr) hry G (hGout r hr)
      η (hηout r hr) (F y).1 ((hW _ (F y).property).2.1 r hr) (hrep y hy r)
    rw [RiemannRochEichler_residue_germ_value
      ((hK r (hFA r hr) (hFq r hr)).2.2.2.1 y (Ne.symm hry) (hFq y hy))
      Filter.EventuallyEq.rfl] at hv
    exact hv
  refine ⟨RiemannRochEichler_graph_linear (fun x ↦ (K x).1) (fun x ↦ (K x).property.1) f, ?_⟩
  intro p
  apply RiemannRochEichler_graph_meromorphic_of_modified hE (S : Set C) S.finite_toSet W
    (fun w ↦ (hW w.1 w.property).1) (fun w ↦ (hW w.1 w.property).2.1)
    (fun w ↦ (hW w.1 w.property).2.2) K G η F hF f hf f.injective p _ (hsep p)
  exact (meromorphicOrderAt_ne_top_iff_eventually_ne_zero (η.property.2 p)).mp
    (RiemannRochEichler_finite_orders hE η hη p)


/-- Evaluations are precisely the coordinates in a normalized holomorphic basis. -/
lemma RiemannRochEichler_normalized_coord (hE : Module.finrank ℂ E = 1)
    {ι : Type} (p : ι → C) (b : Module.Basis ι ℂ (b3_HolForm E C))
    (hb : ∀ i j, RiemannRochEichler_eval hE (p i) (b j) = if i = j then 1 else 0)
    (i : ι) : b.coord i = RiemannRochEichler_eval hE (p i) := by
  classical
  apply b.ext
  intro j
  simp only [Module.Basis.coord_apply, Module.Basis.repr_self, Finsupp.single_apply,
    hb, eq_comm]


/-- Two distinct surface points have a global meromorphic function taking the finite values zero and one. -/
lemma RiemannRochEichler_function_separates_two_points
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (p q : C) (hpq : p ≠ q) :
    ∃ G : b4c_MeroFun E C, G p = (0 : ℂ) ∧ G q = (1 : ℂ) := by
  obtain ⟨f, _, hfp, hfo, _⟩ := RiemannRochEichler_function_with_single_pole hE p
  obtain ⟨c, hc⟩ := OnePoint.ne_infty_iff_exists.mp (hfo q hpq.symm)
  let a := 1 - c
  let T := (Homeomorph.addRight a).onePointCongr
  have hT : ContMDiff 𝓘(ℂ, ℂ) 𝓘(ℂ, ℂ) ω T := RiemannRochTop_sphere_translation_holomorphic a
  have hTinf : T OnePoint.infty = OnePoint.infty := rfl
  have hTc : T (c : OnePoint ℂ) = (1 : ℂ) := by
    change ((c + a : ℂ) : OnePoint ℂ) = (1 : ℂ)
    dsimp [a]
    congr 1
    ring
  let G : b4c_MeroFun E C := ⟨b4cov_sphInv ∘ T ∘ f,
    RiemannRochTop_sphere_inversion_holomorphic.comp (hT.comp f.property.1), p, by
      change b4cov_sphInv (T (f p)) ≠ OnePoint.infty
      rw [hfp, hTinf, b4cov_sphInv_infty]
      exact OnePoint.coe_ne_infty 0⟩
  refine ⟨G, ?_, ?_⟩
  · change b4cov_sphInv (T (f p)) = (0 : ℂ)
    rw [hfp, hTinf, b4cov_sphInv_infty]
  · change b4cov_sphInv (T (f q)) = (1 : ℂ)
    rw [← hc, hTc, b4cov_sphInv_coe one_ne_zero, inv_one]


/-- Off-diagonal kernel data have a nonzero scalar difference and a regular parameter differential. -/
lemma RiemannRochEichler_off_diagonal_kernel_data
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (A : Set C) (hA : A.Finite)
    (p e : C) (hpe : p ≠ e) :
    ∃ (G : b4c_MeroFun E C) (η : b4c_MeroForm E C hE) (S : Finset C) (N M : ℕ),
      A ⊆ (S : Set C) ∧ G p = (0 : ℂ) ∧ G e = (1 : ℂ) ∧
      AnalyticAt ℂ (HurwitzPrymRR_loc hE η p) 0 ∧ HurwitzPrymRR_loc hE η p 0 ≠ 0 ∧
      (p ∉ A → p ∉ S) ∧
      (∀ r, ((-(N : ℤ)) : WithTop ℤ) ≤ meromorphicOrderAt
        (RiemannRochEichler_functionLocal hE G r) 0) ∧
      (∀ r ∉ S, G r ≠ OnePoint.infty) ∧
      (∀ r, ((-(M : ℤ)) : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE η r) 0) ∧
      ∀ r ∉ S, AnalyticAt ℂ (HurwitzPrymRR_loc hE η r) 0 := by
  classical
  obtain ⟨G, hGp, hGe⟩ := RiemannRochEichler_function_separates_two_points hE p e hpe
  have hnc : ∃ x y, G x ≠ G y := by
    refine ⟨p, e, ?_⟩
    rw [hGp, hGe]
    exact fun h ↦ zero_ne_one (OnePoint.coe_injective h)
  obtain ⟨P, N, hP, hGo⟩ := RiemannRochEichler_function_pole_bounds hE G hnc
  obtain ⟨η, hηa, hη0⟩ := RiemannRochEichler_local_unit_form hE p
  have hηo : meromorphicOrderAt (HurwitzPrymRR_loc hE η p) 0 = 0 := by
    rw [hηa.meromorphicOrderAt_eq, hηa.analyticOrderAt_eq_zero.mpr hη0]
    rfl
  obtain ⟨M, hMo⟩ := RiemannRochEichler_uniform_form_order hE η ⟨p, by rw [hηo]; exact WithTop.zero_ne_top⟩
  let B := {r : C | ¬ AnalyticAt ℂ (HurwitzPrymRR_loc hE η r) 0}
  have hB : B.Finite := RiemannRochEichler_nonanalytic_finite hE η
  let S := hA.toFinset ∪ P ∪ hB.toFinset
  refine ⟨G, η, S, N, M, ?_, hGp, hGe, hηa, hη0, ?_, hGo, ?_, hMo, ?_⟩
  · intro r hr
    exact Finset.mem_union_left _ (Finset.mem_union_left _ (hA.mem_toFinset.mpr hr))
  · intro hp
    have hpP : p ∉ P := by
      intro h
      have hi := (hP p).mp h
      rw [hGp] at hi
      exact OnePoint.coe_ne_infty 0 hi
    simp only [S, Finset.mem_union, Set.Finite.mem_toFinset, not_or]
    exact ⟨⟨hp, hpP⟩, fun h ↦ h hηa⟩
  · intro r hr hGr
    apply hr
    exact Finset.mem_union_left _ (Finset.mem_union_right _ ((hP r).mpr hGr))
  · intro r hr
    by_contra h
    apply hr
    exact Finset.mem_union_right _ (hB.mem_toFinset.mpr h)


/-- The extra-pole residue determines the auxiliary residues through the normalized holomorphic basis. -/
lemma RiemannRochEichler_extra_pole_residue_relation
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) {ι : Type}
    (a : ι → C) (b : Module.Basis ι ℂ (b3_HolForm E C))
    (hb : ∀ i j, RiemannRochEichler_eval hE (a i) (b j) = if i = j then 1 else 0)
    (y : C) (hy : y ∉ Set.range a) (f : b4c_MeroFun E C)
    (ho : ∀ x, (-1 : WithTop ℤ) ≤ meromorphicOrderAt
      (RiemannRochEichler_functionLocal hE f x) 0)
    (hout : ∀ x, x ∉ Set.range a → x ≠ y → 0 ≤ meromorphicOrderAt
      (RiemannRochEichler_functionLocal hE f x) 0) (i : ι) :
    residue (RiemannRochEichler_functionLocal hE f (a i)) 0 =
      -(residue (RiemannRochEichler_functionLocal hE f y) 0 *
        RiemannRochEichler_eval hE y (b i)) := by
  classical
  let v : b4c_MeroForm E C hE := ⟨(b i).1, (b i).property.2,
    fun x ↦ (RiemannRochEichler_loc_analytic hE (b i) x).meromorphicAt⟩
  let w : b4c_MeroForm E C hE := ⟨fun t ↦ (f t.1).elim 0 id * v t,
    RiemannRochEichler_mul_meroForm hE f v⟩
  have hr (x : C) : b4c_res (hE := hE) w x =
      residue (RiemannRochEichler_functionLocal hE f x) 0 *
        RiemannRochEichler_eval hE x (b i) := by
    have hf : MeromorphicAt (RiemannRochEichler_functionLocal hE f x) 0 :=
      RiemannRochEichler_fun_loc_meromorphic hE f x
    have h := RiemannRochEichler_residue_mul_analytic hf (ho x)
      (RiemannRochEichler_loc_analytic hE (b i) x)
    change residue (RiemannRochEichler_functionLocal hE f x *
      HurwitzPrymRR_loc hE (b i).1 x) 0 = _
    rw [h]
    congr 1
    change (b i).1 ⟨(extChartAt 𝓘(ℂ, E) x).symm
      (extChartAt 𝓘(ℂ, E) x x + b4cov_lineEquiv hE 0), _⟩ = _
    rw [map_zero, add_zero, extChartAt_to_inv, b4cov_vec_self]
    rfl
  have hs : Function.support (b4c_res (hE := hE) w) ⊆ ({a i, y} : Finset C) := by
    intro x hx
    by_contra hn
    have hx' : x ≠ a i ∧ x ≠ y := by
      simpa only [Finset.mem_coe, Finset.mem_insert, Finset.mem_singleton, not_or] using hn
    apply hx
    rw [hr]
    by_cases hxA : x ∈ Set.range a
    · obtain ⟨j, rfl⟩ := hxA
      have hji : j ≠ i := fun h ↦ hx'.1 (congrArg a h)
      rw [hb, if_neg hji, mul_zero]
    · rw [residue_eq_zero_of_meromorphicOrderAt_nonneg (hout x hxA hx'.2), zero_mul]
  have hai : a i ≠ y := fun h ↦ hy ⟨i, h⟩
  have hsum := b4c_residue_sum_aux hE w
  rw [finsum_eq_sum_of_support_subset _ hs, Finset.sum_insert (by simpa using hai),
    Finset.sum_singleton, hr, hr, hb, if_pos rfl, mul_one] at hsum
  exact eq_neg_of_add_eq_zero_left hsum


/-- The parameter residue at an auxiliary point is the negative normalized basis evaluation. -/
lemma RiemannRochEichler_parameter_auxiliary_residue
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) {ι : Type} [Fintype ι]
    (a : ι → C) (ha : Function.Injective a) (b : Module.Basis ι ℂ (b3_HolForm E C))
    (hb : ∀ i j, RiemannRochEichler_eval hE (a i) (b j) = if i = j then 1 else 0)
    (q y : C) (hq : q ∉ Set.range a) (hy : y ∉ Set.range a) (hyq : y ≠ q)
    (K : C → b4c_MeroForm E C hE)
    (hK : ∀ p, p ∉ Set.range a → p ≠ q →
      b4c_res (hE := hE) (K p) p = -1 ∧ b4c_res (hE := hE) (K p) q = 1 ∧
      (∀ x, (-1 : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (K p) x) 0) ∧
      (∀ x, x ≠ p → x ≠ q → 0 ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (K p) x) 0) ∧
      (∀ i, AnalyticAt ℂ (HurwitzPrymRR_loc hE (K p) (a i)) 0) ∧
      ∀ i, K p ⟨a i, b4cov_lineEquiv hE 1⟩ = 0) (i : ι) :
    residue (fun t ↦ residue (fun z ↦ HurwitzPrymRR_loc hE
      (K ((extChartAt 𝓘(ℂ, E) (a i)).symm
        (extChartAt 𝓘(ℂ, E) (a i) (a i) + b4cov_lineEquiv hE t))) y z / z) 0) 0 =
      -RiemannRochEichler_eval hE y (b i) := by
  obtain ⟨f, hfo, hfout, hr, he⟩ :=
    RiemannRochEichler_parameter_germ_representation hE a ha b hb q y hq hy hyq K hK
  have hres := RiemannRochEichler_extra_pole_residue_relation hE a b hb y hy f hfo hfout i
  let d := residue (RiemannRochEichler_functionLocal hE f y) 0
  let c := (f q).elim 0 id
  rw [residue_congr_nhdsNE (he (a i))]
  have hfun : (fun t ↦ (RiemannRochEichler_functionLocal hE f (a i) t - c) / d) =
      d⁻¹ • (RiemannRochEichler_functionLocal hE f (a i) - fun _ ↦ c) := by
    funext t
    simp only [Pi.smul_apply, Pi.sub_apply, smul_eq_mul, div_eq_mul_inv]
    exact mul_comm _ _
  change residue (fun t ↦ (RiemannRochEichler_functionLocal hE f (a i) t - c) / d) 0 = _
  rw [hfun, residue_const_smul,
    residue_sub (f := RiemannRochEichler_functionLocal hE f (a i)) (g := fun _ ↦ c)
      (RiemannRochEichler_fun_loc_meromorphic hE f (a i)) (MeromorphicAt.const _ _),
    residue_eq_zero_of_analyticAt analyticAt_const, sub_zero, hres]
  change d⁻¹ * -(d * RiemannRochEichler_eval hE y (b i)) = _
  have hd : d ≠ 0 := hr
  field_simp


/-- Modified normalized parameter coefficients have the expected simple auxiliary residues. -/
lemma RiemannRochEichler_modified_auxiliary_residue
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) {ι : Type} [Fintype ι]
    (a : ι → C) (ha : Function.Injective a) (b : Module.Basis ι ℂ (b3_HolForm E C))
    (hb : ∀ i j, RiemannRochEichler_eval hE (a i) (b j) = if i = j then 1 else 0)
    (q y : C) (hq : q ∉ Set.range a) (hy : y ∉ Set.range a) (hyq : y ≠ q)
    (K : C → b4c_MeroForm E C hE)
    (hK : ∀ p, p ∉ Set.range a → p ≠ q →
      b4c_res (hE := hE) (K p) p = -1 ∧ b4c_res (hE := hE) (K p) q = 1 ∧
      (∀ x, (-1 : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (K p) x) 0) ∧
      (∀ x, x ≠ p → x ≠ q → 0 ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (K p) x) 0) ∧
      (∀ i, AnalyticAt ℂ (HurwitzPrymRR_loc hE (K p) (a i)) 0) ∧
      ∀ i, K p ⟨a i, b4cov_lineEquiv hE 1⟩ = 0) (i : ι)
    (G : b4c_MeroFun E C) (hG : G (a i) ≠ OnePoint.infty)
    (η : b4c_MeroForm E C hE) (hη : AnalyticAt ℂ (HurwitzPrymRR_loc hE η (a i)) 0)
    (v : ℂ → ℂ)
    (hv : v =ᶠ[𝓝[≠] 0] (fun t ↦
      residue (fun z ↦ HurwitzPrymRR_loc hE
        (K ((extChartAt 𝓘(ℂ, E) (a i)).symm
          (extChartAt 𝓘(ℂ, E) (a i) (a i) + b4cov_lineEquiv hE t))) y z / z) 0 *
        (RiemannRochEichler_functionLocal hE G (a i) t - (G y).elim 0 id) *
          HurwitzPrymRR_loc hE η (a i) t)) :
    MeromorphicAt v 0 ∧ (-1 : WithTop ℤ) ≤ meromorphicOrderAt v 0 ∧
      residue v 0 = -RiemannRochEichler_eval hE y (b i) *
        ((G (a i)).elim 0 id - (G y).elim 0 id) * HurwitzPrymRR_loc hE η (a i) 0 := by
  let P := fun t ↦ residue (fun z ↦ HurwitzPrymRR_loc hE
    (K ((extChartAt 𝓘(ℂ, E) (a i)).symm
      (extChartAt 𝓘(ℂ, E) (a i) (a i) + b4cov_lineEquiv hE t))) y z / z) 0
  let U := fun t ↦ (RiemannRochEichler_functionLocal hE G (a i) t - (G y).elim 0 id) *
    HurwitzPrymRR_loc hE η (a i) t
  have hd := RiemannRochEichler_parameter_pole_data hE a ha b hb q y hq hy hyq K hK
  have hP : MeromorphicAt P 0 := hd.1 (a i)
  have hPo : (-1 : WithTop ℤ) ≤ meromorphicOrderAt P 0 := hd.2.1 (a i)
  have hU : AnalyticAt ℂ U 0 :=
    ((RiemannRochEichler_functionLocal_analytic hE G (a i) hG).sub analyticAt_const).mul hη
  have he : v =ᶠ[𝓝[≠] 0] P * U := by
    filter_upwards [hv] with t ht
    exact ht.trans (mul_assoc _ _ _)
  refine ⟨(hP.mul hU.meromorphicAt).congr he.symm, ?_, ?_⟩
  · rw [meromorphicOrderAt_congr he, meromorphicOrderAt_mul hP hU.meromorphicAt]
    simpa only [add_zero] using add_le_add hPo hU.meromorphicOrderAt_nonneg
  · rw [residue_congr_nhdsNE he, RiemannRochEichler_residue_mul_analytic hP hPo hU]
    have hr : residue P 0 = -RiemannRochEichler_eval hE y (b i) :=
      RiemannRochEichler_parameter_auxiliary_residue hE a ha b hb q y hq hy hyq K hK i
    rw [hr]
    simp only [U, RiemannRochEichler_functionLocal, map_zero, add_zero, extChartAt_to_inv,
      mul_assoc]


/-- Injective holomorphic maps have nonzero derivative in centred source and target coordinates. -/
lemma RiemannRochEichler_graph_coordinate_derivative
    (hE : Module.finrank ℂ E = 1) (f : C → C)
    (hf : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω f) (hfi : Function.Injective f) (p : C) :
    deriv (b4cov_transport hE hE (b4cov_expr E E f p (f p))
      (extChartAt 𝓘(ℂ, E) p p)) 0 ≠ 0 := by
  let k := fun z ↦ (extChartAt 𝓘(ℂ, E) p).symm
    (extChartAt 𝓘(ℂ, E) p p + b4cov_lineEquiv hE z)
  let j := fun z ↦ (extChartAt 𝓘(ℂ, E) (f p)).symm
    (extChartAt 𝓘(ℂ, E) (f p) (f p) + b4cov_lineEquiv hE z)
  let T := b4cov_transport hE hE (b4cov_expr E E f p (f p)) (extChartAt 𝓘(ℂ, E) p p)
  have hTa : AnalyticAt ℂ T 0 := by
    apply b4cov_transport_analyticAt
    apply b4cov_analyticAt_chart f hf p (f p) _ (mem_extChartAt_target p)
    rw [extChartAt_to_inv]
    exact mem_extChartAt_source (f p)
  have hc : ∀ᶠ z in 𝓝 (0 : ℂ), j (T z) = f (k z) :=
    RiemannRochEichler_graph_coordinates hE f hf p (f p) rfl
  have hlin : ContinuousAt (fun z : ℂ ↦ extChartAt 𝓘(ℂ, E) p p + b4cov_lineEquiv hE z) 0 :=
    continuous_const.continuousAt.add (b4cov_lineEquiv hE).continuous.continuousAt
  have ht : ∀ᶠ z : ℂ in 𝓝 0,
      extChartAt 𝓘(ℂ, E) p p + b4cov_lineEquiv hE z ∈ (extChartAt 𝓘(ℂ, E) p).target := by
    apply hlin.preimage_mem_nhds
    simpa only [map_zero, add_zero] using
      (isOpen_extChartAt_target p).mem_nhds (mem_extChartAt_target p)
  let U := {z : ℂ | j (T z) = f (k z) ∧
    extChartAt 𝓘(ℂ, E) p p + b4cov_lineEquiv hE z ∈ (extChartAt 𝓘(ℂ, E) p).target}
  have hU : U ∈ 𝓝 0 := hc.and ht
  have hi : Set.InjOn T U := by
    intro z hz w hw hzw
    have hkw : k z = k w := hfi (hz.1.symm.trans ((congrArg j hzw).trans hw.1))
    have he := congrArg (extChartAt 𝓘(ℂ, E) p) hkw
    change extChartAt 𝓘(ℂ, E) p ((extChartAt 𝓘(ℂ, E) p).symm _) =
      extChartAt 𝓘(ℂ, E) p ((extChartAt 𝓘(ℂ, E) p).symm _) at he
    rw [(extChartAt 𝓘(ℂ, E) p).right_inv hz.2,
      (extChartAt 𝓘(ℂ, E) p).right_inv hw.2] at he
    exact (b4cov_lineEquiv hE).injective (add_left_cancel he)
  obtain ⟨e, he0, he⟩ := RiemannRochTop_injective_analytic_local_homeomorph T 0 hTa U hU hi
  have hehol : AnalyticAt ℂ e 0 := by rw [he]; exact hTa
  have hd := RiemannRochTop_local_homeomorph_deriv_ne_zero e 0 he0 hehol
  rwa [he] at hd


/-- Scaling by the inverse transition derivative expresses fibre evaluations in a fixed chart. -/
lemma RiemannRochEichler_scaled_fibre_germ
    (hE : Module.finrank ℂ E = 1) (θ : TangentBundle 𝓘(ℂ, E) C → ℂ)
    (hθ : HurwitzPrymRR_IsLinear θ) (e : C) :
    let k := fun t ↦ (extChartAt 𝓘(ℂ, E) e).symm
      (extChartAt 𝓘(ℂ, E) e e + b4cov_lineEquiv hE t)
    let d := fun t ↦ deriv (b4cov_transport hE hE
      (b4cov_expr E E (id : C → C) (k t) e) (extChartAt 𝓘(ℂ, E) (k t) (k t))) 0
    (fun t ↦ (d t)⁻¹ * θ ⟨k t, b4cov_lineEquiv hE 1⟩) =ᶠ[𝓝 0]
      HurwitzPrymRR_loc hE θ e := by
  let k := fun t ↦ (extChartAt 𝓘(ℂ, E) e).symm
    (extChartAt 𝓘(ℂ, E) e e + b4cov_lineEquiv hE t)
  let d := fun t ↦ deriv (b4cov_transport hE hE
    (b4cov_expr E E (id : C → C) (k t) e) (extChartAt 𝓘(ℂ, E) (k t) (k t))) 0
  have hlin : ContinuousAt (fun t : ℂ ↦ extChartAt 𝓘(ℂ, E) e e + b4cov_lineEquiv hE t) 0 :=
    continuous_const.continuousAt.add (b4cov_lineEquiv hE).continuous.continuousAt
  have ht : ∀ᶠ t : ℂ in 𝓝 0,
      extChartAt 𝓘(ℂ, E) e e + b4cov_lineEquiv hE t ∈ (extChartAt 𝓘(ℂ, E) e).target := by
    apply hlin.preimage_mem_nhds
    simpa only [map_zero, add_zero] using
      (isOpen_extChartAt_target e).mem_nhds (mem_extChartAt_target e)
  dsimp only
  filter_upwards [ht] with t ht
  have hks : k t ∈ (extChartAt 𝓘(ℂ, E) e).source :=
    (extChartAt 𝓘(ℂ, E) e).map_target ht
  have hcoord : (b4cov_lineEquiv hE).symm
      (extChartAt 𝓘(ℂ, E) e (k t) - extChartAt 𝓘(ℂ, E) e e) = t := by
    rw [(extChartAt 𝓘(ℂ, E) e).right_inv ht]
    simp only [add_sub_cancel_left, ContinuousLinearEquiv.symm_apply_apply]
  have hd : d t ≠ 0 := (RiemannRochEichler_chart_transition_unit hE e (k t) hks).2
  have hc := RiemannRochEichler_chart_value hE θ hθ e (k t) hks
  dsimp only at hc
  rw [hcoord, RiemannRochEichler_loc_zero] at hc
  change (d t)⁻¹ * θ ⟨k t, b4cov_lineEquiv hE 1⟩ = HurwitzPrymRR_loc hE θ e t
  rw [hc]
  change (d t)⁻¹ * (HurwitzPrymRR_loc hE θ e t * d t) = _
  field_simp


/-- Scaled evaluation germs equal fixed-chart kernel coefficients times the scalar difference. -/
lemma RiemannRochEichler_chart_scaled_evaluation_germ [T1Space C]
    (hE : Module.finrank ℂ E = 1) (S : Set C) (hS : S.Finite)
    (K : C → b4c_MeroForm E C hE) (G : b4c_MeroFun E C) (β : C → ℂ)
    (F : C → TangentBundle 𝓘(ℂ, E) C → ℂ)
    (hF : ∀ y ∉ S, ∀ r ∉ S, r ≠ y →
      F y ⟨r, b4cov_lineEquiv hE 1⟩ = HurwitzPrymRR_loc hE (K r) y 0 *
        ((G r).elim 0 id - (G y).elim 0 id) * β r)
    (e r : C) (hrS : r ∉ S) :
    let k := fun t ↦ (extChartAt 𝓘(ℂ, E) e).symm
      (extChartAt 𝓘(ℂ, E) e e + b4cov_lineEquiv hE t)
    let d := fun t ↦ deriv (b4cov_transport hE hE
      (b4cov_expr E E (id : C → C) (k t) e) (extChartAt 𝓘(ℂ, E) (k t) (k t))) 0
    (fun t ↦ (d t)⁻¹ * F (k t) ⟨r, b4cov_lineEquiv hE 1⟩) =ᶠ[𝓝[≠] 0]
      (fun t ↦ HurwitzPrymRR_loc hE (K r) e t *
        ((G r).elim 0 id - RiemannRochEichler_functionLocal hE G e t) * β r) := by
  let k := fun t ↦ (extChartAt 𝓘(ℂ, E) e).symm
    (extChartAt 𝓘(ℂ, E) e e + b4cov_lineEquiv hE t)
  let d := fun t ↦ deriv (b4cov_transport hE hE
    (b4cov_expr E E (id : C → C) (k t) e) (extChartAt 𝓘(ℂ, E) (k t) (k t))) 0
  have hlin : ContinuousAt (fun t : ℂ ↦ extChartAt 𝓘(ℂ, E) e e + b4cov_lineEquiv hE t) 0 :=
    continuous_const.continuousAt.add (b4cov_lineEquiv hE).continuous.continuousAt
  have ht : ∀ᶠ t : ℂ in 𝓝 0,
      extChartAt 𝓘(ℂ, E) e e + b4cov_lineEquiv hE t ∈ (extChartAt 𝓘(ℂ, E) e).target := by
    apply hlin.preimage_mem_nhds
    simpa only [map_zero, add_zero] using
      (isOpen_extChartAt_target e).mem_nhds (mem_extChartAt_target e)
  have havoid : ∀ᶠ y in 𝓝[≠] e, y ∉ S ∪ {r} := by
    have hs : ((S ∪ {r}) \ {e})ᶜ ∈ 𝓝 e :=
      (hS.union (Set.finite_singleton r)).sdiff.isClosed.isOpen_compl.mem_nhds (fun h ↦ h.2 rfl)
    filter_upwards [nhdsWithin_le_nhds hs, self_mem_nhdsWithin] with y hy hye
    exact fun h ↦ hy ⟨h, hye⟩
  have hav : ∀ᶠ t in 𝓝[≠] (0 : ℂ), k t ∉ S ∪ {r} :=
    RiemannRochEichler_inverse_coordinate_punctured hE e havoid
  dsimp only
  symm
  filter_upwards [nhdsWithin_le_nhds ht, hav] with t ht hav
  have hks : k t ∈ (extChartAt 𝓘(ℂ, E) e).source :=
    (extChartAt 𝓘(ℂ, E) e).map_target ht
  have hcoord : (b4cov_lineEquiv hE).symm
      (extChartAt 𝓘(ℂ, E) e (k t) - extChartAt 𝓘(ℂ, E) e e) = t := by
    rw [(extChartAt 𝓘(ℂ, E) e).right_inv ht]
    simp only [add_sub_cancel_left, ContinuousLinearEquiv.symm_apply_apply]
  have hd : d t ≠ 0 := (RiemannRochEichler_chart_transition_unit hE e (k t) hks).2
  have hv := hF (k t) (fun h ↦ hav (Or.inl h)) r hrS (fun h ↦ hav (Or.inr h.symm))
  have hc := RiemannRochEichler_chart_value hE (K r) (K r).property.1 e (k t) hks
  dsimp only at hc
  rw [hcoord] at hc
  change HurwitzPrymRR_loc hE (K r) e t *
      ((G r).elim 0 id - (G (k t)).elim 0 id) * β r =
    (d t)⁻¹ * (F (k t)) ⟨r, b4cov_lineEquiv hE 1⟩
  rw [hv, hc]
  change _ = (d t)⁻¹ * (HurwitzPrymRR_loc hE (K r) e t * d t * _ * _)
  field_simp


/-- Analytic substitution preserves nonnegative meromorphic order, including locally constant substitutions. -/
lemma RiemannRochEichler_nonneg_order_comp
    {f g : ℂ → ℂ} {x : ℂ} (hf : MeromorphicAt f (g x)) (hg : AnalyticAt ℂ g x)
    (ho : 0 ≤ meromorphicOrderAt f (g x)) :
    0 ≤ meromorphicOrderAt (f ∘ g) x := by
  by_cases hc : EventuallyConst g (𝓝 x)
  · obtain ⟨c, hc⟩ := hc.eventuallyEq_const
    have he : (fun _ : ℂ ↦ f c) =ᶠ[𝓝 x] (f ∘ g) := by
      filter_upwards [hc] with z hz
      exact (congrArg f hz).symm
    exact (analyticAt_const.congr he).meromorphicOrderAt_nonneg
  · obtain ⟨u, hu, he⟩ := hf.meromorphicOrderAt_nonneg_iff.mp ho
    have hcomp : f ∘ g =ᶠ[𝓝[≠] x] u ∘ g := he.comp_tendsto (hg.map_nhdsNE hc)
    rw [meromorphicOrderAt_congr hcomp]
    exact (hu.comp hg).meromorphicOrderAt_nonneg


/-- A lower bound for local orders passes from generators to their linear span. -/
lemma RiemannRochEichler_order_bound_span
    {V : Type*} [AddCommGroup V] [Module ℂ V]
    (J : V →ₗ[ℂ] (ℂ → ℂ)) (S : Set V) (x : ℂ) (k : WithTop ℤ)
    (hS : ∀ v ∈ S, MeromorphicAt (J v) x ∧ k ≤ meromorphicOrderAt (J v) x) :
    ∀ v ∈ Submodule.span ℂ S,
      MeromorphicAt (J v) x ∧ k ≤ meromorphicOrderAt (J v) x := by
  intro v hv
  induction hv using Submodule.span_induction with
  | mem v hv => exact hS v hv
  | zero =>
    rw [map_zero]
    refine ⟨MeromorphicAt.const _ _, ?_⟩
    change k ≤ meromorphicOrderAt (fun _ : ℂ ↦ (0 : ℂ)) x
    rw [meromorphicOrderAt_const, if_pos rfl]
    exact le_top
  | add v w _ _ hv hw =>
    rw [map_add]
    exact ⟨hv.1.add hw.1, (le_min hv.2 hw.2).trans (meromorphicOrderAt_add hv.1 hw.1)⟩
  | smul c v _ hv =>
    rw [map_smul]
    refine ⟨hv.1.const_smul c, ?_⟩
    by_cases hc : c = 0
    · subst c
      simp only [zero_smul]
      change k ≤ meromorphicOrderAt (fun _ : ℂ ↦ (0 : ℂ)) x
      rw [meromorphicOrderAt_const, if_pos rfl]
      exact le_top
    · rw [meromorphicOrderAt_const_smul_eq_meromorphicOrderAt hc]
      exact hv.2


/-- Regular meromorphic parameter coordinates preserve a common lower bound on graph orders. -/
lemma RiemannRochEichler_graph_order_bound
    {V X : Type*} [AddCommGroup V] [Module ℂ V] [Module.Finite ℂ V]
    (ev : X → Module.Dual ℂ V) (hsep : ∀ v, (∀ z, ev z v = 0) → v = 0)
    (J : V →ₗ[ℂ] (ℂ → ℂ)) (F : ℂ → V) (x : ℂ) (k : WithTop ℤ)
    (hF : ∀ z, MeromorphicAt (fun t ↦ ev z (F t)) x)
    (ho : ∀ z, 0 ≤ meromorphicOrderAt (fun t ↦ ev z (F t)) x)
    (hJ : ∀ v, MeromorphicAt (J v) x)
    (hJo : ∀ v, k ≤ meromorphicOrderAt (J v) x) :
    k ≤ meromorphicOrderAt (fun z ↦ J (F z) z) x := by
  classical
  let P : Module.Dual ℂ V →ₗ[ℂ] (ℂ → ℂ) :=
    { toFun := fun l z ↦ l (F z)
      map_add' := fun _ _ ↦ rfl
      map_smul' := fun _ _ ↦ rfl }
  have hs : Submodule.span ℂ (Set.range ev) = ⊤ := by
    apply Submodule.span_eq_top_of_ne_zero
    intro v hv
    by_contra h
    push Not at h
    exact hv (hsep v (fun z ↦ h (ev z) ⟨z, rfl⟩))
  have hb : ∀ l : Module.Dual ℂ V, MeromorphicAt (P l) x ∧
      0 ≤ meromorphicOrderAt (P l) x := by
    intro l
    apply RiemannRochEichler_order_bound_span P (Set.range ev) x 0 _ l
    · rw [hs]
      exact Submodule.mem_top
    · rintro _ ⟨z, rfl⟩
      exact ⟨hF z, ho z⟩
  let b := Module.finBasis ℂ V
  let Q := fun i z ↦ b.coord i (F z) * J (b i) z
  have hQ i : MeromorphicAt (Q i) x ∧ k ≤ meromorphicOrderAt (Q i) x := by
    refine ⟨(hb (b.coord i)).1.mul (hJ (b i)), ?_⟩
    change k ≤ meromorphicOrderAt (P (b.coord i) * J (b i)) x
    rw [meromorphicOrderAt_mul (hb (b.coord i)).1 (hJ (b i))]
    simpa only [zero_add] using add_le_add (hb (b.coord i)).2 (hJo (b i))
  have he : (fun z ↦ J (F z) z) = ∑ i, Q i := by
    funext z
    have h := congrArg (fun v : V ↦ J v z) (b.sum_repr (F z))
    simpa only [Q, map_sum, map_smul, Finset.sum_apply, Pi.smul_apply, smul_eq_mul,
      Module.Basis.coord_apply] using h.symm
  rw [he]
  have hsum : ∑ i, Q i ∈ Submodule.span ℂ (Set.range Q) :=
    Submodule.sum_mem _ (fun i hi ↦ Submodule.subset_span ⟨i, rfl⟩)
  exact (RiemannRochEichler_order_bound_span (LinearMap.id : (ℂ → ℂ) →ₗ[ℂ] (ℂ → ℂ))
    (Set.range Q) x k (by rintro _ ⟨i, rfl⟩; exact hQ i) _ hsum).2


/-- Bounds on a family image control graph orders when the parameter coordinates have no poles. -/
lemma RiemannRochEichler_graph_order_bound_of_image
    {V X : Type*} [AddCommGroup V] [Module ℂ V] [Module.Finite ℂ V]
    (ev : X → Module.Dual ℂ V) (hsep : ∀ v, (∀ z, ev z v = 0) → v = 0)
    (J : V →ₗ[ℂ] (ℂ → ℂ)) (F : ℂ → V) (x : ℂ) (k : WithTop ℤ)
    (hF : ∀ z, MeromorphicAt (fun t ↦ ev z (F t)) x)
    (hFo : ∀ z, 0 ≤ meromorphicOrderAt (fun t ↦ ev z (F t)) x)
    (hJ : ∀ t, MeromorphicAt (J (F t)) x)
    (ho : ∀ t, k ≤ meromorphicOrderAt (J (F t)) x) :
    k ≤ meromorphicOrderAt (fun z ↦ J (F z) z) x := by
  let W := Submodule.span ℂ (Set.range F)
  let F' : ℂ → W := fun t ↦ ⟨F t, Submodule.subset_span ⟨t, rfl⟩⟩
  let ev' : X → Module.Dual ℂ W := fun z ↦ (ev z).comp W.subtype
  have hsep' : ∀ v : W, (∀ z, ev' z v = 0) → v = 0 := by
    intro v hv
    apply Subtype.ext
    exact hsep v.1 hv
  have hb : ∀ v : W, MeromorphicAt (J v.1) x ∧
      k ≤ meromorphicOrderAt (J v.1) x := by
    intro v
    apply RiemannRochEichler_order_bound_span J (Set.range F) x k _ v.1 v.2
    rintro _ ⟨t, rfl⟩
    exact ⟨hJ t, ho t⟩
  exact RiemannRochEichler_graph_order_bound ev' hsep' (J.comp W.subtype) F' x k
    hF hFo (fun v ↦ (hb v).1) (fun v ↦ (hb v).2)


/-- A finite-dimensional family with regular meromorphic coordinates has an analytic germ representative. -/
lemma RiemannRochEichler_regularize_finite_family
    {V X : Type*} [AddCommGroup V] [Module ℂ V] [Module.Finite ℂ V]
    (ev : X → Module.Dual ℂ V) (hsep : ∀ v, (∀ z, ev z v = 0) → v = 0)
    (F : ℂ → V) (x : ℂ)
    (hF : ∀ z, MeromorphicAt (fun t ↦ ev z (F t)) x)
    (ho : ∀ z, 0 ≤ meromorphicOrderAt (fun t ↦ ev z (F t)) x) :
    ∃ F' : ℂ → V, (∀ l : Module.Dual ℂ V, AnalyticAt ℂ (fun t ↦ l (F' t)) x) ∧
      F' =ᶠ[𝓝[≠] x] F := by
  classical
  let P : Module.Dual ℂ V →ₗ[ℂ] (ℂ → ℂ) :=
    { toFun := fun l z ↦ l (F z)
      map_add' := fun _ _ ↦ rfl
      map_smul' := fun _ _ ↦ rfl }
  have hs : Submodule.span ℂ (Set.range ev) = ⊤ := by
    apply Submodule.span_eq_top_of_ne_zero
    intro v hv
    by_contra h
    push Not at h
    exact hv (hsep v (fun z ↦ h (ev z) ⟨z, rfl⟩))
  have hb : ∀ l : Module.Dual ℂ V, MeromorphicAt (P l) x ∧
      0 ≤ meromorphicOrderAt (P l) x := by
    intro l
    apply RiemannRochEichler_order_bound_span P (Set.range ev) x 0 _ l
    · rw [hs]
      exact Submodule.mem_top
    · rintro _ ⟨z, rfl⟩
      exact ⟨hF z, ho z⟩
  let b := Module.finBasis ℂ V
  have hc (i : Fin (Module.finrank ℂ V)) : ∃ g : ℂ → ℂ,
      AnalyticAt ℂ g x ∧ (fun t ↦ b.coord i (F t)) =ᶠ[𝓝[≠] x] g :=
    (hb (b.coord i)).1.meromorphicOrderAt_nonneg_iff.mp (hb (b.coord i)).2
  choose g hg he using hc
  let F' : ℂ → V := fun t ↦ ∑ i, g i t • b i
  refine ⟨F', ?_, ?_⟩
  · intro l
    have h : (fun t ↦ l (F' t)) = fun t ↦ ∑ i, g i t * l (b i) := by
      funext t
      simp only [F', map_sum, map_smul, smul_eq_mul]
    rw [h]
    exact Finset.analyticAt_fun_sum _ (fun i hi ↦ (hg i).mul analyticAt_const)
  · filter_upwards [Filter.eventually_all.mpr he] with t ht
    dsimp only [F']
    calc
      ∑ i, g i t • b i = ∑ i, b.coord i (F t) • b i := by
        apply Finset.sum_congr rfl
        intro i hi
        rw [ht i]
      _ = F t := b.sum_repr (F t)


/-- A finite-dimensional simple-pole family has graph residue equal to its residue at the central parameter. -/
lemma RiemannRochEichler_finite_family_graph_residue
    {V X : Type*} [AddCommGroup V] [Module ℂ V] [Module.Finite ℂ V]
    (ev : X → Module.Dual ℂ V) (hsep : ∀ v, (∀ z, ev z v = 0) → v = 0)
    (J : V →ₗ[ℂ] (ℂ → ℂ)) (F : ℂ → V) (x : ℂ)
    (hF : ∀ z, AnalyticAt ℂ (fun t ↦ ev z (F t)) x)
    (hJ : ∀ v, MeromorphicAt (J v) x)
    (ho : ∀ v, (-1 : WithTop ℤ) ≤ meromorphicOrderAt (J v) x) :
    MeromorphicAt (fun z ↦ J (F z) z) x ∧
      residue (fun z ↦ J (F z) z) x = residue (J (F x)) x := by
  classical
  have hs : Submodule.span ℂ (Set.range ev) = ⊤ := by
    apply Submodule.span_eq_top_of_ne_zero
    intro v hv
    by_contra h
    push Not at h
    exact hv (hsep v (fun z ↦ h (ev z) ⟨z, rfl⟩))
  have hl (l : Module.Dual ℂ V) : AnalyticAt ℂ (fun t ↦ l (F t)) x := by
    have hm : l ∈ Submodule.span ℂ (Set.range ev) := by rw [hs]; exact Submodule.mem_top
    induction hm using Submodule.span_induction with
    | mem l hm =>
      obtain ⟨z, rfl⟩ := hm
      exact hF z
    | zero => exact analyticAt_const
    | add l m _ _ hl hm => exact hl.add hm
    | smul c l _ hl => exact hl.const_smul
  let b := Module.finBasis ℂ V
  let Q := fun i z ↦ b.coord i (F z) * J (b i) z
  have hQ (i : Fin (Module.finrank ℂ V)) : MeromorphicAt (Q i) x :=
    (hl (b.coord i)).meromorphicAt.mul (hJ (b i))
  have he : (fun z ↦ J (F z) z) = ∑ i, Q i := by
    funext z
    have h := congrArg (fun v : V ↦ J v z) (b.sum_repr (F z))
    simpa only [Q, map_sum, map_smul, Finset.sum_apply, Pi.smul_apply, smul_eq_mul,
      Module.Basis.coord_apply] using h.symm
  have hrQ (i : Fin (Module.finrank ℂ V)) : residue (Q i) x =
      b.coord i (F x) * residue (J (b i)) x := by
    have h := RiemannRochEichler_residue_mul_analytic (hJ (b i)) (ho (b i)) (hl (b.coord i))
    change residue (fun z ↦ J (b i) z * b.coord i (F z)) x =
      residue (J (b i)) x * b.coord i (F x) at h
    simpa only [Q, mul_comm] using h
  refine ⟨he ▸ MeromorphicAt.sum (fun i hi ↦ hQ i), ?_⟩
  rw [he, residue_sum Finset.univ (fun i hi ↦ hQ i)]
  simp only [hrQ]
  let L := RiemannRochEichler_residueLinearMap J x hJ
  have h := congrArg L (b.sum_repr (F x))
  simpa only [map_sum, map_smul, smul_eq_mul, Module.Basis.coord_apply,
    L, RiemannRochEichler_residueLinearMap, LinearMap.coe_mk, AddHom.coe_mk] using h


/-- An analytic germ of parameter residues determines the residue on a graph with regular coordinates. -/
lemma RiemannRochEichler_graph_residue_from_germ
    {V X : Type*} [AddCommGroup V] [Module ℂ V] [Module.Finite ℂ V]
    (ev : X → Module.Dual ℂ V) (hsep : ∀ v, (∀ z, ev z v = 0) → v = 0)
    (J : V →ₗ[ℂ] (ℂ → ℂ)) (F : ℂ → V) (x : ℂ)
    (hF : ∀ z, MeromorphicAt (fun t ↦ ev z (F t)) x)
    (hFo : ∀ z, 0 ≤ meromorphicOrderAt (fun t ↦ ev z (F t)) x)
    (hJ : ∀ v, MeromorphicAt (J v) x)
    (ho : ∀ v, (-1 : WithTop ℤ) ≤ meromorphicOrderAt (J v) x)
    (H : ℂ → ℂ) (hH : AnalyticAt ℂ H x)
    (he : (fun t ↦ residue (J (F t)) x) =ᶠ[𝓝[≠] x] H) :
    residue (fun z ↦ J (F z) z) x = H x := by
  obtain ⟨F', ha, heF⟩ := RiemannRochEichler_regularize_finite_family ev hsep F x hF hFo
  have hg := (RiemannRochEichler_finite_family_graph_residue ev hsep J F' x
    (fun z ↦ ha (ev z)) hJ ho).2
  let L := RiemannRochEichler_residueLinearMap J x hJ
  have hL : (fun t ↦ L (F' t)) =ᶠ[𝓝[≠] x] H := by
    filter_upwards [heF, he] with t ht hr
    change residue (J (F' t)) x = H t
    rw [ht]
    exact hr
  have hv := ((ha L).continuousAt.eventuallyEq_nhds_iff_eventuallyEq_nhdsNE
    hH.continuousAt).mp hL |>.self_of_nhds
  have hegraph : (fun z ↦ J (F' z) z) =ᶠ[𝓝[≠] x] (fun z ↦ J (F z) z) :=
    heF.mono (fun z hz ↦ congrArg (fun v ↦ J v z) hz)
  rw [← residue_congr_nhdsNE hegraph, hg]
  exact hv


/-- Simple pole bounds on the family image suffice to extract graph residues from residue germs. -/
lemma RiemannRochEichler_graph_residue_from_image_germ
    {V X : Type*} [AddCommGroup V] [Module ℂ V] [Module.Finite ℂ V]
    (ev : X → Module.Dual ℂ V) (hsep : ∀ v, (∀ z, ev z v = 0) → v = 0)
    (J : V →ₗ[ℂ] (ℂ → ℂ)) (F : ℂ → V) (x : ℂ)
    (hF : ∀ z, MeromorphicAt (fun t ↦ ev z (F t)) x)
    (hFo : ∀ z, 0 ≤ meromorphicOrderAt (fun t ↦ ev z (F t)) x)
    (hJ : ∀ t, MeromorphicAt (J (F t)) x)
    (ho : ∀ t, (-1 : WithTop ℤ) ≤ meromorphicOrderAt (J (F t)) x)
    (H : ℂ → ℂ) (hH : AnalyticAt ℂ H x)
    (he : (fun t ↦ residue (J (F t)) x) =ᶠ[𝓝[≠] x] H) :
    residue (fun z ↦ J (F z) z) x = H x := by
  let W := Submodule.span ℂ (Set.range F)
  let F' : ℂ → W := fun t ↦ ⟨F t, Submodule.subset_span ⟨t, rfl⟩⟩
  let ev' : X → Module.Dual ℂ W := fun z ↦ (ev z).comp W.subtype
  have hsep' : ∀ v : W, (∀ z, ev' z v = 0) → v = 0 := by
    intro v hv
    apply Subtype.ext
    exact hsep v.1 hv
  have hb : ∀ v : W, MeromorphicAt (J v.1) x ∧
      (-1 : WithTop ℤ) ≤ meromorphicOrderAt (J v.1) x := by
    intro v
    apply RiemannRochEichler_order_bound_span J (Set.range F) x (-1) _ v.1 v.2
    rintro _ ⟨t, rfl⟩
    exact ⟨hJ t, ho t⟩
  exact RiemannRochEichler_graph_residue_from_germ ev' hsep' (J.comp W.subtype) F' x
    hF hFo (fun v ↦ (hb v).1) (fun v ↦ (hb v).2) H hH he


/-- Simple parameter poles and regular evaluation coordinates give modified graph residues. -/
lemma RiemannRochEichler_modified_graph_residue_from_germ [T1Space C]
    (hE : Module.finrank ℂ E = 1) (S : Set C) (hS : S.Finite)
    (W : Submodule ℂ (TangentBundle 𝓘(ℂ, E) C → ℂ)) [Module.Finite ℂ W]
    (hw : ∀ w : W, b4c_IsMeroForm hE w.1)
    (ha : ∀ w : W, ∀ p ∉ S, AnalyticAt ℂ (HurwitzPrymRR_loc hE w.1 p) 0)
    (hz : ∀ w : W, ∀ p ∈ S, ∀ u, w.1 ⟨p, u⟩ = 0)
    (K : C → b4c_MeroForm E C hE) (G : b4c_MeroFun E C) (β : C → ℂ)
    (F : C → W)
    (hF : ∀ y ∉ S, ∀ r ∉ S, r ≠ y →
      (F y).1 ⟨r, b4cov_lineEquiv hE 1⟩ = HurwitzPrymRR_loc hE (K r) y 0 *
        ((G r).elim 0 id - (G y).elim 0 id) * β r)
    (e p : C) (himage : ∀ y, (-1 : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (F y).1 p) 0) (hG : G e ≠ OnePoint.infty)
    (hK : ∀ r ∉ S, r ≠ e → AnalyticAt ℂ (HurwitzPrymRR_loc hE (K r) e) 0)
    (T : ℂ → ℂ) (hT : AnalyticAt ℂ T 0) (hT0 : T 0 = 0)
    (H : ℂ → ℂ) (hH : AnalyticAt ℂ H 0) :
    let j := fun t ↦ (extChartAt 𝓘(ℂ, E) e).symm
      (extChartAt 𝓘(ℂ, E) e e + b4cov_lineEquiv hE t)
    let d := fun t ↦ deriv (b4cov_transport hE hE
      (b4cov_expr E E (id : C → C) (j t) e) (extChartAt 𝓘(ℂ, E) (j t) (j t))) 0
    (fun z ↦ residue (HurwitzPrymRR_loc hE ((d (T z))⁻¹ • (F (j (T z))).1) p) 0)
      =ᶠ[𝓝[≠] 0] H →
    (-1 : WithTop ℤ) ≤ meromorphicOrderAt
      (fun z ↦ HurwitzPrymRR_loc hE ((d (T z))⁻¹ • (F (j (T z))).1) p z) 0 ∧
    residue (fun z ↦ HurwitzPrymRR_loc hE ((d (T z))⁻¹ • (F (j (T z))).1) p z) 0 = H 0 := by
  dsimp only
  intro hres
  let j := fun t ↦ (extChartAt 𝓘(ℂ, E) e).symm
    (extChartAt 𝓘(ℂ, E) e e + b4cov_lineEquiv hE t)
  let d := fun t ↦ deriv (b4cov_transport hE hE
    (b4cov_expr E E (id : C → C) (j t) e) (extChartAt 𝓘(ℂ, E) (j t) (j t))) 0
  let A : ℂ → W := fun z ↦ (d (T z))⁻¹ • F (j (T z))
  let ev : {r : C // r ∉ S ∪ {e}} → Module.Dual ℂ W :=
    fun r ↦ (LinearMap.proj ⟨r.1, b4cov_lineEquiv hE 1⟩).comp W.subtype
  have hsep : ∀ w : W, (∀ r, ev r w = 0) → w = 0 := by
    intro w he
    apply Subtype.ext
    apply RiemannRochEichler_evaluations_separate_off_finite hE w.1 (hw w).1 S {e} hS
      (Set.finite_singleton e) (ha w) (hz w)
    intro r hr
    exact he ⟨r, hr⟩
  let J : W →ₗ[ℂ] (ℂ → ℂ) :=
    { toFun := fun w ↦ HurwitzPrymRR_loc hE w.1 p
      map_add' := fun _ _ ↦ rfl
      map_smul' := fun _ _ ↦ rfl }
  have hcoords (r : {r : C // r ∉ S ∪ {e}}) :
      MeromorphicAt (fun z ↦ ev r (A z)) 0 ∧
      0 ≤ meromorphicOrderAt (fun z ↦ ev r (A z)) 0 := by
    have hrS : r.1 ∉ S := fun h ↦ r.2 (Or.inl h)
    have hre : r.1 ≠ e := fun h ↦ r.2 (Or.inr h)
    let B := fun t ↦ (d t)⁻¹ * (F (j t)).1 ⟨r.1, b4cov_lineEquiv hE 1⟩
    have hm : MeromorphicAt B 0 := RiemannRochEichler_chart_scaled_evaluation_meromorphic
      hE S hS K G β (fun y ↦ (F y).1) hF e r.1 hrS
    have he := RiemannRochEichler_chart_scaled_evaluation_germ
      hE S hS K G β (fun y ↦ (F y).1) hF e r.1 hrS
    have hreg : AnalyticAt ℂ (fun t ↦ HurwitzPrymRR_loc hE (K r.1) e t *
        ((G r.1).elim 0 id - RiemannRochEichler_functionLocal hE G e t) * β r.1) 0 :=
      ((hK r.1 hrS hre).mul (analyticAt_const.sub
        (RiemannRochEichler_functionLocal_analytic hE G e hG))).mul analyticAt_const
    have ho : 0 ≤ meromorphicOrderAt B 0 := by
      rw [meromorphicOrderAt_congr he]
      exact hreg.meromorphicOrderAt_nonneg
    have hmT : MeromorphicAt B (T 0) := hT0.symm ▸ hm
    have hoT : 0 ≤ meromorphicOrderAt B (T 0) := hT0.symm ▸ ho
    exact ⟨hmT.comp_analyticAt hT, RiemannRochEichler_nonneg_order_comp hmT hT hoT⟩
  have hJ : ∀ z, MeromorphicAt (J (A z)) 0 :=
    fun z ↦ ((hw (F (j (T z)))).2 p).const_smul ((d (T z))⁻¹)
  have hJo : ∀ z, (-1 : WithTop ℤ) ≤ meromorphicOrderAt (J (A z)) 0 := by
    intro z
    change (-1 : WithTop ℤ) ≤ meromorphicOrderAt
      ((d (T z))⁻¹ • HurwitzPrymRR_loc hE (F (j (T z))).1 p) 0
    by_cases hc : (d (T z))⁻¹ = 0
    · rw [hc, zero_smul]
      change (-1 : WithTop ℤ) ≤ meromorphicOrderAt (fun _ : ℂ ↦ (0 : ℂ)) 0
      rw [meromorphicOrderAt_const, if_pos rfl]
      exact le_top
    · rw [meromorphicOrderAt_const_smul_eq_meromorphicOrderAt hc]
      exact himage _
  exact ⟨RiemannRochEichler_graph_order_bound_of_image ev hsep J A 0 (-1)
    (fun r ↦ (hcoords r).1) (fun r ↦ (hcoords r).2) hJ hJo,
    RiemannRochEichler_graph_residue_from_image_germ ev hsep J A 0
      (fun r ↦ (hcoords r).1) (fun r ↦ (hcoords r).2) hJ hJo H hH hres⟩


/-- A regular separating denominator transfers modified graph residues to the graph differential. -/
lemma RiemannRochEichler_graph_residue_of_modified
    [T1Space C] (hE : Module.finrank ℂ E = 1) (S : Set C) (hS : S.Finite)
    (W : Submodule ℂ (TangentBundle 𝓘(ℂ, E) C → ℂ)) [Module.Finite ℂ W]
    (hw : ∀ w : W, b4c_IsMeroForm hE w.1)
    (ha : ∀ w : W, ∀ p ∉ S, AnalyticAt ℂ (HurwitzPrymRR_loc hE w.1 p) 0)
    (hz : ∀ w : W, ∀ p ∈ S, ∀ u, w.1 ⟨p, u⟩ = 0)
    (K : C → b4c_MeroForm E C hE) (G : b4c_MeroFun E C)
    (η : b4c_MeroForm E C hE) (F : C → W)
    (hF : ∀ y ∉ S, ∀ r ∉ S, r ≠ y →
      (F y).1 ⟨r, b4cov_lineEquiv hE 1⟩ = HurwitzPrymRR_loc hE (K r) y 0 *
        ((G r).elim 0 id - (G y).elim 0 id) * η ⟨r, b4cov_lineEquiv hE 1⟩)
    (f : C → C) (hf : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω f) (hfi : Function.Injective f)
    (p : C) (himage : ∀ y, (-1 : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (F y).1 p) 0)
    (hηa : AnalyticAt ℂ (HurwitzPrymRR_loc hE η p) 0)
    (hη0 : HurwitzPrymRR_loc hE η p 0 ≠ 0)
    (hGp : G p ≠ OnePoint.infty) (hGe : G (f p) ≠ OnePoint.infty)
    (hsep : (G p).elim 0 id ≠ (G (f p)).elim 0 id)
    (hK : ∀ r ∉ S, r ≠ f p → AnalyticAt ℂ (HurwitzPrymRR_loc hE (K r) (f p)) 0) :
    let T := b4cov_transport hE hE (b4cov_expr E E f p (f p)) (extChartAt 𝓘(ℂ, E) p p)
    let j := fun z ↦ (extChartAt 𝓘(ℂ, E) (f p)).symm
      (extChartAt 𝓘(ℂ, E) (f p) (f p) + b4cov_lineEquiv hE z)
    let d := fun t ↦ deriv (b4cov_transport hE hE
      (b4cov_expr E E (id : C → C) (j t) (f p)) (extChartAt 𝓘(ℂ, E) (j t) (j t))) 0
    ∀ H : ℂ → ℂ, AnalyticAt ℂ H 0 →
      (fun z ↦ residue (HurwitzPrymRR_loc hE ((d (T z))⁻¹ • (F (j (T z))).1) p) 0)
        =ᶠ[𝓝[≠] 0] H →
    residue (HurwitzPrymRR_loc hE
      (fun t : TangentBundle 𝓘(ℂ, E) C ↦ K t.1
        ⟨f t.1, mfderiv 𝓘(ℂ, E) 𝓘(ℂ, E) f t.1 t.2⟩) p) 0 = H 0 * deriv T 0 /
      (HurwitzPrymRR_loc hE η p 0 * ((G p).elim 0 id - (G (f p)).elim 0 id)) := by
  dsimp only
  intro H hH hres
  let k := fun z ↦ (extChartAt 𝓘(ℂ, E) p).symm
    (extChartAt 𝓘(ℂ, E) p p + b4cov_lineEquiv hE z)
  let j := fun z ↦ (extChartAt 𝓘(ℂ, E) (f p)).symm
    (extChartAt 𝓘(ℂ, E) (f p) (f p) + b4cov_lineEquiv hE z)
  let T := b4cov_transport hE hE (b4cov_expr E E f p (f p)) (extChartAt 𝓘(ℂ, E) p p)
  let d := fun t ↦ deriv (b4cov_transport hE hE
    (b4cov_expr E E (id : C → C) (j t) (f p)) (extChartAt 𝓘(ℂ, E) (j t) (j t))) 0
  let N := fun z ↦ HurwitzPrymRR_loc hE ((d (T z))⁻¹ • (F (j (T z))).1) p z * deriv T z
  let D := fun z ↦ HurwitzPrymRR_loc hE η p z *
    ((G (k z)).elim 0 id - (G (f (k z))).elim 0 id)
  have hTa : AnalyticAt ℂ T 0 := by
    apply b4cov_transport_analyticAt
    apply b4cov_analyticAt_chart f hf p (f p) _ (mem_extChartAt_target p)
    rw [extChartAt_to_inv]
    exact mem_extChartAt_source (f p)
  have hT0 : T 0 = 0 := b4cov_transport_zero _ _ _ _
  have hN : MeromorphicAt N 0 :=
    (RiemannRochEichler_modified_graph_meromorphic hE S hS W hw ha hz K G
      (fun r ↦ η ⟨r, b4cov_lineEquiv hE 1⟩) F hF (f p) p T hTa hT0).mul hTa.deriv.meromorphicAt
  have hB := RiemannRochEichler_modified_graph_residue_from_germ hE S hS W hw ha hz
    K G (fun r ↦ η ⟨r, b4cov_lineEquiv hE 1⟩) F hF (f p) p himage hGe hK T hTa hT0 H hH hres
  have hNo : (-1 : WithTop ℤ) ≤ meromorphicOrderAt N 0 := by
    rw [show N = (fun z ↦ HurwitzPrymRR_loc hE ((d (T z))⁻¹ • (F (j (T z))).1) p z) * deriv T from rfl,
      meromorphicOrderAt_mul
        (RiemannRochEichler_modified_graph_meromorphic hE S hS W hw ha hz K G
          (fun r ↦ η ⟨r, b4cov_lineEquiv hE 1⟩) F hF (f p) p T hTa hT0)
        hTa.deriv.meromorphicAt]
    simpa only [add_zero] using add_le_add hB.1 hTa.deriv.meromorphicOrderAt_nonneg
  have hNr : residue N 0 = H 0 * deriv T 0 := by
    change residue ((fun z ↦ HurwitzPrymRR_loc hE ((d (T z))⁻¹ • (F (j (T z))).1) p z) * deriv T) 0 = _
    rw [RiemannRochEichler_residue_mul_analytic
      (RiemannRochEichler_modified_graph_meromorphic hE S hS W hw ha hz K G
        (fun r ↦ η ⟨r, b4cov_lineEquiv hE 1⟩) F hF (f p) p T hTa hT0) hB.1 hTa.deriv, hB.2]
  have hGa : AnalyticAt ℂ (fun z ↦ (G (k z)).elim 0 id - (G (f (k z))).elim 0 id) 0 :=
    (RiemannRochEichler_functionLocal_analytic hE G p hGp).sub
      (RiemannRochEichler_scalar_pullback_analytic hE (fun x ↦ (G x).elim 0 id) f hf p
        (RiemannRochEichler_functionLocal_analytic hE G (f p) hGe))
  have hk0 : k 0 = p := by simp [k, extChartAt_to_inv]
  have hG0 : (G (k 0)).elim 0 id - (G (f (k 0))).elim 0 id ≠ 0 := by
    rw [hk0]
    exact sub_ne_zero.mpr hsep
  have hG : ∀ᶠ z in 𝓝[≠] (0 : ℂ), (G (k z)).elim 0 id ≠ (G (f (k z))).elim 0 id :=
    (hGa.continuousAt.eventually_ne hG0).filter_mono nhdsWithin_le_nhds |>.mono
      (fun z hz ↦ sub_ne_zero.mp hz)
  have hη : ∀ᶠ z in 𝓝[≠] (0 : ℂ), HurwitzPrymRR_loc hE η p z ≠ 0 :=
    (hηa.continuousAt.eventually_ne hη0).filter_mono nhdsWithin_le_nhds
  have hD : AnalyticAt ℂ D 0 := hηa.mul hGa
  have hD0 : D 0 ≠ 0 := mul_ne_zero hη0 hG0
  have hDo : meromorphicOrderAt D 0 = 0 := by
    rw [hD.meromorphicOrderAt_eq, hD.analyticOrderAt_eq_zero.mpr hD0]
    rfl
  have hpoints : ∀ᶠ z in 𝓝[≠] (0 : ℂ), k z ∈ Sᶜ ∧ f (k z) ∈ Sᶜ ∧ k z ≠ f (k z) := by
    filter_upwards [RiemannRochEichler_coordinate_avoid_finite hE (S ∪ f ⁻¹' S)
      (hS.union (Set.Finite.preimage hfi.injOn hS)) p, hG] with z hz hg
    refine ⟨fun h ↦ hz (Or.inl h), fun h ↦ hz (Or.inr h), ?_⟩
    exact fun h ↦ hg (congrArg (fun x ↦ (G x).elim 0 id) h)
  have he := RiemannRochEichler_graph_modified_product_charts hE (fun x ↦ (K x).1)
    (fun y ↦ (F y).1) (fun x ↦ (K x).property.1) (fun y ↦ (hw (F y)).1)
    η η.property.1 (fun x ↦ (G x).elim 0 id) Sᶜ
    (fun x hx y hy hxy ↦ by simpa only [RiemannRochEichler_loc_zero] using hF y hy x hx hxy)
    f hf p (f p) rfl hpoints
  have hc := RiemannRochEichler_graph_coordinates hE f hf p (f p) rfl
  suffices heq : N / D =ᶠ[𝓝[≠] (0 : ℂ)] HurwitzPrymRR_loc hE
      (fun t : TangentBundle 𝓘(ℂ, E) C ↦ K t.1
        ⟨f t.1, mfderiv 𝓘(ℂ, E) 𝓘(ℂ, E) f t.1 t.2⟩) p by
    rw [← residue_congr_nhdsNE heq]
    have hr := RiemannRochEichler_residue_mul_analytic hN hNo (hD.inv hD0)
    change residue (fun z ↦ N z * (D z)⁻¹) 0 = residue N 0 * (D 0)⁻¹ at hr
    change residue (fun z ↦ N z * (D z)⁻¹) 0 = _
    rw [hr, hNr]
    change H 0 * deriv T 0 * (D 0)⁻¹ = _
    dsimp only [D]
    rw [hk0]
    rfl
  filter_upwards [he, nhdsWithin_le_nhds hc, hη, hG] with z he hc hη hg
  have hdn : D z ≠ 0 := mul_ne_zero hη (sub_ne_zero.mpr hg)
  change N z / D z = _
  change N z = _ at he
  change j (T z) = f (k z) at hc
  change N z = HurwitzPrymRR_loc hE
    (fun t : TangentBundle 𝓘(ℂ, E) C ↦ K t.1
      ⟨f t.1, mfderiv 𝓘(ℂ, E) 𝓘(ℂ, E) f t.1 t.2⟩) p z *
    (HurwitzPrymRR_loc hE η p z * ((G (k z)).elim 0 id - (G (j (T z))).elim 0 id)) at he
  rw [hc] at he
  change N z = _ * D z at he
  rw [he, mul_div_cancel_right₀ _ hdn]


/-- The graph residue at an auxiliary point is the negative pulled-back normalized basis coefficient. -/
lemma RiemannRochEichler_normalized_graph_auxiliary_residue
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) {ι : Type} [Fintype ι]
    (a : ι → C) (ha : Function.Injective a) (b : Module.Basis ι ℂ (b3_HolForm E C))
    (hb : ∀ i j, RiemannRochEichler_eval hE (a i) (b j) = if i = j then 1 else 0)
    (q : C) (hq : q ∉ Set.range a)
    (K : C → b4c_MeroForm E C hE)
    (hK : ∀ p, p ∉ Set.range a → p ≠ q →
      b4c_res (hE := hE) (K p) p = -1 ∧ b4c_res (hE := hE) (K p) q = 1 ∧
      (∀ x, (-1 : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (K p) x) 0) ∧
      (∀ x, x ≠ p → x ≠ q → AnalyticAt ℂ (HurwitzPrymRR_loc hE (K p) x) 0) ∧
      ∀ i, K p ⟨a i, b4cov_lineEquiv hE 1⟩ = 0)
    (f : C ≃ₜ C) (hf : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω f)
    (i : ι) (hfp : f (a i) ≠ a i) (hfq : f (a i) ≠ q) :
    residue (HurwitzPrymRR_loc hE
      (fun t : TangentBundle 𝓘(ℂ, E) C ↦ K t.1
        ⟨f t.1, mfderiv 𝓘(ℂ, E) 𝓘(ℂ, E) f t.1 t.2⟩) (a i)) 0 =
      -HurwitzPrymRR_loc hE (b i) (f (a i)) 0 *
        deriv (b4cov_transport hE hE (b4cov_expr E E f (a i) (f (a i)))
          (extChartAt 𝓘(ℂ, E) (a i) (a i))) 0 := by
  classical
  let p := a i
  have hnorm : ∀ p, p ∉ Set.range a → p ≠ q →
      b4c_res (hE := hE) (K p) p = -1 ∧ b4c_res (hE := hE) (K p) q = 1 ∧
      (∀ x, (-1 : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (K p) x) 0) ∧
      (∀ x, x ≠ p → x ≠ q → 0 ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (K p) x) 0) ∧
      (∀ i, AnalyticAt ℂ (HurwitzPrymRR_loc hE (K p) (a i)) 0) ∧
      ∀ i, K p ⟨a i, b4cov_lineEquiv hE 1⟩ = 0 := by
    intro p hp hpq
    obtain ⟨h₁, h₂, h₃, h₄, h₅⟩ := hK p hp hpq
    exact ⟨h₁, h₂, h₃, fun x hxp hxq ↦ (h₄ x hxp hxq).meromorphicOrderAt_nonneg,
      fun i ↦ h₄ (a i) (fun h ↦ hp ⟨i, h⟩) (fun h ↦ hq ⟨i, h⟩), h₅⟩
  obtain ⟨G, η, S, N, M, hAS, hGp, hGe, hηa, hη0, hpS, hGo, hGout, hηo, hηout⟩ :=
    RiemannRochEichler_off_diagonal_kernel_data hE (Set.range a ∪ {q})
      ((Set.finite_range a).union (Set.finite_singleton q)) p (f p) hfp.symm
  have hSa : ∀ i, a i ∈ S := fun i ↦ hAS (Or.inl ⟨i, rfl⟩)
  have hSq : q ∈ S := hAS (Or.inr rfl)
  have hFA (y : C) (hy : y ∉ S) : y ∉ Set.range a := by
    rintro ⟨i, rfl⟩
    exact hy (hSa i)
  have hFq (y : C) (hy : y ∉ S) : y ≠ q := fun he ↦ hy (he ▸ hSq)
  obtain ⟨W, hfin, F, hW, hrep, _⟩ :=
    RiemannRochEichler_joint_modified_kernel_family hE a ha b hb q hq K hK
      S hSa hSq G N M hGo hGout η hηo hηout
  letI : Module.Finite ℂ W := hfin
  have hF : ∀ y ∉ S, ∀ r ∉ S, r ≠ y →
      (F y).1 ⟨r, b4cov_lineEquiv hE 1⟩ = HurwitzPrymRR_loc hE (K r) y 0 *
        ((G r).elim 0 id - (G y).elim 0 id) * η ⟨r, b4cov_lineEquiv hE 1⟩ := by
    intro y hy r hr hry
    have hv := RiemannRochEichler_modified_representative_value hE a ha b hb q y hq
      (hFA y hy) (hFq y hy) K hnorm r (hFA r hr) (hFq r hr) hry G (hGout r hr)
      η (hηout r hr) (F y).1 ((hW _ (F y).property).2.1 r hr) (hrep y hy r)
    rw [RiemannRochEichler_residue_germ_value
      ((hK r (hFA r hr) (hFq r hr)).2.2.2.1 y (Ne.symm hry) (hFq y hy))
      Filter.EventuallyEq.rfl] at hv
    exact hv
  let F' : C → W := fun y ↦ if y ∈ S then 0 else F y
  have hF' : ∀ y ∉ S, ∀ r ∉ S, r ≠ y →
      (F' y).1 ⟨r, b4cov_lineEquiv hE 1⟩ = HurwitzPrymRR_loc hE (K r) y 0 *
        ((G r).elim 0 id - (G y).elim 0 id) * η ⟨r, b4cov_lineEquiv hE 1⟩ := by
    intro y hy r hr hry
    simpa only [F', if_neg hy] using hF y hy r hr hry
  have hGpfin : G p ≠ OnePoint.infty := by rw [hGp]; exact OnePoint.coe_ne_infty _
  have haux (y : C) (hy : y ∉ S) :=
    RiemannRochEichler_modified_auxiliary_residue hE a ha b hb q y hq
      (hFA y hy) (hFq y hy) K hnorm i G hGpfin η hηa
      (HurwitzPrymRR_loc hE (F y).1 p) (hrep y hy p)
  have himage : ∀ y, (-1 : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (F' y).1 p) 0 := by
    intro y
    by_cases hy : y ∈ S
    · simp only [F', if_pos hy]
      change (-1 : WithTop ℤ) ≤ meromorphicOrderAt (fun _ : ℂ ↦ (0 : ℂ)) 0
      rw [meromorphicOrderAt_const, if_pos rfl]
      exact le_top
    · simpa only [F', if_neg hy] using (haux y hy).2.1
  let T := b4cov_transport hE hE (b4cov_expr E E f p (f p)) (extChartAt 𝓘(ℂ, E) p p)
  let j := fun t ↦ (extChartAt 𝓘(ℂ, E) (f p)).symm
    (extChartAt 𝓘(ℂ, E) (f p) (f p) + b4cov_lineEquiv hE t)
  let d := fun t ↦ deriv (b4cov_transport hE hE
    (b4cov_expr E E (id : C → C) (j t) (f p)) (extChartAt 𝓘(ℂ, E) (j t) (j t))) 0
  have hTa : AnalyticAt ℂ T 0 := by
    apply b4cov_transport_analyticAt
    apply b4cov_analyticAt_chart f hf p (f p) _ (mem_extChartAt_target p)
    rw [extChartAt_to_inv]
    exact mem_extChartAt_source (f p)
  have hT0 : T 0 = 0 := b4cov_transport_zero _ _ _ _
  have hd : deriv T 0 ≠ 0 := RiemannRochEichler_graph_coordinate_derivative hE f hf f.injective p
  have hnc : ¬ EventuallyConst T (𝓝 0) := by
    intro hc
    obtain ⟨c, hc⟩ := hc.eventuallyEq_const
    exact hd (hc.deriv_eq.trans (deriv_const _ _))
  have ht : Tendsto T (𝓝[≠] 0) (𝓝[≠] 0) := by
    have h := hTa.map_nhdsNE hnc
    rw [hT0] at h
    exact h
  have hGeFin : G (f p) ≠ OnePoint.infty := by rw [hGe]; exact OnePoint.coe_ne_infty _
  let H := fun z ↦ -HurwitzPrymRR_loc hE (b i) (f p) (T z) *
    ((G p).elim 0 id - RiemannRochEichler_functionLocal hE G (f p) (T z)) *
      HurwitzPrymRR_loc hE η p 0
  have hH : AnalyticAt ℂ H 0 :=
    (((hT0.symm ▸ RiemannRochEichler_loc_analytic hE (b i) (f p)).comp hTa).neg.mul
      (analyticAt_const.sub ((hT0.symm ▸ RiemannRochEichler_functionLocal_analytic
        hE G (f p) hGeFin).comp hTa))).mul analyticAt_const
  have hr : (fun z ↦ residue (HurwitzPrymRR_loc hE ((d (T z))⁻¹ • (F' (j (T z))).1) p) 0)
      =ᶠ[𝓝[≠] 0] H := by
    have hav := (RiemannRochEichler_coordinate_avoid_finite hE (S : Set C) S.finite_toSet (f p))
    have hsc := RiemannRochEichler_scaled_fibre_germ hE (b i).1 (b i).property.2 (f p)
    filter_upwards [ht hav, ht (nhdsWithin_le_nhds hsc)] with z hz hsc
    change j (T z) ∉ S at hz
    change (d (T z))⁻¹ * (b i).1 ⟨j (T z), b4cov_lineEquiv hE 1⟩ =
      HurwitzPrymRR_loc hE (b i) (f p) (T z) at hsc
    change residue ((d (T z))⁻¹ • HurwitzPrymRR_loc hE (F' (j (T z))).1 p) 0 = H z
    rw [residue_const_smul]
    simp only [F', if_neg hz]
    rw [(haux _ hz).2.2]
    change (d (T z))⁻¹ * (-(b i).1 ⟨j (T z), b4cov_lineEquiv hE 1⟩ *
      ((G p).elim 0 id - (G (j (T z))).elim 0 id) * HurwitzPrymRR_loc hE η p 0) = H z
    dsimp only [H, RiemannRochEichler_functionLocal]
    rw [← hsc]
    ring
  have hrgraph := RiemannRochEichler_graph_residue_of_modified hE (S : Set C) S.finite_toSet W
    (fun w ↦ (hW w.1 w.property).1) (fun w ↦ (hW w.1 w.property).2.1)
    (fun w ↦ (hW w.1 w.property).2.2) K G η F' hF' f hf f.injective p himage hηa hη0
    hGpfin hGeFin (by rw [hGp, hGe]; exact zero_ne_one)
    (fun r hr hre ↦ (hK r (hFA r hr) (hFq r hr)).2.2.2.1 (f p) hre.symm hfq) H hH hr
  rw [hrgraph]
  change H 0 * deriv T 0 / _ = _
  dsimp only [H]
  rw [hT0]
  have hGlocal0 : RiemannRochEichler_functionLocal hE G (f p) 0 = (G (f p)).elim 0 id := by
    simp only [RiemannRochEichler_functionLocal, map_zero, add_zero, extChartAt_to_inv]
  rw [hGlocal0, hGp, hGe]
  change (-HurwitzPrymRR_loc hE (b i) (f p) 0 * (0 - 1) * HurwitzPrymRR_loc hE η p 0) *
    deriv T 0 / (HurwitzPrymRR_loc hE η p 0 * (0 - 1)) =
    -HurwitzPrymRR_loc hE (b i) (f p) 0 * deriv T 0
  field_simp


/-- The value of a pulled-back holomorphic form is its target coefficient times the coordinate derivative. -/
lemma RiemannRochEichler_pullback_evaluation
    (hE : Module.finrank ℂ E = 1) (f : C → C)
    (hf : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω f) (w : b3_HolForm E C) (p : C) :
    RiemannRochEichler_eval hE p (b4c_formPullbackEnd f hf w) =
      HurwitzPrymRR_loc hE w (f p) 0 *
        deriv (b4cov_transport hE hE (b4cov_expr E E f p (f p))
          (extChartAt 𝓘(ℂ, E) p p)) 0 := by
  have h := (RiemannRochEichler_graph_loc hE (fun _ ↦ w.1) (fun _ ↦ w.property.2)
    f hf p (f p) (mem_extChartAt_source (f p))).self_of_nhds
  change w.1 ⟨f p, mfderiv 𝓘(ℂ, E) 𝓘(ℂ, E) f p (b4cov_lineEquiv hE 1)⟩ = _
  simpa only [RiemannRochEichler_loc_zero, sub_self, map_zero, zero_add,
    b4cov_transport_zero] using h


/-- Uniform kernel data can be chosen with the prescribed centre outside every exceptional pole set. -/
lemma RiemannRochEichler_local_kernel_data
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (A : Set C) (hA : A.Finite) (p : C) (hp : p ∉ A) :
    ∃ (G : b4c_MeroFun E C) (η : b4c_MeroForm E C hE) (S : Finset C) (N M : ℕ),
      p ∉ S ∧ A ⊆ (S : Set C) ∧ G p = (0 : ℂ) ∧
      deriv (RiemannRochEichler_functionLocal hE G p) 0 ≠ 0 ∧
      HurwitzPrymRR_loc hE η p 0 ≠ 0 ∧
      (∀ r, ((-(N : ℤ)) : WithTop ℤ) ≤ meromorphicOrderAt
        (RiemannRochEichler_functionLocal hE G r) 0) ∧
      (∀ r ∉ S, G r ≠ OnePoint.infty) ∧
      (∀ r, ((-(M : ℤ)) : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE η r) 0) ∧
      ∀ r ∉ S, AnalyticAt ℂ (HurwitzPrymRR_loc hE η r) 0 := by
  classical
  obtain ⟨G, hnc, hGp, _, hGd⟩ := RiemannRochEichler_unramified_function hE p
  obtain ⟨P, N, hP, hGo⟩ := RiemannRochEichler_function_pole_bounds hE G hnc
  obtain ⟨η, hηa, hη0⟩ := RiemannRochEichler_local_unit_form hE p
  have hηo : meromorphicOrderAt (HurwitzPrymRR_loc hE η p) 0 = 0 := by
    rw [hηa.meromorphicOrderAt_eq, hηa.analyticOrderAt_eq_zero.mpr hη0]
    rfl
  obtain ⟨M, hMo⟩ := RiemannRochEichler_uniform_form_order hE η ⟨p, by rw [hηo]; exact WithTop.zero_ne_top⟩
  let B := {r : C | ¬ AnalyticAt ℂ (HurwitzPrymRR_loc hE η r) 0}
  have hB : B.Finite := RiemannRochEichler_nonanalytic_finite hE η
  let S := hA.toFinset ∪ P ∪ hB.toFinset
  have hpP : p ∉ P := by
    intro h
    have hi := (hP p).mp h
    rw [hGp] at hi
    exact OnePoint.coe_ne_infty 0 hi
  have hpS : p ∉ S := by
    simp only [S, Finset.mem_union, Set.Finite.mem_toFinset, not_or]
    exact ⟨⟨hp, hpP⟩, fun h ↦ h hηa⟩
  refine ⟨G, η, S, N, M, hpS, ?_, hGp, hGd, hη0, hGo, ?_, hMo, ?_⟩
  · intro r hr
    exact Finset.mem_union_left _ (Finset.mem_union_left _ (hA.mem_toFinset.mpr hr))
  · intro r hr hGr
    apply hr
    exact Finset.mem_union_left _ (Finset.mem_union_right _ ((hP r).mpr hGr))
  · intro r hr
    by_contra h
    apply hr
    exact Finset.mem_union_right _ (hB.mem_toFinset.mpr h)


/-- The centred transition from a chart to itself has derivative one. -/
lemma RiemannRochEichler_self_transition_derivative
    (hE : Module.finrank ℂ E = 1) (p : C) :
    deriv (b4cov_transport hE hE (b4cov_expr E E (id : C → C) p p)
      (extChartAt 𝓘(ℂ, E) p p)) 0 = 1 := by
  let w : TangentBundle 𝓘(ℂ, E) C → ℂ := fun t ↦ (b4cov_lineEquiv hE).symm t.2
  have hw : HurwitzPrymRR_IsLinear w := by
    intro q a u v
    change E at u v
    change (b4cov_lineEquiv hE).symm (a • u + v) =
      a * (b4cov_lineEquiv hE).symm u + (b4cov_lineEquiv hE).symm v
    simp only [map_add, map_smul, smul_eq_mul]
  have hc := RiemannRochEichler_chart_value hE w hw p p (mem_extChartAt_source p)
  dsimp only at hc
  simp only [sub_self, map_zero, RiemannRochEichler_loc_zero] at hc
  change (b4cov_lineEquiv hE).symm (b4cov_lineEquiv hE 1) =
    (b4cov_lineEquiv hE).symm (b4cov_lineEquiv hE 1) * _ at hc
  simpa only [ContinuousLinearEquiv.symm_apply_apply, one_mul] using hc.symm


/-- Analytic germs with distinct derivatives differ throughout a punctured neighbourhood. -/
lemma RiemannRochEichler_analytic_separated
    {f g : ℂ → ℂ} {x : ℂ} (hf : AnalyticAt ℂ f x) (hg : AnalyticAt ℂ g x)
    (hd : deriv f x ≠ deriv g x) :
    ∀ᶠ z in 𝓝[≠] x, f z ≠ g z := by
  rcases hf.eventually_eq_or_eventually_ne hg with he | he
  · have heq : f =ᶠ[𝓝 x] g := he
    exact (hd heq.deriv_eq).elim
  · exact he


/-- Restricting a jointly analytic modified diagonal kernel to a graph gives the tangent multiplier residue. -/
lemma RiemannRochEichler_joint_graph_residue
    (R : ℂ × ℂ → ℂ) (g η s : ℂ → ℂ)
    (hR : AnalyticAt ℂ R (0, 0)) (hg : AnalyticAt ℂ g 0)
    (hη : AnalyticAt ℂ η 0) (hs : AnalyticAt ℂ s 0)
    (hs0 : s 0 = 0) (hη0 : η 0 ≠ 0) (hg' : deriv g 0 ≠ 0)
    (hs' : deriv s 0 ≠ 1) (hdiag : R (0, 0) = deriv g 0 * η 0) :
    MeromorphicAt (fun z ↦ R (s z, z) * deriv s z / (η z * (g z - g (s z)))) 0 ∧
      residue (fun z ↦ R (s z, z) * deriv s z / (η z * (g z - g (s z)))) 0 =
        deriv s 0 / (1 - deriv s 0) := by
  have hgc : AnalyticAt ℂ (fun z ↦ g (s z)) 0 :=
    AnalyticAt.comp (g := g) (f := s) (by simpa only [hs0] using hg) hs
  have hRc : AnalyticAt ℂ (fun z ↦ R (s z, z)) 0 :=
    AnalyticAt.comp (g := R) (f := fun z ↦ (s z, z))
      (by simpa only [hs0] using hR) (hs.prod analyticAt_id)
  have hnum : AnalyticAt ℂ (fun z ↦ R (s z, z) * deriv s z) 0 := hRc.mul hs.deriv
  have hden : AnalyticAt ℂ (fun z ↦ η z * (g z - g (s z))) 0 := hη.mul (hg.sub hgc)
  have hdergc : HasDerivAt (fun z ↦ g (s z)) (deriv g 0 * deriv s 0) 0 := by
    have hgd : HasDerivAt g (deriv g 0) (s 0) := by
      simpa only [hs0] using hg.differentiableAt.hasDerivAt
    exact hgd.comp 0 hs.differentiableAt.hasDerivAt
  have hd : deriv (fun z ↦ η z * (g z - g (s z))) 0 =
      η 0 * deriv g 0 * (1 - deriv s 0) := by
    change deriv (η * (g - fun z ↦ g (s z))) 0 = _
    rw [(hη.differentiableAt.hasDerivAt.mul
      (hg.differentiableAt.hasDerivAt.sub hdergc)).deriv]
    simp only [Pi.sub_apply]
    rw [hs0, sub_self, mul_zero, zero_add]
    ring
  have hn : 1 - deriv s 0 ≠ 0 := sub_ne_zero.mpr (Ne.symm hs')
  have hdne : deriv (fun z ↦ η z * (g z - g (s z))) 0 ≠ 0 := by
    rw [hd]
    exact mul_ne_zero (mul_ne_zero hη0 hg') hn
  refine ⟨hnum.meromorphicAt.div hden.meromorphicAt, ?_⟩
  rw [residue_div_of_zero_deriv_ne_zero hnum hden (by simp [hs0]) hdne, hd, hs0, hdiag]
  field_simp
  <;> ring


/-- A modified graph product transfers the quotient residue to the original coefficient germ. -/
lemma RiemannRochEichler_graph_residue_of_product
    (A : ℂ → ℂ) (R : ℂ × ℂ → ℂ) (g η s : ℂ → ℂ)
    (hR : AnalyticAt ℂ R (0, 0)) (hg : AnalyticAt ℂ g 0)
    (hη : AnalyticAt ℂ η 0) (hs : AnalyticAt ℂ s 0)
    (hs0 : s 0 = 0) (hη0 : η 0 ≠ 0) (hg' : deriv g 0 ≠ 0)
    (hs' : deriv s 0 ≠ 1) (hdiag : R (0, 0) = deriv g 0 * η 0)
    (he : (fun z ↦ R (s z, z) * deriv s z) =ᶠ[𝓝[≠] 0]
      (fun z ↦ A z * (η z * (g z - g (s z))))) :
    MeromorphicAt A 0 ∧ residue A 0 = deriv s 0 / (1 - deriv s 0) := by
  have hgc : AnalyticAt ℂ (fun z ↦ g (s z)) 0 :=
    AnalyticAt.comp (g := g) (f := s) (by simpa only [hs0] using hg) hs
  have hd : deriv (fun z ↦ g (s z)) 0 = deriv g 0 * deriv s 0 := by
    have hgd : HasDerivAt g (deriv g 0) (s 0) := by
      simpa only [hs0] using hg.differentiableAt.hasDerivAt
    exact (hgd.comp 0 hs.differentiableAt.hasDerivAt).deriv
  have hne : deriv g 0 ≠ deriv (fun z ↦ g (s z)) 0 := by
    rw [hd]
    intro h
    apply hs'
    exact (mul_left_cancel₀ hg' (by simpa only [mul_one] using h.symm))
  have hdiff := RiemannRochEichler_analytic_separated hg hgc hne
  have hunit := hη.continuousAt.eventually_ne hη0
  have hq : A =ᶠ[𝓝[≠] 0]
      (fun z ↦ R (s z, z) * deriv s z / (η z * (g z - g (s z)))) := by
    filter_upwards [he, hdiff, nhdsWithin_le_nhds hunit] with z hz hd hηz
    rw [hz, mul_div_cancel_right₀ _ (mul_ne_zero hηz (sub_ne_zero.mpr hd))]
  obtain ⟨hm, hr⟩ := RiemannRochEichler_joint_graph_residue R g η s hR hg hη hs hs0
    hη0 hg' hs' hdiag
  exact ⟨hm.congr hq.symm, (residue_congr_nhdsNE hq).trans hr⟩


/-- Modified kernel values identify the product of the graph coefficient and its denominator. -/
lemma RiemannRochEichler_graph_modified_product
    (hE : Module.finrank ℂ E = 1)
    (K F : C → TangentBundle 𝓘(ℂ, E) C → ℂ)
    (hK : ∀ p, HurwitzPrymRR_IsLinear (K p))
    (hF : ∀ p, HurwitzPrymRR_IsLinear (F p))
    (η : TangentBundle 𝓘(ℂ, E) C → ℂ) (hη : HurwitzPrymRR_IsLinear η)
    (G : C → ℂ) (U : Set C)
    (hval : ∀ x ∈ U, ∀ y ∈ U, x ≠ y →
      F y ⟨x, b4cov_lineEquiv hE 1⟩ =
        K x ⟨y, b4cov_lineEquiv hE 1⟩ * (G x - G y) * η ⟨x, b4cov_lineEquiv hE 1⟩)
    (f : C → C) (hf : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω f) (p : C) (hfp : f p = p)
    (hpoints : ∀ᶠ z in 𝓝[≠] (0 : ℂ),
      let x := (extChartAt 𝓘(ℂ, E) p).symm
        (extChartAt 𝓘(ℂ, E) p p + b4cov_lineEquiv hE z)
      x ∈ U ∧ f x ∈ U ∧ x ≠ f x) :
    let k := fun z ↦ (extChartAt 𝓘(ℂ, E) p).symm
      (extChartAt 𝓘(ℂ, E) p p + b4cov_lineEquiv hE z)
    let T := b4cov_transport hE hE (b4cov_expr E E f p p) (extChartAt 𝓘(ℂ, E) p p)
    let d := fun y ↦ deriv (b4cov_transport hE hE (b4cov_expr E E (id : C → C) y p)
      (extChartAt 𝓘(ℂ, E) y y)) 0
    (fun z ↦ HurwitzPrymRR_loc hE ((d (k (T z)))⁻¹ • F (k (T z))) p z * deriv T z)
      =ᶠ[𝓝[≠] 0]
    (fun z ↦ HurwitzPrymRR_loc hE
      (fun t : TangentBundle 𝓘(ℂ, E) C ↦ K t.1
        ⟨f t.1, mfderiv 𝓘(ℂ, E) 𝓘(ℂ, E) f t.1 t.2⟩) p z *
      (HurwitzPrymRR_loc hE η p z * (G (k z) - G (k (T z))))) := by
  let φ := extChartAt 𝓘(ℂ, E) p
  let k := fun z ↦ φ.symm (φ p + b4cov_lineEquiv hE z)
  let T := b4cov_transport hE hE (b4cov_expr E E f p p) (φ p)
  have hps : p ∈ φ.source := mem_extChartAt_source p
  have hkp : k 0 = p := by simp [k, φ]
  have hlin : ContinuousAt (fun z : ℂ ↦ φ p + b4cov_lineEquiv hE z) 0 :=
    continuous_const.continuousAt.add (b4cov_lineEquiv hE).continuous.continuousAt
  have hk : ContinuousAt k 0 := by
    apply ((continuousOn_extChartAt_symm p).continuousAt _).comp hlin
    apply (isOpen_extChartAt_target p).mem_nhds
    simpa only [map_zero, add_zero] using mem_extChartAt_target p
  have hnear : ∀ᶠ z in 𝓝 (0 : ℂ),
      φ p + b4cov_lineEquiv hE z ∈ φ.target ∧ f (k z) ∈ φ.source := by
    have h₁ : ∀ᶠ z in 𝓝 (0 : ℂ), φ p + b4cov_lineEquiv hE z ∈ φ.target :=
      hlin.preimage_mem_nhds
        (by simpa only [map_zero, add_zero] using (isOpen_extChartAt_target p).mem_nhds (φ.map_source hps))
    have h₂ : ∀ᶠ z in 𝓝 (0 : ℂ), f (k z) ∈ φ.source :=
      (hf.continuous.continuousAt.comp hk).preimage_mem_nhds
        (by change φ.source ∈ 𝓝 (f (k 0)); rw [hkp, hfp]; exact (isOpen_extChartAt_source p).mem_nhds hps)
    exact h₁.and h₂
  have hloc := RiemannRochEichler_graph_loc hE K hK f hf p p (by rw [hfp]; exact hps)
  simp only [hfp, sub_self, map_zero, zero_add] at hloc
  filter_upwards [hpoints, nhdsWithin_le_nhds hnear, nhdsWithin_le_nhds hloc] with z hz hn hl
  have hcx : (b4cov_lineEquiv hE).symm (φ (k z) - φ p) = z := by
    rw [φ.right_inv hn.1, add_sub_cancel_left]
    exact (b4cov_lineEquiv hE).symm_apply_apply z
  have hT : T z = (b4cov_lineEquiv hE).symm (φ (f (k z)) - φ p) := by
    change (b4cov_lineEquiv hE).symm (φ (f (k z))) -
      (b4cov_lineEquiv hE).symm (φ (f (φ.symm (φ p)))) = _
    rw [φ.left_inv hps, hfp, map_sub]
  have hkT : k (T z) = f (k z) := by
    rw [hT]
    dsimp only [k]
    rw [ContinuousLinearEquiv.apply_symm_apply, add_sub_cancel, φ.left_inv hn.2]
  have hv := RiemannRochEichler_fixed_chart_modified_value hE (F (f (k z))) (K (k z)) η
    (hF _) (hK _) hη p p (k z) (f (k z)) (φ.map_target hn.1) hn.2
    (G (k z) - G (f (k z))) (hval _ hz.1 _ hz.2.1 hz.2.2)
  dsimp only at hv
  rw [hcx, ← hT] at hv
  change HurwitzPrymRR_loc hE
    ((deriv (b4cov_transport hE hE (b4cov_expr E E (id : C → C) (k (T z)) p)
      (extChartAt 𝓘(ℂ, E) (k (T z)) (k (T z)))) 0)⁻¹ • F (k (T z))) p z * deriv T z =
    HurwitzPrymRR_loc hE
      (fun t : TangentBundle 𝓘(ℂ, E) C ↦ K t.1
        ⟨f t.1, mfderiv 𝓘(ℂ, E) 𝓘(ℂ, E) f t.1 t.2⟩) p z *
      (HurwitzPrymRR_loc hE η p z * (G (k z) - G (k (T z))))
  rw [hkT, hv, hl]
  dsimp only [k, T, φ]
  ring


/-- A fixed point with multiplier different from one is isolated within any prescribed neighbourhood. -/
lemma RiemannRochEichler_graph_points_near_fixed
    (hE : Module.finrank ℂ E = 1) (f : C → C)
    (hf : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω f) (p : C) (hfp : f p = p)
    (U : Set C) (hU : U ∈ 𝓝 p)
    (hd : deriv (b4cov_transport hE hE (b4cov_expr E E f p p)
      (extChartAt 𝓘(ℂ, E) p p)) 0 ≠ 1) :
    ∀ᶠ z in 𝓝[≠] (0 : ℂ),
      let x := (extChartAt 𝓘(ℂ, E) p).symm
        (extChartAt 𝓘(ℂ, E) p p + b4cov_lineEquiv hE z)
      x ∈ U ∧ f x ∈ U ∧ x ≠ f x := by
  let φ := extChartAt 𝓘(ℂ, E) p
  let k := fun z ↦ φ.symm (φ p + b4cov_lineEquiv hE z)
  let T := b4cov_transport hE hE (b4cov_expr E E f p p) (φ p)
  have hps : p ∈ φ.source := mem_extChartAt_source p
  have hkp : k 0 = p := by simp [k, φ]
  have hlin : ContinuousAt (fun z : ℂ ↦ φ p + b4cov_lineEquiv hE z) 0 :=
    continuous_const.continuousAt.add (b4cov_lineEquiv hE).continuous.continuousAt
  have hk : ContinuousAt k 0 := by
    apply ((continuousOn_extChartAt_symm p).continuousAt _).comp hlin
    apply (isOpen_extChartAt_target p).mem_nhds
    simpa only [map_zero, add_zero] using mem_extChartAt_target p
  have h₁ : ∀ᶠ z in 𝓝 (0 : ℂ), k z ∈ U :=
    hk.preimage_mem_nhds (by rw [hkp]; exact hU)
  have h₂ : ∀ᶠ z in 𝓝 (0 : ℂ), f (k z) ∈ U :=
    (hf.continuous.continuousAt.comp hk).preimage_mem_nhds
      (by change U ∈ 𝓝 (f (k 0)); rw [hkp, hfp]; exact hU)
  have ht : ∀ᶠ z in 𝓝 (0 : ℂ), φ p + b4cov_lineEquiv hE z ∈ φ.target :=
    hlin.preimage_mem_nhds (by simpa only [map_zero, add_zero] using
      (isOpen_extChartAt_target p).mem_nhds (φ.map_source hps))
  have hTa : AnalyticAt ℂ T 0 := by
    apply b4cov_transport_analyticAt
    apply b4cov_analyticAt_chart f hf p p _ (φ.map_source hps)
    change f (φ.symm (φ p)) ∈ φ.source
    rw [φ.left_inv hps, hfp]
    exact hps
  have hsep : ∀ᶠ z in 𝓝[≠] (0 : ℂ), T z ≠ z :=
    RiemannRochEichler_analytic_separated hTa analyticAt_id (by simpa only [deriv_id''] using hd)
  filter_upwards [nhdsWithin_le_nhds h₁, nhdsWithin_le_nhds h₂,
    nhdsWithin_le_nhds ht, hsep] with z hz₁ hz₂ hzt hzs
  refine ⟨hz₁, hz₂, ?_⟩
  intro he
  apply hzs
  change (b4cov_lineEquiv hE).symm (φ (f (k z))) -
    (b4cov_lineEquiv hE).symm (φ (f (φ.symm (φ p)))) = z
  rw [← he, φ.left_inv hps, hfp, ← map_sub, φ.right_inv hzt, add_sub_cancel_left]
  exact (b4cov_lineEquiv hE).symm_apply_apply z


/-- An analytic modified kernel determines the residue of the actual graph differential at a fixed point. -/
lemma RiemannRochEichler_graph_fixed_residue
    (hE : Module.finrank ℂ E = 1)
    (K F : C → TangentBundle 𝓘(ℂ, E) C → ℂ)
    (hK : ∀ p, HurwitzPrymRR_IsLinear (K p))
    (hF : ∀ p, HurwitzPrymRR_IsLinear (F p))
    (η : TangentBundle 𝓘(ℂ, E) C → ℂ) (hηlin : HurwitzPrymRR_IsLinear η)
    (G : C → ℂ) (U : Set C)
    (hval : ∀ x ∈ U, ∀ y ∈ U, x ≠ y →
      F y ⟨x, b4cov_lineEquiv hE 1⟩ =
        K x ⟨y, b4cov_lineEquiv hE 1⟩ * (G x - G y) * η ⟨x, b4cov_lineEquiv hE 1⟩)
    (f : C → C) (hf : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω f) (p : C) (hfp : f p = p)
    (hU : U ∈ 𝓝 p)
    (hη : AnalyticAt ℂ (HurwitzPrymRR_loc hE η p) 0)
    (hη0 : HurwitzPrymRR_loc hE η p 0 ≠ 0)
    (hg : AnalyticAt ℂ (fun z ↦ G ((extChartAt 𝓘(ℂ, E) p).symm
      (extChartAt 𝓘(ℂ, E) p p + b4cov_lineEquiv hE z))) 0)
    (hg' : deriv (fun z ↦ G ((extChartAt 𝓘(ℂ, E) p).symm
      (extChartAt 𝓘(ℂ, E) p p + b4cov_lineEquiv hE z))) 0 ≠ 0)
    (hd : deriv (b4cov_transport hE hE (b4cov_expr E E f p p)
      (extChartAt 𝓘(ℂ, E) p p)) 0 ≠ 1)
    (hdiag : HurwitzPrymRR_loc hE (F p) p 0 =
      deriv (fun z ↦ G ((extChartAt 𝓘(ℂ, E) p).symm
        (extChartAt 𝓘(ℂ, E) p p + b4cov_lineEquiv hE z))) 0 * HurwitzPrymRR_loc hE η p 0)
    (hR :
      let k := fun z ↦ (extChartAt 𝓘(ℂ, E) p).symm
        (extChartAt 𝓘(ℂ, E) p p + b4cov_lineEquiv hE z)
      let d := fun y ↦ deriv (b4cov_transport hE hE (b4cov_expr E E (id : C → C) y p)
        (extChartAt 𝓘(ℂ, E) y y)) 0
      AnalyticAt ℂ (fun z : ℂ × ℂ ↦ HurwitzPrymRR_loc hE ((d (k z.1))⁻¹ • F (k z.1)) p z.2)
        (0, 0)) :
    let A := HurwitzPrymRR_loc hE
      (fun t : TangentBundle 𝓘(ℂ, E) C ↦ K t.1
        ⟨f t.1, mfderiv 𝓘(ℂ, E) 𝓘(ℂ, E) f t.1 t.2⟩) p
    let μ := deriv (b4cov_transport hE hE (b4cov_expr E E f p p)
      (extChartAt 𝓘(ℂ, E) p p)) 0
    MeromorphicAt A 0 ∧ residue A 0 = μ / (1 - μ) := by
  let k := fun z ↦ (extChartAt 𝓘(ℂ, E) p).symm
    (extChartAt 𝓘(ℂ, E) p p + b4cov_lineEquiv hE z)
  let T := b4cov_transport hE hE (b4cov_expr E E f p p) (extChartAt 𝓘(ℂ, E) p p)
  let d := fun y ↦ deriv (b4cov_transport hE hE (b4cov_expr E E (id : C → C) y p)
    (extChartAt 𝓘(ℂ, E) y y)) 0
  let R := fun z : ℂ × ℂ ↦ HurwitzPrymRR_loc hE ((d (k z.1))⁻¹ • F (k z.1)) p z.2
  have hps := mem_extChartAt_source (I := 𝓘(ℂ, E)) p
  have hTa : AnalyticAt ℂ T 0 := by
    apply b4cov_transport_analyticAt
    apply b4cov_analyticAt_chart f hf p p _ (mem_extChartAt_target p)
    simpa only [(extChartAt 𝓘(ℂ, E) p).left_inv hps, hfp] using hps
  have hT0 : T 0 = 0 := b4cov_transport_zero _ _ _ _
  have hkp : k 0 = p := by simp [k]
  have hRp : R (0, 0) = HurwitzPrymRR_loc hE (F p) p 0 := by
    dsimp only [R]
    rw [hkp]
    have hd₀ : d p = 1 := RiemannRochEichler_self_transition_derivative hE p
    rw [hd₀, inv_one, one_smul]
  apply RiemannRochEichler_graph_residue_of_product _ R (fun z ↦ G (k z))
    (HurwitzPrymRR_loc hE η p) T hR hg hη hTa hT0 hη0 hg' hd
    (hRp.trans hdiag)
  exact RiemannRochEichler_graph_modified_product hE K F hK hF η hηlin G U hval f hf p hfp
    (RiemannRochEichler_graph_points_near_fixed hE f hf p hfp U hU hd)


/-- The diagonal value of a modified kernel representative is the derivative factor times the differential coefficient. -/
lemma RiemannRochEichler_modified_representative_diagonal_value
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) {ι : Type} [Fintype ι]
    (a : ι → C) (ha : Function.Injective a) (b : Module.Basis ι ℂ (b3_HolForm E C))
    (hb : ∀ i j, RiemannRochEichler_eval hE (a i) (b j) = if i = j then 1 else 0)
    (q y : C) (hq : q ∉ Set.range a) (hy : y ∉ Set.range a) (hyq : y ≠ q)
    (K : C → b4c_MeroForm E C hE)
    (hK : ∀ p, p ∉ Set.range a → p ≠ q →
      b4c_res (hE := hE) (K p) p = -1 ∧ b4c_res (hE := hE) (K p) q = 1 ∧
      (∀ x, (-1 : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (K p) x) 0) ∧
      (∀ x, x ≠ p → x ≠ q → 0 ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (K p) x) 0) ∧
      (∀ i, AnalyticAt ℂ (HurwitzPrymRR_loc hE (K p) (a i)) 0) ∧
      ∀ i, K p ⟨a i, b4cov_lineEquiv hE 1⟩ = 0)
    (G : b4c_MeroFun E C) (hGy : G y ≠ OnePoint.infty)
    (η : b4c_MeroForm E C hE) (hη : AnalyticAt ℂ (HurwitzPrymRR_loc hE η y) 0)
    (v : TangentBundle 𝓘(ℂ, E) C → ℂ) (hv : AnalyticAt ℂ (HurwitzPrymRR_loc hE v y) 0)
    (he : HurwitzPrymRR_loc hE v y =ᶠ[𝓝[≠] 0] (fun t ↦
      (residue (fun z ↦ HurwitzPrymRR_loc hE
        (K ((extChartAt 𝓘(ℂ, E) y).symm
          (extChartAt 𝓘(ℂ, E) y y + b4cov_lineEquiv hE t))) y z / z) 0) *
        (RiemannRochEichler_functionLocal hE G y t - (G y).elim 0 id) *
          HurwitzPrymRR_loc hE η y t)) :
    HurwitzPrymRR_loc hE v y 0 =
      deriv (RiemannRochEichler_functionLocal hE G y) 0 * HurwitzPrymRR_loc hE η y 0 := by
  obtain ⟨hm, ho, _, hr⟩ := RiemannRochEichler_parameter_pole_data hE a ha b hb q y hq hy hyq K hK
  have hG : AnalyticAt ℂ (fun t ↦ RiemannRochEichler_functionLocal hE G y t - (G y).elim 0 id) 0 :=
    (RiemannRochEichler_functionLocal_analytic hE G y hGy).sub analyticAt_const
  have hG0 : RiemannRochEichler_functionLocal hE G y 0 - (G y).elim 0 id = 0 := by
    simp [RiemannRochEichler_functionLocal]
  obtain ⟨f, hf, hef, hf0⟩ := RiemannRochEichler_cancel_simple_pole (hm y) (ho y) hG hG0
  have he' : HurwitzPrymRR_loc hE v y =ᶠ[𝓝[≠] 0] f * HurwitzPrymRR_loc hE η y :=
    he.trans (hef.mul Filter.EventuallyEq.rfl)
  have hval := (hv.continuousAt.eventuallyEq_nhds_iff_eventuallyEq_nhdsNE
    (hf.mul hη).continuousAt).mp he' |>.self_of_nhds
  rw [hr, one_mul] at hf0
  change f 0 = deriv (fun t ↦ RiemannRochEichler_functionLocal hE G y t - (G y).elim 0 id) 0 at hf0
  rw [deriv_sub_const] at hf0
  simpa only [Pi.mul_apply, hf0] using hval


/-- The normalized third-kind family has the fixed-point graph residue. -/
lemma RiemannRochEichler_normalized_graph_fixed_residue
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) {ι : Type} [Fintype ι]
    (a : ι → C) (ha : Function.Injective a) (b : Module.Basis ι ℂ (b3_HolForm E C))
    (hb : ∀ i j, RiemannRochEichler_eval hE (a i) (b j) = if i = j then 1 else 0)
    (q : C) (hq : q ∉ Set.range a)
    (K : C → b4c_MeroForm E C hE)
    (hK : ∀ p, p ∉ Set.range a → p ≠ q →
      b4c_res (hE := hE) (K p) p = -1 ∧ b4c_res (hE := hE) (K p) q = 1 ∧
      (∀ x, (-1 : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (K p) x) 0) ∧
      (∀ x, x ≠ p → x ≠ q → AnalyticAt ℂ (HurwitzPrymRR_loc hE (K p) x) 0) ∧
      ∀ i, K p ⟨a i, b4cov_lineEquiv hE 1⟩ = 0)
    (f : C → C) (hf : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω f) (p : C) (hfp : f p = p)
    (hp : p ∉ Set.range a) (hpq : p ≠ q)
    (hd : deriv (b4cov_transport hE hE (b4cov_expr E E f p p)
      (extChartAt 𝓘(ℂ, E) p p)) 0 ≠ 1) :
    let A := HurwitzPrymRR_loc hE
      (fun t : TangentBundle 𝓘(ℂ, E) C ↦ K t.1
        ⟨f t.1, mfderiv 𝓘(ℂ, E) 𝓘(ℂ, E) f t.1 t.2⟩) p
    let μ := deriv (b4cov_transport hE hE (b4cov_expr E E f p p)
      (extChartAt 𝓘(ℂ, E) p p)) 0
    MeromorphicAt A 0 ∧ residue A 0 = μ / (1 - μ) := by
  classical
  have hnorm : ∀ p, p ∉ Set.range a → p ≠ q →
      b4c_res (hE := hE) (K p) p = -1 ∧ b4c_res (hE := hE) (K p) q = 1 ∧
      (∀ x, (-1 : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (K p) x) 0) ∧
      (∀ x, x ≠ p → x ≠ q → 0 ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (K p) x) 0) ∧
      (∀ i, AnalyticAt ℂ (HurwitzPrymRR_loc hE (K p) (a i)) 0) ∧
      ∀ i, K p ⟨a i, b4cov_lineEquiv hE 1⟩ = 0 := by
    intro p hp hpq
    obtain ⟨h₁, h₂, h₃, h₄, h₅⟩ := hK p hp hpq
    exact ⟨h₁, h₂, h₃, fun x hxp hxq ↦ (h₄ x hxp hxq).meromorphicOrderAt_nonneg,
      fun i ↦ h₄ (a i) (fun h ↦ hp ⟨i, h⟩) (fun h ↦ hq ⟨i, h⟩), h₅⟩
  obtain ⟨G, η, S, N, M, hpS, hAS, _, hGd, hη0, hGo, hGout, hηo, hηout⟩ :=
    RiemannRochEichler_local_kernel_data hE (Set.range a ∪ {q})
      ((Set.finite_range a).union (Set.finite_singleton q)) p (fun h ↦ h.elim hp hpq)
  have hSa : ∀ i, a i ∈ S := fun i ↦ hAS (Or.inl ⟨i, rfl⟩)
  have hSq : q ∈ S := hAS (Or.inr rfl)
  have hFA (y : C) (hy : y ∉ S) : y ∉ Set.range a := by
    rintro ⟨i, rfl⟩
    exact hy (hSa i)
  have hFq (y : C) (hy : y ∉ S) : y ≠ q := fun he ↦ hy (he ▸ hSq)
  obtain ⟨W, hfin, F, hW, hrep, hjoint⟩ :=
    RiemannRochEichler_joint_modified_kernel_family hE a ha b hb q hq K hK
      S hSa hSq G N M hGo hGout η hηo hηout
  apply RiemannRochEichler_graph_fixed_residue hE (fun x ↦ (K x).1) (fun y ↦ (F y).1)
    (fun x ↦ (K x).property.1) (fun y ↦ (hW _ (F y).property).1.1)
    η η.property.1 (fun x ↦ (G x).elim 0 id) ((S : Set C)ᶜ) _ f hf p hfp
    (S.finite_toSet.isClosed.isOpen_compl.mem_nhds hpS) (hηout p hpS) hη0
    (RiemannRochEichler_functionLocal_analytic hE G p (hGout p hpS)) hGd hd
  · exact RiemannRochEichler_modified_representative_diagonal_value hE a ha b hb q p hq
      hp hpq K hnorm G (hGout p hpS) η (hηout p hpS) (F p).1
      ((hW _ (F p).property).2.1 p hpS) (hrep p hpS p)
  · exact hjoint p hpS p hpS
  · intro x hx y hy hxy
    have hv := RiemannRochEichler_modified_representative_value hE a ha b hb q y hq
      (hFA y hy) (hFq y hy) K hnorm x (hFA x hx) (hFq x hx) hxy G (hGout x hx)
      η (hηout x hx) (F y).1 ((hW _ (F y).property).2.1 x hx) (hrep y hy x)
    rw [RiemannRochEichler_residue_germ_value
      ((hK x (hFA x hx) (hFq x hx)).2.2.2.1 y (Ne.symm hxy) (hFq y hy))
      Filter.EventuallyEq.rfl, RiemannRochEichler_loc_zero] at hv
    exact hv


/-- The normalized graph differential has the tangent-rotation residue at fixed points. -/
lemma RiemannRochEichler_normalized_graph_rotation_residue
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) {ι : Type} [Fintype ι]
    (a : ι → C) (ha : Function.Injective a) (b : Module.Basis ι ℂ (b3_HolForm E C))
    (hb : ∀ i j, RiemannRochEichler_eval hE (a i) (b j) = if i = j then 1 else 0)
    (q : C) (hq : q ∉ Set.range a)
    (K : C → b4c_MeroForm E C hE)
    (hK : ∀ p, p ∉ Set.range a → p ≠ q →
      b4c_res (hE := hE) (K p) p = -1 ∧ b4c_res (hE := hE) (K p) q = 1 ∧
      (∀ x, (-1 : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (K p) x) 0) ∧
      (∀ x, x ≠ p → x ≠ q → AnalyticAt ℂ (HurwitzPrymRR_loc hE (K p) x) 0) ∧
      ∀ i, K p ⟨a i, b4cov_lineEquiv hE 1⟩ = 0)
    (s : C ≃ₜ C) (hs : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω s)
    (hne : s ≠ Homeomorph.refl C) (n : ℕ) (hn : 0 < n) (hord : s^[n] = id)
    (p : C) (hsp : s p = p) (hp : p ∉ Set.range a) (hpq : p ≠ q) :
    let A := HurwitzPrymRR_loc hE
      (fun t : TangentBundle 𝓘(ℂ, E) C ↦ K t.1
        ⟨s t.1, mfderiv 𝓘(ℂ, E) 𝓘(ℂ, E) s t.1 t.2⟩) p
    MeromorphicAt A 0 ∧ residue A 0 = b4c_rotation hE s p / (1 - b4c_rotation hE s p) := by
  have hsrc : s ((extChartAt 𝓘(ℂ, E) p).symm (extChartAt 𝓘(ℂ, E) p p)) ∈
      (extChartAt 𝓘(ℂ, E) p).source := by
    rw [extChartAt_to_inv, hsp]
    exact mem_extChartAt_source p
  have hA := b4cov_analyticAt_chart s hs p p _
    (mem_extChartAt_target p) hsrc
  have hD : deriv (b4cov_transport hE hE (b4cov_expr E E s p p)
      (extChartAt 𝓘(ℂ, E) p p)) 0 = b4c_rotation hE s p := by
    rw [b4cov_transport_deriv hE hE 0 (by simpa only [map_zero, add_zero, b4cov_expr]
      using hA.differentiableAt)]
    simp only [map_zero, add_zero]
    simpa only [b4cov_expr, extChartAt_coe, extChartAt_coe_symm,
      modelWithCornersSelf_coe, modelWithCornersSelf_coe_symm, Function.id_comp,
      Function.comp_id] using (b4c_rotation_chart_independent_aux hE s hs p hsp
      (chartAt E p) (chart_mem_atlas E p) (mem_chart_source E p)).symm
  have hDne : deriv (b4cov_transport hE hE (b4cov_expr E E s p p)
      (extChartAt 𝓘(ℂ, E) p p)) 0 ≠ 1 := by
    rw [hD]
    exact RiemannRochTop_rotation_ne_one hE s hs hne n hn hord p hsp
  simpa only [hD] using RiemannRochEichler_normalized_graph_fixed_residue hE a ha b hb q hq
    K hK s hs p hsp hp hpq hDne


/-- A lower bound on parameter coordinates passes to a graph with regular evaluation germs. -/
lemma RiemannRochEichler_graph_order_bound_in_parameter
    {V X : Type*} [AddCommGroup V] [Module ℂ V] [Module.Finite ℂ V]
    (ev : X → Module.Dual ℂ V) (hsep : ∀ v, (∀ z, ev z v = 0) → v = 0)
    (J : V →ₗ[ℂ] (ℂ → ℂ)) (F : ℂ → V) (x : ℂ) (k : WithTop ℤ)
    (hF : ∀ z, MeromorphicAt (fun t ↦ ev z (F t)) x)
    (ho : ∀ z, k ≤ meromorphicOrderAt (fun t ↦ ev z (F t)) x)
    (hJ : ∀ v, MeromorphicAt (J v) x)
    (hJo : ∀ v, 0 ≤ meromorphicOrderAt (J v) x) :
    k ≤ meromorphicOrderAt (fun z ↦ J (F z) z) x := by
  classical
  let P : Module.Dual ℂ V →ₗ[ℂ] (ℂ → ℂ) :=
    { toFun := fun l z ↦ l (F z)
      map_add' := fun _ _ ↦ rfl
      map_smul' := fun _ _ ↦ rfl }
  have hs : Submodule.span ℂ (Set.range ev) = ⊤ := by
    apply Submodule.span_eq_top_of_ne_zero
    intro v hv
    by_contra h
    push Not at h
    exact hv (hsep v (fun z ↦ h (ev z) ⟨z, rfl⟩))
  have hb : ∀ l : Module.Dual ℂ V, MeromorphicAt (P l) x ∧
      k ≤ meromorphicOrderAt (P l) x := by
    intro l
    apply RiemannRochEichler_order_bound_span P (Set.range ev) x k _ l
    · rw [hs]
      exact Submodule.mem_top
    · rintro _ ⟨z, rfl⟩
      exact ⟨hF z, ho z⟩
  let b := Module.finBasis ℂ V
  let Q := fun i z ↦ b.coord i (F z) * J (b i) z
  have hQ i : MeromorphicAt (Q i) x ∧ k ≤ meromorphicOrderAt (Q i) x := by
    refine ⟨(hb (b.coord i)).1.mul (hJ (b i)), ?_⟩
    change k ≤ meromorphicOrderAt (P (b.coord i) * J (b i)) x
    rw [meromorphicOrderAt_mul (hb (b.coord i)).1 (hJ (b i))]
    simpa only [add_zero] using add_le_add (hb (b.coord i)).2 (hJo (b i))
  have he : (fun z ↦ J (F z) z) = ∑ i, Q i := by
    funext z
    have h := congrArg (fun v : V ↦ J v z) (b.sum_repr (F z))
    simpa only [Q, map_sum, map_smul, Finset.sum_apply, Pi.smul_apply, smul_eq_mul,
      Module.Basis.coord_apply] using h.symm
  rw [he]
  have hsum : ∑ i, Q i ∈ Submodule.span ℂ (Set.range Q) :=
    Submodule.sum_mem _ (fun i hi ↦ Submodule.subset_span ⟨i, rfl⟩)
  exact (RiemannRochEichler_order_bound_span (LinearMap.id : (ℂ → ℂ) →ₗ[ℂ] (ℂ → ℂ))
    (Set.range Q) x k (by rintro _ ⟨i, rfl⟩; exact hQ i) _ hsum).2


/-- When the parameter coordinates have simple poles, graph residues are obtained by freezing the analytic variable. -/
lemma RiemannRochEichler_graph_residue_in_parameter
    {V X : Type*} [AddCommGroup V] [Module ℂ V] [Module.Finite ℂ V]
    (ev : X → Module.Dual ℂ V) (hsep : ∀ v, (∀ z, ev z v = 0) → v = 0)
    (J : V →ₗ[ℂ] (ℂ → ℂ)) (F : ℂ → V) (x : ℂ)
    (hF : ∀ z, MeromorphicAt (fun t ↦ ev z (F t)) x)
    (ho : ∀ z, (-1 : WithTop ℤ) ≤ meromorphicOrderAt (fun t ↦ ev z (F t)) x)
    (hJ : ∀ v, AnalyticAt ℂ (J v) x) :
    MeromorphicAt (fun z ↦ J (F z) z) x ∧
      residue (fun z ↦ J (F z) z) x = residue (fun z ↦ J (F z) x) x := by
  classical
  let P : Module.Dual ℂ V →ₗ[ℂ] (ℂ → ℂ) :=
    { toFun := fun l z ↦ l (F z)
      map_add' := fun _ _ ↦ rfl
      map_smul' := fun _ _ ↦ rfl }
  have hs : Submodule.span ℂ (Set.range ev) = ⊤ := by
    apply Submodule.span_eq_top_of_ne_zero
    intro v hv
    by_contra h
    push Not at h
    exact hv (hsep v (fun z ↦ h (ev z) ⟨z, rfl⟩))
  have hb : ∀ l : Module.Dual ℂ V, MeromorphicAt (P l) x ∧
      (-1 : WithTop ℤ) ≤ meromorphicOrderAt (P l) x := by
    intro l
    apply RiemannRochEichler_order_bound_span P (Set.range ev) x (-1) _ l
    · rw [hs]
      exact Submodule.mem_top
    · rintro _ ⟨z, rfl⟩
      exact ⟨hF z, ho z⟩
  let b := Module.finBasis ℂ V
  let Q := fun i z ↦ b.coord i (F z) * J (b i) z
  let Q₀ := fun i z ↦ b.coord i (F z) * J (b i) x
  have hQ i : MeromorphicAt (Q i) x := (hb (b.coord i)).1.mul (hJ (b i)).meromorphicAt
  have hQ₀ i : MeromorphicAt (Q₀ i) x := (hb (b.coord i)).1.mul (MeromorphicAt.const _ _)
  have he (z y : ℂ) : J (F z) y = ∑ i, b.coord i (F z) * J (b i) y := by
    have h := congrArg (fun v : V ↦ J v y) (b.sum_repr (F z))
    simpa only [map_sum, map_smul, Finset.sum_apply, Pi.smul_apply, smul_eq_mul,
      Module.Basis.coord_apply] using h.symm
  have hr i : residue (Q i) x = residue (Q₀ i) x := by
    have h₁ := RiemannRochEichler_residue_mul_analytic (hb (b.coord i)).1
      (hb (b.coord i)).2 (hJ (b i))
    have h₂ := RiemannRochEichler_residue_mul_analytic (hb (b.coord i)).1
      (hb (b.coord i)).2 (analyticAt_const (v := J (b i) x))
    exact h₁.trans h₂.symm
  refine ⟨RiemannRochEichler_finite_family_graph_meromorphic ev hsep J F x hF
    (fun v ↦ (hJ v).meromorphicAt), ?_⟩
  have h₁ : (fun z ↦ J (F z) z) = ∑ i, Q i := by
    funext z
    simpa only [Finset.sum_apply, Q] using he z z
  have h₂ : (fun z ↦ J (F z) x) = ∑ i, Q₀ i := by
    funext z
    simpa only [Finset.sum_apply, Q₀] using he z x
  rw [h₁, h₂, residue_sum Finset.univ (fun i hi ↦ hQ i),
    residue_sum Finset.univ (fun i hi ↦ hQ₀ i)]
  exact Finset.sum_congr rfl (fun i hi ↦ hr i)


/-- Simple evaluation poles determine modified graph residues by freezing the regular parameter variable. -/
lemma RiemannRochEichler_modified_graph_evaluation_residue [T1Space C]
    (hE : Module.finrank ℂ E = 1) (S : Set C) (hS : S.Finite)
    (W : Submodule ℂ (TangentBundle 𝓘(ℂ, E) C → ℂ)) [Module.Finite ℂ W]
    (hw : ∀ w : W, HurwitzPrymRR_IsLinear w.1)
    (ha : ∀ w : W, ∀ p ∉ S, AnalyticAt ℂ (HurwitzPrymRR_loc hE w.1 p) 0)
    (hz : ∀ w : W, ∀ p ∈ S, ∀ u, w.1 ⟨p, u⟩ = 0)
    (K : C → b4c_MeroForm E C hE) (G : b4c_MeroFun E C) (β : C → ℂ)
    (F : C → W)
    (hF : ∀ y ∉ S, ∀ r ∉ S, r ≠ y →
      (F y).1 ⟨r, b4cov_lineEquiv hE 1⟩ = HurwitzPrymRR_loc hE (K r) y 0 *
        ((G r).elim 0 id - (G y).elim 0 id) * β r)
    (e p : C) (hp : p ∉ S) (hG : G e ≠ OnePoint.infty)
    (hK : ∀ r ∉ S, r ≠ e → (-1 : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (K r) e) 0)
    (T : ℂ → ℂ) (hT : AnalyticAt ℂ T 0) (hT0 : T 0 = 0) (hTd : deriv T 0 ≠ 0) :
    let j := fun t ↦ (extChartAt 𝓘(ℂ, E) e).symm
      (extChartAt 𝓘(ℂ, E) e e + b4cov_lineEquiv hE t)
    let d := fun t ↦ deriv (b4cov_transport hE hE
      (b4cov_expr E E (id : C → C) (j t) e) (extChartAt 𝓘(ℂ, E) (j t) (j t))) 0
    (-1 : WithTop ℤ) ≤ meromorphicOrderAt
      (fun z ↦ HurwitzPrymRR_loc hE ((d (T z))⁻¹ • (F (j (T z))).1) p z) 0 ∧
    residue (fun z ↦ HurwitzPrymRR_loc hE ((d (T z))⁻¹ • (F (j (T z))).1) p z) 0 =
      residue (fun z ↦ HurwitzPrymRR_loc hE ((d (T z))⁻¹ • (F (j (T z))).1) p 0) 0 := by
  let j := fun t ↦ (extChartAt 𝓘(ℂ, E) e).symm
    (extChartAt 𝓘(ℂ, E) e e + b4cov_lineEquiv hE t)
  let d := fun t ↦ deriv (b4cov_transport hE hE
    (b4cov_expr E E (id : C → C) (j t) e) (extChartAt 𝓘(ℂ, E) (j t) (j t))) 0
  let A : ℂ → W := fun z ↦ (d (T z))⁻¹ • F (j (T z))
  let ev : {r : C // r ∉ S ∪ {e}} → Module.Dual ℂ W :=
    fun r ↦ (LinearMap.proj ⟨r.1, b4cov_lineEquiv hE 1⟩).comp W.subtype
  have hsep : ∀ w : W, (∀ r, ev r w = 0) → w = 0 := by
    intro w he
    apply Subtype.ext
    apply RiemannRochEichler_evaluations_separate_off_finite hE w.1 (hw w) S {e} hS
      (Set.finite_singleton e) (ha w) (hz w)
    intro r hr
    exact he ⟨r, hr⟩
  let J : W →ₗ[ℂ] (ℂ → ℂ) :=
    { toFun := fun w ↦ HurwitzPrymRR_loc hE w.1 p
      map_add' := fun _ _ ↦ rfl
      map_smul' := fun _ _ ↦ rfl }
  have hcoords (r : {r : C // r ∉ S ∪ {e}}) :
      MeromorphicAt (fun z ↦ ev r (A z)) 0 ∧
      (-1 : WithTop ℤ) ≤ meromorphicOrderAt (fun z ↦ ev r (A z)) 0 := by
    have hrS : r.1 ∉ S := fun h ↦ r.2 (Or.inl h)
    have hre : r.1 ≠ e := fun h ↦ r.2 (Or.inr h)
    let B := fun t ↦ (d t)⁻¹ * (F (j t)).1 ⟨r.1, b4cov_lineEquiv hE 1⟩
    have hm : MeromorphicAt B 0 := RiemannRochEichler_chart_scaled_evaluation_meromorphic
      hE S hS K G β (fun y ↦ (F y).1) hF e r.1 hrS
    have he := RiemannRochEichler_chart_scaled_evaluation_germ
      hE S hS K G β (fun y ↦ (F y).1) hF e r.1 hrS
    let U := fun t ↦ ((G r.1).elim 0 id - RiemannRochEichler_functionLocal hE G e t) * β r.1
    have hU : AnalyticAt ℂ U 0 :=
      (analyticAt_const.sub (RiemannRochEichler_functionLocal_analytic hE G e hG)).mul analyticAt_const
    have he' : B =ᶠ[𝓝[≠] 0] HurwitzPrymRR_loc hE (K r.1) e * U := by
      filter_upwards [he] with t ht
      exact ht.trans (mul_assoc _ _ _)
    have ho : (-1 : WithTop ℤ) ≤ meromorphicOrderAt B 0 := by
      rw [meromorphicOrderAt_congr he', meromorphicOrderAt_mul ((K r.1).property.2 e) hU.meromorphicAt]
      simpa only [add_zero] using add_le_add (hK r.1 hrS hre) hU.meromorphicOrderAt_nonneg
    have hmT : MeromorphicAt B (T 0) := hT0.symm ▸ hm
    refine ⟨hmT.comp_analyticAt hT, ?_⟩
    change (-1 : WithTop ℤ) ≤ meromorphicOrderAt (B ∘ T) 0
    rw [meromorphicOrderAt_comp_of_deriv_ne_zero hT hTd, hT0]
    exact ho
  exact ⟨RiemannRochEichler_graph_order_bound_in_parameter ev hsep J A 0 (-1)
    (fun r ↦ (hcoords r).1) (fun r ↦ (hcoords r).2)
    (fun w ↦ (ha w p hp).meromorphicAt) (fun w ↦ (ha w p hp).meromorphicOrderAt_nonneg),
    (RiemannRochEichler_graph_residue_in_parameter ev hsep J A 0
      (fun r ↦ (hcoords r).1) (fun r ↦ (hcoords r).2) (fun w ↦ ha w p hp)).2⟩


/-- Pullback by a regular analytic coordinate preserves the residue of a simple meromorphic pole. -/
lemma RiemannRochEichler_simple_pole_pullback
    {f T : ℂ → ℂ} (hf : MeromorphicAt f 0)
    (ho : (-1 : WithTop ℤ) ≤ meromorphicOrderAt f 0)
    (hT : AnalyticAt ℂ T 0) (hT0 : T 0 = 0) (hd : deriv T 0 ≠ 0) :
    residue (fun z ↦ f (T z) * deriv T z) 0 = residue f 0 := by
  obtain ⟨g, hg, he, hg0⟩ := RiemannRochEichler_cancel_simple_pole hf ho analyticAt_id rfl
  have hnc : ¬ EventuallyConst T (𝓝 0) := by
    intro hc
    obtain ⟨c, hc⟩ := hc.eventuallyEq_const
    exact hd (hc.deriv_eq.trans (deriv_const _ _))
  have ht : Tendsto T (𝓝[≠] 0) (𝓝[≠] 0) := by
    have h := hT.map_nhdsNE hnc
    rw [hT0] at h
    exact h
  have heT := he.comp_tendsto ht
  have hne : ∀ᶠ z in 𝓝[≠] (0 : ℂ), T z ≠ 0 := ht self_mem_nhdsWithin
  have hquot : (fun z ↦ f (T z) * deriv T z) =ᶠ[𝓝[≠] (0 : ℂ)]
      (fun z ↦ (g (T z) * deriv T z) / T z) := by
    filter_upwards [heT, hne] with z hz hnez
    change f (T z) * T z = g (T z) at hz
    rw [← hz]
    field_simp
  have hgT : AnalyticAt ℂ (fun z ↦ g (T z) * deriv T z) 0 :=
    ((hT0.symm ▸ hg).comp hT).mul hT.deriv
  rw [residue_congr_nhdsNE hquot,
    residue_div_of_zero_deriv_ne_zero hgT hT hT0 hd, hT0, hg0]
  simp only [deriv_id, mul_one, mul_div_cancel_right₀ _ hd]


/-- An evaluation pole contributes its differential residue to an off-diagonal graph. -/
lemma RiemannRochEichler_graph_evaluation_residue
    [T1Space C] (hE : Module.finrank ℂ E = 1) (S : Set C) (hS : S.Finite)
    (W : Submodule ℂ (TangentBundle 𝓘(ℂ, E) C → ℂ)) [Module.Finite ℂ W]
    (hw : ∀ w : W, b4c_IsMeroForm hE w.1)
    (ha : ∀ w : W, ∀ p ∉ S, AnalyticAt ℂ (HurwitzPrymRR_loc hE w.1 p) 0)
    (hz : ∀ w : W, ∀ p ∈ S, ∀ u, w.1 ⟨p, u⟩ = 0)
    (K : C → b4c_MeroForm E C hE) (G : b4c_MeroFun E C)
    (η : b4c_MeroForm E C hE) (F : C → W)
    (hF : ∀ y ∉ S, ∀ r ∉ S, r ≠ y →
      (F y).1 ⟨r, b4cov_lineEquiv hE 1⟩ = HurwitzPrymRR_loc hE (K r) y 0 *
        ((G r).elim 0 id - (G y).elim 0 id) * η ⟨r, b4cov_lineEquiv hE 1⟩)
    (f : C → C) (hf : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω f) (hfi : Function.Injective f)
    (p : C) (hp : p ∉ S)
    (hηa : AnalyticAt ℂ (HurwitzPrymRR_loc hE η p) 0)
    (hη0 : HurwitzPrymRR_loc hE η p 0 ≠ 0)
    (hGp : G p ≠ OnePoint.infty) (hGe : G (f p) ≠ OnePoint.infty)
    (hsep : (G p).elim 0 id ≠ (G (f p)).elim 0 id)
    (hK : ∀ r ∉ S, r ≠ f p → (-1 : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (K r) (f p)) 0) :
    residue (HurwitzPrymRR_loc hE
      (fun t : TangentBundle 𝓘(ℂ, E) C ↦ K t.1
        ⟨f t.1, mfderiv 𝓘(ℂ, E) 𝓘(ℂ, E) f t.1 t.2⟩) p) 0 =
      residue (HurwitzPrymRR_loc hE (K p) (f p)) 0 := by
  let k := fun z ↦ (extChartAt 𝓘(ℂ, E) p).symm
    (extChartAt 𝓘(ℂ, E) p p + b4cov_lineEquiv hE z)
  let j := fun z ↦ (extChartAt 𝓘(ℂ, E) (f p)).symm
    (extChartAt 𝓘(ℂ, E) (f p) (f p) + b4cov_lineEquiv hE z)
  let T := b4cov_transport hE hE (b4cov_expr E E f p (f p)) (extChartAt 𝓘(ℂ, E) p p)
  let d := fun t ↦ deriv (b4cov_transport hE hE
    (b4cov_expr E E (id : C → C) (j t) (f p)) (extChartAt 𝓘(ℂ, E) (j t) (j t))) 0
  let N := fun z ↦ HurwitzPrymRR_loc hE ((d (T z))⁻¹ • (F (j (T z))).1) p z * deriv T z
  let D := fun z ↦ HurwitzPrymRR_loc hE η p z *
    ((G (k z)).elim 0 id - (G (f (k z))).elim 0 id)
  have hTa : AnalyticAt ℂ T 0 := by
    apply b4cov_transport_analyticAt
    apply b4cov_analyticAt_chart f hf p (f p) _ (mem_extChartAt_target p)
    rw [extChartAt_to_inv]
    exact mem_extChartAt_source (f p)
  have hT0 : T 0 = 0 := b4cov_transport_zero _ _ _ _
  have hN : MeromorphicAt N 0 :=
    (RiemannRochEichler_modified_graph_meromorphic hE S hS W hw ha hz K G
      (fun r ↦ η ⟨r, b4cov_lineEquiv hE 1⟩) F hF (f p) p T hTa hT0).mul hTa.deriv.meromorphicAt
  have hTd : deriv T 0 ≠ 0 := RiemannRochEichler_graph_coordinate_derivative hE f hf hfi p
  have hnc : ¬ EventuallyConst T (𝓝 0) := by
    intro hc
    obtain ⟨c, hc⟩ := hc.eventuallyEq_const
    exact hTd (hc.deriv_eq.trans (deriv_const _ _))
  have ht : Tendsto T (𝓝[≠] 0) (𝓝[≠] 0) := by
    have h := hTa.map_nhdsNE hnc
    rw [hT0] at h
    exact h
  have hB := RiemannRochEichler_modified_graph_evaluation_residue hE S hS W
    (fun w ↦ (hw w).1) ha hz K G (fun r ↦ η ⟨r, b4cov_lineEquiv hE 1⟩)
    F hF (f p) p hp hGe hK T hTa hT0 hTd
  have hpe : p ≠ f p := fun h ↦ hsep (congrArg (fun x ↦ (G x).elim 0 id) h)
  let R := fun t ↦ HurwitzPrymRR_loc hE (K p) (f p) t *
    (((G p).elim 0 id - RiemannRochEichler_functionLocal hE G (f p) t) *
      η ⟨p, b4cov_lineEquiv hE 1⟩)
  let U := fun t ↦ ((G p).elim 0 id - RiemannRochEichler_functionLocal hE G (f p) t) *
    η ⟨p, b4cov_lineEquiv hE 1⟩
  have hU : AnalyticAt ℂ U 0 :=
    (analyticAt_const.sub (RiemannRochEichler_functionLocal_analytic hE G (f p) hGe)).mul analyticAt_const
  have hR : MeromorphicAt R 0 := ((K p).property.2 (f p)).mul hU.meromorphicAt
  have hRo : (-1 : WithTop ℤ) ≤ meromorphicOrderAt R 0 := by
    change (-1 : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (K p) (f p) * U) 0
    rw [meromorphicOrderAt_mul ((K p).property.2 (f p)) hU.meromorphicAt]
    simpa only [add_zero] using add_le_add (hK p hp hpe) hU.meromorphicOrderAt_nonneg
  have hRT : MeromorphicAt (R ∘ T) 0 := (hT0.symm ▸ hR).comp_analyticAt hTa
  have hRTo : (-1 : WithTop ℤ) ≤ meromorphicOrderAt (R ∘ T) 0 := by
    rw [meromorphicOrderAt_comp_of_deriv_ne_zero hTa hTd, hT0]
    exact hRo
  have heval : (fun z ↦ HurwitzPrymRR_loc hE ((d (T z))⁻¹ • (F (j (T z))).1) p 0)
      =ᶠ[𝓝[≠] 0] R ∘ T := by
    have he := RiemannRochEichler_chart_scaled_evaluation_germ hE S hS K G
      (fun r ↦ η ⟨r, b4cov_lineEquiv hE 1⟩) (fun y ↦ (F y).1) hF (f p) p hp
    filter_upwards [ht he] with z hz
    rw [RiemannRochEichler_loc_zero]
    exact hz.trans (mul_assoc _ _ _)
  have hNo : (-1 : WithTop ℤ) ≤ meromorphicOrderAt N 0 := by
    rw [show N = (fun z ↦ HurwitzPrymRR_loc hE ((d (T z))⁻¹ • (F (j (T z))).1) p z) * deriv T from rfl,
      meromorphicOrderAt_mul
        (RiemannRochEichler_modified_graph_meromorphic hE S hS W hw ha hz K G
          (fun r ↦ η ⟨r, b4cov_lineEquiv hE 1⟩) F hF (f p) p T hTa hT0)
        hTa.deriv.meromorphicAt]
    simpa only [add_zero] using add_le_add hB.1 hTa.deriv.meromorphicOrderAt_nonneg
  have hNr : residue N 0 = residue R 0 := by
    change residue ((fun z ↦ HurwitzPrymRR_loc hE ((d (T z))⁻¹ • (F (j (T z))).1) p z) * deriv T) 0 = _
    rw [RiemannRochEichler_residue_mul_analytic
      (RiemannRochEichler_modified_graph_meromorphic hE S hS W hw ha hz K G
        (fun r ↦ η ⟨r, b4cov_lineEquiv hE 1⟩) F hF (f p) p T hTa hT0) hB.1 hTa.deriv,
      hB.2, residue_congr_nhdsNE heval]
    have hr := RiemannRochEichler_residue_mul_analytic hRT hRTo hTa.deriv
    have hpull := RiemannRochEichler_simple_pole_pullback hR hRo hTa hT0 hTd
    exact hr.symm.trans hpull
  have hGa : AnalyticAt ℂ (fun z ↦ (G (k z)).elim 0 id - (G (f (k z))).elim 0 id) 0 :=
    (RiemannRochEichler_functionLocal_analytic hE G p hGp).sub
      (RiemannRochEichler_scalar_pullback_analytic hE (fun x ↦ (G x).elim 0 id) f hf p
        (RiemannRochEichler_functionLocal_analytic hE G (f p) hGe))
  have hk0 : k 0 = p := by simp [k, extChartAt_to_inv]
  have hG0 : (G (k 0)).elim 0 id - (G (f (k 0))).elim 0 id ≠ 0 := by
    rw [hk0]
    exact sub_ne_zero.mpr hsep
  have hG : ∀ᶠ z in 𝓝[≠] (0 : ℂ), (G (k z)).elim 0 id ≠ (G (f (k z))).elim 0 id :=
    (hGa.continuousAt.eventually_ne hG0).filter_mono nhdsWithin_le_nhds |>.mono
      (fun z hz ↦ sub_ne_zero.mp hz)
  have hη : ∀ᶠ z in 𝓝[≠] (0 : ℂ), HurwitzPrymRR_loc hE η p z ≠ 0 :=
    (hηa.continuousAt.eventually_ne hη0).filter_mono nhdsWithin_le_nhds
  have hD : AnalyticAt ℂ D 0 := hηa.mul hGa
  have hD0 : D 0 ≠ 0 := mul_ne_zero hη0 hG0
  have hDo : meromorphicOrderAt D 0 = 0 := by
    rw [hD.meromorphicOrderAt_eq, hD.analyticOrderAt_eq_zero.mpr hD0]
    rfl
  have hpoints : ∀ᶠ z in 𝓝[≠] (0 : ℂ), k z ∈ Sᶜ ∧ f (k z) ∈ Sᶜ ∧ k z ≠ f (k z) := by
    filter_upwards [RiemannRochEichler_coordinate_avoid_finite hE (S ∪ f ⁻¹' S)
      (hS.union (Set.Finite.preimage hfi.injOn hS)) p, hG] with z hz hg
    refine ⟨fun h ↦ hz (Or.inl h), fun h ↦ hz (Or.inr h), ?_⟩
    exact fun h ↦ hg (congrArg (fun x ↦ (G x).elim 0 id) h)
  have he := RiemannRochEichler_graph_modified_product_charts hE (fun x ↦ (K x).1)
    (fun y ↦ (F y).1) (fun x ↦ (K x).property.1) (fun y ↦ (hw (F y)).1)
    η η.property.1 (fun x ↦ (G x).elim 0 id) Sᶜ
    (fun x hx y hy hxy ↦ by simpa only [RiemannRochEichler_loc_zero] using hF y hy x hx hxy)
    f hf p (f p) rfl hpoints
  have hc := RiemannRochEichler_graph_coordinates hE f hf p (f p) rfl
  suffices heq : N / D =ᶠ[𝓝[≠] (0 : ℂ)] HurwitzPrymRR_loc hE
      (fun t : TangentBundle 𝓘(ℂ, E) C ↦ K t.1
        ⟨f t.1, mfderiv 𝓘(ℂ, E) 𝓘(ℂ, E) f t.1 t.2⟩) p by
    rw [← residue_congr_nhdsNE heq]
    have hr := RiemannRochEichler_residue_mul_analytic hN hNo (hD.inv hD0)
    change residue (fun z ↦ N z * (D z)⁻¹) 0 = residue N 0 * (D 0)⁻¹ at hr
    change residue (fun z ↦ N z * (D z)⁻¹) 0 = _
    rw [hr, hNr]
    have hRres : residue R 0 = residue (HurwitzPrymRR_loc hE (K p) (f p)) 0 * U 0 :=
      RiemannRochEichler_residue_mul_analytic ((K p).property.2 (f p)) (hK p hp hpe) hU
    rw [hRres]
    have hU0 : U 0 = D 0 := by
      dsimp only [U, D, RiemannRochEichler_functionLocal]
      rw [hk0]
      simp only [map_zero, add_zero, extChartAt_to_inv, RiemannRochEichler_loc_zero]
      ring
    rw [hU0, mul_assoc, mul_inv_cancel₀ hD0, mul_one]
  filter_upwards [he, nhdsWithin_le_nhds hc, hη, hG] with z he hc hη hg
  have hdn : D z ≠ 0 := mul_ne_zero hη (sub_ne_zero.mpr hg)
  change N z / D z = _
  change N z = _ at he
  change j (T z) = f (k z) at hc
  change N z = HurwitzPrymRR_loc hE
    (fun t : TangentBundle 𝓘(ℂ, E) C ↦ K t.1
      ⟨f t.1, mfderiv 𝓘(ℂ, E) 𝓘(ℂ, E) f t.1 t.2⟩) p z *
    (HurwitzPrymRR_loc hE η p z * ((G (k z)).elim 0 id - (G (j (T z))).elim 0 id)) at he
  rw [hc] at he
  change N z = _ * D z at he
  rw [he, mul_div_cancel_right₀ _ hdn]


/-- The normalized graph differential has residue one over the reference point. -/
lemma RiemannRochEichler_normalized_graph_reference_residue
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) {ι : Type} [Fintype ι]
    (a : ι → C) (ha : Function.Injective a) (b : Module.Basis ι ℂ (b3_HolForm E C))
    (hb : ∀ i j, RiemannRochEichler_eval hE (a i) (b j) = if i = j then 1 else 0)
    (q : C) (hq : q ∉ Set.range a)
    (K : C → b4c_MeroForm E C hE)
    (hK : ∀ p, p ∉ Set.range a → p ≠ q →
      b4c_res (hE := hE) (K p) p = -1 ∧ b4c_res (hE := hE) (K p) q = 1 ∧
      (∀ x, (-1 : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (K p) x) 0) ∧
      (∀ x, x ≠ p → x ≠ q → AnalyticAt ℂ (HurwitzPrymRR_loc hE (K p) x) 0) ∧
      ∀ i, K p ⟨a i, b4cov_lineEquiv hE 1⟩ = 0)
    (f : C ≃ₜ C) (hf : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω f)
    (p : C) (hp : p ∉ Set.range a) (hpq : p ≠ q)
    (hfq : f p = q) :
    residue (HurwitzPrymRR_loc hE
      (fun t : TangentBundle 𝓘(ℂ, E) C ↦ K t.1
        ⟨f t.1, mfderiv 𝓘(ℂ, E) 𝓘(ℂ, E) f t.1 t.2⟩) p) 0 = 1 := by
  classical
  have hfp : f p ≠ p := fun h ↦ hpq (h.symm.trans hfq)
  have hnorm : ∀ p, p ∉ Set.range a → p ≠ q →
      b4c_res (hE := hE) (K p) p = -1 ∧ b4c_res (hE := hE) (K p) q = 1 ∧
      (∀ x, (-1 : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (K p) x) 0) ∧
      (∀ x, x ≠ p → x ≠ q → 0 ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (K p) x) 0) ∧
      (∀ i, AnalyticAt ℂ (HurwitzPrymRR_loc hE (K p) (a i)) 0) ∧
      ∀ i, K p ⟨a i, b4cov_lineEquiv hE 1⟩ = 0 := by
    intro p hp hpq
    obtain ⟨h₁, h₂, h₃, h₄, h₅⟩ := hK p hp hpq
    exact ⟨h₁, h₂, h₃, fun x hxp hxq ↦ (h₄ x hxp hxq).meromorphicOrderAt_nonneg,
      fun i ↦ h₄ (a i) (fun h ↦ hp ⟨i, h⟩) (fun h ↦ hq ⟨i, h⟩), h₅⟩
  obtain ⟨G, η, S, N, M, hAS, hGp, hGe, hηa, hη0, hpS, hGo, hGout, hηo, hηout⟩ :=
    RiemannRochEichler_off_diagonal_kernel_data hE (Set.range a ∪ {q})
      ((Set.finite_range a).union (Set.finite_singleton q)) p (f p) hfp.symm
  have hSa : ∀ i, a i ∈ S := fun i ↦ hAS (Or.inl ⟨i, rfl⟩)
  have hSq : q ∈ S := hAS (Or.inr rfl)
  have hpout : p ∉ S := hpS (fun h ↦ h.elim hp hpq)
  have hFA (y : C) (hy : y ∉ S) : y ∉ Set.range a := by
    rintro ⟨i, rfl⟩
    exact hy (hSa i)
  have hFq (y : C) (hy : y ∉ S) : y ≠ q := fun he ↦ hy (he ▸ hSq)
  obtain ⟨W, hfin, F, hW, hrep, _⟩ :=
    RiemannRochEichler_joint_modified_kernel_family hE a ha b hb q hq K hK
      S hSa hSq G N M hGo hGout η hηo hηout
  letI : Module.Finite ℂ W := hfin
  have hF : ∀ y ∉ S, ∀ r ∉ S, r ≠ y →
      (F y).1 ⟨r, b4cov_lineEquiv hE 1⟩ = HurwitzPrymRR_loc hE (K r) y 0 *
        ((G r).elim 0 id - (G y).elim 0 id) * η ⟨r, b4cov_lineEquiv hE 1⟩ := by
    intro y hy r hr hry
    have hv := RiemannRochEichler_modified_representative_value hE a ha b hb q y hq
      (hFA y hy) (hFq y hy) K hnorm r (hFA r hr) (hFq r hr) hry G (hGout r hr)
      η (hηout r hr) (F y).1 ((hW _ (F y).property).2.1 r hr) (hrep y hy r)
    rw [RiemannRochEichler_residue_germ_value
      ((hK r (hFA r hr) (hFq r hr)).2.2.2.1 y (Ne.symm hry) (hFq y hy))
      Filter.EventuallyEq.rfl] at hv
    exact hv
  have hr := RiemannRochEichler_graph_evaluation_residue hE (S : Set C) S.finite_toSet W
    (fun w ↦ (hW w.1 w.property).1) (fun w ↦ (hW w.1 w.property).2.1)
    (fun w ↦ (hW w.1 w.property).2.2) K G η F hF f hf f.injective p hpout hηa hη0
    (by rw [hGp]; exact OnePoint.coe_ne_infty _) (by rw [hGe]; exact OnePoint.coe_ne_infty _)
    (by rw [hGp, hGe]; exact zero_ne_one)
    (fun r hr hre ↦ (hK r (hFA r hr) (hFq r hr)).2.2.1 (f p))
  rw [hr, hfq]
  exact (hK p hp hpq).2.1


/-- Regularity on the family image suffices for a modified graph numerator without a pole. -/
lemma RiemannRochEichler_modified_graph_nonneg_of_image [T1Space C]
    (hE : Module.finrank ℂ E = 1) (S : Set C) (hS : S.Finite)
    (W : Submodule ℂ (TangentBundle 𝓘(ℂ, E) C → ℂ)) [Module.Finite ℂ W]
    (hw : ∀ w : W, b4c_IsMeroForm hE w.1)
    (ha : ∀ w : W, ∀ p ∉ S, AnalyticAt ℂ (HurwitzPrymRR_loc hE w.1 p) 0)
    (hz : ∀ w : W, ∀ p ∈ S, ∀ u, w.1 ⟨p, u⟩ = 0)
    (K : C → b4c_MeroForm E C hE) (G : b4c_MeroFun E C) (β : C → ℂ)
    (F : C → W)
    (hF : ∀ y ∉ S, ∀ r ∉ S, r ≠ y →
      (F y).1 ⟨r, b4cov_lineEquiv hE 1⟩ = HurwitzPrymRR_loc hE (K r) y 0 *
        ((G r).elim 0 id - (G y).elim 0 id) * β r)
    (e p : C) (himage : ∀ y, 0 ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (F y).1 p) 0) (hG : G e ≠ OnePoint.infty)
    (hK : ∀ r ∉ S, r ≠ e → AnalyticAt ℂ (HurwitzPrymRR_loc hE (K r) e) 0)
    (T : ℂ → ℂ) (hT : AnalyticAt ℂ T 0) (hT0 : T 0 = 0) :
    let j := fun t ↦ (extChartAt 𝓘(ℂ, E) e).symm
      (extChartAt 𝓘(ℂ, E) e e + b4cov_lineEquiv hE t)
    let d := fun t ↦ deriv (b4cov_transport hE hE
      (b4cov_expr E E (id : C → C) (j t) e) (extChartAt 𝓘(ℂ, E) (j t) (j t))) 0
    0 ≤ meromorphicOrderAt
      (fun z ↦ HurwitzPrymRR_loc hE ((d (T z))⁻¹ • (F (j (T z))).1) p z) 0 := by
  let j := fun t ↦ (extChartAt 𝓘(ℂ, E) e).symm
    (extChartAt 𝓘(ℂ, E) e e + b4cov_lineEquiv hE t)
  let d := fun t ↦ deriv (b4cov_transport hE hE
    (b4cov_expr E E (id : C → C) (j t) e) (extChartAt 𝓘(ℂ, E) (j t) (j t))) 0
  let A : ℂ → W := fun z ↦ (d (T z))⁻¹ • F (j (T z))
  let ev : {r : C // r ∉ S ∪ {e}} → Module.Dual ℂ W :=
    fun r ↦ (LinearMap.proj ⟨r.1, b4cov_lineEquiv hE 1⟩).comp W.subtype
  have hsep : ∀ w : W, (∀ r, ev r w = 0) → w = 0 := by
    intro w he
    apply Subtype.ext
    apply RiemannRochEichler_evaluations_separate_off_finite hE w.1 (hw w).1 S {e} hS
      (Set.finite_singleton e) (ha w) (hz w)
    intro r hr
    exact he ⟨r, hr⟩
  let J : W →ₗ[ℂ] (ℂ → ℂ) :=
    { toFun := fun w ↦ HurwitzPrymRR_loc hE w.1 p
      map_add' := fun _ _ ↦ rfl
      map_smul' := fun _ _ ↦ rfl }
  have hcoords (r : {r : C // r ∉ S ∪ {e}}) :
      MeromorphicAt (fun z ↦ ev r (A z)) 0 ∧
      0 ≤ meromorphicOrderAt (fun z ↦ ev r (A z)) 0 := by
    have hrS : r.1 ∉ S := fun h ↦ r.2 (Or.inl h)
    have hre : r.1 ≠ e := fun h ↦ r.2 (Or.inr h)
    let B := fun t ↦ (d t)⁻¹ * (F (j t)).1 ⟨r.1, b4cov_lineEquiv hE 1⟩
    have hm : MeromorphicAt B 0 := RiemannRochEichler_chart_scaled_evaluation_meromorphic
      hE S hS K G β (fun y ↦ (F y).1) hF e r.1 hrS
    have he := RiemannRochEichler_chart_scaled_evaluation_germ
      hE S hS K G β (fun y ↦ (F y).1) hF e r.1 hrS
    have hreg : AnalyticAt ℂ (fun t ↦ HurwitzPrymRR_loc hE (K r.1) e t *
        ((G r.1).elim 0 id - RiemannRochEichler_functionLocal hE G e t) * β r.1) 0 :=
      ((hK r.1 hrS hre).mul (analyticAt_const.sub
        (RiemannRochEichler_functionLocal_analytic hE G e hG))).mul analyticAt_const
    have ho : 0 ≤ meromorphicOrderAt B 0 := by
      rw [meromorphicOrderAt_congr he]
      exact hreg.meromorphicOrderAt_nonneg
    have hmT : MeromorphicAt B (T 0) := hT0.symm ▸ hm
    have hoT : 0 ≤ meromorphicOrderAt B (T 0) := hT0.symm ▸ ho
    exact ⟨hmT.comp_analyticAt hT, RiemannRochEichler_nonneg_order_comp hmT hT hoT⟩
  apply RiemannRochEichler_graph_order_bound_of_image ev hsep J A 0 0
    (fun r ↦ (hcoords r).1) (fun r ↦ (hcoords r).2)
    (fun z ↦ ((hw (F (j (T z)))).2 p).const_smul ((d (T z))⁻¹))
  intro z
  change 0 ≤ meromorphicOrderAt
    ((fun _ : ℂ ↦ (d (T z))⁻¹) * HurwitzPrymRR_loc hE (F (j (T z))).1 p) 0
  rw [meromorphicOrderAt_mul analyticAt_const.meromorphicAt ((hw _).2 p)]
  exact add_nonneg analyticAt_const.meromorphicOrderAt_nonneg (himage _)


/-- Regular parameter germs on the family image give a graph differential without a pole. -/
lemma RiemannRochEichler_graph_nonneg_of_image
    [T1Space C] (hE : Module.finrank ℂ E = 1) (S : Set C) (hS : S.Finite)
    (W : Submodule ℂ (TangentBundle 𝓘(ℂ, E) C → ℂ)) [Module.Finite ℂ W]
    (hw : ∀ w : W, b4c_IsMeroForm hE w.1)
    (ha : ∀ w : W, ∀ p ∉ S, AnalyticAt ℂ (HurwitzPrymRR_loc hE w.1 p) 0)
    (hz : ∀ w : W, ∀ p ∈ S, ∀ u, w.1 ⟨p, u⟩ = 0)
    (K : C → b4c_MeroForm E C hE) (G : b4c_MeroFun E C)
    (η : b4c_MeroForm E C hE) (F : C → W)
    (hF : ∀ y ∉ S, ∀ r ∉ S, r ≠ y →
      (F y).1 ⟨r, b4cov_lineEquiv hE 1⟩ = HurwitzPrymRR_loc hE (K r) y 0 *
        ((G r).elim 0 id - (G y).elim 0 id) * η ⟨r, b4cov_lineEquiv hE 1⟩)
    (f : C → C) (hf : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω f) (hfi : Function.Injective f)
    (p : C) (himage : ∀ y, 0 ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (F y).1 p) 0)
    (hηa : AnalyticAt ℂ (HurwitzPrymRR_loc hE η p) 0)
    (hη0 : HurwitzPrymRR_loc hE η p 0 ≠ 0)
    (hGp : G p ≠ OnePoint.infty) (hGe : G (f p) ≠ OnePoint.infty)
    (hsep : (G p).elim 0 id ≠ (G (f p)).elim 0 id)
    (hK : ∀ r ∉ S, r ≠ f p → AnalyticAt ℂ (HurwitzPrymRR_loc hE (K r) (f p)) 0) :
    0 ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE
      (fun t : TangentBundle 𝓘(ℂ, E) C ↦ K t.1
        ⟨f t.1, mfderiv 𝓘(ℂ, E) 𝓘(ℂ, E) f t.1 t.2⟩) p) 0 := by
  let k := fun z ↦ (extChartAt 𝓘(ℂ, E) p).symm
    (extChartAt 𝓘(ℂ, E) p p + b4cov_lineEquiv hE z)
  let j := fun z ↦ (extChartAt 𝓘(ℂ, E) (f p)).symm
    (extChartAt 𝓘(ℂ, E) (f p) (f p) + b4cov_lineEquiv hE z)
  let T := b4cov_transport hE hE (b4cov_expr E E f p (f p)) (extChartAt 𝓘(ℂ, E) p p)
  let d := fun t ↦ deriv (b4cov_transport hE hE
    (b4cov_expr E E (id : C → C) (j t) (f p)) (extChartAt 𝓘(ℂ, E) (j t) (j t))) 0
  let N := fun z ↦ HurwitzPrymRR_loc hE ((d (T z))⁻¹ • (F (j (T z))).1) p z * deriv T z
  let D := fun z ↦ HurwitzPrymRR_loc hE η p z *
    ((G (k z)).elim 0 id - (G (f (k z))).elim 0 id)
  have hTa : AnalyticAt ℂ T 0 := by
    apply b4cov_transport_analyticAt
    apply b4cov_analyticAt_chart f hf p (f p) _ (mem_extChartAt_target p)
    rw [extChartAt_to_inv]
    exact mem_extChartAt_source (f p)
  have hT0 : T 0 = 0 := b4cov_transport_zero _ _ _ _
  have hN : MeromorphicAt N 0 :=
    (RiemannRochEichler_modified_graph_meromorphic hE S hS W hw ha hz K G
      (fun r ↦ η ⟨r, b4cov_lineEquiv hE 1⟩) F hF (f p) p T hTa hT0).mul hTa.deriv.meromorphicAt
  have hNo : 0 ≤ meromorphicOrderAt N 0 := by
    rw [show N = (fun z ↦ HurwitzPrymRR_loc hE ((d (T z))⁻¹ • (F (j (T z))).1) p z) * deriv T from rfl,
      meromorphicOrderAt_mul
        (RiemannRochEichler_modified_graph_meromorphic hE S hS W hw ha hz K G
          (fun r ↦ η ⟨r, b4cov_lineEquiv hE 1⟩) F hF (f p) p T hTa hT0)
        hTa.deriv.meromorphicAt]
    exact add_nonneg (RiemannRochEichler_modified_graph_nonneg_of_image hE S hS W
      hw ha hz K G (fun r ↦ η ⟨r, b4cov_lineEquiv hE 1⟩)
      F hF (f p) p himage hGe hK T hTa hT0) hTa.deriv.meromorphicOrderAt_nonneg
  have hGa : AnalyticAt ℂ (fun z ↦ (G (k z)).elim 0 id - (G (f (k z))).elim 0 id) 0 :=
    (RiemannRochEichler_functionLocal_analytic hE G p hGp).sub
      (RiemannRochEichler_scalar_pullback_analytic hE (fun x ↦ (G x).elim 0 id) f hf p
        (RiemannRochEichler_functionLocal_analytic hE G (f p) hGe))
  have hk0 : k 0 = p := by simp [k, extChartAt_to_inv]
  have hG0 : (G (k 0)).elim 0 id - (G (f (k 0))).elim 0 id ≠ 0 := by
    rw [hk0]
    exact sub_ne_zero.mpr hsep
  have hG : ∀ᶠ z in 𝓝[≠] (0 : ℂ), (G (k z)).elim 0 id ≠ (G (f (k z))).elim 0 id :=
    (hGa.continuousAt.eventually_ne hG0).filter_mono nhdsWithin_le_nhds |>.mono
      (fun z hz ↦ sub_ne_zero.mp hz)
  have hη : ∀ᶠ z in 𝓝[≠] (0 : ℂ), HurwitzPrymRR_loc hE η p z ≠ 0 :=
    (hηa.continuousAt.eventually_ne hη0).filter_mono nhdsWithin_le_nhds
  have hD : AnalyticAt ℂ D 0 := hηa.mul hGa
  have hD0 : D 0 ≠ 0 := mul_ne_zero hη0 hG0
  have hDo : meromorphicOrderAt D 0 = 0 := by
    rw [hD.meromorphicOrderAt_eq, hD.analyticOrderAt_eq_zero.mpr hD0]
    rfl
  have hpoints : ∀ᶠ z in 𝓝[≠] (0 : ℂ), k z ∈ Sᶜ ∧ f (k z) ∈ Sᶜ ∧ k z ≠ f (k z) := by
    filter_upwards [RiemannRochEichler_coordinate_avoid_finite hE (S ∪ f ⁻¹' S)
      (hS.union (Set.Finite.preimage hfi.injOn hS)) p, hG] with z hz hg
    refine ⟨fun h ↦ hz (Or.inl h), fun h ↦ hz (Or.inr h), ?_⟩
    exact fun h ↦ hg (congrArg (fun x ↦ (G x).elim 0 id) h)
  have he := RiemannRochEichler_graph_modified_product_charts hE (fun x ↦ (K x).1)
    (fun y ↦ (F y).1) (fun x ↦ (K x).property.1) (fun y ↦ (hw (F y)).1)
    η η.property.1 (fun x ↦ (G x).elim 0 id) Sᶜ
    (fun x hx y hy hxy ↦ by simpa only [RiemannRochEichler_loc_zero] using hF y hy x hx hxy)
    f hf p (f p) rfl hpoints
  have hc := RiemannRochEichler_graph_coordinates hE f hf p (f p) rfl
  have hquot : 0 ≤ meromorphicOrderAt (N / D) 0 := by
    rw [meromorphicOrderAt_div hN hD.meromorphicAt, hDo, sub_zero]
    exact hNo
  suffices heq : N / D =ᶠ[𝓝[≠] (0 : ℂ)] HurwitzPrymRR_loc hE
      (fun t : TangentBundle 𝓘(ℂ, E) C ↦ K t.1
        ⟨f t.1, mfderiv 𝓘(ℂ, E) 𝓘(ℂ, E) f t.1 t.2⟩) p by
    rwa [← meromorphicOrderAt_congr heq]
  filter_upwards [he, nhdsWithin_le_nhds hc, hη, hG] with z he hc hη hg
  have hdn : D z ≠ 0 := mul_ne_zero hη (sub_ne_zero.mpr hg)
  change N z / D z = _
  change N z = _ at he
  change j (T z) = f (k z) at hc
  change N z = HurwitzPrymRR_loc hE
    (fun t : TangentBundle 𝓘(ℂ, E) C ↦ K t.1
      ⟨f t.1, mfderiv 𝓘(ℂ, E) 𝓘(ℂ, E) f t.1 t.2⟩) p z *
    (HurwitzPrymRR_loc hE η p z * ((G (k z)).elim 0 id - (G (j (T z))).elim 0 id)) at he
  rw [hc] at he
  change N z = _ * D z at he
  rw [he, mul_div_cancel_right₀ _ hdn]


/-- The normalized graph differential also has no pole at its reference parameter. -/
lemma RiemannRochEichler_normalized_graph_nonneg_off_auxiliary
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) {ι : Type} [Fintype ι]
    (a : ι → C) (ha : Function.Injective a) (b : Module.Basis ι ℂ (b3_HolForm E C))
    (hb : ∀ i j, RiemannRochEichler_eval hE (a i) (b j) = if i = j then 1 else 0)
    (q : C) (hq : q ∉ Set.range a)
    (K : C → b4c_MeroForm E C hE)
    (hK : ∀ p, p ∉ Set.range a → p ≠ q →
      b4c_res (hE := hE) (K p) p = -1 ∧ b4c_res (hE := hE) (K p) q = 1 ∧
      (∀ x, (-1 : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (K p) x) 0) ∧
      (∀ x, x ≠ p → x ≠ q → AnalyticAt ℂ (HurwitzPrymRR_loc hE (K p) x) 0) ∧
      ∀ i, K p ⟨a i, b4cov_lineEquiv hE 1⟩ = 0)
    (f : C ≃ₜ C) (hf : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω f)
    (p : C) (hp : p ∉ Set.range a)
    (hfp : f p ≠ p) (hfq : f p ≠ q) :
    0 ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE
      (fun t : TangentBundle 𝓘(ℂ, E) C ↦ K t.1
        ⟨f t.1, mfderiv 𝓘(ℂ, E) 𝓘(ℂ, E) f t.1 t.2⟩) p) 0 := by
  classical
  have hnorm : ∀ p, p ∉ Set.range a → p ≠ q →
      b4c_res (hE := hE) (K p) p = -1 ∧ b4c_res (hE := hE) (K p) q = 1 ∧
      (∀ x, (-1 : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (K p) x) 0) ∧
      (∀ x, x ≠ p → x ≠ q → 0 ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (K p) x) 0) ∧
      (∀ i, AnalyticAt ℂ (HurwitzPrymRR_loc hE (K p) (a i)) 0) ∧
      ∀ i, K p ⟨a i, b4cov_lineEquiv hE 1⟩ = 0 := by
    intro p hp hpq
    obtain ⟨h₁, h₂, h₃, h₄, h₅⟩ := hK p hp hpq
    exact ⟨h₁, h₂, h₃, fun x hxp hxq ↦ (h₄ x hxp hxq).meromorphicOrderAt_nonneg,
      fun i ↦ h₄ (a i) (fun h ↦ hp ⟨i, h⟩) (fun h ↦ hq ⟨i, h⟩), h₅⟩
  obtain ⟨G, η, S, N, M, hAS, hGp, hGe, hηa, hη0, hpS, hGo, hGout, hηo, hηout⟩ :=
    RiemannRochEichler_off_diagonal_kernel_data hE (Set.range a ∪ {q})
      ((Set.finite_range a).union (Set.finite_singleton q)) p (f p) hfp.symm
  have hSa : ∀ i, a i ∈ S := fun i ↦ hAS (Or.inl ⟨i, rfl⟩)
  have hSq : q ∈ S := hAS (Or.inr rfl)
  have hFA (y : C) (hy : y ∉ S) : y ∉ Set.range a := by
    rintro ⟨i, rfl⟩
    exact hy (hSa i)
  have hFq (y : C) (hy : y ∉ S) : y ≠ q := fun he ↦ hy (he ▸ hSq)
  obtain ⟨W, hfin, F, hW, hrep, _⟩ :=
    RiemannRochEichler_joint_modified_kernel_family hE a ha b hb q hq K hK
      S hSa hSq G N M hGo hGout η hηo hηout
  letI : Module.Finite ℂ W := hfin
  have hF : ∀ y ∉ S, ∀ r ∉ S, r ≠ y →
      (F y).1 ⟨r, b4cov_lineEquiv hE 1⟩ = HurwitzPrymRR_loc hE (K r) y 0 *
        ((G r).elim 0 id - (G y).elim 0 id) * η ⟨r, b4cov_lineEquiv hE 1⟩ := by
    intro y hy r hr hry
    have hv := RiemannRochEichler_modified_representative_value hE a ha b hb q y hq
      (hFA y hy) (hFq y hy) K hnorm r (hFA r hr) (hFq r hr) hry G (hGout r hr)
      η (hηout r hr) (F y).1 ((hW _ (F y).property).2.1 r hr) (hrep y hy r)
    rw [RiemannRochEichler_residue_germ_value
      ((hK r (hFA r hr) (hFq r hr)).2.2.2.1 y (Ne.symm hry) (hFq y hy))
      Filter.EventuallyEq.rfl] at hv
    exact hv
  let F' : C → W := fun y ↦ if y ∈ S then 0 else F y
  have hF' : ∀ y ∉ S, ∀ r ∉ S, r ≠ y →
      (F' y).1 ⟨r, b4cov_lineEquiv hE 1⟩ = HurwitzPrymRR_loc hE (K r) y 0 *
        ((G r).elim 0 id - (G y).elim 0 id) * η ⟨r, b4cov_lineEquiv hE 1⟩ := by
    intro y hy r hr hry
    simpa only [F', if_neg hy] using hF y hy r hr hry
  have hGpfin : G p ≠ OnePoint.infty := by rw [hGp]; exact OnePoint.coe_ne_infty _
  have himage : ∀ y, 0 ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (F' y).1 p) 0 := by
    intro y
    by_cases hy : y ∈ S
    · simp only [F', if_pos hy]
      change 0 ≤ meromorphicOrderAt (fun _ : ℂ ↦ (0 : ℂ)) 0
      rw [meromorphicOrderAt_const, if_pos rfl]
      exact le_top
    · simp only [F', if_neg hy]
      have ho := RiemannRochEichler_modified_parameter_orders hE a ha b hb q y hq
        (hFA y hy) (hFq y hy) K hnorm G (hGout y hy) N hGo p
      rw [meromorphicOrderAt_congr (hrep y hy p)]
      rw [show (fun t ↦ residue (fun z ↦ HurwitzPrymRR_loc hE
          (K ((extChartAt 𝓘(ℂ, E) p).symm
            (extChartAt 𝓘(ℂ, E) p p + b4cov_lineEquiv hE t))) y z / z) 0 *
          (RiemannRochEichler_functionLocal hE G p t - (G y).elim 0 id) *
            HurwitzPrymRR_loc hE η p t) = _ * HurwitzPrymRR_loc hE η p from rfl,
        meromorphicOrderAt_mul ho.1 (η.property.2 p)]
      exact add_nonneg (ho.2.2 hp hGpfin) hηa.meromorphicOrderAt_nonneg
  apply RiemannRochEichler_graph_nonneg_of_image hE (S : Set C) S.finite_toSet W
    (fun w ↦ (hW w.1 w.property).1) (fun w ↦ (hW w.1 w.property).2.1)
    (fun w ↦ (hW w.1 w.property).2.2) K G η F' hF' f hf f.injective p himage hηa hη0
    hGpfin (by rw [hGe]; exact OnePoint.coe_ne_infty _)
    (by rw [hGp, hGe]; exact zero_ne_one)
  intro r hr hre
  exact (hK r (hFA r hr) (hFq r hr)).2.2.2.1 (f p) hre.symm hfq


/-- A finite family of auxiliary point contributions separates from a finitely supported residue sum. -/
lemma RiemannRochEichler_residue_sum_algebra
    {X ι : Type*} [Fintype ι] (u : X → ℂ) (hu : Function.HasFiniteSupport u)
    (a : ι → X) (c : ι → ℂ) (q : X) :
    (∑ᶠ x, (u x + (if x = q then 1 else 0) - ∑ i, if x = a i then c i else 0)) =
      (∑ᶠ x, u x) + 1 - ∑ i, c i := by
  classical
  let v := fun x : X ↦ if x = q then (1 : ℂ) else 0
  let w := fun i x ↦ if x = a i then c i else 0
  have hv : Function.HasFiniteSupport v := (Set.finite_singleton q).subset (by
    intro x hx
    by_contra h
    exact hx (if_neg h))
  have hw (i : ι) : Function.HasFiniteSupport (w i) := (Set.finite_singleton (a i)).subset (by
    intro x hx
    by_contra h
    exact hx (if_neg h))
  have hsum : Function.HasFiniteSupport (fun x ↦ ∑ i, w i x) := (Set.finite_range a).subset (by
    intro x hx
    by_contra h
    apply hx
    apply Finset.sum_eq_zero
    intro i hi
    exact if_neg (fun he ↦ h ⟨i, he.symm⟩))
  have hvr : ∑ᶠ x, v x = 1 := by
    rw [finsum_eq_single v q (fun x hx ↦ if_neg hx)]
    exact if_pos rfl
  have hwr (i : ι) : ∑ᶠ x, w i x = c i := by
    rw [finsum_eq_single (w i) (a i) (fun x hx ↦ if_neg hx)]
    exact if_pos rfl
  change (∑ᶠ x, (u x + v x - ∑ i, w i x)) = _
  rw [finsum_sub_distrib (f := fun x ↦ u x + v x) (g := fun x ↦ ∑ i, w i x) (hu.add hv) hsum, finsum_add_distrib hu hv, hvr,
    finsum_sum_comm Finset.univ (fun x i ↦ w i x) (fun i hi ↦ hw i)]
  simp only [hwr]


/-- RiemannRochTop: scalar endomorphisms commute with a change of tangent coordinates. -/
theorem b4c_eichler_trace_aux [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (s : C ≃ₜ C) (hs : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω s)
    (hne : s ≠ Homeomorph.refl C) (n : ℕ) (hn : 0 < n) (hord : s^[n] = id) :
    LinearMap.trace ℂ (b3_HolForm E C) (b4c_formPullbackEnd s hs) =
      1 + ∑ᶠ p : C, if s p = p then b4c_rotation hE s p / (1 - b4c_rotation hE s p) else 0 := by
  classical
  have hne' : (s : C → C) ≠ id := by
    intro h
    apply hne
    ext x
    exact congrFun h x
  let P := {x : C | s x = x}
  have hP : P.Finite := RiemannRochTop_fixed_finite hE s hs hne'
  obtain ⟨ι, a, b, hι, ha, haP, hb⟩ := RiemannRochEichler_normalized_basis_away hE P hP
  letI : Finite ι := hι
  letI : Fintype ι := Fintype.ofFinite ι
  let B := (P ∪ Set.range a) ∪ s '' Set.range a
  have hB : B.Finite := (hP.union (Set.finite_range a)).union ((Set.finite_range a).image s)
  obtain ⟨z, hz⟩ := (RiemannRochEichler_coordinate_avoid_finite hE B hB (Classical.arbitrary C)).exists
  let q := (extChartAt 𝓘(ℂ, E) (Classical.arbitrary C)).symm
    (extChartAt 𝓘(ℂ, E) (Classical.arbitrary C) (Classical.arbitrary C) + b4cov_lineEquiv hE z)
  have hqP : s q ≠ q := fun h ↦ hz (Or.inl (Or.inl h))
  have hq : q ∉ Set.range a := fun h ↦ hz (Or.inl (Or.inr h))
  have hqa : ∀ i, s (a i) ≠ q := fun i h ↦ hz (Or.inr ⟨a i, ⟨i, rfl⟩, h⟩)
  let r := s.symm q
  have hsr : s r = q := s.apply_symm_apply q
  have hrA : r ∉ Set.range a := by
    rintro ⟨i, hi⟩
    exact hqa i ((congrArg s hi).trans hsr)
  have hrq : r ≠ q := fun h ↦ hqP ((congrArg s h).symm.trans hsr)
  have hrP : s r ≠ r := fun h ↦ hrq (h.symm.trans hsr)
  obtain ⟨K, hK, _⟩ := RiemannRochEichler_regular_kernel_family hE a ha b hb q hq
  let θ : b4c_MeroForm E C hE := ⟨fun t : TangentBundle 𝓘(ℂ, E) C ↦ K t.1
    ⟨s t.1, mfderiv 𝓘(ℂ, E) 𝓘(ℂ, E) s t.1 t.2⟩,
    RiemannRochEichler_normalized_graph_meromorphic hE a ha b hb q hq K hK s hs hne⟩
  let u := fun x : C ↦ if s x = x then b4c_rotation hE s x / (1 - b4c_rotation hE s x) else 0
  let c := fun i ↦ RiemannRochEichler_eval hE (a i) (b4c_formPullbackEnd s hs (b i))
  have hu : Function.HasFiniteSupport u := hP.subset (by
    intro x hx
    by_contra h
    exact hx (if_neg h))
  have htrace : LinearMap.trace ℂ (b3_HolForm E C) (b4c_formPullbackEnd s hs) = ∑ i, c i := by
    rw [LinearMap.trace_eq_matrix_trace ℂ b]
    apply Finset.sum_congr rfl
    intro i hi
    simpa only [c, Matrix.diag_apply, LinearMap.toMatrix_apply, Module.Basis.coord_apply] using
      LinearMap.congr_fun (RiemannRochEichler_normalized_coord hE a b hb i)
        (b4c_formPullbackEnd s hs (b i))
  have hres (x : C) : b4c_res (hE := hE) θ x =
      u x + (if x = r then 1 else 0) - ∑ i, if x = a i then c i else 0 := by
    by_cases hxA : x ∈ Set.range a
    · obtain ⟨i, rfl⟩ := hxA
      have hai : s (a i) ≠ a i := haP i
      have hair : a i ≠ r := fun h ↦ hrA ⟨i, h⟩
      have hr := RiemannRochEichler_normalized_graph_auxiliary_residue hE a ha b hb q hq
        K hK s hs i hai (hqa i)
      have hc := RiemannRochEichler_pullback_evaluation hE s hs (b i) (a i)
      have hr' : b4c_res (hE := hE) θ (a i) = -c i := by
        change residue (HurwitzPrymRR_loc hE θ (a i)) 0 = -c i
        rw [hr]
        change _ = -RiemannRochEichler_eval hE (a i) (b4c_formPullbackEnd s hs (b i))
        rw [hc, neg_mul]
      simpa only [u, if_neg hai, if_neg hair, ha.eq_iff, Finset.sum_ite_eq,
        Finset.mem_univ, if_true, zero_add, zero_sub] using hr'
    · have hsum : (∑ i, if x = a i then c i else 0) = 0 := by
        apply Finset.sum_eq_zero
        intro i hi
        exact if_neg (fun h ↦ hxA ⟨i, h.symm⟩)
      rw [hsum, sub_zero]
      by_cases hfix : s x = x
      · have hxq : x ≠ q := fun h ↦ hqP (h ▸ hfix)
        have hxr : x ≠ r := fun h ↦ hrP (h ▸ hfix)
        have hrot := (RiemannRochEichler_normalized_graph_rotation_residue hE a ha b hb q hq
          K hK s hs hne n hn hord x hfix hxA hxq).2
        change b4c_res (hE := hE) θ x = _ at hrot
        simpa only [u, if_pos hfix, if_neg hxr, add_zero] using hrot
      · by_cases hxref : s x = q
        · have hxr : x = r := s.injective (hxref.trans hsr.symm)
          subst x
          have hr := RiemannRochEichler_normalized_graph_reference_residue hE a ha b hb q hq
            K hK s hs r hrA hrq hsr
          change b4c_res (hE := hE) θ r = 1 at hr
          simpa only [u, if_neg hrP, if_pos rfl, if_true, zero_add] using hr
        · have hxr : x ≠ r := fun h ↦ hxref ((congrArg s h).trans hsr)
          have hz := residue_eq_zero_of_meromorphicOrderAt_nonneg
            (RiemannRochEichler_normalized_graph_nonneg_off_auxiliary hE a ha b hb q hq
              K hK s hs x hxA hfix hxref)
          change b4c_res (hE := hE) θ x = 0 at hz
          simpa only [u, if_neg hfix, if_neg hxr, zero_add] using hz
  have hsum := finsum_congr hres
  rw [b4c_residue_sum_aux hE θ, RiemannRochEichler_residue_sum_algebra u hu a c r] at hsum
  rw [htrace]
  change (∑ i, c i) = 1 + ∑ᶠ x, u x
  linear_combination hsum

lemma RiemannRochEichler_chart_residue [T2Space C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (s : C ≃ₜ C)
    (hs : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω s) (hne : s ≠ Homeomorph.refl C)
    (n : ℕ) (hn : 0 < n) (hord : s^[n] = id) (p : C) (hp : s p = p) :
    let T := b4cov_transport hE hE (b4cov_expr E E s p p)
      (extChartAt 𝓘(ℂ, E) p p)
    residue (fun z ↦ deriv T z / (z - T z)) 0 =
      b4c_rotation hE s p / (1 - b4c_rotation hE s p) := by
  have hsrc : s ((extChartAt 𝓘(ℂ, E) p).symm (extChartAt 𝓘(ℂ, E) p p)) ∈
      (extChartAt 𝓘(ℂ, E) p).source := by
    rw [extChartAt_to_inv, hp]
    exact mem_extChartAt_source p
  have hA := b4cov_analyticAt_chart s hs p p _
    (mem_extChartAt_target p) hsrc
  have hD : deriv (b4cov_transport hE hE (b4cov_expr E E s p p)
      (extChartAt 𝓘(ℂ, E) p p)) 0 = b4c_rotation hE s p := by
    rw [b4cov_transport_deriv hE hE 0 (by simpa only [map_zero, add_zero, b4cov_expr]
      using hA.differentiableAt)]
    simp only [map_zero, add_zero]
    simpa only [b4cov_expr, extChartAt_coe, extChartAt_coe_symm,
      modelWithCornersSelf_coe, modelWithCornersSelf_coe_symm, Function.id_comp,
      Function.comp_id] using (b4c_rotation_chart_independent_aux hE s hs p hp
      (chartAt E p) (chart_mem_atlas E p) (mem_chart_source E p)).symm
  have hDne : deriv (b4cov_transport hE hE (b4cov_expr E E s p p)
      (extChartAt 𝓘(ℂ, E) p p)) 0 ≠ 1 := by
    rw [hD]
    exact RiemannRochTop_rotation_ne_one hE s hs hne n hn hord p hp
  dsimp only
  have hT : AnalyticAt ℂ (b4cov_transport hE hE (b4cov_expr E E s p p)
      (extChartAt 𝓘(ℂ, E) p p)) 0 := b4cov_transport_analyticAt hE hE hA
  simpa only [hD] using RiemannRochTop_local_trace_residue _ 0 hT
    (b4cov_transport_zero hE hE _ _) hDne

/-- A residue-dual family reads the diagonal coefficients of an endomorphism. -/
lemma RiemannRochEichler_residue_dual_trace {V ι : Type*} [AddCommGroup V]
    [Module ℂ V] [Fintype ι] [DecidableEq ι] (b : Module.Basis ι ℂ V)
    (a : ι → V →ₗ[ℂ] (ℂ → ℂ)) (z : ι → ℂ)
    (ha : ∀ i v, MeromorphicAt (a i v) (z i))
    (hdual : ∀ i j, residue (a i (b j)) (z i) = if i = j then 1 else 0)
    (A : V →ₗ[ℂ] V) :
    LinearMap.trace ℂ V A = ∑ i, residue (a i (A (b i))) (z i) := by
  have hcoord (i : ι) : RiemannRochEichler_residueLinearMap (a i) (z i) (ha i) =
      b.coord i := by
    apply b.ext
    intro j
    change residue (a i (b j)) (z i) = b.repr (b j) i
    rw [hdual, Module.Basis.repr_self]
    simp only [Finsupp.single_apply, eq_comm]
  rw [LinearMap.trace_eq_matrix_trace ℂ b]
  apply Finset.sum_congr rfl
  intro i _
  simpa only [Matrix.diag_apply, LinearMap.toMatrix_apply, Module.Basis.coord_apply,
    RiemannRochEichler_residueLinearMap, LinearMap.coe_mk, AddHom.coe_mk] using
    (LinearMap.congr_fun (hcoord i) (A (b i))).symm

/-- The Cauchy principal part represents evaluation of a holomorphic form. -/
lemma RiemannRochEichler_eval_residue (hE : Module.finrank ℂ E = 1)
    (w : b3_HolForm E C) (p : C) :
    residue (fun z ↦ HurwitzPrymRR_loc hE w p z / z) 0 =
      RiemannRochEichler_eval hE p w := by
  have h := residue_div_sub_pow_of_analyticAt (RiemannRochEichler_loc_analytic hE w p) 0
  have hres : residue (fun z ↦ HurwitzPrymRR_loc hE w p z / z) 0 =
      HurwitzPrymRR_loc hE w p 0 := by
    simpa only [sub_zero, zero_add, pow_one, iteratedDeriv_zero, Nat.factorial_zero,
      Nat.cast_one, div_one] using h
  rw [hres]
  change w.1 ⟨(extChartAt 𝓘(ℂ, E) p).symm
    (extChartAt 𝓘(ℂ, E) p p + b4cov_lineEquiv hE 0), _⟩ = _
  rw [map_zero, add_zero, extChartAt_to_inv, b4cov_vec_self]
  rfl

/-- Evaluations on tangent generators span the dual of the holomorphic forms. -/
lemma RiemannRochEichler_eval_span [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) :
    Submodule.span ℂ (Set.range (RiemannRochEichler_eval (C := C) hE)) = ⊤ := by
  have : FiniteDimensional ℂ E := Module.finite_of_finrank_eq_succ hE
  have : Module.Finite ℂ (b3_HolForm E C) := b3Forms_holForm_finiteDimensional hE
  apply Submodule.span_eq_top_of_ne_zero
  intro w hw
  by_contra h
  push Not at h
  apply hw
  apply Subtype.ext
  funext v
  have hp : w.1 ⟨v.1, b4cov_lineEquiv hE 1⟩ = 0 :=
    h (RiemannRochEichler_eval hE v.1) ⟨v.1, rfl⟩
  have hv : v.2 = (b4cov_lineEquiv hE).symm v.2 • b4cov_lineEquiv hE 1 := by
    change (v.2 : E) = (b4cov_lineEquiv hE).symm (v.2 : E) • b4cov_lineEquiv hE 1
    rw [← map_smul, smul_eq_mul, mul_one]
    exact ((b4cov_lineEquiv hE).apply_symm_apply (v.2 : E)).symm
  change w.1 ⟨v.1, v.2⟩ = 0
  calc
    w.1 ⟨v.1, v.2⟩ = w.1 ⟨v.1, (b4cov_lineEquiv hE).symm v.2 •
        b4cov_lineEquiv hE 1⟩ := congrArg (fun u : E ↦ w.1 ⟨v.1, u⟩) hv
    _ = (b4cov_lineEquiv hE).symm v.2 * w.1 ⟨v.1, b4cov_lineEquiv hE 1⟩ :=
      HurwitzPrymRR_IsLinear.smul w.property.2 _ _ _
    _ = 0 := mul_eq_zero_of_right _ hp

/-- Every functional on holomorphic forms is a finite sum of Cauchy residue pairings. -/
lemma RiemannRochEichler_dual_residues [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (l : Module.Dual ℂ (b3_HolForm E C)) :
    ∃ c : C →₀ ℂ, ∀ w : b3_HolForm E C,
      l w = c.sum (fun p a ↦ residue (fun z ↦ a * (HurwitzPrymRR_loc hE w p z / z)) 0) := by
  classical
  have hl : l ∈ Submodule.span ℂ (Set.range (RiemannRochEichler_eval (C := C) hE)) := by
    rw [RiemannRochEichler_eval_span hE]
    exact Submodule.mem_top
  obtain ⟨c, hc⟩ := Finsupp.mem_span_range_iff_exists_finsupp.mp hl
  refine ⟨c, fun w ↦ ?_⟩
  have h := LinearMap.congr_fun hc w
  simpa only [Finsupp.sum, LinearMap.sum_apply, LinearMap.smul_apply, smul_eq_mul,
    residue_const_mul, RiemannRochEichler_eval_residue] using h.symm

/-- A basis has finite residue-dual principal parts, which recover every endomorphism trace. -/
lemma RiemannRochEichler_exists_residue_dual [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) {ι : Type*} [Fintype ι]
    (b : Module.Basis ι ℂ (b3_HolForm E C)) :
    ∃ c : ι → C →₀ ℂ,
      (∀ i w, b.repr w i = (c i).sum (fun p a ↦
        residue (fun z ↦ a * (HurwitzPrymRR_loc hE w p z / z)) 0)) ∧
      ∀ A : Module.End ℂ (b3_HolForm E C),
        LinearMap.trace ℂ (b3_HolForm E C) A = ∑ i, (c i).sum (fun p a ↦
          residue (fun z ↦ a * (HurwitzPrymRR_loc hE (A (b i)) p z / z)) 0) := by
  classical
  choose c hc using fun i ↦ RiemannRochEichler_dual_residues hE (b.coord i)
  refine ⟨c, hc, fun A ↦ ?_⟩
  rw [LinearMap.trace_eq_matrix_trace ℂ b]
  apply Finset.sum_congr rfl
  intro i _
  simpa only [Matrix.diag_apply, LinearMap.toMatrix_apply, Module.Basis.coord_apply] using
    hc i (A (b i))

/-- Auxiliary Cauchy principal parts may avoid any prescribed finite set. -/
lemma RiemannRochEichler_dual_residues_away [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (F : Set C) (hF : F.Finite)
    (l : Module.Dual ℂ (b3_HolForm E C)) :
    ∃ c : {p : C // p ∉ F} →₀ ℂ, ∀ w : b3_HolForm E C,
      l w = c.sum (fun p a ↦ residue
        (fun z ↦ a * (HurwitzPrymRR_loc hE w p.1 z / z)) 0) := by
  classical
  have : ∀ p : C, NeBot (𝓝[≠] p) := RiemannRochEichler_nhdsNE_neBot hE
  have hd : Dense Fᶜ := by simpa only [← Set.compl_eq_univ_sdiff] using dense_univ.sdiff_finite hF
  have hl : l ∈ Submodule.span ℂ
      (Set.range (fun p : (Fᶜ : Set C) ↦ RiemannRochEichler_eval hE p.1)) := by
    rw [RiemannRochEichler_eval_span_dense hE Fᶜ hd]
    exact Submodule.mem_top
  obtain ⟨c, hc⟩ := Finsupp.mem_span_range_iff_exists_finsupp.mp hl
  refine ⟨c, fun w ↦ ?_⟩
  have h := LinearMap.congr_fun hc w
  simp only [Finsupp.sum, LinearMap.sum_apply, LinearMap.smul_apply, smul_eq_mul,
    residue_const_mul, RiemannRochEichler_eval_residue] at h ⊢
  exact h.symm

/-- A residue-dual basis and its trace formula can avoid a finite set of points. -/
lemma RiemannRochEichler_exists_residue_dual_away
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (F : Set C) (hF : F.Finite)
    {ι : Type*} [Fintype ι] (b : Module.Basis ι ℂ (b3_HolForm E C)) :
    ∃ c : ι → {p : C // p ∉ F} →₀ ℂ,
      (∀ i w, b.repr w i = (c i).sum (fun p a ↦
        residue (fun z ↦ a * (HurwitzPrymRR_loc hE w p.1 z / z)) 0)) ∧
      ∀ A : Module.End ℂ (b3_HolForm E C),
        LinearMap.trace ℂ (b3_HolForm E C) A = ∑ i, (c i).sum (fun p a ↦
          residue (fun z ↦ a * (HurwitzPrymRR_loc hE (A (b i)) p.1 z / z)) 0) := by
  classical
  choose c hc using fun i ↦ RiemannRochEichler_dual_residues_away hE F hF (b.coord i)
  refine ⟨c, hc, fun A ↦ ?_⟩
  rw [LinearMap.trace_eq_matrix_trace ℂ b]
  apply Finset.sum_congr rfl
  intro i _
  simpa only [Matrix.diag_apply, LinearMap.toMatrix_apply, Module.Basis.coord_apply] using
    hc i (A (b i))

/-- A normalized basis expresses the trace as Cauchy residues at distinct auxiliary points. -/
lemma RiemannRochEichler_trace_auxiliary_residues (hE : Module.finrank ℂ E = 1)
    {ι : Type} [Fintype ι] (p : ι → C) (b : Module.Basis ι ℂ (b3_HolForm E C))
    (hb : ∀ i j, RiemannRochEichler_eval hE (p i) (b j) = if i = j then 1 else 0)
    (A : Module.End ℂ (b3_HolForm E C)) :
    LinearMap.trace ℂ (b3_HolForm E C) A =
      ∑ i, residue (fun z ↦ HurwitzPrymRR_loc hE (A (b i)) (p i) z / z) 0 := by
  classical
  rw [LinearMap.trace_eq_matrix_trace ℂ b]
  apply Finset.sum_congr rfl
  intro i _
  rw [RiemannRochEichler_eval_residue]
  simpa only [Matrix.diag_apply, LinearMap.toMatrix_apply, Module.Basis.coord_apply] using
    LinearMap.congr_fun (RiemannRochEichler_normalized_coord hE p b hb i) (A (b i))


/-- Simple-pole differentials with identical residues differ by a holomorphic differential in germs. -/
lemma RiemannRochEichler_same_residues_holomorphic_difference [T1Space C] [CompactSpace C]
    (hE : Module.finrank ℂ E = 1) (w₁ w₂ : b4c_MeroForm E C hE)
    (h₁ : ∀ p, (-1 : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE w₁ p) 0)
    (h₂ : ∀ p, (-1 : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE w₂ p) 0)
    (hr : ∀ p, b4c_res (hE := hE) w₁ p = b4c_res (hE := hE) w₂ p) :
    ∃ v : b3_HolForm E C, ∀ p,
      HurwitzPrymRR_loc hE v p =ᶠ[𝓝[≠] 0]
        fun z ↦ HurwitzPrymRR_loc hE w₁ p z - HurwitzPrymRR_loc hE w₂ p z := by
  have hm : b4c_IsMeroForm hE (fun t ↦ w₁ t - w₂ t) := by
    refine ⟨?_, fun p ↦ (w₁.property.2 p).sub (w₂.property.2 p)⟩
    intro p a u v
    change w₁ ⟨p, a • u + v⟩ - w₂ ⟨p, a • u + v⟩ = _
    rw [w₁.property.1 p a u v, w₂.property.1 p a u v]
    ring
  let w : b4c_MeroForm E C hE := ⟨fun t ↦ w₁ t - w₂ t, hm⟩
  apply RiemannRochEichler_regularize_no_poles hE w
  intro p
  apply (w.property.2 p).meromorphicOrderAt_nonneg_iff.mpr
  obtain ⟨g₁, hg₁, he₁⟩ := RiemannRochEichler_simple_pole_split (w₁.property.2 p) (h₁ p)
  obtain ⟨g₂, hg₂, he₂⟩ := RiemannRochEichler_simple_pole_split (w₂.property.2 p) (h₂ p)
  refine ⟨g₁ - g₂, hg₁.sub hg₂, ?_⟩
  have hp : residue (HurwitzPrymRR_loc hE w₁ p) 0 =
      residue (HurwitzPrymRR_loc hE w₂ p) 0 := hr p
  filter_upwards [he₁, he₂] with z hz₁ hz₂
  change HurwitzPrymRR_loc hE w₁ p z - HurwitzPrymRR_loc hE w₂ p z = g₁ z - g₂ z
  rw [hz₁, hz₂, hp]
  ring


/-- Equal residues and regular normalized values determine simple-pole differential germs uniquely. -/
lemma RiemannRochEichler_normalized_simple_pole_unique [T1Space C] [CompactSpace C]
    (hE : Module.finrank ℂ E = 1) {ι : Type}
    (p : ι → C) (b : Module.Basis ι ℂ (b3_HolForm E C))
    (hb : ∀ i j, RiemannRochEichler_eval hE (p i) (b j) = if i = j then 1 else 0)
    (w₁ w₂ : b4c_MeroForm E C hE)
    (h₁ : ∀ x, (-1 : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE w₁ x) 0)
    (h₂ : ∀ x, (-1 : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE w₂ x) 0)
    (hr : ∀ x, b4c_res (hE := hE) w₁ x = b4c_res (hE := hE) w₂ x)
    (ha₁ : ∀ i, AnalyticAt ℂ (HurwitzPrymRR_loc hE w₁ (p i)) 0)
    (ha₂ : ∀ i, AnalyticAt ℂ (HurwitzPrymRR_loc hE w₂ (p i)) 0)
    (hv : ∀ i, w₁ ⟨p i, b4cov_lineEquiv hE 1⟩ = w₂ ⟨p i, b4cov_lineEquiv hE 1⟩) :
    ∀ x, HurwitzPrymRR_loc hE w₁ x =ᶠ[𝓝[≠] 0] HurwitzPrymRR_loc hE w₂ x := by
  obtain ⟨v, he⟩ := RiemannRochEichler_same_residues_holomorphic_difference hE w₁ w₂ h₁ h₂ hr
  have hzero (θ : TangentBundle 𝓘(ℂ, E) C → ℂ) (x : C) :
      HurwitzPrymRR_loc hE θ x 0 = θ ⟨x, b4cov_lineEquiv hE 1⟩ := by
    change θ ⟨(extChartAt 𝓘(ℂ, E) x).symm
      (extChartAt 𝓘(ℂ, E) x x + b4cov_lineEquiv hE 0), _⟩ = _
    rw [map_zero, add_zero, extChartAt_to_inv, b4cov_vec_self]
  have hveval (i : ι) : RiemannRochEichler_eval hE (p i) v = 0 := by
    have hc := (RiemannRochEichler_loc_analytic hE v (p i)).continuousAt
    have h := (hc.eventuallyEq_nhds_iff_eventuallyEq_nhdsNE
      ((ha₁ i).sub (ha₂ i)).continuousAt).mp (he (p i)) |>.self_of_nhds
    change HurwitzPrymRR_loc hE v (p i) 0 =
      HurwitzPrymRR_loc hE w₁ (p i) 0 - HurwitzPrymRR_loc hE w₂ (p i) 0 at h
    rw [hzero, hzero, hzero, hv i, sub_self] at h
    exact h
  have hv0 : v = 0 := by
    apply b.ext_elem
    intro i
    change b.coord i v = b.coord i 0
    rw [RiemannRochEichler_normalized_coord hE p b hb i, hveval, map_zero]
  intro x
  have hx := he x
  rw [hv0] at hx
  filter_upwards [hx] with z hz
  change 0 = HurwitzPrymRR_loc hE w₁ x z - HurwitzPrymRR_loc hE w₂ x z at hz
  exact sub_eq_zero.mp hz.symm


/-- Normalized third-kind differentials form a family with meromorphic coefficients in the pole parameter. -/
lemma RiemannRochEichler_normalized_kernel_family
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) {ι : Type} [Fintype ι]
    (a : ι → C) (ha : Function.Injective a) (b : Module.Basis ι ℂ (b3_HolForm E C))
    (hb : ∀ i j, RiemannRochEichler_eval hE (a i) (b j) = if i = j then 1 else 0)
    (q : C) (hq : q ∉ Set.range a) :
    ∃ K : C → b4c_MeroForm E C hE,
      (∀ p, p ∉ Set.range a → p ≠ q →
        b4c_res (hE := hE) (K p) p = -1 ∧ b4c_res (hE := hE) (K p) q = 1 ∧
        (∀ x, (-1 : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (K p) x) 0) ∧
        (∀ x, x ≠ p → x ≠ q → 0 ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (K p) x) 0) ∧
        (∀ i, AnalyticAt ℂ (HurwitzPrymRR_loc hE (K p) (a i)) 0) ∧
        ∀ i, K p ⟨a i, b4cov_lineEquiv hE 1⟩ = 0) ∧
      ∀ y, y ∉ Set.range a → y ≠ q → ∀ r,
        MeromorphicAt (fun t ↦ residue (fun z ↦
          HurwitzPrymRR_loc hE
            (K ((extChartAt 𝓘(ℂ, E) r).symm
              (extChartAt 𝓘(ℂ, E) r r + b4cov_lineEquiv hE t))) y z / z) 0) 0 := by
  classical
  let w₀ : b4c_MeroForm E C hE := ⟨fun _ ↦ 0, by
    constructor
    · intro x c u v
      simp
    · intro x
      exact analyticAt_const.meromorphicAt⟩
  have hex (p : C) : ∃ w : b4c_MeroForm E C hE,
      p ∉ Set.range a → p ≠ q →
      b4c_res (hE := hE) w p = -1 ∧ b4c_res (hE := hE) w q = 1 ∧
      (∀ x, (-1 : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0) ∧
      (∀ x, x ≠ p → x ≠ q → 0 ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0) ∧
      (∀ i, AnalyticAt ℂ (HurwitzPrymRR_loc hE w (a i)) 0) ∧
      ∀ i, w ⟨a i, b4cov_lineEquiv hE 1⟩ = 0 := by
    by_cases hp : p ∉ Set.range a
    · by_cases hpq : p ≠ q
      · obtain ⟨w, hw⟩ := RiemannRochEichler_normalized_third_kind hE a b hb p q hpq
          (fun i h ↦ hp ⟨i, h⟩) (fun i h ↦ hq ⟨i, h⟩)
        exact ⟨w, fun _ _ ↦ hw⟩
      · exact ⟨w₀, fun _ h ↦ (hpq h).elim⟩
    · exact ⟨w₀, fun h _ ↦ (hp h).elim⟩
  choose K hK using hex
  refine ⟨K, hK, ?_⟩
  intro y hy hyq r
  exact RiemannRochEichler_normalized_parameter_meromorphic hE a ha b hb q y hq hy hyq K hK r


/-- Analytic centred coefficients are analytic at the corresponding point in any overlapping chart. -/
lemma RiemannRochEichler_chart_analytic_of_loc (hE : Module.finrank ℂ E = 1)
    (w : TangentBundle 𝓘(ℂ, E) C → ℂ) (hw : HurwitzPrymRR_IsLinear w)
    (p q : C) (hq : q ∈ (extChartAt 𝓘(ℂ, E) p).source)
    (ha : AnalyticAt ℂ (HurwitzPrymRR_loc hE w q) 0) :
    AnalyticAt ℂ (HurwitzPrymRR_loc hE w p)
      ((b4cov_lineEquiv hE).symm (extChartAt 𝓘(ℂ, E) p q - extChartAt 𝓘(ℂ, E) p p)) := by
  have hid : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω (id : C → C) := contMDiff_id
  have he := HurwitzPrymRR_loc_pullback hE hE id hid q p hq w hw
  rw [HurwitzPrymRR_pullback_id] at he
  let G := b4cov_expr E E (id : C → C) q p
  let T := b4cov_transport hE hE G (extChartAt 𝓘(ℂ, E) q q)
  let c := (b4cov_lineEquiv hE).symm
    (extChartAt 𝓘(ℂ, E) p q - extChartAt 𝓘(ℂ, E) p p)
  obtain ⟨hT, hT'⟩ := RiemannRochEichler_chart_transition_unit hE p q hq
  change AnalyticAt ℂ T 0 at hT
  change deriv T 0 ≠ 0 at hT'
  have hquot : AnalyticAt ℂ (fun z ↦ HurwitzPrymRR_loc hE w q z / deriv T z) 0 :=
    ha.div hT.deriv hT'
  have hcomp : AnalyticAt ℂ (fun z ↦ HurwitzPrymRR_loc hE w p (c + T z)) 0 := by
    apply hquot.congr
    filter_upwards [he, hT.deriv.continuousAt.eventually_ne hT'] with z hz hn
    change HurwitzPrymRR_loc hE w q z / deriv T z = _
    change HurwitzPrymRR_loc hE w q z = HurwitzPrymRR_loc hE w p (c + T z) * deriv T z at hz
    rw [hz, mul_div_cancel_right₀ _ hn]
  have hA : AnalyticAt ℂ (fun z ↦ c + T z) 0 := analyticAt_const.add hT
  have hA' : deriv (fun z ↦ c + T z) 0 ≠ 0 := by
    simpa only [deriv_const_add] using hT'
  have h := (analyticAt_comp_iff_of_deriv_ne_zero (g := HurwitzPrymRR_loc hE w p) hA hA').mp hcomp
  simpa only [T, b4cov_transport_zero, add_zero] using h


/-- In a finite-dimensional function space, pointwise analytic dependence is analytic under every functional. -/
lemma RiemannRochEichler_analytic_dual_of_pointwise {X : Type*}
    (V : Submodule ℂ (X → ℂ)) [Module.Finite ℂ V]
    (F : ℂ → V) (x : ℂ) (hF : ∀ y, AnalyticAt ℂ (fun t ↦ (F t).1 y) x)
    (l : Module.Dual ℂ V) : AnalyticAt ℂ (fun t ↦ l (F t)) x := by
  let ev : X → Module.Dual ℂ V := fun y ↦ (LinearMap.proj y).comp V.subtype
  have hs : Submodule.span ℂ (Set.range ev) = ⊤ := by
    apply Submodule.span_eq_top_of_ne_zero
    intro v hv
    by_contra h
    push Not at h
    apply hv
    apply Subtype.ext
    funext y
    exact h (ev y) ⟨y, rfl⟩
  have hl : l ∈ Submodule.span ℂ (Set.range ev) := by rw [hs]; exact Submodule.mem_top
  induction hl using Submodule.span_induction with
  | mem l hl =>
    obtain ⟨y, rfl⟩ := hl
    exact hF y
  | zero => exact analyticAt_const
  | add l m _ _ hl hm => exact hl.add hm
  | smul c l _ hl => exact hl.const_smul


/-- Separate analytic dependence in a fixed finite-dimensional function space is jointly analytic. -/
lemma RiemannRochEichler_joint_analytic_of_finite_dimensional
    (V : Submodule ℂ (ℂ → ℂ)) [Module.Finite ℂ V]
    (F : ℂ → V) (x y : ℂ)
    (hx : ∀ z, AnalyticAt ℂ (fun t ↦ (F t).1 z) x)
    (hy : ∀ v : V, AnalyticAt ℂ v.1 y) :
    AnalyticAt ℂ (fun z : ℂ × ℂ ↦ (F z.1).1 z.2) (x, y) := by
  classical
  let b := Module.finBasis ℂ V
  have hc (i : Fin (Module.finrank ℂ V)) : AnalyticAt ℂ (fun t ↦ b.coord i (F t)) x :=
    RiemannRochEichler_analytic_dual_of_pointwise V F x hx (b.coord i)
  have he (t u : ℂ) : (F t).1 u = ∑ i, b.coord i (F t) * (b i).1 u := by
    have h := congrArg (fun v : V ↦ v.1 u) (b.sum_repr (F t))
    simpa only [Submodule.coe_sum, Finset.sum_apply, Submodule.coe_smul,
      Pi.smul_apply, smul_eq_mul, Module.Basis.coord_apply] using h.symm
  have hsum : AnalyticAt ℂ
      (fun z : ℂ × ℂ ↦ ∑ i, b.coord i (F z.1) * (b i).1 z.2) (x, y) := by
    apply Finset.analyticAt_fun_sum
    intro i hi
    have h₁ : AnalyticAt ℂ (fun z : ℂ × ℂ ↦ b.coord i (F z.1)) (x, y) :=
      AnalyticAt.comp (g := fun t ↦ b.coord i (F t)) (f := Prod.fst) (hc i) analyticAt_fst
    have h₂ : AnalyticAt ℂ (fun z : ℂ × ℂ ↦ (b i).1 z.2) (x, y) :=
      AnalyticAt.comp (g := (b i).1) (f := Prod.snd) (hy (b i)) analyticAt_snd
    exact h₁.mul h₂
  simpa only [← he] using hsum


/-- The coefficients of a regular normalized family in a fixed chart are meromorphic in the pole parameter. -/
lemma RiemannRochEichler_fixed_chart_parameter_meromorphic
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) {ι : Type} [Fintype ι]
    (a : ι → C) (ha : Function.Injective a) (b : Module.Basis ι ℂ (b3_HolForm E C))
    (hb : ∀ i j, RiemannRochEichler_eval hE (a i) (b j) = if i = j then 1 else 0)
    (q y e : C) (hq : q ∉ Set.range a) (hy : y ∉ Set.range a) (hyq : y ≠ q)
    (hye : y ∈ (extChartAt 𝓘(ℂ, E) e).source)
    (K : C → b4c_MeroForm E C hE)
    (hK : ∀ p, p ∉ Set.range a → p ≠ q →
      b4c_res (hE := hE) (K p) p = -1 ∧ b4c_res (hE := hE) (K p) q = 1 ∧
      (∀ x, (-1 : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (K p) x) 0) ∧
      (∀ x, x ≠ p → x ≠ q → AnalyticAt ℂ (HurwitzPrymRR_loc hE (K p) x) 0) ∧
      ∀ i, K p ⟨a i, b4cov_lineEquiv hE 1⟩ = 0) (r : C) :
    MeromorphicAt (fun t ↦ HurwitzPrymRR_loc hE
      (K ((extChartAt 𝓘(ℂ, E) r).symm
        (extChartAt 𝓘(ℂ, E) r r + b4cov_lineEquiv hE t))) e
      ((b4cov_lineEquiv hE).symm (extChartAt 𝓘(ℂ, E) e y - extChartAt 𝓘(ℂ, E) e e))) 0 := by
  have hm := RiemannRochEichler_normalized_parameter_meromorphic hE a ha b hb q y hq hy hyq K
    (by
      intro p hp hpq
      obtain ⟨h₁, h₂, h₃, h₄, h₅⟩ := hK p hp hpq
      exact ⟨h₁, h₂, h₃, fun x hxp hxq ↦ (h₄ x hxp hxq).meromorphicOrderAt_nonneg,
        fun i ↦ h₄ (a i) (fun h ↦ hp ⟨i, h⟩) (fun h ↦ hq ⟨i, h⟩), h₅⟩) r
  let T := b4cov_transport hE hE (b4cov_expr E E (id : C → C) y e)
    (extChartAt 𝓘(ℂ, E) y y)
  have hd : deriv T 0 ≠ 0 := (RiemannRochEichler_chart_transition_unit hE e y hye).2
  let c := (b4cov_lineEquiv hE).symm (extChartAt 𝓘(ℂ, E) e y - extChartAt 𝓘(ℂ, E) e e)
  let S := Set.range a ∪ ({q, y} : Set C)
  have hS : S.Finite := (Set.finite_range a).union (Set.toFinite _)
  have he : ∀ p ∉ S, HurwitzPrymRR_loc hE (K p) e c =
      residue (fun z ↦ HurwitzPrymRR_loc hE (K p) y z / z) 0 / deriv T 0 := by
    intro p hp
    have hpA : p ∉ Set.range a := fun h ↦ hp (Or.inl h)
    have hpq : p ≠ q := fun h ↦ hp (Or.inr (Or.inl h))
    have hpy : p ≠ y := fun h ↦ hp (Or.inr (Or.inr h))
    have han := (hK p hpA hpq).2.2.2.1 y (Ne.symm hpy) hyq
    rw [RiemannRochEichler_residue_germ_value han Filter.EventuallyEq.rfl]
    apply (eq_div_iff hd).mpr
    exact (RiemannRochEichler_chart_value hE (K p) (K p).property.1 e y hye).symm
  have hloc := RiemannRochEichler_scalar_loc_congr_off_finite hE S hS _ _ he r
  exact (hm.div (MeromorphicAt.const (deriv T 0) 0)).congr hloc.symm


/-- Fixed-chart coefficients of a regular normalized family are analytic away from the parameter exceptions. -/
lemma RiemannRochEichler_fixed_chart_parameter_analytic
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) {ι : Type} [Fintype ι]
    (a : ι → C) (ha : Function.Injective a) (b : Module.Basis ι ℂ (b3_HolForm E C))
    (hb : ∀ i j, RiemannRochEichler_eval hE (a i) (b j) = if i = j then 1 else 0)
    (q y e : C) (hq : q ∉ Set.range a) (hy : y ∉ Set.range a) (hyq : y ≠ q)
    (hye : y ∈ (extChartAt 𝓘(ℂ, E) e).source)
    (K : C → b4c_MeroForm E C hE)
    (hK : ∀ p, p ∉ Set.range a → p ≠ q →
      b4c_res (hE := hE) (K p) p = -1 ∧ b4c_res (hE := hE) (K p) q = 1 ∧
      (∀ x, (-1 : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (K p) x) 0) ∧
      (∀ x, x ≠ p → x ≠ q → AnalyticAt ℂ (HurwitzPrymRR_loc hE (K p) x) 0) ∧
      ∀ i, K p ⟨a i, b4cov_lineEquiv hE 1⟩ = 0) (r : C) (hr : r ∉ Set.range a) (hrq : r ≠ q) (hry : r ≠ y) :
    AnalyticAt ℂ (fun t ↦ HurwitzPrymRR_loc hE
      (K ((extChartAt 𝓘(ℂ, E) r).symm
        (extChartAt 𝓘(ℂ, E) r r + b4cov_lineEquiv hE t))) e
      ((b4cov_lineEquiv hE).symm (extChartAt 𝓘(ℂ, E) e y - extChartAt 𝓘(ℂ, E) e e))) 0 := by
  have hm := RiemannRochEichler_normalized_parameter_analytic hE a ha b hb q y hq hy hyq K
    (by
      intro p hp hpq
      obtain ⟨h₁, h₂, h₃, h₄, h₅⟩ := hK p hp hpq
      exact ⟨h₁, h₂, h₃, fun x hxp hxq ↦ (h₄ x hxp hxq).meromorphicOrderAt_nonneg,
        fun i ↦ h₄ (a i) (fun h ↦ hp ⟨i, h⟩) (fun h ↦ hq ⟨i, h⟩), h₅⟩) r hr hrq hry
  let T := b4cov_transport hE hE (b4cov_expr E E (id : C → C) y e)
    (extChartAt 𝓘(ℂ, E) y y)
  have hd : deriv T 0 ≠ 0 := (RiemannRochEichler_chart_transition_unit hE e y hye).2
  let c := (b4cov_lineEquiv hE).symm (extChartAt 𝓘(ℂ, E) e y - extChartAt 𝓘(ℂ, E) e e)
  let S := Set.range a ∪ ({q, y} : Set C)
  have hS : S.Finite := (Set.finite_range a).union (Set.toFinite _)
  have he : ∀ p ∉ S, HurwitzPrymRR_loc hE (K p) e c =
      residue (fun z ↦ HurwitzPrymRR_loc hE (K p) y z / z) 0 / deriv T 0 := by
    intro p hp
    have hpA : p ∉ Set.range a := fun h ↦ hp (Or.inl h)
    have hpq : p ≠ q := fun h ↦ hp (Or.inr (Or.inl h))
    have hpy : p ≠ y := fun h ↦ hp (Or.inr (Or.inr h))
    have han := (hK p hpA hpq).2.2.2.1 y (Ne.symm hpy) hyq
    rw [RiemannRochEichler_residue_germ_value han Filter.EventuallyEq.rfl]
    apply (eq_div_iff hd).mpr
    exact (RiemannRochEichler_chart_value hE (K p) (K p).property.1 e y hye).symm
  have hloc := RiemannRochEichler_scalar_loc_congr_off_finite hE S hS _ _ he r
  apply (hm.div analyticAt_const hd).congr
  apply (eventuallyEq_nhds_of_eventuallyEq_nhdsNE hloc _).symm
  simp only [map_zero, add_zero, extChartAt_to_inv]
  exact he r (by simpa only [S, Set.mem_union, Set.mem_insert_iff,
    Set.mem_singleton_iff, not_or] using And.intro hr (And.intro hrq hry))


/-- Cancelling the diagonal pole with a difference of analytic values gives the derivative at the diagonal. -/
lemma RiemannRochEichler_diagonal_regular_value {f g : ℂ → ℂ}
    (hf : MeromorphicAt f 0) (ho : (-1 : WithTop ℤ) ≤ meromorphicOrderAt f 0)
    (hr : residue f 0 = -1) (hg : AnalyticAt ℂ g 0) :
    ∃ h : ℂ → ℂ, AnalyticAt ℂ h 0 ∧
      (fun z ↦ f z * (g 0 - g z)) =ᶠ[𝓝[≠] 0] h ∧ h 0 = deriv g 0 := by
  obtain ⟨h, ha, he, hv⟩ := RiemannRochEichler_cancel_simple_pole hf ho
    (analyticAt_const.sub hg) (sub_self (g 0))
  refine ⟨h, ha, he, ?_⟩
  change h 0 = residue f 0 * deriv (fun z ↦ g 0 - g z) 0 at hv
  simpa only [hr, deriv_const_sub, neg_mul, one_mul, neg_neg] using hv


/-- Fixed-chart coefficients of a finite-dimensional differential space lie in a finite-dimensional analytic function space. -/
lemma RiemannRochEichler_finite_chart_space
    (hE : Module.finrank ℂ E = 1)
    (W : Submodule ℂ (TangentBundle 𝓘(ℂ, E) C → ℂ)) [Module.Finite ℂ W]
    (hw : ∀ w : W, HurwitzPrymRR_IsLinear w.1)
    (e p : C) (hp : p ∈ (extChartAt 𝓘(ℂ, E) e).source)
    (ha : ∀ w : W, AnalyticAt ℂ (HurwitzPrymRR_loc hE w.1 p) 0) :
    ∃ V : Submodule ℂ (ℂ → ℂ), Module.Finite ℂ V ∧
      (∀ w ∈ W, HurwitzPrymRR_loc hE w e ∈ V) ∧
      ∀ f ∈ V, AnalyticAt ℂ f
        ((b4cov_lineEquiv hE).symm (extChartAt 𝓘(ℂ, E) e p - extChartAt 𝓘(ℂ, E) e e)) := by
  let L : W →ₗ[ℂ] (ℂ → ℂ) :=
    { toFun := fun w ↦ HurwitzPrymRR_loc hE w.1 e
      map_add' := fun _ _ ↦ rfl
      map_smul' := fun _ _ ↦ rfl }
  refine ⟨L.range, inferInstance, ?_, ?_⟩
  · intro w hw
    exact ⟨⟨w, hw⟩, rfl⟩
  · rintro f ⟨w, rfl⟩
    exact RiemannRochEichler_chart_analytic_of_loc hE w.1 (hw w) e p hp (ha w)


/-- Cancelling the diagonal pole in either variable yields the same derivative value. -/
lemma RiemannRochEichler_diagonal_values_agree
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) {ι : Type} [Fintype ι]
    (a : ι → C) (ha : Function.Injective a) (b : Module.Basis ι ℂ (b3_HolForm E C))
    (hb : ∀ i j, RiemannRochEichler_eval hE (a i) (b j) = if i = j then 1 else 0)
    (q y : C) (hq : q ∉ Set.range a) (hy : y ∉ Set.range a) (hyq : y ≠ q)
    (K : C → b4c_MeroForm E C hE)
    (hK : ∀ p, p ∉ Set.range a → p ≠ q →
      b4c_res (hE := hE) (K p) p = -1 ∧ b4c_res (hE := hE) (K p) q = 1 ∧
      (∀ x, (-1 : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (K p) x) 0) ∧
      (∀ x, x ≠ p → x ≠ q → 0 ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (K p) x) 0) ∧
      (∀ i, AnalyticAt ℂ (HurwitzPrymRR_loc hE (K p) (a i)) 0) ∧
      ∀ i, K p ⟨a i, b4cov_lineEquiv hE 1⟩ = 0)
    (g : ℂ → ℂ) (hg : AnalyticAt ℂ g 0) :
    let F := fun t ↦ residue (fun z ↦ HurwitzPrymRR_loc hE
      (K ((extChartAt 𝓘(ℂ, E) y).symm
        (extChartAt 𝓘(ℂ, E) y y + b4cov_lineEquiv hE t))) y z / z) 0
    ∃ U V : ℂ → ℂ, AnalyticAt ℂ U 0 ∧ AnalyticAt ℂ V 0 ∧
      (fun z ↦ HurwitzPrymRR_loc hE (K y) y z * (g 0 - g z)) =ᶠ[𝓝[≠] 0] U ∧
      (fun z ↦ F z * (g z - g 0)) =ᶠ[𝓝[≠] 0] V ∧
      U 0 = deriv g 0 ∧ V 0 = deriv g 0 := by
  dsimp only
  obtain ⟨hm, ho, _, hr⟩ :=
    RiemannRochEichler_parameter_pole_data hE a ha b hb q y hq hy hyq K hK
  have hw := hK y hy hyq
  obtain ⟨U, hU, heU, hvU⟩ := RiemannRochEichler_diagonal_regular_value
    ((K y).property.2 y) (hw.2.2.1 y) hw.1 hg
  obtain ⟨V, hV, heV, hvV⟩ := RiemannRochEichler_cancel_simple_pole
    (hm y) (ho y) (hg.sub analyticAt_const) (sub_self (g 0))
  refine ⟨U, V, hU, hV, heU, heV, hvU, ?_⟩
  rw [hr, one_mul] at hvV
  change V 0 = deriv (fun z ↦ g z - g 0) 0 at hvV
  simpa only [deriv_sub_const] using hvV


/-- Simple pole bounds on the image of a family suffice for its graph residue formula. -/
lemma RiemannRochEichler_graph_residue_of_image_bounds
    {V X : Type*} [AddCommGroup V] [Module ℂ V] [Module.Finite ℂ V]
    (ev : X → Module.Dual ℂ V) (hsep : ∀ v, (∀ z, ev z v = 0) → v = 0)
    (J : V →ₗ[ℂ] (ℂ → ℂ)) (F : ℂ → V) (x : ℂ)
    (hF : ∀ z, AnalyticAt ℂ (fun t ↦ ev z (F t)) x)
    (hJ : ∀ t, MeromorphicAt (J (F t)) x)
    (ho : ∀ t, (-1 : WithTop ℤ) ≤ meromorphicOrderAt (J (F t)) x) :
    MeromorphicAt (fun z ↦ J (F z) z) x ∧
      residue (fun z ↦ J (F z) z) x = residue (J (F x)) x := by
  let W := Submodule.span ℂ (Set.range F)
  let F' : ℂ → W := fun t ↦ ⟨F t, Submodule.subset_span ⟨t, rfl⟩⟩
  let ev' : X → Module.Dual ℂ W := fun z ↦ (ev z).comp W.subtype
  have hsep' : ∀ v : W, (∀ z, ev' z v = 0) → v = 0 := by
    intro v hv
    apply Subtype.ext
    exact hsep v.1 hv
  have hb : ∀ v : W, MeromorphicAt (J v.1) x ∧
      (-1 : WithTop ℤ) ≤ meromorphicOrderAt (J v.1) x := by
    intro v
    apply RiemannRochEichler_order_bound_span J (Set.range F) x (-1) _ v.1 v.2
    rintro _ ⟨t, rfl⟩
    exact ⟨hJ t, ho t⟩
  exact RiemannRochEichler_finite_family_graph_residue ev' hsep' (J.comp W.subtype) F' x
    hF (fun v ↦ (hb v).1) (fun v ↦ (hb v).2)


/-- Regular fixed-chart evaluation germs give a modified graph numerator without a pole. -/
lemma RiemannRochEichler_modified_graph_nonneg [T1Space C]
    (hE : Module.finrank ℂ E = 1) (S : Set C) (hS : S.Finite)
    (W : Submodule ℂ (TangentBundle 𝓘(ℂ, E) C → ℂ)) [Module.Finite ℂ W]
    (hw : ∀ w : W, HurwitzPrymRR_IsLinear w.1)
    (ha : ∀ w : W, ∀ p ∉ S, AnalyticAt ℂ (HurwitzPrymRR_loc hE w.1 p) 0)
    (hz : ∀ w : W, ∀ p ∈ S, ∀ u, w.1 ⟨p, u⟩ = 0)
    (K : C → b4c_MeroForm E C hE) (G : b4c_MeroFun E C) (β : C → ℂ)
    (F : C → W)
    (hF : ∀ y ∉ S, ∀ r ∉ S, r ≠ y →
      (F y).1 ⟨r, b4cov_lineEquiv hE 1⟩ = HurwitzPrymRR_loc hE (K r) y 0 *
        ((G r).elim 0 id - (G y).elim 0 id) * β r)
    (e p : C) (hp : p ∉ S) (hG : G e ≠ OnePoint.infty)
    (hK : ∀ r ∉ S, r ≠ e → AnalyticAt ℂ (HurwitzPrymRR_loc hE (K r) e) 0)
    (T : ℂ → ℂ) (hT : AnalyticAt ℂ T 0) (hT0 : T 0 = 0) :
    let j := fun t ↦ (extChartAt 𝓘(ℂ, E) e).symm
      (extChartAt 𝓘(ℂ, E) e e + b4cov_lineEquiv hE t)
    let d := fun t ↦ deriv (b4cov_transport hE hE
      (b4cov_expr E E (id : C → C) (j t) e) (extChartAt 𝓘(ℂ, E) (j t) (j t))) 0
    0 ≤ meromorphicOrderAt
      (fun z ↦ HurwitzPrymRR_loc hE ((d (T z))⁻¹ • (F (j (T z))).1) p z) 0 := by
  let j := fun t ↦ (extChartAt 𝓘(ℂ, E) e).symm
    (extChartAt 𝓘(ℂ, E) e e + b4cov_lineEquiv hE t)
  let d := fun t ↦ deriv (b4cov_transport hE hE
    (b4cov_expr E E (id : C → C) (j t) e) (extChartAt 𝓘(ℂ, E) (j t) (j t))) 0
  let A : ℂ → W := fun z ↦ (d (T z))⁻¹ • F (j (T z))
  let ev : {r : C // r ∉ S ∪ {e}} → Module.Dual ℂ W :=
    fun r ↦ (LinearMap.proj ⟨r.1, b4cov_lineEquiv hE 1⟩).comp W.subtype
  have hsep : ∀ w : W, (∀ r, ev r w = 0) → w = 0 := by
    intro w he
    apply Subtype.ext
    apply RiemannRochEichler_evaluations_separate_off_finite hE w.1 (hw w) S {e} hS
      (Set.finite_singleton e) (ha w) (hz w)
    intro r hr
    exact he ⟨r, hr⟩
  let J : W →ₗ[ℂ] (ℂ → ℂ) :=
    { toFun := fun w ↦ HurwitzPrymRR_loc hE w.1 p
      map_add' := fun _ _ ↦ rfl
      map_smul' := fun _ _ ↦ rfl }
  have hcoords (r : {r : C // r ∉ S ∪ {e}}) :
      MeromorphicAt (fun z ↦ ev r (A z)) 0 ∧
      0 ≤ meromorphicOrderAt (fun z ↦ ev r (A z)) 0 := by
    have hrS : r.1 ∉ S := fun h ↦ r.2 (Or.inl h)
    have hre : r.1 ≠ e := fun h ↦ r.2 (Or.inr h)
    let B := fun t ↦ (d t)⁻¹ * (F (j t)).1 ⟨r.1, b4cov_lineEquiv hE 1⟩
    have hm : MeromorphicAt B 0 := RiemannRochEichler_chart_scaled_evaluation_meromorphic
      hE S hS K G β (fun y ↦ (F y).1) hF e r.1 hrS
    have he := RiemannRochEichler_chart_scaled_evaluation_germ
      hE S hS K G β (fun y ↦ (F y).1) hF e r.1 hrS
    have hreg : AnalyticAt ℂ (fun t ↦ HurwitzPrymRR_loc hE (K r.1) e t *
        ((G r.1).elim 0 id - RiemannRochEichler_functionLocal hE G e t) * β r.1) 0 :=
      ((hK r.1 hrS hre).mul (analyticAt_const.sub
        (RiemannRochEichler_functionLocal_analytic hE G e hG))).mul analyticAt_const
    have ho : 0 ≤ meromorphicOrderAt B 0 := by
      rw [meromorphicOrderAt_congr he]
      exact hreg.meromorphicOrderAt_nonneg
    have hmT : MeromorphicAt B (T 0) := hT0.symm ▸ hm
    have hoT : 0 ≤ meromorphicOrderAt B (T 0) := hT0.symm ▸ ho
    exact ⟨hmT.comp_analyticAt hT, RiemannRochEichler_nonneg_order_comp hmT hT hoT⟩
  exact RiemannRochEichler_graph_order_bound ev hsep J A 0 0
    (fun r ↦ (hcoords r).1) (fun r ↦ (hcoords r).2)
    (fun w ↦ (ha w p hp).meromorphicAt) (fun w ↦ (ha w p hp).meromorphicOrderAt_nonneg)


/-- A regular modified numerator gives a graph differential without a pole off the diagonal. -/
lemma RiemannRochEichler_graph_nonneg_of_modified
    [T1Space C] (hE : Module.finrank ℂ E = 1) (S : Set C) (hS : S.Finite)
    (W : Submodule ℂ (TangentBundle 𝓘(ℂ, E) C → ℂ)) [Module.Finite ℂ W]
    (hw : ∀ w : W, b4c_IsMeroForm hE w.1)
    (ha : ∀ w : W, ∀ p ∉ S, AnalyticAt ℂ (HurwitzPrymRR_loc hE w.1 p) 0)
    (hz : ∀ w : W, ∀ p ∈ S, ∀ u, w.1 ⟨p, u⟩ = 0)
    (K : C → b4c_MeroForm E C hE) (G : b4c_MeroFun E C)
    (η : b4c_MeroForm E C hE) (F : C → W)
    (hF : ∀ y ∉ S, ∀ r ∉ S, r ≠ y →
      (F y).1 ⟨r, b4cov_lineEquiv hE 1⟩ = HurwitzPrymRR_loc hE (K r) y 0 *
        ((G r).elim 0 id - (G y).elim 0 id) * η ⟨r, b4cov_lineEquiv hE 1⟩)
    (f : C → C) (hf : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω f) (hfi : Function.Injective f)
    (p : C) (hp : p ∉ S)
    (hηa : AnalyticAt ℂ (HurwitzPrymRR_loc hE η p) 0)
    (hη0 : HurwitzPrymRR_loc hE η p 0 ≠ 0)
    (hGp : G p ≠ OnePoint.infty) (hGe : G (f p) ≠ OnePoint.infty)
    (hsep : (G p).elim 0 id ≠ (G (f p)).elim 0 id)
    (hK : ∀ r ∉ S, r ≠ f p → AnalyticAt ℂ (HurwitzPrymRR_loc hE (K r) (f p)) 0) :
    0 ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE
      (fun t : TangentBundle 𝓘(ℂ, E) C ↦ K t.1
        ⟨f t.1, mfderiv 𝓘(ℂ, E) 𝓘(ℂ, E) f t.1 t.2⟩) p) 0 := by
  let k := fun z ↦ (extChartAt 𝓘(ℂ, E) p).symm
    (extChartAt 𝓘(ℂ, E) p p + b4cov_lineEquiv hE z)
  let j := fun z ↦ (extChartAt 𝓘(ℂ, E) (f p)).symm
    (extChartAt 𝓘(ℂ, E) (f p) (f p) + b4cov_lineEquiv hE z)
  let T := b4cov_transport hE hE (b4cov_expr E E f p (f p)) (extChartAt 𝓘(ℂ, E) p p)
  let d := fun t ↦ deriv (b4cov_transport hE hE
    (b4cov_expr E E (id : C → C) (j t) (f p)) (extChartAt 𝓘(ℂ, E) (j t) (j t))) 0
  let N := fun z ↦ HurwitzPrymRR_loc hE ((d (T z))⁻¹ • (F (j (T z))).1) p z * deriv T z
  let D := fun z ↦ HurwitzPrymRR_loc hE η p z *
    ((G (k z)).elim 0 id - (G (f (k z))).elim 0 id)
  have hTa : AnalyticAt ℂ T 0 := by
    apply b4cov_transport_analyticAt
    apply b4cov_analyticAt_chart f hf p (f p) _ (mem_extChartAt_target p)
    rw [extChartAt_to_inv]
    exact mem_extChartAt_source (f p)
  have hT0 : T 0 = 0 := b4cov_transport_zero _ _ _ _
  have hN : MeromorphicAt N 0 :=
    (RiemannRochEichler_modified_graph_meromorphic hE S hS W hw ha hz K G
      (fun r ↦ η ⟨r, b4cov_lineEquiv hE 1⟩) F hF (f p) p T hTa hT0).mul hTa.deriv.meromorphicAt
  have hNo : 0 ≤ meromorphicOrderAt N 0 := by
    rw [show N = (fun z ↦ HurwitzPrymRR_loc hE ((d (T z))⁻¹ • (F (j (T z))).1) p z) * deriv T from rfl,
      meromorphicOrderAt_mul
        (RiemannRochEichler_modified_graph_meromorphic hE S hS W hw ha hz K G
          (fun r ↦ η ⟨r, b4cov_lineEquiv hE 1⟩) F hF (f p) p T hTa hT0)
        hTa.deriv.meromorphicAt]
    exact add_nonneg (RiemannRochEichler_modified_graph_nonneg hE S hS W
      (fun w ↦ (hw w).1) ha hz K G (fun r ↦ η ⟨r, b4cov_lineEquiv hE 1⟩)
      F hF (f p) p hp hGe hK T hTa hT0) hTa.deriv.meromorphicOrderAt_nonneg
  have hGa : AnalyticAt ℂ (fun z ↦ (G (k z)).elim 0 id - (G (f (k z))).elim 0 id) 0 :=
    (RiemannRochEichler_functionLocal_analytic hE G p hGp).sub
      (RiemannRochEichler_scalar_pullback_analytic hE (fun x ↦ (G x).elim 0 id) f hf p
        (RiemannRochEichler_functionLocal_analytic hE G (f p) hGe))
  have hk0 : k 0 = p := by simp [k, extChartAt_to_inv]
  have hG0 : (G (k 0)).elim 0 id - (G (f (k 0))).elim 0 id ≠ 0 := by
    rw [hk0]
    exact sub_ne_zero.mpr hsep
  have hG : ∀ᶠ z in 𝓝[≠] (0 : ℂ), (G (k z)).elim 0 id ≠ (G (f (k z))).elim 0 id :=
    (hGa.continuousAt.eventually_ne hG0).filter_mono nhdsWithin_le_nhds |>.mono
      (fun z hz ↦ sub_ne_zero.mp hz)
  have hη : ∀ᶠ z in 𝓝[≠] (0 : ℂ), HurwitzPrymRR_loc hE η p z ≠ 0 :=
    (hηa.continuousAt.eventually_ne hη0).filter_mono nhdsWithin_le_nhds
  have hD : AnalyticAt ℂ D 0 := hηa.mul hGa
  have hD0 : D 0 ≠ 0 := mul_ne_zero hη0 hG0
  have hDo : meromorphicOrderAt D 0 = 0 := by
    rw [hD.meromorphicOrderAt_eq, hD.analyticOrderAt_eq_zero.mpr hD0]
    rfl
  have hpoints : ∀ᶠ z in 𝓝[≠] (0 : ℂ), k z ∈ Sᶜ ∧ f (k z) ∈ Sᶜ ∧ k z ≠ f (k z) := by
    filter_upwards [RiemannRochEichler_coordinate_avoid_finite hE (S ∪ f ⁻¹' S)
      (hS.union (Set.Finite.preimage hfi.injOn hS)) p, hG] with z hz hg
    refine ⟨fun h ↦ hz (Or.inl h), fun h ↦ hz (Or.inr h), ?_⟩
    exact fun h ↦ hg (congrArg (fun x ↦ (G x).elim 0 id) h)
  have he := RiemannRochEichler_graph_modified_product_charts hE (fun x ↦ (K x).1)
    (fun y ↦ (F y).1) (fun x ↦ (K x).property.1) (fun y ↦ (hw (F y)).1)
    η η.property.1 (fun x ↦ (G x).elim 0 id) Sᶜ
    (fun x hx y hy hxy ↦ by simpa only [RiemannRochEichler_loc_zero] using hF y hy x hx hxy)
    f hf p (f p) rfl hpoints
  have hc := RiemannRochEichler_graph_coordinates hE f hf p (f p) rfl
  have hquot : 0 ≤ meromorphicOrderAt (N / D) 0 := by
    rw [meromorphicOrderAt_div hN hD.meromorphicAt, hDo, sub_zero]
    exact hNo
  suffices heq : N / D =ᶠ[𝓝[≠] (0 : ℂ)] HurwitzPrymRR_loc hE
      (fun t : TangentBundle 𝓘(ℂ, E) C ↦ K t.1
        ⟨f t.1, mfderiv 𝓘(ℂ, E) 𝓘(ℂ, E) f t.1 t.2⟩) p by
    rwa [← meromorphicOrderAt_congr heq]
  filter_upwards [he, nhdsWithin_le_nhds hc, hη, hG] with z he hc hη hg
  have hdn : D z ≠ 0 := mul_ne_zero hη (sub_ne_zero.mpr hg)
  change N z / D z = _
  change N z = _ at he
  change j (T z) = f (k z) at hc
  change N z = HurwitzPrymRR_loc hE
    (fun t : TangentBundle 𝓘(ℂ, E) C ↦ K t.1
      ⟨f t.1, mfderiv 𝓘(ℂ, E) 𝓘(ℂ, E) f t.1 t.2⟩) p z *
    (HurwitzPrymRR_loc hE η p z * ((G (k z)).elim 0 id - (G (j (T z))).elim 0 id)) at he
  rw [hc] at he
  change N z = _ * D z at he
  rw [he, mul_div_cancel_right₀ _ hdn]


/-- The normalized graph differential has no pole away from its exceptional points. -/
lemma RiemannRochEichler_normalized_graph_nonneg
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) {ι : Type} [Fintype ι]
    (a : ι → C) (ha : Function.Injective a) (b : Module.Basis ι ℂ (b3_HolForm E C))
    (hb : ∀ i j, RiemannRochEichler_eval hE (a i) (b j) = if i = j then 1 else 0)
    (q : C) (hq : q ∉ Set.range a)
    (K : C → b4c_MeroForm E C hE)
    (hK : ∀ p, p ∉ Set.range a → p ≠ q →
      b4c_res (hE := hE) (K p) p = -1 ∧ b4c_res (hE := hE) (K p) q = 1 ∧
      (∀ x, (-1 : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (K p) x) 0) ∧
      (∀ x, x ≠ p → x ≠ q → AnalyticAt ℂ (HurwitzPrymRR_loc hE (K p) x) 0) ∧
      ∀ i, K p ⟨a i, b4cov_lineEquiv hE 1⟩ = 0)
    (f : C ≃ₜ C) (hf : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω f)
    (p : C) (hp : p ∉ Set.range a) (hpq : p ≠ q)
    (hfp : f p ≠ p) (hfq : f p ≠ q) :
    0 ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE
      (fun t : TangentBundle 𝓘(ℂ, E) C ↦ K t.1
        ⟨f t.1, mfderiv 𝓘(ℂ, E) 𝓘(ℂ, E) f t.1 t.2⟩) p) 0 := by
  classical
  have hnorm : ∀ p, p ∉ Set.range a → p ≠ q →
      b4c_res (hE := hE) (K p) p = -1 ∧ b4c_res (hE := hE) (K p) q = 1 ∧
      (∀ x, (-1 : WithTop ℤ) ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (K p) x) 0) ∧
      (∀ x, x ≠ p → x ≠ q → 0 ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE (K p) x) 0) ∧
      (∀ i, AnalyticAt ℂ (HurwitzPrymRR_loc hE (K p) (a i)) 0) ∧
      ∀ i, K p ⟨a i, b4cov_lineEquiv hE 1⟩ = 0 := by
    intro p hp hpq
    obtain ⟨h₁, h₂, h₃, h₄, h₅⟩ := hK p hp hpq
    exact ⟨h₁, h₂, h₃, fun x hxp hxq ↦ (h₄ x hxp hxq).meromorphicOrderAt_nonneg,
      fun i ↦ h₄ (a i) (fun h ↦ hp ⟨i, h⟩) (fun h ↦ hq ⟨i, h⟩), h₅⟩
  obtain ⟨G, η, S, N, M, hAS, hGp, hGe, hηa, hη0, hpS, hGo, hGout, hηo, hηout⟩ :=
    RiemannRochEichler_off_diagonal_kernel_data hE (Set.range a ∪ {q})
      ((Set.finite_range a).union (Set.finite_singleton q)) p (f p) hfp.symm
  have hSa : ∀ i, a i ∈ S := fun i ↦ hAS (Or.inl ⟨i, rfl⟩)
  have hSq : q ∈ S := hAS (Or.inr rfl)
  have hpout : p ∉ S := hpS (fun h ↦ h.elim hp hpq)
  have hFA (y : C) (hy : y ∉ S) : y ∉ Set.range a := by
    rintro ⟨i, rfl⟩
    exact hy (hSa i)
  have hFq (y : C) (hy : y ∉ S) : y ≠ q := fun he ↦ hy (he ▸ hSq)
  obtain ⟨W, hfin, F, hW, hrep, _⟩ :=
    RiemannRochEichler_joint_modified_kernel_family hE a ha b hb q hq K hK
      S hSa hSq G N M hGo hGout η hηo hηout
  letI : Module.Finite ℂ W := hfin
  have hF : ∀ y ∉ S, ∀ r ∉ S, r ≠ y →
      (F y).1 ⟨r, b4cov_lineEquiv hE 1⟩ = HurwitzPrymRR_loc hE (K r) y 0 *
        ((G r).elim 0 id - (G y).elim 0 id) * η ⟨r, b4cov_lineEquiv hE 1⟩ := by
    intro y hy r hr hry
    have hv := RiemannRochEichler_modified_representative_value hE a ha b hb q y hq
      (hFA y hy) (hFq y hy) K hnorm r (hFA r hr) (hFq r hr) hry G (hGout r hr)
      η (hηout r hr) (F y).1 ((hW _ (F y).property).2.1 r hr) (hrep y hy r)
    rw [RiemannRochEichler_residue_germ_value
      ((hK r (hFA r hr) (hFq r hr)).2.2.2.1 y (Ne.symm hry) (hFq y hy))
      Filter.EventuallyEq.rfl] at hv
    exact hv
  apply RiemannRochEichler_graph_nonneg_of_modified hE (S : Set C) S.finite_toSet W
    (fun w ↦ (hW w.1 w.property).1) (fun w ↦ (hW w.1 w.property).2.1)
    (fun w ↦ (hW w.1 w.property).2.2) K G η F hF f hf f.injective p hpout hηa hη0
    (by rw [hGp]; exact OnePoint.coe_ne_infty _) (by rw [hGe]; exact OnePoint.coe_ne_infty _)
    (by rw [hGp, hGe]; exact zero_ne_one)
  intro r hr hre
  exact (hK r (hFA r hr) (hFq r hr)).2.2.2.1 (f p) hre.symm hfq


structure b4c_GenusZeroMapData (E C : Type) [NormedAddCommGroup E] [NormedSpace ℂ E]
    [TopologicalSpace C] [ChartedSpace E C] [IsManifold 𝓘(ℂ, E) ω C] where
  toFun : C → OnePoint ℂ
  contMDiff_toFun : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω toFun
  bijective : Function.Bijective toFun
  ramIndex_one : ∀ x, b4_ramIndex E ℂ toFun x = 1

noncomputable def b4c_genusZeroMapData [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (hg : Module.finrank ℂ (b3_HolForm E C) = 0) :
    b4c_GenusZeroMapData E C := by
  let p₀ : C := Classical.choice (inferInstance : Nonempty C)
  let p : Fin (Module.finrank ℂ (b3_HolForm E C) + 1) → C := fun _ ↦ p₀
  have hp : Function.Injective p := by
    intro i j _
    apply Fin.eq_of_val_eq
    omega
  let hex := b4c_exists_meroFun_aux hE p hp
  let f := Classical.choose hex
  have hfSpec := Classical.choose_spec hex
  have hnc := hfSpec.1
  have hord := hfSpec.2
  change ∃ x y, f x ≠ f y at hnc
  change ∀ x, -(1 : ℤ) ≤ b4c_ord E f x ∧
    (x ∉ Set.range p → 0 ≤ b4c_ord E f x) at hord
  have hf := f.2.1
  have hsurj : Function.Surjective f := b4cov_surjective (by simp) f hf hnc
  let xInf := Classical.choose (hsurj OnePoint.infty)
  have hxInf := Classical.choose_spec (hsurj OnePoint.infty)
  have hinf0 : OnePoint.infty ≠ ((0 : ℂ) : OnePoint ℂ) := (OnePoint.coe_ne_infty 0).symm
  have hxInf0 : f xInf ≠ ((0 : ℂ) : OnePoint ℂ) := by rw [hxInf]; exact hinf0
  have hxInfRange : xInf ∈ Set.range p := by
    by_contra hx
    have hord0 := (hord xInf).2 hx
    have hpos : 1 ≤ b4_ramIndex E ℂ f xInf := b4cov_ramIndex_pos f hf hnc xInf
    simp only [b4c_ord] at hord0
    rw [hxInf] at hord0
    simp at hord0
    omega
  have hxInfP : xInf = p₀ := by
    let i := Classical.choose hxInfRange
    have hi := Classical.choose_spec hxInfRange
    simpa [p] using hi.symm
  have hramInf : b4_ramIndex E ℂ f xInf = 1 := by
    have hlower := (hord xInf).1
    have hpos : 1 ≤ b4_ramIndex E ℂ f xInf := b4cov_ramIndex_pos f hf hnc xInf
    simp only [b4c_ord] at hlower
    rw [hxInf] at hlower
    simp at hlower
    exact Nat.le_antisymm hlower hpos
  have hfiberInf : f ⁻¹' {OnePoint.infty} = {xInf} := by
    ext x
    simp only [Set.mem_preimage, Set.mem_singleton_iff]
    constructor
    · intro hx
      have hxrange : x ∈ Set.range p := by
        by_contra hxr
        have hord0 := (hord x).2 hxr
        have hpos : 1 ≤ b4_ramIndex E ℂ f x := b4cov_ramIndex_pos f hf hnc x
        have hx0 : f x ≠ ((0 : ℂ) : OnePoint ℂ) := by rw [hx]; exact hinf0
        simp only [b4c_ord] at hord0
        rw [hx] at hord0
        simp at hord0
        omega
      let i := Classical.choose hxrange
      have hi := Classical.choose_spec hxrange
      have hxp : x = p₀ := by simpa [p] using hi.symm
      exact hxp.trans hxInfP.symm
    · rintro rfl
      exact hxInf
  have hdegInf : b4_fiberDegree E ℂ f OnePoint.infty = 1 := by
    simp [b4_fiberDegree, hfiberInf, hramInf]
  have hdeg (y : OnePoint ℂ) : b4_fiberDegree E ℂ f y = 1 :=
    (b4cov_fiberDegree_eq hE (by simp) f hf hnc y OnePoint.infty).trans hdegInf
  have hram (x : C) : b4_ramIndex E ℂ f x = 1 := by
    have hfin := b4cov_fiber_finite hE f hf hnc (f x)
    have hxmem : x ∈ f ⁻¹' {f x} := by simp
    have hle : b4_ramIndex E ℂ f x ≤ b4_fiberDegree E ℂ f (f x) := by
      rw [b4_fiberDegree]
      rw [finsum_mem_def]
      have hsupp : Function.HasFiniteSupport
          (fun z ↦ if z ∈ f ⁻¹' {f x} then b4_ramIndex E ℂ f z else 0) := by
        apply hfin.subset
        intro z hz
        by_contra hzm
        change (if z ∈ f ⁻¹' {f x} then b4_ramIndex E ℂ f z else 0) ≠ 0 at hz
        rw [if_neg hzm] at hz
        exact hz rfl
      simpa [Set.indicator, hxmem] using
        single_le_finsum x hsupp (fun z ↦ by positivity)
    rw [hdeg] at hle
    exact Nat.le_antisymm hle (b4cov_ramIndex_pos f hf hnc x)
  have hcard (y : OnePoint ℂ) : (f ⁻¹' {y}).ncard = 1 := by
    rw [← hdeg y, b4_fiberDegree, ← finsum_one]
    exact finsum_mem_congr rfl fun x _ ↦ (hram x).symm
  have hinj : Function.Injective f := by
    intro x x' hxx'
    let a := Classical.choose (Set.ncard_eq_one.mp (hcard (f x)))
    have ha := Classical.choose_spec (Set.ncard_eq_one.mp (hcard (f x)))
    have hx : x ∈ f ⁻¹' {f x} := by simp
    have hx' : x' ∈ f ⁻¹' {f x} := by simpa [hxx']
    rw [ha] at hx hx'
    simpa using hx.trans hx'.symm
  exact ⟨f, hf, ⟨hinj, hsurj⟩, hram⟩

/-- RiemannRochAna: an effective divisor has nonnegative degree. -/
theorem RiemannRochAna_deg_nonneg (D : C →₀ ℤ) (hD : ∀ x, 0 ≤ D x) :
    0 ≤ b4c_deg D := by
  classical
  exact Finset.sum_nonneg fun x _ ↦ hD x

/-- RiemannRochAna: a nonzero bounded meromorphic function forces the
bounding divisor to have nonnegative degree. -/
theorem RiemannRochAna_deg_nonneg_of_bounded_meroFun
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ) (F : b4c_MeroFun E C)
    (hFn : ∃ x, F x ≠ (0 : ℂ))
    (hbound : ∀ x, 0 ≤ b4c_ord E F x + D x) :
    0 ≤ b4c_deg D := by
  have he : ∀ x, 0 ≤ (b4c_div E F + D) x := by
    intro x
    simpa only [Finsupp.add_apply, RiemannRochAna_div_apply_of_finite F
      (b4c_meroFun_orderSupport_finite_aux hE F) x] using hbound x
  have hd := RiemannRochAna_deg_nonneg (b4c_div E F + D) he
  rwa [RiemannRochAna_deg_add, b4c_deg_div_meroFun_aux hE F hFn, zero_add] at hd

/-- RiemannRochAna: a divisor of negative degree has zero section space. -/
theorem RiemannRochAna_L_eq_bot_of_deg_neg
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ) (hD : b4c_deg D < 0) :
    b4c_L (E := E) D = ⊥ := by
  apply le_antisymm _ bot_le
  intro g hg
  have hm : g ∈ (b4c_L (E := E) D : Set _) := hg
  rw [b4c_L_eq_restrictions_aux hE D] at hm
  rcases hm with rfl | ⟨F, hFn, _, hbound, _⟩
  · exact Submodule.zero_mem _
  · exact (not_le_of_gt hD
      (RiemannRochAna_deg_nonneg_of_bounded_meroFun hE D F hFn hbound)).elim

/-- RiemannRochAna: when both form germs have finite order, the integer
order of their local quotient is the difference of the form orders. -/
theorem RiemannRochAna_hol_div_form_local_untop
    (hE : Module.finrank ℂ E = 1) (θ : b3_HolForm E C)
    (w : b4c_MeroForm E C hE) (x : C)
    (hθ : meromorphicOrderAt (HurwitzPrymRR_loc hE θ x) 0 ≠ ⊤)
    (hw : meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 ≠ ⊤) :
    (meromorphicOrderAt (fun z : ℂ ↦
        HurwitzPrymRR_loc hE θ x z / HurwitzPrymRR_loc hE w x z) 0).untop₀ =
      b4c_ordForm (hE := hE) θ x - b4c_ordForm (hE := hE) w x := by
  rw [RiemannRochAna_hol_div_form_local_order]
  let a := (meromorphicOrderAt (HurwitzPrymRR_loc hE θ x) 0).untop₀
  let b := (meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0).untop₀
  have ha : meromorphicOrderAt (HurwitzPrymRR_loc hE θ x) 0 =
      (a : WithTop ℤ) := (WithTop.coe_untop₀_of_ne_top hθ).symm
  have hb : meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 =
      (b : WithTop ℤ) := (WithTop.coe_untop₀_of_ne_top hw).symm
  change (meromorphicOrderAt (HurwitzPrymRR_loc hE θ x) 0 -
      meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0).untop₀ = a - b
  rw [ha, hb]
  rfl

/-- RiemannRochAna: integer divisor bounds characterize nonzero forms in
the effective residue kernel. -/
theorem RiemannRochAna_mem_holKernel_iff_divisor_bound
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (hD : ∀ x, 0 ≤ D x) (θ : b3_HolForm E C) (hθ : θ ≠ 0) :
    θ ∈ LinearMap.ker (RiemannRochAna_holPrincipalResidueLinear hE D) ↔
      ∀ x, D x ≤ b4c_ordForm (hE := hE) θ x := by
  constructor
  · exact RiemannRochAna_holKernel_divisor_bound hE D hD θ hθ
  · intro hb
    apply (RiemannRochAna_mem_holPrincipalResidueKernel_iff_meromorphicOrder
      hE D hD θ).mpr
    intro i
    exact (RiemannRochAna_le_hol_order_iff_le_ordForm hE θ i.1 (D i.1)
      (RiemannRochAna_hol_order_ne_top hE θ hθ i.1)).mpr (hb i.1)

/-- RiemannRochAna: the canonical bound on a form ratio detects exactly
the holomorphic forms annihilating effective principal residues. -/
theorem RiemannRochAna_mem_holKernel_iff_ratio_bound
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ)
    (hD : ∀ x, 0 ≤ D x) (θ : b3_HolForm E C) (hθ : θ ≠ 0)
    (w : b4c_MeroForm E C hE)
    (hw : (w : TangentBundle 𝓘(ℂ, E) C → ℂ) ≠ 0)
    (hgw : ∃ x, meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 ≠ ⊤) :
    θ ∈ LinearMap.ker (RiemannRochAna_holPrincipalResidueLinear hE D) ↔
      ∀ x, 0 ≤ b4c_ord E (b4c_formRatio (hE := hE) θ w) x +
        (b4c_divForm (hE := hE) w - D) x := by
  rw [RiemannRochAna_mem_holKernel_iff_divisor_bound hE D hD θ hθ]
  apply forall_congr'
  intro x
  rw [RiemannRochAna_formRatio_ord hE θ hθ w hw hgw x,
    RiemannRochAna_hol_ratio_add_canonical_sub hE θ w
      (b4c_meroForm_orderSupport_finite_aux hE w) D x]
  exact sub_nonneg.symm

/-- RiemannRochAna: taking the centered coefficient of a chart
differential recovers its defining scalar germ. -/
theorem RiemannRochAna_chartDifferential_loc
    (hE : Module.finrank ℂ E = 1) (x : C) (g : ℂ → ℂ) :
    HurwitzPrymRR_loc hE (RiemannRochAna_chartDifferential hE x g) x =ᶠ[𝓝 0] g := by
  let φ := extChartAt 𝓘(ℂ, E) x
  let L := b4cov_lineEquiv hE
  have hc : Continuous (fun z : ℂ ↦ φ x + L z) :=
    continuous_const.add L.continuous
  have htarget : φ.target ∈ 𝓝 (φ x) :=
    (isOpen_extChartAt_target (I := 𝓘(ℂ, E)) x).mem_nhds
      (mem_extChartAt_target (I := 𝓘(ℂ, E)) x)
  have ht : ∀ᶠ z : ℂ in 𝓝 0, φ x + L z ∈ φ.target :=
    hc.continuousAt.preimage_mem_nhds (by
      simpa only [map_zero, add_zero] using htarget)
  filter_upwards [ht] with z hz
  have hy : φ.symm (φ x + L z) ∈ φ.source := φ.map_target hz
  dsimp only [HurwitzPrymRR_loc, b4cov_coef, RiemannRochAna_chartDifferential]
  rw [Bundle.Trivialization.linearMapAt_apply,
    if_pos (b4cov_mem_baseSet x _ hy), b4cov_triv_vec x _ hy]
  change g (L.symm (φ (φ.symm (φ x + L z)) - φ x)) * L.symm (L 1) = g z
  rw [φ.right_inv hz, add_sub_cancel_left, L.symm_apply_apply, L.symm_apply_apply, mul_one]

/-- RiemannRochAna: section dimensions increase with the divisor. -/
theorem RiemannRochAna_L_finrank_mono
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D B : C →₀ ℤ) (hDB : ∀ x, D x ≤ B x) :
    Module.finrank ℂ (b4c_L (E := E) D) ≤
      Module.finrank ℂ (b4c_L (E := E) B) := by
  classical
  let S := D.support ∪ B.support
  have hDS : D.support ⊆ S := Finset.subset_union_left
  have hBS : B.support ⊆ S := Finset.subset_union_right
  let f := RiemannRochAna_L_restrictOffFinset (E := E) D S hDS
  let g := RiemannRochAna_L_restrictOffFinset (E := E) B S hBS
  letI := RiemannRochAna_L_finite hE B
  let eD := LinearEquiv.ofInjective f
    (RiemannRochAna_L_restrictOffFinset_injective hE D S hDS)
  let eB := LinearEquiv.ofInjective g
    (RiemannRochAna_L_restrictOffFinset_injective hE B S hBS)
  rw [eD.finrank_eq, eB.finrank_eq]
  exact Submodule.finrank_mono
    (RiemannRochAna_L_restriction_range_mono hE D B hDB S hDS hBS)

/-- RiemannRochAna: each nonnegative local Laurent coefficient is a
linear functional on a divisor's section space. -/
noncomputable def RiemannRochAna_L_coefficientLinear
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ) (x : C) (n : ℕ) :
    b4c_L (E := E) D →ₗ[ℂ] ℂ where
  toFun g := residue (fun z : ℂ ↦ RiemannRochAna_L_scalarLinear D g
    ((extChartAt 𝓘(ℂ, E) x).symm
      (extChartAt 𝓘(ℂ, E) x x + b4cov_lineEquiv hE z)) / z ^ (n + 1)) 0
  map_add' g h := by
    simp only [map_add, Pi.add_apply, add_div]
    exact residue_add
      ((RiemannRochAna_L_scalar_meromorphic hE D g x).div
        ((analyticAt_id (𝕜 := ℂ)).pow (n + 1)).meromorphicAt)
      ((RiemannRochAna_L_scalar_meromorphic hE D h x).div
        ((analyticAt_id (𝕜 := ℂ)).pow (n + 1)).meromorphicAt)
  map_smul' a g := by
    simp only [map_smul, Pi.smul_apply, RingHom.id_apply, smul_eq_mul,
      mul_div_assoc, residue_const_mul]

/-- RiemannRochAna: the principal-class cokernel and the kernel of its dual
have the same dimension. -/
theorem RiemannRochAna_principalClass_cokernel_eq_dualKernel
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (D : C →₀ ℤ) :
    Module.finrank ℂ
        (b4c_Dolbeault01 E C ⧸
          LinearMap.range (RiemannRochAna_principalClassLinear hE D)) =
      Module.finrank ℂ
        (LinearMap.ker (RiemannRochAna_principalClassLinear hE D).dualMap) := by
  letI := (b4c_dolbeault_finite_aux (E := E) (C := C) hE).1
  have hq := (LinearMap.range
    (RiemannRochAna_principalClassLinear hE D)).finrank_quotient_add_finrank
  have hk := LinearMap.finrank_range_add_finrank_ker
    (RiemannRochAna_principalClassLinear hE D).dualMap
  rw [Subspace.dual_finrank_eq,
    LinearMap.finrank_range_dualMap_eq_finrank_range] at hk
  omega

end RiemannRochAnaMeromorphicDifferential
theorem b4c_deg_canonical_aux [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (w : b4c_MeroForm E C hE)
    (hw : (w : TangentBundle 𝓘(ℂ, E) C → ℂ) ≠ 0)
    (hgw : ∃ x, meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 ≠ ⊤) :
    b4c_deg (b4c_divForm (hE := hE) w) =
      2 * (Module.finrank ℂ (b3_HolForm E C) : ℤ) - 2 := by
  have hK := b4c_riemannRoch_aux hE (b4c_divForm (hE := hE) w) w hw hgw
  have h0 := b4c_riemannRoch_aux hE (0 : C →₀ ℤ) w hw hgw
  rw [sub_self] at hK
  have hdeg0 : b4c_deg (0 : C →₀ ℤ) = 0 := by simp [b4c_deg]
  rw [hdeg0] at h0
  rw [sub_zero] at h0
  omega

theorem b4c_genusZero_equiv_aux [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (hg : Module.finrank ℂ (b3_HolForm E C) = 0) :
    ∃ e : C ≃ₜ OnePoint ℂ, ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω e ∧
      ContMDiff 𝓘(ℂ, ℂ) 𝓘(ℂ, E) ω e.symm := by
  let d := b4c_genusZeroMapData hE hg
  let e : C ≃ₜ OnePoint ℂ := d.contMDiff_toFun.continuous.homeoOfEquivCompactToT2
    (f := Equiv.ofBijective d.toFun d.bijective)
  refine ⟨e, d.contMDiff_toFun, ?_⟩
  have hfd : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω e := d.contMDiff_toFun
  have hram : ∀ x, b4_ramIndex E ℂ e x = 1 := d.ramIndex_one
  have hEfd : FiniteDimensional ℂ E := Module.finite_of_finrank_eq_succ hE
  letI : FiniteDimensional ℂ E := hEfd
  letI : CompleteSpace E := FiniteDimensional.complete ℂ E
  intro y
  let x := e.symm y
  have hexy : e x = y := e.apply_symm_apply y
  have hDne : mfderiv 𝓘(ℂ, E) 𝓘(ℂ, ℂ) e x ≠ 0 :=
    (b4cov_ramIndex_eq_one_iff e hfd x).mp (hram x)
  have hsrc : x ∈ (chartAt E x).source := mem_chart_source E x
  have htgt : y ∈ (chartAt ℂ y).source := mem_chart_source ℂ y
  let q : OpenPartialHomeomorph E ℂ :=
    ((chartAt E x).symm.trans e.toOpenPartialHomeomorph).trans (chartAt ℂ y)
  have ha : chartAt E x x ∈ q.source := by
    simp [q, hsrc, hexy]
  have hqa : q (chartAt E x x) = chartAt ℂ y y := by
    simp [q, hexy, hsrc, htgt]
  have hqt : chartAt ℂ y y ∈ q.target := by
    rw [← hqa]
    exact q.map_source ha
  have han : AnalyticAt ℂ q (chartAt E x x) := by
    have h := b4cov_analyticAt_chart e hfd x y (chartAt E x x)
      ((extChartAt 𝓘(ℂ, E) x).map_source (by rw [extChartAt_source]; exact hsrc))
      (by simpa [hexy] using htgt)
    simpa [q, extChartAt_coe, extChartAt_coe_symm] using h
  have hqDne : fderiv ℂ q (chartAt E x x) ≠ 0 := by
    have h := (b4cov_mfderiv_eq_zero_iff e hfd x x (by rw [extChartAt_source]; exact hsrc)
      (by simpa [hexy] using htgt)).not.mp hDne
    simpa [q, hexy, extChartAt_coe, extChartAt_coe_symm] using h
  have hbij := b4cov_bijective_of_ne_zero hE (by simp) _ hqDne
  let De : E ≃L[ℂ] ℂ :=
    (LinearEquiv.ofBijective (fderiv ℂ q (chartAt E x x) : E →ₗ[ℂ] ℂ) hbij).toContinuousLinearEquiv
  have hder : HasFDerivAt q (De : E →L[ℂ] ℂ) (chartAt E x x) := by
    have h := han.differentiableAt.hasFDerivAt
    convert h using 1
    ext v
    rfl
  have hqi : ContDiffAt ℂ ω q.symm (chartAt ℂ y y) := by
    rw [← hqa]
    have hsymm : q.symm (q (chartAt E x x)) = chartAt E x x := q.left_inv ha
    exact q.contDiffAt_symm (q.map_source ha) (by simpa [hsymm] using hder)
      (by simpa [hsymm] using han.contDiffAt)
  apply (contMDiffAt_iff_of_mem_source htgt hsrc).2
  refine ⟨e.symm.continuous.continuousAt, ?_⟩
  have heq : Filter.EventuallyEq (nhds (chartAt ℂ y y))
      (writtenInExtChartAt 𝓘(ℂ, ℂ) 𝓘(ℂ, E) y e.symm) q.symm := by
    filter_upwards [q.open_target.mem_nhds hqt] with z hz
    simp [q, x, extChartAt_coe, extChartAt_coe_symm]
  exact (hqi.congr_of_eventuallyEq heq).contDiffWithinAt

theorem b4c_riemannHurwitz_aux [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) {E' Y : Type} [NormedAddCommGroup E'] [NormedSpace ℂ E']
    [TopologicalSpace Y] [ChartedSpace E' Y] [IsManifold 𝓘(ℂ, E') ω Y] [T2Space Y]
    [CompactSpace Y] [ConnectedSpace Y] (hE' : Module.finrank ℂ E' = 1) (f : C → Y)
    (hf : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E') ω f) (hnc : ∃ x x', f x ≠ f x') (y : Y) :
    2 * (Module.finrank ℂ (b3_HolForm E C) : ℤ) - 2 = b4_fiberDegree E E' f y *
      (2 * (Module.finrank ℂ (b3_HolForm E' Y) : ℤ) - 2) + ∑ᶠ x : C, ((b4_ramIndex E E' f x : ℤ) - 1) := by
  classical
  letI : FiniteDimensional ℂ E' := Module.finite_of_finrank_eq_succ hE'
  letI : CompleteSpace E' := FiniteDimensional.complete ℂ E'
  obtain ⟨w, hw, hgw⟩ := b4c_exists_meroForm_aux (C := Y) hE'
  let v : b4c_MeroForm E C hE := ⟨b4c_pullback (hE := hE) (hE' := hE') f w,
    b4c_pullback_isMeroForm_aux hE hE' f hf hnc w⟩
  let K := b4c_divForm (hE := hE') w
  have hK (x : Y) : ((K x : ℤ) : WithTop ℤ) =
      meromorphicOrderAt (HurwitzPrymRR_loc hE' w x) 0 :=
    RiemannRochAna_coe_divForm_apply hE' w
      (b4c_meroForm_orderSupport_finite_aux hE' w) x
      (b4c_meroForm_order_ne_top hE' w hgw x)
  have ho (x : C) : meromorphicOrderAt (HurwitzPrymRR_loc hE v x) 0 =
      ((K (f x) * (b4_ramIndex E E' f x : ℤ) +
        ((b4_ramIndex E E' f x : ℤ) - 1) : ℤ) : WithTop ℤ) := by
    have h := HurwitzPrymRR_ord_pullback hE hE' f hf hnc x w w.property.1
      (w.property.2 (f x))
    rw [← hK] at h
    simpa only [v, b4c_pullback, WithTop.coe_add, WithTop.coe_mul] using h
  have hvo (x : C) : meromorphicOrderAt (HurwitzPrymRR_loc hE v x) 0 ≠ ⊤ := by
    rw [ho]; exact WithTop.coe_ne_top
  have hgv : ∃ x, meromorphicOrderAt (HurwitzPrymRR_loc hE v x) 0 ≠ ⊤ :=
    ⟨Classical.arbitrary C, hvo (Classical.arbitrary C)⟩
  have hv : (v : TangentBundle 𝓘(ℂ, E) C → ℂ) ≠ 0 := by
    intro hh
    have ht := hvo (Classical.arbitrary C)
    rw [hh] at ht
    apply ht
    change meromorphicOrderAt (fun _ : ℂ ↦ (0 : ℂ)) 0 = ⊤
    rw [meromorphicOrderAt_const, if_pos rfl]
  let V := b4c_divForm (hE := hE) v
  have hdiv (x : C) : V x = K (f x) * (b4_ramIndex E E' f x : ℤ) +
      ((b4_ramIndex E E' f x : ℤ) - 1) := by
    apply WithTop.coe_injective
    exact (RiemannRochAna_coe_divForm_apply hE v
      (b4c_meroForm_orderSupport_finite_aux hE v) x (hvo x)).trans (ho x)
  let A : Y → C → ℤ := fun z x ↦ if f x = z then (b4_ramIndex E E' f x : ℤ) else 0
  have hAf (z : Y) : Function.HasFiniteSupport (A z) :=
    (b4cov_fiber_finite hE f hf hnc z).subset (by
      intro x hx
      by_contra hn
      exact hx (if_neg (by simpa only [Set.mem_preimage, Set.mem_singleton_iff] using hn)))
  have hAs (z : Y) : ∑ᶠ x, A z x = (b4_fiberDegree E E' f y : ℤ) := by
    rw [← b4cov_fiberDegree_eq hE hE' f hf hnc z y, b4_fiberDegree,
      Nat.cast_finsum_mem (b4cov_fiber_finite hE f hf hnc z), finsum_mem_def]
    apply finsum_congr
    intro x
    simp only [A, Set.indicator, Set.mem_preimage, Set.mem_singleton_iff]
  let P : C → ℤ := fun x ↦ K (f x) * (b4_ramIndex E E' f x : ℤ)
  have hP (x : C) : P x = ∑ z ∈ K.support, K z * A z x := by
    simp only [A, mul_ite, mul_zero]
    rw [Finset.sum_ite_eq]
    split_ifs with hx
    · rfl
    · simp only [P, Finsupp.notMem_support_iff.mp hx, zero_mul]
  have hPf : Function.HasFiniteSupport P := by
    have hh := Function.HasFiniteSupport.sum
      (fun z ↦ Function.HasFiniteSupport.mul_right (fun _ ↦ K z) (hAf z)) K.support
    simpa only [Pi.mul_apply, ← hP] using hh
  have hPs : ∑ᶠ x, P x = (b4_fiberDegree E E' f y : ℤ) * b4c_deg K := by
    simp_rw [hP]
    rw [finsum_sum_comm K.support (fun x z ↦ K z * A z x)
      (fun z _ ↦ Function.HasFiniteSupport.mul_right (fun _ ↦ K z) (hAf z))]
    simp_rw [← mul_finsum, hAs]
    rw [← Finset.sum_mul]
    exact mul_comm _ _
  have hVf : Function.HasFiniteSupport (fun x ↦ V x) := V.hasFiniteSupport
  have hRf : Function.HasFiniteSupport (fun x ↦ (b4_ramIndex E E' f x : ℤ) - 1) := by
    have hh := hVf.sub hPf
    convert hh using 1
    ext x
    dsimp only [P, Pi.sub_apply]
    rw [hdiv]
    ring
  have hVs : (∑ᶠ x, V x) = b4c_deg V := by
    exact finsum_eq_finsetSum_of_support_subset _ (by
      intro x hx
      exact Finsupp.mem_support_iff.mpr hx)
  have hsum : b4c_deg V = (b4_fiberDegree E E' f y : ℤ) * b4c_deg K +
      ∑ᶠ x : C, ((b4_ramIndex E E' f x : ℤ) - 1) := by
    rw [← hVs]
    simp_rw [hdiv]
    rw [finsum_add_distrib hPf hRf, hPs]
  rw [b4c_deg_canonical_aux hE v hv hgv,
    b4c_deg_canonical_aux hE' w hw hgw] at hsum
  exact hsum


