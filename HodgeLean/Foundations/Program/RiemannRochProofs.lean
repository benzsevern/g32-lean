/-- RiemannRochAna: the finite-value representative is the affine chart coordinate on its source. -/
theorem RiemannRochAna_finiteValue_chart0 (p : OnePoint ℂ) (hp : p ∈ b4cov_chart0.source) :
    p.elim 0 id = b4cov_chart0 p := by
  rw [b4cov_chart0_source] at hp
  obtain ⟨z, rfl⟩ := hp
  exact (b4cov_chart0_coe z).symm

/-- RiemannRochAna: the finite-value representative is the inverse reciprocal coordinate on its source. -/
theorem RiemannRochAna_finiteValue_chartInf (p : OnePoint ℂ) (hp : p ∈ b4cov_chartInf.source) :
    p.elim 0 id = (b4cov_chartInf p)⁻¹ := by
  induction p using OnePoint.rec with
  | infty =>
    rw [b4cov_chartInf_apply, b4cov_sphInv_infty, b4cov_chart0_coe]
    simp
  | coe z =>
    have hz : z ≠ 0 := b4cov_sphInv_ne_infty_iff z |>.mp (by
      simpa only [b4cov_chartInf_source, mem_ofPred_eq] using hp)
    rw [b4cov_chartInf_apply, b4cov_chart0_sphInv hz, inv_inv]
    rfl

/-- RiemannRochAna: the finite-value representative of an analytic sphere map is meromorphic in surface charts. -/
theorem RiemannRochAna_sphere_map_meromorphic
    (hE : Module.finrank ℂ E = 1) (F : C → OnePoint ℂ)
    (hF : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω F) (x : C) :
    MeromorphicAt (fun t : ℂ ↦ (F ((extChartAt 𝓘(ℂ, E) x).symm
      (extChartAt 𝓘(ℂ, E) x x + b4cov_lineEquiv hE t))).elim 0 id) 0 := by
  let φ := extChartAt 𝓘(ℂ, E) x
  let ψ := extChartAt 𝓘(ℂ, ℂ) (F x)
  let L := b4cov_lineEquiv hE
  let A := fun t : ℂ ↦ b4cov_expr E ℂ F x (F x) (φ x + L t)
  have hG := b4cov_analyticAt_chart F hF x (F x) (φ x) (mem_extChartAt_target x) (by
    rw [extChartAt_to_inv]; exact mem_extChartAt_source (F x))
  have hA : AnalyticAt ℂ A 0 := hG.comp_of_eq (analyticAt_const.add (L.analyticAt 0)) (by simp)
  have hs : ∀ᶠ y in 𝓝 x, F y ∈ ψ.source :=
    hF.continuous.continuousAt.preimage_mem_nhds
      ((isOpen_extChartAt_source (F x)).mem_nhds (mem_extChartAt_source (F x)))
  have ht := RiemannRochAna_inverse_coordinate_punctured hE x
    (hs.filter_mono nhdsWithin_le_nhds)
  by_cases hx : F x = OnePoint.infty
  · apply hA.meromorphicAt.inv.congr
    filter_upwards [ht] with t htp
    change (A t)⁻¹ = _
    have hψ : ∀ p : OnePoint ℂ, ψ p = b4cov_chartInf p := by
      intro p
      simp only [ψ, hx, extChartAt_coe, b4cov_chartAt_infty,
        modelWithCornersSelf_coe, Function.comp_apply, id_eq]
    have hp : F (φ.symm (φ x + L t)) ∈ b4cov_chartInf.source := by
      simpa only [mem_preimage, mem_ofPred_eq, φ, L, ψ, hx, extChartAt_source, b4cov_chartAt_infty] using htp
    change (ψ (F (φ.symm (φ x + L t))))⁻¹ = _
    rw [hψ]
    exact (RiemannRochAna_finiteValue_chartInf _ hp).symm
  · obtain ⟨a, ha⟩ := OnePoint.ne_infty_iff_exists.mp hx
    apply hA.meromorphicAt.congr
    filter_upwards [ht] with t htp
    have hψ : ∀ p : OnePoint ℂ, ψ p = b4cov_chart0 p := by
      intro p
      simp only [ψ, ← ha, extChartAt_coe, b4cov_chartAt_coe,
        modelWithCornersSelf_coe, Function.comp_apply, id_eq]
    have hp : F (φ.symm (φ x + L t)) ∈ b4cov_chart0.source := by
      simpa only [mem_preimage, mem_ofPred_eq, φ, L, ψ, ← ha, extChartAt_source, b4cov_chartAt_coe] using htp
    change ψ (F (φ.symm (φ x + L t))) = _
    rw [hψ]
    exact (RiemannRochAna_finiteValue_chart0 _ hp).symm

