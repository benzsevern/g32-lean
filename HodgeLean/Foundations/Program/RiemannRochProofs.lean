/-- RiemannRochAna: a smooth cutoff supported in a prescribed neighbourhood is one near its centre. -/
theorem RiemannRochAna_cutoff [T2Space C] (hE : Module.finrank ℂ E = 1)
    (x : C) {U : Set C} (hU : U ∈ 𝓝 x) :
    ∃ χ : C → ℝ, ContMDiff 𝓘(ℝ, E) 𝓘(ℝ, ℝ) ∞ χ ∧
      χ =ᶠ[𝓝 x] 1 ∧ tsupport χ ⊆ U := by
  letI : FiniteDimensional ℂ E := Module.finite_of_finrank_eq_succ hE
  letI : FiniteDimensional ℝ E := Module.Finite.trans ℂ E
  obtain ⟨χ, _, hχ⟩ := (SmoothBumpFunction.nhds_basis_tsupport
    (I := 𝓘(ℝ, E)) x).mem_iff.mp hU
  exact ⟨χ, χ.contMDiff, χ.eventuallyEq_one, hχ⟩

/-- RiemannRochAna: the centred scalar chart coordinate. -/
def RiemannRochAna_coordinate (hE : Module.finrank ℂ E = 1) (x y : C) : ℂ :=
  (b4cov_lineEquiv hE).symm (extChartAt 𝓘(ℂ, E) x y - extChartAt 𝓘(ℂ, E) x x)

/-- RiemannRochAna: the centred coordinate vanishes at its centre. -/
theorem RiemannRochAna_coordinate_self (hE : Module.finrank ℂ E = 1) (x : C) :
    RiemannRochAna_coordinate hE x x = 0 := by
  simp only [RiemannRochAna_coordinate, sub_self, map_zero]

/-- RiemannRochAna: within its chart the centred coordinate vanishes only at its centre. -/
theorem RiemannRochAna_coordinate_ne (hE : Module.finrank ℂ E = 1) (x y : C)
    (hy : y ∈ (extChartAt 𝓘(ℂ, E) x).source) (hne : y ≠ x) :
    RiemannRochAna_coordinate hE x y ≠ 0 := by
  intro hz
  have hh : extChartAt 𝓘(ℂ, E) x y = extChartAt 𝓘(ℂ, E) x x := by
    apply sub_eq_zero.mp
    exact (b4cov_lineEquiv hE).symm.injective (hz.trans (map_zero _).symm)
  exact hne ((extChartAt 𝓘(ℂ, E) x).injOn hy (mem_extChartAt_source x) hh)

/-- RiemannRochAna: the centred coordinate is analytic on its chart. -/
theorem RiemannRochAna_coordinate_analytic (hE : Module.finrank ℂ E = 1) (x y : C)
    (hy : y ∈ (extChartAt 𝓘(ℂ, E) x).source) :
    ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω (RiemannRochAna_coordinate hE x) y := by
  exact (b4cov_lineEquiv hE).symm.contDiff.contMDiff.contMDiffAt.comp y
    ((contMDiffAt_extChartAt' (by simpa only [extChartAt_source] using hy)).sub contMDiffAt_const)

/-- RiemannRochAna: a cutoff simple principal part is smooth away from its centre. -/
theorem RiemannRochAna_cutoff_principal_smooth [T2Space C]
    (hE : Module.finrank ℂ E = 1) (x : C) (χ : C → ℝ)
    (hχ : ContMDiff 𝓘(ℝ, E) 𝓘(ℝ, ℝ) ∞ χ)
    (hs : tsupport χ ⊆ (extChartAt 𝓘(ℂ, E) x).source) (y : C) (hy : y ≠ x) :
    ContMDiffAt 𝓘(ℝ, E) 𝓘(ℝ, ℂ) ∞
      (fun z ↦ (χ z : ℂ) / RiemannRochAna_coordinate hE x z) y := by
  by_cases hys : y ∈ tsupport χ
  · have hc := RiemannRochAna_coordinate_analytic hE x y (hs hys)
    have hcr : ContMDiffAt 𝓘(ℝ, E) 𝓘(ℝ, ℂ) ∞
        (RiemannRochAna_coordinate hE x) y :=
      (b3A_contMDiffWithinAt_real hc).of_le (by simp)
    exact (Complex.ofRealCLM.contMDiff.contMDiffAt.comp y hχ.contMDiffAt).mul
      ((contDiffAt_inv (𝕜 := ℝ) (RiemannRochAna_coordinate_ne hE x y (hs hys) hy)).contMDiffAt.comp y hcr)
  · apply (contMDiffAt_const (c := (0 : ℂ))).congr_of_eventuallyEq
    filter_upwards [notMem_tsupport_iff_eventuallyEq.mp hys] with z hz
    simp only [show χ z = 0 from hz, Complex.ofReal_zero, zero_div]

/-- RiemannRochAna: a cutoff simple principal part agrees with the reciprocal coordinate near its centre. -/
theorem RiemannRochAna_cutoff_principal_germ (hE : Module.finrank ℂ E = 1)
    (x : C) (χ : C → ℝ) (hχ : χ =ᶠ[𝓝 x] 1) :
    (fun z ↦ (χ z : ℂ) / RiemannRochAna_coordinate hE x z) =ᶠ[𝓝 x]
      (fun z ↦ (RiemannRochAna_coordinate hE x z)⁻¹) := by
  filter_upwards [hχ] with z hz
  simp only [show χ z = 1 from hz, Complex.ofReal_one, one_div]

/-- RiemannRochAna: cutoff simple principal parts have support inside the cutoff support. -/
theorem RiemannRochAna_cutoff_principal_support (hE : Module.finrank ℂ E = 1)
    (x : C) (χ : C → ℝ) :
    tsupport (fun z ↦ (χ z : ℂ) / RiemannRochAna_coordinate hE x z) ⊆ tsupport χ := by
  apply closure_mono
  intro z hz
  contrapose! hz
  simp only [Function.mem_support, not_not] at hz ⊢
  simp only [hz, Complex.ofReal_zero, zero_div]

