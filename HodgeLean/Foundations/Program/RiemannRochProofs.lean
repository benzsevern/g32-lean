set_option backward.isDefEq.respectTransparency false

/-- RiemannRochAna: the reciprocal sphere coordinate has identity derivative at its centre. -/
theorem RiemannRochAna_inverse_coe_derivative :
    (mfderiv 𝓘(ℂ, ℂ) 𝓘(ℂ, ℂ)
      (fun z : ℂ ↦ b4cov_sphInv (z : OnePoint ℂ)) 0 : ℂ →L[ℂ] ℂ) =
      ContinuousLinearMap.id ℂ ℂ := by
  have he : (fun z : ℂ ↦ b4cov_sphInv (z : OnePoint ℂ)) =
      (extChartAt 𝓘(ℂ, ℂ) (OnePoint.infty : OnePoint ℂ)).symm := by
    funext z
    simp only [extChartAt_coe_symm, b4cov_chartAt_infty,
      modelWithCornersSelf_coe_symm, Function.comp_apply, b4cov_chartInf_symm, id_eq]
  rw [he]
  have hh := mfderivWithin_range_extChartAt_symm (I := 𝓘(ℂ, ℂ))
    (x := (OnePoint.infty : OnePoint ℂ))
  have h0 : extChartAt 𝓘(ℂ, ℂ) (OnePoint.infty : OnePoint ℂ) OnePoint.infty = 0 := by
    change b4cov_chart0 (b4cov_sphInv OnePoint.infty) = 0
    rw [b4cov_sphInv_infty, b4cov_chart0_coe]
  rw [h0] at hh
  dsimp only [TangentSpace] at hh ⊢
  simpa only [modelWithCornersSelf_coe, Set.range_id, mfderivWithin_univ] using hh

/-- RiemannRochAna: the derivative of the centred coordinate is the inverse chosen tangent basis. -/
theorem RiemannRochAna_coordinate_derivative (hE : Module.finrank ℂ E = 1) (x : C) :
    (mfderiv 𝓘(ℂ, E) 𝓘(ℂ, ℂ) (RiemannRochAna_coordinate hE x) x : E →L[ℂ] ℂ) =
      (b4cov_lineEquiv hE).symm.toContinuousLinearMap := by
  have he := (contMDiffAt_extChartAt (I := 𝓘(ℂ, E)) (n := ω) (x := x)).mdifferentiableAt
    (by simp)
  have hd := he.hasMFDerivAt.sub (hasMFDerivAt_const (I := 𝓘(ℂ, E))
    (extChartAt 𝓘(ℂ, E) x x) x)
  have hL := ((b4cov_lineEquiv hE).symm.toContinuousLinearMap.hasFDerivAt
    (x := extChartAt 𝓘(ℂ, E) x x - extChartAt 𝓘(ℂ, E) x x)).hasMFDerivAt
  have hh := (hL.comp x hd).mfderiv
  simp only [mfderiv_extChartAt_self, sub_zero] at hh
  change (mfderiv 𝓘(ℂ, E) 𝓘(ℂ, ℂ) (RiemannRochAna_coordinate hE x) x : E →L[ℂ] ℂ) =
    (b4cov_lineEquiv hE).symm.toContinuousLinearMap.comp (ContinuousLinearMap.id ℂ E) at hh
  exact hh.trans (ContinuousLinearMap.comp_id _)

/-- RiemannRochAna: the reciprocal coordinate of a simple pole has nonzero derivative. -/
theorem RiemannRochAna_simple_pole_quotient_derivative
    (hE : Module.finrank ℂ E = 1) (x : C) (a : ℂ) (ha : a ≠ 0)
    (u : C → ℂ) (hu : ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω u x) :
    (mfderiv 𝓘(ℂ, E) 𝓘(ℂ, ℂ) (fun y ↦ RiemannRochAna_coordinate hE x y /
      (a - RiemannRochAna_coordinate hE x y * u y)) x : E →L[ℂ] ℂ) ≠ 0 := by
  let z := RiemannRochAna_coordinate hE x
  let d : C → ℂ := fun y ↦ a - z y * u y
  have hz := RiemannRochAna_coordinate_analytic hE x x (mem_extChartAt_source x)
  have hd : ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω d x := contMDiffAt_const.sub (hz.mul hu)
  have hdx : d x = a := by simp only [d, z, RiemannRochAna_coordinate_self, zero_mul, sub_zero]
  have hi : ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω (fun y ↦ (d y)⁻¹) x :=
    (contDiffAt_inv (𝕜 := ℂ) (hdx.trans_ne ha)).contMDiffAt.comp x hd
  let L : E →L[ℂ] ℂ := mfderiv 𝓘(ℂ, E) 𝓘(ℂ, ℂ) (fun y ↦ (d y)⁻¹) x
  have he : (mfderiv 𝓘(ℂ, E) 𝓘(ℂ, ℂ) (fun y ↦ z y * (d y)⁻¹) x : E →L[ℂ] ℂ) =
      z x • L + (d x)⁻¹ • (b4cov_lineEquiv hE).symm.toContinuousLinearMap := by
    have hh := ((hz.mdifferentiableAt (by simp)).hasMFDerivAt.mul
      (hi.mdifferentiableAt (by simp)).hasMFDerivAt).mfderiv
    dsimp only [TangentSpace] at hh ⊢
    simpa only [RiemannRochAna_coordinate_derivative, Pi.mul_def, z, L] using hh
  change (mfderiv 𝓘(ℂ, E) 𝓘(ℂ, ℂ) (fun y ↦ z y * (d y)⁻¹) x : E →L[ℂ] ℂ) ≠ 0
  rw [he]
  simp only [z, RiemannRochAna_coordinate_self, zero_smul, zero_add, hdx]
  intro hzero
  have hh := congrArg (fun L : E →L[ℂ] ℂ ↦ L (b4cov_lineEquiv hE 1)) hzero
  have hinv : a⁻¹ = 0 := by simpa using hh
  exact (inv_ne_zero ha) hinv

/-- RiemannRochAna: a reciprocal-coordinate germ with nonzero differential has ramification index one. -/
theorem RiemannRochAna_ramIndex_one_of_reciprocal_germ
    (f : C → OnePoint ℂ) (hf : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω f)
    (x : C) (q : C → ℂ) (hq : ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω q x)
    (hqx : q x = 0) (hdq : (mfderiv 𝓘(ℂ, E) 𝓘(ℂ, ℂ) q x : E →L[ℂ] ℂ) ≠ 0)
    (hg : f =ᶠ[𝓝 x] fun y ↦ b4cov_sphInv (q y : OnePoint ℂ)) :
    b4_ramIndex E ℂ f x = 1 := by
  apply (b4cov_ramIndex_eq_one_iff f hf x).mpr
  let F : C → OnePoint ℂ := fun y ↦ b4cov_sphInv (q y : OnePoint ℂ)
  have hF : (mfderiv 𝓘(ℂ, E) 𝓘(ℂ, ℂ) F x : E →L[ℂ] ℂ) =
      mfderiv 𝓘(ℂ, E) 𝓘(ℂ, ℂ) q x := by
    have hh := mfderiv_comp (I := 𝓘(ℂ, E)) (I' := 𝓘(ℂ, ℂ)) (I'' := 𝓘(ℂ, ℂ)) x
      (RiemannRochAna_inverse_coe_holomorphic.mdifferentiableAt (by simp))
      (hq.mdifferentiableAt (by simp))
    dsimp only [TangentSpace] at hh ⊢
    rw [hqx, RiemannRochAna_inverse_coe_derivative, ContinuousLinearMap.id_comp] at hh
    exact hh
  have he : (mfderiv 𝓘(ℂ, E) 𝓘(ℂ, ℂ) f x : E →L[ℂ] ℂ) =
      mfderiv 𝓘(ℂ, E) 𝓘(ℂ, ℂ) F x := by
    have hh := hg.mfderiv_eq (I := 𝓘(ℂ, E)) (I' := 𝓘(ℂ, ℂ))
    ext v
    exact congrArg (fun L : E →L[ℂ] ℂ ↦ L v) hh
  rw [he, hF]
  exact hdq

/-- RiemannRochAna: a nonzero simple principal part gives ramification index one at its pole. -/
theorem RiemannRochAna_ramIndex_one_of_simple_pole
    (hE : Module.finrank ℂ E = 1) (f : C → OnePoint ℂ)
    (hf : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω f) (x : C) (a : ℂ) (ha : a ≠ 0)
    (u : C → ℂ) (hu : ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω u x)
    (hfx : f x = OnePoint.infty)
    (hfg : ∀ᶠ y in 𝓝[≠] x,
      f y = ((a / RiemannRochAna_coordinate hE x y - u y : ℂ) : OnePoint ℂ)) :
    b4_ramIndex E ℂ f x = 1 := by
  let z := RiemannRochAna_coordinate hE x
  let d : C → ℂ := fun y ↦ a - z y * u y
  let q : C → ℂ := fun y ↦ z y / d y
  have hz := RiemannRochAna_coordinate_analytic hE x x (mem_extChartAt_source x)
  have hd : ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω d x := contMDiffAt_const.sub (hz.mul hu)
  have hd0 : d x ≠ 0 := by
    simpa only [d, z, RiemannRochAna_coordinate_self, zero_mul, sub_zero] using ha
  have hq : ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω q x :=
    hz.mul ((contDiffAt_inv (𝕜 := ℂ) hd0).contMDiffAt.comp x hd)
  have hqx : q x = 0 := by simp only [q, z, RiemannRochAna_coordinate_self, zero_div]
  apply RiemannRochAna_ramIndex_one_of_reciprocal_germ f hf x q hq hqx
    (RiemannRochAna_simple_pole_quotient_derivative hE x a ha u hu)
  have hsrc : (extChartAt 𝓘(ℂ, E) x).source ∈ 𝓝 x := by
    rw [extChartAt_source]
    exact (chartAt E x).open_source.mem_nhds (mem_chart_source E x)
  have hfg' := eventually_nhdsWithin_iff.mp hfg
  filter_upwards [hd.continuousAt.eventually_ne hd0, hsrc, hfg'] with y hdy hys hfy
  by_cases hy : y = x
  · subst y
    rw [hfx, hqx, b4cov_sphInv_zero]
  · have hzy : z y ≠ 0 := RiemannRochAna_coordinate_ne hE x y hys hy
    rw [hfy hy, b4cov_sphInv_coe (show q y ≠ 0 from div_ne_zero hzy hdy)]
    congr 1
    change a / z y - u y = (z y / (a - z y * u y))⁻¹
    field_simp

/-- RiemannRochAna: extending prescribed simple principal parts gives the corresponding divisor bounds. -/
theorem RiemannRochAna_sphere_extension_order [T2Space C]
    (hE : Module.finrank ℂ E = 1) {ι : Type} [Fintype ι]
    (p : ι → C) (hp : Function.Injective p) (c : ι → ℂ) (A : C → ℂ)
    (f : C → OnePoint ℂ) (hf : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω f)
    (hfdef : ∀ y, f y = if ∃ i, p i = y ∧ c i ≠ 0 then OnePoint.infty else (A y : OnePoint ℂ))
    (hloc : ∀ j, ∃ u : C → ℂ, ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω u (p j) ∧
      A =ᶠ[𝓝 (p j)] fun y ↦ c j / RiemannRochAna_coordinate hE (p j) y - u y) :
    ∀ x, -(1 : ℤ) ≤ b4c_ord E f x ∧ (x ∉ Set.range p → 0 ≤ b4c_ord E f x) := by
  intro x
  by_cases hzero : f x = (0 : ℂ)
  · simp only [b4c_ord, hzero, if_pos]
    constructor <;> intros <;> omega
  by_cases hinf : f x = OnePoint.infty
  · have hex : ∃ i, p i = x ∧ c i ≠ 0 := by
      by_contra hn
      rw [hfdef, if_neg hn] at hinf
      exact OnePoint.coe_ne_infty _ hinf
    obtain ⟨j, rfl, hcj⟩ := hex
    obtain ⟨u, hu, hAu⟩ := hloc j
    have htest := RiemannRochAna_pole_test_germ p hp c j
    have hfg : ∀ᶠ y in 𝓝[≠] (p j),
        f y = ((c j / RiemannRochAna_coordinate hE (p j) y - u y : ℂ) : OnePoint ℂ) := by
      filter_upwards [nhdsWithin_le_nhds htest, nhdsWithin_le_nhds hAu,
        self_mem_nhdsWithin] with y hy hAy hne
      have hn : ¬ ∃ i, p i = y ∧ c i ≠ 0 := fun h ↦ hne (hy.mp h).1
      rw [hfdef, if_neg hn, hAy]
    have hr := RiemannRochAna_ramIndex_one_of_simple_pole hE f hf (p j) (c j) hcj u hu hinf hfg
    simp only [b4c_ord, if_neg hzero, if_pos hinf, hr]
    refine ⟨by norm_num, ?_⟩
    intro hn
    exact (hn ⟨j, rfl⟩).elim
  · simp only [b4c_ord, if_neg hzero, if_neg hinf]
    constructor <;> intros <;> norm_num

/-- RiemannRochAna: the obstruction construction gives a nonconstant function with at most simple marked poles. -/
theorem RiemannRochAna_exists_meroFun_simple [T2Space C] [CompactSpace C]
    [ConnectedSpace C] (hE : Module.finrank ℂ E = 1)
    (p : Fin (Module.finrank ℂ (b3_HolForm E C) + 1) → C) (hp : Function.Injective p) :
    ∃ f : b4c_MeroFun E C, (∃ x y, f x ≠ f y) ∧
      ∀ x, -(1 : ℤ) ≤ b4c_ord E f x ∧ (x ∉ Set.range p → 0 ≤ b4c_ord E f x) := by
  obtain ⟨χ, hχ, c, ⟨j, hcj⟩, u, hu⟩ := RiemannRochAna_principal_obstruction_relation hE p hp
  let A : C → ℂ := fun z ↦ (∑ i, c i * ((χ i z : ℂ) /
    RiemannRochAna_coordinate hE (p i) z)) - (u : C → ℂ) z
  let f : C → OnePoint ℂ := fun y ↦
    if ∃ i, p i = y ∧ c i ≠ 0 then OnePoint.infty else (A y : OnePoint ℂ)
  have hloc (k) : ∃ v : C → ℂ, ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω v (p k) ∧
      A =ᶠ[𝓝 (p k)] fun y ↦ c k / RiemannRochAna_coordinate hE (p k) y - v y := by
    refine ⟨u, RiemannRochAna_potential_analytic_at_poles hE p χ
      (fun i ↦ ⟨(hχ i).2.1, (hχ i).2.2.2⟩) c u hu k, ?_⟩
    exact RiemannRochAna_corrected_principal_germ hE p χ
      (fun i ↦ ⟨(hχ i).2.1, (hχ i).2.2.2⟩) c u k
  have hfdef (y) : f y = if ∃ i, p i = y ∧ c i ≠ 0 then OnePoint.infty else (A y : OnePoint ℂ) := rfl
  have hf : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω f := by
    have hh := RiemannRochAna_sphere_extension hE p hp c A
      (fun y hy ↦ RiemannRochAna_corrected_principal_analytic hE p χ
        (fun i ↦ ⟨(hχ i).1, (hχ i).2.2.1⟩) c u hu y hy) hloc
    apply hh.congr
    intro y
    dsimp only [f]
    split_ifs <;> rfl
  have hout (y : C) (hy : y ∉ Set.range p) : f y ≠ OnePoint.infty := by
    have hn : ¬ ∃ i, p i = y ∧ c i ≠ 0 := by
      rintro ⟨i, hi, _⟩
      exact hy ⟨i, hi⟩
    simp only [f, if_neg hn]
    exact OnePoint.coe_ne_infty _
  obtain ⟨y, hy⟩ := RiemannRochAna_exists_unmarked hE (p j) p
  have hj : f (p j) = OnePoint.infty := if_pos ⟨j, rfl, hcj⟩
  refine ⟨⟨f, hf, y, hout y hy⟩, ⟨p j, y, ?_⟩, ?_⟩
  · change f (p j) ≠ f y
    rw [hj]
    exact (hout y hy).symm
  · apply RiemannRochAna_sphere_extension_order hE p hp c A f hf _ hloc
    intro z
    dsimp only [f]
    split_ifs <;> rfl


theorem b4c_exists_meroFun_aux [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (p : Fin (Module.finrank ℂ (b3_HolForm E C) + 1) → C)
    (hp : Function.Injective p) : ∃ f : b4c_MeroFun E C, (∃ x y, f x ≠ f y) ∧
      ∀ x, -(1 : ℤ) ≤ b4c_ord E f x ∧ (x ∉ Set.range p → 0 ≤ b4c_ord E f x) :=
  RiemannRochAna_exists_meroFun_simple hE p hp

