/-- RiemannRochAna: normalization preserves values wherever the scalar representative is continuous. -/
theorem RiemannRochAna_normalization_value
    (hE : Module.finrank ℂ E = 1) (f : C → ℂ) (F : C → OnePoint ℂ) (x : C)
    (hF : ContinuousAt F x) (hf : ContinuousAt f x)
    (he : ∀ᶠ y in 𝓝[≠] x, F y = ((f y : ℂ) : OnePoint ℂ)) :
    F x = ((f x : ℂ) : OnePoint ℂ) := by
  letI := RiemannRochAna_punctured_neBot hE x
  exact (hF.eventuallyEq_nhds_iff_eventuallyEq_nhdsNE
    (OnePoint.continuous_coe.continuousAt.comp hf)).mp he |>.self_of_nhds

/-- RiemannRochAna: a meromorphic scalar representative with a regular point gives a meromorphic function. -/
theorem RiemannRochAna_normalize_to_meroFun [T1Space C]
    (hE : Module.finrank ℂ E = 1) (f : C → ℂ)
    (hf : ∀ x, MeromorphicAt (fun t : ℂ ↦ f ((extChartAt 𝓘(ℂ, E) x).symm
      (extChartAt 𝓘(ℂ, E) x x + b4cov_lineEquiv hE t))) 0)
    (x₀ : C) (h₀ : ContinuousAt f x₀) :
    ∃ F : b4c_MeroFun E C,
      (∀ x, ∀ᶠ y in 𝓝[≠] x, F y = ((f y : ℂ) : OnePoint ℂ)) ∧
      ∀ x, ContinuousAt f x → F x = ((f x : ℂ) : OnePoint ℂ) := by
  obtain ⟨F, hF, he⟩ := RiemannRochAna_normalize_meromorphic hE f hf
  have hval (x : C) (hx : ContinuousAt f x) : F x = ((f x : ℂ) : OnePoint ℂ) :=
    RiemannRochAna_normalization_value hE f F x (hF x).continuousAt hx (he x)
  refine ⟨⟨F, hF, x₀, ?_⟩, he, hval⟩
  rw [hval x₀ h₀]
  exact OnePoint.coe_ne_infty _

