#print axioms RiemannRochAna_finiteValue_chartInf
#print axioms RiemannRochAna_sphere_map_meromorphic
/-- RiemannRochAna: the finite-value representative of a sphere map is analytic at finite values. -/
theorem RiemannRochAna_finiteValue_analytic (F : C → OnePoint ℂ)
    (hF : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω F) (x : C) (hx : F x ≠ OnePoint.infty) :
    ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω (fun y ↦ (F y).elim 0 id) x := by
  obtain ⟨a, ha⟩ := OnePoint.ne_infty_iff_exists.mp hx
  apply ((contMDiffAt_iff_target.mp (hF x)).2).congr_of_eventuallyEq
  filter_upwards [(hF x).continuousAt.eventually_ne hx] with y hy
  have hs : F y ∈ b4cov_chart0.source := by
    rw [b4cov_chart0_source]
    exact OnePoint.ne_infty_iff_exists.mp hy
  change (F y).elim 0 id = (extChartAt 𝓘(ℂ, ℂ) (F x)) (F y)
  simpa only [← ha, extChartAt_coe, b4cov_chartAt_coe,
    modelWithCornersSelf_coe, Function.comp_apply, id_eq]
    using RiemannRochAna_finiteValue_chart0 (F y) hs

/-- RiemannRochAna: sums of meromorphic functions extend across their poles and agree with the scalar sum wherever both values are finite. -/
theorem RiemannRochAna_meroFun_add [T1Space C]
    (hE : Module.finrank ℂ E = 1) (F G : b4c_MeroFun E C)
    (x₀ : C) (hF₀ : F x₀ ≠ OnePoint.infty) (hG₀ : G x₀ ≠ OnePoint.infty) :
    ∃ H : b4c_MeroFun E C,
      (∀ x, ∀ᶠ y in 𝓝[≠] x,
        H y = (((F y).elim 0 id + (G y).elim 0 id : ℂ) : OnePoint ℂ)) ∧
      ∀ x, F x ≠ OnePoint.infty → G x ≠ OnePoint.infty →
        H x = (((F x).elim 0 id + (G x).elim 0 id : ℂ) : OnePoint ℂ) := by
  let f : C → ℂ := fun y ↦ (F y).elim 0 id + (G y).elim 0 id
  have hmer (x : C) : MeromorphicAt (fun t : ℂ ↦ f ((extChartAt 𝓘(ℂ, E) x).symm
      (extChartAt 𝓘(ℂ, E) x x + b4cov_lineEquiv hE t))) 0 :=
    (RiemannRochAna_sphere_map_meromorphic hE F F.property.1 x).add
      (RiemannRochAna_sphere_map_meromorphic hE G G.property.1 x)
  have hc (x : C) (hFx : F x ≠ OnePoint.infty) (hGx : G x ≠ OnePoint.infty) :
      ContinuousAt f x :=
    (RiemannRochAna_finiteValue_analytic F F.property.1 x hFx).continuousAt.add
      (RiemannRochAna_finiteValue_analytic G G.property.1 x hGx).continuousAt
  obtain ⟨H, he, hv⟩ := RiemannRochAna_normalize_to_meroFun hE f hmer x₀ (hc x₀ hF₀ hG₀)
  exact ⟨H, he, fun x hFx hGx ↦ hv x (hc x hFx hGx)⟩

#print axioms RiemannRochAna_finiteValue_analytic
#print axioms RiemannRochAna_meroFun_add

/-- RiemannRochAna: scalar multiples of meromorphic functions extend across their poles. -/
theorem RiemannRochAna_meroFun_smul [T1Space C]
    (hE : Module.finrank ℂ E = 1) (a : ℂ) (F : b4c_MeroFun E C) :
    ∃ H : b4c_MeroFun E C,
      (∀ x, ∀ᶠ y in 𝓝[≠] x,
        H y = ((a * (F y).elim 0 id : ℂ) : OnePoint ℂ)) ∧
      ∀ x, F x ≠ OnePoint.infty → H x = ((a * (F x).elim 0 id : ℂ) : OnePoint ℂ) := by
  let f : C → ℂ := fun y ↦ a * (F y).elim 0 id
  have hmer (x : C) : MeromorphicAt (fun t : ℂ ↦ f ((extChartAt 𝓘(ℂ, E) x).symm
      (extChartAt 𝓘(ℂ, E) x x + b4cov_lineEquiv hE t))) 0 :=
    (MeromorphicAt.const a (0 : ℂ)).mul
      (RiemannRochAna_sphere_map_meromorphic hE F F.property.1 x)
  have hc (x : C) (hFx : F x ≠ OnePoint.infty) : ContinuousAt f x :=
    continuousAt_const.mul
      (RiemannRochAna_finiteValue_analytic F F.property.1 x hFx).continuousAt
  obtain ⟨x₀, hF₀⟩ := F.property.2
  obtain ⟨H, he, hv⟩ := RiemannRochAna_normalize_to_meroFun hE f hmer x₀ (hc x₀ hF₀)
  exact ⟨H, he, fun x hFx ↦ hv x (hc x hFx)⟩

/-- RiemannRochAna: the scalar coefficient of a sphere map in a centred surface chart. -/
def RiemannRochAna_functionLocal (hE : Module.finrank ℂ E = 1)
    (F : C → OnePoint ℂ) (x : C) : ℂ → ℂ :=
  fun t ↦ (F ((extChartAt 𝓘(ℂ, E) x).symm
    (extChartAt 𝓘(ℂ, E) x x + b4cov_lineEquiv hE t))).elim 0 id

/-- RiemannRochAna: the normalized sum satisfies the local valuation inequality. -/
theorem RiemannRochAna_meroFun_add_order
    (hE : Module.finrank ℂ E = 1) (F G H : b4c_MeroFun E C) (x : C)
    (hH : ∀ᶠ y in 𝓝[≠] x,
      H y = (((F y).elim 0 id + (G y).elim 0 id : ℂ) : OnePoint ℂ)) :
    min (meromorphicOrderAt (RiemannRochAna_functionLocal hE F x) 0)
        (meromorphicOrderAt (RiemannRochAna_functionLocal hE G x) 0) ≤
      meromorphicOrderAt (RiemannRochAna_functionLocal hE H x) 0 := by
  have he := RiemannRochAna_normalization_local_germ hE
    (fun y ↦ (F y).elim 0 id + (G y).elim 0 id) H x hH
  change RiemannRochAna_functionLocal hE H x =ᶠ[𝓝[≠] 0]
    RiemannRochAna_functionLocal hE F x + RiemannRochAna_functionLocal hE G x at he
  rw [meromorphicOrderAt_congr he]
  exact meromorphicOrderAt_add
    (RiemannRochAna_sphere_map_meromorphic hE F F.property.1 x)
    (RiemannRochAna_sphere_map_meromorphic hE G G.property.1 x)

