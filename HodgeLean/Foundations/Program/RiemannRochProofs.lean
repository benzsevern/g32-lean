section
set_option backward.isDefEq.respectTransparency false

/-- RiemannRochAna: the pointwise Cauchy--Riemann equation implies complex differentiability. -/
theorem RiemannRochAna_mdifferentiableAt_of_dbar (u : C → ℂ) (x : C)
    (hu : ContMDiffAt 𝓘(ℝ, E) 𝓘(ℝ, ℂ) ∞ u x)
    (hz : ∀ v : E, b4c_dbar E C u ⟨x, v⟩ = 0) :
    MDifferentiableAt 𝓘(ℂ, E) 𝓘(ℂ, ℂ) u x := by
  let g : E → ℂ := u ∘ (chartAt E x).symm
  have hd : DifferentiableAt ℝ g (chartAt E x x) :=
    differentiableAt_comp_chartAt_symm (by simp) hu
  have hm := mfderiv_eq_fderiv_comp_chartAt_symm (hu.mdifferentiableAt (by simp))
  have ha : antiLinearPart (fderiv ℝ g (chartAt E x x)) = 0 := by
    ext v
    have h := hz v
    let du : E →L[ℝ] ℂ := mfderiv 𝓘(ℝ, E) 𝓘(ℝ, ℂ) u x
    change (du v + Complex.I * du (Complex.I • v)) / 2 = 0 at h
    dsimp only [du] at h
    rw [hm] at h
    simpa only [antiLinearPart_apply, _root_.zero_apply, Complex.real_smul,
      Complex.ofReal_div, Complex.ofReal_inv, Complex.ofReal_one,
      Complex.ofReal_ofNat, div_eq_mul_inv, mul_comm, g] using h
  obtain ⟨L, hL⟩ := exists_restrictScalars_eq_of_antiLinearPart_eq_zero _ ha
  have hc := (hasFDerivAt_of_restrictScalars ℝ hd.hasFDerivAt hL).differentiableAt
  rw [mdifferentiableAt_iff]
  refine ⟨hu.continuousAt, ?_⟩
  simpa only [mfld_simps] using hc.differentiableWithinAt (s := Set.univ)

/-- RiemannRochAna: complex differentiability on a neighbourhood implies analyticity on a curve. -/
theorem RiemannRochAna_analyticAt_of_eventually_mdifferentiable
    (hE : Module.finrank ℂ E = 1) (u : C → ℂ) (x : C)
    (hu : ∀ᶠ y in 𝓝 x, MDifferentiableAt 𝓘(ℂ, E) 𝓘(ℂ, ℂ) u y) :
    ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω u x := by
  let e := chartAt E x
  let φ := b4cov_lineEquiv hE
  let g : E → ℂ := u ∘ e.symm
  have hc : ContinuousAt e.symm (e x) :=
    e.continuousOn_symm.continuousAt (e.open_target.mem_nhds (mem_chart_target E x))
  have hh : ∀ᶠ z in 𝓝 (e x), DifferentiableAt ℂ g z := by
    have hp : e.symm (e x) = x := e.left_inv (mem_chart_source E x)
    have hu' := hc.preimage_mem_nhds (hp.symm ▸ hu)
    filter_upwards [hu', e.open_target.mem_nhds (mem_chart_target E x)] with z hz hzt
    have he := ((contMDiffOn_chart_symm (I := 𝓘(ℂ, E)) (n := ω) (x := x)) z hzt).contMDiffAt
      (e.open_target.mem_nhds hzt)
    exact (hz.comp z (he.mdifferentiableAt (by simp))).differentiableAt
  have hn : {z : ℂ | DifferentiableAt ℂ g (φ z)} ∈ 𝓝 (φ.symm (e x)) := by
    have hφ := φ.continuous.continuousAt (x := φ.symm (e x))
    exact hφ.preimage_mem_nhds (t := {z : E | DifferentiableAt ℂ g z})
      (by
        rw [ContinuousLinearEquiv.apply_symm_apply]
        exact hh)
  have hg : DifferentiableOn ℂ (g ∘ φ) {z : ℂ | DifferentiableAt ℂ g (φ z)} :=
    fun z hz ↦ (hz.comp z φ.differentiableAt).differentiableWithinAt
  have ha := (hg.analyticAt hn).comp (φ.symm.toContinuousLinearMap.analyticAt (e x))
  have he : (g ∘ φ) ∘ φ.symm = g := by
    funext z
    simp only [Function.comp_apply, ContinuousLinearEquiv.apply_symm_apply]
  rw [he] at ha
  rw [contMDiffAt_iff]
  refine ⟨hu.self_of_nhds.continuousAt, ?_⟩
  simpa only [mfld_simps, g, e] using ha.contDiffAt.contDiffWithinAt (s := Set.univ)

/-- RiemannRochAna: the local Cauchy--Riemann equation yields an analytic germ. -/
theorem RiemannRochAna_analyticAt_of_dbar_germ
    (hE : Module.finrank ℂ E = 1) (u : C → ℂ) (x : C)
    (hu : ∀ᶠ y in 𝓝 x, ContMDiffAt 𝓘(ℝ, E) 𝓘(ℝ, ℂ) ∞ u y ∧
      ∀ v : E, b4c_dbar E C u ⟨y, v⟩ = 0) :
    ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω u x := by
  apply RiemannRochAna_analyticAt_of_eventually_mdifferentiable hE u x
  filter_upwards [hu] with y hy
  exact RiemannRochAna_mdifferentiableAt_of_dbar u y hy.1 hy.2

/-- RiemannRochAna: a principal-part obstruction potential is analytic near every marked point. -/
theorem RiemannRochAna_potential_analytic_at_poles [T2Space C]
    (hE : Module.finrank ℂ E = 1) {ι : Type} [Fintype ι]
    (p : ι → C) (χ : ι → C → ℝ)
    (hχ : ∀ i, χ i =ᶠ[𝓝 (p i)] 1 ∧ ∀ j, j ≠ i → p j ∉ tsupport (χ i))
    (c : ι → ℂ) (u : b4c_SmoothFun E C)
    (hu : ∀ q : TangentBundle 𝓘(ℂ, E) C, b4c_dbar E C u q =
      ∑ i, c i * RiemannRochAna_principalObstruction hE (p i) (χ i) q) (j : ι) :
    ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω (u : C → ℂ) (p j) := by
  classical
  have hh (i : ι) : ∀ᶠ y in 𝓝 (p j), ∀ v : E,
      RiemannRochAna_principalObstruction hE (p i) (χ i) ⟨y, v⟩ = 0 := by
    by_cases hij : j = i
    · subst i
      exact RiemannRochAna_principalObstruction_zero_germ hE (p j) (p j) (χ j) (hχ j).1
    · exact RiemannRochAna_principalObstruction_zero_germ hE (p i) (p j) (χ i)
        (notMem_tsupport_iff_eventuallyEq.mp ((hχ i).2 j hij))
  apply RiemannRochAna_analyticAt_of_dbar_germ hE u (p j)
  filter_upwards [Filter.eventually_all.mpr hh] with y hy
  refine ⟨u.property.contMDiffAt, ?_⟩
  intro v
  rw [hu]
  apply Finset.sum_eq_zero
  intro i _
  rw [hy i v, mul_zero]

/-- RiemannRochAna: the conjugate differential is additive at real differentiable points. -/
theorem RiemannRochAna_dbar_add_at (u v : C → ℂ) (x : C)
    (hu : MDifferentiableAt 𝓘(ℝ, E) 𝓘(ℝ, ℂ) u x)
    (hv : MDifferentiableAt 𝓘(ℝ, E) 𝓘(ℝ, ℂ) v x) (w : E) :
    b4c_dbar E C (u + v) ⟨x, w⟩ = b4c_dbar E C u ⟨x, w⟩ + b4c_dbar E C v ⟨x, w⟩ := by
  let du : E →L[ℝ] ℂ := mfderiv 𝓘(ℝ, E) 𝓘(ℝ, ℂ) u x
  let dv : E →L[ℝ] ℂ := mfderiv 𝓘(ℝ, E) 𝓘(ℝ, ℂ) v x
  have hd : (mfderiv 𝓘(ℝ, E) 𝓘(ℝ, ℂ) (u + v) x : E →L[ℝ] ℂ) = du + dv :=
    mfderiv_add hu hv
  unfold b4c_dbar
  rw [hd]
  change ((du + dv) w + Complex.I * (du + dv) (Complex.I • w)) / 2 =
    (du w + Complex.I * du (Complex.I • w)) / 2 +
    (dv w + Complex.I * dv (Complex.I • w)) / 2
  simp only [ContinuousLinearMap.add_apply]
  ring

/-- RiemannRochAna: finite sums commute with the conjugate differential at real differentiable points. -/
theorem RiemannRochAna_dbar_sum_at {ι : Type} (s : Finset ι) (f : ι → C → ℂ)
    (x : C) (hf : ∀ i ∈ s, MDifferentiableAt 𝓘(ℝ, E) 𝓘(ℝ, ℂ) (f i) x) (v : E) :
    b4c_dbar E C (∑ i ∈ s, f i) ⟨x, v⟩ = ∑ i ∈ s, b4c_dbar E C (f i) ⟨x, v⟩ := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    simp only [Finset.sum_empty]
    exact RiemannRochAna_dbar_const_germ (Filter.EventuallyEq.refl _ _) v
  | @insert i s his ih =>
    rw [Finset.sum_insert his, Finset.sum_insert his]
    rw [RiemannRochAna_dbar_add_at _ _ x (hf i (Finset.mem_insert_self i s))
      (MDifferentiableAt.sum fun j hj ↦ hf j (Finset.mem_insert_of_mem hj)) v]
    rw [ih (fun j hj ↦ hf j (Finset.mem_insert_of_mem hj))]

/-- RiemannRochAna: scalar multiplication commutes with the conjugate differential at a differentiable point. -/
theorem RiemannRochAna_dbar_smul_at (a : ℂ) (u : C → ℂ) (x : C)
    (hu : MDifferentiableAt 𝓘(ℝ, E) 𝓘(ℝ, ℂ) u x) (v : E) :
    b4c_dbar E C (a • u) ⟨x, v⟩ = a * b4c_dbar E C u ⟨x, v⟩ := by
  have hh := RiemannRochAna_dbar_mul_at (fun _ ↦ a) u x mdifferentiableAt_const hu v
  have hz := RiemannRochAna_dbar_const_germ (E := E) (x := x)
    (u := fun _ ↦ a) (Filter.EventuallyEq.refl _ _) v
  change b4c_dbar E C (fun y ↦ a * u y) ⟨x, v⟩ = _
  simpa only [hz, mul_zero, add_zero] using hh

/-- RiemannRochAna: subtracting an obstruction potential annihilates the conjugate differential away from the marked points. -/
theorem RiemannRochAna_corrected_principal_dbar [T2Space C]
    (hE : Module.finrank ℂ E = 1) {ι : Type} [Fintype ι]
    (p : ι → C) (χ : ι → C → ℝ)
    (hχ : ∀ i, ContMDiff 𝓘(ℝ, E) 𝓘(ℝ, ℝ) ∞ (χ i) ∧
      tsupport (χ i) ⊆ (extChartAt 𝓘(ℂ, E) (p i)).source)
    (c : ι → ℂ) (u : b4c_SmoothFun E C)
    (hu : ∀ q : TangentBundle 𝓘(ℂ, E) C, b4c_dbar E C u q =
      ∑ i, c i * RiemannRochAna_principalObstruction hE (p i) (χ i) q)
    (y : C) (hy : y ∉ Set.range p) (v : E) :
    b4c_dbar E C (fun z ↦ (∑ i, c i * ((χ i z : ℂ) /
      RiemannRochAna_coordinate hE (p i) z)) - (u : C → ℂ) z) ⟨y, v⟩ = 0 := by
  let f : ι → C → ℂ := fun i z ↦ (χ i z : ℂ) / RiemannRochAna_coordinate hE (p i) z
  have hf (i : ι) : ContMDiffAt 𝓘(ℝ, E) 𝓘(ℝ, ℂ) ∞ (f i) y :=
    RiemannRochAna_cutoff_principal_smooth hE (p i) (χ i) (hχ i).1 (hχ i).2 y
      (fun he ↦ hy ⟨i, he.symm⟩)
  have hcf (i : ι) : MDifferentiableAt 𝓘(ℝ, E) 𝓘(ℝ, ℂ) (c i • f i) y :=
    (contMDiffAt_const.mul (hf i)).mdifferentiableAt (by simp)
  have hs : MDifferentiableAt 𝓘(ℝ, E) 𝓘(ℝ, ℂ) (∑ i, c i • f i) y :=
    MDifferentiableAt.sum fun i _ ↦ hcf i
  have hum := u.property.mdifferentiable (by simp) y
  have hneg : MDifferentiableAt 𝓘(ℝ, E) 𝓘(ℝ, ℂ) ((-1 : ℂ) • (u : C → ℂ)) y :=
    (contMDiffAt_const.mul u.property.contMDiffAt).mdifferentiableAt (by simp)
  have he : (fun z ↦ (∑ i, c i * ((χ i z : ℂ) / RiemannRochAna_coordinate hE (p i) z)) - (u : C → ℂ) z) =
      (∑ i, c i • f i) + (-1 : ℂ) • (u : C → ℂ) := by
    funext z
    simp only [Pi.add_apply, Finset.sum_apply, Pi.smul_apply, smul_eq_mul,
      neg_one_mul, sub_eq_add_neg, f]
  rw [he, RiemannRochAna_dbar_add_at _ _ y hs hneg v,
    RiemannRochAna_dbar_sum_at _ _ y (fun i _ ↦ hcf i) v,
    RiemannRochAna_dbar_smul_at _ _ y hum v, hu]
  have hi (i : ι) : b4c_dbar E C (c i • f i) ⟨y, v⟩ =
      c i * RiemannRochAna_principalObstruction hE (p i) (χ i) ⟨y, v⟩ := by
    rw [RiemannRochAna_dbar_smul_at _ _ y ((hf i).mdifferentiableAt (by simp)) v]
    congr 1
    exact RiemannRochAna_principalObstruction_eq_dbar hE (p i) (χ i)
      (hχ i).1 (hχ i).2 y (fun he ↦ hy ⟨i, he.symm⟩) v
  simp only [hi, neg_one_mul, add_neg_cancel]

/-- RiemannRochAna: corrected cutoff principal parts are holomorphic away from their marked points. -/
theorem RiemannRochAna_corrected_principal_analytic [T2Space C]
    (hE : Module.finrank ℂ E = 1) {ι : Type} [Fintype ι]
    (p : ι → C) (χ : ι → C → ℝ)
    (hχ : ∀ i, ContMDiff 𝓘(ℝ, E) 𝓘(ℝ, ℝ) ∞ (χ i) ∧
      tsupport (χ i) ⊆ (extChartAt 𝓘(ℂ, E) (p i)).source)
    (c : ι → ℂ) (u : b4c_SmoothFun E C)
    (hu : ∀ q : TangentBundle 𝓘(ℂ, E) C, b4c_dbar E C u q =
      ∑ i, c i * RiemannRochAna_principalObstruction hE (p i) (χ i) q)
    (y : C) (hy : y ∉ Set.range p) :
    ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω (fun z ↦
      (∑ i, c i * ((χ i z : ℂ) / RiemannRochAna_coordinate hE (p i) z)) - (u : C → ℂ) z) y := by
  have hn : (Set.range p)ᶜ ∈ 𝓝 y :=
    (Set.finite_range p).isClosed.isOpen_compl.mem_nhds hy
  apply RiemannRochAna_analyticAt_of_dbar_germ hE _ y
  filter_upwards [hn] with z hz
  refine ⟨?_, RiemannRochAna_corrected_principal_dbar hE p χ hχ c u hu z hz⟩
  apply ContMDiffAt.sub _ u.property.contMDiffAt
  apply ContMDiffAt.sum
  intro i _
  exact contMDiffAt_const.mul (RiemannRochAna_cutoff_principal_smooth hE (p i) (χ i)
    (hχ i).1 (hχ i).2 z (fun he ↦ hz ⟨i, he.symm⟩))

/-- RiemannRochAna: near a marked point the corrected sum has exactly its prescribed simple principal part. -/
theorem RiemannRochAna_corrected_principal_germ [T2Space C]
    (hE : Module.finrank ℂ E = 1) {ι : Type} [Fintype ι]
    (p : ι → C) (χ : ι → C → ℝ)
    (hχ : ∀ i, χ i =ᶠ[𝓝 (p i)] 1 ∧ ∀ j, j ≠ i → p j ∉ tsupport (χ i))
    (c : ι → ℂ) (u : C → ℂ) (j : ι) :
    (fun z ↦ (∑ i, c i * ((χ i z : ℂ) / RiemannRochAna_coordinate hE (p i) z)) - u z)
      =ᶠ[𝓝 (p j)] (fun z ↦ c j / RiemannRochAna_coordinate hE (p j) z - u z) := by
  classical
  have hh (i : ι) : ∀ᶠ z in 𝓝 (p j),
      c i * ((χ i z : ℂ) / RiemannRochAna_coordinate hE (p i) z) =
        if i = j then c j / RiemannRochAna_coordinate hE (p j) z else 0 := by
    by_cases hij : i = j
    · subst i
      filter_upwards [(hχ j).1] with z hz
      simp only [show χ j z = 1 from hz, Complex.ofReal_one, if_pos rfl,
        one_div, div_eq_mul_inv, one_mul, ite_true]
    · have hz := notMem_tsupport_iff_eventuallyEq.mp ((hχ i).2 j (Ne.symm hij))
      filter_upwards [hz] with z hz
      simp only [show χ i z = 0 from hz, Complex.ofReal_zero, zero_div, mul_zero, if_neg hij]
  filter_upwards [Filter.eventually_all.mpr hh] with z hz
  simp only [hz, Finset.sum_ite_eq', Finset.mem_univ, if_true]


