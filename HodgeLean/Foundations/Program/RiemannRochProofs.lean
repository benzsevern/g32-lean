/-- RiemannRochAna: the real differential of a holomorphic function is complex linear. -/
theorem RiemannRochAna_real_derivative_smul (u : C → ℂ)
    (hu : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω u) (x : C) (a : ℂ) (v : E) :
    mfderiv 𝓘(ℝ, E) 𝓘(ℝ, ℂ) u x (a • v) =
      a * (show ℂ from mfderiv 𝓘(ℝ, E) 𝓘(ℝ, ℂ) u x v) := by
  have h := (b3A_mdifferentiableAt_real (hu.mdifferentiable (by simp) x)).2
  rw [h, h]
  exact (mfderiv 𝓘(ℂ, E) 𝓘(ℂ, ℂ) u x).map_smul a v

set_option backward.isDefEq.respectTransparency false in
/-- RiemannRochAna: differentiation is additive on smooth functions. -/
theorem RiemannRochAna_dbar_add (u v : b4c_SmoothFun E C) :
    b4c_dbar E C (u + v) = b4c_dbar E C u + b4c_dbar E C v := by
  funext p
  have hu := u.property.mdifferentiable (by simp) p.1
  have hv := v.property.mdifferentiable (by simp) p.1
  let du : E →L[ℝ] ℂ := mfderiv 𝓘(ℝ, E) 𝓘(ℝ, ℂ) (u : C → ℂ) p.1
  let dv : E →L[ℝ] ℂ := mfderiv 𝓘(ℝ, E) 𝓘(ℝ, ℂ) (v : C → ℂ) p.1
  have hd : (mfderiv 𝓘(ℝ, E) 𝓘(ℝ, ℂ) ((u : C → ℂ) + (v : C → ℂ)) p.1 : E →L[ℝ] ℂ) =
      du + dv := mfderiv_add hu hv
  change b4c_dbar E C ((u : C → ℂ) + (v : C → ℂ)) p = _
  unfold b4c_dbar
  rw [hd]
  change ((du + dv) (show E from p.2) + Complex.I * (du + dv) (Complex.I • (show E from p.2))) / 2 =
    (du (show E from p.2) + Complex.I * du (Complex.I • (show E from p.2))) / 2 +
    (dv (show E from p.2) + Complex.I * dv (Complex.I • (show E from p.2))) / 2
  dsimp only [TangentSpace] at *
  simp only [ContinuousLinearMap.add_apply]
  ring

set_option backward.isDefEq.respectTransparency false in
/-- RiemannRochAna: differentiation commutes with constant complex scalars. -/
theorem RiemannRochAna_dbar_smul (a : ℂ) (u : b4c_SmoothFun E C) :
    b4c_dbar E C (a • u) = a • b4c_dbar E C u := by
  funext p
  have hu := u.property.mdifferentiable (by simp) p.1
  have hd := ((hasMFDerivAt_const (I := 𝓘(ℝ, E)) a p.1).mul hu.hasMFDerivAt).mfderiv
  let du : E →L[ℝ] ℂ := mfderiv 𝓘(ℝ, E) 𝓘(ℝ, ℂ) (u : C → ℂ) p.1
  have hd' : (mfderiv 𝓘(ℝ, E) 𝓘(ℝ, ℂ) (a • (u : C → ℂ)) p.1 : E →L[ℝ] ℂ) =
      a • du := by
    change (mfderiv 𝓘(ℝ, E) 𝓘(ℝ, ℂ) ((fun _ ↦ a) * (u : C → ℂ)) p.1 :
      E →L[ℝ] ℂ) = a • du + (u : C → ℂ) p.1 • (0 : E →L[ℝ] ℂ) at hd
    have he : a • (u : C → ℂ) = (fun _ ↦ a) * (u : C → ℂ) := by
      ext x
      exact smul_eq_mul a ((u : C → ℂ) x)
    rw [he]
    simpa only [TangentSpace, smul_zero, add_zero] using hd
  change b4c_dbar E C (a • (u : C → ℂ)) p = _
  unfold b4c_dbar
  rw [hd']
  change ((a • du) (show E from p.2) + Complex.I * (a • du) (Complex.I • (show E from p.2))) / 2 =
    a * ((du (show E from p.2) + Complex.I * du (Complex.I • (show E from p.2))) / 2)
  dsimp only [TangentSpace] at *
  simp only [ContinuousLinearMap.smul_apply, smul_eq_mul]
  ring

/-- RiemannRochAna: the complex linear differential operator on smooth functions. -/
def RiemannRochAna_dbarLinear : b4c_SmoothFun E C →ₗ[ℂ]
    (TangentBundle 𝓘(ℂ, E) C → ℂ) where
  toFun u := b4c_dbar E C u
  map_add' := RiemannRochAna_dbar_add
  map_smul' := RiemannRochAna_dbar_smul

