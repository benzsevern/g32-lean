/-- RiemannRochAna: the real tangent atlas agrees smoothly with the complex tangent atlas. -/
theorem RiemannRochAna_realTangent :
    ContMDiff 𝓘(ℝ, E).tangent 𝓘(ℝ, E).tangent ∞
      (fun p : TangentBundle 𝓘(ℂ, E) C ↦
        (⟨p.1, p.2⟩ : TangentBundle 𝓘(ℝ, E) C)) := by
  let : ChartedSpace (E × E) (TangentBundle 𝓘(ℂ, E) C) :=
    inferInstanceAs (ChartedSpace (ModelProd E E) (TangentBundle 𝓘(ℂ, E) C))
  intro p
  have hc := (Bundle.contMDiffAt_totalSpace.mp
    (contMDiffAt_id : ContMDiffAt 𝓘(ℂ, E).tangent 𝓘(ℂ, E).tangent ω
      (id : TangentBundle 𝓘(ℂ, E) C → TangentBundle 𝓘(ℂ, E) C) p))
  rw [Bundle.contMDiffAt_totalSpace]
  simp only [ModelWithCorners.tangent, ← modelWithCornersSelf_prod] at hc ⊢
  refine ⟨(b3A_contMDiffWithinAt_real hc.1).of_le (by simp), ?_⟩
  have h := (b3A_contMDiffWithinAt_real hc.2).of_le (show (∞ : WithTop ℕ∞) ≤ ω by simp)
  refine ContMDiffAt.congr_of_eventuallyEq h ?_
  filter_upwards [(FiberBundle.continuous_proj E (TangentSpace 𝓘(ℂ, E))).continuousAt.preimage_mem_nhds
    ((chartAt E p.1).open_source.mem_nhds (mem_chart_source E p.1))] with q hq
  simp only [TangentBundle.trivializationAt_apply, id_eq,
    OpenPartialHomeomorph.extend_coe, OpenPartialHomeomorph.extend_coe_symm,
    modelWithCornersSelf_coe, modelWithCornersSelf_coe_symm, range_id,
    fderivWithin_univ, Function.id_comp, Function.comp_id]
  exact congrArg (fun L : E →L[ℝ] E ↦ L q.2)
    (b3Forms_fderiv_tr_real (x := q.1) (y := p.1)
      (u := chartAt E q.1 q.1) (by
        exact ⟨mem_chart_target E q.1, by simpa using hq⟩))
/-- RiemannRochAna: the conjugate-linear projection of a real differential. -/
theorem RiemannRochAna_antilinear (L : E →L[ℝ] ℂ) (a : ℂ) (v w : E) :
    (L (a • v + w) + Complex.I * L (Complex.I • (a • v + w))) / 2 =
      star a * ((L v + Complex.I * L (Complex.I • v)) / 2) +
        (L w + Complex.I * L (Complex.I • w)) / 2 := by
  have ha (t : E) : L (a • t) = (a.re : ℂ) * L t + (a.im : ℂ) * L (Complex.I • t) := by
    have he : a • t = (a.re : ℂ) • t + (a.im : ℂ) • (Complex.I • t) := by
      rw [smul_smul, ← add_smul, Complex.re_add_im]
    rw [he, map_add, Complex.coe_smul, Complex.coe_smul, map_smul, map_smul,
      Complex.real_smul, Complex.real_smul]
  rw [map_add, smul_add, map_add, smul_comm Complex.I a v, ha, ha,
    smul_smul, Complex.I_mul_I, neg_one_smul, map_neg]
  have hc : star a = (a.re : ℂ) - (a.im : ℂ) * Complex.I := by
    apply Complex.ext <;> simp
  rw [hc]
  ring_nf
  simp only [Complex.I_sq]
  ring


/-- RiemannRochAna: multiplication by `i` in tangent fibres is holomorphic. -/
theorem RiemannRochAna_tangentI :
    ContMDiff 𝓘(ℂ, E).tangent 𝓘(ℂ, E).tangent ω
      (fun p : TangentBundle 𝓘(ℂ, E) C ↦
        (⟨p.1, Complex.I • p.2⟩ : TangentBundle 𝓘(ℂ, E) C)) := by
  intro p
  have hc := (Bundle.contMDiffAt_totalSpace.mp
    (contMDiffAt_id : ContMDiffAt 𝓘(ℂ, E).tangent 𝓘(ℂ, E).tangent ω
      (id : TangentBundle 𝓘(ℂ, E) C → TangentBundle 𝓘(ℂ, E) C) p))
  rw [Bundle.contMDiffAt_totalSpace]
  refine ⟨hc.1, ?_⟩
  have hm : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω (fun v : E ↦ Complex.I • v) :=
    (Complex.I • ContinuousLinearMap.id ℂ E).contMDiff
  convert hm.contMDiffAt.comp p hc.2 using 1
  funext q
  simp only [TangentBundle.trivializationAt_apply, id_eq]
  exact map_smul _ Complex.I q.2

/-- RiemannRochAna: evaluation of a real smooth differential on complex tangent vectors. -/
theorem RiemannRochAna_smooth_differential (u : b4c_SmoothFun E C) :
    ContMDiff 𝓘(ℝ, E).tangent 𝓘(ℝ, ℂ) ∞
      (fun p : TangentBundle 𝓘(ℂ, E) C ↦
        (mfderiv 𝓘(ℝ, E) 𝓘(ℝ, ℂ) (u : C → ℂ) p.1 : E →L[ℝ] ℂ) p.2) := by
  exact ((contMDiff_snd_tangentBundle_modelSpace ℂ 𝓘(ℝ, ℂ)).comp
    (u.property.contMDiff_tangentMap (by simp))).comp RiemannRochAna_realTangent

/-- RiemannRochAna: smoothness of the conjugate-linear differential. -/
theorem RiemannRochAna_dbar_smooth (u : b4c_SmoothFun E C) :
    ContMDiff 𝓘(ℝ, E).tangent 𝓘(ℝ, ℂ) ∞ (b4c_dbar E C u) := by
  let : ChartedSpace (E × E) (TangentBundle 𝓘(ℂ, E) C) :=
    inferInstanceAs (ChartedSpace (ModelProd E E) (TangentBundle 𝓘(ℂ, E) C))
  have hd := RiemannRochAna_smooth_differential u
  have hi : ContMDiff 𝓘(ℝ, E).tangent 𝓘(ℝ, E).tangent ∞
      (fun p : TangentBundle 𝓘(ℂ, E) C ↦
        (⟨p.1, Complex.I • p.2⟩ : TangentBundle 𝓘(ℂ, E) C)) := by
    have hc := RiemannRochAna_tangentI (E := E) (C := C)
    simp only [ModelWithCorners.tangent, ← modelWithCornersSelf_prod] at hc ⊢
    exact fun p ↦ (b3A_contMDiffWithinAt_real (hc p)).of_le (by simp)
  have hm : ContMDiff 𝓘(ℝ, ℂ) 𝓘(ℝ, ℂ) ∞ (fun z : ℂ ↦ Complex.I * z) :=
    (contDiff_const.mul contDiff_id : ContDiff ℝ ∞ (fun z : ℂ ↦ Complex.I * z)).contMDiff
  have hs : ContMDiff 𝓘(ℝ, ℂ) 𝓘(ℝ, ℂ) ∞ (fun z : ℂ ↦ z / 2) :=
    (contDiff_id.div_const (2 : ℂ) : ContDiff ℝ ∞ (fun z : ℂ ↦ z / 2)).contMDiff
  exact hs.comp (hd.add (hm.comp (hd.comp hi)))

end RiemannRochAna

/-- RiemannRochAna: the plane Dolbeault operator is the Wirtinger derivative. -/
theorem RiemannRochAna_plane_dbar (u : ℂ → ℂ) (z v : ℂ) :
    b4c_dbar ℂ ℂ u ⟨z, v⟩ = star v * wirtingerDbar u z := by
  have h := RiemannRochAna_antilinear (E := ℂ) (fderiv ℝ u z) v 1 0
  simp only [smul_eq_mul, mul_one, add_zero, map_zero, mul_zero, zero_div] at h
  simp only [b4c_dbar, mfderiv_eq_fderiv]
  change ((fderiv ℝ u z) v + Complex.I * (fderiv ℝ u z) (Complex.I * v)) / 2 =
    star v * wirtingerDbar u z
  simpa only [wirtingerDbar, antiLinearPart_apply, Complex.real_smul,
    Complex.ofReal_inv, Complex.ofReal_ofNat, smul_eq_mul, mul_one,
    div_eq_mul_inv, mul_comm (2⁻¹ : ℂ)] using h

/-- RiemannRochAna: the Cauchy transform solves the compactly supported plane equation. -/
theorem RiemannRochAna_cauchy_solution {g : ℂ → ℂ} (hg : ContDiff ℝ ∞ g)
    (hc : HasCompactSupport g) :
    cauchyTransform g ∈ b4c_SmoothFun ℂ ℂ ∧
      ∀ z v : ℂ, b4c_dbar ℂ ℂ (cauchyTransform g) ⟨z, v⟩ = star v * g z := by
  refine ⟨(spec_contDiff_cauchyTransform (n := ⊤) hg hc).contMDiff, ?_⟩
  intro z v
  rw [RiemannRochAna_plane_dbar,
    spec_wirtingerDbar_cauchyTransform (hg.of_le (by simp)) hc]

/-- RiemannRochAna: local smooth data on a plane open set have a smooth local
solution of the conjugate-linear differential equation. -/
theorem RiemannRochAna_plane_local_solution {U : Set ℂ} (hU : IsOpen U)
    {g : ℂ → ℂ} (hg : ContDiffOn ℝ ∞ g U) {z : ℂ} (hz : z ∈ U) :
    ∃ u : b4c_SmoothFun ℂ ℂ, ∀ᶠ w in 𝓝 z, ∀ v : ℂ,
      b4c_dbar ℂ ℂ u ⟨w, v⟩ = star v * g w := by
  obtain ⟨ε, hε, hεU⟩ := Metric.mem_nhds_iff.1 (hU.mem_nhds hz)
  let χ : ContDiffBump z := ⟨ε / 4, ε / 2, by positivity, by linarith⟩
  let G : ℂ → ℂ := fun w ↦ (χ w : ℂ) * g w
  have hG : ContDiff ℝ ∞ G := by
    rw [contDiff_iff_contDiffAt]
    intro w
    by_cases hw : w ∈ Metric.ball z ε
    · exact ((Complex.ofRealCLM.contDiff.comp χ.contDiff).contDiffAt).mul
        (hg.contDiffAt (hU.mem_nhds (hεU hw)))
    · have hout : w ∉ tsupport χ := by
        rw [χ.tsupport_eq]
        intro h
        exact hw (Metric.closedBall_subset_ball (by change ε / 2 < ε; linarith) h)
      refine (contDiffAt_const (c := (0 : ℂ))).congr_of_eventuallyEq ?_
      filter_upwards [notMem_tsupport_iff_eventuallyEq.1 hout] with y hy
      change (χ y : ℂ) * g y = 0
      rw [show χ y = 0 from hy]
      simp only [Complex.ofReal_zero, zero_mul]
  have hGc : HasCompactSupport G :=
    χ.hasCompactSupport.mono fun w hw ↦
      Complex.ofReal_ne_zero.1 (left_ne_zero_of_mul (Function.mem_support.1 hw))
  obtain ⟨hu, heq⟩ := RiemannRochAna_cauchy_solution hG hGc
  refine ⟨⟨cauchyTransform G, hu⟩, ?_⟩
  filter_upwards [χ.eventuallyEq_one] with w hw
  intro v
  rw [heq]
  change star v * ((χ w : ℂ) * g w) = star v * g w
  rw [show χ w = 1 from hw]
  simp only [Complex.ofReal_one, one_mul]

/-- RiemannRochAna: the centred coefficient of a holomorphic form is analytic. -/
theorem RiemannRochAna_hol_loc_analytic (hE : Module.finrank ℂ E = 1)
    (θ : b3_HolForm E C) (x : C) : AnalyticAt ℂ (HurwitzPrymRR_loc (Y := C) hE θ x) 0 := by
  unfold HurwitzPrymRR_loc
  apply AnalyticAt.comp (g := b4cov_coef (M := C) θ.1 x (b4cov_lineEquiv hE 1))
  · simp only [(b4cov_lineEquiv hE).map_zero, add_zero]
    exact b4cov_coef_analyticAt (M := C) θ.1 θ.2.1 x _ _ (mem_extChartAt_target x)
  · exact analyticAt_const.add ((b4cov_lineEquiv hE).toContinuousLinearMap.analyticAt 0)

/-- RiemannRochAna: holomorphic forms are meromorphic forms. -/
theorem RiemannRochAna_hol_isMeroForm (hE : Module.finrank ℂ E = 1)
    (θ : b3_HolForm E C) : b4c_IsMeroForm (C := C) hE θ.1 :=
  ⟨θ.2.2, fun x ↦ (RiemannRochAna_hol_loc_analytic hE θ x).meromorphicAt⟩

/-- RiemannRochAna: the centred coefficient evaluates on the chosen tangent basis. -/
theorem RiemannRochAna_loc_zero (hE : Module.finrank ℂ E = 1)
    (θ : TangentBundle 𝓘(ℂ, E) C → ℂ) (x : C) :
    HurwitzPrymRR_loc (Y := C) hE θ x 0 = θ ⟨x, b4cov_lineEquiv hE 1⟩ := by
  unfold HurwitzPrymRR_loc
  rw [(b4cov_lineEquiv hE).map_zero, add_zero]
  unfold b4cov_coef
  rw [(extChartAt 𝓘(ℂ, E) x).left_inv (mem_extChartAt_source x), b4cov_vec_self]

/-- RiemannRochAna: a nonzero holomorphic form has a coefficient of order zero somewhere. -/
theorem RiemannRochAna_hol_nonzero_germ (hE : Module.finrank ℂ E = 1)
    (θ : b3_HolForm E C) (hθ : θ ≠ 0) :
    ∃ x, meromorphicOrderAt (HurwitzPrymRR_loc (Y := C) hE θ x) 0 = 0 := by
  have hx : ∃ x, θ.1 ⟨x, b4cov_lineEquiv hE 1⟩ ≠ 0 := by
    by_contra hn
    push_neg at hn
    apply hθ
    apply Subtype.ext
    funext p
    obtain ⟨x, v⟩ := p
    change E at v
    let L := b4cov_lineEquiv hE
    have hv : v = (L.symm v) • L 1 := by
      rw [← map_smul, smul_eq_mul, mul_one]
      exact (L.apply_symm_apply v).symm
    change θ.1 ⟨x, v⟩ = 0
    rw [hv]
    have hlin : HurwitzPrymRR_IsLinear (E' := E) (Y := C) θ.1 := θ.2.2
    exact (hlin.smul x _ _).trans (by rw [hn x, mul_zero])
  obtain ⟨x, hx⟩ := hx
  refine ⟨x, ?_⟩
  have ha := RiemannRochAna_hol_loc_analytic hE θ x
  rw [ha.meromorphicOrderAt_eq,
    ha.analyticOrderAt_eq_zero.mpr (by rwa [RiemannRochAna_loc_zero])]
  rfl

/-- RiemannRochAna: positive holomorphic dimension supplies a meromorphic form with a
nonzero germ. -/
theorem RiemannRochAna_exists_meroForm_of_pos [T2Space C] [CompactSpace C]
    [ConnectedSpace C] (hE : Module.finrank ℂ E = 1)
    (hg : 0 < Module.finrank ℂ (b3_HolForm E C)) :
    ∃ w : b4c_MeroForm E C hE,
      (w : TangentBundle 𝓘(ℂ, E) C → ℂ) ≠ 0 ∧
      ∃ x, meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 ≠ ⊤ := by
  have : FiniteDimensional ℂ E := Module.finite_of_finrank_eq_succ hE
  have := b3Forms_holForm_finiteDimensional (C := C) hE
  obtain ⟨θ, hθ⟩ := Module.finrank_pos_iff_exists_ne_zero.mp hg
  refine ⟨⟨θ, RiemannRochAna_hol_isMeroForm hE θ⟩, ?_, ?_⟩
  · exact fun hz ↦ hθ (Subtype.ext hz)
  · obtain ⟨x, hx⟩ := RiemannRochAna_hol_nonzero_germ hE θ hθ
    exact ⟨x, hx.trans_ne (by simp)⟩

section RiemannRochAnaHilbert

attribute [local instance] b3Forms_isManifold_real

variable [FiniteDimensional ℂ E] [T2Space C] [CompactSpace C]
  [MeasurableSpace E] [BorelSpace E] [hE1 : Fact (Module.finrank ℂ E = 1)]

/-- RiemannRochAna: the real part of a holomorphic form in the Hilbert space of forms. -/
def RiemannRochAna_holRealL2 : b3_HolForm E C →ₗ[ℝ] b3Rest_L2 E C where
  toFun θ := (b3Rest_SF.mk (b3Forms_reForm θ) (b3Forms_isSmooth_reForm θ) : b3Rest_L2 E C)
  map_add' θ η := by
    rw [← UniformSpace.Completion.coe_add]
    exact congrArg (fun h : b3Rest_SF E C ↦ (h : b3Rest_L2 E C))
      (b3Rest_SF.ext (b3Forms_reForm_add θ η))
  map_smul' r θ := by
    rw [← UniformSpace.Completion.coe_smul]
    congr 1
    exact b3Rest_SF.ext (b3Forms_reForm_smul r θ)

/-- RiemannRochAna: every weakly harmonic form is the real part of a holomorphic form. -/
theorem RiemannRochAna_harmonic_le_range :
    (b3Rest_Ex E C)ᗮ ⊓ (b3Rest_Co E C)ᗮ ≤
      LinearMap.range (RiemannRochAna_holRealL2 (E := E) (C := C)) := by
  intro a ha
  obtain ⟨h, hd, hsd, hh⟩ := b3Rest_weakHarmonic_eq a ha.1 ha.2
  refine ⟨b3Forms_harmonicHol hE1.out ⟨h.isSmooth, hd, hsd⟩, ?_⟩
  rw [hh]
  apply congrArg (fun h : b3Rest_SF E C ↦ (h : b3Rest_L2 E C))
  exact b3Rest_SF.ext (b3Forms_reForm_harmonicHol hE1.out _)

/-- RiemannRochAna: real parts of holomorphic forms are orthogonal to exact and
coexact limits. -/
theorem RiemannRochAna_range_le_harmonic :
    LinearMap.range (RiemannRochAna_holRealL2 (E := E) (C := C)) ≤
      (b3Rest_Ex E C)ᗮ ⊓ (b3Rest_Co E C)ᗮ := by
  rintro a ⟨θ, rfl⟩
  let h : b3Rest_SF E C := b3Rest_SF.mk (b3Forms_reForm θ) (b3Forms_isSmooth_reForm θ)
  have hh := b3Forms_isHarmonic_reForm hE1.out θ
  constructor
  · change (h : b3Rest_L2 E C) ∈ (b3Rest_Ex E C)ᗮ
    rw [Submodule.mem_orthogonal']
    intro e he
    rw [real_inner_comm]
    refine b3Rest_inner_closure_eq_zero ?_ he
    rintro _ ⟨g, rfl⟩
    change inner ℝ ((b3Rest_dSF g.2 : b3Rest_SF E C) : b3Rest_L2 E C)
      (h : b3Rest_L2 E C) = 0
    rw [UniformSpace.Completion.inner_coe, b3Rest_SF.inner_def, b3Rest_inner]
    exact b3Forms_integral_wedge_d_eq_zero (b3Rest_b hE1.out)
      (b3Forms_oriented_complex (C := C)) g.2 hh.1.star hh.2.2
  · change (h : b3Rest_L2 E C) ∈ (b3Rest_Co E C)ᗮ
    rw [Submodule.mem_orthogonal']
    intro c hc
    exact b3Rest_closed_inner_Co (α := h) hh.2.1 hc

/-- RiemannRochAna: the real-part map identifies the weakly harmonic subspace. -/
theorem RiemannRochAna_harmonic_eq_range :
    (b3Rest_Ex E C)ᗮ ⊓ (b3Rest_Co E C)ᗮ =
      LinearMap.range (RiemannRochAna_holRealL2 (E := E) (C := C)) :=
  le_antisymm RiemannRochAna_harmonic_le_range RiemannRochAna_range_le_harmonic

/-- RiemannRochAna: the real-part map into square-integrable forms is injective. -/
theorem RiemannRochAna_holRealL2_injective :
    Function.Injective (RiemannRochAna_holRealL2 (E := E) (C := C)) := by
  intro θ η heq
  have hs : b3Forms_reForm θ = b3Forms_reForm η :=
    congrArg b3Rest_SF.form (UniformSpace.Completion.coe_injective _ heq)
  apply b3Forms_reClass_injective hE1.out
  apply congrArg (Submodule.mkQ _)
  apply Subtype.ext
  exact Subtype.ext hs

/-- RiemannRochAna: the harmonic subspace has real dimension twice the holomorphic dimension. -/
theorem RiemannRochAna_harmonic_finrank [ConnectedSpace C] :
    Module.finrank ℝ ((b3Rest_Ex E C)ᗮ ⊓ (b3Rest_Co E C)ᗮ :
      Submodule ℝ (b3Rest_L2 E C)) = 2 * Module.finrank ℂ (b3_HolForm E C) := by
  rw [RiemannRochAna_harmonic_eq_range,
    LinearMap.finrank_range_of_inj RiemannRochAna_holRealL2_injective]
  simpa using (Module.finrank_mul_finrank ℝ ℂ (b3_HolForm E C)).symm

/-- RiemannRochAna: the weakly harmonic subspace is finite dimensional. -/
theorem RiemannRochAna_harmonic_finite [ConnectedSpace C] :
    Module.Finite ℝ ((b3Rest_Ex E C)ᗮ ⊓ (b3Rest_Co E C)ᗮ :
      Submodule ℝ (b3Rest_L2 E C)) := by
  letI := b3Forms_holForm_finiteDimensional_real (C := C) hE1.out
  exact Submodule.finiteDimensional_of_le RiemannRochAna_harmonic_le_range

/-- RiemannRochAna: arbitrary square-integrable forms split into exact and coexact
limits and a smooth harmonic form. -/
theorem RiemannRochAna_hilbert_decomposition (a : b3Rest_L2 E C) :
    ∃ e ∈ b3Rest_Ex E C, ∃ c ∈ b3Rest_Co E C, ∃ h : b3Rest_SF E C,
      b3Forms_d h.form = 0 ∧ b3Forms_d (b3Forms_star h.form) = 0 ∧
      a = e + c + (h : b3Rest_L2 E C) := by
  letI : CompleteSpace (b3Rest_Co E C) :=
    (Submodule.isClosed_topologicalClosure _).completeSpace_coe
  let e := (b3Rest_Ex E C).starProjection a
  let c := (b3Rest_Co E C).starProjection (a - e)
  have he : e ∈ b3Rest_Ex E C := Submodule.starProjection_apply_mem _ _
  have hc : c ∈ b3Rest_Co E C := Submodule.starProjection_apply_mem _ _
  have he' : a - e ∈ (b3Rest_Ex E C)ᗮ :=
    Submodule.sub_starProjection_mem_orthogonal _
  have hc' : c ∈ (b3Rest_Ex E C)ᗮ := by
    rw [Submodule.mem_orthogonal']
    intro x hx
    rw [real_inner_comm]
    exact b3Rest_Ex_inner_Co hx hc
  have hhEx : a - e - c ∈ (b3Rest_Ex E C)ᗮ :=
    (b3Rest_Ex E C)ᗮ.sub_mem he' hc'
  have hhCo : a - e - c ∈ (b3Rest_Co E C)ᗮ :=
    Submodule.sub_starProjection_mem_orthogonal _
  obtain ⟨h, hd, hsd, hh⟩ := b3Rest_weakHarmonic_eq (a - e - c) hhEx hhCo
  refine ⟨e, he, c, hc, h, hd, hsd, ?_⟩
  rw [← hh]
  abel

/-- RiemannRochAna: holomorphic real parts represent every Hilbert quotient class. -/
theorem RiemannRochAna_hilbert_quotient_surjective :
    Function.Surjective
      (((b3Rest_Ex E C ⊔ b3Rest_Co E C).mkQ).comp
        (RiemannRochAna_holRealL2 (E := E) (C := C))) := by
  intro q
  obtain ⟨a, rfl⟩ := (b3Rest_Ex E C ⊔ b3Rest_Co E C).mkQ_surjective q
  obtain ⟨e, he, c, hc, h, hd, hsd, ha⟩ :=
    RiemannRochAna_hilbert_decomposition a
  let θ := b3Forms_harmonicHol hE1.out ⟨h.isSmooth, hd, hsd⟩
  have hθ : RiemannRochAna_holRealL2 θ = (h : b3Rest_L2 E C) := by
    apply congrArg (fun t : b3Rest_SF E C ↦ (t : b3Rest_L2 E C))
    exact b3Rest_SF.ext (b3Forms_reForm_harmonicHol hE1.out _)
  refine ⟨θ, ?_⟩
  simp only [LinearMap.comp_apply, hθ]
  have hec : e + c ∈ b3Rest_Ex E C ⊔ b3Rest_Co E C :=
    Submodule.add_mem _ (Submodule.mem_sup_left he) (Submodule.mem_sup_right hc)
  have hzero : (b3Rest_Ex E C ⊔ b3Rest_Co E C).mkQ (e + c) = 0 :=
    (Submodule.Quotient.mk_eq_zero _).mpr hec
  rw [ha, map_add, hzero, zero_add]

/-- RiemannRochAna: distinct holomorphic forms give distinct Hilbert quotient classes. -/
theorem RiemannRochAna_hilbert_quotient_injective :
    Function.Injective
      (((b3Rest_Ex E C ⊔ b3Rest_Co E C).mkQ).comp
        (RiemannRochAna_holRealL2 (E := E) (C := C))) := by
  apply LinearMap.ker_eq_bot.mp
  apply LinearMap.ker_eq_bot'.mpr
  intro θ hθ
  let a := RiemannRochAna_holRealL2 θ
  have ha : a ∈ b3Rest_Ex E C ⊔ b3Rest_Co E C :=
    (Submodule.Quotient.mk_eq_zero _).mp hθ
  obtain ⟨e, he, c, hc, hec⟩ := Submodule.mem_sup.mp ha
  have hh := RiemannRochAna_range_le_harmonic (show a ∈
      LinearMap.range (RiemannRochAna_holRealL2 (E := E) (C := C)) from ⟨θ, rfl⟩)
  have hea : inner ℝ e a = 0 := hh.1 e he
  have hca : inner ℝ c a = 0 := hh.2 c hc
  have haa : inner ℝ a a = 0 := by
    calc inner ℝ a a = inner ℝ (e + c) a := congrArg (fun t ↦ inner ℝ t a) hec.symm
         _ = 0 := by rw [inner_add_left, hea, hca, add_zero]
  apply RiemannRochAna_holRealL2_injective
  rw [map_zero]
  exact inner_self_eq_zero.mp haa

/-- RiemannRochAna: the Hilbert quotient has real dimension twice the holomorphic dimension. -/
theorem RiemannRochAna_hilbert_quotient_finite [ConnectedSpace C] :
    Module.Finite ℝ (b3Rest_L2 E C ⧸ (b3Rest_Ex E C ⊔ b3Rest_Co E C)) ∧
      Module.finrank ℝ (b3Rest_L2 E C ⧸ (b3Rest_Ex E C ⊔ b3Rest_Co E C)) =
        2 * Module.finrank ℂ (b3_HolForm E C) := by
  let e := LinearEquiv.ofBijective
    (((b3Rest_Ex E C ⊔ b3Rest_Co E C).mkQ).comp
      (RiemannRochAna_holRealL2 (E := E) (C := C)))
    ⟨RiemannRochAna_hilbert_quotient_injective, RiemannRochAna_hilbert_quotient_surjective⟩
  letI := b3Forms_holForm_finiteDimensional_real (C := C) hE1.out
  refine ⟨e.finiteDimensional, ?_⟩
  rw [← e.finrank_eq]
  simpa using (Module.finrank_mul_finrank ℝ ℂ (b3_HolForm E C)).symm

end RiemannRochAnaHilbert

theorem b4c_formRatio_germ_order (hE : Module.finrank ℂ E = 1)
    (w₁ w₂ : b4c_MeroForm E C hE) (x : C) :
    meromorphicOrderAt
        (fun z ↦ HurwitzPrymRR_loc hE w₁ x z / HurwitzPrymRR_loc hE w₂ x z) 0 =
      meromorphicOrderAt (HurwitzPrymRR_loc hE w₁ x) 0 -
        meromorphicOrderAt (HurwitzPrymRR_loc hE w₂ x) 0 := by
  exact meromorphicOrderAt_div (w₁.2.2 x) (w₂.2.2 x)

theorem b4c_inverse_coe_contMDiff :
    ContMDiff 𝓘(ℂ, ℂ) 𝓘(ℂ, ℂ) ω
      (fun z : ℂ ↦ b4cov_sphInv (z : OnePoint ℂ)) := by
  have ht : b4cov_chartInf.target = Set.univ := by
    ext z
    simp only [b4cov_chartInf, OpenPartialHomeomorph.trans_target,
      Homeomorph.toOpenPartialHomeomorph_target, Set.preimage_univ, Set.inter_univ,
      b4cov_chart0_target, Set.mem_univ]
  have h := contMDiffOn_chart_symm (I := 𝓘(ℂ, ℂ)) (n := ω)
    (x := (OnePoint.infty : OnePoint ℂ))
  rw [b4cov_chartAt_infty, ht] at h
  have he : (fun z : ℂ ↦ b4cov_sphInv (z : OnePoint ℂ)) = b4cov_chartInf.symm :=
    funext fun z ↦ (b4cov_chartInf_symm z).symm
  rw [he]
  exact contMDiffOn_univ.mp h

theorem b4c_meromorphic_germ_sphere_extension {f : ℂ → ℂ} {x : ℂ}
    (hf : MeromorphicAt f x) :
    ∃ F : ℂ → OnePoint ℂ, ContMDiffAt 𝓘(ℂ, ℂ) 𝓘(ℂ, ℂ) ω F x ∧
      ∀ᶠ z in nhdsWithin x {x}ᶜ, F z = ((f z : ℂ) : OnePoint ℂ) := by
  by_cases ho : 0 ≤ meromorphicOrderAt f x
  · obtain ⟨g, hg, hfg⟩ := hf.meromorphicOrderAt_nonneg_iff.mp ho
    refine ⟨fun z ↦ (g z : OnePoint ℂ),
      b4cov_coe_contMDiff.contMDiffAt.comp x hg.contDiffAt.contMDiffAt, ?_⟩
    filter_upwards [hfg] with z hz
    rw [hz]
  · have hneg : meromorphicOrderAt f x < 0 := lt_of_not_ge ho
    obtain ⟨n, hn⟩ := WithTop.ne_top_iff_exists.mp hneg.ne_top
    have hnneg : n < 0 := by exact_mod_cast (hn ▸ hneg)
    have hinv : 0 ≤ meromorphicOrderAt f⁻¹ x := by
      rw [meromorphicOrderAt_inv, ← hn]
      exact_mod_cast neg_nonneg.mpr hnneg.le
    obtain ⟨g, hg, hfg⟩ := hf.inv.meromorphicOrderAt_nonneg_iff.mp hinv
    refine ⟨fun z ↦ b4cov_sphInv (g z : OnePoint ℂ),
      b4c_inverse_coe_contMDiff.contMDiffAt.comp x hg.contDiffAt.contMDiffAt, ?_⟩
    have hne := (meromorphicOrderAt_ne_top_iff_eventually_ne_zero hf).mp hneg.ne_top
    filter_upwards [hfg, hne] with z hz hzf
    have hgz : g z = (f z)⁻¹ := hz.symm
    rw [hgz, b4cov_sphInv_coe (inv_ne_zero hzf), inv_inv]

def b4c_meromorphicValue (f : ℂ → ℂ) (x : ℂ) : OnePoint ℂ :=
  if meromorphicOrderAt f x < 0 then OnePoint.infty
  else if meromorphicOrderAt f x = 0 then
    ((meromorphicTrailingCoeffAt f x : ℂ) : OnePoint ℂ)
  else (0 : ℂ)

theorem b4c_meromorphic_germ_sphere_extension_spec {f : ℂ → ℂ} {x : ℂ}
    (hf : MeromorphicAt f x) :
    ∃ F : ℂ → OnePoint ℂ, ContMDiffAt 𝓘(ℂ, ℂ) 𝓘(ℂ, ℂ) ω F x ∧
      F =ᶠ[nhdsWithin x {x}ᶜ] (fun z ↦ ((f z : ℂ) : OnePoint ℂ)) ∧
      F x = b4c_meromorphicValue f x := by
  by_cases ho : 0 ≤ meromorphicOrderAt f x
  · obtain ⟨g, hg, hfg⟩ := hf.meromorphicOrderAt_nonneg_iff.mp ho
    have hord : meromorphicOrderAt f x = meromorphicOrderAt g x :=
      meromorphicOrderAt_congr hfg
    refine ⟨fun z ↦ (g z : OnePoint ℂ),
      b4cov_coe_contMDiff.contMDiffAt.comp x hg.contDiffAt.contMDiffAt, ?_, ?_⟩
    · filter_upwards [hfg] with z hz
      rw [hz]
    · have hnlt : ¬meromorphicOrderAt f x < 0 := not_lt.mpr ho
      by_cases hz : meromorphicOrderAt f x = 0
      · have hg0 : g x ≠ 0 := by
          apply hg.analyticOrderAt_eq_zero.mp
          have hm : meromorphicOrderAt g x = 0 := hord.symm.trans hz
          rw [hg.meromorphicOrderAt_eq] at hm
          simpa using hm
        have htrail : meromorphicTrailingCoeffAt f x = g x := by
          rw [meromorphicTrailingCoeffAt_congr_nhdsNE hfg,
            hg.meromorphicTrailingCoeffAt_of_ne_zero hg0]
        simp [b4c_meromorphicValue, hnlt, hz, htrail]
      · have hg0 : g x = 0 := by
          by_contra hg0
          have : meromorphicOrderAt g x = 0 := by
            rw [hg.meromorphicOrderAt_eq, hg.analyticOrderAt_eq_zero.mpr hg0]
            rfl
          exact hz (hord.trans this)
        simp [b4c_meromorphicValue, hnlt, hz, hg0]
  · have hneg : meromorphicOrderAt f x < 0 := lt_of_not_ge ho
    obtain ⟨n, hn⟩ := WithTop.ne_top_iff_exists.mp hneg.ne_top
    have hnneg : n < 0 := by exact_mod_cast (hn ▸ hneg)
    have hinv : 0 ≤ meromorphicOrderAt f⁻¹ x := by
      rw [meromorphicOrderAt_inv, ← hn]
      exact_mod_cast neg_nonneg.mpr hnneg.le
    obtain ⟨g, hg, hfg⟩ := hf.inv.meromorphicOrderAt_nonneg_iff.mp hinv
    have hgord : meromorphicOrderAt g x = meromorphicOrderAt f⁻¹ x :=
      (meromorphicOrderAt_congr hfg).symm
    have hg0 : g x = 0 := by
      by_contra hg0
      have hz : meromorphicOrderAt g x = 0 := by
        rw [hg.meromorphicOrderAt_eq, hg.analyticOrderAt_eq_zero.mpr hg0]
        rfl
      rw [hz, meromorphicOrderAt_inv, ← hn] at hgord
      simp at hgord
      omega
    refine ⟨fun z ↦ b4cov_sphInv (g z : OnePoint ℂ),
      b4c_inverse_coe_contMDiff.contMDiffAt.comp x hg.contDiffAt.contMDiffAt, ?_, ?_⟩
    · have hne := (meromorphicOrderAt_ne_top_iff_eventually_ne_zero hf).mp hneg.ne_top
      filter_upwards [hfg, hne] with z hz hzf
      have hgz : g z = (f z)⁻¹ := hz.symm
      rw [hgz, b4cov_sphInv_coe (inv_ne_zero hzf), inv_inv]
    · simp [b4c_meromorphicValue, hneg, hg0]

theorem b4c_punctured_nhds_neBot (hE : Module.finrank ℂ E = 1) (x : C) :
    (nhdsWithin x {x}ᶜ).NeBot := by
  letI : Nontrivial E := Module.nontrivial_of_finrank_eq_succ hE
  let e := chartAt E x
  have hx : x ∈ e.source := mem_chart_source E x
  have hc : Tendsto e.symm (nhds (e x)) (nhds x) := by
    simpa only [e.left_inv hx] using (e.symm.continuousAt (e.map_source hx)).tendsto
  have hn : ∀ᶠ z in nhdsWithin (e x) {e x}ᶜ, e.symm z ≠ x := by
    filter_upwards [nhdsWithin_le_nhds (e.open_target.mem_nhds (e.map_source hx)),
      self_mem_nhdsWithin] with z hz hzx
    intro he
    apply hzx
    rw [← e.right_inv hz, he]
    rfl
  have ht : Tendsto e.symm (nhdsWithin (e x) {e x}ᶜ) (nhdsWithin x {x}ᶜ) :=
    tendsto_nhdsWithin_iff.mpr ⟨hc.mono_left nhdsWithin_le_nhds, hn⟩
  exact ht.neBot

theorem b4c_glue_punctured_germs [T1Space C]
    [∀ x : C, (nhdsWithin x {x}ᶜ).NeBot] (f : C → OnePoint ℂ)
    (F : C → C → OnePoint ℂ)
    (hF : ∀ x, ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω (F x) x)
    (hfg : ∀ x, F x =ᶠ[nhdsWithin x {x}ᶜ] f) :
    ∀ x, (fun y ↦ F y y) =ᶠ[nhds x] F x := by
  intro x
  have he : ∀ᶠ z in nhds x, z ≠ x → F x z = f z := by
    simpa only [Filter.EventuallyEq, eventually_nhdsWithin_iff, mem_compl_iff,
      mem_singleton_iff] using hfg x
  have ha := (contMDiffAt_iff_contMDiffAt_nhds (by simp)).mp (hF x)
  filter_upwards [he.eventually_nhds, ha] with y hy hya
  by_cases hyx : y = x
  · subst y
    rfl
  have hxy : F x =ᶠ[nhds y] f := by
    filter_upwards [hy, eventually_ne_nhds hyx] with z hz hzx
    exact hz hzx
  have hsame : F y =ᶠ[nhdsWithin y {y}ᶜ] F x :=
    (hfg y).trans (hxy.filter_mono nhdsWithin_le_nhds).symm
  exact ((hF y).continuousAt.eventuallyEq_nhds_iff_eventuallyEq_nhdsNE
    hya.continuousAt).mp hsame |>.self_of_nhds

theorem b4c_contMDiff_of_punctured_extensions [T1Space C]
    [∀ x : C, (nhdsWithin x {x}ᶜ).NeBot] (f : C → OnePoint ℂ)
    (h : ∀ x, ∃ F : C → OnePoint ℂ,
      ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω F x ∧
        F =ᶠ[nhdsWithin x {x}ᶜ] f) :
    ∃ F : C → OnePoint ℂ, ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω F ∧
      ∀ x, F =ᶠ[nhdsWithin x {x}ᶜ] f := by
  choose F hF hg using h
  have he := b4c_glue_punctured_germs f F hF hg
  refine ⟨fun x ↦ F x x, fun x ↦ (hF x).congr_of_eventuallyEq (he x), ?_⟩
  intro x
  exact ((he x).filter_mono nhdsWithin_le_nhds).trans (hg x)

def b4c_centeredCoordinate (hE : Module.finrank ℂ E = 1) (x y : C) : ℂ :=
  (b4cov_lineEquiv hE).symm
    (extChartAt 𝓘(ℂ, E) x y - extChartAt 𝓘(ℂ, E) x x)

theorem b4c_centeredCoordinate_self (hE : Module.finrank ℂ E = 1) (x : C) :
    b4c_centeredCoordinate hE x x = 0 := by
  simp [b4c_centeredCoordinate]

theorem b4c_centeredCoordinate_ne (hE : Module.finrank ℂ E = 1) (x y : C)
    (hy : y ∈ (extChartAt 𝓘(ℂ, E) x).source) (hne : y ≠ x) :
    b4c_centeredCoordinate hE x y ≠ 0 := by
  intro hz
  have hh : extChartAt 𝓘(ℂ, E) x y = extChartAt 𝓘(ℂ, E) x x := by
    apply sub_eq_zero.mp
    exact (b4cov_lineEquiv hE).symm.injective (hz.trans (map_zero _).symm)
  exact hne ((extChartAt 𝓘(ℂ, E) x).injOn hy (mem_extChartAt_source x) hh)

theorem b4c_centeredCoordinate_contMDiffAt (hE : Module.finrank ℂ E = 1)
    (x y : C) (hy : y ∈ (extChartAt 𝓘(ℂ, E) x).source) :
    ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω (b4c_centeredCoordinate hE x) y := by
  exact (b4cov_lineEquiv hE).symm.contDiff.contMDiff.contMDiffAt.comp y
    ((contMDiffAt_extChartAt' (by simpa only [extChartAt_source] using hy)).sub
      contMDiffAt_const)

theorem b4c_meromorphicOrder_ne_top_eventually {f : ℂ → ℂ} {x : ℂ}
    (hf : MeromorphicAt f x) (hx : meromorphicOrderAt f x ≠ ⊤) :
    ∀ᶠ y in nhds x, meromorphicOrderAt f y ≠ ⊤ := by
  have ha := hf.eventually_analyticAt
  have hn := (meromorphicOrderAt_ne_top_iff_eventually_ne_zero hf).mp hx
  have hp : ∀ᶠ y in nhdsWithin x {x}ᶜ, meromorphicOrderAt f y ≠ ⊤ := by
    filter_upwards [ha, hn] with y hay hny
    rw [hay.meromorphicOrderAt_eq, hay.analyticOrderAt_eq_zero.mpr hny]
    simp
  have hp' := eventually_nhdsWithin_iff.mp hp
  filter_upwards [hp'] with y hy
  by_cases hyx : y = x
  · simpa only [hyx] using hx
  · exact hy (by simpa only [mem_compl_iff, mem_singleton_iff])

theorem b4c_meromorphicOrder_eq_top_eventually {f : ℂ → ℂ} {x : ℂ}
    (hx : meromorphicOrderAt f x = ⊤) :
    ∀ᶠ y in nhds x, meromorphicOrderAt f y = ⊤ := by
  have hzero : f =ᶠ[nhdsWithin x {x}ᶜ] 0 := meromorphicOrderAt_eq_top_iff.mp hx
  have hspread : ∀ᶠ y in nhds x, ∀ᶠ z in nhdsWithin y {x}ᶜ, f z = 0 :=
    eventually_nhds_nhdsWithin.mpr hzero
  filter_upwards [hspread] with y hy
  by_cases hyx : y = x
  · simpa only [hyx] using hx
  · rw [meromorphicOrderAt_eq_top_iff]
    have hy' := eventually_nhdsWithin_iff.mp hy
    have hz : ∀ᶠ z in nhds y, f z = 0 := by
      filter_upwards [hy', eventually_ne_nhds hyx] with z hz hzx
      exact hz (by simpa only [mem_compl_iff, mem_singleton_iff])
    exact hz.filter_mono nhdsWithin_le_nhds

theorem b4c_meroForm_finiteOrder_isOpen (hE : Module.finrank ℂ E = 1)
    (w : b4c_MeroForm E C hE) :
    IsOpen {x : C | meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 ≠ ⊤} := by
  rw [isOpen_iff_mem_nhds]
  intro x hx
  let z := b4c_centeredCoordinate hE x
  have hz0 : z x = 0 := b4c_centeredCoordinate_self hE x
  have hzs : ∀ᶠ y in nhds x, y ∈ (extChartAt 𝓘(ℂ, E) x).source :=
    (isOpen_extChartAt_source x).mem_nhds (mem_extChartAt_source x)
  have hzt : Tendsto z (nhds x) (nhds 0) := by
    rw [← hz0]
    exact (b4c_centeredCoordinate_contMDiffAt hE x x
      (mem_extChartAt_source x)).continuousAt
  have hp := b4c_meromorphicOrder_ne_top_eventually (w.2.2 x) hx
  filter_upwards [hzs, hzt hp] with y hys hy
  rw [HurwitzPrymRR_ord_chart hE w w.2.1 x y hys]
  exact hy

theorem b4c_meroForm_infiniteOrder_isOpen (hE : Module.finrank ℂ E = 1)
    (w : b4c_MeroForm E C hE) :
    IsOpen {x : C | meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 = ⊤} := by
  rw [isOpen_iff_mem_nhds]
  intro x hx
  let z := b4c_centeredCoordinate hE x
  have hz0 : z x = 0 := b4c_centeredCoordinate_self hE x
  have hzs : ∀ᶠ y in nhds x, y ∈ (extChartAt 𝓘(ℂ, E) x).source :=
    (isOpen_extChartAt_source x).mem_nhds (mem_extChartAt_source x)
  have hzt : Tendsto z (nhds x) (nhds 0) := by
    rw [← hz0]
    exact (b4c_centeredCoordinate_contMDiffAt hE x x
      (mem_extChartAt_source x)).continuousAt
  have hp := b4c_meromorphicOrder_eq_top_eventually hx
  filter_upwards [hzs, hzt hp] with y hys hy
  rw [HurwitzPrymRR_ord_chart hE w w.2.1 x y hys]
  exact hy

theorem b4c_meroForm_order_ne_top [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (w : b4c_MeroForm E C hE)
    (hg : ∃ x, meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 ≠ ⊤) :
    ∀ x, meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 ≠ ⊤ := by
  let A : Set C := {x | meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 ≠ ⊤}
  have hAo : IsOpen A := b4c_meroForm_finiteOrder_isOpen hE w
  have hAc : IsClosed A := by
    have htop := b4c_meroForm_infiniteOrder_isOpen hE w
    have heq : A = {x : C |
        meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 = ⊤}ᶜ := by
      ext x
      simp [A]
    rw [heq]
    exact htop.isClosed_compl
  rcases isClopen_iff.mp ⟨hAc, hAo⟩ with hA | hA
  · obtain ⟨x, hx⟩ := hg
    have : x ∈ A := hx
    rw [hA] at this
    exact this.elim
  · intro x
    have : x ∈ A := by rw [hA]; trivial
    exact this

theorem b4c_formRatio_chart_regular (hE : Module.finrank ℂ E = 1)
    (w₁ w₂ : b4c_MeroForm E C hE) (x y : C)
    (hy : y ∈ (extChartAt 𝓘(ℂ, E) x).source)
    (ha₁ : AnalyticAt ℂ (HurwitzPrymRR_loc hE w₁ x) (b4c_centeredCoordinate hE x y))
    (ha₂ : AnalyticAt ℂ (HurwitzPrymRR_loc hE w₂ x) (b4c_centeredCoordinate hE x y))
    (hn₁ : HurwitzPrymRR_loc hE w₁ x (b4c_centeredCoordinate hE x y) ≠ 0)
    (hn₂ : HurwitzPrymRR_loc hE w₂ x (b4c_centeredCoordinate hE x y) ≠ 0) :
    b4c_formRatio (hE := hE) w₁ w₂ y =
      (((HurwitzPrymRR_loc hE w₁ x (b4c_centeredCoordinate hE x y) /
        HurwitzPrymRR_loc hE w₂ x (b4c_centeredCoordinate hE x y) : ℂ)) : OnePoint ℂ) := by
  letI : FiniteDimensional ℂ E := Module.finite_of_finrank_eq_succ hE
  letI : CompleteSpace E := FiniteDimensional.complete ℂ E
  letI : Nontrivial E := Module.nontrivial_of_finrank_eq_succ hE
  have hid : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω (id : C → C) := contMDiff_id
  set G := b4cov_expr E E (id : C → C) y x
  set T := b4cov_transport hE hE G (extChartAt 𝓘(ℂ, E) y y)
  set σ := b4c_centeredCoordinate hE x y
  change AnalyticAt ℂ (HurwitzPrymRR_loc hE w₁ x) σ at ha₁
  change AnalyticAt ℂ (HurwitzPrymRR_loc hE w₂ x) σ at ha₂
  have hys : y ∈ (extChartAt 𝓘(ℂ, E) y).source := mem_extChartAt_source y
  have hGan : AnalyticAt ℂ G (extChartAt 𝓘(ℂ, E) y y) :=
    b4cov_analyticAt_chart id hid y x _ ((extChartAt 𝓘(ℂ, E) y).map_source hys)
      (by rw [(extChartAt 𝓘(ℂ, E) y).left_inv hys]; exact hy)
  have hTan : AnalyticAt ℂ T 0 := b4cov_transport_analyticAt hE hE hGan
  have hG' : fderiv ℂ G (extChartAt 𝓘(ℂ, E) y y) ≠ 0 := by
    refine (b4cov_mfderiv_ne_zero_iff_expr id hid y x y hys hy).1 ?_
    rw [mfderiv_id]
    intro h0
    obtain ⟨v, hv⟩ := exists_ne (0 : E)
    exact hv (congrArg (fun L : E →L[ℂ] E ↦ L v) h0)
  have hT' : deriv T 0 ≠ 0 := by
    rw [b4cov_transport_deriv hE hE 0 (by simpa using hGan.differentiableAt)]
    simp only [map_zero, add_zero]
    intro h0
    apply hG'
    ext v
    have h1 : fderiv ℂ G (extChartAt 𝓘(ℂ, E) y y) (b4cov_lineEquiv hE 1) = 0 := by
      simpa using congrArg (b4cov_lineEquiv hE) h0
    have hv : v = (b4cov_lineEquiv hE).symm v • b4cov_lineEquiv hE 1 := by
      rw [← map_smul, smul_eq_mul, mul_one, ContinuousLinearEquiv.apply_symm_apply]
    rw [hv, map_smul, h1, smul_zero]
    rfl
  have hloc₁ := HurwitzPrymRR_loc_pullback hE hE id hid y x hy w₁ w₁.2.1
  have hloc₂ := HurwitzPrymRR_loc_pullback hE hE id hid y x hy w₂ w₂.2.1
  rw [HurwitzPrymRR_pullback_id] at hloc₁ hloc₂
  change HurwitzPrymRR_loc hE w₁ y =ᶠ[nhds 0]
    (fun t ↦ HurwitzPrymRR_loc hE w₁ x (σ + T t) * deriv T t) at hloc₁
  change HurwitzPrymRR_loc hE w₂ y =ᶠ[nhds 0]
    (fun t ↦ HurwitzPrymRR_loc hE w₂ x (σ + T t) * deriv T t) at hloc₂
  have hT0 : T 0 = 0 := b4cov_transport_zero hE hE _ _
  have hc : AnalyticAt ℂ (fun t ↦ σ + T t) 0 := analyticAt_const.add hTan
  have han₁ : AnalyticAt ℂ (HurwitzPrymRR_loc hE w₁ y) 0 :=
    (analyticAt_congr hloc₁).mpr
      ((ha₁.comp_of_eq hc (by rw [hT0, add_zero])).mul hTan.deriv)
  have han₂ : AnalyticAt ℂ (HurwitzPrymRR_loc hE w₂ y) 0 :=
    (analyticAt_congr hloc₂).mpr
      ((ha₂.comp_of_eq hc (by rw [hT0, add_zero])).mul hTan.deriv)
  have hv₁ : HurwitzPrymRR_loc hE w₁ y 0 =
      HurwitzPrymRR_loc hE w₁ x σ * deriv T 0 := by
    simpa [hT0] using hloc₁.self_of_nhds
  have hv₂ : HurwitzPrymRR_loc hE w₂ y 0 =
      HurwitzPrymRR_loc hE w₂ x σ * deriv T 0 := by
    simpa [hT0] using hloc₂.self_of_nhds
  have hv₂ne : HurwitzPrymRR_loc hE w₂ y 0 ≠ 0 := by
    rw [hv₂]
    exact mul_ne_zero hn₂ hT'
  let q := fun z ↦ HurwitzPrymRR_loc hE w₁ y z / HurwitzPrymRR_loc hE w₂ y z
  have hqa : AnalyticAt ℂ q 0 := han₁.div han₂ hv₂ne
  have hq0 : q 0 ≠ 0 := by
    dsimp only [q]
    rw [hv₁, hv₂]
    exact div_ne_zero (mul_ne_zero hn₁ hT') (mul_ne_zero hn₂ hT')
  have hqo : meromorphicOrderAt q 0 = 0 := by
    rw [hqa.meromorphicOrderAt_eq, hqa.analyticOrderAt_eq_zero.mpr hq0]
    rfl
  have hqt : meromorphicTrailingCoeffAt q 0 = q 0 :=
    hqa.meromorphicTrailingCoeffAt_of_ne_zero hq0
  unfold b4c_formRatio
  change (if meromorphicOrderAt q 0 < 0 then OnePoint.infty
    else if meromorphicOrderAt q 0 = 0 then
      ((meromorphicTrailingCoeffAt q 0 : ℂ) : OnePoint ℂ) else (0 : ℂ)) = _
  rw [hqo, hqt]
  simp only [lt_self_iff_false, ite_false, ↓reduceIte, q, hv₁, hv₂]
  field_simp

theorem b4c_formRatio_isMeroFun_aux [ConnectedSpace C] (hE : Module.finrank ℂ E = 1)
    (w₁ w₂ : b4c_MeroForm E C hE)
    (hw₁ : (w₁ : TangentBundle 𝓘(ℂ, E) C → ℂ) ≠ 0)
    (hw₂ : (w₂ : TangentBundle 𝓘(ℂ, E) C → ℂ) ≠ 0)
    (hg₁ : ∃ x, meromorphicOrderAt (HurwitzPrymRR_loc hE w₁ x) 0 ≠ ⊤)
    (hg₂ : ∃ x, meromorphicOrderAt (HurwitzPrymRR_loc hE w₂ x) 0 ≠ ⊤) :
    b4c_IsMeroFun E (b4c_formRatio (hE := hE) w₁ w₂) := by
  have htop₁ := b4c_meroForm_order_ne_top hE w₁ hg₁
  have htop₂ := b4c_meroForm_order_ne_top hE w₂ hg₂
  have hregular : ∀ x, ∀ᶠ y in nhdsWithin x {x}ᶜ,
      y ∈ (extChartAt 𝓘(ℂ, E) x).source ∧
      AnalyticAt ℂ (HurwitzPrymRR_loc hE w₁ x) (b4c_centeredCoordinate hE x y) ∧
      AnalyticAt ℂ (HurwitzPrymRR_loc hE w₂ x) (b4c_centeredCoordinate hE x y) ∧
      HurwitzPrymRR_loc hE w₁ x (b4c_centeredCoordinate hE x y) ≠ 0 ∧
      HurwitzPrymRR_loc hE w₂ x (b4c_centeredCoordinate hE x y) ≠ 0 := by
    intro x
    have hs : ∀ᶠ y in nhds x, y ∈ (extChartAt 𝓘(ℂ, E) x).source :=
      (isOpen_extChartAt_source x).mem_nhds (mem_extChartAt_source x)
    have hz : Tendsto (b4c_centeredCoordinate hE x) (nhdsWithin x {x}ᶜ)
        (nhdsWithin 0 {0}ᶜ) := by
      refine tendsto_nhdsWithin_iff.mpr ⟨?_, ?_⟩
      · simpa only [b4c_centeredCoordinate_self hE x] using
          (b4c_centeredCoordinate_contMDiffAt hE x x
            (mem_extChartAt_source x)).continuousAt.tendsto.mono_left nhdsWithin_le_nhds
      · filter_upwards [hs.filter_mono nhdsWithin_le_nhds, self_mem_nhdsWithin] with y hys hyx
        exact b4c_centeredCoordinate_ne hE x y hys hyx
    have ha₁ := hz.eventually (w₁.2.2 x).eventually_analyticAt
    have ha₂ := hz.eventually (w₂.2.2 x).eventually_analyticAt
    have hn₁ := hz.eventually
      ((meromorphicOrderAt_ne_top_iff_eventually_ne_zero (w₁.2.2 x)).mp (htop₁ x))
    have hn₂ := hz.eventually
      ((meromorphicOrderAt_ne_top_iff_eventually_ne_zero (w₂.2.2 x)).mp (htop₂ x))
    filter_upwards [hs.filter_mono nhdsWithin_le_nhds, ha₁, ha₂, hn₁, hn₂,
      self_mem_nhdsWithin] with y hys hya₁ hya₂ hyn₁ hyn₂ hyx
    exact ⟨hys, hya₁, hya₂, hyn₁, hyn₂⟩
  refine ⟨?_, ?_⟩
  · intro x
    let q := fun z ↦ HurwitzPrymRR_loc hE w₁ x z / HurwitzPrymRR_loc hE w₂ x z
    have hq : MeromorphicAt q 0 := (w₁.2.2 x).div (w₂.2.2 x)
    obtain ⟨F, hFa, hFpunct, hF0⟩ := b4c_meromorphic_germ_sphere_extension_spec hq
    let z := b4c_centeredCoordinate hE x
    have hz0 : z x = 0 := b4c_centeredCoordinate_self hE x
    have hza : ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω z x :=
      b4c_centeredCoordinate_contMDiffAt hE x x (mem_extChartAt_source x)
    have hcomp : ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω (F ∘ z) x := by
      have hFa' : ContMDiffAt 𝓘(ℂ, ℂ) 𝓘(ℂ, ℂ) ω F (z x) := by
        simpa only [hz0] using hFa
      exact hFa'.comp x hza
    apply hcomp.congr_of_eventuallyEq
    have hcenter : F (z x) = b4c_formRatio (hE := hE) w₁ w₂ x := by
      rw [hz0, hF0]
      rfl
    have hFp : ∀ᶠ y in nhdsWithin x {x}ᶜ,
        F (z y) = ((q (z y) : ℂ) : OnePoint ℂ) := by
      have hzt : Tendsto z (nhdsWithin x {x}ᶜ) (nhdsWithin 0 {0}ᶜ) := by
        have hs0 : ∀ᶠ y in nhds x, y ∈ (extChartAt 𝓘(ℂ, E) x).source :=
          (isOpen_extChartAt_source x).mem_nhds (mem_extChartAt_source x)
        have hs' : ∀ᶠ y in nhdsWithin x {x}ᶜ,
            y ∈ (extChartAt 𝓘(ℂ, E) x).source :=
          hs0.filter_mono nhdsWithin_le_nhds
        refine tendsto_nhdsWithin_iff.mpr ⟨?_, ?_⟩
        · simpa only [hz0] using hza.continuousAt.tendsto.mono_left nhdsWithin_le_nhds
        · filter_upwards [hs', self_mem_nhdsWithin] with y hys hyx
          exact b4c_centeredCoordinate_ne hE x y hys hyx
      exact hzt.eventually hFpunct
    have hp : ∀ᶠ y in nhdsWithin x {x}ᶜ,
        F (z y) = b4c_formRatio (hE := hE) w₁ w₂ y := by
      filter_upwards [hFp, hregular x] with y hFy hy
      rw [hFy, b4c_formRatio_chart_regular hE w₁ w₂ x y hy.1 hy.2.1 hy.2.2.1
        hy.2.2.2.1 hy.2.2.2.2]
    have hp' := eventually_nhdsWithin_iff.mp hp
    filter_upwards [hp'] with y hy
    by_cases hyx : y = x
    · simpa only [hyx, Function.comp_apply] using hcenter.symm
    · exact (hy (by simpa only [mem_compl_iff, mem_singleton_iff])).symm
  · obtain ⟨x, _⟩ := hg₁
    letI : (nhdsWithin x {x}ᶜ).NeBot := b4c_punctured_nhds_neBot hE x
    obtain ⟨y, hy⟩ := (hregular x).exists
    refine ⟨y, ?_⟩
    rw [b4c_formRatio_chart_regular hE w₁ w₂ x y hy.1 hy.2.1 hy.2.2.1
      hy.2.2.2.1 hy.2.2.2.2]
    simp

def b4c_targetLocal (hE : Module.finrank ℂ E = 1)
    (F : C → OnePoint ℂ) (x : C) : ℂ → ℂ :=
  fun t ↦ b4cov_expr E ℂ F x (F x)
    (extChartAt 𝓘(ℂ, E) x x + b4cov_lineEquiv hE t)

theorem b4c_targetLocal_order [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (F : C → OnePoint ℂ)
    (hF : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω F) (hnc : ∃ x y, F x ≠ F y) (x : C)
    (hzero : b4c_targetLocal hE F x 0 = 0) :
    meromorphicOrderAt (b4c_targetLocal hE F x) 0 =
      ((b4_ramIndex E ℂ F x : ℤ) : WithTop ℤ) := by
  let G := b4cov_expr E ℂ F x (F x)
  let z := extChartAt 𝓘(ℂ, E) x x
  let L := b4cov_lineEquiv (show Module.finrank ℂ ℂ = 1 by simp)
  let T := b4cov_transport hE (show Module.finrank ℂ ℂ = 1 by simp) G z
  have hG := b4cov_analyticAt_chart F hF x (F x) z (mem_extChartAt_target x) (by
    rw [extChartAt_to_inv]; exact mem_extChartAt_source (F x))
  have hT : AnalyticAt ℂ T 0 := b4cov_transport_analyticAt hE (by simp) hG
  obtain ⟨he, hne, hlow⟩ := b4cov_ramIndex_spec F hF hnc x
  have hTo : analyticOrderAt T 0 = b4_ramIndex E ℂ F x :=
    b4cov_analyticOrderAt_transport hE (by simp) hG he hlow hne
  have hG0 : G z = 0 := by
    simpa only [b4c_targetLocal, map_zero, add_zero] using hzero
  have hL (t : ℂ) : L t = L 1 * t := by
    simpa only [smul_eq_mul, mul_one, mul_comm] using L.map_smul t 1
  have hA : b4c_targetLocal hE F x = (fun _ : ℂ ↦ L 1) * T := by
    funext t
    change G (z + b4cov_lineEquiv hE t) = L 1 * T t
    rw [← hL]
    simp only [T, b4cov_transport, hG0, map_zero, sub_zero]
    exact (L.apply_symm_apply _).symm
  have hc : L 1 ≠ 0 := L.map_ne_zero_iff.mpr one_ne_zero
  rw [hA, meromorphicOrderAt_mul (MeromorphicAt.const (L 1) 0) hT.meromorphicAt,
    meromorphicOrderAt_const, if_neg hc, zero_add, hT.meromorphicOrderAt_eq, hTo]
  simp only [ENat.map_natCast]

theorem b4c_inverse_centeredCoordinate_punctured
    (hE : Module.finrank ℂ E = 1) (x : C) :
    Tendsto (fun t : ℂ ↦ (extChartAt 𝓘(ℂ, E) x).symm
      (extChartAt 𝓘(ℂ, E) x x + b4cov_lineEquiv hE t))
      (nhdsWithin 0 {0}ᶜ) (nhdsWithin x {x}ᶜ) := by
  let φ := extChartAt 𝓘(ℂ, E) x
  let L := b4cov_lineEquiv hE
  have hx : x ∈ φ.source := mem_extChartAt_source x
  have ha : Continuous (fun t : ℂ ↦ φ x + L t) := continuous_const.add L.continuous
  have ht : ∀ᶠ t : ℂ in nhds 0, φ x + L t ∈ φ.target :=
    ha.continuousAt.preimage_mem_nhds (by
      have hh : φ.target ∈ nhds (φ x) :=
        (isOpen_extChartAt_target x).mem_nhds (φ.map_source hx)
      simpa only [map_zero, add_zero] using hh)
  have hc : Tendsto φ.symm (nhds (φ x)) (nhds x) := by
    have hh := ((continuousOn_extChartAt_symm x).continuousAt
      ((isOpen_extChartAt_target x).mem_nhds (φ.map_source hx))).tendsto
    change Tendsto φ.symm (nhds (φ x)) (nhds (φ.symm (φ x))) at hh
    rwa [φ.left_inv hx] at hh
  refine tendsto_nhdsWithin_iff.mpr ⟨?_, ?_⟩
  · apply hc.comp
    simpa only [map_zero, add_zero] using
      (ha.continuousAt (x := 0)).tendsto.mono_left nhdsWithin_le_nhds
  · filter_upwards [ht.filter_mono nhdsWithin_le_nhds, self_mem_nhdsWithin] with t ht hne
    change φ.symm (φ x + L t) ≠ x
    intro he
    have hh := congrArg φ he
    rw [φ.right_inv ht] at hh
    have hz : L t = 0 := add_left_cancel (hh.trans (add_zero (φ x)).symm)
    exact hne (L.map_eq_zero_iff.mp hz)

theorem b4c_centeredCoordinate_inverse_eventuallyEq
    (hE : Module.finrank ℂ E = 1) (x : C) :
    (fun t : ℂ ↦ b4c_centeredCoordinate hE x
      ((extChartAt 𝓘(ℂ, E) x).symm
        (extChartAt 𝓘(ℂ, E) x x + b4cov_lineEquiv hE t))) =ᶠ[nhds 0]
      id := by
  let φ := extChartAt 𝓘(ℂ, E) x
  let L := b4cov_lineEquiv hE
  have hx : x ∈ φ.source := mem_extChartAt_source x
  have ha : Continuous (fun t : ℂ ↦ φ x + L t) := continuous_const.add L.continuous
  have ht : ∀ᶠ t : ℂ in nhds 0, φ x + L t ∈ φ.target :=
    ha.continuousAt.preimage_mem_nhds (by
      have hh : φ.target ∈ nhds (φ x) :=
        (isOpen_extChartAt_target x).mem_nhds (φ.map_source hx)
      simpa only [map_zero, add_zero] using hh)
  filter_upwards [ht] with t ht
  simp only [b4c_centeredCoordinate, φ.right_inv ht, add_sub_cancel_left,
    ContinuousLinearEquiv.symm_apply_apply, id_eq, φ, L]

theorem b4c_formRatio_punctured_chart (hE : Module.finrank ℂ E = 1)
    (w₁ w₂ : b4c_MeroForm E C hE)
    (htop₁ : ∀ x, meromorphicOrderAt (HurwitzPrymRR_loc hE w₁ x) 0 ≠ ⊤)
    (htop₂ : ∀ x, meromorphicOrderAt (HurwitzPrymRR_loc hE w₂ x) 0 ≠ ⊤)
    (x : C) :
    ∀ᶠ y in nhdsWithin x {x}ᶜ, b4c_formRatio (hE := hE) w₁ w₂ y =
      (((HurwitzPrymRR_loc hE w₁ x (b4c_centeredCoordinate hE x y) /
        HurwitzPrymRR_loc hE w₂ x (b4c_centeredCoordinate hE x y) : ℂ)) : OnePoint ℂ) := by
  have hs : ∀ᶠ y in nhds x, y ∈ (extChartAt 𝓘(ℂ, E) x).source :=
    (isOpen_extChartAt_source x).mem_nhds (mem_extChartAt_source x)
  have hz : Tendsto (b4c_centeredCoordinate hE x) (nhdsWithin x {x}ᶜ)
      (nhdsWithin 0 {0}ᶜ) := by
    refine tendsto_nhdsWithin_iff.mpr ⟨?_, ?_⟩
    · simpa only [b4c_centeredCoordinate_self hE x] using
        (b4c_centeredCoordinate_contMDiffAt hE x x
          (mem_extChartAt_source x)).continuousAt.tendsto.mono_left nhdsWithin_le_nhds
    · filter_upwards [hs.filter_mono nhdsWithin_le_nhds,
        self_mem_nhdsWithin] with y hys hyx
      exact b4c_centeredCoordinate_ne hE x y hys hyx
  have ha₁ := hz.eventually (w₁.2.2 x).eventually_analyticAt
  have ha₂ := hz.eventually (w₂.2.2 x).eventually_analyticAt
  have hn₁ := hz.eventually
    ((meromorphicOrderAt_ne_top_iff_eventually_ne_zero (w₁.2.2 x)).mp (htop₁ x))
  have hn₂ := hz.eventually
    ((meromorphicOrderAt_ne_top_iff_eventually_ne_zero (w₂.2.2 x)).mp (htop₂ x))
  filter_upwards [hs.filter_mono nhdsWithin_le_nhds, ha₁, ha₂, hn₁, hn₂] with y hys hya₁ hya₂ hyn₁ hyn₂
  exact b4c_formRatio_chart_regular hE w₁ w₂ x y hys hya₁ hya₂ hyn₁ hyn₂
theorem b4c_pullback_isMeroForm_aux
    (hE : Module.finrank ℂ E = 1) {E' Y : Type} [NormedAddCommGroup E'] [NormedSpace ℂ E']
    [TopologicalSpace Y] [ChartedSpace E' Y] [IsManifold 𝓘(ℂ, E') ω Y]
    (hE' : Module.finrank ℂ E' = 1) (f : C → Y)
    (hf : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E') ω f) (hnc : ∃ x x', f x ≠ f x')
    (w : b4c_MeroForm E' Y hE') :
    b4c_IsMeroForm hE (b4c_pullback (hE := hE) (hE' := hE') f w) := by
  refine ⟨?_, ?_⟩
  · intro x a v v'
    change w ⟨f x, _⟩ = a * w ⟨f x, _⟩ + w ⟨f x, _⟩
    rw [map_add, map_smul, w.2.1]
  · intro x
    have hloc := HurwitzPrymRR_loc_pullback hE hE' f hf x (f x)
      (mem_extChartAt_source _) w w.2.1
    set T := b4cov_transport hE hE' (b4cov_expr E E' f x (f x))
      (extChartAt (modelWithCornersSelf ℂ E) x x)
    have hx : x ∈ (extChartAt (modelWithCornersSelf ℂ E) x).source := mem_extChartAt_source x
    have hG : AnalyticAt ℂ (b4cov_expr E E' f x (f x))
        (extChartAt (modelWithCornersSelf ℂ E) x x) :=
      b4cov_analyticAt_chart f hf x (f x) _
        ((extChartAt (modelWithCornersSelf ℂ E) x).map_source hx)
        (by rw [(extChartAt (modelWithCornersSelf ℂ E) x).left_inv hx]
            exact mem_extChartAt_source _)
    have hT : AnalyticAt ℂ T 0 := b4cov_transport_analyticAt hE hE' hG
    have hT0 : T 0 = 0 := b4cov_transport_zero hE hE' _ _
    have hmcomp : MeromorphicAt (HurwitzPrymRR_loc hE' w (f x) ∘ T) 0 := by
      have hm0 : MeromorphicAt (HurwitzPrymRR_loc hE' w (f x)) (T 0) := by
        simpa only [hT0] using w.2.2 (f x)
      exact hm0.comp_analyticAt hT
    have hprod : MeromorphicAt
        (fun t ↦ HurwitzPrymRR_loc hE' w (f x) (T t) * deriv T t) 0 := by
      exact hmcomp.mul hT.deriv.meromorphicAt
    apply hprod.congr
    simpa only [b4c_pullback, sub_self, map_zero, zero_add, T] using
      (hloc.filter_mono nhdsWithin_le_nhds).symm
/-- A meromorphic form has zero residue away from the support of its order divisor.
Tag: RiemannRochRes. -/
theorem b4c_res_eq_zero_of_ordForm_eq_zero (hE : Module.finrank ℂ E = 1)
    (w : b4c_MeroForm E C hE) (x : C) (hx : b4c_ordForm (hE := hE) w x = 0) :
    b4c_res (hE := hE) w x = 0 := by
  apply residue_eq_zero_of_meromorphicOrderAt_nonneg
  rw [b4c_ordForm, WithTop.untop₀_eq_zero] at hx
  rcases hx with hx | hx
  · rw [hx]
  · rw [hx]
    exact le_top

/-- A fibrewise linear form is determined by its value on the chosen line basis.
Tag: RiemannRochRes. -/
theorem b4c_residue_linear_value (hE : Module.finrank ℂ E = 1)
    (θ : TangentBundle 𝓘(ℂ, E) C → ℂ) (hθ : HurwitzPrymRR_IsLinear θ)
    (x : C) (v : TangentSpace 𝓘(ℂ, E) x) :
    θ ⟨x, v⟩ = θ ⟨x, b4cov_lineEquiv hE 1⟩ * (b4cov_lineEquiv hE).symm v := by
  have hv : (v : E) = (b4cov_lineEquiv hE).symm v • b4cov_lineEquiv hE 1 := by
    rw [← map_smul, smul_eq_mul, mul_one]
    exact ((b4cov_lineEquiv hE).apply_symm_apply v).symm
  exact (congrArg (fun u : E ↦ θ ⟨x, u⟩) hv).trans
    ((hθ.smul x ((b4cov_lineEquiv hE).symm v) (b4cov_lineEquiv hE 1)).trans (mul_comm _ _))

/-- Normalizing the coefficient at the centre defines a fibrewise linear form.
Source: Mathlib `toMeromorphicNFAt`; the centred coefficient `HurwitzPrymRR_loc`.
Tag: RiemannRochRes. -/
def b4c_residue_normalizedForm (hE : Module.finrank ℂ E = 1)
    (w : b4c_MeroForm E C hE) : TangentBundle 𝓘(ℂ, E) C → ℂ :=
  fun v ↦ toMeromorphicNFAt (HurwitzPrymRR_loc hE w v.proj) 0 0 *
    (b4cov_lineEquiv hE).symm v.2

/-- The normalized form is linear in every fibre.
Tag: RiemannRochRes. -/
theorem b4c_residue_normalizedForm_linear (hE : Module.finrank ℂ E = 1)
    (w : b4c_MeroForm E C hE) :
    HurwitzPrymRR_IsLinear (b4c_residue_normalizedForm hE w) := by
  intro x a v v'
  change _ * (b4cov_lineEquiv hE).symm (a • (v : E) + (v' : E)) =
    a * (_ * (b4cov_lineEquiv hE).symm v) + _ * (b4cov_lineEquiv hE).symm v'
  erw [(b4cov_lineEquiv hE).symm.map_add, (b4cov_lineEquiv hE).symm.map_smul]
  simp only [smul_eq_mul]
  ring

/-- At a point with analytic centred coefficient, normalization preserves the form.
Tag: RiemannRochRes. -/
theorem b4c_residue_normalizedForm_eq (hE : Module.finrank ℂ E = 1)
    (w : b4c_MeroForm E C hE) (x : C)
    (hx : AnalyticAt ℂ (HurwitzPrymRR_loc hE w x) 0)
    (v : TangentSpace 𝓘(ℂ, E) x) :
    b4c_residue_normalizedForm hE w ⟨x, v⟩ = w ⟨x, v⟩ := by
  rw [b4c_residue_normalizedForm, toMeromorphicNFAt_eq_self.mpr hx.meromorphicNFAt]
  rw [b4c_residue_linear_value hE w w.2.1 x v]
  congr 1
  dsimp only [HurwitzPrymRR_loc, b4cov_coef]
  erw [(b4cov_lineEquiv hE).map_zero, add_zero,
    (extChartAt 𝓘(ℂ, E) x).left_inv (mem_extChartAt_source x), b4cov_vec_self]


/-- Analyticity of a coefficient in one chart gives analyticity in a chart centred at a
nearby point.
Tag: RiemannRochRes. -/
theorem b4c_residue_analytic_chart (hE : Module.finrank ℂ E = 1)
    (θ : TangentBundle 𝓘(ℂ, E) C → ℂ) (hθ : HurwitzPrymRR_IsLinear θ)
    (x y : C) (hy : y ∈ (extChartAt 𝓘(ℂ, E) x).source)
    (hcoef : AnalyticAt ℂ (HurwitzPrymRR_loc hE θ x)
      ((b4cov_lineEquiv hE).symm (extChartAt 𝓘(ℂ, E) x y - extChartAt 𝓘(ℂ, E) x x))) :
    AnalyticAt ℂ (HurwitzPrymRR_loc hE θ y) 0 := by
  have : FiniteDimensional ℂ E := Module.finite_of_finrank_eq_succ hE
  have := FiniteDimensional.complete ℂ E
  have hid : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω (id : C → C) := contMDiff_id
  have h := HurwitzPrymRR_loc_pullback hE hE id hid y x hy θ hθ
  rw [HurwitzPrymRR_pullback_id] at h
  set G := b4cov_expr E E (id : C → C) y x
  set T := b4cov_transport hE hE G (extChartAt 𝓘(ℂ, E) y y)
  set σ := (b4cov_lineEquiv hE).symm
    (extChartAt 𝓘(ℂ, E) x y - extChartAt 𝓘(ℂ, E) x x)
  have hys := mem_extChartAt_source (I := 𝓘(ℂ, E)) y
  have hGan : AnalyticAt ℂ G (extChartAt 𝓘(ℂ, E) y y) :=
    b4cov_analyticAt_chart id hid y x _ ((extChartAt 𝓘(ℂ, E) y).map_source hys)
      (by rw [(extChartAt 𝓘(ℂ, E) y).left_inv hys]; exact hy)
  have hTan : AnalyticAt ℂ T 0 := b4cov_transport_analyticAt hE hE hGan
  have hcomp : AnalyticAt ℂ (fun τ ↦ HurwitzPrymRR_loc hE θ x (σ + T τ)) 0 := by
    have hc0 : AnalyticAt ℂ (HurwitzPrymRR_loc hE θ x) (σ + T 0) := by
      simpa only [T, b4cov_transport_zero, add_zero, σ] using hcoef
    have hsum : AnalyticAt ℂ (fun τ ↦ σ + T τ) 0 := analyticAt_const.add hTan
    exact hc0.comp (f := fun τ ↦ σ + T τ) hsum
  exact (hcomp.mul hTan.deriv).congr h.symm

/-- The global normalized form has the normalized coefficient in each centred chart.
Tag: RiemannRochRes. -/
theorem b4c_residue_normalizedForm_loc (hE : Module.finrank ℂ E = 1)
    (w : b4c_MeroForm E C hE) (x : C) :
    HurwitzPrymRR_loc hE (b4c_residue_normalizedForm hE w) x =ᶠ[𝓝 0]
      toMeromorphicNFAt (HurwitzPrymRR_loc hE w x) 0 := by
  let L := b4cov_lineEquiv hE
  let e := extChartAt 𝓘(ℂ, E) x
  have hx : x ∈ e.source := mem_extChartAt_source x
  have ht : ∀ᶠ τ : ℂ in 𝓝 0, e x + L τ ∈ e.target := by
    have hc : ContinuousAt (fun τ : ℂ ↦ e x + L τ) 0 :=
      continuousAt_const.add L.continuous.continuousAt
    apply hc.preimage_mem_nhds
    simpa only [map_zero, add_zero] using (isOpen_extChartAt_target x).mem_nhds (e.map_source hx)
  have hA : ∀ᶠ τ in 𝓝 (0 : ℂ), τ ≠ 0 → AnalyticAt ℂ (HurwitzPrymRR_loc hE w x) τ := by
    simpa only [eventually_nhdsWithin_iff, mem_compl_singleton_iff] using
      (w.2.2 x).eventually_analyticAt
  filter_upwards [ht, hA] with τ hτ hAτ
  by_cases hzero : τ = 0
  · subst τ
    dsimp only [HurwitzPrymRR_loc, b4cov_coef]
    erw [(b4cov_lineEquiv hE).map_zero, add_zero,
      (extChartAt 𝓘(ℂ, E) x).left_inv (mem_extChartAt_source x), b4cov_vec_self]
    change _ * (b4cov_lineEquiv hE).symm (b4cov_lineEquiv hE 1) = _
    rw [ContinuousLinearEquiv.symm_apply_apply, mul_one]
  · let y := e.symm (e x + L τ)
    have hy : y ∈ e.source := e.map_target hτ
    have hcoord : L.symm (e y - e x) = τ := by
      rw [e.right_inv hτ, add_sub_cancel_left, ContinuousLinearEquiv.symm_apply_apply]
    have hlocal : AnalyticAt ℂ (HurwitzPrymRR_loc hE w y) 0 :=
      b4c_residue_analytic_chart hE w w.2.1 x y hy (by
        change AnalyticAt ℂ (HurwitzPrymRR_loc hE w x) (L.symm (e y - e x))
        rw [hcoord]
        exact hAτ hzero)
    change b4c_residue_normalizedForm hE w ⟨y, b4cov_vec x y (L 1)⟩ = _
    rw [b4c_residue_normalizedForm_eq hE w y hlocal]
    exact (w.2.2 x).eqOn_compl_singleton_toMeromorphicNFAt
      (show τ ∈ ({0} : Set ℂ)ᶜ from hzero)

/-- The normalized representative is a meromorphic form.
Tag: RiemannRochRes. -/
theorem b4c_residue_normalizedForm_mem (hE : Module.finrank ℂ E = 1)
    (w : b4c_MeroForm E C hE) :
    b4c_IsMeroForm hE (b4c_residue_normalizedForm hE w) := by
  refine ⟨b4c_residue_normalizedForm_linear hE w, fun x ↦ ?_⟩
  exact meromorphicNFAt_toMeromorphicNFAt.meromorphicAt.congr
    ((b4c_residue_normalizedForm_loc hE w x).symm.filter_mono nhdsWithin_le_nhds)

/-- Normalizing a form preserves every residue.
Tag: RiemannRochRes. -/
theorem b4c_residue_normalizedForm_res (hE : Module.finrank ℂ E = 1)
    (w : b4c_MeroForm E C hE) (x : C) :
    b4c_res (hE := hE) (b4c_residue_normalizedForm hE w) x = b4c_res (hE := hE) w x := by
  apply residue_congr_nhdsNE
  exact ((b4c_residue_normalizedForm_loc hE w x).filter_mono nhdsWithin_le_nhds).trans
    (w.2.2 x).eq_nhdsNE_toMeromorphicNFAt.symm

/-- The normalized coefficient is analytic at every point of nonnegative order.
Tag: RiemannRochRes. -/
theorem b4c_residue_normalizedForm_analytic (hE : Module.finrank ℂ E = 1)
    (w : b4c_MeroForm E C hE) (x : C)
    (hx : 0 ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0) :
    AnalyticAt ℂ (HurwitzPrymRR_loc hE (b4c_residue_normalizedForm hE w) x) 0 := by
  exact ((w.2.2 x).meromorphicOrderAt_nonneg_iff_analyticAt_toMeromorphicNFAt.mp hx).congr
    (b4c_residue_normalizedForm_loc hE w x).symm

section ResidueCutoffs

local instance : NormedSpace ℝ E := NormedSpace.restrictScalars ℝ ℂ E
attribute [local instance] b3Forms_isManifold_real

/-- A real linear projection of a fibrewise complex linear form in B3's representation.
Source: Mathlib `ContinuousAlternatingMap.ofSubsingleton`.
Tag: RiemannRochRes. -/
def b4c_residue_realForm (hE : Module.finrank ℂ E = 1)
    (θ : TangentBundle 𝓘(ℂ, E) C → ℂ) (P : ℂ →L[ℝ] ℝ) :
    C → E [⋀^Fin 1]→L[ℝ] ℝ :=
  fun x ↦ ContinuousAlternatingMap.ofSubsingleton ℝ E ℝ (0 : Fin 1)
    (P.comp (((θ ⟨x, b4cov_lineEquiv hE 1⟩) •
      (b4cov_lineEquiv hE).symm.toContinuousLinearMap).restrictScalars ℝ))

/-- Evaluation of the projected form agrees with projection of its fibrewise value.
Tag: RiemannRochRes. -/
theorem b4c_residue_realForm_apply (hE : Module.finrank ℂ E = 1)
    (θ : TangentBundle 𝓘(ℂ, E) C → ℂ) (hθ : HurwitzPrymRR_IsLinear θ)
    (P : ℂ →L[ℝ] ℝ) (x : C) (v : E) :
    b4c_residue_realForm hE θ P x (fun _ ↦ v) = P (θ ⟨x, v⟩) := by
  change P (θ ⟨x, b4cov_lineEquiv hE 1⟩ * (b4cov_lineEquiv hE).symm v) = _
  rw [← b4c_residue_linear_value hE θ hθ x v]

/-- The local projected form evaluates on the corresponding chart vector.
Tag: RiemannRochRes. -/
theorem b4c_residue_loc_realForm_apply (hE : Module.finrank ℂ E = 1)
    (θ : TangentBundle 𝓘(ℂ, E) C → ℂ) (hθ : HurwitzPrymRR_IsLinear θ)
    (P : ℂ →L[ℝ] ℝ) {x : C} {u : E} (hu : u ∈ (chartAt E x).target) (v : E) :
    b3Forms_loc (b4c_residue_realForm hE θ P) x u (fun _ ↦ v) =
      P (θ (b3Forms_chartVec x v u)) := by
  simp only [b3Forms_loc, ContinuousAlternatingMap.compContinuousLinearMap_apply]
  rw [b3Forms_fderiv_tr_real (b3Forms_mem_trDom_self hu)]
  exact b4c_residue_realForm_apply hE θ hθ P _ _

/-- Smoothness at every chart centre suffices for a family of differential forms.
Tag: RiemannRochRes. -/
theorem b4c_residue_smooth_of_centres [FiniteDimensional ℂ E] {k : ℕ}
    (α : C → E [⋀^Fin k]→L[ℝ] ℝ)
    (hα : ∀ x, ContDiffAt ℝ ∞ (b3Forms_loc α x) (chartAt E x x)) :
    b3Forms_IsSmooth α := by
  intro x u hu
  let y := (chartAt E x).symm u
  have hxy : u ∈ b3Forms_trDom x y := b3Forms_mem_trDom_self hu
  have htr : ContDiffAt ℝ ∞ (b3Forms_tr x y) u :=
    (b3Forms_contDiffOn_tr x y).contDiffAt
      ((b3Forms_isOpen_trDom x y).mem_nhds hxy)
  have hval : b3Forms_tr x y u = chartAt E y y := rfl
  have hg := (hα y).comp u htr
  have hfd : ContDiffAt ℝ ∞ (fderiv ℝ (b3Forms_tr x y)) u :=
    ((b3Forms_contDiffOn_tr x y).fderiv_of_isOpen
      (b3Forms_isOpen_trDom x y) (m := ∞) (by simp)).contDiffAt
        ((b3Forms_isOpen_trDom x y).mem_nhds hxy)
  have hop : ContDiff ℝ ∞ (fun p : (E [⋀^Fin k]→L[ℝ] ℝ) × (E →L[ℝ] E) ↦
      p.1.compContinuousLinearMap p.2) :=
    contDiffOn_univ.mp (b3Forms_contDiffOn_comp contDiff_fst.contDiffOn
      contDiff_snd.contDiffOn)
  have hcAt := hop.contDiffAt.comp u (hg.prodMk hfd)
  apply (hcAt.congr_of_eventuallyEq ?_).contDiffWithinAt
  filter_upwards [(b3Forms_isOpen_trDom x y).mem_nhds hxy] with v hv
  exact b3Forms_loc_eq_comp α hv

/-- A smooth multiplier vanishing near the poles gives smooth centred coefficients for
the normalized global form.
Tag: RiemannRochRes. -/
theorem b4c_residue_cutoff_coefficient_smooth (hE : Module.finrank ℂ E = 1)
    (w : b4c_MeroForm E C hE) (μ : C → ℝ)
    (hμ : ContMDiff 𝓘(ℝ, E) 𝓘(ℝ, ℝ) ∞ μ)
    (hpoles : ∀ x, meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 < 0 → μ =ᶠ[𝓝 x] 0)
    (x : C) :
    ContDiffAt ℝ ∞ (HurwitzPrymRR_loc hE
      (fun v ↦ (μ v.proj : ℂ) * b4c_residue_normalizedForm hE w v) x) 0 := by
  let L := b4cov_lineEquiv hE
  let e := chartAt E x
  let A : ℂ → E := fun τ ↦ e x + L τ
  have hA : ContDiffAt ℝ ∞ A 0 :=
    contDiffAt_const.add (L.contDiff.restrict_scalars ℝ).contDiffAt
  have hA0 : A 0 = e x := by simp [A]
  have htarget : e x ∈ e.target := e.map_source (mem_chart_source E x)
  have hchart : ContDiffAt ℝ ∞ (μ ∘ e.symm) (A 0) := by
    rw [hA0]
    exact ((b3Forms_isSmooth_fun_iff μ).mp (b3Forms_isSmooth_fun hμ) x).contDiffAt
      (e.open_target.mem_nhds htarget)
  have hμA : ContDiffAt ℝ ∞ (fun τ ↦ (μ (e.symm (A τ)) : ℂ)) 0 :=
    Complex.ofRealCLM.contDiff.contDiffAt.comp 0 (hchart.comp 0 hA)
  change ContDiffAt ℝ ∞ (fun τ ↦ (μ (e.symm (A τ)) : ℂ) *
    HurwitzPrymRR_loc hE (b4c_residue_normalizedForm hE w) x τ) 0
  by_cases horder : 0 ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0
  · exact hμA.mul ((b4c_residue_normalizedForm_analytic hE w x horder).contDiffAt.restrict_scalars ℝ)
  · have hymap : Tendsto (fun τ ↦ e.symm (A τ)) (𝓝 0) (𝓝 x) := by
      have ht := (e.continuousAt_symm htarget).tendsto
      rw [e.left_inv (mem_chart_source E x)] at ht
      have hAt : Tendsto A (𝓝 0) (𝓝 (e x)) := hA0 ▸ hA.continuousAt.tendsto
      exact ht.comp hAt
    apply (contDiffAt_const (c := (0 : ℂ))).congr_of_eventuallyEq
    filter_upwards [hymap.eventually (hpoles x (lt_of_not_ge horder))] with τ hτ
    simp only [Pi.zero_apply] at hτ
    simp only [hτ, Complex.ofReal_zero, zero_mul]

/-- The inverse tangent trivialization agrees with the derivative of the chart transition.
Tag: RiemannRochRes. -/
theorem b4c_residue_vec_chart {x : C} {u : E}
    (hu : u ∈ (chartAt E x).target) (v : E) :
    b4cov_vec x ((chartAt E x).symm u) v =
      (b3Forms_chartVec x v u).2 := by
  have hy := (chartAt E x).map_target hu
  rw [b4cov_vec, ← Bundle.Trivialization.symmL_apply (R := ℂ) _
    (b4cov_mem_baseSet x _ (by simpa only [extChartAt_source] using hy)), TangentBundle.symmL_trivializationAt_eq_core hy]
  simp only [tangentBundleCore_coordChange_achart, extChartAt,
    OpenPartialHomeomorph.extend_coe, OpenPartialHomeomorph.extend_coe_symm,
    modelWithCornersSelf_coe, modelWithCornersSelf_coe_symm, range_id,
    fderivWithin_univ, Function.id_comp, Function.comp_id,
    (chartAt E x).right_inv hu]
  rfl

/-- The local real projection is the centred coefficient evaluated on the line coordinate.
Tag: RiemannRochRes. -/
theorem b4c_residue_loc_realForm_coefficient (hE : Module.finrank ℂ E = 1)
    (θ : TangentBundle 𝓘(ℂ, E) C → ℂ) (hθ : HurwitzPrymRR_IsLinear θ)
    (P : ℂ →L[ℝ] ℝ) {x : C} {u : E} (hu : u ∈ (chartAt E x).target) (v : E) :
    b3Forms_loc (b4c_residue_realForm hE θ P) x u (fun _ ↦ v) =
      P (HurwitzPrymRR_loc hE θ x
        ((b4cov_lineEquiv hE).symm (u - chartAt E x x)) *
          (b4cov_lineEquiv hE).symm v) := by
  rw [b4c_residue_loc_realForm_apply hE θ hθ P hu]
  have hv : v = (b4cov_lineEquiv hE).symm v • b4cov_lineEquiv hE 1 := by
    rw [← map_smul, smul_eq_mul, mul_one]
    exact ((b4cov_lineEquiv hE).apply_symm_apply v).symm
  have hy : (chartAt E x).symm u ∈ (extChartAt 𝓘(ℂ, E) x).source :=
    by simpa only [extChartAt_source] using (chartAt E x).map_target hu
  have hvec : b3Forms_chartVec x v u =
      ⟨(chartAt E x).symm u, b4cov_vec x ((chartAt E x).symm u) v⟩ :=
    congrArg (fun t : TangentSpace 𝓘(ℂ, E) ((chartAt E x).symm u) ↦
      (⟨(chartAt E x).symm u, t⟩ : TangentBundle 𝓘(ℂ, E) C))
        (b4c_residue_vec_chart hu v).symm
  rw [hvec]
  have hscaled : θ ⟨(chartAt E x).symm u, b4cov_vec x ((chartAt E x).symm u) v⟩ =
      (b4cov_lineEquiv hE).symm v * θ ⟨(chartAt E x).symm u,
        b4cov_vec x ((chartAt E x).symm u) (b4cov_lineEquiv hE 1)⟩ := by
    calc
      _ = θ ⟨(chartAt E x).symm u, b4cov_vec x ((chartAt E x).symm u)
          ((b4cov_lineEquiv hE).symm v • b4cov_lineEquiv hE 1)⟩ :=
        congrArg (fun t ↦ θ ⟨(chartAt E x).symm u,
          b4cov_vec x ((chartAt E x).symm u) t⟩) hv
      _ = _ := by
        rw [b4cov_vec_smul x _ hy]
        exact hθ.smul _ _ _
  rw [hscaled]
  apply congrArg P
  have hcoord : extChartAt 𝓘(ℂ, E) x x +
      b4cov_lineEquiv hE ((b4cov_lineEquiv hE).symm (u - chartAt E x x)) = u := by
    rw [ContinuousLinearEquiv.apply_symm_apply]
    change chartAt E x x + (u - chartAt E x x) = u
    abel
  change _ = b4cov_coef θ x (b4cov_lineEquiv hE 1)
    (extChartAt 𝓘(ℂ, E) x x +
      b4cov_lineEquiv hE ((b4cov_lineEquiv hE).symm (u - chartAt E x x))) * _
  rw [hcoord]
  exact mul_comm _ _



/-- Smooth centred coefficients give smooth real projections of a complex linear form.
Tag: RiemannRochRes. -/
theorem b4c_residue_realForm_smooth (hE : Module.finrank ℂ E = 1)
    (θ : TangentBundle 𝓘(ℂ, E) C → ℂ) (hθ : HurwitzPrymRR_IsLinear θ)
    (P : ℂ →L[ℝ] ℝ)
    (hs : ∀ x, ContDiffAt ℝ ∞ (HurwitzPrymRR_loc hE θ x) 0) :
    b3Forms_IsSmooth (b4c_residue_realForm hE θ P) := by
  have : FiniteDimensional ℂ E := Module.finite_of_finrank_eq_succ hE
  let L := b4cov_lineEquiv hE
  let A : ℂ → E [⋀^Fin 1]→L[ℝ] ℝ := fun c ↦
    ContinuousAlternatingMap.ofSubsingleton ℝ E ℝ (0 : Fin 1)
      (P.comp ((c • L.symm.toContinuousLinearMap).restrictScalars ℝ))
  have hA : ContDiff ℝ ∞ A := by
    apply contDiffOn_univ.mp
    apply b3Forms_contDiffOn_of_apply
    intro v
    change ContDiffOn ℝ ∞ (fun c ↦ P (c * L.symm v)) univ
    exact P.contDiff.comp_contDiffOn (contDiffOn_id.mul contDiffOn_const)
  apply b4c_residue_smooth_of_centres
  intro x
  have harg : ContDiffAt ℝ ∞ (fun u : E ↦ L.symm (u - chartAt E x x))
      (chartAt E x x) :=
    (L.symm.contDiff.restrict_scalars ℝ).contDiffAt.comp _
      (contDiffAt_id.sub contDiffAt_const)
  have harg0 : L.symm (chartAt E x x - chartAt E x x) = 0 := by simp
  have hs' : ContDiffAt ℝ ∞ (HurwitzPrymRR_loc hE θ x)
      (L.symm (chartAt E x x - chartAt E x x)) := harg0 ▸ hs x
  have hg := hs'.comp (chartAt E x x) harg
  have h := hA.contDiffAt.comp (chartAt E x x) hg
  apply h.congr_of_eventuallyEq
  filter_upwards [(chartAt E x).open_target.mem_nhds
    ((chartAt E x).map_source (mem_chart_source E x))] with u hu
  ext v
  have hv : v = fun _ ↦ v 0 := funext fun i ↦ by fin_cases i; rfl
  rw [hv]
  exact b4c_residue_loc_realForm_coefficient hE θ hθ P hu (v 0)


/-- A multiplier vanishing near the poles gives a smooth global projected form.
Tag: RiemannRochRes. -/
theorem b4c_residue_smooth_global (hE : Module.finrank ℂ E = 1)
    (w : b4c_MeroForm E C hE) (μ : C → ℝ)
    (hμ : ContMDiff 𝓘(ℝ, E) 𝓘(ℝ, ℝ) ∞ μ)
    (hpoles : ∀ x, meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 < 0 → μ =ᶠ[𝓝 x] 0)
    (P : ℂ →L[ℝ] ℝ) :
    b3Forms_IsSmooth (b4c_residue_realForm hE
      (fun v ↦ (μ v.proj : ℂ) * b4c_residue_normalizedForm hE w v) P) := by
  apply b4c_residue_realForm_smooth hE
  · intro x a v v'
    change (μ x : ℂ) * b4c_residue_normalizedForm hE w ⟨x, a • v + v'⟩ = _
    rw [b4c_residue_normalizedForm_linear hE w x a v v']
    change (μ x : ℂ) * (a * _ + _) = a * ((μ x : ℂ) * _) + (μ x : ℂ) * _
    ring
  · exact b4c_residue_cutoff_coefficient_smooth hE w μ hμ hpoles


/-- In the oriented line frame, B3's exterior derivative is the complex derivative density.
Tag: RiemannRochRes. -/
theorem b4c_residue_realForm_derivative (hE : Module.finrank ℂ E = 1)
    (θ : TangentBundle 𝓘(ℂ, E) C → ℂ) (hθ : HurwitzPrymRR_IsLinear θ)
    (P : ℂ →L[ℝ] ℝ)
    (hs : ∀ x, ContDiffAt ℝ ∞ (HurwitzPrymRR_loc hE θ x) 0) (x : C) :
    b3Forms_d (b4c_residue_realForm hE θ P) x
      ![b4cov_lineEquiv hE 1, b4cov_lineEquiv hE Complex.I] =
      P (Complex.I * fderiv ℝ (HurwitzPrymRR_loc hE θ x) 0 1 -
        fderiv ℝ (HurwitzPrymRR_loc hE θ x) 0 Complex.I) := by
  have : FiniteDimensional ℂ E := Module.finite_of_finrank_eq_succ hE
  let L := b4cov_lineEquiv hE
  let α := b4c_residue_realForm hE θ P
  let g := HurwitzPrymRR_loc hE θ x
  let u := chartAt E x x
  have hu : u ∈ (chartAt E x).target := (chartAt E x).map_source (mem_chart_source E x)
  have hdiff : DifferentiableAt ℝ g 0 := (hs x).differentiableAt (by simp)
  have hT : HasFDerivAt (fun t : E ↦ L.symm (t - u))
      (L.symm.toContinuousLinearMap.restrictScalars ℝ) u := by
    convert (L.symm.toContinuousLinearMap.restrictScalars ℝ).hasFDerivAt.comp u
      ((hasFDerivAt_id u).sub_const u) using 1 <;> ext t <;> simp
  have hTu : L.symm (u - u) = 0 := by simp
  have hdg : HasFDerivAt (fun t : E ↦ g (L.symm (t - u)))
      ((fderiv ℝ g 0).comp (L.symm.toContinuousLinearMap.restrictScalars ℝ)) u := by
    have hzero : HasFDerivAt g (fderiv ℝ g 0) (L.symm (u - u)) :=
      hTu ▸ hdiff.hasFDerivAt
    exact hzero.comp u hT
  have hd : ∀ v t : E,
      fderiv ℝ (fun q ↦ b3Forms_loc α x q (fun _ ↦ v)) u t =
        P (fderiv ℝ g 0 (L.symm t) * L.symm v) := by
    intro v t
    have heq : (fun q ↦ b3Forms_loc α x q (fun _ ↦ v)) =ᶠ[𝓝 u]
        (fun q ↦ P (g (L.symm (q - u)) * L.symm v)) := by
      filter_upwards [(chartAt E x).open_target.mem_nhds hu] with q hq
      exact b4c_residue_loc_realForm_coefficient hE θ hθ P hq v
    rw [heq.fderiv_eq]
    have hh := P.hasFDerivAt.comp u (hdg.mul_const (L.symm v))
    change (fderiv ℝ (P ∘ fun q ↦ g (L.symm (q - u)) * L.symm v) u) t = _
    rw [hh.fderiv]
    change P (L.symm v * fderiv ℝ g 0 (L.symm t)) = _
    rw [mul_comm]
  change extDeriv (b3Forms_loc α x) u _ = _
  rw [extDeriv_apply ((b4c_residue_realForm_smooth hE θ hθ P hs).contDiffAt hu
      |>.differentiableAt (by simp)), Fin.sum_univ_two]
  have e0 : Fin.removeNth 0 ![L 1, L Complex.I] = fun _ : Fin 1 ↦ L Complex.I := by
    ext i; fin_cases i; rfl
  have e1 : Fin.removeNth 1 ![L 1, L Complex.I] = fun _ : Fin 1 ↦ L 1 := by
    ext i; fin_cases i; rfl
  change _ + _ = _
  rw [e0, e1, hd, hd]
  simp [L, g, mul_comm, sub_eq_add_neg]


/-- Compactness and isolated meromorphic singularities give finitely many poles.
Tag: RiemannRochRes. -/
theorem b4c_residue_poles_finite [CompactSpace C]
    (hE : Module.finrank ℂ E = 1) (w : b4c_MeroForm E C hE) :
    {x : C | meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 < 0}.Finite := by
  classical
  let U : C → Set C := fun x ↦ {y | meromorphicOrderAt
    (HurwitzPrymRR_loc hE w y) 0 < 0 → y = x}
  have hU : ∀ x, U x ∈ 𝓝 x := by
    intro x
    let e := extChartAt 𝓘(ℂ, E) x
    let L := b4cov_lineEquiv hE
    have hx : x ∈ e.source := mem_extChartAt_source x
    have hA : ∀ᶠ τ in 𝓝 (0 : ℂ), τ ≠ 0 →
        AnalyticAt ℂ (HurwitzPrymRR_loc hE w x) τ := by
      simpa only [eventually_nhdsWithin_iff, mem_compl_singleton_iff] using
        (w.2.2 x).eventually_analyticAt
    have hT : Tendsto (fun y ↦ L.symm (e y - e x)) (𝓝 x) (𝓝 0) := by
      have h : ContinuousAt (fun y ↦ L.symm (e y - e x)) x :=
        L.symm.continuous.continuousAt.comp
        ((continuousAt_extChartAt (I := 𝓘(ℂ, E)) x).sub continuousAt_const)
      simpa only [sub_self, map_zero] using h.tendsto
    filter_upwards [(isOpen_extChartAt_source x).mem_nhds hx, hT.eventually hA] with y hy hAy
    intro hp
    by_contra hne
    have hcoord : L.symm (e y - e x) ≠ 0 := by
      intro hz
      have heq : e y = e x := sub_eq_zero.mp (L.symm.injective (hz.trans L.symm.map_zero.symm))
      exact hne (e.injOn hy hx heq)
    have han := b4c_residue_analytic_chart hE w w.2.1 x y hy (hAy hcoord)
    exact not_lt_of_ge han.meromorphicOrderAt_nonneg hp
  obtain ⟨t, ht⟩ := finite_cover_nhds hU
  apply t.finite_toSet.subset
  intro y hy
  have hym : y ∈ ⋃ x ∈ t, U x := by rw [ht]; trivial
  obtain ⟨x, hx, hxy⟩ := Set.mem_iUnion₂.mp hym
  exact (hxy hy) ▸ hx

/-- The residue sum is supported on the finite pole set.
Tag: RiemannRochRes. -/
theorem b4c_residue_finsum_eq_poles_sum [CompactSpace C]
    (hE : Module.finrank ℂ E = 1) (w : b4c_MeroForm E C hE) :
    ∑ᶠ x : C, b4c_res (hE := hE) w x =
      ∑ x ∈ (b4c_residue_poles_finite hE w).toFinset, b4c_res (hE := hE) w x := by
  classical
  apply finsum_eq_sum_of_support_subset
  intro x hx
  apply (b4c_residue_poles_finite hE w).mem_toFinset.mpr
  by_contra h
  exact hx (TauCeti.Contour.residue_eq_zero_of_meromorphicOrderAt_nonneg (le_of_not_gt h))

/-- The real basis transported from `(1, i)` through the fixed complex line coordinate.
Source: Mathlib `Complex.basisOneI` and `Module.Basis.map`.
Tag: RiemannRochRes. -/
def b4c_residue_basis (hE : Module.finrank ℂ E = 1) : Module.Basis (Fin 2) ℝ E :=
  Complex.basisOneI.map ((b4cov_lineEquiv hE).toLinearEquiv.restrictScalars ℝ)

/-- The transported real basis has the vectors used by the coefficient derivative formula.
Tag: RiemannRochRes. -/
theorem b4c_residue_basis_coe (hE : Module.finrank ℂ E = 1) :
    (b4c_residue_basis hE : Fin 2 → E) =
      ![b4cov_lineEquiv hE 1, b4cov_lineEquiv hE Complex.I] := by
  ext i
  fin_cases i <;> simp [b4c_residue_basis]

/-- The basis Haar integral is the complex Lebesgue integral in translated line coordinates.
Tag: RiemannRochRes. -/
theorem b4c_residue_integral_coordinates [MeasurableSpace E] [BorelSpace E]
    (hE : Module.finrank ℂ E = 1) {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]
    (f : E → F) (c : E) :
    ∫ u, f u ∂(b4c_residue_basis hE).addHaar =
      ∫ z : ℂ, f (c + b4cov_lineEquiv hE z) := by
  have : FiniteDimensional ℂ E := Module.finite_of_finrank_eq_succ hE
  let R : ℂ ≃L[ℝ] E :=
    { toLinearEquiv := (b4cov_lineEquiv hE).toLinearEquiv.restrictScalars ℝ
      continuous_toFun := (b4cov_lineEquiv hE).continuous
      continuous_invFun := (b4cov_lineEquiv hE).symm.continuous }
  have hvol : Complex.basisOneI.addHaar = (volume : Measure ℂ) := by
    rw [Module.Basis.addHaar_eq_iff]
    simpa using Complex.orthonormalBasisOneI.volume_parallelepiped
  have hmap : (b4c_residue_basis hE).addHaar = Measure.map R volume := by
    rw [← hvol, Module.Basis.map_addHaar]
    rfl
  have hme : MeasurableEmbedding R := R.toHomeomorph.measurableEmbedding
  rw [← integral_add_left_eq_self (μ := (b4c_residue_basis hE).addHaar) _ c, hmap,
    hme.integral_map]
  rfl

/-- Chart integrals use complex Lebesgue measure in the centred line coordinate.
Tag: RiemannRochRes. -/
theorem b4c_residue_chartIntegral_coordinates [MeasurableSpace E] [BorelSpace E]
    (hE : Module.finrank ℂ E = 1) (α : C → E [⋀^Fin 2]→L[ℝ] ℝ) (x : C) :
    b3Forms_chartIntegral (b4c_residue_basis hE) x α =
      ∫ z : ℂ, b3Forms_chartFun (b4c_residue_basis hE) x α
        (chartAt E x x + b4cov_lineEquiv hE z) := by
  exact b4c_residue_integral_coordinates hE _ _
/-- The exterior derivative in an arbitrary chart has the centred complex derivative density.
Tag: RiemannRochRes. -/
theorem b4c_residue_loc_derivative (hE : Module.finrank ℂ E = 1)
    (θ : TangentBundle 𝓘(ℂ, E) C → ℂ) (hθ : HurwitzPrymRR_IsLinear θ)
    (P : ℂ →L[ℝ] ℝ)
    (hs : ∀ x, ContDiffAt ℝ ∞ (HurwitzPrymRR_loc hE θ x) 0)
    (x : C) (z : ℂ)
    (hz : chartAt E x x + b4cov_lineEquiv hE z ∈ (chartAt E x).target)
    (hg : DifferentiableAt ℝ (HurwitzPrymRR_loc hE θ x) z) :
    b3Forms_loc (b3Forms_d (b4c_residue_realForm hE θ P)) x
      (chartAt E x x + b4cov_lineEquiv hE z)
      ![b4cov_lineEquiv hE 1, b4cov_lineEquiv hE Complex.I] =
      P (Complex.I * fderiv ℝ (HurwitzPrymRR_loc hE θ x) z 1 -
        fderiv ℝ (HurwitzPrymRR_loc hE θ x) z Complex.I) := by
  have : FiniteDimensional ℂ E := Module.finite_of_finrank_eq_succ hE
  let L := b4cov_lineEquiv hE
  let α := b4c_residue_realForm hE θ P
  let g := HurwitzPrymRR_loc hE θ x
  let c := chartAt E x x
  let u := c + L z
  have hu : u ∈ (chartAt E x).target := hz
  have hdiff : DifferentiableAt ℝ g z := hg
  have hT : HasFDerivAt (fun t : E ↦ L.symm (t - c))
      (L.symm.toContinuousLinearMap.restrictScalars ℝ) u := by
    convert (L.symm.toContinuousLinearMap.restrictScalars ℝ).hasFDerivAt.comp u
      ((hasFDerivAt_id u).sub_const c) using 1 <;> ext t <;> simp
  have hTu : L.symm (u - c) = z := by simp [u]
  have hdg : HasFDerivAt (fun t : E ↦ g (L.symm (t - c)))
      ((fderiv ℝ g z).comp (L.symm.toContinuousLinearMap.restrictScalars ℝ)) u := by
    have hzero : HasFDerivAt g (fderiv ℝ g z) (L.symm (u - c)) :=
      hTu ▸ hdiff.hasFDerivAt
    exact hzero.comp u hT
  have hd : ∀ v t : E,
      fderiv ℝ (fun q ↦ b3Forms_loc α x q (fun _ ↦ v)) u t =
        P (fderiv ℝ g z (L.symm t) * L.symm v) := by
    intro v t
    have heq : (fun q ↦ b3Forms_loc α x q (fun _ ↦ v)) =ᶠ[𝓝 u]
        (fun q ↦ P (g (L.symm (q - c)) * L.symm v)) := by
      filter_upwards [(chartAt E x).open_target.mem_nhds hu] with q hq
      exact b4c_residue_loc_realForm_coefficient hE θ hθ P hq v
    rw [heq.fderiv_eq]
    have hh := P.hasFDerivAt.comp u (hdg.mul_const (L.symm v))
    change (fderiv ℝ (P ∘ fun q ↦ g (L.symm (q - c)) * L.symm v) u) t = _
    rw [hh.fderiv]
    change P (L.symm v * fderiv ℝ g z (L.symm t)) = _
    rw [mul_comm]
  rw [b3Forms_loc_d (b4c_residue_realForm_smooth hE θ hθ P hs) x hz]
  change extDeriv (b3Forms_loc α x) u _ = _
  rw [extDeriv_apply ((b4c_residue_realForm_smooth hE θ hθ P hs).contDiffAt hu
      |>.differentiableAt (by simp)), Fin.sum_univ_two]
  have e0 : Fin.removeNth 0 ![L 1, L Complex.I] = fun _ : Fin 1 ↦ L Complex.I := by
    ext i; fin_cases i; rfl
  have e1 : Fin.removeNth 1 ![L 1, L Complex.I] = fun _ : Fin 1 ↦ L 1 := by
    ext i; fin_cases i; rfl
  change _ + _ = _
  rw [e0, e1, hd, hd]
  simp [L, g, mul_comm, sub_eq_add_neg]


/-- Smooth scalar zero-forms are smooth manifold functions.
Tag: RiemannRochRes. -/
theorem b4c_residue_contMDiff_of_smooth_fun (f : C → ℝ)
    (hf : b3Forms_IsSmooth (b3Forms_fun (E := E) f)) :
    ContMDiff 𝓘(ℝ, E) 𝓘(ℝ, ℝ) ∞ f := by
  intro x
  let e := chartAt E x
  have hx : x ∈ e.source := mem_chart_source E x
  have hg : ContDiffAt ℝ ∞ (f ∘ e.symm) (e x) :=
    ((b3Forms_isSmooth_fun_iff f).mp hf x).contDiffAt (e.open_target.mem_nhds (e.map_source hx))
  have he : ContMDiffAt 𝓘(ℝ, E) 𝓘(ℝ, E) ∞ e x :=
    (contMDiffOn_chart (I := 𝓘(ℝ, E)) (x := x)).contMDiffAt (e.open_source.mem_nhds hx)
  have h := hg.contMDiffAt.comp x he
  apply h.congr_of_eventuallyEq
  filter_upwards [e.open_source.mem_nhds hx] with y hy
  simp only [Function.comp_apply, e.left_inv hy]

/-- A function in the fixed centred complex coordinate, extended by zero outside the chart.
Source: Mathlib `chartAt`; B3 chart functions `b3Rest_cfun`.
Tag: RiemannRochRes. -/
def b4c_residue_chartFunction (hE : Module.finrank ℂ E = 1) (x : C) (g : ℂ → ℝ) : C → ℝ :=
  fun y ↦ if y ∈ (chartAt E x).source then
    g ((b4cov_lineEquiv hE).symm (chartAt E x y - chartAt E x x)) else 0

/-- Compactly supported smooth coordinate functions extend smoothly to the manifold.
Tag: RiemannRochRes. -/
theorem b4c_residue_chartFunction_smooth [T2Space C]
    (hE : Module.finrank ℂ E = 1) (x : C) (g : ℂ → ℝ)
    (hg : ContDiff ℝ ∞ g) (hgc : HasCompactSupport g)
    (hgs : ∀ z ∈ tsupport g, chartAt E x x + b4cov_lineEquiv hE z ∈ (chartAt E x).target) :
    ContMDiff 𝓘(ℝ, E) 𝓘(ℝ, ℝ) ∞ (b4c_residue_chartFunction hE x g) := by
  classical
  have : FiniteDimensional ℂ E := Module.finite_of_finrank_eq_succ hE
  let L := b4cov_lineEquiv hE
  let R : ℂ ≃L[ℝ] E :=
    { toLinearEquiv := L.toLinearEquiv.restrictScalars ℝ
      continuous_toFun := L.continuous
      continuous_invFun := L.symm.continuous }
  let T : ℂ ≃L[ℝ] ℂ := (b3Rest_L hE).trans R.symm
  have hgc' : HasCompactSupport (g ∘ T) := hgc.comp_homeomorph T.toHomeomorph
  have hgs' : ∀ z ∈ tsupport (g ∘ T), b3Rest_ζ hE x z ∈ (chartAt E x).target := by
    intro z hz
    have hz' : T z ∈ tsupport g := tsupport_comp_subset_preimage g T.continuous hz
    have heq : b3Rest_ζ hE x z = chartAt E x x + L (T z) := by
      change chartAt E x x + b3Rest_L hE z =
        chartAt E x x + L (L.symm (b3Rest_L hE z))
      rw [ContinuousLinearEquiv.apply_symm_apply]
    rw [heq]
    exact hgs (T z) hz'
  have hs := b3Rest_smoothFun_cfun hE x (hg.comp T.contDiff) hgc' hgs'
  have heq : b4c_residue_chartFunction hE x g = b3Rest_cfun hE x (g ∘ T) := by
    funext y
    unfold b4c_residue_chartFunction b3Rest_cfun
    split_ifs
    · change g (L.symm _) = g (L.symm (b3Rest_L hE ((b3Rest_L hE).symm _)))
      rw [ContinuousLinearEquiv.apply_symm_apply]
    · rfl
  rw [heq]
  exact b4c_residue_contMDiff_of_smooth_fun _ hs

/-- The extended chart function recovers its prescribed complex-coordinate values.
Tag: RiemannRochRes. -/
theorem b4c_residue_chartFunction_coordinates (hE : Module.finrank ℂ E = 1)
    (x : C) (g : ℂ → ℝ) {z : ℂ}
    (hz : chartAt E x x + b4cov_lineEquiv hE z ∈ (chartAt E x).target) :
    b4c_residue_chartFunction hE x g
      ((chartAt E x).symm (chartAt E x x + b4cov_lineEquiv hE z)) = g z := by
  simp only [b4c_residue_chartFunction, (chartAt E x).map_target hz, ite_true,
    (chartAt E x).right_inv hz, add_sub_cancel_left, ContinuousLinearEquiv.symm_apply_apply]

/-- The extended function has compact support inside its chart, over its planar support.
Tag: RiemannRochRes. -/
theorem b4c_residue_chartFunction_support [T2Space C]
    (hE : Module.finrank ℂ E = 1) (x : C) (g : ℂ → ℝ)
    (hgc : HasCompactSupport g)
    (hgs : ∀ z ∈ tsupport g, chartAt E x x + b4cov_lineEquiv hE z ∈ (chartAt E x).target) :
    HasCompactSupport (b4c_residue_chartFunction hE x g) ∧
      tsupport (b4c_residue_chartFunction hE x g) ⊆ (chartAt E x).source ∧
      tsupport (b4c_residue_chartFunction hE x g) ⊆
        (chartAt E x).symm '' ((fun z ↦ chartAt E x x + b4cov_lineEquiv hE z) '' tsupport g) := by
  classical
  let e := chartAt E x
  let L := b4cov_lineEquiv hE
  let A : ℂ → E := fun z ↦ e x + L z
  have hc : IsCompact (e.symm '' (A '' tsupport g)) :=
    (hgc.isCompact.image (continuous_const.add L.continuous)).image_of_continuousOn
      (e.continuousOn_symm.mono fun u ⟨z, hz, hzu⟩ ↦ hzu ▸ hgs z hz)
  have hs : tsupport (b4c_residue_chartFunction hE x g) ⊆ e.symm '' (A '' tsupport g) := by
    apply closure_minimal _ hc.isClosed
    intro p hp
    have hps : p ∈ e.source := by
      by_contra h
      exact hp (by simp [b4c_residue_chartFunction, show p ∉ (chartAt E x).source from h])
    let z := L.symm (e p - e x)
    have hgz : g z ≠ 0 := by
      intro h0
      exact hp (by simp only [b4c_residue_chartFunction, show p ∈ (chartAt E x).source from hps, ite_true]; exact h0)
    have hAz : A z = e p := by
      dsimp [A, z]
      rw [ContinuousLinearEquiv.apply_symm_apply, add_sub_cancel]
    refine ⟨A z, ⟨z, subset_tsupport g hgz, rfl⟩, ?_⟩
    rw [hAz, e.left_inv hps]
  refine ⟨hc.of_isClosed_subset (isClosed_tsupport _) hs, ?_, hs⟩
  intro p hp
  obtain ⟨u, ⟨z, hz, rfl⟩, rfl⟩ := hs hp
  exact e.map_target (hgs z hz)

/-- A coordinate function equal to one near zero extends to one near the chart centre.
Tag: RiemannRochRes. -/
theorem b4c_residue_chartFunction_one (hE : Module.finrank ℂ E = 1)
    (x : C) (g : ℂ → ℝ) (hg : g =ᶠ[𝓝 0] fun _ ↦ (1 : ℝ)) :
    b4c_residue_chartFunction hE x g =ᶠ[𝓝 x] fun _ ↦ (1 : ℝ) := by
  let e := chartAt E x
  let L := b4cov_lineEquiv hE
  have hx : x ∈ e.source := mem_chart_source E x
  have hT : Tendsto (fun y ↦ L.symm (e y - e x)) (𝓝 x) (𝓝 0) := by
    have h : ContinuousAt (fun y ↦ L.symm (e y - e x)) x :=
      L.symm.continuous.continuousAt.comp ((e.continuousAt hx).sub continuousAt_const)
    simpa only [sub_self, map_zero] using h.tendsto
  filter_upwards [e.open_source.mem_nhds hx, hT.eventually hg] with y hy hgy
  simp only [b4c_residue_chartFunction, show y ∈ (chartAt E x).source from hy, ite_true]
  exact hgy

/-- Smooth cutoffs around a finite set, with disjoint chart supports.
Tag: RiemannRochRes. -/
theorem b4c_residue_cutoff [T2Space C] [FiniteDimensional ℂ E]
    (s : Set C) (hs : s.Finite) :
    ∃ χ : C → C → ℝ,
      (∀ x, ContMDiff 𝓘(ℝ, E) 𝓘(ℝ, ℝ) ∞ (χ x)) ∧
      (∀ x, χ x =ᶠ[𝓝 x] 1) ∧
      (∀ x y, 0 ≤ χ x y ∧ χ x y ≤ 1) ∧
      (∀ x, HasCompactSupport (χ x)) ∧
      (∀ x, tsupport (χ x) ⊆ (chartAt E x).source) ∧
      s.PairwiseDisjoint (fun x ↦ tsupport (χ x)) := by
  obtain ⟨U, hU, hd⟩ := hs.t2_separation
  have hχ : ∀ x : C, ∃ f : SmoothBumpFunction 𝓘(ℝ, E) x,
      tsupport f ⊆ U x := by
    intro x
    obtain ⟨f, _, hf⟩ := (SmoothBumpFunction.nhds_basis_tsupport
      (I := 𝓘(ℝ, E)) x).mem_iff.mp ((hU x).2.mem_nhds (hU x).1)
    exact ⟨f, hf⟩
  choose χ hχ using hχ
  refine ⟨fun x ↦ χ x, fun x ↦ (χ x).contMDiff,
    fun x ↦ (χ x).eventuallyEq_one, fun x y ↦ ⟨(χ x).nonneg, (χ x).le_one⟩,
    fun x ↦ (χ x).hasCompactSupport,
    fun x ↦ (χ x).tsupport_subset_chartAt_source, ?_⟩
  intro x hx y hy hxy
  exact (hd hx hy hxy).mono (hχ x) (hχ y)

/-- The complementary finite cutoff multiplier vanishes near each selected point.
Tag: RiemannRochRes. -/
theorem b4c_residue_cutoff_vanishes {X : Type*} [TopologicalSpace X]
    (s : Finset X) (χ : X → X → ℝ)
    (hχ : ∀ x ∈ s, χ x =ᶠ[𝓝 x] 1)
    (hd : (s : Set X).PairwiseDisjoint (fun x ↦ tsupport (χ x)))
    {p : X} (hp : p ∈ s) :
    (fun y ↦ 1 - ∑ x ∈ s, χ x y) =ᶠ[𝓝 p] 0 := by
  filter_upwards [hχ p hp] with y hy
  have hpy : y ∈ tsupport (χ p) :=
    subset_tsupport _ (by simpa only [Function.mem_support, hy, Pi.one_apply] using
      (one_ne_zero : (1 : ℝ) ≠ 0))
  have hsum : ∑ x ∈ s, χ x y = χ p y := by
    apply Finset.sum_eq_single p
    · intro x hx hxp
      by_contra hne
      exact Set.disjoint_left.mp (hd hx hp hxp) (subset_tsupport _ hne) hpy
    · exact fun hnot ↦ (hnot hp).elim
  simp only [hsum, hy, Pi.one_apply, sub_self, Pi.zero_apply]

/-- Disjoint cutoffs for all poles give a smooth global form for every real projection.
Tag: RiemannRochRes. -/
theorem b4c_residue_cutoff_poles [T2Space C] [CompactSpace C]
    (hE : Module.finrank ℂ E = 1) (w : b4c_MeroForm E C hE) :
    let s := (b4c_residue_poles_finite hE w).toFinset
    ∃ χ : C → C → ℝ,
      (∀ x, ContMDiff 𝓘(ℝ, E) 𝓘(ℝ, ℝ) ∞ (χ x)) ∧
      (∀ x, χ x =ᶠ[𝓝 x] 1) ∧
      (∀ x y, 0 ≤ χ x y ∧ χ x y ≤ 1) ∧
      (∀ x, HasCompactSupport (χ x)) ∧
      (∀ x, tsupport (χ x) ⊆ (chartAt E x).source) ∧
      (s : Set C).PairwiseDisjoint (fun x ↦ tsupport (χ x)) ∧
      (∀ P : ℂ →L[ℝ] ℝ, b3Forms_IsSmooth (b4c_residue_realForm hE
        (fun v ↦ ((1 - ∑ x ∈ s, χ x v.proj : ℝ) : ℂ) *
          b4c_residue_normalizedForm hE w v) P)) := by
  classical
  have : FiniteDimensional ℂ E := Module.finite_of_finrank_eq_succ hE
  let s := (b4c_residue_poles_finite hE w).toFinset
  obtain ⟨χ, hχ, hχone, hχbounds, hχcompact, hχchart, hχdisj⟩ :=
    b4c_residue_cutoff (E := E) (s : Set C) s.finite_toSet
  refine ⟨χ, hχ, hχone, hχbounds, hχcompact, hχchart, hχdisj, ?_⟩
  intro P
  apply b4c_residue_smooth_global hE w (fun y ↦ 1 - ∑ x ∈ s, χ x y)
  · exact contMDiff_const.sub (ContMDiff.sum fun i _ ↦ hχ i)
  · intro x hx
    apply b4c_residue_cutoff_vanishes s χ (fun i _ ↦ hχone i) hχdisj
    exact (b4c_residue_poles_finite hE w).mem_toFinset.mpr hx
/-- Boundaryless Stokes turns a finite decomposition of an exterior derivative into an
identity between integrals.
Tag: RiemannRochRes. -/
theorem b4c_residue_stokes [T2Space C] [CompactSpace C]
    [FiniteDimensional ℂ E] [MeasurableSpace E] [BorelSpace E]
    (b : Module.Basis (Fin 2) ℝ E) {ι : Type*} (s : Finset ι)
    (η : C → E [⋀^Fin 1]→L[ℝ] ℝ)
    (ρ : ι → C → E [⋀^Fin 2]→L[ℝ] ℝ)
    (hη : b3Forms_IsSmooth η) (hρ : ∀ i ∈ s, b3Forms_IsSmooth (ρ i))
    (hd : b3Forms_d η = -(∑ i ∈ s, ρ i)) :
    ∑ i ∈ s, b3Forms_integral b (ρ i) = 0 := by
  have h := b3Forms_integral_d_eq_zero b3Forms_oriented_complex b hη
  rw [hd, ← neg_one_smul ℝ (∑ i ∈ s, ρ i), b3Forms_integral_smul,
    b3Forms_integral_finsetSum b s hρ] at h
  linarith

end ResidueCutoffs

/-- A planar meromorphic coefficient has an analytic representative away from its poles,
with the same punctured germs and residues.
Tag: RiemannRochRes. -/
theorem b4c_residue_local_normalization {g : ℂ → ℂ} {U : Set ℂ}
    (hg : MeromorphicOn g U) :
    ∃ G : ℂ → ℂ, MeromorphicOn G U ∧
      (∀ z ∈ U, G =ᶠ[𝓝[≠] z] g) ∧
      (∀ z ∈ U, 0 ≤ meromorphicOrderAt g z → AnalyticAt ℂ G z) ∧
      (∀ z ∈ U, residue G z = residue g z) := by
  refine ⟨toMeromorphicNFOn g U, (meromorphicNFOn_toMeromorphicNFOn g U).meromorphicOn,
    fun z hz ↦ hg.toMeromorphicNFOn_eq_self_on_nhdsNE hz, ?_, ?_⟩
  · intro z hz horder
    apply ((meromorphicNFOn_toMeromorphicNFOn g U) hz).meromorphicOrderAt_nonneg_iff_analyticAt.mp
    rwa [meromorphicOrderAt_toMeromorphicNFOn hg hz]
  · intro z hz
    exact residue_congr_nhdsNE (hg.toMeromorphicNFOn_eq_self_on_nhdsNE hz)

/-- Normalized coefficients respect an analytic coordinate change and its nonvanishing
multiplier on an entire neighbourhood, including the centre.
Tag: RiemannRochRes. -/
theorem b4c_residue_normalization_change {f g a ψ : ℂ → ℂ} {z : ℂ}
    (hf : MeromorphicAt f z) (hg : MeromorphicAt g (ψ z))
    (hψ : AnalyticAt ℂ ψ z) (hψ' : deriv ψ z ≠ 0)
    (ha : AnalyticAt ℂ a z) (ha0 : a z ≠ 0)
    (hfg : f =ᶠ[𝓝[≠] z] fun y ↦ a y * g (ψ y)) :
    toMeromorphicNFAt f z =ᶠ[𝓝 z]
      fun y ↦ a y * toMeromorphicNFAt g (ψ z) (ψ y) := by
  have hnf : MeromorphicNFAt
      (fun y ↦ a y * toMeromorphicNFAt g (ψ z) (ψ y)) z :=
    (meromorphicNFAt_toMeromorphicNFAt.comp_analyticAt hψ).smul_analytic ha ha0
  apply (meromorphicNFAt_toMeromorphicNFAt.eventuallyEq_nhdsNE_iff_eventuallyEq_nhds hnf).mp
  apply hf.eq_nhdsNE_toMeromorphicNFAt.symm.trans
  apply hfg.trans
  have hcomp := hg.eq_nhdsNE_toMeromorphicNFAt.comp_tendsto
    (hψ.differentiableAt.hasDerivAt.tendsto_nhdsNE hψ')
  filter_upwards [hcomp] with y hy
  exact congrArg (a y * ·) hy

/-- Removing the poles of a normalized coefficient by a smooth cutoff produces a smooth
coefficient on the given planar domain.
Tag: RiemannRochRes. -/
theorem b4c_residue_smooth_local {g χ : ℂ → ℂ} {U : Set ℂ}
    (hg : MeromorphicOn g U) (hχ : ContDiff ℝ ∞ χ)
    (hpoles : ∀ z ∈ U, meromorphicOrderAt g z < 0 → χ =ᶠ[𝓝 z] 1) :
    ContDiffOn ℝ ∞ (fun z ↦ (1 - χ z) * toMeromorphicNFOn g U z) U := by
  intro z hz
  apply ContDiffAt.contDiffWithinAt
  by_cases horder : 0 ≤ meromorphicOrderAt g z
  · have hG : AnalyticAt ℂ (toMeromorphicNFOn g U) z := by
      apply ((meromorphicNFOn_toMeromorphicNFOn g U) hz).meromorphicOrderAt_nonneg_iff_analyticAt.mp
      rwa [meromorphicOrderAt_toMeromorphicNFOn hg hz]
    exact (contDiffAt_const.sub hχ.contDiffAt).mul (hG.contDiffAt.restrict_scalars ℝ)
  · apply (contDiffAt_const (c := (0 : ℂ))).congr_of_eventuallyEq
    filter_upwards [hpoles z hz (lt_of_not_ge horder)] with y hy
    simp only [Pi.one_apply] at hy
    simp only [hy, sub_self, zero_mul]

/-- The complex exterior-derivative density of a cutoff times a holomorphic coefficient.
Tag: RiemannRochRes. -/
theorem b4c_residue_d_eta_local {χ G : ℂ → ℂ} {z : ℂ}
    (hχ : DifferentiableAt ℝ χ z) (hG : AnalyticAt ℂ G z) :
    Complex.I * fderiv ℝ (fun y ↦ (1 - χ y) * G y) z 1 -
        fderiv ℝ (fun y ↦ (1 - χ y) * G y) z Complex.I =
      -(Complex.I * fderiv ℝ χ z 1 - fderiv ℝ χ z Complex.I) * G z := by
  have hGc : DifferentiableAt ℂ G z := hG.differentiableAt
  have hGr : DifferentiableAt ℝ G z := hGc.restrictScalars ℝ
  have hCR : fderiv ℝ G z Complex.I = Complex.I * fderiv ℝ G z 1 := by
    rw [hGc.fderiv_restrictScalars ℝ]
    change fderiv ℂ G z Complex.I = Complex.I * fderiv ℂ G z 1
    simpa only [smul_eq_mul, mul_one] using (fderiv ℂ G z).map_smul Complex.I (1 : ℂ)
  have hcut : DifferentiableAt ℝ (fun y : ℂ ↦ 1 - χ y) z :=
    (differentiableAt_const (1 : ℂ)).sub hχ
  have hdcut : fderiv ℝ (fun y : ℂ ↦ 1 - χ y) z = -fderiv ℝ χ z := by
    simpa using fderiv_fun_sub (differentiableAt_const (1 : ℂ)) hχ
  rw [fderiv_fun_mul hcut hGr, hdcut]
  simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply,
    ContinuousLinearMap.sub_apply, ContinuousLinearMap.neg_apply, fderiv_const, ContinuousLinearMap.zero_apply,
    zero_sub, smul_eq_mul]
  rw [hCR]
  ring

section ResidueDerivative
attribute [local instance] b3Forms_isManifold_real

/-- The derivative of the normalized cutoff form is its multiplier derivative times the
meromorphic coefficient, including at poles where the multiplier vanishes locally.
Tag: RiemannRochRes. -/
theorem b4c_residue_d_multiplier (hE : Module.finrank ℂ E = 1)
    (w : b4c_MeroForm E C hE) (μ : C → ℝ)
    (hμ : ContMDiff 𝓘(ℝ, E) 𝓘(ℝ, ℝ) ∞ μ)
    (hpoles : ∀ x, meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 < 0 → μ =ᶠ[𝓝 x] 0)
    (P : ℂ →L[ℝ] ℝ) (x : C) :
    let m : ℂ → ℂ := fun τ ↦
      (μ ((chartAt E x).symm (chartAt E x x + b4cov_lineEquiv hE τ)) : ℂ)
    b3Forms_d (b4c_residue_realForm hE
      (fun v ↦ (μ v.proj : ℂ) * b4c_residue_normalizedForm hE w v) P) x
        ![b4cov_lineEquiv hE 1, b4cov_lineEquiv hE Complex.I] =
      P ((Complex.I * fderiv ℝ m 0 1 - fderiv ℝ m 0 Complex.I) *
        HurwitzPrymRR_loc hE (b4c_residue_normalizedForm hE w) x 0) := by
  dsimp only
  let L := b4cov_lineEquiv hE
  let e := chartAt E x
  let m : ℂ → ℂ := fun τ ↦ (μ (e.symm (e x + L τ)) : ℂ)
  let G := HurwitzPrymRR_loc hE (b4c_residue_normalizedForm hE w) x
  have hlinear : HurwitzPrymRR_IsLinear
      (fun v ↦ (μ v.proj : ℂ) * b4c_residue_normalizedForm hE w v) := by
    intro y a v v'
    change (μ y : ℂ) * b4c_residue_normalizedForm hE w ⟨y, a • v + v'⟩ = _
    rw [b4c_residue_normalizedForm_linear hE w y a v v']
    change (μ y : ℂ) * (a * _ + _) = a * ((μ y : ℂ) * _) + (μ y : ℂ) * _
    ring
  rw [b4c_residue_realForm_derivative hE _ hlinear P
    (b4c_residue_cutoff_coefficient_smooth hE w μ hμ hpoles)]
  change P (Complex.I * fderiv ℝ (fun τ ↦ m τ * G τ) 0 1 -
    fderiv ℝ (fun τ ↦ m τ * G τ) 0 Complex.I) =
    P ((Complex.I * fderiv ℝ m 0 1 - fderiv ℝ m 0 Complex.I) * G 0)
  apply congrArg P
  by_cases horder : 0 ≤ meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0
  · have hG : AnalyticAt ℂ G 0 := b4c_residue_normalizedForm_analytic hE w x horder
    have hA : ContDiffAt ℝ ∞ (fun τ : ℂ ↦ e x + L τ) 0 :=
      contDiffAt_const.add (L.contDiff.restrict_scalars ℝ).contDiffAt
    have ht : e x ∈ e.target := e.map_source (mem_chart_source E x)
    have hchart : ContDiffAt ℝ ∞ (μ ∘ e.symm) (e x) :=
      ((b3Forms_isSmooth_fun_iff μ).mp (b3Forms_isSmooth_fun hμ) x).contDiffAt
        (e.open_target.mem_nhds ht)
    have hchart' : ContDiffAt ℝ ∞ (μ ∘ e.symm) (e x + L 0) := by
      simpa only [map_zero, add_zero] using hchart
    have hμA := hchart'.comp 0 hA
    have hm : ContDiffAt ℝ ∞ m 0 :=
      Complex.ofRealCLM.contDiff.contDiffAt.comp 0 hμA
    have h := b4c_residue_d_eta_local (differentiableAt_const (1 : ℂ) |>.sub
      (hm.differentiableAt (by simp))) hG
    have heq : (fun y ↦ (1 - (1 - m y)) * G y) = (fun y ↦ m y * G y) := by
      funext y; ring
    simp only [Pi.sub_def] at h
    rw [heq] at h
    have hd : fderiv ℝ (fun y ↦ 1 - m y) 0 = -fderiv ℝ m 0 := by
      simpa using fderiv_fun_sub (differentiableAt_const (1 : ℂ))
        (hm.differentiableAt (by simp))
    rw [hd] at h
    simpa only [ContinuousLinearMap.neg_apply, mul_neg, neg_sub_neg, neg_sub] using h
  · have ht : e x ∈ e.target := e.map_source (mem_chart_source E x)
    have hT : Tendsto (fun τ : ℂ ↦ e.symm (e x + L τ)) (𝓝 0) (𝓝 x) := by
      have h := (e.continuousAt_symm ht).tendsto
      rw [e.left_inv (mem_chart_source E x)] at h
      apply h.comp
      have hA : ContinuousAt (fun τ : ℂ ↦ e x + L τ) 0 :=
        continuousAt_const.add L.continuous.continuousAt
      simpa only [map_zero, add_zero] using hA.tendsto
    have hm : m =ᶠ[𝓝 0] 0 := by
      filter_upwards [hT.eventually (hpoles x (lt_of_not_ge horder))] with τ hτ
      change (μ (e.symm (e x + L τ)) : ℂ) = 0
      simp only [Pi.zero_apply] at hτ
      simp only [hτ, Complex.ofReal_zero]
    have hmG : (fun τ ↦ m τ * G τ) =ᶠ[𝓝 0] 0 := by
      filter_upwards [hm] with τ hτ
      simp only [hτ, Pi.zero_apply, zero_mul]
    rw [hmG.fderiv_eq, hm.fderiv_eq]
    simp
end ResidueDerivative

/-- A smooth radial profile with transition between the two specified radii.
Source: Mathlib `Real.smoothTransition`.
Tag: RiemannRochRes. -/
def b4c_residue_profile (a b r : ℝ) : ℝ := Real.smoothTransition ((b - r) / (b - a))

/-- The radial profile is one before its inner radius.
Tag: RiemannRochRes. -/
theorem b4c_residue_profile_one {a b r : ℝ} (hab : a < b) (hr : r ≤ a) :
    b4c_residue_profile a b r = 1 := by
  apply Real.smoothTransition.one_of_one_le
  apply (le_div_iff₀ (sub_pos.mpr hab)).mpr
  linarith

/-- The radial profile vanishes after its outer radius.
Tag: RiemannRochRes. -/
theorem b4c_residue_profile_zero {a b r : ℝ} (hab : a < b) (hr : b ≤ r) :
    b4c_residue_profile a b r = 0 := by
  apply Real.smoothTransition.zero_of_nonpos
  exact div_nonpos_of_nonpos_of_nonneg (sub_nonpos.mpr hr) (sub_pos.mpr hab).le

/-- The radial profile is smooth on the real line.
Tag: RiemannRochRes. -/
theorem b4c_residue_profile_smooth (a b : ℝ) : ContDiff ℝ ∞ (b4c_residue_profile a b) :=
  Real.smoothTransition.contDiff.comp ((contDiff_const.sub contDiff_id).div_const (b - a))

/-- The profile derivative vanishes outside the transition interval.
Tag: RiemannRochRes. -/
theorem b4c_residue_profile_deriv {a b r : ℝ} (hab : a < b) (hr : r ∉ Set.Icc a b) :
    deriv (b4c_residue_profile a b) r = 0 := by
  have hr' : r < a ∨ b < r := by
    simpa only [Set.mem_Icc, not_and_or, not_le] using hr
  rcases hr' with hr | hr
  · have heq : b4c_residue_profile a b =ᶠ[𝓝 r] fun _ ↦ (1 : ℝ) := by
      filter_upwards [gt_mem_nhds hr] with t ht
      exact b4c_residue_profile_one hab ht.le
    rw [heq.deriv_eq, deriv_const]
  · have heq : b4c_residue_profile a b =ᶠ[𝓝 r] fun _ ↦ (0 : ℝ) := by
      filter_upwards [lt_mem_nhds hr] with t ht
      exact b4c_residue_profile_zero hab ht.le
    rw [heq.deriv_eq, deriv_const]

/-- The radial cutoff is one on a neighborhood of the origin.
Tag: RiemannRochRes. -/
theorem b4c_residue_profile_radial_one {a b : ℝ} (ha : 0 < a) (hab : a < b) :
    (fun z : ℂ ↦ b4c_residue_profile a b ‖z‖) =ᶠ[𝓝 0] fun _ ↦ (1 : ℝ) := by
  have hnorm : ∀ᶠ z : ℂ in 𝓝 0, ‖z‖ < a := by
    have h : Tendsto (norm : ℂ → ℝ) (𝓝 0) (𝓝 0) := by
      simpa only [norm_zero] using continuous_norm.tendsto (0 : ℂ)
    exact h.eventually (gt_mem_nhds ha)
  filter_upwards [hnorm] with z hz
  exact b4c_residue_profile_one hab hz.le

/-- The radial cutoff is smooth even at the origin.
Tag: RiemannRochRes. -/
theorem b4c_residue_profile_radial_smooth {a b : ℝ} (ha : 0 < a) (hab : a < b) :
    ContDiff ℝ ∞ (fun z : ℂ ↦ b4c_residue_profile a b ‖z‖) := by
  apply contDiff_iff_contDiffAt.mpr
  intro z
  by_cases hz : z = 0
  · subst z
    exact contDiffAt_const.congr_of_eventuallyEq (b4c_residue_profile_radial_one ha hab)
  · exact (b4c_residue_profile_smooth a b).contDiffAt.comp z (contDiffAt_norm ℝ hz)

/-- The radial cutoff is supported in its outer disc.
Tag: RiemannRochRes. -/
theorem b4c_residue_profile_radial_support {a b : ℝ} (hab : a < b) :
    tsupport (fun z : ℂ ↦ b4c_residue_profile a b ‖z‖) ⊆ Metric.closedBall 0 b := by
  apply closure_minimal _ Metric.isClosed_closedBall
  intro z hz
  rw [Metric.mem_closedBall, dist_zero_right]
  by_contra hn
  exact hz (b4c_residue_profile_zero hab (le_of_lt (lt_of_not_ge hn)))

/-- The radial cutoff has compact support.
Tag: RiemannRochRes. -/
theorem b4c_residue_profile_radial_compact {a b : ℝ} (hab : a < b) :
    HasCompactSupport (fun z : ℂ ↦ b4c_residue_profile a b ‖z‖) :=
  (isCompact_closedBall (0 : ℂ) b).of_isClosed_subset (isClosed_tsupport _)
    (b4c_residue_profile_radial_support hab)
/-- A radial cutoff has the complex differential density used by polar residue integration.
Tag: RiemannRochRes. -/
theorem b4c_residue_radial_derivative {φ : ℝ → ℝ} {z : ℂ}
    (hφ : DifferentiableAt ℝ φ ‖z‖) (hz : z ≠ 0) :
    Complex.I * fderiv ℝ (fun y : ℂ ↦ (φ ‖y‖ : ℂ)) z 1 -
      fderiv ℝ (fun y : ℂ ↦ (φ ‖y‖ : ℂ)) z Complex.I =
      ((deriv φ ‖z‖ : ℝ) : ℂ) * (z * Complex.I / ‖z‖) := by
  have hn : ‖z‖ ≠ 0 := norm_ne_zero_iff.mpr hz
  have hsq := (hasFDerivAt_id z).norm_sq
  have hnorm := hsq.sqrt (pow_ne_zero 2 hn)
  simp only [Real.sqrt_sq (norm_nonneg _)] at hnorm
  have h := Complex.ofRealCLM.hasFDerivAt.comp z
    (hφ.hasDerivAt.comp_hasFDerivAt z hnorm)
  have hf := h.fderiv
  change Complex.I * (fderiv ℝ (Complex.ofRealCLM ∘ φ ∘ norm) z) 1 -
    (fderiv ℝ (Complex.ofRealCLM ∘ φ ∘ norm) z) Complex.I = _
  rw [hf]
  simp only [ContinuousLinearMap.comp_apply, ContinuousLinearMap.smul_apply,
    ContinuousLinearMap.id_apply, id_eq, innerSL_apply_apply, Complex.inner,
    smul_eq_mul, Complex.ofRealCLM_apply]
  apply Complex.ext <;> simp <;> field_simp [hn] <;> ring_nf <;> simp
/-- Every sufficiently small circle around a meromorphic germ computes its residue.
Tag: RiemannRochRes. -/
theorem b4c_residue_local_circle {g : ℂ → ℂ} (hg : MeromorphicAt g 0) :
    ∃ r : ℝ, 0 < r ∧ ∀ R : ℝ, 0 < R → R < r →
      circleIntegral g 0 R = 2 * (Real.pi : ℂ) * Complex.I * residue g 0 := by
  have hA : ∀ᶠ z in 𝓝 (0 : ℂ), z ≠ 0 → AnalyticAt ℂ g z := by
    simpa only [eventually_nhdsWithin_iff, mem_compl_singleton_iff] using hg.eventually_analyticAt
  obtain ⟨r, hr, hA⟩ := Metric.eventually_nhds_iff.mp hA
  refine ⟨r, hr, ?_⟩
  intro R hR hRr
  have hlocal : ∀ z ∈ Metric.closedBall (0 : ℂ) R, z ≠ 0 → AnalyticAt ℂ g z := by
    intro z hz hne
    exact hA ((Metric.mem_closedBall.mp hz).trans_lt hRr) hne
  have hmero : MeromorphicOn g (Metric.closedBall 0 R) := by
    intro z hz
    by_cases h : z = 0
    · subst z; exact hg
    · exact (hlocal z hz h).meromorphicAt
  have h := classicalResidueTheorem_circle_of_meromorphicOrderAt_neg hR {0} hmero
    (by simpa using hR) (by
      intro z hz hneg
      by_contra hnot
      have hne : z ≠ 0 := by simpa using hnot
      exact (not_lt_of_ge (hlocal z hz hne).meromorphicOrderAt_nonneg) hneg)
  simpa using h

/-- The angular integral in polar coordinates agrees with the oriented circle integral.
Tag: RiemannRochRes. -/
theorem b4c_residue_circle_polar (g : ℂ → ℂ) (r : ℝ) :
    (∫ θ in Set.Ioo (-Real.pi) Real.pi,
      (Complex.polarCoord.symm (r, θ) * Complex.I) *
        g (Complex.polarCoord.symm (r, θ))) = circleIntegral g 0 r := by
  have hcoord : ∀ θ : ℝ, Complex.polarCoord.symm (r, θ) = circleMap 0 r θ := by
    intro θ
    simp [Complex.polarCoord_symm_apply, circleMap, Complex.exp_mul_I]
  simp_rw [hcoord]
  rw [← MeasureTheory.integral_Ioc_eq_integral_Ioo,
    ← intervalIntegral.integral_of_le (by linarith [Real.pi_pos] : -Real.pi ≤ Real.pi)]
  have hper : Function.Periodic
      (fun θ ↦ (circleMap 0 r θ * Complex.I) * g (circleMap 0 r θ)) (2 * Real.pi) := by
    intro θ
    dsimp only
    rw [periodic_circleMap 0 r θ]
  have heq := hper.intervalIntegral_add_eq (-Real.pi) 0
  have hends : -Real.pi + 2 * Real.pi = Real.pi := by ring
  simpa only [hends, zero_add, circleIntegral, deriv_circleMap, smul_eq_mul] using heq

/-- Polar integration of the planar density associated to a radial cutoff.
Tag: RiemannRochRes. -/
theorem b4c_residue_area_radial (g : ℂ → ℂ) (q : ℝ → ℝ) {a b : ℝ}
    (ha : 0 < a) (hab : a < b) (hq : ∀ r ∉ Set.Icc a b, q r = 0)
    (hF : Continuous (fun z : ℂ ↦ (q ‖z‖ : ℂ) *
      (z * Complex.I / (‖z‖ : ℂ)) * g z)) :
    (∫ z : ℂ, (q ‖z‖ : ℂ) * (z * Complex.I / (‖z‖ : ℂ)) * g z) =
      ∫ r in a..b, (q r : ℂ) * circleIntegral g 0 r := by
  let F : ℂ → ℂ := fun z ↦ (q ‖z‖ : ℂ) * (z * Complex.I / (‖z‖ : ℂ)) * g z
  let f : ℝ × ℝ → ℂ := fun p ↦ p.1 • F (Complex.polarCoord.symm p)
  have hpc : Continuous (Complex.polarCoord.symm : ℝ × ℝ → ℂ) := by
    change Continuous (fun p : ℝ × ℝ ↦ Complex.polarCoord.symm p)
    simp_rw [Complex.polarCoord_symm_apply]
    fun_prop
  have hfc : Continuous f := continuous_fst.smul (hF.comp hpc)
  have hint : IntegrableOn f (Set.Ioi 0 ×ˢ Set.Ioo (-Real.pi) Real.pi)
      (volume.prod volume) := by
    have hc : IntegrableOn f (Set.Icc a b ×ˢ Set.Icc (-Real.pi) Real.pi)
        (volume.prod volume) :=
      hfc.continuousOn.integrableOn_compact (isCompact_Icc.prod isCompact_Icc)
    refine hc.of_forall_sdiff_eq_zero (measurableSet_Ioi.prod measurableSet_Ioo) ?_
    rintro ⟨r, θ⟩ ⟨⟨hr, hθ⟩, hn⟩
    change 0 < r at hr
    have hrab : r ∉ Set.Icc a b := fun h ↦ hn ⟨h, hθ.1.le, hθ.2.le⟩
    simp only [f, F, Complex.norm_polarCoord_symm, abs_of_pos hr, hq r hrab,
      Complex.ofReal_zero, zero_mul, smul_zero]
  have hpoint (r : ℝ) (hr : 0 < r) (θ : ℝ) : f (r, θ) =
      (q r : ℂ) * ((Complex.polarCoord.symm (r, θ) * Complex.I) *
        g (Complex.polarCoord.symm (r, θ))) := by
    have hrC : (r : ℂ) ≠ 0 := by exact_mod_cast hr.ne'
    simp only [f, F, Complex.norm_polarCoord_symm, abs_of_pos hr, Complex.real_smul]
    field_simp
    <;> ring
  have hinner : ∀ r ∈ Set.Ioi (0 : ℝ),
      (∫ θ in Set.Ioo (-Real.pi) Real.pi, f (r, θ)) =
        (q r : ℂ) * circleIntegral g 0 r := by
    intro r hr
    simp_rw [hpoint r hr]
    rw [integral_const_mul, b4c_residue_circle_polar]
  change (∫ z, F z) = _
  rw [← Complex.integral_comp_polarCoord_symm, polarCoord_target]
  change (∫ p in Set.Ioi 0 ×ˢ Set.Ioo (-Real.pi) Real.pi, f p) = _
  rw [Measure.volume_eq_prod, setIntegral_prod f hint,
    setIntegral_congr_fun measurableSet_Ioi hinner]
  rw [setIntegral_eq_of_subset_of_forall_sdiff_eq_zero measurableSet_Ioi
    (show Set.Icc a b ⊆ Set.Ioi (0 : ℝ) from fun r hr ↦ ha.trans_le hr.1)
    (fun r hr ↦ by simp only [hq r hr.2, Complex.ofReal_zero, zero_mul]),
    integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le hab.le]

/-- Integrating a radial cutoff derivative against the small-circle integrals gives the
negative residue contribution.
Tag: RiemannRochRes. -/
theorem b4c_residue_local_radial {g : ℂ → ℂ} (hg : MeromorphicAt g 0) :
    ∃ r : ℝ, 0 < r ∧ ∀ (a b : ℝ) (φ : ℝ → ℝ),
      0 < a → a < b → b < r → ContDiff ℝ 1 φ → φ a = 1 → φ b = 0 →
      (∫ t in a..b, ((deriv φ t : ℝ) : ℂ) * circleIntegral g 0 t) =
        -(2 * (Real.pi : ℂ) * Complex.I * residue g 0) := by
  obtain ⟨r, hr, hcirc⟩ := b4c_residue_local_circle hg
  refine ⟨r, hr, ?_⟩
  intro a b φ ha hab hbr hφ hφa hφb
  have hint : (∫ t in a..b, ((deriv φ t : ℝ) : ℂ)) = -1 := by
    rw [intervalIntegral.integral_ofReal,
      intervalIntegral.integral_deriv_eq_sub (fun t _ ↦ hφ.differentiable one_ne_zero t)
        (hφ.continuous_deriv_one.intervalIntegrable a b), hφa, hφb]
    norm_num
  calc
    (∫ t in a..b, ((deriv φ t : ℝ) : ℂ) * circleIntegral g 0 t) =
        ∫ t in a..b, ((deriv φ t : ℝ) : ℂ) *
          (2 * (Real.pi : ℂ) * Complex.I * residue g 0) := by
      apply intervalIntegral.integral_congr
      intro t ht
      rw [Set.uIcc_of_le hab.le] at ht
      dsimp only
      rw [hcirc t (ha.trans_le ht.1) (ht.2.trans_lt hbr)]
    _ = -(2 * (Real.pi : ℂ) * Complex.I * residue g 0) := by
      rw [intervalIntegral.integral_mul_const, hint, neg_one_mul]

/-- The planar radial-cutoff density integrates to the negative residue contribution.
Tag: RiemannRochRes. -/
theorem b4c_residue_local {g : ℂ → ℂ} (hg : MeromorphicAt g 0) :
    ∃ r : ℝ, 0 < r ∧ ∀ (a b : ℝ) (φ : ℝ → ℝ),
      0 < a → a < b → b < r → ContDiff ℝ 1 φ → φ a = 1 → φ b = 0 →
      (∀ t ∉ Set.Icc a b, deriv φ t = 0) →
      (∫ z : ℂ, ((deriv φ ‖z‖ : ℝ) : ℂ) *
        (z * Complex.I / (‖z‖ : ℂ)) * g z) =
          -(2 * (Real.pi : ℂ) * Complex.I * residue g 0) := by
  have hA : ∀ᶠ z in 𝓝 (0 : ℂ), z ≠ 0 → AnalyticAt ℂ g z := by
    simpa only [eventually_nhdsWithin_iff, mem_compl_singleton_iff] using hg.eventually_analyticAt
  obtain ⟨ε, hε, hA⟩ := Metric.eventually_nhds_iff.mp hA
  obtain ⟨r, hr, hradial⟩ := b4c_residue_local_radial hg
  refine ⟨min r ε, lt_min hr hε, ?_⟩
  intro a b φ ha hab hbr hφ hφa hφb hq
  have hF : Continuous (fun z : ℂ ↦ ((deriv φ ‖z‖ : ℝ) : ℂ) *
      (z * Complex.I / (‖z‖ : ℂ)) * g z) := by
    apply continuous_iff_continuousAt.mpr
    intro z
    by_cases hz : ‖z‖ ∈ Set.Icc a b
    · have hzpos : 0 < ‖z‖ := ha.trans_le hz.1
      have hzne : z ≠ 0 := norm_pos_iff.mp hzpos
      have hgz : AnalyticAt ℂ g z :=
        hA (by simpa only [dist_zero_right] using
          hz.2.trans_lt (hbr.trans_le (min_le_right r ε))) hzne
      have hdc : Continuous (fun y : ℂ ↦ ((deriv φ ‖y‖ : ℝ) : ℂ)) :=
        Complex.continuous_ofReal.comp (hφ.continuous_deriv_one.comp continuous_norm)
      have hnc : Continuous (fun y : ℂ ↦ (‖y‖ : ℂ)) :=
        Complex.continuous_ofReal.comp continuous_norm
      have hnz : (‖z‖ : ℂ) ≠ 0 := by exact_mod_cast hzpos.ne'
      exact (hdc.continuousAt.mul ((continuousAt_id.mul continuousAt_const).div
        hnc.continuousAt hnz)).mul hgz.continuousAt
    · apply (continuousAt_const : ContinuousAt (fun _ : ℂ ↦ (0 : ℂ)) z).congr_of_eventuallyEq
      have hn : ∀ᶠ y in 𝓝 z, ‖y‖ ∉ Set.Icc a b :=
        (isClosed_Icc.isOpen_compl.preimage continuous_norm).mem_nhds hz
      filter_upwards [hn] with y hy
      simp only [hq _ hy, Complex.ofReal_zero, zero_mul]
  rw [b4c_residue_area_radial g (deriv φ) ha hab hq hF]
  exact hradial a b φ ha hab (hbr.trans_le (min_le_left r ε)) hφ hφa hφb

section ResidueLocalAssembly
attribute [local instance] b3Forms_isManifold_real

/-- The explicit radial cutoff has the polar derivative density at every point.
Tag: RiemannRochRes. -/
theorem b4c_residue_profile_density {a b : ℝ} (ha : 0 < a) (hab : a < b) (z : ℂ) :
    Complex.I * fderiv ℝ (fun y : ℂ ↦ (b4c_residue_profile a b ‖y‖ : ℂ)) z 1 -
      fderiv ℝ (fun y : ℂ ↦ (b4c_residue_profile a b ‖y‖ : ℂ)) z Complex.I =
      ((deriv (b4c_residue_profile a b) ‖z‖ : ℝ) : ℂ) *
        (z * Complex.I / ‖z‖) := by
  by_cases hz : z = 0
  · subst z
    have heq : (fun y : ℂ ↦ (b4c_residue_profile a b ‖y‖ : ℂ)) =ᶠ[𝓝 0]
        fun _ ↦ (1 : ℂ) := by
      filter_upwards [b4c_residue_profile_radial_one ha hab] with y hy
      simp only [hy, Complex.ofReal_one]
    rw [heq.fderiv_eq]
    simp
  · exact b4c_residue_radial_derivative
      ((b4c_residue_profile_smooth a b).differentiable (by simp) ‖z‖) hz

/-- The planar derivative of the explicit radial cutoff integrates to the meromorphic residue.
Tag: RiemannRochRes. -/
theorem b4c_residue_local_cutoff {g : ℂ → ℂ} (hg : MeromorphicAt g 0) :
    ∃ r : ℝ, 0 < r ∧ ∀ (a b : ℝ), 0 < a → a < b → b < r →
      (∫ z : ℂ,
        (Complex.I * fderiv ℝ (fun y : ℂ ↦ (b4c_residue_profile a b ‖y‖ : ℂ)) z 1 -
          fderiv ℝ (fun y : ℂ ↦ (b4c_residue_profile a b ‖y‖ : ℂ)) z Complex.I) * g z) =
            -(2 * (Real.pi : ℂ) * Complex.I * residue g 0) := by
  obtain ⟨r, hr, hlocal⟩ := b4c_residue_local hg
  refine ⟨r, hr, ?_⟩
  intro a b ha hab hbr
  simp_rw [b4c_residue_profile_density ha hab]
  exact hlocal a b (b4c_residue_profile a b) ha hab hbr
    ((b4c_residue_profile_smooth a b).of_le (by simp))
    (b4c_residue_profile_one hab le_rfl) (b4c_residue_profile_zero hab le_rfl)
    (fun t ht ↦ b4c_residue_profile_deriv hab ht)
/-- Stokes applied to the smooth normalized global cutoff form.
Tag: RiemannRochRes. -/
theorem b4c_residue_stokes_global [T2Space C] [CompactSpace C]
    [FiniteDimensional ℂ E] [MeasurableSpace E] [BorelSpace E]
    (hE : Module.finrank ℂ E = 1) (w : b4c_MeroForm E C hE) (μ : C → ℝ)
    (hμ : ContMDiff 𝓘(ℝ, E) 𝓘(ℝ, ℝ) ∞ μ)
    (hpoles : ∀ x, meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 < 0 → μ =ᶠ[𝓝 x] 0)
    (P : ℂ →L[ℝ] ℝ) :
    b3Forms_integral (b4c_residue_basis hE) (b3Forms_d (b4c_residue_realForm hE
      (fun v ↦ (μ v.proj : ℂ) * b4c_residue_normalizedForm hE w v) P)) = 0 :=
  b3Forms_integral_d_eq_zero b3Forms_oriented_complex (b4c_residue_basis hE)
    (b4c_residue_smooth_global hE w μ hμ hpoles P)

/-- Radial chart cutoffs can be chosen inside any neighborhood and below any radius bound.
Tag: RiemannRochRes. -/
theorem b4c_residue_radial_cutoff_at [T2Space C]
    (hE : Module.finrank ℂ E = 1) (x : C) {U : Set C}
    (hU : U ∈ 𝓝 x) {r : ℝ} (hr : 0 < r) :
    ∃ a b : ℝ, 0 < a ∧ a < b ∧ b < r ∧
      let χ := b4c_residue_chartFunction hE x (fun z ↦ b4c_residue_profile a b ‖z‖)
      ContMDiff 𝓘(ℝ, E) 𝓘(ℝ, ℝ) ∞ χ ∧ HasCompactSupport χ ∧
        tsupport χ ⊆ U ∩ (chartAt E x).source ∧
        (χ =ᶠ[𝓝 x] fun _ ↦ (1 : ℝ)) ∧
        ∀ z : ℂ, ‖z‖ ≤ b →
          chartAt E x x + b4cov_lineEquiv hE z ∈ (chartAt E x).target ∧
            (chartAt E x).symm (chartAt E x x + b4cov_lineEquiv hE z) ∈ U := by
  let e := chartAt E x
  let L := b4cov_lineEquiv hE
  let A : ℂ → E := fun z ↦ e x + L z
  have hx : x ∈ e.source := mem_chart_source E x
  have hAx : A 0 = e x := by simp [A]
  have hA : ContinuousAt A 0 := continuousAt_const.add L.continuous.continuousAt
  have ht : ∀ᶠ z in 𝓝 (0 : ℂ), A z ∈ e.target := by
    apply hA.preimage_mem_nhds
    rw [hAx]
    exact e.open_target.mem_nhds (e.map_source hx)
  have hT : Tendsto (fun z ↦ e.symm (A z)) (𝓝 0) (𝓝 x) := by
    have h := (e.continuousAt_symm (e.map_source hx)).tendsto
    rw [e.left_inv hx] at h
    exact h.comp (hAx ▸ hA.tendsto)
  obtain ⟨ε, hε, heps⟩ := Metric.eventually_nhds_iff.mp (ht.and (hT.eventually hU))
  let b := min ε r / 2
  let a := b / 2
  have hb : 0 < b := div_pos (lt_min hε hr) (by norm_num)
  have ha : 0 < a := div_pos hb (by norm_num)
  have hab : a < b := by dsimp [a]; linarith
  have hbε : b < ε := by dsimp [b]; have := min_le_left ε r; linarith
  have hbr : b < r := by dsimp [b]; have := min_le_right ε r; linarith
  let g : ℂ → ℝ := fun z ↦ b4c_residue_profile a b ‖z‖
  have hg : ∀ z ∈ tsupport g, A z ∈ e.target ∧ e.symm (A z) ∈ U := by
    intro z hz
    apply heps
    have hz' := b4c_residue_profile_radial_support hab hz
    rw [Metric.mem_closedBall, dist_zero_right] at hz'
    simpa only [dist_zero_right] using hz'.trans_lt hbε
  have hgc : HasCompactSupport g := b4c_residue_profile_radial_compact hab
  have hs := b4c_residue_chartFunction_support hE x g hgc (fun z hz ↦ (hg z hz).1)
  refine ⟨a, b, ha, hab, hbr,
    b4c_residue_chartFunction_smooth hE x g (b4c_residue_profile_radial_smooth ha hab)
      hgc (fun z hz ↦ (hg z hz).1), hs.1, ?_,
    b4c_residue_chartFunction_one hE x g (b4c_residue_profile_radial_one ha hab), ?_⟩
  · intro y hy
    refine ⟨?_, hs.2.1 hy⟩
    obtain ⟨u, ⟨z, hz, rfl⟩, rfl⟩ := hs.2.2 hy
    exact (hg z hz).2
  · intro z hz
    apply heps
    simpa only [dist_zero_right] using hz.trans_lt hbε

/-- A finite set have pairwise disjoint radial chart cutoffs with prescribed radius bounds.
Tag: RiemannRochRes. -/
theorem b4c_residue_radial_cutoffs [T2Space C]
    (hE : Module.finrank ℂ E = 1) (s : Set C) (hs : s.Finite)
    (R : C → ℝ) (hR : ∀ x, 0 < R x) :
    ∃ a b : C → ℝ, (∀ x, 0 < a x ∧ a x < b x ∧ b x < R x) ∧
      let χ := fun x ↦ b4c_residue_chartFunction hE x
        (fun z ↦ b4c_residue_profile (a x) (b x) ‖z‖)
      (∀ x, ContMDiff 𝓘(ℝ, E) 𝓘(ℝ, ℝ) ∞ (χ x)) ∧
      (∀ x, HasCompactSupport (χ x)) ∧
      (∀ x, tsupport (χ x) ⊆ (chartAt E x).source) ∧
      (∀ x, χ x =ᶠ[𝓝 x] fun _ ↦ (1 : ℝ)) ∧
      s.PairwiseDisjoint (fun x ↦ tsupport (χ x)) ∧
      ∀ x z, ‖z‖ ≤ b x → chartAt E x x + b4cov_lineEquiv hE z ∈ (chartAt E x).target := by
  classical
  obtain ⟨U, hU, hd⟩ := hs.t2_separation
  have hcut := fun x ↦ b4c_residue_radial_cutoff_at hE x
    ((hU x).2.mem_nhds (hU x).1) (hR x)
  choose a b ha hab hbR hsm hc hsub hone hball using hcut
  refine ⟨a, b, fun x ↦ ⟨ha x, hab x, hbR x⟩, hsm, hc,
    fun x ↦ (hsub x).trans inter_subset_right, hone, ?_, fun x z hz ↦ (hball x z hz).1⟩
  intro x hx y hy hxy
  exact (hd hx hy hxy).mono ((hsub x).trans inter_subset_left)
    ((hsub y).trans inter_subset_left)

/-- A finite family equal to one in sum on the support localizes a top-form integral.
Tag: RiemannRochRes. -/
theorem b4c_residue_integral_localize [T2Space C] [CompactSpace C]
    [FiniteDimensional ℂ E] [MeasurableSpace E] [BorelSpace E]
    (hE : Module.finrank ℂ E = 1) (s : Finset C) (χ : C → C → ℝ)
    (hχ : ∀ i ∈ s, ContMDiff 𝓘(ℝ, E) 𝓘(ℝ, ℝ) ∞ (χ i))
    (hchart : ∀ i ∈ s, tsupport (χ i) ⊆ (chartAt E i).source)
    (α : C → E [⋀^Fin 2]→L[ℝ] ℝ) (hα : b3Forms_IsSmooth α)
    (hpartition : ∀ x, α x ≠ 0 → ∑ i ∈ s, χ i x = 1) :
    b3Forms_integral (b4c_residue_basis hE) α =
      ∑ i ∈ s, b3Forms_chartIntegral (b4c_residue_basis hE) i
        (b3Forms_smulFun (χ i) α) := by
  have heq : α = ∑ i ∈ s, b3Forms_smulFun (χ i) α := by
    funext x
    simp only [Finset.sum_apply, b3Forms_smulFun, ← Finset.sum_smul]
    by_cases hx : α x = 0
    · simp [hx]
    · rw [hpartition x hx, one_smul]
  calc
    _ = b3Forms_integral (b4c_residue_basis hE)
        (∑ i ∈ s, b3Forms_smulFun (χ i) α) := congrArg _ heq
    _ = ∑ i ∈ s, b3Forms_integral (b4c_residue_basis hE)
        (b3Forms_smulFun (χ i) α) :=
      b3Forms_integral_finsetSum _ s (fun i hi ↦ hα.smulFun (hχ i hi))
    _ = _ := Finset.sum_congr rfl fun i hi ↦
      b3Forms_integral_eq_chartIntegral _ b3Forms_oriented_complex
        (hα.smulFun (hχ i hi))
        ((b3Forms_tsupport_smulFun_subset_left _ _).trans (hchart i hi))

/-- The cutoff derivative vanishes wherever its multiplier is locally constant.
Tag: RiemannRochRes. -/
theorem b4c_residue_d_eq_zero_of_constant
    (hE : Module.finrank ℂ E = 1) (w : b4c_MeroForm E C hE) (μ : C → ℝ)
    (hμ : ContMDiff 𝓘(ℝ, E) 𝓘(ℝ, ℝ) ∞ μ)
    (hpoles : ∀ x, meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 < 0 → μ =ᶠ[𝓝 x] 0)
    (P : ℂ →L[ℝ] ℝ) {x : C} {c : ℝ} (hx : μ =ᶠ[𝓝 x] fun _ ↦ c) :
    b3Forms_d (b4c_residue_realForm hE
      (fun v ↦ (μ v.proj : ℂ) * b4c_residue_normalizedForm hE w v) P) x = 0 := by
  let α := b3Forms_d (b4c_residue_realForm hE
    (fun v ↦ (μ v.proj : ℂ) * b4c_residue_normalizedForm hE w v) P) x
  have hT : Tendsto (fun z : ℂ ↦ (chartAt E x).symm
      (chartAt E x x + b4cov_lineEquiv hE z)) (𝓝 0) (𝓝 x) := by
    have h := ((chartAt E x).continuousAt_symm
      ((chartAt E x).map_source (mem_chart_source E x))).tendsto
    rw [(chartAt E x).left_inv (mem_chart_source E x)] at h
    apply h.comp
    have hc : ContinuousAt (fun z : ℂ ↦ chartAt E x x + b4cov_lineEquiv hE z) 0 :=
      continuousAt_const.add (b4cov_lineEquiv hE).continuous.continuousAt
    simpa only [map_zero, add_zero] using hc.tendsto
  have hm : (fun z : ℂ ↦ (μ ((chartAt E x).symm
      (chartAt E x x + b4cov_lineEquiv hE z)) : ℂ)) =ᶠ[𝓝 0] fun _ ↦ (c : ℂ) := by
    filter_upwards [hT.eventually hx] with z hz
    rw [hz]
  have hb : α (b4c_residue_basis hE) = 0 := by
    rw [b4c_residue_basis_coe]
    change b3Forms_d _ x _ = 0
    rw [b4c_residue_d_multiplier hE w μ hμ hpoles P x]
    rw [hm.fderiv_eq]
    simp
  have hz := (α.toAlternatingMap.map_basis_eq_zero_iff (b4c_residue_basis hE)).mp hb
  ext v
  exact congrArg (fun f : E [⋀^Fin 2]→ₗ[ℝ] ℝ ↦ f v) hz

/-- The derivative of the complementary cutoff form is supported on the cutoff supports.
Tag: RiemannRochRes. -/
theorem b4c_residue_d_support
    (hE : Module.finrank ℂ E = 1) (w : b4c_MeroForm E C hE)
    (s : Finset C) (χ : C → C → ℝ)
    (hχ : ∀ i ∈ s, ContMDiff 𝓘(ℝ, E) 𝓘(ℝ, ℝ) ∞ (χ i))
    (hpoles : ∀ x, meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 < 0 →
      (fun y ↦ 1 - ∑ i ∈ s, χ i y) =ᶠ[𝓝 x] 0)
    (P : ℂ →L[ℝ] ℝ) :
    Function.support (b3Forms_d (b4c_residue_realForm hE
      (fun v ↦ ((1 - ∑ i ∈ s, χ i v.proj : ℝ) : ℂ) *
        b4c_residue_normalizedForm hE w v) P)) ⊆ ⋃ i ∈ s, tsupport (χ i) := by
  intro x hx
  by_contra hn
  have hz : ∀ i ∈ s, χ i =ᶠ[𝓝 x] 0 := by
    intro i hi
    apply notMem_tsupport_iff_eventuallyEq.mp
    intro hxi
    exact hn (Set.mem_iUnion.mpr ⟨i, Set.mem_iUnion.mpr ⟨hi, hxi⟩⟩)
  have hzero : (fun y ↦ 1 - ∑ i ∈ s, χ i y) =ᶠ[𝓝 x] fun _ ↦ (1 : ℝ) := by
    have he : ∀ᶠ y in 𝓝 x, ∀ i ∈ s, χ i y = 0 := by
      simpa only [Filter.eventually_all_finset, Filter.EventuallyEq, Pi.zero_apply] using hz
    filter_upwards [he] with y hy
    simp [Finset.sum_eq_zero hy]
  exact hx (b4c_residue_d_eq_zero_of_constant hE w _
    (contMDiff_const.sub (ContMDiff.sum hχ)) hpoles P hzero)

/-- An outer radial chart cutoff is one on the support of an inner radial cutoff.
Tag: RiemannRochRes. -/
theorem b4c_residue_nested_cutoffs [T2Space C]
    (hE : Module.finrank ℂ E = 1) (x : C) {a b : ℝ}
    (ha : 0 < a) (hab : a < b)
    (hball : ∀ z : ℂ, ‖z‖ ≤ b →
      chartAt E x x + b4cov_lineEquiv hE z ∈ (chartAt E x).target) :
    ∀ y ∈ tsupport (b4c_residue_chartFunction hE x
      (fun z ↦ b4c_residue_profile (a / 2) a ‖z‖)),
      b4c_residue_chartFunction hE x (fun z ↦ b4c_residue_profile a b ‖z‖) y = 1 := by
  have haa : a / 2 < a := by linarith
  have hinner : ∀ z ∈ tsupport (fun z : ℂ ↦ b4c_residue_profile (a / 2) a ‖z‖),
      ‖z‖ ≤ a := by
    intro z hz
    simpa only [Metric.mem_closedBall, dist_zero_right] using
      b4c_residue_profile_radial_support haa hz
  have hs := b4c_residue_chartFunction_support hE x _
    (b4c_residue_profile_radial_compact haa)
    (fun z hz ↦ hball z ((hinner z hz).trans hab.le))
  intro y hy
  obtain ⟨u, ⟨z, hz, rfl⟩, rfl⟩ := hs.2.2 hy
  rw [b4c_residue_chartFunction_coordinates hE x _
    (hball z ((hinner z hz).trans hab.le))]
  exact b4c_residue_profile_one hab (hinner z hz)

/-- Disjoint outer cutoffs sum to one on any union where the corresponding cutoff is one.
Tag: RiemannRochRes. -/
theorem b4c_residue_cutoff_partition {X : Type*} [TopologicalSpace X]
    (s : Finset X) (χ ψ : X → X → ℝ)
    (hd : (s : Set X).PairwiseDisjoint (fun i ↦ tsupport (χ i)))
    (hone : ∀ i ∈ s, ∀ x ∈ tsupport (ψ i), χ i x = 1)
    {x : X} (hx : x ∈ ⋃ i ∈ s, tsupport (ψ i)) :
    ∑ i ∈ s, χ i x = 1 := by
  obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hx
  obtain ⟨his, hxi⟩ := Set.mem_iUnion.mp hi
  have hχi := hone i his x hxi
  have hxis : x ∈ tsupport (χ i) := subset_tsupport _ (by simp [hχi])
  calc
    _ = χ i x := Finset.sum_eq_single i (fun j hj hji ↦ by
      by_contra hne
      exact Set.disjoint_left.mp (hd hj his hji) (subset_tsupport _ hne) hxis)
      (fun h ↦ (h his).elim)
    _ = 1 := hχi

/-- Stokes and nested cutoffs give a finite sum of chart integrals equal to zero.
Tag: RiemannRochRes. -/
theorem b4c_residue_stokes_localize [T2Space C] [CompactSpace C]
    [FiniteDimensional ℂ E] [MeasurableSpace E] [BorelSpace E]
    (hE : Module.finrank ℂ E = 1) (w : b4c_MeroForm E C hE)
    (s : Finset C) (χ ψ : C → C → ℝ)
    (hχ : ∀ i ∈ s, ContMDiff 𝓘(ℝ, E) 𝓘(ℝ, ℝ) ∞ (χ i))
    (hψ : ∀ i ∈ s, ContMDiff 𝓘(ℝ, E) 𝓘(ℝ, ℝ) ∞ (ψ i))
    (hchart : ∀ i ∈ s, tsupport (χ i) ⊆ (chartAt E i).source)
    (hd : (s : Set C).PairwiseDisjoint (fun i ↦ tsupport (χ i)))
    (hone : ∀ i ∈ s, ∀ x ∈ tsupport (ψ i), χ i x = 1)
    (hpoles : ∀ x, meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 < 0 →
      (fun y ↦ 1 - ∑ i ∈ s, ψ i y) =ᶠ[𝓝 x] 0)
    (P : ℂ →L[ℝ] ℝ) :
    ∑ i ∈ s, b3Forms_chartIntegral (b4c_residue_basis hE) i
      (b3Forms_smulFun (χ i) (b3Forms_d (b4c_residue_realForm hE
        (fun v ↦ ((1 - ∑ j ∈ s, ψ j v.proj : ℝ) : ℂ) *
          b4c_residue_normalizedForm hE w v) P))) = 0 := by
  have hμ : ContMDiff 𝓘(ℝ, E) 𝓘(ℝ, ℝ) ∞ (fun y ↦ 1 - ∑ i ∈ s, ψ i y) :=
    contMDiff_const.sub (ContMDiff.sum hψ)
  rw [← b4c_residue_integral_localize hE s χ hχ hchart _
    (b4c_residue_smooth_global hE w _ hμ hpoles P).d]
  · exact b4c_residue_stokes_global hE w _ hμ hpoles P
  · intro x hx
    exact b4c_residue_cutoff_partition s χ ψ hd hone
      (b4c_residue_d_support hE w s ψ hψ hpoles P hx)

/-- A radial cutoff removes the central singularity in the derivative calculation.
Tag: RiemannRochRes. -/
theorem b4c_residue_radial_product {G : ℂ → ℂ} {a b : ℝ}
    (ha : 0 < a) (hab : a < b) {z : ℂ}
    (hG : z ≠ 0 → AnalyticAt ℂ G z) :
    DifferentiableAt ℝ (fun y : ℂ ↦
      (1 - (b4c_residue_profile a b ‖y‖ : ℂ)) * G y) z ∧
    Complex.I * fderiv ℝ (fun y : ℂ ↦
      (1 - (b4c_residue_profile a b ‖y‖ : ℂ)) * G y) z 1 -
      fderiv ℝ (fun y : ℂ ↦
        (1 - (b4c_residue_profile a b ‖y‖ : ℂ)) * G y) z Complex.I =
      -(((deriv (b4c_residue_profile a b) ‖z‖ : ℝ) : ℂ) *
        (z * Complex.I / ‖z‖) * G z) := by
  by_cases hz : z = 0
  · subst z
    have he : (fun y : ℂ ↦ (1 - (b4c_residue_profile a b ‖y‖ : ℂ)) * G y)
        =ᶠ[𝓝 0] fun _ ↦ (0 : ℂ) := by
      filter_upwards [b4c_residue_profile_radial_one ha hab] with y hy
      simp [hy]
    refine ⟨(differentiableAt_const (0 : ℂ)).congr_of_eventuallyEq he, ?_⟩
    rw [he.fderiv_eq]
    simp
  · have hχ : DifferentiableAt ℝ
        (fun y : ℂ ↦ (b4c_residue_profile a b ‖y‖ : ℂ)) z :=
      (Complex.ofRealCLM.contDiff.comp (b4c_residue_profile_radial_smooth ha hab)).differentiable
        (by simp) z
    refine ⟨((differentiableAt_const (1 : ℂ)).sub hχ).mul
      ((hG hz).differentiableAt.restrictScalars ℝ), ?_⟩
    rw [b4c_residue_d_eta_local hχ (hG hz), b4c_residue_profile_density ha hab, neg_mul]

/-- The radial residue density is integrable when its transition annulus is analytic.
Tag: RiemannRochRes. -/
theorem b4c_residue_density_integrable {G : ℂ → ℂ} {a b : ℝ}
    (ha : 0 < a) (hab : a < b)
    (hG : ∀ z : ℂ, ‖z‖ ∈ Set.Icc a b → AnalyticAt ℂ G z) :
    Integrable (fun z : ℂ ↦ ((deriv (b4c_residue_profile a b) ‖z‖ : ℝ) : ℂ) *
      (z * Complex.I / ‖z‖) * G z) := by
  let F : ℂ → ℂ := fun z ↦ ((deriv (b4c_residue_profile a b) ‖z‖ : ℝ) : ℂ) *
    (z * Complex.I / ‖z‖) * G z
  have hc : Continuous F := by
    apply continuous_iff_continuousAt.mpr
    intro z
    by_cases hz : ‖z‖ ∈ Set.Icc a b
    · have hn : (‖z‖ : ℂ) ≠ 0 := by
        exact_mod_cast (ha.trans_le hz.1).ne'
      have hd : Continuous (fun y : ℂ ↦
          ((deriv (b4c_residue_profile a b) ‖y‖ : ℝ) : ℂ)) :=
        Complex.continuous_ofReal.comp
          (((b4c_residue_profile_smooth a b).of_le (by simp : (1 : WithTop ℕ∞) ≤ ∞)).continuous_deriv_one.comp continuous_norm)
      exact (hd.continuousAt.mul ((continuousAt_id.mul continuousAt_const).div
        (Complex.continuous_ofReal.comp continuous_norm).continuousAt hn)).mul
        (hG z hz).continuousAt
    · apply (continuousAt_const : ContinuousAt (fun _ : ℂ ↦ (0 : ℂ)) z).congr_of_eventuallyEq
      filter_upwards [(isClosed_Icc.isOpen_compl.preimage continuous_norm).mem_nhds hz] with y hy
      simp only [F, b4c_residue_profile_deriv hab hy, Complex.ofReal_zero, zero_mul]
  have hs : HasCompactSupport F := by
    apply HasCompactSupport.intro (isCompact_closedBall (0 : ℂ) b)
    intro z hz
    have hnorm : b < ‖z‖ := by simpa only [Metric.mem_closedBall, dist_zero_right, not_le] using hz
    simp only [F, b4c_residue_profile_deriv hab
      (show ‖z‖ ∉ Set.Icc a b from fun h ↦ (not_le.mpr hnorm) h.2),
      Complex.ofReal_zero, zero_mul]
  exact hc.integrable_of_hasCompactSupport hs

/-- On an outer cutoff support, the complementary multiplier has only its own inner term.
Tag: RiemannRochRes. -/
theorem b4c_residue_multiplier_germ {X : Type*} [TopologicalSpace X]
    (s : Finset X) (χ ψ : X → X → ℝ)
    (hd : (s : Set X).PairwiseDisjoint (fun i ↦ tsupport (χ i)))
    (hone : ∀ i ∈ s, ∀ x ∈ tsupport (ψ i), χ i x = 1)
    {i : X} (hi : i ∈ s) {x : X} (hx : x ∈ tsupport (χ i)) :
    (fun y ↦ 1 - ∑ j ∈ s, ψ j y) =ᶠ[𝓝 x] fun y ↦ 1 - ψ i y := by
  have hz : ∀ j ∈ s, j ≠ i → ψ j =ᶠ[𝓝 x] 0 := by
    intro j hj hji
    apply notMem_tsupport_iff_eventuallyEq.mp
    intro hxj
    have hχj : x ∈ tsupport (χ j) := subset_tsupport _ (by simp [hone j hj x hxj])
    exact Set.disjoint_left.mp (hd hj hi hji) hχj hx
  have he : ∀ᶠ y in 𝓝 x, ∀ j ∈ s, j ≠ i → ψ j y = 0 := by
    simpa only [Filter.eventually_all_finset, Filter.eventually_all,
      Filter.EventuallyEq, Pi.zero_apply] using hz
  filter_upwards [he] with y hy
  rw [Finset.sum_eq_single i (fun j hj hji ↦ hy j hj hji) (fun hn ↦ (hn hi).elim)]

/-- The scalar coefficient inherits a radial multiplier germ inside a chart.
Tag: RiemannRochRes. -/
theorem b4c_residue_coefficient_germ
    (hE : Module.finrank ℂ E = 1) (w : b4c_MeroForm E C hE)
    (μ : C → ℝ) (x : C) (a b : ℝ) {z : ℂ}
    (hz : chartAt E x x + b4cov_lineEquiv hE z ∈ (chartAt E x).target)
    (hμ : μ =ᶠ[𝓝 ((chartAt E x).symm (chartAt E x x + b4cov_lineEquiv hE z))]
      fun y ↦ 1 - b4c_residue_chartFunction hE x
        (fun t ↦ b4c_residue_profile a b ‖t‖) y) :
    HurwitzPrymRR_loc hE
      (fun v ↦ (μ v.proj : ℂ) * b4c_residue_normalizedForm hE w v) x =ᶠ[𝓝 z]
      fun t ↦ (1 - (b4c_residue_profile a b ‖t‖ : ℂ)) *
        HurwitzPrymRR_loc hE (b4c_residue_normalizedForm hE w) x t := by
  let A : ℂ → E := fun t ↦ chartAt E x x + b4cov_lineEquiv hE t
  have hA : Continuous A := continuous_const.add (b4cov_lineEquiv hE).continuous
  have hT := ((chartAt E x).continuousAt_symm hz).tendsto.comp (hA.continuousAt (x := z)).tendsto
  filter_upwards [hT.eventually hμ, hA.continuousAt.preimage_mem_nhds
    ((chartAt E x).open_target.mem_nhds hz)] with t ht htarg
  change (μ ((chartAt E x).symm (A t)) : ℂ) * _ = _
  dsimp only [Function.comp_def] at ht
  rw [ht, b4c_residue_chartFunction_coordinates hE x _ htarg]
  push_cast
  rfl

/-- The local density of the global cutoff derivative is the negative radial density.
Tag: RiemannRochRes. -/
theorem b4c_residue_chart_density [T2Space C]
    (hE : Module.finrank ℂ E = 1) (w : b4c_MeroForm E C hE)
    (μ : C → ℝ) (hμ : ContMDiff 𝓘(ℝ, E) 𝓘(ℝ, ℝ) ∞ μ)
    (hpoles : ∀ x, meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 < 0 → μ =ᶠ[𝓝 x] 0)
    (x : C) {a b : ℝ} (ha : 0 < a) (hab : a < b)
    (hball : ∀ z : ℂ, ‖z‖ ≤ b →
      chartAt E x x + b4cov_lineEquiv hE z ∈ (chartAt E x).target)
    (hG : ∀ z : ℂ, ‖z‖ < b → z ≠ 0 →
      AnalyticAt ℂ (HurwitzPrymRR_loc hE (b4c_residue_normalizedForm hE w) x) z)
    (hμgerm : ∀ y ∈ tsupport (b4c_residue_chartFunction hE x
        (fun t ↦ b4c_residue_profile a b ‖t‖)),
      μ =ᶠ[𝓝 y] fun q ↦ 1 - b4c_residue_chartFunction hE x
        (fun t ↦ b4c_residue_profile (a / 2) a ‖t‖) q)
    (P : ℂ →L[ℝ] ℝ) (z : ℂ) :
    b3Forms_chartFun (b4c_residue_basis hE) x
      (b3Forms_smulFun (b4c_residue_chartFunction hE x
        (fun t ↦ b4c_residue_profile a b ‖t‖))
        (b3Forms_d (b4c_residue_realForm hE
          (fun v ↦ (μ v.proj : ℂ) * b4c_residue_normalizedForm hE w v) P)))
      (chartAt E x x + b4cov_lineEquiv hE z) =
      P (-(((deriv (b4c_residue_profile (a / 2) a) ‖z‖ : ℝ) : ℂ) *
        (z * Complex.I / ‖z‖) *
        HurwitzPrymRR_loc hE (b4c_residue_normalizedForm hE w) x z)) := by
  have ha2 : 0 < a / 2 := by positivity
  have haa : a / 2 < a := by linarith
  let χ := b4c_residue_chartFunction hE x (fun t ↦ b4c_residue_profile a b ‖t‖)
  let A : ℂ → E := fun t ↦ chartAt E x x + b4cov_lineEquiv hE t
  let y := (chartAt E x).symm (A z)
  let θ := fun v : TangentBundle 𝓘(ℂ, E) C ↦
    (μ v.proj : ℂ) * b4c_residue_normalizedForm hE w v
  let G := HurwitzPrymRR_loc hE (b4c_residue_normalizedForm hE w) x
  have hθ : HurwitzPrymRR_IsLinear θ := by
    intro q c v v'
    change (μ q : ℂ) * b4c_residue_normalizedForm hE w ⟨q, c • v + v'⟩ = _
    rw [b4c_residue_normalizedForm_linear hE w q c v v']
    change (μ q : ℂ) * (c * _ + _) = c * ((μ q : ℂ) * _) + (μ q : ℂ) * _
    ring
  have hzero : a < ‖z‖ → deriv (b4c_residue_profile (a / 2) a) ‖z‖ = 0 := by
    intro hza
    exact b4c_residue_profile_deriv haa (fun h ↦ (not_le.mpr hza) h.2)
  by_cases ht : A z ∈ (chartAt E x).target
  · rw [b3Forms_chartFun, Set.indicator_of_mem ht, b3Forms_loc_smulFun]
    change χ y * b3Forms_loc (b3Forms_d (b4c_residue_realForm hE θ P)) x (A z)
      (b4c_residue_basis hE) = _
    have hχcoord : χ y = b4c_residue_profile a b ‖z‖ :=
      b4c_residue_chartFunction_coordinates hE x _ ht
    by_cases hχ : χ y = 0
    · have hza : a < ‖z‖ := by
        by_contra hn
        have hh := b4c_residue_profile_one hab (le_of_not_gt hn)
        rw [hh] at hχcoord
        exact zero_ne_one (hχ.symm.trans hχcoord)
      simp [hχ, hzero hza]
    · have hzb : ‖z‖ < b := by
        by_contra hn
        exact hχ (hχcoord.trans (b4c_residue_profile_zero hab (le_of_not_gt hn)))
      have he := b4c_residue_coefficient_germ hE w μ x (a / 2) a ht
        (hμgerm y (subset_tsupport _ hχ))
      have hrad := b4c_residue_radial_product (G := G) ha2 haa (hG z hzb)
      have hdiff : DifferentiableAt ℝ (HurwitzPrymRR_loc hE θ x) z :=
        hrad.1.congr_of_eventuallyEq he
      rw [b4c_residue_basis_coe, b4c_residue_loc_derivative hE θ hθ P
        (b4c_residue_cutoff_coefficient_smooth hE w μ hμ hpoles) x z ht hdiff,
        he.fderiv_eq, hrad.2]
      by_cases hza : ‖z‖ ≤ a
      · rw [hχcoord, b4c_residue_profile_one hab hza, one_mul]
      · simp [hzero (lt_of_not_ge hza)]
  · have hzb : b < ‖z‖ := by
      by_contra hn
      exact ht (hball z (le_of_not_gt hn))
    rw [b3Forms_chartFun, Set.indicator_of_notMem ht]
    simp [hzero (hab.trans hzb)]

end ResidueLocalAssembly

/-- A localized radial chart integral is the chosen real projection of the residue
contribution.
Tag: RiemannRochRes. -/
theorem b4c_residue_chartIntegral_eq
    [T2Space C] [MeasurableSpace E] [BorelSpace E]
    (hE : Module.finrank ℂ E = 1) (w : b4c_MeroForm E C hE)
    (μ : C → ℝ) (hμ : ContMDiff (modelWithCornersSelf ℝ E) (modelWithCornersSelf ℝ ℝ) ∞ μ)
    (hpoles : ∀ x, meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 < 0 → μ =ᶠ[nhds x] 0)
    (x : C) {a b : ℝ} (ha : 0 < a) (hab : a < b)
    (hball : ∀ z : ℂ, ‖z‖ ≤ b →
      chartAt E x x + b4cov_lineEquiv hE z ∈ (chartAt E x).target)
    (hG : ∀ z : ℂ, ‖z‖ < b → z ≠ 0 →
      AnalyticAt ℂ (HurwitzPrymRR_loc hE (b4c_residue_normalizedForm hE w) x) z)
    (hμgerm : ∀ y ∈ tsupport (b4c_residue_chartFunction hE x
        (fun t ↦ b4c_residue_profile a b ‖t‖)),
      μ =ᶠ[nhds y] fun q ↦ 1 - b4c_residue_chartFunction hE x
        (fun t ↦ b4c_residue_profile (a / 2) a ‖t‖) q)
    (hlocal : (∫ z : ℂ,
      (((deriv (b4c_residue_profile (a / 2) a) ‖z‖ : ℝ) : ℂ) *
        (z * Complex.I / ‖z‖) *
        HurwitzPrymRR_loc hE (b4c_residue_normalizedForm hE w) x z)) =
          -(2 * (Real.pi : ℂ) * Complex.I * b4c_res (hE := hE) w x))
    (P : ℂ →L[ℝ] ℝ) :
    b3Forms_chartIntegral (b4c_residue_basis hE) x
      (b3Forms_smulFun (b4c_residue_chartFunction hE x
        (fun t ↦ b4c_residue_profile a b ‖t‖))
        (b3Forms_d (b4c_residue_realForm hE
          (fun v ↦ (μ v.proj : ℂ) * b4c_residue_normalizedForm hE w v) P))) =
      P (2 * (Real.pi : ℂ) * Complex.I * b4c_res (hE := hE) w x) := by
  have ha2 : 0 < a / 2 := by positivity
  have haa : a / 2 < a := by linarith
  have hInt := b4c_residue_density_integrable ha2 haa (fun z hz ↦
    hG z (hz.2.trans_lt hab) (norm_pos_iff.mp (ha2.trans_le hz.1)))
  have hIntNeg : Integrable (fun z : ℂ ↦
      -(((deriv (b4c_residue_profile (a / 2) a) ‖z‖ : ℝ) : ℂ) *
        (z * Complex.I / ‖z‖) *
        HurwitzPrymRR_loc hE (b4c_residue_normalizedForm hE w) x z)) := hInt.fun_neg
  rw [b4c_residue_chartIntegral_coordinates]
  simp_rw [b4c_residue_chart_density hE w μ hμ hpoles x ha hab hball hG hμgerm P]
  rw [P.integral_comp_comm hIntNeg]
  apply congrArg P
  have hneg : (∫ z : ℂ, -(((deriv (b4c_residue_profile (a / 2) a) ‖z‖ : ℝ) : ℂ) *
      (z * Complex.I / ‖z‖) *
      HurwitzPrymRR_loc hE (b4c_residue_normalizedForm hE w) x z)) =
      -(∫ z : ℂ, (((deriv (b4c_residue_profile (a / 2) a) ‖z‖ : ℝ) : ℂ) *
        (z * Complex.I / ‖z‖) *
        HurwitzPrymRR_loc hE (b4c_residue_normalizedForm hE w) x z)) := by
    simpa only using integral_neg (fun z : ℂ ↦
      (((deriv (b4c_residue_profile (a / 2) a) ‖z‖ : ℝ) : ℂ) *
        (z * Complex.I / ‖z‖) *
        HurwitzPrymRR_loc hE (b4c_residue_normalizedForm hE w) x z))
  rw [hneg, hlocal, neg_neg]

/-- Around each pole, one radius controls both punctured analyticity and every smaller
radial cutoff integral.
Tag: RiemannRochRes. -/
theorem b4c_residue_local_data (hE : Module.finrank ℂ E = 1)
    (w : b4c_MeroForm E C hE) (x : C) :
    ∃ r : ℝ, 0 < r ∧
      (∀ z : ℂ, ‖z‖ < r → z ≠ 0 →
        AnalyticAt ℂ (HurwitzPrymRR_loc hE (b4c_residue_normalizedForm hE w) x) z) ∧
      ∀ (a b : ℝ), 0 < a → a < b → b < r →
        (∫ z : ℂ,
          (Complex.I * fderiv ℝ
              (fun y : ℂ ↦ (b4c_residue_profile a b ‖y‖ : ℂ)) z 1 -
            fderiv ℝ
              (fun y : ℂ ↦ (b4c_residue_profile a b ‖y‖ : ℂ)) z Complex.I) *
            HurwitzPrymRR_loc hE (b4c_residue_normalizedForm hE w) x z) =
          -(2 * (Real.pi : ℂ) * Complex.I * b4c_res (hE := hE) w x) := by
  let G := HurwitzPrymRR_loc hE (b4c_residue_normalizedForm hE w) x
  have hmero : MeromorphicAt G 0 := (b4c_residue_normalizedForm_mem hE w).2 x
  have hA : ∀ᶠ z in nhds (0 : ℂ), z ≠ 0 → AnalyticAt ℂ G z := by
    simpa only [eventually_nhdsWithin_iff, mem_compl_singleton_iff] using
      hmero.eventually_analyticAt
  obtain ⟨rA, hrA, hA⟩ := Metric.eventually_nhds_iff.mp hA
  obtain ⟨rL, hrL, hL⟩ := b4c_residue_local_cutoff hmero
  refine ⟨min rA rL, lt_min hrA hrL, ?_, ?_⟩
  · intro z hz hne
    exact hA (by simpa only [dist_zero_right] using hz.trans_le (min_le_left rA rL)) hne
  · intro a b ha hab hbr
    rw [hL a b ha hab (hbr.trans_le (min_le_right rA rL))]
    exact congrArg Neg.neg (congrArg (fun q ↦ 2 * (Real.pi : ℂ) * Complex.I * q)
      (b4c_residue_normalizedForm_res hE w x))

theorem b4c_residue_sum_aux [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) (w : b4c_MeroForm E C hE) :
    ∑ᶠ x : C, b4c_res (hE := hE) w x = 0 := by
  classical
  letI : FiniteDimensional ℂ E := Module.finite_of_finrank_eq_succ hE
  letI : MeasurableSpace E := borel E
  haveI : BorelSpace E := ⟨rfl⟩
  let s := (b4c_residue_poles_finite hE w).toFinset
  choose R hR hA hlocal using fun x : C ↦ b4c_residue_local_data hE w x
  obtain ⟨a, b, hab, hχ, hχc, hχchart, hχone, hd, hball⟩ :=
    b4c_residue_radial_cutoffs hE (s : Set C) s.finite_toSet R hR
  let χ : C → C → ℝ := fun x ↦ b4c_residue_chartFunction hE x
    (fun z ↦ b4c_residue_profile (a x) (b x) ‖z‖)
  let ψ : C → C → ℝ := fun x ↦ b4c_residue_chartFunction hE x
    (fun z ↦ b4c_residue_profile (a x / 2) (a x) ‖z‖)
  let μ : C → ℝ := fun y ↦ 1 - ∑ i ∈ s, ψ i y
  have hψ : ∀ i ∈ s, ContMDiff (modelWithCornersSelf ℝ E)
      (modelWithCornersSelf ℝ ℝ) ∞ (ψ i) := by
    intro i hi
    apply b4c_residue_chartFunction_smooth hE i
    · exact b4c_residue_profile_radial_smooth (by positivity [ (hab i).1 ])
        (by linarith [(hab i).1])
    · exact b4c_residue_profile_radial_compact (by linarith [(hab i).1])
    · intro z hz
      apply hball i z
      have hzle : ‖z‖ ≤ a i := by
        simpa only [Metric.mem_closedBall, dist_zero_right] using
          b4c_residue_profile_radial_support (by linarith [(hab i).1]) hz
      exact hzle.trans (hab i).2.1.le
  have hψone : ∀ i ∈ s, ψ i =ᶠ[nhds i] fun _ ↦ (1 : ℝ) := by
    intro i hi
    exact b4c_residue_chartFunction_one hE i _
      (b4c_residue_profile_radial_one (by positivity [ (hab i).1 ])
        (by linarith [(hab i).1]))
  have hone : ∀ i ∈ s, ∀ y ∈ tsupport (ψ i), χ i y = 1 := by
    intro i hi
    exact b4c_residue_nested_cutoffs hE i (hab i).1 (hab i).2.1 (hball i)
  have hsub : ∀ i ∈ s, tsupport (ψ i) ⊆ tsupport (χ i) := by
    intro i hi y hy
    exact subset_tsupport _ (by simp [hone i hi y hy])
  have hψd : (s : Set C).PairwiseDisjoint (fun i ↦ tsupport (ψ i)) := by
    intro i hi j hj hij
    exact (hd hi hj hij).mono (hsub i hi) (hsub j hj)
  have hμ : ContMDiff (modelWithCornersSelf ℝ E) (modelWithCornersSelf ℝ ℝ) ∞ μ :=
    contMDiff_const.sub (ContMDiff.sum hψ)
  have hpoles : ∀ x, meromorphicOrderAt (HurwitzPrymRR_loc hE w x) 0 < 0 →
      μ =ᶠ[nhds x] 0 := by
    intro x hx
    apply b4c_residue_cutoff_vanishes s ψ hψone hψd
    exact (b4c_residue_poles_finite hE w).mem_toFinset.mpr hx
  have hproj (P : ℂ →L[ℝ] ℝ) :
      P (∑ i ∈ s, 2 * (Real.pi : ℂ) * Complex.I * b4c_res (hE := hE) w i) = 0 := by
    have hs := b4c_residue_stokes_localize hE w s χ ψ
      (fun i hi ↦ hχ i) hψ (fun i hi ↦ hχchart i) hd hone hpoles P
    have hterms : ∑ i ∈ s, b3Forms_chartIntegral (b4c_residue_basis hE) i
        (b3Forms_smulFun (χ i) (b3Forms_d (b4c_residue_realForm hE
          (fun v ↦ (μ v.proj : ℂ) * b4c_residue_normalizedForm hE w v) P))) =
        ∑ i ∈ s, P (2 * (Real.pi : ℂ) * Complex.I * b4c_res (hE := hE) w i) := by
      apply Finset.sum_congr rfl
      intro i hi
      have ha2 : 0 < a i / 2 := div_pos (hab i).1 (by norm_num)
      have haa : a i / 2 < a i := by linarith [(hab i).1]
      have haR : a i < R i := (hab i).2.1.trans (hab i).2.2
      have hLi := hlocal i (a i / 2) (a i) ha2 haa haR
      simp_rw [b4c_residue_profile_density ha2 haa] at hLi
      exact b4c_residue_chartIntegral_eq hE w μ hμ hpoles i
        (hab i).1 (hab i).2.1 (hball i)
        (fun z hz ↦ hA i z (hz.trans (hab i).2.2))
        (fun y hy ↦ b4c_residue_multiplier_germ s χ ψ hd hone hi hy) hLi P
    rw [hterms] at hs
    simpa only [map_sum] using hs
  let Z : ℂ := ∑ i ∈ s, 2 * (Real.pi : ℂ) * Complex.I * b4c_res (hE := hE) w i
  have hZ : Z = 0 := by
    apply Complex.ext
    · exact hproj Complex.reCLM
    · exact hproj Complex.imCLM
  have hsum : ∑ i ∈ s, b4c_res (hE := hE) w i = 0 := by
    have hfactor : Z = (2 * (Real.pi : ℂ) * Complex.I) *
        ∑ i ∈ s, b4c_res (hE := hE) w i := by
      simp only [Z, Finset.mul_sum]
    rw [hfactor] at hZ
    exact (mul_eq_zero.mp hZ).resolve_left (by norm_num [Real.pi_ne_zero])
  rw [b4c_residue_finsum_eq_poles_sum hE w, hsum]
/-- RiemannRochTop: a continuously differentiable curve misses a point of a complex surface. -/
lemma RiemannRochTop_smooth_curve_omits [Nonempty C] (hE : Module.finrank ℂ E = 1)
    (γ : ℝ → C) (hγ : ContMDiff 𝓘(ℝ, ℝ) 𝓘(ℝ, E) 1 γ) :
    ∃ p : C, ∀ t, γ t ≠ p := by
  have : FiniteDimensional ℂ E := Module.finite_of_finrank_eq_succ hE
  let x : C := Classical.choice inferInstance
  let e := chartAt E x
  obtain ⟨v, hv, hmiss, -, -⟩ := b3Rest_exists_generic hE hγ x 0 0
    e.open_target ⟨e x, e.map_source (mem_chart_source E x)⟩
  refine ⟨e.symm v, fun t ht ↦ hmiss ?_⟩
  exact ⟨t, ht ▸ e.map_target hv, by rw [ht]; exact e.right_inv hv⟩

/-- RiemannRochTop: a sphere homeomorphism taking a chosen point to infinity. -/
lemma RiemannRochTop_move_puncture (p : OnePoint ℂ) :
    ∃ e : OnePoint ℂ ≃ₜ OnePoint ℂ, e p = OnePoint.infty := by
  induction p using OnePoint.rec with
  | infty => exact ⟨Homeomorph.refl _, rfl⟩
  | coe z =>
    refine ⟨((Homeomorph.addRight (-z)).onePointCongr).trans b4cov_sphInvHomeo, ?_⟩
    change b4cov_sphInv (OnePoint.map (Homeomorph.addRight (-z)) (z : OnePoint ℂ)) = _
    simp

/-- RiemannRochTop: inversion is holomorphic on the sphere, including zero and infinity. -/
lemma RiemannRochTop_sphere_inversion_holomorphic :
    ContMDiff 𝓘(ℂ, ℂ) 𝓘(ℂ, ℂ) ω b4cov_sphInv := by
  have h0 : b4cov_chart0 ∈ IsManifold.maximalAtlas 𝓘(ℂ, ℂ) ω (OnePoint ℂ) :=
    IsManifold.chart_mem_maximalAtlas ((0 : ℂ) : OnePoint ℂ)
  have hI : b4cov_chartInf ∈ IsManifold.maximalAtlas 𝓘(ℂ, ℂ) ω (OnePoint ℂ) :=
    IsManifold.chart_mem_maximalAtlas (OnePoint.infty : OnePoint ℂ)
  have hIT : b4cov_chartInf.target = Set.univ := by
    simp [b4cov_chartInf, b4cov_chart0_target]
  intro p
  induction p using OnePoint.rec with
  | coe z =>
    have hz : (z : OnePoint ℂ) ∈ b4cov_chart0.source := by
      rw [b4cov_chart0_source]; exact Set.mem_range_self z
    have hd := (contMDiffAt_symm_of_mem_maximalAtlas hI
      (show b4cov_chart0 (z : OnePoint ℂ) ∈ b4cov_chartInf.target by rw [hIT]; trivial)).comp
        (z : OnePoint ℂ) (contMDiffAt_of_mem_maximalAtlas h0 hz)
    apply hd.congr_of_eventuallyEq
    filter_upwards [b4cov_chart0.open_source.mem_nhds hz] with y hy
    rw [b4cov_chart0_source] at hy
    obtain ⟨w, rfl⟩ := hy
    simp only [Function.comp_apply, b4cov_chart0_coe, b4cov_chartInf_symm]
  | infty =>
    have hz : (OnePoint.infty : OnePoint ℂ) ∈ b4cov_chartInf.source :=
      mem_chart_source ℂ OnePoint.infty
    have hd := (contMDiffAt_symm_of_mem_maximalAtlas h0
      (show b4cov_chartInf OnePoint.infty ∈ b4cov_chart0.target by
        rw [b4cov_chart0_target]; trivial)).comp
          OnePoint.infty (contMDiffAt_of_mem_maximalAtlas hI hz)
    apply hd.congr_of_eventuallyEq
    filter_upwards [b4cov_chartInf.open_source.mem_nhds hz] with y hy
    change y ∈ Set.univ ∩ b4cov_sphInv ⁻¹' b4cov_chart0.source at hy
    change b4cov_sphInv y = b4cov_chart0.symm (b4cov_chart0 (b4cov_sphInv y))
    exact (b4cov_chart0.left_inv hy.2).symm

/-- RiemannRochTop: affine translations extend holomorphically across the point at infinity. -/
lemma RiemannRochTop_sphere_translation_holomorphic (a : ℂ) :
    ContMDiff 𝓘(ℂ, ℂ) 𝓘(ℂ, ℂ) ω (Homeomorph.addRight a).onePointCongr := by
  let T := (Homeomorph.addRight a).onePointCongr
  have h0 : b4cov_chart0 ∈ IsManifold.maximalAtlas 𝓘(ℂ, ℂ) ω (OnePoint ℂ) :=
    IsManifold.chart_mem_maximalAtlas ((0 : ℂ) : OnePoint ℂ)
  intro p
  induction p using OnePoint.rec with
  | coe z =>
    have hz : (z : OnePoint ℂ) ∈ b4cov_chart0.source := by
      rw [b4cov_chart0_source]; exact Set.mem_range_self z
    have hd := (b4cov_coe_contMDiff.contMDiffAt (x := b4cov_chart0 (z : OnePoint ℂ) + a)).comp
      (z : OnePoint ℂ) ((contMDiffAt_of_mem_maximalAtlas h0 hz).add contMDiffAt_const)
    apply hd.congr_of_eventuallyEq
    filter_upwards [b4cov_chart0.open_source.mem_nhds hz] with y hy
    rw [b4cov_chart0_source] at hy
    obtain ⟨w, rfl⟩ := hy
    change ((w + a : ℂ) : OnePoint ℂ) = ((b4cov_chart0 (w : OnePoint ℂ) + a : ℂ) : OnePoint ℂ)
    rw [b4cov_chart0_coe]
  | infty =>
    have hq : ContDiffAt ℂ ω (fun z : ℂ ↦ z / (1 + a * z)) 0 :=
      contDiffAt_id.div (contDiffAt_const.add (contDiffAt_const.mul contDiffAt_id)) (by simp)
    have heq : (b4cov_chartInf ∘ T ∘ b4cov_chartInf.symm) =ᶠ[𝓝 (0 : ℂ)]
        (fun z : ℂ ↦ z / (1 + a * z)) := by
      have hne : ∀ᶠ z : ℂ in 𝓝 0, 1 + a * z ≠ 0 :=
        (by fun_prop : Continuous (fun z : ℂ ↦ 1 + a * z)).continuousAt.preimage_mem_nhds
          (isOpen_ne.mem_nhds (by simp))
      filter_upwards [hne] with z hz
      by_cases hz0 : z = 0
      · subst z
        simp [Function.comp_def, b4cov_chartInf_symm, b4cov_chartInf_apply,
          b4cov_sphInv_zero, T, b4cov_chart0_coe]
      · have hza : z⁻¹ + a ≠ 0 := by
          intro h
          apply hz
          calc
            1 + a * z = (z⁻¹ + a) * z := by rw [add_mul, inv_mul_cancel₀ hz0]
            _ = 0 := by rw [h, zero_mul]
        simp only [Function.comp_apply, b4cov_chartInf_symm, b4cov_sphInv_coe hz0]
        change b4cov_chartInf ((z⁻¹ + a : ℂ) : OnePoint ℂ) = _
        rw [b4cov_chartInf_apply, b4cov_sphInv_coe hza, b4cov_chart0_coe]
        field_simp
    have hd := hq.congr_of_eventuallyEq heq
    rw [contMDiffAt_iff]
    refine ⟨T.continuous.continuousAt, ?_⟩
    change ContDiffWithinAt ℂ ω
      (extChartAt 𝓘(ℂ, ℂ) (OnePoint.infty : OnePoint ℂ) ∘ T ∘
        (extChartAt 𝓘(ℂ, ℂ) (OnePoint.infty : OnePoint ℂ)).symm)
      (Set.range (𝓘(ℂ, ℂ))) (extChartAt 𝓘(ℂ, ℂ) (OnePoint.infty : OnePoint ℂ) OnePoint.infty)
    simpa only [extChartAt, b4cov_chartAt_infty, OpenPartialHomeomorph.extend_coe,
      OpenPartialHomeomorph.extend_coe_symm, modelWithCornersSelf_coe,
      modelWithCornersSelf_coe_symm, Function.id_comp, Function.comp_id, id_eq,
      b4cov_chartInf_apply, b4cov_sphInv_infty, b4cov_chart0_coe] using hd.contDiffWithinAt

/-- RiemannRochTop: any chosen sphere puncture can be moved to infinity biholomorphically. -/
lemma RiemannRochTop_move_puncture_biholomorphic (p : OnePoint ℂ) :
    ∃ e : OnePoint ℂ ≃ₜ OnePoint ℂ, e p = OnePoint.infty ∧
      ContMDiff 𝓘(ℂ, ℂ) 𝓘(ℂ, ℂ) ω e ∧ ContMDiff 𝓘(ℂ, ℂ) 𝓘(ℂ, ℂ) ω e.symm := by
  induction p using OnePoint.rec with
  | infty => exact ⟨Homeomorph.refl _, rfl, contMDiff_id, contMDiff_id⟩
  | coe z =>
    let T := (Homeomorph.addRight (-z)).onePointCongr
    have hT : T.symm = (Homeomorph.addRight z).onePointCongr := by
      apply Homeomorph.ext
      intro p
      induction p using OnePoint.rec with
      | infty => rfl
      | coe w =>
        change ((w - -z : ℂ) : OnePoint ℂ) = ((w + z : ℂ) : OnePoint ℂ)
        simp
    refine ⟨T.trans b4cov_sphInvHomeo, ?_, ?_, ?_⟩
    · change b4cov_sphInv (OnePoint.map (Homeomorph.addRight (-z)) (z : OnePoint ℂ)) = _
      simp
    · exact RiemannRochTop_sphere_inversion_holomorphic.comp
        (RiemannRochTop_sphere_translation_holomorphic (-z))
    · change ContMDiff 𝓘(ℂ, ℂ) 𝓘(ℂ, ℂ) ω (T.symm ∘ b4cov_sphInv)
      rw [hT]
      exact (RiemannRochTop_sphere_translation_holomorphic z).comp
        RiemannRochTop_sphere_inversion_holomorphic

/-- RiemannRochTop: translated inverse coordinates give normalized holomorphic charts at infinity. -/
lemma RiemannRochTop_inverse_affine_chart (a : ℂ) :
    ∃ e : OpenPartialHomeomorph (OnePoint ℂ) ℂ,
      (OnePoint.infty : OnePoint ℂ) ∈ e.source ∧ e OnePoint.infty = 0 ∧
      e.target = Set.univ ∧ e.symm 0 = OnePoint.infty ∧
      (∀ z : ℂ, z ≠ 0 → e.symm z = ((a + z⁻¹ : ℂ) : OnePoint ℂ)) ∧
      ContMDiffAt 𝓘(ℂ, ℂ) 𝓘(ℂ, ℂ) ω e OnePoint.infty := by
  let T := (Homeomorph.addRight (-a)).onePointCongr
  let e := T.toOpenPartialHomeomorph.trans b4cov_chartInf
  have hmem : (OnePoint.infty : OnePoint ℂ) ∈ b4cov_chartInf.source :=
    mem_chart_source ℂ OnePoint.infty
  refine ⟨e, ⟨Set.mem_univ _, hmem⟩, ?_, ?_, ?_, ?_, ?_⟩
  · change b4cov_chartInf OnePoint.infty = 0
    rw [b4cov_chartInf_apply, b4cov_sphInv_infty, b4cov_chart0_coe]
  · simp [e, b4cov_chartInf, b4cov_chart0_target]
  · change T.symm (b4cov_chartInf.symm 0) = _
    rw [b4cov_chartInf_symm, b4cov_sphInv_zero]
    rfl
  · intro z hz
    change T.symm (b4cov_chartInf.symm z) = _
    rw [b4cov_chartInf_symm, b4cov_sphInv_coe hz]
    change ((z⁻¹ - -a : ℂ) : OnePoint ℂ) = ((a + z⁻¹ : ℂ) : OnePoint ℂ)
    simp [add_comm]
  · have hI := contMDiffAt_of_mem_maximalAtlas
      (IsManifold.chart_mem_maximalAtlas (I := 𝓘(ℂ, ℂ)) (n := ω) (OnePoint.infty : OnePoint ℂ)) hmem
    change ContMDiffAt 𝓘(ℂ, ℂ) 𝓘(ℂ, ℂ) ω (b4cov_chartInf ∘ T) OnePoint.infty
    have ht : ContMDiffAt 𝓘(ℂ, ℂ) 𝓘(ℂ, ℂ) ω T OnePoint.infty :=
      (RiemannRochTop_sphere_translation_holomorphic (-a)).contMDiffAt
    exact hI.comp OnePoint.infty ht

/-- RiemannRochTop: the once-punctured sphere is contractible. -/
lemma RiemannRochTop_single_puncture_contractible (p : OnePoint ℂ) :
    ContractibleSpace {y : OnePoint ℂ // y ≠ p} := by
  have : ContractibleSpace {y : OnePoint ℂ // y ≠ OnePoint.infty} := by
    change ContractibleSpace ↥({OnePoint.infty}ᶜ : Set (OnePoint ℂ))
    rw [OnePoint.compl_infty]
    exact OnePoint.isOpenEmbedding_coe.isEmbedding.toHomeomorph.symm.contractibleSpace
  obtain ⟨e, he⟩ := RiemannRochTop_move_puncture p
  exact (e.subtype (p := fun y ↦ y ≠ p) (q := fun y ↦ y ≠ OnePoint.infty)
    (fun y ↦ by rw [← he, e.injective.ne_iff])).contractibleSpace

/-- RiemannRochTop: every continuous circle map into the sphere is nullhomotopic. -/
lemma RiemannRochTop_sphere_circle_nullhomotopic (f : C(UnitAddCircle, OnePoint ℂ)) :
    f.Nullhomotopic := by
  obtain ⟨γ, q, hγq, h⟩ := b3Rest_exists_homotopic_smoothLoop (E := ℂ) f
  obtain ⟨p, hp⟩ := RiemannRochTop_smooth_curve_omits (by simp) γ.1 γ.2.2
  have hq : ∀ t, q t ≠ p := by
    intro t
    obtain ⟨t, rfl⟩ := QuotientAddGroup.mk_surjective t
    rw [← hγq t]
    exact hp t
  let q' : C(UnitAddCircle, {y : OnePoint ℂ // y ≠ p}) :=
    ⟨fun t ↦ ⟨q t, hq t⟩, by fun_prop⟩
  have : ContractibleSpace {y : OnePoint ℂ // y ≠ p} :=
    RiemannRochTop_single_puncture_contractible p
  have hn : q'.Nullhomotopic := (id_nullhomotopic _).comp_left q'
  obtain ⟨z, hz⟩ := hn.comp_right ⟨Subtype.val, continuous_subtype_val⟩
  exact ⟨z, ContinuousMap.Homotopic.trans h hz⟩

/-- RiemannRochTop: a nullhomotopic map sends every loop to a nullhomotopic loop. -/
lemma RiemannRochTop_nullhomotopic_map_loop {X Y : Type}
    [TopologicalSpace X] [TopologicalSpace Y] (f : C(X, Y)) (hf : f.Nullhomotopic)
    {x : X} (δ : Path x x) : (δ.map f.continuous).Homotopic (Path.refl (f x)) := by
  obtain ⟨z, ⟨H⟩⟩ := hf
  have hconst : δ.map (ContinuousMap.const X z).continuous = Path.refl z := by
    ext t
    rfl
  have hh := Path.Homotopic.Quotient.eq.mpr (Path.Homotopic.map_trans_evalAt H δ)
  rw [hconst] at hh
  change (Path.Homotopic.Quotient.mk (δ.map f.continuous)).trans
      (Path.Homotopic.Quotient.mk (H.evalAt x)) =
    (Path.Homotopic.Quotient.mk (H.evalAt x)).trans (Path.Homotopic.Quotient.refl z) at hh
  have hh := hh.trans (Path.Homotopic.Quotient.trans_refl _)
  have hh' := congrArg (fun q ↦ q.trans (Path.Homotopic.Quotient.mk (H.evalAt x)).symm) hh
  apply Path.Homotopic.Quotient.eq.mp
  simpa only [Path.Homotopic.Quotient.mk_refl, Path.Homotopic.Quotient.trans_assoc, Path.Homotopic.Quotient.trans_symm,
    Path.Homotopic.Quotient.trans_refl, Path.Homotopic.Quotient.refl_trans] using hh'

/-- RiemannRochTop: every based loop factors through the standard circle parameter. -/
lemma RiemannRochTop_path_circle_factor {X : Type} [TopologicalSpace X] {x : X}
    (γ : Path x x) : ∃ f : C(UnitAddCircle, X),
      ∀ t : unitInterval, f ((t : ℝ) : UnitAddCircle) = γ t := by
  let f : C(UnitAddCircle, X) := ⟨AddCircle.liftIco 1 0 γ.extend,
    AddCircle.liftIco_zero_continuous (by simp) γ.extend.continuous.continuousOn⟩
  refine ⟨f, fun t ↦ ?_⟩
  by_cases ht : t = 1
  · subst t
    change AddCircle.liftIco 1 0 γ.extend ((1 : ℝ) : UnitAddCircle) = γ 1
    rw [AddCircle.coe_period]
    change AddCircle.liftIco 1 0 γ.extend ((0 : ℝ) : UnitAddCircle) = γ 1
    rw [AddCircle.liftIco_zero_coe_apply (by norm_num), γ.extend_zero, γ.target]
  · have hlt : (t : ℝ) < 1 := lt_of_le_of_ne t.property.2 (fun he ↦ ht (Subtype.ext he))
    exact (AddCircle.liftIco_zero_coe_apply ⟨t.property.1, hlt⟩).trans (γ.extend_extends' t)

/-- RiemannRochTop: the sphere is simply connected. -/
lemma RiemannRochTop_sphere_simplyConnected : SimplyConnectedSpace (OnePoint ℂ) := by
  have : LocallyPathConnectedSpace (OnePoint ℂ) := ChartedSpace.locallyPathConnectedSpace ℂ _
  have : PathConnectedSpace (OnePoint ℂ) := PathConnectedSpace.of_locallyPathConnectedSpace
  apply simply_connected_iff_loops_nullhomotopic.mpr
  refine ⟨inferInstance, fun x γ ↦ ?_⟩
  obtain ⟨f, hf⟩ := RiemannRochTop_path_circle_factor γ
  let δ : Path (0 : UnitAddCircle) 0 :=
    ⟨⟨fun t ↦ ((t : ℝ) : UnitAddCircle), by fun_prop⟩, by simp, by simp⟩
  have h := RiemannRochTop_nullhomotopic_map_loop f
    (RiemannRochTop_sphere_circle_nullhomotopic f) δ
  have hx : x = f 0 := γ.source.symm.trans (hf 0).symm
  have hm : (δ.map f.continuous).cast hx hx = γ := by
    ext t
    exact hf t
  have hc : (Path.refl (f 0)).cast hx hx = Path.refl x := by
    ext t
    exact hx.symm
  simpa only [hm, hc] using h.pathCast hx hx

/-- RiemannRochTop: the sphere with one point removed is simply connected. -/
lemma RiemannRochTop_single_puncture (p : OnePoint ℂ) :
    IsSimplyConnected ({p}ᶜ : Set (OnePoint ℂ)) := by
  have hplane : IsSimplyConnected (Set.univ : Set ℂ) :=
    (Homeomorph.Set.univ ℂ).toHomotopyEquiv.simplyConnectedSpace
  have hinfty : IsSimplyConnected ({OnePoint.infty}ᶜ : Set (OnePoint ℂ)) := by
    rw [OnePoint.compl_infty, ← Set.image_univ]
    exact OnePoint.isOpenEmbedding_coe.isEmbedding.isSimplyConnected_image.mpr hplane
  obtain ⟨e, he⟩ := RiemannRochTop_move_puncture p
  have hpre : e ⁻¹' ({OnePoint.infty}ᶜ : Set (OnePoint ℂ)) = {p}ᶜ := by
    ext x
    simp only [Set.mem_preimage, Set.mem_compl_iff, Set.mem_singleton_iff,
      ← he, e.injective.eq_iff]
  rw [← hpre]
  exact e.isSimplyConnected_preimage.mpr hinfty

/-- RiemannRochTop: every loop class on a once-punctured sphere is the identity. -/
lemma RiemannRochTop_single_puncture_loop (p : OnePoint ℂ)
    (y₀ : {y : OnePoint ℂ // y ≠ p})
    (γ : FundamentalGroup {y : OnePoint ℂ // y ≠ p} y₀) : γ = 1 := by
  have : SimplyConnectedSpace {y : OnePoint ℂ // y ≠ p} :=
    RiemannRochTop_single_puncture p
  exact Subsingleton.elim _ _

/-- RiemannRochTop: the puncture presentation for a sphere with one point removed. -/
lemma RiemannRochTop_single_puncture_presentation (b : Fin 1 → OnePoint ℂ)
    (y₀ : {y : OnePoint ℂ // y ∉ Set.range b}) :
    ∃ γ : Fin 1 → FundamentalGroup {y : OnePoint ℂ // y ∉ Set.range b} y₀,
      (List.ofFn γ).prod = 1 ∧
      (∀ (H : Type) [Group H] (k : Fin 1 → H), (List.ofFn k).prod = 1 →
        ∃! φ : FundamentalGroup {y : OnePoint ℂ // y ∉ Set.range b} y₀ →* H,
          ∀ j, φ (γ j) = k j) := by
  have hrange : Set.range b = {b 0} := by
    ext x
    simp only [Set.mem_range, Set.mem_singleton_iff]
    constructor
    · rintro ⟨j, rfl⟩
      exact congrArg b (Subsingleton.elim j 0)
    · intro hx
      exact ⟨0, hx.symm⟩
  have hsimply : SimplyConnectedSpace {y : OnePoint ℂ // y ∉ Set.range b} := by
    change IsSimplyConnected (Set.range b)ᶜ
    rw [hrange]
    exact RiemannRochTop_single_puncture (b 0)
  refine ⟨fun _ ↦ 1, by simp, ?_⟩
  intro H _ k hk
  have hk0 : k 0 = 1 := by simpa using hk
  have hkall : ∀ j, k j = 1 := fun j ↦ (congrArg k (Subsingleton.elim j 0)).trans hk0
  refine ⟨1, fun j ↦ (hkall j).symm, ?_⟩
  intro φ _
  ext x
  have hx : x = 1 := Subsingleton.elim _ _
  simp only [hx, map_one]

/-- RiemannRochTop: a connected quotient covering of the once-punctured sphere has trivial group. -/
lemma RiemannRochTop_single_puncture_cover (p : OnePoint ℂ)
    {U G : Type} [TopologicalSpace U] [PathConnectedSpace U] [Group G] [MulAction G U]
    (f : U → {y : OnePoint ℂ // y ≠ p}) (hf : IsQuotientCoveringMap f G) :
    ∀ g : G, g = 1 := by
  let u : U := Classical.choice inferInstance
  let e : f ⁻¹' {f u} := ⟨u, rfl⟩
  intro g
  obtain ⟨γ, hγ⟩ := hf.fundamentalGroupToMulOpposite_surjective e (MulOpposite.op g)
  rw [RiemannRochTop_single_puncture_loop p (f u) γ, map_one] at hγ
  exact MulOpposite.op_injective hγ.symm

/-- RiemannRochTop: lifted loops with the same class and initial point have the same deck element. -/
lemma RiemannRochTop_lift_deck_eq {X U G : Type}
    [TopologicalSpace X] [TopologicalSpace U] [Group G] [MulAction G U]
    (f : U → X) (hf : IsQuotientCoveringMap f G) {x : X}
    (c d : Path x x) (hcd : FundamentalGroup.fromPath ⟦c⟧ = FundamentalGroup.fromPath ⟦d⟧)
    (Γ Δ : C(unitInterval, U)) (k l : G)
    (hΓ : ∀ t, f (Γ t) = c t) (hΔ : ∀ t, f (Δ t) = d t)
    (hstart : Γ 0 = Δ 0) (hΓend : Γ 1 = k • Γ 0) (hΔend : Δ 1 = l • Δ 0) :
    k = l := by
  let e : f ⁻¹' {x} := ⟨Γ 0, (hΓ 0).trans c.source⟩
  have hk := hf.fundamentalGroupToMulOpposite_apply_mk_eq (e := e)
    (funext hΓ) rfl hΓend
  have hl := hf.fundamentalGroupToMulOpposite_apply_mk_eq (e := e)
    (funext hΔ) hstart.symm (hΔend.trans (congrArg (fun u ↦ l • u) hstart.symm))
  exact MulOpposite.op_injective (hk.symm.trans ((congrArg
    (hf.fundamentalGroupToMulOpposite e) hcd).trans hl))

/-- RiemannRochTop: a finite Galois map is a covering away from nontrivial stabilizers. -/
lemma RiemannRochTop_galois_coveringOn [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) {G : Type} [Group G] [Finite G] [MulAction G C]
    (hG : ∀ g : G, ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω (fun x : C ↦ g • x))
    (f : C → OnePoint ℂ) (hf : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω f)
    (hgal : b4_IsGaloisCover G f) (B : Set (OnePoint ℂ))
    (hfree : ∀ x, f x ∉ B → MulAction.stabilizer G x = ⊥) :
    IsCoveringMapOn f Bᶜ := by
  letI : ContinuousConstSMul G C := ⟨fun g ↦ (hG g).continuous⟩
  have hsurj : Function.Surjective f := b4cov_surjective (by simp) f hf
    (b4cov_nonconst_of_galois hE f hgal (Classical.choice inferInstance))
  have hquot : IsQuotientMap f := hf.continuous.isClosedMap.isQuotientMap hf.continuous hsurj
  have horbit : ∀ {x y : C}, f x = f y ↔ x ∈ MulAction.orbit G y := by
    intro x y
    constructor
    · intro hxy
      obtain ⟨g, hg⟩ := hgal.2 y x hxy.symm
      exact ⟨g, hg⟩
    · rintro ⟨g, rfl⟩
      exact hgal.1 g y
  apply (hquot.isCoveringMapOn_of_properlyDiscontinuousSMul horbit).mono
  intro y hy
  obtain ⟨x, rfl⟩ := hsurj y
  exact ⟨x, hfree x hy, rfl⟩

/-- RiemannRochTop: homotopic paths lifted over a covering locus have equal endpoints. -/
lemma RiemannRochTop_coveringOn_lift_endpoint {X U : Type}
    [TopologicalSpace X] [TopologicalSpace U] (f : U → X) (B : Set X)
    (hf : IsCoveringMapOn f Bᶜ) {x : ↥(Bᶜ)}
    (c d : Path x x) (hcd : FundamentalGroup.fromPath ⟦c⟧ = FundamentalGroup.fromPath ⟦d⟧)
    (Γ Δ : C(unitInterval, U)) (hΓ : ∀ t, f (Γ t) = (c t : X))
    (hΔ : ∀ t, f (Δ t) = (d t : X)) (hstart : Γ 0 = Δ 0) : Γ 1 = Δ 1 := by
  let p := Bᶜ.restrictPreimage f
  have hp : IsCoveringMap p := hf.isCoveringMap_restrictPreimage
  let Γ' : C(unitInterval, f ⁻¹' Bᶜ) :=
    ⟨fun t ↦ ⟨Γ t, by change f (Γ t) ∈ Bᶜ; rw [hΓ t]; exact (c t).property⟩,
      by fun_prop⟩
  let Δ' : C(unitInterval, f ⁻¹' Bᶜ) :=
    ⟨fun t ↦ ⟨Δ t, by change f (Δ t) ∈ Bᶜ; rw [hΔ t]; exact (d t).property⟩,
      by fun_prop⟩
  have hΓ' : p ∘ Γ' = c := funext fun t ↦ Subtype.ext (hΓ t)
  have hΔ' : p ∘ Δ' = d := funext fun t ↦ Subtype.ext (hΔ t)
  let e : p ⁻¹' {x} := ⟨Γ' 0, (congrFun hΓ' 0).trans c.source⟩
  have h₁ := hp.monodromy_eq_apply_one (e := e) hΓ' rfl
  have h₂ := hp.monodromy_eq_apply_one (e := e) hΔ' (Subtype.ext hstart.symm)
  have heq : (⟦c⟧ : Path.Homotopic.Quotient x x) = ⟦d⟧ :=
    congrArg (fun γ : FundamentalGroup ↥(Bᶜ) x ↦ γ.asHom) hcd
  exact congrArg Subtype.val (h₁.symm.trans ((congrArg
    (fun γ ↦ (hp.monodromy γ e : f ⁻¹' Bᶜ)) heq).trans h₂))

/-- RiemannRochTop: changing a loop representative preserves both endpoints of a lift. -/
lemma RiemannRochTop_coveringOn_replace_loop {X U : Type}
    [TopologicalSpace X] [TopologicalSpace U] (f : U → X) (B : Set X)
    (hf : IsCoveringMapOn f Bᶜ) {x : ↥(Bᶜ)}
    (c d : Path x x) (hcd : FundamentalGroup.fromPath ⟦c⟧ = FundamentalGroup.fromPath ⟦d⟧)
    (Γ : C(unitInterval, U)) (hΓ : ∀ t, f (Γ t) = (c t : X)) :
    ∃ Δ : C(unitInterval, U), (∀ t, f (Δ t) = (d t : X)) ∧
      Δ 0 = Γ 0 ∧ Δ 1 = Γ 1 := by
  let p := Bᶜ.restrictPreimage f
  have hp : IsCoveringMap p := hf.isCoveringMap_restrictPreimage
  let u : f ⁻¹' Bᶜ := ⟨Γ 0, by rw [Set.mem_preimage, hΓ 0]; exact (c 0).property⟩
  have hu : d 0 = p u := by
    apply Subtype.ext
    change (d 0 : X) = f (Γ 0)
    rw [hΓ 0, c.source, d.source]
  let Δ' := hp.liftPath d u hu
  let Δ : C(unitInterval, U) := ⟨fun t ↦ (Δ' t).val, by fun_prop⟩
  have hΔ : ∀ t, f (Δ t) = (d t : X) := fun t ↦
    congrArg Subtype.val (congrFun (hp.liftPath_lifts d u hu) t)
  have hstart : Δ 0 = Γ 0 := congrArg Subtype.val (hp.liftPath_zero d u hu)
  refine ⟨Δ, hΔ, hstart, ?_⟩
  exact (RiemannRochTop_coveringOn_lift_endpoint f B hf c d hcd Γ Δ hΓ hΔ
    hstart.symm).symm

/-- RiemannRochTop: conjugating an action transports its rotation generator. -/
lemma RiemannRochTop_rotGen_conjugate {G : Type} [Group G] [MulAction G C]
    (hG : ∀ g : G, ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω (fun x : C ↦ g • x))
    (x : C) (g k : G) (hk : b4_IsRotGen E x k) :
    b4_IsRotGen E (g • x) (g * k * g⁻¹) := by
  have hord : orderOf (g * k * g⁻¹) = orderOf k := by
    simpa only [MulAut.conj_apply] using (MulAut.conj g).orderOf_eq k
  have hcard : Nat.card (MulAction.stabilizer G x) =
      Nat.card (MulAction.stabilizer G (g • x)) :=
    Nat.card_congr (MulAction.stabilizerEquivStabilizer (g := g) (a := x) rfl).toEquiv
  refine ⟨by simp only [mul_smul, inv_smul_smul, hk.1], hord.trans (hk.2.1.trans hcard), ?_⟩
  intro v
  let a : C → C := fun z ↦ g • z
  let b : C → C := fun z ↦ g⁻¹ • z
  let c : C → C := fun z ↦ k • z
  have ha : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω a := hG g
  have hb : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω b := hG g⁻¹
  have hc : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω c := hG k
  have hcomp : (fun z : C ↦ (g * k * g⁻¹) • z) = a ∘ c ∘ b := by
    funext z
    simp only [a, b, c, Function.comp_apply, mul_smul]
  have hbx : b (g • x) = x := inv_smul_smul g x
  have hcx : c x = x := hk.1
  have hab : a ∘ b = id := funext (smul_inv_smul g)
  have hchain := mfderiv_comp (g • x)
    ((ha _).mdifferentiableAt (by simp))
    (((hc.comp hb) _).mdifferentiableAt (by simp))
  rw [mfderiv_comp (g • x) ((hc _).mdifferentiableAt (by simp))
    ((hb _).mdifferentiableAt (by simp))] at hchain
  simp only [Function.comp_apply] at hchain
  have hinv := mfderiv_comp (g • x) ((ha _).mdifferentiableAt (by simp))
    ((hb _).mdifferentiableAt (by simp))
  rw [hab, mfderiv_id, hbx] at hinv
  let A : E →L[ℂ] E := mfderiv 𝓘(ℂ, E) 𝓘(ℂ, E) a x
  let B : E →L[ℂ] E := mfderiv 𝓘(ℂ, E) 𝓘(ℂ, E) b (g • x)
  let T : E →L[ℂ] E := mfderiv 𝓘(ℂ, E) 𝓘(ℂ, E) c x
  have hchain' : (mfderiv 𝓘(ℂ, E) 𝓘(ℂ, E) (a ∘ c ∘ b) (g • x) : E →L[ℂ] E) =
      A.comp (T.comp B) := by
    convert hchain using 1 <;> rw [hbx, hcx]
    rfl
  have hv := congrArg (fun T : E →L[ℂ] E ↦ T v) hinv
  change v = A (B v) at hv
  rw [hcomp]
  calc
    _ = A (T (B v)) := congrArg (fun L : E →L[ℂ] E ↦ L v) hchain'
    _ = A (Complex.exp (2 * Real.pi * Complex.I / (orderOf k : ℂ)) • B v) :=
      congrArg A (hk.2.2 (B v))
    _ = Complex.exp (2 * Real.pi * Complex.I / (orderOf k : ℂ)) • v := by
      rw [map_smul, ← hv]
    _ = _ := by rw [hord]

/-- RiemannRochTop: translating the initial point conjugates the deck element of a lifted loop. -/
lemma RiemannRochTop_lift_deck_conjugate {X U G : Type}
    [TopologicalSpace X] [TopologicalSpace U] [Group G] [MulAction G U]
    (f : U → X) (B : Set X) (hf : IsCoveringMapOn f Bᶜ)
    (hG : ∀ g : G, Continuous (fun u : U ↦ g • u))
    (hinv : ∀ (g : G) (u : U), f (g • u) = f u)
    {x : ↥(Bᶜ)} (c d : Path x x)
    (hcd : FundamentalGroup.fromPath ⟦c⟧ = FundamentalGroup.fromPath ⟦d⟧)
    (Γ Δ : C(unitInterval, U)) (g k l : G)
    (hΓ : ∀ t, f (Γ t) = (c t : X)) (hΔ : ∀ t, f (Δ t) = (d t : X))
    (hstart : Γ 0 = g • Δ 0) (hΓend : Γ 1 = k • Γ 0) (hΔend : Δ 1 = l • Δ 0)
    (hfree : MulAction.stabilizer G (Γ 0) = ⊥) : k = g * l * g⁻¹ := by
  let Δ' : C(unitInterval, U) := ⟨fun t ↦ g • Δ t, (hG g).comp Δ.continuous⟩
  have hΔ' : ∀ t, f (Δ' t) = (d t : X) := fun t ↦ (hinv g (Δ t)).trans (hΔ t)
  have hend := RiemannRochTop_coveringOn_lift_endpoint f B hf c d hcd Γ Δ'
    hΓ hΔ' hstart
  have heq : k • Γ 0 = (g * l * g⁻¹) • Γ 0 := by
    calc
      k • Γ 0 = Γ 1 := hΓend.symm
      _ = g • Δ 1 := hend
      _ = g • (l • Δ 0) := congrArg (fun u ↦ g • u) hΔend
      _ = (g * l * g⁻¹) • Γ 0 := by rw [hstart]; simp only [mul_smul, inv_smul_smul]
  have hmem : k⁻¹ * (g * l * g⁻¹) ∈ MulAction.stabilizer G (Γ 0) := by
    change (k⁻¹ * (g * l * g⁻¹)) • Γ 0 = Γ 0
    rw [mul_smul, ← heq, inv_smul_smul]
  have hunit : k⁻¹ * (g * l * g⁻¹) = 1 := by
    simpa only [hfree, Subgroup.mem_bot] using hmem
  exact inv_mul_eq_one.mp hunit

/-- RiemannRochTop: a reference lift determines the rotation clause for every loop in its class. -/
lemma RiemannRochTop_rotGen_of_reference_lift [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) {G : Type} [Group G] [Finite G] [MulAction G C]
    (hG : ∀ g : G, ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω (fun x : C ↦ g • x))
    (f : C → OnePoint ℂ) (hf : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω f)
    (hgal : b4_IsGaloisCover G f) (B : Set (OnePoint ℂ))
    (hfree : ∀ x, f x ∉ B → MulAction.stabilizer G x = ⊥)
    {y : ↥(Bᶜ)} (c d : Path y y)
    (hcd : FundamentalGroup.fromPath ⟦c⟧ = FundamentalGroup.fromPath ⟦d⟧)
    (Γ Δ : C(unitInterval, C)) (k l : G)
    (hΓ : ∀ t, f (Γ t) = (c t : OnePoint ℂ))
    (hΔ : ∀ t, f (Δ t) = (d t : OnePoint ℂ))
    (hΓend : Γ 1 = k • Γ 0) (hΔend : Δ 1 = l • Δ 0)
    (p : C) (hl : b4_IsRotGen E p l) :
    ∃ q, f q = f p ∧ b4_IsRotGen E q k := by
  have hbase : f (Δ 0) = f (Γ 0) := by rw [hΔ 0, hΓ 0, c.source, d.source]
  obtain ⟨g, hg⟩ := hgal.2 (Δ 0) (Γ 0) hbase
  have hfree₀ : MulAction.stabilizer G (Γ 0) = ⊥ := by
    apply hfree
    rw [hΓ 0]
    exact (c 0).property
  have hk := RiemannRochTop_lift_deck_conjugate f B
    (RiemannRochTop_galois_coveringOn hE hG f hf hgal B hfree)
    (fun g ↦ (hG g).continuous) hgal.1 c d hcd Γ Δ g k l hΓ hΔ hg.symm hΓend hΔend hfree₀
  refine ⟨g • p, hgal.1 g p, ?_⟩
  rw [hk]
  exact RiemannRochTop_rotGen_conjugate hG p g l hl

/-- RiemannRochTop: near a point, only stabilizer elements can identify two points of the neighborhood. -/
lemma RiemannRochTop_local_stabilizer [T2Space C]
    {G : Type} [Group G] [Finite G] [MulAction G C]
    (hG : ∀ g : G, Continuous (fun y : C ↦ g • y)) (x : C) :
    ∃ U : Set C, IsOpen U ∧ x ∈ U ∧
      ∀ (g : G) (y : C), y ∈ U → g • y ∈ U → g • x = x := by
  have hlocal : ∀ g : G, ∃ U : Set C, IsOpen U ∧ x ∈ U ∧
      (∀ y ∈ U, g • y ∈ U → g • x = x) := by
    intro g
    by_cases hg : g • x = x
    · exact ⟨Set.univ, isOpen_univ, Set.mem_univ _, fun _ _ _ ↦ hg⟩
    obtain ⟨V, W, hV, hW, hxV, hgxW, hdis⟩ := t2_separation (Ne.symm hg)
    refine ⟨V ∩ (fun y : C ↦ g • y) ⁻¹' W, hV.inter (hW.preimage (hG g)),
      ⟨hxV, hgxW⟩, ?_⟩
    intro y hy hgy
    exact False.elim (Set.disjoint_left.mp hdis hgy.1 hy.2)
  choose U hU hxU hprop using hlocal
  refine ⟨⋂ g, U g, isOpen_iInter_of_finite hU, Set.mem_iInter.mpr hxU, ?_⟩
  intro g y hy hgy
  exact hprop g y (Set.mem_iInter.mp hy g) (Set.mem_iInter.mp hgy g)

/-- RiemannRochTop: the rotation generator generates the entire stabilizer. -/
lemma RiemannRochTop_rotGen_zpowers {G : Type} [Group G] [Finite G] [MulAction G C]
    (x : C) (k : G) (hk : b4_IsRotGen E x k) :
    Subgroup.zpowers k = MulAction.stabilizer G x := by
  apply Subgroup.eq_of_le_of_card_ge (Subgroup.zpowers_le.mpr hk.1)
  rw [Nat.card_zpowers, hk.2.1]

/-- RiemannRochTop: fibers near a branch point are exactly the orbits of its rotation generator. -/
lemma RiemannRochTop_local_cyclic_fibers [T2Space C]
    {G : Type} [Group G] [Finite G] [MulAction G C]
    (hG : ∀ g : G, Continuous (fun y : C ↦ g • y))
    {Y : Type} (f : C → Y) (hgal : b4_IsGaloisCover G f)
    (x : C) (k : G) (hk : b4_IsRotGen E x k) :
    ∃ U : Set C, IsOpen U ∧ x ∈ U ∧
      ∀ y ∈ U, ∀ z ∈ U,
        f y = f z ↔ ∃ m : ℕ, m < orderOf k ∧ z = k ^ m • y := by
  obtain ⟨U, hU, hx, hlocal⟩ := RiemannRochTop_local_stabilizer hG x
  refine ⟨U, hU, hx, fun y hy z hz ↦ ⟨?_, ?_⟩⟩
  · intro h
    obtain ⟨g, hg⟩ := hgal.2 y z h
    have hfix : g ∈ MulAction.stabilizer G x := hlocal g y hy (hg ▸ hz)
    rw [← RiemannRochTop_rotGen_zpowers x k hk] at hfix
    obtain ⟨m, hm, heq⟩ := Finset.mem_image.mp (mem_zpowers_iff_mem_range_orderOf.mp hfix)
    exact ⟨m, Finset.mem_range.mp hm, by rw [heq]; exact hg.symm⟩
  · rintro ⟨m, _, rfl⟩
    exact (hgal.1 (k ^ m) y).symm

/-- RiemannRochTop: weighted cyclic averaging produces an equivariant coordinate function. -/
lemma RiemannRochTop_cyclic_average_equivariant {G : Type} [Group G] [MulAction G C]
    (k : G) (n : ℕ) (hkn : k ^ n = 1) (ζ : ℂ) (hζ : ζ ≠ 0) (hζn : ζ ^ n = 1)
    (φ : C → E) (y : C) :
    (∑ j ∈ Finset.range n, (ζ⁻¹) ^ j • φ (k ^ j • (k • y))) =
      ζ • ∑ j ∈ Finset.range n, (ζ⁻¹) ^ j • φ (k ^ j • y) := by
  let F : ℕ → E := fun j ↦ (ζ⁻¹) ^ j • φ (k ^ j • y)
  have hterm : ∀ j, (ζ⁻¹) ^ j • φ (k ^ j • (k • y)) = ζ • F (j + 1) := by
    intro j
    rw [show k ^ j • (k • y) = k ^ (j + 1) • y by rw [pow_succ, mul_smul]]
    simp only [F, smul_smul]
    congr 1
    rw [pow_succ]
    field_simp [hζ]
  have hlast : F n = F 0 := by
    simp only [F, inv_pow, hζn, inv_one, hkn, one_smul, pow_zero, one_pow]
  have hshift : (∑ j ∈ Finset.range n, F (j + 1)) = ∑ j ∈ Finset.range n, F j := by
    have h₁ := Finset.sum_range_succ F n
    have h₂ := Finset.sum_range_succ' F n
    rw [hlast] at h₁
    exact add_right_cancel (h₂.symm.trans h₁)
  simp_rw [hterm]
  rw [← Finset.smul_sum, hshift]

/-- RiemannRochTop: the normalized weighted coordinate average has identity derivative. -/
lemma RiemannRochTop_cyclic_average_derivative {G : Type} [Group G] [MulAction G C]
    (hE : Module.finrank ℂ E = 1)
    (hG : ∀ g : G, ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω (fun x : C ↦ g • x))
    (x : C) (k : G) (hk : k • x = x) (ζ : ℂ) (hζ : ζ ≠ 0)
    (hrot : b4cov_lam hE x k = ζ) (n : ℕ) (hn : 0 < n) :
    let φ := extChartAt 𝓘(ℂ, E) x
    HasStrictFDerivAt
      (fun z : E ↦ (n : ℂ)⁻¹ • ∑ j ∈ Finset.range n,
        (ζ⁻¹) ^ j • φ (k ^ j • φ.symm z))
      (ContinuousLinearMap.id ℂ E) (φ x) := by
  have : FiniteDimensional ℂ E := Module.finite_of_finrank_eq_succ hE
  have := FiniteDimensional.complete ℂ E
  dsimp only
  let φ := extChartAt 𝓘(ℂ, E) x
  have hpow : ∀ j : ℕ, k ^ j • x = x := by
    intro j
    induction j with
    | zero => simp only [pow_zero, one_smul]
    | succ j ih => rw [pow_succ, mul_smul, hk, ih]
  have hrotpow : ∀ j : ℕ, b4cov_lam hE x (k ^ j) = ζ ^ j := by
    intro j
    induction j with
    | zero => simpa only [pow_zero] using (b4cov_lam_one hE (G := G) x)
    | succ j ih => rw [pow_succ, b4cov_lam_mul hE hG x _ _ hk, ih, hrot, pow_succ]
  have hder : ∀ j : ℕ, b4cov_der E x (k ^ j) =
      ζ ^ j • ContinuousLinearMap.id ℂ E := by
    intro j
    ext v
    rw [b4cov_der_apply hE, hrotpow]
    rfl
  have hGj : ∀ j : ℕ, HasStrictFDerivAt
      (fun z : E ↦ (ζ⁻¹) ^ j • φ (k ^ j • φ.symm z))
      (ContinuousLinearMap.id ℂ E) (φ x) := by
    intro j
    have han := b4cov_analyticAt_chart (fun y : C ↦ k ^ j • y) (hG _) x x (φ x)
      (mem_extChartAt_target x) (by
        simp only [φ, extChartAt_to_inv, hpow]
        exact mem_extChartAt_source x)
    have hmd := ((hG (k ^ j)) x).mdifferentiableAt (by simp)
    have hab := hmd.mfderiv_abuse
    rw [modelWithCornersSelf_coe, range_id, fderivWithin_univ] at hab
    have hw : writtenInExtChartAt 𝓘(ℂ, E) 𝓘(ℂ, E) x (fun y : C ↦ k ^ j • y) =
        φ ∘ (fun y : C ↦ k ^ j • y) ∘ φ.symm := by
      simp only [writtenInExtChartAt, hpow, φ]
    rw [hw] at hab
    have hd : fderiv ℂ (φ ∘ (fun y : C ↦ k ^ j • y) ∘ φ.symm) (φ x) =
        ζ ^ j • ContinuousLinearMap.id ℂ E := by
      rw [← hab]
      exact hder j
    have hh := han.hasStrictFDerivAt.const_smul ((ζ⁻¹) ^ j)
    rw [hd, smul_smul, inv_pow, inv_mul_cancel₀ (pow_ne_zero j hζ), one_smul] at hh
    convert hh using 1
    funext z
    simp only [Pi.smul_apply, Function.comp_apply, inv_pow] <;> rfl
  have hsum := (HasStrictFDerivAt.sum (u := Finset.range n) fun j _ ↦ hGj j).const_smul
    ((n : ℂ)⁻¹)
  convert hsum using 1
  · funext z
    simp only [φ, Pi.smul_apply, Finset.sum_apply]
  · rw [Finset.sum_const, Finset.card_range, ← Nat.cast_smul_eq_nsmul ℂ, smul_smul,
      inv_mul_cancel₀ (Nat.cast_ne_zero.mpr hn.ne'), one_smul]

/-- RiemannRochTop: the weighted coordinate average is holomorphic at a fixed point. -/
lemma RiemannRochTop_cyclic_average_holomorphic {G : Type} [Group G] [MulAction G C]
    (hG : ∀ g : G, ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω (fun x : C ↦ g • x))
    (x : C) (k : G) (hk : k • x = x) (ζ : ℂ) (n : ℕ) :
    ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, E) ω
      (fun y : C ↦ (n : ℂ)⁻¹ •
        ∑ j ∈ Finset.range n, (ζ⁻¹) ^ j • (chartAt E x) (k ^ j • y)) x := by
  have hpow : ∀ j : ℕ, k ^ j • x = x := by
    intro j
    induction j with
    | zero => simp
    | succ j ih => simp only [pow_succ', mul_smul, ih, hk]
  have hj : ∀ j : ℕ, ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, E) ω
      (fun y : C ↦ (ζ⁻¹) ^ j • (chartAt E x) (k ^ j • y)) x := by
    intro j
    have hc : ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, E) ω (chartAt E x) (k ^ j • x) := by
      rw [hpow]
      exact contMDiffAt_of_mem_maximalAtlas (IsManifold.chart_mem_maximalAtlas x)
        (mem_chart_source E x)
    exact (contMDiffAt_const (I' := 𝓘(ℂ, ℂ))).smul (hc.comp x (hG (k ^ j) x))
  exact (contMDiffAt_const (I' := 𝓘(ℂ, ℂ))).smul
    (ContMDiffAt.sum (fun j (_ : j ∈ Finset.range n) ↦ hj j))

/-- RiemannRochTop: periodic holomorphic actions have biholomorphic rotation coordinates at fixed points. -/
lemma RiemannRochTop_local_biholomorphic_rotation_coordinates {G : Type} [Group G] [MulAction G C]
    (hE : Module.finrank ℂ E = 1)
    (hG : ∀ g : G, ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω (fun x : C ↦ g • x))
    (x : C) (k : G) (hk : k • x = x) (ζ : ℂ) (hζ : ζ ≠ 0)
    (hrot : b4cov_lam hE x k = ζ) (n : ℕ) (hn : 0 < n)
    (hkn : k ^ n = 1) (hζn : ζ ^ n = 1) :
    ∃ e : OpenPartialHomeomorph C E, x ∈ e.source ∧ e x = 0 ∧
      ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, E) ω e x ∧
      ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, E) ω e.symm 0 ∧
      ∀ᶠ y in 𝓝 x, e (k • y) = ζ • e y := by
  have : FiniteDimensional ℂ E := Module.finite_of_finrank_eq_succ hE
  have := FiniteDimensional.complete ℂ E
  let φ := chartAt E x
  let ψ : C → E := fun y ↦ (n : ℂ)⁻¹ •
    ∑ j ∈ Finset.range n, (ζ⁻¹) ^ j • φ (k ^ j • y)
  let Ψ : E → E := ψ ∘ φ.symm
  have hψ : ∀ y, ψ (k • y) = ζ • ψ y := by
    intro y
    change (n : ℂ)⁻¹ • _ = ζ • ((n : ℂ)⁻¹ • _)
    rw [RiemannRochTop_cyclic_average_equivariant k n hkn ζ hζ hζn φ y, smul_comm]
  have hψx : ψ x = ζ • ψ x := by simpa only [hk] using hψ x
  have hD : HasStrictFDerivAt Ψ
      ((ContinuousLinearEquiv.refl ℂ E : E ≃L[ℂ] E) : E →L[ℂ] E) (φ x) := by
    simpa only [ContinuousLinearEquiv.coe_refl, Ψ, ψ, φ, extChartAt_coe,
      extChartAt_coe_symm, modelWithCornersSelf_coe, modelWithCornersSelf_coe_symm,
      Function.comp_def, id_eq] using
      (RiemannRochTop_cyclic_average_derivative hE hG x k hk ζ hζ hrot n hn)
  let P := hD.toOpenPartialHomeomorph Ψ
  have hP : (P : E → E) = Ψ := hD.toOpenPartialHomeomorph_coe
  let e₀ := φ.trans P
  have hx₀ : x ∈ e₀.source :=
    ⟨mem_chart_source E x, hD.mem_toOpenPartialHomeomorph_source⟩
  have he₀ : ∀ y ∈ φ.source, e₀ y = ψ y := by
    intro y hy
    change P (φ y) = ψ y
    rw [hP]
    change ψ (φ.symm (φ y)) = ψ y
    rw [φ.left_inv hy]
  let e := e₀.trans (Homeomorph.addRight (-e₀ x)).toOpenPartialHomeomorph
  have he : ∀ y, e y = e₀ y + -e₀ x := fun _ ↦ rfl
  have hψhol : ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, E) ω ψ x :=
    RiemannRochTop_cyclic_average_holomorphic hG x k hk ζ n
  have hehol : ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, E) ω e x := by
    apply (hψhol.add (contMDiffAt_const (c := -ψ x))).congr_of_eventuallyEq
    filter_upwards [φ.open_source.mem_nhds (mem_chart_source E x)] with y hy
    rw [he, he₀ y hy, he₀ x (mem_chart_source E x)]
    rfl
  have hφsym : ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, E) ω φ.symm (φ x) :=
    contMDiffAt_symm_of_mem_maximalAtlas (IsManifold.chart_mem_maximalAtlas x)
      (φ.map_source (mem_chart_source E x))
  have hΨhol : ContDiffAt ℂ ω Ψ (φ x) := by
    have hψ' : ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, E) ω ψ (φ.symm (φ x)) := by
      rw [φ.left_inv (mem_chart_source E x)]
      exact hψhol
    exact (hψ'.comp (φ x) hφsym).contDiffAt
  have hPP : P.symm (P (φ x)) = φ x := P.left_inv hD.mem_toOpenPartialHomeomorph_source
  have hPinv : ContDiffAt ℂ ω P.symm (P (φ x)) := by
    apply P.contDiffAt_symm (f₀' := ContinuousLinearEquiv.refl ℂ E)
      (P.map_source hD.mem_toOpenPartialHomeomorph_source)
    · rw [hPP, hP]
      exact hD.hasFDerivAt
    · rw [hPP, hP]
      exact hΨhol
  have he₀inv : ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, E) ω e₀.symm (e₀ x) := by
    have hφ' : ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, E) ω φ.symm (P.symm (P (φ x))) := by
      rw [hPP]
      exact hφsym
    exact hφ'.comp (P (φ x)) hPinv.contMDiffAt
  have heinv : ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, E) ω e.symm 0 := by
    have ht : ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, E) ω (fun z : E ↦ z + e₀ x) 0 :=
      contMDiffAt_id.add contMDiffAt_const
    have hb : ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, E) ω e₀.symm (0 + e₀ x) := by
      simpa only [zero_add] using he₀inv
    convert hb.comp 0 ht using 1
    funext z
    change e₀.symm (z + - -e₀ x) = e₀.symm (z + e₀ x)
    rw [neg_neg]
  refine ⟨e, ⟨hx₀, Set.mem_univ _⟩, by rw [he, add_neg_cancel], hehol, heinv, ?_⟩
  have hnear : ∀ᶠ y in 𝓝 x, y ∈ φ.source := φ.open_source.mem_nhds (mem_chart_source E x)
  have hknear : ∀ᶠ y in 𝓝 x, k • y ∈ φ.source :=
    (hG k).continuous.continuousAt.preimage_mem_nhds (by rw [hk]; exact hnear)
  filter_upwards [hnear, hknear] with y hy hky
  rw [he, he, he₀ y hy, he₀ (k • y) hky, he₀ x (mem_chart_source E x), hψ,
    smul_add, smul_neg, ← hψx]

/-- RiemannRochTop: a periodic holomorphic group element has local rotation coordinates. -/
lemma RiemannRochTop_local_rotation_coordinates {G : Type} [Group G] [MulAction G C]
    (hE : Module.finrank ℂ E = 1)
    (hG : ∀ g : G, ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω (fun x : C ↦ g • x))
    (x : C) (k : G) (hk : k • x = x) (ζ : ℂ) (hζ : ζ ≠ 0)
    (hrot : b4cov_lam hE x k = ζ) (n : ℕ) (hn : 0 < n)
    (hkn : k ^ n = 1) (hζn : ζ ^ n = 1) :
    ∃ e : OpenPartialHomeomorph C E, x ∈ e.source ∧ e x = 0 ∧
      ∀ᶠ y in 𝓝 x, e (k • y) = ζ • e y := by
  obtain ⟨e, hx, he, _, _, hlocal⟩ :=
    RiemannRochTop_local_biholomorphic_rotation_coordinates hE hG x k hk ζ hζ hrot n hn hkn hζn
  exact ⟨e, hx, he, hlocal⟩

/-- RiemannRochTop: local rotation coordinates intertwine the inverse chart on a small ball. -/
lemma RiemannRochTop_inverse_rotation_ball {G : Type} [Group G] [MulAction G C]
    (e : OpenPartialHomeomorph C E) (x : C) (hx : x ∈ e.source) (he : e x = 0)
    (k : G) (hk : k • x = x) (hcont : Continuous (fun y : C ↦ k • y)) (ζ : ℂ)
    (hrot : ∀ᶠ y in 𝓝 x, e (k • y) = ζ • e y) :
    ∃ ε : ℝ, 0 < ε ∧ Metric.ball (0 : E) ε ⊆ e.target ∧
      ∀ z ∈ Metric.ball (0 : E) ε, e.symm (ζ • z) = k • e.symm z := by
  have hz : (0 : E) ∈ e.target := he ▸ e.map_source hx
  have hinv : e.symm (0 : E) = x := by rw [← he, e.left_inv hx]
  have hc := e.continuousAt_symm hz
  have hc' : Tendsto e.symm (𝓝 (0 : E)) (𝓝 x) := by
    simpa only [hinv] using hc.tendsto
  have h₁ : ∀ᶠ z in 𝓝 (0 : E), z ∈ e.target := e.open_target.mem_nhds hz
  have h₂ : ∀ᶠ z in 𝓝 (0 : E), e (k • e.symm z) = ζ • e (e.symm z) :=
    hc'.eventually hrot
  have h₃ : ∀ᶠ z in 𝓝 (0 : E), k • e.symm z ∈ e.source :=
    (hcont.continuousAt.comp hc).preimage_mem_nhds
      (by rw [Function.comp_apply, hinv, hk]; exact e.open_source.mem_nhds hx)
  have hall : ∀ᶠ z in 𝓝 (0 : E), z ∈ e.target ∧ e.symm (ζ • z) = k • e.symm z := by
    filter_upwards [h₁, h₂, h₃] with z hz hzrot hzsrc
    refine ⟨hz, ?_⟩
    rw [e.right_inv hz] at hzrot
    rw [← hzrot, e.left_inv hzsrc]
  obtain ⟨ε, hε, hall⟩ := Metric.eventually_nhds_iff_ball.mp hall
  exact ⟨ε, hε, fun z hz ↦ (hall z hz).1, fun z hz ↦ (hall z hz).2⟩

/-- RiemannRochTop: inverse rotation coordinates intertwine all powers on the same ball. -/
lemma RiemannRochTop_inverse_rotation_pow {G : Type} [Group G] [MulAction G C]
    (e : OpenPartialHomeomorph C E) (k : G) (ζ : ℂ) (hζ : ‖ζ‖ = 1) (ε : ℝ)
    (hrot : ∀ z ∈ Metric.ball (0 : E) ε, e.symm (ζ • z) = k • e.symm z)
    (m : ℕ) (z : E) (hz : z ∈ Metric.ball (0 : E) ε) :
    e.symm (ζ ^ m • z) = k ^ m • e.symm z := by
  induction m with
  | zero => simp
  | succ m ih =>
    have hz' : ζ ^ m • z ∈ Metric.ball (0 : E) ε := by
      simpa only [Metric.mem_ball, dist_zero_right, norm_smul, norm_pow, hζ,
        one_pow, one_mul] using hz
    simpa only [pow_succ', mul_smul] using
      (hrot (ζ ^ m • z) hz').trans (congrArg (fun y : C ↦ k • y) ih)

/-- RiemannRochTop: a circular coordinate arc lifts to a path with the specified rotation endpoint. -/
lemma RiemannRochTop_rotation_arc {G : Type} [Group G] [MulAction G C]
    (e : OpenPartialHomeomorph C E) (x : C) (he : e x = 0) (k : G) (θ ε : ℝ)
    (hball : Metric.ball (0 : E) ε ⊆ e.target)
    (hrot : ∀ z ∈ Metric.ball (0 : E) ε,
      e.symm (Complex.exp (θ * Complex.I) • z) = k • e.symm z)
    (v : E) (hv : v ∈ Metric.ball (0 : E) ε) (hv0 : v ≠ 0) :
    ∃ Γ : C(unitInterval, C), Γ 0 = e.symm v ∧ Γ 1 = k • Γ 0 ∧
      ∀ t, Γ t ∈ e.source ∧ Γ t ≠ x := by
  let q : unitInterval → E := fun t ↦
    Complex.exp (((t : ℝ) * θ : ℝ) * Complex.I) • v
  have hq : Continuous q := by fun_prop
  have hnorm : ∀ t, ‖q t‖ = ‖v‖ := by
    intro t
    simp only [q, norm_smul, Complex.norm_exp_ofReal_mul_I, one_mul]
  have hqb : ∀ t, q t ∈ Metric.ball (0 : E) ε := by
    intro t
    simpa only [Metric.mem_ball, dist_zero_right, hnorm t] using hv
  have hqc : Continuous (e.symm ∘ q) :=
    e.continuousOn_invFun.comp_continuous hq (fun t ↦ hball (hqb t))
  let Γ : C(unitInterval, C) := ⟨e.symm ∘ q, hqc⟩
  have hzero : Γ 0 = e.symm v := by
    change e.symm (q 0) = e.symm v
    simp [q]
  refine ⟨Γ, hzero, ?_, fun t ↦ ⟨e.map_target (hball (hqb t)), ?_⟩⟩
  · rw [hzero]
    change e.symm (q 1) = k • e.symm v
    simpa [q] using hrot v hv
  · intro ht
    have hz : q t = 0 := by
      calc
        q t = e (e.symm (q t)) := (e.right_inv (hball (hqb t))).symm
        _ = e x := congrArg e ht
        _ = 0 := he
    have hnonzero : q t ≠ 0 := smul_ne_zero (Complex.exp_ne_zero _) hv0
    exact hnonzero hz

/-- RiemannRochTop: a stabilizer rotation generator acts by its primitive root in inverse coordinates. -/
lemma RiemannRochTop_rotGen_coordinates {G : Type} [Group G] [Finite G] [MulAction G C]
    (hE : Module.finrank ℂ E = 1)
    (hG : ∀ g : G, ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω (fun x : C ↦ g • x))
    (x : C) (k : G) (hk : b4_IsRotGen E x k) :
    ∃ e : OpenPartialHomeomorph C E, x ∈ e.source ∧ e x = 0 ∧
      ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, E) ω e x ∧
      ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, E) ω e.symm 0 ∧
      ∃ ε : ℝ, 0 < ε ∧ Metric.ball (0 : E) ε ⊆ e.target ∧
        ∀ z ∈ Metric.ball (0 : E) ε,
          e.symm (Complex.exp (2 * Real.pi * Complex.I / (orderOf k : ℂ)) • z) =
            k • e.symm z := by
  let ζ : ℂ := Complex.exp (2 * Real.pi * Complex.I / (orderOf k : ℂ))
  have hn : 0 < orderOf k := orderOf_pos k
  have hζ : ζ ≠ 0 := Complex.exp_ne_zero _
  have hζn : ζ ^ orderOf k = 1 := (Complex.isPrimitiveRoot_exp (orderOf k) hn.ne').pow_eq_one
  have hrot : b4cov_lam hE x k = ζ := b4cov_lam_eq_of_apply hE x k ζ hk.2.2
  obtain ⟨e, hx, he, hehol, heinv, hlocal⟩ :=
    RiemannRochTop_local_biholomorphic_rotation_coordinates hE hG x k hk.1
    ζ hζ hrot (orderOf k) hn (pow_orderOf_eq_one k) hζn
  exact ⟨e, hx, he, hehol, heinv, RiemannRochTop_inverse_rotation_ball e x hx he k hk.1
    (hG k).continuous ζ hlocal⟩

/-- RiemannRochTop: local fibers in rotation coordinates are precisely root-of-unity orbits. -/
lemma RiemannRochTop_rotGen_coordinate_fibers [T2Space C]
    {G : Type} [Group G] [Finite G] [MulAction G C]
    (hE : Module.finrank ℂ E = 1)
    (hG : ∀ g : G, ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω (fun x : C ↦ g • x))
    {Y : Type} (f : C → Y) (hgal : b4_IsGaloisCover G f)
    (x : C) (k : G) (hk : b4_IsRotGen E x k) :
    ∃ e : OpenPartialHomeomorph C E, x ∈ e.source ∧ e x = 0 ∧
      ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, E) ω e x ∧
      ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, E) ω e.symm 0 ∧
      (∀ᶠ z in 𝓝 (0 : E),
        e.symm (Complex.exp (2 * Real.pi * Complex.I / (orderOf k : ℂ)) • z) = k • e.symm z) ∧
      ∃ ε : ℝ, 0 < ε ∧ Metric.ball (0 : E) ε ⊆ e.target ∧
        ∀ v ∈ Metric.ball (0 : E) ε, ∀ w ∈ Metric.ball (0 : E) ε,
          f (e.symm v) = f (e.symm w) ↔
            ∃ m : ℕ, m < orderOf k ∧
              w = Complex.exp (2 * Real.pi * Complex.I / (orderOf k : ℂ)) ^ m • v := by
  obtain ⟨U, hU, hxU, hfib⟩ :=
    RiemannRochTop_local_cyclic_fibers (fun g ↦ (hG g).continuous) f hgal x k hk
  obtain ⟨e, hx, he, hehol, heinv, ε, hε, _, hrot⟩ :=
    RiemannRochTop_rotGen_coordinates hE hG x k hk
  let d := e.restrOpen U hU
  have hxd : x ∈ d.source := ⟨hx, hxU⟩
  have hd : d x = 0 := he
  have hz : (0 : E) ∈ d.target := hd ▸ d.map_source hxd
  obtain ⟨δ, hδ, hδball⟩ := Metric.isOpen_iff.mp d.open_target 0 hz
  let ζ : ℂ := Complex.exp (2 * Real.pi * Complex.I / (orderOf k : ℂ))
  have hζ : ‖ζ‖ = 1 := Complex.norm_eq_one_of_pow_eq_one
    (Complex.isPrimitiveRoot_exp (orderOf k) (orderOf_pos k).ne').pow_eq_one (orderOf_pos k).ne'
  have hball : Metric.ball (0 : E) (min ε δ) ⊆ d.target :=
    (Metric.ball_subset_ball (min_le_right ε δ)).trans hδball
  have hdrot : ∀ z ∈ Metric.ball (0 : E) (min ε δ), d.symm (ζ • z) = k • d.symm z := by
    intro z hz
    simpa only [d, OpenPartialHomeomorph.coe_restrOpen_symm] using
      hrot z (Metric.ball_subset_ball (min_le_left ε δ) hz)
  have hpow := RiemannRochTop_inverse_rotation_pow d k ζ hζ (min ε δ) hdrot
  have hdhol : ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, E) ω d x := by
    simpa only [d, OpenPartialHomeomorph.coe_restrOpen] using hehol
  have hdinv : ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, E) ω d.symm 0 := by
    simpa only [d, OpenPartialHomeomorph.coe_restrOpen_symm] using heinv
  have hdnear : ∀ᶠ z in 𝓝 (0 : E), d.symm (ζ • z) = k • d.symm z := by
    filter_upwards [Metric.ball_mem_nhds (0 : E) (lt_min hε hδ)] with z hz
    exact hdrot z hz
  refine ⟨d, hxd, hd, hdhol, hdinv, hdnear, min ε δ, lt_min hε hδ, hball, ?_⟩
  intro v hv w hw
  constructor
  · intro h
    obtain ⟨m, hm, heq⟩ := (hfib _ (d.map_target (hball hv)).2
      _ (d.map_target (hball hw)).2).mp h
    have hmv : ζ ^ m • v ∈ Metric.ball (0 : E) (min ε δ) := by
      simpa only [Metric.mem_ball, dist_zero_right, norm_smul, norm_pow, hζ,
        one_pow, one_mul] using hv
    refine ⟨m, hm, ?_⟩
    have hi : d.symm w = d.symm (ζ ^ m • v) := heq.trans (hpow m v hv).symm
    simpa only [d.right_inv (hball hw), d.right_inv (hball hmv)] using congrArg d hi
  · rintro ⟨m, _, rfl⟩
    rw [hpow m v hv]
    exact (hgal.1 (k ^ m) (d.symm v)).symm

/-- RiemannRochTop: fibers of a power map are orbits of a primitive root. -/
lemma RiemannRochTop_power_fibers (n : ℕ) (hn : 0 < n) (ζ : ℂ)
    (hζ : IsPrimitiveRoot ζ n) (v w : ℂ) :
    v ^ n = w ^ n ↔ ∃ m : ℕ, m < n ∧ w = ζ ^ m * v := by
  letI : NeZero n := ⟨hn.ne'⟩
  constructor
  · intro h
    by_cases hv : v = 0
    · have hw : w = 0 := by
        by_contra hw
        apply pow_ne_zero n hw
        rw [← h, hv, zero_pow hn.ne']
      exact ⟨0, hn, by simp [hv, hw]⟩
    · have hratio : (w / v) ^ n = 1 := by
        rw [div_pow, ← h, div_self (pow_ne_zero _ hv)]
      obtain ⟨m, hm, heq⟩ := hζ.eq_pow_of_pow_eq_one hratio
      exact ⟨m, hm, by rw [heq, div_mul_cancel₀ _ hv]⟩
  · rintro ⟨m, _, rfl⟩
    rw [mul_pow, ← pow_mul, Nat.mul_comm m n, pow_mul, hζ.pow_eq_one, one_pow, one_mul]

/-- RiemannRochTop: in a complex coordinate disk, Galois fibers coincide with power-map fibers. -/
lemma RiemannRochTop_local_power_fibers [T2Space C]
    {G : Type} [Group G] [Finite G] [MulAction G C]
    (hE : Module.finrank ℂ E = 1)
    (hG : ∀ g : G, ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω (fun x : C ↦ g • x))
    {Y : Type} (f : C → Y) (hgal : b4_IsGaloisCover G f)
    (x : C) (k : G) (hk : b4_IsRotGen E x k) :
    ∃ e : OpenPartialHomeomorph C ℂ, x ∈ e.source ∧ e x = 0 ∧
      ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω e x ∧
      ContMDiffAt 𝓘(ℂ, ℂ) 𝓘(ℂ, E) ω e.symm 0 ∧
      (∀ᶠ z in 𝓝 (0 : ℂ),
        e.symm (Complex.exp (2 * Real.pi * Complex.I / (orderOf k : ℂ)) * z) = k • e.symm z) ∧
      ∃ ε : ℝ, 0 < ε ∧ Metric.ball (0 : ℂ) ε ⊆ e.target ∧
        ∀ v ∈ Metric.ball (0 : ℂ) ε, ∀ w ∈ Metric.ball (0 : ℂ) ε,
          f (e.symm v) = f (e.symm w) ↔ v ^ orderOf k = w ^ orderOf k := by
  obtain ⟨e, hx, he, hehol, heinv, hrot, ε, hε, hball, hfib⟩ :=
    RiemannRochTop_rotGen_coordinate_fibers hE hG f hgal x k hk
  let L := b4cov_lineEquiv hE
  let d := e.trans L.symm.toHomeomorph.toOpenPartialHomeomorph
  have hnear : ∀ᶠ z in 𝓝 (0 : ℂ), L z ∈ Metric.ball (0 : E) ε :=
    L.continuous.continuousAt.preimage_mem_nhds (by simpa using Metric.ball_mem_nhds (0 : E) hε)
  obtain ⟨δ, hδ, hδball⟩ := Metric.eventually_nhds_iff_ball.mp hnear
  have hxd : x ∈ d.source := ⟨hx, Set.mem_univ _⟩
  have hd : d x = 0 := by change L.symm (e x) = 0; rw [he, map_zero]
  have hdhol : ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω d x :=
    L.symm.contDiff.contDiffAt.contMDiffAt.comp x hehol
  have hdinv : ContMDiffAt 𝓘(ℂ, ℂ) 𝓘(ℂ, E) ω d.symm 0 := by
    have hi : ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, E) ω e.symm (L (0 : ℂ)) := by
      simpa only [map_zero] using heinv
    exact hi.comp 0 L.contDiff.contDiffAt.contMDiffAt
  have hL : Tendsto L (𝓝 (0 : ℂ)) (𝓝 (0 : E)) := by
    simpa only [map_zero] using L.continuous.tendsto (0 : ℂ)
  have hdrot : ∀ᶠ z in 𝓝 (0 : ℂ),
      d.symm (Complex.exp (2 * Real.pi * Complex.I / (orderOf k : ℂ)) * z) = k • d.symm z := by
    filter_upwards [hL.eventually hrot] with z hz
    change e.symm (L (Complex.exp (2 * Real.pi * Complex.I / (orderOf k : ℂ)) • z)) =
      k • e.symm (L z)
    rw [map_smul]
    exact hz
  refine ⟨d, hxd, hd, hdhol, hdinv, hdrot, δ, hδ, ?_, ?_⟩
  · intro z hz
    exact ⟨Set.mem_univ _, hball (hδball z hz)⟩
  · intro v hv w hw
    change f (e.symm (L v)) = f (e.symm (L w)) ↔ v ^ orderOf k = w ^ orderOf k
    rw [hfib _ (hδball v hv) _ (hδball w hw)]
    let ζ : ℂ := Complex.exp (2 * Real.pi * Complex.I / (orderOf k : ℂ))
    have hroot := Complex.isPrimitiveRoot_exp (orderOf k) (orderOf_pos k).ne'
    constructor
    · rintro ⟨m, hm, heq⟩
      apply (RiemannRochTop_power_fibers (orderOf k) (orderOf_pos k) ζ hroot v w).mpr
      refine ⟨m, hm, L.injective ?_⟩
      change L w = L (ζ ^ m • v)
      rw [map_smul]
      exact heq
    · intro h
      obtain ⟨m, hm, heq⟩ :=
        (RiemannRochTop_power_fibers (orderOf k) (orderOf_pos k) ζ hroot v w).mp h
      refine ⟨m, hm, ?_⟩
      change L w = ζ ^ m • L v
      rw [← map_smul]
      exact congrArg L heq

/-- RiemannRochTop: analyticity descends through a positive complex power at the origin. -/
lemma RiemannRochTop_analytic_descends_power
    {F : Type} [NormedAddCommGroup F] [NormedSpace ℂ F] [CompleteSpace F]
    (f : ℂ → F) (n : ℕ) (hn : 0 < n)
    (hc : ContinuousAt f 0) (ha : AnalyticAt ℂ (fun z : ℂ ↦ f (z ^ n)) 0) :
    AnalyticAt ℂ f 0 := by
  obtain ⟨ε, hε, hball⟩ := Metric.eventually_nhds_iff_ball.mp ha.eventually_analyticAt
  apply Complex.analyticAt_of_differentiable_on_punctured_nhds_of_continuousAt _ hc
  have hnear : ∀ᶠ w in 𝓝 (0 : ℂ), w ∈ Metric.ball 0 (ε ^ n) :=
    Metric.ball_mem_nhds _ (pow_pos hε n)
  filter_upwards [nhdsWithin_le_nhds hnear, self_mem_nhdsWithin] with w hw hwn
  have hw0 : w ≠ 0 := hwn
  obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq w hn
  have hz0 : z ≠ 0 := by
    intro h
    apply hw0
    rw [← hz, h, zero_pow hn.ne']
  have hzball : z ∈ Metric.ball (0 : ℂ) ε := by
    have hp : ‖z‖ ^ n < ε ^ n := by
      rw [← norm_pow, hz]
      simpa only [Metric.mem_ball, dist_zero_right] using hw
    simpa only [Metric.mem_ball, dist_zero_right] using
      (pow_lt_pow_iff_left₀ (norm_nonneg z) hε.le hn.ne').mp hp
  have hd : deriv (fun z : ℂ ↦ z ^ n) z ≠ 0 := by
    rw [deriv_pow_field]
    exact mul_ne_zero (Nat.cast_ne_zero.mpr hn.ne') (pow_ne_zero _ hz0)
  have hf : AnalyticAt ℂ f (z ^ n) :=
    (analyticAt_comp_iff_of_deriv_ne_zero (analyticAt_id.pow n) hd).mp (hball z hzball)
  rw [hz] at hf
  exact hf.differentiableAt

/-- RiemannRochTop: a nonconstant analytic germ has no critical points sufficiently near its center. -/
lemma RiemannRochTop_deriv_punctured_ne_zero (f : ℂ → ℂ) (x : ℂ)
    (ha : AnalyticAt ℂ f x) (hn : ¬ ∀ᶠ z in 𝓝 x, f z = f x) :
    ∀ᶠ z in 𝓝[≠] x, deriv f z ≠ 0 := by
  rcases ha.deriv.eventually_eq_zero_or_eventually_ne_zero with hzero | hne
  · exfalso
    apply hn
    obtain ⟨r, hr, hball⟩ := Metric.eventually_nhds_iff_ball.mp
      (ha.eventually_analyticAt.and hzero)
    have hd : DifferentiableOn ℂ f (Metric.ball x r) :=
      fun z hz ↦ (hball z hz).1.differentiableAt.differentiableWithinAt
    have hz : (Metric.ball x r).EqOn (deriv f) 0 := fun z hz ↦ (hball z hz).2
    filter_upwards [Metric.ball_mem_nhds x hr] with z hz'
    exact Metric.isOpen_ball.is_const_of_deriv_eq_zero (convex_ball x r).isPreconnected
      hd hz hz' (Metric.mem_ball_self hr)
  · exact hne

/-- RiemannRochTop: a holomorphic local homeomorphism has a holomorphic inverse germ. -/
lemma RiemannRochTop_analytic_local_homeomorph_inverse
    (e : OpenPartialHomeomorph ℂ ℂ) (x : ℂ) (hx : x ∈ e.source)
    (ha : AnalyticAt ℂ e x) : AnalyticAt ℂ e.symm (e x) := by
  have hn : ¬ ∀ᶠ z in 𝓝 x, e z = e x := by
    intro h
    have hfalse : ∀ᶠ z in 𝓝[≠] x, False := by
      filter_upwards [nhdsWithin_le_nhds h,
        nhdsWithin_le_nhds (e.open_source.mem_nhds hx), self_mem_nhdsWithin] with z hz hs hne
      exact hne (e.injOn hs hx hz)
    obtain ⟨z, hz⟩ := hfalse.exists
    exact hz
  have ht : Tendsto e.symm (𝓝[≠] (e x)) (𝓝[≠] x) := by
    apply tendsto_nhdsWithin_iff.mpr
    refine ⟨(e.tendsto_symm hx).mono_left nhdsWithin_le_nhds, ?_⟩
    filter_upwards [self_mem_nhdsWithin,
      nhdsWithin_le_nhds (e.open_target.mem_nhds (e.map_source hx))] with y hy hyt
    change e.symm y ≠ x
    intro heq
    apply hy
    rw [← e.right_inv hyt, heq]
    exact Set.mem_singleton _
  apply Complex.analyticAt_of_differentiable_on_punctured_nhds_of_continuousAt _
    (e.continuousAt_symm (e.map_source hx))
  have hd := ht.eventually (RiemannRochTop_deriv_punctured_ne_zero e x ha hn)
  have hanalytic := ht.eventually (nhdsWithin_le_nhds ha.eventually_analyticAt)
  filter_upwards [hd, hanalytic,
    nhdsWithin_le_nhds (e.open_target.mem_nhds (e.map_source hx))] with y hdy hay hyt
  have hcomp : AnalyticAt ℂ (e.symm ∘ e) (e.symm y) := by
    apply analyticAt_id.congr
    filter_upwards [e.open_source.mem_nhds (e.map_target hyt)] with z hz
    exact (e.left_inv hz).symm
  have hinv := (analyticAt_comp_iff_of_deriv_ne_zero hay hdy).mp hcomp
  rw [e.right_inv hyt] at hinv
  exact hinv.differentiableAt

/-- RiemannRochTop: an analytic local homeomorphism has nonzero complex derivative. -/
lemma RiemannRochTop_local_homeomorph_deriv_ne_zero
    (e : OpenPartialHomeomorph ℂ ℂ) (x : ℂ) (hx : x ∈ e.source)
    (ha : AnalyticAt ℂ e x) : deriv e x ≠ 0 := by
  have hi := RiemannRochTop_analytic_local_homeomorph_inverse e x hx ha
  have hd := hi.differentiableAt.hasDerivAt.comp x ha.differentiableAt.hasDerivAt
  have hid : HasDerivAt (e.symm ∘ e) 1 x :=
    (hasDerivAt_id x).congr_of_eventuallyEq (e.eventually_left_inverse hx)
  have hm := hd.unique hid
  intro hzero
  simp only [hzero, mul_zero, zero_ne_one] at hm

/-- RiemannRochTop: an injective analytic germ defines a local homeomorphism. -/
lemma RiemannRochTop_injective_analytic_local_homeomorph
    (f : ℂ → ℂ) (x : ℂ) (ha : AnalyticAt ℂ f x)
    (s : Set ℂ) (hs : s ∈ 𝓝 x) (hi : Set.InjOn f s) :
    ∃ e : OpenPartialHomeomorph ℂ ℂ, x ∈ e.source ∧ (e : ℂ → ℂ) = f := by
  obtain ⟨r, hr, hball⟩ := Metric.eventually_nhds_iff_ball.mp
    (ha.eventually_analyticAt.and hs)
  have hia : Set.InjOn f (Metric.ball x r) := hi.mono (fun z hz ↦ (hball z hz).2)
  have haa : AnalyticOnNhd ℂ f (Metric.ball x r) := fun z hz ↦ (hball z hz).1
  have hopen : ∀ u ⊆ Metric.ball x r, IsOpen u → IsOpen (f '' u) := by
    rcases haa.is_constant_or_isOpen (convex_ball x r).isPreconnected with hc | ho
    · obtain ⟨c, hc⟩ := hc
      have hfalse : ∀ᶠ z in 𝓝[≠] x, False := by
        filter_upwards [nhdsWithin_le_nhds (Metric.ball_mem_nhds x hr),
          self_mem_nhdsWithin] with z hz hne
        exact hne (hia hz (Metric.mem_ball_self hr)
          ((hc z hz).trans (hc x (Metric.mem_ball_self hr)).symm))
      obtain ⟨z, hz⟩ := hfalse.exists
      exact hz.elim
    · exact ho
  let p : PartialEquiv ℂ ℂ := hia.toPartialEquiv f (Metric.ball x r)
  have hp : IsOpenMap (p.source.domRestrict p) := by
    change IsOpenMap (fun z : ↥(Metric.ball x r) ↦ f (z : ℂ))
    intro u hu
    change IsOpen ((fun z : ↥(Metric.ball x r) ↦ f (z : ℂ)) '' u)
    rw [← Set.image_image]
    apply hopen _ ?_ (Metric.isOpen_ball.isOpenMap_subtype_val u hu)
    rintro z ⟨w, hw, rfl⟩
    exact w.property
  exact ⟨OpenPartialHomeomorph.ofContinuousOpenRestrict p haa.continuousOn hp
    Metric.isOpen_ball, Metric.mem_ball_self hr, rfl⟩

/-- RiemannRochTop: injective holomorphic germs into complex curves give biholomorphic coordinates. -/
lemma RiemannRochTop_injective_holomorphic_coordinates
    {Y : Type} [TopologicalSpace Y] [ChartedSpace ℂ Y] [IsManifold 𝓘(ℂ, ℂ) ω Y]
    (q : ℂ → Y) (x : ℂ) (hq : ContMDiffAt 𝓘(ℂ, ℂ) 𝓘(ℂ, ℂ) ω q x)
    (s : Set ℂ) (hs : s ∈ 𝓝 x) (hi : Set.InjOn q s) :
    ∃ e : OpenPartialHomeomorph ℂ Y, x ∈ e.source ∧ e x = q x ∧
      (e : ℂ → Y) =ᶠ[𝓝 x] q ∧
      ContMDiffAt 𝓘(ℂ, ℂ) 𝓘(ℂ, ℂ) ω e x ∧
      ContMDiffAt 𝓘(ℂ, ℂ) 𝓘(ℂ, ℂ) ω e.symm (q x) := by
  let φ := chartAt ℂ (q x)
  have hx : q x ∈ φ.source := mem_chart_source ℂ (q x)
  have hφ : ContMDiffAt 𝓘(ℂ, ℂ) 𝓘(ℂ, ℂ) ω φ (q x) :=
    contMDiffAt_of_mem_maximalAtlas (IsManifold.chart_mem_maximalAtlas (q x)) hx
  have ha : AnalyticAt ℂ (φ ∘ q) x := (hφ.comp x hq).contDiffAt.analyticAt
  have hsource : ∀ᶠ z in 𝓝 x, q z ∈ φ.source :=
    hq.continuousAt (φ.open_source.mem_nhds hx)
  have hU : s ∩ q ⁻¹' φ.source ∈ 𝓝 x := inter_mem hs hsource
  have hiU : Set.InjOn (φ ∘ q) (s ∩ q ⁻¹' φ.source) := by
    intro a ha b hb hab
    exact hi ha.1 hb.1 (φ.injOn ha.2 hb.2 hab)
  obtain ⟨d, hdx, hd⟩ := RiemannRochTop_injective_analytic_local_homeomorph
    (φ ∘ q) x ha _ hU hiU
  let e := d.trans φ.symm
  have hemem : x ∈ e.source := by
    refine ⟨hdx, ?_⟩
    change d x ∈ φ.target
    rw [hd]
    exact φ.map_source hx
  have heq : (e : ℂ → Y) =ᶠ[𝓝 x] q := by
    filter_upwards [hsource] with z hz
    change φ.symm (d z) = q z
    rw [hd]
    exact φ.left_inv hz
  have hda : AnalyticAt ℂ d x := by rw [hd]; exact ha
  have hdi : ContMDiffAt 𝓘(ℂ, ℂ) 𝓘(ℂ, ℂ) ω d.symm (φ (q x)) := by
    have h : ContMDiffAt 𝓘(ℂ, ℂ) 𝓘(ℂ, ℂ) ω d.symm (d x) :=
      (RiemannRochTop_analytic_local_homeomorph_inverse d x hdx hda).contDiffAt.contMDiffAt
    simpa only [hd, Function.comp_apply] using h
  refine ⟨e, hemem, heq.eq_of_nhds, heq, hq.congr_of_eventuallyEq heq, ?_⟩
  exact hdi.comp (q x) hφ

/-- RiemannRochTop: deformation to a nonzero complex derivative avoids the origin locally. -/
lemma RiemannRochTop_linear_deformation_ne_zero
    (f : ℂ → ℂ) (a : ℂ) (hf : HasDerivAt f a 0) (hf0 : f 0 = 0) (ha : a ≠ 0) :
    ∀ᶠ z in 𝓝 (0 : ℂ), ∀ t ∈ Set.Icc (0 : ℝ) 1, z ≠ 0 →
      (1 - t) • (a * z) + t • f z ≠ 0 := by
  have hb : ∀ᶠ z in 𝓝 (0 : ℂ), ‖f z - a * z‖ ≤ (‖a‖ / 2) * ‖z‖ := by
    simpa only [hf0, sub_zero, smul_eq_mul, mul_comm] using
      hf.isLittleO.bound (half_pos (norm_pos_iff.mpr ha))
  filter_upwards [hb] with z hz
  intro t ht hz0 hzero
  have hbound : ‖t • (f z - a * z)‖ ≤ (‖a‖ / 2) * ‖z‖ := by
    calc
      ‖t • (f z - a * z)‖ = t * ‖f z - a * z‖ := by
        rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg ht.1]
      _ ≤ 1 * ‖f z - a * z‖ := mul_le_mul_of_nonneg_right ht.2 (norm_nonneg _)
      _ ≤ (‖a‖ / 2) * ‖z‖ := by simpa only [one_mul] using hz
  have hform : (1 - t) • (a * z) + t • f z = a * z + t • (f z - a * z) := by
    module
  have heq : a * z = -(t • (f z - a * z)) :=
    eq_neg_of_add_eq_zero_left (hform.symm.trans hzero)
  have hnorm : ‖a‖ * ‖z‖ ≤ (‖a‖ / 2) * ‖z‖ := by
    rw [← norm_mul, heq, norm_neg]
    exact hbound
  have hpos : 0 < ‖a‖ * ‖z‖ := mul_pos (norm_pos_iff.mpr ha) (norm_pos_iff.mpr hz0)
  nlinarith

/-- RiemannRochTop: a regular analytic germ deforms to its derivative on a punctured disk. -/
lemma RiemannRochTop_punctured_disk_linear_deformation
    (f : ℂ → ℂ) (hf : AnalyticAt ℂ f 0) (hf0 : f 0 = 0) (hd : deriv f 0 ≠ 0) :
    ∃ r : ℝ, 0 < r ∧
      ∃ H : C(unitInterval × {z : ℂ // ‖z‖ < r ∧ z ≠ 0}, {z : ℂ // z ≠ 0}),
        ∀ z : {z : ℂ // ‖z‖ < r ∧ z ≠ 0},
          (H (0, z) : ℂ) = deriv f 0 * z ∧ (H (1, z) : ℂ) = f z := by
  obtain ⟨r, hr, hball⟩ := Metric.eventually_nhds_iff_ball.mp
    (hf.eventually_analyticAt.and
      (RiemannRochTop_linear_deformation_ne_zero f (deriv f 0)
        hf.differentiableAt.hasDerivAt hf0 hd))
  let U := {z : ℂ // ‖z‖ < r ∧ z ≠ 0}
  have hU : ∀ z : U, (z : ℂ) ∈ Metric.ball 0 r := by
    intro z
    simpa only [Metric.mem_ball, dist_zero_right] using z.property.1
  have hc : Continuous (fun z : U ↦ f z) := by
    have hfc : ContinuousOn f (Metric.ball 0 r) :=
      fun z hz ↦ (hball z hz).1.continuousAt.continuousWithinAt
    exact hfc.comp_continuous continuous_subtype_val hU
  let H : C(unitInterval × U, {z : ℂ // z ≠ 0}) :=
    ⟨fun p ↦ ⟨(1 - (p.1 : ℝ)) • (deriv f 0 * (p.2 : ℂ)) + (p.1 : ℝ) • f p.2,
      (hball p.2 (hU p.2)).2 p.1 p.1.property p.2.property.2⟩, by
        apply Continuous.subtype_mk
        exact ((continuous_const.sub (continuous_subtype_val.comp continuous_fst)).smul
          (continuous_const.mul (continuous_subtype_val.comp continuous_snd))).add
          ((continuous_subtype_val.comp continuous_fst).smul (hc.comp continuous_snd))⟩
  refine ⟨r, hr, H, ?_⟩
  intro z
  constructor <;> simp [H]

/-- RiemannRochTop: multiplication by a nonzero complex scalar deforms to the identity off zero. -/
lemma RiemannRochTop_scalar_deformation (a : ℂ) (ha : a ≠ 0) :
    ∃ H : C(unitInterval × {z : ℂ // z ≠ 0}, {z : ℂ // z ≠ 0}),
      ∀ z : {z : ℂ // z ≠ 0}, (H (0, z) : ℂ) = z ∧ (H (1, z) : ℂ) = a * z := by
  let H : C(unitInterval × {z : ℂ // z ≠ 0}, {z : ℂ // z ≠ 0}) :=
    ⟨fun p ↦ ⟨Complex.exp ((p.1 : ℝ) * Complex.log a) * (p.2 : ℂ),
      mul_ne_zero (Complex.exp_ne_zero _) p.2.property⟩, by
        apply Continuous.subtype_mk
        fun_prop⟩
  refine ⟨H, ?_⟩
  intro z
  constructor <;> simp [H, Complex.exp_log ha]

/-- RiemannRochTop: a regular analytic germ is homotopic to inclusion on a punctured disk. -/
lemma RiemannRochTop_regular_germ_punctured_homotopy
    (f : ℂ → ℂ) (hf : AnalyticAt ℂ f 0) (hf0 : f 0 = 0) (hd : deriv f 0 ≠ 0) :
    ∃ r : ℝ, 0 < r ∧
      ∃ j g : C({z : ℂ // ‖z‖ < r ∧ z ≠ 0}, {z : ℂ // z ≠ 0}),
        (∀ z, (j z : ℂ) = z ∧ (g z : ℂ) = f z) ∧ ContinuousMap.Homotopic j g := by
  obtain ⟨r, hr, H, hH⟩ := RiemannRochTop_punctured_disk_linear_deformation f hf hf0 hd
  obtain ⟨S, hS⟩ := RiemannRochTop_scalar_deformation (deriv f 0) hd
  let U := {z : ℂ // ‖z‖ < r ∧ z ≠ 0}
  let j : C(U, {z : ℂ // z ≠ 0}) :=
    ⟨fun z ↦ ⟨z, z.property.2⟩, continuous_subtype_val.subtype_mk _⟩
  let m : C(U, {z : ℂ // z ≠ 0}) :=
    ⟨fun z ↦ H (0, z), H.continuous.comp (continuous_const.prodMk continuous_id)⟩
  let g : C(U, {z : ℂ // z ≠ 0}) :=
    ⟨fun z ↦ H (1, z), H.continuous.comp (continuous_const.prodMk continuous_id)⟩
  let A : ContinuousMap.Homotopy j m := {
    toFun := fun p ↦ S (p.1, j p.2)
    continuous_toFun := S.continuous.comp
      (continuous_fst.prodMk (j.continuous.comp continuous_snd))
    map_zero_left := fun z ↦ Subtype.ext (hS (j z)).1
    map_one_left := fun z ↦ Subtype.ext ((hS (j z)).2.trans (hH z).1.symm) }
  let B : ContinuousMap.Homotopy m g := {
    toContinuousMap := H
    map_zero_left := fun _ ↦ rfl
    map_one_left := fun _ ↦ rfl }
  exact ⟨r, hr, j, g, fun z ↦ ⟨rfl, (hH z).2⟩, ⟨A.trans B⟩⟩

/-- RiemannRochTop: injective analytic coordinate changes preserve punctured-disk inclusions up to homotopy. -/
lemma RiemannRochTop_injective_germ_punctured_homotopy
    (f : ℂ → ℂ) (hf : AnalyticAt ℂ f 0) (hf0 : f 0 = 0)
    (s : Set ℂ) (hs : s ∈ 𝓝 (0 : ℂ)) (hi : Set.InjOn f s) :
    ∃ r : ℝ, 0 < r ∧
      ∃ j g : C({z : ℂ // ‖z‖ < r ∧ z ≠ 0}, {z : ℂ // z ≠ 0}),
        (∀ z, (j z : ℂ) = z ∧ (g z : ℂ) = f z) ∧ ContinuousMap.Homotopic j g := by
  obtain ⟨e, he0, he⟩ := RiemannRochTop_injective_analytic_local_homeomorph f 0 hf s hs hi
  have hehol : AnalyticAt ℂ e 0 := by rw [he]; exact hf
  have hd := RiemannRochTop_local_homeomorph_deriv_ne_zero e 0 he0 hehol
  rw [he] at hd
  exact RiemannRochTop_regular_germ_punctured_homotopy f hf hf0 hd

/-- RiemannRochTop: a continuous deformation fixing a point stays uniformly in its neighborhoods. -/
lemma RiemannRochTop_deformation_uniform_nhds
    {X Y : Type} [TopologicalSpace X] [TopologicalSpace Y]
    (H : C(unitInterval × X, Y)) (x : X) (y : Y) (hH : ∀ t, H (t, x) = y)
    (U : Set Y) (hU : U ∈ 𝓝 y) :
    ∀ᶠ z in 𝓝 x, ∀ t : unitInterval, H (t, z) ∈ U := by
  obtain ⟨V, hVU, hV, hyV⟩ := mem_nhds_iff.mp hU
  have hpre : (Set.univ : Set unitInterval) ×ˢ ({x} : Set X) ⊆ H ⁻¹' V := by
    rintro ⟨t, z⟩ ⟨_, hz⟩
    have hz' : z = x := hz
    change H (t, z) ∈ V
    rw [hz', hH t]
    exact hyV
  obtain ⟨A, B, _, hB, hA, hxB, hAB⟩ := generalized_tube_lemma
    isCompact_univ isCompact_singleton (hV.preimage H.continuous) hpre
  filter_upwards [hB.mem_nhds (hxB (Set.mem_singleton x))] with z hz
  intro t
  exact hVU (hAB ⟨hA (Set.mem_univ t), hz⟩)

/-- RiemannRochTop: the deformation of a regular analytic germ extends across its center. -/
lemma RiemannRochTop_regular_germ_disk_deformation
    (f : ℂ → ℂ) (hf : AnalyticAt ℂ f 0) (hf0 : f 0 = 0) (hd : deriv f 0 ≠ 0) :
    ∃ r : ℝ, 0 < r ∧ ∃ H : C(unitInterval × {z : ℂ // ‖z‖ < r}, ℂ),
      (∀ z, H (0, z) = z ∧ H (1, z) = f z) ∧
      ∀ t z, H (t, z) = 0 ↔ (z : ℂ) = 0 := by
  obtain ⟨r, hr, hball⟩ := Metric.eventually_nhds_iff_ball.mp
    (hf.eventually_analyticAt.and
      (RiemannRochTop_linear_deformation_ne_zero f (deriv f 0)
        hf.differentiableAt.hasDerivAt hf0 hd))
  let U := {z : ℂ // ‖z‖ < r}
  have hU : ∀ z : U, (z : ℂ) ∈ Metric.ball 0 r := by
    intro z
    simpa only [Metric.mem_ball, dist_zero_right] using z.property
  let j : C(U, ℂ) := ⟨Subtype.val, continuous_subtype_val⟩
  let m : C(U, ℂ) := ⟨fun z ↦ deriv f 0 * z, continuous_const.mul continuous_subtype_val⟩
  let g : C(U, ℂ) := ⟨fun z ↦ f z, by
    have hfc : ContinuousOn f (Metric.ball 0 r) :=
      fun z hz ↦ (hball z hz).1.continuousAt.continuousWithinAt
    exact hfc.comp_continuous continuous_subtype_val hU⟩
  let A : ContinuousMap.Homotopy j m := {
    toFun := fun p ↦ Complex.exp ((p.1 : ℝ) * Complex.log (deriv f 0)) * j p.2
    continuous_toFun := by fun_prop
    map_zero_left := fun z ↦ by simp [j]
    map_one_left := fun z ↦ by simp [m, j, Complex.exp_log hd] }
  let B : ContinuousMap.Homotopy m g := {
    toFun := fun p ↦ (1 - (p.1 : ℝ)) • m p.2 + (p.1 : ℝ) • g p.2
    continuous_toFun := by fun_prop
    map_zero_left := fun z ↦ by simp [m]
    map_one_left := fun z ↦ by simp }
  refine ⟨r, hr, (A.trans B).toContinuousMap,
    fun z ↦ ⟨(A.trans B).map_zero_left z, (A.trans B).map_one_left z⟩, ?_⟩
  intro t z
  change (A.trans B) (t, z) = 0 ↔ (z : ℂ) = 0
  rw [ContinuousMap.Homotopy.trans_apply]
  split_ifs with ht
  · change Complex.exp _ * (z : ℂ) = 0 ↔ (z : ℂ) = 0
    simp only [mul_eq_zero, Complex.exp_ne_zero, false_or]
  · constructor
    · intro hz
      by_contra hne
      exact (hball z (hU z)).2 _ (unitInterval.two_mul_sub_one_mem_iff.2
        ⟨(not_le.mp ht).le, t.property.2⟩) hne hz
    · intro hz
      change (1 - (2 * (t : ℝ) - 1)) • (deriv f 0 * (z : ℂ)) +
        (2 * (t : ℝ) - 1) • f z = 0
      simp only [hz, hf0, mul_zero, smul_zero, add_zero]

/-- RiemannRochTop: regular analytic germs deform to inclusion inside any punctured neighborhood. -/
lemma RiemannRochTop_regular_germ_homotopy_in_nhds
    (f : ℂ → ℂ) (hf : AnalyticAt ℂ f 0) (hf0 : f 0 = 0) (hd : deriv f 0 ≠ 0)
    (V : Set ℂ) (hV : V ∈ 𝓝 (0 : ℂ)) :
    ∃ r : ℝ, 0 < r ∧
      ∃ j g : C({z : ℂ // ‖z‖ < r ∧ z ≠ 0}, {z : ℂ // z ∈ V ∧ z ≠ 0}),
        (∀ z, (j z : ℂ) = z ∧ (g z : ℂ) = f z) ∧ ContinuousMap.Homotopic j g := by
  obtain ⟨r, hr, H, hend, hzero⟩ := RiemannRochTop_regular_germ_disk_deformation f hf hf0 hd
  let z₀ : {z : ℂ // ‖z‖ < r} := ⟨0, by simpa using hr⟩
  have hfix : ∀ t, H (t, z₀) = 0 := fun t ↦ (hzero t z₀).mpr rfl
  obtain ⟨δ, hδ, hδball⟩ := Metric.eventually_nhds_iff_ball.mp
    (RiemannRochTop_deformation_uniform_nhds H z₀ 0 hfix V hV)
  let U := {z : ℂ // ‖z‖ < min r δ ∧ z ≠ 0}
  let i : C(U, {z : ℂ // ‖z‖ < r}) :=
    ⟨fun z ↦ ⟨z, lt_of_lt_of_le z.property.1 (min_le_left r δ)⟩,
      continuous_subtype_val.subtype_mk _⟩
  have hsmall : ∀ z : U, i z ∈ Metric.ball z₀ δ := by
    intro z
    change dist (z : ℂ) 0 < δ
    rw [dist_zero_right]
    exact lt_of_lt_of_le z.property.1 (min_le_right r δ)
  let K : C(unitInterval × U, {z : ℂ // z ∈ V ∧ z ≠ 0}) :=
    ⟨fun p ↦ ⟨H (p.1, i p.2), hδball (i p.2) (hsmall p.2) p.1,
      fun hz ↦ p.2.property.2 ((hzero p.1 (i p.2)).mp hz)⟩,
      (H.continuous.comp (continuous_fst.prodMk
        (i.continuous.comp continuous_snd))).subtype_mk _⟩
  let j : C(U, {z : ℂ // z ∈ V ∧ z ≠ 0}) :=
    ⟨fun z ↦ K (0, z), K.continuous.comp (continuous_const.prodMk continuous_id)⟩
  let g : C(U, {z : ℂ // z ∈ V ∧ z ≠ 0}) :=
    ⟨fun z ↦ K (1, z), K.continuous.comp (continuous_const.prodMk continuous_id)⟩
  refine ⟨min r δ, lt_min hr hδ, j, g, ?_, ?_⟩
  · intro z
    exact ⟨(hend (i z)).1, (hend (i z)).2⟩
  · exact ⟨{
      toContinuousMap := K
      map_zero_left := fun _ ↦ rfl
      map_one_left := fun _ ↦ rfl }⟩

/-- RiemannRochTop: injective analytic germs deform to inclusion within punctured neighborhoods. -/
lemma RiemannRochTop_injective_germ_homotopy_in_nhds
    (f : ℂ → ℂ) (hf : AnalyticAt ℂ f 0) (hf0 : f 0 = 0)
    (s : Set ℂ) (hs : s ∈ 𝓝 (0 : ℂ)) (hi : Set.InjOn f s)
    (V : Set ℂ) (hV : V ∈ 𝓝 (0 : ℂ)) :
    ∃ r : ℝ, 0 < r ∧
      ∃ j g : C({z : ℂ // ‖z‖ < r ∧ z ≠ 0}, {z : ℂ // z ∈ V ∧ z ≠ 0}),
        (∀ z, (j z : ℂ) = z ∧ (g z : ℂ) = f z) ∧ ContinuousMap.Homotopic j g := by
  obtain ⟨e, he0, he⟩ := RiemannRochTop_injective_analytic_local_homeomorph f 0 hf s hs hi
  have hehol : AnalyticAt ℂ e 0 := by rw [he]; exact hf
  have hd := RiemannRochTop_local_homeomorph_deriv_ne_zero e 0 he0 hehol
  rw [he] at hd
  exact RiemannRochTop_regular_germ_homotopy_in_nhds f hf hf0 hd V hV

/-- RiemannRochTop: normalized analytic charts give homotopic inverse coordinates near a puncture. -/
lemma RiemannRochTop_inverse_charts_punctured_homotopy
    {X : Type} [TopologicalSpace X]
    (d e : OpenPartialHomeomorph X ℂ) (x : X)
    (hdx : x ∈ d.source) (hex : x ∈ e.source) (hd0 : d x = 0) (he0 : e x = 0)
    (ha : AnalyticAt ℂ (e ∘ d.symm) 0)
    (U : Set X) (hU : U ∈ 𝓝 x) :
    ∃ r : ℝ, 0 < r ∧
      ∃ j g : C({z : ℂ // ‖z‖ < r ∧ z ≠ 0}, {y : X // y ∈ U ∧ y ≠ x}),
        (∀ z, (j z : X) = e.symm z ∧ (g z : X) = d.symm z) ∧
        ContinuousMap.Homotopic j g := by
  have hdT : (0 : ℂ) ∈ d.target := hd0 ▸ d.map_source hdx
  have heT : (0 : ℂ) ∈ e.target := he0 ▸ e.map_source hex
  have hdI : d.symm 0 = x := by rw [← hd0, d.left_inv hdx]
  have heI : e.symm 0 = x := by rw [← he0, e.left_inv hex]
  let a := d.symm.trans e
  have ha0 : (0 : ℂ) ∈ a.source := by
    refine ⟨hdT, ?_⟩
    change d.symm 0 ∈ e.source
    rw [hdI]
    exact hex
  have haz : a 0 = 0 := by change e (d.symm 0) = 0; rw [hdI, he0]
  have han : AnalyticAt ℂ a 0 := ha
  let V : Set ℂ := e.target ∩ e.symm ⁻¹' U
  have hV : V ∈ 𝓝 (0 : ℂ) := by
    apply inter_mem (e.open_target.mem_nhds heT)
    have hc : ContinuousAt e.symm 0 := e.continuousAt_symm heT
    exact hc.preimage_mem_nhds (by simpa only [heI] using hU)
  obtain ⟨r, hr, j, g, hjg, ⟨H⟩⟩ :=
    RiemannRochTop_injective_germ_homotopy_in_nhds a han haz
      a.source (a.open_source.mem_nhds ha0) a.injOn V hV
  obtain ⟨s, hs, hsb⟩ := Metric.mem_nhds_iff.mp (a.open_source.mem_nhds ha0)
  let W := {z : ℂ // ‖z‖ < min r s ∧ z ≠ 0}
  let i : C(W, {z : ℂ // ‖z‖ < r ∧ z ≠ 0}) :=
    ⟨fun z ↦ ⟨z, lt_of_lt_of_le z.property.1 (min_le_left r s), z.property.2⟩,
      continuous_subtype_val.subtype_mk _⟩
  have hi : ∀ z : W, (z : ℂ) ∈ a.source := by
    intro z
    apply hsb
    simpa only [Metric.mem_ball, dist_zero_right] using
      lt_of_lt_of_le z.property.1 (min_le_right r s)
  have hm : ∀ z : {z : ℂ // z ∈ V ∧ z ≠ 0}, e.symm z ∈ U ∧ e.symm z ≠ x := by
    intro z
    refine ⟨z.property.1.2, ?_⟩
    intro hz
    apply z.property.2
    calc
      (z : ℂ) = e (e.symm z) := (e.right_inv z.property.1.1).symm
      _ = 0 := by rw [hz, he0]
  let q : C({z : ℂ // z ∈ V ∧ z ≠ 0}, {y : X // y ∈ U ∧ y ≠ x}) :=
    ⟨fun z ↦ ⟨e.symm z, hm z⟩,
      (e.continuousOn_invFun.comp_continuous continuous_subtype_val
        (fun z ↦ z.property.1.1)).subtype_mk hm⟩
  refine ⟨min r s, lt_min hr hs, q.comp (j.comp i), q.comp (g.comp i), ?_, ?_⟩
  · intro z
    constructor
    · change e.symm (j (i z)) = e.symm z
      rw [(hjg (i z)).1]; rfl
    · change e.symm (g (i z)) = d.symm z
      rw [(hjg (i z)).2]
      exact e.left_inv (hi z).2
  · exact ⟨((ContinuousMap.Homotopy.refl q).comp H).compContinuousMap i⟩

/-- RiemannRochTop: holomorphic inverse charts are homotopic away from any finite puncture set. -/
lemma RiemannRochTop_sphere_charts_homotopy
    (d e : OpenPartialHomeomorph (OnePoint ℂ) ℂ) (x : OnePoint ℂ)
    (hdx : x ∈ d.source) (hex : x ∈ e.source) (hd0 : d x = 0) (he0 : e x = 0)
    (hd : ContMDiffAt 𝓘(ℂ, ℂ) 𝓘(ℂ, ℂ) ω d.symm 0)
    (he : ContMDiffAt 𝓘(ℂ, ℂ) 𝓘(ℂ, ℂ) ω e x)
    (B : Set (OnePoint ℂ)) (hB : B.Finite) :
    ∃ r : ℝ, 0 < r ∧ ∃ j g : C({z : ℂ // ‖z‖ < r ∧ z ≠ 0}, ↥Bᶜ),
      (∀ z, (j z : OnePoint ℂ) = e.symm z ∧ (g z : OnePoint ℂ) = d.symm z) ∧
      ContinuousMap.Homotopic j g := by
  have hdI : d.symm 0 = x := by rw [← hd0, d.left_inv hdx]
  have he' : ContMDiffAt 𝓘(ℂ, ℂ) 𝓘(ℂ, ℂ) ω e (d.symm 0) := by
    simpa only [hdI] using he
  have ha : AnalyticAt ℂ (e ∘ d.symm) 0 := (he'.comp 0 hd).contDiffAt.analyticAt
  let U := (B \ {x})ᶜ
  have hU : U ∈ 𝓝 x := hB.sdiff.isClosed.isOpen_compl.mem_nhds (by simp [U])
  obtain ⟨r, hr, j, g, hjg, ⟨H⟩⟩ :=
    RiemannRochTop_inverse_charts_punctured_homotopy d e x hdx hex hd0 he0 ha U hU
  have hm : ∀ y : {y : OnePoint ℂ // y ∈ U ∧ y ≠ x}, (y : OnePoint ℂ) ∈ Bᶜ := by
    intro y hy
    exact y.property.1 ⟨hy, y.property.2⟩
  let q : C({y : OnePoint ℂ // y ∈ U ∧ y ≠ x}, ↥Bᶜ) :=
    ⟨fun y ↦ ⟨y, hm y⟩, continuous_subtype_val.subtype_mk hm⟩
  exact ⟨r, hr, q.comp j, q.comp g, hjg,
    ⟨(ContinuousMap.Homotopy.refl q).comp H⟩⟩

/-- RiemannRochTop: positive circular turns define loops in every punctured disk containing them. -/
lemma RiemannRochTop_positive_circle_path (r : ℝ) (w : ℂ)
    (hw : ‖w‖ < r) (hw0 : w ≠ 0) :
    ∃ p : Path (⟨w, hw, hw0⟩ : {z : ℂ // ‖z‖ < r ∧ z ≠ 0}) ⟨w, hw, hw0⟩,
      ∀ t, (p t : ℂ) =
        Complex.exp ((((t : ℝ) * (2 * Real.pi) : ℝ) : ℂ) * Complex.I) * w := by
  let q : unitInterval → ℂ := fun t ↦
    Complex.exp ((((t : ℝ) * (2 * Real.pi) : ℝ) : ℂ) * Complex.I) * w
  have hq : ∀ t, ‖q t‖ < r ∧ q t ≠ 0 := by
    intro t
    refine ⟨?_, mul_ne_zero (Complex.exp_ne_zero _) hw0⟩
    simpa only [q, norm_mul, Complex.norm_exp_ofReal_mul_I, one_mul] using hw
  refine ⟨{
    toFun := fun t ↦ ⟨q t, hq t⟩
    continuous_toFun := (by fun_prop : Continuous q).subtype_mk hq
    source' := Subtype.ext (by simp [q])
    target' := Subtype.ext (by simp [q, Complex.exp_two_pi_mul_I]) }, fun _ ↦ rfl⟩

/-- RiemannRochTop: positive radial shrinking is homotopic to the identity on a punctured disk. -/
lemma RiemannRochTop_punctured_disk_shrink_homotopy (r a : ℝ) (ha : 0 < a) (ha1 : a ≤ 1) :
    ∃ j g : C({z : ℂ // ‖z‖ < r ∧ z ≠ 0}, {z : ℂ // ‖z‖ < r ∧ z ≠ 0}),
      (∀ z, (j z : ℂ) = z ∧ (g z : ℂ) = (a : ℂ) * z) ∧
      ContinuousMap.Homotopic j g := by
  let W := {z : ℂ // ‖z‖ < r ∧ z ≠ 0}
  let b : unitInterval → ℝ := fun t ↦ 1 - (t : ℝ) + (t : ℝ) * a
  have hb : ∀ t, 0 < b t ∧ b t ≤ 1 := by
    intro t
    have h₁ := mul_nonneg (sub_nonneg.mpr t.property.2) (sub_nonneg.mpr ha1)
    have h₂ := mul_nonneg t.property.1 (sub_nonneg.mpr ha1)
    dsimp [b]
    constructor <;> nlinarith
  have hm : ∀ p : unitInterval × W,
      ‖(b p.1 : ℂ) * (p.2 : ℂ)‖ < r ∧ (b p.1 : ℂ) * (p.2 : ℂ) ≠ 0 := by
    intro p
    constructor
    · rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos (hb p.1).1]
      exact lt_of_le_of_lt (mul_le_of_le_one_left (norm_nonneg _) (hb p.1).2) p.2.property.1
    · exact mul_ne_zero (Complex.ofReal_ne_zero.mpr (hb p.1).1.ne') p.2.property.2
  let K : C(unitInterval × W, W) :=
    ⟨fun p ↦ ⟨(b p.1 : ℂ) * (p.2 : ℂ), hm p⟩,
      (by dsimp [b, W]; fun_prop : Continuous
        (fun p : unitInterval × W ↦ (b p.1 : ℂ) * (p.2 : ℂ))).subtype_mk hm⟩
  let j : C(W, W) :=
    ⟨fun z ↦ K (0, z), K.continuous.comp (continuous_const.prodMk continuous_id)⟩
  let g : C(W, W) :=
    ⟨fun z ↦ K (1, z), K.continuous.comp (continuous_const.prodMk continuous_id)⟩
  refine ⟨j, g, ?_, ?_⟩
  · intro z
    simp [j, g, K, b]
  · exact ⟨{
      toContinuousMap := K
      map_zero_left := fun _ ↦ rfl
      map_one_left := fun _ ↦ rfl }⟩

/-- RiemannRochTop: a homotopy compares based loops by the path traced by their basepoint. -/
lemma RiemannRochTop_homotopy_loop_conjugacy
    {X Y : Type} [TopologicalSpace X] [TopologicalSpace Y]
    {f g : C(X, Y)} (H : ContinuousMap.Homotopy f g) (x : X) (p : Path x x) :
    ((H.evalAt x).symm.trans ((p.map f.continuous).trans (H.evalAt x))).Homotopic
      (p.map g.continuous) := by
  have h := (Path.Homotopic.refl (H.evalAt x).symm).hcomp
    (Path.Homotopic.map_trans_evalAt H p)
  have ha := (Path.Homotopic.trans_assoc (H.evalAt x).symm (H.evalAt x)
    (p.map g.continuous)).symm
  have hb := (Path.Homotopic.symm_trans (H.evalAt x)).hcomp
    (Path.Homotopic.refl (p.map g.continuous))
  exact h.trans (ha.trans (hb.trans (Path.Homotopic.refl_trans (p.map g.continuous))))

/-- RiemannRochTop: injective analytic coordinate changes conjugate loops within punctured neighborhoods. -/
lemma RiemannRochTop_coordinate_loop_conjugacy
    (f : ℂ → ℂ) (hf : AnalyticAt ℂ f 0) (hf0 : f 0 = 0)
    (s : Set ℂ) (hs : s ∈ 𝓝 (0 : ℂ)) (hi : Set.InjOn f s)
    (V : Set ℂ) (hV : V ∈ 𝓝 (0 : ℂ)) :
    ∃ r : ℝ, 0 < r ∧
      ∃ j g : C({z : ℂ // ‖z‖ < r ∧ z ≠ 0}, {z : ℂ // z ∈ V ∧ z ≠ 0}),
        (∀ z, (j z : ℂ) = z ∧ (g z : ℂ) = f z) ∧
        ∀ x, ∃ a : Path (j x) (g x), ∀ p : Path x x,
          (a.symm.trans ((p.map j.continuous).trans a)).Homotopic
            (p.map g.continuous) := by
  obtain ⟨e, he0, he⟩ := RiemannRochTop_injective_analytic_local_homeomorph f 0 hf s hs hi
  have hehol : AnalyticAt ℂ e 0 := by rw [he]; exact hf
  have hd := RiemannRochTop_local_homeomorph_deriv_ne_zero e 0 he0 hehol
  rw [he] at hd
  obtain ⟨r, hr, j, g, hjg, ⟨H⟩⟩ :=
    RiemannRochTop_regular_germ_homotopy_in_nhds f hf hf0 hd V hV
  exact ⟨r, hr, j, g, hjg, fun x ↦ ⟨H.evalAt x,
    fun p ↦ RiemannRochTop_homotopy_loop_conjugacy H x p⟩⟩

/-- RiemannRochTop: transport in a covering commutes with continuous maps over its base. -/
lemma RiemannRochTop_monodromy_naturality
    {X U : Type} [TopologicalSpace X] [TopologicalSpace U]
    (f : U → X) (hf : IsCoveringMap f) (T : C(U, U)) (hT : ∀ u, f (T u) = f u)
    {x y : X} (c : Path x y) (u : f ⁻¹' {x}) :
    (hf.monodromy ⟦c⟧ ⟨T u, (hT u).trans u.property⟩ : U) = T (hf.monodromy ⟦c⟧ u) := by
  let Γ := hf.liftPath c u (c.source.trans u.property.symm)
  have hΓ : f ∘ Γ = c := hf.liftPath_lifts c u (c.source.trans u.property.symm)
  have hΓ0 : Γ 0 = u := hf.liftPath_zero c u (c.source.trans u.property.symm)
  let Δ : C(unitInterval, U) := T.comp Γ
  have hΔ : f ∘ Δ = c := funext fun t ↦ (hT (Γ t)).trans (congrFun hΓ t)
  have hΔ0 : Δ 0 = T u := congrArg T hΓ0
  have h₁ := hf.monodromy_eq_apply_one (e := u) hΓ hΓ0
  have h₂ := hf.monodromy_eq_apply_one (e := ⟨T u, (hT u).trans u.property⟩) hΔ hΔ0
  exact h₂.trans (congrArg T h₁.symm)

/-- RiemannRochTop: homotopy-commutative path squares transport deck endpoints. -/
lemma RiemannRochTop_monodromy_path_square
    {X U : Type} [TopologicalSpace X] [TopologicalSpace U]
    (f : U → X) (hf : IsCoveringMap f) (T : C(U, U)) (hT : ∀ u, f (T u) = f u)
    {x y : X} (c : Path x x) (d : Path y y) (a : Path x y)
    (h : (c.trans a).Homotopic (a.trans d)) (u : f ⁻¹' {x})
    (hloop : (hf.monodromy ⟦c⟧ u : U) = T u) :
    (hf.monodromy ⟦d⟧ (hf.monodromy ⟦a⟧ u) : U) = T (hf.monodromy ⟦a⟧ u) := by
  have heq : (⟦c.trans a⟧ : Path.Homotopic.Quotient x y) = ⟦a.trans d⟧ := Quotient.sound h
  have htransport := congrArg (fun p : Path.Homotopic.Quotient x y ↦ hf.monodromy p u) heq
  change hf.monodromy ((Path.Homotopic.Quotient.mk c).trans (.mk a)) u =
    hf.monodromy ((Path.Homotopic.Quotient.mk a).trans (.mk d)) u at htransport
  rw [hf.monodromy_trans_apply, hf.monodromy_trans_apply] at htransport
  have hu : hf.monodromy (Path.Homotopic.Quotient.mk c) u =
      ⟨T u, (hT u).trans u.property⟩ := Subtype.ext hloop
  rw [hu] at htransport
  exact (congrArg Subtype.val htransport).symm.trans
    (RiemannRochTop_monodromy_naturality f hf T hT a u)

/-- RiemannRochTop: adjoining a stem transports the deck endpoint of a loop. -/
lemma RiemannRochTop_monodromy_conjugated_loop
    {X U : Type} [TopologicalSpace X] [TopologicalSpace U]
    (f : U → X) (hf : IsCoveringMap f) (T : C(U, U)) (hT : ∀ u, f (T u) = f u)
    {x y : X} (a : Path x y) (d : Path y y) (u : f ⁻¹' {x})
    (hloop : (hf.monodromy ⟦a.trans (d.trans a.symm)⟧ u : U) = T u) :
    (hf.monodromy ⟦d⟧ (hf.monodromy ⟦a⟧ u) : U) = T (hf.monodromy ⟦a⟧ u) := by
  have h : ((a.trans (d.trans a.symm)).trans a).Homotopic (a.trans d) := by
    apply (Path.Homotopic.trans_assoc a (d.trans a.symm) a).trans
    apply (Path.Homotopic.refl a).hcomp
    exact (Path.Homotopic.trans_assoc d a.symm a).trans
      (((Path.Homotopic.refl d).hcomp (Path.Homotopic.symm_trans a)).trans
        (Path.Homotopic.trans_refl d))
  exact RiemannRochTop_monodromy_path_square f hf T hT
    (a.trans (d.trans a.symm)) d a h u hloop

/-- RiemannRochTop: free homotopies preserve deck endpoints after transport of the initial point. -/
lemma RiemannRochTop_monodromy_homotopy
    {X U Z : Type} [TopologicalSpace X] [TopologicalSpace U] [TopologicalSpace Z]
    (f : U → X) (hf : IsCoveringMap f) (T : C(U, U)) (hT : ∀ u, f (T u) = f u)
    {j g : C(Z, X)} (H : ContinuousMap.Homotopy j g) (x : Z) (p : Path x x)
    (u : f ⁻¹' {j x})
    (hloop : (hf.monodromy ⟦p.map j.continuous⟧ u : U) = T u) :
    let v := hf.monodromy ⟦H.evalAt x⟧ u
    (hf.monodromy ⟦p.map g.continuous⟧ v : U) = T v := by
  have heq : (⟦(p.map j.continuous).trans (H.evalAt x)⟧ :
      Path.Homotopic.Quotient (j x) (g x)) =
      ⟦(H.evalAt x).trans (p.map g.continuous)⟧ :=
    Quotient.sound (Path.Homotopic.map_trans_evalAt H p)
  have htransport := congrArg (fun c : Path.Homotopic.Quotient (j x) (g x) ↦
    hf.monodromy c u) heq
  change hf.monodromy ((Path.Homotopic.Quotient.mk (p.map j.continuous)).trans
    (.mk (H.evalAt x))) u = hf.monodromy
      ((Path.Homotopic.Quotient.mk (H.evalAt x)).trans (.mk (p.map g.continuous))) u
    at htransport
  rw [hf.monodromy_trans_apply, hf.monodromy_trans_apply] at htransport
  have hu : hf.monodromy (Path.Homotopic.Quotient.mk (p.map j.continuous)) u =
      ⟨T u, (hT u).trans u.property⟩ := Subtype.ext hloop
  rw [hu] at htransport
  exact (congrArg Subtype.val htransport).symm.trans
    (RiemannRochTop_monodromy_naturality f hf T hT (H.evalAt x) u)

/-- RiemannRochTop: free homotopies over a covering locus transfer reference lifts with their deck endpoints. -/
lemma RiemannRochTop_coveringOn_homotopy_lift
    {X U Z : Type} [TopologicalSpace X] [TopologicalSpace U] [TopologicalSpace Z]
    (f : U → X) (B : Set X) (hf : IsCoveringMapOn f Bᶜ)
    (T : C(U, U)) (hT : ∀ u, f (T u) = f u)
    {j g : C(Z, ↥Bᶜ)} (H : ContinuousMap.Homotopy j g) (x : Z) (p : Path x x)
    (Δ : C(unitInterval, U)) (hΔ : ∀ t, f (Δ t) = (j (p t) : X))
    (hend : Δ 1 = T (Δ 0)) :
    ∃ Γ : C(unitInterval, U), (∀ t, f (Γ t) = (g (p t) : X)) ∧ Γ 1 = T (Γ 0) := by
  let f' := Bᶜ.restrictPreimage f
  have hf' : IsCoveringMap f' := hf.isCoveringMap_restrictPreimage
  have hTm : ∀ z : f ⁻¹' Bᶜ, T z ∈ f ⁻¹' Bᶜ := by
    intro z
    change f (T z) ∈ Bᶜ
    rw [hT]
    exact z.property
  let T' : C(↥(f ⁻¹' Bᶜ), ↥(f ⁻¹' Bᶜ)) :=
    ⟨fun z ↦ ⟨T z, hTm z⟩, (T.continuous.comp continuous_subtype_val).subtype_mk hTm⟩
  have hT' : ∀ u, f' (T' u) = f' u := fun u ↦ Subtype.ext (hT u)
  have hΔm : ∀ t, Δ t ∈ f ⁻¹' Bᶜ := by
    intro t
    change f (Δ t) ∈ Bᶜ
    rw [hΔ t]
    exact (j (p t)).property
  let Δ' : C(unitInterval, ↥(f ⁻¹' Bᶜ)) :=
    ⟨fun t ↦ ⟨Δ t, hΔm t⟩, Δ.continuous.subtype_mk hΔm⟩
  have hΔ' : f' ∘ Δ' = p.map j.continuous := funext fun t ↦ Subtype.ext (hΔ t)
  let u : f' ⁻¹' {j x} := ⟨Δ' 0, (congrFun hΔ' 0).trans (congrArg j p.source)⟩
  have hloop : (hf'.monodromy ⟦p.map j.continuous⟧ u : f ⁻¹' Bᶜ) = T' u :=
    (hf'.monodromy_eq_apply_one (e := u) hΔ' rfl).trans (Subtype.ext hend)
  let v := hf'.monodromy ⟦H.evalAt x⟧ u
  let d := p.map g.continuous
  let Γ' := hf'.liftPath d v (d.source.trans v.property.symm)
  have hΓ' : f' ∘ Γ' = d := hf'.liftPath_lifts d v (d.source.trans v.property.symm)
  have hΓ0 : Γ' 0 = v := hf'.liftPath_zero d v (d.source.trans v.property.symm)
  have htransport := RiemannRochTop_monodromy_homotopy f' hf' T' hT' H x p u hloop
  have hΓ1 : Γ' 1 = T' v :=
    (hf'.monodromy_eq_apply_one (e := v) hΓ' hΓ0).symm.trans htransport
  refine ⟨⟨fun t ↦ (Γ' t : U), continuous_subtype_val.comp Γ'.continuous⟩,
    fun t ↦ congrArg Subtype.val (congrFun hΓ' t), ?_⟩
  exact congrArg Subtype.val (hΓ1.trans (congrArg T' hΓ0.symm))

/-- RiemannRochTop: a lifted stem-conjugated loop gives a local lift with the same deck endpoint. -/
lemma RiemannRochTop_coveringOn_conjugated_loop_lift
    {X U : Type} [TopologicalSpace X] [TopologicalSpace U]
    (f : U → X) (B : Set X) (hf : IsCoveringMapOn f Bᶜ)
    (T : C(U, U)) (hT : ∀ u, f (T u) = f u)
    {x y : ↥Bᶜ} (a : Path x y) (d : Path y y)
    (Δ : C(unitInterval, U))
    (hΔ : ∀ t, f (Δ t) = ((a.trans (d.trans a.symm)) t : X))
    (hend : Δ 1 = T (Δ 0)) :
    ∃ Γ : C(unitInterval, U), (∀ t, f (Γ t) = (d t : X)) ∧ Γ 1 = T (Γ 0) := by
  let f' := Bᶜ.restrictPreimage f
  have hf' : IsCoveringMap f' := hf.isCoveringMap_restrictPreimage
  have hTm : ∀ z : f ⁻¹' Bᶜ, T z ∈ f ⁻¹' Bᶜ := by
    intro z
    change f (T z) ∈ Bᶜ
    rw [hT]
    exact z.property
  let T' : C(↥(f ⁻¹' Bᶜ), ↥(f ⁻¹' Bᶜ)) :=
    ⟨fun z ↦ ⟨T z, hTm z⟩, (T.continuous.comp continuous_subtype_val).subtype_mk hTm⟩
  have hT' : ∀ u, f' (T' u) = f' u := fun u ↦ Subtype.ext (hT u)
  let c := a.trans (d.trans a.symm)
  have hΔm : ∀ t, Δ t ∈ f ⁻¹' Bᶜ := by
    intro t
    change f (Δ t) ∈ Bᶜ
    rw [hΔ t]
    exact (c t).property
  let Δ' : C(unitInterval, ↥(f ⁻¹' Bᶜ)) :=
    ⟨fun t ↦ ⟨Δ t, hΔm t⟩, Δ.continuous.subtype_mk hΔm⟩
  have hΔ' : f' ∘ Δ' = c := funext fun t ↦ Subtype.ext (hΔ t)
  let u : f' ⁻¹' {x} := ⟨Δ' 0, (congrFun hΔ' 0).trans c.source⟩
  have hloop : (hf'.monodromy ⟦c⟧ u : f ⁻¹' Bᶜ) = T' u :=
    (hf'.monodromy_eq_apply_one (e := u) hΔ' rfl).trans (Subtype.ext hend)
  let v := hf'.monodromy ⟦a⟧ u
  let Γ' := hf'.liftPath d v (d.source.trans v.property.symm)
  have hΓ' : f' ∘ Γ' = d := hf'.liftPath_lifts d v (d.source.trans v.property.symm)
  have hΓ0 : Γ' 0 = v := hf'.liftPath_zero d v (d.source.trans v.property.symm)
  have htransport := RiemannRochTop_monodromy_conjugated_loop f' hf' T' hT' a d u hloop
  have hΓ1 : Γ' 1 = T' v :=
    (hf'.monodromy_eq_apply_one (e := v) hΓ' hΓ0).symm.trans htransport
  refine ⟨⟨fun t ↦ (Γ' t : U), continuous_subtype_val.comp Γ'.continuous⟩,
    fun t ↦ congrArg Subtype.val (congrFun hΓ' t), ?_⟩
  exact congrArg Subtype.val (hΓ1.trans (congrArg T' hΓ0.symm))

/-- RiemannRochTop: rotation monodromy is invariant under free homotopies away from branch values. -/
lemma RiemannRochTop_rotGen_of_homotopy [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) {G : Type} [Group G] [Finite G] [MulAction G C]
    (hG : ∀ k : G, ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω (fun x : C ↦ k • x))
    (f : C → OnePoint ℂ) (hf : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω f)
    (hgal : b4_IsGaloisCover G f) (B : Set (OnePoint ℂ))
    (hfree : ∀ x, f x ∉ B → MulAction.stabilizer G x = ⊥)
    {Z : Type} [TopologicalSpace Z] {j g : C(Z, ↥Bᶜ)}
    (H : ContinuousMap.Homotopy j g) (x : Z) (p : Path x x)
    (Δ : C(unitInterval, C)) (k : G)
    (hΔ : ∀ t, f (Δ t) = (j (p t) : OnePoint ℂ)) (hΔend : Δ 1 = k • Δ 0)
    (q : C) (hk : b4_IsRotGen E q k)
    (Γ : C(unitInterval, C)) (l : G)
    (hΓ : ∀ t, f (Γ t) = (g (p t) : OnePoint ℂ)) (hΓend : Γ 1 = l • Γ 0) :
    ∃ q', f q' = f q ∧ b4_IsRotGen E q' l := by
  let T : C(C, C) := ⟨fun z ↦ k • z, (hG k).continuous⟩
  obtain ⟨Λ, hΛ, hΛend⟩ := RiemannRochTop_coveringOn_homotopy_lift f B
    (RiemannRochTop_galois_coveringOn hE hG f hf hgal B hfree)
    T (hgal.1 k) H x p Δ hΔ hΔend
  exact RiemannRochTop_rotGen_of_reference_lift hE hG f hf hgal B hfree
    (p.map g.continuous) (p.map g.continuous) rfl Γ Λ l k hΓ hΛ hΓend hΛend q hk

/-- RiemannRochTop: holomorphicity into a complex manifold descends through powers. -/
lemma RiemannRochTop_holomorphic_descends_power
    {F Y : Type} [NormedAddCommGroup F] [NormedSpace ℂ F] [CompleteSpace F]
    [TopologicalSpace Y] [ChartedSpace F Y] [IsManifold 𝓘(ℂ, F) ω Y]
    (f : ℂ → Y) (n : ℕ) (hn : 0 < n) (hc : ContinuousAt f 0)
    (ha : ContMDiffAt 𝓘(ℂ, ℂ) 𝓘(ℂ, F) ω (fun z : ℂ ↦ f (z ^ n)) 0) :
    ContMDiffAt 𝓘(ℂ, ℂ) 𝓘(ℂ, F) ω f 0 := by
  rw [contMDiffAt_iff_target]
  refine ⟨hc, ?_⟩
  apply ContDiffAt.contMDiffAt
  apply AnalyticAt.contDiffAt
  apply RiemannRochTop_analytic_descends_power _ n hn
  · exact (continuousAt_extChartAt (I := 𝓘(ℂ, F)) (f 0)).comp hc
  · have h := (contMDiffAt_iff_target.mp ha).2
    simp only [zero_pow hn.ne'] at h
    exact h.contDiffAt.analyticAt

/-- RiemannRochTop: a continuous disk quotient of a holomorphic power factor has a holomorphic germ. -/
lemma RiemannRochTop_disk_quotient_holomorphic
    {F Y : Type} [NormedAddCommGroup F] [NormedSpace ℂ F] [CompleteSpace F]
    [TopologicalSpace Y] [ChartedSpace F Y] [IsManifold 𝓘(ℂ, F) ω Y]
    (n : ℕ) (hn : 0 < n) (r : ℝ) (hr : 0 < r)
    (g : ℂ → Y) (hg : ContMDiffAt 𝓘(ℂ, ℂ) 𝓘(ℂ, F) ω g 0)
    (ψ : C(↥(Metric.closedBall (0 : ℂ) (r ^ n)), Y))
    (hψ : ∀ (z : ↥(Metric.closedBall (0 : ℂ) r))
      (w : ↥(Metric.closedBall (0 : ℂ) (r ^ n))),
      (w : ℂ) = (z : ℂ) ^ n → ψ w = g z) :
    ∃ q : ℂ → Y, ContMDiffAt 𝓘(ℂ, ℂ) 𝓘(ℂ, F) ω q 0 ∧
      ∀ w : ↥(Metric.closedBall (0 : ℂ) (r ^ n)), q w = ψ w := by
  let q : ℂ → Y := fun w ↦ if h : w ∈ Metric.closedBall (0 : ℂ) (r ^ n)
    then ψ ⟨w, h⟩ else g 0
  have hq : ∀ w : ↥(Metric.closedBall (0 : ℂ) (r ^ n)), q w = ψ w := by
    intro w
    simp only [q, dif_pos w.property]
  refine ⟨q, ?_, hq⟩
  apply RiemannRochTop_holomorphic_descends_power q n hn
  · have hc : ContinuousOn q (Metric.closedBall (0 : ℂ) (r ^ n)) := by
      rw [continuousOn_iff_continuous_restrict]
      have heq : (fun w : ↥(Metric.closedBall (0 : ℂ) (r ^ n)) ↦ q w) = ψ :=
        funext hq
      change Continuous (fun w : ↥(Metric.closedBall (0 : ℂ) (r ^ n)) ↦ q w)
      rw [heq]
      exact ψ.continuous
    exact hc.continuousAt (Metric.closedBall_mem_nhds _ (pow_pos hr n))
  · apply hg.congr_of_eventuallyEq
    filter_upwards [Metric.closedBall_mem_nhds (0 : ℂ) hr] with z hz
    have hw : z ^ n ∈ Metric.closedBall (0 : ℂ) (r ^ n) := by
      have hz' : ‖z‖ ≤ r := by simpa only [Metric.mem_closedBall, dist_zero_right] using hz
      simpa only [Metric.mem_closedBall, dist_zero_right, norm_pow] using
        pow_le_pow_left₀ (norm_nonneg z) hz' n
    exact (hq ⟨z ^ n, hw⟩).trans (hψ ⟨z, hz⟩ ⟨z ^ n, hw⟩ rfl)

/-- RiemannRochTop: quotient maps with the same fibers have homeomorphic targets. -/
lemma RiemannRochTop_quotient_fiber_homeomorph
    {X Y Z : Type} [TopologicalSpace X] [TopologicalSpace Y] [TopologicalSpace Z]
    (f : C(X, Y)) (g : C(X, Z)) (hf : IsQuotientMap f) (hg : IsQuotientMap g)
    (hker : ∀ x x', f x = f x' ↔ g x = g x') :
    ∃ e : Y ≃ₜ Z, ∀ x, e (f x) = g x := by
  let a := hf.lift g (fun x x' h ↦ (hker x x').mp h)
  let b := hg.lift f (fun x x' h ↦ (hker x x').mpr h)
  have ha : ∀ x, a (f x) = g x := fun x ↦
    congrArg (fun h : C(X, Z) ↦ h x) (hf.lift_comp g (fun x x' h ↦ (hker x x').mp h))
  have hb : ∀ x, b (g x) = f x := fun x ↦
    congrArg (fun h : C(X, Y) ↦ h x) (hg.lift_comp f (fun x x' h ↦ (hker x x').mpr h))
  refine ⟨{
    toFun := a
    invFun := b
    left_inv := ?_
    right_inv := ?_
    continuous_toFun := a.continuous
    continuous_invFun := b.continuous }, ha⟩
  · intro y
    obtain ⟨x, rfl⟩ := hf.surjective y
    rw [ha, hb]
  · intro z
    obtain ⟨x, rfl⟩ := hg.surjective z
    rw [hb, ha]

/-- RiemannRochTop: complex powers map disks onto disks of the corresponding radius. -/
lemma RiemannRochTop_power_disk_image (n : ℕ) (hn : 0 < n) (r : ℝ) (hr : 0 ≤ r) :
    (fun z : ℂ ↦ z ^ n) '' Metric.closedBall 0 r = Metric.closedBall 0 (r ^ n) := by
  ext w
  constructor
  · rintro ⟨z, hz, rfl⟩
    have hz' : ‖z‖ ≤ r := by simpa only [Metric.mem_closedBall, dist_zero_right] using hz
    simpa only [Metric.mem_closedBall, dist_zero_right, norm_pow] using
      pow_le_pow_left₀ (norm_nonneg z) hz' n
  · intro hw
    obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq w hn
    refine ⟨z, ?_, hz⟩
    have hp : ‖z‖ ^ n ≤ r ^ n := by
      rw [← norm_pow, hz]
      simpa only [Metric.mem_closedBall, dist_zero_right] using hw
    simpa only [Metric.mem_closedBall, dist_zero_right] using
      (pow_le_pow_iff_left₀ (norm_nonneg z) hr hn.ne').mp hp

/-- RiemannRochTop: a continuous map with power-map fibers gives a disk quotient homeomorphism. -/
lemma RiemannRochTop_disk_power_quotient {Y : Type} [TopologicalSpace Y] [T2Space Y]
    (n : ℕ) (hn : 0 < n) (r : ℝ) (hr : 0 ≤ r)
    (F : C(↥(Metric.closedBall (0 : ℂ) r), Y))
    (hfib : ∀ v w, F v = F w ↔ (v : ℂ) ^ n = (w : ℂ) ^ n) :
    ∃ e : ↥(Metric.closedBall (0 : ℂ) (r ^ n)) ≃ₜ ↥(Set.range F),
      ∀ (z : ↥(Metric.closedBall (0 : ℂ) r)) (w : ↥(Metric.closedBall (0 : ℂ) (r ^ n))),
        (w : ℂ) = (z : ℂ) ^ n → (e w : Y) = F z := by
  letI : CompactSpace ↥(Metric.closedBall (0 : ℂ) r) :=
    isCompact_iff_compactSpace.mp (isCompact_closedBall (0 : ℂ) r)
  have hpow : ∀ z : ↥(Metric.closedBall (0 : ℂ) r),
      (z : ℂ) ^ n ∈ Metric.closedBall (0 : ℂ) (r ^ n) := by
    intro z
    rw [← RiemannRochTop_power_disk_image n hn r hr]
    exact ⟨z, z.property, rfl⟩
  let q : C(↥(Metric.closedBall (0 : ℂ) r), ↥(Metric.closedBall (0 : ℂ) (r ^ n))) :=
    ⟨fun z ↦ ⟨(z : ℂ) ^ n, hpow z⟩, (continuous_subtype_val.pow n).subtype_mk _⟩
  let g : C(↥(Metric.closedBall (0 : ℂ) r), ↥(Set.range F)) :=
    ⟨fun z ↦ ⟨F z, Set.mem_range_self z⟩, F.continuous.subtype_mk _⟩
  have hq : Function.Surjective q := by
    intro w
    have hw : (w : ℂ) ∈ (fun z : ℂ ↦ z ^ n) '' Metric.closedBall 0 r := by
      simpa only [RiemannRochTop_power_disk_image n hn r hr] using w.property
    obtain ⟨z, hz, heq⟩ := hw
    exact ⟨⟨z, hz⟩, Subtype.ext heq⟩
  have hg : Function.Surjective g := by
    rintro ⟨w, z, rfl⟩
    exact ⟨z, rfl⟩
  obtain ⟨e, he⟩ := RiemannRochTop_quotient_fiber_homeomorph q g
    (IsQuotientMap.of_surjective_continuous hq q.continuous)
    (IsQuotientMap.of_surjective_continuous hg g.continuous)
    (fun v w ↦ by rw [Subtype.ext_iff, Subtype.ext_iff]; exact (hfib v w).symm)
  refine ⟨e, ?_⟩
  intro z w hw
  have hw' : w = q z := Subtype.ext hw
  rw [hw']
  exact congrArg Subtype.val (he z)

/-- RiemannRochTop: a Galois map on a small coordinate disk is a power map followed by a homeomorphism. -/
lemma RiemannRochTop_local_power_model [T2Space C]
    {G : Type} [Group G] [Finite G] [MulAction G C]
    (hE : Module.finrank ℂ E = 1)
    (hG : ∀ g : G, ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω (fun x : C ↦ g • x))
    {Y : Type} [TopologicalSpace Y] [T2Space Y] (f : C → Y) (hf : Continuous f)
    (hgal : b4_IsGaloisCover G f) (x : C) (k : G) (hk : b4_IsRotGen E x k) :
    ∃ e : OpenPartialHomeomorph C ℂ, x ∈ e.source ∧ e x = 0 ∧
      ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω e x ∧
      ContMDiffAt 𝓘(ℂ, ℂ) 𝓘(ℂ, E) ω e.symm 0 ∧
      (∀ᶠ z in 𝓝 (0 : ℂ),
        e.symm (Complex.exp (2 * Real.pi * Complex.I / (orderOf k : ℂ)) * z) = k • e.symm z) ∧
      ∃ r : ℝ, 0 < r ∧ Metric.closedBall (0 : ℂ) r ⊆ e.target ∧
        ∃ ψ : ↥(Metric.closedBall (0 : ℂ) (r ^ orderOf k)) ≃ₜ
            ↥(Set.range (fun z : ↥(Metric.closedBall (0 : ℂ) r) ↦ f (e.symm z))),
          ∀ (z : ↥(Metric.closedBall (0 : ℂ) r))
            (w : ↥(Metric.closedBall (0 : ℂ) (r ^ orderOf k))),
            (w : ℂ) = (z : ℂ) ^ orderOf k → (ψ w : Y) = f (e.symm z) := by
  obtain ⟨e, hx, he, hehol, heinv, hrot, ε, hε, hball, hfib⟩ :=
    RiemannRochTop_local_power_fibers hE hG f hgal x k hk
  have hsmall : Metric.closedBall (0 : ℂ) (ε / 2) ⊆ Metric.ball (0 : ℂ) ε :=
    Metric.closedBall_subset_ball (half_lt_self hε)
  have htarget : Metric.closedBall (0 : ℂ) (ε / 2) ⊆ e.target := hsmall.trans hball
  have hec : Continuous (fun z : ↥(Metric.closedBall (0 : ℂ) (ε / 2)) ↦ e.symm (z : ℂ)) :=
    e.continuousOn_invFun.comp_continuous continuous_subtype_val (fun z ↦ htarget z.property)
  let F : C(↥(Metric.closedBall (0 : ℂ) (ε / 2)), Y) :=
    ⟨fun z ↦ f (e.symm z), hf.comp hec⟩
  obtain ⟨ψ, hψ⟩ := RiemannRochTop_disk_power_quotient (orderOf k) (orderOf_pos k)
    (ε / 2) (half_pos hε).le F
    (fun v w ↦ hfib v (hsmall v.property) w (hsmall w.property))
  exact ⟨e, hx, he, hehol, heinv, hrot, ε / 2, half_pos hε, htarget, ψ, hψ⟩

/-- RiemannRochTop: a quotient map whose fibers are group orbits is open. -/
lemma RiemannRochTop_galois_isOpenMap
    {X Y G : Type} [TopologicalSpace X] [TopologicalSpace Y] [Group G] [MulAction G X]
    (f : X → Y) (hq : IsQuotientMap f) (hgal : b4_IsGaloisCover G f)
    (hG : ∀ g : G, Continuous (fun x : X ↦ g • x)) : IsOpenMap f := by
  intro U hU
  apply hq.isCoinducing.isOpen_preimage.mp
  have hpre : f ⁻¹' (f '' U) = ⋃ g : G, (fun x : X ↦ g • x) ⁻¹' U := by
    ext z
    constructor
    · rintro ⟨y, hy, hyz⟩
      obtain ⟨g, hg⟩ := hgal.2 z y hyz.symm
      apply Set.mem_iUnion.mpr
      refine ⟨g, ?_⟩
      change g • z ∈ U
      rw [hg]
      exact hy
    · intro hz
      obtain ⟨g, hg⟩ := Set.mem_iUnion.mp hz
      exact ⟨g • z, hg, hgal.1 g z⟩
  rw [hpre]
  exact isOpen_iUnion (fun g ↦ hU.preimage (hG g))

/-- RiemannRochTop: the image of a coordinate disk under an open map is a neighborhood. -/
lemma RiemannRochTop_disk_image_mem_nhds
    {X Y : Type} [TopologicalSpace X] [TopologicalSpace Y]
    (e : OpenPartialHomeomorph X ℂ) (x : X) (hx : x ∈ e.source) (he : e x = 0)
    (r : ℝ) (hr : 0 < r) (hball : Metric.closedBall (0 : ℂ) r ⊆ e.target)
    (f : X → Y) (hf : IsOpenMap f) :
    Set.range (fun z : ↥(Metric.closedBall (0 : ℂ) r) ↦ f (e.symm z)) ∈ 𝓝 (f x) := by
  have hopen : IsOpen (f '' (e.symm '' Metric.ball (0 : ℂ) r)) :=
    hf _ (e.isOpen_image_symm_of_subset_target Metric.isOpen_ball
      (Metric.ball_subset_closedBall.trans hball))
  have hx' : x ∈ e.symm '' Metric.ball (0 : ℂ) r := by
    refine ⟨0, Metric.mem_ball_self hr, ?_⟩
    rw [← he, e.left_inv hx]
  apply Filter.mem_of_superset (hopen.mem_nhds ⟨x, hx', rfl⟩)
  rintro y ⟨u, ⟨z, hz, rfl⟩, rfl⟩
  exact ⟨⟨z, Metric.ball_subset_closedBall hz⟩, rfl⟩

/-- RiemannRochTop: a compact Galois cover has a topological power model over a branch-value neighborhood. -/
lemma RiemannRochTop_branched_disk_model [T2Space C] [CompactSpace C] [ConnectedSpace C]
    {G : Type} [Group G] [Finite G] [MulAction G C]
    (hE : Module.finrank ℂ E = 1)
    (hG : ∀ g : G, ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω (fun x : C ↦ g • x))
    (f : C → OnePoint ℂ) (hf : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω f)
    (hgal : b4_IsGaloisCover G f) (x : C) (k : G) (hk : b4_IsRotGen E x k) :
    ∃ e : OpenPartialHomeomorph C ℂ, x ∈ e.source ∧ e x = 0 ∧
      ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω e x ∧
      ContMDiffAt 𝓘(ℂ, ℂ) 𝓘(ℂ, E) ω e.symm 0 ∧
      (∀ᶠ z in 𝓝 (0 : ℂ),
        e.symm (Complex.exp (2 * Real.pi * Complex.I / (orderOf k : ℂ)) * z) = k • e.symm z) ∧
      ∃ r : ℝ, 0 < r ∧ Metric.closedBall (0 : ℂ) r ⊆ e.target ∧
        Set.range (fun z : ↥(Metric.closedBall (0 : ℂ) r) ↦ f (e.symm z)) ∈ 𝓝 (f x) ∧
        ∃ ψ : ↥(Metric.closedBall (0 : ℂ) (r ^ orderOf k)) ≃ₜ
            ↥(Set.range (fun z : ↥(Metric.closedBall (0 : ℂ) r) ↦ f (e.symm z))),
          ∀ (z : ↥(Metric.closedBall (0 : ℂ) r))
            (w : ↥(Metric.closedBall (0 : ℂ) (r ^ orderOf k))),
            (w : ℂ) = (z : ℂ) ^ orderOf k → (ψ w : OnePoint ℂ) = f (e.symm z) := by
  have hsurj : Function.Surjective f := b4cov_surjective (by simp) f hf
    (b4cov_nonconst_of_galois hE f hgal x)
  have hq : IsQuotientMap f := IsQuotientMap.of_surjective_continuous hsurj hf.continuous
  have hopen := RiemannRochTop_galois_isOpenMap f hq hgal (fun g ↦ (hG g).continuous)
  obtain ⟨e, hx, he, hehol, heinv, hrot, r, hr, hball, ψ, hψ⟩ :=
    RiemannRochTop_local_power_model hE hG f hf.continuous hgal x k hk
  exact ⟨e, hx, he, hehol, heinv, hrot, r, hr, hball,
    RiemannRochTop_disk_image_mem_nhds e x hx he r hr hball f hopen, ψ, hψ⟩

/-- RiemannRochTop: compact Galois covers factor locally through powers and injective holomorphic germs. -/
lemma RiemannRochTop_holomorphic_power_model [T2Space C] [CompactSpace C] [ConnectedSpace C]
    {G : Type} [Group G] [Finite G] [MulAction G C]
    (hE : Module.finrank ℂ E = 1)
    (hG : ∀ g : G, ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω (fun x : C ↦ g • x))
    (f : C → OnePoint ℂ) (hf : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω f)
    (hgal : b4_IsGaloisCover G f) (x : C) (k : G) (hk : b4_IsRotGen E x k) :
    ∃ e : OpenPartialHomeomorph C ℂ, x ∈ e.source ∧ e x = 0 ∧
      ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω e x ∧
      ContMDiffAt 𝓘(ℂ, ℂ) 𝓘(ℂ, E) ω e.symm 0 ∧
      (∀ᶠ z in 𝓝 (0 : ℂ),
        e.symm (Complex.exp (2 * Real.pi * Complex.I / (orderOf k : ℂ)) * z) = k • e.symm z) ∧
      ∃ r : ℝ, 0 < r ∧ Metric.closedBall (0 : ℂ) r ⊆ e.target ∧
        ∃ q : ℂ → OnePoint ℂ, ContMDiffAt 𝓘(ℂ, ℂ) 𝓘(ℂ, ℂ) ω q 0 ∧
          Set.InjOn q (Metric.closedBall (0 : ℂ) (r ^ orderOf k)) ∧
          q '' Metric.closedBall (0 : ℂ) (r ^ orderOf k) ∈ 𝓝 (f x) ∧
          ∀ z ∈ Metric.closedBall (0 : ℂ) r, q (z ^ orderOf k) = f (e.symm z) := by
  obtain ⟨e, hx, he, hehol, heinv, hrot, r, hr, hball, hnhds, ψ, hψ⟩ :=
    RiemannRochTop_branched_disk_model hE hG f hf hgal x k hk
  let ψ' : C(↥(Metric.closedBall (0 : ℂ) (r ^ orderOf k)), OnePoint ℂ) :=
    ⟨fun w ↦ (ψ w : OnePoint ℂ), continuous_subtype_val.comp ψ.continuous⟩
  obtain ⟨q, hqhol, hq⟩ := RiemannRochTop_disk_quotient_holomorphic
    (orderOf k) (orderOf_pos k) r hr (fun z ↦ f (e.symm z))
    (hf.contMDiffAt.comp 0 heinv) ψ' hψ
  refine ⟨e, hx, he, hehol, heinv, hrot, r, hr, hball, q, hqhol, ?_, ?_, ?_⟩
  · intro a ha b hb hab
    have hab' : ψ ⟨a, ha⟩ = ψ ⟨b, hb⟩ := Subtype.ext (by
      change ψ' ⟨a, ha⟩ = ψ' ⟨b, hb⟩
      rw [← hq ⟨a, ha⟩, ← hq ⟨b, hb⟩]
      exact hab)
    exact congrArg Subtype.val (ψ.injective hab')
  · have himage : q '' Metric.closedBall (0 : ℂ) (r ^ orderOf k) =
        Set.range (fun z : ↥(Metric.closedBall (0 : ℂ) r) ↦ f (e.symm z)) := by
      ext y
      constructor
      · rintro ⟨w, hw, rfl⟩
        rw [hq ⟨w, hw⟩]
        exact (ψ ⟨w, hw⟩).property
      · intro hy
        obtain ⟨w, hw⟩ := ψ.surjective ⟨y, hy⟩
        refine ⟨w, w.property, ?_⟩
        rw [hq w]
        exact congrArg Subtype.val hw
    rw [himage]
    exact hnhds
  · intro z hz
    have hw : z ^ orderOf k ∈ Metric.closedBall (0 : ℂ) (r ^ orderOf k) := by
      rw [← RiemannRochTop_power_disk_image (orderOf k) (orderOf_pos k) r hr.le]
      exact ⟨z, hz, rfl⟩
    exact (hq ⟨z ^ orderOf k, hw⟩).trans (hψ ⟨z, hz⟩ ⟨z ^ orderOf k, hw⟩ rfl)

/-- RiemannRochTop: compact Galois covers have a power normal form in holomorphic coordinates. -/
lemma RiemannRochTop_biholomorphic_power_normal_form
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    {G : Type} [Group G] [Finite G] [MulAction G C]
    (hE : Module.finrank ℂ E = 1)
    (hG : ∀ g : G, ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω (fun x : C ↦ g • x))
    (f : C → OnePoint ℂ) (hf : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω f)
    (hgal : b4_IsGaloisCover G f) (x : C) (k : G) (hk : b4_IsRotGen E x k) :
    ∃ e : OpenPartialHomeomorph C ℂ, ∃ d : OpenPartialHomeomorph (OnePoint ℂ) ℂ,
      x ∈ e.source ∧ e x = 0 ∧ f x ∈ d.source ∧ d (f x) = 0 ∧
      ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω e x ∧
      ContMDiffAt 𝓘(ℂ, ℂ) 𝓘(ℂ, E) ω e.symm 0 ∧
      ContMDiffAt 𝓘(ℂ, ℂ) 𝓘(ℂ, ℂ) ω d (f x) ∧
      ContMDiffAt 𝓘(ℂ, ℂ) 𝓘(ℂ, ℂ) ω d.symm 0 ∧
      (∀ᶠ z in 𝓝 (0 : ℂ),
        e.symm (Complex.exp (2 * Real.pi * Complex.I / (orderOf k : ℂ)) * z) = k • e.symm z) ∧
      ∀ᶠ z in 𝓝 (0 : ℂ), d (f (e.symm z)) = z ^ orderOf k := by
  obtain ⟨e, hx, he, hehol, heinv, hrot, r, hr, hball, q, hqhol, hqinj, _, hpower⟩ :=
    RiemannRochTop_holomorphic_power_model hE hG f hf hgal x k hk
  have hqx : q 0 = f x := by
    have h := hpower 0 (Metric.mem_closedBall_self hr.le)
    rw [zero_pow (orderOf_pos k).ne', ← he, e.left_inv hx] at h
    simpa only [he] using h
  obtain ⟨D, hD0, hD, hDq, hDhol, hDinv⟩ :=
    RiemannRochTop_injective_holomorphic_coordinates q 0 hqhol
      (Metric.closedBall 0 (r ^ orderOf k))
      (Metric.closedBall_mem_nhds _ (pow_pos hr (orderOf k))) hqinj
  have hDfx : D 0 = f x := hD.trans hqx
  have hfx : f x ∈ D.target := hDfx ▸ D.map_source hD0
  have hzero : D.symm (f x) = 0 := by rw [← hDfx, D.left_inv hD0]
  refine ⟨e, D.symm, hx, he, hfx, hzero, hehol, heinv, ?_, hDhol, hrot, ?_⟩
  · simpa only [hqx] using hDinv
  · have hp : Tendsto (fun z : ℂ ↦ z ^ orderOf k) (𝓝 0) (𝓝 0) := by
      have ht : Tendsto (fun z : ℂ ↦ z ^ orderOf k) (𝓝 0)
          (𝓝 ((0 : ℂ) ^ orderOf k)) := (continuous_pow (orderOf k)).tendsto 0
      rw [zero_pow (orderOf_pos k).ne'] at ht
      exact ht
    filter_upwards [Metric.closedBall_mem_nhds (0 : ℂ) hr, hp.eventually hDq,
      hp.eventually (D.open_source.mem_nhds hD0)] with z hz hqz hDz
    change D.symm (f (e.symm z)) = z ^ orderOf k
    rw [← hpower z hz, ← hqz, D.left_inv hDz]

/-- RiemannRochTop: a fractional circular turn maps to one positive turn under a power map. -/
lemma RiemannRochTop_circular_arc_power (n : ℕ) (hn : 0 < n) (t : ℝ) (v : ℂ) :
    (Complex.exp (((t * (2 * Real.pi / (n : ℝ)) : ℝ) : ℂ) * Complex.I) * v) ^ n =
      Complex.exp (((t * (2 * Real.pi) : ℝ) : ℂ) * Complex.I) * v ^ n := by
  rw [mul_pow, ← Complex.exp_nat_mul]
  have hangle : (n : ℂ) * (((t * (2 * Real.pi / (n : ℝ)) : ℝ) : ℂ) * Complex.I) =
      (((t * (2 * Real.pi) : ℝ) : ℂ) * Complex.I) := by
    push_cast
    field_simp [Nat.cast_ne_zero.mpr hn.ne'] <;> ring
  rw [hangle]

/-- RiemannRochTop: equivariant power coordinates give lifts of positive target-coordinate circles. -/
lemma RiemannRochTop_power_coordinate_circle_lift
    {X Y G : Type} [TopologicalSpace X] [TopologicalSpace Y] [Group G] [MulAction G X]
    (e : OpenPartialHomeomorph X ℂ) (d : OpenPartialHomeomorph Y ℂ) (f : X → Y)
    (k : G) (n : ℕ) (hn : 0 < n) (h0 : (0 : ℂ) ∈ e.target)
    (hsrc : ∀ᶠ z in 𝓝 (0 : ℂ), f (e.symm z) ∈ d.source)
    (hrot : ∀ᶠ z in 𝓝 (0 : ℂ),
      e.symm (Complex.exp (2 * Real.pi * Complex.I / (n : ℂ)) * z) = k • e.symm z)
    (hpow : ∀ᶠ z in 𝓝 (0 : ℂ), d (f (e.symm z)) = z ^ n) :
    ∃ r : ℝ, 0 < r ∧ ∀ v : ℂ, ‖v‖ < r → v ≠ 0 →
      ∃ Γ : C(unitInterval, X), Γ 0 = e.symm v ∧ Γ 1 = k • Γ 0 ∧
        ∀ t, Γ t ∈ e.source ∧ f (Γ t) ∈ d.source ∧
          d (f (Γ t)) = Complex.exp ((((t : ℝ) * (2 * Real.pi) : ℝ) : ℂ) * Complex.I) * v ^ n ∧
          Γ t ≠ e.symm 0 := by
  have hnear : ∀ᶠ z in 𝓝 (0 : ℂ), z ∈ e.target ∧ f (e.symm z) ∈ d.source ∧
      e.symm (Complex.exp (2 * Real.pi * Complex.I / (n : ℂ)) * z) = k • e.symm z ∧
      d (f (e.symm z)) = z ^ n := by
    filter_upwards [e.open_target.mem_nhds h0, hsrc, hrot, hpow] with z hz hs hr hp
    exact ⟨hz, hs, hr, hp⟩
  obtain ⟨r, hr, hball⟩ := Metric.eventually_nhds_iff_ball.mp hnear
  refine ⟨r, hr, ?_⟩
  intro v hv hv0
  let q : unitInterval → ℂ := fun t ↦
    Complex.exp ((((t : ℝ) * (2 * Real.pi / (n : ℝ)) : ℝ) : ℂ) * Complex.I) * v
  have hq : Continuous q := by fun_prop
  have hqb : ∀ t, q t ∈ Metric.ball 0 r := by
    intro t
    simpa only [Metric.mem_ball, dist_zero_right, q, norm_mul,
      Complex.norm_exp_ofReal_mul_I, one_mul] using hv
  let Γ : C(unitInterval, X) := ⟨e.symm ∘ q,
    e.continuousOn_invFun.comp_continuous hq (fun t ↦ (hball _ (hqb t)).1)⟩
  have hΓ0 : Γ 0 = e.symm v := by simp [Γ, q]
  refine ⟨Γ, hΓ0, ?_, ?_⟩
  · rw [hΓ0]
    have hθ : ((2 * Real.pi / (n : ℝ) : ℝ) : ℂ) * Complex.I =
        2 * Real.pi * Complex.I / (n : ℂ) := by push_cast; ring
    have hvb : v ∈ Metric.ball (0 : ℂ) r := by simpa only [Metric.mem_ball, dist_zero_right] using hv
    change e.symm (q 1) = k • e.symm v
    simp only [q, Set.Icc.coe_one, one_mul, hθ]
    exact (hball v hvb).2.2.1
  · intro t
    refine ⟨e.map_target (hball _ (hqb t)).1, (hball _ (hqb t)).2.1, ?_, ?_⟩
    · change d (f (e.symm (q t))) = _
      rw [(hball _ (hqb t)).2.2.2]
      exact RiemannRochTop_circular_arc_power n hn t v
    · intro heq
      have hz : q t = 0 := by
        calc
          q t = e (Γ t) := (e.right_inv (hball _ (hqb t)).1).symm
          _ = e (e.symm 0) := congrArg e heq
          _ = 0 := e.right_inv h0
      exact mul_ne_zero (Complex.exp_ne_zero _) hv0 hz

/-- RiemannRochTop: positive holomorphic-coordinate circles have rotation lifts avoiding finite branch sets. -/
lemma RiemannRochTop_rotGen_coordinate_circle_lifts
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    {G : Type} [Group G] [Finite G] [MulAction G C]
    (hE : Module.finrank ℂ E = 1)
    (hG : ∀ k : G, ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω (fun x : C ↦ k • x))
    (f : C → OnePoint ℂ) (hf : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω f)
    (hgal : b4_IsGaloisCover G f) (B : Set (OnePoint ℂ)) (hB : B.Finite)
    (x : C) (k : G) (hk : b4_IsRotGen E x k) :
    ∃ d : OpenPartialHomeomorph (OnePoint ℂ) ℂ, f x ∈ d.source ∧ d (f x) = 0 ∧
      ContMDiffAt 𝓘(ℂ, ℂ) 𝓘(ℂ, ℂ) ω d (f x) ∧
      ContMDiffAt 𝓘(ℂ, ℂ) 𝓘(ℂ, ℂ) ω d.symm 0 ∧
      ∃ r : ℝ, 0 < r ∧ ∀ v : ℂ, ‖v‖ < r → v ≠ 0 →
        ∃ Γ : C(unitInterval, C), Γ 1 = k • Γ 0 ∧
          ∀ t, f (Γ t) ∈ d.source ∧ f (Γ t) ∉ B ∧
            f (Γ t) = d.symm
              (Complex.exp ((((t : ℝ) * (2 * Real.pi) : ℝ) : ℂ) * Complex.I) * v ^ orderOf k) := by
  obtain ⟨e, d, hx, he, hfx, hd0, _, _, hdhol, hdinv, hrot, hpow⟩ :=
    RiemannRochTop_biholomorphic_power_normal_form hE hG f hf hgal x k hk
  let V := (B \ {f x})ᶜ
  have hV : IsOpen V := hB.sdiff.isClosed.isOpen_compl
  let d' := d.restrOpen V hV
  have hfx' : f x ∈ d'.source := ⟨hfx, by simp [V]⟩
  have hd0' : d' (f x) = 0 := hd0
  have hdhol' : ContMDiffAt 𝓘(ℂ, ℂ) 𝓘(ℂ, ℂ) ω d' (f x) := by
    simpa only [d', OpenPartialHomeomorph.coe_restrOpen] using hdhol
  have hdinv' : ContMDiffAt 𝓘(ℂ, ℂ) 𝓘(ℂ, ℂ) ω d'.symm 0 := by
    simpa only [d', OpenPartialHomeomorph.coe_restrOpen_symm] using hdinv
  have h0 : (0 : ℂ) ∈ e.target := he ▸ e.map_source hx
  have hei : e.symm 0 = x := by rw [← he, e.left_inv hx]
  have hc : ContinuousAt (fun z : ℂ ↦ f (e.symm z)) 0 :=
    hf.continuous.continuousAt.comp (e.continuousAt_symm h0)
  have hsrc : ∀ᶠ z in 𝓝 (0 : ℂ), f (e.symm z) ∈ d'.source := by
    apply hc.preimage_mem_nhds
    rw [hei]
    exact d'.open_source.mem_nhds hfx'
  have hpow' : ∀ᶠ z in 𝓝 (0 : ℂ), d' (f (e.symm z)) = z ^ orderOf k := hpow
  obtain ⟨r, hr, hcirc⟩ := RiemannRochTop_power_coordinate_circle_lift
    e d' f k (orderOf k) (orderOf_pos k) h0 hsrc hrot hpow'
  refine ⟨d', hfx', hd0', hdhol', hdinv', r, hr, ?_⟩
  intro v hv hv0
  obtain ⟨Γ, _, hend, hΓ⟩ := hcirc v hv hv0
  refine ⟨Γ, hend, ?_⟩
  intro t
  have hneq : f (Γ t) ≠ f x := by
    intro heq
    have hz : d' (f (Γ t)) = 0 := by rw [heq, hd0']
    exact mul_ne_zero (Complex.exp_ne_zero _) (pow_ne_zero _ hv0)
      ((hΓ t).2.2.1.symm.trans hz)
  refine ⟨(hΓ t).2.1, ?_, ?_⟩
  · intro hmem
    exact (hΓ t).2.1.2 ⟨hmem, hneq⟩
  · exact (d'.left_inv (hΓ t).2.1).symm.trans (congrArg d'.symm (hΓ t).2.2.1)

/-- RiemannRochTop: positive coordinate-circle classes have rotation monodromy for every lifted representative. -/
lemma RiemannRochTop_rotGen_coordinate_circle_classes
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    {G : Type} [Group G] [Finite G] [MulAction G C]
    (hE : Module.finrank ℂ E = 1)
    (hG : ∀ k : G, ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω (fun x : C ↦ k • x))
    (f : C → OnePoint ℂ) (hf : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω f)
    (hgal : b4_IsGaloisCover G f) (B : Set (OnePoint ℂ)) (hB : B.Finite)
    (hfree : ∀ x, f x ∉ B → MulAction.stabilizer G x = ⊥)
    (x : C) (k : G) (hk : b4_IsRotGen E x k) :
    ∃ d : OpenPartialHomeomorph (OnePoint ℂ) ℂ, f x ∈ d.source ∧ d (f x) = 0 ∧
      ContMDiffAt 𝓘(ℂ, ℂ) 𝓘(ℂ, ℂ) ω d (f x) ∧
      ContMDiffAt 𝓘(ℂ, ℂ) 𝓘(ℂ, ℂ) ω d.symm 0 ∧
      ∃ r : ℝ, 0 < r ∧ ∀ v : ℂ, ‖v‖ < r → v ≠ 0 →
        ∃ (y : ↥Bᶜ) (c : Path y y),
          (∀ t, (c t : OnePoint ℂ) ∈ d.source ∧
            (c t : OnePoint ℂ) = d.symm
              (Complex.exp ((((t : ℝ) * (2 * Real.pi) : ℝ) : ℂ) * Complex.I) * v ^ orderOf k)) ∧
          ∀ (c' : Path y y), FundamentalGroup.fromPath ⟦c'⟧ = FundamentalGroup.fromPath ⟦c⟧ →
            ∀ (Γ : C(unitInterval, C)) (l : G), (∀ t, f (Γ t) = (c' t : OnePoint ℂ)) →
              Γ 1 = l • Γ 0 → ∃ q, f q = f x ∧ b4_IsRotGen E q l := by
  obtain ⟨d, hx, hd0, hdhol, hdinv, r, hr, hcirc⟩ :=
    RiemannRochTop_rotGen_coordinate_circle_lifts hE hG f hf hgal B hB x k hk
  refine ⟨d, hx, hd0, hdhol, hdinv, r, hr, ?_⟩
  intro v hv hv0
  obtain ⟨Δ, hend, hΔ⟩ := hcirc v hv hv0
  let y : ↥Bᶜ := ⟨f (Δ 0), (hΔ 0).2.1⟩
  let c : Path y y := {
    toFun := fun t ↦ ⟨f (Δ t), (hΔ t).2.1⟩
    continuous_toFun := (hf.continuous.comp Δ.continuous).subtype_mk (fun t ↦ (hΔ t).2.1)
    source' := rfl
    target' := Subtype.ext (by change f (Δ 1) = f (Δ 0); rw [hend, hgal.1]) }
  refine ⟨y, c, fun t ↦ ⟨(hΔ t).1, (hΔ t).2.2⟩, ?_⟩
  intro c' heq Γ l hΓ hΓend
  exact RiemannRochTop_rotGen_of_reference_lift hE hG f hf hgal B hfree c' c heq
    Γ Δ l k hΓ (fun _ ↦ rfl) hΓend hend x hk

/-- RiemannRochTop: small positive circles in any holomorphic chart have rotation monodromy. -/
lemma RiemannRochTop_rotGen_prescribed_chart_circles
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    {G : Type} [Group G] [Finite G] [MulAction G C]
    (hE : Module.finrank ℂ E = 1)
    (hG : ∀ k : G, ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω (fun x : C ↦ k • x))
    (f : C → OnePoint ℂ) (hf : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω f)
    (hgal : b4_IsGaloisCover G f) (B : Set (OnePoint ℂ)) (hB : B.Finite)
    (hfree : ∀ x, f x ∉ B → MulAction.stabilizer G x = ⊥)
    (x : C) (k : G) (hk : b4_IsRotGen E x k)
    (e : OpenPartialHomeomorph (OnePoint ℂ) ℂ)
    (hex : f x ∈ e.source) (he0 : e (f x) = 0)
    (he : ContMDiffAt 𝓘(ℂ, ℂ) 𝓘(ℂ, ℂ) ω e (f x)) :
    ∃ r : ℝ, 0 < r ∧ ∀ w : ℂ, ‖w‖ < r → w ≠ 0 →
      ∃ (y : ↥Bᶜ) (c : Path y y),
        (∀ t, (c t : OnePoint ℂ) = e.symm
          (Complex.exp ((((t : ℝ) * (2 * Real.pi) : ℝ) : ℂ) * Complex.I) * w)) ∧
        ∀ (c' : Path y y), FundamentalGroup.fromPath ⟦c'⟧ = FundamentalGroup.fromPath ⟦c⟧ →
          ∀ (Γ : C(unitInterval, C)) (l : G), (∀ t, f (Γ t) = (c' t : OnePoint ℂ)) →
            Γ 1 = l • Γ 0 → ∃ q, f q = f x ∧ b4_IsRotGen E q l := by
  obtain ⟨d, hdx, hd0, _, hd, R, hR, hcirc⟩ :=
    RiemannRochTop_rotGen_coordinate_circle_lifts hE hG f hf hgal B hB x k hk
  obtain ⟨s, hs, j, g, hjg, ⟨H⟩⟩ :=
    RiemannRochTop_sphere_charts_homotopy d e (f x) hdx hex hd0 he0 hd he B hB
  refine ⟨min s (R ^ orderOf k), lt_min hs (pow_pos hR _), ?_⟩
  intro w hw hw0
  have hws : ‖w‖ < s := lt_of_lt_of_le hw (min_le_left _ _)
  have hwR : ‖w‖ < R ^ orderOf k := lt_of_lt_of_le hw (min_le_right _ _)
  obtain ⟨v, hvpow⟩ := IsAlgClosed.exists_pow_nat_eq w (orderOf_pos k)
  have hv : ‖v‖ < R := by
    apply (pow_lt_pow_iff_left₀ (norm_nonneg v) hR.le (orderOf_pos k).ne').mp
    simpa only [← norm_pow, hvpow] using hwR
  have hv0 : v ≠ 0 := by
    intro hz
    apply hw0
    rw [← hvpow, hz, zero_pow (orderOf_pos k).ne']
  obtain ⟨Δ, hend, hΔ⟩ := hcirc v hv hv0
  obtain ⟨p, hp⟩ := RiemannRochTop_positive_circle_path s w hws hw0
  have hΔg : ∀ t, f (Δ t) = (g (p t) : OnePoint ℂ) := by
    intro t
    rw [(hjg (p t)).2, hp t, ← hvpow]
    exact (hΔ t).2.2
  let T : C(C, C) := ⟨fun z ↦ k • z, (hG k).continuous⟩
  obtain ⟨Λ, hΛ, hΛend⟩ := RiemannRochTop_coveringOn_homotopy_lift f B
    (RiemannRochTop_galois_coveringOn hE hG f hf hgal B hfree)
    T (hgal.1 k) H.symm ⟨w, hws, hw0⟩ p Δ hΔg hend
  let c := p.map j.continuous
  refine ⟨j ⟨w, hws, hw0⟩, c, ?_, ?_⟩
  · intro t
    exact ((hjg (p t)).1).trans (congrArg e.symm (hp t))
  · intro c' heq Γ l hΓ hΓend
    exact RiemannRochTop_rotGen_of_reference_lift hE hG f hf hgal B hfree c' c heq
      Γ Λ l k hΓ hΛ hΓend hΛend x hk

/-- RiemannRochTop: every positive circle in a puncture chart has rotation monodromy. -/
lemma RiemannRochTop_rotGen_fixed_chart_circle
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    {G : Type} [Group G] [Finite G] [MulAction G C]
    (hE : Module.finrank ℂ E = 1)
    (hG : ∀ k : G, ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω (fun x : C ↦ k • x))
    (f : C → OnePoint ℂ) (hf : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω f)
    (hgal : b4_IsGaloisCover G f) (B : Set (OnePoint ℂ)) (hB : B.Finite)
    (hfree : ∀ x, f x ∉ B → MulAction.stabilizer G x = ⊥)
    (x : C) (k : G) (hk : b4_IsRotGen E x k)
    (e : OpenPartialHomeomorph (OnePoint ℂ) ℂ)
    (hex : f x ∈ e.source) (he0 : e (f x) = 0)
    (he : ContMDiffAt 𝓘(ℂ, ℂ) 𝓘(ℂ, ℂ) ω e (f x))
    (R : ℝ) (hball : Metric.ball (0 : ℂ) R ⊆ e.target)
    (havoid : ∀ z : ℂ, ‖z‖ < R → z ≠ 0 → e.symm z ∉ B)
    (w : ℂ) (hw : ‖w‖ < R) (hw0 : w ≠ 0)
    (Γ : C(unitInterval, C)) (l : G)
    (hΓ : ∀ t, f (Γ t) = e.symm
      (Complex.exp ((((t : ℝ) * (2 * Real.pi) : ℝ) : ℂ) * Complex.I) * w))
    (hΓend : Γ 1 = l • Γ 0) :
    ∃ q, f q = f x ∧ b4_IsRotGen E q l := by
  obtain ⟨s, hs, hsmall⟩ := RiemannRochTop_rotGen_prescribed_chart_circles
    hE hG f hf hgal B hB hfree x k hk e hex he0 he
  have hwn : 0 < ‖w‖ := norm_pos_iff.mpr hw0
  let a : ℝ := min 1 (s / (2 * ‖w‖))
  have ha : 0 < a := lt_min zero_lt_one (div_pos hs (by positivity))
  have ha1 : a ≤ 1 := min_le_left _ _
  have haw : ‖(a : ℂ) * w‖ < s := by
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos ha]
    have hab := (le_div_iff₀ (by positivity : 0 < 2 * ‖w‖)).mp (min_le_right 1 (s / (2 * ‖w‖)))
    change a * (2 * ‖w‖) ≤ s at hab
    nlinarith
  have haw0 : (a : ℂ) * w ≠ 0 := mul_ne_zero (Complex.ofReal_ne_zero.mpr ha.ne') hw0
  obtain ⟨y, c, hc, hrot⟩ := hsmall ((a : ℂ) * w) haw haw0
  obtain ⟨j, g, hjg, ⟨H⟩⟩ := RiemannRochTop_punctured_disk_shrink_homotopy R a ha ha1
  let W := {z : ℂ // ‖z‖ < R ∧ z ≠ 0}
  have hm : ∀ z : W, e.symm z ∈ Bᶜ := fun z ↦ havoid z z.property.1 z.property.2
  let q : C(W, ↥Bᶜ) := ⟨fun z ↦ ⟨e.symm z, hm z⟩,
    (e.continuousOn_invFun.comp_continuous continuous_subtype_val (fun z ↦ hball
      (by simpa only [Metric.mem_ball, dist_zero_right] using z.property.1))).subtype_mk hm⟩
  obtain ⟨p, hp⟩ := RiemannRochTop_positive_circle_path R w hw hw0
  have hΓj : ∀ t, f (Γ t) = (q (j (p t)) : OnePoint ℂ) := by
    intro t
    change f (Γ t) = e.symm (j (p t))
    rw [(hjg (p t)).1, hp t]
    exact hΓ t
  let T : C(C, C) := ⟨fun z ↦ l • z, (hG l).continuous⟩
  obtain ⟨Δ, hΔ, hΔend⟩ := RiemannRochTop_coveringOn_homotopy_lift f B
    (RiemannRochTop_galois_coveringOn hE hG f hf hgal B hfree)
    T (hgal.1 l) ((ContinuousMap.Homotopy.refl q).comp H) ⟨w, hw, hw0⟩ p Γ hΓj hΓend
  apply hrot c rfl Δ l _ hΔend
  intro t
  rw [hc t]
  change f (Δ t) = e.symm _
  have ht : f (Δ t) = e.symm (g (p t)) := hΔ t
  rw [(hjg (p t)).2, hp t] at ht
  rw [ht]
  congr 1
  ring

/-- RiemannRochTop: fixed puncture-chart circles detect rotation generators without a chosen reference fiber. -/
lemma RiemannRochTop_rotGen_of_chart_circle
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    {G : Type} [Group G] [Finite G] [MulAction G C] [FaithfulSMul G C]
    (hE : Module.finrank ℂ E = 1)
    (hG : ∀ k : G, ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω (fun x : C ↦ k • x))
    (f : C → OnePoint ℂ) (hf : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω f)
    (hgal : b4_IsGaloisCover G f) (B : Set (OnePoint ℂ)) (hB : B.Finite)
    (hfree : ∀ x, f x ∉ B → MulAction.stabilizer G x = ⊥)
    (b : OnePoint ℂ) (e : OpenPartialHomeomorph (OnePoint ℂ) ℂ)
    (heb : b ∈ e.source) (he0 : e b = 0)
    (he : ContMDiffAt 𝓘(ℂ, ℂ) 𝓘(ℂ, ℂ) ω e b)
    (R : ℝ) (hball : Metric.ball (0 : ℂ) R ⊆ e.target)
    (havoid : ∀ z : ℂ, ‖z‖ < R → z ≠ 0 → e.symm z ∉ B)
    (w : ℂ) (hw : ‖w‖ < R) (hw0 : w ≠ 0)
    (Γ : C(unitInterval, C)) (l : G)
    (hΓ : ∀ t, f (Γ t) = e.symm
      (Complex.exp ((((t : ℝ) * (2 * Real.pi) : ℝ) : ℂ) * Complex.I) * w))
    (hΓend : Γ 1 = l • Γ 0) :
    ∃ q, f q = b ∧ b4_IsRotGen E q l := by
  have hsurj : Function.Surjective f := b4cov_surjective (by simp) f hf
    (b4cov_nonconst_of_galois hE f hgal (Γ 0))
  obtain ⟨x, hx⟩ := hsurj b
  obtain ⟨k, hk⟩ := b4cov_exists_rotGen hE hG x
  have hex : f x ∈ e.source := hx ▸ heb
  have hez : e (f x) = 0 := hx ▸ he0
  have heh : ContMDiffAt 𝓘(ℂ, ℂ) 𝓘(ℂ, ℂ) ω e (f x) := hx ▸ he
  obtain ⟨q, hq, hrot⟩ := RiemannRochTop_rotGen_fixed_chart_circle
    hE hG f hf hgal B hB hfree x k hk e hex hez heh R hball havoid w hw hw0 Γ l hΓ hΓend
  exact ⟨q, hq.trans hx, hrot⟩

/-- RiemannRochTop: based positive puncture-circle classes detect rotation generators for every lift. -/
lemma RiemannRochTop_rotGen_based_circle_class
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    {G : Type} [Group G] [Finite G] [MulAction G C] [FaithfulSMul G C]
    (hE : Module.finrank ℂ E = 1)
    (hG : ∀ k : G, ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω (fun x : C ↦ k • x))
    (f : C → OnePoint ℂ) (hf : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω f)
    (hgal : b4_IsGaloisCover G f) (B : Set (OnePoint ℂ)) (hB : B.Finite)
    (hfree : ∀ x, f x ∉ B → MulAction.stabilizer G x = ⊥)
    (b : OnePoint ℂ) (e : OpenPartialHomeomorph (OnePoint ℂ) ℂ)
    (heb : b ∈ e.source) (he0 : e b = 0)
    (he : ContMDiffAt 𝓘(ℂ, ℂ) 𝓘(ℂ, ℂ) ω e b)
    (R : ℝ) (hball : Metric.ball (0 : ℂ) R ⊆ e.target)
    (havoid : ∀ z : ℂ, ‖z‖ < R → z ≠ 0 → e.symm z ∉ B)
    (w : ℂ) (hw : ‖w‖ < R) (hw0 : w ≠ 0)
    {y₀ y : ↥Bᶜ} (a : Path y₀ y) (d : Path y y)
    (hd : ∀ t, (d t : OnePoint ℂ) = e.symm
      (Complex.exp ((((t : ℝ) * (2 * Real.pi) : ℝ) : ℂ) * Complex.I) * w))
    (c : Path y₀ y₀)
    (hc : FundamentalGroup.fromPath ⟦c⟧ =
      FundamentalGroup.fromPath ⟦a.trans (d.trans a.symm)⟧)
    (Γ : C(unitInterval, C)) (l : G)
    (hΓ : ∀ t, f (Γ t) = (c t : OnePoint ℂ)) (hΓend : Γ 1 = l • Γ 0) :
    ∃ q, f q = b ∧ b4_IsRotGen E q l := by
  have hcover := RiemannRochTop_galois_coveringOn hE hG f hf hgal B hfree
  obtain ⟨Δ, hΔ, hΔ0, hΔ1⟩ := RiemannRochTop_coveringOn_replace_loop f B hcover
    c (a.trans (d.trans a.symm)) hc Γ hΓ
  have hend : Δ 1 = l • Δ 0 := by rw [hΔ0, hΔ1]; exact hΓend
  let T : C(C, C) := ⟨fun z ↦ l • z, (hG l).continuous⟩
  obtain ⟨Λ, hΛ, hΛend⟩ := RiemannRochTop_coveringOn_conjugated_loop_lift
    f B hcover T (hgal.1 l) a d Δ hΔ hend
  exact RiemannRochTop_rotGen_of_chart_circle hE hG f hf hgal B hB hfree
    b e heb he0 he R hball havoid w hw hw0 Λ l (fun t ↦ (hΛ t).trans (hd t)) hΛend

/-- RiemannRochTop: affine translation gives normalized holomorphic sphere charts with full target. -/
lemma RiemannRochTop_affine_centered_chart (a : ℂ) :
    ∃ e : OpenPartialHomeomorph (OnePoint ℂ) ℂ,
      (a : OnePoint ℂ) ∈ e.source ∧ e a = 0 ∧ e.target = Set.univ ∧
      (∀ z : ℂ, e.symm z = ((a + z : ℂ) : OnePoint ℂ)) ∧
      ContMDiffAt 𝓘(ℂ, ℂ) 𝓘(ℂ, ℂ) ω e (a : OnePoint ℂ) := by
  let e := b4cov_chart0.trans (Homeomorph.addRight (-a)).toOpenPartialHomeomorph
  have hmem : (a : OnePoint ℂ) ∈ b4cov_chart0.source := by
    rw [b4cov_chart0_source]
    exact Set.mem_range_self a
  refine ⟨e, ?_, ?_, ?_, ?_, ?_⟩
  · exact ⟨hmem, Set.mem_univ _⟩
  · change b4cov_chart0 (a : OnePoint ℂ) + -a = 0
    rw [b4cov_chart0_coe, add_neg_cancel]
  · simp [e, b4cov_chart0_target]
  · intro z
    change b4cov_chart0.symm (z - -a) = _
    rw [b4cov_chart0_symm]
    congr 1
    abel
  · have h := contMDiffAt_of_mem_maximalAtlas
      (IsManifold.chart_mem_maximalAtlas (I := 𝓘(ℂ, ℂ)) (n := ω) (a : OnePoint ℂ)) hmem
    change ContMDiffAt 𝓘(ℂ, ℂ) 𝓘(ℂ, ℂ) ω (fun z ↦ b4cov_chart0 z + -a) (a : OnePoint ℂ)
    exact h.add contMDiffAt_const

/-- RiemannRochTop: based affine positive circles detect rotation generators in sphere covers. -/
lemma RiemannRochTop_rotGen_affine_circle
    {E C : Type} [NormedAddCommGroup E] [NormedSpace ℂ E]
    [TopologicalSpace C] [ChartedSpace E C] [IsManifold 𝓘(ℂ, E) ω C]
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    {G : Type} [Group G] [Finite G] [MulAction G C] [FaithfulSMul G C]
    (hE : Module.finrank ℂ E = 1)
    (hG : ∀ k : G, ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω (fun x : C ↦ k • x))
    (f : C → OnePoint ℂ) (hf : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω f)
    (hgal : b4_IsGaloisCover G f) (B : Set (OnePoint ℂ)) (hB : B.Finite)
    (hfree : ∀ x, f x ∉ B → MulAction.stabilizer G x = ⊥)
    (a : ℂ) (R : ℝ)
    (havoid : ∀ z : ℂ, ‖z‖ < R → z ≠ 0 → ((a + z : ℂ) : OnePoint ℂ) ∉ B)
    (w : ℂ) (hw : ‖w‖ < R) (hw0 : w ≠ 0)
    {y₀ y : ↥Bᶜ} (k : Path y₀ y) (d : Path y y)
    (hd : ∀ t, (d t : OnePoint ℂ) =
      ((a + Complex.exp ((((t : ℝ) * (2 * Real.pi) : ℝ) : ℂ) * Complex.I) * w : ℂ) : OnePoint ℂ))
    (c : Path y₀ y₀)
    (hc : FundamentalGroup.fromPath ⟦c⟧ =
      FundamentalGroup.fromPath ⟦(k.trans d).trans k.symm⟧)
    (Γ : C(unitInterval, C)) (l : G)
    (hΓ : ∀ t, f (Γ t) = (c t : OnePoint ℂ)) (hΓend : Γ 1 = l • Γ 0) :
    ∃ q, f q = (a : OnePoint ℂ) ∧ b4_IsRotGen E q l := by
  obtain ⟨e, hea, he0, heT, heinv, he⟩ := RiemannRochTop_affine_centered_chart a
  apply RiemannRochTop_rotGen_based_circle_class hE hG f hf hgal B hB hfree
    a e hea he0 he R (by rw [heT]; exact Set.subset_univ _) _ w hw hw0 k d _ c _ Γ l hΓ hΓend
  · intro z hz hz0
    rw [heinv]
    exact havoid z hz hz0
  · intro t
    rw [heinv]
    exact hd t
  · exact hc.trans (congrArg FundamentalGroup.fromPath
      (Quotient.sound (Path.Homotopic.trans_assoc k d k.symm)))

/-- RiemannRochTop: reversing a positive circular turn inverts its complex exponential. -/
lemma RiemannRochTop_positive_turn_reverse (t : unitInterval) :
    Complex.exp ((((unitInterval.symm t : ℝ) * (2 * Real.pi) : ℝ) : ℂ) * Complex.I) =
      (Complex.exp ((((t : ℝ) * (2 * Real.pi) : ℝ) : ℂ) * Complex.I))⁻¹ := by
  have he : ((((unitInterval.symm t : ℝ) * (2 * Real.pi) : ℝ) : ℂ) * Complex.I) =
      2 * Real.pi * Complex.I + -((((t : ℝ) * (2 * Real.pi) : ℝ) : ℂ) * Complex.I) := by
    change (((1 - (t : ℝ)) * (2 * Real.pi) : ℝ) : ℂ) * Complex.I = _
    push_cast
    ring
  rw [he, Complex.exp_add, Complex.exp_two_pi_mul_I, one_mul, Complex.exp_neg]

/-- RiemannRochTop: reversed affine circles detect positive rotation at infinity. -/
lemma RiemannRochTop_rotGen_infinity_circle
    {E C : Type} [NormedAddCommGroup E] [NormedSpace ℂ E]
    [TopologicalSpace C] [ChartedSpace E C] [IsManifold 𝓘(ℂ, E) ω C]
    [T2Space C] [CompactSpace C] [ConnectedSpace C]
    {G : Type} [Group G] [Finite G] [MulAction G C] [FaithfulSMul G C]
    (hE : Module.finrank ℂ E = 1)
    (hG : ∀ k : G, ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω (fun x : C ↦ k • x))
    (f : C → OnePoint ℂ) (hf : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω f)
    (hgal : b4_IsGaloisCover G f) (B : Set (OnePoint ℂ)) (hB : B.Finite)
    (hfree : ∀ x, f x ∉ B → MulAction.stabilizer G x = ⊥)
    (a : ℂ) (R : ℝ)
    (havoid : ∀ z : ℂ, ‖z‖ < R → z ≠ 0 → ((a + z⁻¹ : ℂ) : OnePoint ℂ) ∉ B)
    (w : ℂ) (hw : ‖w⁻¹‖ < R) (hw0 : w ≠ 0)
    {y₀ y : ↥Bᶜ} (k : Path y₀ y) (d : Path y y)
    (hd : ∀ t, (d t : OnePoint ℂ) =
      ((a + Complex.exp ((((t : ℝ) * (2 * Real.pi) : ℝ) : ℂ) * Complex.I) * w : ℂ) : OnePoint ℂ))
    (c : Path y₀ y₀)
    (hc : FundamentalGroup.fromPath ⟦c⟧ =
      FundamentalGroup.fromPath ⟦(k.trans d.symm).trans k.symm⟧)
    (Γ : C(unitInterval, C)) (l : G)
    (hΓ : ∀ t, f (Γ t) = (c t : OnePoint ℂ)) (hΓend : Γ 1 = l • Γ 0) :
    ∃ q, f q = OnePoint.infty ∧ b4_IsRotGen E q l := by
  obtain ⟨e, heinfty, he0, heT, _, heinv, he⟩ := RiemannRochTop_inverse_affine_chart a
  apply RiemannRochTop_rotGen_based_circle_class hE hG f hf hgal B hB hfree
    OnePoint.infty e heinfty he0 he R (by rw [heT]; exact Set.subset_univ _)
      _ w⁻¹ hw (inv_ne_zero hw0) k d.symm _ c _ Γ l hΓ hΓend
  · intro z hz hz0
    rw [heinv z hz0]
    exact havoid z hz hz0
  · intro t
    rw [heinv _ (mul_ne_zero (Complex.exp_ne_zero _) (inv_ne_zero hw0))]
    change (d (unitInterval.symm t) : OnePoint ℂ) = _
    rw [hd, RiemannRochTop_positive_turn_reverse, mul_inv_rev, inv_inv]
    congr 1
    ring
  · exact hc.trans (congrArg FundamentalGroup.fromPath
      (Quotient.sound (Path.Homotopic.trans_assoc k d.symm k.symm)))

/-- RiemannRochTop: inverse-coordinate disks avoid punctures bounded in the affine plane. -/
lemma RiemannRochTop_infinity_disk_avoids (B : Set (OnePoint ℂ))
    (a : ℂ) (ρ : ℝ) (hρ : 0 < ρ)
    (hbound : ∀ b : ℂ, (b : OnePoint ℂ) ∈ B → ‖b - a‖ < ρ) :
    ∀ z : ℂ, ‖z‖ < ρ⁻¹ → z ≠ 0 → ((a + z⁻¹ : ℂ) : OnePoint ℂ) ∉ B := by
  intro z hz hz0 hmem
  have hb := hbound (a + z⁻¹) hmem
  simp only [add_sub_cancel_left, norm_inv] at hb
  have hh : ρ < ‖z‖⁻¹ := (lt_inv_comm₀ hρ (norm_pos_iff.mpr hz0)).mpr hz
  exact (lt_irrefl ρ) (hh.trans hb)

/-- RiemannRochTop: the finite affine part of a sphere puncture set has a uniform radius bound. -/
lemma RiemannRochTop_finite_sphere_affine_bound (B : Set (OnePoint ℂ)) (hB : B.Finite)
    (a : ℂ) : ∃ ρ : ℝ, 0 < ρ ∧ ∀ b : ℂ, (b : OnePoint ℂ) ∈ B → ‖b - a‖ < ρ := by
  let A := ((↑) : ℂ → OnePoint ℂ) ⁻¹' B
  have hA : A.Finite := hB.preimage OnePoint.coe_injective.injOn
  obtain ⟨ρ, hρ, hb⟩ := (hA.image (fun b ↦ b - a)).isBounded.exists_pos_norm_lt
  exact ⟨ρ, hρ, fun b hbB ↦ hb (b - a) ⟨b, hbB, rfl⟩⟩

/-- RiemannRochTop: circles outside a bound for affine punctures lie in the sphere complement. -/
lemma RiemannRochTop_outer_affine_circle (B : Set (OnePoint ℂ)) (a : ℂ) (ρ : ℝ)
    (hbound : ∀ b : ℂ, (b : OnePoint ℂ) ∈ B → ‖b - a‖ < ρ)
    (w : ℂ) (hw : ρ ≤ ‖w‖) :
    ∃ y : ↥Bᶜ, ∃ d : Path y y, ∀ t, (d t : OnePoint ℂ) =
      ((a + Complex.exp ((((t : ℝ) * (2 * Real.pi) : ℝ) : ℂ) * Complex.I) * w : ℂ) : OnePoint ℂ) := by
  let q : unitInterval → ℂ := fun t ↦ a +
    Complex.exp ((((t : ℝ) * (2 * Real.pi) : ℝ) : ℂ) * Complex.I) * w
  have hq : ∀ t, (q t : OnePoint ℂ) ∉ B := by
    intro t ht
    have h := hbound (q t) ht
    have he : ‖q t - a‖ = ‖w‖ := by
      simp only [q, add_sub_cancel_left, norm_mul, Complex.norm_exp_ofReal_mul_I, one_mul]
    rw [he] at h
    exact (not_lt_of_ge hw) h
  let y : ↥Bᶜ := ⟨(q 0 : OnePoint ℂ), hq 0⟩
  refine ⟨y, {
    toFun := fun t ↦ ⟨(q t : OnePoint ℂ), hq t⟩
    continuous_toFun := (OnePoint.continuous_coe.comp (by fun_prop : Continuous q)).subtype_mk hq
    source' := rfl
    target' := Subtype.ext (by simp [q, Complex.exp_two_pi_mul_I, y]) }, fun _ ↦ rfl⟩

/-- RiemannRochTop: rotation coordinates can avoid a prescribed finite set away from their center. -/
lemma RiemannRochTop_rotGen_coordinates_avoid [T1Space C]
    {G : Type} [Group G] [Finite G] [MulAction G C]
    (hE : Module.finrank ℂ E = 1)
    (hG : ∀ g : G, ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω (fun x : C ↦ g • x))
    (x : C) (k : G) (hk : b4_IsRotGen E x k) (S : Set C) (hS : S.Finite) :
    ∃ e : OpenPartialHomeomorph C E, x ∈ e.source ∧ e x = 0 ∧
      (∀ y ∈ e.source, y ≠ x → y ∉ S) ∧
      ∃ ε : ℝ, 0 < ε ∧ Metric.ball (0 : E) ε ⊆ e.target ∧
        ∀ z ∈ Metric.ball (0 : E) ε,
          e.symm (Complex.exp (2 * Real.pi * Complex.I / (orderOf k : ℂ)) • z) =
            k • e.symm z := by
  obtain ⟨e, hx, he, _, _, ε, hε, hball, hrot⟩ :=
    RiemannRochTop_rotGen_coordinates hE hG x k hk
  let U := (S \ {x})ᶜ
  have hU : IsOpen U := hS.sdiff.isClosed.isOpen_compl
  have hxU : x ∈ U := by simp [U]
  let d := e.restrOpen U hU
  have hxd : x ∈ d.source := ⟨hx, hxU⟩
  have hd : d x = 0 := he
  have hz : (0 : E) ∈ d.target := hd ▸ d.map_source hxd
  obtain ⟨δ, hδ, hδball⟩ := Metric.isOpen_iff.mp d.open_target 0 hz
  refine ⟨d, hxd, hd, ?_, min ε δ, lt_min hε hδ, ?_, ?_⟩
  · intro y hy hyx hyS
    exact hy.2 ⟨hyS, hyx⟩
  · exact (Metric.ball_subset_ball (min_le_right ε δ)).trans hδball
  · intro z hz
    exact hrot z (Metric.ball_subset_ball (min_le_left ε δ) hz)

/-- RiemannRochTop: rotation arcs can stay in any neighborhood of the fixed point. -/
lemma RiemannRochTop_rotGen_arc_in_open [T1Space C]
    {G : Type} [Group G] [Finite G] [MulAction G C]
    (hE : Module.finrank ℂ E = 1)
    (hG : ∀ g : G, ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω (fun x : C ↦ g • x))
    (x : C) (k : G) (hk : b4_IsRotGen E x k) (S : Set C) (hS : S.Finite)
    (U : Set C) (hU : IsOpen U) (hxU : x ∈ U) :
    ∃ Γ : C(unitInterval, C), Γ 1 = k • Γ 0 ∧ ∀ t, Γ t ∈ U ∧ Γ t ∉ S := by
  obtain ⟨e, hx, he, havoid, ε, hε, hball, hrot⟩ :=
    RiemannRochTop_rotGen_coordinates_avoid hE hG x k hk S hS
  let d := e.restrOpen U hU
  have hxd : x ∈ d.source := ⟨hx, hxU⟩
  have hd : d x = 0 := he
  have hz : (0 : E) ∈ d.target := hd ▸ d.map_source hxd
  obtain ⟨δ, hδ, hδball⟩ := Metric.isOpen_iff.mp d.open_target 0 hz
  have hsmall : 0 < min ε δ := lt_min hε hδ
  have hdball : Metric.ball (0 : E) (min ε δ) ⊆ d.target :=
    (Metric.ball_subset_ball (min_le_right ε δ)).trans hδball
  letI : Nontrivial E := Module.nontrivial_of_finrank_eq_succ hE
  letI : NormedSpace ℝ E := NormedSpace.restrictScalars ℝ ℂ E
  obtain ⟨v, hv⟩ := exists_norm_eq E (le_of_lt (half_pos hsmall))
  have hvball : v ∈ Metric.ball (0 : E) (min ε δ) := by
    simpa only [Metric.mem_ball, dist_zero_right, hv] using half_lt_self hsmall
  have hv0 : v ≠ 0 := by
    intro h
    rw [h, norm_zero] at hv
    linarith
  have hθ : ((2 * Real.pi / (orderOf k : ℝ) : ℝ) : ℂ) * Complex.I =
      2 * Real.pi * Complex.I / (orderOf k : ℂ) := by push_cast; ring
  have hdrot : ∀ z ∈ Metric.ball (0 : E) (min ε δ),
      d.symm (Complex.exp ((2 * Real.pi / (orderOf k : ℝ) : ℝ) * Complex.I) • z) =
        k • d.symm z := by
    intro z hz
    simpa only [hθ, d, OpenPartialHomeomorph.coe_restrOpen_symm] using
      hrot z (Metric.ball_subset_ball (min_le_left ε δ) hz)
  obtain ⟨Γ, _, hend, hΓ⟩ := RiemannRochTop_rotation_arc d x hd k
    (2 * Real.pi / (orderOf k : ℝ)) (min ε δ) hdball hdrot v hvball hv0
  exact ⟨Γ, hend, fun t ↦ ⟨(hΓ t).1.2, havoid (Γ t) (hΓ t).1.1 (hΓ t).2⟩⟩

/-- RiemannRochTop: a rotation generator has an arc avoiding any prescribed finite set. -/
lemma RiemannRochTop_rotGen_arc_avoid [T1Space C]
    {G : Type} [Group G] [Finite G] [MulAction G C]
    (hE : Module.finrank ℂ E = 1)
    (hG : ∀ g : G, ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω (fun x : C ↦ g • x))
    (x : C) (k : G) (hk : b4_IsRotGen E x k) (S : Set C) (hS : S.Finite) :
    ∃ Γ : C(unitInterval, C), Γ 1 = k • Γ 0 ∧ ∀ t, Γ t ∉ S := by
  obtain ⟨Γ, hend, hΓ⟩ := RiemannRochTop_rotGen_arc_in_open hE hG x k hk S hS
    Set.univ isOpen_univ (Set.mem_univ x)
  exact ⟨Γ, hend, fun t ↦ (hΓ t).2⟩

/-- RiemannRochTop: local rotation loops stay in any prescribed neighborhood of the branch value. -/
lemma RiemannRochTop_rotGen_reference_loop_in_open [T1Space C]
    {G : Type} [Group G] [Finite G] [MulAction G C]
    (hE : Module.finrank ℂ E = 1)
    (hG : ∀ g : G, ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω (fun x : C ↦ g • x))
    {Y : Type} [TopologicalSpace Y] (f : C → Y) (hf : Continuous f)
    (hgal : b4_IsGaloisCover G f) (B : Set Y) (hB : B.Finite)
    (x : C) (k : G) (hk : b4_IsRotGen E x k)
    (V : Set Y) (hV : IsOpen V) (hxV : f x ∈ V) :
    ∃ (y : ↥Bᶜ) (d : Path y y) (Γ : C(unitInterval, C)),
      (∀ t, f (Γ t) = (d t : Y)) ∧ Γ 1 = k • Γ 0 ∧ ∀ t, (d t : Y) ∈ V := by
  have hfin : (f ⁻¹' B).Finite := by
    apply hB.preimage'
    intro y _
    by_cases hy : ∃ u, f u = y
    · obtain ⟨u, hu⟩ := hy
      apply (Set.finite_range (fun g : G ↦ g • u)).subset
      intro v hv
      exact hgal.2 u v (hu.trans hv.symm)
    · have hempty : f ⁻¹' {y} = ∅ := by
        ext u
        simp only [Set.mem_preimage, Set.mem_singleton_iff, Set.mem_empty_iff_false, iff_false]
        exact fun hu ↦ hy ⟨u, hu⟩
      rw [hempty]
      exact Set.finite_empty
  obtain ⟨Γ, hend, hΓ⟩ := RiemannRochTop_rotGen_arc_in_open hE hG x k hk (f ⁻¹' B) hfin
    (f ⁻¹' V) (hV.preimage hf) hxV
  let y : ↥Bᶜ := ⟨f (Γ 0), (hΓ 0).2⟩
  let d : Path y y :=
    { toFun := fun t ↦ ⟨f (Γ t), (hΓ t).2⟩
      continuous_toFun := (hf.comp Γ.continuous).subtype_mk _
      source' := rfl
      target' := Subtype.ext ((congrArg f hend).trans (hgal.1 k (Γ 0))) }
  exact ⟨y, d, Γ, fun _ ↦ rfl, hend, fun t ↦ (hΓ t).1⟩

/-- RiemannRochTop: a local rotation arc projects to a loop avoiding finitely many values. -/
lemma RiemannRochTop_rotGen_reference_loop [T1Space C]
    {G : Type} [Group G] [Finite G] [MulAction G C]
    (hE : Module.finrank ℂ E = 1)
    (hG : ∀ g : G, ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω (fun x : C ↦ g • x))
    {Y : Type} [TopologicalSpace Y] (f : C → Y) (hf : Continuous f)
    (hgal : b4_IsGaloisCover G f) (B : Set Y) (hB : B.Finite)
    (x : C) (k : G) (hk : b4_IsRotGen E x k) :
    ∃ (y : ↥Bᶜ) (d : Path y y) (Γ : C(unitInterval, C)),
      (∀ t, f (Γ t) = (d t : Y)) ∧ Γ 1 = k • Γ 0 := by
  obtain ⟨y, d, Γ, hΓ, hend, _⟩ := RiemannRochTop_rotGen_reference_loop_in_open
    hE hG f hf hgal B hB x k hk Set.univ isOpen_univ (Set.mem_univ _)
  exact ⟨y, d, Γ, hΓ, hend⟩

/-- RiemannRochTop: adjoining a path and its translated reverse changes the initial point of a lift. -/
lemma RiemannRochTop_rotation_arc_rebase {U : Type} [TopologicalSpace U]
    {G : Type} [Group G] [MulAction G U] (k : G)
    (hk : Continuous (fun z : U ↦ k • z)) (S : Set U)
    (hS : ∀ z, z ∉ S → k • z ∉ S)
    (Γ : C(unitInterval, U)) (hend : Γ 1 = k • Γ 0) (hΓ : ∀ t, Γ t ∉ S)
    (u : U) (a : Path u (Γ 0)) (ha : ∀ t, a t ∉ S) :
    ∃ Δ : C(unitInterval, U), Δ 0 = u ∧ Δ 1 = k • u ∧ ∀ t, Δ t ∉ S := by
  let γ : Path (Γ 0) (k • Γ 0) :=
    { toContinuousMap := Γ
      source' := rfl
      target' := hend }
  let β := a.symm.map hk
  let δ := a.trans (γ.trans β)
  have hδ : Set.range δ ⊆ Sᶜ := by
    change Set.range (a.trans (γ.trans β)) ⊆ Sᶜ
    rw [Path.trans_range, Path.trans_range]
    rintro z (⟨t, rfl⟩ | ⟨t, rfl⟩ | ⟨t, rfl⟩)
    · exact ha t
    · exact hΓ t
    · exact hS _ (ha (unitInterval.symm t))
  exact ⟨δ.toContinuousMap, δ.source, δ.target, fun t ↦ hδ ⟨t, rfl⟩⟩

/-- RiemannRochTop: rotation monodromy can be realized at any point outside the branch fibers. -/
lemma RiemannRochTop_rotGen_reference_loop_at [T2Space C] [CompactSpace C] [ConnectedSpace C]
    {G : Type} [Group G] [Finite G] [MulAction G C]
    (hE : Module.finrank ℂ E = 1)
    (hG : ∀ g : G, ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω (fun x : C ↦ g • x))
    (f : C → OnePoint ℂ) (hf : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω f)
    (hgal : b4_IsGaloisCover G f) (B : Set (OnePoint ℂ)) (hB : B.Finite)
    (x : C) (k : G) (hk : b4_IsRotGen E x k) (u : C) (hu : f u ∉ B) :
    ∃ (d : Path (⟨f u, hu⟩ : ↥Bᶜ) ⟨f u, hu⟩) (Δ : C(unitInterval, C)),
      (∀ t, f (Δ t) = (d t : OnePoint ℂ)) ∧ Δ 0 = u ∧ Δ 1 = k • u := by
  have hfin : (f ⁻¹' B).Finite := hB.preimage' fun y _ ↦
    b4cov_fiber_finite hE f hf (b4cov_nonconst_of_galois hE f hgal u) y
  have hopen : IsOpen (f ⁻¹' Bᶜ) := hf.continuous.isOpen_preimage _ hB.isClosed.isOpen_compl
  have hconn : IsPreconnected (f ⁻¹' Bᶜ) := by
    simpa only [Set.sdiff_eq, Set.univ_inter, Set.preimage_compl] using
      b4cov_isPreconnected_diff_finite isOpen_univ isPreconnected_univ hfin
        (fun z _ ↦ b4cov_goodPoint hE z)
  letI : ConnectedSpace (f ⁻¹' Bᶜ) :=
    isConnected_iff_connectedSpace.mp ⟨⟨u, hu⟩, hconn⟩
  letI : LocallyPathConnectedSpace C := ChartedSpace.locallyPathConnectedSpace E C
  letI : LocallyPathConnectedSpace (f ⁻¹' Bᶜ) := hopen.locallyPathConnectedSpace
  letI : PathConnectedSpace (f ⁻¹' Bᶜ) := pathConnectedSpace_iff_connectedSpace.mpr inferInstance
  obtain ⟨Γ, hend, hΓ⟩ := RiemannRochTop_rotGen_arc_avoid hE hG x k hk (f ⁻¹' B) hfin
  let a' := PathConnectedSpace.somePath (⟨u, hu⟩ : ↥(f ⁻¹' Bᶜ)) ⟨Γ 0, hΓ 0⟩
  let a : Path u (Γ 0) := a'.map continuous_subtype_val
  obtain ⟨Δ, hstart, hfinish, hΔ⟩ := RiemannRochTop_rotation_arc_rebase k (hG k).continuous
    (f ⁻¹' B) (fun z hz ↦ by simpa only [Set.mem_preimage, hgal.1 k z] using hz)
    Γ hend hΓ u a (fun t ↦ (a' t).property)
  let d : Path (⟨f u, hu⟩ : ↥Bᶜ) ⟨f u, hu⟩ :=
    { toFun := fun t ↦ ⟨f (Δ t), hΔ t⟩
      continuous_toFun := (hf.continuous.comp Δ.continuous).subtype_mk _
      source' := Subtype.ext (congrArg f hstart)
      target' := Subtype.ext ((congrArg f hfinish).trans (hgal.1 k u)) }
  exact ⟨d, Δ, fun _ ↦ rfl, hstart, hfinish⟩

/-- RiemannRochTop: a rotation generator determines a monodromy class at any base point. -/
lemma RiemannRochTop_rotGen_monodromy_class [T2Space C] [CompactSpace C] [ConnectedSpace C]
    {G : Type} [Group G] [Finite G] [MulAction G C]
    (hE : Module.finrank ℂ E = 1)
    (hG : ∀ g : G, ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω (fun x : C ↦ g • x))
    (f : C → OnePoint ℂ) (hf : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω f)
    (hgal : b4_IsGaloisCover G f) (B : Set (OnePoint ℂ)) (hB : B.Finite)
    (hfree : ∀ z, f z ∉ B → MulAction.stabilizer G z = ⊥)
    (x : C) (k : G) (hk : b4_IsRotGen E x k) (y : ↥Bᶜ) :
    ∃ γ : FundamentalGroup ↥Bᶜ y,
      ∀ (c : Path y y), FundamentalGroup.fromPath ⟦c⟧ = γ →
        ∀ (Γ : C(unitInterval, C)) (l : G), (∀ t, f (Γ t) = (c t : OnePoint ℂ)) →
          Γ 1 = l • Γ 0 → ∃ q, f q = f x ∧ b4_IsRotGen E q l := by
  have hsurj : Function.Surjective f := b4cov_surjective (by simp) f hf
    (b4cov_nonconst_of_galois hE f hgal x)
  obtain ⟨u, hu⟩ := hsurj y
  have huB : f u ∉ B := by rw [hu]; exact y.property
  obtain ⟨d, Δ, hΔ, hstart, hfinish⟩ :=
    RiemannRochTop_rotGen_reference_loop_at hE hG f hf hgal B hB x k hk u huB
  let d' : Path y y := d.cast (Subtype.ext hu.symm) (Subtype.ext hu.symm)
  refine ⟨FundamentalGroup.fromPath ⟦d'⟧, ?_⟩
  intro c hc Γ l hΓ hend
  exact RiemannRochTop_rotGen_of_reference_lift hE hG f hf hgal B hfree c d' hc
    Γ Δ l k hΓ hΔ hend (by rw [hstart, hfinish]) x hk

/-- RiemannRochTop: a finite Galois map with at most one branch value has trivial group. -/
lemma RiemannRochTop_single_branch_trivial [T2Space C] [CompactSpace C] [ConnectedSpace C]
    (hE : Module.finrank ℂ E = 1) {G : Type} [Group G] [Finite G] [MulAction G C]
    (hG : ∀ g : G, ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, E) ω (fun x : C ↦ g • x))
    (f : C → OnePoint ℂ) (hf : ContMDiff 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω f)
    (hgal : b4_IsGaloisCover G f) (p : OnePoint ℂ)
    (hfree : ∀ x, f x ≠ p → MulAction.stabilizer G x = ⊥)
    (u : C) (hu : f u ≠ p) : ∀ g : G, g = 1 := by
  have hsurj : Function.Surjective f := b4cov_surjective (by simp) f hf
    (b4cov_nonconst_of_galois hE f hgal u)
  obtain ⟨v, hv⟩ := hsurj p
  have hfin : (f ⁻¹' {p}).Finite := by
    apply (Set.finite_range (fun g : G ↦ g • v)).subset
    intro x hx
    exact hgal.2 v x (hv.trans hx.symm)
  have hopen : IsOpen (f ⁻¹' {p}ᶜ) := hf.continuous.isOpen_preimage _
    (isClosed_singleton.isOpen_compl)
  have hconn : IsPreconnected (f ⁻¹' {p}ᶜ) := by
    simpa only [Set.sdiff_eq, Set.univ_inter, Set.preimage_compl] using
      b4cov_isPreconnected_diff_finite isOpen_univ isPreconnected_univ hfin
        (fun x _ ↦ b4cov_goodPoint hE x)
  have : ConnectedSpace (f ⁻¹' {p}ᶜ) :=
    isConnected_iff_connectedSpace.mp ⟨⟨u, hu⟩, hconn⟩
  have : LocallyPathConnectedSpace C := ChartedSpace.locallyPathConnectedSpace E C
  have : LocallyPathConnectedSpace (f ⁻¹' {p}ᶜ) := hopen.locallyPathConnectedSpace
  have : PathConnectedSpace (f ⁻¹' {p}ᶜ) := pathConnectedSpace_iff_connectedSpace.mpr inferInstance
  have : SimplyConnectedSpace ↥({p}ᶜ : Set (OnePoint ℂ)) :=
    RiemannRochTop_single_puncture p
  have hcov := RiemannRochTop_galois_coveringOn hE hG f hf hgal {p} hfree
  intro g
  let u' : f ⁻¹' {p}ᶜ := ⟨u, hu⟩
  let gu' : f ⁻¹' {p}ᶜ := ⟨g • u, by change f (g • u) ≠ p; rwa [hgal.1]⟩
  let Γ := PathConnectedSpace.somePath u' gu'
  let q : C(f ⁻¹' {p}ᶜ, ↥({p}ᶜ : Set (OnePoint ℂ))) :=
    ⟨({p}ᶜ : Set (OnePoint ℂ)).restrictPreimage f, hf.continuous.restrictPreimage⟩
  let c : Path (q u') (q u') := (Γ.map q.continuous).cast rfl
    (Subtype.ext (hgal.1 g u).symm)
  let Γ' : C(unitInterval, C) := ⟨fun t ↦ (Γ t).val, continuous_subtype_val.comp Γ.continuous⟩
  have hΓ : ∀ t, f (Γ' t) = (c t : OnePoint ℂ) := fun _ ↦ rfl
  have hend := RiemannRochTop_coveringOn_lift_endpoint f {p} hcov c (Path.refl (q u'))
    (Subsingleton.elim _ _) Γ' (.const _ u) hΓ (fun _ ↦ rfl)
    (congrArg Subtype.val Γ.source)
  have hgu : g • u = u := (congrArg Subtype.val Γ.target).symm.trans hend
  have hgmem : g ∈ MulAction.stabilizer G u := hgu
  simpa only [hfree u hu, Subgroup.mem_bot] using hgmem

/-- RiemannRochTop: a nonempty finite set of sphere punctures reduces to affine punctures. -/
lemma RiemannRochTop_punctured_affine {r : ℕ} (b : Fin r → OnePoint ℂ) (j : Fin r) :
    ∃ A : Set ℂ, A.Finite ∧
      Nonempty ({y : OnePoint ℂ // y ∉ Set.range b} ≃ₜ {z : ℂ // z ∉ A}) := by
  obtain ⟨e, he⟩ := RiemannRochTop_move_puncture (b j)
  let T : Set (OnePoint ℂ) := e '' Set.range b
  let A : Set ℂ := ((↑) : ℂ → OnePoint ℂ) ⁻¹' T
  have hT : T.Finite := (Set.finite_range b).image e
  have hA : A.Finite := hT.preimage OnePoint.coe_injective.injOn
  have hinfty : (OnePoint.infty : OnePoint ℂ) ∈ T :=
    ⟨b j, Set.mem_range_self j, he⟩
  have hsub : Tᶜ ⊆ Set.range ((↑) : ℂ → OnePoint ℂ) := by
    rw [← OnePoint.compl_infty]
    intro x hx
    exact fun hxinf ↦ hx (by simpa only [Set.mem_singleton_iff.mp hxinf] using hinfty)
  let ep := e.subtype (p := fun y ↦ y ∉ Set.range b) (q := fun y ↦ y ∉ T)
    (fun y ↦ by simp [T])
  let ea := OnePoint.isOpenEmbedding_coe.isEmbedding.homeomorphOfSubsetRange hsub
  exact ⟨A, hA, ⟨ep.trans ea.symm⟩⟩

/-- RiemannRochTop: a path avoiding finitely many punctures has a finite disk subdivision. -/
lemma RiemannRochTop_punctured_subdivision (A : Set ℂ) (hA : A.Finite)
    (γ : C(unitInterval, ℂ)) (hγ : ∀ t, γ t ∉ A) :
    ∃ t : ℕ → unitInterval, t 0 = 0 ∧ Monotone t ∧
      (∃ N, ∀ n ≥ N, t n = 1) ∧
      ∀ n, ∃ c : ℂ, ∃ ε : ℝ, 0 < ε ∧ Metric.ball c ε ⊆ Aᶜ ∧
        ∀ u ∈ Set.Icc (t n) (t (n + 1)), γ u ∈ Metric.ball c ε := by
  have hnb : ∀ u : unitInterval, ∃ ε : ℝ, 0 < ε ∧ Metric.ball (γ u) ε ⊆ Aᶜ := by
    intro u
    exact Metric.mem_nhds_iff.mp (hA.isClosed.isOpen_compl.mem_nhds (hγ u))
  choose ε hε hball using hnb
  obtain ⟨t, ht, hmono, hlast, hcover⟩ :=
    exists_monotone_Icc_subset_open_cover_unitInterval
      (c := fun u ↦ γ ⁻¹' Metric.ball (γ u) (ε u))
      (fun _ ↦ Metric.isOpen_ball.preimage γ.continuous)
      (fun u _ ↦ Set.mem_iUnion.mpr ⟨u, Metric.mem_ball_self (hε u)⟩)
  refine ⟨t, ht, hmono, hlast, fun n ↦ ?_⟩
  obtain ⟨u, hu⟩ := hcover n
  exact ⟨γ u, ε u, hε u, hball u, hu⟩

/-- RiemannRochTop: convex regions avoiding the punctures support relative path homotopies. -/
lemma RiemannRochTop_convex_paths_homotopic (A S : Set ℂ)
    (hS : Convex ℝ S) (havoid : S ⊆ Aᶜ) {x y : {z : ℂ // z ∉ A}}
    (γ δ : Path x y) (hγ : ∀ t, (γ t : ℂ) ∈ S)
    (hδ : ∀ t, (δ t : ℂ) ∈ S) : γ.Homotopic δ := by
  refine ⟨{
    toFun := fun p ↦ ⟨(1 - (p.1 : ℝ)) • (γ p.2 : ℂ) + (p.1 : ℝ) • (δ p.2 : ℂ),
      havoid (hS (hγ p.2) (hδ p.2)
        (sub_nonneg.mpr p.1.property.2) p.1.property.1 (sub_add_cancel 1 _))⟩
    continuous_toFun := by fun_prop
    map_zero_left := by intro t; apply Subtype.ext; simp
    map_one_left := by intro t; apply Subtype.ext; simp
    prop' := ?_ }⟩
  intro t u hu
  have heq : δ u = γ u := by
    rcases hu with rfl | hu
    · simp
    · have : u = 1 := Set.mem_singleton_iff.mp hu
      subst u
      simp
  apply Subtype.ext
  change (1 - (t : ℝ)) • (γ u : ℂ) + (t : ℝ) • (δ u : ℂ) = (γ u : ℂ)
  rw [heq, ← add_smul, sub_add_cancel, one_smul]

/-- RiemannRochTop: segments on a common positive ray stay beyond both endpoint radii. -/
lemma RiemannRochTop_radial_segment_norm (u : ℂ) (a t R : ℝ)
    (ha : 0 ≤ a) (ht : 0 ≤ t) (ht' : t ≤ 1)
    (hu : R < ‖u‖) (hv : R < ‖a • u‖) :
    R < ‖(1 - t) • u + t • (a • u)‖ := by
  have hc : 0 ≤ 1 - t + t * a := by positivity
  rw [smul_smul, ← add_smul, norm_smul, Real.norm_eq_abs, abs_of_nonneg hc]
  rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg ha] at hv
  by_cases h : t = 1
  · subst t
    simpa using hv
  · have h₃ := mul_pos (sub_pos.mpr (lt_of_le_of_ne ht' h)) (sub_pos.mpr hu)
    have h₄ := mul_nonneg ht (sub_nonneg.mpr (le_of_lt hv))
    nlinarith

/-- RiemannRochTop: radial path deformations outside a bounding disk avoid all punctures. -/
lemma RiemannRochTop_radial_paths_homotopic (A : Set ℂ) (R : ℝ)
    (hA : ∀ z ∈ A, ‖z‖ ≤ R) {x y : {z : ℂ // z ∉ A}}
    (γ δ : Path x y) (hγ : ∀ t, R < ‖(γ t : ℂ)‖)
    (hδ : ∀ t, R < ‖(δ t : ℂ)‖)
    (hray : ∀ t, ∃ a : ℝ, 0 ≤ a ∧ (δ t : ℂ) = a • (γ t : ℂ)) :
    γ.Homotopic δ := by
  have hav : ∀ s t : unitInterval,
      (1 - (s : ℝ)) • (γ t : ℂ) + (s : ℝ) • (δ t : ℂ) ∉ A := by
    intro s t hm
    obtain ⟨a, ha, he⟩ := hray t
    have hn := RiemannRochTop_radial_segment_norm (γ t : ℂ) a s R ha
      s.property.1 s.property.2 (hγ t) (by simpa only [← he] using hδ t)
    rw [← he] at hn
    exact (not_le_of_gt hn) (hA _ hm)
  refine ⟨{
    toFun := fun p ↦ ⟨(1 - (p.1 : ℝ)) • (γ p.2 : ℂ) + (p.1 : ℝ) • (δ p.2 : ℂ),
      hav p.1 p.2⟩
    continuous_toFun := by fun_prop
    map_zero_left := by intro t; apply Subtype.ext; simp
    map_one_left := by intro t; apply Subtype.ext; simp
    prop' := ?_ }⟩
  intro t u hu
  have heq : δ u = γ u := by
    rcases hu with rfl | hu
    · simp
    · have : u = 1 := Set.mem_singleton_iff.mp hu
      subst u
      simp
  apply Subtype.ext
  change (1 - (t : ℝ)) • (γ u : ℂ) + (t : ℝ) • (δ u : ℂ) = (γ u : ℂ)
  rw [heq, ← add_smul, sub_add_cancel, one_smul]

/-- RiemannRochTop: the square radius of a nonzero complex number is positive and bounded by its norm. -/
lemma RiemannRochTop_square_radius (z : ℂ) (hz : z ≠ 0) :
    0 < max |z.re| |z.im| ∧ max |z.re| |z.im| ≤ ‖z‖ := by
  refine ⟨?_, max_le (Complex.abs_re_le_norm z) (Complex.abs_im_le_norm z)⟩
  by_contra h
  have hle := le_of_not_gt h
  have hr : z.re = 0 := abs_eq_zero.mp (le_antisymm ((le_max_left _ _).trans hle) (abs_nonneg _))
  have hi : z.im = 0 := abs_eq_zero.mp (le_antisymm ((le_max_right _ _).trans hle) (abs_nonneg _))
  exact hz (Complex.ext hr hi)

/-- RiemannRochTop: radial normalization lands on the square boundary outside its inscribed disk. -/
lemma RiemannRochTop_square_normalize (z : ℂ) (hz : z ≠ 0) (L : ℝ) (hL : 0 < L) :
    let w := (L / max |z.re| |z.im|) • z
    max |w.re| |w.im| = L ∧ L ≤ ‖w‖ := by
  obtain ⟨hm, hmn⟩ := RiemannRochTop_square_radius z hz
  have hc : 0 ≤ L / max |z.re| |z.im| := le_of_lt (div_pos hL hm)
  dsimp only
  have he : max |((L / max |z.re| |z.im|) • z).re|
      |((L / max |z.re| |z.im|) • z).im| = L := by
    simp only [Complex.smul_re, Complex.smul_im, smul_eq_mul, abs_mul, abs_of_nonneg hc]
    rw [← mul_max_of_nonneg _ _ hc, div_mul_cancel₀ _ (ne_of_gt hm)]
  refine ⟨he, ?_⟩
  exact le_trans (le_of_eq he.symm)
    (max_le (Complex.abs_re_le_norm _) (Complex.abs_im_le_norm _))

/-- RiemannRochTop: exterior paths with square-boundary endpoints deform onto that boundary. -/
lemma RiemannRochTop_square_boundary_path (A : Set ℂ) (R L : ℝ) (hR : 0 ≤ R)
    (hRL : R < L) (hA : ∀ z ∈ A, ‖z‖ ≤ R)
    {x y : {z : ℂ // z ∉ A}} (γ : Path x y)
    (hγ : ∀ t, R < ‖(γ t : ℂ)‖)
    (hx : max |(x : ℂ).re| |(x : ℂ).im| = L)
    (hy : max |(y : ℂ).re| |(y : ℂ).im| = L) :
    ∃ δ : Path x y, γ.Homotopic δ ∧
      (∀ t, max |(δ t : ℂ).re| |(δ t : ℂ).im| = L) ∧
      (∀ t, (δ t : ℂ) = (L / max |(γ t : ℂ).re| |(γ t : ℂ).im|) • (γ t : ℂ)) := by
  have hL : 0 < L := lt_of_le_of_lt hR hRL
  have hn : ∀ t, (γ t : ℂ) ≠ 0 := fun t ↦ norm_pos_iff.mp (lt_of_le_of_lt hR (hγ t))
  let q : unitInterval → ℂ := fun t ↦
    (L / max |(γ t : ℂ).re| |(γ t : ℂ).im|) • (γ t : ℂ)
  have hq : ∀ t, max |(q t).re| |(q t).im| = L ∧ L ≤ ‖q t‖ :=
    fun t ↦ RiemannRochTop_square_normalize _ (hn t) L hL
  have hc : Continuous q := by
    dsimp [q]
    fun_prop (disch := intro t; exact ne_of_gt (RiemannRochTop_square_radius _ (hn t)).1)
  let δ : Path x y := {
    toFun := fun t ↦ ⟨q t, fun hm ↦ (not_le_of_gt (hRL.trans_le (hq t).2)) (hA _ hm)⟩
    continuous_toFun := hc.subtype_mk _
    source' := by apply Subtype.ext; simp [q, hx, ne_of_gt hL]
    target' := by apply Subtype.ext; simp [q, hy, ne_of_gt hL] }
  refine ⟨δ, RiemannRochTop_radial_paths_homotopic A R hA γ δ hγ
    (fun t ↦ hRL.trans_le (hq t).2) ?_, fun t ↦ (hq t).1, fun _ ↦ rfl⟩
  intro t
  exact ⟨L / max |(γ t : ℂ).re| |(γ t : ℂ).im|,
    le_of_lt (div_pos hL (RiemannRochTop_square_radius _ (hn t)).1), rfl⟩

/-- RiemannRochTop: a large positive circle has a square-boundary representative with the same basepoint. -/
lemma RiemannRochTop_outer_circle_square (A : Set ℂ) (R L : ℝ) (hR : 0 ≤ R)
    (hRL : R < L) (hA : ∀ z ∈ A, ‖z‖ ≤ R) :
    ∃ x : {z : ℂ // z ∉ A}, (x : ℂ) = (L : ℂ) ∧
      ∃ γ δ : Path x x, γ.Homotopic δ ∧
        (∀ t : unitInterval, (γ t : ℂ) =
          Complex.exp (((t : ℝ) * (2 * Real.pi) : ℝ) * Complex.I) * (L : ℂ)) ∧
        (∀ t, max |(δ t : ℂ).re| |(δ t : ℂ).im| = L) ∧
        (∀ t, (δ t : ℂ) = (L / max |(γ t : ℂ).re| |(γ t : ℂ).im|) • (γ t : ℂ)) := by
  have hL : 0 < L := lt_of_le_of_lt hR hRL
  have hnL : ‖(L : ℂ)‖ = L := by simp [abs_of_pos hL]
  let x : {z : ℂ // z ∉ A} := ⟨(L : ℂ), fun hm ↦
    (not_le_of_gt hRL) (hnL ▸ hA _ hm)⟩
  let q : unitInterval → ℂ := fun t ↦
    Complex.exp (((t : ℝ) * (2 * Real.pi) : ℝ) * Complex.I) * (L : ℂ)
  have hqn : ∀ t, ‖q t‖ = L := by
    intro t
    simp only [q, norm_mul, Complex.norm_exp_ofReal_mul_I, one_mul, hnL]
  let γ : Path x x := {
    toFun := fun t ↦ ⟨q t, fun hm ↦ (not_le_of_gt hRL) ((hqn t) ▸ hA _ hm)⟩
    continuous_toFun := by dsimp [q]; fun_prop
    source' := by apply Subtype.ext; simp [q, x]
    target' := by apply Subtype.ext; simp [q, x, Complex.exp_two_pi_mul_I] }
  have hx : max |(x : ℂ).re| |(x : ℂ).im| = L := by
    simp [x, abs_of_pos hL, le_of_lt hL]
  obtain ⟨δ, hδ, hb, he⟩ := RiemannRochTop_square_boundary_path A R L hR hRL hA γ
    (fun t ↦ by change R < ‖q t‖; rw [hqn]; exact hRL) hx hx
  exact ⟨x, rfl, γ, δ, hδ, fun _ ↦ rfl, hb, he⟩

/-- RiemannRochTop: paths in the same exterior supporting half-plane are homotopic off the punctures. -/
lemma RiemannRochTop_supporting_halfplane_paths (A : Set ℂ) (f : ℂ →ₗ[ℝ] ℝ)
    (R L : ℝ) (hRL : R < L) (hA : ∀ z ∈ A, f z ≤ R)
    {x y : {z : ℂ // z ∉ A}} (γ δ : Path x y)
    (hγ : ∀ t, L ≤ f (γ t)) (hδ : ∀ t, L ≤ f (δ t)) : γ.Homotopic δ := by
  apply RiemannRochTop_convex_paths_homotopic A {z | L ≤ f z} _ _ γ δ hγ hδ
  · intro u hu v hv a b ha hb hab
    change L ≤ f (a • u + b • v)
    simp only [map_add, map_smul, smul_eq_mul]
    calc
      L = (a + b) * L := by rw [hab, one_mul]
      _ ≤ a * f u + b * f v := by
        nlinarith [mul_nonneg ha (sub_nonneg.mpr hu), mul_nonneg hb (sub_nonneg.mpr hv)]
  · intro z hz hm
    exact (not_le_of_gt hRL) (hz.trans (hA z hm))

/-- RiemannRochTop: exterior supporting half-planes allow straight representatives of paths. -/
lemma RiemannRochTop_supporting_halfplane_straight (A : Set ℂ) (f : ℂ →ₗ[ℝ] ℝ)
    (R L : ℝ) (hRL : R < L) (hA : ∀ z ∈ A, f z ≤ R)
    {x y : {z : ℂ // z ∉ A}} (γ : Path x y) (hγ : ∀ t, L ≤ f (γ t)) :
    ∃ δ : Path x y, γ.Homotopic δ ∧
      (∀ t, (δ t : ℂ) = AffineMap.lineMap (x : ℂ) y (t : ℝ)) := by
  have hx : L ≤ f x := by simpa using hγ 0
  have hy : L ≤ f y := by simpa using hγ 1
  have hl : ∀ t : unitInterval, L ≤ f (AffineMap.lineMap (x : ℂ) y (t : ℝ)) := by
    intro t
    rw [AffineMap.lineMap_apply_module, map_add, map_smul, map_smul]
    simp only [smul_eq_mul]
    nlinarith [mul_nonneg (sub_nonneg.mpr t.property.2) (sub_nonneg.mpr hx),
      mul_nonneg t.property.1 (sub_nonneg.mpr hy)]
  let δ : Path x y := {
    toFun := fun t ↦ ⟨AffineMap.lineMap (x : ℂ) y (t : ℝ),
      fun hm ↦ (not_le_of_gt hRL) ((hl t).trans (hA _ hm))⟩
    continuous_toFun := by fun_prop
    source' := by apply Subtype.ext; simp
    target' := by apply Subtype.ext; simp }
  exact ⟨δ, RiemannRochTop_supporting_halfplane_paths A f R L hRL hA γ δ hγ hl,
    fun _ ↦ rfl⟩

/-- RiemannRochTop: exterior quadrant paths straighten without meeting a bounded puncture set. -/
lemma RiemannRochTop_quadrant_path_straight (A : Set ℂ) (R L : ℝ)
    (hRL : 2 * R < L) (hA : ∀ z ∈ A, ‖z‖ ≤ R)
    {x y : {z : ℂ // z ∉ A}} (γ : Path x y)
    (hγ : ∀ t, L ≤ ‖(γ t : ℂ)‖)
    (hre : ∀ t, 0 ≤ (γ t : ℂ).re) (him : ∀ t, 0 ≤ (γ t : ℂ).im) :
    ∃ δ : Path x y, γ.Homotopic δ ∧
      (∀ t, (δ t : ℂ) = AffineMap.lineMap (x : ℂ) y (t : ℝ)) := by
  refine RiemannRochTop_supporting_halfplane_straight A
    (Complex.reLm + Complex.imLm) (2 * R) L hRL ?_ γ ?_
  · intro z hz
    change z.re + z.im ≤ 2 * R
    have hr := (le_abs_self z.re).trans ((Complex.abs_re_le_norm z).trans (hA z hz))
    have hi := (le_abs_self z.im).trans ((Complex.abs_im_le_norm z).trans (hA z hz))
    linarith
  · intro t
    change L ≤ (γ t : ℂ).re + (γ t : ℂ).im
    have hn := Complex.norm_le_abs_re_add_abs_im (γ t : ℂ)
    rw [abs_of_nonneg (hre t), abs_of_nonneg (him t)] at hn
    exact (hγ t).trans hn

/-- RiemannRochTop: circular arcs within the first quadrant have straight representatives off bounded punctures. -/
lemma RiemannRochTop_quarter_arc_straight (A : Set ℂ) (R L : ℝ)
    (hL : 0 ≤ L) (hRL : 2 * R < L) (hA : ∀ z ∈ A, ‖z‖ ≤ R)
    {x y : {z : ℂ // z ∉ A}} (γ : Path x y) (θ : unitInterval → ℝ)
    (hθ : ∀ t, 0 ≤ θ t ∧ θ t ≤ Real.pi / 2)
    (hγ : ∀ t, (γ t : ℂ) = Complex.exp ((θ t : ℂ) * Complex.I) * (L : ℂ)) :
    ∃ δ : Path x y, γ.Homotopic δ ∧
      (∀ t, (δ t : ℂ) = AffineMap.lineMap (x : ℂ) y (t : ℝ)) := by
  refine RiemannRochTop_quadrant_path_straight A R L hRL hA γ ?_ ?_ ?_
  · intro t
    rw [hγ t]
    simp only [norm_mul, Complex.norm_exp_ofReal_mul_I, one_mul, Complex.norm_real,
      Real.norm_eq_abs, abs_of_nonneg hL, le_refl]
  · intro t
    rw [hγ t]
    simp only [Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im, mul_zero,
      sub_zero, Complex.exp_ofReal_mul_I_re]
    exact mul_nonneg (Real.cos_nonneg_of_mem_Icc ⟨by linarith [(hθ t).1, Real.pi_pos],
      (hθ t).2⟩) hL
  · intro t
    rw [hγ t]
    simp only [Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im, mul_zero,
      zero_add, Complex.exp_ofReal_mul_I_im]
    exact mul_nonneg (Real.sin_nonneg_of_nonneg_of_le_pi (hθ t).1
      (by linarith [(hθ t).2, Real.pi_pos])) hL

/-- RiemannRochTop: rotating the supporting quadrant preserves exterior path straightening. -/
lemma RiemannRochTop_rotated_quadrant_path_straight (A : Set ℂ) (R L : ℝ)
    (hRL : 2 * R < L) (hA : ∀ z ∈ A, ‖z‖ ≤ R) (c : ℂ) (hc : ‖c‖ = 1)
    {x y : {z : ℂ // z ∉ A}} (γ : Path x y)
    (hγ : ∀ t, L ≤ ‖(γ t : ℂ)‖)
    (hre : ∀ t, 0 ≤ (c * (γ t : ℂ)).re)
    (him : ∀ t, 0 ≤ (c * (γ t : ℂ)).im) :
    ∃ δ : Path x y, γ.Homotopic δ ∧
      (∀ t, (δ t : ℂ) = AffineMap.lineMap (x : ℂ) y (t : ℝ)) := by
  have hn : ∀ z : ℂ, ‖c * z‖ = ‖z‖ := by intro z; rw [norm_mul, hc, one_mul]
  refine RiemannRochTop_supporting_halfplane_straight A
    ((Complex.reLm + Complex.imLm).comp (LinearMap.mulLeft ℝ c))
    (2 * R) L hRL ?_ γ ?_
  · intro z hz
    change (c * z).re + (c * z).im ≤ 2 * R
    have hz' : ‖c * z‖ ≤ R := by rw [hn]; exact hA z hz
    have hr := (le_abs_self (c * z).re).trans ((Complex.abs_re_le_norm _).trans hz')
    have hi := (le_abs_self (c * z).im).trans ((Complex.abs_im_le_norm _).trans hz')
    linarith
  · intro t
    change L ≤ (c * (γ t : ℂ)).re + (c * (γ t : ℂ)).im
    have hb := Complex.norm_le_abs_re_add_abs_im (c * (γ t : ℂ))
    rw [abs_of_nonneg (hre t), abs_of_nonneg (him t), hn] at hb
    exact (hγ t).trans hb

/-- RiemannRochTop: circular arcs of angular width at most a quarter turn straighten off bounded punctures. -/
lemma RiemannRochTop_rotated_quarter_arc_straight (A : Set ℂ) (R L a : ℝ)
    (hL : 0 ≤ L) (hRL : 2 * R < L) (hA : ∀ z ∈ A, ‖z‖ ≤ R)
    {x y : {z : ℂ // z ∉ A}} (γ : Path x y) (θ : unitInterval → ℝ)
    (hθ : ∀ t, a ≤ θ t ∧ θ t ≤ a + Real.pi / 2)
    (hγ : ∀ t, (γ t : ℂ) = Complex.exp ((θ t : ℂ) * Complex.I) * (L : ℂ)) :
    ∃ δ : Path x y, γ.Homotopic δ ∧
      (∀ t, (δ t : ℂ) = AffineMap.lineMap (x : ℂ) y (t : ℝ)) := by
  let c := Complex.exp ((-a : ℝ) * Complex.I)
  have hc : ‖c‖ = 1 := Complex.norm_exp_ofReal_mul_I _
  have he : ∀ t, c * (γ t : ℂ) =
      Complex.exp (((θ t - a : ℝ) : ℂ) * Complex.I) * (L : ℂ) := by
    intro t
    rw [hγ t, ← mul_assoc]
    dsimp [c]
    rw [← Complex.exp_add]
    congr 2
    push_cast
    ring
  refine RiemannRochTop_rotated_quadrant_path_straight A R L hRL hA c hc γ ?_ ?_ ?_
  · intro t
    rw [hγ t]
    simp only [norm_mul, Complex.norm_exp_ofReal_mul_I, one_mul, Complex.norm_real,
      Real.norm_eq_abs, abs_of_nonneg hL, le_refl]
  · intro t
    rw [he t]
    simp only [Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im, mul_zero,
      sub_zero, Complex.exp_ofReal_mul_I_re]
    exact mul_nonneg (Real.cos_nonneg_of_mem_Icc ⟨by linarith [(hθ t).1, Real.pi_pos],
      by linarith [(hθ t).2]⟩) hL
  · intro t
    rw [he t]
    simp only [Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im, mul_zero,
      zero_add, Complex.exp_ofReal_mul_I_im]
    exact mul_nonneg (Real.sin_nonneg_of_nonneg_of_le_pi (by linarith [(hθ t).1])
      (by linarith [(hθ t).2, Real.pi_pos])) hL

/-- RiemannRochTop: subpaths spanning at most a quarter of an outer circle straighten off bounded punctures. -/
lemma RiemannRochTop_outer_circle_subpath_straight (A : Set ℂ) (R L : ℝ)
    (hL : 0 ≤ L) (hRL : 2 * R < L) (hA : ∀ z ∈ A, ‖z‖ ≤ R)
    {x : {z : ℂ // z ∉ A}} (γ : Path x x)
    (hγ : ∀ t : unitInterval, (γ t : ℂ) =
      Complex.exp (((t : ℝ) * (2 * Real.pi) : ℝ) * Complex.I) * (L : ℂ))
    (a b : unitInterval) (hab : a ≤ b) (hwidth : (b : ℝ) - (a : ℝ) ≤ 1 / 4) :
    ∃ δ : Path (γ a) (γ b), (γ.subpath a b).Homotopic δ ∧
      (∀ t, (δ t : ℂ) = AffineMap.lineMap (γ a : ℂ) (γ b : ℂ) (t : ℝ)) := by
  refine RiemannRochTop_rotated_quarter_arc_straight A R L ((a : ℝ) * (2 * Real.pi))
    hL hRL hA (γ.subpath a b)
    (fun t ↦ (Icc.convexComb a b t : ℝ) * (2 * Real.pi)) ?_ ?_
  · intro t
    have hv : Icc.convexComb a b t ∈ Set.Icc a b := by
      rw [← Set.uIcc_of_le hab, ← Path.range_subpathAux a b]
      exact ⟨t, rfl⟩
    have hva : (a : ℝ) ≤ (Icc.convexComb a b t : ℝ) := hv.1
    have hvb : (Icc.convexComb a b t : ℝ) ≤ (b : ℝ) := hv.2
    refine ⟨mul_le_mul_of_nonneg_right hva (by positivity), ?_⟩
    have hb := mul_le_mul_of_nonneg_right hvb (show 0 ≤ 2 * Real.pi by positivity)
    have hw := mul_le_mul_of_nonneg_right hwidth (show 0 ≤ 2 * Real.pi by positivity)
    nlinarith
  · intro t
    exact hγ (Icc.convexComb a b t)

/-- RiemannRochTop: positive outer circles have four-edge representatives at their quarter-turn vertices. -/
lemma RiemannRochTop_outer_circle_four_edges (A : Set ℂ) (R L : ℝ)
    (hL : 0 ≤ L) (hRL : 2 * R < L) (hA : ∀ z ∈ A, ‖z‖ ≤ R)
    {x : {z : ℂ // z ∉ A}} (γ : Path x x)
    (hγ : ∀ t : unitInterval, (γ t : ℂ) =
      Complex.exp (((t : ℝ) * (2 * Real.pi) : ℝ) * Complex.I) * (L : ℂ)) :
    ∃ t : Fin 5 → unitInterval, (∀ k, (t k : ℝ) = (k.val : ℝ) / 4) ∧
      t 0 = 0 ∧ t (Fin.last 4) = 1 ∧
      ∃ δ : (k : Fin 4) → Path (γ (t k.castSucc)) (γ (t k.succ)),
        (∀ k u, (δ k u : ℂ) = AffineMap.lineMap (γ (t k.castSucc) : ℂ)
          (γ (t k.succ) : ℂ) (u : ℝ)) ∧
        (Path.concat (γ ∘ t) δ).Homotopic (γ.subpath (t 0) (t (Fin.last 4))) := by
  let t : Fin 5 → unitInterval := fun k ↦ ⟨(k.val : ℝ) / 4, by
    constructor
    · positivity
    · have hk : k.val ≤ 4 := by omega
      have hk' : (k.val : ℝ) ≤ 4 := by exact_mod_cast hk
      linarith⟩
  have ht0 : t 0 = 0 := by apply Subtype.ext; norm_num [t]
  have ht1 : t (Fin.last 4) = 1 := by apply Subtype.ext; norm_num [t]
  have hs : ∀ k : Fin 4, ∃ δ : Path (γ (t k.castSucc)) (γ (t k.succ)),
      (γ.subpath (t k.castSucc) (t k.succ)).Homotopic δ ∧
      (∀ u, (δ u : ℂ) = AffineMap.lineMap (γ (t k.castSucc) : ℂ)
        (γ (t k.succ) : ℂ) (u : ℝ)) := by
    intro k
    apply RiemannRochTop_outer_circle_subpath_straight A R L hL hRL hA γ hγ
    · change (k.val : ℝ) / 4 ≤ ((k.val + 1 : ℕ) : ℝ) / 4
      push_cast
      linarith
    · change ((k.val + 1 : ℕ) : ℝ) / 4 - (k.val : ℝ) / 4 ≤ 1 / 4
      push_cast
      linarith
  choose δ hhom hδ using hs
  refine ⟨t, fun _ ↦ rfl, ht0, ht1, δ, hδ, ?_⟩
  exact (Path.Homotopic.concat_hcomp _ _ _ (fun k ↦ (hhom k).symm)).trans
    (Path.Homotopic.concat_subpath γ t)

/-- RiemannRochTop: straight edges on one side of the imaginary axis preserve the diamond height. -/
lemma RiemannRochTop_diamond_line_height (x y : ℂ) (L σ : ℝ)
    (hx : |x.re| + σ * x.im = L) (hy : |y.re| + σ * y.im = L)
    (hs : (0 ≤ x.re ∧ 0 ≤ y.re) ∨ (x.re ≤ 0 ∧ y.re ≤ 0))
    (t : unitInterval) :
    |(AffineMap.lineMap x y (t : ℝ)).re| +
      σ * (AffineMap.lineMap x y (t : ℝ)).im = L := by
  have ht : 0 ≤ (t : ℝ) := t.property.1
  have ht' : 0 ≤ 1 - (t : ℝ) := sub_nonneg.mpr t.property.2
  have hr : (AffineMap.lineMap x y (t : ℝ)).re =
      (1 - (t : ℝ)) * x.re + (t : ℝ) * y.re := by
    simp [AffineMap.lineMap_apply, smul_eq_mul, Complex.mul_re]
    <;> ring
  have hi : (AffineMap.lineMap x y (t : ℝ)).im =
      (1 - (t : ℝ)) * x.im + (t : ℝ) * y.im := by
    simp [AffineMap.lineMap_apply, smul_eq_mul, Complex.mul_im]
    <;> ring
  rw [hr, hi]
  rcases hs with ⟨hxr, hyr⟩ | ⟨hxr, hyr⟩
  · rw [abs_of_nonneg hxr] at hx
    rw [abs_of_nonneg hyr] at hy
    rw [abs_of_nonneg (add_nonneg (mul_nonneg ht' hxr) (mul_nonneg ht hyr))]
    linear_combination (1 - (t : ℝ)) * hx + (t : ℝ) * hy
  · rw [abs_of_nonpos hxr] at hx
    rw [abs_of_nonpos hyr] at hy
    rw [abs_of_nonpos (add_nonpos (mul_nonpos_of_nonneg_of_nonpos ht' hxr)
      (mul_nonpos_of_nonneg_of_nonpos ht hyr))]
    linear_combination (1 - (t : ℝ)) * hx + (t : ℝ) * hy

/-- RiemannRochTop: quarter turns of the unit circle are the four diamond vertices. -/
lemma RiemannRochTop_quarter_turn_vertices (k : Fin 5) :
    Complex.exp ((((k.val : ℝ) / 4 * (2 * Real.pi) : ℝ) : ℂ) * Complex.I) =
      ![(1 : ℂ), Complex.I, -1, -Complex.I, 1] k := by
  fin_cases k
  · simp
  · convert Complex.exp_pi_div_two_mul_I using 1 <;> push_cast <;> ring
  · convert Complex.exp_pi_mul_I using 1 <;> push_cast <;> ring
  · have he : (((3 : ℝ) / 4 * (2 * Real.pi) : ℝ) : ℂ) * Complex.I =
        (Real.pi : ℂ) / 2 * Complex.I + (Real.pi : ℂ) * Complex.I := by
      push_cast
      ring
    change Complex.exp ((((3 : ℝ) / 4 * (2 * Real.pi) : ℝ) : ℂ) * Complex.I) = -Complex.I
    rw [he, Complex.exp_add_pi_mul_I, Complex.exp_pi_div_two_mul_I]
  · convert Complex.exp_two_pi_mul_I using 1 <;> push_cast <;> ring

/-- RiemannRochTop: the four-edge outer-circle representative follows the upper and lower diamond boundaries. -/
lemma RiemannRochTop_outer_circle_diamond_edges (A : Set ℂ) (R L : ℝ)
    (hL : 0 ≤ L) (hRL : 2 * R < L) (hA : ∀ z ∈ A, ‖z‖ ≤ R)
    {x : {z : ℂ // z ∉ A}} (γ : Path x x)
    (hγ : ∀ t : unitInterval, (γ t : ℂ) =
      Complex.exp (((t : ℝ) * (2 * Real.pi) : ℝ) * Complex.I) * (L : ℂ)) :
    ∃ t : Fin 5 → unitInterval, (∀ k, (t k : ℝ) = (k.val : ℝ) / 4) ∧
      t 0 = 0 ∧ t (Fin.last 4) = 1 ∧
      ∃ δ : (k : Fin 4) → Path (γ (t k.castSucc)) (γ (t k.succ)),
        (∀ k u, |(δ k u : ℂ).re| +
          (if k.val < 2 then (1 : ℝ) else -1) * (δ k u : ℂ).im = L) ∧
        (Path.concat (γ ∘ t) δ).Homotopic (γ.subpath (t 0) (t (Fin.last 4))) := by
  obtain ⟨t, ht, ht0, ht1, δ, hδ, hhom⟩ :=
    RiemannRochTop_outer_circle_four_edges A R L hL hRL hA γ hγ
  have hv (k : Fin 5) : (γ (t k) : ℂ) =
      ![(L : ℂ), (L : ℂ) * Complex.I, -L, -(L : ℂ) * Complex.I, L] k := by
    rw [hγ, ht, RiemannRochTop_quarter_turn_vertices]
    fin_cases k <;> simp [mul_comm]
  refine ⟨t, ht, ht0, ht1, δ, ?_, hhom⟩
  intro k u
  rw [hδ]
  apply RiemannRochTop_diamond_line_height
  · fin_cases k <;> simp [hv, abs_of_nonneg hL]
  · fin_cases k <;> simp [hv, abs_of_nonneg hL]
  · fin_cases k <;> simp [hv, hL]

/-- RiemannRochTop: an outer circle has an upper diamond path and a lower diamond return path. -/
lemma RiemannRochTop_outer_circle_diamond_halves (A : Set ℂ) (R L : ℝ)
    (hL : 0 ≤ L) (hRL : 2 * R < L) (hA : ∀ z ∈ A, ‖z‖ ≤ R)
    {x : {z : ℂ // z ∉ A}} (γ : Path x x)
    (hγ : ∀ t : unitInterval, (γ t : ℂ) =
      Complex.exp (((t : ℝ) * (2 * Real.pi) : ℝ) * Complex.I) * (L : ℂ)) :
    ∃ y : {z : ℂ // z ∉ A}, ∃ u : Path x y, ∃ l : Path y x,
      (y : ℂ) = -(L : ℂ) ∧
      (∀ s, |(u s : ℂ).re| + (u s : ℂ).im = L) ∧
      (∀ s, |(l s : ℂ).re| - (l s : ℂ).im = L) ∧
      (u.trans l).Homotopic γ := by
  obtain ⟨t, ht, ht0, ht1, δ, hδ, hhom⟩ :=
    RiemannRochTop_outer_circle_diamond_edges A R L hL hRL hA γ hγ
  have hs : x = γ (t 0) := by rw [ht0, γ.source]
  have he : x = γ (t (Fin.last 4)) := by rw [ht1, γ.target]
  let u := ((δ 0).trans (δ 1)).cast hs rfl
  let l := ((δ 2).trans (δ 3)).cast rfl he
  refine ⟨γ (t 2), u, l, ?_, ?_, ?_, ?_⟩
  · rw [hγ, ht, RiemannRochTop_quarter_turn_vertices]
    simp
  · intro s
    have hr : u s ∈ Set.range ((δ 0).trans (δ 1)) := ⟨s, rfl⟩
    rw [Path.trans_range] at hr
    rcases hr with ⟨v, hv⟩ | ⟨v, hv⟩
    · simpa only [hv, Fin.val_zero, Nat.reduceLT, ↓reduceIte, one_mul] using hδ 0 v
    · simpa only [hv, Fin.val_one, Nat.reduceLT, ↓reduceIte, one_mul] using hδ 1 v
  · intro s
    have hr : l s ∈ Set.range ((δ 2).trans (δ 3)) := ⟨s, rfl⟩
    rw [Path.trans_range] at hr
    rcases hr with ⟨v, hv⟩ | ⟨v, hv⟩
    · simpa [hv, sub_eq_add_neg] using hδ 2 v
    · simpa [hv, sub_eq_add_neg] using hδ 3 v
  · have hg : (Path.concat (γ ∘ t) δ).Homotopic
        (((δ 0).trans (δ 1)).trans ((δ 2).trans (δ 3))) := by
      simp only [Path.concat_succ, Path.concat_zero]
      exact ((((Path.Homotopic.refl_trans (δ 0)).hcomp (Path.Homotopic.refl (δ 1))).hcomp
        (Path.Homotopic.refl (δ 2))).hcomp (Path.Homotopic.refl (δ 3))).trans
          (Path.Homotopic.trans_assoc ((δ 0).trans (δ 1)) (δ 2) (δ 3))
    have h := (hg.symm.trans hhom).pathCast hs he
    have hp : (γ.subpath (t 0) (t (Fin.last 4))).cast hs he = γ := by
      apply Path.ext
      funext s
      change (γ.subpath (t 0) (t (Fin.last 4))) s = γ s
      rw [ht0, ht1, Path.subpath_zero_one]
      rfl
    rw [hp] at h
    exact h

/-- RiemannRochTop: the lower diamond boundary lies below every puncture on its vertical line. -/
lemma RiemannRochTop_lower_diamond_slit (A : Set ℂ) (R L : ℝ)
    (hRL : 2 * R < L) (hA : ∀ z ∈ A, ‖z‖ ≤ R)
    (z : ℂ) (hz : |z.re| - z.im = L) :
    ∀ b ∈ A, z.re = b.re → z.im < b.im := by
  intro b hb he
  have hr : |z.re| ≤ R := by rw [he]; exact (Complex.abs_re_le_norm b).trans (hA b hb)
  have hi := (neg_le_abs b.im).trans ((Complex.abs_im_le_norm b).trans (hA b hb))
  linarith

/-- RiemannRochTop: the central part of an upper diamond boundary lies above all bounded punctures. -/
lemma RiemannRochTop_upper_diamond_above (A : Set ℂ) (R L : ℝ)
    (hRL : 2 * R < L) (hA : ∀ z ∈ A, ‖z‖ ≤ R)
    (z : ℂ) (hz : |z.re| + z.im = L) (hr : |z.re| ≤ R) :
    ∀ b ∈ A, b.im < z.im := by
  intro b hb
  have hi := (le_abs_self b.im).trans ((Complex.abs_im_le_norm b).trans (hA b hb))
  linarith

/-- RiemannRochTop: the central upper diamond graph joins points above every puncture. -/
lemma RiemannRochTop_upper_diamond_path (A : Set ℂ) (R L : ℝ)
    (hRL : 2 * R < L) (hA : ∀ z ∈ A, ‖z‖ ≤ R)
    (x y : {z : ℂ // z ∉ A})
    (hx : |(x : ℂ).re| ≤ R) (hy : |(y : ℂ).re| ≤ R)
    (hxg : |(x : ℂ).re| + (x : ℂ).im = L)
    (hyg : |(y : ℂ).re| + (y : ℂ).im = L) :
    ∃ d : Path x y,
      (∀ t, (d t : ℂ).re = (1 - (t : ℝ)) * (x : ℂ).re + (t : ℝ) * (y : ℂ).re) ∧
      (∀ t, |(d t : ℂ).re| + (d t : ℂ).im = L) ∧
      (∀ t, |(d t : ℂ).re| ≤ R) ∧
      (∀ t b, b ∈ A → b.im < (d t : ℂ).im) := by
  let u : unitInterval → ℝ := fun t ↦ (1 - (t : ℝ)) * (x : ℂ).re + (t : ℝ) * (y : ℂ).re
  have hu : ∀ t, |u t| ≤ R := by
    intro t
    have hmem := (convex_Icc (-R) R) (abs_le.mp hx) (abs_le.mp hy)
      (sub_nonneg.mpr t.property.2) t.property.1 (sub_add_cancel 1 (t : ℝ))
    exact abs_le.mpr hmem
  let z : unitInterval → ℂ := fun t ↦ ⟨u t, L - |u t|⟩
  have hzg : ∀ t, |(z t).re| + (z t).im = L := by intro t; dsimp [z]; ring
  have habove : ∀ t b, b ∈ A → b.im < (z t).im := fun t ↦
    RiemannRochTop_upper_diamond_above A R L hRL hA (z t) (hzg t) (hu t)
  have hzc : Continuous z := by
    have he : z = fun t ↦ (u t : ℂ) + ((L - |u t| : ℝ) : ℂ) * Complex.I := by
      funext t
      apply Complex.ext <;> simp [z]
    rw [he]
    dsimp [u]
    fun_prop
  let d : Path x y := {
    toFun := fun t ↦ ⟨z t, fun hm ↦ (lt_irrefl _) (habove t (z t) hm)⟩
    continuous_toFun := hzc.subtype_mk _
    source' := by
      apply Subtype.ext
      apply Complex.ext
      · simp [z, u]
      · simp only [z, u, Set.Icc.coe_zero, sub_zero, one_mul, zero_mul, add_zero]
        linarith
    target' := by
      apply Subtype.ext
      apply Complex.ext
      · simp [z, u]
      · simp only [z, u, Set.Icc.coe_one, sub_self, zero_mul, one_mul, zero_add]
        linarith }
  exact ⟨d, fun _ ↦ rfl, hzg, hu, habove⟩

/-- RiemannRochTop: upper diamond paths between points in one cut strip remain in that strip. -/
lemma RiemannRochTop_upper_diamond_strip_path (A : Set ℂ) (R L : ℝ)
    (hRL : 2 * R < L) (hA : ∀ z ∈ A, ‖z‖ ≤ R) (a : A) (ε : ℝ)
    (x y : {z : ℂ // z ∉ A})
    (hx : |(x : ℂ).re| ≤ R) (hy : |(y : ℂ).re| ≤ R)
    (hxg : |(x : ℂ).re| + (x : ℂ).im = L)
    (hyg : |(y : ℂ).re| + (y : ℂ).im = L)
    (hxs : |(x : ℂ).re - (a : ℂ).re| < ε)
    (hys : |(y : ℂ).re - (a : ℂ).re| < ε) :
    ∃ d : Path x y,
      (∀ t, (d t : ℂ).re = (1 - (t : ℝ)) * (x : ℂ).re + (t : ℝ) * (y : ℂ).re) ∧
      (∀ t, |(d t : ℂ).re| + (d t : ℂ).im = L) ∧
      (∀ t, |(d t : ℂ).re - (a : ℂ).re| < ε ∧ (a : ℂ).im < (d t : ℂ).im) := by
  obtain ⟨d, hd, hg, _, ha⟩ := RiemannRochTop_upper_diamond_path A R L hRL hA x y hx hy hxg hyg
  refine ⟨d, hd, hg, fun t ↦ ⟨?_, ha t a a.property⟩⟩
  have hxi : (x : ℂ).re ∈ Set.Ioo ((a : ℂ).re - ε) ((a : ℂ).re + ε) := by
    obtain ⟨hl, hr⟩ := abs_lt.mp hxs
    constructor <;> linarith
  have hyi : (y : ℂ).re ∈ Set.Ioo ((a : ℂ).re - ε) ((a : ℂ).re + ε) := by
    obtain ⟨hl, hr⟩ := abs_lt.mp hys
    constructor <;> linarith
  have hm := (convex_Ioo ((a : ℂ).re - ε) ((a : ℂ).re + ε)) hxi hyi
    (sub_nonneg.mpr t.property.2) t.property.1 (sub_add_cancel 1 (t : ℝ))
  simp only [Set.mem_Ioo, smul_eq_mul] at hm
  rw [hd t, abs_lt]
  constructor <;> linarith [hm.1, hm.2]

/-- RiemannRochTop: paths reconstructed from real coordinates are homotopic through those coordinates. -/
lemma RiemannRochTop_real_coordinate_paths_homotopic
    {X : Type} [TopologicalSpace X] (f : C(ℝ, X)) (g : C(X, ℝ))
    {x y : X} (γ δ : Path x y)
    (hγ : ∀ t, f (g (γ t)) = γ t) (hδ : ∀ t, f (g (δ t)) = δ t) :
    γ.Homotopic δ := by
  refine ⟨{
    toFun := fun p ↦ f ((1 - (p.1 : ℝ)) * g (γ p.2) + (p.1 : ℝ) * g (δ p.2))
    continuous_toFun := by fun_prop
    map_zero_left := by intro t; simpa using hγ t
    map_one_left := by intro t; simpa using hδ t
    prop' := ?_ }⟩
  intro t u hu
  have heq : δ u = γ u := by
    rcases hu with rfl | hu
    · simp
    · have : u = 1 := Set.mem_singleton_iff.mp hu
      subst u
      simp
  change f ((1 - (t : ℝ)) * g (γ u) + (t : ℝ) * g (δ u)) = γ u
  rw [heq]
  convert hγ u using 1 <;> congr 1 <;> ring

/-- RiemannRochTop: the entire upper diamond graph avoids a bounded puncture set. -/
lemma RiemannRochTop_upper_diamond_map (A : Set ℂ) (R L : ℝ)
    (hRL : 2 * R < L) (hA : ∀ z ∈ A, ‖z‖ ≤ R) :
    ∃ f : C(ℝ, {z : ℂ // z ∉ A}),
      ∀ s, (f s : ℂ) = (s : ℂ) + ((L - |s| : ℝ) : ℂ) * Complex.I := by
  let q : ℝ → ℂ := fun s ↦ (s : ℂ) + ((L - |s| : ℝ) : ℂ) * Complex.I
  have hq : ∀ s, q s ∉ A := by
    intro s hs
    have hr : |s| ≤ R := by
      have := (Complex.abs_re_le_norm (q s)).trans (hA _ hs)
      simpa [q] using this
    have hi : L - |s| ≤ R := by
      have := (le_abs_self (q s).im).trans ((Complex.abs_im_le_norm (q s)).trans (hA _ hs))
      simpa [q] using this
    linarith
  exact ⟨⟨fun s ↦ ⟨q s, hq s⟩, by dsimp [q]; fun_prop⟩, fun _ ↦ rfl⟩

/-- RiemannRochTop: upper diamond graph paths with the same endpoints are homotopic. -/
lemma RiemannRochTop_upper_diamond_paths_homotopic (A : Set ℂ) (R L : ℝ)
    (hRL : 2 * R < L) (hA : ∀ z ∈ A, ‖z‖ ≤ R)
    {x y : {z : ℂ // z ∉ A}} (γ δ : Path x y)
    (hγ : ∀ t, |(γ t : ℂ).re| + (γ t : ℂ).im = L)
    (hδ : ∀ t, |(δ t : ℂ).re| + (δ t : ℂ).im = L) : γ.Homotopic δ := by
  obtain ⟨f, hf⟩ := RiemannRochTop_upper_diamond_map A R L hRL hA
  let g : C({z : ℂ // z ∉ A}, ℝ) := ⟨fun z ↦ (z : ℂ).re, by fun_prop⟩
  have he : ∀ z : {z : ℂ // z ∉ A}, |(z : ℂ).re| + (z : ℂ).im = L → f (g z) = z := by
    intro z hz
    apply Subtype.ext
    rw [hf]
    apply Complex.ext
    · simp [g]
    · simp only [g, ContinuousMap.coe_mk, Complex.add_im, Complex.ofReal_im,
        Complex.mul_im, Complex.ofReal_re, Complex.I_im, Complex.I_re, mul_one,
        mul_zero, add_zero, zero_add]
      linarith
  exact RiemannRochTop_real_coordinate_paths_homotopic f g γ δ
    (fun t ↦ he _ (hγ t)) (fun t ↦ he _ (hδ t))

/-- RiemannRochTop: a finite path chain stays in any set containing its initial point and segments. -/
lemma RiemannRochTop_concat_range_subset {X : Type} [TopologicalSpace X]
    (S : Set X) {n : ℕ} (p : Fin (n + 1) → X)
    (d : (k : Fin n) → Path (p k.castSucc) (p k.succ))
    (hp : p 0 ∈ S) (hd : ∀ k t, d k t ∈ S) : ∀ t, Path.concat p d t ∈ S := by
  induction n with
  | zero => simpa using (fun _ : unitInterval ↦ hp)
  | succ n ih =>
    intro t
    rw [Path.concat_succ]
    have hm : ((Path.concat (p ∘ Fin.castSucc) (fun k ↦ d k.castSucc)).trans
        (d (Fin.last n))) t ∈
        Set.range ((Path.concat (p ∘ Fin.castSucc) (fun k ↦ d k.castSucc)).trans
          (d (Fin.last n))) := ⟨t, rfl⟩
    rw [Path.trans_range] at hm
    rcases hm with ⟨u, hu⟩ | ⟨u, hu⟩
    · exact (congrArg (fun z ↦ z ∈ S) hu).mp
        (ih (p ∘ Fin.castSucc) (fun k ↦ d k.castSucc) hp (fun k ↦ hd k.castSucc) u)
    · exact (congrArg (fun z ↦ z ∈ S) hu).mp (hd (Fin.last n) u)

/-- RiemannRochTop: vertically separated finite punctures have a strictly horizontally ordered enumeration. -/
lemma RiemannRochTop_ordered_punctures (A : Set ℂ) (hA : A.Finite)
    (hi : Set.InjOn Complex.re A) :
    ∃ n : ℕ, ∃ e : Fin n ≃ A, StrictMono (fun k ↦ (e k : ℂ).re) := by
  letI := hA.fintype
  have hinj : Function.Injective (fun a : A ↦ (a : ℂ).re) := by
    intro x y h
    exact Subtype.ext (hi x.property y.property h)
  letI : LinearOrder A := LinearOrder.lift' (fun a : A ↦ (a : ℂ).re) hinj
  let e : Fin (Fintype.card A) ≃o A := Fintype.orderIsoFinOfCardEq A rfl
  exact ⟨Fintype.card A, e.toEquiv, fun _ _ h ↦ e.strictMono h⟩

/-- RiemannRochTop: distinct vertical puncture lines have a uniform positive separation. -/
lemma RiemannRochTop_uniform_horizontal_separation (A : Set ℂ) (hA : A.Finite)
    (hi : Set.InjOn Complex.re A) :
    ∃ ε : ℝ, 0 < ε ∧ ∀ a b : A, a ≠ b → 4 * ε ≤ |(a : ℂ).re - (b : ℂ).re| := by
  letI := hA.fintype
  let D : Set ℝ := (fun p : A × A ↦ |(p.1 : ℂ).re - (p.2 : ℂ).re|) '' {p | p.1 ≠ p.2}
  have hD : D.Finite := (Set.toFinite _).image _
  have hn : (0 : ℝ) ∉ D := by
    rintro ⟨⟨a, b⟩, hab, he⟩
    exact hab (Subtype.ext (hi a.property b.property (sub_eq_zero.mp (abs_eq_zero.mp he))))
  obtain ⟨δ, hδ, hb⟩ := Metric.mem_nhds_iff.mp (hD.isClosed.isOpen_compl.mem_nhds hn)
  refine ⟨δ / 4, by positivity, ?_⟩
  intro a b hab
  have hd : δ ≤ |(a : ℂ).re - (b : ℂ).re| := by
    apply le_of_not_gt
    intro hlt
    have hm : |(a : ℂ).re - (b : ℂ).re| ∈ Metric.ball (0 : ℝ) δ := by
      simpa [Metric.mem_ball, Real.dist_eq] using hlt
    exact hb hm ⟨(a, b), hab, rfl⟩
  linarith

/-- RiemannRochTop: gaps between consecutive ordered cut intervals contain no puncture lines. -/
lemma RiemannRochTop_ordered_horizontal_gap {n : ℕ} (s : Fin (n + 1) → ℝ)
    (hs : StrictMono s) (ε : ℝ) (hε : 0 < ε) (k : Fin n) (u : ℝ)
    (hu : s k.castSucc + ε ≤ u ∧ u ≤ s k.succ - ε) :
    ∀ j, u ≠ s j := by
  intro j he
  by_cases hj : j ≤ k.castSucc
  · have hm := hs.monotone hj
    linarith [hu.1]
  · have hj' : k.succ ≤ j := by
      have : ¬j.val ≤ k.val := hj
      change k.val + 1 ≤ j.val
      omega
    have hm := hs.monotone hj'
    linarith [hu.2]

/-- RiemannRochTop: points between consecutive ordered cut intervals belong to the slit domain. -/
lemma RiemannRochTop_ordered_gap_slit (A : Set ℂ) {n : ℕ} (e : Fin (n + 1) ≃ A)
    (he : StrictMono (fun k ↦ (e k : ℂ).re)) (ε : ℝ) (hε : 0 < ε)
    (k : Fin n) (z : ℂ)
    (hz : (e k.castSucc : ℂ).re + ε ≤ z.re ∧ z.re ≤ (e k.succ : ℂ).re - ε) :
    ∀ b ∈ A, z.re = b.re → z.im < b.im := by
  intro b hb hzb
  obtain ⟨j, hj⟩ := e.surjective ⟨b, hb⟩
  have hn := RiemannRochTop_ordered_horizontal_gap (fun k ↦ (e k : ℂ).re) he ε hε k z.re hz j
  exact False.elim (hn (by simpa only [hj] using hzb))

/-- RiemannRochTop: finitely many positive widths have a common strictly smaller positive width. -/
lemma RiemannRochTop_finite_positive_width {ι : Type} [Finite ι]
    (w : ι → ℝ) (hw : ∀ i, 0 < w i) : ∃ ε : ℝ, 0 < ε ∧ ∀ i, ε < w i := by
  have hD : (Set.range w).Finite := Set.finite_range w
  have hn : (0 : ℝ) ∉ Set.range w := by
    rintro ⟨i, hi⟩
    exact (ne_of_gt (hw i)) hi
  obtain ⟨δ, hδ, hb⟩ := Metric.mem_nhds_iff.mp (hD.isClosed.isOpen_compl.mem_nhds hn)
  refine ⟨δ / 2, by positivity, ?_⟩
  intro i
  have hd : δ ≤ w i := by
    apply le_of_not_gt
    intro hi
    have hm : w i ∈ Metric.ball (0 : ℝ) δ := by
      simpa [Metric.mem_ball, Real.dist_eq, abs_of_pos (hw i)] using hi
    exact hb hm ⟨i, rfl⟩
  linarith

/-- RiemannRochTop: ordered punctures have disjoint uniform cut intervals inside prescribed widths. -/
lemma RiemannRochTop_ordered_cut_intervals (A : Set ℂ) (hA : A.Finite)
    (hi : Set.InjOn Complex.re A) (w : A → ℝ) (hw : ∀ a, 0 < w a) :
    ∃ n : ℕ, ∃ e : Fin n ≃ A, ∃ ε : ℝ, 0 < ε ∧
      StrictMono (fun k ↦ (e k : ℂ).re) ∧
      (∀ a, ε < w a) ∧
      (∀ i j, i < j → (e i : ℂ).re + ε < (e j : ℂ).re - ε) ∧
      (∀ a b : A, a ≠ b → 4 * ε ≤ |(a : ℂ).re - (b : ℂ).re|) := by
  letI := hA.fintype
  obtain ⟨n, e, he⟩ := RiemannRochTop_ordered_punctures A hA hi
  obtain ⟨δ, hδ, hd⟩ := RiemannRochTop_finite_positive_width w hw
  obtain ⟨η, hη, hsep⟩ := RiemannRochTop_uniform_horizontal_separation A hA hi
  let ε := min δ η
  have hε : 0 < ε := lt_min hδ hη
  have hεsep : ∀ a b : A, a ≠ b → 4 * ε ≤ |(a : ℂ).re - (b : ℂ).re| := by
    intro a b hab
    have : ε ≤ η := min_le_right _ _
    linarith [hsep a b hab]
  refine ⟨n, e, ε, hε, he, fun a ↦ lt_of_le_of_lt (min_le_left _ _) (hd a), ?_, hεsep⟩
  intro i j hij
  have hne : e i ≠ e j := fun h ↦ (ne_of_lt hij) (e.injective h)
  have hs := hεsep (e i) (e j) hne
  rw [abs_of_neg (sub_neg.mpr (he hij))] at hs
  linarith

/-- RiemannRochTop: lines shifted by a small uniform width from a puncture line miss every puncture. -/
lemma RiemannRochTop_shifted_cut_line_slit (A : Set ℂ) (ε : ℝ) (hε : 0 < ε)
    (hsep : ∀ a b : A, a ≠ b → 4 * ε ≤ |(a : ℂ).re - (b : ℂ).re|)
    (a : A) (z : ℂ) (hz : |z.re - (a : ℂ).re| = ε) :
    ∀ b ∈ A, z.re = b.re → z.im < b.im := by
  intro b hb he
  by_cases hab : a = ⟨b, hb⟩
  · have hr : (a : ℂ).re = b.re := congrArg (fun c : A ↦ (c : ℂ).re) hab
    rw [he, hr, sub_self, abs_zero] at hz
    linarith
  · have hs := hsep a ⟨b, hb⟩ hab
    rw [he, abs_sub_comm] at hz
    change 4 * ε ≤ |(a : ℂ).re - b.re| at hs
    linarith

/-- RiemannRochTop: upper diamond arcs cross prescribed puncture strips between uniformly shifted endpoints. -/
lemma RiemannRochTop_upper_diamond_cut_arc (A : Set ℂ) (R L ε : ℝ)
    (hRL : 2 * R < L) (hA : ∀ z ∈ A, ‖z‖ ≤ R) (hε : 0 < ε)
    (hsep : ∀ a b : A, a ≠ b → 4 * ε ≤ |(a : ℂ).re - (b : ℂ).re|)
    (a : A) (w : ℝ) (hw : ε < w) (hR : |(a : ℂ).re| + ε ≤ R) :
    ∃ p q : {z : ℂ // z ∉ A}, ∃ d : Path p q,
      (p : ℂ).re = (a : ℂ).re - ε ∧ (q : ℂ).re = (a : ℂ).re + ε ∧
      (∀ b ∈ A, (p : ℂ).re = b.re → (p : ℂ).im < b.im) ∧
      (∀ b ∈ A, (q : ℂ).re = b.re → (q : ℂ).im < b.im) ∧
      (∀ t, |(d t : ℂ).re| + (d t : ℂ).im = L) ∧
      (∀ t, |(d t : ℂ).re - (a : ℂ).re| < w ∧ (a : ℂ).im < (d t : ℂ).im) := by
  obtain ⟨f, hf⟩ := RiemannRochTop_upper_diamond_map A R L hRL hA
  let p := f ((a : ℂ).re - ε)
  let q := f ((a : ℂ).re + ε)
  have hp : (p : ℂ).re = (a : ℂ).re - ε := by dsimp [p]; rw [hf]; simp
  have hq : (q : ℂ).re = (a : ℂ).re + ε := by dsimp [q]; rw [hf]; simp
  have hpg : |(p : ℂ).re| + (p : ℂ).im = L := by dsimp [p]; rw [hf]; simp
  have hqg : |(q : ℂ).re| + (q : ℂ).im = L := by dsimp [q]; rw [hf]; simp
  have hpε : |(p : ℂ).re - (a : ℂ).re| = ε := by rw [hp]; simp [abs_of_pos hε]
  have hqε : |(q : ℂ).re - (a : ℂ).re| = ε := by rw [hq]; simp [abs_of_pos hε]
  have hpR : |(p : ℂ).re| ≤ R := by
    rw [hp]
    have ht := abs_sub_le (a : ℂ).re 0 ε
    simp only [sub_zero, zero_sub, abs_neg, abs_of_pos hε] at ht
    exact ht.trans hR
  have hqR : |(q : ℂ).re| ≤ R := by
    rw [hq]
    have ht := abs_add_le (a : ℂ).re ε
    rw [abs_of_pos hε] at ht
    exact ht.trans hR
  obtain ⟨d, _, hdg, hds⟩ := RiemannRochTop_upper_diamond_strip_path A R L hRL hA a w p q
    hpR hqR hpg hqg (hpε ▸ hw) (hqε ▸ hw)
  exact ⟨p, q, d, hp, hq, RiemannRochTop_shifted_cut_line_slit A ε hε hsep a p hpε,
    RiemannRochTop_shifted_cut_line_slit A ε hε hsep a q hqε, hdg, hds⟩

/-- RiemannRochTop: arbitrary points on the upper diamond graph are joined by its horizontally linear path. -/
lemma RiemannRochTop_upper_diamond_graph_path (A : Set ℂ) (R L : ℝ)
    (hRL : 2 * R < L) (hA : ∀ z ∈ A, ‖z‖ ≤ R)
    (x y : {z : ℂ // z ∉ A})
    (hx : |(x : ℂ).re| + (x : ℂ).im = L)
    (hy : |(y : ℂ).re| + (y : ℂ).im = L) :
    ∃ d : Path x y,
      (∀ t, (d t : ℂ).re = (1 - (t : ℝ)) * (x : ℂ).re + (t : ℝ) * (y : ℂ).re) ∧
      (∀ t, |(d t : ℂ).re| + (d t : ℂ).im = L) := by
  obtain ⟨f, hf⟩ := RiemannRochTop_upper_diamond_map A R L hRL hA
  have he : ∀ z : {z : ℂ // z ∉ A}, |(z : ℂ).re| + (z : ℂ).im = L → f (z : ℂ).re = z := by
    intro z hz
    apply Subtype.ext
    rw [hf]
    apply Complex.ext
    · simp
    · simp only [Complex.add_im, Complex.ofReal_im, Complex.mul_im, Complex.ofReal_re,
        Complex.I_im, Complex.I_re, mul_one, mul_zero, add_zero, zero_add]
      linarith
  let d : Path x y := {
    toFun := fun t ↦ f ((1 - (t : ℝ)) * (x : ℂ).re + (t : ℝ) * (y : ℂ).re)
    continuous_toFun := by fun_prop
    source' := by simpa using he x hx
    target' := by simpa using he y hy }
  refine ⟨d, ?_, ?_⟩
  · intro t
    change (f _ : ℂ).re = _
    rw [hf]
    simp
  · intro t
    change |(f _ : ℂ).re| + (f _ : ℂ).im = L
    rw [hf]
    simp

/-- RiemannRochTop: successive ordered cut arcs are joined along the upper diamond through the slit domain. -/
lemma RiemannRochTop_upper_diamond_gap_path (A : Set ℂ) (R L : ℝ)
    (hRL : 2 * R < L) (hA : ∀ z ∈ A, ‖z‖ ≤ R)
    {n : ℕ} (e : Fin (n + 1) ≃ A) (he : StrictMono (fun k ↦ (e k : ℂ).re))
    (ε : ℝ) (hε : 0 < ε) (k : Fin n)
    (hgap : (e k.castSucc : ℂ).re + ε ≤ (e k.succ : ℂ).re - ε)
    (x y : {z : ℂ // z ∉ A})
    (hxr : (x : ℂ).re = (e k.castSucc : ℂ).re + ε)
    (hyr : (y : ℂ).re = (e k.succ : ℂ).re - ε)
    (hxg : |(x : ℂ).re| + (x : ℂ).im = L)
    (hyg : |(y : ℂ).re| + (y : ℂ).im = L) :
    ∃ d : Path x y, (∀ t, |(d t : ℂ).re| + (d t : ℂ).im = L) ∧
      (∀ t b, b ∈ A → (d t : ℂ).re = b.re → (d t : ℂ).im < b.im) := by
  obtain ⟨d, hd, hg⟩ := RiemannRochTop_upper_diamond_graph_path A R L hRL hA x y hxg hyg
  have hxy : (x : ℂ).re ≤ (y : ℂ).re := by rw [hxr, hyr]; exact hgap
  refine ⟨d, hg, fun t ↦ RiemannRochTop_ordered_gap_slit A e he ε hε k (d t) ?_⟩
  have hm := (convex_Icc (x : ℂ).re (y : ℂ).re)
    (show (x : ℂ).re ∈ Set.Icc (x : ℂ).re (y : ℂ).re from ⟨le_rfl, hxy⟩)
    (show (y : ℂ).re ∈ Set.Icc (x : ℂ).re (y : ℂ).re from ⟨hxy, le_rfl⟩)
    (sub_nonneg.mpr t.property.2) t.property.1 (sub_add_cancel 1 (t : ℝ))
  simp only [Set.mem_Icc, smul_eq_mul] at hm
  rw [← hd t] at hm
  simpa only [hxr, hyr] using hm

/-- RiemannRochTop: points beyond the extreme ordered puncture lines lie in the slit domain. -/
lemma RiemannRochTop_ordered_outer_lines_slit (A : Set ℂ) {n : ℕ}
    (e : Fin (n + 1) ≃ A) (he : StrictMono (fun k ↦ (e k : ℂ).re)) (z : ℂ)
    (hz : z.re < (e 0 : ℂ).re ∨ (e (Fin.last n) : ℂ).re < z.re) :
    ∀ b ∈ A, z.re = b.re → z.im < b.im := by
  intro b hb hzb
  obtain ⟨j, hj⟩ := e.surjective ⟨b, hb⟩
  have hjb : (e j : ℂ).re = b.re := congrArg (fun a : A ↦ (a : ℂ).re) hj
  rcases hz with hl | hr
  · have hm := he.monotone (show (0 : Fin (n + 1)) ≤ j from Nat.zero_le _)
    rw [hjb] at hm
    exact False.elim (by linarith)
  · have hm := he.monotone (Fin.le_last j)
    rw [hjb] at hm
    exact False.elim (by linarith)

/-- RiemannRochTop: upper diamond end segments beyond the puncture lines stay in the slit domain. -/
lemma RiemannRochTop_upper_diamond_tail_path (A : Set ℂ) (R L : ℝ)
    (hRL : 2 * R < L) (hA : ∀ z ∈ A, ‖z‖ ≤ R)
    {n : ℕ} (e : Fin (n + 1) ≃ A) (he : StrictMono (fun k ↦ (e k : ℂ).re))
    (x y : {z : ℂ // z ∉ A})
    (hxg : |(x : ℂ).re| + (x : ℂ).im = L)
    (hyg : |(y : ℂ).re| + (y : ℂ).im = L)
    (hside : ((x : ℂ).re < (e 0 : ℂ).re ∧ (y : ℂ).re < (e 0 : ℂ).re) ∨
      ((e (Fin.last n) : ℂ).re < (x : ℂ).re ∧ (e (Fin.last n) : ℂ).re < (y : ℂ).re)) :
    ∃ d : Path x y, (∀ t, |(d t : ℂ).re| + (d t : ℂ).im = L) ∧
      (∀ t b, b ∈ A → (d t : ℂ).re = b.re → (d t : ℂ).im < b.im) := by
  obtain ⟨d, hd, hg⟩ := RiemannRochTop_upper_diamond_graph_path A R L hRL hA x y hxg hyg
  refine ⟨d, hg, fun t ↦ RiemannRochTop_ordered_outer_lines_slit A e he (d t) ?_⟩
  rw [hd t]
  rcases hside with hl | hr
  · left
    exact (convex_Iio (e 0 : ℂ).re) hl.1 hl.2
      (sub_nonneg.mpr t.property.2) t.property.1 (sub_add_cancel 1 (t : ℝ))
  · right
    exact (convex_Ioi (e (Fin.last n) : ℂ).re) hr.1 hr.2
      (sub_nonneg.mpr t.property.2) t.property.1 (sub_add_cancel 1 (t : ℝ))

/-- RiemannRochTop: ordered upper diamond cuts have a compatible family of slit-domain connecting paths. -/
lemma RiemannRochTop_upper_diamond_ordered_gaps (A : Set ℂ) (R L : ℝ)
    (hRL : 2 * R < L) (hbound : ∀ z ∈ A, ‖z‖ ≤ R)
    {n : ℕ} (e : Fin (n + 1) ≃ A) (he : StrictMono (fun k ↦ (e k : ℂ).re))
    (ε : ℝ) (hε : 0 < ε)
    (hgap : ∀ k : Fin n, (e k.castSucc : ℂ).re + ε ≤ (e k.succ : ℂ).re - ε)
    (x : {z : ℂ // z ∉ A}) (hx : (x : ℂ).re < (e 0 : ℂ).re)
    (hxg : |(x : ℂ).re| + (x : ℂ).im = L)
    (p q : Fin (n + 1) → {z : ℂ // z ∉ A})
    (hp : ∀ k, (p k : ℂ).re = (e k : ℂ).re - ε)
    (hq : ∀ k, (q k : ℂ).re = (e k : ℂ).re + ε)
    (hpg : ∀ k, |(p k : ℂ).re| + (p k : ℂ).im = L)
    (hqg : ∀ k, |(q k : ℂ).re| + (q k : ℂ).im = L) :
    let v : Fin (n + 2) → {z : ℂ // z ∉ A} := Fin.cases x q
    ∃ g : (k : Fin (n + 1)) → Path (v k.castSucc) (p k),
      (∀ k t, |(g k t : ℂ).re| + (g k t : ℂ).im = L) ∧
      (∀ k t b, b ∈ A → (g k t : ℂ).re = b.re → (g k t : ℂ).im < b.im) := by
  dsimp only
  have hg : ∀ k : Fin (n + 1), ∃ g : Path (Fin.cases x q k.castSucc) (p k),
      (∀ t, |(g t : ℂ).re| + (g t : ℂ).im = L) ∧
      (∀ t b, b ∈ A → (g t : ℂ).re = b.re → (g t : ℂ).im < b.im) := by
    intro k
    refine Fin.cases ?_ (fun i ↦ ?_) k
    · exact RiemannRochTop_upper_diamond_tail_path A R L hRL hbound e he x (p 0)
        hxg (hpg 0) (Or.inl ⟨hx, by rw [hp 0]; linarith⟩)
    · exact RiemannRochTop_upper_diamond_gap_path A R L hRL hbound e he ε hε i
        (hgap i) (q i.castSucc) (p i.succ) (hq i.castSucc) (hp i.succ)
        (hqg i.castSucc) (hpg i.succ)
  choose g hg₁ hg₂ using hg
  exact ⟨g, hg₁, hg₂⟩

/-- RiemannRochTop: paths in one convex disk are homotopic while avoiding the punctures. -/
lemma RiemannRochTop_disk_paths_homotopic (A : Set ℂ) {x y : {z : ℂ // z ∉ A}}
    (γ δ : Path x y) (c : ℂ) (ε : ℝ) (hball : Metric.ball c ε ⊆ Aᶜ)
    (hγ : ∀ t, (γ t : ℂ) ∈ Metric.ball c ε)
    (hδ : ∀ t, (δ t : ℂ) ∈ Metric.ball c ε) : γ.Homotopic δ := by
  refine ⟨{
    toFun := fun p ↦ ⟨(1 - (p.1 : ℝ)) • (γ p.2 : ℂ) + (p.1 : ℝ) • (δ p.2 : ℂ),
      hball ((convex_ball c ε) (hγ p.2) (hδ p.2)
        (sub_nonneg.mpr p.1.property.2) p.1.property.1 (sub_add_cancel 1 _))⟩
    continuous_toFun := by fun_prop
    map_zero_left := by intro t; apply Subtype.ext; simp
    map_one_left := by intro t; apply Subtype.ext; simp
    prop' := ?_ }⟩
  intro t u hu
  have heq : δ u = γ u := by
    rcases hu with rfl | hu
    · simp
    · have : u = 1 := Set.mem_singleton_iff.mp hu
      subst u
      simp
  apply Subtype.ext
  change (1 - (t : ℝ)) • (γ u : ℂ) + (t : ℝ) • (δ u : ℂ) = (γ u : ℂ)
  rw [heq, ← add_smul, sub_add_cancel, one_smul]

/-- RiemannRochTop: a path in a puncture-free disk has a straight representative. -/
lemma RiemannRochTop_disk_straight_path (A : Set ℂ) {x y : {z : ℂ // z ∉ A}}
    (γ : Path x y) (c : ℂ) (ε : ℝ) (hball : Metric.ball c ε ⊆ Aᶜ)
    (hγ : ∀ t, (γ t : ℂ) ∈ Metric.ball c ε) :
    ∃ δ : Path x y, (∀ t, (δ t : ℂ) = AffineMap.lineMap (x : ℂ) y (t : ℝ)) ∧
      δ.Homotopic γ := by
  have hx : (x : ℂ) ∈ Metric.ball c ε := by simpa using hγ 0
  have hy : (y : ℂ) ∈ Metric.ball c ε := by simpa using hγ 1
  have hseg : ∀ t : unitInterval,
      AffineMap.lineMap (x : ℂ) y (t : ℝ) ∈ Metric.ball c ε := by
    intro t
    rw [AffineMap.lineMap_apply_module]
    exact (convex_ball c ε) hx hy (sub_nonneg.mpr t.property.2) t.property.1
      (sub_add_cancel 1 _)
  let δ : Path x y := {
    toFun := fun t ↦ ⟨AffineMap.lineMap (x : ℂ) y (t : ℝ), hball (hseg t)⟩
    continuous_toFun := by fun_prop
    source' := by apply Subtype.ext; simp
    target' := by apply Subtype.ext; simp }
  exact ⟨δ, fun _ ↦ rfl, RiemannRochTop_disk_paths_homotopic A δ γ c ε hball hseg hγ⟩

/-- RiemannRochTop: finite puncture avoidance permits a polygonal representative of every path. -/
lemma RiemannRochTop_polygonal_subdivision (A : Set ℂ) (hA : A.Finite)
    {x y : {z : ℂ // z ∉ A}} (γ : Path x y) :
    ∃ N : ℕ, ∃ t : Fin (N + 1) → unitInterval, t 0 = 0 ∧ t (Fin.last N) = 1 ∧
      ∃ δ : (k : Fin N) → Path (γ (t k.castSucc)) (γ (t k.succ)),
        (∀ k u, (δ k u : ℂ) = AffineMap.lineMap (γ (t k.castSucc) : ℂ)
          (γ (t k.succ) : ℂ) (u : ℝ)) ∧
        (Path.concat (γ ∘ t) δ).Homotopic (γ.subpath (t 0) (t (Fin.last N))) := by
  let γ' : C(unitInterval, ℂ) := ⟨fun u ↦ (γ u : ℂ), by fun_prop⟩
  obtain ⟨t, ht, hmono, ⟨N, hN⟩, hcover⟩ :=
    RiemannRochTop_punctured_subdivision A hA γ' (fun u ↦ (γ u).property)
  have hpaths : ∀ k : Fin N, ∃ δ : Path (γ (t k.val)) (γ (t (k.val + 1))),
      (∀ u, (δ u : ℂ) = AffineMap.lineMap (γ (t k.val) : ℂ)
        (γ (t (k.val + 1)) : ℂ) (u : ℝ)) ∧
      δ.Homotopic (γ.subpath (t k.val) (t (k.val + 1))) := by
    intro k
    obtain ⟨c, ε, _, hball, hc⟩ := hcover k.val
    apply RiemannRochTop_disk_straight_path A _ c ε hball
    intro u
    have hmem : (γ.subpath (t k.val) (t (k.val + 1))) u ∈
        γ '' Set.Icc (t k.val) (t (k.val + 1)) := by
      have hrange : (γ.subpath (t k.val) (t (k.val + 1))) u ∈
          Set.range (γ.subpath (t k.val) (t (k.val + 1))) := ⟨u, rfl⟩
      rw [Path.range_subpath, Set.uIcc_of_le (hmono (Nat.le_succ _))] at hrange
      exact hrange
    obtain ⟨v, hv, heq⟩ := hmem
    rw [← heq]
    exact hc v hv
  choose δ hδ hhom using hpaths
  refine ⟨N, fun k ↦ t k.val, ht, hN N le_rfl, δ, hδ, ?_⟩
  exact (Path.Homotopic.concat_hcomp _ _ _ hhom).trans
    (Path.Homotopic.concat_subpath γ (fun k : Fin (N + 1) ↦ t k.val))

/-- RiemannRochTop: a terminal stem cancels after basing a path segment. -/
lemma RiemannRochTop_segment_stem_cancellation
    {X : Type} [TopologicalSpace X] {o x y : X}
    (a : Path o x) (d : Path x y) (b : Path o y) :
    ((a.trans (d.trans b.symm)).trans b).Homotopic (a.trans d) := by
  apply (Path.Homotopic.trans_assoc a (d.trans b.symm) b).trans
  apply (Path.Homotopic.refl a).hcomp
  exact (Path.Homotopic.trans_assoc d b.symm b).trans
    (((Path.Homotopic.refl d).hcomp (Path.Homotopic.symm_trans b)).trans
      (Path.Homotopic.trans_refl d))

/-- RiemannRochTop: subdivision with vertex stems expresses a path by based segment loops. -/
lemma RiemannRochTop_concat_based_segments
    {X : Type} [TopologicalSpace X] (o : X) {n : ℕ}
    (p : Fin (n + 1) → X)
    (d : (k : Fin n) → Path (p k.castSucc) (p k.succ))
    (a : (k : Fin (n + 1)) → Path o (p k)) :
    ((Path.concat (fun _ : Fin (n + 1) ↦ o)
      (fun k ↦ (a k.castSucc).trans ((d k).trans (a k.succ).symm))).trans
        (a (Fin.last n))).Homotopic ((a 0).trans (Path.concat p d)) := by
  induction n with
  | zero =>
    simp only [Path.concat_zero]
    exact (Path.Homotopic.refl_trans (a 0)).trans (Path.Homotopic.trans_refl (a 0)).symm
  | succ n ih =>
    rw [Path.concat_succ, Path.concat_succ]
    have hi := ih (p ∘ Fin.castSucc) (fun k ↦ d k.castSucc)
      (fun k ↦ a k.castSucc)
    apply (Path.Homotopic.trans_assoc _ _ _).trans
    apply ((Path.Homotopic.refl _).hcomp
      (RiemannRochTop_segment_stem_cancellation
        (a (Fin.last n).castSucc) (d (Fin.last n)) (a (Fin.last (n + 1))))).trans
    apply (Path.Homotopic.trans_assoc _ _ _).symm.trans
    apply (hi.hcomp (Path.Homotopic.refl _)).trans
    exact Path.Homotopic.trans_assoc _ _ _

/-- RiemannRochTop: loop concatenation is the reversed product in the fundamental group convention. -/
lemma RiemannRochTop_concat_loop_class
    {X : Type} [TopologicalSpace X] (o : X) {n : ℕ} (d : Fin n → Path o o) :
    FundamentalGroup.fromPath ⟦Path.concat (fun _ : Fin (n + 1) ↦ o) d⟧ =
      (List.ofFn (fun k ↦ FundamentalGroup.fromPath ⟦d k⟧)).reverse.prod := by
  induction n with
  | zero =>
    simp only [Path.concat_zero, List.ofFn_zero, List.reverse_nil, List.prod_nil]
    rfl
  | succ n ih =>
    rw [Path.concat_succ, List.ofFn_succ', List.concat_eq_append, List.reverse_append]
    simp only [List.reverse_cons, List.reverse_nil, List.nil_append, List.cons_append,
      List.prod_cons]
    rw [← ih (fun k ↦ d k.castSucc)]
    rfl

/-- RiemannRochTop: a based polygonal chain is the product of its based segment classes. -/
lemma RiemannRochTop_concat_based_loop_class
    {X : Type} [TopologicalSpace X] (o : X) {n : ℕ}
    (p : Fin (n + 1) → X)
    (d : (k : Fin n) → Path (p k.castSucc) (p k.succ))
    (a : (k : Fin (n + 1)) → Path o (p k)) :
    FundamentalGroup.fromPath ⟦(a 0).trans ((Path.concat p d).trans (a (Fin.last n)).symm)⟧ =
      (List.ofFn (fun k ↦ FundamentalGroup.fromPath
        ⟦(a k.castSucc).trans ((d k).trans (a k.succ).symm)⟧)).reverse.prod := by
  let q := Path.concat (fun _ : Fin (n + 1) ↦ o)
    (fun k ↦ (a k.castSucc).trans ((d k).trans (a k.succ).symm))
  have h : ((a 0).trans ((Path.concat p d).trans (a (Fin.last n)).symm)).Homotopic q := by
    apply (Path.Homotopic.trans_assoc _ _ _).symm.trans
    apply ((RiemannRochTop_concat_based_segments o p d a).symm.hcomp
      (Path.Homotopic.refl (a (Fin.last n)).symm)).trans
    apply (Path.Homotopic.trans_assoc _ _ _).trans
    apply ((Path.Homotopic.refl q).hcomp (Path.Homotopic.trans_symm (a (Fin.last n)))).trans
    exact Path.Homotopic.trans_refl q
  have heq := congrArg FundamentalGroup.fromPath (Quotient.sound h)
  exact heq.trans (RiemannRochTop_concat_loop_class o _)

/-- RiemannRochTop: an upper diamond boundary segment factors through any finite chain on the same graph. -/
lemma RiemannRochTop_upper_diamond_chain_class (A : Set ℂ) (R L : ℝ)
    (hRL : 2 * R < L) (hA : ∀ z ∈ A, ‖z‖ ≤ R)
    (o : {z : ℂ // z ∉ A}) {n : ℕ}
    (p : Fin (n + 1) → {z : ℂ // z ∉ A})
    (d : (k : Fin n) → Path (p k.castSucc) (p k.succ))
    (a : (k : Fin (n + 1)) → Path o (p k))
    (γ : Path (p 0) (p (Fin.last n)))
    (hγ : ∀ t, |(γ t : ℂ).re| + (γ t : ℂ).im = L)
    (hd : ∀ k t, |(d k t : ℂ).re| + (d k t : ℂ).im = L) :
    FundamentalGroup.fromPath ⟦(a 0).trans (γ.trans (a (Fin.last n)).symm)⟧ =
      (List.ofFn (fun k ↦ FundamentalGroup.fromPath
        ⟦(a k.castSucc).trans ((d k).trans (a k.succ).symm)⟧)).reverse.prod := by
  have hp : |(p 0 : ℂ).re| + (p 0 : ℂ).im = L := by simpa using hγ 0
  have hh := RiemannRochTop_upper_diamond_paths_homotopic A R L hRL hA γ
    (Path.concat p d) hγ (RiemannRochTop_concat_range_subset
      {z : {z : ℂ // z ∉ A} | |(z : ℂ).re| + (z : ℂ).im = L} p d hp hd)
  have hb := (Path.Homotopic.refl (a 0)).hcomp
    (hh.hcomp (Path.Homotopic.refl (a (Fin.last n)).symm))
  exact (congrArg FundamentalGroup.fromPath (Quotient.sound hb)).trans
    (RiemannRochTop_concat_based_loop_class o p d a)

/-- RiemannRochTop: the complement of upward slits contracts below their endpoints. -/
lemma RiemannRochTop_vertical_slits_contractible (A : Set ℂ) (h : ℝ)
    (hh : ∀ a ∈ A, h < a.im) :
    ContractibleSpace {z : ℂ // ∀ a ∈ A, z.re = a.re → z.im < a.im} := by
  let S := {z : ℂ // ∀ a ∈ A, z.re = a.re → z.im < a.im}
  let o : S := ⟨⟨0, h⟩, fun a ha _ ↦ hh a ha⟩
  let g : C(S, S) := ⟨fun z ↦ ⟨⟨(z : ℂ).re, h⟩, fun a ha _ ↦ hh a ha⟩,
    by apply Continuous.subtype_mk; simp only [Complex.mk_eq_add_mul_I]; dsimp [S]; fun_prop⟩
  have hm : ∀ (t : unitInterval) (z : S) (a : ℂ), a ∈ A → (z : ℂ).re = a.re →
      (1 - (t : ℝ)) * (z : ℂ).im + (t : ℝ) * h < a.im := by
    intro t z a ha hz
    have hc := (convex_Iio a.im) (z.property a ha hz) (hh a ha)
      (sub_nonneg.mpr t.property.2) t.property.1 (sub_add_cancel 1 (t : ℝ))
    simpa only [smul_eq_mul, Set.mem_Iio] using hc
  let H : ContinuousMap.Homotopy (ContinuousMap.id S) g := {
    toFun := fun p ↦ ⟨⟨(p.2 : ℂ).re,
      (1 - (p.1 : ℝ)) * (p.2 : ℂ).im + (p.1 : ℝ) * h⟩, hm p.1 p.2⟩
    continuous_toFun := by
      apply Continuous.subtype_mk
      simp only [Complex.mk_eq_add_mul_I]
      dsimp [S]
      fun_prop
    map_zero_left := by intro z; apply Subtype.ext; apply Complex.ext <;> simp
    map_one_left := by intro z; apply Subtype.ext; apply Complex.ext <;> simp [g] }
  let K : ContinuousMap.Homotopy g (ContinuousMap.const S o) := {
    toFun := fun p ↦ ⟨⟨(1 - (p.1 : ℝ)) * (p.2 : ℂ).re, h⟩, fun a ha _ ↦ hh a ha⟩
    continuous_toFun := by
      apply Continuous.subtype_mk
      simp only [Complex.mk_eq_add_mul_I]
      dsimp [S]
      fun_prop
    map_zero_left := by intro z; apply Subtype.ext; apply Complex.ext <;> simp [g]
    map_one_left := by intro z; apply Subtype.ext; apply Complex.ext <;> simp [o] }
  exact (contractible_iff_id_nullhomotopic S).mpr ⟨o, ⟨H.trans K⟩⟩

/-- RiemannRochTop: finitely many punctures have an open contractible slit complement. -/
lemma RiemannRochTop_finite_slit_domain (A : Set ℂ) (hA : A.Finite) :
    IsOpen {z : ℂ | ∀ a ∈ A, z.re = a.re → z.im < a.im} ∧
      {z : ℂ | ∀ a ∈ A, z.re = a.re → z.im < a.im} ⊆ Aᶜ ∧
      ContractibleSpace {z : ℂ // ∀ a ∈ A, z.re = a.re → z.im < a.im} := by
  refine ⟨?_, ?_, ?_⟩
  · have heq : {z : ℂ | ∀ a ∈ A, z.re = a.re → z.im < a.im} =
        ⋂ a ∈ A, ({z : ℂ | z.re ≠ a.re} ∪ {z : ℂ | z.im < a.im}) := by
      ext z
      simp only [Set.mem_setOf_eq, Set.mem_iInter, Set.mem_union, imp_iff_not_or]
    rw [heq]
    exact hA.isOpen_biInter fun a _ ↦
      (isOpen_ne_fun Complex.continuous_re continuous_const).union
        (isOpen_lt Complex.continuous_im continuous_const)
  · intro z hz hmem
    exact (lt_irrefl z.im) (hz z hmem rfl)
  · obtain ⟨h, hh⟩ := (hA.image Complex.im).bddBelow
    apply RiemannRochTop_vertical_slits_contractible A (h - 1)
    intro a ha
    have hb : h ≤ a.im := hh ⟨a, ha, rfl⟩
    linarith

/-- RiemannRochTop: a real shear separates the horizontal coordinates of finitely many points. -/
lemma RiemannRochTop_finite_separating_projection (A : Set ℂ) (hA : A.Finite) :
    ∃ t : ℝ, Set.InjOn (fun z : ℂ ↦ z.re + t * z.im) A := by
  let F : ℂ × ℂ → ℝ := fun p ↦ (p.2.re - p.1.re) / (p.1.im - p.2.im)
  obtain ⟨t, ht⟩ := ((hA.prod hA).image F).exists_notMem
  refine ⟨t, ?_⟩
  intro z hz w hw heq
  by_cases hi : z.im = w.im
  · apply Complex.ext
    · dsimp at heq
      rw [hi] at heq
      linarith
    · exact hi
  · exfalso
    apply ht
    refine ⟨(z, w), ⟨hz, hw⟩, ?_⟩
    dsimp [F]
    apply (div_eq_iff (sub_ne_zero.mpr hi)).mpr
    dsimp at heq
    nlinarith

/-- RiemannRochTop: a plane homeomorphism places finite punctures on distinct vertical lines. -/
lemma RiemannRochTop_finite_vertical_position (A : Set ℂ) (hA : A.Finite) :
    ∃ t : ℝ, ∃ e : ℂ ≃ₜ ℂ,
      (∀ z, e z = ⟨z.re + t * z.im, z.im⟩) ∧ Set.InjOn Complex.re (e '' A) := by
  obtain ⟨t, ht⟩ := RiemannRochTop_finite_separating_projection A hA
  let e : ℂ ≃ₜ ℂ := {
    toFun := fun z ↦ ⟨z.re + t * z.im, z.im⟩
    invFun := fun z ↦ ⟨z.re - t * z.im, z.im⟩
    left_inv := by intro z; apply Complex.ext <;> simp
    right_inv := by intro z; apply Complex.ext <;> simp
    continuous_toFun := by simp only [Complex.mk_eq_add_mul_I]; fun_prop
    continuous_invFun := by simp only [Complex.mk_eq_add_mul_I]; fun_prop }
  refine ⟨t, e, fun _ ↦ rfl, ?_⟩
  rintro _ ⟨z, hz, rfl⟩ _ ⟨w, hw, rfl⟩ heq
  exact congrArg e (ht hz hw heq)

/-- RiemannRochTop: a nonzero complex scaling separates the real parts of finite punctures. -/
lemma RiemannRochTop_finite_complex_scaling (A : Set ℂ) (hA : A.Finite) :
    ∃ c : ℂ, c ≠ 0 ∧ Set.InjOn Complex.re ((fun z ↦ c * z) '' A) := by
  obtain ⟨t, ht⟩ := RiemannRochTop_finite_separating_projection A hA
  let c : ℂ := ⟨1, -t⟩
  have hc : c ≠ 0 := by
    intro h
    have := congrArg Complex.re h
    norm_num [c] at this
  refine ⟨c, hc, ?_⟩
  rintro _ ⟨z, hz, rfl⟩ _ ⟨w, hw, rfl⟩ heq
  apply congrArg (fun z ↦ c * z)
  apply ht hz hw
  simpa [c, Complex.mul_re] using heq

/-- RiemannRochTop: points in the finite-puncture slit domain can be joined within that domain. -/
lemma RiemannRochTop_slit_path (A : Set ℂ) (hA : A.Finite)
    (x y : {z : ℂ // z ∉ A})
    (hx : ∀ b ∈ A, (x : ℂ).re = b.re → (x : ℂ).im < b.im)
    (hy : ∀ b ∈ A, (y : ℂ).re = b.re → (y : ℂ).im < b.im) :
    ∃ c : Path x y, ∀ t b, b ∈ A → (c t : ℂ).re = b.re → (c t : ℂ).im < b.im := by
  let S := {z : ℂ | ∀ b ∈ A, z.re = b.re → z.im < b.im}
  have hs := RiemannRochTop_finite_slit_domain A hA
  letI : ContractibleSpace S := hs.2.2
  let f : C(S, {z : ℂ // z ∉ A}) := ⟨fun z ↦ ⟨z, hs.2.1 z.property⟩, by fun_prop⟩
  let c := PathConnectedSpace.somePath (⟨x, hx⟩ : S) ⟨y, hy⟩
  exact ⟨c.map f.continuous, fun t ↦ (c t).property⟩

/-- RiemannRochTop: an outer circle of prescribed radius have a stem in the slit domain. -/
lemma RiemannRochTop_plane_outer_circle_stem (A : Set ℂ) (hA : A.Finite)
    (R L : ℝ) (hL : 0 ≤ L) (hRL : R < L) (hbound : ∀ z ∈ A, ‖z‖ ≤ R)
    (o : {z : ℂ // z ∉ A})
    (ho : ∀ b ∈ A, (o : ℂ).re = b.re → (o : ℂ).im < b.im) :
    ∃ x : {z : ℂ // z ∉ A}, ∃ k : Path o x, ∃ d : Path x x,
      (x : ℂ) = (L : ℂ) ∧
      (∀ t b, b ∈ A → (k t : ℂ).re = b.re → (k t : ℂ).im < b.im) ∧
      (∀ t, (d t : ℂ) =
        Complex.exp ((((t : ℝ) * (2 * Real.pi) : ℝ) : ℂ) * Complex.I) * (L : ℂ)) := by
  let q : unitInterval → ℂ := fun t ↦
    Complex.exp ((((t : ℝ) * (2 * Real.pi) : ℝ) : ℂ) * Complex.I) * (L : ℂ)
  have hn : ∀ t, ‖q t‖ = L := by
    intro t
    simp only [q, norm_mul, Complex.norm_exp_ofReal_mul_I, one_mul,
      Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hL]
  have hq : ∀ t, q t ∉ A := by
    intro t ht
    have h := hbound (q t) ht
    rw [hn] at h
    linarith
  let x : {z : ℂ // z ∉ A} := ⟨q 0, hq 0⟩
  have hx : (x : ℂ) = (L : ℂ) := by simp [x, q]
  have hxs : ∀ b ∈ A, (x : ℂ).re = b.re → (x : ℂ).im < b.im := by
    intro b hb he
    have hr := (le_abs_self b.re).trans ((Complex.abs_re_le_norm b).trans (hbound b hb))
    have he' : L = b.re := by simpa [hx] using he
    linarith
  obtain ⟨k, hk⟩ := RiemannRochTop_slit_path A hA o x ho hxs
  refine ⟨x, k, {
    toFun := fun t ↦ ⟨q t, hq t⟩
    continuous_toFun := (by fun_prop : Continuous q).subtype_mk hq
    source' := rfl
    target' := Subtype.ext (by simp [q, x, Complex.exp_two_pi_mul_I]) }, hx, hk, fun _ ↦ rfl⟩

/-- RiemannRochTop: upper diamond cut arcs have based slit-domain stems. -/
lemma RiemannRochTop_upper_diamond_based_cut (A : Set ℂ) (hA : A.Finite)
    (R L ε : ℝ) (hRL : 2 * R < L) (hbound : ∀ z ∈ A, ‖z‖ ≤ R) (hε : 0 < ε)
    (hsep : ∀ a b : A, a ≠ b → 4 * ε ≤ |(a : ℂ).re - (b : ℂ).re|)
    (a : A) (w : ℝ) (hw : ε < w) (hR : |(a : ℂ).re| + ε ≤ R)
    (o : {z : ℂ // z ∉ A})
    (ho : ∀ b ∈ A, (o : ℂ).re = b.re → (o : ℂ).im < b.im) :
    ∃ p q : {z : ℂ // z ∉ A}, ∃ α : Path o p, ∃ d : Path p q, ∃ β : Path q o,
      (p : ℂ).re = (a : ℂ).re - ε ∧ (q : ℂ).re = (a : ℂ).re + ε ∧
      (∀ t b, b ∈ A → (α t : ℂ).re = b.re → (α t : ℂ).im < b.im) ∧
      (∀ t, |(d t : ℂ).re - (a : ℂ).re| < w ∧ (a : ℂ).im < (d t : ℂ).im) ∧
      (∀ t b, b ∈ A → (β t : ℂ).re = b.re → (β t : ℂ).im < b.im) ∧
      (∀ t, |(d t : ℂ).re| + (d t : ℂ).im = L) := by
  obtain ⟨p, q, d, hp, hq, hpS, hqS, hdg, hds⟩ :=
    RiemannRochTop_upper_diamond_cut_arc A R L ε hRL hbound hε hsep a w hw hR
  obtain ⟨α, hα⟩ := RiemannRochTop_slit_path A hA o p ho hpS
  obtain ⟨β, hβ⟩ := RiemannRochTop_slit_path A hA q o hqS ho
  exact ⟨p, q, α, d, β, hp, hq, hα, hds, hβ, hdg⟩

/-- RiemannRochTop: horizontally separated finite punctures have isolating vertical strips. -/
lemma RiemannRochTop_vertical_strip_widths (A : Set ℂ) (hA : A.Finite)
    (hi : Set.InjOn Complex.re A) (a : ℂ) (ha : a ∈ A) :
    ∃ ε : ℝ, 0 < ε ∧ ∀ b ∈ A, |b.re - a.re| < ε → b = a := by
  let S := Complex.re '' (A \ {a})
  have hS : S.Finite := hA.sdiff.image Complex.re
  have hnot : a.re ∉ S := by
    rintro ⟨b, ⟨hb, hba⟩, heq⟩
    exact hba (hi hb ha heq)
  obtain ⟨ε, hε, hball⟩ := Metric.mem_nhds_iff.mp (hS.isClosed.isOpen_compl.mem_nhds hnot)
  refine ⟨ε, hε, ?_⟩
  intro b hb hdist
  by_contra hba
  have hmem : b.re ∈ Metric.ball a.re ε := by
    simpa only [Metric.mem_ball, Real.dist_eq] using hdist
  exact hball hmem ⟨b, ⟨hb, hba⟩, rfl⟩

/-- RiemannRochTop: inside an isolating disk only the central puncture affects slit membership. -/
lemma RiemannRochTop_slit_in_isolating_disk (A : Set ℂ) (a : ℂ) (ha : a ∈ A)
    (ε : ℝ) (hiso : ∀ b ∈ A, |b.re - a.re| < ε → b = a)
    (z : ℂ) (hz : ‖z - a‖ < ε) :
    (∀ b ∈ A, z.re = b.re → z.im < b.im) ↔
      (z.re = a.re → z.im < a.im) := by
  constructor
  · exact fun h ↦ h a ha
  · intro h b hb hzb
    have hw : |b.re - a.re| < ε := by
      calc
        |b.re - a.re| = |(z - a).re| := by simp [Complex.sub_re, hzb]
        _ ≤ ‖z - a‖ := Complex.abs_re_le_norm _
        _ < ε := hz
    have hba := hiso b hb hw
    subst b
    exact h hzb

/-- RiemannRochTop: the long circular arc meets the vertical centerline only below its center. -/
lemma RiemannRochTop_long_arc_cos_zero (θ : ℝ)
    (hθ : 3 * Real.pi / 4 ≤ θ ∧ θ ≤ 9 * Real.pi / 4)
    (hc : Real.cos θ = 0) : Real.sin θ = -1 := by
  have heq : θ = Real.pi + Real.pi / 2 := by
    apply le_antisymm
    · by_contra h
      have hp : 0 < Real.cos (θ - 2 * Real.pi) :=
        Real.cos_pos_of_mem_Ioo ⟨by linarith, by linarith [Real.pi_pos]⟩
      rw [Real.cos_sub_two_pi, hc] at hp
      exact (lt_irrefl 0) hp
    · by_contra h
      have hn := Real.cos_neg_of_pi_div_two_lt_of_lt
        (show Real.pi / 2 < θ by linarith [Real.pi_pos]) (lt_of_not_ge h)
      rw [hc] at hn
      exact (lt_irrefl 0) hn
  rw [heq, add_comm, Real.sin_add_pi, Real.sin_pi_div_two]

/-- RiemannRochTop: small circles split into upper-strip and slit-domain arcs. -/
lemma RiemannRochTop_isolating_circle_geometry (A : Set ℂ) (a : ℂ) (ha : a ∈ A)
    (ε ρ : ℝ) (hρ : 0 < ρ) (hρε : ρ < ε)
    (hiso : ∀ b ∈ A, |b.re - a.re| < ε → b = a) (θ : ℝ) :
    let z := a + Complex.exp ((θ : ℂ) * Complex.I) * (ρ : ℂ)
    z ∉ A ∧
    (Real.pi / 4 ≤ θ ∧ θ ≤ 3 * Real.pi / 4 →
      |z.re - a.re| < ε ∧ a.im < z.im) ∧
    (3 * Real.pi / 4 ≤ θ ∧ θ ≤ 9 * Real.pi / 4 →
      ∀ b ∈ A, z.re = b.re → z.im < b.im) := by
  dsimp only
  let z := a + Complex.exp ((θ : ℂ) * Complex.I) * (ρ : ℂ)
  have hn : ‖z - a‖ = ρ := by
    simp [z, norm_mul, Complex.norm_exp_ofReal_mul_I, abs_of_pos hρ]
  have hre : z.re = a.re + Real.cos θ * ρ := by
    simp [z, Complex.add_re, Complex.mul_re, Complex.exp_ofReal_mul_I_re]
  have him : z.im = a.im + Real.sin θ * ρ := by
    simp [z, Complex.add_im, Complex.mul_im, Complex.exp_ofReal_mul_I_im]
  have hw : |z.re - a.re| < ε := by
    calc
      |z.re - a.re| = |(z - a).re| := by rw [Complex.sub_re]
      _ ≤ ‖z - a‖ := Complex.abs_re_le_norm _
      _ < ε := hn ▸ hρε
  refine ⟨?_, ?_, ?_⟩
  · intro hz
    have hza := hiso z hz hw
    have hzero : ‖z - a‖ = 0 := by rw [hza, sub_self, norm_zero]
    linarith
  · intro hθ
    have hs := Real.sin_pos_of_pos_of_lt_pi
      (show 0 < θ by linarith [Real.pi_pos])
      (show θ < Real.pi by linarith [Real.pi_pos])
    exact ⟨hw, by change a.im < z.im; rw [him]; nlinarith⟩
  · intro hθ
    apply (RiemannRochTop_slit_in_isolating_disk A a ha ε hiso z (hn ▸ hρε)).mpr
    intro hc
    have hcos : Real.cos θ = 0 := by rw [hre] at hc; nlinarith
    have hs := RiemannRochTop_long_arc_cos_zero θ hθ hcos
    rw [him, hs]
    linarith

/-- RiemannRochTop: positive small circles have a short strip arc and a long slit arc. -/
lemma RiemannRochTop_isolating_positive_circle (A : Set ℂ) (a : ℂ) (ha : a ∈ A)
    (ε ρ : ℝ) (hρ : 0 < ρ) (hρε : ρ < ε)
    (hiso : ∀ b ∈ A, |b.re - a.re| < ε → b = a) :
    ∃ x : {z : ℂ // z ∉ A}, ∃ p : Path x x,
      (∀ t, (p t : ℂ) = a +
        Complex.exp (((Real.pi / 4 + (t : ℝ) * (2 * Real.pi) : ℝ) : ℂ) * Complex.I) *
          (ρ : ℂ)) ∧
      (∀ t : unitInterval, (t : ℝ) ≤ 1 / 4 →
        |(p t : ℂ).re - a.re| < ε ∧ a.im < (p t : ℂ).im) ∧
      (∀ t : unitInterval, 1 / 4 ≤ (t : ℝ) →
        ∀ b ∈ A, (p t : ℂ).re = b.re → (p t : ℂ).im < b.im) ∧
      a.re < (x : ℂ).re ∧
      ((p ⟨1 / 4, by norm_num⟩ : ℂ).re < a.re) := by
  let q : unitInterval → ℂ := fun t ↦ a +
    Complex.exp (((Real.pi / 4 + (t : ℝ) * (2 * Real.pi) : ℝ) : ℂ) * Complex.I) * (ρ : ℂ)
  have hq : ∀ t, q t ∉ A := fun t ↦
    (RiemannRochTop_isolating_circle_geometry A a ha ε ρ hρ hρε hiso _).1
  have hends : q 1 = q 0 := by
    have he : (((Real.pi / 4 + 1 * (2 * Real.pi) : ℝ) : ℂ) * Complex.I) =
        ((Real.pi / 4 : ℝ) : ℂ) * Complex.I + 2 * Real.pi * Complex.I := by push_cast; ring
    simp only [q, Set.Icc.coe_one, Set.Icc.coe_zero, zero_mul, add_zero]
    rw [he, Complex.exp_add, Complex.exp_two_pi_mul_I, mul_one]
  let x : {z : ℂ // z ∉ A} := ⟨q 0, hq 0⟩
  let p : Path x x := {
    toFun := fun t ↦ ⟨q t, hq t⟩
    continuous_toFun := (by fun_prop : Continuous q).subtype_mk hq
    source' := rfl
    target' := Subtype.ext hends }
  refine ⟨x, p, fun _ ↦ rfl, ?_, ?_, ?_, ?_⟩
  · intro t ht
    apply (RiemannRochTop_isolating_circle_geometry A a ha ε ρ hρ hρε hiso _).2.1
    have := t.property.1
    constructor <;> nlinarith [Real.pi_pos]
  · intro t ht
    apply (RiemannRochTop_isolating_circle_geometry A a ha ε ρ hρ hρε hiso _).2.2
    have := t.property.2
    constructor <;> nlinarith [Real.pi_pos]
  · have hc : 0 < Real.cos (Real.pi / 4) :=
      Real.cos_pos_of_mem_Ioo ⟨by linarith [Real.pi_pos], by linarith [Real.pi_pos]⟩
    change a.re < (q 0).re
    simp only [q, Set.Icc.coe_zero, zero_mul, add_zero, Complex.add_re, Complex.mul_re,
      Complex.ofReal_re, Complex.ofReal_im, mul_zero, sub_zero, Complex.exp_ofReal_mul_I_re]
    nlinarith
  · have hc : Real.cos (3 * Real.pi / 4) < 0 :=
      Real.cos_neg_of_pi_div_two_lt_of_lt (by linarith [Real.pi_pos]) (by linarith [Real.pi_pos])
    change (q ⟨1 / 4, by norm_num⟩).re < a.re
    have he : Real.pi / 4 + 1 / 4 * (2 * Real.pi) = 3 * Real.pi / 4 := by ring
    simp only [q, he, Complex.add_re, Complex.mul_re,
      Complex.ofReal_re, Complex.ofReal_im, mul_zero, sub_zero, Complex.exp_ofReal_mul_I_re]
    nlinarith

/-- RiemannRochTop: the slit domain and strips above the punctures cover the punctured plane. -/
lemma RiemannRochTop_slit_strip_cover (A : Set ℂ) (hA : A.Finite)
    (hi : Set.InjOn Complex.re A) :
    ∃ ε : A → ℝ, (∀ a, 0 < ε a) ∧
      Aᶜ = {z : ℂ | ∀ a ∈ A, z.re = a.re → z.im < a.im} ∪
        ⋃ a : A, {z : ℂ | |z.re - (a : ℂ).re| < ε a ∧ (a : ℂ).im < z.im} := by
  have hw : ∀ a : A, ∃ ε : ℝ, 0 < ε ∧
      ∀ b ∈ A, |b.re - (a : ℂ).re| < ε → b = a :=
    fun a ↦ RiemannRochTop_vertical_strip_widths A hA hi a a.property
  choose ε hε hiso using hw
  refine ⟨ε, hε, ?_⟩
  ext z
  constructor
  · intro hz
    by_cases hc : ∀ a ∈ A, z.re = a.re → z.im < a.im
    · exact Or.inl hc
    · right
      push_neg at hc
      obtain ⟨a, ha, hre, hle⟩ := hc
      have him : a.im < z.im := by
        by_contra hn
        have heq : z = a := Complex.ext hre (le_antisymm (le_of_not_gt hn) hle)
        exact hz (heq.symm ▸ ha)
      apply Set.mem_iUnion.mpr
      refine ⟨⟨a, ha⟩, ?_⟩
      exact ⟨by simpa only [hre, sub_self, abs_zero] using hε ⟨a, ha⟩, him⟩
  · rintro (hc | hc)
    · intro hz
      exact (lt_irrefl z.im) (hc z hz rfl)
    · obtain ⟨a, hwidth, him⟩ := Set.mem_iUnion.mp hc
      intro hz
      have heq := hiso a z hz hwidth
      exact (lt_irrefl (a : ℂ).im) (by simpa only [heq] using him)

/-- RiemannRochTop: upper vertical strips are open convex regions of the plane. -/
lemma RiemannRochTop_upper_strip_open_convex (a : ℂ) (ε : ℝ) :
    IsOpen {z : ℂ | |z.re - a.re| < ε ∧ a.im < z.im} ∧
      Convex ℝ {z : ℂ | |z.re - a.re| < ε ∧ a.im < z.im} := by
  have heq : {z : ℂ | |z.re - a.re| < ε ∧ a.im < z.im} =
      Complex.re ⁻¹' Set.Ioo (a.re - ε) (a.re + ε) ∩ Complex.im ⁻¹' Set.Ioi a.im := by
    ext z
    simp only [Set.mem_setOf_eq, abs_lt, Set.mem_inter_iff, Set.mem_preimage,
      Set.mem_Ioo, Set.mem_Ioi]
    constructor <;> rintro ⟨⟨h₁, h₂⟩, h₃⟩ <;>
      exact ⟨⟨by linarith, by linarith⟩, h₃⟩
  rw [heq]
  refine ⟨(isOpen_Ioo.preimage Complex.continuous_re).inter
    (isOpen_Ioi.preimage Complex.continuous_im), ?_⟩
  exact ((convex_Ioo (a.re - ε) (a.re + ε)).linear_preimage Complex.reLm).inter
    ((convex_Ioi a.im).linear_preimage Complex.imLm)

/-- RiemannRochTop: a cut strip meets the slit domain precisely away from its central ray. -/
lemma RiemannRochTop_slit_strip_overlap (A : Set ℂ) (a : ℂ) (ha : a ∈ A) (ε : ℝ)
    (hiso : ∀ b ∈ A, |b.re - a.re| < ε → b = a) :
    {z : ℂ | ∀ b ∈ A, z.re = b.re → z.im < b.im} ∩
      {z : ℂ | |z.re - a.re| < ε ∧ a.im < z.im} =
    {z : ℂ | |z.re - a.re| < ε ∧ a.im < z.im} ∩ {z : ℂ | z.re ≠ a.re} := by
  ext z
  constructor
  · rintro ⟨hzU, hzV⟩
    refine ⟨hzV, ?_⟩
    intro heq
    exact (not_lt_of_gt hzV.2) (hzU a ha heq)
  · rintro ⟨hzV, hzne⟩
    refine ⟨?_, hzV⟩
    intro b hb hzb
    have hbwidth : |b.re - a.re| < ε := by rw [← hzb]; exact hzV.1
    have hba := hiso b hb hbwidth
    exact False.elim (hzne (hzb.trans (congrArg Complex.re hba)))

/-- RiemannRochTop: finite punctures with distinct horizontal coordinates have disjoint cut strips. -/
lemma RiemannRochTop_disjoint_vertical_strips (A : Set ℂ) (hA : A.Finite)
    (hi : Set.InjOn Complex.re A) :
    ∃ ε : A → ℝ, (∀ a, 0 < ε a) ∧
      (∀ (a : A) (b : ℂ), b ∈ A → |b.re - (a : ℂ).re| < ε a → b = a) ∧
      Pairwise (fun a b : A ↦ Disjoint
        {z : ℂ | |z.re - (a : ℂ).re| < ε a}
        {z : ℂ | |z.re - (b : ℂ).re| < ε b}) := by
  have hw : ∀ a : A, ∃ δ : ℝ, 0 < δ ∧
      ∀ b ∈ A, |b.re - (a : ℂ).re| < δ → b = a :=
    fun a ↦ RiemannRochTop_vertical_strip_widths A hA hi a a.property
  choose δ hδ hiso using hw
  refine ⟨fun a ↦ δ a / 3, fun a ↦ div_pos (hδ a) (by norm_num), ?_, ?_⟩
  · intro a b hb hw
    exact hiso a b hb (by linarith [hδ a])
  · intro a b hab
    apply Set.disjoint_left.mpr
    intro z hza hzb
    have hda : δ a ≤ |(b : ℂ).re - (a : ℂ).re| := by
      apply le_of_not_gt
      intro h
      exact hab (Subtype.ext (hiso a b b.property h)).symm
    have hdb : δ b ≤ |(b : ℂ).re - (a : ℂ).re| := by
      rw [abs_sub_comm]
      apply le_of_not_gt
      intro h
      exact hab (Subtype.ext (hiso b a a.property h))
    have hz : |(b : ℂ).re - z.re| < δ b / 3 := by
      simpa only [Set.mem_setOf_eq, abs_sub_comm] using hzb
    have ht := abs_sub_le (b : ℂ).re z.re (a : ℂ).re
    change |z.re - (a : ℂ).re| < δ a / 3 at hza
    linarith [abs_nonneg ((b : ℂ).re - (a : ℂ).re)]

/-- RiemannRochTop: any isolating strip widths give the slit-domain covering. -/
lemma RiemannRochTop_slit_strip_cover_of_widths (A : Set ℂ) (ε : A → ℝ)
    (hε : ∀ a, 0 < ε a)
    (hiso : ∀ (a : A) (b : ℂ), b ∈ A → |b.re - (a : ℂ).re| < ε a → b = a) :
    Aᶜ = {z : ℂ | ∀ a ∈ A, z.re = a.re → z.im < a.im} ∪
      ⋃ a : A, {z : ℂ | |z.re - (a : ℂ).re| < ε a ∧ (a : ℂ).im < z.im} := by
  ext z
  constructor
  · intro hz
    by_cases hc : ∀ a ∈ A, z.re = a.re → z.im < a.im
    · exact Or.inl hc
    · right
      push_neg at hc
      obtain ⟨a, ha, hre, hle⟩ := hc
      have him : a.im < z.im := by
        by_contra hn
        have heq : z = a := Complex.ext hre (le_antisymm (le_of_not_gt hn) hle)
        exact hz (heq.symm ▸ ha)
      apply Set.mem_iUnion.mpr
      refine ⟨⟨a, ha⟩, ?_⟩
      exact ⟨by simpa only [hre, sub_self, abs_zero] using hε ⟨a, ha⟩, him⟩
  · rintro (hc | hc)
    · intro hz
      exact (lt_irrefl z.im) (hc z hz rfl)
    · obtain ⟨a, hwidth, him⟩ := Set.mem_iUnion.mp hc
      intro hz
      have heq := hiso a z hz hwidth
      exact (lt_irrefl (a : ℂ).im) (by simpa only [heq] using him)

/-- RiemannRochTop: the punctured plane has a slit cover with pairwise disjoint upper strips. -/
lemma RiemannRochTop_disjoint_slit_strip_cover (A : Set ℂ) (hA : A.Finite)
    (hi : Set.InjOn Complex.re A) :
    ∃ ε : A → ℝ, (∀ a, 0 < ε a) ∧
      (∀ (a : A) (b : ℂ), b ∈ A → |b.re - (a : ℂ).re| < ε a → b = a) ∧
      Pairwise (fun a b : A ↦ Disjoint
        {z : ℂ | |z.re - (a : ℂ).re| < ε a ∧ (a : ℂ).im < z.im}
        {z : ℂ | |z.re - (b : ℂ).re| < ε b ∧ (b : ℂ).im < z.im}) ∧
      Aᶜ = {z : ℂ | ∀ a ∈ A, z.re = a.re → z.im < a.im} ∪
        ⋃ a : A, {z : ℂ | |z.re - (a : ℂ).re| < ε a ∧ (a : ℂ).im < z.im} := by
  obtain ⟨ε, hε, hiso, hdisj⟩ := RiemannRochTop_disjoint_vertical_strips A hA hi
  refine ⟨ε, hε, hiso, ?_, RiemannRochTop_slit_strip_cover_of_widths A ε hε hiso⟩
  intro a b hab
  exact (hdisj hab).mono (fun _ hz ↦ hz.1) (fun _ hz ↦ hz.1)

/-- RiemannRochTop: a path in a slit-strip overlap stays on one side of the cut. -/
lemma RiemannRochTop_slit_overlap_path_side (A : Set ℂ) (a : ℂ) (ha : a ∈ A) (ε : ℝ)
    (γ : C(unitInterval, ℂ))
    (hγ : ∀ t, (∀ b ∈ A, (γ t).re = b.re → (γ t).im < b.im) ∧
      |(γ t).re - a.re| < ε ∧ a.im < (γ t).im) :
    (∀ t, (γ t).re < a.re) ∨ (∀ t, a.re < (γ t).re) := by
  have hne : ∀ t, (γ t).re ≠ a.re := by
    intro t heq
    exact (not_lt_of_gt (hγ t).2.2) ((hγ t).1 a ha heq)
  have h := isPreconnected_univ.mapsTo_Ioi_or_Iio
    (Complex.continuous_re.comp γ.continuous).continuousOn (fun t _ ↦ hne t)
  rcases h with h | h
  · exact Or.inr (fun t ↦ h (Set.mem_univ t))
  · exact Or.inl (fun t ↦ h (Set.mem_univ t))

/-- RiemannRochTop: the two sides of an upper cut strip are disjoint contractible regions. -/
lemma RiemannRochTop_upper_strip_halves (a : ℂ) (ε : ℝ) (hε : 0 < ε) :
    let V := {z : ℂ | |z.re - a.re| < ε ∧ a.im < z.im}
    ContractibleSpace ↥(V ∩ {z : ℂ | z.re < a.re}) ∧
      ContractibleSpace ↥(V ∩ {z : ℂ | a.re < z.re}) ∧
      Disjoint (V ∩ {z : ℂ | z.re < a.re}) (V ∩ {z : ℂ | a.re < z.re}) := by
  dsimp only
  have hV := (RiemannRochTop_upper_strip_open_convex a ε).2
  refine ⟨?_, ?_, ?_⟩
  · apply (hV.inter ((convex_Iio a.re).linear_preimage Complex.reLm)).contractibleSpace
    refine ⟨⟨a.re - ε / 2, a.im + 1⟩, ⟨?_, ?_⟩, ?_⟩
    · change |a.re - ε / 2 - a.re| < ε
      rw [abs_lt]
      constructor <;> linarith
    · change a.im < a.im + 1
      linarith
    · change a.re - ε / 2 < a.re
      linarith
  · apply (hV.inter ((convex_Ioi a.re).linear_preimage Complex.reLm)).contractibleSpace
    refine ⟨⟨a.re + ε / 2, a.im + 1⟩, ⟨?_, ?_⟩, ?_⟩
    · change |a.re + ε / 2 - a.re| < ε
      rw [abs_lt]
      constructor <;> linarith
    · change a.im < a.im + 1
      linarith
    · change a.re < a.re + ε / 2
      linarith
  · apply Set.disjoint_left.mpr
    intro z hzL hzR
    have hL : z.re < a.re := hzL.2
    have hR : a.re < z.re := hzR.2
    exact (not_lt_of_gt hR) hL

/-- RiemannRochTop: a two-valued cut transition is continuous away from its central line. -/
lemma RiemannRochTop_cut_transition_continuousAt
    {Y : Type} [TopologicalSpace Y] (u v : Y) (a : ℝ) (z : ℂ) (hz : z.re ≠ a) :
    ContinuousAt (fun w : ℂ ↦ if w.re < a then u else v) z := by
  by_cases hlt : z.re < a
  · apply (show ContinuousAt (fun _ : ℂ ↦ u) z from continuousAt_const).congr_of_eventuallyEq
    filter_upwards [(isOpen_lt Complex.continuous_re continuous_const).mem_nhds hlt] with w hw
    simp only [if_pos hw]
  · have hgt : a < z.re := lt_of_le_of_ne (le_of_not_gt hlt) hz.symm
    apply (show ContinuousAt (fun _ : ℂ ↦ v) z from continuousAt_const).congr_of_eventuallyEq
    filter_upwards [(isOpen_lt continuous_const Complex.continuous_re).mem_nhds hgt] with w hw
    simp only [if_neg (not_lt_of_gt hw)]

/-- RiemannRochTop: relative group-valued gauges define a bundle over an open cover. -/
def RiemannRochTop_gauge_bundle_core
    {ι X G : Type} [TopologicalSpace X] [Group G] [TopologicalSpace G]
    (U : ι → Set X) (hU : ∀ i, IsOpen (U i)) (hcover : ∀ x, ∃ i, x ∈ U i)
    (g : ι → X → G)
    (hg : ∀ i j, ContinuousOn
      (fun p : X × G ↦ (g j p.1)⁻¹ * g i p.1 * p.2) ((U i ∩ U j) ×ˢ Set.univ)) :
    FiberBundleCore ι X G where
  baseSet := U
  isOpen_baseSet := hU
  indexAt x := Classical.choose (hcover x)
  mem_baseSet_at x := Classical.choose_spec (hcover x)
  coordChange i j x v := (g j x)⁻¹ * g i x * v
  coordChange_self := by intro i x hx v; simp
  continuousOn_coordChange := hg
  coordChange_comp := by intro i j k x hx v; simp [mul_assoc]

/-- RiemannRochTop: a bundle core with discrete fiber has a covering projection. -/
lemma RiemannRochTop_discrete_bundle_covering
    {ι X F : Type} [TopologicalSpace X] [TopologicalSpace F] [DiscreteTopology F]
    (Z : FiberBundleCore ι X F) : IsCoveringMap Z.proj := by
  exact IsCoveringMap.mk Z.proj (fun _ : X ↦ F)
    (fun x ↦ Z.localTriv (Z.indexAt x)) (fun x ↦ Z.mem_baseSet_at x)

/-- RiemannRochTop: disjoint peripheral charts reduce gauge continuity to overlaps with one common chart. -/
lemma RiemannRochTop_star_cover_gauge_continuity
    {ι X G : Type} [TopologicalSpace X] [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
    (U : Option ι → Set X)
    (hdisj : Pairwise (fun i j : ι ↦ Disjoint (U (some i)) (U (some j))))
    (g : ι → X → G) (hg : ∀ i, ContinuousOn (g i) (U none ∩ U (some i))) :
    let χ : Option ι → X → G := fun i ↦ i.elim (fun _ ↦ 1) g
    ∀ i j, ContinuousOn (fun p : X × G ↦ (χ j p.1)⁻¹ * χ i p.1 * p.2)
      ((U i ∩ U j) ×ˢ Set.univ) := by
  dsimp only
  intro i j
  rcases i with _ | i <;> rcases j with _ | j
  · simp only [Option.elim_none, inv_one, one_mul]
    exact continuousOn_snd
  · have hc : ContinuousOn (fun p : X × G ↦ g j p.1)
        ((U none ∩ U (some j)) ×ˢ Set.univ) :=
      (hg j).comp continuousOn_fst (fun _ hp ↦ hp.1)
    simp only [Option.elim_none, Option.elim_some, mul_one]
    change ContinuousOn ((fun p : X × G ↦ g j p.1)⁻¹ * Prod.snd) _
    exact hc.inv.mul continuousOn_snd
  · have hc : ContinuousOn (fun p : X × G ↦ g i p.1)
        ((U (some i) ∩ U none) ×ˢ Set.univ) :=
      (hg i).comp continuousOn_fst (fun _ hp ↦ ⟨hp.1.2, hp.1.1⟩)
    simp only [Option.elim_none, Option.elim_some, inv_one, one_mul]
    change ContinuousOn ((fun p : X × G ↦ g i p.1) * Prod.snd) _
    exact hc.mul continuousOn_snd
  · by_cases hij : i = j
    · subst j
      simp only [Option.elim_some, inv_mul_cancel, one_mul]
      exact continuousOn_snd
    · rw [Set.disjoint_iff_inter_eq_empty.mp (hdisj hij), Set.empty_prod]
      exact continuousOn_empty _

/-- RiemannRochTop: arbitrary discrete group labels give coverings with specified cut transitions. -/
lemma RiemannRochTop_cut_label_covering
    (A : Set ℂ) (hA : A.Finite) (hi : Set.InjOn Complex.re A) :
    ∃ ε : A → ℝ, (∀ a, 0 < ε a) ∧
      (∀ (a : A) (b : ℂ), b ∈ A → |b.re - (a : ℂ).re| < ε a → b = a) ∧
      ∀ (G : Type) [Group G] [TopologicalSpace G] [DiscreteTopology G] (k : A → G),
      ∃ Z : FiberBundleCore (Option A) {z : ℂ // z ∉ A} G,
        Z.baseSet none = {z : {z : ℂ // z ∉ A} |
          ∀ b ∈ A, (z : ℂ).re = b.re → (z : ℂ).im < b.im} ∧
        (∀ a : A, Z.baseSet (some a) =
          {z : {z : ℂ // z ∉ A} |
            |(z : ℂ).re - (a : ℂ).re| < ε a ∧ (a : ℂ).im < (z : ℂ).im}) ∧
        (∀ (a : A) (z : {z : ℂ // z ∉ A}) (v : G), Z.coordChange none (some a) z v =
          (if (z : ℂ).re < (a : ℂ).re then 1 else k a)⁻¹ * v) ∧
        (∀ i j x v k, Z.coordChange i j x (v * k) = Z.coordChange i j x v * k) ∧
        IsCoveringMap Z.proj := by
  obtain ⟨ε, hε, hiso, hdisj, hcovset⟩ := RiemannRochTop_disjoint_slit_strip_cover A hA hi
  refine ⟨ε, hε, hiso, ?_⟩
  intro G _ _ _ k
  let B := {z : ℂ // z ∉ A}
  let U : Option A → Set B := fun i ↦ match i with
    | none => {z : B | ∀ b ∈ A, (z : ℂ).re = b.re → (z : ℂ).im < b.im}
    | some a => {z : B | |(z : ℂ).re - (a : ℂ).re| < ε a ∧ (a : ℂ).im < (z : ℂ).im}
  have hU : ∀ i, IsOpen (U i) := by
    rintro (_ | a)
    · exact (RiemannRochTop_finite_slit_domain A hA).1.preimage continuous_subtype_val
    · exact (RiemannRochTop_upper_strip_open_convex a (ε a)).1.preimage continuous_subtype_val
  have hcover : ∀ z : B, ∃ i, z ∈ U i := by
    intro z
    have hz : (z : ℂ) ∈ {z : ℂ | ∀ a ∈ A, z.re = a.re → z.im < a.im} ∪
        ⋃ a : A, {z : ℂ | |z.re - (a : ℂ).re| < ε a ∧ (a : ℂ).im < z.im} := by
      rw [← hcovset]
      exact z.property
    rcases hz with hz | hz
    · exact ⟨none, hz⟩
    · obtain ⟨a, ha⟩ := Set.mem_iUnion.mp hz
      exact ⟨some a, ha⟩
  have hd : Pairwise (fun a b : A ↦ Disjoint (U (some a)) (U (some b))) := by
    intro a b hab
    exact (hdisj hab).preimage Subtype.val
  let g : A → B → G := fun a z ↦ if (z : ℂ).re < (a : ℂ).re then 1 else k a
  have hg : ∀ a, ContinuousOn (g a) (U none ∩ U (some a)) := by
    intro a z hz
    have hne : (z : ℂ).re ≠ (a : ℂ).re := by
      intro heq
      exact (not_lt_of_gt hz.2.2) (hz.1 a a.property heq)
    change ContinuousWithinAt
      ((fun w : ℂ ↦ if w.re < (a : ℂ).re then (1 : G) else k a) ∘ Subtype.val) _ z
    exact ((RiemannRochTop_cut_transition_continuousAt (1 : G) (k a) (a : ℂ).re z hne).comp
      continuous_subtype_val.continuousAt).continuousWithinAt
  let χ : Option A → B → G := fun i ↦ i.elim (fun _ ↦ 1) g
  let Z := RiemannRochTop_gauge_bundle_core U hU hcover χ
    (RiemannRochTop_star_cover_gauge_continuity U hd g hg)
  refine ⟨Z, rfl, fun _ ↦ rfl, ?_, ?_, RiemannRochTop_discrete_bundle_covering Z⟩
  · intro a z v
    change (if (z : ℂ).re < (a : ℂ).re then (1 : G) else k a)⁻¹ * 1 * v = _
    rw [mul_one]
  · intro i j x v k
    exact (mul_assoc ((χ j x)⁻¹ * χ i x) v k).symm

/-- RiemannRochTop: transport within one bundle chart keeps its fiber coordinate fixed. -/
lemma RiemannRochTop_monodromy_in_chart
    {X U F : Type} [TopologicalSpace X] [TopologicalSpace U] [TopologicalSpace F]
    (f : U → X) (hf : IsCoveringMap f) (e : Bundle.Trivialization F f)
    {x y : X} (c : Path x y) (hc : ∀ t, c t ∈ e.baseSet) (u : f ⁻¹' {x}) :
    (hf.monodromy ⟦c⟧ u : U) = e.toOpenPartialHomeomorph.symm (y, (e u).2) := by
  let Δ : C(unitInterval, U) :=
    ⟨fun t ↦ e.toOpenPartialHomeomorph.symm (c t, (e u).2),
      e.continuousOn_invFun.comp_continuous
        (c.continuous.prodMk continuous_const) (fun t ↦ e.mem_target.mpr (hc t))⟩
  have hΔ : f ∘ Δ = c := funext fun t ↦ e.proj_symm_apply' (hc t)
  have hu : (u : U) ∈ e.source := e.mem_source.mpr (by
    rw [u.property]
    simpa using hc 0)
  have hΔ0 : Δ 0 = u := by
    change e.toOpenPartialHomeomorph.symm (c 0, (e u).2) = u
    have hfu : f u = x := u.property
    simpa only [c.source, hfu] using e.symm_apply_mk_proj hu
  have h := hf.monodromy_eq_apply_one hΔ hΔ0
  change (hf.monodromy ⟦c⟧ u : U) =
    e.toOpenPartialHomeomorph.symm (c 1, (e u).2) at h
  simpa only [c.target] using h

/-- RiemannRochTop: chart transport followed by a chart change is the core transition map. -/
lemma RiemannRochTop_bundle_monodromy_coordinates
    {ι X F : Type} [TopologicalSpace X] [TopologicalSpace F] [DiscreteTopology F]
    (Z : FiberBundleCore ι X F) (i j : ι) {x y : X}
    (c : Path x y) (hc : ∀ t, c t ∈ Z.baseSet i) (hj : y ∈ Z.baseSet j)
    (u : Z.proj ⁻¹' {x}) :
    ((Z.localTriv j) ((RiemannRochTop_discrete_bundle_covering Z).monodromy ⟦c⟧ u)).2 =
      Z.coordChange i j y ((Z.localTriv i) u).2 := by
  rw [RiemannRochTop_monodromy_in_chart Z.proj
    (RiemannRochTop_discrete_bundle_covering Z) (Z.localTriv i) c hc u]
  rw [Z.localTriv_symm_apply, Z.localTriv_apply]
  exact Z.coordChange_comp i (Z.indexAt y) j y
    ⟨⟨by simpa using hc 1, Z.mem_baseSet_at y⟩, hj⟩ _

/-- RiemannRochTop: a loop through two charts acts by its two transition maps. -/
lemma RiemannRochTop_bundle_two_chart_loop
    {ι X F : Type} [TopologicalSpace X] [TopologicalSpace F] [DiscreteTopology F]
    (Z : FiberBundleCore ι X F) (i j : ι) {x p q : X}
    (a : Path x p) (d : Path p q) (b : Path q x)
    (ha : ∀ t, a t ∈ Z.baseSet i) (hd : ∀ t, d t ∈ Z.baseSet j)
    (hb : ∀ t, b t ∈ Z.baseSet i) (u : Z.proj ⁻¹' {x}) :
    ((Z.localTriv i) ((RiemannRochTop_discrete_bundle_covering Z).monodromy
      ⟦(a.trans d).trans b⟧ u)).2 =
      Z.coordChange j i q (Z.coordChange i j p ((Z.localTriv i) u).2) := by
  let hf := RiemannRochTop_discrete_bundle_covering Z
  have hx : x ∈ Z.baseSet i := by simpa using ha 0
  have hp : p ∈ Z.baseSet j := by simpa using hd 0
  have hq : q ∈ Z.baseSet i := by simpa using hb 0
  change ((Z.localTriv i) (hf.monodromy
    (((Path.Homotopic.Quotient.mk a).trans (.mk d)).trans (.mk b)) u)).2 = _
  rw [hf.monodromy_trans_apply, hf.monodromy_trans_apply]
  trans Z.coordChange i i x
    ((Z.localTriv i) (hf.monodromy ⟦d⟧ (hf.monodromy ⟦a⟧ u))).2
  · exact RiemannRochTop_bundle_monodromy_coordinates Z i i b hb hx _
  rw [Z.coordChange_self i x hx]
  exact (RiemannRochTop_bundle_monodromy_coordinates Z j i d hd hq _).trans
    (congrArg (Z.coordChange j i q)
      (RiemannRochTop_bundle_monodromy_coordinates Z i j a ha hp u))

/-- RiemannRochTop: identity and inverse-label transitions give left multiplication by the label. -/
lemma RiemannRochTop_bundle_two_chart_label
    {ι X G : Type} [TopologicalSpace X] [Group G] [TopologicalSpace G] [DiscreteTopology G]
    (Z : FiberBundleCore ι X G) (i j : ι) {x p q : X}
    (a : Path x p) (d : Path p q) (b : Path q x)
    (ha : ∀ t, a t ∈ Z.baseSet i) (hd : ∀ t, d t ∈ Z.baseSet j)
    (hb : ∀ t, b t ∈ Z.baseSet i) (k : G)
    (hp : ∀ v, Z.coordChange i j p v = v)
    (hq : ∀ v, Z.coordChange i j q v = k⁻¹ * v) (u : Z.proj ⁻¹' {x}) :
    ((Z.localTriv i) ((RiemannRochTop_discrete_bundle_covering Z).monodromy
      ⟦(a.trans d).trans b⟧ u)).2 = k * ((Z.localTriv i) u).2 := by
  have hqi : q ∈ Z.baseSet i := by simpa using hb 0
  have hqj : q ∈ Z.baseSet j := by simpa using hd 1
  have hrev (v : G) : Z.coordChange j i q v = k * v := by
    have h := Z.coordChange_comp j i j q ⟨⟨hqj, hqi⟩, hqj⟩ v
    rw [hq, Z.coordChange_self j q hqj] at h
    calc
      Z.coordChange j i q v = k * (k⁻¹ * Z.coordChange j i q v) := by simp
      _ = k * v := congrArg (k * ·) h
  exact (RiemannRochTop_bundle_two_chart_loop Z i j a d b ha hd hb u).trans
    (by rw [hp, hrev])

/-- RiemannRochTop: equivariant transition maps make fiberwise right translations continuous. -/
lemma RiemannRochTop_bundle_right_translation_continuous
    {ι X G : Type} [TopologicalSpace X] [Group G] [TopologicalSpace G]
    [IsTopologicalGroup G] (Z : FiberBundleCore ι X G)
    (hZ : ∀ i j x v k, Z.coordChange i j x (v * k) = Z.coordChange i j x v * k)
    (k : G) : Continuous (fun p : Z.TotalSpace ↦
      (⟨p.1, (show G from p.2) * k⟩ : Z.TotalSpace)) := by
  apply continuous_iff_continuousAt.mpr
  intro p
  let i := Z.indexAt p.1
  have hp : p ∈ (Z.localTriv i).source := Z.mem_baseSet_at p.1
  have hn := (Z.localTriv i).open_source.mem_nhds hp
  apply ((Z.localTriv i).toOpenPartialHomeomorph.continuousAt_iff_continuousAt_comp_left
    (f := fun z : Z.TotalSpace ↦ (⟨z.1, (show G from z.2) * k⟩ : Z.TotalSpace)) hn).mpr
  have he : ContinuousAt (Z.localTriv i) p :=
    (Z.localTriv i).continuousOn.continuousAt hn
  convert he.fst.prodMk (he.snd.mul continuousAt_const) using 1
  ext z
  · rfl
  · exact hZ _ _ _ _ k

/-- RiemannRochTop: transport in an equivariant group bundle commutes with right multiplication. -/
lemma RiemannRochTop_bundle_monodromy_right_mul
    {ι X G : Type} [TopologicalSpace X] [Group G] [TopologicalSpace G] [DiscreteTopology G]
    (Z : FiberBundleCore ι X G)
    (hZ : ∀ i j x v k, Z.coordChange i j x (v * k) = Z.coordChange i j x v * k)
    {x y : X} (c : Path.Homotopic.Quotient x y) (u : Z.proj ⁻¹' {x}) (k : G) :
    (show G from ((RiemannRochTop_discrete_bundle_covering Z).monodromy c
      ⟨⟨u.val.1, (show G from u.val.2) * k⟩, u.property⟩).val.2) =
      (show G from ((RiemannRochTop_discrete_bundle_covering Z).monodromy c u).val.2) * k := by
  induction c using Quotient.inductionOn with
  | h c =>
    let T : C(Z.TotalSpace, Z.TotalSpace) :=
      ⟨fun p ↦ ⟨p.1, (show G from p.2) * k⟩,
        RiemannRochTop_bundle_right_translation_continuous Z hZ k⟩
    have h := RiemannRochTop_monodromy_naturality Z.proj
      (RiemannRochTop_discrete_bundle_covering Z) T (fun _ ↦ rfl) c u
    exact congrArg (fun p : Z.TotalSpace ↦ (show G from p.2)) h

/-- RiemannRochTop: right-equivariant permutation representations come from left translations. -/
lemma RiemannRochTop_right_equivariant_perm_hom
    {P G : Type} [Group P] [Group G] (ψ : P →* Equiv.Perm G)
    (hψ : ∀ p v k, ψ p (v * k) = ψ p v * k) :
    ∃ φ : P →* G, ∀ p v, ψ p v = φ p * v := by
  let φ : P →* G :=
    { toFun := fun p ↦ ψ p 1
      map_one' := by simp
      map_mul' := by
        intro p q
        rw [map_mul]
        change ψ p (ψ q 1) = ψ p 1 * ψ q 1
        simpa using hψ p 1 (ψ q 1) }
  refine ⟨φ, ?_⟩
  intro p v
  change ψ p v = ψ p 1 * v
  simpa using hψ p 1 v

/-- RiemannRochTop: a discrete equivariant bundle gives group-valued monodromy in any base chart. -/
lemma RiemannRochTop_bundle_chart_monodromy_hom
    {ι X G : Type} [TopologicalSpace X] [Group G] [TopologicalSpace G] [DiscreteTopology G]
    (Z : FiberBundleCore ι X G)
    (hZ : ∀ i j x v k, Z.coordChange i j x (v * k) = Z.coordChange i j x v * k)
    (i : ι) (x : X) (hx : x ∈ Z.baseSet i) :
    ∃ φ : FundamentalGroup X x →* G,
      ∀ (c : FundamentalGroup X x) (u : Z.proj ⁻¹' {x}),
        ((Z.localTriv i) ((RiemannRochTop_discrete_bundle_covering Z).monodromy c.asHom u)).2 =
          φ c * ((Z.localTriv i) u).2 := by
  let hf := RiemannRochTop_discrete_bundle_covering Z
  let e : (Z.proj ⁻¹' {x}) ≃ G :=
    ((Z.localTriv i).preimageSingletonHomeomorph hx).toEquiv
  let ψ := e.permCongrHom.toMonoidHom.comp (hf.monodromyPerm x)
  have he (u : Z.proj ⁻¹' {x}) (k : G) :
      e ⟨⟨u.val.1, (show G from u.val.2) * k⟩, u.property⟩ = e u * k := by
    exact hZ _ _ _ _ k
  have ht (c : Path.Homotopic.Quotient x x) (u : Z.proj ⁻¹' {x}) (k : G) :
      e (hf.monodromy c ⟨⟨u.val.1, (show G from u.val.2) * k⟩, u.property⟩) =
        e (hf.monodromy c u) * k := by
    induction c using Quotient.inductionOn with
    | h c =>
      let T : C(Z.TotalSpace, Z.TotalSpace) :=
        ⟨fun p ↦ ⟨p.1, (show G from p.2) * k⟩,
          RiemannRochTop_bundle_right_translation_continuous Z hZ k⟩
      have h := RiemannRochTop_monodromy_naturality Z.proj hf T (fun _ ↦ rfl) c u
      exact (congrArg (fun p : Z.TotalSpace ↦ ((Z.localTriv i) p).2) h).trans
        (hZ _ _ _ _ k)
  have hψ : ∀ c v k, ψ c (v * k) = ψ c v * k := by
    intro c v k
    change e (hf.monodromy c.asHom (e.symm (v * k))) =
      e (hf.monodromy c.asHom (e.symm v)) * k
    have hi : e.symm (v * k) =
        ⟨⟨(e.symm v).val.1, (show G from (e.symm v).val.2) * k⟩, (e.symm v).property⟩ := by
      apply e.injective
      rw [e.apply_symm_apply, he, e.apply_symm_apply]
    rw [hi]
    exact ht c.asHom (e.symm v) k
  obtain ⟨φ, hφ⟩ := RiemannRochTop_right_equivariant_perm_hom ψ hψ
  refine ⟨φ, ?_⟩
  intro c u
  have h := hφ c (e u)
  change e (hf.monodromy c.asHom (e.symm (e u))) = φ c * e u at h
  change e (hf.monodromy c.asHom u) = φ c * e u
  simpa only [e.symm_apply_apply] using h

/-- RiemannRochTop: cut-crossing loops have arbitrary prescribed images under group homomorphisms. -/
lemma RiemannRochTop_cut_label_monodromy
    (A : Set ℂ) (hA : A.Finite) (hi : Set.InjOn Complex.re A)
    (x : {z : ℂ // z ∉ A})
    (hx : ∀ b ∈ A, (x : ℂ).re = b.re → (x : ℂ).im < b.im) :
    ∃ ε : A → ℝ, (∀ a, 0 < ε a) ∧
      (∀ (a : A) (b : ℂ), b ∈ A → |b.re - (a : ℂ).re| < ε a → b = a) ∧
      ∀ (G : Type) [Group G] [TopologicalSpace G] [DiscreteTopology G] (k : A → G),
      ∃ φ : FundamentalGroup {z : ℂ // z ∉ A} x →* G,
      ∀ (a : A) (p q : {z : ℂ // z ∉ A}) (α : Path x p) (δ : Path p q) (β : Path q x),
        (∀ t, ∀ b ∈ A, (α t : ℂ).re = b.re → (α t : ℂ).im < b.im) →
        (∀ t, |(δ t : ℂ).re - (a : ℂ).re| < ε a ∧ (a : ℂ).im < (δ t : ℂ).im) →
        (∀ t, ∀ b ∈ A, (β t : ℂ).re = b.re → (β t : ℂ).im < b.im) →
        (p : ℂ).re < (a : ℂ).re → (a : ℂ).re < (q : ℂ).re →
        φ (FundamentalGroup.fromPath ⟦(α.trans δ).trans β⟧) = k a := by
  obtain ⟨ε, hε, hiso, hcov⟩ := RiemannRochTop_cut_label_covering A hA hi
  refine ⟨ε, hε, hiso, ?_⟩
  intro G _ _ _ k
  obtain ⟨Z, hU, hV, hchange, hZ, _⟩ := hcov G k
  have hxZ : x ∈ Z.baseSet none := by rw [hU]; exact hx
  obtain ⟨φ, hφ⟩ := RiemannRochTop_bundle_chart_monodromy_hom Z hZ none x hxZ
  refine ⟨φ, ?_⟩
  intro a p q α δ β hα hδ hβ hp hq
  have hαZ : ∀ t, α t ∈ Z.baseSet none := by intro t; rw [hU]; exact hα t
  have hδZ : ∀ t, δ t ∈ Z.baseSet (some a) := by intro t; rw [hV]; exact hδ t
  have hβZ : ∀ t, β t ∈ Z.baseSet none := by intro t; rw [hU]; exact hβ t
  have hleft : ∀ v, Z.coordChange none (some a) p v = v := by
    intro v
    rw [hchange, if_pos hp, inv_one, one_mul]
  have hright : ∀ v, Z.coordChange none (some a) q v = (k a)⁻¹ * v := by
    intro v
    rw [hchange, if_neg (not_lt_of_gt hq)]
  let u := ((Z.localTriv none).preimageSingletonHomeomorph hxZ).symm (1 : G)
  have hlabel := RiemannRochTop_bundle_two_chart_label Z none (some a)
    α δ β hαZ hδZ hβZ (k a) hleft hright u
  have hvalue := hφ (FundamentalGroup.fromPath ⟦(α.trans δ).trans β⟧) u
  exact mul_right_cancel (hvalue.symm.trans hlabel)

/-- RiemannRochTop: each isolating upper strip meets the slit domain on both sides of its cut. -/
lemma RiemannRochTop_cut_crossing_points (A : Set ℂ) (a : ℂ) (ε : ℝ) (hε : 0 < ε)
    (hiso : ∀ b ∈ A, |b.re - a.re| < ε → b = a) :
    ∃ p q : ℂ,
      (∀ b ∈ A, p.re = b.re → p.im < b.im) ∧
      (∀ b ∈ A, q.re = b.re → q.im < b.im) ∧
      (|p.re - a.re| < ε ∧ a.im < p.im) ∧
      (|q.re - a.re| < ε ∧ a.im < q.im) ∧ p.re < a.re ∧ a.re < q.re := by
  let p : ℂ := ⟨a.re - ε / 2, a.im + 1⟩
  let q : ℂ := ⟨a.re + ε / 2, a.im + 1⟩
  have hp : p.re < a.re := by dsimp [p]; linarith
  have hq : a.re < q.re := by dsimp [q]; linarith
  have hpw : |p.re - a.re| < ε := by
    rw [abs_of_neg (sub_neg.mpr hp)]
    dsimp [p]
    linarith
  have hqw : |q.re - a.re| < ε := by
    rw [abs_of_pos (sub_pos.mpr hq)]
    dsimp [q]
    linarith
  refine ⟨p, q, ?_, ?_, ⟨hpw, ?_⟩, ⟨hqw, ?_⟩, hp, hq⟩
  · intro b hb heq
    have hba := hiso b hb (by rw [← heq]; exact hpw)
    exact (hp.ne (heq.trans (congrArg Complex.re hba))).elim
  · intro b hb heq
    have hba := hiso b hb (by rw [← heq]; exact hqw)
    exact (hq.ne' (heq.trans (congrArg Complex.re hba))).elim
  · dsimp [p]; linarith
  · dsimp [q]; linarith

/-- RiemannRochTop: slit-domain stems and upper-strip paths give based cut-crossing loops. -/
lemma RiemannRochTop_cut_crossing_paths (A : Set ℂ) (hA : A.Finite)
    (a : ℂ) (ε : ℝ) (hε : 0 < ε)
    (hiso : ∀ b ∈ A, |b.re - a.re| < ε → b = a)
    (x : {z : ℂ // z ∉ A})
    (hx : ∀ b ∈ A, (x : ℂ).re = b.re → (x : ℂ).im < b.im) :
    ∃ (p q : {z : ℂ // z ∉ A}) (α : Path x p) (δ : Path p q) (β : Path q x),
      (∀ t, ∀ b ∈ A, (α t : ℂ).re = b.re → (α t : ℂ).im < b.im) ∧
      (∀ t, |(δ t : ℂ).re - a.re| < ε ∧ a.im < (δ t : ℂ).im) ∧
      (∀ t, ∀ b ∈ A, (β t : ℂ).re = b.re → (β t : ℂ).im < b.im) ∧
      (p : ℂ).re < a.re ∧ a.re < (q : ℂ).re := by
  obtain ⟨p, q, hpS, hqS, hpV, hqV, hp, hq⟩ :=
    RiemannRochTop_cut_crossing_points A a ε hε hiso
  let B := {z : ℂ // z ∉ A}
  let S := {z : ℂ | ∀ b ∈ A, z.re = b.re → z.im < b.im}
  let V := {z : ℂ | |z.re - a.re| < ε ∧ a.im < z.im}
  obtain ⟨_, hSA, hS⟩ := RiemannRochTop_finite_slit_domain A hA
  letI : ContractibleSpace S := hS
  letI : ContractibleSpace V :=
    (RiemannRochTop_upper_strip_open_convex a ε).2.contractibleSpace ⟨p, hpV⟩
  have hVA : V ⊆ Aᶜ := by
    intro z hz hza
    have heq := hiso z hza hz.1
    exact (ne_of_lt hz.2) (congrArg Complex.im heq).symm
  let fS : C(S, B) := ⟨fun z ↦ ⟨z, hSA z.property⟩, by fun_prop⟩
  let fV : C(V, B) := ⟨fun z ↦ ⟨z, hVA z.property⟩, by fun_prop⟩
  let α := PathConnectedSpace.somePath (⟨x, hx⟩ : S) ⟨p, hpS⟩
  let δ := PathConnectedSpace.somePath (⟨p, hpV⟩ : V) ⟨q, hqV⟩
  let β := PathConnectedSpace.somePath (⟨q, hqS⟩ : S) ⟨x, hx⟩
  exact ⟨⟨p, hSA hpS⟩, ⟨q, hSA hqS⟩,
    α.map fS.continuous, δ.map fV.continuous, β.map fS.continuous,
    fun t ↦ (α t).property, fun t ↦ (δ t).property, fun t ↦ (β t).property, hp, hq⟩

/-- RiemannRochTop: one geometric family of cut loops have arbitrary group-valued images. -/
lemma RiemannRochTop_cut_loops_prescribed_images
    (A : Set ℂ) (hA : A.Finite) (hi : Set.InjOn Complex.re A)
    (x : {z : ℂ // z ∉ A})
    (hx : ∀ b ∈ A, (x : ℂ).re = b.re → (x : ℂ).im < b.im) :
    ∃ ε : A → ℝ, (∀ a, 0 < ε a) ∧
      (∀ (a : A) (b : ℂ), b ∈ A → |b.re - (a : ℂ).re| < ε a → b = a) ∧
      ∃ γ : A → FundamentalGroup {z : ℂ // z ∉ A} x,
        (∀ a : A, ∃ (p q : {z : ℂ // z ∉ A})
          (α : Path x p) (δ : Path p q) (β : Path q x),
          (∀ t, ∀ b ∈ A, (α t : ℂ).re = b.re → (α t : ℂ).im < b.im) ∧
          (∀ t, |(δ t : ℂ).re - (a : ℂ).re| < ε a ∧ (a : ℂ).im < (δ t : ℂ).im) ∧
          (∀ t, ∀ b ∈ A, (β t : ℂ).re = b.re → (β t : ℂ).im < b.im) ∧
          (p : ℂ).re < (a : ℂ).re ∧ (a : ℂ).re < (q : ℂ).re ∧
          FundamentalGroup.fromPath ⟦(α.trans δ).trans β⟧ = γ a) ∧
        ∀ (G : Type) [Group G] (k : A → G),
          ∃ φ : FundamentalGroup {z : ℂ // z ∉ A} x →* G, ∀ a, φ (γ a) = k a := by
  obtain ⟨ε, hε, hiso, hm⟩ := RiemannRochTop_cut_label_monodromy A hA hi x hx
  have hpaths (a : A) :=
    RiemannRochTop_cut_crossing_paths A hA a (ε a) (hε a) (hiso a) x hx
  choose p q α δ β hα hδ hβ hp hq using hpaths
  let γ : A → FundamentalGroup {z : ℂ // z ∉ A} x :=
    fun a ↦ FundamentalGroup.fromPath ⟦((α a).trans (δ a)).trans (β a)⟧
  refine ⟨ε, hε, hiso, γ, ?_, ?_⟩
  · intro a
    exact ⟨p a, q a, α a, δ a, β a, hα a, hδ a, hβ a, hp a, hq a, rfl⟩
  · intro G _ k
    letI : TopologicalSpace G := ⊥
    letI : DiscreteTopology G := ⟨rfl⟩
    obtain ⟨φ, hφ⟩ := hm G k
    exact ⟨φ, fun a ↦ hφ a (p a) (q a) (α a) (δ a) (β a)
      (hα a) (hδ a) (hβ a) (hp a) (hq a)⟩

/-- RiemannRochTop: paths lying in a simply connected subset are homotopic in the ambient space. -/
lemma RiemannRochTop_paths_homotopic_in_subset
    {X : Type} [TopologicalSpace X] (S : Set X) [SimplyConnectedSpace S]
    {x y : X} (α β : Path x y) (hα : ∀ t, α t ∈ S) (hβ : ∀ t, β t ∈ S) :
    α.Homotopic β := by
  have hx : x ∈ S := by simpa using hα 0
  have hy : y ∈ S := by simpa using hα 1
  let α' : Path (⟨x, hx⟩ : S) ⟨y, hy⟩ :=
    { toFun := fun t ↦ ⟨α t, hα t⟩
      continuous_toFun := α.continuous.subtype_mk _
      source' := by apply Subtype.ext; exact α.source
      target' := by apply Subtype.ext; exact α.target }
  let β' : Path (⟨x, hx⟩ : S) ⟨y, hy⟩ :=
    { toFun := fun t ↦ ⟨β t, hβ t⟩
      continuous_toFun := β.continuous.subtype_mk _
      source' := by apply Subtype.ext; exact β.source
      target' := by apply Subtype.ext; exact β.target }
  exact (SimplyConnectedSpace.paths_homotopic α' β').map
    (⟨Subtype.val, continuous_subtype_val⟩ : C(S, X))

/-- RiemannRochTop: based segments contained with their stems in a simply connected set have trivial class. -/
lemma RiemannRochTop_based_segment_in_subset_eq_one
    {X : Type} [TopologicalSpace X] (S : Set X) [SimplyConnectedSpace S]
    {x p q : X} (α : Path x p) (d : Path p q) (β : Path q x)
    (hα : ∀ t, α t ∈ S) (hd : ∀ t, d t ∈ S) (hβ : ∀ t, β t ∈ S) :
    FundamentalGroup.fromPath ⟦α.trans (d.trans β)⟧ = 1 := by
  have hx : x ∈ S := by simpa using hα 0
  have hr : Set.range (α.trans (d.trans β)) ⊆ S := by
    rw [Path.trans_range, Path.trans_range]
    exact Set.union_subset (Set.range_subset_iff.mpr hα)
      (Set.union_subset (Set.range_subset_iff.mpr hd) (Set.range_subset_iff.mpr hβ))
  have hh := RiemannRochTop_paths_homotopic_in_subset S (α.trans (d.trans β)) (Path.refl x)
    (fun t ↦ hr ⟨t, rfl⟩) (fun _ ↦ hx)
  exact congrArg FundamentalGroup.fromPath (Quotient.sound hh)

/-- RiemannRochTop: a connecting segment in a simply connected stem domain does not change a based cut class. -/
lemma RiemannRochTop_based_segment_prefix_class
    {X : Type} [TopologicalSpace X] (S : Set X) [SimplyConnectedSpace S]
    {o x p q : X} (a : Path o x) (g : Path x p) (a₀ : Path o p)
    (d : Path p q) (b : Path q o)
    (ha : ∀ t, a t ∈ S) (hg : ∀ t, g t ∈ S) (ha₀ : ∀ t, a₀ t ∈ S) :
    FundamentalGroup.fromPath ⟦a.trans ((g.trans d).trans b)⟧ =
      FundamentalGroup.fromPath ⟦(a₀.trans d).trans b⟧ := by
  have hr : Set.range (a.trans g) ⊆ S := by
    rw [Path.trans_range]
    exact Set.union_subset (Set.range_subset_iff.mpr ha) (Set.range_subset_iff.mpr hg)
  have hh := RiemannRochTop_paths_homotopic_in_subset S (a.trans g) a₀
    (fun t ↦ hr ⟨t, rfl⟩) ha₀
  apply congrArg FundamentalGroup.fromPath
  apply Quotient.sound
  exact ((Path.Homotopic.refl a).hcomp (Path.Homotopic.trans_assoc g d b)).trans
    ((Path.Homotopic.trans_assoc a g (d.trans b)).symm.trans
      ((hh.hcomp (Path.Homotopic.refl (d.trans b))).trans
        (Path.Homotopic.trans_assoc a₀ d b).symm))

/-- RiemannRochTop: an open cover gives a finite subdivision whose subpaths lie in single charts. -/
lemma RiemannRochTop_open_cover_subpaths
    {ι X : Type} [TopologicalSpace X] (U : ι → Set X) (hU : ∀ i, IsOpen (U i))
    (hcover : ∀ x, ∃ i, x ∈ U i) {x y : X} (c : Path x y) :
    ∃ N : ℕ, ∃ t : Fin (N + 1) → unitInterval,
      t 0 = 0 ∧ t (Fin.last N) = 1 ∧
      ∀ k : Fin N, ∃ i, ∀ u, c.subpath (t k.castSucc) (t k.succ) u ∈ U i := by
  obtain ⟨t, ht, hmono, ⟨N, hN⟩, hsub⟩ :=
    exists_monotone_Icc_subset_open_cover_unitInterval
      (c := fun i ↦ c ⁻¹' U i) (fun i ↦ (hU i).preimage c.continuous)
      (fun u _ ↦ by obtain ⟨i, hi⟩ := hcover (c u); exact Set.mem_iUnion.mpr ⟨i, hi⟩)
  refine ⟨N, fun k ↦ t k.val, ht, hN N le_rfl, ?_⟩
  intro k
  obtain ⟨i, hi⟩ := hsub k.val
  refine ⟨i, ?_⟩
  intro u
  change c.subpath (t k.val) (t (k.val + 1)) u ∈ U i
  have hmem : c.subpath (t k.val) (t (k.val + 1)) u ∈
      c '' Set.Icc (t k.val) (t (k.val + 1)) := by
    rw [← Set.uIcc_of_le (hmono (Nat.le_succ _)), ← Path.range_subpath]
    exact Set.mem_range_self u
  obtain ⟨v, hv, heq⟩ := hmem
  rw [← heq]
  exact hi hv

/-- RiemannRochTop: compatible path squares identify three-segment based loops. -/
lemma RiemannRochTop_based_path_squares
    {X : Type} [TopologicalSpace X] {x p q p' q' : X}
    (a : Path x p) (d : Path p q) (b : Path q x)
    (a' : Path x p') (d' : Path p' q') (b' : Path q' x)
    (L : Path p p') (R : Path q q')
    (ha : (a.trans L).Homotopic a')
    (hd : (d.trans R).Homotopic (L.trans d'))
    (hb : (R.trans b').Homotopic b) :
    ((a.trans d).trans b).Homotopic ((a'.trans d').trans b') := by
  apply ((Path.Homotopic.refl (a.trans d)).hcomp hb.symm).trans
  apply (Path.Homotopic.trans_assoc (a.trans d) R b').symm.trans
  apply Path.Homotopic.hcomp ?_ (Path.Homotopic.refl b')
  apply (Path.Homotopic.trans_assoc a d R).trans
  apply ((Path.Homotopic.refl a).hcomp hd).trans
  apply (Path.Homotopic.trans_assoc a L d').symm.trans
  exact ha.hcomp (Path.Homotopic.refl d')

/-- RiemannRochTop: connected overlap choices identify loops through simply connected charts. -/
lemma RiemannRochTop_two_chart_loops_homotopic
    {X : Type} [TopologicalSpace X] (S T : Set X)
    [SimplyConnectedSpace S] [SimplyConnectedSpace T] {x p q p' q' : X}
    (a : Path x p) (d : Path p q) (b : Path q x)
    (a' : Path x p') (d' : Path p' q') (b' : Path q' x)
    (L : Path p p') (R : Path q q')
    (ha : ∀ t, a t ∈ S) (hd : ∀ t, d t ∈ T) (hb : ∀ t, b t ∈ S)
    (ha' : ∀ t, a' t ∈ S) (hd' : ∀ t, d' t ∈ T) (hb' : ∀ t, b' t ∈ S)
    (hL : ∀ t, L t ∈ S ∩ T) (hR : ∀ t, R t ∈ S ∩ T) :
    ((a.trans d).trans b).Homotopic ((a'.trans d').trans b') := by
  have htrans {u v w : X} (α : Path u v) (β : Path v w) (W : Set X)
      (hα : ∀ t, α t ∈ W) (hβ : ∀ t, β t ∈ W) : ∀ t, α.trans β t ∈ W := by
    apply Set.range_subset_iff.mp
    rw [Path.trans_range]
    exact Set.union_subset (Set.range_subset_iff.mpr hα) (Set.range_subset_iff.mpr hβ)
  apply RiemannRochTop_based_path_squares a d b a' d' b' L R
  · exact RiemannRochTop_paths_homotopic_in_subset S _ _
      (htrans a L S ha (fun t ↦ (hL t).1)) ha'
  · exact RiemannRochTop_paths_homotopic_in_subset T _ _
      (htrans d R T hd (fun t ↦ (hR t).2))
      (htrans L d' T (fun t ↦ (hL t).2) hd')
  · exact RiemannRochTop_paths_homotopic_in_subset S _ _
      (htrans R b' S (fun t ↦ (hR t).1) hb') hb

/-- RiemannRochTop: a contractible subset stays contractible inside an intermediate subspace. -/
lemma RiemannRochTop_contractible_nested_subset
    {X : Type} [TopologicalSpace X] (S B : Set X) (hSB : S ⊆ B)
    [ContractibleSpace S] : ContractibleSpace {x : B // (x : X) ∈ S} := by
  let e : {x : B // (x : X) ∈ S} ≃ₜ S :=
    { toFun := fun x ↦ ⟨x.val.val, x.property⟩
      invFun := fun x ↦ ⟨⟨x.val, hSB x.property⟩, x.property⟩
      left_inv := by intro x; rfl
      right_inv := by intro x; rfl
      continuous_toFun := by fun_prop
      continuous_invFun := by fun_prop }
  exact e.contractibleSpace

/-- RiemannRochTop: slit-domain stems turn upper boundary chains into the class of the full boundary loop. -/
lemma RiemannRochTop_upper_diamond_slit_chain_class (A : Set ℂ) (hA : A.Finite)
    (R L : ℝ) (hRL : 2 * R < L) (hbound : ∀ z ∈ A, ‖z‖ ≤ R)
    {n : ℕ} (p : Fin (n + 1) → {z : ℂ // z ∉ A})
    (d : (k : Fin n) → Path (p k.castSucc) (p k.succ))
    (a : (k : Fin (n + 1)) → Path (p 0) (p k))
    (γ : Path (p 0) (p (Fin.last n))) (β : Path (p (Fin.last n)) (p 0))
    (hγ : ∀ t, |(γ t : ℂ).re| + (γ t : ℂ).im = L)
    (hd : ∀ k t, |(d k t : ℂ).re| + (d k t : ℂ).im = L)
    (ha : ∀ k t b, b ∈ A → (a k t : ℂ).re = b.re → (a k t : ℂ).im < b.im)
    (hβ : ∀ t b, b ∈ A → (β t : ℂ).re = b.re → (β t : ℂ).im < b.im) :
    FundamentalGroup.fromPath ⟦γ.trans β⟧ =
      (List.ofFn (fun k ↦ FundamentalGroup.fromPath
        ⟦(a k.castSucc).trans ((d k).trans (a k.succ).symm)⟧)).reverse.prod := by
  let S₀ := {z : ℂ | ∀ b ∈ A, z.re = b.re → z.im < b.im}
  let S := {z : {z : ℂ // z ∉ A} | ∀ b ∈ A, (z : ℂ).re = b.re → (z : ℂ).im < b.im}
  have hSdata := RiemannRochTop_finite_slit_domain A hA
  letI : ContractibleSpace S₀ := hSdata.2.2
  letI : ContractibleSpace S := RiemannRochTop_contractible_nested_subset S₀ Aᶜ hSdata.2.1
  have hp : p 0 ∈ S := by simpa [S] using ha 0 0
  have hzero := RiemannRochTop_paths_homotopic_in_subset S (a 0) (Path.refl (p 0))
    (ha 0) (fun _ ↦ hp)
  have hlast := RiemannRochTop_paths_homotopic_in_subset S (a (Fin.last n)).symm β
    (fun t ↦ ha (Fin.last n) (unitInterval.symm t)) hβ
  have hh := (hzero.hcomp ((Path.Homotopic.refl γ).hcomp hlast)).trans
    (Path.Homotopic.refl_trans (γ.trans β))
  exact (congrArg FundamentalGroup.fromPath (Quotient.sound hh.symm)).trans
    (RiemannRochTop_upper_diamond_chain_class A R L hRL hbound (p 0) p d a γ hγ hd)

/-- RiemannRochTop: upper diamond chains with slit-domain gaps factor into their reference cut classes. -/
lemma RiemannRochTop_upper_diamond_excursion_chain_class (A : Set ℂ) (hA : A.Finite)
    (R L : ℝ) (hRL : 2 * R < L) (hbound : ∀ z ∈ A, ‖z‖ ≤ R)
    (o : {z : ℂ // z ∉ A}) {n : ℕ}
    (p : Fin (n + 1) → {z : ℂ // z ∉ A}) (q : Fin n → {z : ℂ // z ∉ A})
    (g : (k : Fin n) → Path (p k.castSucc) (q k))
    (d : (k : Fin n) → Path (q k) (p k.succ))
    (a : (k : Fin (n + 1)) → Path o (p k)) (α : (k : Fin n) → Path o (q k))
    (γ : Path (p 0) (p (Fin.last n)))
    (hγ : ∀ t, |(γ t : ℂ).re| + (γ t : ℂ).im = L)
    (hgg : ∀ k t, |(g k t : ℂ).re| + (g k t : ℂ).im = L)
    (hdg : ∀ k t, |(d k t : ℂ).re| + (d k t : ℂ).im = L)
    (ha : ∀ k t b, b ∈ A → (a k t : ℂ).re = b.re → (a k t : ℂ).im < b.im)
    (hg : ∀ k t b, b ∈ A → (g k t : ℂ).re = b.re → (g k t : ℂ).im < b.im)
    (hα : ∀ k t b, b ∈ A → (α k t : ℂ).re = b.re → (α k t : ℂ).im < b.im) :
    FundamentalGroup.fromPath ⟦(a 0).trans (γ.trans (a (Fin.last n)).symm)⟧ =
      (List.ofFn (fun k ↦ FundamentalGroup.fromPath
        ⟦((α k).trans (d k)).trans (a k.succ).symm⟧)).reverse.prod := by
  let S₀ := {z : ℂ | ∀ b ∈ A, z.re = b.re → z.im < b.im}
  let S := {z : {z : ℂ // z ∉ A} | ∀ b ∈ A, (z : ℂ).re = b.re → (z : ℂ).im < b.im}
  have hSdata := RiemannRochTop_finite_slit_domain A hA
  letI : ContractibleSpace S₀ := hSdata.2.2
  letI : ContractibleSpace S := RiemannRochTop_contractible_nested_subset S₀ Aᶜ hSdata.2.1
  have hgd : ∀ k t, |(((g k).trans (d k)) t : ℂ).re| +
      (((g k).trans (d k)) t : ℂ).im = L := by
    intro k t
    let T := {z : {z : ℂ // z ∉ A} | |(z : ℂ).re| + (z : ℂ).im = L}
    have hr : Set.range ((g k).trans (d k)) ⊆ T := by
      rw [Path.trans_range]
      exact Set.union_subset (Set.range_subset_iff.mpr (hgg k))
        (Set.range_subset_iff.mpr (hdg k))
    exact hr ⟨t, rfl⟩
  have hc := RiemannRochTop_upper_diamond_chain_class A R L hRL hbound o p
    (fun k ↦ (g k).trans (d k)) a γ hγ hgd
  have heq : ∀ k : Fin n, FundamentalGroup.fromPath
      ⟦(a k.castSucc).trans (((g k).trans (d k)).trans (a k.succ).symm)⟧ =
      FundamentalGroup.fromPath ⟦((α k).trans (d k)).trans (a k.succ).symm⟧ := by
    intro k
    exact RiemannRochTop_based_segment_prefix_class S (a k.castSucc) (g k) (α k)
      (d k) (a k.succ).symm (ha k.castSucc) (hg k) (hα k)
  exact hc.trans (congrArg (fun f : Fin n → FundamentalGroup {z : ℂ // z ∉ A} o ↦
    (List.ofFn f).reverse.prod) (funext heq))

/-- RiemannRochTop: ordered cut representatives multiply to the based upper boundary path through the last cut. -/
lemma RiemannRochTop_upper_diamond_ordered_product (A : Set ℂ) (hA : A.Finite) (R L : ℝ)
    (hRL : 2 * R < L) (hbound : ∀ z ∈ A, ‖z‖ ≤ R)
    {n : ℕ} (e : Fin (n + 1) ≃ A) (he : StrictMono (fun k ↦ (e k : ℂ).re))
    (ε : ℝ) (hε : 0 < ε)
    (hgap : ∀ k : Fin n, (e k.castSucc : ℂ).re + ε ≤ (e k.succ : ℂ).re - ε)
    (o x : {z : ℂ // z ∉ A}) (hx : (x : ℂ).re < (e 0 : ℂ).re)
    (hxg : |(x : ℂ).re| + (x : ℂ).im = L)
    (p q : Fin (n + 1) → {z : ℂ // z ∉ A})
    (hp : ∀ k, (p k : ℂ).re = (e k : ℂ).re - ε)
    (hq : ∀ k, (q k : ℂ).re = (e k : ℂ).re + ε)
    (d : (k : Fin (n + 1)) → Path (p k) (q k))
    (α : (k : Fin (n + 1)) → Path o (p k)) (β : (k : Fin (n + 1)) → Path (q k) o)
    (a₀ : Path o x)
    (hdg : ∀ k t, |(d k t : ℂ).re| + (d k t : ℂ).im = L)
    (hα : ∀ k t b, b ∈ A → (α k t : ℂ).re = b.re → (α k t : ℂ).im < b.im)
    (hβ : ∀ k t b, b ∈ A → (β k t : ℂ).re = b.re → (β k t : ℂ).im < b.im)
    (ha₀ : ∀ t b, b ∈ A → (a₀ t : ℂ).re = b.re → (a₀ t : ℂ).im < b.im)
    (γ : Path x (q (Fin.last n)))
    (hγ : ∀ t, |(γ t : ℂ).re| + (γ t : ℂ).im = L) :
    FundamentalGroup.fromPath ⟦a₀.trans (γ.trans (β (Fin.last n)))⟧ =
      (List.ofFn (fun k ↦ FundamentalGroup.fromPath
        ⟦((α k).trans (d k)).trans (β k)⟧)).reverse.prod := by
  have hpg : ∀ k, |(p k : ℂ).re| + (p k : ℂ).im = L := by
    intro k; simpa using hdg k 0
  have hqg : ∀ k, |(q k : ℂ).re| + (q k : ℂ).im = L := by
    intro k; simpa using hdg k 1
  obtain ⟨g, hgg, hg⟩ := RiemannRochTop_upper_diamond_ordered_gaps A R L hRL hbound
    e he ε hε hgap x hx hxg p q hp hq hpg hqg
  let v : Fin (n + 2) → {z : ℂ // z ∉ A} := Fin.cases x q
  let a : (k : Fin (n + 2)) → Path o (v k) := Fin.cases a₀ (fun k ↦ (β k).symm)
  have ha : ∀ k t b, b ∈ A → (a k t : ℂ).re = b.re → (a k t : ℂ).im < b.im := by
    intro k
    refine Fin.cases ?_ (fun i ↦ ?_) k
    · exact ha₀
    · exact fun t ↦ hβ i (unitInterval.symm t)
  have h := RiemannRochTop_upper_diamond_excursion_chain_class A hA R L hRL hbound o
    v p g d a α γ hγ hgg hdg ha hg hα
  change FundamentalGroup.fromPath ⟦a₀.trans (γ.trans (β (Fin.last n)).symm.symm)⟧ =
    (List.ofFn (fun k ↦ FundamentalGroup.fromPath
      ⟦((α k).trans (d k)).trans (β k).symm.symm⟧)).reverse.prod at h
  simpa only [Path.symm_symm] using h

/-- RiemannRochTop: a terminal upper boundary segment in the slit domain can be absorbed into a return stem. -/
lemma RiemannRochTop_upper_diamond_terminal_stem_class (A : Set ℂ) (hA : A.Finite)
    (R L : ℝ) (hRL : 2 * R < L) (hbound : ∀ z ∈ A, ‖z‖ ≤ R)
    {o x q y : {z : ℂ // z ∉ A}} (a : Path o x)
    (γ : Path x y) (δ : Path x q) (t : Path q y) (b : Path y o) (c : Path q o)
    (hγ : ∀ u, |(γ u : ℂ).re| + (γ u : ℂ).im = L)
    (hδ : ∀ u, |(δ u : ℂ).re| + (δ u : ℂ).im = L)
    (htg : ∀ u, |(t u : ℂ).re| + (t u : ℂ).im = L)
    (ht : ∀ u z, z ∈ A → (t u : ℂ).re = z.re → (t u : ℂ).im < z.im)
    (hb : ∀ u z, z ∈ A → (b u : ℂ).re = z.re → (b u : ℂ).im < z.im)
    (hc : ∀ u z, z ∈ A → (c u : ℂ).re = z.re → (c u : ℂ).im < z.im) :
    FundamentalGroup.fromPath ⟦a.trans (γ.trans b)⟧ =
      FundamentalGroup.fromPath ⟦a.trans (δ.trans c)⟧ := by
  let S₀ := {z : ℂ | ∀ b ∈ A, z.re = b.re → z.im < b.im}
  let S := {z : {z : ℂ // z ∉ A} | ∀ b ∈ A, (z : ℂ).re = b.re → (z : ℂ).im < b.im}
  let T := {z : {z : ℂ // z ∉ A} | |(z : ℂ).re| + (z : ℂ).im = L}
  have hSdata := RiemannRochTop_finite_slit_domain A hA
  letI : ContractibleSpace S₀ := hSdata.2.2
  letI : ContractibleSpace S := RiemannRochTop_contractible_nested_subset S₀ Aᶜ hSdata.2.1
  have hδt : Set.range (δ.trans t) ⊆ T := by
    rw [Path.trans_range]
    exact Set.union_subset (Set.range_subset_iff.mpr hδ) (Set.range_subset_iff.mpr htg)
  have htb : Set.range (t.trans b) ⊆ S := by
    rw [Path.trans_range]
    exact Set.union_subset (Set.range_subset_iff.mpr ht) (Set.range_subset_iff.mpr hb)
  have htop := RiemannRochTop_upper_diamond_paths_homotopic A R L hRL hbound γ (δ.trans t)
    hγ (fun u ↦ hδt ⟨u, rfl⟩)
  have hreturn := RiemannRochTop_paths_homotopic_in_subset S (t.trans b) c
    (fun u ↦ htb ⟨u, rfl⟩) hc
  apply congrArg FundamentalGroup.fromPath
  apply Quotient.sound
  exact (Path.Homotopic.refl a).hcomp
    ((htop.hcomp (Path.Homotopic.refl b)).trans
      ((Path.Homotopic.trans_assoc δ t b).trans
        ((Path.Homotopic.refl δ).hcomp hreturn)))

/-- RiemannRochTop: the full upper diamond boundary gives the ordered product of its cut excursions. -/
lemma RiemannRochTop_upper_diamond_full_product (A : Set ℂ) (hA : A.Finite)
    (R L : ℝ) (hRL : 2 * R < L) (hbound : ∀ z ∈ A, ‖z‖ ≤ R)
    {n : ℕ} (e : Fin (n + 1) ≃ A) (he : StrictMono (fun k ↦ (e k : ℂ).re))
    (ε : ℝ) (hε : 0 < ε)
    (hgap : ∀ k : Fin n, (e k.castSucc : ℂ).re + ε ≤ (e k.succ : ℂ).re - ε)
    (o x y : {z : ℂ // z ∉ A})
    (hx : (x : ℂ).re < (e 0 : ℂ).re) (hy : (e (Fin.last n) : ℂ).re < (y : ℂ).re)
    (hxg : |(x : ℂ).re| + (x : ℂ).im = L)
    (hyg : |(y : ℂ).re| + (y : ℂ).im = L)
    (p q : Fin (n + 1) → {z : ℂ // z ∉ A})
    (hp : ∀ k, (p k : ℂ).re = (e k : ℂ).re - ε)
    (hq : ∀ k, (q k : ℂ).re = (e k : ℂ).re + ε)
    (d : (k : Fin (n + 1)) → Path (p k) (q k))
    (α : (k : Fin (n + 1)) → Path o (p k)) (β : (k : Fin (n + 1)) → Path (q k) o)
    (a₀ : Path o x) (b₀ : Path y o)
    (hdg : ∀ k t, |(d k t : ℂ).re| + (d k t : ℂ).im = L)
    (hα : ∀ k t b, b ∈ A → (α k t : ℂ).re = b.re → (α k t : ℂ).im < b.im)
    (hβ : ∀ k t b, b ∈ A → (β k t : ℂ).re = b.re → (β k t : ℂ).im < b.im)
    (ha₀ : ∀ t b, b ∈ A → (a₀ t : ℂ).re = b.re → (a₀ t : ℂ).im < b.im)
    (hb₀ : ∀ t b, b ∈ A → (b₀ t : ℂ).re = b.re → (b₀ t : ℂ).im < b.im)
    (γ : Path x y) (hγ : ∀ t, |(γ t : ℂ).re| + (γ t : ℂ).im = L) :
    FundamentalGroup.fromPath ⟦a₀.trans (γ.trans b₀)⟧ =
      (List.ofFn (fun k ↦ FundamentalGroup.fromPath
        ⟦((α k).trans (d k)).trans (β k)⟧)).reverse.prod := by
  have hqg : |(q (Fin.last n) : ℂ).re| + (q (Fin.last n) : ℂ).im = L := by
    simpa using hdg (Fin.last n) 1
  obtain ⟨δ, _, hδ⟩ := RiemannRochTop_upper_diamond_graph_path A R L hRL hbound
    x (q (Fin.last n)) hxg hqg
  obtain ⟨t, htg, ht⟩ := RiemannRochTop_upper_diamond_tail_path A R L hRL hbound
    e he (q (Fin.last n)) y hqg hyg (Or.inr ⟨by rw [hq]; linarith, hy⟩)
  exact (RiemannRochTop_upper_diamond_terminal_stem_class A hA R L hRL hbound
    a₀ γ δ t b₀ (β (Fin.last n)) hγ hδ htg ht hb₀ (hβ (Fin.last n))).trans
    (RiemannRochTop_upper_diamond_ordered_product A hA R L hRL hbound e he ε hε hgap
      o x hx hxg p q hp hq d α β a₀ hdg hα hβ ha₀ δ hδ)

/-- RiemannRochTop: a reversed outer circle is represented by an upper boundary path with slit-domain stems. -/
lemma RiemannRochTop_outer_circle_upper_reference (A : Set ℂ) (R L : ℝ)
    (hL : 0 ≤ L) (hRL : 2 * R < L) (hA : ∀ z ∈ A, ‖z‖ ≤ R)
    {o x : {z : ℂ // z ∉ A}} (γ : Path x x)
    (hγ : ∀ t : unitInterval, (γ t : ℂ) =
      Complex.exp (((t : ℝ) * (2 * Real.pi) : ℝ) * Complex.I) * (L : ℂ))
    (k : Path o x)
    (hk : ∀ t b, b ∈ A → (k t : ℂ).re = b.re → (k t : ℂ).im < b.im) :
    ∃ y : {z : ℂ // z ∉ A}, ∃ a : Path o y, ∃ d : Path y x,
      (y : ℂ) = -(L : ℂ) ∧
      (∀ t b, b ∈ A → (a t : ℂ).re = b.re → (a t : ℂ).im < b.im) ∧
      (∀ t, |(d t : ℂ).re| + (d t : ℂ).im = L) ∧
      FundamentalGroup.fromPath ⟦(k.trans γ.symm).trans k.symm⟧ =
        FundamentalGroup.fromPath ⟦a.trans (d.trans k.symm)⟧ := by
  obtain ⟨y, u, l, hy, hu, hl, hhom⟩ :=
    RiemannRochTop_outer_circle_diamond_halves A R L hL hRL hA γ hγ
  refine ⟨y, k.trans l.symm, u.symm, hy, ?_, ?_, ?_⟩
  · intro t b hb he
    have hr : (k.trans l.symm) t ∈ Set.range (k.trans l.symm) := ⟨t, rfl⟩
    rw [Path.trans_range] at hr
    rcases hr with ⟨v, hv⟩ | ⟨v, hv⟩
    · simpa only [hv] using hk v b hb (by simpa only [hv] using he)
    · have hg := hl (unitInterval.symm v)
      have hslit := RiemannRochTop_lower_diamond_slit A R L hRL hA
        (l (unitInterval.symm v) : ℂ) hg b hb
      change (l.symm v : ℂ).re = b.re → (l.symm v : ℂ).im < b.im at hslit
      simpa only [hv] using hslit (by simpa only [hv] using he)
  · exact fun t ↦ hu (unitInterval.symm t)
  · apply congrArg FundamentalGroup.fromPath
    apply Quotient.sound
    have hr := hhom.symm₂.symm
    rw [Path.trans_symm] at hr
    exact (((Path.Homotopic.refl k).hcomp hr).hcomp (Path.Homotopic.refl k.symm)).trans
      (((Path.Homotopic.trans_assoc k l.symm u.symm).symm.hcomp
        (Path.Homotopic.refl k.symm)).trans
        (Path.Homotopic.trans_assoc (k.trans l.symm) u.symm k.symm))

/-- RiemannRochTop: reversed outer circles give the ordered product of clockwise cut excursions. -/
lemma RiemannRochTop_outer_circle_cut_product (A : Set ℂ) (hA : A.Finite)
    (R L : ℝ) (hRL : 2 * R < L) (hbound : ∀ z ∈ A, ‖z‖ ≤ R)
    {n : ℕ} (e : Fin (n + 1) ≃ A) (he : StrictMono (fun k ↦ (e k : ℂ).re))
    (ε : ℝ) (hε : 0 < ε)
    (hgap : ∀ k : Fin n, (e k.castSucc : ℂ).re + ε ≤ (e k.succ : ℂ).re - ε)
    (o x : {z : ℂ // z ∉ A}) (γ : Path x x)
    (hγ : ∀ t : unitInterval, (γ t : ℂ) =
      Complex.exp (((t : ℝ) * (2 * Real.pi) : ℝ) * Complex.I) * (L : ℂ))
    (k : Path o x)
    (hk : ∀ t b, b ∈ A → (k t : ℂ).re = b.re → (k t : ℂ).im < b.im)
    (p q : Fin (n + 1) → {z : ℂ // z ∉ A})
    (hp : ∀ i, (p i : ℂ).re = (e i : ℂ).re - ε)
    (hq : ∀ i, (q i : ℂ).re = (e i : ℂ).re + ε)
    (d : (i : Fin (n + 1)) → Path (p i) (q i))
    (α : (i : Fin (n + 1)) → Path o (p i)) (β : (i : Fin (n + 1)) → Path (q i) o)
    (hdg : ∀ i t, |(d i t : ℂ).re| + (d i t : ℂ).im = L)
    (hα : ∀ i t b, b ∈ A → (α i t : ℂ).re = b.re → (α i t : ℂ).im < b.im)
    (hβ : ∀ i t b, b ∈ A → (β i t : ℂ).re = b.re → (β i t : ℂ).im < b.im) :
    FundamentalGroup.fromPath ⟦(k.trans γ.symm).trans k.symm⟧ =
      (List.ofFn (fun i ↦ FundamentalGroup.fromPath
        ⟦((α i).trans (d i)).trans (β i)⟧)).reverse.prod := by
  have hR : 0 ≤ R := (norm_nonneg (e 0 : ℂ)).trans (hbound _ (e 0).property)
  have hL : 0 ≤ L := by linarith
  have hx : (x : ℂ) = (L : ℂ) := by simpa using hγ 0
  obtain ⟨y, a, δ, hy, ha, hδ, hclass⟩ :=
    RiemannRochTop_outer_circle_upper_reference A R L hL hRL hbound γ hγ k hk
  have hleft : (y : ℂ).re < (e 0 : ℂ).re := by
    have hb := (Complex.abs_re_le_norm (e 0 : ℂ)).trans (hbound _ (e 0).property)
    have hn := neg_le_abs (e 0 : ℂ).re
    simp only [hy, Complex.neg_re, Complex.ofReal_re]
    linarith
  have hright : (e (Fin.last n) : ℂ).re < (x : ℂ).re := by
    have hb := (Complex.abs_re_le_norm (e (Fin.last n) : ℂ)).trans
      (hbound _ (e (Fin.last n)).property)
    have hn := le_abs_self (e (Fin.last n) : ℂ).re
    simp only [hx, Complex.ofReal_re]
    linarith
  exact hclass.trans (RiemannRochTop_upper_diamond_full_product A hA R L hRL hbound
    e he ε hε hgap o y x hleft hright (by simp [hy, abs_of_nonneg hL])
    (by simp [hx, abs_of_nonneg hL]) p q hp hq d α β a k.symm hdg hα hβ ha
    (fun t ↦ hk (unitInterval.symm t)) δ hδ)

/-- RiemannRochTop: slit charts, upper strips, and their sides are contractible in the punctured plane. -/
lemma RiemannRochTop_punctured_cut_charts_contractible
    (A : Set ℂ) (hA : A.Finite) (a : ℂ) (ε : ℝ) (hε : 0 < ε)
    (hiso : ∀ b ∈ A, |b.re - a.re| < ε → b = a) :
    ContractibleSpace {z : {z : ℂ // z ∉ A} //
      ∀ b ∈ A, (z : ℂ).re = b.re → (z : ℂ).im < b.im} ∧
    ContractibleSpace {z : {z : ℂ // z ∉ A} //
      |(z : ℂ).re - a.re| < ε ∧ a.im < (z : ℂ).im} ∧
    ContractibleSpace {z : {z : ℂ // z ∉ A} //
      (|(z : ℂ).re - a.re| < ε ∧ a.im < (z : ℂ).im) ∧ (z : ℂ).re < a.re} ∧
    ContractibleSpace {z : {z : ℂ // z ∉ A} //
      (|(z : ℂ).re - a.re| < ε ∧ a.im < (z : ℂ).im) ∧ a.re < (z : ℂ).re} := by
  let S := {z : ℂ | ∀ b ∈ A, z.re = b.re → z.im < b.im}
  let V := {z : ℂ | |z.re - a.re| < ε ∧ a.im < z.im}
  obtain ⟨_, hSA, hS⟩ := RiemannRochTop_finite_slit_domain A hA
  letI : ContractibleSpace S := hS
  have hVA : V ⊆ Aᶜ := by
    intro z hz hza
    exact (ne_of_lt hz.2) (congrArg Complex.im (hiso z hza hz.1)).symm
  have hVnonempty : V.Nonempty := by
    refine ⟨⟨a.re, a.im + 1⟩, ?_, ?_⟩
    · simpa using hε
    · exact lt_add_one _
  letI : ContractibleSpace V :=
    (RiemannRochTop_upper_strip_open_convex a ε).2.contractibleSpace hVnonempty
  obtain ⟨hL, hR, _⟩ := RiemannRochTop_upper_strip_halves a ε hε
  letI : ContractibleSpace ↥(V ∩ {z : ℂ | z.re < a.re}) := hL
  letI : ContractibleSpace ↥(V ∩ {z : ℂ | a.re < z.re}) := hR
  exact ⟨RiemannRochTop_contractible_nested_subset S Aᶜ hSA,
    RiemannRochTop_contractible_nested_subset V Aᶜ hVA,
    RiemannRochTop_contractible_nested_subset (V ∩ {z : ℂ | z.re < a.re}) Aᶜ
      (fun _ hz ↦ hVA hz.1),
    RiemannRochTop_contractible_nested_subset (V ∩ {z : ℂ | a.re < z.re}) Aᶜ
      (fun _ hz ↦ hVA hz.1)⟩

/-- RiemannRochTop: points on the same side of a strip are joined inside its slit overlap. -/
lemma RiemannRochTop_cut_overlap_joined
    (A : Set ℂ) (hA : A.Finite) (a : ℂ) (ha : a ∈ A) (ε : ℝ) (hε : 0 < ε)
    (hiso : ∀ b ∈ A, |b.re - a.re| < ε → b = a)
    (p q : {z : ℂ // z ∉ A})
    (hp : |(p : ℂ).re - a.re| < ε ∧ a.im < (p : ℂ).im)
    (hq : |(q : ℂ).re - a.re| < ε ∧ a.im < (q : ℂ).im)
    (hside : ((p : ℂ).re < a.re ∧ (q : ℂ).re < a.re) ∨
      (a.re < (p : ℂ).re ∧ a.re < (q : ℂ).re)) :
    ∃ L : Path p q, ∀ t,
      (∀ b ∈ A, (L t : ℂ).re = b.re → (L t : ℂ).im < b.im) ∧
      (|(L t : ℂ).re - a.re| < ε ∧ a.im < (L t : ℂ).im) := by
  let B := {z : ℂ // z ∉ A}
  let V := {z : B | |(z : ℂ).re - a.re| < ε ∧ a.im < (z : ℂ).im}
  obtain ⟨_, _, hL, hR⟩ := RiemannRochTop_punctured_cut_charts_contractible A hA a ε hε hiso
  have hover := RiemannRochTop_slit_strip_overlap A a ha ε hiso
  rcases hside with hside | hside
  · let H := V ∩ {z : B | (z : ℂ).re < a.re}
    letI : ContractibleSpace H := hL
    have hconn : IsPathConnected H := isPathConnected_iff_pathConnectedSpace.mpr inferInstance
    obtain ⟨L, hL⟩ := hconn.joinedIn p ⟨hp, hside.1⟩ q ⟨hq, hside.2⟩
    refine ⟨L, fun t ↦ ?_⟩
    exact (Set.ext_iff.mp hover (L t : ℂ)).mpr ⟨(hL t).1, ne_of_lt (hL t).2⟩
  · let H := V ∩ {z : B | a.re < (z : ℂ).re}
    letI : ContractibleSpace H := hR
    have hconn : IsPathConnected H := isPathConnected_iff_pathConnectedSpace.mpr inferInstance
    obtain ⟨L, hL⟩ := hconn.joinedIn p ⟨hp, hside.1⟩ q ⟨hq, hside.2⟩
    refine ⟨L, fun t ↦ ?_⟩
    exact (Set.ext_iff.mp hover (L t : ℂ)).mpr ⟨(hL t).1, (ne_of_lt (hL t).2).symm⟩

/-- RiemannRochTop: splitting a loop preserves its homotopy class and the two parameter ranges. -/
lemma RiemannRochTop_split_loop {X : Type} [TopologicalSpace X] {x : X}
    (p : Path x x) (u : unitInterval) :
    ∃ d : Path x (p u), ∃ e : Path (p u) x,
      (∀ t, ∃ s : unitInterval, s ≤ u ∧ d t = p s) ∧
      (∀ t, ∃ s : unitInterval, u ≤ s ∧ e t = p s) ∧
      (d.trans e).Homotopic p := by
  let d := (p.subpath 0 u).cast p.source.symm rfl
  let e := (p.subpath u 1).cast rfl p.target.symm
  refine ⟨d, e, ?_, ?_, ?_⟩
  · intro t
    have h : d t ∈ Set.range (p.subpath 0 u) := ⟨t, rfl⟩
    rw [Path.range_subpath_of_le _ _ _ (show (0 : unitInterval) ≤ u from u.property.1)] at h
    obtain ⟨s, hs, heq⟩ := h
    exact ⟨s, hs.2, heq.symm⟩
  · intro t
    have h : e t ∈ Set.range (p.subpath u 1) := ⟨t, rfl⟩
    rw [Path.range_subpath_of_le _ _ _ (unitInterval.le_one u)] at h
    obtain ⟨s, hs, heq⟩ := h
    exact ⟨s, hs.1, heq.symm⟩
  · have h := (Path.Homotopic.subpath_trans_subpath p 0 u 1).pathCast
      p.source.symm p.target.symm
    rw [Path.subpath_zero_one] at h
    exact h

/-- RiemannRochTop: cut-loop homotopy classes depend only on their entry and exit sides. -/
lemma RiemannRochTop_cut_loops_homotopic
    (A : Set ℂ) (hA : A.Finite) (a : ℂ) (ha : a ∈ A) (ε : ℝ) (hε : 0 < ε)
    (hiso : ∀ b ∈ A, |b.re - a.re| < ε → b = a)
    {x p q p' q' : {z : ℂ // z ∉ A}}
    (α : Path x p) (δ : Path p q) (β : Path q x)
    (α' : Path x p') (δ' : Path p' q') (β' : Path q' x)
    (hα : ∀ t, ∀ b ∈ A, (α t : ℂ).re = b.re → (α t : ℂ).im < b.im)
    (hδ : ∀ t, |(δ t : ℂ).re - a.re| < ε ∧ a.im < (δ t : ℂ).im)
    (hβ : ∀ t, ∀ b ∈ A, (β t : ℂ).re = b.re → (β t : ℂ).im < b.im)
    (hα' : ∀ t, ∀ b ∈ A, (α' t : ℂ).re = b.re → (α' t : ℂ).im < b.im)
    (hδ' : ∀ t, |(δ' t : ℂ).re - a.re| < ε ∧ a.im < (δ' t : ℂ).im)
    (hβ' : ∀ t, ∀ b ∈ A, (β' t : ℂ).re = b.re → (β' t : ℂ).im < b.im)
    (hp : ((p : ℂ).re < a.re ∧ (p' : ℂ).re < a.re) ∨
      (a.re < (p : ℂ).re ∧ a.re < (p' : ℂ).re))
    (hq : ((q : ℂ).re < a.re ∧ (q' : ℂ).re < a.re) ∨
      (a.re < (q : ℂ).re ∧ a.re < (q' : ℂ).re)) :
    ((α.trans δ).trans β).Homotopic ((α'.trans δ').trans β') := by
  obtain ⟨L, hL⟩ := RiemannRochTop_cut_overlap_joined A hA a ha ε hε hiso p p'
    (by simpa using hδ 0) (by simpa using hδ' 0) hp
  obtain ⟨R, hR⟩ := RiemannRochTop_cut_overlap_joined A hA a ha ε hε hiso q q'
    (by simpa using hδ 1) (by simpa using hδ' 1) hq
  let S := {z : {z : ℂ // z ∉ A} | ∀ b ∈ A, (z : ℂ).re = b.re → (z : ℂ).im < b.im}
  let V := {z : {z : ℂ // z ∉ A} | |(z : ℂ).re - a.re| < ε ∧ a.im < (z : ℂ).im}
  obtain ⟨hS, hV, _, _⟩ := RiemannRochTop_punctured_cut_charts_contractible A hA a ε hε hiso
  letI : ContractibleSpace S := hS
  letI : ContractibleSpace V := hV
  exact RiemannRochTop_two_chart_loops_homotopic S V α δ β α' δ' β' L R
    hα hδ hβ hα' hδ' hβ' hL hR

/-- RiemannRochTop: left-to-right cut loops represent reversed positive puncture circles. -/
lemma RiemannRochTop_cut_loop_inverse_circle
    (A : Set ℂ) (hA : A.Finite) (a : ℂ) (ha : a ∈ A) (ε : ℝ) (hε : 0 < ε)
    (hiso : ∀ b ∈ A, |b.re - a.re| < ε → b = a)
    {x p q : {z : ℂ // z ∉ A}}
    (α : Path x p) (δ : Path p q) (β : Path q x)
    (hα : ∀ t, ∀ b ∈ A, (α t : ℂ).re = b.re → (α t : ℂ).im < b.im)
    (hδ : ∀ t, |(δ t : ℂ).re - a.re| < ε ∧ a.im < (δ t : ℂ).im)
    (hβ : ∀ t, ∀ b ∈ A, (β t : ℂ).re = b.re → (β t : ℂ).im < b.im)
    (hp : (p : ℂ).re < a.re) (hq : a.re < (q : ℂ).re) :
    ∃ y : {z : ℂ // z ∉ A}, ∃ k : Path x y, ∃ c : Path y y,
      (∀ t, ∀ b ∈ A, (k t : ℂ).re = b.re → (k t : ℂ).im < b.im) ∧
      (∀ t, (c t : ℂ) = a +
        Complex.exp (((Real.pi / 4 + (t : ℝ) * (2 * Real.pi) : ℝ) : ℂ) * Complex.I) *
          (ε / 2 : ℝ)) ∧
      ((α.trans δ).trans β).Homotopic ((k.trans c.symm).trans k.symm) := by
  obtain ⟨y, c, hc, hshort, hlong, hy, hleft⟩ :=
    RiemannRochTop_isolating_positive_circle A a ha ε (ε / 2)
      (by linarith) (by linarith) hiso
  let u : unitInterval := ⟨1 / 4, by norm_num⟩
  obtain ⟨d, e, hd, he, hde⟩ := RiemannRochTop_split_loop c u
  let S := {z : {z : ℂ // z ∉ A} | ∀ b ∈ A, (z : ℂ).re = b.re → (z : ℂ).im < b.im}
  have hxS : x ∈ S := by simpa [S] using hα 0
  have hyS : y ∈ S := by simpa [S] using hlong 1 (by norm_num)
  obtain ⟨hS, _, _, _⟩ :=
    RiemannRochTop_punctured_cut_charts_contractible A hA a ε hε hiso
  letI : ContractibleSpace S := hS
  have hconn : IsPathConnected S := isPathConnected_iff_pathConnectedSpace.mpr inferInstance
  obtain ⟨k, hk⟩ := hconn.joinedIn x hxS y hyS
  have heS : ∀ t, e t ∈ S := by
    intro t
    obtain ⟨s, hs, heq⟩ := he t
    rw [heq]
    exact hlong s hs
  have hdV : ∀ t, |(d t : ℂ).re - a.re| < ε ∧ a.im < (d t : ℂ).im := by
    intro t
    obtain ⟨s, hs, heq⟩ := hd t
    rw [heq]
    exact hshort s hs
  have hke : ∀ t, (k.trans e.symm) t ∈ S := by
    intro t
    have hm := Set.mem_range_self (f := k.trans e.symm) t
    rw [Path.trans_range] at hm
    rcases hm with ⟨s, hs⟩ | ⟨s, hs⟩
    · rw [← hs]; exact hk s
    · rw [← hs]; exact heS (unitInterval.symm s)
  have hcmp := RiemannRochTop_cut_loops_homotopic A hA a ha ε hε hiso
    α δ β (k.trans e.symm) d.symm k.symm hα hδ hβ hke
    (fun t ↦ hdV (unitInterval.symm t)) (fun t ↦ hk (unitInterval.symm t))
    (Or.inl ⟨hp, hleft⟩) (Or.inr ⟨hq, hy⟩)
  have hrev : (e.symm.trans d.symm).Homotopic c.symm := by
    rw [← Path.trans_symm]
    exact hde.symm₂
  refine ⟨y, k, c, hk, hc, hcmp.trans ?_⟩
  exact ((Path.Homotopic.trans_assoc k e.symm d.symm).hcomp
    (Path.Homotopic.refl k.symm)).trans
      (((Path.Homotopic.refl k).hcomp hrev).hcomp (Path.Homotopic.refl k.symm))

/-- RiemannRochTop: upper diamond cut loops represent the same classes as reference cut loops. -/
lemma RiemannRochTop_upper_diamond_cut_class (A : Set ℂ) (hA : A.Finite)
    (R L ε : ℝ) (hRL : 2 * R < L) (hbound : ∀ z ∈ A, ‖z‖ ≤ R) (hε : 0 < ε)
    (hsep : ∀ a b : A, a ≠ b → 4 * ε ≤ |(a : ℂ).re - (b : ℂ).re|)
    (a : A) (w : ℝ) (hw : ε < w) (hR : |(a : ℂ).re| + ε ≤ R)
    (hiso : ∀ b ∈ A, |b.re - (a : ℂ).re| < w → b = a)
    (o : {z : ℂ // z ∉ A})
    (ho : ∀ b ∈ A, (o : ℂ).re = b.re → (o : ℂ).im < b.im)
    {p₀ q₀ : {z : ℂ // z ∉ A}} (α₀ : Path o p₀) (d₀ : Path p₀ q₀) (β₀ : Path q₀ o)
    (hα₀ : ∀ t b, b ∈ A → (α₀ t : ℂ).re = b.re → (α₀ t : ℂ).im < b.im)
    (hd₀ : ∀ t, |(d₀ t : ℂ).re - (a : ℂ).re| < w ∧ (a : ℂ).im < (d₀ t : ℂ).im)
    (hβ₀ : ∀ t b, b ∈ A → (β₀ t : ℂ).re = b.re → (β₀ t : ℂ).im < b.im)
    (hp₀ : (p₀ : ℂ).re < (a : ℂ).re) (hq₀ : (a : ℂ).re < (q₀ : ℂ).re) :
    ∃ p q : {z : ℂ // z ∉ A}, ∃ α : Path o p, ∃ d : Path p q, ∃ β : Path q o,
      (p : ℂ).re = (a : ℂ).re - ε ∧ (q : ℂ).re = (a : ℂ).re + ε ∧
      (∀ t b, b ∈ A → (α t : ℂ).re = b.re → (α t : ℂ).im < b.im) ∧
      (∀ t, |(d t : ℂ).re - (a : ℂ).re| < w ∧ (a : ℂ).im < (d t : ℂ).im) ∧
      (∀ t b, b ∈ A → (β t : ℂ).re = b.re → (β t : ℂ).im < b.im) ∧
      (∀ t, |(d t : ℂ).re| + (d t : ℂ).im = L) ∧
      FundamentalGroup.fromPath ⟦(α.trans d).trans β⟧ =
        FundamentalGroup.fromPath ⟦(α₀.trans d₀).trans β₀⟧ := by
  obtain ⟨p, q, α, d, β, hp, hq, hα, hd, hβ, hg⟩ :=
    RiemannRochTop_upper_diamond_based_cut A hA R L ε hRL hbound hε hsep a w hw hR o ho
  refine ⟨p, q, α, d, β, hp, hq, hα, hd, hβ, hg, ?_⟩
  apply congrArg FundamentalGroup.fromPath
  apply Quotient.sound
  exact RiemannRochTop_cut_loops_homotopic A hA a a.property w (hε.trans hw) hiso
    α d β α₀ d₀ β₀ hα hd hβ hα₀ hd₀ hβ₀
    (Or.inl ⟨by rw [hp]; linarith, hp₀⟩) (Or.inr ⟨by rw [hq]; linarith, hq₀⟩)

/-- RiemannRochTop: a geometric cut-loop family has ordered representatives on a common upper diamond boundary. -/
lemma RiemannRochTop_upper_diamond_cut_family
    (A : Set ℂ) (hA : A.Finite) (hi : Set.InjOn Complex.re A)
    (w : A → ℝ) (hw : ∀ a, 0 < w a)
    (hiso : ∀ (a : A) (b : ℂ), b ∈ A → |b.re - (a : ℂ).re| < w a → b = a)
    (o : {z : ℂ // z ∉ A})
    (ho : ∀ b ∈ A, (o : ℂ).re = b.re → (o : ℂ).im < b.im)
    (γ : A → FundamentalGroup {z : ℂ // z ∉ A} o)
    (hγ : ∀ a : A, ∃ (p q : {z : ℂ // z ∉ A})
      (α : Path o p) (d : Path p q) (β : Path q o),
      (∀ t b, b ∈ A → (α t : ℂ).re = b.re → (α t : ℂ).im < b.im) ∧
      (∀ t, |(d t : ℂ).re - (a : ℂ).re| < w a ∧ (a : ℂ).im < (d t : ℂ).im) ∧
      (∀ t b, b ∈ A → (β t : ℂ).re = b.re → (β t : ℂ).im < b.im) ∧
      (p : ℂ).re < (a : ℂ).re ∧ (a : ℂ).re < (q : ℂ).re ∧
      FundamentalGroup.fromPath ⟦(α.trans d).trans β⟧ = γ a) :
    ∃ n : ℕ, ∃ e : Fin n ≃ A, ∃ ε R L : ℝ,
      0 < ε ∧ 0 < R ∧ 2 * R < L ∧
      (∀ z ∈ A, ‖z‖ ≤ R) ∧ StrictMono (fun k ↦ (e k : ℂ).re) ∧
      (∀ i j, i < j → (e i : ℂ).re + ε < (e j : ℂ).re - ε) ∧
      (∀ a : A, ∃ (p q : {z : ℂ // z ∉ A})
        (α : Path o p) (d : Path p q) (β : Path q o),
        (p : ℂ).re = (a : ℂ).re - ε ∧ (q : ℂ).re = (a : ℂ).re + ε ∧
        (∀ t b, b ∈ A → (α t : ℂ).re = b.re → (α t : ℂ).im < b.im) ∧
        (∀ t, |(d t : ℂ).re - (a : ℂ).re| < w a ∧ (a : ℂ).im < (d t : ℂ).im) ∧
        (∀ t b, b ∈ A → (β t : ℂ).re = b.re → (β t : ℂ).im < b.im) ∧
        (∀ t, |(d t : ℂ).re| + (d t : ℂ).im = L) ∧
        FundamentalGroup.fromPath ⟦(α.trans d).trans β⟧ = γ a) := by
  obtain ⟨n, e, ε, hε, he, hεw, hgap, hsep⟩ :=
    RiemannRochTop_ordered_cut_intervals A hA hi w hw
  obtain ⟨ρ, hρ, hρA⟩ := hA.isBounded.exists_pos_norm_lt
  let R := ρ + ε
  have hR : 0 < R := by dsimp [R]; linarith
  have hbound : ∀ z ∈ A, ‖z‖ ≤ R := by
    intro z hz
    have := hρA z hz
    dsimp [R]
    linarith
  have hmargin : ∀ a : A, |(a : ℂ).re| + ε ≤ R := by
    intro a
    have := (Complex.abs_re_le_norm (a : ℂ)).trans (le_of_lt (hρA a a.property))
    dsimp [R]
    linarith
  refine ⟨n, e, ε, R, 3 * R, hε, hR, by linarith, hbound, he, hgap, ?_⟩
  intro a
  obtain ⟨p₀, q₀, α₀, d₀, β₀, hα₀, hd₀, hβ₀, hp₀, hq₀, heq₀⟩ := hγ a
  obtain ⟨p, q, α, d, β, hp, hq, hα, hd, hβ, hg, heq⟩ :=
    RiemannRochTop_upper_diamond_cut_class A hA R (3 * R) ε (by linarith)
      hbound hε hsep a (w a) (hεw a) (hmargin a) (hiso a) o ho
      α₀ d₀ β₀ hα₀ hd₀ hβ₀ hp₀ hq₀
  exact ⟨p, q, α, d, β, hp, hq, hα, hd, hβ, hg, heq.trans heq₀⟩

/-- RiemannRochTop: geometric cut families have an ordered outer-circle product relation. -/
lemma RiemannRochTop_cut_family_outer_relation
    (A : Set ℂ) (hA : A.Finite) (hne : A.Nonempty) (hi : Set.InjOn Complex.re A)
    (w : A → ℝ) (hw : ∀ a, 0 < w a)
    (hiso : ∀ (a : A) (b : ℂ), b ∈ A → |b.re - (a : ℂ).re| < w a → b = a)
    (o : {z : ℂ // z ∉ A})
    (ho : ∀ b ∈ A, (o : ℂ).re = b.re → (o : ℂ).im < b.im)
    (γ : A → FundamentalGroup {z : ℂ // z ∉ A} o)
    (hγ : ∀ a : A, ∃ (p q : {z : ℂ // z ∉ A})
      (α : Path o p) (d : Path p q) (β : Path q o),
      (∀ t b, b ∈ A → (α t : ℂ).re = b.re → (α t : ℂ).im < b.im) ∧
      (∀ t, |(d t : ℂ).re - (a : ℂ).re| < w a ∧ (a : ℂ).im < (d t : ℂ).im) ∧
      (∀ t b, b ∈ A → (β t : ℂ).re = b.re → (β t : ℂ).im < b.im) ∧
      (p : ℂ).re < (a : ℂ).re ∧ (a : ℂ).re < (q : ℂ).re ∧
      FundamentalGroup.fromPath ⟦(α.trans d).trans β⟧ = γ a) :
    ∃ n : ℕ, ∃ e : Fin (n + 1) ≃ A, ∃ R L : ℝ,
      0 < R ∧ 2 * R < L ∧ (∀ z ∈ A, ‖z‖ ≤ R) ∧
      StrictMono (fun i ↦ (e i : ℂ).re) ∧
      ∃ x : {z : ℂ // z ∉ A}, ∃ k : Path o x, ∃ c : Path x x,
        (∀ t b, b ∈ A → (k t : ℂ).re = b.re → (k t : ℂ).im < b.im) ∧
        (∀ t, (c t : ℂ) =
          Complex.exp ((((t : ℝ) * (2 * Real.pi) : ℝ) : ℂ) * Complex.I) * (L : ℂ)) ∧
        FundamentalGroup.fromPath ⟦(k.trans c.symm).trans k.symm⟧ =
          (List.ofFn (fun i ↦ γ (e i))).reverse.prod := by
  obtain ⟨n, e, ε, R, L, hε, hR, hRL, hbound, he, hgap, hfam⟩ :=
    RiemannRochTop_upper_diamond_cut_family A hA hi w hw hiso o ho γ hγ
  cases n with
  | zero =>
    obtain ⟨a, ha⟩ := hne
    exact Fin.elim0 (e.symm ⟨a, ha⟩)
  | succ n =>
    choose p q α d β hp hq hα hd hβ hdg hclass using hfam
    obtain ⟨x, k, c, _, hk, hc⟩ := RiemannRochTop_plane_outer_circle_stem A hA R L
      (by linarith) (by linarith) hbound o ho
    refine ⟨n, e, R, L, hR, hRL, hbound, he, x, k, c, hk, hc, ?_⟩
    have h := RiemannRochTop_outer_circle_cut_product A hA R L hRL hbound e he ε hε
      (fun i ↦ (hgap i.castSucc i.succ Fin.castSucc_lt_succ).le) o x c hc k hk
      (fun i ↦ p (e i)) (fun i ↦ q (e i)) (fun i ↦ hp (e i)) (fun i ↦ hq (e i))
      (fun i ↦ d (e i)) (fun i ↦ α (e i)) (fun i ↦ β (e i))
      (fun i ↦ hdg (e i)) (fun i ↦ hα (e i)) (fun i ↦ hβ (e i))
    simpa only [hclass] using h

/-- RiemannRochTop: a cut loop entering and leaving on the same side is null-homotopic. -/
lemma RiemannRochTop_cut_loop_same_side
    (A : Set ℂ) (hA : A.Finite) (a : ℂ) (ha : a ∈ A) (ε : ℝ) (hε : 0 < ε)
    (hiso : ∀ b ∈ A, |b.re - a.re| < ε → b = a)
    {x p q : {z : ℂ // z ∉ A}} (α : Path x p) (δ : Path p q) (β : Path q x)
    (hα : ∀ t, ∀ b ∈ A, (α t : ℂ).re = b.re → (α t : ℂ).im < b.im)
    (hδ : ∀ t, |(δ t : ℂ).re - a.re| < ε ∧ a.im < (δ t : ℂ).im)
    (hβ : ∀ t, ∀ b ∈ A, (β t : ℂ).re = b.re → (β t : ℂ).im < b.im)
    (hside : ((p : ℂ).re < a.re ∧ (q : ℂ).re < a.re) ∨
      (a.re < (p : ℂ).re ∧ a.re < (q : ℂ).re)) :
    ((α.trans δ).trans β).Homotopic (Path.refl x) := by
  obtain ⟨D, hD⟩ := RiemannRochTop_cut_overlap_joined A hA a ha ε hε hiso p q
    (by simpa using hδ 0) (by simpa using hδ 1) hside
  let S := {z : {z : ℂ // z ∉ A} | ∀ b ∈ A, (z : ℂ).re = b.re → (z : ℂ).im < b.im}
  let V := {z : {z : ℂ // z ∉ A} | |(z : ℂ).re - a.re| < ε ∧ a.im < (z : ℂ).im}
  obtain ⟨hS, hV, _, _⟩ := RiemannRochTop_punctured_cut_charts_contractible A hA a ε hε hiso
  letI : ContractibleSpace S := hS
  letI : ContractibleSpace V := hV
  have hmid := RiemannRochTop_paths_homotopic_in_subset V δ D hδ (fun t ↦ (hD t).2)
  apply (((Path.Homotopic.refl α).hcomp hmid).hcomp (Path.Homotopic.refl β)).trans
  have hloop : Set.range ((α.trans D).trans β) ⊆ S := by
    rw [Path.trans_range, Path.trans_range]
    exact Set.union_subset
      (Set.union_subset (Set.range_subset_iff.mpr hα)
        (Set.range_subset_iff.mpr (fun t ↦ (hD t).1))) (Set.range_subset_iff.mpr hβ)
  apply RiemannRochTop_paths_homotopic_in_subset S _ _ (Set.range_subset_iff.mp hloop)
  intro t
  simpa [S] using hα 0

/-- RiemannRochTop: a strip excursion is trivial or traverses its reference cut loop in either direction. -/
lemma RiemannRochTop_cut_loop_three_cases
    (A : Set ℂ) (hA : A.Finite) (a : ℂ) (ha : a ∈ A) (ε : ℝ) (hε : 0 < ε)
    (hiso : ∀ b ∈ A, |b.re - a.re| < ε → b = a)
    {x p q p₀ q₀ : {z : ℂ // z ∉ A}}
    (α : Path x p) (δ : Path p q) (β : Path q x)
    (α₀ : Path x p₀) (δ₀ : Path p₀ q₀) (β₀ : Path q₀ x)
    (hα : ∀ t, ∀ b ∈ A, (α t : ℂ).re = b.re → (α t : ℂ).im < b.im)
    (hδ : ∀ t, |(δ t : ℂ).re - a.re| < ε ∧ a.im < (δ t : ℂ).im)
    (hβ : ∀ t, ∀ b ∈ A, (β t : ℂ).re = b.re → (β t : ℂ).im < b.im)
    (hα₀ : ∀ t, ∀ b ∈ A, (α₀ t : ℂ).re = b.re → (α₀ t : ℂ).im < b.im)
    (hδ₀ : ∀ t, |(δ₀ t : ℂ).re - a.re| < ε ∧ a.im < (δ₀ t : ℂ).im)
    (hβ₀ : ∀ t, ∀ b ∈ A, (β₀ t : ℂ).re = b.re → (β₀ t : ℂ).im < b.im)
    (hp₀ : (p₀ : ℂ).re < a.re) (hq₀ : a.re < (q₀ : ℂ).re) :
    ((α.trans δ).trans β).Homotopic (Path.refl x) ∨
      ((α.trans δ).trans β).Homotopic ((α₀.trans δ₀).trans β₀) ∨
      ((α.trans δ).trans β).Homotopic (((α₀.trans δ₀).trans β₀).symm) := by
  have hpne : (p : ℂ).re ≠ a.re := by
    intro he
    have hlo : (p : ℂ).im < a.im := by simpa using hα 1 a ha (by simpa using he)
    have hhi : a.im < (p : ℂ).im := by simpa using (hδ 0).2
    exact (not_lt_of_gt hhi) hlo
  have hqne : (q : ℂ).re ≠ a.re := by
    intro he
    have hlo : (q : ℂ).im < a.im := by simpa using hβ 0 a ha (by simpa using he)
    have hhi : a.im < (q : ℂ).im := by simpa using (hδ 1).2
    exact (not_lt_of_gt hhi) hlo
  rcases lt_or_gt_of_ne hpne with hp | hp <;> rcases lt_or_gt_of_ne hqne with hq | hq
  · exact Or.inl (RiemannRochTop_cut_loop_same_side A hA a ha ε hε hiso α δ β
      hα hδ hβ (Or.inl ⟨hp, hq⟩))
  · exact Or.inr (Or.inl (RiemannRochTop_cut_loops_homotopic A hA a ha ε hε hiso
      α δ β α₀ δ₀ β₀ hα hδ hβ hα₀ hδ₀ hβ₀ (Or.inl ⟨hp, hp₀⟩) (Or.inr ⟨hq, hq₀⟩)))
  · right; right
    have h := RiemannRochTop_cut_loops_homotopic A hA a ha ε hε hiso
      α δ β β₀.symm δ₀.symm α₀.symm hα hδ hβ
      (fun t ↦ hβ₀ (unitInterval.symm t)) (fun t ↦ hδ₀ (unitInterval.symm t))
      (fun t ↦ hα₀ (unitInterval.symm t)) (Or.inr ⟨hp, hq₀⟩) (Or.inl ⟨hq, hp₀⟩)
    apply h.trans
    rw [Path.trans_symm, Path.trans_symm]
    exact Path.Homotopic.trans_assoc _ _ _
  · exact Or.inl (RiemannRochTop_cut_loop_same_side A hA a ha ε hε hiso α δ β
      hα hδ hβ (Or.inr ⟨hp, hq⟩))

/-- RiemannRochTop: subgroup membership of based segments propagates to their concatenation. -/
lemma RiemannRochTop_concat_based_loop_mem
    {X : Type} [TopologicalSpace X] (o : X) {n : ℕ}
    (p : Fin (n + 1) → X)
    (d : (k : Fin n) → Path (p k.castSucc) (p k.succ))
    (a : (k : Fin (n + 1)) → Path o (p k)) (H : Subgroup (FundamentalGroup X o))
    (hd : ∀ k, FundamentalGroup.fromPath
      ⟦(a k.castSucc).trans ((d k).trans (a k.succ).symm)⟧ ∈ H) :
    FundamentalGroup.fromPath ⟦(a 0).trans ((Path.concat p d).trans (a (Fin.last n)).symm)⟧ ∈ H := by
  rw [RiemannRochTop_concat_based_loop_class]
  apply H.list_prod_mem
  intro g hg
  simp only [List.mem_reverse, List.mem_ofFn] at hg
  obtain ⟨k, rfl⟩ := hg
  exact hd k

/-- RiemannRochTop: basing the full subpath gives the original loop with its basepoint stem. -/
lemma RiemannRochTop_based_subpath_endpoints
    {X : Type} [TopologicalSpace X] (x : X) (s : (y : X) → Path x y) (c : Path x x) :
    (s (c 0)).trans ((c.subpath 0 1).trans (s (c 1)).symm) =
      (s x).trans (c.trans (s x).symm) := by
  have h0 : (s (c 0) : unitInterval → X) = s x :=
    congrArg (fun y ↦ (s y : unitInterval → X)) c.source
  have h1 : (s (c 1) : unitInterval → X) = s x :=
    congrArg (fun y ↦ (s y : unitInterval → X)) c.target
  ext t
  simp only [Path.trans_apply, Path.symm_apply, Path.subpath_zero_one, Path.cast_coe,
    h0, h1]

/-- RiemannRochTop: based segments in an open cover detect the whole fundamental group. -/
lemma RiemannRochTop_open_cover_subgroup_eq_top
    {ι X : Type} [TopologicalSpace X] (U : ι → Set X) (hU : ∀ i, IsOpen (U i))
    (hcover : ∀ y, ∃ i, y ∈ U i) (x : X) (s : (y : X) → Path x y)
    (hs : (s x).Homotopic (Path.refl x)) (H : Subgroup (FundamentalGroup X x))
    (hlocal : ∀ i {y z : X} (d : Path y z), (∀ t, d t ∈ U i) →
      FundamentalGroup.fromPath ⟦(s y).trans (d.trans (s z).symm)⟧ ∈ H) : H = ⊤ := by
  suffices hall : ∀ c : Path x x, FundamentalGroup.fromPath ⟦c⟧ ∈ H by
    apply top_unique
    intro g _
    obtain ⟨c, hc⟩ := Quotient.exists_rep g.asHom
    have heq : FundamentalGroup.fromPath ⟦c⟧ = g := congrArg FundamentalGroup.fromPath hc
    exact heq ▸ hall c
  intro c
  obtain ⟨N, t, ht0, ht1, hsub⟩ := RiemannRochTop_open_cover_subpaths U hU hcover c
  have hchain := RiemannRochTop_concat_based_loop_mem x (c ∘ t)
    (fun k ↦ c.subpath (t k.castSucc) (t k.succ)) (fun k ↦ s (c (t k))) H
    (fun k ↦ by obtain ⟨i, hi⟩ := hsub k; exact hlocal i _ hi)
  let based (u v : unitInterval) : Path x x :=
    (s (c u)).trans ((c.subpath u v).trans (s (c v)).symm)
  have hhom := (Path.Homotopic.refl (s (c (t 0)))).hcomp
    ((Path.Homotopic.concat_subpath c t).hcomp
      (Path.Homotopic.refl ((s (c (t (Fin.last N)))).symm)))
  have heq := congrArg FundamentalGroup.fromPath (Quotient.sound hhom)
  have hmem : FundamentalGroup.fromPath ⟦based (t 0) (t (Fin.last N))⟧ ∈ H := heq ▸ hchain
  have hend := congrArg (fun d : Path x x ↦ FundamentalGroup.fromPath ⟦d⟧)
    (congrArg₂ based ht0 ht1)
  have hfull : FundamentalGroup.fromPath ⟦based 0 1⟧ ∈ H := hend ▸ hmem
  change FundamentalGroup.fromPath
    ⟦(s (c 0)).trans ((c.subpath 0 1).trans (s (c 1)).symm)⟧ ∈ H at hfull
  rw [RiemannRochTop_based_subpath_endpoints] at hfull
  have hsrev : (s x).symm.Homotopic (Path.refl x) := by simpa using hs.symm₂
  have hfinal := (hs.hcomp ((Path.Homotopic.refl c).hcomp hsrev)).trans
    ((Path.Homotopic.refl_trans (c.trans (Path.refl x))).trans
      (Path.Homotopic.trans_refl c))
  exact (congrArg FundamentalGroup.fromPath (Quotient.sound hfinal)) ▸ hfull

/-- RiemannRochTop: a central path-connected chart supplies compatible stems for a star cover. -/
lemma RiemannRochTop_star_cover_stems
    {ι X : Type} [TopologicalSpace X] (S : Set X) (V : ι → Set X)
    (hS : IsPathConnected S) (hV : ∀ i, IsPathConnected (V i))
    (hcover : ∀ y, y ∈ S ∨ ∃ i, y ∈ V i)
    (huniq : ∀ i j y, y ∈ V i → y ∈ V j → y ∉ S → i = j)
    (hanchor : ∀ i, (S ∩ V i).Nonempty) (x : X) (hx : x ∈ S) :
    ∃ s : (y : X) → Path x y,
      (∀ y, y ∈ S → ∀ t, s y t ∈ S) ∧
      ∀ i y, y ∈ V i → y ∉ S →
        ∃ p, p ∈ S ∧ p ∈ V i ∧ ∃ (α : Path x p) (δ : Path p y),
          (∀ t, α t ∈ S) ∧ (∀ t, δ t ∈ V i) ∧ s y = α.trans δ := by
  have hex (y : X) : ∃ s : Path x y,
      (y ∈ S → ∀ t, s t ∈ S) ∧
      ∀ i, y ∈ V i → y ∉ S →
        ∃ p, p ∈ S ∧ p ∈ V i ∧ ∃ (α : Path x p) (δ : Path p y),
          (∀ t, α t ∈ S) ∧ (∀ t, δ t ∈ V i) ∧ s = α.trans δ := by
    by_cases hy : y ∈ S
    · obtain ⟨s, hs⟩ := hS.joinedIn x hx y hy
      exact ⟨s, fun _ ↦ hs, fun _ _ hn ↦ (hn hy).elim⟩
    · obtain ⟨i, hi⟩ := (hcover y).resolve_left hy
      obtain ⟨p, hpS, hpV⟩ := hanchor i
      obtain ⟨α, hα⟩ := hS.joinedIn x hx p hpS
      obtain ⟨δ, hδ⟩ := (hV i).joinedIn p hpV y hi
      refine ⟨α.trans δ, fun hn ↦ (hy hn).elim, ?_⟩
      intro j hj _
      have hij := huniq i j y hi hj hy
      subst j
      exact ⟨p, hpS, hpV, α, δ, hα, hδ, rfl⟩
  choose s hs hrep using hex
  exact ⟨s, hs, fun i y ↦ hrep y i⟩

/-- RiemannRochTop: internal pieces of stems can be moved into a based loop's middle path. -/
lemma RiemannRochTop_rebase_internal_segments
    {X : Type} [TopologicalSpace X] {x p y z q : X}
    (α : Path x p) (P : Path p y) (d : Path y z) (β : Path x q) (Q : Path q z) :
    ((α.trans P).trans (d.trans (β.trans Q).symm)).Homotopic
      ((α.trans ((P.trans d).trans Q.symm)).trans β.symm) := by
  rw [Path.trans_symm]
  apply (Path.Homotopic.trans_assoc α P (d.trans (Q.symm.trans β.symm))).trans
  apply ((Path.Homotopic.refl α).hcomp
    ((Path.Homotopic.trans_assoc P d (Q.symm.trans β.symm)).symm.trans
      (Path.Homotopic.trans_assoc (P.trans d) Q.symm β.symm).symm)).trans
  exact (Path.Homotopic.trans_assoc α ((P.trans d).trans Q.symm) β.symm).symm

/-- RiemannRochTop: excursions from a simply connected central chart generate a star cover. -/
lemma RiemannRochTop_star_cover_subgroup_eq_top
    {ι X : Type} [TopologicalSpace X] (S : Set X) (V : ι → Set X)
    [SimplyConnectedSpace S] (hSopen : IsOpen S) (hVopen : ∀ i, IsOpen (V i))
    (hVconn : ∀ i, IsPathConnected (V i))
    (hcover : ∀ y, y ∈ S ∨ ∃ i, y ∈ V i)
    (huniq : ∀ i j y, y ∈ V i → y ∈ V j → y ∉ S → i = j)
    (hanchor : ∀ i, (S ∩ V i).Nonempty) (x : X) (hx : x ∈ S)
    (H : Subgroup (FundamentalGroup X x))
    (hexc : ∀ i {p q : X} (α : Path x p) (δ : Path p q) (β : Path q x),
      (∀ t, α t ∈ S) → (∀ t, δ t ∈ V i) → (∀ t, β t ∈ S) →
      FundamentalGroup.fromPath ⟦(α.trans δ).trans β⟧ ∈ H) : H = ⊤ := by
  have hSconn : IsPathConnected S := isPathConnected_iff_pathConnectedSpace.mpr inferInstance
  obtain ⟨s, hs, hrep⟩ := RiemannRochTop_star_cover_stems S V hSconn hVconn
    hcover huniq hanchor x hx
  have rep (i : ι) (y : X) (hy : y ∈ V i) :
      ∃ p, p ∈ S ∧ p ∈ V i ∧ ∃ (α : Path x p) (P : Path p y),
        (∀ t, α t ∈ S) ∧ (∀ t, P t ∈ V i) ∧ (s y).Homotopic (α.trans P) := by
    by_cases hyS : y ∈ S
    · exact ⟨y, hyS, hy, s y, Path.refl y, hs y hyS, fun _ ↦ hy,
        (Path.Homotopic.trans_refl (s y)).symm⟩
    · obtain ⟨p, hpS, hpV, α, P, hα, hP, he⟩ := hrep i y hy hyS
      exact ⟨p, hpS, hpV, α, P, hα, hP, by rw [he]⟩
  let U : Option ι → Set X := fun i ↦ i.elim S V
  have hU : ∀ i, IsOpen (U i) := by
    intro i
    cases i with
    | none => exact hSopen
    | some i => exact hVopen i
  have hcov : ∀ y, ∃ i, y ∈ U i := by
    intro y
    rcases hcover y with hy | ⟨i, hi⟩
    · exact ⟨none, hy⟩
    · exact ⟨some i, hi⟩
  have hsbase := RiemannRochTop_paths_homotopic_in_subset S (s x) (Path.refl x)
    (hs x hx) (fun _ ↦ hx)
  apply RiemannRochTop_open_cover_subgroup_eq_top U hU hcov x s hsbase H
  intro i y z d hd
  cases i with
  | none =>
    change ∀ t, d t ∈ S at hd
    have hy : y ∈ S := by simpa using hd 0
    have hz : z ∈ S := by simpa using hd 1
    have hm : Set.range ((s y).trans (d.trans (s z).symm)) ⊆ S := by
      rw [Path.trans_range, Path.trans_range, Path.symm_range]
      exact Set.union_subset (Set.range_subset_iff.mpr (hs y hy))
        (Set.union_subset (Set.range_subset_iff.mpr hd) (Set.range_subset_iff.mpr (hs z hz)))
    have hnull := RiemannRochTop_paths_homotopic_in_subset S _ (Path.refl x)
      (Set.range_subset_iff.mp hm) (fun _ ↦ hx)
    have he : FundamentalGroup.fromPath ⟦(s y).trans (d.trans (s z).symm)⟧ = 1 :=
      congrArg FundamentalGroup.fromPath (Quotient.sound hnull)
    exact he.symm ▸ H.one_mem
  | some i =>
    change ∀ t, d t ∈ V i at hd
    obtain ⟨p, _, _, α, P, hα, hP, hsy⟩ := rep i y (by simpa using hd 0)
    obtain ⟨q, _, _, β, Q, hβ, hQ, hsz⟩ := rep i z (by simpa using hd 1)
    have hmove := (hsy.hcomp ((Path.Homotopic.refl d).hcomp hsz.symm₂)).trans
      (RiemannRochTop_rebase_internal_segments α P d β Q)
    have hmiddle : ∀ t, (P.trans d).trans Q.symm t ∈ V i := by
      apply Set.range_subset_iff.mp
      rw [Path.trans_range, Path.trans_range, Path.symm_range]
      exact Set.union_subset
        (Set.union_subset (Set.range_subset_iff.mpr hP) (Set.range_subset_iff.mpr hd))
        (Set.range_subset_iff.mpr hQ)
    have hmem := hexc i α ((P.trans d).trans Q.symm) β.symm hα hmiddle
      (fun t ↦ hβ (unitInterval.symm t))
    exact (congrArg FundamentalGroup.fromPath (Quotient.sound hmove)).symm ▸ hmem

/-- RiemannRochTop: geometric cut loops generate the fundamental group of the punctured plane. -/
lemma RiemannRochTop_cut_loop_family_generates
    (A : Set ℂ) (hA : A.Finite) (ε : A → ℝ) (hε : ∀ a, 0 < ε a)
    (hiso : ∀ (a : A) (b : ℂ), b ∈ A → |b.re - (a : ℂ).re| < ε a → b = a)
    (x : {z : ℂ // z ∉ A})
    (hx : ∀ b ∈ A, (x : ℂ).re = b.re → (x : ℂ).im < b.im)
    (γ : A → FundamentalGroup {z : ℂ // z ∉ A} x)
    (hγ : ∀ a : A, ∃ (p q : {z : ℂ // z ∉ A})
      (α : Path x p) (δ : Path p q) (β : Path q x),
      (∀ t, ∀ b ∈ A, (α t : ℂ).re = b.re → (α t : ℂ).im < b.im) ∧
      (∀ t, |(δ t : ℂ).re - (a : ℂ).re| < ε a ∧ (a : ℂ).im < (δ t : ℂ).im) ∧
      (∀ t, ∀ b ∈ A, (β t : ℂ).re = b.re → (β t : ℂ).im < b.im) ∧
      (p : ℂ).re < (a : ℂ).re ∧ (a : ℂ).re < (q : ℂ).re ∧
      FundamentalGroup.fromPath ⟦(α.trans δ).trans β⟧ = γ a) :
    Subgroup.closure (Set.range γ) = ⊤ := by
  choose p q α δ β hα hδ hβ hp hq heq using hγ
  let B := {z : ℂ // z ∉ A}
  let S₀ := {z : ℂ | ∀ b ∈ A, z.re = b.re → z.im < b.im}
  let S := {z : B | ∀ b ∈ A, (z : ℂ).re = b.re → (z : ℂ).im < b.im}
  let V : A → Set B := fun a ↦
    {z : B | |(z : ℂ).re - (a : ℂ).re| < ε a ∧ (a : ℂ).im < (z : ℂ).im}
  have hSdata := RiemannRochTop_finite_slit_domain A hA
  letI : ContractibleSpace S₀ := hSdata.2.2
  letI : ContractibleSpace S :=
    RiemannRochTop_contractible_nested_subset S₀ Aᶜ hSdata.2.1
  have hSopen : IsOpen S := hSdata.1.preimage continuous_subtype_val
  have hVopen : ∀ a, IsOpen (V a) := fun a ↦
    (RiemannRochTop_upper_strip_open_convex a (ε a)).1.preimage continuous_subtype_val
  have hVconn : ∀ a, IsPathConnected (V a) := by
    intro a
    letI : ContractibleSpace (V a) :=
      (RiemannRochTop_punctured_cut_charts_contractible A hA a (ε a) (hε a) (hiso a)).2.1
    exact isPathConnected_iff_pathConnectedSpace.mpr inferInstance
  have hcover : ∀ y : B, y ∈ S ∨ ∃ a, y ∈ V a := by
    intro y
    have hy : (y : ℂ) ∈ Aᶜ := y.property
    rw [RiemannRochTop_slit_strip_cover_of_widths A ε hε hiso] at hy
    rcases hy with hy | hy
    · exact Or.inl hy
    · obtain ⟨a, ha⟩ := Set.mem_iUnion.mp hy
      exact Or.inr ⟨a, ha⟩
  have huniq : ∀ i j (y : B), y ∈ V i → y ∈ V j → y ∉ S → i = j := by
    intro i j y hi hj hn
    change ¬(∀ b ∈ A, (y : ℂ).re = b.re → (y : ℂ).im < b.im) at hn
    push_neg at hn
    obtain ⟨b, hb, hre, _⟩ := hn
    have hbi := hiso i b hb (by rw [← hre]; exact hi.1)
    have hbj := hiso j b hb (by rw [← hre]; exact hj.1)
    exact Subtype.ext (hbi.symm.trans hbj)
  have hanchor : ∀ a, (S ∩ V a).Nonempty := by
    intro a
    exact ⟨p a, by simpa [S] using hα a 1, by simpa [V] using hδ a 0⟩
  let H := Subgroup.closure (Set.range γ)
  change H = ⊤
  apply RiemannRochTop_star_cover_subgroup_eq_top S V hSopen hVopen hVconn
    hcover huniq hanchor x hx H
  intro a p' q' α' δ' β' hα' hδ' hβ'
  have hgen : γ a ∈ H := Subgroup.subset_closure (Set.mem_range_self a)
  rcases RiemannRochTop_cut_loop_three_cases A hA a a.property (ε a) (hε a) (hiso a)
    α' δ' β' (α a) (δ a) (β a) hα' hδ' hβ' (hα a) (hδ a) (hβ a) (hp a) (hq a)
      with hn | hf | hr
  · have he : FundamentalGroup.fromPath ⟦(α'.trans δ').trans β'⟧ = 1 :=
      congrArg FundamentalGroup.fromPath (Quotient.sound hn)
    exact he.symm ▸ H.one_mem
  · have he := (congrArg FundamentalGroup.fromPath (Quotient.sound hf)).trans (heq a)
    exact he.symm ▸ hgen
  · have href : FundamentalGroup.fromPath ⟦(((α a).trans (δ a)).trans (β a)).symm⟧ =
        (γ a)⁻¹ := by
      change (FundamentalGroup.fromPath ⟦((α a).trans (δ a)).trans (β a)⟧)⁻¹ = (γ a)⁻¹
      exact congrArg (fun g ↦ g⁻¹) (heq a)
    have he := (congrArg FundamentalGroup.fromPath (Quotient.sound hr)).trans href
    exact he.symm ▸ H.inv_mem hgen

/-- RiemannRochTop: geometric cut loops satisfy the free-group universal property. -/
lemma RiemannRochTop_cut_loops_universal_property
    (A : Set ℂ) (hA : A.Finite) (hi : Set.InjOn Complex.re A)
    (x : {z : ℂ // z ∉ A})
    (hx : ∀ b ∈ A, (x : ℂ).re = b.re → (x : ℂ).im < b.im) :
    ∃ ε : A → ℝ, (∀ a, 0 < ε a) ∧
      (∀ (a : A) (b : ℂ), b ∈ A → |b.re - (a : ℂ).re| < ε a → b = a) ∧
      ∃ γ : A → FundamentalGroup {z : ℂ // z ∉ A} x,
        (∀ a : A, ∃ (p q : {z : ℂ // z ∉ A})
          (α : Path x p) (δ : Path p q) (β : Path q x),
          (∀ t, ∀ b ∈ A, (α t : ℂ).re = b.re → (α t : ℂ).im < b.im) ∧
          (∀ t, |(δ t : ℂ).re - (a : ℂ).re| < ε a ∧ (a : ℂ).im < (δ t : ℂ).im) ∧
          (∀ t, ∀ b ∈ A, (β t : ℂ).re = b.re → (β t : ℂ).im < b.im) ∧
          (p : ℂ).re < (a : ℂ).re ∧ (a : ℂ).re < (q : ℂ).re ∧
          FundamentalGroup.fromPath ⟦(α.trans δ).trans β⟧ = γ a) ∧
        Subgroup.closure (Set.range γ) = ⊤ ∧
        ∀ (G : Type) [Group G] (k : A → G),
          ∃! φ : FundamentalGroup {z : ℂ // z ∉ A} x →* G, ∀ a, φ (γ a) = k a := by
  obtain ⟨ε, hε, hiso, γ, hgeom, hex⟩ := RiemannRochTop_cut_loops_prescribed_images A hA hi x hx
  have hgen := RiemannRochTop_cut_loop_family_generates A hA ε hε hiso x hx γ hgeom
  refine ⟨ε, hε, hiso, γ, hgeom, hgen, ?_⟩
  intro G _ k
  obtain ⟨φ, hφ⟩ := hex G k
  refine ⟨φ, hφ, ?_⟩
  intro ψ hψ
  apply MonoidHom.eq_of_eqOn_dense hgen
  rintro _ ⟨a, rfl⟩
  exact (hψ a).trans (hφ a).symm

/-- RiemannRochTop: reversing the middle loop inverts its stem-conjugated class. -/
lemma RiemannRochTop_based_reverse_class {X : Type} [TopologicalSpace X]
    {x y : X} (k : Path x y) (c : Path y y) :
    FundamentalGroup.fromPath ⟦(k.trans c.symm).trans k.symm⟧ =
      (FundamentalGroup.fromPath ⟦(k.trans c).trans k.symm⟧)⁻¹ := by
  change FundamentalGroup.fromPath ⟦(k.trans c.symm).trans k.symm⟧ =
    FundamentalGroup.fromPath ⟦((k.trans c).trans k.symm).symm⟧
  rw [Path.trans_symm, Path.trans_symm, Path.symm_symm]
  exact congrArg FundamentalGroup.fromPath
    (Quotient.sound (Path.Homotopic.trans_assoc k c.symm k.symm))

/-- RiemannRochTop: each inverse cut-loop class has a positive circle representative in an isolated disk. -/
lemma RiemannRochTop_cut_inverse_positive_circle
    (A : Set ℂ) (hA : A.Finite) (a : ℂ) (ha : a ∈ A) (ε : ℝ) (hε : 0 < ε)
    (hiso : ∀ b ∈ A, |b.re - a.re| < ε → b = a)
    {o p q : {z : ℂ // z ∉ A}} (α : Path o p) (δ : Path p q) (β : Path q o)
    (hα : ∀ t b, b ∈ A → (α t : ℂ).re = b.re → (α t : ℂ).im < b.im)
    (hδ : ∀ t, |(δ t : ℂ).re - a.re| < ε ∧ a.im < (δ t : ℂ).im)
    (hβ : ∀ t b, b ∈ A → (β t : ℂ).re = b.re → (β t : ℂ).im < b.im)
    (hp : (p : ℂ).re < a.re) (hq : a.re < (q : ℂ).re) :
    ∃ w : ℂ, w ≠ 0 ∧ ‖w‖ < ε ∧
      (∀ z : ℂ, ‖z‖ < ε → z ≠ 0 → a + z ∉ A) ∧
      ∃ (y : {z : ℂ // z ∉ A}) (k : Path o y) (c : Path y y),
        (∀ t b, b ∈ A → (k t : ℂ).re = b.re → (k t : ℂ).im < b.im) ∧
        (∀ t, (c t : ℂ) = a +
          Complex.exp ((((t : ℝ) * (2 * Real.pi) : ℝ) : ℂ) * Complex.I) * w) ∧
        FundamentalGroup.fromPath ⟦(k.trans c).trans k.symm⟧ =
          (FundamentalGroup.fromPath ⟦(α.trans δ).trans β⟧)⁻¹ := by
  obtain ⟨y, k, c, hk, hc, hloop⟩ :=
    RiemannRochTop_cut_loop_inverse_circle A hA a ha ε hε hiso α δ β hα hδ hβ hp hq
  let w : ℂ := Complex.exp (((Real.pi / 4 : ℝ) : ℂ) * Complex.I) * (ε / 2 : ℝ)
  have hw : w ≠ 0 := mul_ne_zero (Complex.exp_ne_zero _)
    (Complex.ofReal_ne_zero.mpr (ne_of_gt (by linarith)))
  have hnorm : ‖w‖ < ε := by
    simp only [w, norm_mul, Complex.norm_exp_ofReal_mul_I, one_mul, Complex.norm_real,
      Real.norm_eq_abs, abs_of_pos (show 0 < ε / 2 by linarith)]
    linarith
  have hdisk : ∀ z : ℂ, ‖z‖ < ε → z ≠ 0 → a + z ∉ A := by
    intro z hz hz0 hmem
    have heq := hiso (a + z) hmem (by
      simpa only [Complex.add_re, add_sub_cancel_left] using
        (Complex.abs_re_le_norm z).trans_lt hz)
    exact hz0 (add_left_cancel (heq.trans (add_zero a).symm))
  refine ⟨w, hw, hnorm, hdisk, y, k, c, hk, ?_, ?_⟩
  · intro t
    rw [hc t]
    congr 1
    dsimp only [w]
    rw [Complex.ofReal_add, add_mul, Complex.exp_add]
    ring
  · have heq : FundamentalGroup.fromPath ⟦(α.trans δ).trans β⟧ =
        (FundamentalGroup.fromPath ⟦(k.trans c).trans k.symm⟧)⁻¹ :=
      (congrArg FundamentalGroup.fromPath (Quotient.sound hloop)).trans
        (RiemannRochTop_based_reverse_class k c)
    rw [heq, inv_inv]

/-- RiemannRochTop: positive circle free bases retain the inverse-product relation at the outer boundary. -/
lemma RiemannRochTop_positive_basis_outer_relation
    (A : Set ℂ) (hA : A.Finite) (hne : A.Nonempty) (hi : Set.InjOn Complex.re A)
    (o : {z : ℂ // z ∉ A})
    (ho : ∀ b ∈ A, (o : ℂ).re = b.re → (o : ℂ).im < b.im) :
    ∃ γ : A → FundamentalGroup {z : ℂ // z ∉ A} o,
      (∀ a : A, ∃ ρ : ℝ, ∃ w : ℂ, w ≠ 0 ∧ ‖w‖ < ρ ∧
        (∀ z : ℂ, ‖z‖ < ρ → z ≠ 0 → (a : ℂ) + z ∉ A) ∧
        ∃ (y : {z : ℂ // z ∉ A}) (k : Path o y) (c : Path y y),
          (∀ t b, b ∈ A → (k t : ℂ).re = b.re → (k t : ℂ).im < b.im) ∧
          (∀ t, (c t : ℂ) = (a : ℂ) +
            Complex.exp ((((t : ℝ) * (2 * Real.pi) : ℝ) : ℂ) * Complex.I) * w) ∧
          FundamentalGroup.fromPath ⟦(k.trans c).trans k.symm⟧ = γ a) ∧
      (∃ n : ℕ, ∃ e : Fin (n + 1) ≃ A, ∃ R L : ℝ,
        0 < R ∧ 2 * R < L ∧ (∀ z ∈ A, ‖z‖ ≤ R) ∧
        StrictMono (fun i ↦ (e i : ℂ).re) ∧
        ∃ x : {z : ℂ // z ∉ A}, ∃ k : Path o x, ∃ c : Path x x,
          (∀ t b, b ∈ A → (k t : ℂ).re = b.re → (k t : ℂ).im < b.im) ∧
          (∀ t, (c t : ℂ) =
            Complex.exp ((((t : ℝ) * (2 * Real.pi) : ℝ) : ℂ) * Complex.I) * (L : ℂ)) ∧
          FundamentalGroup.fromPath ⟦(k.trans c.symm).trans k.symm⟧ =
            (List.ofFn (fun i ↦ γ (e i))).prod⁻¹) ∧
      ∀ (G : Type) [Group G] (v : A → G),
        ∃! φ : FundamentalGroup {z : ℂ // z ∉ A} o →* G, ∀ a, φ (γ a) = v a := by
  obtain ⟨ε, hε, hiso, γ₀, hgeom, _, hu⟩ :=
    RiemannRochTop_cut_loops_universal_property A hA hi o ho
  let γ := fun a ↦ (γ₀ a)⁻¹
  refine ⟨γ, ?_, ?_, ?_⟩
  · intro a
    obtain ⟨p, q, α, δ, β, hα, hδ, hβ, hp, hq, heq⟩ := hgeom a
    obtain ⟨w, hw, hnorm, hdisk, y, k, c, hk, hc, hclass⟩ :=
      RiemannRochTop_cut_inverse_positive_circle A hA a a.property (ε a) (hε a)
        (hiso a) α δ β hα hδ hβ hp hq
    exact ⟨ε a, w, hw, hnorm, hdisk, y, k, c, hk, hc, hclass.trans (congrArg Inv.inv heq)⟩
  · obtain ⟨n, e, R, L, hR, hRL, hbound, he, x, k, c, hk, hc, hclass⟩ :=
      RiemannRochTop_cut_family_outer_relation A hA hne hi ε hε hiso o ho γ₀ hgeom
    refine ⟨n, e, R, L, hR, hRL, hbound, he, x, k, c, hk, hc, ?_⟩
    rw [List.prod_inv_reverse, List.map_ofFn]
    simpa only [γ, Function.comp_def, inv_inv] using hclass
  · intro G _ v
    obtain ⟨φ, hφ, huniq⟩ := hu G (fun a ↦ (v a)⁻¹)
    refine ⟨φ, ?_, ?_⟩
    · intro a
      simp only [γ, map_inv, hφ, inv_inv]
    · intro ψ hψ
      apply huniq ψ
      intro a
      have h := congrArg Inv.inv (hψ a)
      simpa only [γ, map_inv, inv_inv] using h

/-- RiemannRochTop: positive puncture circles form a free generating family with isolated disk neighborhoods. -/
lemma RiemannRochTop_positive_circles_universal_property
    (A : Set ℂ) (hA : A.Finite) (hi : Set.InjOn Complex.re A)
    (x : {z : ℂ // z ∉ A})
    (hx : ∀ b ∈ A, (x : ℂ).re = b.re → (x : ℂ).im < b.im) :
    ∃ γ : A → FundamentalGroup {z : ℂ // z ∉ A} x,
      (∀ a : A, ∃ R : ℝ, ∃ w : ℂ, w ≠ 0 ∧ ‖w‖ < R ∧
        (∀ z : ℂ, ‖z‖ < R → z ≠ 0 → (a : ℂ) + z ∉ A) ∧
        ∃ (y : {z : ℂ // z ∉ A}) (k : Path x y) (c : Path y y),
          (∀ t, ∀ b ∈ A, (k t : ℂ).re = b.re → (k t : ℂ).im < b.im) ∧
          (∀ t, (c t : ℂ) = (a : ℂ) +
            Complex.exp ((((t : ℝ) * (2 * Real.pi) : ℝ) : ℂ) * Complex.I) * w) ∧
          FundamentalGroup.fromPath ⟦(k.trans c).trans k.symm⟧ = γ a) ∧
      Subgroup.closure (Set.range γ) = ⊤ ∧
      ∀ (G : Type) [Group G] (v : A → G),
        ∃! φ : FundamentalGroup {z : ℂ // z ∉ A} x →* G, ∀ a, φ (γ a) = v a := by
  obtain ⟨ε, hε, hiso, γ₀, hgeom, hgen, hu⟩ :=
    RiemannRochTop_cut_loops_universal_property A hA hi x hx
  let γ := fun a ↦ (γ₀ a)⁻¹
  refine ⟨γ, ?_, ?_, ?_⟩
  · intro a
    obtain ⟨p, q, α, δ, β, hα, hδ, hβ, hp, hq, heq⟩ := hgeom a
    obtain ⟨y, k, c, hk, hc, hloop⟩ :=
      RiemannRochTop_cut_loop_inverse_circle A hA a a.property (ε a) (hε a)
        (hiso a) α δ β hα hδ hβ hp hq
    let w : ℂ := Complex.exp (((Real.pi / 4 : ℝ) : ℂ) * Complex.I) * (ε a / 2 : ℝ)
    have hw : w ≠ 0 := mul_ne_zero (Complex.exp_ne_zero _)
      (Complex.ofReal_ne_zero.mpr (ne_of_gt (by linarith [hε a])))
    have hnorm : ‖w‖ < ε a := by
      simp only [w, norm_mul, Complex.norm_exp_ofReal_mul_I, one_mul, Complex.norm_real,
        Real.norm_eq_abs, abs_of_pos (show 0 < ε a / 2 by linarith [hε a])]
      linarith [hε a]
    have hdisk : ∀ z : ℂ, ‖z‖ < ε a → z ≠ 0 → (a : ℂ) + z ∉ A := by
      intro z hz hz0 hmem
      have heq := hiso a ((a : ℂ) + z) hmem (by
        simpa only [Complex.add_re, add_sub_cancel_left] using
          (Complex.abs_re_le_norm z).trans_lt hz)
      exact hz0 (add_left_cancel (heq.trans (add_zero (a : ℂ)).symm))
    refine ⟨ε a, w, hw, hnorm, hdisk, y, k, c, hk, ?_, ?_⟩
    · intro t
      rw [hc t]
      congr 1
      dsimp only [w]
      rw [Complex.ofReal_add, add_mul, Complex.exp_add]
      ring
    · have hclass : γ₀ a =
          (FundamentalGroup.fromPath ⟦(k.trans c).trans k.symm⟧)⁻¹ := by
        calc
          γ₀ a = FundamentalGroup.fromPath ⟦(α.trans δ).trans β⟧ := heq.symm
          _ = FundamentalGroup.fromPath ⟦(k.trans c.symm).trans k.symm⟧ :=
            congrArg FundamentalGroup.fromPath (Quotient.sound hloop)
          _ = _ := RiemannRochTop_based_reverse_class k c
      simp only [γ, hclass, inv_inv]
  · apply top_unique
    rw [← hgen]
    apply (Subgroup.closure_le _).2
    rintro _ ⟨a, rfl⟩
    have h : γ a ∈ Subgroup.closure (Set.range γ) :=
      Subgroup.subset_closure (Set.mem_range_self a)
    have hh := (Subgroup.closure (Set.range γ)).inv_mem h
    change (γ₀ a)⁻¹⁻¹ ∈ Subgroup.closure (Set.range γ) at hh
    rw [inv_inv] at hh
    exact hh
  · intro G _ v
    obtain ⟨φ, hφ, huniq⟩ := hu G (fun a ↦ (v a)⁻¹)
    refine ⟨φ, ?_, ?_⟩
    · intro a
      simp only [γ, map_inv, hφ, inv_inv]
    · intro ψ hψ
      apply huniq ψ
      intro a
      have h := congrArg Inv.inv (hψ a)
      simpa only [γ, map_inv, inv_inv] using h

/-- RiemannRochTop: basepoint transport acts on loop classes by adjoining a stem and its reverse. -/
lemma RiemannRochTop_basepoint_equiv_circle {X : Type} [TopologicalSpace X]
    {x y : X} (k : Path x y) (c : Path y y) :
    FundamentalGroup.fundamentalGroupMulEquivOfPath k.symm
      (FundamentalGroup.fromPath ⟦c⟧) =
        FundamentalGroup.fromPath ⟦(k.trans c).trans k.symm⟧ := by
  change FundamentalGroup.fromPath ⟦k.symm.symm.trans (c.trans k.symm)⟧ = _
  rw [Path.symm_symm]
  exact congrArg FundamentalGroup.fromPath
    (Quotient.sound (Path.Homotopic.trans_assoc k c k.symm).symm)

/-- RiemannRochTop: vertically separated punctures have a free fundamental group at slit-domain basepoints. -/
lemma RiemannRochTop_vertical_punctured_plane_free
    (A : Set ℂ) (hA : A.Finite) (hi : Set.InjOn Complex.re A)
    (x : {z : ℂ // z ∉ A})
    (hx : ∀ b ∈ A, (x : ℂ).re = b.re → (x : ℂ).im < b.im) :
    Nonempty (FreeGroup A ≃* FundamentalGroup {z : ℂ // z ∉ A} x) := by
  obtain ⟨_, _, _, γ, _, hgen, hu⟩ := RiemannRochTop_cut_loops_universal_property A hA hi x hx
  obtain ⟨φ, hφ, _⟩ := hu (FreeGroup A) FreeGroup.of
  let ψ := FreeGroup.lift γ
  have hleft : φ.comp ψ = MonoidHom.id _ := by
    apply FreeGroup.ext_hom
    intro a
    simp only [MonoidHom.comp_apply, MonoidHom.id_apply, ψ, FreeGroup.lift_apply_of, hφ]
  have hinj : Function.Injective ψ :=
    Function.LeftInverse.injective (fun g ↦ congrArg (fun f : FreeGroup A →* FreeGroup A ↦ f g) hleft)
  have hsurj : Function.Surjective ψ := FreeGroup.lift_surjective_iff_closure_range_eq_top.mpr hgen
  exact ⟨MulEquiv.ofBijective ψ ⟨hinj, hsurj⟩⟩

/-- RiemannRochTop: removing finitely many plane points preserves path connectedness. -/
lemma RiemannRochTop_finite_punctured_plane_pathConnected
    (A : Set ℂ) (hA : A.Finite) : PathConnectedSpace {z : ℂ // z ∉ A} := by
  have hopen : IsOpen Aᶜ := hA.isClosed.isOpen_compl
  have hconn : IsPreconnected Aᶜ := by
    simpa only [Set.sdiff_eq, Set.univ_inter] using
      b4cov_isPreconnected_diff_finite isOpen_univ isPreconnected_univ hA
        (fun z _ ↦ b4cov_goodPoint (E := ℂ) (by simp) z)
  obtain ⟨z, hz⟩ := hA.exists_notMem
  letI : ConnectedSpace {z : ℂ // z ∉ A} :=
    isConnected_iff_connectedSpace.mp ⟨⟨z, hz⟩, hconn⟩
  letI : LocallyPathConnectedSpace {z : ℂ // z ∉ A} := hopen.locallyPathConnectedSpace
  exact pathConnectedSpace_iff_connectedSpace.mpr inferInstance

/-- RiemannRochTop: the vertical puncture free-group description holds at every basepoint. -/
lemma RiemannRochTop_vertical_punctured_plane_free_at
    (A : Set ℂ) (hA : A.Finite) (hi : Set.InjOn Complex.re A)
    (x : {z : ℂ // z ∉ A}) :
    Nonempty (FreeGroup A ≃* FundamentalGroup {z : ℂ // z ∉ A} x) := by
  obtain ⟨_, hSA, hS⟩ := RiemannRochTop_finite_slit_domain A hA
  let S := {z : ℂ | ∀ b ∈ A, z.re = b.re → z.im < b.im}
  letI : ContractibleSpace S := hS
  let z : S := Classical.choice inferInstance
  let y : {z : ℂ // z ∉ A} := ⟨z.val, hSA z.property⟩
  obtain ⟨e⟩ := RiemannRochTop_vertical_punctured_plane_free A hA hi y z.property
  letI := RiemannRochTop_finite_punctured_plane_pathConnected A hA
  exact ⟨e.trans (FundamentalGroup.fundamentalGroupMulEquivOfPath
    (PathConnectedSpace.somePath y x))⟩

/-- RiemannRochTop: every finite punctured plane has the free group on its punctures. -/
lemma RiemannRochTop_finite_punctured_plane_free
    (A : Set ℂ) (hA : A.Finite) (x : {z : ℂ // z ∉ A}) :
    Nonempty (FreeGroup A ≃* FundamentalGroup {z : ℂ // z ∉ A} x) := by
  obtain ⟨_, e, _, hi⟩ := RiemannRochTop_finite_vertical_position A hA
  let eB : {z : ℂ // z ∉ A} ≃ₜ {z : ℂ // z ∉ e '' A} := e.subtype (by
    intro z
    constructor
    · intro hz he
      obtain ⟨w, hw, heq⟩ := he
      exact hz (e.injective heq ▸ hw)
    · intro hz hza
      exact hz ⟨z, hza, rfl⟩)
  obtain ⟨f⟩ := RiemannRochTop_vertical_punctured_plane_free_at (e '' A) (hA.image e) hi (eB x)
  let F := FundamentalGroupoidFunctor.equivOfHomotopyEquiv eB.toHomotopyEquiv
  let g : FundamentalGroup {z : ℂ // z ∉ A} x ≃*
      FundamentalGroup {z : ℂ // z ∉ e '' A} (eB x) :=
    F.fullyFaithfulFunctor.mulEquivEnd (FundamentalGroupoid.mk x)
  exact ⟨(FreeGroup.freeGroupCongr (e.toEquiv.image A)).trans (f.trans g.symm)⟩

/-- RiemannRochTop: positive circle bases for horizontally separated punctures allow any basepoint. -/
lemma RiemannRochTop_positive_circles_free_at
    (A : Set ℂ) (hA : A.Finite) (hi : Set.InjOn Complex.re A)
    (x : {z : ℂ // z ∉ A}) :
    ∃ γ : A → FundamentalGroup {z : ℂ // z ∉ A} x,
      (∀ a : A, ∃ R : ℝ, ∃ w : ℂ, w ≠ 0 ∧ ‖w‖ < R ∧
        (∀ z : ℂ, ‖z‖ < R → z ≠ 0 → (a : ℂ) + z ∉ A) ∧
        ∃ (y : {z : ℂ // z ∉ A}) (k : Path x y) (c : Path y y),
          (∀ t, (c t : ℂ) = (a : ℂ) +
            Complex.exp ((((t : ℝ) * (2 * Real.pi) : ℝ) : ℂ) * Complex.I) * w) ∧
          FundamentalGroup.fromPath ⟦(k.trans c).trans k.symm⟧ = γ a) ∧
      ∀ (G : Type) [Group G] (v : A → G),
        ∃! φ : FundamentalGroup {z : ℂ // z ∉ A} x →* G, ∀ a, φ (γ a) = v a := by
  obtain ⟨_, hSA, hS⟩ := RiemannRochTop_finite_slit_domain A hA
  let S := {z : ℂ | ∀ b ∈ A, z.re = b.re → z.im < b.im}
  letI : ContractibleSpace S := hS
  let z : S := Classical.choice inferInstance
  let o : {z : ℂ // z ∉ A} := ⟨z.val, hSA z.property⟩
  obtain ⟨γ₀, hgeom, _, hu⟩ :=
    RiemannRochTop_positive_circles_universal_property A hA hi o z.property
  letI := RiemannRochTop_finite_punctured_plane_pathConnected A hA
  let l : Path x o := PathConnectedSpace.somePath x o
  let e := FundamentalGroup.fundamentalGroupMulEquivOfPath l.symm
  refine ⟨fun a ↦ e (γ₀ a), ?_, ?_⟩
  · intro a
    obtain ⟨R, w, hw, hR, hdisk, y, k, c, _, hc, hclass⟩ := hgeom a
    refine ⟨R, w, hw, hR, hdisk, y, l.trans k, c, hc, ?_⟩
    apply Eq.trans ?_ (congrArg e hclass)
    apply Eq.trans ?_ (RiemannRochTop_basepoint_equiv_circle l ((k.trans c).trans k.symm)).symm
    apply congrArg FundamentalGroup.fromPath
    apply Quotient.sound
    exact (Path.Homotopic.trans_assoc (l.trans k) c (l.trans k).symm).trans
      (RiemannRochTop_rebase_internal_segments l k c l k)
  · intro G _ v
    obtain ⟨φ, hφ, huniq⟩ := hu G v
    refine ⟨φ.comp e.symm.toMonoidHom, ?_, ?_⟩
    · intro a
      simpa using hφ a
    · intro ψ hψ
      have heq : ψ.comp e.toMonoidHom = φ := huniq _ hψ
      ext g
      have h := congrArg (fun f ↦ f (e.symm g)) heq
      simpa using h

/-- RiemannRochTop: adjoining a basepoint stem transports every represented local circle class. -/
lemma RiemannRochTop_rebase_circle_class {X : Type} [TopologicalSpace X]
    {x o y : X} (l : Path x o) (k : Path o y) (c : Path y y) :
    FundamentalGroup.fromPath ⟦((l.trans k).trans c).trans (l.trans k).symm⟧ =
      FundamentalGroup.fundamentalGroupMulEquivOfPath l.symm
        (FundamentalGroup.fromPath ⟦(k.trans c).trans k.symm⟧) := by
  apply Eq.trans ?_ (RiemannRochTop_basepoint_equiv_circle l ((k.trans c).trans k.symm)).symm
  apply congrArg FundamentalGroup.fromPath
  apply Quotient.sound
  exact (Path.Homotopic.trans_assoc (l.trans k) c (l.trans k).symm).trans
    (RiemannRochTop_rebase_internal_segments l k c l k)

/-- RiemannRochTop: positive bases and their outer relation persist at arbitrary basepoints. -/
lemma RiemannRochTop_positive_basis_outer_at
    (A : Set ℂ) (hA : A.Finite) (hne : A.Nonempty) (hi : Set.InjOn Complex.re A)
    (x : {z : ℂ // z ∉ A}) :
    ∃ γ : A → FundamentalGroup {z : ℂ // z ∉ A} x,
      (∀ a : A, ∃ ρ : ℝ, ∃ w : ℂ, w ≠ 0 ∧ ‖w‖ < ρ ∧
        (∀ z : ℂ, ‖z‖ < ρ → z ≠ 0 → (a : ℂ) + z ∉ A) ∧
        ∃ (y : {z : ℂ // z ∉ A}) (k : Path x y) (c : Path y y),
          (∀ t, (c t : ℂ) = (a : ℂ) +
            Complex.exp ((((t : ℝ) * (2 * Real.pi) : ℝ) : ℂ) * Complex.I) * w) ∧
          FundamentalGroup.fromPath ⟦(k.trans c).trans k.symm⟧ = γ a) ∧
      (∃ n : ℕ, ∃ e : Fin (n + 1) ≃ A, ∃ R L : ℝ,
        0 < R ∧ 2 * R < L ∧ (∀ z ∈ A, ‖z‖ ≤ R) ∧
        StrictMono (fun i ↦ (e i : ℂ).re) ∧
        ∃ y : {z : ℂ // z ∉ A}, ∃ k : Path x y, ∃ c : Path y y,
          (∀ t, (c t : ℂ) =
            Complex.exp ((((t : ℝ) * (2 * Real.pi) : ℝ) : ℂ) * Complex.I) * (L : ℂ)) ∧
          FundamentalGroup.fromPath ⟦(k.trans c.symm).trans k.symm⟧ =
            (List.ofFn (fun i ↦ γ (e i))).prod⁻¹) ∧
      ∀ (G : Type) [Group G] (v : A → G),
        ∃! φ : FundamentalGroup {z : ℂ // z ∉ A} x →* G, ∀ a, φ (γ a) = v a := by
  obtain ⟨_, hSA, hS⟩ := RiemannRochTop_finite_slit_domain A hA
  let S := {z : ℂ | ∀ b ∈ A, z.re = b.re → z.im < b.im}
  letI : ContractibleSpace S := hS
  let z : S := Classical.choice inferInstance
  let o : {z : ℂ // z ∉ A} := ⟨z.val, hSA z.property⟩
  obtain ⟨γ₀, hgeom, hout, hu⟩ :=
    RiemannRochTop_positive_basis_outer_relation A hA hne hi o z.property
  letI := RiemannRochTop_finite_punctured_plane_pathConnected A hA
  let l : Path x o := PathConnectedSpace.somePath x o
  let E := FundamentalGroup.fundamentalGroupMulEquivOfPath l.symm
  refine ⟨fun a ↦ E (γ₀ a), ?_, ?_, ?_⟩
  · intro a
    obtain ⟨ρ, w, hw, hρ, hdisk, y, k, c, _, hc, hclass⟩ := hgeom a
    exact ⟨ρ, w, hw, hρ, hdisk, y, l.trans k, c, hc,
      (RiemannRochTop_rebase_circle_class l k c).trans (congrArg E hclass)⟩
  · obtain ⟨n, e, R, L, hR, hRL, hbound, he, y, k, c, _, hc, hclass⟩ := hout
    refine ⟨n, e, R, L, hR, hRL, hbound, he, y, l.trans k, c, hc, ?_⟩
    have h := (RiemannRochTop_rebase_circle_class l k c.symm).trans (congrArg E hclass)
    simpa only [map_inv, map_list_prod, List.map_ofFn, Function.comp_def] using h
  · intro G _ v
    obtain ⟨φ, hφ, huniq⟩ := hu G v
    refine ⟨φ.comp E.symm.toMonoidHom, ?_, ?_⟩
    · intro a
      simpa using hφ a
    · intro ψ hψ
      have heq : ψ.comp E.toMonoidHom = φ := huniq _ hψ
      ext g
      have h := congrArg (fun f ↦ f (E.symm g)) heq
      simpa using h

/-- RiemannRochTop: the fundamental-group equivalence of a homeomorphism maps loop representatives. -/
lemma RiemannRochTop_homeomorph_pi1_map {X Y : Type} [TopologicalSpace X]
    [TopologicalSpace Y] (h : X ≃ₜ Y) (x : X) :
    ∃ e : FundamentalGroup X x ≃* FundamentalGroup Y (h x),
      ∀ c : Path x x, e (FundamentalGroup.fromPath ⟦c⟧) =
        FundamentalGroup.fromPath ⟦c.map h.continuous⟧ := by
  let F := FundamentalGroupoidFunctor.equivOfHomotopyEquiv h.toHomotopyEquiv
  exact ⟨F.fullyFaithfulFunctor.mulEquivEnd (FundamentalGroupoid.mk x), fun _ ↦ rfl⟩

/-- RiemannRochTop: every finite punctured plane has a free basis of positive isolated puncture circles. -/
lemma RiemannRochTop_finite_positive_circles_free
    (A : Set ℂ) (hA : A.Finite) (x : {z : ℂ // z ∉ A}) :
    ∃ γ : A → FundamentalGroup {z : ℂ // z ∉ A} x,
      (∀ a : A, ∃ R : ℝ, ∃ w : ℂ, w ≠ 0 ∧ ‖w‖ < R ∧
        (∀ z : ℂ, ‖z‖ < R → z ≠ 0 → (a : ℂ) + z ∉ A) ∧
        ∃ (y : {z : ℂ // z ∉ A}) (k : Path x y) (d : Path y y),
          (∀ t, (d t : ℂ) = (a : ℂ) +
            Complex.exp ((((t : ℝ) * (2 * Real.pi) : ℝ) : ℂ) * Complex.I) * w) ∧
          FundamentalGroup.fromPath ⟦(k.trans d).trans k.symm⟧ = γ a) ∧
      ∀ (G : Type) [Group G] (v : A → G),
        ∃! φ : FundamentalGroup {z : ℂ // z ∉ A} x →* G, ∀ a, φ (γ a) = v a := by
  obtain ⟨c, hc, hi⟩ := RiemannRochTop_finite_complex_scaling A hA
  let e := Homeomorph.mulLeft₀ c hc
  let eB : {z : ℂ // z ∉ A} ≃ₜ {z : ℂ // z ∉ e '' A} := e.subtype (by
    intro z
    constructor
    · intro hz he
      obtain ⟨w, hw, heq⟩ := he
      exact hz (e.injective heq ▸ hw)
    · intro hz hza
      exact hz ⟨z, hza, rfl⟩)
  let J : A ≃ (e '' A) := e.toEquiv.image A
  obtain ⟨γ₀, hgeom, hu⟩ :=
    RiemannRochTop_positive_circles_free_at (e '' A) (hA.image e) hi (eB x)
  obtain ⟨g, hg⟩ := RiemannRochTop_homeomorph_pi1_map eB.symm (eB x)
  rw [← eB.symm_apply_apply x]
  refine ⟨fun a ↦ g (γ₀ (J a)), ?_, ?_⟩
  · intro a
    obtain ⟨R, w, hw, hR, hdisk, y, k, d, hd, hclass⟩ := hgeom (J a)
    have hcn : 0 < ‖c‖ := norm_pos_iff.mpr hc
    have hnorm : ‖c⁻¹ * w‖ < R / ‖c‖ := by
      rw [norm_mul, norm_inv, inv_mul_eq_div]
      exact (div_lt_div_iff_of_pos_right hcn).mpr hR
    have hdisk' : ∀ z : ℂ, ‖z‖ < R / ‖c‖ → z ≠ 0 → (a : ℂ) + z ∉ A := by
      intro z hz hz0 hmem
      have hcz : ‖c * z‖ < R := by
        rw [norm_mul, mul_comm]
        exact (lt_div_iff₀ hcn).mp hz
      apply hdisk (c * z) hcz (mul_ne_zero hc hz0)
      refine ⟨(a : ℂ) + z, hmem, ?_⟩
      change c * ((a : ℂ) + z) = c * (a : ℂ) + c * z
      ring
    refine ⟨R / ‖c‖, c⁻¹ * w, mul_ne_zero (inv_ne_zero hc) hw, hnorm, hdisk',
      eB.symm y, k.map eB.symm.continuous, d.map eB.symm.continuous, ?_, ?_⟩
    · intro t
      change c⁻¹ * (d t : ℂ) = _
      rw [hd t]
      change c⁻¹ * (c * (a : ℂ) +
        Complex.exp ((((t : ℝ) * (2 * Real.pi) : ℝ) : ℂ) * Complex.I) * w) = _
      rw [mul_add, inv_mul_cancel_left₀ hc]
      ring
    · have hm := (hg ((k.trans d).trans k.symm)).symm.trans (congrArg g hclass)
      simpa only [Path.map_trans, Path.map_symm] using hm
  · intro G _ v
    obtain ⟨φ, hφ, huniq⟩ := hu G (fun a ↦ v (J.symm a))
    refine ⟨φ.comp g.symm.toMonoidHom, ?_, ?_⟩
    · intro a
      simpa using hφ (J a)
    · intro ψ hψ
      have heq : ψ.comp g.toMonoidHom = φ := by
        apply huniq
        intro a
        simpa using hψ (J.symm a)
      ext z
      have h := congrArg (fun f ↦ f (g.symm z)) heq
      simpa using h

/-- RiemannRochTop: finite punctured planes have positive free bases with an outer inverse-product representative. -/
lemma RiemannRochTop_finite_positive_basis_outer
    (A : Set ℂ) (hA : A.Finite) (hne : A.Nonempty) (x : {z : ℂ // z ∉ A}) :
    ∃ γ : A → FundamentalGroup {z : ℂ // z ∉ A} x,
      (∀ a : A, ∃ ρ : ℝ, ∃ w : ℂ, w ≠ 0 ∧ ‖w‖ < ρ ∧
        (∀ z : ℂ, ‖z‖ < ρ → z ≠ 0 → (a : ℂ) + z ∉ A) ∧
        ∃ (y : {z : ℂ // z ∉ A}) (k : Path x y) (d : Path y y),
          (∀ t, (d t : ℂ) = (a : ℂ) +
            Complex.exp ((((t : ℝ) * (2 * Real.pi) : ℝ) : ℂ) * Complex.I) * w) ∧
          FundamentalGroup.fromPath ⟦(k.trans d).trans k.symm⟧ = γ a) ∧
      (∃ n : ℕ, ∃ j : Fin (n + 1) ≃ A, ∃ R : ℝ, ∃ w : ℂ,
        0 < R ∧ 2 * R < ‖w‖ ∧ (∀ z ∈ A, ‖z‖ ≤ R) ∧
        ∃ y : {z : ℂ // z ∉ A}, ∃ k : Path x y, ∃ d : Path y y,
          (∀ t, (d t : ℂ) =
            Complex.exp ((((t : ℝ) * (2 * Real.pi) : ℝ) : ℂ) * Complex.I) * w) ∧
          FundamentalGroup.fromPath ⟦(k.trans d.symm).trans k.symm⟧ =
            (List.ofFn (fun i ↦ γ (j i))).prod⁻¹) ∧
      ∀ (G : Type) [Group G] (v : A → G),
        ∃! φ : FundamentalGroup {z : ℂ // z ∉ A} x →* G, ∀ a, φ (γ a) = v a := by
  obtain ⟨c, hc, hi⟩ := RiemannRochTop_finite_complex_scaling A hA
  let e := Homeomorph.mulLeft₀ c hc
  let eB : {z : ℂ // z ∉ A} ≃ₜ {z : ℂ // z ∉ e '' A} := e.subtype (by
    intro z
    constructor
    · intro hz he
      obtain ⟨w, hw, heq⟩ := he
      exact hz (e.injective heq ▸ hw)
    · intro hz hza
      exact hz ⟨z, hza, rfl⟩)
  let J : A ≃ (e '' A) := e.toEquiv.image A
  obtain ⟨γ₀, hgeom, hout, hu⟩ :=
    RiemannRochTop_positive_basis_outer_at (e '' A) (hA.image e) (hne.image e) hi (eB x)
  obtain ⟨g, hg⟩ := RiemannRochTop_homeomorph_pi1_map eB.symm (eB x)
  have hcn : 0 < ‖c‖ := norm_pos_iff.mpr hc
  rw [← eB.symm_apply_apply x]
  refine ⟨fun a ↦ g (γ₀ (J a)), ?_, ?_, ?_⟩
  · intro a
    obtain ⟨R, w, hw, hR, hdisk, y, k, d, hd, hclass⟩ := hgeom (J a)
    have hnorm : ‖c⁻¹ * w‖ < R / ‖c‖ := by
      rw [norm_mul, norm_inv, inv_mul_eq_div]
      exact (div_lt_div_iff_of_pos_right hcn).mpr hR
    have hdisk' : ∀ z : ℂ, ‖z‖ < R / ‖c‖ → z ≠ 0 → (a : ℂ) + z ∉ A := by
      intro z hz hz0 hmem
      have hcz : ‖c * z‖ < R := by
        rw [norm_mul, mul_comm]
        exact (lt_div_iff₀ hcn).mp hz
      apply hdisk (c * z) hcz (mul_ne_zero hc hz0)
      refine ⟨(a : ℂ) + z, hmem, ?_⟩
      change c * ((a : ℂ) + z) = c * (a : ℂ) + c * z
      ring
    refine ⟨R / ‖c‖, c⁻¹ * w, mul_ne_zero (inv_ne_zero hc) hw, hnorm, hdisk',
      eB.symm y, k.map eB.symm.continuous, d.map eB.symm.continuous, ?_, ?_⟩
    · intro t
      change c⁻¹ * (d t : ℂ) = _
      rw [hd t]
      change c⁻¹ * (c * (a : ℂ) +
        Complex.exp ((((t : ℝ) * (2 * Real.pi) : ℝ) : ℂ) * Complex.I) * w) = _
      rw [mul_add, inv_mul_cancel_left₀ hc]
      ring
    · have hm := (hg ((k.trans d).trans k.symm)).symm.trans (congrArg g hclass)
      simpa only [Path.map_trans, Path.map_symm] using hm
  · obtain ⟨n, j, R, L, hR, hRL, hbound, _, y, k, d, hd, hclass⟩ := hout
    have hL : 0 ≤ L := by linarith
    have hn : ‖c⁻¹ * (L : ℂ)‖ = L / ‖c‖ := by
      rw [norm_mul, norm_inv, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hL,
        inv_mul_eq_div]
    refine ⟨n, j.trans J.symm, R / ‖c‖, c⁻¹ * (L : ℂ), div_pos hR hcn, ?_, ?_,
      eB.symm y, k.map eB.symm.continuous, d.map eB.symm.continuous, ?_, ?_⟩
    · rw [hn, ← mul_div_assoc]
      exact (div_lt_div_iff_of_pos_right hcn).mpr hRL
    · intro z hz
      have hb := hbound (e z) ⟨z, hz, rfl⟩
      change ‖c * z‖ ≤ R at hb
      rw [norm_mul] at hb
      exact (le_div_iff₀ hcn).mpr (by simpa only [mul_comm] using hb)
    · intro t
      change c⁻¹ * (d t : ℂ) = _
      rw [hd t]
      ring
    · have hm := (hg ((k.trans d.symm).trans k.symm)).symm.trans (congrArg g hclass)
      simpa only [Path.map_trans, Path.map_symm, map_inv, map_list_prod, List.map_ofFn,
        Function.comp_def, Equiv.trans_apply, Equiv.apply_symm_apply] using hm
  · intro G _ v
    obtain ⟨φ, hφ, huniq⟩ := hu G (fun a ↦ v (J.symm a))
    refine ⟨φ.comp g.symm.toMonoidHom, ?_, ?_⟩
    · intro a
      simpa using hφ (J a)
    · intro ψ hψ
      have heq : ψ.comp g.toMonoidHom = φ := by
        apply huniq
        intro a
        simpa using hψ (J.symm a)
      ext z
      have h := congrArg (fun f ↦ f (g.symm z)) heq
      simpa using h

/-- RiemannRochTop: affine inclusion identifies complements of sphere sets containing infinity. -/
lemma RiemannRochTop_affine_complement_homeomorph
    (B : Set (OnePoint ℂ)) (hinfty : OnePoint.infty ∈ B) :
    ∃ e : {z : ℂ // (z : OnePoint ℂ) ∉ B} ≃ₜ {y : OnePoint ℂ // y ∉ B},
      ∀ z, (e z : OnePoint ℂ) = (z.val : OnePoint ℂ) := by
  have hsub : Bᶜ ⊆ Set.range ((↑) : ℂ → OnePoint ℂ) := by
    intro y hy
    exact OnePoint.ne_infty_iff_exists.mp (fun h ↦ hy (h.symm ▸ hinfty))
  let e := OnePoint.isOpenEmbedding_coe.isEmbedding.homeomorphOfSubsetRange hsub
  exact ⟨e, fun _ ↦ rfl⟩

/-- RiemannRochTop: finite sphere complements containing an infinity puncture are path connected. -/
lemma RiemannRochTop_affine_sphere_complement_pathConnected
    (B : Set (OnePoint ℂ)) (hB : B.Finite) (hinfty : OnePoint.infty ∈ B) :
    PathConnectedSpace {y : OnePoint ℂ // y ∉ B} := by
  let A := ((↑) : ℂ → OnePoint ℂ) ⁻¹' B
  have hA : A.Finite := hB.preimage OnePoint.coe_injective.injOn
  letI : PathConnectedSpace {z : ℂ // (z : OnePoint ℂ) ∉ B} :=
    RiemannRochTop_finite_punctured_plane_pathConnected A hA
  obtain ⟨e, _⟩ := RiemannRochTop_affine_complement_homeomorph B hinfty
  exact e.pathConnectedSpace

/-- RiemannRochTop: outer circles have stems from every basepoint and isolated inverse-coordinate disks. -/
lemma RiemannRochTop_outer_circle_reference
    (B : Set (OnePoint ℂ)) (hB : B.Finite) (hinfty : OnePoint.infty ∈ B)
    (y₀ : ↥Bᶜ) (a : ℂ) :
    ∃ R : ℝ, 0 < R ∧ ∃ w : ℂ, w ≠ 0 ∧ ‖w⁻¹‖ < R ∧
      (∀ z : ℂ, ‖z‖ < R → z ≠ 0 → ((a + z⁻¹ : ℂ) : OnePoint ℂ) ∉ B) ∧
      ∃ (y : ↥Bᶜ) (k : Path y₀ y) (d : Path y y), ∀ t, (d t : OnePoint ℂ) =
        ((a + Complex.exp ((((t : ℝ) * (2 * Real.pi) : ℝ) : ℂ) * Complex.I) * w : ℂ) : OnePoint ℂ) := by
  obtain ⟨ρ, hρ, hbound⟩ := RiemannRochTop_finite_sphere_affine_bound B hB a
  let w : ℂ := (ρ + 1 : ℝ)
  have hn : ‖w‖ = ρ + 1 := by
    simp only [w, Complex.norm_real, Real.norm_eq_abs, abs_of_pos (show 0 < ρ + 1 by linarith)]
  have hw0 : w ≠ 0 := norm_pos_iff.mp (by rw [hn]; linarith)
  have hw : ρ ≤ ‖w‖ := by rw [hn]; linarith
  have hwinv : ‖w⁻¹‖ < ρ⁻¹ := by
    rw [norm_inv, hn]
    exact inv_strictAnti₀ hρ (by linarith)
  obtain ⟨y, d, hd⟩ := RiemannRochTop_outer_affine_circle B a ρ hbound w hw
  letI : PathConnectedSpace ↥Bᶜ :=
    RiemannRochTop_affine_sphere_complement_pathConnected B hB hinfty
  exact ⟨ρ⁻¹, inv_pos.mpr hρ, w, hw0, hwinv,
    RiemannRochTop_infinity_disk_avoids B a ρ hρ hbound,
    y, PathConnectedSpace.somePath y₀ y, d, hd⟩

/-- RiemannRochTop: affine sphere bases retain an isolated positive infinity representative of their inverse product. -/
