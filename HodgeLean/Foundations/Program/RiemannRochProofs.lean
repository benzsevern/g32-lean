/-- RiemannRochAna: the conjugate differential depends only on the local germ. -/
theorem RiemannRochAna_dbar_congr {u v : C → ℂ} {x : C}
    (h : u =ᶠ[𝓝 x] v) (w : E) :
    b4c_dbar E C u ⟨x, w⟩ = b4c_dbar E C v ⟨x, w⟩ := by
  have hd := h.mfderiv_eq (I := 𝓘(ℝ, E)) (I' := 𝓘(ℝ, ℂ))
  simp only [b4c_dbar, hd]
  rfl

/-- RiemannRochAna: locally constant functions have zero conjugate differential. -/
theorem RiemannRochAna_dbar_const_germ {u : C → ℂ} {x : C} {a : ℂ}
    (h : u =ᶠ[𝓝 x] fun _ ↦ a) (w : E) : b4c_dbar E C u ⟨x, w⟩ = 0 := by
  rw [RiemannRochAna_dbar_congr h w]
  simp only [b4c_dbar, mfderiv_const]
  change ((0 : ℂ) + Complex.I * 0) / 2 = 0
  ring

/-- RiemannRochAna: the conjugate differential vanishes over a neighbourhood on which a function is constant. -/
theorem RiemannRochAna_dbar_eventually_zero {u : C → ℂ} {x : C} {a : ℂ}
    (h : u =ᶠ[𝓝 x] fun _ ↦ a) :
    ∀ᶠ y in 𝓝 x, ∀ w : E, b4c_dbar E C u ⟨y, w⟩ = 0 := by
  filter_upwards [h.eventually_nhds] with y hy
  exact fun w ↦ RiemannRochAna_dbar_const_germ hy w

/-- RiemannRochAna: the tangent bundle projection is real smooth. -/
theorem RiemannRochAna_projection_smooth :
    ContMDiff 𝓘(ℝ, E).tangent 𝓘(ℝ, E) ∞
      (fun p : TangentBundle 𝓘(ℂ, E) C ↦ p.1) := by
  exact (Bundle.contMDiff_proj (TangentSpace 𝓘(ℝ, E))).comp
    RiemannRochAna_realTangent

/-- RiemannRochAna: the smooth obstruction associated with a cutoff principal part. -/
def RiemannRochAna_principalObstruction (hE : Module.finrank ℂ E = 1)
    (x : C) (χ : C → ℝ) : TangentBundle 𝓘(ℂ, E) C → ℂ :=
  fun p ↦ b4c_dbar E C (fun y ↦ (χ y : ℂ)) p /
    RiemannRochAna_coordinate hE x p.1

/-- RiemannRochAna: the principal-part obstruction vanishes over any constant germ of the cutoff. -/
theorem RiemannRochAna_principalObstruction_zero_germ
    (hE : Module.finrank ℂ E = 1) (x y : C) (χ : C → ℝ) {a : ℝ}
    (hχ : χ =ᶠ[𝓝 y] fun _ ↦ a) :
    ∀ᶠ z in 𝓝 y, ∀ v : E, RiemannRochAna_principalObstruction hE x χ ⟨z, v⟩ = 0 := by
  have hh : (fun z ↦ (χ z : ℂ)) =ᶠ[𝓝 y] fun _ ↦ (a : ℂ) :=
    hχ.mono fun z hz ↦ congrArg Complex.ofReal hz
  filter_upwards [RiemannRochAna_dbar_eventually_zero (E := E) hh] with z hz
  intro v
  simp only [RiemannRochAna_principalObstruction, hz, zero_div]

/-- RiemannRochAna: the obstruction of a cutoff simple principal part is a smooth antiholomorphic one-form. -/
theorem RiemannRochAna_principalObstruction_mem [T2Space C]
    (hE : Module.finrank ℂ E = 1) (x : C) (χ : C → ℝ)
    (hχ : ContMDiff 𝓘(ℝ, E) 𝓘(ℝ, ℝ) ∞ χ)
    (hχx : χ =ᶠ[𝓝 x] 1)
    (hs : tsupport χ ⊆ (extChartAt 𝓘(ℂ, E) x).source) :
    RiemannRochAna_principalObstruction hE x χ ∈ b4c_Smooth01 E C := by
  let u : b4c_SmoothFun E C := ⟨fun y ↦ (χ y : ℂ), Complex.ofRealCLM.contMDiff.comp hχ⟩
  have hd := b4c_dbar_mem_aux u
  refine ⟨?_, ?_⟩
  · intro p
    have hzero (a : ℝ) (hc : χ =ᶠ[𝓝 p.1] fun _ ↦ a) :
        ContMDiffAt 𝓘(ℝ, E).tangent 𝓘(ℝ, ℂ) ∞
          (RiemannRochAna_principalObstruction hE x χ) p := by
      apply (contMDiffAt_const (c := (0 : ℂ))).congr_of_eventuallyEq
      have hh := RiemannRochAna_principalObstruction_zero_germ hE x p.1 χ hc
      have hp := (FiberBundle.continuous_proj E (TangentSpace 𝓘(ℂ, E) : C → Type)).continuousAt (x := p)
      filter_upwards [hp.preimage_mem_nhds hh] with q hq
      exact hq q.2
    by_cases hpx : p.1 = x
    · apply hzero 1
      rw [hpx]
      filter_upwards [hχx] with z hz
      exact hz
    by_cases hps : p.1 ∈ tsupport χ
    · have hc := RiemannRochAna_coordinate_analytic hE x p.1 (hs hps)
      have hcr : ContMDiffAt 𝓘(ℝ, E) 𝓘(ℝ, ℂ) ∞
          (RiemannRochAna_coordinate hE x) p.1 :=
        (b3A_contMDiffWithinAt_real hc).of_le (by simp)
      have hi := (contDiffAt_inv (𝕜 := ℝ)
        (RiemannRochAna_coordinate_ne hE x p.1 (hs hps) hpx)).contMDiffAt.comp p.1 hcr
      exact hd.1.contMDiffAt.mul (hi.comp p RiemannRochAna_projection_smooth.contMDiffAt)
    · exact hzero 0 (notMem_tsupport_iff_eventuallyEq.mp hps)
  · intro y a v w
    simp only [RiemannRochAna_principalObstruction]
    have hh := hd.2 y a v w
    change b4c_dbar E C (fun y ↦ (χ y : ℂ)) ⟨y, a • v + w⟩ = _ at hh
    rw [hh]
    ring

/-- RiemannRochAna: the conjugate differential obeys the product rule at differentiable points. -/
theorem RiemannRochAna_dbar_mul_at (u v : C → ℂ) (x : C)
    (hu : MDifferentiableAt 𝓘(ℝ, E) 𝓘(ℝ, ℂ) u x)
    (hv : MDifferentiableAt 𝓘(ℝ, E) 𝓘(ℝ, ℂ) v x) (w : E) :
    b4c_dbar E C (fun y ↦ u y * v y) ⟨x, w⟩ =
      u x * b4c_dbar E C v ⟨x, w⟩ + v x * b4c_dbar E C u ⟨x, w⟩ := by
  let du : E →L[ℝ] ℂ := mfderiv 𝓘(ℝ, E) 𝓘(ℝ, ℂ) u x
  let dv : E →L[ℝ] ℂ := mfderiv 𝓘(ℝ, E) 𝓘(ℝ, ℂ) v x
  have hd : (mfderiv 𝓘(ℝ, E) 𝓘(ℝ, ℂ) (fun y ↦ u y * v y) x : E →L[ℝ] ℂ) =
      u x • dv + v x • du := (hu.hasMFDerivAt.mul hv.hasMFDerivAt).mfderiv
  unfold b4c_dbar
  rw [hd]
  change ((u x • dv + v x • du) w + Complex.I *
    (u x • dv + v x • du) (Complex.I • w)) / 2 =
      u x * ((dv w + Complex.I * dv (Complex.I • w)) / 2) +
      v x * ((du w + Complex.I * du (Complex.I • w)) / 2)
  simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
  ring

/-- RiemannRochAna: complex differentiability at a point annihilates the conjugate differential. -/
theorem RiemannRochAna_dbar_holomorphic_at (u : C → ℂ) (x : C)
    (hu : MDifferentiableAt 𝓘(ℂ, E) 𝓘(ℂ, ℂ) u x) (v : E) :
    b4c_dbar E C u ⟨x, v⟩ = 0 := by
  have hd := (b3A_mdifferentiableAt_real hu).2
  change ((show ℂ from mfderiv 𝓘(ℝ, E) 𝓘(ℝ, ℂ) u x v) + Complex.I *
    (show ℂ from mfderiv 𝓘(ℝ, E) 𝓘(ℝ, ℂ) u x (Complex.I • v))) / 2 = 0
  rw [hd v, hd (Complex.I • v), map_smul]
  change (_ + Complex.I * (Complex.I * _)) / 2 = 0
  simp only [← mul_assoc, Complex.I_mul_I, neg_one_mul, add_neg_cancel, zero_div]

/-- RiemannRochAna: away from the pole the cutoff obstruction is the conjugate differential of the principal part. -/
theorem RiemannRochAna_principalObstruction_eq_dbar [T2Space C]
    (hE : Module.finrank ℂ E = 1) (x : C) (χ : C → ℝ)
    (hχ : ContMDiff 𝓘(ℝ, E) 𝓘(ℝ, ℝ) ∞ χ)
    (hs : tsupport χ ⊆ (extChartAt 𝓘(ℂ, E) x).source)
    (y : C) (hy : y ≠ x) (v : E) :
    b4c_dbar E C (fun z ↦ (χ z : ℂ) / RiemannRochAna_coordinate hE x z) ⟨y, v⟩ =
      RiemannRochAna_principalObstruction hE x χ ⟨y, v⟩ := by
  by_cases hys : y ∈ tsupport χ
  · have hc := RiemannRochAna_coordinate_analytic hE x y (hs hys)
    have hi : ContMDiffAt 𝓘(ℂ, E) 𝓘(ℂ, ℂ) ω
        (fun z ↦ (RiemannRochAna_coordinate hE x z)⁻¹) y :=
      (contDiffAt_inv (𝕜 := ℂ) (RiemannRochAna_coordinate_ne hE x y (hs hys) hy)).contMDiffAt.comp y hc
    have hh := hi.mdifferentiableAt (by simp)
    have hr := (b3A_mdifferentiableAt_real hh).1
    have hχr : MDifferentiableAt 𝓘(ℝ, E) 𝓘(ℝ, ℂ) (fun z ↦ (χ z : ℂ)) y :=
      (Complex.ofRealCLM.contMDiff.comp hχ).mdifferentiable (by simp) y
    simp only [div_eq_mul_inv]
    rw [RiemannRochAna_dbar_mul_at (fun z ↦ (χ z : ℂ)) _ y hχr hr v,
      RiemannRochAna_dbar_holomorphic_at _ y hh v]
    simp only [mul_zero, zero_add, RiemannRochAna_principalObstruction, div_eq_mul_inv]
    exact mul_comm _ _
  · have hz : χ =ᶠ[𝓝 y] 0 := notMem_tsupport_iff_eventuallyEq.mp hys
    have hquot : (fun z ↦ (χ z : ℂ) / RiemannRochAna_coordinate hE x z) =ᶠ[𝓝 y]
        fun _ ↦ (0 : ℂ) := by
      filter_upwards [hz] with z hz
      simp only [show χ z = 0 from hz, Complex.ofReal_zero, zero_div]
    rw [RiemannRochAna_dbar_const_germ hquot v]
    have hc : χ =ᶠ[𝓝 y] fun _ ↦ (0 : ℝ) := hz
    exact ((RiemannRochAna_principalObstruction_zero_germ hE x y χ hc).self_of_nhds v).symm

/-- RiemannRochAna: finitely many marked points have cutoffs excluding the other marked points. -/
theorem RiemannRochAna_separated_cutoffs [T2Space C]
    (hE : Module.finrank ℂ E = 1) {ι : Type} [Finite ι]
    (p : ι → C) (hp : Function.Injective p) :
    ∃ χ : ι → C → ℝ, ∀ i,
      ContMDiff 𝓘(ℝ, E) 𝓘(ℝ, ℝ) ∞ (χ i) ∧ χ i =ᶠ[𝓝 (p i)] 1 ∧
      tsupport (χ i) ⊆ (extChartAt 𝓘(ℂ, E) (p i)).source ∧
      ∀ j, j ≠ i → p j ∉ tsupport (χ i) := by
  classical
  have hi (i : ι) : ∃ χ : C → ℝ,
      ContMDiff 𝓘(ℝ, E) 𝓘(ℝ, ℝ) ∞ χ ∧ χ =ᶠ[𝓝 (p i)] 1 ∧
      tsupport χ ⊆ (extChartAt 𝓘(ℂ, E) (p i)).source ∧
      ∀ j, j ≠ i → p j ∉ tsupport χ := by
    have hc : IsClosed (p '' {j | j ≠ i}) := ((Set.toFinite _).image p).isClosed
    have hn : p i ∈ (p '' {j | j ≠ i})ᶜ := by
      rintro ⟨j, hj, he⟩
      exact hj (hp he)
    have hsrc : (extChartAt 𝓘(ℂ, E) (p i)).source ∈ 𝓝 (p i) := by
      rw [extChartAt_source]
      exact (chartAt E (p i)).open_source.mem_nhds (mem_chart_source E (p i))
    obtain ⟨χ, hχ, hχi, hs⟩ := RiemannRochAna_cutoff hE (p i)
      (inter_mem hsrc (hc.isOpen_compl.mem_nhds hn))
    refine ⟨χ, hχ, hχi, fun z hz ↦ (hs hz).1, ?_⟩
    intro j hj hjχ
    exact (hs hjχ).2 ⟨j, hj, rfl⟩
  choose χ hχ using hi
  exact ⟨χ, hχ⟩

/-- RiemannRochAna: genus-plus-one cutoff principal parts have a nontrivial obstruction relation with a smooth potential. -/
theorem RiemannRochAna_principal_obstruction_relation [T2Space C] [CompactSpace C]
    [ConnectedSpace C] (hE : Module.finrank ℂ E = 1)
    (p : Fin (Module.finrank ℂ (b3_HolForm E C) + 1) → C) (hp : Function.Injective p) :
    ∃ χ : Fin (Module.finrank ℂ (b3_HolForm E C) + 1) → C → ℝ,
      (∀ i, ContMDiff 𝓘(ℝ, E) 𝓘(ℝ, ℝ) ∞ (χ i) ∧ χ i =ᶠ[𝓝 (p i)] 1 ∧
        tsupport (χ i) ⊆ (extChartAt 𝓘(ℂ, E) (p i)).source ∧
        ∀ j, j ≠ i → p j ∉ tsupport (χ i)) ∧
      ∃ c : Fin (Module.finrank ℂ (b3_HolForm E C) + 1) → ℂ,
        (∃ j, c j ≠ 0) ∧ ∃ u : b4c_SmoothFun E C,
          ∀ q : TangentBundle 𝓘(ℂ, E) C, b4c_dbar E C u q =
            ∑ i, c i * RiemannRochAna_principalObstruction hE (p i) (χ i) q := by
  obtain ⟨χ, hχ⟩ := RiemannRochAna_separated_cutoffs hE p hp
  let β : Fin (Module.finrank ℂ (b3_HolForm E C) + 1) → b4c_Smooth01 E C :=
    fun i ↦ ⟨RiemannRochAna_principalObstruction hE (p i) (χ i),
      RiemannRochAna_principalObstruction_mem hE (p i) (χ i)
        (hχ i).1 (hχ i).2.1 (hχ i).2.2.1⟩
  obtain ⟨c, hc, u, hu⟩ := RiemannRochAna_obstruction_dependence hE β
  refine ⟨χ, hχ, c, hc, u, ?_⟩
  intro q
  have hh := congrFun hu q
  simpa only [Submodule.coe_sum, Submodule.coe_smul, Finset.sum_apply,
    Pi.smul_apply, smul_eq_mul, β] using hh


