/-- RiemannRochAna: multiplication by a nonzero scalar preserves local meromorphic orders. -/
theorem RiemannRochAna_meroFun_smul_order
    (hE : Module.finrank ℂ E = 1) (a : ℂ) (ha : a ≠ 0) (F H : b4c_MeroFun E C) (x : C)
    (hH : ∀ᶠ y in 𝓝[≠] x,
      H y = ((a * (F y).elim 0 id : ℂ) : OnePoint ℂ)) :
    meromorphicOrderAt (RiemannRochAna_functionLocal hE H x) 0 =
      meromorphicOrderAt (RiemannRochAna_functionLocal hE F x) 0 := by
  have he := RiemannRochAna_normalization_local_germ hE
    (fun y ↦ a * (F y).elim 0 id) H x hH
  change RiemannRochAna_functionLocal hE H x =ᶠ[𝓝[≠] 0]
    (fun _ : ℂ ↦ a) * RiemannRochAna_functionLocal hE F x at he
  rw [meromorphicOrderAt_congr he]
  have hf : MeromorphicAt (RiemannRochAna_functionLocal hE F x) 0 :=
    RiemannRochAna_sphere_map_meromorphic hE F F.property.1 x
  rw [meromorphicOrderAt_mul (MeromorphicAt.const a 0) hf,
    meromorphicOrderAt_const, if_neg ha, zero_add]

