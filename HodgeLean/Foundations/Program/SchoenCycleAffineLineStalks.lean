import HodgeLean.Foundations.Program.SchoenCycleAffineEvaluationIdeals
import HodgeConjecture.Lemmas.AlgebraicGeometry.ComplexPoint.AffineScheme
import Mathlib.AlgebraicGeometry.Stalk
import Mathlib.RingTheory.Localization.AtPrime.Basic

/-! # The centered coordinate in an actual affine-line stalk -/
noncomputable section
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option maxHeartbeats 400000
set_option synthInstance.maxHeartbeats 400000
open CategoryTheory AlgebraicGeometry MvPolynomial
namespace HodgeLean.Foundations.Program

/-- The actual affine-line stalk at a scalar evaluation has its maximal ideal
generated by the centered polynomial coordinate.
Source: Hartshorne, Algebraic Geometry, II.2; Atiyah–Macdonald,
Introduction to Commutative Algebra, Chapter 3. -/
theorem s2e_affine_line_stalk_parameter
    (φ : MvPolynomial (Fin 1) ℂ →ₐ[ℂ] ℂ) :
    let P := CommRingCat.of (MvPolynomial (Fin 1) ℂ)
    let y : Spec P := PrimeSpectrum.comap φ.toRingHom (IsLocalRing.closedPoint ℂ)
    IsLocalRing.maximalIdeal ((Spec P).presheaf.stalk y) =
      Ideal.span {(StructureSheaf.toStalk P y).hom (X 0 - C (φ (X 0)))} := by
  let P := CommRingCat.of (MvPolynomial (Fin 1) ℂ)
  let y : Spec P := PrimeSpectrum.comap φ.toRingHom (IsLocalRing.closedPoint ℂ)
  let S := (Spec P).presheaf.stalk y
  letI : y.asIdeal.IsPrime := y.isPrime
  letI : Algebra P S := StructureSheaf.stalkAlgebra P y
  letI : IsLocalization.AtPrime S y.asIdeal := StructureSheaf.IsLocalization.to_stalk P y
  have hy : y.asIdeal = RingHom.ker φ.toRingHom := by
    change (IsLocalRing.maximalIdeal ℂ).comap φ.toRingHom = RingHom.ker φ.toRingHom
    rw [IsLocalRing.maximalIdeal_eq_bot (R := ℂ)]
    rfl
  change IsLocalRing.maximalIdeal S = _
  rw [← IsLocalization.AtPrime.map_eq_maximalIdeal y.asIdeal S, hy,
    s2e_one_variable_evaluation_kernel, Ideal.map_span, Set.image_singleton]
  rfl

/-- The centered coordinate generates the actual affine-line maximal ideal
at every actual complex point.
Source: Hartshorne, Algebraic Geometry, II.2; Atiyah–Macdonald,
Introduction to Commutative Algebra, Chapter 3. -/
theorem s2e_affine_line_point_stalk_parameter
    (y : ComplexPoint (Over.mk
      (ComplexPoint.affineSpecStructureMap (MvPolynomial (Fin 1) ℂ)))) :
    IsLocalRing.maximalIdeal ((Spec ↧(MvPolynomial (Fin 1) ℂ)).presheaf.stalk y.underlying) =
      Ideal.span (Set.singleton ((StructureSheaf.toStalk
        (CommRingCat.of (MvPolynomial (Fin 1) ℂ)) y.underlying).hom
          (X 0 - C (ComplexPoint.affineSpecEquiv (MvPolynomial (Fin 1) ℂ) y (X 0))))) := by
  let E := ComplexPoint.affineSpecEquiv (MvPolynomial (Fin 1) ℂ)
  have h := s2e_affine_line_stalk_parameter (E y)
  change IsLocalRing.maximalIdeal
      ((Spec ↧(MvPolynomial (Fin 1) ℂ)).presheaf.stalk (E.symm (E y)).underlying) =
    Ideal.span (Set.singleton ((StructureSheaf.toStalk (CommRingCat.of (MvPolynomial (Fin 1) ℂ))
      (E.symm (E y)).underlying).hom (X 0 - C (E y (X 0))))) at h
  rw [E.symm_apply_apply] at h
  exact h

end HodgeLean.Foundations.Program
