  haveI : Surjective (pullback.snd β.left ℓ.left) :=
    s2e_c1_pullback_surjective_of_slice_points W (B (Fin.last r)) PP β ℓ hpoints
  obtain ⟨U, hU, _, hEt⟩ := s2e_chain_cover_etale_near_slice_aux S Y Z W₀ B₀ hdimY hdimZ a e ha1 hamul hinj p₀ hp₀ hpsurj hporbit C eY hpointAction r σ y rot hrot hy hbranch hexp hpair h hh q₀ hqsurj hqinv hq γ hγsurj hγinv hγ β₀ hβ₀ d₀ hd₀ hgenerator B e₀ b D hD₀ htransform hcartier hblowup η hη₀ hη eW heW hgeneric w hw d hd hdinit hdw horder W eFinal k ℓ havoid
  haveI : Etale (β.left ∣_ U) := hEt
  haveI : Etale (pullback.snd β.left ℓ.left) :=
    s2e_c1_pullback_etale_of_neighbourhood β.left ℓ.left U hU
  obtain ⟨ι, hι, hιβ, htrans, hdis, hex⟩ :=
    s2e_c1_component_orbit_of_slice_fibres k S.m (NeZero.ne S.m) W
      (B (Fin.last r)) β ℓ δ hδ hδorder (by
        intro x
        obtain ⟨z, hz, hi, _, he⟩ := hfibre x
        exact ⟨z, hz, hi, he⟩)
  refine ⟨PP, Iso.refl PP, ι, hι, ?_, htrans, hdis, hex⟩
  simpa only [Iso.refl_hom, Category.id_comp] using hιβ

end HodgeLean.Foundations.Program
