import HodgeLean.Foundations.Program.SchoenCycleElementaryNilpotence
import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.RingTheory.MvPolynomial.Ideal
import Mathlib.RingTheory.Finiteness.Ideal

noncomputable section
set_option maxHeartbeats 400000
set_option synthInstance.maxHeartbeats 400000
open MvPolynomial
namespace HodgeLean.Foundations.Program

/-- Each root-coordinate block-size power belongs to the ideal generated by its elementary coefficients.
Source: Schoen, Compositio Mathematica 65 (1988), Lemma 2.2, printed p. 13. -/
theorem s2e_variable_power_mem_elementary_ideal (n : ℕ) (i : Fin n) :
    (X i : MvPolynomial (Fin n) ℂ) ^ n ∈
      Ideal.span (Set.range (fun j : Fin n => esymm (Fin n) ℂ (j.val + 1))) := by
  classical
  let I : Ideal (MvPolynomial (Fin n) ℂ) :=
    Ideal.span (Set.range (fun j : Fin n => esymm (Fin n) ℂ (j.val + 1)))
  let q := Ideal.Quotient.mkₐ ℂ I
  let t : Fin n → MvPolynomial (Fin n) ℂ ⧸ I := fun j => q (X j)
  have he : aeval t = q := by
    ext j
    simp [t]
  have hh (k : ℕ) (hk : 0 < k) (hkn : k ≤ n) :
      aeval t (esymm (Fin n) ℂ k) = 0 := by
    rw [he]
    change Ideal.Quotient.mk I (esymm (Fin n) ℂ k) = 0
    apply Ideal.Quotient.eq_zero_iff_mem.mpr
    apply Ideal.subset_span
    refine ⟨⟨k - 1, by omega⟩, ?_⟩
    change esymm (Fin n) ℂ (k - 1 + 1) = esymm (Fin n) ℂ k
    rw [Nat.sub_add_cancel hk]
  have hz := s2e_elementary_vanishing_root_nilpotence n t hh i
  apply Ideal.Quotient.eq_zero_iff_mem.mp
  change q ((X i) ^ n) = 0
  simpa only [map_pow] using hz

#print axioms s2e_variable_power_mem_elementary_ideal
end HodgeLean.Foundations.Program
