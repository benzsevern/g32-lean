import HodgeLean.Foundations.Program.SchoenCycleSingletonAdicKernel
import HodgeLean.Foundations.Program.SchoenCycleInsertionStalkKernel
import HodgeLean.Foundations.Program.SchoenCycleInsertionImmersion

/-! # The actual marked insertion kernel in adic stalks -/
noncomputable section
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option maxHeartbeats 400000
set_option synthInstance.maxHeartbeats 400000
open CategoryTheory AlgebraicGeometry
open HodgeLean.Adapters
namespace HodgeLean.Foundations.Program

/-- The actual insertion's adic stalk kernel is generated by the image of
the marked geometric parameter.
Source: Hartshorne, Algebraic Geometry, II.2 and II.8;
Atiyah–Macdonald, Introduction to Commutative Algebra, Chapter 10. -/
theorem s2e_branchInsertion_adic_stalk_kernel
    (Z : Over (Spec ↧ℂ)) [IsIntegral Z.left] [Smooth Z.hom]
    [SmoothOfRelativeDimension 1 Z.hom] [IsProjective Z.hom]
    (n : ℕ) (a : ComplexPoint Z) (y : ComplexPoint (g3_power Z n)) :
    let q := s2c_branchInsertion Z n a
    let R := (g3_power Z (n + 1)).left.presheaf.stalk (q.left y.underlying)
    RingHom.ker (s2e_adic_stalkMap q.left y.underlying) =
      Ideal.span {(AdicCompletion.of (IsLocalRing.maximalIdeal R) R
        (s2e_curvePowerParameter Z (n + 1) (Point.map q y) 0))} := by
  let q := s2c_branchInsertion Z n a
  letI : IsClosedImmersion q.left := s2e_branchInsertion_isClosedImmersion Z n a
  letI : IsLocallyNoetherian (g3_power Z n).left :=
    LocallyOfFiniteType.isLocallyNoetherian (g3_power Z n).hom
  letI : IsLocallyNoetherian (g3_power Z (n + 1)).left :=
    LocallyOfFiniteType.isLocallyNoetherian (g3_power Z (n + 1)).hom
  letI : IsClosedImmersion y.left :=
    isClosedImmersion_of_comp_eq_id (g3_power Z n).hom y.left (Over.w y)
  have hcy : IsClosed ({y.underlying} : Set (g3_power Z n).left) := by
    change IsClosed {y.left (IsLocalRing.closedPoint ℂ)}
    simpa only [Set.image_singleton] using y.left.isClosedMap {IsLocalRing.closedPoint ℂ}
      (IsLocalRing.isClosed_singleton_closedPoint ℂ)
  have hc : IsClosed ({q.left y.underlying} : Set (g3_power Z (n + 1)).left) := by
    simpa only [Set.image_singleton] using q.left.isClosedMap {y.underlying} hcy
  have hf : q.left ⁻¹' {q.left y.underlying} = {y.underlying} := by
    ext z
    exact q.left.isClosedEmbedding.injective.eq_iff
  dsimp only
  rw [s2e_singleton_fiber_adic_kernel_eq_map q.left y.underlying hc hf,
    s2e_branchInsertion_stalk_kernel, Ideal.map_span]
  change Ideal.span ((algebraMap ((g3_power Z (n + 1)).left.presheaf.stalk (q.left y.underlying)) _) ''
    {s2e_curvePowerParameter Z (n + 1) (Point.map q y) 0}) = _
  rw [Set.image_singleton]
  rfl

#print axioms s2e_branchInsertion_adic_stalk_kernel
end HodgeLean.Foundations.Program
