import HodgeLean.Foundations.Program.SchoenCycleAnalyticLinearFactor
import Mathlib.RingTheory.LocalRing.MaximalIdeal.Basic
import Mathlib.RingTheory.Ideal.Operations
import Mathlib.Algebra.MvPolynomial.Eval
import Mathlib.RingTheory.Ideal.Quotient.Defs
import Mathlib.RingTheory.MvPolynomial.Ideal

/-! # Coordinate generators in native analytic local rings -/
noncomputable section
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option maxHeartbeats 400000
set_option synthInstance.maxHeartbeats 400000
open Filter Topology
namespace HodgeLean.Foundations.Program

/-- The coordinate functions define elements of the native analytic germ ring.
Source: Serre, Géométrie algébrique et géométrie analytique, §2, no. 6. -/
def s2e_nativeAnalytic_coordinate (d : ℕ) (i : Fin d) : s2e_nativeAnalyticGermRing d :=
  ⟨Filter.Germ.ofFun (fun z : Fin d → ℂ => z i),
    ⟨_, (ContinuousLinearMap.proj i : (Fin d → ℂ) →L[ℂ] ℂ).analyticAt 0, rfl⟩⟩

#print axioms s2e_nativeAnalytic_coordinate
/-- The native analytic maximal ideal is generated by the coordinate germs.
Source: Serre, Géométrie algébrique et géométrie analytique, §2, no. 6. -/
theorem s2e_nativeAnalytic_maximalIdeal_coordinates (d : ℕ) :
    IsLocalRing.maximalIdeal (s2e_nativeAnalyticGermRing d) =
      Ideal.span (Set.range (s2e_nativeAnalytic_coordinate d)) := by
  apply le_antisymm
  · intro a ha
    obtain ⟨f, hf, he⟩ := a.property
    have hval : s2e_nativeAnalyticGerm_value d a = f 0 := by
      change Filter.Germ.liftOn a.val _ _ = _
      rw [← he]
      rfl
    have h0 : f 0 = 0 := by
      have hn : ¬ IsUnit a := ha
      simpa only [s2e_nativeAnalyticGerm_isUnit_iff_value_ne_zero, hval, not_not] using hn
    obtain ⟨g, hg, hfg⟩ := s2e_analytic_coordinate_factor d f hf
    let c : Fin d → s2e_nativeAnalyticGermRing d := fun i =>
      ⟨Filter.Germ.ofFun (g i), ⟨g i, hg i, rfl⟩⟩
    have heq : a = ∑ i, s2e_nativeAnalytic_coordinate d i * c i := by
      apply Subtype.ext
      change a.val = (s2e_nativeAnalyticGermRing d).subtype
        (∑ i, s2e_nativeAnalytic_coordinate d i * c i)
      rw [← he, map_sum]
      change (Filter.Germ.coeRingHom (nhds (0 : Fin d → ℂ))) f =
        ∑ i, (Filter.Germ.coeRingHom (nhds (0 : Fin d → ℂ))) (fun z => z i * g i z)
      rw [← map_sum]
      apply Filter.Germ.coe_eq.mpr
      filter_upwards [hfg] with z hz
      simpa only [h0, zero_add, Finset.sum_apply] using hz
    rw [heq]
    exact Submodule.sum_mem _ fun i _ =>
      Ideal.mul_mem_right _ _ (Ideal.mem_span_range_self (x := i))
  · apply Ideal.span_le.mpr
    rintro _ ⟨i, rfl⟩
    change ¬ IsUnit (s2e_nativeAnalytic_coordinate d i)
    intro hu
    exact (s2e_nativeAnalyticGerm_isUnit_iff_value_ne_zero d _).mp hu rfl

#print axioms s2e_nativeAnalytic_maximalIdeal_coordinates
/-- Constant functions embed complex scalars in native analytic germs.
Source: Serre, Géométrie algébrique et géométrie analytique, §2, no. 6. -/
def s2e_nativeAnalytic_constant (d : ℕ) : ℂ →+* s2e_nativeAnalyticGermRing d where
  toFun c := ⟨Filter.Germ.ofFun (fun _ => c), ⟨_, analyticAt_const, rfl⟩⟩
  map_one' := rfl
  map_mul' _ _ := rfl
  map_zero' := rfl
  map_add' _ _ := rfl

#print axioms s2e_nativeAnalytic_constant
/-- Polynomial evaluation in the coordinate germs is a ring map into the
native analytic germ ring.
Source: Serre, Géométrie algébrique et géométrie analytique, §2, no. 6. -/
def s2e_nativeAnalytic_polynomial (d : ℕ) :
    MvPolynomial (Fin d) ℂ →+* s2e_nativeAnalyticGermRing d :=
  MvPolynomial.eval₂Hom (s2e_nativeAnalytic_constant d) (s2e_nativeAnalytic_coordinate d)

#print axioms s2e_nativeAnalytic_polynomial
/-- Every native analytic germ has a polynomial representative to any
specified power of the analytic maximal ideal.
Source: Serre, Géométrie algébrique et géométrie analytique, §2, no. 6. -/
theorem s2e_nativeAnalytic_polynomial_approximation (d N : ℕ)
    (a : s2e_nativeAnalyticGermRing d) :
    ∃ p : MvPolynomial (Fin d) ℂ, a - s2e_nativeAnalytic_polynomial d p ∈
      IsLocalRing.maximalIdeal (s2e_nativeAnalyticGermRing d) ^ N := by
  induction N generalizing a with
  | zero => exact ⟨0, by simp⟩
  | succ N ih =>
    let k := s2e_nativeAnalyticGerm_value d a
    have hm : a - s2e_nativeAnalytic_constant d k ∈
        IsLocalRing.maximalIdeal (s2e_nativeAnalyticGermRing d) := by
      change ¬ IsUnit _
      intro h
      apply (s2e_nativeAnalyticGerm_isUnit_iff_value_ne_zero d _).mp h
      rw [map_sub]
      change k - k = 0
      exact sub_self k
    rw [s2e_nativeAnalytic_maximalIdeal_coordinates] at hm
    obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp hm
    choose p hp using fun i => ih (c i)
    refine ⟨MvPolynomial.C k + ∑ i, p i * MvPolynomial.X i, ?_⟩
    have herr : a - s2e_nativeAnalytic_polynomial d
        (MvPolynomial.C k + ∑ i, p i * MvPolynomial.X i) =
        ∑ i, (c i - s2e_nativeAnalytic_polynomial d (p i)) *
          s2e_nativeAnalytic_coordinate d i := by
      simp only [map_add, map_sum, map_mul, s2e_nativeAnalytic_polynomial,
        MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X']
      change a - (s2e_nativeAnalytic_constant d k +
        ∑ i, s2e_nativeAnalytic_polynomial d (p i) * s2e_nativeAnalytic_coordinate d i) = _
      rw [sub_add_eq_sub_sub, ← hc, ← Finset.sum_sub_distrib]
      apply Finset.sum_congr rfl
      intro i _
      exact (sub_mul _ _ _).symm
    rw [herr, pow_succ]
    apply Submodule.sum_mem
    intro i _
    apply Ideal.mul_mem_mul (hp i)
    rw [s2e_nativeAnalytic_maximalIdeal_coordinates]
    exact Ideal.mem_span_range_self

#print axioms s2e_nativeAnalytic_polynomial_approximation
/-- Polynomial evaluation surjects onto each finite order quotient of the
native analytic local ring.
Source: Serre, Géométrie algébrique et géométrie analytique, §2, no. 6. -/
theorem s2e_nativeAnalytic_polynomial_quotient_surjective (d N : ℕ) :
    Function.Surjective ((Ideal.Quotient.mk
      (IsLocalRing.maximalIdeal (s2e_nativeAnalyticGermRing d) ^ N)).comp
        (s2e_nativeAnalytic_polynomial d)) := by
  intro b
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective b
  obtain ⟨p, hp⟩ := s2e_nativeAnalytic_polynomial_approximation d N a
  exact ⟨p, (Ideal.Quotient.eq.mpr hp).symm⟩

#print axioms s2e_nativeAnalytic_polynomial_quotient_surjective
/-- Polynomial evaluation extends the variable ideal to the actual native
analytic maximal ideal.
Source: Serre, Géométrie algébrique et géométrie analytique, §2, no. 6. -/
theorem s2e_nativeAnalytic_map_variableIdeal (d : ℕ) :
    (MvPolynomial.idealOfVars (Fin d) ℂ).map (s2e_nativeAnalytic_polynomial d) =
      IsLocalRing.maximalIdeal (s2e_nativeAnalyticGermRing d) := by
  rw [s2e_nativeAnalytic_maximalIdeal_coordinates]
  change (Ideal.span (Set.range MvPolynomial.X)).map _ = _
  rw [Ideal.map_span, ← Set.range_comp]
  congr 1
  congr 1
  funext i
  exact MvPolynomial.eval₂Hom_X' _ _ i

#print axioms s2e_nativeAnalytic_map_variableIdeal
end HodgeLean.Foundations.Program
