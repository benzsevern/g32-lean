import Mathlib.Algebra.MvPolynomial.Eval
import HodgeLean.Foundations.Program.SchoenCycleUnramifiedStalkIdeal
import Mathlib.RingTheory.Ideal.Quotient.Operations

/-! # Polynomial ideals of specified points -/
noncomputable section
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option maxHeartbeats 400000
set_option synthInstance.maxHeartbeats 400000
namespace HodgeLean.Foundations.Program

/-- The kernel of polynomial evaluation is generated by the shifted
coordinate functions.
Source: Hartshorne, Algebraic Geometry, I.1. -/
theorem s2e_polynomial_eval_kernel
    {R ι : Type*} [CommRing R] (a : ι → R) :
    RingHom.ker (MvPolynomial.eval a) =
      Ideal.span (Set.range (fun i => MvPolynomial.X i - MvPolynomial.C (a i))) := by
  let I : Ideal (MvPolynomial ι R) :=
    Ideal.span (Set.range (fun i => MvPolynomial.X i - MvPolynomial.C (a i)))
  have he : Ideal.Quotient.mk I =
      ((Ideal.Quotient.mk I).comp MvPolynomial.C).comp (MvPolynomial.eval a) := by
    apply MvPolynomial.ringHom_ext
    · intro c
      simp
    · intro i
      simp only [RingHom.comp_apply, MvPolynomial.eval_X]
      apply Ideal.Quotient.eq.mpr
      exact Ideal.subset_span (Set.mem_range_self i)
  apply le_antisymm
  · intro p hp
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    change (Ideal.Quotient.mk I) p = 0
    rw [he, RingHom.comp_apply, RingHom.comp_apply]
    change (Ideal.Quotient.mk I) (MvPolynomial.C (MvPolynomial.eval a p)) = 0
    rw [show MvPolynomial.eval a p = 0 from hp, map_zero, map_zero]
  · apply Ideal.span_le.mpr
    rintro _ ⟨i, rfl⟩
    change MvPolynomial.eval a (MvPolynomial.X i - MvPolynomial.C (a i)) = 0
    simp

#print axioms s2e_polynomial_eval_kernel
/-- Shifted coordinate images generate the maximal ideal of an unramified
local algebra with the specified residue evaluation.
Source: Stacks Project, Tag 00UW; Hartshorne, Algebraic Geometry, I.1 and II.2. -/
theorem s2e_unramified_polynomial_local_generators
    {K S ι : Type*} [Field K] [CommRing S] [IsLocalRing S]
    (f : MvPolynomial ι K →+* S) (hf : f.FormallyUnramified) (hft : f.EssFiniteType)
    (e : S →+* K) (a : ι → K)
    (he : e.comp f = MvPolynomial.eval a) :
    Ideal.span (Set.range (fun i => f (MvPolynomial.X i) - f (MvPolynomial.C (a i)))) =
      IsLocalRing.maximalIdeal S := by
  letI : Algebra (MvPolynomial ι K) S := f.toAlgebra
  haveI : Algebra.FormallyUnramified (MvPolynomial ι K) S :=
    (RingHom.formallyUnramified_algebraMap).mp hf
  haveI : Algebra.EssFiniteType (MvPolynomial ι K) S :=
    (RingHom.essFiniteType_algebraMap).mp hft
  let I := RingHom.ker (MvPolynomial.eval a)
  haveI : I.IsMaximal := RingHom.ker_isMaximal_of_surjective _
    (fun c => ⟨MvPolynomial.C c, MvPolynomial.eval_C c⟩)
  have hI : I.map (algebraMap (MvPolynomial ι K) S) ≤ IsLocalRing.maximalIdeal S := by
    rw [Ideal.map_le_iff_le_comap]
    intro q hq
    change ¬ IsUnit (f q)
    intro hu
    have hzero : e (f q) = 0 := by
      change (e.comp f) q = 0
      rw [he]
      exact hq
    exact not_isUnit_zero (hzero ▸ hu.map e)
  have h := s2e_unramified_local_map_maximalIdeal I hI
  change (RingHom.ker (MvPolynomial.eval a)).map f = _ at h
  rw [s2e_polynomial_eval_kernel, Ideal.map_span, ← Set.range_comp] at h
  simpa only [Function.comp_def, map_sub] using h

#print axioms s2e_unramified_polynomial_local_generators
end HodgeLean.Foundations.Program
