import HodgeLean.Foundations.Program.SchoenCycleS3AffineConormalFree
import HodgeLean.Foundations.Program.SchoenCycleResidueChartSum

/-! # Coordinate conormal bases on the retained projective charts -/
noncomputable section
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option maxHeartbeats 400000
set_option synthInstance.maxHeartbeats 400000
open CategoryTheory AlgebraicGeometry AlgebraicGeometry.ComplexProjectiveSpace MvPolynomial
namespace HodgeLean.Foundations.Program

/-- On a chart meeting the intersection, each selected index is a chart variable. -/
def s2e_residueChartCoordinateEmbedding {k : ℕ} (T : Finset (Fin (k + 1)))
    (i : Fin (k + 1)) (hi : i ∉ T) : T ↪ {j : Fin (k + 1) // j ≠ i} where
  toFun j := ⟨j.val, fun h => hi (h ▸ j.property)⟩
  inj' j l h := Subtype.ext
    (congrArg (fun x : {j : Fin (k + 1) // j ≠ i} => x.val) h)

/-- The exact pulled-back residue ideal is generated by these distinct chart variables. -/
theorem s2e_residueChartIdeal_eq_coordinateSpan {k : ℕ}
    (T : Finset (Fin (k + 1))) (i : Fin (k + 1)) (hi : i ∉ T) :
    Ideal.map (Scheme.ΓSpecIso
        ↧(MvPolynomial {j : Fin (k + 1) // j ≠ i} ℂ)).hom.hom
      (((s2e_s2b_intersectionIdeal k T).comap (s2e_s2b_chart i)).ideal ⟨⊤, isAffineOpen_top _⟩) =
    Ideal.span (Set.range (fun j : T =>
      (X (s2e_residueChartCoordinateEmbedding T i hi j) :
        MvPolynomial {j : Fin (k + 1) // j ≠ i} ℂ))) := by
  classical
  rw [s2e_chain_residue_projective_chart_aux]
  congr 1
  ext p
  constructor
  · rintro ⟨j, hj, rfl⟩
    have hji : j ≠ i := fun h => hi (h ▸ hj)
    dsimp only
    rw [dite_eq_right hji]
    exact ⟨⟨j, hj⟩, rfl⟩
  · rintro ⟨j, rfl⟩
    refine ⟨j.val, j.property, ?_⟩
    have hji : j.val ≠ i := fun h => hi (h ▸ j.property)
    dsimp only
    rw [dite_eq_right hji]
    rfl

/-- The affine module of the exact chart ideal gives a free sheaf of the residue count. -/
theorem s2e_residueChartCotangentSheaf_free {k : ℕ}
    (T : Finset (Fin (k + 1))) (i : Fin (k + 1)) (hi : i ∉ T) :
    let I := Ideal.map (Scheme.ΓSpecIso
        ↧(MvPolynomial {j : Fin (k + 1) // j ≠ i} ℂ)).hom.hom
      (((s2e_s2b_intersectionIdeal k T).comap (s2e_s2b_chart i)).ideal ⟨⊤, isAffineOpen_top _⟩)
    let Q := CommRingCat.of (MvPolynomial {j : Fin (k + 1) // j ≠ i} ℂ ⧸ I)
    Nonempty (tilde (ModuleCat.of Q I.Cotangent) ≅
      (SheafOfModules.free (R := (Spec Q).ringCatSheaf) (Fin T.card) :
        (Spec Q).Modules)) := by
  dsimp only
  rw [s2e_residueChartIdeal_eq_coordinateSpan T i hi]
  simpa only [Fintype.card_coe] using
    (⟨s2e_coordinateCotangentSheafFiniteIso (R := ℂ)
      (s2e_residueChartCoordinateEmbedding T i hi)⟩ : Nonempty _)

end HodgeLean.Foundations.Program
