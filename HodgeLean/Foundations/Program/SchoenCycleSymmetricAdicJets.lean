import HodgeLean.Foundations.Program.SchoenCycleInvariantCoefficients
import HodgeLean.Foundations.Program.SchoenCycleAdicIdealEvaluation
import HodgeLean.Foundations.Program.SchoenCycleAdicPermutation
import HodgeLean.Foundations.Program.SchoenCycleSymmetricJets
import HodgeLean.Foundations.Program.SchoenCycleSymmetricAugmentation

/-! # Symmetric representatives of invariant adic elements -/
noncomputable section
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option maxHeartbeats 400000
set_option synthInstance.maxHeartbeats 400000
open MvPolynomial
open scoped BigOperators
namespace HodgeLean.Foundations.Program

/-- Every finite quotient of an invariant polynomial adic element has a
symmetric polynomial representative.
Source: Mumford–Fogarty–Kirwan, Geometric Invariant Theory, Chapter 1, §1;
finite-group averaging in characteristic zero. -/
theorem s2e_invariant_adic_symmetric_representative
    (n : ℕ) (z : AdicCompletion (idealOfVars (Fin n) ℂ) (MvPolynomial (Fin n) ℂ))
    (hz : ∀ σ : Equiv.Perm (Fin n), s2e_polynomial_adic_rename σ z = z) (N : ℕ) :
    ∃ p : MvPolynomial (Fin n) ℂ, IsSymmetric p ∧
      Ideal.Quotient.mk (idealOfVars (Fin n) ℂ ^ N) p =
        AdicCompletion.evalₐ (idealOfVars (Fin n) ℂ) N z := by
  let I := idealOfVars (Fin n) ℂ
  obtain ⟨p, hp⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ I N z)
  have hi (σ : Equiv.Perm (Fin n)) : rename σ p - p ∈ I ^ N := by
    have h := congrArg (AdicCompletion.evalₐ I N) (hz σ)
    unfold s2e_polynomial_adic_rename at h
    rw [s2e_adic_ring_map_eval, ← hp] at h
    change Ideal.Quotient.mk (I ^ N) (rename σ p) = Ideal.Quotient.mk (I ^ N) p at h
    exact (Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).mp h
  obtain ⟨y, hy, he⟩ := s2e_invariant_jet_representative (Equiv.Perm (Fin n))
    (MvPolynomial (Fin n) ℂ) (s2e_polynomial_permutation_action (Fin n)) (I ^ N) p hi
  refine ⟨y, hy, ?_⟩
  exact ((Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).mpr he).trans hp

#print axioms s2e_invariant_adic_symmetric_representative
/-- An invariant adic element vanishing to order one has finite representatives
in the positive elementary symmetric ideal.
Source: Macdonald, Symmetric Functions and Hall Polynomials, Chapter I, §2;
finite-group averaging and the fundamental theorem of symmetric polynomials. -/
theorem s2e_invariant_adic_elementary_representative
    (n : ℕ) (z : AdicCompletion (idealOfVars (Fin n) ℂ) (MvPolynomial (Fin n) ℂ))
    (hz : ∀ σ : Equiv.Perm (Fin n), s2e_polynomial_adic_rename σ z = z)
    (h0 : AdicCompletion.evalₐ (idealOfVars (Fin n) ℂ) 1 z = 0)
    (N : ℕ) (hN : 0 < N) :
    ∃ p : MvPolynomial (Fin n) ℂ,
      p ∈ Ideal.span (Set.range (fun j : Fin n => esymm (Fin n) ℂ (j.val + 1))) ∧
      Ideal.Quotient.mk (idealOfVars (Fin n) ℂ ^ N) p =
        AdicCompletion.evalₐ (idealOfVars (Fin n) ℂ) N z := by
  obtain ⟨p, hp, he⟩ := s2e_invariant_adic_symmetric_representative n z hz N
  refine ⟨p, ?_, he⟩
  apply s2e_symmetric_zero_constant_mem_elementary_ideal ℂ n p hp
  have h := congrArg (Ideal.Quotient.factorPow (idealOfVars (Fin n) ℂ) hN) he
  rw [s2e_adic_eval_factor, h0] at h
  have hm : p ∈ idealOfVars (Fin n) ℂ := by
    have hm := Ideal.Quotient.eq_zero_iff_mem.mp h
    simpa only [pow_one] using hm
  have hk : idealOfVars (Fin n) ℂ ≤ RingHom.ker constantCoeff := by
    apply Ideal.span_le.mpr
    rintro _ ⟨i, rfl⟩
    change constantCoeff (X i : MvPolynomial (Fin n) ℂ) = 0
    simp only [constantCoeff_X]
  exact hk hm

#print axioms s2e_invariant_adic_elementary_representative
/-- Invariant polynomial adic elements vanishing to order one belong to the
ideal generated by the positive elementary symmetric polynomials in the adic ring.
Source: Macdonald, Symmetric Functions and Hall Polynomials, Chapter I, §2;
Atiyah–Macdonald, Chapter 10; finite-group averaging and Vieta's formula. -/
theorem s2e_invariant_adic_mem_elementary_span
    (n : ℕ) (z : AdicCompletion (idealOfVars (Fin n) ℂ) (MvPolynomial (Fin n) ℂ))
    (hz : ∀ σ : Equiv.Perm (Fin n), s2e_polynomial_adic_rename σ z = z)
    (h0 : AdicCompletion.evalₐ (idealOfVars (Fin n) ℂ) 1 z = 0) :
    z ∈ Ideal.span (Set.range (fun j : Fin n =>
      algebraMap (MvPolynomial (Fin n) ℂ)
        (AdicCompletion (idealOfVars (Fin n) ℂ) (MvPolynomial (Fin n) ℂ))
        (esymm (Fin n) ℂ (j.val + 1)))) := by
  let I := idealOfVars (Fin n) ℂ
  let J : Ideal (MvPolynomial (Fin n) ℂ) :=
    Ideal.span (Set.range (fun j : Fin n => esymm (Fin n) ℂ (j.val + 1)))
  let a := algebraMap (MvPolynomial (Fin n) ℂ) (AdicCompletion I (MvPolynomial (Fin n) ℂ))
  obtain ⟨k, hk, hIJ⟩ := s2e_idealOfVars_pow_le_elementary ℂ n
  obtain ⟨p, hp, he⟩ := s2e_invariant_adic_elementary_representative n z hz h0 k hk
  have hd : z - a p ∈ (I ^ k).map a := by
    apply (s2e_adic_mem_extended_pow_iff_eval I (idealOfVars_fg (Fin n) ℂ) _ k).mpr
    rw [map_sub]
    change AdicCompletion.evalₐ I k z - AdicCompletion.evalₐ I k (AdicCompletion.of I _ p) = 0
    rw [AdicCompletion.evalₐ_of, he, sub_self]
  have hzJ : z - a p ∈ J.map a := (Ideal.map_mono hIJ) hd
  have hpJ : a p ∈ J.map a := Ideal.mem_map_of_mem a hp
  have h : z ∈ J.map a := by
    simpa only [sub_add_cancel] using (J.map a).add_mem hzJ hpJ
  simpa only [J, Ideal.map_span, ← Set.range_comp, Function.comp_def, a, I] using h

#print axioms s2e_invariant_adic_mem_elementary_span
/-- A vanishing invariant polynomial-adic element is an elementary symmetric
linear combination with invariant adic coefficients.
Source: Macdonald, Symmetric Functions and Hall Polynomials, Chapter I, §2;
Mumford–Fogarty–Kirwan, Geometric Invariant Theory, Chapter 1, §1. -/
theorem s2e_invariant_adic_elementary_invariant_coefficients
    (n : ℕ) (z : AdicCompletion (idealOfVars (Fin n) ℂ) (MvPolynomial (Fin n) ℂ))
    (hz : ∀ σ : Equiv.Perm (Fin n), s2e_polynomial_adic_rename σ z = z)
    (h0 : AdicCompletion.evalₐ (idealOfVars (Fin n) ℂ) 1 z = 0) :
    ∃ b : Fin n → AdicCompletion (idealOfVars (Fin n) ℂ) (MvPolynomial (Fin n) ℂ),
      (∀ σ : Equiv.Perm (Fin n), ∀ j, s2e_polynomial_adic_rename σ (b j) = b j) ∧
      ∑ j, b j * algebraMap (MvPolynomial (Fin n) ℂ)
        (AdicCompletion (idealOfVars (Fin n) ℂ) (MvPolynomial (Fin n) ℂ))
        (esymm (Fin n) ℂ (j.val + 1)) = z := by
  apply s2e_invariant_span_invariant_coefficients _ (Equiv.Perm (Fin n)) (Fin n)
    (s2e_polynomial_adic_permutation_action (Fin n)) _ _ z hz
    (s2e_invariant_adic_mem_elementary_span n z hz h0)
  intro σ j
  change s2e_polynomial_adic_rename σ
    (AdicCompletion.of (idealOfVars (Fin n) ℂ) _ (esymm (Fin n) ℂ (j.val + 1))) = _
  unfold s2e_polynomial_adic_rename
  rw [s2e_adic_ring_map_of]
  change AdicCompletion.of (idealOfVars (Fin n) ℂ) _
    (rename σ (esymm (Fin n) ℂ (j.val + 1))) = _
  rw [rename_esymm]
  rfl

#print axioms s2e_invariant_adic_elementary_invariant_coefficients
end HodgeLean.Foundations.Program
