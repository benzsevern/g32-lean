import HodgeLean.Foundations.Program.SchoenCycleRectangularJets
import Mathlib.RingTheory.MvPolynomial.Ideal

/-! # Total-order multivariable infinitesimal neighbourhoods -/
noncomputable section
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option maxHeartbeats 400000
set_option synthInstance.maxHeartbeats 400000
open MvPolynomial
namespace HodgeLean.Foundations.Program

/-- Subtracting the constant coefficient puts a polynomial in the coordinate ideal.
Source: Atiyah–Macdonald, Introduction to Commutative Algebra, Chapter 1. -/
theorem s2e_polynomial_sub_scalar_mem_coordinate_ideal
    (σ : Type*) (p : MvPolynomial σ ℂ) :
    p - C (constantCoeff p) ∈ idealOfVars σ ℂ := by
  induction p using MvPolynomial.induction_on with
  | C c => simp
  | add p q hp hq =>
    have h := (idealOfVars σ ℂ).add_mem hp hq
    convert h using 1 <;> simp only [map_add] <;> ring
  | mul_X p i hp =>
    simp only [map_mul, constantCoeff_X, mul_zero, map_zero, sub_zero]
    exact (idealOfVars σ ℂ).mul_mem_left p (Ideal.subset_span ⟨i, rfl⟩)

/-- The polynomial coordinate ideal is the kernel of scalar residue.
Source: Atiyah–Macdonald, Introduction to Commutative Algebra, Chapter 1. -/
theorem s2e_polynomial_coordinate_ideal_residue_kernel (σ : Type*) :
    RingHom.ker (constantCoeff : MvPolynomial σ ℂ →+* ℂ) = idealOfVars σ ℂ := by
  apply le_antisymm
  · intro p hp
    have h0 : constantCoeff p = 0 := hp
    simpa only [h0, map_zero, sub_zero] using
      s2e_polynomial_sub_scalar_mem_coordinate_ideal σ p
  · apply Ideal.span_le.mpr
    rintro p ⟨i, rfl⟩
    exact constantCoeff_X ℂ i

/-- Scalar residue on the total-order polynomial neighbourhood.
Source: Atiyah–Macdonald, Introduction to Commutative Algebra, Chapter 10. -/
def s2e_totalJetResidue (σ : Type*) (N : ℕ) (hN : 0 < N) :
    (MvPolynomial σ ℂ ⧸ idealOfVars σ ℂ ^ N) →ₐ[ℂ] ℂ := by
  let ε : MvPolynomial σ ℂ →ₐ[ℂ] ℂ := aeval (fun _ : σ => (0 : ℂ))
  have hm : idealOfVars σ ℂ ≤ RingHom.ker ε.toRingHom := by
    apply Ideal.span_le.mpr
    rintro p ⟨i, rfl⟩
    change ε (X i) = 0
    simp only [ε, aeval_X]
  have hI : idealOfVars σ ℂ ^ N ≤ RingHom.ker ε.toRingHom :=
    (Ideal.pow_le_self (Nat.ne_of_gt hN)).trans hm
  exact Ideal.Quotient.liftₐ (idealOfVars σ ℂ ^ N) ε (fun p hp => hI hp)

/-- The total-order coordinate quotient kills the specified power of every variable.
Source: Atiyah–Macdonald, Introduction to Commutative Algebra, Chapter 10. -/
theorem s2e_totalJet_coordinate_pow (σ : Type*) (N : ℕ) (i : σ) :
    Ideal.Quotient.mk (idealOfVars σ ℂ ^ N) (X i) ^ N = 0 := by
  rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem]
  have hi : (X i : MvPolynomial σ ℂ) ∈ idealOfVars σ ℂ := Ideal.subset_span ⟨i, rfl⟩
  exact Ideal.pow_mem_pow hi N

/-- Scalar residue on a total-order polynomial class is its constant coefficient.
Source: Atiyah–Macdonald, Introduction to Commutative Algebra, Chapter 10. -/
theorem s2e_totalJetResidue_mk (σ : Type*) (N : ℕ) (hN : 0 < N)
    (p : MvPolynomial σ ℂ) :
    s2e_totalJetResidue σ N hN (Ideal.Quotient.mk (idealOfVars σ ℂ ^ N) p) =
      constantCoeff p := by
  change aeval (fun _ : σ => (0 : ℂ)) p = constantCoeff p
  simp only [aeval_zero', Algebra.algebraMap_self, RingHom.id_apply]

/-- The total-order polynomial neighbourhood is a local complex algebra.
Source: Atiyah–Macdonald, Introduction to Commutative Algebra, Chapters 1 and 10. -/
theorem s2e_totalJet_isLocalRing (σ : Type*) (N : ℕ) (hN : 0 < N) :
    IsLocalRing (MvPolynomial σ ℂ ⧸ idealOfVars σ ℂ ^ N) := by
  let I := idealOfVars σ ℂ ^ N
  let A := MvPolynomial σ ℂ ⧸ I
  let a : σ → A := fun i => Ideal.Quotient.mk I (X i)
  have ha (i : σ) : IsNilpotent (a i) := ⟨N, s2e_totalJet_coordinate_pow σ N i⟩
  apply s2e_nilpotent_scalar_residue_isLocalRing A (s2e_totalJetResidue σ N hN)
  intro r
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective r
  have hp := s2e_nilpotent_coordinate_evaluation σ A a ha p
  dsimp only [a] at hp
  rw [← mkₐ_eq_aeval] at hp
  rw [s2e_totalJetResidue_mk]
  exact hp

/-- The maximal ideal of a total-order neighbourhood is generated by the
images of the coordinate variables.
Source: Atiyah–Macdonald, Introduction to Commutative Algebra, Chapters 1 and 10. -/
theorem s2e_totalJet_maximalIdeal (σ : Type*) (N : ℕ) (hN : 0 < N) :
    letI := s2e_totalJet_isLocalRing σ N hN
    IsLocalRing.maximalIdeal (MvPolynomial σ ℂ ⧸ idealOfVars σ ℂ ^ N) =
      (idealOfVars σ ℂ).map (Ideal.Quotient.mk (idealOfVars σ ℂ ^ N)) := by
  let I := idealOfVars σ ℂ ^ N
  let A := MvPolynomial σ ℂ ⧸ I
  letI := s2e_totalJet_isLocalRing σ N hN
  let ε := s2e_totalJetResidue σ N hN
  have hsurj : Function.Surjective ε := by
    intro c
    refine ⟨algebraMap ℂ A c, ?_⟩
    simpa only [Algebra.algebraMap_self, RingHom.id_apply] using ε.commutes c
  have hker : RingHom.ker ε.toRingHom =
      (idealOfVars σ ℂ).map (Ideal.Quotient.mk I) := by
    change RingHom.ker (Ideal.Quotient.lift I _ _) = _
    rw [Ideal.ker_quotient_lift]
    congr 1
    have he : (aeval (fun _ : σ => (0 : ℂ)) : MvPolynomial σ ℂ →ₐ[ℂ] ℂ).toRingHom =
        constantCoeff := by
      apply RingHom.ext
      intro p
      change aeval (fun _ : σ => (0 : ℂ)) p = constantCoeff p
      simp only [aeval_zero', Algebra.algebraMap_self, RingHom.id_apply]
    change RingHom.ker (aeval (fun _ : σ => (0 : ℂ)) :
      MvPolynomial σ ℂ →ₐ[ℂ] ℂ).toRingHom = idealOfVars σ ℂ
    rw [he]
    exact s2e_polynomial_coordinate_ideal_residue_kernel σ
  exact (IsLocalRing.ker_eq_maximalIdeal ε.toRingHom hsurj).symm.trans hker

/-- The total-order coordinate algebra has the specified maximal-ideal
nilpotence bound.
Source: Atiyah–Macdonald, Introduction to Commutative Algebra, Chapter 10. -/
theorem s2e_totalJet_maximalIdeal_pow (σ : Type*) (N : ℕ) (hN : 0 < N) :
    letI := s2e_totalJet_isLocalRing σ N hN
    IsLocalRing.maximalIdeal (MvPolynomial σ ℂ ⧸ idealOfVars σ ℂ ^ N) ^ N = ⊥ := by
  letI := s2e_totalJet_isLocalRing σ N hN
  rw [s2e_totalJet_maximalIdeal σ N hN, ← Ideal.map_pow,
    Ideal.map_eq_bot_iff_le_ker, Ideal.mk_ker]

end HodgeLean.Foundations.Program
