import HodgeLean.Foundations.Program.SchoenHomogeneousDegreeSupport

noncomputable section
set_option maxHeartbeats 400000
set_option synthInstance.maxHeartbeats 400000
namespace HodgeLean.Foundations.Program

/-- The actual subalgebra generated by one homogeneous degree. -/
def s2_degreeSubalgebra {A : Type} [CommRing A]
    (𝒜 : ℕ → AddSubgroup A) [GradedRing 𝒜] (M : ℕ) : Subalgebra (𝒜 0) A :=
  Algebra.adjoin (𝒜 0) (𝒜 M : Set A)

/-- The actual degree-generated subalgebra carries the inherited grading. -/
def s2_degreeSubalgebraGrading {A : Type} [CommRing A]
    (𝒜 : ℕ → AddSubgroup A) [GradedRing 𝒜] (M : ℕ) :
    GradedRing (s2_subringGradedPiece 𝒜 (s2_degreeSubalgebra 𝒜 M).toSubring) :=
  s2_homogeneousAdjoinGrading 𝒜 (𝒜 M : Set A) (fun _ ha => ⟨M, ha⟩)

/-- Every nonzero homogeneous element of the actual degree-generated subalgebra has divisible degree. -/
theorem s2_degreeSubalgebra_degree_dvd {A : Type} [CommRing A]
    (𝒜 : ℕ → AddSubgroup A) [GradedRing 𝒜] (M : ℕ)
    {a : A} (ha : a ∈ s2_degreeSubalgebra 𝒜 M) {n : ℕ}
    (han : a ∈ 𝒜 n) (hane : a ≠ 0) : M ∣ n := by
  by_contra hn
  have ha' : a ∈ Algebra.adjoin (𝒜 0) (Set.range (fun x : 𝒜 M => (x : A))) := by
    have hrange : Set.range (fun x : 𝒜 M => (x : A)) = (𝒜 M : Set A) := by
      ext x
      exact ⟨fun ⟨y, hy⟩ => hy ▸ y.property, fun hx => ⟨⟨x, hx⟩, rfl⟩⟩
    rw [hrange]
    exact ha
  have h := s2_commonDegreeAdjoin_components_vanish 𝒜 M
    (fun x : 𝒜 M => (x : A)) (fun x => x.property) a ha' n hn
  rw [DirectSum.decompose_of_mem_same 𝒜 han] at h
  exact hane h

end HodgeLean.Foundations.Program
