import HodgeLean.Foundations.Program.SchoenHighDegreeMonomials
import Mathlib.Algebra.Group.Submonoid.Finsupp

noncomputable section
set_option maxHeartbeats 400000
set_option synthInstance.maxHeartbeats 400000
open scoped BigOperators
namespace HodgeLean.Foundations.Program

/-- Every high-degree component lies in the actual subalgebra generated by the first high degree. -/
theorem s2_highDegree_component_mem {A ι : Type} [CommRing A] [Fintype ι]
    (𝒜 : ℕ → AddSubgroup A) [GradedRing 𝒜] (v : ι → A) (d c : ι → ℕ)
    (hd : ∀ i, 0 < d i) (hv : ∀ i, v i ∈ 𝒜 (d i))
    (hgen : Algebra.adjoin (𝒜 0) (Set.range v) = ⊤)
    (D N : ℕ) (hD : 0 < D) (hc : ∀ i, c i * d i = D) (hN : Fintype.card ι < N)
    (k : ℕ) (x : A) :
    (DirectSum.decompose 𝒜 x (k * (N * D)) : A) ∈
      Algebra.adjoin (𝒜 0) (𝒜 (N * D) : Set A) := by
  classical
  let Q := Algebra.adjoin (𝒜 0) (𝒜 (N * D) : Set A)
  have hx : x ∈ Submodule.span (𝒜 0) (Submonoid.closure (Set.range v)) := by
    rw [← Algebra.adjoin_eq_span, hgen]
    trivial
  induction hx using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨a, rfl⟩ := Submonoid.exists_of_mem_closure_range _ _ hx
    have hmon := SetLike.prod_pow_mem_graded 𝒜 d v a (F := Finset.univ) (fun i _ => hv i)
    by_cases hdeg : ∑ i, a i * d i = k * (N * D)
    · rw [DirectSum.decompose_of_mem_same 𝒜 (by simpa only [smul_eq_mul, hdeg] using hmon)]
      exact s2_highDegree_monomial_mem 𝒜 v d c hd hv D N hD hc hN k a hdeg
    · rw [DirectSum.decompose_of_mem_ne 𝒜 hmon (by simpa only [smul_eq_mul] using hdeg)]
      exact Q.zero_mem
  | zero =>
    change GradedRing.proj 𝒜 (k * (N * D)) 0 ∈ Q
    rw [map_zero]
    exact Q.zero_mem
  | add x y hx hy ihx ihy =>
    change GradedRing.proj 𝒜 (k * (N * D)) (x + y) ∈ Q
    rw [map_add]
    exact Q.add_mem ihx ihy
  | smul r x hx ih =>
    change (DirectSum.decompose 𝒜 (r.val * x) (k * (N * D)) : A) ∈ Q
    rw [DirectSum.coe_decompose_mul_of_left_mem_zero 𝒜 r.property]
    exact Q.mul_mem (Q.algebraMap_mem r) ih

/-- Every homogeneous element of a multiple of the selected high degree belongs to its actual adjoin. -/
theorem s2_highDegree_homogeneous_mem {A ι : Type} [CommRing A] [Fintype ι]
    (𝒜 : ℕ → AddSubgroup A) [GradedRing 𝒜] (v : ι → A) (d c : ι → ℕ)
    (hd : ∀ i, 0 < d i) (hv : ∀ i, v i ∈ 𝒜 (d i))
    (hgen : Algebra.adjoin (𝒜 0) (Set.range v) = ⊤)
    (D N : ℕ) (hD : 0 < D) (hc : ∀ i, c i * d i = D) (hN : Fintype.card ι < N)
    (k : ℕ) {x : A} (hx : x ∈ 𝒜 (k * (N * D))) :
    x ∈ Algebra.adjoin (𝒜 0) (𝒜 (N * D) : Set A) := by
  have h := s2_highDegree_component_mem 𝒜 v d c hd hv hgen D N hD hc hN k x
  rwa [DirectSum.decompose_of_mem_same 𝒜 hx] at h

end HodgeLean.Foundations.Program
