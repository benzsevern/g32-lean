import HodgeLean.Foundations.Program.SchoenWeightedExponentSplit
import Mathlib.RingTheory.GradedAlgebra.Basic

noncomputable section
set_option maxHeartbeats 400000
set_option synthInstance.maxHeartbeats 400000
open scoped BigOperators
namespace HodgeLean.Foundations.Program

/-- Monomials in sufficiently high common degrees are generated by the first such degree. -/
theorem s2_highDegree_monomial_mem {A ι : Type} [CommRing A] [Fintype ι]
    (𝒜 : ℕ → AddSubgroup A) [GradedRing 𝒜] (v : ι → A) (d c : ι → ℕ)
    (hd : ∀ i, 0 < d i) (hv : ∀ i, v i ∈ 𝒜 (d i))
    (D N : ℕ) (hD : 0 < D) (hc : ∀ i, c i * d i = D) (hN : Fintype.card ι < N)
    (k : ℕ) (a : ι → ℕ) (ha : ∑ i, a i * d i = k * (N * D)) :
    (∏ i, v i ^ a i) ∈ Algebra.adjoin (𝒜 0) (𝒜 (N * D) : Set A) := by
  classical
  induction k generalizing a with
  | zero =>
    have hz : ∀ i, a i = 0 := by
      intro i
      have hs : ∑ i, a i * d i = 0 := by simpa only [zero_mul] using ha
      have hi := (Finset.sum_eq_zero_iff_of_nonneg (fun j _ => Nat.zero_le (a j * d j))).mp hs i
        (Finset.mem_univ i)
      rcases Nat.mul_eq_zero.mp hi with h | h
      · exact h
      · exact ((hd i).ne' h).elim
    simp only [hz, pow_zero, Finset.prod_const_one]
    exact Subalgebra.one_mem _
  | succ k ih =>
    obtain ⟨b, hb, hbsum⟩ := s2_weighted_exponent_split Finset.univ a d c D N (k + 1)
      hD (by simpa using hN) (Nat.succ_pos k) (fun i _ => hc i) ha
    have hrem : ∑ i, (a i - b i) * d i = k * (N * D) := by
      have hs : (∑ i, (a i - b i) * d i) + (∑ i, b i * d i) = ∑ i, a i * d i := by
        rw [← Finset.sum_add_distrib]
        apply Finset.sum_congr rfl
        intro i _
        rw [← add_mul, Nat.sub_add_cancel (hb i)]
      rw [hbsum, ha] at hs
      nlinarith
    have hbm : (∏ i, v i ^ b i) ∈ 𝒜 (N * D) := by
      have h := SetLike.prod_pow_mem_graded 𝒜 d v b (F := Finset.univ) (fun i _ => hv i)
      simpa only [smul_eq_mul, hbsum] using h
    have hprod : (∏ i, v i ^ a i) = (∏ i, v i ^ b i) * (∏ i, v i ^ (a i - b i)) := by
      rw [← Finset.prod_mul_distrib]
      apply Finset.prod_congr rfl
      intro i _
      rw [← pow_add, Nat.add_sub_of_le (hb i)]
    rw [hprod]
    exact Subalgebra.mul_mem _ (Algebra.subset_adjoin hbm) (ih _ hrem)

end HodgeLean.Foundations.Program
