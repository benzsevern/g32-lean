import Mathlib.RingTheory.GradedAlgebra.Homogeneous.Subsemiring
import HodgeLean.Foundations.Program.SchoenHomogeneousSubringGrading

noncomputable section
set_option maxHeartbeats 400000
set_option synthInstance.maxHeartbeats 400000
namespace HodgeLean.Foundations.Program

/-- The subalgebra generated over degree zero by homogeneous elements retains every component. -/
theorem s2_homogeneous_adjoin_components {A : Type} [CommRing A]
    (𝒜 : ℕ → AddSubgroup A) [GradedRing 𝒜] (s : Set A)
    (hs : ∀ a ∈ s, ∃ n, a ∈ 𝒜 n) :
    ∀ n, ∀ a ∈ Algebra.adjoin (𝒜 0) s, (DirectSum.decompose 𝒜 a n : A) ∈
      Algebra.adjoin (𝒜 0) s := by
  apply IsHomogeneous.subsemiringClosure_of_isHomogeneousElem
  intro a ha
  rcases ha with ⟨c, rfl⟩ | ha
  · exact ⟨0, c.property⟩
  · exact hs a ha

/-- The actual subalgebra generated by homogeneous elements carries its inherited grading. -/
def s2_homogeneousAdjoinGrading {A : Type} [CommRing A]
    (𝒜 : ℕ → AddSubgroup A) [GradedRing 𝒜] (s : Set A)
    (hs : ∀ a ∈ s, ∃ n, a ∈ 𝒜 n) :
    GradedRing (s2_subringGradedPiece 𝒜 (Algebra.adjoin (𝒜 0) s).toSubring) :=
  s2_homogeneousSubringGrading 𝒜 (Algebra.adjoin (𝒜 0) s).toSubring
    (s2_homogeneous_adjoin_components 𝒜 s hs)

end HodgeLean.Foundations.Program
