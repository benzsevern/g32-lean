import Mathlib.RingTheory.ReesAlgebra
import Mathlib.RingTheory.Localization.Away.Basic
import Mathlib.RingTheory.MvPolynomial.Homogeneous

/-! # Rees presentation and affine fraction algebras
Concrete algebra constructions for the first B2 pieces.
HC no distance; AV milestone no distance.
-/
noncomputable section
namespace HodgeLean.Foundations.Program

/-- A degree-one Rees element with its specified coefficient.
Source: Mathlib, `reesAlgebra.monomial_mem`. -/
def s2t_reesGenerator {R : Type} [CommRing R] (I : Ideal R) (x : I) :
    reesAlgebra I :=
  ⟨Polynomial.monomial 1 x.val,
    reesAlgebra.monomial_mem.mpr (by simpa only [pow_one] using x.property)⟩

example {R : Type} [CommRing R] (I : Ideal R) (x : I) :
    (s2t_reesGenerator I x).val = Polynomial.monomial 1 x.val := rfl

/-- The polynomial map specified by a family in the ideal.
Source: Hartshorne, Algebraic Geometry, II.7, proof of Proposition 7.13;
Mathlib, `MvPolynomial.aeval`. -/
def s2t_reesPresentation {R : Type} [CommRing R] {n : ℕ}
    (I : Ideal R) (g : Fin n → I) :
    MvPolynomial (Fin n) R →ₐ[R] reesAlgebra I :=
  MvPolynomial.aeval (fun i => s2t_reesGenerator I (g i))

example {R : Type} [CommRing R] {n : ℕ} (I : Ideal R) (g : Fin n → I)
    (i : Fin n) :
    s2t_reesPresentation I g (MvPolynomial.X i) = s2t_reesGenerator I (g i) :=
  MvPolynomial.aeval_X _ _

/-- The affine fraction algebra generated by all x/f for x in I.
Source: Hartshorne, Algebraic Geometry, II.7, proof of Proposition 7.13. -/
def s2t_reesChart {R : Type} [CommRing R] (I : Ideal R) (f : R) :
    Subalgebra R (Localization.Away f) :=
  Algebra.adjoin R (Set.range (fun x : I =>
    algebraMap R (Localization.Away f) x.val *
      IsLocalization.Away.invSelf f))

example {R : Type} [CommRing R] (I : Ideal R) (f : R) (x : I) :
    algebraMap R (Localization.Away f) x.val * IsLocalization.Away.invSelf f ∈
      s2t_reesChart I f :=
  Algebra.subset_adjoin (Set.mem_range_self x)

end HodgeLean.Foundations.Program
