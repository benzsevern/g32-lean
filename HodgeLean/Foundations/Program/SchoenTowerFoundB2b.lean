import HodgeLean.Foundations.Program.SchoenTowerFoundB2bProofs

/-! # B2b: first algebraic piece
Implication from the explicit ring and ideal data below.
HC no distance; AV milestone no distance.
This unit supplies an algebraic prerequisite; geometric assembly remains later work.
-/

noncomputable section
set_option maxHeartbeats 400000
set_option synthInstance.maxHeartbeats 400000
namespace HodgeLean.Foundations.Program

/-- The actual image ideal in the affine fraction algebra is generated by f.
Source: Hartshorne, Algebraic Geometry, II.7, proof of Proposition 7.13. -/
theorem s2t_reesChart_image (R : Type) [CommRing R] (I : Ideal R) (f : R) (hf : f ∈ I) :
    Ideal.map (algebraMap R (s2t_reesChart I f)) I =
      Ideal.span {algebraMap R (s2t_reesChart I f) f} :=
  s2t_reesChart_image_aux R I f hf

example (R : Type) [CommRing R] (I : Ideal R) (f : R) (hf : f ∈ I) :
    Ideal.map (algebraMap R (s2t_reesChart I f)) I =
      Ideal.span {algebraMap R (s2t_reesChart I f) f} :=
  s2t_reesChart_image R I f hf

end HodgeLean.Foundations.Program
