import HodgeLean.Foundations.Program.SchoenTowerFoundB2Defs

noncomputable section
set_option maxHeartbeats 400000
set_option synthInstance.maxHeartbeats 400000
namespace HodgeLean.Foundations.Program

/-- The actual image ideal in the affine fraction algebra is generated by f.
Source: Hartshorne, Algebraic Geometry, II.7, proof of Proposition 7.13. -/
theorem s2t_reesChart_image_aux (R : Type) [CommRing R] (I : Ideal R) (f : R) (hf : f ∈ I) :
    Ideal.map (algebraMap R (s2t_reesChart I f)) I =
      Ideal.span {algebraMap R (s2t_reesChart I f) f} := by
  apply le_antisymm
  · apply Ideal.map_le_iff_le_comap.mpr
    intro x hx
    let q : s2t_reesChart I f :=
      ⟨algebraMap R (Localization.Away f) x * IsLocalization.Away.invSelf f,
        Algebra.subset_adjoin (Set.mem_range_self (⟨x, hx⟩ : I))⟩
    have he : algebraMap R (s2t_reesChart I f) x =
        q * algebraMap R (s2t_reesChart I f) f := by
      apply Subtype.ext
      change algebraMap R (Localization.Away f) x =
        (algebraMap R (Localization.Away f) x * _) * algebraMap R _ f
      rw [mul_assoc, mul_comm (IsLocalization.Away.invSelf f),
        IsLocalization.Away.mul_invSelf, mul_one]
    change algebraMap R (s2t_reesChart I f) x ∈
      Ideal.span {algebraMap R (s2t_reesChart I f) f}
    rw [he]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_singleton _))
  · apply Ideal.span_le.mpr
    intro x hx
    rcases Set.mem_singleton_iff.mp hx with rfl
    exact Ideal.mem_map_of_mem _ hf

end HodgeLean.Foundations.Program
