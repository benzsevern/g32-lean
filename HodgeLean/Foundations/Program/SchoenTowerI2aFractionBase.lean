import HodgeLean.Foundations.Program.SchoenTowerI2aFieldHelpers
import Mathlib.RingTheory.Localization.FractionRing

/-! # Retaining the affine coefficient ring in field generation
HC no distance; AV milestone no distance.
-/
noncomputable section
set_option maxHeartbeats 400000
namespace HodgeLean.Foundations.Program

/-- Adjoining the coefficient fraction field does not enlarge the subfield generated by the actual coefficient ring and a specified element.
Source: Mathlib, IsFractionRing.div_surjective and Subfield.closure_le. -/
theorem s2v_i2a_fraction_base_generated_field
    {R F K : Type*} [CommRing R] [Field F] [Field K]
    [Algebra R F] [IsFractionRing R F] [Algebra R K] [Algebra F K]
    [IsScalarTower R F K] (v : K) :
    Subfield.closure (Set.range (algebraMap R K) ∪ {v}) =
      Subfield.closure (Set.range (algebraMap F K) ∪ {v}) := by
  apply le_antisymm
  · apply Subfield.closure_le.mpr
    rintro x (⟨r, rfl⟩ | hx)
    · rw [IsScalarTower.algebraMap_apply R F K]
      exact Subfield.subset_closure (Or.inl ⟨algebraMap R F r, rfl⟩)
    · exact Subfield.subset_closure (Or.inr hx)
  · apply Subfield.closure_le.mpr
    rintro x (⟨f, rfl⟩ | hx)
    · obtain ⟨r, s, hs, rfl⟩ := IsFractionRing.div_surjective R f
      rw [map_div₀, ← IsScalarTower.algebraMap_apply R F K,
        ← IsScalarTower.algebraMap_apply R F K]
      exact div_mem (Subfield.subset_closure (Or.inl ⟨r, rfl⟩))
        (Subfield.subset_closure (Or.inl ⟨s, rfl⟩))
    · exact Subfield.subset_closure (Or.inr hx)

end HodgeLean.Foundations.Program
