import HodgeLean.Foundations.Program.SchoenTowerI2aAbsentBranchNeighborhood
import HodgeLean.Foundations.Program.SchoenTowerI2aPrincipalSupport
import HodgeLean.Foundations.Program.SchoenTowerI2aBranchSectionIdentification
import HodgeLean.Foundations.Program.SchoenTowerI2aOrderedEvaluations
import HodgeLean.Foundations.Program.SchoenTowerI2aOrderedCoefficientDescent
import HodgeLean.Foundations.Program.SchoenTowerI2aOrderedInvariantChart
import HodgeLean.Foundations.Program.SchoenTowerI2aFiniteCurveSupport

/-! # Actual simultaneous branch charts on the retained initial symmetric base
HC no distance; AV milestone no distance.
-/
noncomputable section
set_option maxHeartbeats 400000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
open CategoryTheory AlgebraicGeometry
open HodgeLean.Adapters
namespace HodgeLean.Foundations.Program
attribute [local instance] overSpecAlgebra

/-- The retained symmetric quotient has an actual affine etale chart at the
specified tuple image, with every present branch ideal in a distinct coordinate
slot and every absent branch ideal generated by one.
Source: Schoen (1988), Lemma 2.2, printed p. 13. -/
theorem s2v_i2a_simultaneous_initial_branch_chart
    (Z B : Over (Spec ↧ℂ)) [IsIntegral Z.left] [Smooth Z.hom] [IsProjective Z.hom]
    (hdimZ : TopologicalSpace.dim Z.left = 1) (h : ℕ)
    (γ : g3_power Z (h + 1) ⟶ B) [IsFinite γ.left]
    (hγinv : ∀ τ, s2_permute Z (h + 1) τ ≫ γ = γ)
    (hγ : ∀ (W : Over (Spec ↧ℂ)) (f : g3_power Z (h + 1) ⟶ W),
      (∀ τ, s2_permute Z (h + 1) τ ≫ f = f) → ∃! u : B ⟶ W, γ ≫ u = f)
    {T : Type} [Fintype T] (branchPoints : T → ComplexPoint Z)
    (hbranchPoints : Function.Injective branchPoints)
    (xOrdered : ComplexPoint (g3_power Z (h + 1))) :
    ∃ (U : Over (Spec ↧ℂ)) (hU : IsAffine U.left) (u : U ⟶ B) (p : ComplexPoint U)
      (c : MvPolynomial (Fin (h + 1)) ℂ →ₐ[ℂ] Γ(U.left, ⊤))
      (J : Finset T) (κ : J ↪ Fin (h + 1)) (z : T → Γ(U.left, ⊤)),
      IsOpenImmersion u.left ∧ Point.map u p = Point.map γ xOrdered ∧ c.toRingHom.Etale ∧
      (∀ t, t ∈ J ↔ (Point.map γ xOrdered).underlying ∈
        (s2c_branchIdeal Z B h γ (branchPoints t)).support) ∧
      (∀ t : J, z t = c (MvPolynomial.X (κ t))) ∧
      (∀ t, t ∉ J → z t = 1) ∧
      (∀ t, ((s2c_branchIdeal Z B h γ (branchPoints t)).comap u.left).ideal
        ⟨⊤, @isAffineOpen_top _ hU⟩ = Ideal.span {z t}) := by
  classical
  let xInitial := Point.map γ xOrdered
  have hxOrdered : Point.map γ xOrdered = xInitial := rfl
  let tuplePoints : Fin (h + 1) → ComplexPoint Z :=
    fun j => Point.map (g3_proj Z (h + 1) j) xOrdered
  obtain ⟨Cchart, hCchart, uCurve, yBranch, yTuple, zCurve, huCurve, hyBranch, hyTuple,
      hCurveEt, hBranchValues, hBranchTupleValues, hTupleValues, hBranchIdeals, hTupleIdeals⟩ :=
    s2v_i2a_branch_and_tuple_curve_parameters Z hdimZ branchPoints hbranchPoints h tuplePoints
  letI : IsAffine Cchart.left := hCchart
  letI : IsOpenImmersion uCurve.left := huCurve
  let orderedLift : ComplexPoint (g3_power Cchart (h + 1)) := s2_lift (h + 1) yTuple
  have horderedLift : Point.map (s2_powerMap uCurve (h + 1)) orderedLift = xOrdered :=
    s2v_l1a_ordered_point_lift uCurve (h + 1) xOrdered yTuple hyTuple
  obtain ⟨Oinitial, hxOrderedOpen, jOrdered, hjOrdered, hjOrderedSquare⟩ :=
    s2v_l1a_compatible_curve_chart Cchart Z B h uCurve γ hγinv hγ xOrdered orderedLift horderedLift
  let VOrdered := ComplexPoint.openScheme (g3_power Z (h + 1)) (γ.left ⁻¹ᵁ Oinitial.1)
  letI : IsAffine VOrdered.left := Oinitial.2.preimage γ.left
  letI : IsOpenImmersion jOrdered.left := hjOrdered
  have hOrderedRootEt := s2v_i2a_ordered_curve_chart_parameters_etale Cchart VOrdered
    (h + 1) jOrdered zCurve hCurveEt
  let vOrdered : VOrdered ⟶ g3_power Z (h + 1) :=
    ComplexPoint.openInclusion (g3_power Z (h + 1)) (γ.left ⁻¹ᵁ Oinitial.1)
  have hOrderedBranchIdeals := s2v_i2a_ordered_curve_branch_ideals Cchart VOrdered Z
    (h + 1) uCurve jOrdered vOrdered hjOrderedSquare branchPoints
    (fun t => Point.evaluate ⊤ zCurve (yBranch t)) zCurve hBranchIdeals
  obtain ⟨qOrdered, ρOrdered, hqOrderedFinite, hqOrderedSquare,
      hρOrdered, hρOrderedQuotient, hqOrderedInjective, hqOrderedImage⟩ :=
    s2v_i2a_ordered_invariant_chart Z B h γ hγinv hγ Oinitial
  let UOrdered := ComplexPoint.openScheme B Oinitial.1
  letI : IsAffine UOrdered.left := Oinitial.2
  letI : IsOpenImmersion vOrdered.left :=
    inferInstanceAs (IsOpenImmersion (γ.left ⁻¹ᵁ Oinitial.1).ι)
  letI : Mono vOrdered := Over.mono_of_mono_left vOrdered
  letI : Mono uCurve := Over.mono_of_mono_left uCurve
  let orderedRoot (i : Fin (h + 1)) :=
    (jOrdered ≫ g3_proj Cchart (h + 1) i).left.appTop.hom zCurve
  have hOrderedCoordinate (i : Fin (h + 1)) :
      (jOrdered ≫ g3_proj Cchart (h + 1) i) ≫ uCurve =
        vOrdered ≫ g3_proj Z (h + 1) i := by
    have H : s2_powerMap uCurve (h + 1) ≫ g3_proj Z (h + 1) i =
        g3_proj Cchart (h + 1) i ≫ uCurve := s2_check_lift_proj (h + 1) _ i
    rw [Category.assoc, ← H, ← Category.assoc, hjOrderedSquare]
  have hOrderedCovariance (τ : Equiv.Perm (Fin (h + 1))) (i : Fin (h + 1)) :
      (ρOrdered τ).left.appTop.hom (orderedRoot i) = orderedRoot (τ⁻¹ i) := by
    have H := s2v_l1a_chart_parameter_action VOrdered Cchart Z (h + 1)
      uCurve vOrdered ρOrdered hρOrdered
      (fun i => jOrdered ≫ g3_proj Cchart (h + 1) i)
      hOrderedCoordinate zCurve τ⁻¹ i
    change (ρOrdered ((τ⁻¹)⁻¹)).left.appTop.hom (orderedRoot i) =
      orderedRoot (τ⁻¹ i) at H
    simpa only [inv_inv] using H
  obtain ⟨orderedCoefficients, hOrderedCoefficients, hOrderedCoefficientsUnique⟩ :=
    s2v_i2a_ordered_coefficient_descent UOrdered VOrdered h qOrdered ρOrdered
      orderedRoot hqOrderedInjective hqOrderedImage hOrderedCovariance
  let pOrdered := ComplexPoint.asOpenPoint (g3_power Z (h + 1))
    (γ.left ⁻¹ᵁ Oinitial.1) xOrdered hxOrderedOpen
  have hpOrdered : Point.map vOrdered pOrdered = xOrdered := by
    apply Over.OverMorphism.ext
    exact ComplexPoint.liftToOpen_fac (g3_power Z (h + 1))
      (γ.left ⁻¹ᵁ Oinitial.1) xOrdered hxOrderedOpen
  have hOrderedEvaluation := s2v_i2a_curve_coordinate_evaluations Cchart VOrdered Z
    (h + 1) uCurve vOrdered (fun i => jOrdered ≫ g3_proj Cchart (h + 1) i)
    hOrderedCoordinate pOrdered xOrdered hpOrdered yTuple hyTuple zCurve
  have hOrderedSeparation (i j : Fin (h + 1))
      (hij : Point.map (vOrdered ≫ g3_proj Z (h + 1) i) pOrdered ≠
        Point.map (vOrdered ≫ g3_proj Z (h + 1) j) pOrdered) :
      Point.evaluate ⊤ (orderedRoot i) pOrdered ≠
        Point.evaluate ⊤ (orderedRoot j) pOrdered := by
    rw [hOrderedEvaluation i, hOrderedEvaluation j]
    intro H
    have Hpoints : tuplePoints i = tuplePoints j := (hTupleValues i j).mp H
    apply hij
    change (pOrdered ≫ vOrdered) ≫ g3_proj Z (h + 1) i =
      (pOrdered ≫ vOrdered) ≫ g3_proj Z (h + 1) j
    rw [show pOrdered ≫ vOrdered = xOrdered from hpOrdered]
    exact Hpoints
  letI : Algebra ℂ Γ(VOrdered.left, ⊤) := overSpecAlgebra VOrdered ⊤
  letI : Algebra ℂ Γ(UOrdered.left, ⊤) := overSpecAlgebra UOrdered ⊤
  have hOrderedRootEtComplex :
      (MvPolynomial.aeval (R := ℂ) orderedRoot).toRingHom.Etale := by
    rw [s2v_l1a_structure_section_coefficients] at hOrderedRootEt
    exact (s2v_l1a_etale_eval_change_coefficients_iff _ _ _).mp hOrderedRootEt
  let branchValues (t : T) : ℂ := Point.evaluate ⊤ zCurve (yBranch t)
  obtain ⟨branchEquation, hBranchEquationProduct, hBranchEquationContraction⟩ :=
    s2v_i2a_actual_branch_product_sections UOrdered VOrdered Z h vOrdered qOrdered
      ρOrdered hρOrdered orderedRoot hOrderedCovariance hqOrderedInjective
      hqOrderedImage hOrderedRootEtComplex branchValues
  have hInitialBranchEquation (t : T) :
      ((s2c_branchIdeal Z B h γ (branchPoints t)).comap Oinitial.1.ι).ideal
        ⟨⊤, @isAffineOpen_top _ Oinitial.2⟩ = Ideal.span {branchEquation t} := by
    exact s2v_i2a_actual_branch_ideal_from_contraction Z B h γ Oinitial qOrdered
      hqOrderedSquare (branchPoints t)
      (orderedRoot 0 - algebraMap ℂ Γ(VOrdered.left, ⊤) (branchValues t))
      (branchEquation t) (hOrderedBranchIdeals t 0) (hBranchEquationContraction t)
  letI : LocallyOfFiniteType VOrdered.hom := by
    rw [← Over.w vOrdered]
    infer_instance
  obtain ⟨dOrdered, hdOrdered, hOrderedCoefficientEtale⟩ :=
    s2v_i2a_ordered_coefficient_etale_neighborhood UOrdered VOrdered Z h vOrdered
      qOrdered ρOrdered hρOrdered orderedRoot hOrderedCovariance hqOrderedInjective
      hqOrderedImage orderedCoefficients hOrderedCoefficients hOrderedRootEtComplex
      pOrdered hOrderedSeparation
  letI : IsFinite qOrdered.left := hqOrderedFinite
  obtain ⟨U', V', hU', hV', rU, rV, q', p', ρLocalized, hrU, hrV, hq', hsquare', hp', hρLocalizedv,
    hρLocalizedq, hlocU, hlocV⟩ :=
    s2v_l1a_principal_quotient_restriction VOrdered UOrdered qOrdered ρOrdered hρOrderedQuotient pOrdered dOrdered hdOrdered
  letI : IsAffine U'.left := hU'
  letI : IsAffine V'.left := hV'
  letI : IsOpenImmersion rU.left := hrU
  letI : IsOpenImmersion rV.left := hrV
  letI : Algebra Γ(UOrdered.left, ⊤) Γ(U'.left, ⊤) := rU.left.appTop.hom.toAlgebra
  letI : Algebra Γ(VOrdered.left, ⊤) Γ(V'.left, ⊤) := rV.left.appTop.hom.toAlgebra
  letI : IsLocalization.Away dOrdered Γ(U'.left, ⊤) := hlocU
  letI : IsLocalization.Away (qOrdered.left.appTop.hom dOrdered) Γ(V'.left, ⊤) := hlocV
  have hcomm (s : Γ(UOrdered.left, ⊤)) : q'.left.appTop.hom (rU.left.appTop.hom s) =
      rV.left.appTop.hom (qOrdered.left.appTop.hom s) := by
    have H := congrArg (fun f : V' ⟶ UOrdered => f.left.appTop.hom s) hsquare'
    simpa only [Over.comp_left, Scheme.Hom.comp_appTop, CommRingCat.comp_apply] using H.symm
  have hmap (t : Equiv.Perm (Fin (h + 1))) :
      (ρLocalized t).left.appTop.hom.comp rV.left.appTop.hom =
        rV.left.appTop.hom.comp (ρOrdered t).left.appTop.hom := by
    ext s
    change (ρLocalized t).left.appTop.hom (rV.left.appTop.hom s) =
      rV.left.appTop.hom ((ρOrdered t).left.appTop.hom s)
    have H := congrArg (fun f : V' ⟶ VOrdered => f.left.appTop.hom s) (hρLocalizedv t)
    simpa only [Over.comp_left, Scheme.Hom.comp_appTop, CommRingCat.comp_apply] using H
  obtain ⟨hqinj', hqimage'⟩ := s2v_l1a_localized_invariant_image
    qOrdered.left.appTop.hom hqOrderedInjective (fun t => (ρOrdered t).left.appTop.hom) hqOrderedImage dOrdered
    q'.left.appTop.hom hcomm (fun t => (ρLocalized t).left.appTop.hom) hmap
  let z' (i : Fin (h + 1)) := rV.left.appTop.hom (orderedRoot i)
  let c' (i : Fin (h + 1)) := rU.left.appTop.hom (orderedCoefficients i)
  have hEt' : (MvPolynomial.eval₂Hom V'.hom.appTop.hom z').Etale := by
    rw [← s2v_l1a_section_parameter_comp rV orderedRoot]
    exact s2v_l1a_etale_ringHom_comp _ _ hOrderedRootEt
      (HasRingHomProperty.appTop (P := @Etale) rV.left inferInstance)
  have hSym' : (MvPolynomial.eval₂Hom U'.hom.appTop.hom c').Etale :=
    s2v_l1a_etale_principal_section_parameters rU orderedCoefficients dOrdered hlocU hOrderedCoefficientEtale
  letI : Algebra ℂ Γ(U'.left, ⊤) := overSpecAlgebra U' ⊤
  letI : Algebra ℂ Γ(V'.left, ⊤) := overSpecAlgebra V' ⊤
  have hCoefficientLocalized := s2v_i2a_symmetric_coefficient_restriction
    UOrdered VOrdered U' V' qOrdered q' rU rV hsquare' (h + 1)
    orderedRoot orderedCoefficients hOrderedCoefficients
  let vLocalized : V' ⟶ g3_power Z (h + 1) := rV ≫ vOrdered
  letI : IsOpenImmersion vLocalized.left :=
    inferInstanceAs (IsOpenImmersion (rV.left ≫ vOrdered.left))
  letI : Mono vLocalized := Over.mono_of_mono_left vLocalized
  have hρLocalizedPower (τ : Equiv.Perm (Fin (h + 1))) :
      ρLocalized τ ≫ vLocalized = vLocalized ≫ s2_permute Z (h + 1) τ := by
    change ρLocalized τ ≫ (rV ≫ vOrdered) = (rV ≫ vOrdered) ≫ _
    rw [← Category.assoc, hρLocalizedv, Category.assoc, hρOrdered, ← Category.assoc]
  have hCovLocalized (τ : Equiv.Perm (Fin (h + 1))) (j : Fin (h + 1)) :
      (ρLocalized τ).left.appTop.hom (z' j) = z' (τ⁻¹ j) := by
    change (ρLocalized τ).left.appTop.hom (rV.left.appTop.hom (orderedRoot j)) = _
    rw [show (ρLocalized τ).left.appTop.hom (rV.left.appTop.hom (orderedRoot j)) =
      rV.left.appTop.hom ((ρOrdered τ).left.appTop.hom (orderedRoot j)) from
        DFunLike.congr_fun (hmap τ) (orderedRoot j), hOrderedCovariance]
  have hEvalLocalized (j : Fin (h + 1)) : Point.evaluate ⊤ (z' j) p' =
      Point.evaluate ⊤ (orderedRoot j) pOrdered := by
    have H := Point.evaluate_map rV ⊤ (orderedRoot j) p'
    rw [hp'] at H
    simpa only [TopologicalSpace.Opens.map_top, Scheme.Hom.appTop] using H.symm
  have hRootEtLocalized : (MvPolynomial.aeval (R := ℂ) z').toRingHom.Etale := by
    have H := hEt'
    rw [s2v_l1a_structure_section_coefficients] at H
    exact (s2v_l1a_etale_eval_change_coefficients_iff _ _ _).mp H
  have hCoefficientEtLocalized : (MvPolynomial.aeval (R := ℂ) c').toRingHom.Etale := by
    have H := hSym'
    rw [s2v_l1a_structure_section_coefficients] at H
    exact (s2v_l1a_etale_eval_change_coefficients_iff _ _ _).mp H
  classical
  let Jinitial : Finset (T) :=
    Finset.univ.filter (fun t => ∃ j, branchPoints t = tuplePoints j)
  have hPresentValues (t : Jinitial) : ∃ j, Point.evaluate ⊤ (z' j) p' = branchValues t := by
    obtain ⟨j, hj⟩ := (Finset.mem_filter.mp t.property).2
    refine ⟨j, ?_⟩
    rw [hEvalLocalized, hOrderedEvaluation]
    exact ((hBranchTupleValues t j).mpr hj).symm
  obtain ⟨κinitial, cBranch, hcBranchEt, hBranchSlots, hBranchProducts,
      hBranchContractions, hBranchZeros⟩ :=
    s2v_i2a_actual_present_branch_parameters U' V' Z h vLocalized q' ρLocalized
      hρLocalizedPower z' hCovLocalized hqinj' hqimage' (MvPolynomial.aeval c')
      hCoefficientEtLocalized
      (by intro j; simpa only [MvPolynomial.aeval_X] using hCoefficientLocalized j)
      hRootEtLocalized p' (fun t : Jinitial => branchValues t)
      (hBranchValues.comp Subtype.val_injective) hPresentValues
  let uOrdered : UOrdered ⟶ B := ComplexPoint.openInclusion B Oinitial.1
  let uBranch : U' ⟶ B := rU ≫ uOrdered
  have hAllBranchIdeals (t : T) :
      ((s2c_branchIdeal Z B h γ (branchPoints t)).comap uBranch.left).ideal
        ⟨⊤, isAffineOpen_top _⟩ = Ideal.span {rU.left.appTop.hom (branchEquation t)} := by
    exact s2v_l1a_curve_point_equation_pullback uOrdered.left rU.left
      (s2c_branchIdeal Z B h γ (branchPoints t)) (branchEquation t) (hInitialBranchEquation t)
  have hBranchSectionCoordinates (t : Jinitial) : rU.left.appTop.hom (branchEquation t) =
      cBranch (MvPolynomial.X (κinitial t)) := by
    exact s2v_i2a_branch_section_restriction_identification UOrdered VOrdered U' V'
      qOrdered q' rU rV hsquare' hqinj' (h + 1) orderedRoot (branchValues t)
      (branchEquation t) (cBranch (MvPolynomial.X (κinitial t)))
      (hBranchEquationProduct t) (hBranchProducts t)
  have hPresentBranchIdeals (t : Jinitial) :
      ((s2c_branchIdeal Z B h γ (branchPoints t)).comap uBranch.left).ideal
        ⟨⊤, isAffineOpen_top _⟩ = Ideal.span {cBranch (MvPolynomial.X (κinitial t))} := by
    rw [hAllBranchIdeals, hBranchSectionCoordinates]
  have hBranchBaseSquare : vLocalized ≫ γ = q' ≫ uBranch := by
    change (rV ≫ vOrdered) ≫ γ = q' ≫ (rU ≫ uOrdered)
    rw [Category.assoc, hqOrderedSquare, ← Category.assoc, hsquare', Category.assoc]
  have hLocalizedPoint : Point.map vLocalized p' = xOrdered := by
    change (p' ≫ rV) ≫ vOrdered = xOrdered
    rw [show p' ≫ rV = pOrdered from hp']
    exact hpOrdered
  have hBranchBasePoint : Point.map uBranch (Point.map q' p') = xInitial := by
    calc
      Point.map uBranch (Point.map q' p') = Point.map γ (Point.map vLocalized p') := by
        change (p' ≫ q') ≫ uBranch = (p' ≫ vLocalized) ≫ γ
        rw [Category.assoc, ← hBranchBaseSquare, ← Category.assoc]
      _ = xInitial := by rw [hLocalizedPoint]
  have hOrderedBasePoint : Point.map uOrdered (Point.map qOrdered pOrdered) = xInitial := by
    change (pOrdered ≫ qOrdered) ≫ uOrdered = xInitial
    rw [Category.assoc, ← hqOrderedSquare, ← Category.assoc]
    change Point.map γ (Point.map vOrdered pOrdered) = xInitial
    rw [hpOrdered]
  have hInitialBranchSupport (t : T) :
      xInitial.underlying ∈ (s2c_branchIdeal Z B h γ (branchPoints t)).support ↔
        t ∈ Jinitial := by
    have H := s2v_i2a_principal_pullback_support_evaluation UOrdered B uOrdered
      (s2c_branchIdeal Z B h γ (branchPoints t)) (branchEquation t)
      (hInitialBranchEquation t) (Point.map qOrdered pOrdered)
    rw [hOrderedBasePoint] at H
    rw [H, s2v_i2a_actual_branch_evaluation_zero_iff UOrdered VOrdered qOrdered pOrdered
      (h + 1) orderedRoot (branchValues t) (branchEquation t) (hBranchEquationProduct t)]
    simp only [Jinitial, Finset.mem_filter, Finset.mem_univ, true_and]
    apply exists_congr
    intro j
    rw [hOrderedEvaluation]
    exact eq_comm.trans (hBranchTupleValues t j)
  have hAbsentBranchEvaluation (t : T) (ht : t ∉ Jinitial) :
      Point.evaluate ⊤ (rU.left.appTop.hom (branchEquation t)) (Point.map q' p') ≠ 0 := by
    intro hz
    have H := s2v_i2a_principal_pullback_support_evaluation U' B uBranch
      (s2c_branchIdeal Z B h γ (branchPoints t))
      (rU.left.appTop.hom (branchEquation t)) (hAllBranchIdeals t) (Point.map q' p')
    rw [hBranchBasePoint] at H
    exact ht ((hInitialBranchSupport t).mp (H.mpr hz))
  obtain ⟨Ubranch, hUbranch, rBranch, pBranch, hrBranch, hpBranch, hAbsentBranchUnits⟩ :=
    s2v_i2a_absent_branch_unit_neighborhood U' (Point.map q' p') Jinitial
      (fun t => rU.left.appTop.hom (branchEquation t)) hAbsentBranchEvaluation
  letI : IsAffine Ubranch.left := hUbranch
  letI : IsOpenImmersion rBranch.left := hrBranch
  letI : IsOpenImmersion uOrdered.left := inferInstanceAs (IsOpenImmersion Oinitial.1.ι)
  letI : IsOpenImmersion uBranch.left :=
    inferInstanceAs (IsOpenImmersion (rU.left ≫ uOrdered.left))
  letI : Algebra ℂ Γ(Ubranch.left, ⊤) := overSpecAlgebra Ubranch ⊤
  let uChart : Ubranch ⟶ B := rBranch ≫ uBranch
  let cChart := (s2t_overSectionsAlgHom rBranch).comp cBranch
  let zChart (t : T) : Γ(Ubranch.left, ⊤) :=
    if ht : t ∈ Jinitial then cChart (MvPolynomial.X (κinitial ⟨t, ht⟩)) else 1
  have hcChart : cChart.toRingHom.Etale := by
    change (rBranch.left.appTop.hom.comp cBranch.toRingHom).Etale
    exact RingHom.Etale.stableUnderComposition cBranch.toRingHom rBranch.left.appTop.hom
      hcBranchEt (HasRingHomProperty.appTop (P := @Etale) rBranch.left inferInstance)
  have hChartPoint : Point.map uChart pBranch = xInitial := by
    change (pBranch ≫ rBranch) ≫ uBranch = xInitial
    rw [show pBranch ≫ rBranch = Point.map q' p' from hpBranch]
    exact hBranchBasePoint
  refine ⟨Ubranch, hUbranch, uChart, pBranch, cChart, Jinitial, κinitial, zChart,
    inferInstanceAs (IsOpenImmersion (rBranch.left ≫ uBranch.left)), hChartPoint,
    hcChart, (fun t => (hInitialBranchSupport t).symm), ?_, ?_, ?_⟩
  · intro t
    simp only [zChart, dif_pos t.property]
  · intro t ht
    simp only [zChart, dif_neg ht]
  · intro t
    have H := s2v_l1a_curve_point_equation_pullback uBranch.left rBranch.left
      (s2c_branchIdeal Z B h γ (branchPoints t))
      (rU.left.appTop.hom (branchEquation t)) (hAllBranchIdeals t)
    change ((s2c_branchIdeal Z B h γ (branchPoints t)).comap
      (rBranch.left ≫ uBranch.left)).ideal ⟨⊤, isAffineOpen_top _⟩ = Ideal.span {zChart t}
    by_cases ht : t ∈ Jinitial
    · rw [hBranchSectionCoordinates ⟨t, ht⟩] at H
      simp only [zChart, dif_pos ht]
      change _ = Ideal.span {rBranch.left.appTop.hom (cBranch (MvPolynomial.X (κinitial ⟨t, ht⟩)))}
      exact H
    · rw [Ideal.span_singleton_eq_top.mpr (hAbsentBranchUnits t ht)] at H
      simpa only [zChart, dif_neg ht, Ideal.span_singleton_one] using H

end HodgeLean.Foundations.Program
