import Mathlib.Analysis.Complex.Polynomial.Basic
import Mathlib.FieldTheory.IsAlgClosed.AlgebraicClosure
import HodgeLean.Foundations.Program.SchoenTowerI2aEvaluationExtensions
import HodgeLean.Foundations.Program.SchoenTowerI2aMonomialParameters

/-! # Integral root choices for monomial charts
HC no distance; AV milestone no distance.
-/
noncomputable section
set_option maxHeartbeats 400000
open scoped BigOperators
namespace HodgeLean.Foundations.Program

/-- Roots of the parameters can be chosen with a compatible integral root of the coefficient and the specified monomial generator.
Source: Mathlib, IsAlgClosed.exists_pow_nat_eq, IsIntegral.of_pow and Finset.prod_pow. -/
theorem s2v_i2a_monomial_root_choices
    {R L : Type*} [CommRing R] [Field L] [IsAlgClosed L] [Algebra R L]
    (n m : ℕ) (hm : 0 < m) (z : Fin n → R)
    (hz : ∀ j, algebraMap R L (z j) ≠ 0)
    (α : Fin n → ℕ) (ε : R) (v : L)
    (hv : v ^ m = algebraMap R L ε * ∏ j, (algebraMap R L (z j)) ^ α j) :
    ∃ (w : Fin n → L) (u : L),
      (∀ j, w j ^ m = algebraMap R L (z j)) ∧
      u ^ m = algebraMap R L ε ∧ v = u * ∏ j, w j ^ α j ∧
      (∀ j, IsIntegral R (w j)) ∧ IsIntegral R u := by
  choose w hw using fun j => IsAlgClosed.exists_pow_nat_eq (algebraMap R L (z j)) hm
  have hwnz (j : Fin n) : w j ≠ 0 := by
    intro H
    exact hz j (by rw [← hw j, H, zero_pow hm.ne'])
  let W := ∏ j, w j ^ α j
  have hWnz : W ≠ 0 := Finset.prod_ne_zero_iff.mpr fun j _ => pow_ne_zero _ (hwnz j)
  have hW : W ^ m = ∏ j, (algebraMap R L (z j)) ^ α j := by
    change (∏ j, w j ^ α j) ^ m = _
    rw [← Finset.prod_pow]
    apply Finset.prod_congr rfl
    intro j _
    rw [← pow_mul, Nat.mul_comm (α j) m, pow_mul, hw j]
  let u := v / W
  have hu : u ^ m = algebraMap R L ε := by
    change (v / W) ^ m = _
    rw [div_pow, hv, hW]
    apply mul_div_cancel_right₀
    rw [← hW]
    exact pow_ne_zero m hWnz
  refine ⟨w, u, hw, hu, ?_, ?_, s2v_i2a_binomial_integral m hm ε u hu⟩
  · exact (div_mul_cancel₀ v hWnz).symm
  · intro j
    exact s2v_i2a_binomial_integral m hm (z j) (w j) (hw j)

/-- The specified chart and its evaluation have compatible integral roots in an algebraic closure of the original field.
Source: Mathlib, AlgebraicClosure.isAlgClosed and Ideal.exists_ideal_over_maximal_of_isIntegral. -/
theorem s2v_i2a_etale_integral_root_choices
    (n m : ℕ) (hm : 0 < m)
    (R K : Type*) [CommRing R] [IsDomain R] [Field K]
    [Algebra ℂ R] [Algebra R K] [Algebra ℂ K] [IsScalarTower ℂ R K]
    (c : MvPolynomial (Fin n) ℂ →ₐ[ℂ] R) (hc : c.toRingHom.Etale)
    (hinj : Function.Injective (algebraMap R K))
    (α : Fin n → ℕ) (ε : R) (v : K)
    (hv : v ^ m = algebraMap R K ε * ∏ j, (algebraMap R K (c (MvPolynomial.X j))) ^ α j)
    (p : integralClosure R K →ₐ[ℂ] ℂ) :
    ∃ (w : Fin n → AlgebraicClosure K) (u : AlgebraicClosure K)
      (hwint : ∀ j, IsIntegral R (w j)) (huint : IsIntegral R u)
      (pL : integralClosure R (AlgebraicClosure K) →ₐ[ℂ] ℂ),
      (∀ j, w j ^ m = algebraMap R (AlgebraicClosure K) (c (MvPolynomial.X j))) ∧
      u ^ m = algebraMap R (AlgebraicClosure K) ε ∧
      algebraMap K (AlgebraicClosure K) v = u * ∏ j, w j ^ α j ∧
      ∀ b, pL ((IsScalarTower.toAlgHom R K (AlgebraicClosure K)).mapIntegralClosure b) = p b := by
  let L := AlgebraicClosure K
  let f : K →ₐ[R] L := IsScalarTower.toAlgHom R K L
  obtain ⟨pL, hpL⟩ := s2v_i2a_evaluation_extends_integralClosure f p
  have hinjL : Function.Injective (algebraMap R L) := by
    rw [IsScalarTower.algebraMap_eq R K L]
    exact (algebraMap K L).injective.comp hinj
  have hcI := s2v_i2a_etale_parameter_injective n c hc
  have hz (j : Fin n) : algebraMap R L (c (MvPolynomial.X j)) ≠ 0 := by
    intro H
    apply MvPolynomial.X_ne_zero (R := ℂ) j
    apply hcI
    apply hinjL
    rw [H, map_zero, map_zero]
  have hvL : algebraMap K L v ^ m = algebraMap R L ε *
      ∏ j, (algebraMap R L (c (MvPolynomial.X j))) ^ α j := by
    simpa only [map_pow, map_mul, map_prod, ← IsScalarTower.algebraMap_apply R K L]
      using congrArg (algebraMap K L) hv
  obtain ⟨w, u, hw, hu, heq, hwint, huint⟩ :=
    s2v_i2a_monomial_root_choices n m hm (fun j => c (MvPolynomial.X j)) hz α ε
      (algebraMap K L v) hvL
  exact ⟨w, u, hwint, huint, pL, hw, hu, heq, hpL⟩

/-- The actual algebra generated by the chosen integral roots is integral over the original coefficient ring.
Source: Mathlib, Algebra.adjoin_le and Subalgebra.isIntegral_iff. -/
theorem s2v_i2a_root_adjoin_integral
    {R L ι : Type*} [CommRing R] [CommRing L] [Algebra R L]
    (w : ι → L) (u : L) (hw : ∀ i, IsIntegral R (w i)) (hu : IsIntegral R u) :
    Algebra.IsIntegral R (Algebra.adjoin R (Set.range w ∪ {u})) := by
  have hle : Algebra.adjoin R (Set.range w ∪ {u}) ≤ integralClosure R L :=
    Algebra.adjoin_le (by
      intro x hx
      rcases hx with ⟨i, rfl⟩ | hx
      · exact hw i
      · have hxu : x = u := Set.mem_singleton_iff.mp hx
        rw [hxu]
        exact hu)
  apply (Subalgebra.isIntegral_iff _).mpr
  intro x hx
  exact hle hx

/-- The extended integral-closure evaluation restricts to the actual root algebra with its specified root values.
Source: Mathlib, Subalgebra.inclusion and AlgHom.restrictScalars. -/
theorem s2v_i2a_root_adjoin_evaluation
    {C R L ι : Type*} [CommRing C] [CommRing R] [CommRing L]
    [Algebra C R] [Algebra R L] [Algebra C L] [IsScalarTower C R L]
    (w : ι → L) (u : L) (hw : ∀ i, IsIntegral R (w i)) (hu : IsIntegral R u)
    (p : integralClosure R L →ₐ[C] C) :
    ∃ q : Algebra.adjoin R (Set.range w ∪ {u}) →ₐ[C] C,
      (∀ i, q ⟨w i, Algebra.subset_adjoin (Or.inl ⟨i, rfl⟩)⟩ = p ⟨w i, hw i⟩) ∧
      q ⟨u, Algebra.subset_adjoin (Or.inr rfl)⟩ = p ⟨u, hu⟩ := by
  let A := Algebra.adjoin R (Set.range w ∪ {u})
  have hint : Algebra.IsIntegral R A := s2v_i2a_root_adjoin_integral w u hw hu
  have hle : A ≤ integralClosure R L := fun x hx => (Subalgebra.isIntegral_iff A).mp hint x hx
  let β : A →ₐ[C] integralClosure R L := (Subalgebra.inclusion hle).restrictScalars C
  exact ⟨p.comp β, fun _ => rfl, rfl⟩

end HodgeLean.Foundations.Program
