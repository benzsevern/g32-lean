import HodgeLean.Foundations.AlgebraicGeometry.RegularPairChart
import HodgeLean.Foundations.Program.SchoenTowerI2bBlowupChartRegular
import Mathlib.RingTheory.MvPolynomial.Ideal
import Mathlib.RingTheory.Regular.Flat
import Mathlib.RingTheory.RingHom.Etale

/-! Regularity of independent branch coordinates.
HC no distance; AV milestone no distance. -/
noncomputable section
set_option maxHeartbeats 400000
open MvPolynomial
namespace HodgeLean.Foundations.Program

/-- An unused coordinate preserves membership in the ideal of selected coordinates.
Source: the monomial support criterion for ideals generated by variables. -/
theorem s2v_i2b_coordinate_ideal_saturated
    {κ R : Type*} [CommRing R] (J : Set κ) (i : κ) (hi : i ∉ J)
    (p : MvPolynomial κ R)
    (hp : X i * p ∈ Ideal.span (X '' J : Set (MvPolynomial κ R))) :
    p ∈ Ideal.span (X '' J : Set (MvPolynomial κ R)) := by
  exact AlgebraicGeometry.RegularPairChart.coordinate_ideal_saturated J i hi p hp

/-- Any ordered list of distinct variables is a weakly regular sequence.
Source: saturation of coordinate ideals and the quotient definition of regular sequences. -/
theorem s2v_i2b_coordinate_list_weakly_regular
    {κ R : Type*} [CommRing R] (l : List κ) (hl : l.Nodup) :
    RingTheory.Sequence.IsWeaklyRegular (MvPolynomial κ R) (l.map (X : κ → MvPolynomial κ R)) := by
  exact AlgebraicGeometry.RegularPairChart.coordinate_list_weakly_regular l hl

/-- Flat coordinate charts preserve the weak regularity of distinct branch variables.
Source: flat base change for weakly regular sequences. -/
theorem s2v_i2b_flat_coordinate_list_weakly_regular
    {κ R A : Type*} [CommRing R] [CommRing A]
    [Algebra (MvPolynomial κ R) A] [Module.Flat (MvPolynomial κ R) A]
    (l : List κ) (hl : l.Nodup) :
    RingTheory.Sequence.IsWeaklyRegular A
      (l.map (fun i => algebraMap (MvPolynomial κ R) A (X i))) := by
  exact (AlgebraicGeometry.RegularPairChart.coordinateSequence_of_flat (R := R) (A := A) l hl).2

/-- Each next element of a weakly regular sequence saturates its preceding ideal.
Source: the quotient criterion for regular scalar multiplication. -/
theorem s2v_i2b_weakly_regular_prefix_saturated
    {R : Type*} [CommRing R] (l : List R)
    (hl : RingTheory.Sequence.IsWeaklyRegular R l) (n : ℕ) (hn : n < l.length) :
    ∀ a : R, l[n] * a ∈ Ideal.ofList (l.take n) → a ∈ Ideal.ofList (l.take n) := by
  have h := hl.regular_mod_prev n hn
  rw [Ideal.smul_eq_mul, Ideal.mul_top] at h
  exact (isSMulRegular_quotient_iff_mem_of_smul_mem _ _).mp h

/-- An etale polynomial coordinate map carries distinct variables to a weakly regular sequence.
Source: flatness of etale ring maps and flat transport of coordinate sequences. -/
theorem s2v_i2b_etale_coordinate_list_weakly_regular
    {κ R A : Type*} [CommRing R] [CommRing A]
    (c : MvPolynomial κ R →+* A) (hc : c.Etale)
    (l : List κ) (hl : l.Nodup) :
    RingTheory.Sequence.IsWeaklyRegular A (l.map (fun i => c (X i))) := by
  letI : Algebra (MvPolynomial κ R) A := c.toAlgebra
  haveI : Module.Flat (MvPolynomial κ R) A :=
    (RingHom.Etale.iff_flat_and_formallyUnramified.mp hc).1
  exact s2v_i2b_flat_coordinate_list_weakly_regular (R := R) (A := A) l hl

end HodgeLean.Foundations.Program
