import HodgeLean.Foundations.Program.SchoenTowerL1aFlatDivisibility
import Mathlib.RingTheory.Flat.TorsionFree
import Mathlib.Algebra.MvPolynomial.Division
import Mathlib.RingTheory.Ideal.Maps
import Mathlib.Algebra.BigOperators.GroupWithZero.Action

/-! # Insertion equations after flat ordered parameter extension

Implication from a flat ordered parameter map and its invariant-image quotient
to the principal contracted coordinate ideal, retaining multiplicities.
HC no distance; AV milestone no distance.
-/

noncomputable section
set_option maxHeartbeats 400000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
open scoped BigOperators
namespace HodgeLean.Foundations.Program

/-- In a flat ordered parameter algebra, the contraction of one coordinate
ideal to the invariant quotient is generated by the descended product.
Source: Schoen (1988), Lemma 2.2, printed p. 13; Atiyah–Macdonald, Introduction to Commutative Algebra, Chapter 2. -/
theorem s2v_l1a_flat_insertion_contraction
    {K B D : Type*} [Field K] [CommRing B] [CommRing D] [Algebra K B]
    (n : ℕ) [MulSemiringAction (Equiv.Perm (Fin n)) B]
    (z : Fin n → B) (hz : ∀ g : Equiv.Perm (Fin n), ∀ i, g • z i = z (g i))
    (hflat : letI := (MvPolynomial.aeval (R := K) z).toRingHom.toAlgebra
      Module.Flat (MvPolynomial (Fin n) K) B)
    (q : D →+* B) (hq : Function.Injective q)
    (himage : ∀ b : B, b ∈ Set.range q ↔ ∀ g : Equiv.Perm (Fin n), g • b = b)
    (c : D) (hc : q c = ∏ i, z i) (i₀ : Fin n) :
    (Ideal.span {z i₀}).comap q = Ideal.span {c} := by
  classical
  let P := MvPolynomial (Fin n) K
  letI : Algebra P B := (MvPolynomial.aeval (R := K) z).toRingHom.toAlgebra
  letI : Module.Flat P B := hflat
  let N : B := ∏ i, z i
  have hNmap : algebraMap P B (∏ i : Fin n, (MvPolynomial.X i : P)) = N := by
    rw [map_prod]
    apply Finset.prod_congr rfl
    intro i _
    exact MvPolynomial.aeval_X z i
  have hreg : Function.Injective (fun b : B => N * b) := by
    have hsource : IsRegular (∏ i : Fin n, (MvPolynomial.X i : P)) :=
      IsRegular.of_ne_zero (Finset.prod_ne_zero_iff.mpr
        (fun i _ => MvPolynomial.X_ne_zero (R := K) i))
    have H := Module.Flat.isSMulRegular_of_isRegular (R := P) (M := B) hsource
    simpa only [IsSMulRegular, Algebra.smul_def, hNmap] using H
  have hNfix (g : Equiv.Perm (Fin n)) : g • N = N := by
    change g • ∏ i, z i = ∏ i, z i
    rw [Finset.smul_prod']
    simp_rw [hz]
    exact Equiv.prod_comp g z
  apply le_antisymm
  · intro r hr
    have hi : z i₀ ∣ q r := Ideal.mem_span_singleton.mp hr
    have hrfix (g : Equiv.Perm (Fin n)) : g • q r = q r :=
      (himage (q r)).mp ⟨r, rfl⟩ g
    have hall (i : Fin n) : algebraMap P B (MvPolynomial.X i) ∣ q r := by
      rw [show algebraMap P B (MvPolynomial.X i) = z i from MvPolynomial.aeval_X z i]
      have H := map_dvd (MulSemiringAction.toRingHom (Equiv.Perm (Fin n)) B
        (Equiv.swap i₀ i)) hi
      simpa only [MulSemiringAction.toRingHom_apply, hz, Equiv.swap_apply_left, hrfix] using H
    have hrel : Pairwise (fun i j : Fin n => IsRelPrime
        (MvPolynomial.X i : P) (MvPolynomial.X j)) := by
      intro i j hij
      apply (MvPolynomial.X_prime (R := K) (i := i)).irreducible.isRelPrime_iff_not_dvd.mpr
      simpa only [MvPolynomial.X_dvd_X] using hij
    have hdiv := s2v_l1a_flat_pairwise_product_divisibility (R := P) (B := B)
      (fun i : Fin n => MvPolynomial.X i) hrel Finset.univ (q r) (fun i _ => hall i)
    rw [hNmap] at hdiv
    obtain ⟨s, hs⟩ := hdiv
    have hsfix (g : Equiv.Perm (Fin n)) : g • s = s := by
      apply hreg
      have H := congrArg (MulSemiringAction.toRingHom (Equiv.Perm (Fin n)) B g) hs
      change g • q r = g • (N * s) at H
      rw [smul_mul', hrfix, hNfix] at H
      exact H.symm.trans hs
    obtain ⟨t, ht⟩ := (himage s).mpr hsfix
    apply Ideal.mem_span_singleton.mpr
    refine ⟨t, hq ?_⟩
    rw [map_mul, hc, ht]
    exact hs
  · apply Ideal.span_le.mpr
    intro d hd
    have hdc : d = c := Set.mem_singleton_iff.mp hd
    subst d
    change q c ∈ Ideal.span {z i₀}
    rw [hc]
    apply Ideal.mem_span_singleton.mpr
    exact Finset.dvd_prod_of_mem z (Finset.mem_univ i₀)

end HodgeLean.Foundations.Program
