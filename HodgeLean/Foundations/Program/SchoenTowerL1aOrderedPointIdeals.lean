import HodgeLean.Foundations.Program.SchoenTowerL1aOrderedParameterEtale
import HodgeLean.Foundations.Program.SchoenTowerL1aIdealPullback

/-! # Actual coordinate point ideals on ordered charts

Implication from the curve point equation to the coordinate point equations
on its actual retained ordered power, with the original curve maps.
HC no distance; AV milestone no distance.
-/

noncomputable section
set_option maxHeartbeats 400000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
open CategoryTheory AlgebraicGeometry
open HodgeLean.Adapters
namespace HodgeLean.Foundations.Program

/-- A principal point equation on an affine curve chart pulls back to the
actual principal ideal on every affine scheme mapping into that chart.
Source: Hartshorne, Algebraic Geometry, II.5–6, pullback of local divisor equations. -/
theorem s2v_l1a_curve_point_equation_pullback
    {U V Z : Scheme} [IsAffine U] [IsAffine V]
    (u : U ⟶ Z) (a : V ⟶ U) (I : Z.IdealSheafData) (z : Γ(U, ⊤))
    (hz : (I.comap u).ideal ⟨⊤, isAffineOpen_top _⟩ = Ideal.span {z}) :
    (I.comap (a ≫ u)).ideal ⟨⊤, isAffineOpen_top _⟩ =
      Ideal.span {a.appTop.hom z} := by
  rw [Scheme.IdealSheafData.comap_comp, s2v_l1a_affine_ideal_pullback, hz,
    Ideal.map_span, Set.image_singleton]

/-- The actual coordinate point ideals on the retained ordered curve chart
are generated by the coordinatewise pullbacks of its curve parameter.
Source: Schoen (1988), Lemma 2.2, printed p. 13; Hartshorne, Algebraic Geometry, II.6. -/
theorem s2v_l1a_ordered_point_ideals
    (U Z : Over (Spec ↧ℂ)) [IsAffine U.left] (u : U ⟶ Z)
    (b : ComplexPoint Z) (z : Γ(U.left, ⊤))
    (hz : (b.left.ker.comap u.left).ideal ⟨⊤, isAffineOpen_top _⟩ = Ideal.span {z})
    (n : ℕ) (j : Fin n) :
    letI : IsAffine (g3_power U n).left := s2v_l1a_ordered_power_affine U n
    (b.left.ker.comap ((s2_powerMap u n ≫ g3_proj Z n j).left)).ideal
        ⟨⊤, isAffineOpen_top _⟩ =
      Ideal.span {(g3_proj U n j).left.appTop.hom z} := by
  letI : IsAffine (g3_power U n).left := s2v_l1a_ordered_power_affine U n
  have hproj : s2_powerMap u n ≫ g3_proj Z n j = g3_proj U n j ≫ u :=
    s2_check_lift_proj n _ j
  rw [hproj]
  exact s2v_l1a_curve_point_equation_pullback u.left (g3_proj U n j).left b.left.ker z hz

end HodgeLean.Foundations.Program
