        (∀ f, φ (ρ f) = ρ f) ∧
        Spec.map (CommRingCat.ofHom φ) ≫
          W₀.left.fromSpecStalk (genericPoint W₀.left) =
          W₀.left.fromSpecStalk (genericPoint W₀.left) ≫ d₀.left ∧
        Spec.map (CommRingCat.ofHom φ) ≫ (η i.castSucc).toNormalization =
