import HodgeLean.Foundations.Program.SchoenTowerL1bSimultaneousPointEquations
import HodgeLean.Foundations.Program.SchoenTowerL1aAffinePointEquation

/-! # Simultaneous equations for actual affine curve points

The equations describe ideal sheaves on one actual principal neighborhood.
HC no distance; AV milestone no distance.
-/

noncomputable section
set_option maxHeartbeats 400000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency false
open CategoryTheory AlgebraicGeometry AlgebraicGeometry.ComplexPoint
namespace HodgeLean.Foundations.Program
attribute [local instance] overSpecAlgebra

/-- All points separated by one etale parameter have their actual point ideals
generated by its translated values on one principal neighborhood retaining them. -/
theorem s2v_l1b_affine_point_equations
    (X : Over (Spec ↧ℂ)) [IsAffine X.left] [LocallyOfFiniteType X.hom]
    {ι : Type} [Fintype ι] (p : ι → ComplexPoint X) (hp : Function.Injective p)
    (g : Γ(X.left, ⊤)) (hEt : (Polynomial.aeval (R := ℂ) g).toRingHom.Etale)
    (hsep : Function.Injective (fun i => Point.evaluate ⊤ g (p i))) :
    ∃ d : Γ(X.left, ⊤), (∀ i, Point.evaluate ⊤ d (p i) = 1) ∧
      let O := X.left.basicOpen d
      letI : IsAffine O.toScheme := (isAffineOpen_top X.left).basicOpen d
      ∀ i, (((p i).left.ker).comap O.ι).ideal ⟨⊤, isAffineOpen_top _⟩ =
        Ideal.span {O.ι.appTop.hom (g - algebraMap ℂ Γ(X.left, ⊤)
          (Point.evaluate ⊤ g (p i)))} := by
  let A := Γ(X.left, ⊤)
  letI : Algebra.FiniteType ℂ A := s2t_globalSections_finiteType X
  let φ (i : ι) := s2t_affinePointAlgHom X (p i)
  have hinj : Function.Injective φ := (s2t_affinePointAlgHom_injective X).comp hp
  have hφ (i : ι) (s : A) : φ i s = Point.evaluate ⊤ s (p i) :=
    s2t_affinePointAlgHom_apply X (p i) s
  obtain ⟨d, hd, hI⟩ := s2v_l1b_separating_parameter_point_equations φ hinj g hEt
    (by simpa only [hφ] using hsep)
  refine ⟨d, ?_, ?_⟩
  · intro i
    rw [← hφ]
    exact hd i
  · let O := X.left.basicOpen d
    let B := Γ(O.toScheme, ⊤)
    letI : IsAffine O.toScheme := (isAffineOpen_top X.left).basicOpen d
    letI : Algebra A B := O.ι.appTop.hom.toAlgebra
    letI : IsLocalization.Away d B := s2v_l1a_openScheme_sections_localization X.left d
    let e : Localization.Away d ≃ₐ[A] B :=
      IsLocalization.algEquiv (Submonoid.powers d) (Localization.Away d) B
    have heq : O.ι.appTop.hom = e.toRingHom.comp (algebraMap A (Localization.Away d)) := by
      ext a
      exact (e.commutes a).symm
    change ∀ i : ι, (((p i).left.ker).comap O.ι).ideal ⟨⊤, isAffineOpen_top _⟩ =
      Ideal.span {O.ι.appTop.hom (g - algebraMap ℂ A (Point.evaluate ⊤ g (p i)))}
    intro i
    have hker : RingHom.ker (φ i).toRingHom =
        (p i).left.ker.ideal ⟨⊤, isAffineOpen_top _⟩ := by
      rw [← s2v_l1a_pointSectionEvaluation_kernel]
      congr 1
      ext s
      rw [s2v_l1a_pointSectionEvaluation_apply]
      exact hφ i s
    change (((p i).left.ker).comap O.ι).ideal ⟨⊤, isAffineOpen_top _⟩ = _
    rw [s2v_l1a_affine_ideal_pullback, ← hker, heq, ← Ideal.map_map, hI,
      Ideal.map_span, Set.image_singleton, hφ]
    rfl

end HodgeLean.Foundations.Program
