import HodgeLean.Foundations.Program.SchoenTowerL1bTranslatedParameters
import Mathlib.Algebra.Polynomial.GroupRingAction
import Mathlib.Algebra.Polynomial.Lifts

/-! # One descended polynomial for every branch value

The ordered parameters give one polynomial over the invariant section ring.
HC no distance; AV milestone no distance.
-/

noncomputable section
namespace HodgeLean.Foundations.Program
universe u

/-- The product polynomial descends coefficient by coefficient through the invariant section map. -/
theorem s2v_l1b_branch_polynomial_descent
    {B D : Type*} [CommRing B] [CommRing D] (n : ℕ)
    [MulSemiringAction (Equiv.Perm (Fin n)) B]
    (z : Fin n → B)
    (hz : ∀ g : Equiv.Perm (Fin n), ∀ i, g • z i = z (g i))
    (q : D →+* B) (hq : Function.Injective q)
    (himage : ∀ b : B, b ∈ Set.range q ↔ ∀ g : Equiv.Perm (Fin n), g • b = b) :
    ∃! P : Polynomial D, P.map q = ∏ i, (Polynomial.C (z i) - Polynomial.X) := by
  classical
  let Q : Polynomial B := ∏ i, (Polynomial.C (z i) - Polynomial.X)
  have hfix (g : Equiv.Perm (Fin n)) : g • Q = Q := by
    simp only [Q, Finset.smul_prod', smul_sub, Polynomial.smul_C, Polynomial.smul_X, hz]
    exact Equiv.prod_comp g (fun i => Polynomial.C (z i) - Polynomial.X)
  have hlift : Q ∈ Polynomial.lifts q := by
    rw [Polynomial.lifts_iff_coeff_lifts]
    intro k
    apply (himage _).mpr
    intro g
    have H := congrArg (fun P : Polynomial B => P.coeff k) (hfix g)
    exact H
  obtain ⟨P, hP⟩ := (Polynomial.mem_lifts (f := q) Q).mp hlift
  refine ⟨P, hP, ?_⟩
  intro P' hP'
  exact Polynomial.map_injective q hq (hP'.trans hP.symm)

/-- Evaluation of the descended polynomial gives the ordered branch product exactly. -/
theorem s2v_l1b_branch_polynomial_eval
    {B D : Type*} [CommRing B] [CommRing D] (n : ℕ)
    (z : Fin n → B) (q : D →+* B) (P : Polynomial D)
    (hP : P.map q = ∏ i, (Polynomial.C (z i) - Polynomial.X)) (a : D) :
    q (P.eval a) = ∏ i, (z i - q a) := by
  rw [← Polynomial.eval_map_apply, hP]
  simp only [Polynomial.eval_prod, Polynomial.eval_sub, Polynomial.eval_C, Polynomial.eval_X]

/-- Every branch contraction is generated by evaluation of the same descended polynomial. -/
theorem s2v_l1b_branch_polynomial_contractions
    {K B D : Type u} [Field K] [CommRing B] [CommRing D]
    [Algebra K B] [Algebra K D] (n : ℕ)
    [MulSemiringAction (Equiv.Perm (Fin n)) B]
    [SMulCommClass (Equiv.Perm (Fin n)) K B]
    (z : Fin n → B)
    (hz : ∀ g : Equiv.Perm (Fin n), ∀ i, g • z i = z (g i))
    (hEt : (MvPolynomial.aeval (R := K) z).toRingHom.Etale)
    (q : D →ₐ[K] B) (hq : Function.Injective q)
    (himage : ∀ b : B, b ∈ Set.range q ↔ ∀ g : Equiv.Perm (Fin n), g • b = b) :
    ∃ P : Polynomial D,
      P.map q.toRingHom = ∏ i, (Polynomial.C (z i) - Polynomial.X) ∧
      ∀ (a : K) (i : Fin n),
        (Ideal.span {z i - algebraMap K B a}).comap q.toRingHom =
          Ideal.span {P.eval (algebraMap K D a)} := by
  obtain ⟨P, hP, _⟩ := s2v_l1b_branch_polynomial_descent n z hz q.toRingHom hq himage
  refine ⟨P, hP, ?_⟩
  intro a i
  apply s2v_l1b_translated_insertion_contraction n z hz hEt q.toRingHom hq himage a (P.eval (algebraMap K D a)) ?_ i
  have H := s2v_l1b_branch_polynomial_eval n z q.toRingHom P hP (algebraMap K D a)
  simpa only [AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom, q.commutes] using H

end HodgeLean.Foundations.Program
