import HodgeLean.Foundations.Program.SchoenTowerL1bLocalLifts

noncomputable section
set_option Elab.async false
set_option maxHeartbeats 400000
set_option synthInstance.maxHeartbeats 400000
namespace HodgeLean.Foundations.Program

/-- A binomial equation forces the denominator coefficient to be a unit when the two coefficients
come from a trivialized ideal generated by the two sections. -/
theorem s2v_l1b_binomial_coefficient_unit {A D : Type*} [CommRing A] [CommRing D]
    [Algebra A D] [Module.Flat A D] (I : Ideal A) (e : I ≃ₗ[A] A)
    (u v : I) (hI : I = Ideal.span {u.val, v.val}) (s : D)
    (hs : algebraMap A D u.val = s * algebraMap A D v.val) :
    IsUnit (algebraMap A D (e v)) := by
  have hcoeff : algebraMap A D (e u) = s * algebraMap A D (e v) := by
    apply (s2v_l1b_trivialization_generator_flat I e).right
    change algebraMap A D (e u) * _ = (s * algebraMap A D (e v)) * _
    rw [mul_assoc, ← map_mul, ← map_mul,
      ← (s2v_l1b_trivialization_generator I e).2 u,
      ← (s2v_l1b_trivialization_generator I e).2 v]
    exact hs
  have hspan := s2v_l1b_invertible_ideal_coefficients I u.val v.val u.property v.property hI e
  obtain ⟨a, b, hab⟩ := Ideal.mem_span_pair.mp
    (show (1 : A) ∈ Ideal.span {e u, e v} from hspan ▸ trivial)
  have habD := congrArg (algebraMap A D) hab
  rw [map_add, map_mul, map_mul, map_one, hcoeff, ← mul_assoc, ← add_mul] at habD
  exact IsUnit.of_mul_eq_one_right _ habD

/-- Every affine chart lift over a flat source forces its denominator coefficient to be a unit. -/
theorem s2v_l1b_chart_map_coefficient_unit {R A D : Type*}
    [CommRing R] [CommRing A] [CommRing D] [Algebra A D] [Module.Flat A D]
    (u v : R) (f : R →+* A) (I : Ideal A)
    (hu : f u ∈ I) (hv : f v ∈ I) (hI : I = Ideal.span {f u, f v})
    (e : I ≃ₗ[A] A) (φ : s2v_L1bChart u v →+* D)
    (hφ : φ.comp
      ((Ideal.Quotient.mk (Ideal.span {Polynomial.C u - Polynomial.X * Polynomial.C v})).comp
        Polynomial.C) = (algebraMap A D).comp f) :
    IsUnit (algebraMap A D (e ⟨f v, hv⟩)) := by
  let q := Ideal.Quotient.mk (Ideal.span {Polynomial.C u - Polynomial.X * Polynomial.C v})
  apply s2v_l1b_binomial_coefficient_unit I e ⟨f u, hu⟩ ⟨f v, hv⟩ hI (φ (q Polynomial.X))
  have h := congrArg φ (s2v_l1b_chart_relation u v)
  rw [map_mul] at h
  have hC (a : R) : φ (q (Polynomial.C a)) = algebraMap A D (f a) :=
    DFunLike.congr_fun hφ a
  rw [hC, hC] at h
  exact h

end HodgeLean.Foundations.Program
