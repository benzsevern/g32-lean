import HodgeLean.Foundations.AlgebraicGeometry.RegularPairChart
import HodgeLean.Foundations.Program.SchoenTowerL1bChartAlgebra
import Mathlib.Algebra.Polynomial.Coeff
import Mathlib.Algebra.Polynomial.Eval.Coeff
import Mathlib.Algebra.Regular.Basic

noncomputable section
set_option Elab.async false
set_option maxHeartbeats 400000
set_option synthInstance.maxHeartbeats 400000

namespace HodgeLean.Foundations.Program
open Polynomial

/-- Cancellation by a regular coefficient holds coefficientwise in the polynomial ring. -/
theorem s2v_l1b_polynomial_constant_regular {R : Type*} [CommRing R]
    (v : R) (hv : IsRegular v) : IsRegular (C v : R[X]) := by
  exact AlgebraicGeometry.RegularPairChart.constant_regular v hv

/-- The binomial relation is saturated with respect to the second regular parameter. -/
theorem s2v_l1b_chart_relation_saturated {R : Type*} [CommRing R]
    (u v : R) (hv : IsRegular v)
    (hu : IsRegular (Ideal.Quotient.mk (Ideal.span {v}) u))
    (p : R[X]) (hp : C u - X * C v ∣ C v * p) :
    C u - X * C v ∣ p := by
  exact AlgebraicGeometry.RegularPairChart.relation_saturated u v hv hu p hp

/-- A regular pair gives a regular denominator in its binomial chart ring. -/
theorem s2v_l1b_chart_denominator_regular {R : Type*} [CommRing R]
    (u v : R) (hv : IsRegular v)
    (hu : IsRegular (Ideal.Quotient.mk (Ideal.span {v}) u)) :
    IsRegular (Ideal.Quotient.mk (Ideal.span {C u - X * C v}) (C v)) := by
  exact AlgebraicGeometry.RegularPairChart.denominator_regular u v hv hu

/-- A principal ideal generated by a regular element has a module trivialization. -/
theorem s2v_l1b_regular_principal_trivialization {A : Type*} [CommRing A]
    (v : A) (hv : IsRegular v) :
    ∃ e : (Ideal.span {v}) ≃ₗ[A] A,
      e ⟨v, Ideal.subset_span (Set.mem_singleton _)⟩ = 1 := by
  let f : A →ₗ[A] (Ideal.span {v}) :=
    { toFun := fun a => ⟨a * v, Ideal.mem_span_singleton'.mpr ⟨a, rfl⟩⟩
      map_add' := fun a b => Subtype.ext (add_mul a b v)
      map_smul' := fun a b => Subtype.ext (mul_assoc a b v) }
  have hf : Function.Bijective f := by
    constructor
    · intro a b hab
      exact hv.right (congrArg Subtype.val hab)
    · intro a
      obtain ⟨b, hb⟩ := Ideal.mem_span_singleton'.mp a.property
      exact ⟨b, Subtype.ext hb⟩
  let e := LinearEquiv.ofBijective f hf
  refine ⟨e.symm, ?_⟩
  apply e.injective
  rw [e.apply_symm_apply]
  apply Subtype.ext
  exact (one_mul v).symm

/-- The selected centre ideal is a free rank one module on the regular binomial chart. -/
theorem s2v_l1b_chart_centre_trivialization {R : Type*} [CommRing R]
    (u v : R) (hv : IsRegular v)
    (hu : IsRegular (Ideal.Quotient.mk (Ideal.span {v}) u)) :
    let q := Ideal.Quotient.mk (Ideal.span {C u - X * C v})
    Nonempty ((Ideal.span {q (C u), q (C v)}) ≃ₗ[s2v_L1bChart u v]
      s2v_L1bChart u v) := by
  dsimp only
  rw [s2v_l1b_chart_centre_principal]
  obtain ⟨e, _⟩ := s2v_l1b_regular_principal_trivialization _
    (s2v_l1b_chart_denominator_regular u v hv hu)
  exact ⟨e⟩

end HodgeLean.Foundations.Program
