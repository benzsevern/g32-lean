import HodgeLean.Foundations.Program.SchoenTowerL1bDivisorPrimeParameter

noncomputable section
set_option maxHeartbeats 400000
namespace HodgeLean.Foundations.Program

/-- A local map from a DVR preserves prime parameters if one extended ideal is generated by a prime. -/
theorem s2v_l1b_divisor_dvr_prime_of_extended_ideal
    {R T : Type*} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    [CommRing T] [IsDomain T] (φ : R →+* T) [IsLocalHom φ]
    (I : Ideal R) (π : T) (hπ : Prime π) (hI : I.map φ = Ideal.span {π})
    (p : R) (hp : Prime p) : Prime (φ p) := by
  obtain ⟨c, hc⟩ := (IsPrincipalIdealRing.principal I).principal
  rw [hc, Ideal.map_span, Set.image_singleton] at hI
  have ha : Associated (φ c) π := Ideal.span_singleton_eq_span_singleton.mp hI
  have hφc : Prime (φ c) := ha.prime_iff.mpr hπ
  have hc' : Irreducible c := hφc.irreducible.of_map
  have hcp : Associated c p := IsDiscreteValuationRing.associated_of_irreducible R hc' hp.irreducible
  exact (hcp.map φ).prime_iff.mp hφc

end HodgeLean.Foundations.Program
