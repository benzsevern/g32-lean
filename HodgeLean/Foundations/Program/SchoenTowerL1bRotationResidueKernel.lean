import HodgeLean.Foundations.DiscreteValuationRing.ParameterExpansion
import HodgeLean.Foundations.Program.SchoenTowerL1bRotationLocalLinearization
import HodgeLean.Foundations.Program.SchoenTowerL1bRotationCurveExpansion
import HodgeLean.Foundations.Program.SchoenCycleCurveStalkJets
import Mathlib.RingTheory.PowerSeries.NoZeroDivisors

noncomputable section
set_option maxHeartbeats 200000
open CategoryTheory AlgebraicGeometry
namespace HodgeLean.Foundations.Program

/-- A scalar-preserving parameter expansion of a DVR identifies the actual
residue kernel with the ideal generated by that parameter. -/
theorem s2v_l1b_rotation_expansion_residue_kernel
    {R K : Type*} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    [Field K] [Algebra K R]
    (ι : R →ₐ[K] PowerSeries K) (u : R) (hu : ι u = PowerSeries.X) :
    IsLocalHom (PowerSeries.constantCoeff.comp ι.toRingHom) ∧
    RingHom.ker (PowerSeries.constantCoeff.comp ι.toRingHom) = Ideal.span {u} := by
  exact DiscreteValuationRing.ParameterExpansion.residue_kernel ι u hu

/-- The actual curve stalk expansion supplies the local residue map and its
principal kernel needed for finite-action linearization. -/
theorem s2v_l1b_rotation_curve_expansion_kernel
    (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom]
    [SmoothOfRelativeDimension 1 X.hom] [IsProjective X.hom]
    (p : ComplexPoint X) :
    let R := X.left.presheaf.stalk p.underlying
    letI : Algebra ℂ R := (HodgeLean.Foundations.Curves.stalkC p.underlying).toAlgebra
    ∃ (ι : R →ₐ[ℂ] PowerSeries ℂ) (u : R), Function.Injective ι ∧
      ι u = PowerSeries.X ∧
      IsLocalHom (PowerSeries.constantCoeff.comp ι.toRingHom) ∧
      RingHom.ker (PowerSeries.constantCoeff.comp ι.toRingHom) = Ideal.span {u} := by
  let R := X.left.presheaf.stalk p.underlying
  letI : Algebra ℂ R := (HodgeLean.Foundations.Curves.stalkC p.underlying).toAlgebra
  letI : IsDiscreteValuationRing R := s2e_smooth_curve_point_stalk_dvr X p
  obtain ⟨ι, hι, ⟨u, hu⟩, hc⟩ := s2v_l1b_rotation_curve_expansion X p
  let φ : R →ₐ[ℂ] PowerSeries ℂ :=
    { toRingHom := ι
      commutes' := hc }
  exact ⟨φ, u, hι, hu, s2v_l1b_rotation_expansion_residue_kernel φ u hu⟩

end HodgeLean.Foundations.Program
