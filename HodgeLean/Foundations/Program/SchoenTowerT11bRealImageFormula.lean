import HodgeLean.Foundations.Program.SchoenTowerT11bFiniteConnectedCharts

/-! Boolean descriptions of actual real images of finite connected realizations.
HC no distance; AV milestone no distance.
-/
noncomputable section
set_option maxHeartbeats 400000
set_option synthInstance.maxHeartbeats 400000
namespace HodgeLean.Foundations.Program

/-- The upper ray generated by any real subset has an actual Boolean polynomial description, with its endpoint retained exactly when attained.
Source: Coste, Real Algebraic Sets (2005), Theorem 1.3, real image endpoint step. -/
theorem s2v_t11b_real_lower_shadow_formula (S : Set ℝ) :
    ∃ f : s2v_t11b_Formula 1, ∀ t : ℝ,
      WithLp.toLp 2 (fun _ : Fin 1 => t) ∈ f.realize ↔ ∃ x ∈ S, x ≤ t := by
  classical
  by_cases hne : S.Nonempty
  · by_cases hb : BddBelow S
    · by_cases hm : sInf S ∈ S
      · refine ⟨.nonneg (MvPolynomial.X 0 - MvPolynomial.C (sInf S)), ?_⟩
        intro t
        change 0 ≤ MvPolynomial.eval (fun _ : Fin 1 => t) _ ↔ _
        simp only [map_sub, MvPolynomial.eval_X, MvPolynomial.eval_C, sub_nonneg]
        exact ⟨fun ht => ⟨sInf S, hm, ht⟩, fun ⟨x, hx, ht⟩ => (csInf_le hb hx).trans ht⟩
      · refine ⟨.compl (.nonneg (MvPolynomial.C (sInf S) - MvPolynomial.X 0)), ?_⟩
        intro t
        change ¬ 0 ≤ MvPolynomial.eval (fun _ : Fin 1 => t) _ ↔ _
        simp only [map_sub, MvPolynomial.eval_X, MvPolynomial.eval_C, sub_nonneg, not_le]
        constructor
        · intro ht
          obtain ⟨x, hx, hxt⟩ := exists_lt_of_csInf_lt hne ht
          exact ⟨x, hx, hxt.le⟩
        · rintro ⟨x, hx, hxt⟩
          have hix := csInf_le hb hx
          have hix' : sInf S < x := lt_of_le_of_ne hix (fun he => hm (he ▸ hx))
          exact hix'.trans_le hxt
    · refine ⟨.nonneg 0, ?_⟩
      intro t
      constructor
      · intro _
        obtain ⟨x, hx, hxt⟩ := not_bddBelow_iff.mp hb t
        exact ⟨x, hx, hxt.le⟩
      · intro _
        change 0 ≤ MvPolynomial.eval (fun _ : Fin 1 => t) 0
        simp
  · refine ⟨.compl (.nonneg 0), ?_⟩
    intro t
    constructor
    · intro ht
      have hf : ¬ (0 : ℝ) ≤ 0 := by simpa [s2v_t11b_Formula.realize] using ht
      exact (hf le_rfl).elim
    · rintro ⟨x, hx, _⟩
      exact (hne ⟨x, hx⟩).elim

/-- The lower ray generated by any real subset has a Boolean polynomial description obtained by reversing the coordinate.
Source: Coste, Real Algebraic Sets (2005), Theorem 1.3, reflected real endpoint step. -/
theorem s2v_t11b_real_upper_shadow_formula (S : Set ℝ) :
    ∃ f : s2v_t11b_Formula 1, ∀ t : ℝ,
      WithLp.toLp 2 (fun _ : Fin 1 => t) ∈ f.realize ↔ ∃ x ∈ S, t ≤ x := by
  obtain ⟨f, hf⟩ := s2v_t11b_real_lower_shadow_formula (Neg.neg '' S)
  refine ⟨f.subst (fun _ => -MvPolynomial.X 0), ?_⟩
  intro t
  rw [s2v_t11b_realize_subst]
  simp only [map_neg, MvPolynomial.eval_X]
  rw [hf]
  constructor
  · rintro ⟨y, ⟨x, hx, rfl⟩, hxt⟩
    exact ⟨x, hx, neg_le_neg_iff.mp hxt⟩
  · rintro ⟨x, hx, htx⟩
    exact ⟨-x, ⟨x, hx, rfl⟩, neg_le_neg htx⟩

/-- Every preconnected real subset has an actual Boolean polynomial formula, including empty and unbounded intervals.
Source: Coste, Real Algebraic Sets (2005), Theorem 1.3, real interval description step. -/
theorem s2v_t11b_preconnected_real_formula (S : Set ℝ) (hS : IsPreconnected S) :
    ∃ f : s2v_t11b_Formula 1, ∀ t : ℝ,
      WithLp.toLp 2 (fun _ : Fin 1 => t) ∈ f.realize ↔ t ∈ S := by
  obtain ⟨l, hl⟩ := s2v_t11b_real_lower_shadow_formula S
  obtain ⟨u, hu⟩ := s2v_t11b_real_upper_shadow_formula S
  refine ⟨.inter l u, ?_⟩
  intro t
  change (_ ∈ l.realize ∧ _ ∈ u.realize) ↔ t ∈ S
  rw [hl, hu]
  constructor
  · rintro ⟨⟨a, ha, hat⟩, ⟨b, hb, htb⟩⟩
    exact hS.ordConnected.out ha hb ⟨hat, htb⟩
  · intro ht
    exact ⟨⟨t, ht, le_rfl⟩, ⟨t, ht, le_rfl⟩⟩

/-- A finite union of actual Boolean realizations has an explicit Boolean description.
Source: Coste, Real Algebraic Sets (2005), Theorem 1.3, finite real image union step. -/
theorem s2v_t11b_finite_union_formula {n m : ℕ} (c : Fin m → s2v_t11b_Formula n) :
    ∃ f : s2v_t11b_Formula n, ∀ x : EuclideanSpace ℝ (Fin n),
      x ∈ f.realize ↔ ∃ i, x ∈ (c i).realize := by
  classical
  refine ⟨.compl (s2v_t11b_Formula.conjunction (Finset.univ.toList.map (fun i => .compl (c i)))), ?_⟩
  intro x
  change (¬ x ∈ (s2v_t11b_Formula.conjunction _).realize) ↔ _
  rw [s2v_t11b_realize_conjunction]
  constructor
  · intro h
    by_contra hn
    apply h
    intro g hg
    obtain ⟨i, _, rfl⟩ := List.mem_map.mp hg
    exact fun hxi => hn ⟨i, hxi⟩
  · rintro ⟨i, hi⟩ h
    exact h (.compl (c i)) (List.mem_map.mpr ⟨i, by simp, rfl⟩) hi

/-- The actual real image of a continuous map on a Boolean realization has an exact Boolean polynomial description.
Source: Coste, Real Algebraic Sets (2005), Theorem 1.3, finite connected real image step. -/
theorem s2v_t11b_continuous_real_image_formula {n : ℕ} (f : s2v_t11b_Formula n)
    (p : EuclideanSpace ℝ (Fin n) → ℝ) (hp : ContinuousOn p f.realize) :
    ∃ g : s2v_t11b_Formula 1, ∀ t : ℝ,
      WithLp.toLp 2 (fun _ : Fin 1 => t) ∈ g.realize ↔ t ∈ p '' f.realize := by
  classical
  obtain ⟨m, U, hU, hcover⟩ := s2v_t11b_formula_finite_preconnected_cover n f
  choose c hc using fun i => s2v_t11b_preconnected_real_formula (p '' U i)
    ((hU i).1.image p (hp.mono (hU i).2))
  obtain ⟨g, hg⟩ := s2v_t11b_finite_union_formula c
  refine ⟨g, ?_⟩
  intro t
  rw [hg]
  constructor
  · rintro ⟨i, hi⟩
    obtain ⟨x, hx, rfl⟩ := (hc i t).mp hi
    exact ⟨x, (hU i).2 hx, rfl⟩
  · rintro ⟨x, hx, rfl⟩
    obtain ⟨i, hi⟩ := hcover x hx
    exact ⟨i, (hc i (p x)).mpr ⟨x, hi, rfl⟩⟩

end HodgeLean.Foundations.Program
