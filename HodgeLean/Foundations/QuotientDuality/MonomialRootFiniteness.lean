import HodgeLean.Foundations.QuotientDuality.MonomialRootNormality

/-! Finiteness for field extensions generated by finitely many power roots. -/
noncomputable section
set_option maxHeartbeats 200000
open IntermediateField
namespace HodgeLean.Foundations.QuotientDuality

theorem finiteDimensional_of_adjoin_power_roots
    {K F : Type*} [Field K] [Field F] [Algebra K F]
    (m : ℕ) (hm : 0 < m) (S : Set F) (hfinite : S.Finite)
    (hS : adjoin K S = ⊤)
    (hpow : ∀ x ∈ S, ∃ a : K, x ^ m = algebraMap K F a) : FiniteDimensional K F := by
  letI : Finite S := hfinite.to_subtype
  have hint (x : F) (hx : x ∈ S) : IsIntegral K x := by
    obtain ⟨a, ha⟩ := hpow x hx
    exact IsIntegral.of_pow hm (ha ▸ isIntegral_algebraMap)
  have hfin := finiteDimensional_adjoin hint
  rw [hS] at hfin
  exact FiniteDimensional.of_injective
    (IntermediateField.topEquiv.symm.toLinearMap : F →ₗ[K] (⊤ : IntermediateField K F))
    IntermediateField.topEquiv.symm.injective

#print axioms finiteDimensional_of_adjoin_power_roots
end HodgeLean.Foundations.QuotientDuality
