import Mathlib.FieldTheory.KummerExtension
import Mathlib.FieldTheory.Normal.Basic

/-! Normality of a field generated by roots of powers over a field with the required roots of unity. -/
noncomputable section
set_option maxHeartbeats 200000
open Polynomial IntermediateField
namespace HodgeLean.Foundations.QuotientDuality

theorem normal_of_adjoin_power_roots
    {K F : Type*} [Field K] [Field F] [Algebra K F]
    (m : ℕ) (hm : 0 < m) (ζ : K) (hζ : IsPrimitiveRoot ζ m)
    (S : Set F) (hS : adjoin K S = ⊤)
    (hpow : ∀ x ∈ S, ∃ a : K, x ^ m = algebraMap K F a) : Normal K F := by
  have hint (x : F) (hx : x ∈ S) : IsIntegral K x := by
    obtain ⟨a, ha⟩ := hpow x hx
    exact IsIntegral.of_pow hm (ha ▸ isIntegral_algebraMap)
  have hsplit (x : F) (hx : x ∈ S) : ((minpoly K x).map (algebraMap K F)).Splits := by
    obtain ⟨a, ha⟩ := hpow x hx
    have hroot : aeval x (X ^ m - C a : K[X]) = 0 := by
      simp only [map_sub, map_pow, aeval_X, aeval_C, ha, sub_self]
    have hd := Polynomial.map_dvd (algebraMap K F) (minpoly.dvd K x hroot)
    have hz := X_pow_sub_C_splits_of_isPrimitiveRoot
      (hζ.map_of_injective (algebraMap K F).injective) ha
    rw [Polynomial.map_sub, Polynomial.map_pow, Polynomial.map_X, Polynomial.map_C] at hd
    exact hz.of_dvd (X_pow_sub_C_ne_zero hm _) hd
  have halg := isAlgebraic_adjoin hint
  rw [hS] at halg
  letI : Algebra.IsAlgebraic K F :=
    Algebra.IsAlgebraic.of_injective
      (IntermediateField.topEquiv.symm.toAlgHom : F →ₐ[K] (⊤ : IntermediateField K F))
      IntermediateField.topEquiv.symm.injective
  apply normal_iff.mpr
  intro x
  exact ⟨Algebra.IsIntegral.isIntegral x,
    splits_of_mem_adjoin K F (fun y hy => ⟨hint y hy, hsplit y hy⟩) (hS ▸ Set.mem_univ x)⟩

#print axioms normal_of_adjoin_power_roots
end HodgeLean.Foundations.QuotientDuality
