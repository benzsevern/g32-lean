import HodgeLean.Foundations.QuotientDuality.DeckDefs
import HodgeLean.Foundations.Port.AlgebraicTopology.Singular.CohomologyZero
import HodgeConjecture.Lemmas.AlgebraicTopology.LocalHomology.ChartFundamentalClass
import Mathlib.LinearAlgebra.Span.Basic

/-! # Local orientation lines and rational integration

Local classes are projections of actual singular homology classes. Integration
is evaluation under the singular universal-coefficient equivalence.
HC no distance; AV milestone no distance.
-/

noncomputable section
open CategoryTheory AlgebraicTopology.Singular
namespace HodgeLean.Foundations.QuotientDuality

/-- The local rational homology group at a point.
Source: Hatcher, Algebraic Topology, section 3.3, local orientations. -/
abbrev orientationGroup (X : TopCat.{0}) (n : ℕ) (x : X) :=
  RelativeHomology ℚ (pointComplementPair x) n

example : orientationGroup (TopCat.of Unit) 0 () =
    RelativeHomology ℚ (pointComplementPair ()) 0 := rfl

/-- Restriction of an actual global class to a point complement.
Source: Hatcher, Algebraic Topology, Lemma 3.27 and Theorem 3.26. -/
def localOrientation (X : TopCat.{0}) (n : ℕ) (c : Homology ℚ X n) (x : X) :
    orientationGroup X n x :=
  (relativeHomologyProjection ℚ (pointComplementPair x) n).hom c

example (X : TopCat.{0}) (n : ℕ) (x : X) :
    localOrientation X n 0 x = 0 := map_zero _

/-- The scalar map onto the line generated by a local orientation class.
Source: Hatcher, Algebraic Topology, section 3.3, generators of local homology. -/
def orientationLine (X : TopCat.{0}) (n : ℕ) (c : Homology ℚ X n) (x : X) :
    ℚ →ₗ[ℚ] orientationGroup X n x :=
  LinearMap.toSpanSingleton ℚ _ (localOrientation X n c x)

example (X : TopCat.{0}) (n : ℕ) (x : X) :
    orientationLine X n 0 x (3 : ℚ) = 0 := by
  change (3 : ℚ) • ((relativeHomologyProjection ℚ (pointComplementPair x) n).hom 0) = 0
  rw [map_zero, smul_zero]

/-- Integration against a specified singular fundamental class.
Source: Hatcher, Algebraic Topology, section 3.1, universal coefficients. -/
def orientationIntegral (X : TopCat.{0}) (n : ℕ) (c : Homology ℚ X n) :
    Cohomology ℚ X n →ₗ[ℚ] ℚ where
  toFun a := cohomologyEquivDualHomology ℚ X n a c
  map_add' a b := by simp
  map_smul' r a := by simp

example (X : TopCat.{0}) (n : ℕ) (a : Cohomology ℚ X n) :
    orientationIntegral X n 0 a = 0 := by
  exact map_zero (cohomologyEquivDualHomology ℚ X n a)

/-- Integration of the specified complementary-degree product.
Source: Hatcher, Algebraic Topology, sections 3.2 and 3.3, cup evaluation. -/
def orientationPairing (X : TopCat.{0}) (p r n : ℕ) (c : Homology ℚ X n)
    (cup : Cohomology ℚ X p →ₗ[ℚ] Cohomology ℚ X r →ₗ[ℚ] Cohomology ℚ X n)
    (a : Cohomology ℚ X p) (b : Cohomology ℚ X r) : ℚ :=
  orientationIntegral X n c (cup a b)

example (X : TopCat.{0}) (p r n : ℕ) (c : Homology ℚ X n)
    (a : Cohomology ℚ X p) (b : Cohomology ℚ X r) :
    orientationPairing X p r n c 0 a b = 0 := by
  simp [orientationPairing]

private abbrev pointSpace := TopCat.of Unit
private def pointFundamental : Homology ℚ pointSpace 0 :=
  (asIso (pointSpace.singularHomology₀ε (ModuleCat.of ℚ ℚ))).inv.hom (1 : ℚ)

private theorem pointIntegral :
    orientationIntegral pointSpace 0 pointFundamental
      (cohomologyUnitZero ℚ pointSpace) = 1 := by
  change cohomologyEquivDualHomology ℚ pointSpace 0 (cohomologyUnitZero ℚ pointSpace) _ = _
  rw [cohomologyEquivDualHomology_cohomologyUnitZero]
  exact LinearMap.congr_fun
    (congrArg ModuleCat.Hom.hom (Iso.inv_hom_id
      (asIso (pointSpace.singularHomology₀ε (ModuleCat.of ℚ ℚ))))) 1

example : orientationIntegral pointSpace 0 pointFundamental
    (cohomologyUnitZero ℚ pointSpace) = 1 := pointIntegral

example : orientationPairing pointSpace 0 0 0 pointFundamental
    (LinearMap.smulRight (orientationIntegral pointSpace 0 pointFundamental)
      (LinearMap.smulRight (orientationIntegral pointSpace 0 pointFundamental)
        (cohomologyUnitZero ℚ pointSpace)))
    (cohomologyUnitZero ℚ pointSpace) (cohomologyUnitZero ℚ pointSpace) = 1 := by
  change orientationIntegral _ _ pointFundamental
    ((orientationIntegral _ _ pointFundamental (cohomologyUnitZero ℚ pointSpace)) •
      ((orientationIntegral _ _ pointFundamental (cohomologyUnitZero ℚ pointSpace)) •
        cohomologyUnitZero ℚ pointSpace)) = 1
  simp only [pointIntegral, one_smul]

end HodgeLean.Foundations.QuotientDuality
