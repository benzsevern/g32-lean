import HodgeLean.Foundations.SchurWeyl

/-!
# The Lie-algebra form of the first fundamental theorem, and `sl(W)`-invariants

Foundations targets T7 (run 2) and T8(a) (`docs/roadmap/foundations.md` §4 T7, T8).

`K` is a field of characteristic zero and `W` a finite-dimensional `K`-vector space,
`N = finrank K W`. `gl(W) = Module.End K W` acts on `MixedTensor K W ι κ = W^{⊗ι} ⊗ (W^∨)^{⊗κ}`
by derivations (`mixedLie`), and `sl(W) = slEnd K W` is the traceless part. Conventions from
T7: `permRep σ` moves slot `i` to slot `σ i`; `GL(W)` acts on duals by `φ ↦ φ ∘ g⁻¹`, so `gl(W)`
acts on `W^∨` by `-Xᵀ` (`dualLie`).

## Main results

* `mixedLie` (a morphism of Lie algebras) and `mixedEquiv_lie`: under
  `mixedEquiv : W^{⊗ι} ⊗ (W^∨)^{⊗ι} ≃ End (W^{⊗ι})` the action is the commutator with the
  derivation action `tensorDer`.
* `maxTrivSubmodule_eq_invariants`: the `gl(W)`-invariants are the `GL(W)`-invariants, hence
  `maxTriv_mixedLie_eq_span_contraction` (the first fundamental theorem for `gl(W)`) and
  `maxTriv_mixedLie_eq_bot` (`|ι| ≠ |κ|`). Route: `GL ⇒ gl` by the polynomial
  `t ↦ (1 + tX) · v`; `gl ⇒ GL` by Newton's identities in the commutative algebra generated by
  the slot operators (`tensorPow_mem_intertwinerAlg`).
* `detTensor`, `detTensorDual` (`ε`, `ε^∨`): the antisymmetrizations of a basis and its dual,
  images of `⋀^N` under `exteriorPower.toTensorPower`; `X` acts on `ε` by `−trace X` and on
  `ε^∨` by `trace X`
  (`tensorDer_detTensor`, `tensorDer_detTensorDual`), `⟨ε, ε^∨⟩ = N!`, and another basis changes
  them by a nonzero scalar. `detPow`, `detPowDual`: their `m`-th tensor powers, slots
  `Blocks N m`.
* T8(a), the `sl(W)`-invariants of `W^{⊗a} ⊗ (W^∨)^{⊗b}`:
  * `maxTriv_slEnd_eq_span_detPow` (`b = a + mN`, dual slots `ι ⊕ Blocks N m`): spanned by the
    `(1 ⊗ τ)(c_1 ⊗ ε^{⊗m})`, `τ ∈ Perm (ι ⊕ Blocks N m)`;
  * `maxTriv_slEnd_eq_span_detPowDual` (`a = b + mN`, `W`-slots `ι ⊕ Blocks N m`): spanned by
    the `(τ ⊗ 1)(c_1 ⊗ (ε^∨)^{⊗m})`;
  * `maxTriv_slEnd_eq_span_contraction` (`a = b`, the case `m = 0` in the natural slots);
  * `maxTriv_slEnd_eq_bot`: `0` unless `N ∣ b - a` (weights of the diagonal torus).
  The abstract forms `maxTriv_slEnd_eq_span`, `maxTriv_slEnd_eq_span_vec` take any
  `sl(W)`-invariant `D`, `D'` with `⟨D, D'⟩ ≠ 0`.
* Examples: `maxTriv_slEnd_eq_span_detMixed` (`a = 0`, `b = N`: the line through `ε`; for `N = 2`
  the line through `e₁^∨ ⊗ e₂^∨ - e₂^∨ ⊗ e₁^∨`), `a = b = 1` (the line through the identity),
  and the falsifications `W^∨` has no invariant (`N = 2`, `a = 0`, `b = 1`) and
  `eq_zero_of_swap_invariant` (no symmetric invariant in `W^∨ ⊗ W^∨`).

## Not formalized here

T8(b), the exterior-algebra lemma with multiplicity spaces (F-1575 (1) itself), and the group
form of T8(a) for `SL(W)`. The T8(a) theorems use the explicit slot types `ι ⊕ Blocks N m`
(and the mirror type); transport to an arbitrary index type `κ` of the right cardinality by
equivariant `PiTensorProduct.reindex` is routine but not formalized.

Relation to the goal: HC no distance; AV milestone no distance; a step toward a Lean proof of
F-1575 (1); F-1575 (1) itself is not proved.
-/

open PiTensorProduct Finset Module
open scoped TensorProduct

noncomputable section

/- `Module.End K W` is a Lie algebra under the commutator; Mathlib no longer makes
`LieRing.ofAssociativeRing` a global instance. -/
attribute [local instance 100] LieRing.ofAssociativeRing

namespace HodgeLean.Foundations.SchurWeyl

/-- Instance search does not unfold `Module.Dual K W` under the binder of `⨂[K] _ : κ, _`, so
without this it finds no `Ring (Module.End K (⨂[K] _ : κ, Module.Dual K W))`.

Source: Mathlib's dual space `Module.Dual`; this is an instance shim. -/
@[reducible] def dualAddCommGroup (K W : Type*) [Field K] [AddCommGroup W] [Module K W] :
    AddCommGroup (Module.Dual K W) :=
  LinearMap.addCommGroup

attribute [local instance] dualAddCommGroup

example (K W : Type*) [Field K] [AddCommGroup W] [Module K W] :
    AddCommGroup (Module.Dual K W) := dualAddCommGroup K W

section Slot

variable {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M] {ι : Type*} [DecidableEq ι]

variable (ι) in
/-- `f` acting in the single slot `i` of `⨂[R] _ : ι, M`: `1 ⊗ ⋯ ⊗ f ⊗ ⋯ ⊗ 1`.

Source: Goodman–Wallach, *Symmetry, Representations, and Invariants*, GTM 255, Ch. 4 (the
differential of the action of `GL(V)` on `⊗^k V`). -/
def slot (i : ι) : Module.End R M →ₗ[R] Module.End R (⨂[R] _ : ι, M) :=
  (mapMultilinear R (fun _ : ι => M) fun _ => M).toLinearMap (fun _ => 1) i

theorem slot_apply (i : ι) (f : Module.End R M) :
    slot ι i f = PiTensorProduct.map (Function.update (fun _ => (1 : Module.End R M)) i f) :=
  rfl

theorem slot_tprod (i : ι) (f : Module.End R M) (v : ι → M) :
    slot ι i f (tprod R v) = tprod R (Function.update v i (f (v i))) := by
  rw [slot_apply, map_tprod]
  congr 1
  funext j
  by_cases h : j = i
  · subst h; simp
  · simp [Function.update_of_ne h]

/-- `slot` on `W ⊗ W`. -/
example (f : Module.End R M) (a b : M) :
    slot (Fin 2) 1 f (tprod R ![a, b]) = tprod R ![a, f b] := by
  rw [slot_tprod]
  congr 1
  funext i
  fin_cases i <;> rfl

theorem slot_mul_slot (i : ι) (f g : Module.End R M) :
    slot ι i f * slot ι i g = slot ι i (f * g) := by
  ext v
  simp [slot_tprod]

theorem slot_one (i : ι) : slot ι i (1 : Module.End R M) = 1 := by
  ext v
  simp [slot_tprod]

theorem commute_slot (i j : ι) (f g : Module.End R M) (h : i ≠ j) :
    Commute (slot ι i f) (slot ι j g) := by
  ext v
  simp [slot_tprod, Function.update_of_ne h, Function.update_of_ne (Ne.symm h),
    Function.update_comm h]

theorem slot_pow (i : ι) (f : Module.End R M) (n : ℕ) : slot ι i f ^ n = slot ι i (f ^ n) := by
  induction n with
  | zero => simp [slot_one]
  | succ n ih => rw [pow_succ, ih, slot_mul_slot, pow_succ]

end Slot

section Derivation

variable {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M] (ι : Type*) [Fintype ι]
  [DecidableEq ι]

/-- The derivation action of `gl(M) = Module.End R M` on `⨂[R] _ : ι, M`:
`X ↦ ∑ᵢ 1 ⊗ ⋯ ⊗ X ⊗ ⋯ ⊗ 1`. It is a morphism of Lie algebras (`tensorDer_lie`).

Source: Goodman–Wallach, *Symmetry, Representations, and Invariants*, GTM 255, Ch. 4 (the
differential of the representation of `GL(V)` on `⊗^k V`); Fulton–Harris, *Representation
Theory*, §8.1 (tensor products of Lie algebra representations). -/
def tensorDer : Module.End R M →ₗ⁅R⁆ Module.End R (⨂[R] _ : ι, M) where
  toFun f := ∑ i, slot ι i f
  map_add' f g := by simp [Finset.sum_add_distrib]
  map_smul' c f := by simp [Finset.smul_sum]
  map_lie' {f g} := by
    have key (i j : ι) : slot ι i f * slot ι j g - slot ι j g * slot ι i f =
        if i = j then slot ι i (f * g - g * f) else 0 := by
      split_ifs with h
      · subst h; rw [map_sub, slot_mul_slot, slot_mul_slot]
      · rw [(commute_slot i j f g h).eq, sub_self]
    simp only [Ring.lie_def, Finset.sum_mul_sum]
    rw [Finset.sum_comm (f := fun i j => slot ι i g * slot ι j f), ← Finset.sum_sub_distrib]
    simp_rw [← Finset.sum_sub_distrib, key, Finset.sum_ite_eq, Finset.mem_univ, ite_true]

variable {ι}

theorem tensorDer_apply (f : Module.End R M) : tensorDer ι f = ∑ i, slot ι i f := rfl

theorem tensorDer_tprod (f : Module.End R M) (v : ι → M) :
    tensorDer ι f (tprod R v) = ∑ i, tprod R (Function.update v i (f (v i))) := by
  simp [tensorDer_apply, LinearMap.sum_apply, slot_tprod]

/-- The derivation action on `W ⊗ W`. -/
example (f : Module.End R M) (a b : M) :
    tensorDer (Fin 2) f (tprod R ![a, b]) = tprod R ![f a, b] + tprod R ![a, f b] := by
  rw [tensorDer_tprod, Fin.sum_univ_two]
  congr 2 <;> funext i <;> fin_cases i <;> rfl

/-- The identity acts by the number of factors. -/
theorem tensorDer_one : tensorDer ι (1 : Module.End R M) = (Fintype.card ι : R) • 1 := by
  simp [tensorDer_apply, slot_one, Finset.sum_const, Nat.cast_smul_eq_nsmul]

end Derivation

section DualLie

variable (K W : Type*) [Field K] [AddCommGroup W] [Module K W]

/-- The contragredient action `X ↦ -Xᵀ` of `gl(W)` on `W^∨`, a morphism of Lie algebras.

Source: Fulton–Harris, *Representation Theory*, §8.1 (the dual of a Lie algebra
representation). -/
def dualLie : Module.End K W →ₗ⁅K⁆ Module.End K (Module.Dual K W) where
  toFun X := -X.dualMap
  map_add' X Y := by ext; simp; abel
  map_smul' c X := by ext; simp
  map_lie' {X Y} := by
    ext φ w
    simp [Ring.lie_def, Module.End.mul_apply, LinearMap.dualMap_apply]

variable {K W}

@[simp]
theorem dualLie_apply (X : Module.End K W) : dualLie K W X = -X.dualMap := rfl

/-- `X` acts on `φ ∈ W^∨` by `-(φ ∘ X)`. -/
example (X : Module.End K W) (φ : Module.Dual K W) : dualLie K W X φ = -(φ ∘ₗ X) := rfl

end DualLie

section MixedLie

variable (K W : Type*) [Field K] [AddCommGroup W] [Module K W] (ι κ : Type*) [Fintype ι]
  [DecidableEq ι] [Fintype κ] [DecidableEq κ]

/-- The action of `gl(W)` on the mixed tensors `W^{⊗ι} ⊗ (W^∨)^{⊗κ}`: the derivation action
(`tensorDer`) on `W^{⊗ι}`, plus the derivation action of `-Xᵀ` on `(W^∨)^{⊗κ}`. It is a morphism
of Lie algebras, which makes `MixedTensor K W ι κ` a Lie module over `Module.End K W`.

Source: Goodman–Wallach, *Symmetry, Representations, and Invariants*, GTM 255, Ch. 5 (mixed
tensors); Fulton–Harris, *Representation Theory*, §8.1. -/
def mixedLie : Module.End K W →ₗ⁅K⁆ Module.End K (MixedTensor K W ι κ) where
  toFun X := (tensorDer ι X).rTensor _ + (tensorDer κ (dualLie K W X)).lTensor _
  map_add' X Y := by simp only [map_add, LinearMap.rTensor_add, LinearMap.lTensor_add]; abel
  map_smul' c X := by
    simp only [map_smul, LinearMap.rTensor_smul, LinearMap.lTensor_smul, smul_add,
      RingHom.id_apply]
  map_lie' {X Y} := by
    have hc (A : Module.End K (⨂[K] _ : ι, W)) (B : Module.End K (⨂[K] _ : κ, Module.Dual K W)) :
        A.rTensor _ * B.lTensor _ = B.lTensor _ * A.rTensor _ := by
      rw [Module.End.mul_eq_comp, Module.End.mul_eq_comp, LinearMap.rTensor_comp_lTensor,
        LinearMap.lTensor_comp_rTensor]
    simp only [LieHom.map_lie]
    simp only [Ring.lie_def, LinearMap.rTensor_sub, LinearMap.lTensor_sub,
      LinearMap.rTensor_mul, LinearMap.lTensor_mul, add_mul, mul_add, hc]
    abel

instance : LieRingModule (Module.End K W) (MixedTensor K W ι κ) :=
  LieRingModule.compLieHom _ (mixedLie K W ι κ)

instance : LieModule K (Module.End K W) (MixedTensor K W ι κ) :=
  LieModule.compLieHom _ (mixedLie K W ι κ)

variable {K W ι κ}

theorem lie_mixedTensor (X : Module.End K W) (v : MixedTensor K W ι κ) :
    ⁅X, v⁆ = mixedLie K W ι κ X v := rfl

theorem mixedLie_apply (X : Module.End K W) (v : MixedTensor K W ι κ) :
    mixedLie K W ι κ X v =
      (tensorDer ι X).rTensor _ v - (tensorDer κ X.dualMap).lTensor _ v := by
  simp [mixedLie, sub_eq_add_neg, LinearMap.lTensor_neg]

/-- `gl(W)` acting on `W ⊗ W^∨`. -/
example (X : Module.End K W) (v : W) (φ : Module.Dual K W) :
    ⁅X, tprod K (fun _ : Fin 1 => v) ⊗ₜ[K] tprod K (fun _ : Fin 1 => φ)⁆ =
      tprod K (fun _ : Fin 1 => X v) ⊗ₜ tprod K (fun _ : Fin 1 => φ) -
        tprod K (fun _ : Fin 1 => v) ⊗ₜ tprod K (fun _ : Fin 1 => φ ∘ₗ X) := by
  rw [lie_mixedTensor, mixedLie_apply]
  simp [tensorDer_tprod, Function.update_eq_const_of_subsingleton]
  rfl

variable [FiniteDimensional K W]

/-- `mixedEquiv : W^{⊗ι} ⊗ (W^∨)^{⊗ι} ≃ End (W^{⊗ι})` carries the `gl(W)`-action to the commutator
with the derivation action. -/
theorem mixedEquiv_lie (X : Module.End K W) (v : MixedTensor K W ι ι) :
    mixedEquiv K W ι ⁅X, v⁆ =
      tensorDer ι X * mixedEquiv K W ι v - mixedEquiv K W ι v * tensorDer ι X := by
  have : (mixedEquiv K W ι).toLinearMap ∘ₗ mixedLie K W ι ι X =
      (LinearMap.mulLeft K (tensorDer ι X) - LinearMap.mulRight K (tensorDer ι X)) ∘ₗ
        (mixedEquiv K W ι).toLinearMap := by
    ext t φ w
    simp only [LinearMap.compMultilinearMap_apply, TensorProduct.AlgebraTensorModule.curry_apply,
      LinearMap.restrictScalars_apply, TensorProduct.curry_apply, LinearMap.coe_comp,
      Function.comp_apply, mixedLie_apply, LinearMap.rTensor_tmul, LinearMap.lTensor_tmul,
      map_sub, LinearEquiv.coe_coe, LinearMap.sub_apply, LinearMap.mulLeft_apply,
      LinearMap.mulRight_apply, Module.End.mul_apply, tensorDer_tprod, map_sum,
      LinearMap.sum_apply, mixedEquiv_tmul_tprod, TensorProduct.sum_tmul,
      TensorProduct.tmul_sum]
    rw [map_smul, tensorDer_tprod, Finset.smul_sum]
    congr 1
    refine Finset.sum_congr rfl fun i _ => ?_
    congr 1
    refine Finset.prod_congr rfl fun j _ => ?_
    by_cases h : j = i
    · subst h; simp
    · simp [Function.update_of_ne h]
  exact congr($this v)

end MixedLie

section Polynomial

variable {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M] {ι : Type*} [Fintype ι]
  [DecidableEq ι]

/-- The expansion `(1 + t X)^{⊗ι} = ∑ₛ t^{|s|} X^{⊗s}`, where `X^{⊗s}` puts `X` in the slots of
`s`. -/
theorem tensorPow_one_add_smul (X : Module.End R M) (t : R) :
    tensorPow ι (1 + t • X) =
      ∑ s : Finset ι, t ^ s.card • PiTensorProduct.map (s.piecewise (fun _ => X) fun _ => 1) := by
  let F := mapMultilinear R (fun _ : ι => M) fun _ => M
  have h : tensorPow ι (1 + t • X) = F ((fun _ => t • X) + fun _ => 1) := by
    simp only [tensorPow, F, mapMultilinear_apply]
    congr 1
    funext i
    simp [add_comm]
  rw [h, F.map_add_univ]
  refine Finset.sum_congr rfl fun s _ => ?_
  have hpw : s.piecewise (fun _ : ι => t • X) (fun _ => 1) =
      fun i => (if i ∈ s then t else 1) • s.piecewise (fun _ => X) (fun _ => 1) i := by
    ext1 i
    by_cases hi : i ∈ s <;> simp [hi]
  rw [hpw, F.map_smul_univ, Finset.prod_ite_mem, Finset.univ_inter, Finset.prod_const]
  rfl

/-- The sum over the one-element subsets. -/
theorem sum_finset_card_eq_one {N : Type*} [AddCommMonoid N] (g : Finset ι → N) :
    (∑ s : Finset ι, if 1 = s.card then g s else 0) = ∑ i, g {i} := by
  rw [← Finset.sum_filter]
  have : (Finset.univ.filter fun s : Finset ι => 1 = s.card) =
      Finset.univ.map ⟨fun i => {i}, Finset.singleton_injective⟩ := by
    ext s
    simp [eq_comm (a := 1), Finset.card_eq_one, eq_comm (a := s)]
  rw [this, Finset.sum_map]
  rfl

/-- For a linear form `Λ` on `End (⨂ M)`, `t ↦ Λ ((1 + t X)^{⊗ι})` is a polynomial whose linear
coefficient is `Λ` of the derivation action of `X`. -/
theorem exists_polynomial_tensorPow_one_add_smul
    (Λ : Module.End R (⨂[R] _ : ι, M) →ₗ[R] R) (X : Module.End R M) :
    ∃ p : Polynomial R, (∀ t, p.eval t = Λ (tensorPow ι (1 + t • X))) ∧
      p.coeff 1 = Λ (tensorDer ι X) := by
  refine ⟨∑ s : Finset ι, Polynomial.C (Λ (PiTensorProduct.map
      (s.piecewise (fun _ => X) fun _ => 1))) * Polynomial.X ^ s.card, fun t => ?_, ?_⟩
  · rw [tensorPow_one_add_smul, map_sum, Polynomial.eval_finsetSum]
    refine Finset.sum_congr rfl fun s _ => ?_
    rw [map_smul, smul_eq_mul]
    simp only [Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_pow, Polynomial.eval_X]
    ring
  · rw [Polynomial.finsetSum_coeff]
    simp only [Polynomial.coeff_C_mul_X_pow]
    rw [sum_finset_card_eq_one, tensorDer_apply, map_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [Finset.piecewise_singleton, slot_apply]

end Polynomial

section TensorOne

variable {R M N : Type*} [CommRing R] [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]

theorem lTensor_one_apply (x : M ⊗[R] N) : (1 : Module.End R N).lTensor M x = x := by
  rw [Module.End.one_eq_id, LinearMap.lTensor_id, LinearMap.id_apply]

theorem rTensor_one_apply (x : N ⊗[R] M) : (1 : Module.End R N).rTensor M x = x := by
  rw [Module.End.one_eq_id, LinearMap.rTensor_id, LinearMap.id_apply]

end TensorOne

section Invariants

variable {K W ι κ : Type*} [Field K] [AddCommGroup W] [Module K W] [Fintype ι] [DecidableEq ι]
  [Fintype κ] [DecidableEq κ]

omit [Fintype ι] [DecidableEq ι] [Fintype κ] [DecidableEq κ] in
/-- `v` is `GL(W)`-invariant iff `(g^{⊗ι} ⊗ 1) v = (1 ⊗ (gᵀ)^{⊗κ}) v` for every `g`. -/
theorem mem_invariants_mixedRep_iff (v : MixedTensor K W ι κ) :
    v ∈ (mixedRep K W ι κ).invariants ↔ ∀ g : LinearMap.GeneralLinearGroup K W,
      (tensorPow ι (g : Module.End K W)).rTensor _ v =
        (tensorPow κ (g : Module.End K W).dualMap).lTensor _ v := by
  have hcancel (B B' : Module.End K (⨂[K] _ : κ, Module.Dual K W)) (h : B * B' = 1)
      (x : MixedTensor K W ι κ) : B.lTensor _ (B'.lTensor _ x) = x := by
    rw [← Module.End.mul_apply, ← LinearMap.lTensor_mul, h, Module.End.one_eq_id,
      LinearMap.lTensor_id, LinearMap.id_apply]
  have hdual (g h : LinearMap.GeneralLinearGroup K W) (hgh : h * g = 1) :
      tensorPow κ (g : Module.End K W).dualMap * tensorPow κ (h : Module.End K W).dualMap = 1 := by
    rw [← tensorPow_mul, ← tensorPow_one]
    congr 1
    ext φ w
    have := congr($(congrArg Units.val hgh) w)
    simp only [Units.val_mul, Module.End.mul_apply, Units.val_one, Module.End.one_apply] at this
    simp [LinearMap.dualMap_apply, this]
  simp only [Representation.mem_invariants]
  refine forall_congr' fun g => ?_
  have hmap : mixedRep K W ι κ g v = (tensorPow κ ((g⁻¹ : LinearMap.GeneralLinearGroup K W) :
      Module.End K W).dualMap).lTensor _ ((tensorPow ι (g : Module.End K W)).rTensor _ v) := by
    rw [← LinearMap.comp_apply, LinearMap.lTensor_comp_rTensor]
    rfl
  rw [hmap]
  constructor
  · intro h
    calc _ = (tensorPow κ (g : Module.End K W).dualMap).lTensor _
          ((tensorPow κ ((g⁻¹ : LinearMap.GeneralLinearGroup K W) :
            Module.End K W).dualMap).lTensor _ ((tensorPow ι (g : Module.End K W)).rTensor _ v)) :=
          (hcancel _ _ (hdual g g⁻¹ (inv_mul_cancel g)) _).symm
      _ = _ := by rw [h]
  · intro h
    rw [h, hcancel _ _ (hdual g⁻¹ g (mul_inv_cancel g))]

variable [FiniteDimensional K W]

/-- `1 + t X` is invertible for all but finitely many `t`. -/
theorem finite_not_isUnit_one_add_smul (X : Module.End K W) :
    {t : K | ¬ IsUnit (1 + t • X)}.Finite := by
  refine (Set.Finite.preimage (f := fun t : K => -t⁻¹) ?_ X.finite_hasEigenvalue).subset ?_
  · intro a _ b _ h
    simpa using h
  · intro t ht
    simp only [Set.mem_ofPred_eq] at ht
    simp only [Set.mem_preimage, Set.mem_ofPred_eq]
    rw [LinearMap.isUnit_iff_ker_eq_bot] at ht
    obtain ⟨w, hw, hw0⟩ := (Submodule.ne_bot_iff _).mp ht
    rw [LinearMap.mem_ker] at hw
    simp only [LinearMap.add_apply, Module.End.one_apply, LinearMap.smul_apply] at hw
    have ht0 : t ≠ 0 := by
      rintro rfl
      simp at hw
      exact hw0 hw
    refine Module.End.hasEigenvalue_of_hasEigenvector ⟨?_, hw0⟩
    rw [Module.End.mem_eigenspace_iff]
    have : X w = -t⁻¹ • w := by
      rw [neg_smul, eq_neg_iff_add_eq_zero]
      have h2 := congrArg (t⁻¹ • ·) hw
      simp only [smul_add, smul_smul, inv_mul_cancel₀ ht0, one_smul, smul_zero] at h2
      rw [add_comm]
      exact h2
    exact this

/-- **`GL(W)`-invariants are `gl(W)`-invariants.** The polynomial route: `(1 + t X)` is invertible
for all but finitely many `t`, and the linear coefficient of `t ↦ (1 + t X) · v` is `X · v`. -/
theorem mem_maxTrivSubmodule_of_mem_invariants [CharZero K] {v : MixedTensor K W ι κ}
    (hv : v ∈ (mixedRep K W ι κ).invariants) :
    v ∈ LieModule.maxTrivSubmodule K (Module.End K W) (MixedTensor K W ι κ) := by
  rw [LieModule.mem_maxTrivSubmodule]
  intro X
  rw [mem_invariants_mixedRep_iff] at hv
  rw [lie_mixedTensor, mixedLie_apply, ← Module.forall_dual_apply_eq_zero_iff K]
  intro ℓ
  let Λ₁ : Module.End K (⨂[K] _ : ι, W) →ₗ[K] K :=
    ℓ ∘ₗ LinearMap.applyₗ v ∘ₗ LinearMap.rTensorHom _
  let Λ₂ : Module.End K (⨂[K] _ : κ, Module.Dual K W) →ₗ[K] K :=
    ℓ ∘ₗ LinearMap.applyₗ v ∘ₗ LinearMap.lTensorHom _
  obtain ⟨p₁, hp₁, hc₁⟩ := exists_polynomial_tensorPow_one_add_smul Λ₁ X
  obtain ⟨p₂, hp₂, hc₂⟩ := exists_polynomial_tensorPow_one_add_smul Λ₂ X.dualMap
  have hp : p₁ - p₂ = 0 := by
    apply Polynomial.eq_zero_of_infinite_isRoot
    refine Set.Infinite.mono ?_ (finite_not_isUnit_one_add_smul X).infinite_compl
    intro t ht
    simp only [Set.mem_compl_iff, Set.mem_ofPred_eq, not_not] at ht
    have hdual : (1 + t • X).dualMap = 1 + t • X.dualMap := by
      ext φ w
      simp [LinearMap.dualMap_apply]
    have := hv ht.unit
    simp only [IsUnit.unit_spec, hdual] at this
    simp [Polynomial.IsRoot, hp₁, hp₂, Λ₁, Λ₂, this]
  have h1 := congrArg (Polynomial.coeff · 1) hp
  simp only [Polynomial.coeff_sub, hc₁, hc₂, Polynomial.coeff_zero, sub_eq_zero] at h1
  change ℓ ((tensorDer ι X).rTensor _ v) = ℓ ((tensorDer κ X.dualMap).lTensor _ v) at h1
  rw [map_sub, h1, sub_self]

end Invariants

section Newton

open MvPolynomial

/-- **Newton's identities, generation form.** In characteristic zero the elementary symmetric
polynomials lie in the subalgebra generated by the power sums.

Source: Macdonald, *Symmetric Functions and Hall Polynomials*, Ch. I §2 (Newton's formulas);
Procesi, *Lie Groups*, Ch. 2. -/
theorem esymm_mem_adjoin_psum (σ K : Type*) [Fintype σ] [Field K] [CharZero K] (n : ℕ) :
    esymm σ K n ∈ Algebra.adjoin K (Set.range (psum σ K)) := by
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    rcases n.eq_zero_or_pos with rfl | hn
    · rw [esymm_zero]
      exact Subalgebra.one_mem _
    have h := mul_esymm_eq_sum σ K n
    have hn' : (n : MvPolynomial σ K) = C (n : K) := by simp
    have : esymm σ K n = C (n : K)⁻¹ * ((n : MvPolynomial σ K) * esymm σ K n) := by
      rw [← mul_assoc, hn', ← C_mul, inv_mul_cancel₀ (by exact_mod_cast hn.ne'), C_1, one_mul]
    rw [this, h]
    have hC (c : K) : C c ∈ Algebra.adjoin K (Set.range (psum σ K)) := by
      rw [← MvPolynomial.algebraMap_eq]
      exact Subalgebra.algebraMap_mem _ _
    have hneg (k : ℕ) : ((-1) ^ k : MvPolynomial σ K) ∈ Algebra.adjoin K (Set.range (psum σ K)) :=
      Subalgebra.pow_mem _ (Subalgebra.neg_mem _ (Subalgebra.one_mem _)) _
    refine Subalgebra.mul_mem _ (hC _) (Subalgebra.mul_mem _ (hneg _) (Subalgebra.sum_mem _
      fun a ha => ?_))
    obtain ⟨-, hlt⟩ := Finset.mem_filter.mp ha
    exact Subalgebra.mul_mem _ (Subalgebra.mul_mem _ (hneg _) (ih _ hlt))
      (Algebra.subset_adjoin ⟨_, rfl⟩)

/-- `esymm` in degree `|σ|` is the product of the variables. -/
theorem esymm_card (σ R : Type*) [Fintype σ] [CommSemiring R] :
    esymm σ R (Fintype.card σ) = ∏ i, X i := by
  classical
  rw [esymm, ← Finset.card_univ, Finset.powersetCard_self, Finset.sum_singleton]

end Newton

section Intertwiner

variable {K W ι κ : Type*} [Field K] [AddCommGroup W] [Module K W]

variable (ι κ) in
/-- The pairs `(a, b)` with `(a ⊗ 1) v = (1 ⊗ b) v`, a subalgebra of `End (W^{⊗ι}) × End
((W^∨)^{⊗κ})ᵐᵒᵖ`.

Source: Goodman–Wallach, GTM 255, Ch. 4 (commuting algebras of operators on tensor spaces). -/
def intertwinerAlg (v : MixedTensor K W ι κ) :
    Subalgebra K (Module.End K (⨂[K] _ : ι, W) ×
      (Module.End K (⨂[K] _ : κ, Module.Dual K W))ᵐᵒᵖ) where
  carrier := {p | p.1.rTensor _ v = p.2.unop.lTensor _ v}
  mul_mem' {p q} hp hq := by
    simp only [Set.mem_ofPred_eq, Prod.fst_mul, Prod.snd_mul, MulOpposite.unop_mul] at *
    rw [LinearMap.rTensor_mul, LinearMap.lTensor_mul, Module.End.mul_apply, Module.End.mul_apply,
      hq, ← LinearMap.comp_apply, LinearMap.rTensor_comp_lTensor, ← LinearMap.lTensor_comp_rTensor,
      LinearMap.comp_apply, hp]
  add_mem' {p q} hp hq := by
    simp only [Set.mem_ofPred_eq, Prod.fst_add, Prod.snd_add, MulOpposite.unop_add] at *
    rw [LinearMap.rTensor_add, LinearMap.lTensor_add, LinearMap.add_apply, LinearMap.add_apply,
      hp, hq]
  algebraMap_mem' c := by
    simp only [Set.mem_ofPred_eq, Algebra.algebraMap_eq_smul_one, Prod.smul_fst, Prod.smul_snd,
      Prod.fst_one, Prod.snd_one, MulOpposite.unop_smul, MulOpposite.unop_one,
      LinearMap.rTensor_smul,
      LinearMap.lTensor_smul, LinearMap.smul_apply, Module.End.one_eq_id, LinearMap.rTensor_id,
      LinearMap.lTensor_id, LinearMap.id_apply]

/-- `(1, 1)` intertwines every `v`. -/
example (v : MixedTensor K W ι κ) : (1, 1) ∈ intertwinerAlg ι κ v := Subalgebra.one_mem _

theorem mem_intertwinerAlg {v : MixedTensor K W ι κ} {p} :
    p ∈ intertwinerAlg ι κ v ↔ p.1.rTensor _ v = p.2.unop.lTensor _ v := Iff.rfl

theorem dualMap_pow (x : Module.End K W) (n : ℕ) : (x ^ n).dualMap = x.dualMap ^ n := by
  induction n with
  | zero => ext; simp
  | succ n ih =>
    rw [pow_succ, pow_succ', ← ih]
    exact (LinearMap.dualMap_comp_dualMap _ _).symm

variable [Fintype ι] [DecidableEq ι] [Fintype κ] [DecidableEq κ]

omit [Fintype ι] [Fintype κ] [DecidableEq κ] in
theorem map_piecewise_tprod {M : Type*} [AddCommGroup M] [Module K M] (s : Finset ι)
    (f : Module.End K M) (w : ι → M) :
    PiTensorProduct.map (s.piecewise (fun _ => f) fun _ => 1) (tprod K w) =
      tprod K fun i => if i ∈ s then f (w i) else w i := by
  rw [map_tprod]
  congr 1
  funext i
  by_cases hi : i ∈ s <;> simp [hi]

omit [Fintype ι] [Fintype κ] [DecidableEq κ] in
theorem slot_mul_map_piecewise {M : Type*} [AddCommGroup M] [Module K M] {a : ι} {s : Finset ι}
    (ha : a ∉ s) (f : Module.End K M) :
    slot ι a f * PiTensorProduct.map (s.piecewise (fun _ => f) fun _ => 1) =
      PiTensorProduct.map ((insert a s).piecewise (fun _ => f) fun _ => 1) := by
  ext w
  simp only [LinearMap.compMultilinearMap_apply, Module.End.mul_apply, map_piecewise_tprod,
    slot_tprod]
  congr 1
  funext i
  by_cases hia : i = a
  · subst hia; simp [ha]
  · simp [hia]

omit [Fintype ι] [Fintype κ] [DecidableEq κ] in
theorem map_piecewise_mul_slot {M : Type*} [AddCommGroup M] [Module K M] {a : ι} {s : Finset ι}
    (ha : a ∉ s) (f : Module.End K M) :
    PiTensorProduct.map (s.piecewise (fun _ => f) fun _ => 1) * slot ι a f =
      PiTensorProduct.map ((insert a s).piecewise (fun _ => f) fun _ => 1) := by
  ext w
  simp only [LinearMap.compMultilinearMap_apply, Module.End.mul_apply, map_piecewise_tprod,
    slot_tprod]
  congr 1
  funext i
  by_cases hia : i = a
  · subst hia; simp [ha]
  · simp [hia]

open MvPolynomial in
open scoped IsMulCommutative in
set_option synthInstance.maxHeartbeats 200000 in
/-- **`gl(W)`-invariance gives the diagonal pairs.** If `|ι| = |κ|` and `v` is `gl(W)`-invariant,
then `(x^{⊗ι} ⊗ 1) v = (1 ⊗ (xᵀ)^{⊗κ}) v` for every `x ∈ End W`. The slot operators `x` in slot
`i` (paired with `xᵀ` in slot `e i`) commute; their power sums are the derivation actions of
`x^j`, which fix `v` by hypothesis, and their product is `x^{⊗ι}`, which Newton's identities
express through the power sums. -/
theorem tensorPow_mem_intertwinerAlg [CharZero K] (e : ι ≃ κ) {v : MixedTensor K W ι κ}
    (hv : v ∈ LieModule.maxTrivSubmodule K (Module.End K W) (MixedTensor K W ι κ))
    (x : Module.End K W) :
    (tensorPow ι x, MulOpposite.op (tensorPow κ x.dualMap)) ∈ intertwinerAlg ι κ v := by
  set P := intertwinerAlg ι κ v
  have hX (X : Module.End K W) :
      (tensorDer ι X, MulOpposite.op (tensorDer κ X.dualMap)) ∈ P := by
    have := (LieModule.mem_maxTrivSubmodule K _ _ v).mp hv X
    rw [lie_mixedTensor, mixedLie_apply, sub_eq_zero] at this
    exact this
  let y : ι → Module.End K (⨂[K] _ : ι, W) × (Module.End K (⨂[K] _ : κ, Module.Dual K W))ᵐᵒᵖ :=
    fun i => (slot ι i x, MulOpposite.op (slot κ (e i) x.dualMap))
  have hcomm : (Set.range y).Pairwise Commute := by
    rintro _ ⟨i, rfl⟩ _ ⟨j, rfl⟩ hne
    have hij : i ≠ j := fun h => hne (h ▸ rfl)
    refine Prod.ext (commute_slot i j x x hij).eq ?_
    apply MulOpposite.unop_injective
    exact (commute_slot (e j) (e i) _ _ (e.injective.ne (Ne.symm hij))).eq
  set S := Algebra.adjoin K (Set.range y)
  have : IsMulCommutative S := Algebra.isMulCommutative_adjoin K hcomm
  let y' : ι → S := fun i => ⟨y i, Algebra.subset_adjoin ⟨i, rfl⟩⟩
  have hpsum (j : ℕ) : aeval y' (psum ι K j) ∈ P.comap S.val := by
    rw [Subalgebra.mem_comap]
    have : S.val (aeval y' (psum ι K j)) =
        (tensorDer ι (x ^ j), MulOpposite.op (tensorDer κ (x ^ j).dualMap)) := by
      have hy (i : ι) : y i ^ j =
          (slot ι i (x ^ j), MulOpposite.op (slot κ (e i) (x ^ j).dualMap)) := by
        simp only [y, Prod.pow_mk, ← MulOpposite.op_pow, slot_pow, dualMap_pow]
      simp only [psum, map_sum, map_pow, aeval_X]
      refine Prod.ext ?_ ?_
      · simp only [Prod.fst_sum, Subalgebra.coe_val, y', hy, tensorDer_apply]
      · apply MulOpposite.unop_injective
        simp only [Prod.snd_sum, Finset.unop_sum, Subalgebra.coe_val, y', hy, MulOpposite.unop_op,
          tensorDer_apply]
        exact e.sum_comp (fun k => slot κ k (x ^ j).dualMap)
    rw [this]
    exact hX _
  have hesymm : aeval y' (esymm ι K (Fintype.card ι)) ∈ P.comap S.val := by
    have h := esymm_mem_adjoin_psum ι K (Fintype.card ι)
    have : (Algebra.adjoin K (Set.range (psum ι K))).map (aeval y') ≤ P.comap S.val := by
      rw [AlgHom.map_adjoin, Algebra.adjoin_le_iff]
      rintro _ ⟨_, ⟨j, rfl⟩, rfl⟩
      exact hpsum j
    exact this (Subalgebra.mem_map.mpr ⟨_, h, rfl⟩)
  have hprod (s : Finset ι) : S.val (∏ i ∈ s, y' i) =
      (PiTensorProduct.map (s.piecewise (fun _ => x) fun _ => 1),
        MulOpposite.op (PiTensorProduct.map
          ((s.map e.toEmbedding).piecewise (fun _ => x.dualMap) fun _ => 1))) := by
    induction s using Finset.induction_on with
    | empty =>
      simp only [Finset.prod_empty, map_one, Finset.piecewise_empty, Finset.map_empty]
      refine Prod.ext ?_ ?_
      · exact PiTensorProduct.map_one.symm
      · apply MulOpposite.unop_injective
        exact PiTensorProduct.map_one.symm
    | insert a s ha ih =>
      rw [Finset.prod_insert ha, map_mul, ih]
      refine Prod.ext ?_ ?_
      · exact slot_mul_map_piecewise ha x
      · apply MulOpposite.unop_injective
        simp only [Prod.snd_mul, MulOpposite.unop_mul, MulOpposite.unop_op, y', y,
          Subalgebra.coe_val]
        rw [Finset.map_insert]
        exact map_piecewise_mul_slot (by simpa using ha) _
  rw [esymm_card, map_prod] at hesymm
  simp only [aeval_X] at hesymm
  rw [Subalgebra.mem_comap, hprod, Finset.piecewise_univ,
    Finset.map_univ_equiv, Finset.piecewise_univ] at hesymm
  exact hesymm

end Intertwiner

section Main

variable {K W ι κ : Type*} [Field K] [CharZero K] [AddCommGroup W] [Module K W]
  [FiniteDimensional K W] [Fintype ι] [DecidableEq ι] [Fintype κ] [DecidableEq κ]

/-- **`gl(W)`-invariants equal `GL(W)`-invariants.** Over a field of characteristic zero, the
vectors of `W^{⊗ι} ⊗ (W^∨)^{⊗κ}` killed by every `X ∈ gl(W)` are exactly the vectors fixed by
every `g ∈ GL(W)`.

The route is the commutant one. `GL ⇒ gl`: the linear coefficient of the polynomial
`t ↦ (1 + t X) · v` (`mem_maxTrivSubmodule_of_mem_invariants`). `gl ⇒ GL`: when `|ι| = |κ|`, the
pairs `(a, b)` with `(a ⊗ 1) v = (1 ⊗ b) v` form an algebra containing the derivation pairs, and
Newton's identities put `(x^{⊗ι}, (xᵀ)^{⊗κ})` in the algebra the derivation pairs generate
(`tensorPow_mem_intertwinerAlg`); when `|ι| ≠ |κ|`, the identity of `W` acts by
`|ι| - |κ| ≠ 0`.

Source: Goodman–Wallach, *Symmetry, Representations, and Invariants*, GTM 255, Ch. 4–5
(invariants of a connected group and of its Lie algebra; the first fundamental theorem for
`GL(V)`); Procesi, *Lie Groups*, Ch. 9. -/
theorem maxTrivSubmodule_eq_invariants :
    (LieModule.maxTrivSubmodule K (Module.End K W) (MixedTensor K W ι κ) :
      Submodule K (MixedTensor K W ι κ)) = (mixedRep K W ι κ).invariants := by
  ext v
  rw [LieSubmodule.mem_toSubmodule]
  refine ⟨fun hv => ?_, mem_maxTrivSubmodule_of_mem_invariants⟩
  by_cases h : Fintype.card ι = Fintype.card κ
  · rw [mem_invariants_mixedRep_iff]
    intro g
    exact tensorPow_mem_intertwinerAlg (Fintype.equivOfCardEq h) hv _
  · have h1 := (LieModule.mem_maxTrivSubmodule K _ _ v).mp hv 1
    have hd : (1 : Module.End K W).dualMap = 1 := LinearMap.dualMap_id
    rw [lie_mixedTensor, mixedLie_apply, tensorDer_one, hd, tensorDer_one] at h1
    simp only [LinearMap.rTensor_smul, LinearMap.lTensor_smul, LinearMap.smul_apply,
      rTensor_one_apply, lTensor_one_apply, ← sub_smul] at h1
    have hne : (Fintype.card ι : K) - Fintype.card κ ≠ 0 := by
      rw [sub_ne_zero]
      exact_mod_cast h
    rw [smul_eq_zero_iff_right hne] at h1
    rw [h1]
    exact Submodule.zero_mem _

/-- **The first fundamental theorem for `gl(W)`.** The `gl(W)`-invariants of
`W^{⊗ι} ⊗ (W^∨)^{⊗ι}` are the span of the permutation contractions `c_π`.

Source: Goodman–Wallach, *Symmetry, Representations, and Invariants*, GTM 255, Ch. 5 (first
fundamental theorem for `GL(V)`, tensor form); Procesi, *Lie Groups*, Ch. 9. -/
theorem maxTriv_mixedLie_eq_span_contraction :
    (LieModule.maxTrivSubmodule K (Module.End K W) (MixedTensor K W ι ι) :
      Submodule K (MixedTensor K W ι ι)) = Submodule.span K (Set.range (contraction K W ι)) := by
  rw [maxTrivSubmodule_eq_invariants, invariants_mixedRep_eq_span_contraction]

/-- No `gl(W)`-invariants in unequal degrees.

Source: Goodman–Wallach, GTM 255, Ch. 5 (first fundamental theorem for `GL(V)`, the case
`k ≠ l`). -/
theorem maxTriv_mixedLie_eq_bot (h : Fintype.card ι ≠ Fintype.card κ) :
    LieModule.maxTrivSubmodule K (Module.End K W) (MixedTensor K W ι κ) = ⊥ := by
  rw [← LieSubmodule.toSubmodule_eq_bot, maxTrivSubmodule_eq_invariants,
    invariants_mixedRep_eq_bot h]

/-- `k = 1`: the `gl(W)`-invariants of `W ⊗ W^∨ ≃ End W` are the line through the identity. -/
example : (LieModule.maxTrivSubmodule K (Module.End K W) (MixedTensor K W (Fin 1) (Fin 1)) :
    Submodule K (MixedTensor K W (Fin 1) (Fin 1))) = K ∙ contraction K W (Fin 1) 1 := by
  rw [maxTrivSubmodule_eq_invariants, invariants_mixedRep_fin_one]

end Main

section AntisymTensor

variable {K M : Type*} [Field K] [AddCommGroup M] [Module K M] {ι : Type*} [Fintype ι]
  [DecidableEq ι]

variable (K M ι) in
/-- The antisymmetrization `v ↦ ∑_σ sign σ • v_{σ 1} ⊗ ⋯ ⊗ v_{σ n}`, an alternating map into the
tensor power: the composite of `⋀^ι M → ⨂^ι M` with `v ↦ v₁ ∧ ⋯ ∧ vₙ`.

Source: Goodman–Wallach, *Symmetry, Representations, and Invariants*, GTM 255, Ch. 4 (skew
tensors as the image of the antisymmetrizer); Fulton–Harris, *Representation Theory*, Appendix B. -/
def antisymTensor : M [⋀^ι]→ₗ[K] ⨂[K] _ : ι, M :=
  MultilinearMap.alternatization (tprod K)

theorem antisymTensor_apply (v : ι → M) :
    antisymTensor K M ι v =
      ∑ σ : Equiv.Perm ι, (Equiv.Perm.sign σ : ℤ) • tprod K (fun i => v (σ i)) := by
  simp [antisymTensor, MultilinearMap.alternatization_apply, Units.smul_def]

/-- On two factors: `a ⊗ b - b ⊗ a`. -/
example (a b : M) :
    antisymTensor K M (Fin 2) ![a, b] = tprod K ![a, b] - tprod K ![b, a] := by
  have : (Finset.univ : Finset (Equiv.Perm (Fin 2))) = {1, Equiv.swap 0 1} := by decide
  rw [antisymTensor_apply, this, Finset.sum_pair (by decide)]
  simp only [Equiv.Perm.sign_one, Equiv.Perm.sign_swap (show (0 : Fin 2) ≠ 1 by decide),
    Units.val_one, one_smul, Equiv.Perm.one_apply]
  rw [Units.val_neg, Units.val_one, neg_smul, one_smul, ← sub_eq_add_neg]
  congr 2
  funext i
  fin_cases i <;> rfl

/-- The derivation action on an antisymmetrized tensor is the sum over the slots. -/
theorem tensorDer_antisymTensor (X : Module.End K M) (v : ι → M) :
    tensorDer ι X (antisymTensor K M ι v) =
      ∑ i, antisymTensor K M ι (Function.update v i (X (v i))) := by
  simp only [antisymTensor_apply, map_sum, map_zsmul, tensorDer_tprod]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun σ _ => ?_
  simp only [← Int.cast_smul_eq_zsmul K]
  rw [Finset.smul_sum]
  refine (Fintype.sum_equiv σ _ _ fun i => ?_)
  congr 2
  funext j
  by_cases h : j = i
  · subst h; simp
  · simp [Function.update_of_ne h, Function.update_of_ne (σ.injective.ne h)]

/-- **The derivation action on the antisymmetrization of a basis is the trace.** -/
theorem tensorDer_antisymTensor_basis (b : Basis ι K M) (X : Module.End K M) :
    tensorDer ι X (antisymTensor K M ι b) = LinearMap.trace K M X • antisymTensor K M ι b := by
  rw [tensorDer_antisymTensor, LinearMap.trace_eq_matrix_trace K b, Matrix.trace, Finset.sum_smul]
  refine Finset.sum_congr rfl fun i _ => ?_
  have h : antisymTensor K M ι (Function.update b i (X (b i))) =
      (antisymTensor K M ι).toMultilinearMap.toLinearMap b i (X (b i)) := rfl
  rw [h, ← b.sum_repr (X (b i)), map_sum, Finset.sum_eq_single i]
  · rw [map_smul, MultilinearMap.toLinearMap_apply, Function.update_eq_self,
      Matrix.diag_apply, LinearMap.toMatrix_apply]
    rfl
  · intro j _ hj
    rw [map_smul, MultilinearMap.toLinearMap_apply]
    rw [AlternatingMap.coe_multilinearMap, (antisymTensor K M ι).map_eq_zero_of_eq _
      (i := i) (j := j) (by simp [Function.update_of_ne hj]) (Ne.symm hj), smul_zero]
  · exact fun h => absurd (Finset.mem_univ i) h

/-- **Independence of the basis.** Another basis changes the antisymmetrization by the
determinant of the change of basis. -/
theorem antisymTensor_basis_eq_smul (b b' : Basis ι K M) :
    antisymTensor K M ι b' = b.det b' • antisymTensor K M ι b := by
  rw [← sub_eq_zero, ← Module.forall_dual_apply_eq_zero_iff K]
  intro ℓ
  have := (ℓ.compAlternatingMap (antisymTensor K M ι)).eq_smul_basis_det b
  have h := congr($this b')
  simp only [LinearMap.compAlternatingMap_apply, smul_apply, smul_eq_mul] at h
  rw [map_sub, map_smul, h, smul_eq_mul, mul_comm, sub_self]

/-- **The pairing of the two antisymmetrizations is `n!`.** -/
theorem dualDistrib_antisymTensor (b : Basis ι K M) :
    dualDistrib (antisymTensor K (Module.Dual K M) ι b.dualBasis) (antisymTensor K M ι b) =
      (Fintype.card ι).factorial := by
  simp only [antisymTensor_apply, map_sum, map_zsmul, LinearMap.sum_apply, LinearMap.smul_apply,
    dualDistrib_apply, Basis.dualBasis_apply_self]
  have h (σ τ : Equiv.Perm ι) : (∏ i, if σ i = τ i then (1 : K) else 0) =
      if σ = τ then 1 else 0 := by
    split_ifs with hst
    · subst hst; simp
    · obtain ⟨i, hi⟩ := not_forall.mp fun h => hst (Equiv.ext h)
      exact Finset.prod_eq_zero (Finset.mem_univ i) (ite_eq_right_iff.mpr fun h => absurd h hi)
  simp only [h, smul_ite, smul_zero, Finset.sum_ite_eq, Finset.mem_univ, ite_true]
  simp only [smul_smul, ← Units.val_mul, Int.units_mul_self, Units.val_one, one_smul,
    Finset.sum_const, Finset.card_univ, Fintype.card_perm, nsmul_eq_mul, mul_one]

end AntisymTensor

section DetTensor

variable (K W : Type*) [Field K] [AddCommGroup W] [Module K W] [FiniteDimensional K W]

/-- The determinant tensor `ε ∈ (W^∨)^{⊗N}`, `N = finrank K W`: the image of the nonzero vector
`e^∨_1 ∧ ⋯ ∧ e^∨_N ∈ ⋀^N W^∨` (for the dual of the basis `Module.finBasis`) under the
antisymmetrization `⋀^N W^∨ → (W^∨)^{⊗N}`. Another basis changes it by a nonzero scalar
(`antisymTensor_dualBasis_eq_smul_detTensor`).

Source: Goodman–Wallach, *Symmetry, Representations, and Invariants*, GTM 255, Ch. 5 (the
determinant in the first fundamental theorem for `SL(V)`); Procesi, *Lie Groups*, Ch. 11. -/
def detTensor : ⨂[K] _ : Fin (finrank K W), Module.Dual K W :=
  exteriorPower.toTensorPower K (Module.Dual K W) (finrank K W)
    (exteriorPower.ιMulti K (finrank K W) (Module.finBasis K W).dualBasis)

/-- The dual determinant tensor `ε^∨ ∈ W^{⊗N}`: the antisymmetrization of `e_1 ∧ ⋯ ∧ e_N`.

Source: Goodman–Wallach, GTM 255, Ch. 5; Procesi, *Lie Groups*, Ch. 11. -/
def detTensorDual : ⨂[K] _ : Fin (finrank K W), W :=
  exteriorPower.toTensorPower K W (finrank K W)
    (exteriorPower.ιMulti K (finrank K W) (Module.finBasis K W))

variable {K W}

theorem detTensor_eq :
    detTensor K W = antisymTensor K _ _ (Module.finBasis K W).dualBasis := by
  rw [detTensor, exteriorPower.toTensorPower_apply_ιMulti, antisymTensor_apply]
  simp [Units.smul_def]

theorem detTensorDual_eq : detTensorDual K W = antisymTensor K _ _ (Module.finBasis K W) := by
  rw [detTensorDual, exteriorPower.toTensorPower_apply_ιMulti, antisymTensor_apply]
  simp [Units.smul_def]

theorem trace_dualMap (X : Module.End K W) :
    LinearMap.trace K (Module.Dual K W) X.dualMap = LinearMap.trace K W X :=
  LinearMap.trace_transpose' X

/-- **`ε^∨` is `sl(W)`-invariant**: the derivation action of `X` on it is multiplication by
`trace X`. -/
theorem tensorDer_detTensorDual (X : Module.End K W) :
    tensorDer _ X (detTensorDual K W) = LinearMap.trace K W X • detTensorDual K W := by
  rw [detTensorDual_eq, tensorDer_antisymTensor_basis]

/-- **`ε` is `sl(W)`-invariant**: `Xᵀ` acts on it by `trace X`, so `-Xᵀ` by `-trace X`. -/
theorem tensorDer_detTensor (X : Module.End K W) :
    tensorDer _ X.dualMap (detTensor K W) = LinearMap.trace K W X • detTensor K W := by
  rw [detTensor_eq, tensorDer_antisymTensor_basis, trace_dualMap]

/-- **The pairing `⟨ε, ε^∨⟩ = N!`.** -/
theorem dualDistrib_detTensor_detTensorDual :
    dualDistrib (detTensor K W) (detTensorDual K W) = (finrank K W).factorial := by
  rw [detTensor_eq, detTensorDual_eq, dualDistrib_antisymTensor, Fintype.card_fin]

/-- **`ε^∨` spans a line independent of the basis**: the antisymmetrization of any basis indexed
by `Fin N` is a nonzero multiple of `ε^∨`. -/
theorem antisymTensor_eq_smul_detTensorDual (b : Basis (Fin (finrank K W)) K W) :
    ∃ c : K, c ≠ 0 ∧ antisymTensor K W _ b = c • detTensorDual K W :=
  ⟨_, (Module.finBasis K W).isUnit_det b |>.ne_zero, by
    rw [detTensorDual_eq, antisymTensor_basis_eq_smul]⟩

/-- **`ε` spans a line independent of the basis.** -/
theorem antisymTensor_dualBasis_eq_smul_detTensor (b : Basis (Fin (finrank K W)) K W) :
    ∃ c : K, c ≠ 0 ∧ antisymTensor K _ _ b.dualBasis = c • detTensor K W :=
  ⟨_, (Module.finBasis K W).dualBasis.isUnit_det b.dualBasis |>.ne_zero, by
    rw [detTensor_eq, antisymTensor_basis_eq_smul]⟩

/-- A traceless `X` kills `ε^∨`. -/
example (X : Module.End K W) (hX : LinearMap.trace K W X = 0) :
    tensorDer _ X (detTensorDual K W) = 0 := by
  rw [tensorDer_detTensorDual, hX, zero_smul]

/-- A traceless `X` kills `ε` (for the action `-Xᵀ`). -/
example (X : Module.End K W) (hX : LinearMap.trace K W X = 0) :
    tensorDer _ (dualLie K W X) (detTensor K W) = 0 := by
  rw [dualLie_apply, map_neg, LinearMap.neg_apply, tensorDer_detTensor, hX, zero_smul, neg_zero]

variable [CharZero K]

theorem detTensor_ne_zero : detTensor K W ≠ 0 := by
  intro h
  have := dualDistrib_detTensor_detTensorDual (K := K) (W := W)
  rw [h, map_zero, LinearMap.zero_apply] at this
  exact (Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero _)) this.symm

theorem detTensorDual_ne_zero : detTensorDual K W ≠ 0 := by
  intro h
  have := dualDistrib_detTensor_detTensorDual (K := K) (W := W)
  rw [h, map_zero] at this
  exact (Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero _)) this.symm

end DetTensor

section SumSlots

variable {K M : Type*} [Field K] [AddCommGroup M] [Module K M] {ι ι₂ : Type*}
  [Fintype ι] [DecidableEq ι] [Fintype ι₂] [DecidableEq ι₂]

/-- The derivation action on `M^{⊗(ι ⊕ ι₂)} ≃ M^{⊗ι} ⊗ M^{⊗ι₂}` is the sum of the two
actions (the Leibniz rule). -/
theorem tensorDer_tmulEquiv (X : Module.End K M) (s : ⨂[K] _ : ι, M) (t : ⨂[K] _ : ι₂, M) :
    tensorDer (ι ⊕ ι₂) X (tmulEquiv K M (s ⊗ₜ t)) =
      tmulEquiv K M (tensorDer ι X s ⊗ₜ t) + tmulEquiv K M (s ⊗ₜ tensorDer ι₂ X t) := by
  have : tensorDer (ι ⊕ ι₂) X ∘ₗ (tmulEquiv K M).toLinearMap =
      (tmulEquiv K M).toLinearMap ∘ₗ
        ((tensorDer ι X).rTensor _ + (tensorDer ι₂ X).lTensor _) := by
    ext a b
    simp only [LinearMap.compMultilinearMap_apply, TensorProduct.AlgebraTensorModule.curry_apply,
      TensorProduct.curry_apply, LinearMap.restrictScalars_apply, LinearMap.coe_comp,
      Function.comp_apply, LinearEquiv.coe_coe, tmulEquiv_apply, LinearMap.add_apply,
      LinearMap.rTensor_tmul, LinearMap.lTensor_tmul, tensorDer_tprod, TensorProduct.sum_tmul,
      TensorProduct.tmul_sum, Fintype.sum_sum_type]
    rw [map_add, map_sum, map_sum]
    congr 1 <;> refine Finset.sum_congr rfl fun i _ => ?_ <;> rw [tmulEquiv_apply] <;> congr 1 <;>
      funext j <;> rcases j with j | j <;> simp [Function.update_apply]
  simpa using congr($this (s ⊗ₜ t))

end SumSlots

section DualDistrib

variable {K W : Type*} [Field K] [AddCommGroup W] [Module K W] {ι ι₂ : Type*}
  [Fintype ι] [Fintype ι₂]

theorem dualDistrib_tmulEquiv_tprod (T : ⨂[K] _ : ι, Module.Dual K W)
    (D : ⨂[K] _ : ι₂, Module.Dual K W) (g : ι ⊕ ι₂ → W) :
    dualDistrib (tmulEquiv K (Module.Dual K W) (T ⊗ₜ D)) (tprod K g) =
      dualDistrib T (tprod K (g ∘ Sum.inl)) * dualDistrib D (tprod K (g ∘ Sum.inr)) := by
  have : LinearMap.applyₗ (tprod K g) ∘ₗ dualDistrib ∘ₗ
        (tmulEquiv K (Module.Dual K W)).toLinearMap =
      LinearMap.mul' K K ∘ₗ TensorProduct.map
        (LinearMap.applyₗ (tprod K (g ∘ Sum.inl)) ∘ₗ dualDistrib)
        (LinearMap.applyₗ (tprod K (g ∘ Sum.inr)) ∘ₗ dualDistrib) := by
    ext a b
    simp [Fintype.prod_sum_type]
  simpa using congr($this (T ⊗ₜ D))

/-- The pairing of `W^{⊗(ι ⊕ ι₂)}` with its dual is the product of the pairings. -/
theorem dualDistrib_tmulEquiv (T : ⨂[K] _ : ι, Module.Dual K W)
    (D : ⨂[K] _ : ι₂, Module.Dual K W) (t : ⨂[K] _ : ι, W) (d : ⨂[K] _ : ι₂, W) :
    dualDistrib (tmulEquiv K (Module.Dual K W) (T ⊗ₜ D)) (tmulEquiv K W (t ⊗ₜ d)) =
      dualDistrib T t * dualDistrib D d := by
  have : dualDistrib (tmulEquiv K (Module.Dual K W) (T ⊗ₜ D)) ∘ₗ (tmulEquiv K W).toLinearMap =
      LinearMap.mul' K K ∘ₗ TensorProduct.map (dualDistrib T) (dualDistrib D) := by
    ext a b
    simp [dualDistrib_tmulEquiv_tprod]
  simpa using congr($this (t ⊗ₜ d))

end DualDistrib

section SpecialLinear

variable (K W : Type*) [Field K] [AddCommGroup W] [Module K W] [FiniteDimensional K W]

/-- The special linear Lie algebra `sl(W) = {X ∈ gl(W) | trace X = 0}`.

Source: Fulton–Harris, *Representation Theory*, §8.1 and Lecture 15; Goodman–Wallach, GTM 255,
Ch. 2. -/
def slEnd : LieSubalgebra K (Module.End K W) where
  toSubmodule := LinearMap.ker (LinearMap.trace K W)
  lie_mem' {X Y} _ _ := by
    change ⁅X, Y⁆ ∈ LinearMap.ker (LinearMap.trace K W)
    rw [LinearMap.mem_ker, Ring.lie_def, map_sub, LinearMap.trace_mul_comm, sub_self]

variable {K W}

omit [FiniteDimensional K W] in
theorem mem_slEnd {X : Module.End K W} : X ∈ slEnd K W ↔ LinearMap.trace K W X = 0 :=
  LinearMap.mem_ker

/-- Commutators are traceless. -/
example (X Y : Module.End K W) : ⁅X, Y⁆ ∈ slEnd K W := by
  rw [mem_slEnd, Ring.lie_def, map_sub, LinearMap.trace_mul_comm, sub_self]

end SpecialLinear

section Blocks

/-- The index of `m` blocks of `n` slots, `Fin n ⊕ (Fin n ⊕ ⋯ ⊕ Empty)`: the slots of the `m`-th
tensor power of a determinant tensor (`detPow`). It has `m * n` elements (`card_blocks`).

Source: Goodman–Wallach, GTM 255, Ch. 5 (the first fundamental theorem for `SL(V)`, products of
determinants). -/
def Blocks (n : ℕ) : ℕ → Type
  | 0 => Empty
  | m + 1 => Fin n ⊕ Blocks n m

instance instFintypeBlocks (n : ℕ) : (m : ℕ) → Fintype (Blocks n m)
  | 0 => inferInstanceAs (Fintype Empty)
  | m + 1 => letI := instFintypeBlocks n m; inferInstanceAs (Fintype (Fin n ⊕ Blocks n m))

instance instDecidableEqBlocks (n : ℕ) : (m : ℕ) → DecidableEq (Blocks n m)
  | 0 => inferInstanceAs (DecidableEq Empty)
  | m + 1 => letI := instDecidableEqBlocks n m; inferInstanceAs (DecidableEq (Fin n ⊕ Blocks n m))

instance (n : ℕ) : IsEmpty (Blocks n 0) := inferInstanceAs (IsEmpty Empty)

theorem card_blocks (n m : ℕ) : Fintype.card (Blocks n m) = m * n := by
  induction m with
  | zero => rw [zero_mul]; exact Fintype.card_eq_zero (α := Blocks n 0)
  | succ m ih =>
    change Fintype.card (Fin n ⊕ Blocks n m) = _
    rw [Fintype.card_sum, ih, Fintype.card_fin]
    ring

/-- One block. -/
example (n : ℕ) : Fintype.card (Blocks n 1) = n := by simp [card_blocks]

end Blocks

section DetPow

variable (K W : Type*) [Field K] [AddCommGroup W] [Module K W] [FiniteDimensional K W]

/-- `ε^{⊗m} ∈ (W^∨)^{⊗(m N)}`, the `m`-th tensor power of the determinant tensor, with slots
`Blocks N m`: `ε ⊗ ε^{⊗(m-1)}` under `tmulEquiv`.

Source: Goodman–Wallach, GTM 255, Ch. 5; Procesi, *Lie Groups*, Ch. 11. -/
def detPow : (m : ℕ) → ⨂[K] _ : Blocks (finrank K W) m, Module.Dual K W
  | 0 => tprod K fun _ => 0
  | m + 1 => tmulEquiv K (Module.Dual K W) (detTensor K W ⊗ₜ detPow m)

/-- `(ε^∨)^{⊗m} ∈ W^{⊗(m N)}`.

Source: Goodman–Wallach, GTM 255, Ch. 5; Procesi, *Lie Groups*, Ch. 11. -/
def detPowDual : (m : ℕ) → ⨂[K] _ : Blocks (finrank K W) m, W
  | 0 => tprod K fun _ => 0
  | m + 1 => tmulEquiv K W (detTensorDual K W ⊗ₜ detPowDual m)

variable {K W}

/-- `(ε^∨)^{⊗1} = ε^∨ ⊗ 1`. -/
example : detPowDual K W 1 = tmulEquiv K W (detTensorDual K W ⊗ₜ detPowDual K W 0) := rfl

/-- `ε^{⊗1} = ε ⊗ 1`. -/
example : detPow K W 1 = tmulEquiv K (Module.Dual K W) (detTensor K W ⊗ₜ detPow K W 0) := rfl

theorem tensorDer_blocks_zero {M : Type*} [AddCommGroup M] [Module K M] (n : ℕ)
    (X : Module.End K M) : tensorDer (Blocks n 0) X = 0 := by
  rw [tensorDer_apply, Finset.univ_eq_empty, Finset.sum_empty]

theorem tensorDer_detPowDual (X : Module.End K W) (m : ℕ) :
    tensorDer _ X (detPowDual K W m) = ((m : K) * LinearMap.trace K W X) • detPowDual K W m := by
  induction m with
  | zero => simp [tensorDer_blocks_zero]
  | succ m ih =>
    change tensorDer (Fin _ ⊕ Blocks _ m) X (tmulEquiv K W (detTensorDual K W ⊗ₜ detPowDual K W m))
      = ((↑(m + 1) : K) * LinearMap.trace K W X) •
        tmulEquiv K W (detTensorDual K W ⊗ₜ detPowDual K W m)
    rw [tensorDer_tmulEquiv, tensorDer_detTensorDual, ih, ← TensorProduct.smul_tmul',
      TensorProduct.tmul_smul, map_smul, map_smul, ← add_smul]
    congr 1
    push_cast
    ring

theorem tensorDer_detPow (X : Module.End K W) (m : ℕ) :
    tensorDer _ X.dualMap (detPow K W m) = ((m : K) * LinearMap.trace K W X) • detPow K W m := by
  induction m with
  | zero => simp [tensorDer_blocks_zero]
  | succ m ih =>
    change tensorDer (Fin _ ⊕ Blocks _ m) X.dualMap
      (tmulEquiv K (Module.Dual K W) (detTensor K W ⊗ₜ detPow K W m)) =
        ((↑(m + 1) : K) * LinearMap.trace K W X) •
          tmulEquiv K (Module.Dual K W) (detTensor K W ⊗ₜ detPow K W m)
    rw [tensorDer_tmulEquiv, tensorDer_detTensor, ih, ← TensorProduct.smul_tmul',
      TensorProduct.tmul_smul, map_smul, map_smul, ← add_smul]
    congr 1
    push_cast
    ring

/-- **`⟨ε^{⊗m}, (ε^∨)^{⊗m}⟩ = (N!)^m`.** -/
theorem dualDistrib_detPow (m : ℕ) :
    dualDistrib (detPow K W m) (detPowDual K W m) = ((finrank K W).factorial : K) ^ m := by
  induction m with
  | zero => simp [detPow, detPowDual]
  | succ m ih =>
    change dualDistrib (tmulEquiv K (Module.Dual K W) (detTensor K W ⊗ₜ detPow K W m))
      (tmulEquiv K W (detTensorDual K W ⊗ₜ detPowDual K W m)) = _
    rw [dualDistrib_tmulEquiv, dualDistrib_detTensor_detTensorDual, ih, pow_succ, mul_comm]

end DetPow

section Extend

variable {K W : Type*} [Field K] [AddCommGroup W] [Module K W] {ι κ J : Type*}

/-- `x ↦ x ⊗ D`: append `D ∈ (W^∨)^{⊗J}` in the dual slots `J`,
`W^{⊗ι} ⊗ (W^∨)^{⊗κ} → W^{⊗ι} ⊗ (W^∨)^{⊗(κ ⊕ J)}`.

Source: Goodman–Wallach, GTM 255, Ch. 5 (products of invariant tensors). -/
def extendDual (D : ⨂[K] _ : J, Module.Dual K W) :
    MixedTensor K W ι κ →ₗ[K] MixedTensor K W ι (κ ⊕ J) :=
  ((tmulEquiv K (Module.Dual K W)).toLinearMap ∘ₗ (TensorProduct.mk K _ _).flip D).lTensor _

theorem extendDual_tmul (D : ⨂[K] _ : J, Module.Dual K W) (t : ⨂[K] _ : ι, W)
    (u : ⨂[K] _ : κ, Module.Dual K W) :
    extendDual D (t ⊗ₜ u) = t ⊗ₜ tmulEquiv K (Module.Dual K W) (u ⊗ₜ D) :=
  rfl

/-- `v ↦ v ⊗ D'`: append `D' ∈ W^{⊗J}` in the slots `J`,
`W^{⊗ι} ⊗ (W^∨)^{⊗κ} → W^{⊗(ι ⊕ J)} ⊗ (W^∨)^{⊗κ}`.

Source: Goodman–Wallach, GTM 255, Ch. 5. -/
def extendVec (D' : ⨂[K] _ : J, W) : MixedTensor K W ι κ →ₗ[K] MixedTensor K W (ι ⊕ J) κ :=
  ((tmulEquiv K W).toLinearMap ∘ₗ (TensorProduct.mk K _ _).flip D').rTensor _

theorem extendVec_tmul (D' : ⨂[K] _ : J, W) (t : ⨂[K] _ : ι, W)
    (u : ⨂[K] _ : κ, Module.Dual K W) :
    extendVec D' (t ⊗ₜ u) = tmulEquiv K W (t ⊗ₜ D') ⊗ₜ u :=
  rfl

/-- `v ↦ v ⊗ D'` on `W ⊗ W^∨`. -/
example (D' : ⨂[K] _ : J, W) (w : W) (φ : Module.Dual K W) :
    extendVec D' (tprod K (fun _ : Fin 1 => w) ⊗ₜ tprod K (fun _ : Fin 1 => φ)) =
      tmulEquiv K W (tprod K (fun _ => w) ⊗ₜ D') ⊗ₜ tprod K (fun _ => φ) :=
  rfl

@[simp]
theorem extendDual_zero : extendDual (ι := ι) (κ := κ) (0 : ⨂[K] _ : J, Module.Dual K W) = 0 := by
  rw [extendDual, map_zero, LinearMap.comp_zero, LinearMap.lTensor_zero]

@[simp]
theorem extendVec_zero : extendVec (ι := ι) (κ := κ) (0 : ⨂[K] _ : J, W) = 0 := by
  rw [extendVec, map_zero, LinearMap.comp_zero, LinearMap.rTensor_zero]

variable [Fintype J]

/-- Contraction of the slots `J` of `W^{⊗(ι ⊕ J)}` against `D ∈ (W^∨)^{⊗J}`,
`W^{⊗(ι ⊕ J)} ⊗ (W^∨)^{⊗κ} → W^{⊗ι} ⊗ (W^∨)^{⊗κ}`.

Source: Goodman–Wallach, GTM 255, Ch. 5 (contractions of mixed tensors). -/
def contractVec (D : ⨂[K] _ : J, Module.Dual K W) :
    MixedTensor K W (ι ⊕ J) κ →ₗ[K] MixedTensor K W ι κ :=
  ((TensorProduct.rid K _).toLinearMap ∘ₗ (dualDistrib D).lTensor _ ∘ₗ
    (tmulEquiv K W).symm.toLinearMap).rTensor _

/-- Appending `D'` and contracting against `D` multiplies by `⟨D, D'⟩`. -/
theorem contractVec_extendVec (D : ⨂[K] _ : J, Module.Dual K W) (D' : ⨂[K] _ : J, W)
    (v : MixedTensor K W ι κ) : contractVec D (extendVec D' v) = dualDistrib D D' • v := by
  have : ((TensorProduct.rid K _).toLinearMap ∘ₗ (dualDistrib D).lTensor _ ∘ₗ
      (tmulEquiv K W).symm.toLinearMap) ∘ₗ
        ((tmulEquiv K W).toLinearMap ∘ₗ (TensorProduct.mk K (⨂[K] _ : ι, W) _).flip D') =
      dualDistrib D D' • LinearMap.id := by
    ext t
    simp
  rw [contractVec, extendVec, ← LinearMap.comp_apply, ← LinearMap.rTensor_comp, this,
    LinearMap.rTensor_smul, LinearMap.rTensor_id, LinearMap.smul_apply, LinearMap.id_apply]

/-- Contracting `t ⊗ D'` against `D`, on `W ⊗ W^∨`. -/
example (D : ⨂[K] _ : J, Module.Dual K W) (D' : ⨂[K] _ : J, W)
    (v : MixedTensor K W (Fin 1) (Fin 1)) :
    contractVec D (extendVec D' v) = dualDistrib D D' • v :=
  contractVec_extendVec D D' v

/-- `x ↦ x ⊗ D` on `W ⊗ W^∨`. -/
example (D : ⨂[K] _ : J, Module.Dual K W) (w : W) (φ : Module.Dual K W) :
    extendDual D (tprod K (fun _ : Fin 1 => w) ⊗ₜ tprod K (fun _ : Fin 1 => φ)) =
      tprod K (fun _ => w) ⊗ₜ tmulEquiv K _ (tprod K (fun _ => φ) ⊗ₜ D) :=
  rfl

variable [Fintype ι] [Fintype κ]

variable (κ) in
/-- The evaluation of a mixed tensor against `T ∈ (W^∨)^{⊗ι}` and `w : κ → W`:
`t ⊗ u ↦ ⟨T, t⟩ ⟨u, w₁ ⊗ ⋯ ⊗ w_k⟩`. These separate points (`ext_ev`).

Source: Goodman–Wallach, GTM 255, Ch. 5 (mixed tensors as multilinear functions). -/
def ev (T : ⨂[K] _ : ι, Module.Dual K W) (w : κ → W) : MixedTensor K W ι κ →ₗ[K] K :=
  LinearMap.mul' K K ∘ₗ
    TensorProduct.map (dualDistrib T) (LinearMap.applyₗ (tprod K w) ∘ₗ dualDistrib)

theorem ev_tmul (T : ⨂[K] _ : ι, Module.Dual K W) (w : κ → W) (t : ⨂[K] _ : ι, W)
    (u : ⨂[K] _ : κ, Module.Dual K W) :
    ev κ T w (t ⊗ₜ u) = dualDistrib T t * dualDistrib u (tprod K w) := by
  simp [ev]

/-- On `W ⊗ W^∨`, `ev` is `⟨φ, v⟩ ⟨ψ, w⟩`. -/
example (φ ψ : Module.Dual K W) (v w : W) :
    ev (Fin 1) (tprod K fun _ => φ) (fun _ => w)
      (tprod K (fun _ : Fin 1 => v) ⊗ₜ tprod K (fun _ : Fin 1 => ψ)) = φ v * ψ w := by
  simp [ev_tmul]

theorem prod_ite_eq_fun {α β : Type*} [Fintype α] [DecidableEq β] (f g : α → β) :
    (∏ i, if f i = g i then (1 : K) else 0) = if f = g then 1 else 0 := by
  split_ifs with h
  · subst h; simp
  · obtain ⟨i, hi⟩ := Function.ne_iff.mp h
    exact Finset.prod_eq_zero (Finset.mem_univ i) (by simp [hi])

theorem ev_basis {n : Type*} [Fintype n] [DecidableEq n] (b : Basis n K W)
    (p : (ι → n) × (κ → n)) (x : MixedTensor K W ι κ) :
    ev κ (tprod K fun i => b.dualBasis (p.1 i)) (fun k => b (p.2 k)) x =
      ((Basis.piTensorProduct fun _ : ι => b).tensorProduct
        (Basis.piTensorProduct fun _ : κ => b.dualBasis)).repr x p := by
  obtain ⟨p1, p2⟩ := p
  set B := (Basis.piTensorProduct fun _ : ι => b).tensorProduct
    (Basis.piTensorProduct fun _ : κ => b.dualBasis)
  have : ev κ (tprod K fun i => b.dualBasis (p1 i)) (fun k => b (p2 k)) =
      Finsupp.lapply (p1, p2) ∘ₗ B.repr.toLinearMap := by
    refine B.ext fun q => ?_
    simp only [LinearMap.coe_comp, Function.comp_apply, LinearEquiv.coe_coe, Basis.repr_self,
      Finsupp.lapply_apply, Finsupp.single_apply]
    obtain ⟨q1, q2⟩ := q
    simp only [B, Basis.tensorProduct_apply', Basis.piTensorProduct_apply, ev_tmul,
      dualDistrib_apply, Basis.dualBasis_apply_self, prod_ite_eq_fun, Prod.mk.injEq]
    by_cases h1 : q1 = p1
    · by_cases h2 : q2 = p2
      · simp [h1, h2]
      · simp [h1, h2, Ne.symm h2]
    · simp [h1]
  exact congr($this x)

/-- **The evaluations separate points.** -/
theorem ext_ev [FiniteDimensional K W] {x y : MixedTensor K W ι κ}
    (h : ∀ (φ : ι → Module.Dual K W) (w : κ → W),
      ev κ (tprod K φ) w x = ev κ (tprod K φ) w y) : x = y := by
  let b := Module.finBasis K W
  apply ((Basis.piTensorProduct fun _ : ι => b).tensorProduct
    (Basis.piTensorProduct fun _ : κ => b.dualBasis)).repr.injective
  ext p
  rw [← ev_basis, ← ev_basis, h]

theorem ev_mixedEquiv [FiniteDimensional K W] (T : ⨂[K] _ : ι, Module.Dual K W) (w : ι → W)
    (x : MixedTensor K W ι ι) :
    ev ι T w x = dualDistrib T (mixedEquiv K W ι x (tprod K w)) := by
  have : ev ι T w = dualDistrib T ∘ₗ LinearMap.applyₗ (tprod K w) ∘ₗ
      (mixedEquiv K W ι).toLinearMap := by
    ext a ψ
    simp [ev_tmul, mul_comm]
  exact congr($this x)

theorem ev_contraction [FiniteDimensional K W] (T : ⨂[K] _ : ι, Module.Dual K W) (w : ι → W)
    (π : Equiv.Perm ι) :
    ev ι T w (contraction K W ι π) = dualDistrib T (tprod K fun i => w (π.symm i)) := by
  rw [ev_mixedEquiv, mixedEquiv_contraction, permRep_tprod]

theorem ev_lTensor_permRep (T : ⨂[K] _ : ι, Module.Dual K W) (w : κ → W) (τ : Equiv.Perm κ)
    (y : MixedTensor K W ι κ) :
    ev κ T w ((permRep K (Module.Dual K W) κ τ).lTensor _ y) = ev κ T (fun k => w (τ k)) y := by
  have : ev κ T w ∘ₗ (permRep K (Module.Dual K W) κ τ).lTensor _ = ev κ T (fun k => w (τ k)) := by
    ext a ψ
    simp only [LinearMap.compMultilinearMap_apply, TensorProduct.AlgebraTensorModule.curry_apply,
      TensorProduct.curry_apply, LinearMap.restrictScalars_apply, LinearMap.coe_comp,
      Function.comp_apply, LinearMap.lTensor_tmul, permRep_tprod, ev_tmul, dualDistrib_apply]
    congr 1
    exact (Fintype.prod_equiv τ _ _ fun k => by simp).symm
  exact congr($this y)

theorem ev_extendDual (D : ⨂[K] _ : J, Module.Dual K W) (T : ⨂[K] _ : ι, Module.Dual K W)
    (w : κ ⊕ J → W) (y : MixedTensor K W ι κ) :
    ev (κ ⊕ J) T w (extendDual D y) =
      ev κ T (fun k => w (Sum.inl k)) y * dualDistrib D (tprod K fun j => w (Sum.inr j)) := by
  have : ev (κ ⊕ J) T w ∘ₗ extendDual D =
      dualDistrib D (tprod K fun j => w (Sum.inr j)) • ev κ T (fun k => w (Sum.inl k)) := by
    ext a ψ
    simp only [LinearMap.compMultilinearMap_apply, TensorProduct.AlgebraTensorModule.curry_apply,
      TensorProduct.curry_apply, LinearMap.restrictScalars_apply, LinearMap.coe_comp,
      Function.comp_apply, extendDual_tmul, ev_tmul, dualDistrib_tmulEquiv_tprod,
      LinearMap.smul_apply, smul_eq_mul]
    simp only [Function.comp_def]
    ring
  rw [mul_comm]
  exact congr($this y)

theorem ev_contractVec (D : ⨂[K] _ : J, Module.Dual K W) (T : ⨂[K] _ : ι, Module.Dual K W)
    (w : κ → W) (z : MixedTensor K W (ι ⊕ J) κ) :
    ev κ T w (contractVec D z) = ev κ (tmulEquiv K (Module.Dual K W) (T ⊗ₜ D)) w z := by
  have : ev κ T w ∘ₗ contractVec D = ev κ (tmulEquiv K (Module.Dual K W) (T ⊗ₜ D)) w := by
    ext g ψ
    simp only [contractVec, LinearMap.compMultilinearMap_apply,
      TensorProduct.AlgebraTensorModule.curry_apply, TensorProduct.curry_apply,
      LinearMap.restrictScalars_apply, LinearMap.coe_comp, Function.comp_apply,
      LinearMap.rTensor_tmul, LinearEquiv.coe_coe, tmulEquiv_symm_apply, LinearMap.lTensor_tmul,
      TensorProduct.rid_tmul, ev_tmul, map_smul, dualDistrib_tmulEquiv_tprod, smul_eq_mul]
    simp only [Function.comp_def]
    ring
  exact congr($this z)

/-- **Contracting a permutation contraction against `D`.** Contracting the slots `J` of
`c_π ∈ W^{⊗(ι ⊕ J)} ⊗ (W^∨)^{⊗(ι ⊕ J)}` against `D` gives `c_1 ⊗ D` with its dual slots permuted
by `π⁻¹`. -/
theorem contractVec_contraction [FiniteDimensional K W] (D : ⨂[K] _ : J, Module.Dual K W)
    (π : Equiv.Perm (ι ⊕ J)) :
    contractVec D (contraction K W (ι ⊕ J) π) =
      (permRep K (Module.Dual K W) (ι ⊕ J) π.symm).lTensor _
        (extendDual D (contraction K W ι 1)) := by
  refine ext_ev fun φ w => ?_
  rw [ev_contractVec, ev_contraction, dualDistrib_tmulEquiv_tprod, ev_lTensor_permRep,
    ev_extendDual, ev_contraction]
  have h1 (i : ι) : (1 : Equiv.Perm ι).symm i = i := rfl
  simp [Function.comp_def, h1]

end Extend

section LieAction

variable {K W : Type*} [Field K] [AddCommGroup W] [Module K W] {ι κ J : Type*}
  [Fintype ι] [DecidableEq ι] [Fintype κ] [DecidableEq κ] [Fintype J] [DecidableEq J]

omit [Fintype κ] [DecidableEq κ] [Fintype J] [DecidableEq J] [Fintype ι] in
/-- Permuting the factors commutes with the derivation action. -/
theorem permRep_mul_tensorDer [Fintype ι] {M : Type*} [AddCommGroup M] [Module K M]
    (τ : Equiv.Perm ι) (f : Module.End K M) :
    permRep K M ι τ * tensorDer ι f = tensorDer ι f * permRep K M ι τ := by
  ext v
  simp only [LinearMap.compMultilinearMap_apply, Module.End.mul_apply, permRep_tprod,
    tensorDer_tprod, map_sum]
  refine Fintype.sum_equiv τ _ _ fun i => ?_
  congr 1
  funext j
  by_cases h : j = τ i
  · subst h
    have e : τ.symm (τ i) = i := τ.symm_apply_apply i
    simp only [Function.update_self]
    erw [e, Function.update_self]
  · have h' : τ.symm j ≠ i := fun h'' => h (by rw [← h'', Equiv.apply_symm_apply])
    simp [Function.update_of_ne h, Function.update_of_ne h']

theorem lie_lTensor_permRep (X : Module.End K W) (τ : Equiv.Perm κ) (y : MixedTensor K W ι κ) :
    ⁅X, (permRep K (Module.Dual K W) κ τ).lTensor _ y⁆ =
      (permRep K (Module.Dual K W) κ τ).lTensor _ ⁅X, y⁆ := by
  rw [lie_mixedTensor, lie_mixedTensor, mixedLie_apply, mixedLie_apply, map_sub]
  congr 1
  · rw [← LinearMap.comp_apply, ← LinearMap.comp_apply, LinearMap.rTensor_comp_lTensor,
      LinearMap.lTensor_comp_rTensor]
  · rw [← LinearMap.comp_apply, ← LinearMap.comp_apply, ← LinearMap.lTensor_comp,
      ← LinearMap.lTensor_comp, ← Module.End.mul_eq_comp, ← Module.End.mul_eq_comp,
      permRep_mul_tensorDer]

theorem lie_extendDual (X : Module.End K W) (D : ⨂[K] _ : J, Module.Dual K W)
    (y : MixedTensor K W ι κ) :
    ⁅X, extendDual D y⁆ = extendDual D ⁅X, y⁆ - extendDual (tensorDer J X.dualMap D) y := by
  rw [lie_mixedTensor, lie_mixedTensor]
  induction y using TensorProduct.inductionOn with
  | add x y hx hy => simp only [map_add, hx, hy]; abel
  | tmul t u =>
    simp only [mixedLie_apply, map_sub, LinearMap.rTensor_tmul, LinearMap.lTensor_tmul,
      extendDual_tmul, tensorDer_tmulEquiv, TensorProduct.tmul_add]
    abel

theorem lie_extendVec (X : Module.End K W) (D' : ⨂[K] _ : J, W) (v : MixedTensor K W ι κ) :
    ⁅X, extendVec D' v⁆ = extendVec D' ⁅X, v⁆ + extendVec (tensorDer J X D') v := by
  rw [lie_mixedTensor, lie_mixedTensor]
  induction v using TensorProduct.inductionOn with
  | add x y hx hy => simp only [map_add, hx, hy]; abel
  | tmul t u =>
    simp only [mixedLie_apply, map_sub, LinearMap.rTensor_tmul, LinearMap.lTensor_tmul,
      extendVec_tmul, tensorDer_tmulEquiv, TensorProduct.add_tmul]
    abel

omit [DecidableEq ι] [DecidableEq κ] in
/-- The identity of `W` acts on `W^{⊗ι} ⊗ (W^∨)^{⊗κ}` by `|ι| - |κ|`. -/
theorem one_lie_mixedTensor [DecidableEq ι] [DecidableEq κ] (z : MixedTensor K W ι κ) :
    ⁅(1 : Module.End K W), z⁆ = ((Fintype.card ι : K) - Fintype.card κ) • z := by
  have hd : (1 : Module.End K W).dualMap = 1 := LinearMap.dualMap_id
  rw [lie_mixedTensor, mixedLie_apply, tensorDer_one, hd, tensorDer_one]
  simp only [LinearMap.rTensor_smul, LinearMap.lTensor_smul, LinearMap.smul_apply,
    rTensor_one_apply, lTensor_one_apply, ← sub_smul]

end LieAction

section SlInvariants

variable {K W : Type*} [Field K] [CharZero K] [AddCommGroup W] [Module K W]
  [FiniteDimensional K W] {ι J : Type*} [Fintype ι] [DecidableEq ι] [Fintype J] [DecidableEq J]

omit [DecidableEq J] [Fintype J] in
/-- **In equal degrees, `sl(W)`-invariants are `gl(W)`-invariants.** If `|ι| = |κ|`, the identity
of `W` acts on `W^{⊗ι} ⊗ (W^∨)^{⊗κ}` by `0`, and `gl(W) = sl(W) + K · 1` (when `N ≥ 1`; when
`N = 0` every `X` is `0`). -/
theorem mem_maxTriv_slEnd_iff {κ : Type*} [Fintype κ] [DecidableEq κ]
    (h : Fintype.card ι = Fintype.card κ) {v : MixedTensor K W ι κ} :
    v ∈ LieModule.maxTrivSubmodule K (slEnd K W) (MixedTensor K W ι κ) ↔
      v ∈ LieModule.maxTrivSubmodule K (Module.End K W) (MixedTensor K W ι κ) := by
  simp only [LieModule.mem_maxTrivSubmodule]
  refine ⟨fun hv X => ?_, fun hv X => by rw [LieSubalgebra.coe_bracket_of_module, hv]⟩
  have h0 (X : Module.End K W) (hX : X ∈ slEnd K W) : ⁅X, v⁆ = 0 := by
    have := hv ⟨X, hX⟩
    rwa [LieSubalgebra.coe_bracket_of_module] at this
  rcases eq_or_ne (finrank K W) 0 with hN | hN
  · have : Subsingleton W := Module.finrank_zero_iff.mp hN
    have hX : X = 0 := LinearMap.ext fun _ => Subsingleton.elim _ _
    rw [hX, zero_lie]
  · set c := LinearMap.trace K W X / finrank K W
    have hX0 : X - c • 1 ∈ slEnd K W := by
      rw [mem_slEnd, map_sub, map_smul, LinearMap.trace_one, smul_eq_mul,
        div_mul_cancel₀ _ (Nat.cast_ne_zero.mpr hN), sub_self]
    have h1 : ⁅(1 : Module.End K W), v⁆ = 0 := by
      rw [one_lie_mixedTensor, h, sub_self, zero_smul]
    rw [← sub_add_cancel X (c • 1), add_lie, smul_lie, h0 _ hX0, h1, smul_zero, add_zero]

omit [DecidableEq J] [Fintype J] in
/-- **The first fundamental theorem for `sl(W)` in equal degrees.** The `sl(W)`-invariants of
`W^{⊗ι} ⊗ (W^∨)^{⊗ι}` are the span of the permutation contractions `c_π` (the case `m = 0` of
`maxTriv_slEnd_eq_span_detPow`, in the natural slots).

Source: Goodman–Wallach, GTM 255, Ch. 5 (first fundamental theorem for `SL(V)`); Procesi,
*Lie Groups*, Ch. 11. -/
theorem maxTriv_slEnd_eq_span_contraction :
    (LieModule.maxTrivSubmodule K (slEnd K W) (MixedTensor K W ι ι) :
      Submodule K (MixedTensor K W ι ι)) = Submodule.span K (Set.range (contraction K W ι)) := by
  rw [← maxTriv_mixedLie_eq_span_contraction]
  ext v
  exact mem_maxTriv_slEnd_iff rfl

/-- **`a = b = 1`:** the `sl(W)`-invariants of `W ⊗ W^∨ ≃ End W` are the line through the
identity contraction (for every `N`, in particular `N = 2`). -/
example : (LieModule.maxTrivSubmodule K (slEnd K W) (MixedTensor K W (Fin 1) (Fin 1)) :
    Submodule K (MixedTensor K W (Fin 1) (Fin 1))) = K ∙ contraction K W (Fin 1) 1 := by
  rw [maxTriv_slEnd_eq_span_contraction, ← invariants_mixedRep_fin_one,
    invariants_mixedRep_eq_span_contraction]

/-- **`sl(W)`-invariants with extra dual slots, abstract form.** Let `D ∈ (W^∨)^{⊗J}` and
`D' ∈ W^{⊗J}` be `sl(W)`-invariant with `⟨D, D'⟩ ≠ 0`. Then the `sl(W)`-invariants of
`W^{⊗ι} ⊗ (W^∨)^{⊗(ι ⊕ J)}` are spanned by the tensors `c_1 ⊗ D` (the identity contraction on
the slots `ι`, then `D` on the slots `J`) with their dual slots permuted by any `τ`.

The proof: for an invariant `v`, `v ⊗ D'` is `sl(W)`-invariant in equal degrees, where the
identity acts by `0`, so it is `gl(W)`-invariant, a combination of contractions `c_π`
(`maxTriv_mixedLie_eq_span_contraction`). Contracting against `D` recovers `⟨D, D'⟩ v`
(`contractVec_extendVec`) and sends `c_π` to `c_1 ⊗ D` permuted by `π⁻¹`
(`contractVec_contraction`). -/
theorem maxTriv_slEnd_eq_span (D : ⨂[K] _ : J, Module.Dual K W) (D' : ⨂[K] _ : J, W)
    (hD : ∀ X ∈ slEnd K W, tensorDer J X.dualMap D = 0)
    (hD' : ∀ X ∈ slEnd K W, tensorDer J X D' = 0) (hDD' : dualDistrib D D' ≠ 0) :
    (LieModule.maxTrivSubmodule K (slEnd K W) (MixedTensor K W ι (ι ⊕ J)) :
      Submodule K (MixedTensor K W ι (ι ⊕ J))) =
      Submodule.span K (Set.range fun τ : Equiv.Perm (ι ⊕ J) =>
        (permRep K (Module.Dual K W) (ι ⊕ J) τ).lTensor _
          (extendDual D (contraction K W ι 1))) := by
  apply le_antisymm
  · intro v hv
    rw [LieSubmodule.mem_toSubmodule, LieModule.mem_maxTrivSubmodule] at hv
    have hsl (X : Module.End K W) (hX : X ∈ slEnd K W) : ⁅X, v⁆ = 0 := by
      have := hv ⟨X, hX⟩
      rwa [LieSubalgebra.coe_bracket_of_module] at this
    have h0 (X : Module.End K W) (hX : X ∈ slEnd K W) : ⁅X, extendVec D' v⁆ = 0 := by
      rw [lie_extendVec, hsl X hX, hD' X hX, map_zero, extendVec_zero, LinearMap.zero_apply,
        add_zero]
    have hgl : extendVec D' v ∈ (LieModule.maxTrivSubmodule K (Module.End K W)
        (MixedTensor K W (ι ⊕ J) (ι ⊕ J)) : Submodule K _) := by
      rw [LieSubmodule.mem_toSubmodule, ← mem_maxTriv_slEnd_iff rfl,
        LieModule.mem_maxTrivSubmodule]
      exact fun ⟨X, hX⟩ => by rw [LieSubalgebra.coe_bracket_of_module, h0 X hX]
    rw [maxTriv_mixedLie_eq_span_contraction] at hgl
    have hmap := Submodule.mem_map_of_mem (f := contractVec D) hgl
    rw [Submodule.map_span, contractVec_extendVec] at hmap
    have hv' : v = (dualDistrib D D')⁻¹ • (dualDistrib D D' • v) := by
      rw [smul_smul, inv_mul_cancel₀ hDD', one_smul]
    rw [hv']
    refine Submodule.smul_mem _ _ (Submodule.span_mono ?_ hmap)
    rintro _ ⟨_, ⟨π, rfl⟩, rfl⟩
    exact ⟨π.symm, (contractVec_contraction D π).symm⟩
  · rw [Submodule.span_le]
    rintro _ ⟨τ, rfl⟩
    rw [SetLike.mem_coe, LieSubmodule.mem_toSubmodule, LieModule.mem_maxTrivSubmodule]
    rintro ⟨X, hX⟩
    have hc : contraction K W ι 1 ∈ (LieModule.maxTrivSubmodule K (Module.End K W)
        (MixedTensor K W ι ι) : Submodule K _) := by
      rw [maxTriv_mixedLie_eq_span_contraction]
      exact Submodule.subset_span ⟨1, rfl⟩
    rw [LieSubmodule.mem_toSubmodule, LieModule.mem_maxTrivSubmodule] at hc
    rw [LieSubalgebra.coe_bracket_of_module, lie_lTensor_permRep, lie_extendDual, hD X hX,
      extendDual_zero, LinearMap.zero_apply, sub_zero, hc X, map_zero, map_zero]

variable (ι) in
/-- **The `sl(W)`-invariants of `W^{⊗a} ⊗ (W^∨)^{⊗(a + mN)}` (T8(a), Lie form, `b = a + mN`).**
Over a field of characteristic zero, with `N = finrank K W`, `a = |ι|` and the dual slots
`ι ⊕ Blocks N m` (`a` slots, then `m` blocks of `N`), the `sl(W)`-invariants are spanned by the
tensors
`(1 ⊗ τ) (c_1 ⊗ ε^{⊗m})`, `τ ∈ Perm (ι ⊕ Blocks N m)`:
the identity contraction pairing `W`-slot `i` with dual slot `inl i`, the determinant tensors
`ε` on the blocks, and then the dual slots permuted by `τ` (`permRep`, which moves slot `s` to
slot `τ s`). Taking `τ = π ⊕ 1` gives `c_π ⊗ ε^{⊗m}`.

Source: Goodman–Wallach, *Symmetry, Representations, and Invariants*, GTM 255, Ch. 5 (first
fundamental theorem for `SL(V)`); Procesi, *Lie Groups*, Ch. 11; Weyl, *The Classical Groups*,
Ch. II. -/
theorem maxTriv_slEnd_eq_span_detPow (m : ℕ) :
    (LieModule.maxTrivSubmodule K (slEnd K W)
        (MixedTensor K W ι (ι ⊕ Blocks (finrank K W) m)) :
      Submodule K (MixedTensor K W ι (ι ⊕ Blocks (finrank K W) m))) =
      Submodule.span K (Set.range fun τ : Equiv.Perm (ι ⊕ Blocks (finrank K W) m) =>
        (permRep K (Module.Dual K W) _ τ).lTensor _
          (extendDual (detPow K W m) (contraction K W ι 1))) :=
  maxTriv_slEnd_eq_span _ (detPowDual K W m)
    (fun X hX => by rw [tensorDer_detPow, mem_slEnd.mp hX, mul_zero, zero_smul])
    (fun X hX => by rw [tensorDer_detPowDual, mem_slEnd.mp hX, mul_zero, zero_smul])
    (by
      rw [dualDistrib_detPow]
      exact pow_ne_zero _ (Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero _)))

end SlInvariants

section Weights

variable {K W : Type*} [Field K] [AddCommGroup W] [Module K W] {n : Type*} [Fintype n]
  [DecidableEq n]

/-- The diagonal endomorphism `b i ↦ f i • b i` in a basis `b`.

Source: Fulton–Harris, *Representation Theory*, Lecture 15 (the Cartan subalgebra of
`sl_n`). -/
def diagEnd (b : Basis n K W) (f : n → K) : Module.End K W :=
  b.constr K fun i => f i • b i

omit [Fintype n] [DecidableEq n] in
theorem diagEnd_apply_basis (b : Basis n K W) (f : n → K) (i : n) :
    diagEnd b f (b i) = f i • b i :=
  b.constr_basis _ _ _

/-- The constant `f = c` gives `c • 1`. -/
example (b : Basis n K W) (c : K) : diagEnd b (fun _ => c) = c • 1 :=
  b.ext fun i => by simp [diagEnd_apply_basis]

theorem dualMap_diagEnd_dualBasis (b : Basis n K W) (f : n → K) (i : n) :
    (diagEnd b f).dualMap (b.dualBasis i) = f i • b.dualBasis i := by
  refine b.ext fun j => ?_
  rw [LinearMap.dualMap_apply, diagEnd_apply_basis, map_smul, LinearMap.smul_apply,
    Basis.dualBasis_apply_self, smul_eq_mul, smul_eq_mul]
  split_ifs with h
  · rw [h]
  · simp

theorem trace_diagEnd (b : Basis n K W) (f : n → K) :
    LinearMap.trace K W (diagEnd b f) = ∑ i, f i := by
  rw [LinearMap.trace_eq_matrix_trace K b, Matrix.trace]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [Matrix.diag_apply, LinearMap.toMatrix_apply, diagEnd_apply_basis, map_smul,
    Basis.repr_self, Finsupp.smul_apply, Finsupp.single_eq_same, smul_eq_mul, mul_one]

variable {ι κ : Type*} [Fintype ι] [DecidableEq ι] [Fintype κ] [DecidableEq κ]

variable (ι κ) in
/-- The basis `e_α ⊗ e^∨_β` of `W^{⊗ι} ⊗ (W^∨)^{⊗κ}`, `α : ι → n`, `β : κ → n`
(`mixedBasis_apply`).

Source: Goodman–Wallach, GTM 255, Ch. 5 (tensor bases of mixed tensors). -/
def mixedBasis (b : Basis n K W) : Basis ((ι → n) × (κ → n)) K (MixedTensor K W ι κ) :=
  (Basis.piTensorProduct fun _ : ι => b).tensorProduct
    (Basis.piTensorProduct fun _ : κ => b.dualBasis)

omit [DecidableEq ι] [DecidableEq κ] in
theorem mixedBasis_apply (b : Basis n K W) (p : (ι → n) × (κ → n)) :
    mixedBasis ι κ b p =
      tprod K (fun s => b (p.1 s)) ⊗ₜ tprod K (fun t => b.dualBasis (p.2 t)) := by
  rw [mixedBasis, Basis.tensorProduct_apply', Basis.piTensorProduct_apply,
    Basis.piTensorProduct_apply]

omit [DecidableEq ι] [DecidableEq κ] in
/-- On `W ⊗ W^∨`, `mixedBasis` is `e_i ⊗ e^∨_j`. -/
example (b : Basis n K W) (i j : n) :
    mixedBasis (Fin 1) (Fin 1) b (fun _ => i, fun _ => j) =
      tprod K (fun _ => b i) ⊗ₜ tprod K (fun _ => b.dualBasis j) :=
  mixedBasis_apply b _

/-- The weight of `e_α ⊗ e^∨_β` for the diagonal `f`: `∑ₛ f (α s) - ∑ₜ f (β t)`
(`lie_diagEnd_mixedBasis`).

Source: Fulton–Harris, *Representation Theory*, Lecture 15 (weights of tensor
representations of `sl_n`). -/
def weight (f : n → K) (p : (ι → n) × (κ → n)) : K :=
  ∑ s, f (p.1 s) - ∑ t, f (p.2 t)

omit [DecidableEq n] [DecidableEq ι] [DecidableEq κ] in
/-- A constant `f = c` has weight `(|ι| - |κ|) c`. -/
example (c : K) (p : (ι → n) × (κ → n)) :
    weight (fun _ => c) p = ((Fintype.card ι : K) - Fintype.card κ) * c := by
  simp [weight, sub_mul]

omit [Fintype ι] in
theorem tprod_update_smul_self {M : Type*} [AddCommGroup M] [Module K M] (v : ι → M) (s : ι)
    (c : K) : tprod K (Function.update v s (c • v s)) = c • tprod K v := by
  have := (PiTensorProduct.tprod K).map_update_smul v s c (v s)
  rwa [Function.update_eq_self] at this

/-- The diagonal acts on `e_α ⊗ e^∨_β` by its weight. -/
theorem lie_diagEnd_mixedBasis (b : Basis n K W) (f : n → K) (p : (ι → n) × (κ → n)) :
    ⁅diagEnd b f, mixedBasis ι κ b p⁆ = weight f p • mixedBasis ι κ b p := by
  rw [mixedBasis_apply, weight]
  conv_rhs => simp only [sub_smul, TensorProduct.smul_tmul']
  rw [lie_mixedTensor, mixedLie_apply, LinearMap.rTensor_tmul, LinearMap.lTensor_tmul,
    tensorDer_tprod, tensorDer_tprod]
  simp only [diagEnd_apply_basis, dualMap_diagEnd_dualBasis]
  simp only [tprod_update_smul_self (fun s => b (p.1 s)),
    tprod_update_smul_self (fun t => b.dualBasis (p.2 t)), ← Finset.sum_smul,
    TensorProduct.smul_tmul', TensorProduct.tmul_smul]

theorem repr_lie_diagEnd (b : Basis n K W) (f : n → K) (x : MixedTensor K W ι κ)
    (p : (ι → n) × (κ → n)) :
    (mixedBasis ι κ b).repr ⁅diagEnd b f, x⁆ p = weight f p * (mixedBasis ι κ b).repr x p := by
  have : Finsupp.lapply p ∘ₗ (mixedBasis ι κ b).repr.toLinearMap ∘ₗ mixedLie K W ι κ (diagEnd b f) =
      weight f p • (Finsupp.lapply p ∘ₗ (mixedBasis ι κ b).repr.toLinearMap) := by
    refine (mixedBasis ι κ b).ext fun q => ?_
    simp only [LinearMap.coe_comp, Function.comp_apply, ← lie_mixedTensor,
      lie_diagEnd_mixedBasis, LinearEquiv.coe_coe, map_smul, Basis.repr_self,
      Finsupp.lapply_apply, Finsupp.single_apply, LinearMap.smul_apply,
      smul_eq_mul]
    split_ifs with h
    · rw [h]
    · simp
  exact congr($this x)

omit [Fintype n] [DecidableEq ι] [DecidableEq κ] in
/-- The weight of `e_k - e_l` is the difference of the slot counts. -/
theorem weight_sub_single (k l : n) (p : (ι → n) × (κ → n)) :
    weight (fun i => (if i = k then (1 : K) else 0) - if i = l then 1 else 0) p =
      (((univ.filter fun s => p.1 s = k).card - (univ.filter fun t => p.2 t = k).card -
        ((univ.filter fun s => p.1 s = l).card - (univ.filter fun t => p.2 t = l).card) : ℤ) :
          K) := by
  simp only [weight, Finset.sum_sub_distrib, Finset.sum_boole]
  push_cast
  ring

variable [CharZero K] [FiniteDimensional K W]

/-- **No `sl(W)`-invariants unless `N ∣ b - a`.** With `a = |ι|`, `b = |κ|` and
`N = finrank K W`: if `N` does not divide `b - a`, then `W^{⊗a} ⊗ (W^∨)^{⊗b}` has no nonzero
`sl(W)`-invariants.

The route is the weights of the diagonal torus: `diag(e_k - e_l)` lies in `sl(W)` and acts on
`e_α ⊗ e^∨_β` by `c_k - c_l`, where `c_k` is the number of `W`-slots of `α` equal to `k` minus the
number of dual slots of `β` equal to `k`. An invariant can only have coefficients where all
`c_k` agree, and then `a - b = ∑ c_k = N c_0`.

Source: Fulton–Harris, *Representation Theory*, Lecture 15 (weights of `sl_n`-representations);
Goodman–Wallach, GTM 255, Ch. 5 (first fundamental theorem for `SL(V)`). -/
theorem maxTriv_slEnd_eq_bot
    (h : ¬ (finrank K W : ℤ) ∣ (Fintype.card κ : ℤ) - Fintype.card ι) :
    LieModule.maxTrivSubmodule K (slEnd K W) (MixedTensor K W ι κ) = ⊥ := by
  rw [LieSubmodule.eq_bot_iff]
  intro v hv
  rw [LieModule.mem_maxTrivSubmodule] at hv
  set b := Module.finBasis K W
  apply (mixedBasis ι κ b).repr.injective
  ext p
  rw [map_zero, Finsupp.coe_zero, Pi.zero_apply]
  by_contra hp
  let c : Fin (finrank K W) → ℤ := fun k =>
    (univ.filter fun s => p.1 s = k).card - (univ.filter fun t => p.2 t = k).card
  have hc (k l : Fin (finrank K W)) : c k = c l := by
    let f : Fin (finrank K W) → K := fun i => (if i = k then 1 else 0) - if i = l then 1 else 0
    have hf : diagEnd b f ∈ slEnd K W := by
      rw [mem_slEnd, trace_diagEnd]
      simp [f, Finset.sum_sub_distrib]
    have h0 := hv ⟨_, hf⟩
    rw [LieSubalgebra.coe_bracket_of_module] at h0
    have h1 := congrArg (fun x => (mixedBasis ι κ b).repr x p) h0
    simp only [repr_lie_diagEnd, map_zero, Finsupp.coe_zero, Pi.zero_apply] at h1
    rcases mul_eq_zero.mp h1 with h2 | h2
    · rw [weight_sub_single, Int.cast_eq_zero] at h2
      simp only [c]
      omega
    · exact absurd h2 hp
  have hsum : ∑ k, c k = (Fintype.card ι : ℤ) - Fintype.card κ := by
    simp only [c, Finset.sum_sub_distrib]
    rw [← Nat.cast_sum, ← Nat.cast_sum,
      ← Finset.card_eq_sum_card_fiberwise fun s _ => Finset.mem_univ (p.1 s),
      ← Finset.card_eq_sum_card_fiberwise fun t _ => Finset.mem_univ (p.2 t),
      Finset.card_univ, Finset.card_univ]
  apply h
  rcases Nat.eq_zero_or_pos (finrank K W) with hN | hN
  · have : ∑ k, c k = 0 := by
      rw [Finset.univ_eq_empty_iff.mpr (by rw [hN]; infer_instance), Finset.sum_empty]
    rw [hN, Nat.cast_zero, zero_dvd_iff]
    omega
  · have h0 : ∑ k, c k = finrank K W * c ⟨0, hN⟩ := by
      rw [Finset.sum_congr rfl fun k _ => hc k ⟨0, hN⟩, Finset.sum_const, Finset.card_univ,
        Fintype.card_fin, nsmul_eq_mul]
    exact ⟨-c ⟨0, hN⟩, by rw [mul_neg, ← h0, hsum, neg_sub]⟩

/-- **Falsification, `N = 2`, `a = 0`, `b = 1`:** `W^∨` has no nonzero `sl(W)`-invariant. -/
example (h : finrank K W = 2) :
    LieModule.maxTrivSubmodule K (slEnd K W) (MixedTensor K W (Fin 0) (Fin 1)) = ⊥ :=
  maxTriv_slEnd_eq_bot (by rw [h]; decide)

end Weights

section ExtendW

variable {K W : Type*} [Field K] [AddCommGroup W] [Module K W] {ι κ J : Type*} [Fintype J]

/-- Contraction of the dual slots `J` of `(W^∨)^{⊗(κ ⊕ J)}` against `D' ∈ W^{⊗J}`,
`W^{⊗ι} ⊗ (W^∨)^{⊗(κ ⊕ J)} → W^{⊗ι} ⊗ (W^∨)^{⊗κ}`.

Source: Goodman–Wallach, GTM 255, Ch. 5 (contractions of mixed tensors). -/
def contractDual (D' : ⨂[K] _ : J, W) : MixedTensor K W ι (κ ⊕ J) →ₗ[K] MixedTensor K W ι κ :=
  ((TensorProduct.rid K _).toLinearMap ∘ₗ
    (LinearMap.applyₗ D' ∘ₗ dualDistrib).lTensor _ ∘ₗ
      (tmulEquiv K (Module.Dual K W)).symm.toLinearMap).lTensor _

/-- Appending `D` and contracting against `D'` multiplies by `⟨D, D'⟩`. -/
theorem contractDual_extendDual (D : ⨂[K] _ : J, Module.Dual K W) (D' : ⨂[K] _ : J, W)
    (v : MixedTensor K W ι κ) : contractDual D' (extendDual D v) = dualDistrib D D' • v := by
  have : ((TensorProduct.rid K _).toLinearMap ∘ₗ
      (LinearMap.applyₗ D' ∘ₗ dualDistrib).lTensor _ ∘ₗ
        (tmulEquiv K (Module.Dual K W)).symm.toLinearMap) ∘ₗ
        ((tmulEquiv K (Module.Dual K W)).toLinearMap ∘ₗ
          (TensorProduct.mk K (⨂[K] _ : κ, Module.Dual K W) _).flip D) =
      dualDistrib D D' • LinearMap.id := by
    ext t
    simp
  rw [contractDual, extendDual, ← LinearMap.comp_apply, ← LinearMap.lTensor_comp, this,
    LinearMap.lTensor_smul, LinearMap.lTensor_id, LinearMap.smul_apply, LinearMap.id_apply]

/-- Contracting `u ⊗ D` against `D'`, on `W ⊗ W^∨`. -/
example (D : ⨂[K] _ : J, Module.Dual K W) (D' : ⨂[K] _ : J, W)
    (v : MixedTensor K W (Fin 1) (Fin 1)) :
    contractDual D' (extendDual D v) = dualDistrib D D' • v :=
  contractDual_extendDual D D' v

variable [Fintype ι] [Fintype κ]

variable (κ) in
/-- `ev` with a general tensor `S ∈ W^{⊗κ}` in place of `w₁ ⊗ ⋯ ⊗ w_k`:
`t ⊗ u ↦ ⟨T, t⟩ ⟨u, S⟩`.

Source: Goodman–Wallach, GTM 255, Ch. 5 (mixed tensors as multilinear functions). -/
def ev₂ (T : ⨂[K] _ : ι, Module.Dual K W) (S : ⨂[K] _ : κ, W) : MixedTensor K W ι κ →ₗ[K] K :=
  LinearMap.mul' K K ∘ₗ TensorProduct.map (dualDistrib T) (LinearMap.applyₗ S ∘ₗ dualDistrib)

theorem ev₂_tprod (T : ⨂[K] _ : ι, Module.Dual K W) (w : κ → W) :
    ev₂ κ T (tprod K w) = ev κ T w :=
  rfl

/-- On `W ⊗ W^∨`, `ev₂` is `⟨φ, v⟩ ⟨ψ, S⟩`. -/
example (φ ψ : Module.Dual K W) (v : W) (S : ⨂[K] _ : Fin 1, W) :
    ev₂ (Fin 1) (tprod K fun _ => φ) S
      (tprod K (fun _ : Fin 1 => v) ⊗ₜ tprod K (fun _ : Fin 1 => ψ)) =
        φ v * dualDistrib (tprod K fun _ => ψ) S := by
  simp [ev₂]

omit [Fintype κ] in
theorem mixedEquiv_tmul [FiniteDimensional K W] (t : ⨂[K] _ : ι, W)
    (u : ⨂[K] _ : ι, Module.Dual K W) (S : ⨂[K] _ : ι, W) :
    mixedEquiv K W ι (t ⊗ₜ u) S = dualDistrib u S • t := by
  have : mixedEquiv K W ι (t ⊗ₜ u) = (dualDistrib u).smulRight t := by
    ext v
    simp only [LinearMap.compMultilinearMap_apply, LinearMap.smulRight_apply]
    induction u using PiTensorProduct.induction_on with
    | smul_tprod c ψ =>
      rw [TensorProduct.tmul_smul, map_smul, LinearMap.smul_apply, mixedEquiv_tmul_tprod, map_smul,
        LinearMap.smul_apply, dualDistrib_apply, smul_smul, smul_eq_mul]
    | add u u' hu hu' =>
      rw [TensorProduct.tmul_add, map_add, LinearMap.add_apply, hu, hu', map_add,
        LinearMap.add_apply, add_smul]
  rw [this, LinearMap.smulRight_apply]

omit [Fintype κ] in
theorem ev₂_mixedEquiv [FiniteDimensional K W] (T : ⨂[K] _ : ι, Module.Dual K W)
    (S : ⨂[K] _ : ι, W) (x : MixedTensor K W ι ι) :
    ev₂ ι T S x = dualDistrib T (mixedEquiv K W ι x S) := by
  have : ev₂ ι T S = dualDistrib T ∘ₗ LinearMap.applyₗ S ∘ₗ (mixedEquiv K W ι).toLinearMap := by
    refine TensorProduct.ext' fun t u => ?_
    simp [ev₂, mixedEquiv_tmul, mul_comm]
  exact congr($this x)

omit [Fintype κ] in
theorem ev₂_contraction [FiniteDimensional K W] (T : ⨂[K] _ : ι, Module.Dual K W)
    (S : ⨂[K] _ : ι, W) (π : Equiv.Perm ι) :
    ev₂ ι T S (contraction K W ι π) = dualDistrib T (permRep K W ι π S) := by
  rw [ev₂_mixedEquiv, mixedEquiv_contraction]

omit [Fintype ι] in
theorem dualDistrib_tprod_permRep [Fintype ι] (φ : ι → Module.Dual K W) (π : Equiv.Perm ι)
    (S : ⨂[K] _ : ι, W) :
    dualDistrib (tprod K φ) (permRep K W ι π S) = dualDistrib (tprod K fun i => φ (π i)) S := by
  have : dualDistrib (tprod K φ) ∘ₗ permRep K W ι π = dualDistrib (tprod K fun i => φ (π i)) := by
    ext v
    simp only [LinearMap.compMultilinearMap_apply, LinearMap.coe_comp, Function.comp_apply,
      permRep_tprod, dualDistrib_apply]
    exact (Fintype.prod_equiv π _ _ fun i => by simp).symm
  exact congr($this S)

omit [Fintype ι] [Fintype κ] in
theorem dualDistrib_tprod_tmulEquiv [Fintype ι] (φ : ι ⊕ J → Module.Dual K W)
    (S : ⨂[K] _ : ι, W) (D' : ⨂[K] _ : J, W) :
    dualDistrib (tprod K φ) (tmulEquiv K W (S ⊗ₜ D')) =
      dualDistrib (tprod K fun i => φ (Sum.inl i)) S *
        dualDistrib (tprod K fun j => φ (Sum.inr j)) D' := by
  have : dualDistrib (tprod K φ) ∘ₗ (tmulEquiv K W).toLinearMap =
      LinearMap.mul' K K ∘ₗ TensorProduct.map (dualDistrib (tprod K fun i => φ (Sum.inl i)))
        (dualDistrib (tprod K fun j => φ (Sum.inr j))) := by
    ext a b
    simp [Fintype.prod_sum_type]
  exact congr($this (S ⊗ₜ D'))

theorem ev₂_contractDual (D' : ⨂[K] _ : J, W) (T : ⨂[K] _ : ι, Module.Dual K W)
    (S : ⨂[K] _ : κ, W) (z : MixedTensor K W ι (κ ⊕ J)) :
    ev₂ κ T S (contractDual D' z) = ev₂ (κ ⊕ J) T (tmulEquiv K W (S ⊗ₜ D')) z := by
  have : ev₂ κ T S ∘ₗ contractDual D' = ev₂ (κ ⊕ J) T (tmulEquiv K W (S ⊗ₜ D')) := by
    refine TensorProduct.ext' fun t u => ?_
    induction u using PiTensorProduct.induction_on with
    | smul_tprod c ψ =>
      simp only [contractDual, ev₂, LinearMap.coe_comp, Function.comp_apply,
        LinearMap.lTensor_tmul, TensorProduct.tmul_smul, map_smul, LinearEquiv.coe_coe,
        tmulEquiv_symm_apply, TensorProduct.rid_tmul, TensorProduct.map_tmul,
        LinearMap.applyₗ_apply_apply, LinearMap.mul'_apply, smul_eq_mul]
      rw [dualDistrib_tprod_tmulEquiv]
      ring
    | add u u' hu hu' => rw [TensorProduct.tmul_add, map_add, map_add, hu, hu']
  exact congr($this z)

omit [Fintype J] in
theorem ev_rTensor_permRep (φ : ι → Module.Dual K W) (w : κ → W) (τ : Equiv.Perm ι)
    (y : MixedTensor K W ι κ) :
    ev κ (tprod K φ) w ((permRep K W ι τ).rTensor _ y) = ev κ (tprod K fun i => φ (τ i)) w y := by
  have : ev κ (tprod K φ) w ∘ₗ (permRep K W ι τ).rTensor _ = ev κ (tprod K fun i => φ (τ i)) w :=
    TensorProduct.ext' fun t u => by
      simp only [LinearMap.coe_comp, Function.comp_apply, LinearMap.rTensor_tmul, ev_tmul,
        dualDistrib_tprod_permRep]
  exact congr($this y)

theorem ev_extendVec (D' : ⨂[K] _ : J, W) (φ : ι ⊕ J → Module.Dual K W) (w : κ → W)
    (y : MixedTensor K W ι κ) :
    ev κ (tprod K φ) w (extendVec D' y) =
      ev κ (tprod K fun i => φ (Sum.inl i)) w y *
        dualDistrib (tprod K fun j => φ (Sum.inr j)) D' := by
  have : ev κ (tprod K φ) w ∘ₗ extendVec D' =
      dualDistrib (tprod K fun j => φ (Sum.inr j)) D' • ev κ (tprod K fun i => φ (Sum.inl i)) w :=
    TensorProduct.ext' fun t u => by
      simp only [LinearMap.coe_comp, Function.comp_apply, extendVec_tmul, ev_tmul,
        dualDistrib_tprod_tmulEquiv, LinearMap.smul_apply, smul_eq_mul]
      ring
  rw [mul_comm]
  exact congr($this y)

omit [Fintype κ] in
/-- **Contracting a permutation contraction against `D'`.** Contracting the dual slots `J` of
`c_π ∈ W^{⊗(ι ⊕ J)} ⊗ (W^∨)^{⊗(ι ⊕ J)}` against `D'` gives `c_1 ⊗ D'` with its `W`-slots
permuted by `π`. -/
theorem contractDual_contraction [FiniteDimensional K W] [DecidableEq ι] [DecidableEq J]
    (D' : ⨂[K] _ : J, W) (π : Equiv.Perm (ι ⊕ J)) :
    contractDual D' (contraction K W (ι ⊕ J) π) =
      (permRep K W (ι ⊕ J) π).rTensor _ (extendVec D' (contraction K W ι 1)) := by
  refine ext_ev fun φ w => ?_
  conv_lhs => rw [← ev₂_tprod]
  rw [ev₂_contractDual, ev₂_contraction, dualDistrib_tprod_permRep, dualDistrib_tprod_tmulEquiv,
    ev_rTensor_permRep, ev_extendVec, ev_contraction]
  have h1 (i : ι) : (1 : Equiv.Perm ι).symm i = i := rfl
  simp [h1]

end ExtendW

section LieActionW

variable {K W : Type*} [Field K] [AddCommGroup W] [Module K W] {ι κ : Type*}
  [Fintype ι] [DecidableEq ι] [Fintype κ] [DecidableEq κ]

theorem lie_rTensor_permRep (X : Module.End K W) (τ : Equiv.Perm ι) (y : MixedTensor K W ι κ) :
    ⁅X, (permRep K W ι τ).rTensor _ y⁆ = (permRep K W ι τ).rTensor _ ⁅X, y⁆ := by
  rw [lie_mixedTensor, lie_mixedTensor, mixedLie_apply, mixedLie_apply, map_sub]
  congr 1
  · rw [← LinearMap.comp_apply, ← LinearMap.comp_apply, ← LinearMap.rTensor_comp,
      ← LinearMap.rTensor_comp, ← Module.End.mul_eq_comp, ← Module.End.mul_eq_comp,
      permRep_mul_tensorDer]
  · rw [← LinearMap.comp_apply, ← LinearMap.comp_apply, LinearMap.lTensor_comp_rTensor,
      LinearMap.rTensor_comp_lTensor]

end LieActionW

section SlInvariantsW

variable {K W : Type*} [Field K] [CharZero K] [AddCommGroup W] [Module K W]
  [FiniteDimensional K W] {ι J : Type*} [Fintype ι] [DecidableEq ι] [Fintype J] [DecidableEq J]

/-- **`sl(W)`-invariants with extra `W`-slots, abstract form.** Let `D ∈ (W^∨)^{⊗J}` and
`D' ∈ W^{⊗J}` be `sl(W)`-invariant with `⟨D, D'⟩ ≠ 0`. Then the `sl(W)`-invariants of
`W^{⊗(ι ⊕ J)} ⊗ (W^∨)^{⊗ι}` are spanned by the tensors `c_1 ⊗ D'` (the identity contraction on
the slots `ι`, then `D'` on the `W`-slots `J`) with their `W`-slots permuted by any `τ`.

The proof mirrors `maxTriv_slEnd_eq_span`: append `D` on the dual side, use the first
fundamental theorem for `gl(W)` in equal degrees, and contract against `D'`
(`contractDual_extendDual`, `contractDual_contraction`). -/
theorem maxTriv_slEnd_eq_span_vec (D : ⨂[K] _ : J, Module.Dual K W) (D' : ⨂[K] _ : J, W)
    (hD : ∀ X ∈ slEnd K W, tensorDer J X.dualMap D = 0)
    (hD' : ∀ X ∈ slEnd K W, tensorDer J X D' = 0) (hDD' : dualDistrib D D' ≠ 0) :
    (LieModule.maxTrivSubmodule K (slEnd K W) (MixedTensor K W (ι ⊕ J) ι) :
      Submodule K (MixedTensor K W (ι ⊕ J) ι)) =
      Submodule.span K (Set.range fun τ : Equiv.Perm (ι ⊕ J) =>
        (permRep K W (ι ⊕ J) τ).rTensor _ (extendVec D' (contraction K W ι 1))) := by
  apply le_antisymm
  · intro v hv
    rw [LieSubmodule.mem_toSubmodule, LieModule.mem_maxTrivSubmodule] at hv
    have hsl (X : Module.End K W) (hX : X ∈ slEnd K W) : ⁅X, v⁆ = 0 := by
      have := hv ⟨X, hX⟩
      rwa [LieSubalgebra.coe_bracket_of_module] at this
    have hgl : extendDual D v ∈ (LieModule.maxTrivSubmodule K (Module.End K W)
        (MixedTensor K W (ι ⊕ J) (ι ⊕ J)) : Submodule K _) := by
      rw [LieSubmodule.mem_toSubmodule, ← mem_maxTriv_slEnd_iff rfl,
        LieModule.mem_maxTrivSubmodule]
      exact fun ⟨X, hX⟩ => by
        rw [LieSubalgebra.coe_bracket_of_module, lie_extendDual, hsl X hX, hD X hX, map_zero,
          extendDual_zero, LinearMap.zero_apply, sub_zero]
    rw [maxTriv_mixedLie_eq_span_contraction] at hgl
    have hmap := Submodule.mem_map_of_mem (f := contractDual D') hgl
    rw [Submodule.map_span, contractDual_extendDual] at hmap
    have hv' : v = (dualDistrib D D')⁻¹ • (dualDistrib D D' • v) := by
      rw [smul_smul, inv_mul_cancel₀ hDD', one_smul]
    rw [hv']
    refine Submodule.smul_mem _ _ (Submodule.span_mono ?_ hmap)
    rintro _ ⟨_, ⟨π, rfl⟩, rfl⟩
    exact ⟨π, (contractDual_contraction D' π).symm⟩
  · rw [Submodule.span_le]
    rintro _ ⟨τ, rfl⟩
    rw [SetLike.mem_coe, LieSubmodule.mem_toSubmodule, LieModule.mem_maxTrivSubmodule]
    rintro ⟨X, hX⟩
    have hc : contraction K W ι 1 ∈ (LieModule.maxTrivSubmodule K (Module.End K W)
        (MixedTensor K W ι ι) : Submodule K _) := by
      rw [maxTriv_mixedLie_eq_span_contraction]
      exact Submodule.subset_span ⟨1, rfl⟩
    rw [LieSubmodule.mem_toSubmodule, LieModule.mem_maxTrivSubmodule] at hc
    rw [LieSubalgebra.coe_bracket_of_module, lie_rTensor_permRep, lie_extendVec, hD' X hX,
      extendVec_zero, LinearMap.zero_apply, add_zero, hc X, map_zero, map_zero]

variable (ι) in
/-- **The `sl(W)`-invariants of `W^{⊗(b + mN)} ⊗ (W^∨)^{⊗b}` (T8(a), Lie form, `a = b + mN`).**
Over a field of characteristic zero, with `N = finrank K W`, `b = |ι|` and the `W`-slots
`ι ⊕ Blocks N m`, the `sl(W)`-invariants are spanned by the tensors
`(τ ⊗ 1) (c_1 ⊗ (ε^∨)^{⊗m})`, `τ ∈ Perm (ι ⊕ Blocks N m)`: the identity contraction pairing
`W`-slot `inl i` with dual slot `i`, the dual determinant tensors `ε^∨` on the blocks, and then the
`W`-slots permuted by `τ` (`permRep` moves slot `s` to slot `τ s`).

Source: Goodman–Wallach, *Symmetry, Representations, and Invariants*, GTM 255, Ch. 5 (first
fundamental theorem for `SL(V)`); Procesi, *Lie Groups*, Ch. 11. -/
theorem maxTriv_slEnd_eq_span_detPowDual (m : ℕ) :
    (LieModule.maxTrivSubmodule K (slEnd K W)
        (MixedTensor K W (ι ⊕ Blocks (finrank K W) m) ι) :
      Submodule K (MixedTensor K W (ι ⊕ Blocks (finrank K W) m) ι)) =
      Submodule.span K (Set.range fun τ : Equiv.Perm (ι ⊕ Blocks (finrank K W) m) =>
        (permRep K W _ τ).rTensor _ (extendVec (detPowDual K W m) (contraction K W ι 1))) :=
  maxTriv_slEnd_eq_span_vec (detPow K W m) _
    (fun X hX => by rw [tensorDer_detPow, mem_slEnd.mp hX, mul_zero, zero_smul])
    (fun X hX => by rw [tensorDer_detPowDual, mem_slEnd.mp hX, mul_zero, zero_smul])
    (by
      rw [dualDistrib_detPow]
      exact pow_ne_zero _ (Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero _)))

end SlInvariantsW

section TopDegree

/-- Pairing the antisymmetrization with a permuted pure tensor multiplies by the sign. -/
theorem dualDistrib_antisymTensor_tprod_perm {K M ι : Type*} [Field K] [AddCommGroup M]
    [Module K M] [Fintype ι] [DecidableEq ι] (f : ι → Module.Dual K M) (u : ι → M)
    (σ : Equiv.Perm ι) :
    dualDistrib (antisymTensor K (Module.Dual K M) ι f) (tprod K fun i => u (σ i)) =
      (Equiv.Perm.sign σ : ℤ) * dualDistrib (antisymTensor K (Module.Dual K M) ι f)
        (tprod K u) := by
  simp only [antisymTensor_apply, map_sum, map_zsmul, LinearMap.sum_apply, LinearMap.smul_apply,
    dualDistrib_apply, zsmul_eq_mul, Finset.mul_sum]
  refine Fintype.sum_equiv (Equiv.mulRight σ⁻¹) _ _ fun ρ => ?_
  simp only [Equiv.coe_mulRight, Equiv.Perm.sign_mul, Equiv.Perm.sign_inv, Units.val_mul,
    Int.cast_mul, Equiv.Perm.mul_apply]
  have hp : ∏ i, f (ρ (σ⁻¹ i)) (u i) = ∏ i, f (ρ i) (u (σ i)) := by
    rw [← Equiv.prod_comp σ (fun j => f (ρ (σ⁻¹ j)) (u j))]
    simp
  rw [hp]
  have h : ((Equiv.Perm.sign σ : ℤ) : K) * (Equiv.Perm.sign σ : ℤ) = 1 := by
    rw [← Int.cast_mul, ← Units.val_mul, Int.units_mul_self, Units.val_one, Int.cast_one]
  generalize ((Equiv.Perm.sign σ : ℤ) : K) = s at h ⊢
  generalize ((Equiv.Perm.sign ρ : ℤ) : K) = r
  generalize ∏ x, (f (ρ x)) (u (σ x)) = P
  linear_combination (-(r * P)) * h

variable {K W : Type*} [Field K] [CharZero K] [AddCommGroup W] [Module K W]
  [FiniteDimensional K W]

/-- The tensor `ε ∈ (W^∨)^{⊗N}` as a mixed tensor with no `W`-slots: `c_1 ⊗ ε` with
`c_1 = 1 ∈ W^{⊗0} ⊗ (W^∨)^{⊗0}`, in the slots `Fin 0 ⊕ Fin N` of `maxTriv_slEnd_eq_span`.

Source: Goodman–Wallach, GTM 255, Ch. 5 (the determinant as an `SL(V)`-invariant). -/
abbrev detMixed (K W : Type*) [Field K] [AddCommGroup W] [Module K W] [FiniteDimensional K W] :
    MixedTensor K W (Fin 0) (Fin 0 ⊕ Fin (finrank K W)) :=
  extendDual (detTensor K W) (contraction K W (Fin 0) 1)

omit [CharZero K] in
/-- Permuting the dual slots of `ε` multiplies it by the sign. -/
theorem lTensor_permRep_detMixed (τ : Equiv.Perm (Fin 0 ⊕ Fin (finrank K W))) :
    (permRep K (Module.Dual K W) _ τ).lTensor _ (detMixed K W) =
      ((Equiv.Perm.sign τ : ℤ) : K) • detMixed K W := by
  set e := Equiv.emptySum (Fin 0) (Fin (finrank K W))
  refine ext_ev fun φ w => ?_
  rw [ev_lTensor_permRep, map_smul, ev_extendDual, ev_extendDual, smul_eq_mul]
  have hτ (j : Fin (finrank K W)) : τ (Sum.inr j) = Sum.inr (e.permCongr τ j) := by
    rcases h : τ (Sum.inr j) with i | i
    · exact i.elim0
    · simp [Equiv.permCongr_apply, e, h]
  simp only [hτ]
  rw [detTensor_eq, dualDistrib_antisymTensor_tprod_perm (u := fun j => w (Sum.inr j)),
    Equiv.Perm.sign_permCongr]
  have h0 : (fun k : Fin 0 => w (τ (Sum.inl k))) = fun k => w (Sum.inl k) :=
    funext fun k => k.elim0
  rw [h0]
  ring

/-- **`a = 0`, `b = N`: the `sl(W)`-invariants of `(W^∨)^{⊗N}` are the line through `ε`**
(slots `Fin 0 ⊕ Fin N`: no `W`-slots, then the `N` dual slots). For `N = 2` this is the line
through `e₁^∨ ⊗ e₂^∨ - e₂^∨ ⊗ e₁^∨`. -/
theorem maxTriv_slEnd_eq_span_detMixed :
    (LieModule.maxTrivSubmodule K (slEnd K W)
        (MixedTensor K W (Fin 0) (Fin 0 ⊕ Fin (finrank K W))) :
      Submodule K (MixedTensor K W (Fin 0) (Fin 0 ⊕ Fin (finrank K W)))) = K ∙ detMixed K W := by
  rw [maxTriv_slEnd_eq_span (detTensor K W) (detTensorDual K W)
    (fun X hX => by rw [tensorDer_detTensor, mem_slEnd.mp hX, zero_smul])
    (fun X hX => by rw [tensorDer_detTensorDual, mem_slEnd.mp hX, zero_smul])
    (by
      rw [dualDistrib_detTensor_detTensorDual]
      exact Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero _))]
  apply le_antisymm
  · rw [Submodule.span_le]
    rintro _ ⟨τ, rfl⟩
    dsimp only
    rw [SetLike.mem_coe, lTensor_permRep_detMixed]
    exact Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self _)
  · rw [Submodule.span_singleton_le_iff_mem]
    refine Submodule.subset_span ⟨1, ?_⟩
    simp [map_one, Module.End.one_eq_id, LinearMap.lTensor_id]

/-- `ε` is `sl(W)`-invariant. -/
example : detMixed K W ∈ (LieModule.maxTrivSubmodule K (slEnd K W)
    (MixedTensor K W (Fin 0) (Fin 0 ⊕ Fin (finrank K W))) : Submodule K _) := by
  rw [maxTriv_slEnd_eq_span_detMixed]
  exact Submodule.mem_span_singleton_self _

/-- **Falsification: no symmetric invariant.** For `N ≥ 2`, an `sl(W)`-invariant of
`(W^∨)^{⊗N}` that is fixed by swapping two dual slots is `0` (for `N = 2`: `W^∨ ⊗ W^∨` has no
nonzero symmetric invariant). -/
theorem eq_zero_of_swap_invariant {x : MixedTensor K W (Fin 0) (Fin 0 ⊕ Fin (finrank K W))}
    (hx : x ∈ LieModule.maxTrivSubmodule K (slEnd K W)
      (MixedTensor K W (Fin 0) (Fin 0 ⊕ Fin (finrank K W)))) {i j : Fin (finrank K W)} (hij : i ≠ j)
    (hs : (permRep K (Module.Dual K W) _ (Equiv.swap (Sum.inr i) (Sum.inr j))).lTensor _ x = x) :
    x = 0 := by
  have hx' : x ∈ (LieModule.maxTrivSubmodule K (slEnd K W)
      (MixedTensor K W (Fin 0) (Fin 0 ⊕ Fin (finrank K W))) : Submodule K _) := hx
  rw [maxTriv_slEnd_eq_span_detMixed, Submodule.mem_span_singleton] at hx'
  obtain ⟨c, rfl⟩ := hx'
  rw [map_smul, lTensor_permRep_detMixed, Equiv.Perm.sign_swap (by simpa using hij)] at hs
  simp only [Units.val_neg, Units.val_one, Int.cast_neg, Int.cast_one, neg_one_smul, smul_neg]
    at hs
  have : (2 : K) • c • detMixed K W = 0 := by rw [two_smul]; nth_rw 1 [← hs]; exact neg_add_cancel _
  rw [smul_eq_zero] at this
  rcases this with h | h
  · exact absurd h two_ne_zero
  · exact h

/-- For `N = 2`: `W^∨ ⊗ W^∨` has no nonzero symmetric `sl(W)`-invariant. -/
example (h : finrank K W = 2) {x : MixedTensor K W (Fin 0) (Fin 0 ⊕ Fin (finrank K W))}
    (hx : x ∈ LieModule.maxTrivSubmodule K (slEnd K W)
      (MixedTensor K W (Fin 0) (Fin 0 ⊕ Fin (finrank K W))))
    (hs : (permRep K (Module.Dual K W) _
      (Equiv.swap (Sum.inr ⟨0, by omega⟩) (Sum.inr ⟨1, by omega⟩))).lTensor _ x = x) :
    x = 0 :=
  eq_zero_of_swap_invariant hx (by simp) hs

end TopDegree

