import HodgeLean.Papers.G32ModuliDefs
import HodgeLean.Papers.PapersG32CertificatesDefs

/-! # G32 Theorem A, stage 2: the Hurwitz family and its Prym factor (definitions)

Stage 2 of the premise-first route to G32 v0.16 Theorem A supplies the fields `S`, `fiber` and
`fiber_polarized` of `g32m_StageFields`: the paper's family of `G₃₂`-covers of `ℙ¹` and the
`ρ`-isotypic factor `A_ρ(C)` of each Jacobian. This file records:

* the finite data the repository can carry: the class datum `g32h_classRep` (six reflections of
  class `𝓡₁`, six of class `𝓡₂`, one element of class `𝓘`), the matrix group `g32h_G` generated
  by the printed `r₁, r₂, x, y`, conjugacy in it, and the Nielsen class `g32h_Nielsen`;
* the two Chevalley–Weil counts of G32 Proposition 3.1 for the natural representation `ρ`
  (`g32h_multCW`, through ranks of `ρ(g) - 1`, and `g32h_holoCW`, through ages), and the
  centralizer dimension `g32h_centralizerDim` that enters Katz's rigidity count;
* the dimensions `g32h_h10`, `g32h_h01` of the two Hodge pieces of the `i√3`-eigenspace on `H¹`
  of a bundled sixfold;
* `g32h_PrymFamily`: the named premise holding the index set, the monodromy tuple and the fibre
  `A_ρ(C)` of each cover, with Chevalley–Weil and G32 Lemma 3.3 recorded as link fields;
* `g32h_RemainingFields`: the five fields of `g32m_StageFields` that stages 3–6 supply.

Nothing here asserts Theorem A, a discriminant, algebraicity or dominance. HC no distance; AV
milestone no distance.
-/

noncomputable section

open CategoryTheory AlgebraicGeometry AlgebraicGeometry.ComplexPoint TopologicalSpace
open scoped CategoryTheory.MonObj Manifold ContDiff
open HodgeLean.RealDefs HodgeLean.Foundations HodgeLean.Foundations.WeilPower
open HodgeLean.Foundations.Symplectic HodgeLean.Foundations.HermitianForm HodgeLean.Adapters

namespace HodgeLean.Papers

/-! ## The finite data -/

/-- **The cube root of unity `ω = e^{2πi/3}`** of G32, in `ℂ`.
Source: G32 v0.16, Subsection 1.4 and Appendix A (`ω = e^{2πi/3}`). -/
def g32h_omega : ℂ := Complex.exp (2 * Real.pi * Complex.I / 3)

/-- `ω² + ω + 1 = 0`, the hypothesis of the printed certificates.
Source: `ω` is a primitive cube root of unity (Mathlib's `Complex.isPrimitiveRoot_exp`). -/
theorem g32h_omega_sq_add : g32h_omega ^ 2 + g32h_omega + 1 = 0 := by
  have h := (Complex.isPrimitiveRoot_exp 3 (by norm_num)).geom_sum_eq_zero (by norm_num)
  simp only [Finset.sum_range_succ, Finset.sum_range_zero, pow_zero, pow_one] at h
  rw [g32h_omega, show 2 * Real.pi * Complex.I / 3 = 2 * Real.pi * Complex.I / (3 : ℕ) by
    norm_num]
  linear_combination h

example : g32h_omega ≠ 1 := by
  intro h
  have := g32h_omega_sq_add
  rw [h] at this
  norm_num at this

/-- **The class datum**: representatives of the thirteen local monodromy classes, the printed
reflection `r₁` (class `𝓡₁`, nontrivial eigenvalue `ω`) at positions `0, …, 5`, the printed
reflection `r₂` (class `𝓡₂`, nontrivial eigenvalue `ω²`) at positions `6, …, 11`, and `x²`
(class `𝓘`, eigenvalues `(1, 1, -1, -1)`) at position `12`.
Source: G32 v0.16, Definition 3.5 (the class datum) and Subsection 3.3 (`𝓡₁`, `𝓡₂` are the
classes of `r₁`, `r₂`; `𝓘` is the class of `x²`); Appendix A (the matrices). -/
def g32h_classRep {K : Type*} [Field K] (w : K) (j : Fin 13) : Matrix (Fin 4) (Fin 4) K :=
  if (j : ℕ) < 6 then g32R1 w else if (j : ℕ) < 12 then g32R2 w else g32X w * g32X w

example {K : Type*} [Field K] (w : K) : g32h_classRep w 12 = g32X w * g32X w := rfl

example {K : Type*} [Field K] (w : K) : g32h_classRep w 7 = g32R2 w := rfl

/-- **The group `G = G₃₂`** as the submonoid of `M₄(ℂ)` generated by the printed `r₁, r₂, x, y`.
Each generator has finite order (`r₁³ = r₂³ = y³ = x⁴ = 1`), so this submonoid is a group, the
group `⟨r₁, r₂, x, y⟩` of the paper. Its order `155 520` is not used.
Source: G32 v0.16, Subsection 3.3 and Appendix A (`G = ⟨r₁, r₂, x, y⟩ ⊂ GL₄(K)`). -/
def g32h_G : Submonoid (Matrix (Fin 4) (Fin 4) ℂ) :=
  Submonoid.closure {g32R1 g32h_omega, g32R2 g32h_omega, g32X g32h_omega, g32Y g32h_omega}

example : g32X g32h_omega ∈ g32h_G := Submonoid.subset_closure (by simp)

/-- **Conjugacy in `G`**: `g = h c h⁻¹` for some `h ∈ G`, with the inverse `h'` also in `G`.
Source: G32 v0.16, Subsection 3.1 (conjugacy classes `𝓒_j` of `G`). -/
def g32h_ConjIn (c g : Matrix (Fin 4) (Fin 4) ℂ) : Prop :=
  ∃ h ∈ g32h_G, ∃ h' ∈ g32h_G, h * h' = 1 ∧ g = h * c * h'

example (c : Matrix (Fin 4) (Fin 4) ℂ) : g32h_ConjIn c c :=
  ⟨1, one_mem _, 1, one_mem _, by simp, by simp⟩

/-- **The Nielsen class of the class datum**: thirteen elements of `G`, each conjugate in `G` to
the representative of its class, the classes forming the class datum in some order (six in `𝓡₁`,
six in `𝓡₂`, one in `𝓘`), with product `g₁ ⋯ g₁₃ = 1`, and generating `G`. By the Riemann
existence theorem a connected Galois `G`-cover of `ℙ¹` branched over thirteen ordered points with
these local classes is such a tuple up to simultaneous conjugation (G32 Subsection 3.1).
Source: G32 v0.16, Subsection 3.1 (the Nielsen class) and Definition 3.5 (the class datum);
Fried–Völklein, *The inverse Galois problem and rational points on moduli spaces*, Math. Ann. 290
(1991), §1. -/
def g32h_Nielsen (g : Fin 13 → Matrix (Fin 4) (Fin 4) ℂ) : Prop :=
  (∃ σ : Equiv.Perm (Fin 13), ∀ j, g32h_ConjIn (g32h_classRep g32h_omega (σ j)) (g j)) ∧
    (List.ofFn g).prod = 1 ∧ Submonoid.closure (Set.range g) = g32h_G

/-- A Nielsen tuple lies in `G`. -/
example (g : Fin 13 → Matrix (Fin 4) (Fin 4) ℂ) (hg : g32h_Nielsen g) (j : Fin 13) :
    g j ∈ g32h_G := by
  rw [← hg.2.2]
  exact Submonoid.subset_closure ⟨j, rfl⟩

/-- **The Chevalley–Weil multiplicity for `ρ`**: `m_ρ = -2 d + Σ_j c_ρ(g_j)` with `d = 4` and
`c_ρ(g) = rk(ρ(g) - 1)`, for the natural representation `ρ` (the matrices themselves). For a
`G`-cover with monodromy tuple `g` and `ρ` nontrivial irreducible, this is the multiplicity of
`ρ` in `H¹(C, ℂ)`.
Source: G32 v0.16, Proposition 3.1 (first formula). -/
def g32h_multCW {K : Type*} [Field K] {n : ℕ} (g : Fin n → Matrix (Fin 4) (Fin 4) K) : ℤ :=
  -2 * 4 + ∑ j, ((g j - 1).rank : ℤ)

example {K : Type*} [Field K] : g32h_multCW (fun _ : Fin 0 => (1 : Matrix (Fin 4) (Fin 4) K)) =
    -8 := by
  simp [g32h_multCW]

/-- **The angle of a complex number**: `α ∈ [0, 1)` with `z = |z| e^{2πiα}` (and `0` for `z = 0`).
Source: G32 v0.16, Subsection 3.1 (eigenvalues `e^{2πiα_k}` with `0 ≤ α_k < 1`). -/
def g32h_angle (z : ℂ) : ℝ :=
  toIcoMod Real.two_pi_pos 0 (Complex.arg z) / (2 * Real.pi)

example : g32h_angle 1 = 0 := by
  simp [g32h_angle]

/-- **The age** `age(M) = Σ_k α_k` of a `4 × 4` complex matrix, over its eigenvalues
`e^{2πiα_k}` counted with multiplicity (the roots of its characteristic polynomial).
Source: G32 v0.16, Subsection 3.1 (`age τ(g)`). -/
def g32h_age (M : Matrix (Fin 4) (Fin 4) ℂ) : ℝ :=
  (M.charpoly.roots.map g32h_angle).sum

example (M : Matrix (Fin 4) (Fin 4) ℂ) :
    g32h_age M = (M.charpoly.roots.map g32h_angle).sum :=
  rfl

/-- **The Chevalley–Weil holomorphic count for `ρ`**:
`dim Hom_G(ρ, H⁰(C, K_C)) = Σ_j age ρ(g_j⁻¹) - d`, `d = 4`.
Source: G32 v0.16, Proposition 3.1 (second formula); Frediani–Ghigi–Penegini, *Shimura
varieties in the Torelli locus via Galois coverings*, IMRN 2015, Theorem 2.10. -/
def g32h_holoCW {n : ℕ} (g : Fin n → Matrix (Fin 4) (Fin 4) ℂ) : ℝ :=
  ∑ j, g32h_age (g j)⁻¹ - 4

example : g32h_holoCW (fun _ : Fin 0 => (1 : Matrix (Fin 4) (Fin 4) ℂ)) = -4 := by
  simp [g32h_holoCW]

/-- **The centralizer dimension** of a `4 × 4` matrix `M`: the dimension of
`{A | A M = M A}`. The conjugacy class of `M` in `GL₄` has dimension `16` minus this.
Source: Katz, *Rigid Local Systems*, Ann. of Math. Stud. 139 (1996), §1.1; G32 v0.16,
Subsection 5.2 (the class dimensions `6 + 6 + 10 + 8`). -/
def g32h_centralizerDim {K : Type*} [Field K] (M : Matrix (Fin 4) (Fin 4) K) : ℕ :=
  Module.finrank K (LinearMap.ker (LinearMap.mulRight K M - LinearMap.mulLeft K M))

example {K : Type*} [Field K] (M A : Matrix (Fin 4) (Fin 4) K) (h : A * M = M * A) :
    A ∈ LinearMap.ker (LinearMap.mulRight K M - LinearMap.mulLeft K M) := by
  simp [h]

/-! ## Hodge numbers of the `i√3`-eigenspace -/

/-- **`dim (V_s ∩ H^{1,0})`** for a bundled sixfold: the `(1,0)`-part of the `i√3`-eigenspace
of its Weil action on `H¹(X(ℂ); ℂ)`.
Source: G32 v0.16, Definition 2.1 (multiplicities of the embeddings of `K`); the vocabulary of
`IsWeilType` and `isWeilType_iff_finrank_eq`. -/
def g32h_h10 (P : g32t_Sixfold) : ℕ :=
  letI := (torusCohomology_cupProductOf P.X).finite
  Module.finrank ℂ ↥(P.W.Vs ⊓ (abelianVarietyCohomologyOf (finiteBetti_abelian P.X)
    (spec_bettiDeRhamIso_abelian P.X) (hodgeDecomposition_of_abelian P.X)
    (torusCohomology_cupProductOf P.X)).weight1.H (1, 0))

/-- **`dim (V_s ∩ H^{0,1})`** for a bundled sixfold.
Source: as for `g32h_h10`. -/
def g32h_h01 (P : g32t_Sixfold) : ℕ :=
  letI := (torusCohomology_cupProductOf P.X).finite
  Module.finrank ℂ ↥(P.W.Vs ⊓ (abelianVarietyCohomologyOf (finiteBetti_abelian P.X)
    (spec_bettiDeRhamIso_abelian P.X) (hodgeDecomposition_of_abelian P.X)
    (torusCohomology_cupProductOf P.X)).weight1.H (0, 1))

/-- Equal Hodge numbers of `V_s` are Weil type. -/
example (P : g32t_Sixfold) (h : g32h_h10 P = g32h_h01 P) :
    letI := (torusCohomology_cupProductOf P.X).finite; P.W.IsWeilType :=
  (isWeilType_iff_finrank_eq _ _ _ _ P.W).2 h

/-! ## The premise -/

/-- **The `G₃₂` Hurwitz family and its Prym factor (premise).** An index set `S` (in the paper,
the component `Hur°` of the Hurwitz space of the class datum), and for each `s : S`

* `tuple s`: the monodromy tuple of the cover `C_s → ℙ¹`, in the Nielsen class
  (`tuple_nielsen`);
* `fiber s`: the bundled sixfold `A_ρ(C_s) = im(N₀ e : J(C_s) → J(C_s))`, with the action `ι` of
  the centre `K` of `ℚ[G] ε_ρ` as its Weil action and the restricted polarization `E` as `pol`;

with the following facts, each the conclusion of a cited theorem applied to `tuple s`:

* `dim_eq`: `dim A_ρ(C_s) = m_ρ`, the Chevalley–Weil multiplicity of `tuple s` (G32
  Proposition 3.1 and Lemma 3.3);
* `hodge`: the two Hodge pieces of the `i√3`-eigenspace of `H¹(A_ρ(C_s))` have dimensions
  `p_ρ = dim Hom_G(ρ, H⁰(K_C))` and `m_ρ - p_ρ`, in one of the two orders (which order depends on
  the choice of the embedding `K → ℂ` and on `H¹` against `H₁`), with `p_ρ` the Chevalley–Weil
  holomorphic count of `tuple s` (G32 Proposition 3.1 and Lemma 3.3; FGP, Theorem 2.10);
* `nondegenerate`, `rosati`, `positive`: the restricted polarization `E` is nondegenerate, `ι(K)`
  is Rosati-stable acting by complex conjugation, and `E` is positive (G32 Lemma 3.3 and
  Definition 3.2).

Weil type and `dim = 6` are not fields: they follow from `dim_eq`, `hodge` and the finite counts
`m_ρ = 6`, `p_ρ = 3` on the Nielsen class (the frozen statements `g32h_multCW_of_nielsen`,
`g32h_holoCW_of_nielsen`, `g32h_fiber_polarized`). No field states a discriminant, algebraicity
or dominance. The construction of `A_ρ(C)` from a Jacobian, and the relation between `tuple s`
and `fiber s` beyond the counts, are not recorded: the repository has no Hurwitz spaces,
Jacobians or Prym–Tyurin factors. This structure is a premise; nothing derives it.
Source: G32 v0.16, Subsections 3.1–3.3, Proposition 3.1, Definition 3.2, Lemma 3.3,
Definition 3.5 and Lemma 3.6 (`Hur°`, `A_ρ(C)` is a polarized sixfold of Weil type); Chevalley–Weil
in the form of Frediani–Ghigi–Penegini, *Shimura varieties in the Torelli locus via Galois
coverings*, IMRN 2015, Theorem 2.10; Birkenhake–Lange, *Complex Abelian Varieties*, 2nd ed.,
Ch. 12 (Prym–Tyurin factors). -/
structure g32h_PrymFamily where
  /-- The index set (the Hurwitz component `Hur°`). -/
  S : Type
  /-- The monodromy tuple of each cover. -/
  tuple : S → Fin 13 → Matrix (Fin 4) (Fin 4) ℂ
  /-- Each monodromy tuple lies in the Nielsen class of the class datum. -/
  tuple_nielsen : ∀ s, g32h_Nielsen (tuple s)
  /-- The `ρ`-isotypic factor `A_ρ(C_s)`. -/
  fiber : S → g32t_Sixfold
  /-- Chevalley–Weil: `dim A_ρ(C_s) = m_ρ`. -/
  dim_eq : ∀ s, (dim (fiber s).X.left : ℤ) = g32h_multCW (tuple s)
  /-- Chevalley–Weil: the Hodge numbers of the `i√3`-eigenspace are `(p_ρ, m_ρ - p_ρ)` up to
  order. -/
  hodge : ∀ s,
    ((g32h_h10 (fiber s) : ℝ) = g32h_holoCW (tuple s) ∧
        (g32h_h01 (fiber s) : ℝ) = g32h_multCW (tuple s) - g32h_holoCW (tuple s)) ∨
      ((g32h_h01 (fiber s) : ℝ) = g32h_holoCW (tuple s) ∧
        (g32h_h10 (fiber s) : ℝ) = g32h_multCW (tuple s) - g32h_holoCW (tuple s))
  /-- The restricted polarization is nondegenerate. -/
  nondegenerate : ∀ s,
    IsNondegenerate (polarizationVec (torusCohomology_cupProductOf (fiber s).X) (fiber s).pol)
  /-- `ι(K)` is Rosati-stable. -/
  rosati : ∀ s, letI := (torusCohomology_cupProductOf (fiber s).X).finite
    IsRosatiSkew (polarizationVec (torusCohomology_cupProductOf (fiber s).X) (fiber s).pol)
      (fiber s).W.J
  /-- The restricted polarization is positive. -/
  positive : ∀ s, PolarizationPositive (finiteBetti_abelian (fiber s).X)
    (spec_bettiDeRhamIso_abelian (fiber s).X) (hodgeDecomposition_of_abelian (fiber s).X)
    (torusCohomology_cupProductOf (fiber s).X) (nondegenerate s)

/-- A Prym family indexes its fibres by Nielsen tuples. -/
example (P : g32h_PrymFamily) (s : P.S) : g32h_Nielsen (P.tuple s) := P.tuple_nielsen s

/-- **The fields of `g32m_StageFields` that stages 3–6 supply** over a Prym family `P`: the
discriminant (stage 5), algebraicity of the Weil classes (stage 3), dominance (stage 4), Hilbert
spreading and isogeny transport (stage 6). Each has the type of the field of `g32m_StageFields`
with the same name, with `S := P.S` and `fiber := P.fiber`; `fiber_disc` is stated for every
proof of `g32t_PolarizedWeil`, which by proof irrelevance is the same condition.
Source: G32 v0.16, Proposition 4.6, Corollary 5.11, Proposition 6.3, Lemma 7.1, Lemma 2.2; the
fields of `g32m_StageFields`. -/
structure g32h_RemainingFields (F : g32m_UniversalFamily) (P : g32h_PrymFamily) where
  /-- Stage 5: each fibre has Hermitian discriminant `[-2]`. -/
  fiber_disc : ∀ s (h : g32t_PolarizedWeil (P.fiber s)), g32t_disc h = classNegTwo
  /-- Stage 3: the Weil classes of each fibre are algebraic. -/
  fiber_alg : ∀ s, g32t_WeilAlg (P.fiber s)
  /-- Stage 4: dominance. -/
  dominant : ∃ U : Set g32m_Domain, IsOpen U ∧ U.Nonempty ∧
    ∀ m ∈ U, ∃ s, g32t_KIsog (P.fiber s) (F.univ m)
  /-- Hilbert spreading. -/
  spread : ∃ C : Set (Set g32m_Domain), C.Countable ∧
    (∀ Z ∈ C, IsClosedAnalytic (Fin 9 → ℂ) Z) ∧ {m | g32t_WeilAlg (F.univ m)} = ⋃₀ C
  /-- Isogeny transport. -/
  transport : ∀ P Q, g32t_KIsog P Q → (g32t_WeilAlg P ↔ g32t_WeilAlg Q)

/-- The remaining fields give a fibre. -/
example (F : g32m_UniversalFamily) (P : g32h_PrymFamily) (R : g32h_RemainingFields F P) :
    Nonempty P.S :=
  let ⟨_, _, ⟨m, hm⟩, h⟩ := R.dominant
  let ⟨s, _⟩ := h m hm
  ⟨s⟩

end HodgeLean.Papers
