namespace HodgeLean.Papers

open Polynomial

/-! ## Norms from imaginary quadratic fields -/

/-- The norm of `a + b ω` from `ℚ(ω)` to `ℚ`, `ω² + ω + 1 = 0`: `(a + bω)(a + bω̄) = a² − ab + b²`.
Source: standard (`ω + ω̄ = −1`, `ω ω̄ = 1`); G32 v0.16, proof of Proposition 6.3. -/
def normOmega (a b : ℚ) : ℚ := a ^ 2 - a * b + b ^ 2

example (ω : ℂ) (hω : ω ^ 2 + ω + 1 = 0) (a b : ℚ) :
    ((a : ℂ) + b * ω) * ((a : ℂ) + b * ω ^ 2) = (normOmega a b : ℂ) := by
  have h3 : ω ^ 3 = 1 := by linear_combination (ω - 1) * hω
  push_cast [normOmega]
  linear_combination (a * b : ℂ) * hω + (b : ℂ) ^ 2 * h3

/-- The norm of `a + b i` from `ℚ(i)` to `ℚ`: `a² + b²`.
Source: standard; QI v0.7, proof of Proposition 8.2; TT v0.16, Section 11. -/
def normGaussian (a b : ℚ) : ℚ := a ^ 2 + b ^ 2

example : normGaussian 1 1 = 2 := by norm_num [normGaussian]

/-- `a` and `b` have the same class in `ℚ^× / Nm K^×` for `K = ℚ(√−D)`: `a = b · Nm(x + y√−D)` for
some element of nonzero norm `x² + D y²`. For `D > 0` the nonzero norms are those of the nonzero
elements of `K`.
Source: G34 v1.5, Section 10 (classes in `ℚ^×/Nm K^×`); the norm form of `ℚ(√−D)`. -/
def SameNormClass (D a b : ℚ) : Prop :=
  ∃ x y : ℚ, x ^ 2 + D * y ^ 2 ≠ 0 ∧ a = b * (x ^ 2 + D * y ^ 2)

example (D : ℚ) : SameNormClass D 4 1 := ⟨2, 0, by norm_num, by norm_num⟩

/-! ## Item 3: G32 Proposition 6.3 -/

/-- The printed Gram matrix `h_0` of G32 Proposition 6.3 (`prop:disc`), with `ω` any element of a
field `K` (in the paper, a primitive cube root of unity in `K = ℚ(√−3)`). Entries transcribed
exactly as printed, row by row.
Source: G32 v0.16 (`weil-nonsplit-g32-v0.16`), proof of Proposition 6.3. -/
def g32H0 {K : Type*} [Field K] (ω : K) : Matrix (Fin 6) (Fin 6) K :=
  !![2/3, -1/3, 0, -ω - 1/3, -2/3 * ω, 0;
     -1/3, 2/3, 0, ω + 2/3, 1/3 * ω, 0;
     0, 0, 1/3, 0, 0, -1/3 * ω;
     ω + 2/3, -ω - 1/3, 0, 2/3, -2/3 * ω, 0;
     2/3 * ω + 2/3, -1/3 * ω - 1/3, 0, 2/3 * ω + 2/3, -2/3, 0;
     0, 0, 1/3 * ω + 1/3, 0, 0, -1/3]

example {K : Type*} [Field K] (ω : K) : g32H0 ω 2 5 = -1/3 * ω := rfl

/-- The printed characteristic polynomial of G32 Proposition 6.3, in its expanded form
`x⁶ − 4/3 x⁵ − 26/9 x⁴ + 41/27 x³ + 19/27 x² − 22/81 x − 2/81`.
Source: G32 v0.16, proof of Proposition 6.3. -/
noncomputable def g32Charpoly : ℚ[X] :=
  X ^ 6 - C (4/3) * X ^ 5 - C (26/9) * X ^ 4 + C (41/27) * X ^ 3 + C (19/27) * X ^ 2
    - C (22/81) * X - C (2/81)

example : g32Charpoly.eval 0 = -2/81 := by simp [g32Charpoly]; norm_num

/-- The real roots of a rational polynomial, with multiplicity.
Source: Mathlib `Polynomial.roots`, `Polynomial.map`. -/
noncomputable def realRoots (p : ℚ[X]) : Multiset ℝ := (p.map (algebraMap ℚ ℝ)).roots

example : realRoots (X - C 2) = {2} := by
  simp [realRoots, Polynomial.map_sub, Polynomial.roots_X_sub_C]

/-- The number of positive real roots of a rational polynomial, with multiplicity.
Source: Sylvester's law of inertia reads the signature of a Hermitian matrix off the signs of the
roots of its characteristic polynomial (G32 v0.16, proof of Proposition 6.3). -/
noncomputable def posRealRootCount (p : ℚ[X]) : ℕ := ((realRoots p).filter (0 < ·)).card

example : posRealRootCount 0 = 0 := by simp [posRealRootCount, realRoots]

/-- The number of negative real roots of a rational polynomial, with multiplicity.
Source: as for `posRealRootCount`. -/
noncomputable def negRealRootCount (p : ℚ[X]) : ℕ := ((realRoots p).filter (· < 0)).card

example : negRealRootCount 0 = 0 := by simp [negRealRootCount, realRoots]

/-! ## Item 4: QI Proposition 8.2 -/

/-- The printed Gram matrix `h_0` of QI Proposition 8.2 (`prop:dominance`), with `ι` any element of
a field `K` (in the paper, `i ∈ K = ℚ(i)`). Entries transcribed exactly as printed, row by row.
Source: QI v0.7 (`weil-qi-m3-v0.7`), proof of Proposition 8.2. -/
def qiH0 {K : Type*} [Field K] (ι : K) : Matrix (Fin 6) (Fin 6) K :=
  !![-2, 1 + ι, 0, -1 - ι, 2 + ι, -1 + ι;
     1 - ι, 2, 2 * ι, 0, -1 - 3 * ι, 2;
     0, -2 * ι, 0, ι, 0, -1 - ι;
     -1 + ι, 0, -ι, 0, ι, 0;
     2 - ι, -1 + 3 * ι, 0, -ι, -1, 3/2 + 1/2 * ι;
     -1 - ι, 2, -1 + ι, 0, 3/2 - 1/2 * ι, 0]

example {K : Type*} [Field K] (ι : K) : qiH0 ι 4 5 = 3/2 + 1/2 * ι := rfl

/-! ## Item 7: multiplicities and Hodge numbers from local monodromy -/

/-- The local monodromy of one branch point, recorded by the eigenvalue angles `α_k ∈ [0, 1)` of
`τ(g_j)` (eigenvalues `e^{2πiα_k}`).
Source: G32 v0.16, Subsection 3.1 (definitions of `c_τ` and `age`). -/
abbrev Angles := List ℚ

/-- `c_τ(g) = rk(τ(g) − 1)`: the number of nonzero angles.
Source: G32 v0.16, Subsection 3.1. -/
def rankDefect (θ : Angles) : ℕ := θ.countP (· ≠ 0)

example : rankDefect [1/3, 0, 0, 0] = 1 := by norm_num [rankDefect]

/-- `age τ(g) = Σ_k α_k`.
Source: G32 v0.16, Subsection 3.1. -/
def age (θ : Angles) : ℚ := θ.sum

example : age [0, 0, 1/2, 1/2] = 1 := by norm_num [age]

/-- The angles of `τ(g⁻¹)`: `α ↦ 1 − α` on the nonzero angles.
Source: eigenvalues of the inverse are the inverse eigenvalues. -/
def invAngles (θ : Angles) : Angles := θ.map fun a => if a = 0 then 0 else 1 - a

example : invAngles [1/3, 0] = [2/3, 0] := by norm_num [invAngles]

/-- The first formula of G32 Proposition 3.1: `m_τ = −2d + Σ_j c_τ(g_j)`.
Source: G32 v0.16, Proposition 3.1; QI v0.7, Proposition 3.1; G34 v1.5, Proposition 3.1. -/
def defectMultiplicity (d : ℕ) (data : List Angles) : ℤ :=
  -2 * (d : ℤ) + ((data.map rankDefect).sum : ℤ)

example : defectMultiplicity 1 [[1/2], [1/2], [1/2]] = 1 := by
  norm_num [defectMultiplicity, rankDefect]

/-- The second formula of G32 Proposition 3.1 (Chevalley–Weil):
`dim Hom_G(τ, H⁰(C, K_C)) = Σ_j age τ(g_j⁻¹) − d`.
Source: G32 v0.16, Proposition 3.1; QI v0.7, Proposition 3.1; G34 v1.5, Proposition 3.1. -/
def holomorphicMultiplicity (d : ℕ) (data : List Angles) : ℚ :=
  ((data.map fun θ => age (invAngles θ)).sum) - d

example : holomorphicMultiplicity 1 [[1/2], [1/2], [1/2]] = 1/2 := by
  norm_num [holomorphicMultiplicity, age, invAngles]

/-- Riemann–Hurwitz for a Galois cover of `ℙ¹` of degree `n` with branch orders `e_j`:
`2g − 2 = n (−2 + Σ_j (1 − 1/e_j))`.
Source: G32 v0.16, proof of Lemma 3.6. -/
def riemannHurwitzEuler (n : ℕ) (orders : List ℕ) : ℚ :=
  n * (-2 + (orders.map fun e => 1 - 1 / (e : ℚ)).sum)

example : riemannHurwitzEuler 2 [2, 2] = -2 := by norm_num [riemannHurwitzEuler]

/-- The G32 class datum (Definition 3.5), as angles of `ρ(g_j)` on `K⁴`: six points in `𝓡₁`
(eigenvalues `(ω, 1, 1, 1)`), six in `𝓡₂` (`(ω², 1, 1, 1)`), one in `𝓘` (`(1, 1, −1, −1)`).
Source: G32 v0.16, Subsection 3.3, Definition 3.5 and proof of Lemma 3.6. -/
def g32Angles : List Angles :=
  List.replicate 6 [1/3, 0, 0, 0] ++ List.replicate 6 [2/3, 0, 0, 0] ++ [[0, 0, 1/2, 1/2]]

example : g32Angles.length = 13 := by decide

/-- The branch orders of the G32 class datum: twelve reflections of order 3, one involution.
Source: G32 v0.16, Definition 3.5 and proof of Lemma 3.6. -/
def g32BranchOrders : List ℕ := List.replicate 12 3 ++ [2]

example : g32BranchOrders.length = 13 := by decide

/-- The G34 class datum (Section 9), as angles of `σ(g_j)` on `K⁶`: twenty reflections, each with
eigenvalues `−1` once and `1` five times.
Source: G34 v1.5 (`weil-qsqrt3-v1.5`), Section 9 and proof of Lemma 9.1. -/
def g34Angles : List Angles := List.replicate 20 [1/2, 0, 0, 0, 0, 0]

example : g34Angles.length = 20 := by decide

/-- The angles of `i x₁` in QI Lemma 8.1: eigenvalues `∓1`, four of each.
Source: QI v0.7, proof of Lemma 8.1. -/
def qiAnglesIX1 : Angles := [0, 0, 0, 0, 1/2, 1/2, 1/2, 1/2]

example : qiAnglesIX1.length = 8 := by decide

/-- The angles of `i x₂` in QI Lemma 8.1, from the printed eigenvalues of `x₂` (characteristic
polynomial `Φ₂²Φ₆Φ₁₂`: `−1` twice, the primitive sixth and twelfth roots of unity) multiplied by
`i` (angle `1/4`), reduced modulo 1: `3/4, 3/4` from `−1`; `5/12, 1/12` from `e^{±2πi/6}`;
`1/3, 2/3, 5/6, 1/6` from `e^{2πik/12}`, `k = 1, 5, 7, 11`.
Source: QI v0.7, Section 8.1 and proof of Lemma 8.1 (which prints `c_σ(ix₂) = 8` and the angle
sum `4`). -/
def qiAnglesIX2 : Angles := [3/4, 3/4, 5/12, 1/12, 1/3, 2/3, 5/6, 1/6]

example : qiAnglesIX2.length = 8 := by decide

/-- The QI class datum (Section 8.1), as angles of `σ(g_j)` on `K⁸`: ten reflections of `W(E₈)`
(angles `(0⁷, 1/2)`), then `i x₁` and `i x₂`.
Source: QI v0.7, Section 8.1 and proof of Lemma 8.1. -/
def qiAngles : List Angles :=
  List.replicate 10 [0, 0, 0, 0, 0, 0, 0, 1/2] ++ [qiAnglesIX1, qiAnglesIX2]

example : qiAngles.length = 12 := by decide

