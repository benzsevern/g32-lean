/-- The componentwise sum of a list of imbalance vectors.
Source: QI v0.7, Definition 4.8 (`δ_t = Σ_χ n_χ (p_{χ^t} − q_{χ^t})`, summed over slots). -/
def sumImbalance (l : List (List ℤ)) : List ℤ := l.foldr (List.zipWith (· + ·)) [0, 0, 0, 0]

example : sumImbalance [[1, 2, 3, 4], [-1, -2, -3, -4]] = [0, 0, 0, 0] := by decide

