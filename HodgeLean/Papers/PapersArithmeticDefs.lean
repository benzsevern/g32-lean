/-- The exponent multiset of a row, with `a^k` expanded to `k` copies of `a`.
Source: G32 v0.16, Appendix B (notation `a^k`). -/
def expandExps (e : List (ℕ × ℕ)) : List ℕ := e.flatMap fun p => List.replicate p.2 p.1

example : expandExps [(1, 2), (2, 1)] = [1, 1, 2] := by decide

/-- Schoen's simplicity: after reordering, `α_{2i} = −α_{2i−1}` in `ℤ/m` for all `i`, i.e. the
exponents can be split into pairs with sum `≡ 0 (mod m)`.
Source: G32 v0.16, Subsection 4.1 (following Schoen, *Hodge classes on self-products of a variety
with an automorphism*, Compositio 65 (1988), §1). -/
def IsSimpleExps (m : ℕ) (α : List ℕ) : Prop :=
  ∃ L : List (ℕ × ℕ), (L.flatMap fun p => [p.1, p.2]).Perm α ∧ ∀ p ∈ L, (p.1 + p.2) % m = 0

example : IsSimpleExps 3 [1, 2] := ⟨[(1, 2)], List.Perm.refl _, by decide⟩

/-- The greatest common divisor of `m` and the exponents (column `d` of G32 Table 1).
Source: G32 v0.16, Appendix B ("`d = gcd(m, α)` for ramified rows"). -/
def gcdExps (m : ℕ) (e : List (ℕ × ℕ)) : ℕ := e.foldl (fun g p => Nat.gcd g p.1) m

example : gcdExps 6 [(2, 3), (4, 3)] = 2 := by decide

