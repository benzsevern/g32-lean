/-! ## Item 2: the monodromy tuples of Proposition 6.3 and the cocycle form of Lemma 6.2 -/

/-- **The printed `S₆` tuples have product one**: `π₀ π₁ π₂ π_∞ = 1` (composition, the right factor
acting first) for each of the four printed tuples.
Source: G32 v0.16, proof of Proposition 6.3 ("product-one tuple `(1,1,π₀,π₁,π₂,π_∞)`"). -/
theorem papers_g32_pi_prod :
    ∀ k : Fin 4, g32Pi k 0 * g32Pi k 1 * g32Pi k 2 * g32Pi k 3 = 1 :=
  papers_g32_pi_prod_aux

example :
    ∀ k : Fin 4, g32Pi k 0 * g32Pi k 1 * g32Pi k 2 * g32Pi k 3 = 1 :=
  papers_g32_pi_prod

/-- **Cycle types.** In each printed tuple, `π₀, π₁, π₂, π_∞` have cycle types `[2, 4]`, `[2, 1⁴]`,
`[2, 1⁴]`, `[3, 3]` (fixed points counted).
Source: G32 v0.16, proof of Proposition 6.3. -/
theorem papers_g32_pi_cycleType :
    ∀ k : Fin 4, (g32Pi k 0).partition.parts = {4, 2} ∧
      (g32Pi k 1).partition.parts = {2, 1, 1, 1, 1} ∧
      (g32Pi k 2).partition.parts = {2, 1, 1, 1, 1} ∧ (g32Pi k 3).partition.parts = {3, 3} :=
  papers_g32_pi_cycleType_aux

example :
    ∀ k : Fin 4, (g32Pi k 0).partition.parts = {4, 2} ∧
      (g32Pi k 1).partition.parts = {2, 1, 1, 1, 1} ∧
      (g32Pi k 2).partition.parts = {2, 1, 1, 1, 1} ∧ (g32Pi k 3).partition.parts = {3, 3} :=
  papers_g32_pi_cycleType

/-- **Transitivity.** Each printed tuple generates a transitive subgroup of `S₆`.
Source: G32 v0.16, proof of Proposition 6.3 ("generating a transitive group"). -/
theorem papers_g32_pi_transitive (k : Fin 4) :
    MulAction.IsPretransitive (Subgroup.closure (Set.range (g32Pi k))) (Fin 6) :=
  papers_g32_pi_transitive_aux k

example (k : Fin 4) :
    MulAction.IsPretransitive (Subgroup.closure (Set.range (g32Pi k))) (Fin 6) :=
  papers_g32_pi_transitive k

/-- **The four printed tuples are pairwise inequivalent** under simultaneous conjugation by `S₆`.
This is the "at least four classes" half of the printed count; that every transitive product-one
tuple of these cycle types is conjugate to one of them is not claimed here.
Source: G32 v0.16, proof of Proposition 6.3 ("exactly four classes under simultaneous conjugation by
`S₆`, with representatives"). -/
theorem papers_g32_pi_not_conj (k l : Fin 4) (hkl : k ≠ l) :
    ¬ ∃ g : Equiv.Perm (Fin 6), ∀ j, g * g32Pi k j * g⁻¹ = g32Pi l j :=
  papers_g32_pi_not_conj_aux k l hkl

example (k l : Fin 4) (hkl : k ≠ l) :
    ¬ ∃ g : Equiv.Perm (Fin 6), ∀ j, g * g32Pi k j * g⁻¹ = g32Pi l j :=
  papers_g32_pi_not_conj k l hkl

/-- **The rank-24 tuple has product one.** For each printed `S₆` tuple,
`T₁ ⋯ T₆ = 1` for `(T₁, …, T₆) = (r₁ ⊗ 1, r₂ ⊗ 1, x ⊗ π₀, 1 ⊗ π₁, 1 ⊗ π₂, y ⊗ π_∞)`, the tuple to
which G32 applies Lemma 6.2. This is the product-one hypothesis of Lemma 6.2 for the printed data;
the rank and Gram matrix of the cocycle form are not claimed here.
Source: G32 v0.16, proof of Proposition 6.3 and Lemma 6.2 (`lem:cocycle`). -/
theorem papers_g32_cocycleTuple_prod {K : Type*} [Field K] [CharZero K] (ω : K) (hω : ω ^ 2 + ω + 1 = 0) (k : Fin 4) :
    g32CocycleTuple ω k 0 * g32CocycleTuple ω k 1 * g32CocycleTuple ω k 2 *
      g32CocycleTuple ω k 3 * g32CocycleTuple ω k 4 * g32CocycleTuple ω k 5 = 1 :=
  papers_g32_cocycleTuple_prod_aux ω hω k

example {K : Type*} [Field K] [CharZero K] (ω : K) (hω : ω ^ 2 + ω + 1 = 0) (k : Fin 4) :
    g32CocycleTuple ω k 0 * g32CocycleTuple ω k 1 * g32CocycleTuple ω k 2 *
      g32CocycleTuple ω k 3 * g32CocycleTuple ω k 4 * g32CocycleTuple ω k 5 = 1 :=
  papers_g32_cocycleTuple_prod ω hω k

/-- **The printed `h_0` is a Gram matrix of the cocycle form.** For each of the four printed `S₆`
tuples, there are six parameter tuples `z₁, …, z₆` in the space `Z` of the rank-24 tuple on which
`h_par = δ S`, `δ = 1 + 2ω = √−3`, with `S` the cup-product formula of Lemma 6.2, has Gram matrix
exactly the printed `h_0` (papers1's `g32H0`). Together with `det h_0 = −2/81 ≠ 0`
(`papers_g32_h0_det`) this gives rank at least `6` on `Z`. It does not claim that the rank is exactly
`6`, that `dim Z = 120`, that the `z_a` are the printed choice from the reduced row echelon basis, or
that `S` is the cup product on parabolic cohomology (Lemma 6.2 itself), let alone the Hermitian form
of `A_ρ(C)` (Proposition 6.1).
Source: G32 v0.16, Lemma 6.2 (`lem:cocycle`) and proof of Proposition 6.3. -/
theorem papers_g32_cocycle_gram_h0 (ω : ℂ) (hω : ω ^ 2 + ω + 1 = 0) (k : Fin 4) :
    ∃ z : Fin 6 → G32CocycleParam, (∀ a, G32InCocycleSpace ω k (z a)) ∧
      ∀ a b, (1 + 2 * ω) * g32CocycleS ω k (z a) (z b) = g32H0 ω a b :=
  papers_g32_cocycle_gram_h0_aux ω hω k

example (ω : ℂ) (hω : ω ^ 2 + ω + 1 = 0) (k : Fin 4) :
    ∃ z : Fin 6 → G32CocycleParam, (∀ a, G32InCocycleSpace ω k (z a)) ∧
      ∀ a b, (1 + 2 * ω) * g32CocycleS ω k (z a) (z b) = g32H0 ω a b :=
  papers_g32_cocycle_gram_h0 ω hω k

