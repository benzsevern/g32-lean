/-! ## Item 1: G32 Proposition 4.5, the character identity (Appendix B, Table 2) -/

/-- **Table 2 cross-checks Table 1.** The index and coefficient columns of Table 2 agree, row by row,
with those of Table 1 (`g32WitnessTable`, papers1): row `i` of Table 1 is the supplier of `a(χ_i)`.
Source: G32 v0.16, Appendix B, Tables 1 and 2. -/
theorem papers_g32_vectors_index :
    g32VectorTable.map (fun r => (r.i, r.n)) = g32WitnessTable.map (fun r => (r.i, r.n)) :=
  papers_g32_vectors_index_aux

example :
    g32VectorTable.map (fun r => (r.i, r.n)) = g32WitnessTable.map (fun r => (r.i, r.n)) :=
  papers_g32_vectors_index

/-- **`Σ_i |n_i| = 56`** for the coefficients printed in Table 2.
Source: G32 v0.16, Proposition 4.5 and Appendix B, Table 2. -/
theorem papers_g32_vectors_abs_sum :
    (g32VectorTable.map fun r => r.n.natAbs).sum = 56 :=
  papers_g32_vectors_abs_sum_aux

example :
    (g32VectorTable.map fun r => r.n.natAbs).sum = 56 :=
  papers_g32_vectors_abs_sum

/-- **The printed sparse vectors are well formed.** In every row of Table 2 the printed coordinates
are strictly increasing and lie in `1, …, 48`, every printed value is nonzero, and every printed
value at a coordinate of order two (`45, …, 48`) is odd, so it is nonzero in `ℤ/2`.
Source: G32 v0.16, Appendix B, Table 2 ("the nonzero coordinates of each `a(χ_i)`"). -/
theorem papers_g32_vectors_wellFormed :
    ∀ r ∈ g32VectorTable, (r.coords.map Prod.fst).Pairwise (· < ·) ∧
      ∀ p ∈ r.coords, 1 ≤ p.1 ∧ p.1 ≤ 48 ∧ p.2 ≠ 0 ∧ (45 ≤ p.1 → Odd p.2) :=
  papers_g32_vectors_wellFormed_aux

example :
    ∀ r ∈ g32VectorTable, (r.coords.map Prod.fst).Pairwise (· < ·) ∧
      ∀ p ∈ r.coords, 1 ≤ p.1 ∧ p.1 ≤ 48 ∧ p.2 ≠ 0 ∧ (45 ≤ p.1 → Odd p.2) :=
  papers_g32_vectors_wellFormed

/-- **Supports as printed.** For every row of Table 2 the vector `a(χ_i) ∈ ℤ⁴⁴ ⊕ (ℤ/2)⁴` built from
the printed pairs is nonzero exactly at the printed coordinates.
Source: G32 v0.16, Appendix B, Table 2. -/
theorem papers_g32_vectors_support :
    ∀ r ∈ g32VectorTable,
      g32LatticeSupport (g32SparseVec r.coords) = (r.coords.map Prod.fst).toFinset :=
  papers_g32_vectors_support_aux

example :
    ∀ r ∈ g32VectorTable,
      g32LatticeSupport (g32SparseVec r.coords) = (r.coords.map Prod.fst).toFinset :=
  papers_g32_vectors_support

/-- **The character identity, on the printed data.** In `X*(T) = ℤ⁴⁴ ⊕ (ℤ/2)⁴`, the fifty-one
printed vectors of Table 2 with the printed coefficients sum to `e_ρ`: `Σ_i n_i a(χ_i) = e_ρ`. This
checks the printed vectors and coefficients; it does not check that the printed vectors are the
characters `a(χ_i)` of the suppliers (the GAP computation), nor condition (L) of Theorem A.
Source: G32 v0.16, Proposition 4.5 (`prop:lattice`) and Appendix B, Table 2. -/
theorem papers_g32_character_identity :
    g32CharSum g32VectorTable = g32ERho :=
  papers_g32_character_identity_aux

example :
    g32CharSum g32VectorTable = g32ERho :=
  papers_g32_character_identity

/-- **The printed sum, over the integers.** Summing `n_i a(χ_i)` with the printed integer values gives
`1` in coordinate `3`, `0` in the other free coordinates, and even values in coordinates `45` to `48`
(index `c` is printed coordinate `c + 1`).
Source: G32 v0.16, Appendix B ("Summing `n_i a(χ_i)` gives 1 in coordinate 3, 0 in the other free
coordinates, and even values in coordinates 45 to 48"). -/
theorem papers_g32_character_identity_int :
    ∀ c : Fin 48, (c.val < 44 → g32IntCharSum g32VectorTable c = if c.val = 2 then 1 else 0) ∧
      (44 ≤ c.val → Even (g32IntCharSum g32VectorTable c)) :=
  papers_g32_character_identity_int_aux

example :
    ∀ c : Fin 48, (c.val < 44 → g32IntCharSum g32VectorTable c = if c.val = 2 then 1 else 0) ∧
      (44 ≤ c.val → Even (g32IntCharSum g32VectorTable c)) :=
  papers_g32_character_identity_int

