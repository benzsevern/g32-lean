/-! ## Item 1: G32 Proposition 4.5, the character identity (Appendix B, Table 2) -/

/-- The character group `X*(T) = ℤ⁴⁴ ⊕ (ℤ/2)⁴` of G32 Subsection 4.2, as coordinate vectors. The
printed coordinates `1, …, 44` are the free coordinates `0, …, 43` of the first factor, and the
printed coordinates `45, …, 48` are the coordinates `0, …, 3` of the second.
Source: G32 v0.16, Subsection 4.2 and Appendix B ("The vectors"). -/
abbrev G32CharLattice := (Fin 44 → ℤ) × (Fin 4 → ZMod 2)

example : (0 : G32CharLattice).1 0 = 0 := rfl

/-- One row of G32 Table 2: the index `i`, the coefficient `n_i`, and the nonzero coordinates of
`a(χ_i)` as printed pairs `(coordinate, value)`, coordinates numbered `1, …, 48`.
Source: G32 v0.16, Appendix B, Table 2 (column order as printed). -/
structure G32VectorRow where
  i : ℕ
  n : ℤ
  coords : List (ℕ × ℤ)
  deriving DecidableEq, Repr

