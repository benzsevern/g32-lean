/-- The vector of `X*(T)` with the printed sparse coordinates: coordinate `c ≤ 44` goes to the free
coordinate `c − 1`, coordinate `45 ≤ c ≤ 48` to the coordinate `c − 45` of order two (reduced
modulo 2). Repeated coordinates would be added; Table 2 has none (`papers_g32_vectors_wellFormed`).
Source: G32 v0.16, Appendix B ("The vectors": numbering of the coordinates of `X*(T)`). -/
def g32SparseVec (cs : List (ℕ × ℤ)) : G32CharLattice :=
  (fun j => ((cs.filter fun p => p.1 = j.val + 1).map Prod.snd).sum,
   fun j => ((((cs.filter fun p => p.1 = j.val + 45).map Prod.snd).sum : ℤ) : ZMod 2))

example : (g32SparseVec [(3, 1)]).1 2 = 1 := by decide

/-- The printed integer coordinates `1, …, 48` of a sparse vector, before reduction modulo 2 (index
`c` of `Fin 48` is the printed coordinate `c + 1`).
Source: G32 v0.16, Appendix B ("The vectors"). -/
def g32SparseIntVec (cs : List (ℕ × ℤ)) : Fin 48 → ℤ :=
  fun c => ((cs.filter fun p => p.1 = c.val + 1).map Prod.snd).sum

example : g32SparseIntVec [(45, 3)] 44 = 3 := by decide

/-- The coordinates (numbered `1, …, 48` as printed) at which a vector of `X*(T)` is nonzero.
Source: G32 v0.16, Appendix B ("The vectors": numbering of the coordinates). -/
def g32LatticeSupport (v : G32CharLattice) : Finset ℕ :=
  (Finset.univ.filter fun j : Fin 44 => v.1 j ≠ 0).image (fun j => j.val + 1) ∪
    (Finset.univ.filter fun j : Fin 4 => v.2 j ≠ 0).image (fun j => j.val + 45)

example : g32LatticeSupport 0 = ∅ := by decide

/-- The weighted sum `Σ_i n_i a(χ_i)` in `X*(T)` over a list of rows.
Source: G32 v0.16, Proposition 4.5. -/
def g32CharSum (rows : List G32VectorRow) : G32CharLattice :=
  (rows.map fun r => r.n • g32SparseVec r.coords).sum

example : g32CharSum [] = 0 := rfl

/-- The weighted sum `Σ_i n_i a(χ_i)` of the printed integer coordinates, before reduction modulo 2.
Source: G32 v0.16, Appendix B ("Summing `n_i a(χ_i)` gives …"). -/
def g32IntCharSum (rows : List G32VectorRow) : Fin 48 → ℤ :=
  (rows.map fun r => r.n • g32SparseIntVec r.coords).sum

example : g32IntCharSum [] = 0 := rfl

/-- `e_ρ`, the third coordinate vector of `X*(T)` (the pair of `ρ` is printed coordinate `3`, index
`2` of the free part).
Source: G32 v0.16, Subsection 4.2 and Appendix B ("the pair of `ρ` is coordinate 3, so `e_ρ` is
the third coordinate vector"). -/
def g32ERho : G32CharLattice := (Pi.single (2 : Fin 44) 1, 0)

example : g32ERho.1 2 = 1 := rfl

/-- The rows with the coefficient of row `k` changed from `n_k` to `n_k + δ` (falsification checks).
Source: the brief's falsification requirement; G32 v0.16, Table 2. -/
def g32PerturbCoeff (k : ℕ) (δ : ℤ) (rows : List G32VectorRow) : List G32VectorRow :=
  rows.map fun r => if r.i = k then { r with n := r.n + δ } else r

example : g32PerturbCoeff 1 0 [] = [] := rfl

/-! ## Item 2: G32 Appendix A, the rigid tuple, and the monodromy tuples of Proposition 6.3 -/

/-- The printed matrix `r₁` of G32 Appendix A, with `ω` any element of a field `K` (in the paper, a
primitive cube root of unity in `K = ℚ(√−3)`), acting on column vectors. Entries as printed.
Source: G32 v0.16, Appendix A ("The group, the rigid system and the base cover"). -/
def g32R1 {K : Type*} [Field K] (ω : K) : Matrix (Fin 4) (Fin 4) K :=
  !![(ω + 2) / 3, (2 * ω + 1) / 3, 0, -((2 * ω + 1) / 3);
     -((ω + 2) / 3), (ω + 2) / 3, 0, (1 - ω) / 3;
     0, 0, 1, 0;
     (ω + 2) / 3, (1 - ω) / 3, 0, (ω + 2) / 3]

example {K : Type*} [Field K] (ω : K) : g32R1 ω 2 2 = 1 := rfl

/-- The printed matrix `r₂` of G32 Appendix A. Entries as printed.
Source: G32 v0.16, Appendix A. -/
def g32R2 {K : Type*} [Field K] (ω : K) : Matrix (Fin 4) (Fin 4) K :=
  !![(1 - ω) / 3, (2 * ω + 1) / 3, (2 * ω + 1) / 3, 0;
     (1 - ω) / 3, (1 - ω) / 3, -((ω + 2) / 3), 0;
     (1 - ω) / 3, -((ω + 2) / 3), (1 - ω) / 3, 0;
     0, 0, 0, 1]

example {K : Type*} [Field K] (ω : K) : g32R2 ω 3 3 = 1 := rfl

/-- The printed matrix `x` of G32 Appendix A. Entries as printed.
Source: G32 v0.16, Appendix A. -/
def g32X {K : Type*} [Field K] (ω : K) : Matrix (Fin 4) (Fin 4) K :=
  !![-1, 0, 0, 0;
     0, -((ω + 2) / 3), -((2 * ω + 1) / 3), (1 - ω) / 3;
     0, (ω + 2) / 3, -((ω + 2) / 3), (ω + 2) / 3;
     0, -((ω + 2) / 3), (ω - 1) / 3, (2 * ω + 1) / 3]

example {K : Type*} [Field K] (ω : K) : g32X ω 0 0 = -1 := rfl

/-- The printed matrix `y` of G32 Appendix A. Entries as printed.
Source: G32 v0.16, Appendix A. -/
def g32Y {K : Type*} [Field K] (ω : K) : Matrix (Fin 4) (Fin 4) K :=
  !![(ω - 1) / 3, 0, -((ω + 2) / 3), -((ω + 2) / 3);
     0, (ω - 1) / 3, (1 - ω) / 3, (ω - 1) / 3;
     (1 - ω) / 3, -((ω + 2) / 3), -((ω + 2) / 3), 0;
     (1 - ω) / 3, (ω + 2) / 3, 0, -((ω + 2) / 3)]

example {K : Type*} [Field K] (ω : K) : g32Y ω 0 1 = 0 := rfl

/-- The residue `B₀ = diag(−3/4, −1/2, −1/2, 3/4)` of the rigid system.
Source: G32 v0.16, Appendix A (residues of the rigid system of Subsection 5.2). -/
def g32B0 : Matrix (Fin 4) (Fin 4) ℚ := Matrix.diagonal ![-3/4, -1/2, -1/2, 3/4]

example : g32B0 0 0 = -3/4 := by simp [g32B0]

/-- The printed vector `u₁ = (1, 1, 0, 1)`.
Source: G32 v0.16, Appendix A. -/
def g32U1 : Fin 4 → ℚ := ![1, 1, 0, 1]

example : g32U1 2 = 0 := rfl

/-- The printed vector `v₁ = (119/648, 28/135, −41472/289, −187/3240)`.
Source: G32 v0.16, Appendix A. -/
def g32V1 : Fin 4 → ℚ := ![119/648, 28/135, -41472/289, -187/3240]

example : g32V1 1 = 28/135 := rfl

/-- The printed vector `u₂ = (−5598720/14161, 0, 1, 5598720/22253)`.
Source: G32 v0.16, Appendix A. -/
def g32U2 : Fin 4 → ℚ := ![-5598720/14161, 0, 1, 5598720/22253]

example : g32U2 2 = 1 := rfl

/-- The printed vector
`v₂ = (−2648107/3627970560, −1090397/755827200, 56/135, −2648107/18139852800)`.
Source: G32 v0.16, Appendix A. -/
def g32V2 : Fin 4 → ℚ :=
  ![-2648107/3627970560, -1090397/755827200, 56/135, -2648107/18139852800]

example : g32V2 2 = 56/135 := rfl

/-- The residue `B₅ = u₁ v₁ᵀ`.
Source: G32 v0.16, Appendix A. -/
def g32B5 : Matrix (Fin 4) (Fin 4) ℚ := Matrix.vecMulVec g32U1 g32V1

example : g32B5 2 0 = 0 := by simp [g32B5, g32U1, Matrix.vecMulVec_apply]

/-- The residue `B₋₇ = u₂ v₂ᵀ`.
Source: G32 v0.16, Appendix A. -/
def g32B7 : Matrix (Fin 4) (Fin 4) ℚ := Matrix.vecMulVec g32U2 g32V2

example : g32B7 1 0 = 0 := by simp [g32B7, g32U2, Matrix.vecMulVec_apply]

/-- The residue at infinity `B_∞ = −(B₀ + B₅ + B₋₇)`.
Source: G32 v0.16, Appendix A. -/
def g32BInf : Matrix (Fin 4) (Fin 4) ℚ := -(g32B0 + g32B5 + g32B7)

example : g32BInf = -(g32B0 + g32B5 + g32B7) := rfl

/-- The permutation of `{1, …, 6}` given by one printed cycle, as a permutation of `Fin 6` (printed
point `k` is `k − 1`; every printed point is in `1, …, 6`).
Source: cycle notation; G32 v0.16, proof of Proposition 6.3. -/
def g32Cycle (l : List ℕ) : Equiv.Perm (Fin 6) :=
  (l.map fun k => (⟨(k - 1) % 6, Nat.mod_lt _ (by decide)⟩ : Fin 6)).formPerm

example : g32Cycle [1, 6] 0 = 5 := by decide

/-- The permutation given by a printed product of disjoint cycles.
Source: cycle notation; G32 v0.16, proof of Proposition 6.3. -/
def g32PermOfCycles (cs : List (List ℕ)) : Equiv.Perm (Fin 6) := (cs.map g32Cycle).prod

example : g32PermOfCycles [] = 1 := rfl

/-- The four printed representatives `(π₀, π₁, π₂, π_∞)` of the transitive product-one tuples of
cycle types `[2, 4], [2, 1⁴], [2, 1⁴], [3, 3]` in `S₆`, as printed cycles: `g32MonodromyCycles k j`
is the `j`-th permutation of the `k`-th printed tuple.
Source: G32 v0.16, proof of Proposition 6.3 (the displayed array of four tuples). -/
def g32MonodromyCycles : Fin 4 → Fin 4 → List (List ℕ) :=
  ![![[[1, 5, 2, 4], [3, 6]], [[1, 6]], [[2, 3]], [[1, 4, 3], [2, 5, 6]]],
    ![[[1, 5, 2, 4], [3, 6]], [[1, 6]], [[1, 5]], [[1, 4, 2], [3, 5, 6]]],
    ![[[1, 5, 2, 4], [3, 6]], [[1, 6]], [[4, 6]], [[1, 6, 3], [2, 5, 4]]],
    ![[[1, 5, 2, 4], [3, 6]], [[1, 4]], [[1, 6]], [[1, 6, 3], [2, 5, 4]]]]

example : g32MonodromyCycles 3 1 = [[1, 4]] := rfl

/-- The permutation `π_j` of the `k`-th printed tuple (`j = 0, 1, 2, 3` for `π₀, π₁, π₂, π_∞`).
Source: G32 v0.16, proof of Proposition 6.3. -/
def g32Pi (k j : Fin 4) : Equiv.Perm (Fin 6) := g32PermOfCycles (g32MonodromyCycles k j)

example : g32Pi 0 1 0 = 5 := by decide

/-- The permutation matrix of `σ` acting on column vectors, `e_j ↦ e_{σ j}`. (This is the
convention under which a product-one tuple of permutations gives a product-one tuple of matrices;
Mathlib's `Equiv.Perm.permMatrix` is its transpose.)
Source: G32 v0.16, proof of Proposition 6.3 ("the monodromy of `φ_* K`"; matrices act on column
vectors, Appendix A). -/
def g32PermMatrix {K : Type*} [Field K] (σ : Equiv.Perm (Fin 6)) : Matrix (Fin 6) (Fin 6) K :=
  fun i j => if σ j = i then 1 else 0

example {K : Type*} [Field K] : g32PermMatrix (K := K) 1 = 1 := by
  ext i j; simp [g32PermMatrix, Matrix.one_apply, eq_comm]

/-- The rank-24 tuple of G32 Proposition 6.3 for the `k`-th printed `S₆` tuple:
`(T₁, …, T₆) = (r₁ ⊗ 1, r₂ ⊗ 1, x ⊗ π₀, 1 ⊗ π₁, 1 ⊗ π₂, y ⊗ π_∞)`, as Kronecker products on
`K⁴ ⊗ K⁶ = K^{Fin 4 × Fin 6}` (index `t` of `Fin 6` is `T_{t+1}`).
Source: G32 v0.16, proof of Proposition 6.3. -/
def g32CocycleTuple {K : Type*} [Field K] (ω : K) (k : Fin 4) :
    Fin 6 → Matrix (Fin 4 × Fin 6) (Fin 4 × Fin 6) K :=
  ![g32R1 ω ⊗ₖ 1, g32R2 ω ⊗ₖ 1, g32X ω ⊗ₖ g32PermMatrix (g32Pi k 0),
    1 ⊗ₖ g32PermMatrix (g32Pi k 1), 1 ⊗ₖ g32PermMatrix (g32Pi k 2),
    g32Y ω ⊗ₖ g32PermMatrix (g32Pi k 3)]

example {K : Type*} [Field K] (ω : K) (k : Fin 4) :
    g32CocycleTuple ω k 0 = g32R1 ω ⊗ₖ 1 := rfl

/-- A parameter tuple `(a₁, …, a₆) ∈ (K²⁴)⁶` of Lemma 6.2 for the rank-24 tuple, over `ℂ`.
Source: G32 v0.16, Lemma 6.2 (`lem:cocycle`) and proof of Proposition 6.3. -/
abbrev G32CocycleParam := Fin 6 → (Fin 4 × Fin 6 → ℂ)

example : (0 : G32CocycleParam) 0 (0, 0) = 0 := rfl

/-- `Q_i = T₁ ⋯ T_{i−1}` (index `i` of `Fin 6` is the `(i+1)`-st puncture, so `Q` at `0` is `1`).
Source: G32 v0.16, before Lemma 6.2 ("Put `Q_i = T₁ ⋯ T_{i−1}`"). -/
noncomputable def g32CocycleQ (ω : ℂ) (k : Fin 4) (i : Fin 6) : Matrix (Fin 4 × Fin 6) (Fin 4 × Fin 6) ℂ :=
  (((List.finRange 6).filter fun j => j < i).map (g32CocycleTuple ω k)).prod

example (ω : ℂ) (k : Fin 4) : g32CocycleQ ω k 0 = 1 := by
  simp [g32CocycleQ]

/-- `c_i = (1 − T_i) a_i`, the value of the cocycle on the loop `ℓ_i`.
Source: G32 v0.16, before Lemma 6.2. -/
noncomputable def g32CocycleC (ω : ℂ) (k : Fin 4) (a : G32CocycleParam) (i : Fin 6) : Fin 4 × Fin 6 → ℂ :=
  (1 - g32CocycleTuple ω k i) *ᵥ a i

example (ω : ℂ) (k : Fin 4) (i : Fin 6) : g32CocycleC ω k 0 i = 0 := by
  simp [g32CocycleC]

/-- `F_i = Σ_{j<i} Q_j c_j`.
Source: G32 v0.16, before Lemma 6.2. -/
noncomputable def g32CocycleF (ω : ℂ) (k : Fin 4) (a : G32CocycleParam) (i : Fin 6) : Fin 4 × Fin 6 → ℂ :=
  ∑ j ∈ Finset.univ.filter (· < i), g32CocycleQ ω k j *ᵥ g32CocycleC ω k a j

example (ω : ℂ) (k : Fin 4) (a : G32CocycleParam) : g32CocycleF ω k a 0 = 0 := by
  simp [g32CocycleF]

/-- The parameter space `Z`: the tuples with `Σ_i Q_i (1 − T_i) a_i = 0`.
Source: G32 v0.16, before Lemma 6.2 and proof of Proposition 6.3. -/
def G32InCocycleSpace (ω : ℂ) (k : Fin 4) (a : G32CocycleParam) : Prop :=
  ∑ i, g32CocycleQ ω k i *ᵥ g32CocycleC ω k a i = 0

example (ω : ℂ) (k : Fin 4) : G32InCocycleSpace ω k 0 := by
  simp [G32InCocycleSpace, g32CocycleC]

/-- The cup product of Lemma 6.2,
`S(a, b) = Σ_i h_W(Q_i⁻¹ F^a_i + a_i, c^b_i)`, with `h_W` the standard Hermitian form of
`ℂ⁴ ⊗ ℂ⁶ = ℂ^{Fin 4 × Fin 6}` (the tensor product of the standard forms), conjugate-linear in the
first variable.
Source: G32 v0.16, Lemma 6.2 (`lem:cocycle`) and proof of Proposition 6.3. -/
noncomputable def g32CocycleS (ω : ℂ) (k : Fin 4) (a b : G32CocycleParam) : ℂ :=
  ∑ i, star ((g32CocycleQ ω k i)⁻¹ *ᵥ g32CocycleF ω k a i + a i) ⬝ᵥ g32CocycleC ω k b i

example (ω : ℂ) (k : Fin 4) (a : G32CocycleParam) : g32CocycleS ω k a 0 = 0 := by
  simp [g32CocycleS, g32CocycleC]

end HodgeLean.Papers
