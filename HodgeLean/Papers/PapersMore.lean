open Polynomial Matrix

/-! Item 6: G32 Appendix A, the algebra generated by `r₁, r₂, x` -/

/-- **Sixteen products of `r₁, r₂, x` are linearly independent.** The products along the sixteen
words `g32SpanWords` (`1, a, b, c, ab, ac, ba, bc, ca, cb, cc, abc, bac, cac, cba, cbc`, with
`a, b, c = r₁, r₂, x`) are linearly independent over any field of characteristic zero containing a
root `ω` of `ω² + ω + 1`: the sixteen products have rank `16`.
Source: G32 v0.16, Appendix A ("the `K`-algebra generated by `r₁, r₂, x` is `M₄(K)`"). -/
theorem papers_g32_words_linearIndependent {K : Type*} [Field K] [CharZero K] (ω : K) (hω : ω ^ 2 + ω + 1 = 0) :
    LinearIndependent K (fun i => g32WordMat ω (g32SpanWords i)) :=
  papers_g32_words_linearIndependent_aux ω hω

example {K : Type*} [Field K] [CharZero K] (ω : K) (hω : ω ^ 2 + ω + 1 = 0) :
    LinearIndependent K (fun i => g32WordMat ω (g32SpanWords i)) :=
  papers_g32_words_linearIndependent ω hω

/-- **The sixteen products span `M₄(K)`.**
Source: G32 v0.16, Appendix A ("the `K`-algebra generated by `r₁, r₂, x` is `M₄(K)`"). -/
theorem papers_g32_words_span {K : Type*} [Field K] [CharZero K] (ω : K) (hω : ω ^ 2 + ω + 1 = 0) :
    Submodule.span K (Set.range fun i => g32WordMat ω (g32SpanWords i)) = ⊤ :=
  papers_g32_words_span_aux ω hω

example {K : Type*} [Field K] [CharZero K] (ω : K) (hω : ω ^ 2 + ω + 1 = 0) :
    Submodule.span K (Set.range fun i => g32WordMat ω (g32SpanWords i)) = ⊤ :=
  papers_g32_words_span ω hω

/-- **The algebra generated by `r₁, r₂, x` is `M₄(K)`.** The `K`-subalgebra of `M₄(K)` generated
by the printed `r₁, r₂, x` is everything, over any field of characteristic zero and for any `ω` with
`ω² + ω + 1 = 0`.
Source: G32 v0.16, Appendix A ("the `K`-algebra generated by `r₁, r₂, x` is `M₄(K)`") and Subsection 5.2
("the `K`-algebra generated by its matrices is `M₄(K)`"). -/
theorem papers_g32_adjoin_top {K : Type*} [Field K] [CharZero K] (ω : K) (hω : ω ^ 2 + ω + 1 = 0) :
    Algebra.adjoin K {g32R1 ω, g32R2 ω, g32X ω} = ⊤ :=
  papers_g32_adjoin_top_aux ω hω

example {K : Type*} [Field K] [CharZero K] (ω : K) (hω : ω ^ 2 + ω + 1 = 0) :
    Algebra.adjoin K {g32R1 ω, g32R2 ω, g32X ω} = ⊤ :=
  papers_g32_adjoin_top ω hω

/-- **Falsification check for the word list.** Replacing the last word `cbc` by `aa` (the product
`r₁²`) makes the family linearly dependent: `1, r₁, r₁²` are dependent since
`(r₁ − 1)(r₁ − ω) = 0`.
Source: G32 v0.16, Appendix A (`r₁` has eigenvalues `(ω,1,1,1)`); the word list is this spec's. -/
theorem papers_g32_words_perturbed {K : Type*} [Field K] [CharZero K] (ω : K) (hω : ω ^ 2 + ω + 1 = 0) :
    ¬ LinearIndependent K (Function.update (fun i => g32WordMat ω (g32SpanWords i)) 15 (g32R1 ω * g32R1 ω)) :=
  papers_g32_words_perturbed_aux ω hω

example {K : Type*} [Field K] [CharZero K] (ω : K) (hω : ω ^ 2 + ω + 1 = 0) :
    ¬ LinearIndependent K (Function.update (fun i => g32WordMat ω (g32SpanWords i)) 15 (g32R1 ω * g32R1 ω)) :=
  papers_g32_words_perturbed ω hω

/-- **Falsification check: `x` is needed.** The algebra generated by `r₁` and `r₂` alone is not
`M₄(K)` (it has dimension `5`: it preserves the plane spanned by the images of `r₁ − 1` and
`r₂ − 1`).
Source: G32 v0.16, Appendix A (the printed `r₁, r₂`). -/
theorem papers_g32_adjoin_r1_r2_ne_top {K : Type*} [Field K] [CharZero K] (ω : K) (hω : ω ^ 2 + ω + 1 = 0) :
    Algebra.adjoin K {g32R1 ω, g32R2 ω} ≠ ⊤ :=
  papers_g32_adjoin_r1_r2_ne_top_aux ω hω

example {K : Type*} [Field K] [CharZero K] (ω : K) (hω : ω ^ 2 + ω + 1 = 0) :
    Algebra.adjoin K {g32R1 ω, g32R2 ω} ≠ ⊤ :=
  papers_g32_adjoin_r1_r2_ne_top ω hω

/-! Item 6: G32 Subsection 5.2 and Appendix A, the base cover `φ` -/

/-- **The derivative of `φ`, polynomial form.** With `N = s²(s − 3)⁴` and `D = (s − 1)³(s + 2)³`,
`N′D − ND′ = 3s(s − 3)³(5s² − 3s + 4)(s − 1)²(s + 2)²` in `ℚ[s]`; dividing by `D²` gives the
printed `φ′`.
Source: G32 v0.16, Appendix A ("The derivative of `φ` is `φ′(s) = 3s(s−3)³(5s²−3s+4)/((s−1)⁴(s+2)⁴)`"). -/
theorem papers_g32_phi_deriv_poly :
    derivative g32PhiNum * g32PhiDen - g32PhiNum * derivative g32PhiDen = 3 * X * (X - 3) ^ 3 * g32CritQuad * (X - 1) ^ 2 * (X + 2) ^ 2 :=
  papers_g32_phi_deriv_poly_aux

example :
    derivative g32PhiNum * g32PhiDen - g32PhiNum * derivative g32PhiDen = 3 * X * (X - 3) ^ 3 * g32CritQuad * (X - 1) ^ 2 * (X + 2) ^ 2 :=
  papers_g32_phi_deriv_poly

/-- **The derivative of `φ`.** At every complex `s ≠ 1, −2`, the printed `φ` has derivative
`3s(s − 3)³(5s² − 3s + 4)/((s − 1)⁴(s + 2)⁴)`.
Source: G32 v0.16, Appendix A ("The derivative of `φ` is …"). -/
theorem papers_g32_phi_hasDerivAt (s : ℂ) (h₁ : s ≠ 1) (h₂ : s ≠ -2) :
    HasDerivAt g32Phi (g32PhiDeriv s) s :=
  papers_g32_phi_hasDerivAt_aux s h₁ h₂

example (s : ℂ) (h₁ : s ≠ 1) (h₂ : s ≠ -2) :
    HasDerivAt g32Phi (g32PhiDeriv s) s :=
  papers_g32_phi_hasDerivAt s h₁ h₂

/-- **The finite critical points.** For complex `s ≠ 1, −2`, the printed `φ′(s)` vanishes exactly
at `s = 0`, `s = 3` and the roots of `5s² − 3s + 4`.
Source: G32 v0.16, Appendix A ("so the critical points are `0`, `3`, `1`, `−2` and the roots of
`5s² − 3s + 4`"). -/
theorem papers_g32_phi_critical_points (s : ℂ) (h₁ : s ≠ 1) (h₂ : s ≠ -2) :
    g32PhiDeriv s = 0 ↔ s = 0 ∨ s = 3 ∨ 5 * s ^ 2 - 3 * s + 4 = 0 :=
  papers_g32_phi_critical_points_aux s h₁ h₂

example (s : ℂ) (h₁ : s ≠ 1) (h₂ : s ≠ -2) :
    g32PhiDeriv s = 0 ↔ s = 0 ∨ s = 3 ∨ 5 * s ^ 2 - 3 * s + 4 = 0 :=
  papers_g32_phi_critical_points s h₁ h₂

/-- **Falsification check for `φ′`.** The identity fails with `5s² + 3s + 4` in place of the
printed `5s² − 3s + 4`.
Source: G32 v0.16, Appendix A. -/
theorem papers_g32_phi_deriv_poly_perturbed :
    derivative g32PhiNum * g32PhiDen - g32PhiNum * derivative g32PhiDen ≠ 3 * X * (X - 3) ^ 3 * (5 * X ^ 2 + 3 * X + 4) * (X - 1) ^ 2 * (X + 2) ^ 2 :=
  papers_g32_phi_deriv_poly_perturbed_aux

example :
    derivative g32PhiNum * g32PhiDen - g32PhiNum * derivative g32PhiDen ≠ 3 * X * (X - 3) ^ 3 * (5 * X ^ 2 + 3 * X + 4) * (X - 1) ^ 2 * (X + 2) ^ 2 :=
  papers_g32_phi_deriv_poly_perturbed

/-- **The critical values, polynomial form.** `5s² − 3s + 4` divides
`729N² − 3674ND + 5120D²` in `ℚ[s]`: at a root `s` of `5s² − 3s + 4` (where `D ≠ 0`), `z = φ(s)`
satisfies `729z² − 3674z + 5120 = 0`.
Source: G32 v0.16, Subsection 5.2 and Appendix A ("whose critical values are the roots of
`729z² − 3674z + 5120`"). -/
theorem papers_g32_crit_value_dvd :
    g32CritQuad ∣ g32CritValuePoly 729 3674 5120 :=
  papers_g32_crit_value_dvd_aux

example :
    g32CritQuad ∣ g32CritValuePoly 729 3674 5120 :=
  papers_g32_crit_value_dvd

/-- **The critical values.** The image under `φ` of the two roots of `5s² − 3s + 4` in `ℂ` is
exactly the set of roots of `729z² − 3674z + 5120`.
Source: G32 v0.16, Subsection 5.2 ("its two other critical values are the roots of
`729z² − 3674z + 5120`") and Appendix A. -/
theorem papers_g32_crit_values :
    g32Phi '' {s : ℂ | 5 * s ^ 2 - 3 * s + 4 = 0} = {z : ℂ | 729 * z ^ 2 - 3674 * z + 5120 = 0} :=
  papers_g32_crit_values_aux

example :
    g32Phi '' {s : ℂ | 5 * s ^ 2 - 3 * s + 4 = 0} = {z : ℂ | 729 * z ^ 2 - 3674 * z + 5120 = 0} :=
  papers_g32_crit_values

/-- **The critical values are not real.** Every complex root of `729z² − 3674z + 5120` has nonzero
imaginary part (the discriminant `3674² − 4·729·5120 = −1431644` is negative).
Source: G32 v0.16, Subsection 5.2 ("which are not real"). -/
theorem papers_g32_crit_values_not_real :
    ∀ z : ℂ, 729 * z ^ 2 - 3674 * z + 5120 = 0 → z.im ≠ 0 :=
  papers_g32_crit_values_not_real_aux

example :
    ∀ z : ℂ, 729 * z ^ 2 - 3674 * z + 5120 = 0 → z.im ≠ 0 :=
  papers_g32_crit_values_not_real

/-- **Falsification check for the critical values.** `5s² − 3s + 4` does not divide
`729N² − 3675ND + 5120D²`: changing the printed `3674` to `3675` breaks the statement.
Source: G32 v0.16, Appendix A. -/
theorem papers_g32_crit_value_dvd_perturbed :
    ¬ g32CritQuad ∣ g32CritValuePoly 729 3675 5120 :=
  papers_g32_crit_value_dvd_perturbed_aux

example :
    ¬ g32CritQuad ∣ g32CritValuePoly 729 3675 5120 :=
  papers_g32_crit_value_dvd_perturbed

/-! Item 15: G34 Theorem 5.1, the combinatorial core -/

/-- **The unpaired exponents equal `m/2`.** An exponent `a` in `1, …, m − 1` with `−a = a` in `ℤ/m`
(that is, `m ∣ 2a`) satisfies `2a = m`.
Source: G34 v1.5, proof of Theorem 5.1 ("the unpaired ones equal `m/2`"). -/
theorem papers_g34_exps_selfneg (m : ℕ) (α : List ℕ) (hrange : ∀ a ∈ α, 0 < a ∧ a < m) (a : ℕ) (ha : a ∈ α) (h2 : 2 * a % m = 0) :
    2 * a = m :=
  papers_g34_exps_selfneg_aux m α hrange a ha h2

example (m : ℕ) (α : List ℕ) (hrange : ∀ a ∈ α, 0 < a ∧ a < m) (a : ℕ) (ha : a ∈ α) (h2 : 2 * a % m = 0) :
    2 * a = m :=
  papers_g34_exps_selfneg m α hrange a ha h2

/-- **The number of unpaired exponents is even.** If the exponents lie in `1, …, m − 1`, form a
multiset stable under `α ↦ −α` and sum to `0` modulo `m`, then the number `k` of exponents equal
to `m/2` is even.
Source: G34 v1.5, proof of Theorem 5.1 ("Their number `k` is even, because the exponents sum to `0`
modulo `m` and the pairs contribute `0`"). -/
theorem papers_g34_exps_unpaired_even (m : ℕ) (α : List ℕ) (hrange : ∀ a ∈ α, 0 < a ∧ a < m) (hstable : ExpsNegStable m α) (hsum : α.sum % m = 0) :
    Even (α.countP fun a => 2 * a = m) :=
  papers_g34_exps_unpaired_even_aux m α hrange hstable hsum

example (m : ℕ) (α : List ℕ) (hrange : ∀ a ∈ α, 0 < a ∧ a < m) (hstable : ExpsNegStable m α) (hsum : α.sum % m = 0) :
    Even (α.countP fun a => 2 * a = m) :=
  papers_g34_exps_unpaired_even m α hrange hstable hsum

/-- **Stable exponents are simple.** If the exponents lie in `1, …, m − 1`, form a multiset stable
under `α ↦ −α` and sum to `0` modulo `m`, then `α` is simple in Schoen's sense (papers1's
`IsSimpleExps`).
Source: G34 v1.5, proof of Theorem 5.1 ("Hence `α` is simple"). -/
theorem papers_g34_exps_simple (m : ℕ) (α : List ℕ) (hrange : ∀ a ∈ α, 0 < a ∧ a < m) (hstable : ExpsNegStable m α) (hsum : α.sum % m = 0) :
    IsSimpleExps m α :=
  papers_g34_exps_simple_aux m α hrange hstable hsum

example (m : ℕ) (α : List ℕ) (hrange : ∀ a ∈ α, 0 < a ∧ a < m) (hstable : ExpsNegStable m α) (hsum : α.sum % m = 0) :
    IsSimpleExps m α :=
  papers_g34_exps_simple m α hrange hstable hsum

/-- **`s` is even.** Under the same hypotheses the number `s` of exponents is even.
Source: G34 v1.5, proof of Theorem 5.1 ("`s` is even"). -/
theorem papers_g34_exps_length_even (m : ℕ) (α : List ℕ) (hrange : ∀ a ∈ α, 0 < a ∧ a < m) (hstable : ExpsNegStable m α) (hsum : α.sum % m = 0) :
    Even α.length :=
  papers_g34_exps_length_even_aux m α hrange hstable hsum

example (m : ℕ) (α : List ℕ) (hrange : ∀ a ∈ α, 0 < a ∧ a < m) (hstable : ExpsNegStable m α) (hsum : α.sum % m = 0) :
    Even α.length :=
  papers_g34_exps_length_even m α hrange hstable hsum

/-- **Theorem 5.1's finite core: every supplier with `h > 0` is admissible.** If the exponents of a
supplier of order `m` lie in `1, …, m − 1`, form a multiset stable under `α ↦ −α` and sum to `0`
modulo `m`, and `h = 2q − 2 + s > 0`, then `h` is even and `α` is simple, so the supplier is
admissible. (The stability is what real branch classes give; deriving it from the group is not
claimed here.)
Source: G34 v1.5, Theorem 5.1, proof, paragraph "These suppliers are admissible"; admissibility as in
Section 4, after Definition 4.1. -/
theorem papers_g34_real_supplier_admissible (m q : ℕ) (α : List ℕ) (hrange : ∀ a ∈ α, 0 < a ∧ a < m) (hstable : ExpsNegStable m α) (hsum : α.sum % m = 0) (hh : 0 < (2 * q - 2 + α.length : ℤ)) :
    SupplierAdmissible m q α :=
  papers_g34_real_supplier_admissible_aux m q α hrange hstable hsum hh

example (m q : ℕ) (α : List ℕ) (hrange : ∀ a ∈ α, 0 < a ∧ a < m) (hstable : ExpsNegStable m α) (hsum : α.sum % m = 0) (hh : 0 < (2 * q - 2 + α.length : ℤ)) :
    SupplierAdmissible m q α :=
  papers_g34_real_supplier_admissible m q α hrange hstable hsum hh

/-- **Falsification check: the sum condition is needed.** For `m = 4`, the exponent list `[2]` lies
in range and is stable under negation, but its sum is not `0` modulo `4` and it is not simple.
Source: G34 v1.5, proof of Theorem 5.1 (the role of "the exponents sum to `0` modulo `m`"). -/
theorem papers_g34_exps_sum_needed :
    (∀ a ∈ [2], 0 < a ∧ a < 4) ∧ ExpsNegStable 4 [2] ∧ [2].sum % 4 ≠ 0 ∧ ¬ IsSimpleExps 4 [2] :=
  papers_g34_exps_sum_needed_aux

example :
    (∀ a ∈ [2], 0 < a ∧ a < 4) ∧ ExpsNegStable 4 [2] ∧ [2].sum % 4 ≠ 0 ∧ ¬ IsSimpleExps 4 [2] :=
  papers_g34_exps_sum_needed

/-- **Falsification check: stability is needed.** For `m = 3`, the list `[1, 1, 1]` lies in range
and sums to `0` modulo `3`, but it is not stable under negation and not simple.
Source: G34 v1.5, proof of Theorem 5.1 (the role of stability under `α ↦ −α`). -/
theorem papers_g34_exps_stable_needed :
    (∀ a ∈ [1, 1, 1], 0 < a ∧ a < 3) ∧ ¬ ExpsNegStable 3 [1, 1, 1] ∧ [1, 1, 1].sum % 3 = 0 ∧ ¬ IsSimpleExps 3 [1, 1, 1] :=
  papers_g34_exps_stable_needed_aux

example :
    (∀ a ∈ [1, 1, 1], 0 < a ∧ a < 3) ∧ ¬ ExpsNegStable 3 [1, 1, 1] ∧ [1, 1, 1].sum % 3 = 0 ∧ ¬ IsSimpleExps 3 [1, 1, 1] :=
  papers_g34_exps_stable_needed

