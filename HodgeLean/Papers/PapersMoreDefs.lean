import Mathlib
import HodgeLean.Papers.PapersG32CertificatesDefs

/-! # Definitions for the compact paper results, batch 4 (FROZEN)

Part of the frozen spec for `docs/briefs/cloud-spec-papers4.md` (`docs/specs/PapersMore.md`).
Do not edit this file. It holds printed data from G32 v0.16 Appendix A (read-only copy
`docs/specs/inputs/papers/weil-nonsplit-g32-v0.16.tex`) and the combinatorial notions of G34 v1.5
Section 4 (read-only copy `docs/specs/inputs/papers/weil-qsqrt3-v1.5.tex`). Nothing here mentions
curves, characters of a group or abelian varieties: the matrices are those of papers3
(`g32R1`, `g32R2`, `g32X`), the rational function is the printed `φ`, and the exponent data of a
supplier is a bare list of natural numbers.
Relation to the goal: HC no distance; AV milestone no distance.
-/

namespace HodgeLean.Papers

open Polynomial Matrix

/-! ## Item 6: G32 Appendix A, the algebra generated by `r₁, r₂, x` -/

/-- The generator of index `k` of the triple `(r₁, r₂, x)` (`0 ↦ r₁`, `1 ↦ r₂`, `2 ↦ x`).
Source: G32 v0.16, Appendix A ("the `K`-algebra generated by `r₁, r₂, x` is `M₄(K)`"). -/
def g32Gen {K : Type*} [Field K] (ω : K) : Fin 3 → Matrix (Fin 4) (Fin 4) K :=
  ![g32R1 ω, g32R2 ω, g32X ω]

example {K : Type*} [Field K] (ω : K) : g32Gen ω 2 = g32X ω := rfl

/-- The product of the generators along a word, left to right: `[k₁, …, kₙ] ↦ g_{k₁} ⋯ g_{kₙ}`, and
the empty word gives `1`.
Source: G32 v0.16, Appendix A (products of `r₁, r₂, x`). -/
def g32WordMat {K : Type*} [Field K] (ω : K) (w : List (Fin 3)) : Matrix (Fin 4) (Fin 4) K :=
  (w.map (g32Gen ω)).prod

example {K : Type*} [Field K] (ω : K) : g32WordMat ω [0, 1] = g32R1 ω * g32R2 ω := by
  simp [g32WordMat, g32Gen]

/-- Sixteen words in `r₁, r₂, x` of length at most three (writing `a, b, c` for `r₁, r₂, x`:
`1, a, b, c, ab, ac, ba, bc, ca, cb, cc, abc, bac, cac, cba, cbc`). They were found by a greedy
search over words by length; their products are a basis of `M₄(K)` (the `16 × 16` coordinate matrix
has determinant `1` modulo `ω² + ω + 1`, computed in sympy). The paper prints no list of words; it
states the conclusion, checked by its certificate scripts.
Source: G32 v0.16, Appendix A ("the `K`-algebra generated by `r₁, r₂, x` is `M₄(K)`") and
Appendix D (certificate scripts); the list itself is this spec's. -/
def g32SpanWords : Fin 16 → List (Fin 3) :=
  ![[], [0], [1], [2], [0, 1], [0, 2], [1, 0], [1, 2], [2, 0], [2, 1], [2, 2],
    [0, 1, 2], [1, 0, 2], [2, 0, 2], [2, 1, 0], [2, 1, 2]]

example : g32SpanWords 4 = [0, 1] := rfl

/-! ## Item 6: G32 Subsection 5.2 and Appendix A, the base cover `φ` -/

/-- The printed rational function `φ(s) = s²(s − 3)⁴ / ((s − 1)³(s + 2)³)` (with Lean's convention
`a / 0 = 0` at the poles `s = 1, −2`).
Source: G32 v0.16, Subsection 5.2 ("The pullback": the displayed `φ`). -/
def g32Phi {K : Type*} [Field K] (s : K) : K :=
  s ^ 2 * (s - 3) ^ 4 / ((s - 1) ^ 3 * (s + 2) ^ 3)

example : g32Phi (0 : ℚ) = 0 := by norm_num [g32Phi]

/-- The printed derivative `3s(s − 3)³(5s² − 3s + 4) / ((s − 1)⁴(s + 2)⁴)`.
Source: G32 v0.16, Appendix A ("The derivative of `φ` is …"). -/
def g32PhiDeriv {K : Type*} [Field K] (s : K) : K :=
  3 * s * (s - 3) ^ 3 * (5 * s ^ 2 - 3 * s + 4) / ((s - 1) ^ 4 * (s + 2) ^ 4)

example : g32PhiDeriv (3 : ℚ) = 0 := by norm_num [g32PhiDeriv]

/-- The numerator `s²(s − 3)⁴` of `φ`, as a polynomial over `ℚ`.
Source: G32 v0.16, Subsection 5.2 (the displayed `φ`). -/
noncomputable def g32PhiNum : ℚ[X] := X ^ 2 * (X - 3) ^ 4

example : g32PhiNum.eval 3 = 0 := by simp [g32PhiNum]

/-- The denominator `(s − 1)³(s + 2)³` of `φ`, as a polynomial over `ℚ`.
Source: G32 v0.16, Subsection 5.2 (the displayed `φ`). -/
noncomputable def g32PhiDen : ℚ[X] := (X - 1) ^ 3 * (X + 2) ^ 3

example : g32PhiDen.eval 1 = 0 := by simp [g32PhiDen]

/-- The quadratic `5s² − 3s + 4` whose roots are the critical points of `φ` other than `0, 3, 1, −2`.
Source: G32 v0.16, Appendix A ("the roots of `5s² − 3s + 4`"). -/
noncomputable def g32CritQuad : ℚ[X] := 5 * X ^ 2 - 3 * X + 4

example : g32CritQuad.eval 0 = 4 := by simp [g32CritQuad]

/-- The polynomial `a N² − b N D + c D²` in `s`, with `N, D` the numerator and denominator of `φ`.
At a point where `D ≠ 0` it is `D² (a z² − b z + c)` for `z = φ(s)`; the printed critical-value
quadratic is `729z² − 3674z + 5120`, i.e. `(a, b, c) = (729, 3674, 5120)`.
Source: G32 v0.16, Subsection 5.2 and Appendix A ("the roots of `729z² − 3674z + 5120`"). -/
noncomputable def g32CritValuePoly (a b c : ℚ) : ℚ[X] :=
  C a * g32PhiNum ^ 2 - C b * g32PhiNum * g32PhiDen + C c * g32PhiDen ^ 2

example : g32CritValuePoly 0 0 0 = 0 := by simp [g32CritValuePoly]

/-! ## Item 15: G34 Theorem 5.1, the combinatorial core -/

/-- The exponent list `α` of a supplier of order `m` (exponents in `1, …, m − 1`, the residues of
`ℤ/m − {0}`) is stable under `α ↦ −α`: negation modulo `m`, which is `a ↦ m − a` on this range,
permutes the list.
Source: G34 v1.5, proof of Theorem 5.1 ("the exponents … form a multiset stable under
`α ↦ −α`"). -/
def ExpsNegStable (m : ℕ) (α : List ℕ) : Prop :=
  (α.map fun a => m - a).Perm α

example : ExpsNegStable 3 [1, 2] := by unfold ExpsNegStable; decide

/-- Admissibility of a supplier from its numerical data: with `q` the genus of `C/H'`, `s` the
number of branch points of `C' → C/H'` (the length of `α`) and `h = 2q − 2 + s`, the supplier is
admissible if `h` is positive and even and `α` is simple (papers1's `IsSimpleExps`).
Source: G34 v1.5, Section 4, paragraph after Definition 4.1 ("A supplier is admissible if `h` is
even and positive and `α` is simple"). -/
def SupplierAdmissible (m q : ℕ) (α : List ℕ) : Prop :=
  0 < (2 * q - 2 + α.length : ℤ) ∧ Even (2 * q - 2 + α.length : ℤ) ∧ IsSimpleExps m α

example : SupplierAdmissible 3 2 [] :=
  ⟨by norm_num, ⟨1, by norm_num⟩, ⟨[], List.Perm.refl _, by simp⟩⟩

end HodgeLean.Papers
