import HodgeLean.Papers.PapersSupplyProofs

/-! # Compact results from the posted papers, batch 5 (FROZEN SPEC)

The frozen spec for `docs/briefs/cloud-spec-papers5.md`; see `docs/specs/PapersSupply.md`.
Do not edit this file. Each theorem is proved by the matching `_aux` theorem in
`PapersSupplyProofs.lean`. The manuscripts are the read-only copies
`docs/specs/inputs/papers/weil-nonsplit-g32-v0.16.tex` (G32 v0.16),
`docs/specs/inputs/papers/transfer-theorem-v0.16.tex` (TT v0.16) and
`docs/specs/inputs/papers/weil-qsqrt3-v1.5.tex` (G34 v1.5); every citation is a printed number.
Item 16, item 15 (core statement 2) and the group-theoretic half of item 15's admissibility step
(deferred by papers4) of `docs/specs/inputs/papers/lean-compact-list.md`.

It claims, for a finite group `G`, a field `k` of characteristic zero, finite-dimensional
representations `τ, τ̄, η` of `G` (Mathlib's `FDRep`) and linear characters `χ` of subgroups:

* G32 Lemma 4.4: a ring endomorphism `γ` with `γ(χ(h)) = χ(h)^t` satisfies
  `⟨τ^γ|_{H′}, χ^t⟩ = ⟨τ|_{H′}, χ⟩`; hence `a(χ^t) = a(χ)` when `γ` fixes the characters, and
  `a(χ^t) = −a(χ)` on the free and `a(χ)` on the `ℤ/2` coordinates when `γ` exchanges `τ` and `τ̄`
  and fixes the quaternionic `η`; `K`-valued character values behave this way according to `γ(ω)`;
  and the paper's printed intermediate identity `⟨τ|_{H′}, χ^t⟩ = ⟨τ^γ|_{H′}, χ⟩` fails for
  `t = 2`, `m = 5` (a discrepancy in the proof, not in the lemma);
* TT Lemma 3.5: `a_{−1}(χ) = −a(χ)` on the free and `a(χ)` on the `ℤ/2` coordinates;
* G34 Theorem 5.1, the representation-theoretic core, as an implication from its inputs:
  Frobenius reciprocity for class functions, `𝖺(Ind_{H′}^G χ) = a(χ)`, the passage from a Brauer
  decomposition (an explicit binder) to `𝖺(σ) = ∑ n_i a(λ_i)`, and `a(λ) = 0` for `λ` of order `1`
  or `2` (the quaternionic coordinate through an invariant alternating form);
* G34 Theorem 5.1, the group-theoretic half of the admissibility step: the exponent multiset of
  `(G, H′, χ, g)`, defined from the orbits of `⟨g⟩` on `G ⧸ H′` (as many as Mathlib's double cosets
  `H′ \ G / ⟨g⟩`), is negation-stable when `g` is conjugate to `g⁻¹`, sums to the transfer of `g`,
  hence to `0` over a product-one tuple; so real classes make every supplier's exponents simple
  and every supplier with `h > 0` admissible.

It does not claim: Brauer's induction theorem (only an explicit binder); that `a(σ) = e_σ`; that
the characters of `G₃₂` are `K`-valued or that the Galois automorphisms with the required action
exist for a given `m`; the identification of the multiplicities with `U`-characters of `det V_χ`,
the Chevalley–Weil formula, the genus `q` of `C/H′` (a free number here), condition (L), Schoen's
theorem, Milne's theorem or any algebraicity. HC no distance; AV milestone no distance.
-/

namespace HodgeLean.Papers

/-! Item 16: G32 Lemma 4.4, the Galois action on multiplicities -/

/-- **A ring endomorphism moves the pairing with `χ` to the pairing with `χ^t`.** If `γ(χ(h)) = χ(h)^t` for every `h` (for `χ` of order `m`: `γ(ζ_m) = ζ_m^t`), then `γ⟨f, χ⟩ = ⟨γ ∘ f, χ^t⟩` for every function `f`.
Source: G32 v0.16, Lemma 4.4 (`lem:sign`), proof ("Let `γ` be an automorphism of `ℚ(ζ_m, ω)` with `γ(ζ_m) = ζ_m^t`"). -/
theorem papers_g32_galois_inner {k : Type*} [Field k] {H : Type*} [Group H] [Fintype H] (γ : k →+* k) (χ : H →* kˣ) (t : ℕ) (hγ : ∀ h, γ (χ h : k) = (χ h : k) ^ t) (f : H → k) :
    γ (papersInner f (papersLinChar χ)) = papersInner (fun h => γ (f h)) (papersLinChar (χ ^ t)) :=
  papers_g32_galois_inner_aux γ χ t hγ f

example {k : Type*} [Field k] {H : Type*} [Group H] [Fintype H] (γ : k →+* k) (χ : H →* kˣ) (t : ℕ) (hγ : ∀ h, γ (χ h : k) = (χ h : k) ^ t) (f : H → k) :
    γ (papersInner f (papersLinChar χ)) = papersInner (fun h => γ (f h)) (papersLinChar (χ ^ t)) :=
  papers_g32_galois_inner γ χ t hγ f

/-- **The pairing of characters is the multiplicity.** For a finite-dimensional representation `V` of `G` and a linear character `χ` of a finite subgroup `H`, `⟨V|_H, χ⟩ = dim Hom_H(χ, V|_H)` in a field of characteristic zero (Mathlib's `FDRep.scalar_product_char_eq_finrank_equivariant` for `H`).
Source: G32 v0.16, Subsection 4.2 (`subsec:characters`, `V_χ = ⊕_τ Hom_{H′}(χ, τ|_{H′}) ⊗ M_τ` and the multiplicities `⟨τ|_{H′}, χ⟩`). -/
theorem papers_g32_mult_eq_inner {k : Type*} [Field k] [CharZero k] {G : Type*} [Group G] (H : Subgroup G) [Fintype H] (V : FDRep k G) (χ : H →* kˣ) :
    papersInner (papersRes H V.character) (papersLinChar χ) = (papersMult H V χ : k) :=
  papers_g32_mult_eq_inner_aux H V χ

example {k : Type*} [Field k] [CharZero k] {G : Type*} [Group G] (H : Subgroup G) [Fintype H] (V : FDRep k G) (χ : H →* kˣ) :
    papersInner (papersRes H V.character) (papersLinChar χ) = (papersMult H V χ : k) :=
  papers_g32_mult_eq_inner H V χ

/-- **The Galois action on multiplicities, `⟨τ^γ|_H, χ^t⟩ = ⟨τ|_H, χ⟩`.** With `τ^γ` the class function `γ ∘ tr τ` and `γ(χ(h)) = χ(h)^t`. This is the identity the paper's proof needs; the paper prints it as `⟨τ|_{H′}, χ^t⟩ = ⟨τ^γ|_{H′}, χ⟩`, which agrees with it for `t = ±1` and fails in general (`papers_g32_conj_printed_fails`).
Source: G32 v0.16, Lemma 4.4 (`lem:sign`), proof, first sentence. -/
theorem papers_g32_galois_mult {k : Type*} [Field k] [CharZero k] {G : Type*} [Group G] (H : Subgroup G) [Fintype H] (τ : FDRep k G) (γ : k →+* k) (χ : H →* kˣ) (t : ℕ) (hγ : ∀ h, γ (χ h : k) = (χ h : k) ^ t) :
    papersInner (papersRes H fun g => γ (τ.character g)) (papersLinChar (χ ^ t)) = (papersMult H τ χ : k) :=
  papers_g32_galois_mult_aux H τ γ χ t hγ

example {k : Type*} [Field k] [CharZero k] {G : Type*} [Group G] (H : Subgroup G) [Fintype H] (τ : FDRep k G) (γ : k →+* k) (χ : H →* kˣ) (t : ℕ) (hγ : ∀ h, γ (χ h : k) = (χ h : k) ^ t) :
    papersInner (papersRes H fun g => γ (τ.character g)) (papersLinChar (χ ^ t)) = (papersMult H τ χ : k) :=
  papers_g32_galois_mult H τ γ χ t hγ

/-- **`γ` fixing the character of `τ`: `⟨τ|_H, χ^t⟩ = ⟨τ|_H, χ⟩`.**
Source: G32 v0.16, Lemma 4.4 (`lem:sign`), proof ("`τ^γ = τ` if `γ` fixes `ω`"). -/
theorem papers_g32_galois_mult_fix {k : Type*} [Field k] [CharZero k] {G : Type*} [Group G] (H : Subgroup G) [Fintype H] (τ : FDRep k G) (γ : k →+* k) (χ : H →* kˣ) (t : ℕ) (hγ : ∀ h, γ (χ h : k) = (χ h : k) ^ t) (hfix : ∀ g, γ (τ.character g) = τ.character g) :
    papersMult H τ (χ ^ t) = papersMult H τ χ :=
  papers_g32_galois_mult_fix_aux H τ γ χ t hγ hfix

example {k : Type*} [Field k] [CharZero k] {G : Type*} [Group G] (H : Subgroup G) [Fintype H] (τ : FDRep k G) (γ : k →+* k) (χ : H →* kˣ) (t : ℕ) (hγ : ∀ h, γ (χ h : k) = (χ h : k) ^ t) (hfix : ∀ g, γ (τ.character g) = τ.character g) :
    papersMult H τ (χ ^ t) = papersMult H τ χ :=
  papers_g32_galois_mult_fix H τ γ χ t hγ hfix

/-- **`γ` carrying the character of `τ` to that of `τ̄`: `⟨τ̄|_H, χ^t⟩ = ⟨τ|_H, χ⟩`.**
Source: G32 v0.16, Lemma 4.4 (`lem:sign`), proof ("`τ^γ = τ̄` otherwise; the second case exchanges the two terms of each free coordinate"). -/
theorem papers_g32_galois_mult_swap {k : Type*} [Field k] [CharZero k] {G : Type*} [Group G] (H : Subgroup G) [Fintype H] (τ τbar : FDRep k G) (γ : k →+* k) (χ : H →* kˣ) (t : ℕ) (hγ : ∀ h, γ (χ h : k) = (χ h : k) ^ t) (hswap : ∀ g, γ (τ.character g) = τbar.character g) :
    papersMult H τbar (χ ^ t) = papersMult H τ χ :=
  papers_g32_galois_mult_swap_aux H τ τbar γ χ t hγ hswap

example {k : Type*} [Field k] [CharZero k] {G : Type*} [Group G] (H : Subgroup G) [Fintype H] (τ τbar : FDRep k G) (γ : k →+* k) (χ : H →* kˣ) (t : ℕ) (hγ : ∀ h, γ (χ h : k) = (χ h : k) ^ t) (hswap : ∀ g, γ (τ.character g) = τbar.character g) :
    papersMult H τbar (χ ^ t) = papersMult H τ χ :=
  papers_g32_galois_mult_swap H τ τbar γ χ t hγ hswap

/-- **G32 Lemma 4.4, case `γ` fixes `ω`: `a(χ^t) = a(χ)`.** If `γ(χ(h)) = χ(h)^t` and `γ` fixes the characters of all `τ`, `τ̄` and `η` (which holds for `K`-valued characters when `γ` fixes `ω`, `papers_g32_kvalued_fix`), then `a(χ^t) = a(χ)`, on the free and on the `ℤ/2` coordinates.
Source: G32 v0.16, Lemma 4.4 (`lem:sign`: "the character of `det V_{χ^t}` is `a(χ)` on the free coordinates if the automorphism `ζ_m ↦ ζ_m^t` fixes `ω` … on the coordinates of order two it is `a(χ)`"). -/
theorem papers_g32_sign_fix {k : Type*} [Field k] [CharZero k] {G : Type*} [Group G] {ι κ : Type*} (τ τbar : ι → FDRep k G) (η : κ → FDRep k G) (H : Subgroup G) [Fintype H] (γ : k →+* k) (χ : H →* kˣ) (t : ℕ) (hγ : ∀ h, γ (χ h : k) = (χ h : k) ^ t) (hτ : ∀ i g, γ ((τ i).character g) = (τ i).character g) (hτbar : ∀ i g, γ ((τbar i).character g) = (τbar i).character g) (hη : ∀ j g, γ ((η j).character g) = (η j).character g) :
    papersA τ τbar η H (χ ^ t) = papersA τ τbar η H χ :=
  papers_g32_sign_fix_aux τ τbar η H γ χ t hγ hτ hτbar hη

example {k : Type*} [Field k] [CharZero k] {G : Type*} [Group G] {ι κ : Type*} (τ τbar : ι → FDRep k G) (η : κ → FDRep k G) (H : Subgroup G) [Fintype H] (γ : k →+* k) (χ : H →* kˣ) (t : ℕ) (hγ : ∀ h, γ (χ h : k) = (χ h : k) ^ t) (hτ : ∀ i g, γ ((τ i).character g) = (τ i).character g) (hτbar : ∀ i g, γ ((τbar i).character g) = (τbar i).character g) (hη : ∀ j g, γ ((η j).character g) = (η j).character g) :
    papersA τ τbar η H (χ ^ t) = papersA τ τbar η H χ :=
  papers_g32_sign_fix τ τbar η H γ χ t hγ hτ hτbar hη

/-- **G32 Lemma 4.4, case `γ` moves `ω`: `a(χ^t) = −a(χ)` on the free coordinates and `a(χ)` on the `ℤ/2` coordinates.** If `γ(χ(h)) = χ(h)^t`, `γ` exchanges the characters of `τ i` and `τ̄ i`, and fixes those of the quaternionic `η j` (self-conjugate).
Source: G32 v0.16, Lemma 4.4 (`lem:sign`: "… and `−a(χ)` otherwise; on the coordinates of order two it is `a(χ)`"). -/
theorem papers_g32_sign_swap {k : Type*} [Field k] [CharZero k] {G : Type*} [Group G] {ι κ : Type*} (τ τbar : ι → FDRep k G) (η : κ → FDRep k G) (H : Subgroup G) [Fintype H] (γ : k →+* k) (χ : H →* kˣ) (t : ℕ) (hγ : ∀ h, γ (χ h : k) = (χ h : k) ^ t) (hτ : ∀ i g, γ ((τ i).character g) = (τbar i).character g) (hτbar : ∀ i g, γ ((τbar i).character g) = (τ i).character g) (hη : ∀ j g, γ ((η j).character g) = (η j).character g) :
    (papersA τ τbar η H (χ ^ t)).1 = -(papersA τ τbar η H χ).1 ∧ (papersA τ τbar η H (χ ^ t)).2 = (papersA τ τbar η H χ).2 :=
  papers_g32_sign_swap_aux τ τbar η H γ χ t hγ hτ hτbar hη

example {k : Type*} [Field k] [CharZero k] {G : Type*} [Group G] {ι κ : Type*} (τ τbar : ι → FDRep k G) (η : κ → FDRep k G) (H : Subgroup G) [Fintype H] (γ : k →+* k) (χ : H →* kˣ) (t : ℕ) (hγ : ∀ h, γ (χ h : k) = (χ h : k) ^ t) (hτ : ∀ i g, γ ((τ i).character g) = (τbar i).character g) (hτbar : ∀ i g, γ ((τbar i).character g) = (τ i).character g) (hη : ∀ j g, γ ((η j).character g) = (η j).character g) :
    (papersA τ τbar η H (χ ^ t)).1 = -(papersA τ τbar η H χ).1 ∧ (papersA τ τbar η H (χ ^ t)).2 = (papersA τ τbar η H χ).2 :=
  papers_g32_sign_swap τ τbar η H γ χ t hγ hτ hτbar hη

/-- **When `t` extends both to a `γ` fixing `ω` and to one moving it, the free coordinates of `a(χ)` vanish.** (For `3 ∤ m`, linear disjointness of `ℚ(ζ_m)` and `K` provides both, for every `t`.)
Source: G32 v0.16, Section 4, paragraph after Lemma 4.4 ("If `3 ∤ m` … every `t` extends both to an automorphism fixing `ω` and to one moving it; the lemma then gives `a(χ) = −a(χ)`, so `a(χ)` vanishes on the free coordinates"). -/
theorem papers_g32_sign_free_vanish {k : Type*} [Field k] [CharZero k] {G : Type*} [Group G] {ι κ : Type*} (τ τbar : ι → FDRep k G) (η : κ → FDRep k G) (H : Subgroup G) [Fintype H] (γ₁ γ₂ : k →+* k) (χ : H →* kˣ) (t : ℕ) (hγ₁ : ∀ h, γ₁ (χ h : k) = (χ h : k) ^ t) (hγ₂ : ∀ h, γ₂ (χ h : k) = (χ h : k) ^ t) (hfix : ∀ i g, γ₁ ((τ i).character g) = (τ i).character g ∧ γ₁ ((τbar i).character g) = (τbar i).character g) (hswap : ∀ i g, γ₂ ((τ i).character g) = (τbar i).character g ∧ γ₂ ((τbar i).character g) = (τ i).character g) :
    (papersA τ τbar η H χ).1 = 0 :=
  papers_g32_sign_free_vanish_aux τ τbar η H γ₁ γ₂ χ t hγ₁ hγ₂ hfix hswap

example {k : Type*} [Field k] [CharZero k] {G : Type*} [Group G] {ι κ : Type*} (τ τbar : ι → FDRep k G) (η : κ → FDRep k G) (H : Subgroup G) [Fintype H] (γ₁ γ₂ : k →+* k) (χ : H →* kˣ) (t : ℕ) (hγ₁ : ∀ h, γ₁ (χ h : k) = (χ h : k) ^ t) (hγ₂ : ∀ h, γ₂ (χ h : k) = (χ h : k) ^ t) (hfix : ∀ i g, γ₁ ((τ i).character g) = (τ i).character g ∧ γ₁ ((τbar i).character g) = (τbar i).character g) (hswap : ∀ i g, γ₂ ((τ i).character g) = (τbar i).character g ∧ γ₂ ((τbar i).character g) = (τ i).character g) :
    (papersA τ τbar η H χ).1 = 0 :=
  papers_g32_sign_free_vanish τ τbar η H γ₁ γ₂ χ t hγ₁ hγ₂ hfix hswap

/-- **A `K`-valued character value is fixed by a `γ` fixing `ω`.** For `x = a + bω` with `a, b ∈ ℚ`.
Source: G32 v0.16, Lemma 4.4 (`lem:sign`), proof ("Since every character of `G` is `K`-valued, `τ^γ = τ` if `γ` fixes `ω`"). -/
theorem papers_g32_kvalued_fix {k : Type*} [Field k] [CharZero k] (ω : k) (γ : k →+* k) (hγ : γ ω = ω) (x : k) (hx : ∃ a b : ℚ, x = a + b * ω) :
    γ x = x :=
  papers_g32_kvalued_fix_aux ω γ hγ x hx

example {k : Type*} [Field k] [CharZero k] (ω : k) (γ : k →+* k) (hγ : γ ω = ω) (x : k) (hx : ∃ a b : ℚ, x = a + b * ω) :
    γ x = x :=
  papers_g32_kvalued_fix ω γ hγ x hx

/-- **A `γ` moving `ω` exchanges a `K`-valued character value and its conjugate.** For `x = a + bω` and its `K`-conjugate `y = a + bω²` (the value of `τ̄` when `x` is a value of `τ`), with `ω² + ω + 1 = 0` and `γ(ω) = ω²`.
Source: G32 v0.16, Lemma 4.4 (`lem:sign`), proof ("`τ^γ = τ̄` otherwise"). -/
theorem papers_g32_kvalued_swap {k : Type*} [Field k] [CharZero k] (ω : k) (hω : ω ^ 2 + ω + 1 = 0) (γ : k →+* k) (hγ : γ ω = ω ^ 2) (x y : k) (hxy : ∃ a b : ℚ, x = a + b * ω ∧ y = a + b * ω ^ 2) :
    γ x = y ∧ γ y = x :=
  papers_g32_kvalued_swap_aux ω hω γ hγ x y hxy

example {k : Type*} [Field k] [CharZero k] (ω : k) (hω : ω ^ 2 + ω + 1 = 0) (γ : k →+* k) (hγ : γ ω = ω ^ 2) (x y : k) (hxy : ∃ a b : ℚ, x = a + b * ω ∧ y = a + b * ω ^ 2) :
    γ x = y ∧ γ y = x :=
  papers_g32_kvalued_swap ω hω γ hγ x y hxy

/-- **Falsification: the printed form `⟨τ|_{H′}, χ^t⟩ = ⟨τ^γ|_{H′}, χ⟩` fails for `t = 2`, `m = 5`.** Take `G = H′ = μ₅ ⊂ ℚ(ζ₅)ˣ`, `χ` the inclusion, `τ = χ²` (character `h ↦ h²`), `γ` the automorphism `ζ₅ ↦ ζ₅²`. Then `⟨τ, χ²⟩ = 1` while `⟨τ^γ, χ⟩ = ⟨χ⁴, χ⟩ = 0`. The corrected identity `papers_g32_galois_mult` holds, and Lemma 4.4 itself is unaffected (`γ⁻¹` fixes `ω` exactly when `γ` does).
Source: G32 v0.16, Lemma 4.4 (`lem:sign`), proof, first sentence (discrepancy, reported in `docs/specs/PapersSupply.md`). -/
theorem papers_g32_conj_printed_fails :
    letI := Fintype.ofFinite (rootsOfUnity 5 (CyclotomicField 5 ℚ)); ∃ γ : CyclotomicField 5 ℚ →+* CyclotomicField 5 ℚ, (∀ h : rootsOfUnity 5 (CyclotomicField 5 ℚ), γ ((h : (CyclotomicField 5 ℚ)ˣ) : CyclotomicField 5 ℚ) = ((h : (CyclotomicField 5 ℚ)ˣ) : CyclotomicField 5 ℚ) ^ 2) ∧ papersInner (fun h : rootsOfUnity 5 (CyclotomicField 5 ℚ) => ((h : (CyclotomicField 5 ℚ)ˣ) : CyclotomicField 5 ℚ) ^ 2) (papersLinChar ((rootsOfUnity 5 (CyclotomicField 5 ℚ)).subtype ^ 2)) ≠ papersInner (fun h : rootsOfUnity 5 (CyclotomicField 5 ℚ) => γ (((h : (CyclotomicField 5 ℚ)ˣ) : CyclotomicField 5 ℚ) ^ 2)) (papersLinChar (rootsOfUnity 5 (CyclotomicField 5 ℚ)).subtype) :=
  papers_g32_conj_printed_fails_aux

example :
    letI := Fintype.ofFinite (rootsOfUnity 5 (CyclotomicField 5 ℚ)); ∃ γ : CyclotomicField 5 ℚ →+* CyclotomicField 5 ℚ, (∀ h : rootsOfUnity 5 (CyclotomicField 5 ℚ), γ ((h : (CyclotomicField 5 ℚ)ˣ) : CyclotomicField 5 ℚ) = ((h : (CyclotomicField 5 ℚ)ˣ) : CyclotomicField 5 ℚ) ^ 2) ∧ papersInner (fun h : rootsOfUnity 5 (CyclotomicField 5 ℚ) => ((h : (CyclotomicField 5 ℚ)ˣ) : CyclotomicField 5 ℚ) ^ 2) (papersLinChar ((rootsOfUnity 5 (CyclotomicField 5 ℚ)).subtype ^ 2)) ≠ papersInner (fun h : rootsOfUnity 5 (CyclotomicField 5 ℚ) => γ (((h : (CyclotomicField 5 ℚ)ˣ) : CyclotomicField 5 ℚ) ^ 2)) (papersLinChar (rootsOfUnity 5 (CyclotomicField 5 ℚ)).subtype) :=
  papers_g32_conj_printed_fails

/-! TT Lemma 3.5: the case `t = −1` -/

/-- **Conjugation on pairings: `⟨f|_H, χ⁻¹⟩ = ⟨f̄|_H, χ⟩` with `f̄(g) = f(g⁻¹)`.** For a character `f = tr τ`, `f̄` is the character of the dual `τ̄` (`FDRep.char_dual`); no hypothesis on the character values.
Source: TT v0.16, Lemma 3.5 (`lem:conj`), proof ("Complex conjugation gives `⟨τ|_H, χ⁻¹⟩ = ⟨τ̄|_H, χ⟩`"). -/
theorem papers_tt_conj_inner {k : Type*} [Field k] {G : Type*} [Group G] (H : Subgroup G) [Fintype H] (f : G → k) (χ : H →* kˣ) :
    papersInner (papersRes H f) (papersLinChar χ⁻¹) = papersInner (papersRes H fun g => f g⁻¹) (papersLinChar χ) :=
  papers_tt_conj_inner_aux H f χ

example {k : Type*} [Field k] {G : Type*} [Group G] (H : Subgroup G) [Fintype H] (f : G → k) (χ : H →* kˣ) :
    papersInner (papersRes H f) (papersLinChar χ⁻¹) = papersInner (papersRes H fun g => f g⁻¹) (papersLinChar χ) :=
  papers_tt_conj_inner H f χ

/-- **`⟨τ|_H, χ⁻¹⟩ = ⟨τ̄|_H, χ⟩`** for `τ̄` with character `g ↦ tr τ(g⁻¹)`.
Source: TT v0.16, Lemma 3.5 (`lem:conj`), proof. -/
theorem papers_tt_conj_mult {k : Type*} [Field k] [CharZero k] {G : Type*} [Group G] (H : Subgroup G) [Fintype H] (τ τbar : FDRep k G) (hbar : ∀ g, τbar.character g = τ.character g⁻¹) (χ : H →* kˣ) :
    papersMult H τ χ⁻¹ = papersMult H τbar χ :=
  papers_tt_conj_mult_aux H τ τbar hbar χ

example {k : Type*} [Field k] [CharZero k] {G : Type*} [Group G] (H : Subgroup G) [Fintype H] (τ τbar : FDRep k G) (hbar : ∀ g, τbar.character g = τ.character g⁻¹) (χ : H →* kˣ) :
    papersMult H τ χ⁻¹ = papersMult H τbar χ :=
  papers_tt_conj_mult H τ τbar hbar χ

/-- **TT Lemma 3.5: `a_{−1}(χ) = −a(χ)` on the free coordinates and `a(χ)` on the `ℤ/2` coordinates.** Here `τ̄ i` has the character of the dual of `τ i`, and each quaternionic `η j` is self-dual (`tr η(g⁻¹) = tr η(g)`).
Source: TT v0.16, Lemma 3.5 (`lem:conj`: "For every supplier, `a_{−1}(χ) = −a(χ)` on the free coordinates, and `a_{−1}(χ) = a(χ)` on the `ℤ/2` coordinates"); G34 v1.5, Subsection 4.2 (last sentence before Definition 4.4). -/
theorem papers_tt_conj {k : Type*} [Field k] [CharZero k] {G : Type*} [Group G] {ι κ : Type*} (τ τbar : ι → FDRep k G) (η : κ → FDRep k G) (hbar : ∀ i g, (τbar i).character g = (τ i).character g⁻¹) (hη : ∀ j g, (η j).character g⁻¹ = (η j).character g) (H : Subgroup G) [Fintype H] (χ : H →* kˣ) :
    (papersA τ τbar η H χ⁻¹).1 = -(papersA τ τbar η H χ).1 ∧ (papersA τ τbar η H χ⁻¹).2 = (papersA τ τbar η H χ).2 :=
  papers_tt_conj_aux τ τbar η hbar hη H χ

example {k : Type*} [Field k] [CharZero k] {G : Type*} [Group G] {ι κ : Type*} (τ τbar : ι → FDRep k G) (η : κ → FDRep k G) (hbar : ∀ i g, (τbar i).character g = (τ i).character g⁻¹) (hη : ∀ j g, (η j).character g⁻¹ = (η j).character g) (H : Subgroup G) [Fintype H] (χ : H →* kˣ) :
    (papersA τ τbar η H χ⁻¹).1 = -(papersA τ τbar η H χ).1 ∧ (papersA τ τbar η H χ⁻¹).2 = (papersA τ τbar η H χ).2 :=
  papers_tt_conj τ τbar η hbar hη H χ

/-! Item 15, core statement 2: G34 Theorem 5.1, the homomorphism `𝖺` and the vanishing terms -/

/-- **Frobenius reciprocity for class functions: `⟨Ind_H^G ψ, f⟩_G = ⟨ψ, f|_H⟩_H`** for a class function `f` on `G`.
Source: G34 v1.5, Theorem 5.1 (`thm:brauer`), proof ("by Frobenius reciprocity `𝖺(Ind_{H′}^G χ) = a(χ)`"); Serre, *Linear representations of finite groups*, §7.2, Theorem 13. -/
theorem papers_g34_frobenius {k : Type*} [Field k] [CharZero k] {G : Type*} [Group G] [Fintype G] (H : Subgroup G) [Fintype H] (ψ : H → k) (f : G → k) (hf : ∀ g x, f (x * g * x⁻¹) = f g) :
    papersInner (papersIndCF H ψ) f = papersInner ψ (papersRes H f) :=
  papers_g34_frobenius_aux H ψ f hf

example {k : Type*} [Field k] [CharZero k] {G : Type*} [Group G] [Fintype G] (H : Subgroup G) [Fintype H] (ψ : H → k) (f : G → k) (hf : ∀ g x, f (x * g * x⁻¹) = f g) :
    papersInner (papersIndCF H ψ) f = papersInner ψ (papersRes H f) :=
  papers_g34_frobenius H ψ f hf

/-- **`𝖺(Ind_H^G χ) = a(χ)`.** The coordinates of the induced character, computed by `𝖺` on class functions, are the integers of `a(χ)`: `⟨τ|_H, χ⟩ − ⟨τ̄|_H, χ⟩` on the free coordinates and `⟨η|_H, χ⟩` (before reduction modulo `2`) on the quaternionic ones.
Source: G34 v1.5, Theorem 5.1 (`thm:brauer`), proof ("by Frobenius reciprocity `𝖺(Ind_{H′}^G χ) = a(χ)` for every subgroup `H′` and linear character `χ` of `H′`"). -/
theorem papers_g34_a_ind {k : Type*} [Field k] [CharZero k] {G : Type*} [Group G] [Fintype G] {ι κ : Type*} (τ τbar : ι → FDRep k G) (η : κ → FDRep k G) (H : Subgroup G) [Fintype H] (χ : H →* kˣ) :
    papersACF τ τbar η (papersIndCF H (papersLinChar χ)) = (fun i => ((papersA τ τbar η H χ).1 i : k), fun j => (papersMult H (η j) χ : k)) :=
  papers_g34_a_ind_aux τ τbar η H χ

example {k : Type*} [Field k] [CharZero k] {G : Type*} [Group G] [Fintype G] {ι κ : Type*} (τ τbar : ι → FDRep k G) (η : κ → FDRep k G) (H : Subgroup G) [Fintype H] (χ : H →* kˣ) :
    papersACF τ τbar η (papersIndCF H (papersLinChar χ)) = (fun i => ((papersA τ τbar η H χ).1 i : k), fun j => (papersMult H (η j) χ : k)) :=
  papers_g34_a_ind τ τbar η H χ

/-- **From a Brauer decomposition to `𝖺(σ) = ∑ n_i a(λ_i)`.** If the character of `σ` is `∑ n_i Ind_{B_i}^G λ_i` (Brauer's theorem, an explicit binder `hbrauer` here, not proved), then `𝖺(σ)` is the corresponding integer combination of the `a(λ_i)`.
Source: G34 v1.5, Theorem 5.1 (`thm:brauer`), proof ("Brauer induction … `σ = ∑ n_i Ind_{B_i}^G λ_i` in `R_ℂ(G)` … Hence `e_σ = ∑ n_i a(λ_i)`"). -/
theorem papers_g34_a_brauer {k : Type*} [Field k] [CharZero k] {G : Type*} [Group G] [Fintype G] {ι κ : Type*} (τ τbar : ι → FDRep k G) (η : κ → FDRep k G) (σ : FDRep k G) {N : ℕ} (Hs : Fin N → Subgroup G) [∀ i, Fintype (Hs i)] (lam : (i : Fin N) → Hs i →* kˣ) (n : Fin N → ℤ) (hbrauer : ∀ g, σ.character g = ∑ i, (n i : k) * papersIndCF (Hs i) (papersLinChar (lam i)) g) :
    papersACF τ τbar η σ.character = ∑ i, (n i : k) • ((fun i' => ((papersA τ τbar η (Hs i) (lam i)).1 i' : k)), fun j => (papersMult (Hs i) (η j) (lam i) : k)) :=
  papers_g34_a_brauer_aux τ τbar η σ Hs lam n hbrauer

example {k : Type*} [Field k] [CharZero k] {G : Type*} [Group G] [Fintype G] {ι κ : Type*} (τ τbar : ι → FDRep k G) (η : κ → FDRep k G) (σ : FDRep k G) {N : ℕ} (Hs : Fin N → Subgroup G) [∀ i, Fintype (Hs i)] (lam : (i : Fin N) → Hs i →* kˣ) (n : Fin N → ℤ) (hbrauer : ∀ g, σ.character g = ∑ i, (n i : k) * papersIndCF (Hs i) (papersLinChar (lam i)) g) :
    papersACF τ τbar η σ.character = ∑ i, (n i : k) • ((fun i' => ((papersA τ τbar η (Hs i) (lam i)).1 i' : k)), fun j => (papersMult (Hs i) (η j) (lam i) : k)) :=
  papers_g34_a_brauer τ τbar η σ Hs lam n hbrauer

/-- **A linear character of order `1` or `2` has vanishing free coordinates** (it is real).
Source: G34 v1.5, Theorem 5.1 (`thm:brauer`), proof ("If `λ_i` has order `1` or `2` it is real, so the free coordinates of `a(λ_i)` vanish"). -/
theorem papers_g34_order_two_free {k : Type*} [Field k] [CharZero k] {G : Type*} [Group G] {ι κ : Type*} (τ τbar : ι → FDRep k G) (η : κ → FDRep k G) (hbar : ∀ i g, (τbar i).character g = (τ i).character g⁻¹) (B : Subgroup G) [Fintype B] (lam : B →* kˣ) (hlam : lam ^ 2 = 1) :
    (papersA τ τbar η B lam).1 = 0 :=
  papers_g34_order_two_free_aux τ τbar η hbar B lam hlam

example {k : Type*} [Field k] [CharZero k] {G : Type*} [Group G] {ι κ : Type*} (τ τbar : ι → FDRep k G) (η : κ → FDRep k G) (hbar : ∀ i g, (τbar i).character g = (τ i).character g⁻¹) (B : Subgroup G) [Fintype B] (lam : B →* kˣ) (hlam : lam ^ 2 = 1) :
    (papersA τ τbar η B lam).1 = 0 :=
  papers_g34_order_two_free τ τbar η hbar B lam hlam

/-- **For `η` with a nondegenerate invariant alternating form and `λ` of order `1` or `2`, `⟨η|_B, λ⟩` is even.** The form pairs the `λ`-isotypic part only with the `λ⁻¹ = λ`-isotypic part, so it is nondegenerate there, and an alternating nondegenerate form lives on an even-dimensional space.
Source: G34 v1.5, Theorem 5.1 (`thm:brauer`), proof ("for quaternionic `η` the coordinate of order two is `⟨η|_{B_i}, λ_i⟩ mod 2`, and it vanishes. Indeed …"). -/
theorem papers_g34_quat_mult_even {k : Type*} [Field k] [CharZero k] {G : Type*} [Group G] (η : FDRep k G) (β : LinearMap.BilinForm k η) (hβalt : β.IsAlt) (hβnd : β.Nondegenerate) (hβinv : ∀ g x y, β (η.ρ g x) (η.ρ g y) = β x y) (B : Subgroup G) [Fintype B] (lam : B →* kˣ) (hlam : lam ^ 2 = 1) :
    Even (papersMult B η lam) :=
  papers_g34_quat_mult_even_aux η β hβalt hβnd hβinv B lam hlam

example {k : Type*} [Field k] [CharZero k] {G : Type*} [Group G] (η : FDRep k G) (β : LinearMap.BilinForm k η) (hβalt : β.IsAlt) (hβnd : β.Nondegenerate) (hβinv : ∀ g x y, β (η.ρ g x) (η.ρ g y) = β x y) (B : Subgroup G) [Fintype B] (lam : B →* kˣ) (hlam : lam ^ 2 = 1) :
    Even (papersMult B η lam) :=
  papers_g34_quat_mult_even η β hβalt hβnd hβinv B lam hlam

/-- **A linear character of order `1` or `2` has vanishing quaternionic coordinates**, when each `η j` carries a nondegenerate invariant alternating form.
Source: G34 v1.5, Theorem 5.1 (`thm:brauer`), proof ("Terms that vanish"). -/
theorem papers_g34_order_two_quat {k : Type*} [Field k] [CharZero k] {G : Type*} [Group G] {ι κ : Type*} (τ τbar : ι → FDRep k G) (η : κ → FDRep k G) (hforms : ∀ j, ∃ β : LinearMap.BilinForm k (η j), β.IsAlt ∧ β.Nondegenerate ∧ ∀ g x y, β ((η j).ρ g x) ((η j).ρ g y) = β x y) (B : Subgroup G) [Fintype B] (lam : B →* kˣ) (hlam : lam ^ 2 = 1) :
    (papersA τ τbar η B lam).2 = 0 :=
  papers_g34_order_two_quat_aux τ τbar η hforms B lam hlam

example {k : Type*} [Field k] [CharZero k] {G : Type*} [Group G] {ι κ : Type*} (τ τbar : ι → FDRep k G) (η : κ → FDRep k G) (hforms : ∀ j, ∃ β : LinearMap.BilinForm k (η j), β.IsAlt ∧ β.Nondegenerate ∧ ∀ g x y, β ((η j).ρ g x) ((η j).ρ g y) = β x y) (B : Subgroup G) [Fintype B] (lam : B →* kˣ) (hlam : lam ^ 2 = 1) :
    (papersA τ τbar η B lam).2 = 0 :=
  papers_g34_order_two_quat τ τbar η hforms B lam hlam

/-- **`a(λ) = 0` for a linear character of order `1` or `2`.**
Source: G34 v1.5, Theorem 5.1 (`thm:brauer`), proof ("Terms that vanish"). -/
theorem papers_g34_order_two_vanish {k : Type*} [Field k] [CharZero k] {G : Type*} [Group G] {ι κ : Type*} (τ τbar : ι → FDRep k G) (η : κ → FDRep k G) (hbar : ∀ i g, (τbar i).character g = (τ i).character g⁻¹) (hforms : ∀ j, ∃ β : LinearMap.BilinForm k (η j), β.IsAlt ∧ β.Nondegenerate ∧ ∀ g x y, β ((η j).ρ g x) ((η j).ρ g y) = β x y) (B : Subgroup G) [Fintype B] (lam : B →* kˣ) (hlam : lam ^ 2 = 1) :
    papersA τ τbar η B lam = 0 :=
  papers_g34_order_two_vanish_aux τ τbar η hbar hforms B lam hlam

example {k : Type*} [Field k] [CharZero k] {G : Type*} [Group G] {ι κ : Type*} (τ τbar : ι → FDRep k G) (η : κ → FDRep k G) (hbar : ∀ i g, (τbar i).character g = (τ i).character g⁻¹) (hforms : ∀ j, ∃ β : LinearMap.BilinForm k (η j), β.IsAlt ∧ β.Nondegenerate ∧ ∀ g x y, β ((η j).ρ g x) ((η j).ρ g y) = β x y) (B : Subgroup G) [Fintype B] (lam : B →* kˣ) (hlam : lam ^ 2 = 1) :
    papersA τ τbar η B lam = 0 :=
  papers_g34_order_two_vanish τ τbar η hbar hforms B lam hlam

/-- **Falsification: the alternating hypothesis is needed.** The trivial one-dimensional representation carries a nondegenerate invariant (symmetric) form, and its multiplicity `⟨1, 1⟩ = 1` is odd.
Source: G34 v1.5, Theorem 5.1 (`thm:brauer`), proof ("an alternating nondegenerate form lives on an even-dimensional space"). -/
theorem papers_g34_quat_needs_alt :
    ∃ β : LinearMap.BilinForm ℚ (FDRep.of (Representation.trivial ℚ Unit ℚ)), β.Nondegenerate ∧ (∀ g x y, β ((FDRep.of (Representation.trivial ℚ Unit ℚ)).ρ g x) ((FDRep.of (Representation.trivial ℚ Unit ℚ)).ρ g y) = β x y) ∧ ¬ Even (papersMult ⊤ (FDRep.of (Representation.trivial ℚ Unit ℚ)) 1) :=
  papers_g34_quat_needs_alt_aux

example :
    ∃ β : LinearMap.BilinForm ℚ (FDRep.of (Representation.trivial ℚ Unit ℚ)), β.Nondegenerate ∧ (∀ g x y, β ((FDRep.of (Representation.trivial ℚ Unit ℚ)).ρ g x) ((FDRep.of (Representation.trivial ℚ Unit ℚ)).ρ g y) = β x y) ∧ ¬ Even (papersMult ⊤ (FDRep.of (Representation.trivial ℚ Unit ℚ)) 1) :=
  papers_g34_quat_needs_alt

/-! The exponent multiset of a supplier (papers4's deferred group-theoretic half) -/

/-- **The orbits of `⟨g⟩` on `G ⧸ H` are as many as the double cosets `H \ G / ⟨g⟩`** (Mathlib's `DoubleCoset.Quotient`), through `⟨g⟩xH ↦ Hx⁻¹⟨g⟩`. So `papersExps` runs over the points of `C/H′` above the branch point, as in the paper.
Source: G34 v1.5, Section 4, paragraph after Definition 4.1 ("The points of `C/H′` over `p_j` correspond to the double cosets `H′ \ G / ⟨g_j⟩`"). -/
theorem papers_g34_orbits_doubleCoset {G : Type*} [Group G] (H : Subgroup G) (g : G) :
    Nat.card (Quotient (MulAction.orbitRel (Subgroup.zpowers g) (G ⧸ H))) = Nat.card (DoubleCoset.Quotient (H : Set G) (Subgroup.zpowers g : Set G)) :=
  papers_g34_orbits_doubleCoset_aux H g

example {G : Type*} [Group G] (H : Subgroup G) (g : G) :
    Nat.card (Quotient (MulAction.orbitRel (Subgroup.zpowers g) (G ⧸ H))) = Nat.card (DoubleCoset.Quotient (H : Set G) (Subgroup.zpowers g : Set G)) :=
  papers_g34_orbits_doubleCoset H g

/-- **A real branch element gives a negation-stable exponent multiset.** If `w g w⁻¹ = g⁻¹`, then `⟨g⟩xH ↦ ⟨g⟩wxH` permutes the orbits, keeps `ℓ` and inverts the local monodromy.
Source: G34 v1.5, Theorem 5.1 (`thm:brauer`), proof ("Since `w` normalizes `D = ⟨g_j⟩`, the map `H′xD ↦ H′xwD` is a bijection of `H′ \ G / D` … Hence the exponents … over `p_j` form a multiset stable under `α ↦ −α`"). -/
theorem papers_g34_exps_neg_stable {G : Type*} [Group G] [Finite G] {m : ℕ} (H : Subgroup G) (χ : H →* Multiplicative (ZMod m)) (g w : G) (hw : w * g * w⁻¹ = g⁻¹) :
    (papersExps H χ g).map Neg.neg = papersExps H χ g :=
  papers_g34_exps_neg_stable_aux H χ g w hw

example {G : Type*} [Group G] [Finite G] {m : ℕ} (H : Subgroup G) (χ : H →* Multiplicative (ZMod m)) (g w : G) (hw : w * g * w⁻¹ = g⁻¹) :
    (papersExps H χ g).map Neg.neg = papersExps H χ g :=
  papers_g34_exps_neg_stable H χ g w hw

/-- **The exponents over one branch point sum to the transfer of `g`.** By Mathlib's `MonoidHom.transfer_eq_prod_quotient_orbitRel_zpowers_quot`.
Source: G34 v1.5, Theorem 5.1 (`thm:brauer`), proof ("the exponents sum to `0` modulo `m`"); the transfer formula is the source of that sum condition. -/
theorem papers_g34_exps_sum_transfer {G : Type*} [Group G] [Finite G] {m : ℕ} (H : Subgroup G) (χ : H →* Multiplicative (ZMod m)) (g : G) :
    (papersExps H χ g).sum = Multiplicative.toAdd (χ.transfer g) :=
  papers_g34_exps_sum_transfer_aux H χ g

example {G : Type*} [Group G] [Finite G] {m : ℕ} (H : Subgroup G) (χ : H →* Multiplicative (ZMod m)) (g : G) :
    (papersExps H χ g).sum = Multiplicative.toAdd (χ.transfer g) :=
  papers_g34_exps_sum_transfer H χ g

/-- **The sum condition: for a product-one tuple the exponents sum to `0` modulo `m`.**
Source: G34 v1.5, Theorem 5.1 (`thm:brauer`), proof ("because the exponents sum to `0` modulo `m`"). -/
theorem papers_g34_exps_sum_zero {G : Type*} [Group G] [Finite G] {m : ℕ} (H : Subgroup G) (χ : H →* Multiplicative (ZMod m)) (gs : List G) (hprod : gs.prod = 1) :
    (papersExpsTuple H χ gs).sum = 0 :=
  papers_g34_exps_sum_zero_aux H χ gs hprod

example {G : Type*} [Group G] [Finite G] {m : ℕ} (H : Subgroup G) (χ : H →* Multiplicative (ZMod m)) (gs : List G) (hprod : gs.prod = 1) :
    (papersExpsTuple H χ gs).sum = 0 :=
  papers_g34_exps_sum_zero H χ gs hprod

/-- **Real classes make every supplier's exponents simple.** For a product-one tuple of real elements, the exponent list of `(H, χ)` is simple (papers1's `IsSimpleExps`), through papers4's `papers_g34_exps_simple`.
Source: G34 v1.5, Theorem 5.1 (`thm:brauer`), proof ("These suppliers are admissible … Hence `α` is simple"). -/
theorem papers_g34_exps_tuple_simple {G : Type*} [Group G] [Finite G] {m : ℕ} [NeZero m] (H : Subgroup G) (χ : H →* Multiplicative (ZMod m)) (gs : List G) (hreal : ∀ g ∈ gs, ∃ w : G, w * g * w⁻¹ = g⁻¹) (hprod : gs.prod = 1) :
    IsSimpleExps m (papersExpsList H χ gs) :=
  papers_g34_exps_tuple_simple_aux H χ gs hreal hprod

example {G : Type*} [Group G] [Finite G] {m : ℕ} [NeZero m] (H : Subgroup G) (χ : H →* Multiplicative (ZMod m)) (gs : List G) (hreal : ∀ g ∈ gs, ∃ w : G, w * g * w⁻¹ = g⁻¹) (hprod : gs.prod = 1) :
    IsSimpleExps m (papersExpsList H χ gs) :=
  papers_g34_exps_tuple_simple H χ gs hreal hprod

/-- **Real classes make every supplier with `h > 0` admissible** (papers4's `SupplierAdmissible`, `q` the genus of `C/H′` as a number).
Source: G34 v1.5, Theorem 5.1 (`thm:brauer`), proof ("Let `(H′, χ)` be a supplier with `h > 0` … Hence `α` is simple, `s` is even, and `h = 2q − 2 + s` is even"). -/
theorem papers_g34_exps_tuple_admissible {G : Type*} [Group G] [Finite G] {m : ℕ} [NeZero m] (H : Subgroup G) (χ : H →* Multiplicative (ZMod m)) (gs : List G) (hreal : ∀ g ∈ gs, ∃ w : G, w * g * w⁻¹ = g⁻¹) (hprod : gs.prod = 1) (q : ℕ) (hh : 0 < (2 * q - 2 + (papersExpsList H χ gs).length : ℤ)) :
    SupplierAdmissible m q (papersExpsList H χ gs) :=
  papers_g34_exps_tuple_admissible_aux H χ gs hreal hprod q hh

example {G : Type*} [Group G] [Finite G] {m : ℕ} [NeZero m] (H : Subgroup G) (χ : H →* Multiplicative (ZMod m)) (gs : List G) (hreal : ∀ g ∈ gs, ∃ w : G, w * g * w⁻¹ = g⁻¹) (hprod : gs.prod = 1) (q : ℕ) (hh : 0 < (2 * q - 2 + (papersExpsList H χ gs).length : ℤ)) :
    SupplierAdmissible m q (papersExpsList H χ gs) :=
  papers_g34_exps_tuple_admissible H χ gs hreal hprod q hh

/-- **Falsification: the reality hypothesis is needed.** In `ℤ/3` with `H = G` and `χ` the identity, the product-one tuple `(1, 1, 1)` has exponents `(1, 1, 1)`, not simple; `1` is not conjugate to `−1`.
Source: G34 v1.5, Theorem 5.1 (`thm:brauer`: "If the classes `𝒞₁, …, 𝒞_r` are real"). -/
theorem papers_g34_exps_tuple_real_needed :
    ([Multiplicative.ofAdd 1, Multiplicative.ofAdd 1, Multiplicative.ofAdd 1] : List (Multiplicative (ZMod 3))).prod = 1 ∧ ¬ (∀ g ∈ ([Multiplicative.ofAdd 1, Multiplicative.ofAdd 1, Multiplicative.ofAdd 1] : List (Multiplicative (ZMod 3))), ∃ w : Multiplicative (ZMod 3), w * g * w⁻¹ = g⁻¹) ∧ ¬ IsSimpleExps 3 (papersExpsList (⊤ : Subgroup (Multiplicative (ZMod 3))) (⊤ : Subgroup (Multiplicative (ZMod 3))).subtype [Multiplicative.ofAdd 1, Multiplicative.ofAdd 1, Multiplicative.ofAdd 1]) :=
  papers_g34_exps_tuple_real_needed_aux

example :
    ([Multiplicative.ofAdd 1, Multiplicative.ofAdd 1, Multiplicative.ofAdd 1] : List (Multiplicative (ZMod 3))).prod = 1 ∧ ¬ (∀ g ∈ ([Multiplicative.ofAdd 1, Multiplicative.ofAdd 1, Multiplicative.ofAdd 1] : List (Multiplicative (ZMod 3))), ∃ w : Multiplicative (ZMod 3), w * g * w⁻¹ = g⁻¹) ∧ ¬ IsSimpleExps 3 (papersExpsList (⊤ : Subgroup (Multiplicative (ZMod 3))) (⊤ : Subgroup (Multiplicative (ZMod 3))).subtype [Multiplicative.ofAdd 1, Multiplicative.ofAdd 1, Multiplicative.ofAdd 1]) :=
  papers_g34_exps_tuple_real_needed

/-- **Falsification: the product relation is needed.** In `ℤ/4` with `H = G` and `χ` the identity, the one-element tuple `(2)` is real but not product-one, and its exponents `(2)` are not simple.
Source: G34 v1.5, Theorem 5.1 (`thm:brauer`), proof ("because the exponents sum to `0` modulo `m`"). -/
theorem papers_g34_exps_tuple_prod_needed :
    (∀ g ∈ ([Multiplicative.ofAdd 2] : List (Multiplicative (ZMod 4))), ∃ w : Multiplicative (ZMod 4), w * g * w⁻¹ = g⁻¹) ∧ ([Multiplicative.ofAdd 2] : List (Multiplicative (ZMod 4))).prod ≠ 1 ∧ ¬ IsSimpleExps 4 (papersExpsList (⊤ : Subgroup (Multiplicative (ZMod 4))) (⊤ : Subgroup (Multiplicative (ZMod 4))).subtype [Multiplicative.ofAdd 2]) :=
  papers_g34_exps_tuple_prod_needed_aux

example :
    (∀ g ∈ ([Multiplicative.ofAdd 2] : List (Multiplicative (ZMod 4))), ∃ w : Multiplicative (ZMod 4), w * g * w⁻¹ = g⁻¹) ∧ ([Multiplicative.ofAdd 2] : List (Multiplicative (ZMod 4))).prod ≠ 1 ∧ ¬ IsSimpleExps 4 (papersExpsList (⊤ : Subgroup (Multiplicative (ZMod 4))) (⊤ : Subgroup (Multiplicative (ZMod 4))).subtype [Multiplicative.ofAdd 2]) :=
  papers_g34_exps_tuple_prod_needed

