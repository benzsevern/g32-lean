import Mathlib
import HodgeLean.Papers.PapersMoreDefs

/-! # Definitions for the compact paper results, batch 5 (FROZEN)

Part of the frozen spec for `docs/briefs/cloud-spec-papers5.md` (`docs/specs/PapersSupply.md`).
Do not edit this file. It holds the representation-theoretic notions of G32 v0.16 Subsection 4.2
(`subsec:characters`; read-only copy `docs/specs/inputs/papers/weil-nonsplit-g32-v0.16.tex`), TT
v0.16 Section 3 (`transfer-theorem-v0.16.tex`) and G34 v1.5 Sections 4 and 5
(`weil-qsqrt3-v1.5.tex`), written for a finite group `G` and a field `k`:

* class functions and their pairing `⟨f, ψ⟩ = |H|⁻¹ ∑ f(h) ψ(h⁻¹)` (no complex conjugation, so
  that the Galois action of G32 Lemma 4.4 is visible);
* restriction, the induced class function, the one-dimensional representation of a linear
  character and the restriction of an `FDRep`;
* the multiplicity `⟨τ|_{H′}, χ⟩` as the dimension of `Hom_{H′}(χ, τ|_{H′})`, and the vector
  `a(χ) ∈ ℤ^{pairs} ⊕ (ℤ/2)^{quat}` built from it;
* the local monodromies and the exponent multiset of a supplier `(H′, χ)` at a branch element `g`,
  read off from the orbits of `⟨g⟩` on `G ⧸ H′` (the double cosets `⟨g⟩\G/H′`).

Nothing here mentions curves, cohomology or abelian varieties: the "pairs" and "quat" index sets,
the representations `τ, τ̄, η` and the branch elements are bare data supplied by the user.
Relation to the goal: HC no distance; AV milestone no distance.
-/

namespace HodgeLean.Papers

open MulAction

/-! ## Class functions -/

/-- The pairing of two functions on a finite group, `⟨f, ψ⟩ = |H|⁻¹ ∑_{h ∈ H} f(h) ψ(h⁻¹)`. For
characters of representations over `ℂ` this is the usual inner product, since `ψ(h⁻¹)` is the
complex conjugate of `ψ(h)`; it is symmetric in `f` and `ψ`.
Source: G32 v0.16, Subsection 4.2 (`subsec:characters`, the multiplicities `⟨τ|_{H′}, χ⟩` in the
display defining `a(χ)`); Serre, *Linear representations of finite groups*, §2.2 and §7.2. -/
noncomputable def papersInner {k : Type*} [Field k] {H : Type*} [Group H] [Fintype H]
    (f ψ : H → k) : k :=
  (Fintype.card H : k)⁻¹ * ∑ h, f h * ψ h⁻¹

example : papersInner (H := Unit) (fun _ => (2 : ℚ)) (fun _ => 3) = 6 := by
  simp [papersInner]; norm_num

/-- The restriction of a function on `G` to a subgroup `H`.
Source: G32 v0.16, Subsection 4.2 (`τ|_{H′}`). -/
def papersRes {k G : Type*} [Group G] (H : Subgroup G) (f : G → k) : H → k :=
  fun h => f h

example : papersRes (⊤ : Subgroup Unit) (fun _ => (1 : ℚ)) 1 = 1 := rfl

/-- The function `h ↦ χ(h)` of a linear character `χ : H → kˣ`.
Source: G34 v1.5, Definition 4.1 (`def:supplier`: a character `χ : H′ → ℂ^×`). -/
def papersLinChar {k H : Type*} [Field k] [Group H] (χ : H →* kˣ) : H → k :=
  fun h => (χ h : k)

example : papersLinChar (1 : Unit →* ℚˣ) () = 1 := rfl

open Classical in
/-- The induced class function, `Ind_H^G ψ (g) = |H|⁻¹ ∑_{x ∈ G} ψ°(x g x⁻¹)`, where `ψ°` extends `ψ`
by `0` off `H`. For the character of a representation of `H` it is the character of the induced
representation.
Source: G34 v1.5, Theorem 5.1 (`thm:brauer`), proof ("`Ind_{H′}^G χ`"); Serre, *Linear
representations of finite groups*, §7.2, Theorem 12. -/
noncomputable def papersIndCF {k G : Type*} [Field k] [Group G] [Fintype G] (H : Subgroup G)
    [Fintype H] (ψ : H → k) : G → k :=
  fun g => (Fintype.card H : k)⁻¹ * ∑ x : G, if hx : x * g * x⁻¹ ∈ H then ψ ⟨_, hx⟩ else 0

example {G : Type*} [Group G] [Fintype G] (H : Subgroup G) [Fintype H] (g : G) :
    papersIndCF H (fun _ => (0 : ℚ)) g = 0 := by
  simp [papersIndCF]

/-! ## Representations and multiplicities -/

/-- The one-dimensional representation of `H` on `k` given by a linear character `χ`.
Source: G34 v1.5, Definition 4.1 (`def:supplier`). -/
noncomputable def papersLinRep {k : Type*} [Field k] {H : Type*} [Group H] (χ : H →* kˣ) :
    FDRep k H :=
  FDRep.of (((Algebra.lmul k k : k →* Module.End k k)).comp ((Units.coeHom k).comp χ))

example {k : Type*} [Field k] : papersLinRep (1 : Unit →* kˣ) = papersLinRep (1 : Unit →* kˣ) :=
  rfl

/-- The restriction of a finite-dimensional representation of `G` to a subgroup `H`.
Source: G32 v0.16, Subsection 4.2 (`τ|_{H′}`). -/
noncomputable def papersResRep {k : Type*} [Field k] {G : Type*} [Group G] (H : Subgroup G)
    (V : FDRep k G) : FDRep k H :=
  FDRep.of (V.ρ.comp H.subtype)

example {k : Type*} [Field k] {G : Type*} [Group G] (V : FDRep k G) :
    papersResRep (⊤ : Subgroup G) V = papersResRep ⊤ V := rfl

/-- The multiplicity `⟨τ|_H, χ⟩` of a linear character `χ` of `H` in the restriction of `τ`, as the
dimension of `Hom_H(χ, τ|_H)`.
Source: G32 v0.16, Subsection 4.2 (`V_χ = ⊕_τ Hom_{H′}(χ, τ|_{H′}) ⊗ M_τ` and the multiplicities
`⟨τ|_{H′}, χ⟩`). -/
noncomputable def papersMult {k : Type*} [Field k] {G : Type*} [Group G] (H : Subgroup G)
    (V : FDRep k G) (χ : H →* kˣ) : ℕ :=
  Module.finrank k (papersLinRep χ ⟶ papersResRep H V)

example {k : Type*} [Field k] {G : Type*} [Group G] (H : Subgroup G) (V : FDRep k G)
    (χ : H →* kˣ) : papersMult H V χ = Module.finrank k (papersLinRep χ ⟶ papersResRep H V) :=
  rfl

/-- The vector `a(χ) ∈ ℤ^{pairs} ⊕ (ℤ/2)^{quat}` of a supplier `(H, χ)`: for each pair `i`, with
chosen member `τ i` and partner `τbar i`, the free coordinate `⟨τ|_H, χ⟩ − ⟨τ̄|_H, χ⟩`; for each
quaternionic `η j`, the coordinate `⟨η|_H, χ⟩ mod 2`. The index sets and the representations are
data: the paper's restriction to pairs and quaternionic `τ` with `m_τ > 0` is the user's choice of
`ι`, `κ`, `τ`, `τbar`, `η`.
Source: G32 v0.16, Subsection 4.2 (display defining `a(χ)`); TT v0.16, Subsection 3.2 (`a_t(χ)`
with `a(χ) = a_1(χ)`); G34 v1.5, Subsection 4.2. -/
noncomputable def papersA {k : Type*} [Field k] {G : Type*} [Group G] {ι κ : Type*}
    (τ τbar : ι → FDRep k G) (η : κ → FDRep k G) (H : Subgroup G) (χ : H →* kˣ) :
    (ι → ℤ) × (κ → ZMod 2) :=
  (fun i => (papersMult H (τ i) χ : ℤ) - papersMult H (τbar i) χ,
    fun j => (papersMult H (η j) χ : ZMod 2))

example {k : Type*} [Field k] {G : Type*} [Group G] (H : Subgroup G) (χ : H →* kˣ) :
    papersA (ι := Empty) (κ := Empty) Empty.elim Empty.elim Empty.elim H χ =
      (fun i => i.elim, fun j => j.elim) := by
  ext i <;> exact i.elim

/-- The homomorphism `𝖺 : R_ℂ(G) → X*(T)` on class functions, with coordinates in `k`: for a class
function `F` (the character of a virtual representation), the free coordinate of the pair `i` is
`⟨F, τ i⟩ − ⟨F, τbar i⟩` and the quaternionic coordinate `j` is `⟨F, η j⟩` (to be read modulo `2`
when it is an integer).
Source: G34 v1.5, Theorem 5.1 (`thm:brauer`), proof ("A homomorphism": `𝖺(V) = (mult_τ V −
mult_τ̄ V)_pairs ⊕ (mult_η V mod 2)_quat`). -/
noncomputable def papersACF {k : Type*} [Field k] {G : Type*} [Group G] [Fintype G] {ι κ : Type*}
    (τ τbar : ι → FDRep k G) (η : κ → FDRep k G) (F : G → k) : (ι → k) × (κ → k) :=
  (fun i => papersInner F (τ i).character - papersInner F (τbar i).character,
    fun j => papersInner F (η j).character)

example {k : Type*} [Field k] {G : Type*} [Group G] [Fintype G] :
    papersACF (ι := Empty) (κ := Empty) Empty.elim Empty.elim Empty.elim (fun _ : G => (0 : k)) =
      (fun i => i.elim, fun j => j.elim) := by
  ext i <;> exact i.elim

/-! ## Exponents of a supplier -/

/-- The local monodromy of the supplier cover over the orbit `q` of `⟨g⟩` on `G ⧸ H` (the double
coset `⟨g⟩ x H` with `x = q.out.out`): the element `x⁻¹ g^ℓ x ∈ H`, `ℓ` the least positive integer
with `g^ℓ x H = x H`. The paper writes the same data with `H′ \ G / ⟨g⟩` and `x g^ℓ x⁻¹`; the
inversion `x ↦ x⁻¹` matches the two descriptions. This is the element of Mathlib's transfer formula
`MonoidHom.transfer_eq_prod_quotient_orbitRel_zpowers_quot`.
Source: G34 v1.5, Section 4, paragraph after Definition 4.1 ("over the double coset of `x` the
local monodromy is `x g_j^ℓ x⁻¹ ∈ H′`, with `ℓ` the least positive integer for which this lies in
`H′`"); TT v0.16, Subsection 3.1. -/
noncomputable def papersLocalMonodromy {G : Type*} [Group G] (H : Subgroup G) (g : G)
    (q : Quotient (orbitRel (Subgroup.zpowers g) (G ⧸ H))) : H :=
  ⟨q.out.out⁻¹ * g ^ Function.minimalPeriod (g • ·) q.out * q.out.out,
    QuotientGroup.out_conj_pow_minimalPeriod_mem H g q.out⟩

example {G : Type*} [Group G] (H : Subgroup G) (g : G)
    (q : Quotient (orbitRel (Subgroup.zpowers g) (G ⧸ H))) :
    ((papersLocalMonodromy H g q : H) : G) =
      q.out.out⁻¹ * g ^ Function.minimalPeriod (g • ·) q.out * q.out.out := rfl

/-- The exponents of the supplier `(H, χ)` over a branch point with local monodromy `g`: with `χ`
taking values in `ℤ/m` (the paper's exponents "with respect to a generator" of the image `μ_m`),
the multiset of the nonzero values `χ(x⁻¹ g^ℓ x)` over the orbits of `⟨g⟩` on `G ⧸ H`. Orbits with
value `0` are unbranched in `C′ → C/H` and are dropped.
Source: G34 v1.5, Section 4, paragraph after Definition 4.1 ("`α ∈ (ℤ/m − {0})^s` their exponents
with respect to a generator"). -/
noncomputable def papersExps {G : Type*} [Group G] [Finite G] {m : ℕ} (H : Subgroup G)
    (χ : H →* Multiplicative (ZMod m)) (g : G) : Multiset (ZMod m) :=
  haveI := Fintype.ofFinite (Quotient (orbitRel (Subgroup.zpowers g) (G ⧸ H)))
  ((Finset.univ : Finset (Quotient (orbitRel (Subgroup.zpowers g) (G ⧸ H)))).val.map
      fun q => Multiplicative.toAdd (χ (papersLocalMonodromy H g q))).filter (· ≠ 0)

example {G : Type*} [Group G] [Finite G] (H : Subgroup G) (g : G) :
    papersExps H (1 : H →* Multiplicative (ZMod 3)) g = 0 := by
  simp only [papersExps, MonoidHom.one_apply, toAdd_one, Multiset.filter_eq_nil]
  intro a ha
  obtain ⟨_, _, rfl⟩ := Multiset.mem_map.mp ha
  simp

/-- The exponents of the supplier `(H, χ)` over all branch points of a tuple `gs = (g₁, …, g_r)`:
the sum (multiset union) of `papersExps H χ g_j`.
Source: G34 v1.5, Section 4, paragraph after Definition 4.1 (the points of `C/H′` over `p_j`
correspond to `H′ \ G / ⟨g_j⟩`). -/
noncomputable def papersExpsTuple {G : Type*} [Group G] [Finite G] {m : ℕ} (H : Subgroup G)
    (χ : H →* Multiplicative (ZMod m)) (gs : List G) : Multiset (ZMod m) :=
  (gs.map (papersExps H χ)).sum

example {G : Type*} [Group G] [Finite G] {m : ℕ} (H : Subgroup G)
    (χ : H →* Multiplicative (ZMod m)) : papersExpsTuple H χ [] = 0 := rfl

/-- The exponents of `papersExpsTuple` as a list of natural numbers in `1, …, m − 1` (the
representatives `ZMod.val`), the format of papers1's `IsSimpleExps` and papers4's
`ExpsNegStable`. The order of the list is irrelevant for both predicates.
Source: G34 v1.5, Section 4, paragraph after Definition 4.1. -/
noncomputable def papersExpsList {G : Type*} [Group G] [Finite G] {m : ℕ} (H : Subgroup G)
    (χ : H →* Multiplicative (ZMod m)) (gs : List G) : List ℕ :=
  ((papersExpsTuple H χ gs).map ZMod.val).toList

example {G : Type*} [Group G] [Finite G] {m : ℕ} (H : Subgroup G)
    (χ : H →* Multiplicative (ZMod m)) : papersExpsList H χ [] = [] := by
  simp [papersExpsList, papersExpsTuple]

end HodgeLean.Papers
