import HodgeLean.RealDefs.ComplexFundamentalClassProofs

/-! # The fundamental class of a compact complex manifold (J5c, FROZEN SPEC)

The frozen spec for `docs/briefs/cloud-spec-j5c.md`. Do not edit this file. Each theorem is
proved by the matching `_aux` theorem in `ComplexFundamentalClassProofs.lean`.

The statements follow the proof of Hatcher's Lemma 3.27, in rational singular homology
`H_i(M, M \ A; ℚ)` = upstream's `RelativeHomology ℚ (TopPair.ofSubset Aᶜ) i`. They are: the
chain-level relative Mayer–Vietoris sequence (short exactness, small-chain comparison, exactness
of homology at two terms) and its two uses in the proof; the Mayer–Vietoris step; restriction
from a convex compact set to a point, the convex case, finite unions of convex sets and arbitrary
compact sets in a finite-dimensional real vector space; compact supports of classes; closed-set
excision on chains and on homology; compact sets in one chart and in a charted Hausdorff space;
existence of a class with prescribed coherent point values along a compact set; the fundamental
class of a compact charted Hausdorff space; the fundamental class of `X(ℂ)` for a smooth
projective complex variety `X`, in exactly the type of the open J5 input
`exists_complexFundamentalClass_aux`; and falsification checks: no class in `H_n(E; ℚ)` has a
nonzero point value when `dim E = n ≥ 1`, and on `Fin d → ℂ` the translates of
`standardComplexLocalClass` are a locally coherent, nowhere-zero family with no fundamental
class.

Scope. The manifold statements are about a Hausdorff space with a Mathlib `ChartedSpace` structure
modelled on a finite-dimensional real normed space `E`; no smoothness or second countability is
used. The orientation is any family of local classes that is locally the restriction of one class
(the form of the ported `exists_neighborhood_complexLocalOrientation`). Not claimed: uniqueness of
the fundamental class, that it generates `H_n(M; ℚ)` on a connected `M`, Poincaré duality,
statements for integer coefficients, for non-orientable manifolds or for singular varieties. Every
statement is an implication from its explicit hypotheses; no named geometric input is used.
Relation to the goal: HC no distance; AV milestone no distance.
-/

open CategoryTheory TopologicalSpace AlgebraicGeometry AlgebraicGeometry.ComplexPoint
open AlgebraicTopology.Singular

namespace HodgeLean.RealDefs

/-- **The relative Mayer–Vietoris sequence of chains is short exact.** For any subsets `A`, `B`
of `M`, `0 → C(M)/C(M \ (A ∪ B)) → C(M)/C(M \ A) ⊞ C(M)/C(M \ B) → C(M)/(C(M \ A) + C(M \ B)) → 0`
is exact. A singular simplex lies in `M \ (A ∪ B)` exactly when it lies in `M \ A` and in
`M \ B`; no topological hypothesis is used.
Source: Hatcher, *Algebraic Topology*, §2.2, p. 152 (relative Mayer–Vietoris sequence); compare
upstream's `singularMayerVietorisShortComplex_shortExact`. -/
theorem j5c_relativeMayerVietorisShortComplex_shortExact {M : Type} [TopologicalSpace M] (A B : Set M) :
    (relativeMayerVietorisShortComplex M A B).ShortExact :=
  j5c_relativeMayerVietorisShortComplex_shortExact_aux A B

example {M : Type} [TopologicalSpace M] (A B : Set M) :
    (relativeMayerVietorisShortComplex M A B).ShortExact :=
  j5c_relativeMayerVietorisShortComplex_shortExact A B

/-- **Small chains in `M \ (A ∩ B)`.** For closed `A`, `B`, the inclusion of the chains small for
the open cover `{M \ A, M \ B}` of `M \ (A ∩ B)` into all singular chains of `M \ (A ∩ B)` is
a quasi-isomorphism.
Source: Hatcher, *Algebraic Topology*, Proposition 2.21, in the space `M \ (A ∩ B)`; upstream's
`coverSmallRationalChainHomotopyEquiv_of_openCover` (`Singular/Excision/Field.lean:386`). -/
theorem j5c_relativeSumSmallChainComparison_quasiIso {M : Type} [TopologicalSpace M] {A B : Set M}
    (hA : IsClosed A) (hB : IsClosed B) :
    QuasiIso (relativeSumSmallChainComparison M A B) :=
  j5c_relativeSumSmallChainComparison_quasiIso_aux hA hB

example {M : Type} [TopologicalSpace M] {A B : Set M}
    (hA : IsClosed A) (hB : IsClosed B) :
    QuasiIso (relativeSumSmallChainComparison M A B) :=
  j5c_relativeSumSmallChainComparison_quasiIso hA hB

/-- **The relative small-chain comparison.** For closed `A`, `B`, the comparison
`C(M)/(C(M \ A) + C(M \ B)) → C(M)/C(M \ (A ∩ B))` is a quasi-isomorphism.
Source: Hatcher, *Algebraic Topology*, Proposition 2.21 and the five lemma, §2.2, p. 152. -/
theorem j5c_relativeSumComparison_quasiIso {M : Type} [TopologicalSpace M] {A B : Set M}
    (hA : IsClosed A) (hB : IsClosed B) :
    QuasiIso (relativeSumComparison M A B) :=
  j5c_relativeSumComparison_quasiIso_aux hA hB

example {M : Type} [TopologicalSpace M] {A B : Set M}
    (hA : IsClosed A) (hB : IsClosed B) :
    QuasiIso (relativeSumComparison M A B) :=
  j5c_relativeSumComparison_quasiIso hA hB

/-- **Exactness at the middle, chain-model form.** Classes on `A` and on `B` with the same image
in `H_i(C(M)/(C(M \ A) + C(M \ B)))` are the restrictions of one class on `A ∪ B`.
Source: Hatcher, *Algebraic Topology*, §2.2, p. 152: the long exact homology sequence of
`j5c_relativeMayerVietorisShortComplex_shortExact`, exact at the middle term. -/
theorem j5c_relativeMayerVietoris_exact_middle {M : Type} [TopologicalSpace M] (A B : Set M) (i : ℕ)
    (a : RelativeHomology ℚ (TopPair.ofSubset (X := TopCat.of M) Aᶜ) i)
    (b : RelativeHomology ℚ (TopPair.ofSubset (X := TopCat.of M) Bᶜ) i)
    (hab : (HomologicalComplex.homologyMap (relativeSumLeftProjection M A B) i).hom a =
      (HomologicalComplex.homologyMap (relativeSumRightProjection M A B) i).hom b) :
    ∃ c : RelativeHomology ℚ (TopPair.ofSubset (X := TopCat.of M) (A ∪ B)ᶜ) i,
      relativeHomologyMap ℚ i
          (supportInclusionPairMap (TopCat.of M) (show A ⊆ A ∪ B from Set.subset_union_left)) c =
        a ∧
      relativeHomologyMap ℚ i
          (supportInclusionPairMap (TopCat.of M) (show B ⊆ A ∪ B from Set.subset_union_right)) c =
        b :=
  j5c_relativeMayerVietoris_exact_middle_aux A B i a b hab

example {M : Type} [TopologicalSpace M] (A B : Set M) (i : ℕ)
    (a : RelativeHomology ℚ (TopPair.ofSubset (X := TopCat.of M) Aᶜ) i)
    (b : RelativeHomology ℚ (TopPair.ofSubset (X := TopCat.of M) Bᶜ) i)
    (hab : (HomologicalComplex.homologyMap (relativeSumLeftProjection M A B) i).hom a =
      (HomologicalComplex.homologyMap (relativeSumRightProjection M A B) i).hom b) :
    ∃ c : RelativeHomology ℚ (TopPair.ofSubset (X := TopCat.of M) (A ∪ B)ᶜ) i,
      relativeHomologyMap ℚ i
          (supportInclusionPairMap (TopCat.of M) (show A ⊆ A ∪ B from Set.subset_union_left)) c =
        a ∧
      relativeHomologyMap ℚ i
          (supportInclusionPairMap (TopCat.of M) (show B ⊆ A ∪ B from Set.subset_union_right)) c =
        b :=
  j5c_relativeMayerVietoris_exact_middle A B i a b hab

/-- **Exactness at the left, chain-model form.** If `H_{i+1}(C(M)/(C(M \ A) + C(M \ B)))`
vanishes, a class on `A ∪ B` that restricts to zero on `A` and on `B` is zero.
Source: Hatcher, *Algebraic Topology*, §2.2, p. 152: the long exact homology sequence of
`j5c_relativeMayerVietorisShortComplex_shortExact`, exact at the first term. -/
theorem j5c_relativeMayerVietoris_exact_left {M : Type} [TopologicalSpace M] (A B : Set M) (i : ℕ)
    (hvan : Subsingleton ((RelativeSumChainComplex M A B).homology (i + 1)))
    (c : RelativeHomology ℚ (TopPair.ofSubset (X := TopCat.of M) (A ∪ B)ᶜ) i)
    (hcA : relativeHomologyMap ℚ i
      (supportInclusionPairMap (TopCat.of M) (show A ⊆ A ∪ B from Set.subset_union_left)) c = 0)
    (hcB : relativeHomologyMap ℚ i
      (supportInclusionPairMap (TopCat.of M) (show B ⊆ A ∪ B from Set.subset_union_right)) c = 0) :
    c = 0 :=
  j5c_relativeMayerVietoris_exact_left_aux A B i hvan c hcA hcB

example {M : Type} [TopologicalSpace M] (A B : Set M) (i : ℕ)
    (hvan : Subsingleton ((RelativeSumChainComplex M A B).homology (i + 1)))
    (c : RelativeHomology ℚ (TopPair.ofSubset (X := TopCat.of M) (A ∪ B)ᶜ) i)
    (hcA : relativeHomologyMap ℚ i
      (supportInclusionPairMap (TopCat.of M) (show A ⊆ A ∪ B from Set.subset_union_left)) c = 0)
    (hcB : relativeHomologyMap ℚ i
      (supportInclusionPairMap (TopCat.of M) (show B ⊆ A ∪ B from Set.subset_union_right)) c = 0) :
    c = 0 :=
  j5c_relativeMayerVietoris_exact_left A B i hvan c hcA hcB

/-- **Relative Mayer–Vietoris, exactness at the middle.** For closed `A`, `B`, classes in
`H_i(M, M \ A)` and `H_i(M, M \ B)` that agree in `H_i(M, M \ (A ∩ B))` come from one class in
`H_i(M, M \ (A ∪ B))`.
Source: Hatcher, *Algebraic Topology*, §2.2, relative Mayer–Vietoris sequence (p. 152), for the
open sets `M \ A`, `M \ B`; used in the proof of Lemma 3.27, step (2). -/
theorem j5c_relativeMayerVietoris_glue {M : Type} [TopologicalSpace M] {A B : Set M}
    (hA : IsClosed A) (hB : IsClosed B) (i : ℕ)
    (a : RelativeHomology ℚ (TopPair.ofSubset (X := TopCat.of M) Aᶜ) i)
    (b : RelativeHomology ℚ (TopPair.ofSubset (X := TopCat.of M) Bᶜ) i)
    (hab : relativeHomologyMap ℚ i
        (supportInclusionPairMap (TopCat.of M) (show A ∩ B ⊆ A from Set.inter_subset_left)) a =
      relativeHomologyMap ℚ i
        (supportInclusionPairMap (TopCat.of M) (show A ∩ B ⊆ B from Set.inter_subset_right)) b) :
    ∃ c : RelativeHomology ℚ (TopPair.ofSubset (X := TopCat.of M) (A ∪ B)ᶜ) i,
      relativeHomologyMap ℚ i
          (supportInclusionPairMap (TopCat.of M) (show A ⊆ A ∪ B from Set.subset_union_left)) c =
        a ∧
      relativeHomologyMap ℚ i
          (supportInclusionPairMap (TopCat.of M) (show B ⊆ A ∪ B from Set.subset_union_right)) c =
        b :=
  j5c_relativeMayerVietoris_glue_aux hA hB i a b hab

example {M : Type} [TopologicalSpace M] {A B : Set M}
    (hA : IsClosed A) (hB : IsClosed B) (i : ℕ)
    (a : RelativeHomology ℚ (TopPair.ofSubset (X := TopCat.of M) Aᶜ) i)
    (b : RelativeHomology ℚ (TopPair.ofSubset (X := TopCat.of M) Bᶜ) i)
    (hab : relativeHomologyMap ℚ i
        (supportInclusionPairMap (TopCat.of M) (show A ∩ B ⊆ A from Set.inter_subset_left)) a =
      relativeHomologyMap ℚ i
        (supportInclusionPairMap (TopCat.of M) (show A ∩ B ⊆ B from Set.inter_subset_right)) b) :
    ∃ c : RelativeHomology ℚ (TopPair.ofSubset (X := TopCat.of M) (A ∪ B)ᶜ) i,
      relativeHomologyMap ℚ i
          (supportInclusionPairMap (TopCat.of M) (show A ⊆ A ∪ B from Set.subset_union_left)) c =
        a ∧
      relativeHomologyMap ℚ i
          (supportInclusionPairMap (TopCat.of M) (show B ⊆ A ∪ B from Set.subset_union_right)) c =
        b :=
  j5c_relativeMayerVietoris_glue hA hB i a b hab

/-- **Relative Mayer–Vietoris, exactness at the left.** For closed `A`, `B`, if
`H_{i+1}(M, M \ (A ∩ B))` vanishes, a class in `H_i(M, M \ (A ∪ B))` that restricts to zero
along `A` and along `B` is zero.
Source: Hatcher, *Algebraic Topology*, §2.2, relative Mayer–Vietoris sequence (p. 152); Lemma
3.27, step (2). -/
theorem j5c_relativeMayerVietoris_injective {M : Type} [TopologicalSpace M] {A B : Set M}
    (hA : IsClosed A) (hB : IsClosed B) (i : ℕ)
    (hvan : Subsingleton
      (RelativeHomology ℚ (TopPair.ofSubset (X := TopCat.of M) (A ∩ B)ᶜ) (i + 1)))
    (c : RelativeHomology ℚ (TopPair.ofSubset (X := TopCat.of M) (A ∪ B)ᶜ) i)
    (hcA : relativeHomologyMap ℚ i
      (supportInclusionPairMap (TopCat.of M) (show A ⊆ A ∪ B from Set.subset_union_left)) c = 0)
    (hcB : relativeHomologyMap ℚ i
      (supportInclusionPairMap (TopCat.of M) (show B ⊆ A ∪ B from Set.subset_union_right)) c = 0) :
    c = 0 :=
  j5c_relativeMayerVietoris_injective_aux hA hB i hvan c hcA hcB

example {M : Type} [TopologicalSpace M] {A B : Set M}
    (hA : IsClosed A) (hB : IsClosed B) (i : ℕ)
    (hvan : Subsingleton
      (RelativeHomology ℚ (TopPair.ofSubset (X := TopCat.of M) (A ∩ B)ᶜ) (i + 1)))
    (c : RelativeHomology ℚ (TopPair.ofSubset (X := TopCat.of M) (A ∪ B)ᶜ) i)
    (hcA : relativeHomologyMap ℚ i
      (supportInclusionPairMap (TopCat.of M) (show A ⊆ A ∪ B from Set.subset_union_left)) c = 0)
    (hcB : relativeHomologyMap ℚ i
      (supportInclusionPairMap (TopCat.of M) (show B ⊆ A ∪ B from Set.subset_union_right)) c = 0) :
    c = 0 :=
  j5c_relativeMayerVietoris_injective hA hB i hvan c hcA hcB

/-- **The Mayer–Vietoris step for vanishing and point detection.** If local homology vanishes above
`n` along `A`, `B` and `A ∩ B`, and point restrictions detect degree `n` along `A` and `B`, the
same holds along `A ∪ B`.
Source: Hatcher, *Algebraic Topology*, Lemma 3.27, proof step (2). -/
theorem j5c_union {M : Type} [TopologicalSpace M] (n : ℕ) {A B : Set M}
    (hA : IsClosed A) (hB : IsClosed B)
    (hvA : LocalHomologyVanishesAbove M n A) (hvB : LocalHomologyVanishesAbove M n B)
    (hvAB : LocalHomologyVanishesAbove M n (A ∩ B))
    (hdA : LocalHomologyDetectedByPoints M n A) (hdB : LocalHomologyDetectedByPoints M n B) :
    LocalHomologyVanishesAbove M n (A ∪ B) ∧ LocalHomologyDetectedByPoints M n (A ∪ B) :=
  j5c_union_aux n hA hB hvA hvB hvAB hdA hdB

example {M : Type} [TopologicalSpace M] (n : ℕ) {A B : Set M}
    (hA : IsClosed A) (hB : IsClosed B)
    (hvA : LocalHomologyVanishesAbove M n A) (hvB : LocalHomologyVanishesAbove M n B)
    (hvAB : LocalHomologyVanishesAbove M n (A ∩ B))
    (hdA : LocalHomologyDetectedByPoints M n A) (hdB : LocalHomologyDetectedByPoints M n B) :
    LocalHomologyVanishesAbove M n (A ∪ B) ∧ LocalHomologyDetectedByPoints M n (A ∪ B) :=
  j5c_union n hA hB hvA hvB hvAB hdA hdB

/-- **The Mayer–Vietoris step for existence.** If classes with point values `μ` exist along
`A` and along `B`, and point restrictions detect degree `n` along `A ∩ B`, such a class exists
along `A ∪ B`.
Source: Hatcher, *Algebraic Topology*, Lemma 3.27, proof step (2). -/
theorem j5c_union_hasClassAlong {M : Type} [TopologicalSpace M] (n : ℕ) {A B : Set M}
    (hA : IsClosed A) (hB : IsClosed B)
    (μ : ∀ x : M, RelativeHomology ℚ (pointComplementPair x) n)
    (hμA : HasClassAlong M n μ A) (hμB : HasClassAlong M n μ B)
    (hdAB : LocalHomologyDetectedByPoints M n (A ∩ B)) :
    HasClassAlong M n μ (A ∪ B) :=
  j5c_union_hasClassAlong_aux n hA hB μ hμA hμB hdAB

example {M : Type} [TopologicalSpace M] (n : ℕ) {A B : Set M}
    (hA : IsClosed A) (hB : IsClosed B)
    (μ : ∀ x : M, RelativeHomology ℚ (pointComplementPair x) n)
    (hμA : HasClassAlong M n μ A) (hμB : HasClassAlong M n μ B)
    (hdAB : LocalHomologyDetectedByPoints M n (A ∩ B)) :
    HasClassAlong M n μ (A ∪ B) :=
  j5c_union_hasClassAlong n hA hB μ hμA hμB hdAB

/-- **Restriction from a convex compact set to one of its points.** In a finite-dimensional real
normed space `E`, for a compact convex `K` and `x ∈ K`, the restriction
`H_i(E, E \ K; ℚ) → H_i(E, E \ x; ℚ)` is bijective in every degree.
Source: Hatcher, *Algebraic Topology*, Lemma 3.27, proof step (1): `E \ K` and `E \ x` both
deformation retract onto a large sphere centred at `x`, and the five lemma. -/
theorem j5c_convex_restrict_bijective {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [FiniteDimensional ℝ E] {K : Set E} (hK : Convex ℝ K) (hKc : IsCompact K) {x : E}
    (hx : x ∈ K) (i : ℕ) :
    Function.Bijective (relativeHomologyMap ℚ i
      (supportInclusionPairMap (TopCat.of E) (Set.singleton_subset_iff.mpr hx))) :=
  j5c_convex_restrict_bijective_aux hK hKc hx i

example {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [FiniteDimensional ℝ E] {K : Set E} (hK : Convex ℝ K) (hKc : IsCompact K) {x : E}
    (hx : x ∈ K) (i : ℕ) :
    Function.Bijective (relativeHomologyMap ℚ i
      (supportInclusionPairMap (TopCat.of E) (Set.singleton_subset_iff.mpr hx))) :=
  j5c_convex_restrict_bijective hK hKc hx i

/-- **The convex case.** In a real vector space `E` of dimension `n`, local homology along a
compact convex set vanishes above `n`, and point restrictions detect degree `n`.
Source: Hatcher, *Algebraic Topology*, Lemma 3.27, proof step (1): `E \ K` deformation retracts
onto a large sphere around any point of `K`, so `H_i(E, E \ K) → H_i(E, E \ x)` is an
isomorphism; `H_i(ℝⁿ, ℝⁿ \ 0) ≅ H̃_{i-1}(S^{n-1})` is Hatcher, Corollary 2.14 and §3.3, p. 231. -/
theorem j5c_convex {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [FiniteDimensional ℝ E] {n : ℕ} (hn : Module.finrank ℝ E = n) {K : Set E}
    (hK : Convex ℝ K) (hKc : IsCompact K) :
    LocalHomologyVanishesAbove E n K ∧ LocalHomologyDetectedByPoints E n K :=
  j5c_convex_aux hn hK hKc

example {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [FiniteDimensional ℝ E] {n : ℕ} (hn : Module.finrank ℝ E = n) {K : Set E}
    (hK : Convex ℝ K) (hKc : IsCompact K) :
    LocalHomologyVanishesAbove E n K ∧ LocalHomologyDetectedByPoints E n K :=
  j5c_convex hn hK hKc

/-- **Finite unions of convex compacts.** The conclusion of `j5c_convex` holds along any finite
union of compact convex subsets of `E`.
Source: Hatcher, *Algebraic Topology*, Lemma 3.27, proof step (3). -/
theorem j5c_iUnion_convex {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [FiniteDimensional ℝ E] {n : ℕ} (hn : Module.finrank ℝ E = n) {m : ℕ} (K : Fin m → Set E)
    (hK : ∀ j, Convex ℝ (K j)) (hKc : ∀ j, IsCompact (K j)) :
    LocalHomologyVanishesAbove E n (⋃ j, K j) ∧
      LocalHomologyDetectedByPoints E n (⋃ j, K j) :=
  j5c_iUnion_convex_aux hn K hK hKc

example {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [FiniteDimensional ℝ E] {n : ℕ} (hn : Module.finrank ℝ E = n) {m : ℕ} (K : Fin m → Set E)
    (hK : ∀ j, Convex ℝ (K j)) (hKc : ∀ j, IsCompact (K j)) :
    LocalHomologyVanishesAbove E n (⋃ j, K j) ∧
      LocalHomologyDetectedByPoints E n (⋃ j, K j) :=
  j5c_iUnion_convex hn K hK hKc

/-- **Classes have compact support.** In a Hausdorff space, every class in `H_i(M, M \ A)` lifts
to `H_i(M, M \ K)` for every `K` between `A` and some open `W ⊇ A`. Take `W` the complement of
the compact image of the boundary of a representing chain.
Source: Hatcher, *Algebraic Topology*, Lemma 3.27, proof step (4). -/
theorem j5c_exists_open_lift {M : Type} [TopologicalSpace M] [T2Space M] (A : Set M)
    (i : ℕ) (α : RelativeHomology ℚ (TopPair.ofSubset (X := TopCat.of M) Aᶜ) i) :
    ∃ W : Set M, IsOpen W ∧ A ⊆ W ∧ ∀ (K : Set M) (hAK : A ⊆ K), K ⊆ W →
      ∃ α' : RelativeHomology ℚ (TopPair.ofSubset (X := TopCat.of M) Kᶜ) i,
        relativeHomologyMap ℚ i (supportInclusionPairMap (TopCat.of M) hAK) α' = α :=
  j5c_exists_open_lift_aux A i α

example {M : Type} [TopologicalSpace M] [T2Space M] (A : Set M)
    (i : ℕ) (α : RelativeHomology ℚ (TopPair.ofSubset (X := TopCat.of M) Aᶜ) i) :
    ∃ W : Set M, IsOpen W ∧ A ⊆ W ∧ ∀ (K : Set M) (hAK : A ⊆ K), K ⊆ W →
      ∃ α' : RelativeHomology ℚ (TopPair.ofSubset (X := TopCat.of M) Kᶜ) i,
        relativeHomologyMap ℚ i (supportInclusionPairMap (TopCat.of M) hAK) α' = α :=
  j5c_exists_open_lift A i α

/-- **Compact sets in Euclidean space.** In `E` of dimension `n`, local homology along any
compact set vanishes above `n`, and point restrictions detect degree `n`.
Source: Hatcher, *Algebraic Topology*, Lemma 3.27, proof step (4). -/
theorem j5c_compact_euclidean {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [FiniteDimensional ℝ E] {n : ℕ} (hn : Module.finrank ℝ E = n) {A : Set E}
    (hA : IsCompact A) :
    LocalHomologyVanishesAbove E n A ∧ LocalHomologyDetectedByPoints E n A :=
  j5c_compact_euclidean_aux hn hA

example {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [FiniteDimensional ℝ E] {n : ℕ} (hn : Module.finrank ℝ E = n) {A : Set E}
    (hA : IsCompact A) :
    LocalHomologyVanishesAbove E n A ∧ LocalHomologyDetectedByPoints E n A :=
  j5c_compact_euclidean hn hA

/-- **Closed-set excision on chains.** For `A` closed and `U` open with `A ⊆ U`, the inclusion of
relative chain complexes `C(U)/C(U \ A) → C(M)/C(M \ A)` is a quasi-isomorphism.
Source: Hatcher, *Algebraic Topology*, Theorem 2.20 (excision of the closed set `M \ U`); the
proof of upstream's `neighborhoodPointComplement_relativeChainMap_quasiIso`
(`Singular/RelativePairExcision.lean`), with the cover `{U, M \ A}` in place of `{U, M \ x}`. -/
theorem j5c_excision_relativeChainMap_quasiIso {M : Type} [TopologicalSpace M] {U A : Set M} (hU : IsOpen U)
    (hA : IsClosed A) (hAU : A ⊆ U) :
    QuasiIso ((relativeChainFunctor ℚ).map
      (TopPair.ofSubsetHom (A := {u : U | u.1 ∉ A}) (B := Aᶜ)
        (TopCat.ofHom ⟨Subtype.val, continuous_subtype_val⟩ : TopCat.of U ⟶ TopCat.of M)
        (fun _ ha => ha))) :=
  j5c_excision_relativeChainMap_quasiIso_aux hU hA hAU

example {M : Type} [TopologicalSpace M] {U A : Set M} (hU : IsOpen U)
    (hA : IsClosed A) (hAU : A ⊆ U) :
    QuasiIso ((relativeChainFunctor ℚ).map
      (TopPair.ofSubsetHom (A := {u : U | u.1 ∉ A}) (B := Aᶜ)
        (TopCat.ofHom ⟨Subtype.val, continuous_subtype_val⟩ : TopCat.of U ⟶ TopCat.of M)
        (fun _ ha => ha))) :=
  j5c_excision_relativeChainMap_quasiIso hU hA hAU

/-- **Excision to an open neighbourhood.** For `A` closed and `U` open with `A ⊆ U`, the inclusion
`(U, U \ A) → (M, M \ A)` is an isomorphism on rational singular homology.
Source: Hatcher, *Algebraic Topology*, Theorem 2.20 (excision of the closed set `M \ U`). -/
theorem j5c_excision {M : Type} [TopologicalSpace M] {U A : Set M} (hU : IsOpen U)
    (hA : IsClosed A) (hAU : A ⊆ U) (i : ℕ) :
    Function.Bijective (relativeHomologyMap ℚ i
      (TopPair.ofSubsetHom (A := {u : U | u.1 ∉ A}) (B := Aᶜ)
        (TopCat.ofHom ⟨Subtype.val, continuous_subtype_val⟩ : TopCat.of U ⟶ TopCat.of M)
        (fun _ ha => ha))) :=
  j5c_excision_aux hU hA hAU i

example {M : Type} [TopologicalSpace M] {U A : Set M} (hU : IsOpen U)
    (hA : IsClosed A) (hAU : A ⊆ U) (i : ℕ) :
    Function.Bijective (relativeHomologyMap ℚ i
      (TopPair.ofSubsetHom (A := {u : U | u.1 ∉ A}) (B := Aᶜ)
        (TopCat.ofHom ⟨Subtype.val, continuous_subtype_val⟩ : TopCat.of U ⟶ TopCat.of M)
        (fun _ ha => ha))) :=
  j5c_excision hU hA hAU i

/-- **Compact sets in one chart.** In a Hausdorff space, local homology along a compact set
inside the source of a chart to `E` vanishes above `n = dim E`, and point restrictions detect
degree `n`.
Source: Hatcher, *Algebraic Topology*, Lemma 3.27, proof step (5), first half. -/
theorem j5c_chart {M E : Type} [TopologicalSpace M] [T2Space M] [NormedAddCommGroup E]
    [NormedSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ} (hn : Module.finrank ℝ E = n)
    (e : OpenPartialHomeomorph M E) {A : Set M} (hA : IsCompact A) (hAe : A ⊆ e.source) :
    LocalHomologyVanishesAbove M n A ∧ LocalHomologyDetectedByPoints M n A :=
  j5c_chart_aux hn e hA hAe

example {M E : Type} [TopologicalSpace M] [T2Space M] [NormedAddCommGroup E]
    [NormedSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ} (hn : Module.finrank ℝ E = n)
    (e : OpenPartialHomeomorph M E) {A : Set M} (hA : IsCompact A) (hAe : A ⊆ e.source) :
    LocalHomologyVanishesAbove M n A ∧ LocalHomologyDetectedByPoints M n A :=
  j5c_chart hn e hA hAe

/-- **Finite unions of chart compacts.** The conclusion of `j5c_chart` holds along a finite union
of compact sets, each inside the source of some chart of the charted space `M`.
Source: Hatcher, *Algebraic Topology*, Lemma 3.27, proof step (5). -/
theorem j5c_iUnion_chart {M E : Type} [TopologicalSpace M] [T2Space M]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E] [ChartedSpace E M]
    {n : ℕ} (hn : Module.finrank ℝ E = n) {m : ℕ} (A : Fin m → Set M)
    (hA : ∀ j, IsCompact (A j)) (hchart : ∀ j, ∃ x : M, A j ⊆ (chartAt E x).source) :
    LocalHomologyVanishesAbove M n (⋃ j, A j) ∧
      LocalHomologyDetectedByPoints M n (⋃ j, A j) :=
  j5c_iUnion_chart_aux hn A hA hchart

example {M E : Type} [TopologicalSpace M] [T2Space M]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E] [ChartedSpace E M]
    {n : ℕ} (hn : Module.finrank ℝ E = n) {m : ℕ} (A : Fin m → Set M)
    (hA : ∀ j, IsCompact (A j)) (hchart : ∀ j, ∃ x : M, A j ⊆ (chartAt E x).source) :
    LocalHomologyVanishesAbove M n (⋃ j, A j) ∧
      LocalHomologyDetectedByPoints M n (⋃ j, A j) :=
  j5c_iUnion_chart hn A hA hchart

/-- **Lemma 3.27 (b) and the uniqueness in (a).** On a Hausdorff space with charts to `E`
(`dim E = n`), local homology along any compact set vanishes above `n`, and point restrictions
detect degree `n`.
Source: Hatcher, *Algebraic Topology*, Lemma 3.27. -/
theorem j5c_compact_manifold {M E : Type} [TopologicalSpace M] [T2Space M]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E] [ChartedSpace E M]
    {n : ℕ} (hn : Module.finrank ℝ E = n) {A : Set M} (hA : IsCompact A) :
    LocalHomologyVanishesAbove M n A ∧ LocalHomologyDetectedByPoints M n A :=
  j5c_compact_manifold_aux hn hA

example {M E : Type} [TopologicalSpace M] [T2Space M]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E] [ChartedSpace E M]
    {n : ℕ} (hn : Module.finrank ℝ E = n) {A : Set M} (hA : IsCompact A) :
    LocalHomologyVanishesAbove M n A ∧ LocalHomologyDetectedByPoints M n A :=
  j5c_compact_manifold hn hA

/-- **The existence in Lemma 3.27 (a).** On a Hausdorff space with charts to `E`, a family of
local classes `μ` that is locally the restriction of one class has, along every compact set, a
class with point values `μ`.
Source: Hatcher, *Algebraic Topology*, Lemma 3.27(a). -/
theorem j5c_hasClassAlong_of_isCompact {M E : Type} [TopologicalSpace M] [T2Space M]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E] [ChartedSpace E M]
    {n : ℕ} (hn : Module.finrank ℝ E = n)
    (μ : ∀ x : M, RelativeHomology ℚ (pointComplementPair x) n)
    (hμ : ∀ x : M, ∃ U : Opens M, x ∈ U ∧
      ∃ c : RelativeHomology ℚ (TopPair.ofSubset (X := TopCat.of M) (U : Set M)ᶜ) n,
        ∀ (y : M) (hy : y ∈ U),
          relativeHomologyMap ℚ n
            (supportInclusionPairMap (TopCat.of M) (Set.singleton_subset_iff.mpr hy)) c = μ y)
    {A : Set M} (hA : IsCompact A) :
    HasClassAlong M n μ A :=
  j5c_hasClassAlong_of_isCompact_aux hn μ hμ hA

example {M E : Type} [TopologicalSpace M] [T2Space M]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E] [ChartedSpace E M]
    {n : ℕ} (hn : Module.finrank ℝ E = n)
    (μ : ∀ x : M, RelativeHomology ℚ (pointComplementPair x) n)
    (hμ : ∀ x : M, ∃ U : Opens M, x ∈ U ∧
      ∃ c : RelativeHomology ℚ (TopPair.ofSubset (X := TopCat.of M) (U : Set M)ᶜ) n,
        ∀ (y : M) (hy : y ∈ U),
          relativeHomologyMap ℚ n
            (supportInclusionPairMap (TopCat.of M) (Set.singleton_subset_iff.mpr hy)) c = μ y)
    {A : Set M} (hA : IsCompact A) :
    HasClassAlong M n μ A :=
  j5c_hasClassAlong_of_isCompact hn μ hμ hA

/-- **Fundamental class of a compact manifold.** On a compact Hausdorff space with charts to `E`
(`dim E = n`), a locally coherent family of local classes `μ` is the family of point values of
one class in `H_n(M; ℚ)`, written as `H_n(M, M \ M; ℚ)`.
Source: Hatcher, *Algebraic Topology*, Theorem 3.26(a) and Lemma 3.27. -/
theorem j5c_exists_fundamentalClass {M E : Type} [TopologicalSpace M] [T2Space M]
    [CompactSpace M] [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
    [ChartedSpace E M] {n : ℕ} (hn : Module.finrank ℝ E = n)
    (μ : ∀ x : M, RelativeHomology ℚ (pointComplementPair x) n)
    (hμ : ∀ x : M, ∃ U : Opens M, x ∈ U ∧
      ∃ c : RelativeHomology ℚ (TopPair.ofSubset (X := TopCat.of M) (U : Set M)ᶜ) n,
        ∀ (y : M) (hy : y ∈ U),
          relativeHomologyMap ℚ n
            (supportInclusionPairMap (TopCat.of M) (Set.singleton_subset_iff.mpr hy)) c = μ y) :
    ∃ w : RelativeHomology ℚ (TopPair.ofSubset
        (((⊤ : Opens M) : Set M)ᶜ : Set (TopCat.of M))) n,
      ∀ y : M,
        relativeHomologyMap ℚ n
            (supportInclusionPairMap (TopCat.of M)
              (Set.singleton_subset_iff.mpr (Opens.mem_top y))) w = μ y :=
  j5c_exists_fundamentalClass_aux hn μ hμ

example {M E : Type} [TopologicalSpace M] [T2Space M]
    [CompactSpace M] [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
    [ChartedSpace E M] {n : ℕ} (hn : Module.finrank ℝ E = n)
    (μ : ∀ x : M, RelativeHomology ℚ (pointComplementPair x) n)
    (hμ : ∀ x : M, ∃ U : Opens M, x ∈ U ∧
      ∃ c : RelativeHomology ℚ (TopPair.ofSubset (X := TopCat.of M) (U : Set M)ᶜ) n,
        ∀ (y : M) (hy : y ∈ U),
          relativeHomologyMap ℚ n
            (supportInclusionPairMap (TopCat.of M) (Set.singleton_subset_iff.mpr hy)) c = μ y) :
    ∃ w : RelativeHomology ℚ (TopPair.ofSubset
        (((⊤ : Opens M) : Set M)ᶜ : Set (TopCat.of M))) n,
      ∀ y : M,
        relativeHomologyMap ℚ n
            (supportInclusionPairMap (TopCat.of M)
              (Set.singleton_subset_iff.mpr (Opens.mem_top y))) w = μ y :=
  j5c_exists_fundamentalClass hn μ hμ

/-- **Fundamental class of `X(ℂ)`.** A smooth projective complex variety of dimension `d` has a
class in `H_{2d}(X(ℂ); ℚ)` whose local value at every complex point is upstream's complex
orientation. The type is exactly that of the open input `exists_complexFundamentalClass_aux` in
`Foundations/Curves/CurveCycleClassProofs.lean`.
Source: Hatcher, *Algebraic Topology*, Theorem 3.26 and Lemma 3.27; Griffiths–Harris,
*Principles of Algebraic Geometry*, Ch. 0 §4 (complex manifolds are canonically oriented). -/
theorem j5c_exists_complexFundamentalClass (X : Over (Spec ↧ℂ)) [IsIntegral X.left]
    [Smooth X.hom] [IsProjective X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom] :
    ∃ w : RelativeHomology ℚ (TopPair.ofSubset
        (((⊤ : Opens (ComplexPoint X)) : Set (ComplexPoint X))ᶜ :
          Set (TopCat.of (ComplexPoint X)))) (2 * d),
      ∀ y : ComplexPoint X,
        relativeHomologyMap ℚ (2 * d)
            (supportInclusionPairMap (TopCat.of (ComplexPoint X))
              (Set.singleton_subset_iff.mpr (Opens.mem_top y))) w =
          complexLocalOrientation X d y :=
  j5c_exists_complexFundamentalClass_aux X d

example (X : Over (Spec ↧ℂ)) [IsIntegral X.left]
    [Smooth X.hom] [IsProjective X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom] :
    ∃ w : RelativeHomology ℚ (TopPair.ofSubset
        (((⊤ : Opens (ComplexPoint X)) : Set (ComplexPoint X))ᶜ :
          Set (TopCat.of (ComplexPoint X)))) (2 * d),
      ∀ y : ComplexPoint X,
        relativeHomologyMap ℚ (2 * d)
            (supportInclusionPairMap (TopCat.of (ComplexPoint X))
              (Set.singleton_subset_iff.mpr (Opens.mem_top y))) w =
          complexLocalOrientation X d y :=
  j5c_exists_complexFundamentalClass X d

/-- **Falsification check: compactness is needed.** On `E` with `dim E = n ≥ 1`, no class in
`H_n(E; ℚ)` has a nonzero point value, because `H_n(E; ℚ) = 0`. So `j5c_exists_fundamentalClass`
fails without `CompactSpace`, for example for `E = ℂ` and the standard local class.
Source: Hatcher, *Algebraic Topology*, Theorem 3.26(b) and Corollary 2.11 (contractible spaces). -/
theorem j5c_not_exists_fundamentalClass_euclidean {E : Type} [NormedAddCommGroup E]
    [NormedSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ} (hn : Module.finrank ℝ E = n)
    (hpos : 0 < n) (μ : ∀ x : E, RelativeHomology ℚ (pointComplementPair x) n)
    (hμ : ∃ x : E, μ x ≠ 0) :
    ¬ ∃ w : RelativeHomology ℚ (TopPair.ofSubset
        (((⊤ : Opens E) : Set E)ᶜ : Set (TopCat.of E))) n,
      ∀ y : E,
        relativeHomologyMap ℚ n
            (supportInclusionPairMap (TopCat.of E)
              (Set.singleton_subset_iff.mpr (Opens.mem_top y))) w = μ y :=
  j5c_not_exists_fundamentalClass_euclidean_aux hn hpos μ hμ

example {E : Type} [NormedAddCommGroup E]
    [NormedSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ} (hn : Module.finrank ℝ E = n)
    (hpos : 0 < n) (μ : ∀ x : E, RelativeHomology ℚ (pointComplementPair x) n)
    (hμ : ∃ x : E, μ x ≠ 0) :
    ¬ ∃ w : RelativeHomology ℚ (TopPair.ofSubset
        (((⊤ : Opens E) : Set E)ᶜ : Set (TopCat.of E))) n,
      ∀ y : E,
        relativeHomologyMap ℚ n
            (supportInclusionPairMap (TopCat.of E)
              (Set.singleton_subset_iff.mpr (Opens.mem_top y))) w = μ y :=
  j5c_not_exists_fundamentalClass_euclidean hn hpos μ hμ

/-- **The translated local classes are nonzero.** For every `d` and every point `v` of
`Fin d → ℂ`, the translate of `standardComplexLocalClass` to `v` is nonzero.
Source: upstream's `standardComplexLocalClass_ne_zero`; translation by `v` is a homeomorphism of
pairs `(E, E \ 0) ≅ (E, E \ v)`, so it is injective on homology. -/
theorem j5c_translatedStandardComplexLocalClass_ne_zero (d : ℕ) (v : Fin d → ℂ) :
    translatedStandardComplexLocalClass d v ≠ 0 :=
  j5c_translatedStandardComplexLocalClass_ne_zero_aux d v

example (d : ℕ) (v : Fin d → ℂ) :
    translatedStandardComplexLocalClass d v ≠ 0 :=
  j5c_translatedStandardComplexLocalClass_ne_zero d v

/-- **The translated local classes are locally coherent,** in exactly the form of the hypothesis
`hμ` of `j5c_hasClassAlong_of_isCompact` and `j5c_exists_fundamentalClass`: each point has an
open neighbourhood `U` and a class in `H_{2d}(E, E \ U; ℚ)` whose value at every `y ∈ U` is the
translated class at `y`.
Source: Hatcher, *Algebraic Topology*, §3.3, p. 234 (the local orientation of `ℝⁿ` is locally
constant along translations); the ported `standardOrientationBallClass_restrict`
(`LocalHomology/EuclideanNeighborhoodOrientation.lean`), transported by the linear
homeomorphism `complexRealHomeomorph d`. -/
theorem j5c_translatedStandardComplexLocalClass_locallyCoherent (d : ℕ) :
    ∀ x : Fin d → ℂ, ∃ U : Opens (Fin d → ℂ), x ∈ U ∧
      ∃ c : RelativeHomology ℚ
          (TopPair.ofSubset (X := TopCat.of (Fin d → ℂ)) (U : Set (Fin d → ℂ))ᶜ) (2 * d),
        ∀ (y : Fin d → ℂ) (hy : y ∈ U),
          relativeHomologyMap ℚ (2 * d)
            (supportInclusionPairMap (TopCat.of (Fin d → ℂ)) (Set.singleton_subset_iff.mpr hy)) c =
              translatedStandardComplexLocalClass d y :=
  j5c_translatedStandardComplexLocalClass_locallyCoherent_aux d

example (d : ℕ) :
    ∀ x : Fin d → ℂ, ∃ U : Opens (Fin d → ℂ), x ∈ U ∧
      ∃ c : RelativeHomology ℚ
          (TopPair.ofSubset (X := TopCat.of (Fin d → ℂ)) (U : Set (Fin d → ℂ))ᶜ) (2 * d),
        ∀ (y : Fin d → ℂ) (hy : y ∈ U),
          relativeHomologyMap ℚ (2 * d)
            (supportInclusionPairMap (TopCat.of (Fin d → ℂ)) (Set.singleton_subset_iff.mpr hy)) c =
              translatedStandardComplexLocalClass d y :=
  j5c_translatedStandardComplexLocalClass_locallyCoherent d

/-- **Falsification check: compactness is needed in `j5c_exists_fundamentalClass`.** On
`E = Fin d → ℂ` with `d ≥ 1` (the model of `j5c_exists_complexFundamentalClass`, `n = 2 * d`),
some family of local classes is locally coherent in the form `hμ`, is nonzero at every point,
and is not the family of point values of any class in `H_n(E, ∅; ℚ)`. The family is
`translatedStandardComplexLocalClass d`.
Source: Hatcher, *Algebraic Topology*, Theorem 3.26 and Corollary 2.11 (`E` is contractible,
so `H_n(E; ℚ) = 0` for `n ≥ 1`). -/
theorem j5c_exists_locallyCoherent_not_fundamentalClass (d : ℕ) (hd : 0 < d) :
    ∃ μ : ∀ x : Fin d → ℂ, RelativeHomology ℚ (pointComplementPair x) (2 * d),
      (∀ x : Fin d → ℂ, ∃ U : Opens (Fin d → ℂ), x ∈ U ∧
        ∃ c : RelativeHomology ℚ
            (TopPair.ofSubset (X := TopCat.of (Fin d → ℂ)) (U : Set (Fin d → ℂ))ᶜ) (2 * d),
          ∀ (y : Fin d → ℂ) (hy : y ∈ U),
            relativeHomologyMap ℚ (2 * d)
              (supportInclusionPairMap (TopCat.of (Fin d → ℂ))
                (Set.singleton_subset_iff.mpr hy)) c = μ y) ∧
      (∀ x : Fin d → ℂ, μ x ≠ 0) ∧
      ¬ ∃ w : RelativeHomology ℚ (TopPair.ofSubset
          (((⊤ : Opens (Fin d → ℂ)) : Set (Fin d → ℂ))ᶜ : Set (TopCat.of (Fin d → ℂ)))) (2 * d),
        ∀ y : Fin d → ℂ,
          relativeHomologyMap ℚ (2 * d)
              (supportInclusionPairMap (TopCat.of (Fin d → ℂ))
                (Set.singleton_subset_iff.mpr (Opens.mem_top y))) w = μ y :=
  j5c_exists_locallyCoherent_not_fundamentalClass_aux d hd

example (d : ℕ) (hd : 0 < d) :
    ∃ μ : ∀ x : Fin d → ℂ, RelativeHomology ℚ (pointComplementPair x) (2 * d),
      (∀ x : Fin d → ℂ, ∃ U : Opens (Fin d → ℂ), x ∈ U ∧
        ∃ c : RelativeHomology ℚ
            (TopPair.ofSubset (X := TopCat.of (Fin d → ℂ)) (U : Set (Fin d → ℂ))ᶜ) (2 * d),
          ∀ (y : Fin d → ℂ) (hy : y ∈ U),
            relativeHomologyMap ℚ (2 * d)
              (supportInclusionPairMap (TopCat.of (Fin d → ℂ))
                (Set.singleton_subset_iff.mpr hy)) c = μ y) ∧
      (∀ x : Fin d → ℂ, μ x ≠ 0) ∧
      ¬ ∃ w : RelativeHomology ℚ (TopPair.ofSubset
          (((⊤ : Opens (Fin d → ℂ)) : Set (Fin d → ℂ))ᶜ : Set (TopCat.of (Fin d → ℂ)))) (2 * d),
        ∀ y : Fin d → ℂ,
          relativeHomologyMap ℚ (2 * d)
              (supportInclusionPairMap (TopCat.of (Fin d → ℂ))
                (Set.singleton_subset_iff.mpr (Opens.mem_top y))) w = μ y :=
  j5c_exists_locallyCoherent_not_fundamentalClass d hd

/-- The falsification check for `d = 1`: on `Fin 1 → ℂ`, a copy of `ℂ`, the translated local
classes are locally coherent and nonzero, and no class in `H_2(ℂ, ∅; ℚ)` has them as point
values. -/
example : ∃ μ : ∀ x : Fin 1 → ℂ, RelativeHomology ℚ (pointComplementPair x) (2 * 1),
      (∀ x : Fin 1 → ℂ, ∃ U : Opens (Fin 1 → ℂ), x ∈ U ∧
        ∃ c : RelativeHomology ℚ
            (TopPair.ofSubset (X := TopCat.of (Fin 1 → ℂ)) (U : Set (Fin 1 → ℂ))ᶜ) (2 * 1),
          ∀ (y : Fin 1 → ℂ) (hy : y ∈ U),
            relativeHomologyMap ℚ (2 * 1)
              (supportInclusionPairMap (TopCat.of (Fin 1 → ℂ))
                (Set.singleton_subset_iff.mpr hy)) c = μ y) ∧
      (∀ x : Fin 1 → ℂ, μ x ≠ 0) ∧
      ¬ ∃ w : RelativeHomology ℚ (TopPair.ofSubset
          (((⊤ : Opens (Fin 1 → ℂ)) : Set (Fin 1 → ℂ))ᶜ : Set (TopCat.of (Fin 1 → ℂ)))) (2 * 1),
        ∀ y : Fin 1 → ℂ,
          relativeHomologyMap ℚ (2 * 1)
              (supportInclusionPairMap (TopCat.of (Fin 1 → ℂ))
                (Set.singleton_subset_iff.mpr (Opens.mem_top y))) w = μ y :=
  j5c_exists_locallyCoherent_not_fundamentalClass 1 one_pos

end HodgeLean.RealDefs
