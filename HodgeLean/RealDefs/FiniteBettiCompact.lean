import HodgeLean.RealDefs.FiniteBettiCompactProofs

/-! # Finite Betti numbers of compact charted spaces and of `X(ℂ)` (FROZEN SPEC)

The frozen spec for `docs/briefs/cloud-spec-finbetti.md`. Do not edit this file. Each theorem is
proved by the matching `_aux` theorem in `FiniteBettiCompactProofs.lean`. Spec doc:
`docs/specs/FiniteBettiCompact.md`.

Homology is upstream's rational singular `Homology ℚ (TopCat.of Y) i`; a subset `U : Set Y` is the
subspace `TopCat.of ↥U`. `FiniteHomology Y` says every `H_i(Y; ℚ)` is finite-dimensional, and
`FiniteHomologyImage h`, for `V ⊆ U`, says every image of `H_i(V; ℚ) → H_i(U; ℚ)` is
finite-dimensional (`FiniteBettiCompactDefs.lean`).

**Claimed.**
* A convex subset of a real normed space has finite rational homology.
* For open `U`, `V` in any space: the Mayer–Vietoris boundary `H_{n+1}(U ∪ V) → H_n(U ∩ V)` is
  natural for inclusions of pairs of open sets; a class on `U ∪ V` with zero boundary is a sum of
  classes from `U` and `V`; in degree `0` every class is such a sum (for any subsets `U`, `V`); and
  finite homology of `U`, `V` and `U ∩ V` gives finite homology of `U ∪ V`.
* A finite union of open convex sets in a real normed space has finite homology.
* The finite-rank Mayer–Vietoris step: for open `V_k ⊆ W_k ⊆ U_k` (`k = 1, 2`), finite images of
  `H(W_k) → H(U_k)` and of `H(V₁ ∩ V₂) → H(W₁ ∩ W₂)` give a finite image of
  `H(V₁ ∪ V₂) → H(U₁ ∪ U₂)`.
* In a charted space, for open `V`, `U` with `closure V` compact, `closure V ⊆ U` and `U` inside
  one chart source, the image of `H(V) → H(U)` is finite; in a Hausdorff charted space on a
  finite-dimensional model the same holds when `closure V` is covered by finitely many chart
  sources.
* Every compact Hausdorff space charted on a finite-dimensional real normed space has finite
  rational homology; finite homology gives finite singular cohomology (universal coefficients
  over `ℚ`); and **`FiniteBetti X` for every integral smooth projective `X` over `ℂ`**, with
  exactly `FiniteBetti`'s type, unconditionally (no named input).
* Falsification check: an infinite discrete space has infinite-dimensional `H_0`. The example
  after it shows `ℕ` is Hausdorff and charted on `Fin 0 → ℝ`, so the compactness hypothesis of
  `finbetti_finiteHomology_of_compact` cannot be dropped.

**Not claimed.** No finite generation over `ℤ`, no Betti number values (beyond what other specs
compute), no finite good cover, no CW structure, nothing about non-compact manifolds. No named
input is used and no new `@[hodge_hypothesis]` is added. The last main statement proves the named
input `FiniteBetti X` outright for every integral smooth projective `X`; it generalizes the abelian
case `HodgeLean.Adapters.finiteBetti_abelian` and does not restate it.
Relation to the goal: HC no distance; AV milestone no distance.
-/

noncomputable section

open CategoryTheory AlgebraicGeometry AlgebraicGeometry.ComplexPoint TopologicalSpace
open AlgebraicTopology.Singular

namespace HodgeLean.RealDefs

/-- **Convex sets have finite homology.** A convex subset `K` of a real normed space has
finite-dimensional rational homology in every degree (it is empty or contractible, so its homology
is `0` or that of a point).
Source: Hatcher, *Algebraic Topology*, Example 2.8 and Corollary 2.11 (a point has homology `ℚ` in
degree `0` only; homotopy invariance), with the straight-line contraction of a convex set. -/
theorem finbetti_finiteHomology_of_convex {E : Type} [NormedAddCommGroup E]
    [NormedSpace ℝ E] {K : Set E} (hK : Convex ℝ K) :
    FiniteHomology K :=
  finbetti_finiteHomology_of_convex_aux hK

example {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] (c : E) (r : ℝ) :
    FiniteHomology (Metric.ball c r) :=
  finbetti_finiteHomology_of_convex (convex_ball c r)

/-- **Naturality of the Mayer–Vietoris boundary.** For open `V_k ⊆ W_k` (`k = 1, 2`), the boundary
`H_{n+1}(W₁ ∪ W₂) → H_n(W₁ ∩ W₂)` of the image of a class `x` on `V₁ ∪ V₂` is the image of the
boundary of `x`.
Source: Hatcher, *Algebraic Topology*, §2.2, subsection "Mayer–Vietoris Sequences" (the sequence is
the long exact sequence of a short exact sequence of chain complexes) and §2.1 (naturality of the
boundary map of that long exact sequence for a map of short exact sequences). -/
theorem finbetti_subsetMayerVietorisBoundary_naturality {Y : Type} [TopologicalSpace Y]
    {V₁ V₂ W₁ W₂ : Set Y} (hV₁ : IsOpen V₁) (hV₂ : IsOpen V₂) (hW₁ : IsOpen W₁)
    (hW₂ : IsOpen W₂) (h₁ : V₁ ⊆ W₁) (h₂ : V₂ ⊆ W₂) (n : ℕ)
    (x : Homology ℚ (TopCat.of ↥(V₁ ∪ V₂)) (n + 1)) :
    subsetMayerVietorisBoundary hW₁ hW₂ n
        (homologyMap ℚ (n + 1) (subsetInclusionHom (Set.union_subset_union h₁ h₂)) x) =
      homologyMap ℚ n (subsetInclusionHom (Set.inter_subset_inter h₁ h₂))
        (subsetMayerVietorisBoundary hV₁ hV₂ n x) :=
  finbetti_subsetMayerVietorisBoundary_naturality_aux hV₁ hV₂ hW₁ hW₂ h₁ h₂ n x

example {Y : Type} [TopologicalSpace Y] {U V : Set Y} (hU : IsOpen U) (hV : IsOpen V) (n : ℕ)
    (x : Homology ℚ (TopCat.of ↥(U ∪ V)) (n + 1)) :
    subsetMayerVietorisBoundary hU hV n
        (homologyMap ℚ (n + 1) (subsetInclusionHom (Set.union_subset_union
          (subset_refl U) (subset_refl V))) x) =
      homologyMap ℚ n (subsetInclusionHom (Set.inter_subset_inter (subset_refl U)
        (subset_refl V))) (subsetMayerVietorisBoundary hU hV n x) :=
  finbetti_subsetMayerVietorisBoundary_naturality hU hV hU hV (subset_refl U) (subset_refl V) n x

/-- **Mayer–Vietoris exactness at `H_{n+1}(U ∪ V)`.** For open `U`, `V`, a class on `U ∪ V` whose
boundary in `H_n(U ∩ V)` vanishes is the sum of the images of a class on `U` and a class on `V`.
Source: Hatcher, *Algebraic Topology*, §2.2, subsection "Mayer–Vietoris Sequences" (exactness);
upstream `singularMayerVietoris_exact_ambient`. -/
theorem finbetti_subsetMayerVietoris_exact {Y : Type} [TopologicalSpace Y] {U V : Set Y}
    (hU : IsOpen U) (hV : IsOpen V) (n : ℕ) (y : Homology ℚ (TopCat.of ↥(U ∪ V)) (n + 1))
    (hy : subsetMayerVietorisBoundary hU hV n y = 0) :
    ∃ (a : Homology ℚ (TopCat.of U) (n + 1)) (b : Homology ℚ (TopCat.of V) (n + 1)),
      y = homologyMap ℚ (n + 1) (subsetInclusionHom Set.subset_union_left) a +
        homologyMap ℚ (n + 1) (subsetInclusionHom Set.subset_union_right) b :=
  finbetti_subsetMayerVietoris_exact_aux hU hV n y hy

example {Y : Type} [TopologicalSpace Y] {U V : Set Y} (hU : IsOpen U) (hV : IsOpen V) :
    ∃ (a : Homology ℚ (TopCat.of U) 1) (b : Homology ℚ (TopCat.of V) 1),
      (0 : Homology ℚ (TopCat.of ↥(U ∪ V)) 1) =
        homologyMap ℚ 1 (subsetInclusionHom Set.subset_union_left) a +
          homologyMap ℚ 1 (subsetInclusionHom Set.subset_union_right) b :=
  finbetti_subsetMayerVietoris_exact hU hV 0 0 (map_zero _)

/-- **Mayer–Vietoris in degree `0`.** For any subsets `U`, `V` (open or not), every class in
`H_0(U ∪ V)` is the sum of the images of a class on `U` and a class on `V`: `H_0` is spanned by
classes of points, and each point of `U ∪ V` lies in `U` or in `V`.
Source: Hatcher, *Algebraic Topology*, §2.2, subsection "Mayer–Vietoris Sequences" (the sequence
ends with `H_0(A) ⊕ H_0(B) → H_0(X) → 0`) and Propositions 2.6–2.7
(`H_0` is spanned by classes of points). -/
theorem finbetti_subsetMayerVietoris_surjective_zero {Y : Type} [TopologicalSpace Y]
    (U V : Set Y) (y : Homology ℚ (TopCat.of ↥(U ∪ V)) 0) :
    ∃ (a : Homology ℚ (TopCat.of U) 0) (b : Homology ℚ (TopCat.of V) 0),
      y = homologyMap ℚ 0 (subsetInclusionHom Set.subset_union_left) a +
        homologyMap ℚ 0 (subsetInclusionHom Set.subset_union_right) b :=
  finbetti_subsetMayerVietoris_surjective_zero_aux U V y

example {Y : Type} [TopologicalSpace Y] (U : Set Y) (y : Homology ℚ (TopCat.of ↥(U ∪ U)) 0) :
    ∃ (a b : Homology ℚ (TopCat.of U) 0),
      y = homologyMap ℚ 0 (subsetInclusionHom Set.subset_union_left) a +
        homologyMap ℚ 0 (subsetInclusionHom Set.subset_union_right) b :=
  finbetti_subsetMayerVietoris_surjective_zero U U y

/-- **The Mayer–Vietoris step.** For open `U`, `V`, finite homology of `U`, `V` and `U ∩ V` gives
finite homology of `U ∪ V`.
Source: Hatcher, *Algebraic Topology*, §2.2, subsection "Mayer–Vietoris Sequences" (exactness of
`H_i(U) ⊕ H_i(V) → H_i(U ∪ V) → H_{i-1}(U ∩ V)`); Bott–Tu, *Differential Forms in Algebraic
Topology*, GTM 82, §5 (the same step for de Rham cohomology). -/
theorem finbetti_finiteHomology_union {Y : Type} [TopologicalSpace Y] {U V : Set Y}
    (hU : IsOpen U) (hV : IsOpen V) (hfU : FiniteHomology U) (hfV : FiniteHomology V)
    (hfUV : FiniteHomology ↥(U ∩ V)) :
    FiniteHomology ↥(U ∪ V) :=
  finbetti_finiteHomology_union_aux hU hV hfU hfV hfUV

/-- Two open convex sets: their intersection is convex. -/
example {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] {U V : Set E} (hU : IsOpen U)
    (hV : IsOpen V) (hUc : Convex ℝ U) (hVc : Convex ℝ V) :
    FiniteHomology ↥(U ∪ V) :=
  finbetti_finiteHomology_union hU hV (finbetti_finiteHomology_of_convex hUc)
    (finbetti_finiteHomology_of_convex hVc) (finbetti_finiteHomology_of_convex (hUc.inter hVc))

/-- **Finite unions of open convex sets.** In a real normed space, the union of finitely many open
convex sets has finite rational homology.
Source: Hatcher, *Algebraic Topology*, §2.2 (Mayer–Vietoris), by induction on the number of sets:
`(⋃_{j<m} K j) ∩ K m = ⋃_{j<m} (K j ∩ K m)` is again a union of `m` open convex sets; compare
Hatcher, Lemma 3.27, step (3), and Bott–Tu, GTM 82, §5. -/
theorem finbetti_finiteHomology_iUnion_convex {E : Type} [NormedAddCommGroup E]
    [NormedSpace ℝ E] {m : ℕ} (K : Fin m → Set E) (hopen : ∀ j, IsOpen (K j))
    (hconv : ∀ j, Convex ℝ (K j)) :
    FiniteHomology ↥(⋃ j, K j) :=
  finbetti_finiteHomology_iUnion_convex_aux K hopen hconv

example {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] (c : Fin 3 → E) (r : ℝ) :
    FiniteHomology ↥(⋃ j, Metric.ball (c j) r) :=
  finbetti_finiteHomology_iUnion_convex (fun j => Metric.ball (c j) r)
    (fun _ => Metric.isOpen_ball) (fun j => convex_ball (c j) r)

/-- **The finite-rank Mayer–Vietoris step.** For open `V_k ⊆ W_k ⊆ U_k` (`k = 1, 2`), if the images
of `H(W₁) → H(U₁)`, `H(W₂) → H(U₂)` and `H(V₁ ∩ V₂) → H(W₁ ∩ W₂)` are finite-dimensional in every
degree, so is the image of `H(V₁ ∪ V₂) → H(U₁ ∪ U₂)`.
Source: Hatcher, *Algebraic Topology*, §2.2 (the Mayer–Vietoris sequence and its naturality); the
argument (a class on `V₁ ∪ V₂` has boundary in the finite image of `H(V₁ ∩ V₂)` in
`H(W₁ ∩ W₂)`, and classes with zero boundary come from `W₁` and `W₂`) is written out in
`docs/specs/FiniteBettiCompact.md`, statement 7. -/
theorem finbetti_finiteHomologyImage_union {Y : Type} [TopologicalSpace Y]
    {V₁ V₂ W₁ W₂ U₁ U₂ : Set Y} (hV₁ : IsOpen V₁) (hV₂ : IsOpen V₂) (hW₁ : IsOpen W₁)
    (hW₂ : IsOpen W₂) (hU₁ : IsOpen U₁) (hU₂ : IsOpen U₂) (hVW₁ : V₁ ⊆ W₁) (hVW₂ : V₂ ⊆ W₂)
    (hWU₁ : W₁ ⊆ U₁) (hWU₂ : W₂ ⊆ U₂) (h₁ : FiniteHomologyImage hWU₁)
    (h₂ : FiniteHomologyImage hWU₂) (h₁₂ : FiniteHomologyImage (Set.inter_subset_inter hVW₁ hVW₂)) :
    FiniteHomologyImage
      (Set.union_subset_union (hVW₁.trans hWU₁) (hVW₂.trans hWU₂)) :=
  finbetti_finiteHomologyImage_union_aux hV₁ hV₂ hW₁ hW₂ hU₁ hU₂ hVW₁ hVW₂ hWU₁ hWU₂ h₁ h₂ h₁₂

example {Y : Type} [TopologicalSpace Y] {V₁ V₂ : Set Y} (hV₁ : IsOpen V₁) (hV₂ : IsOpen V₂)
    (h₁ : FiniteHomologyImage (subset_refl V₁)) (h₂ : FiniteHomologyImage (subset_refl V₂))
    (h₁₂ : FiniteHomologyImage (Set.inter_subset_inter (subset_refl V₁) (subset_refl V₂))) :
    FiniteHomologyImage (Set.union_subset_union ((subset_refl V₁).trans (subset_refl V₁))
      ((subset_refl V₂).trans (subset_refl V₂))) :=
  finbetti_finiteHomologyImage_union hV₁ hV₂ hV₁ hV₂ hV₁ hV₂ (subset_refl V₁) (subset_refl V₂)
    (subset_refl V₁) (subset_refl V₂) h₁ h₂ h₁₂

/-- **Finite rank inside one chart.** In a charted space on a real normed space `E`, for open `V`,
`U` with `closure V` compact, `closure V ⊆ U` and `U` inside the source of one chart, the image of
`H(V) → H(U)` is finite-dimensional in every degree: it factors through the homology of the
preimage of a finite union of open balls covering the image of `closure V` inside the image of `U`.
Source: Hatcher, *Algebraic Topology*, §2.1 (functoriality) and Lemma 3.27, step (4) (covering a
compact set in `ℝⁿ` by finitely many balls inside an open set);
`finbetti_finiteHomology_iUnion_convex`. -/
theorem finbetti_finiteHomologyImage_chart {M E : Type} [TopologicalSpace M]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [ChartedSpace E M] {V U : Set M}
    (hV : IsOpen V) (hU : IsOpen U) (hcpt : IsCompact (closure V)) (hVU : closure V ⊆ U) (x : M)
    (hUx : U ⊆ (chartAt E x).source) :
    FiniteHomologyImage (subset_closure.trans hVU) :=
  finbetti_finiteHomologyImage_chart_aux hV hU hcpt hVU x hUx

example {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] {V U : Set E} (hV : IsOpen V)
    (hU : IsOpen U) (hcpt : IsCompact (closure V)) (hVU : closure V ⊆ U) (x : E) :
    FiniteHomologyImage (subset_closure.trans hVU) :=
  finbetti_finiteHomologyImage_chart hV hU hcpt hVU x (fun y _ => mem_chart_source E y)

/-- **Finite rank over finitely many charts.** In a Hausdorff space charted on a finite-dimensional
real normed space `E`, for open `V`, `U` with `closure V` compact, `closure V ⊆ U` and `closure V`
covered by finitely many chart sources, the image of `H(V) → H(U)` is finite-dimensional in every
degree.
Source: Hatcher, *Algebraic Topology*, §2.2 (Mayer–Vietoris) and Lemma 3.27, step (5) (induction on
the number of charts); by induction on `m` with `finbetti_finiteHomologyImage_union` and
`finbetti_finiteHomologyImage_chart` (the overlap lies in the last chart). -/
theorem finbetti_finiteHomologyImage_of_subset_charts {M E : Type} [TopologicalSpace M]
    [T2Space M] [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
    [ChartedSpace E M] {m : ℕ} (x : Fin m → M) {V U : Set M} (hV : IsOpen V) (hU : IsOpen U)
    (hcpt : IsCompact (closure V)) (hVU : closure V ⊆ U)
    (hcover : closure V ⊆ ⋃ j, (chartAt E (x j)).source) :
    FiniteHomologyImage (subset_closure.trans hVU) :=
  finbetti_finiteHomologyImage_of_subset_charts_aux x hV hU hcpt hVU hcover

example {M E : Type} [TopologicalSpace M] [T2Space M] [NormedAddCommGroup E] [NormedSpace ℝ E]
    [FiniteDimensional ℝ E] [ChartedSpace E M] (x : M) {V U : Set M} (hV : IsOpen V)
    (hU : IsOpen U) (hcpt : IsCompact (closure V)) (hVU : closure V ⊆ U)
    (hx : closure V ⊆ (chartAt E x).source) :
    FiniteHomologyImage (subset_closure.trans hVU) :=
  finbetti_finiteHomologyImage_of_subset_charts (fun _ : Fin 1 => x) hV hU hcpt hVU
    (hx.trans (Set.subset_iUnion (fun _ : Fin 1 => (chartAt E x).source) 0))

/-- **Compact manifolds have finite rational homology.** Every compact Hausdorff space charted on a
finite-dimensional real normed space `E` has finite-dimensional `H_i(M; ℚ)` in every degree.
Source: Hatcher, *Algebraic Topology*, Appendix, Corollary A.8 and the remarks after it (a compact
manifold has finitely generated homology); here through
`finbetti_finiteHomologyImage_of_subset_charts` with `V = U = univ`. -/
theorem finbetti_finiteHomology_of_compact {M : Type} (E : Type) [TopologicalSpace M]
    [T2Space M] [CompactSpace M] [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
    [ChartedSpace E M] :
    FiniteHomology M :=
  finbetti_finiteHomology_of_compact_aux E

/-- `X(ℂ)` has finite rational homology. -/
example (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom] :
    FiniteHomology (ComplexPoint X) :=
  finbetti_finiteHomology_of_compact (Fin (dim X.left) → ℂ)

/-- **Universal coefficients, finiteness form.** If `H_n(Y; ℚ)` is finite-dimensional, so is the
singular cohomology `H^n(Y; ℚ)`.
Source: Hatcher, *Algebraic Topology*, Theorem 3.2 and the remark after it
(`H^n(Y; F) ≅ Hom_F(H_n(Y; F), F)` over a field `F`); upstream `cohomologyEquivDualHomology`. -/
theorem finbetti_finite_cohomology_of_finite_homology (Y : Type) [TopologicalSpace Y]
    (n : ℕ) (h : Module.Finite ℚ (Homology ℚ (TopCat.of Y) n)) :
    Module.Finite ℚ (Cohomology ℚ (TopCat.of Y) n) :=
  finbetti_finite_cohomology_of_finite_homology_aux Y n h

example (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom] [IsProjective X.hom] (n : ℕ) :
    Module.Finite ℚ (Cohomology ℚ (TopCat.of (ComplexPoint X)) n) :=
  finbetti_finite_cohomology_of_finite_homology _ n
    (finbetti_finiteHomology_of_compact (Fin (dim X.left) → ℂ) n)

/-- **Finite Betti numbers of `X(ℂ)`.** For every integral smooth projective `X` over `ℂ`,
`FiniteBetti X` holds: each `HQ X n = H^n(X(ℂ); ℚ)` is finite-dimensional.
Source: Hatcher, *Algebraic Topology*, Appendix, Corollary A.8 and Theorem 3.2; Bredon, *Sheaf
Theory*, 2nd ed., GTM 170, Ch. III (sheaf and singular cohomology agree), through
`spec_fieldCohomology_linearEquiv_singular` (`Foundations/ComplexSheafSingular.lean`),
`finbetti_finite_cohomology_of_finite_homology` and `finbetti_finiteHomology_of_compact` with
`E = Fin (dim X.left) → ℂ`. -/
theorem finbetti_finiteBetti (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom]
    [IsProjective X.hom] :
    FiniteBetti X :=
  finbetti_finiteBetti_aux X

/-- For curves, `H¹(X(ℂ); ℚ)` is finite-dimensional (the item the ledger harvest lists as
missing). -/
example (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom]
    [SmoothOfRelativeDimension 1 X.hom] [IsProjective X.hom] :
    Module.Finite ℚ (HQ X 1) :=
  (finbetti_finiteBetti X).finite 1

/-- The cubic `E`, an elliptic curve, where `HodgeLean.Adapters.finiteBetti_abelian` already gives
the same conclusion through the torus calculation. -/
example : FiniteBetti HodgeLean.Foundations.Curves.E :=
  finbetti_finiteBetti HodgeLean.Foundations.Curves.E

/-- **Falsification check: compactness is needed.** An infinite discrete space has
infinite-dimensional `H_0(Y; ℚ)`.
Source: Hatcher, *Algebraic Topology*, Proposition 2.6 and Proposition 2.7 (`H_0` is free on the
path components); Mathlib `TopCat.singularHomology₀Iso`. -/
theorem finbetti_not_finite_homology_zero_of_infinite_discrete (Y : Type)
    [TopologicalSpace Y] [DiscreteTopology Y] [Infinite Y] :
    ¬ Module.Finite ℚ (Homology ℚ (TopCat.of Y) 0) :=
  finbetti_not_finite_homology_zero_of_infinite_discrete_aux Y

/-- `ℕ` is Hausdorff and charted on the finite-dimensional space `Fin 0 → ℝ`, but its homology is
not finite: every hypothesis of `finbetti_finiteHomology_of_compact` except compactness holds. -/
example : Nonempty (ChartedSpace (Fin 0 → ℝ) ℕ) ∧ T2Space ℕ ∧
    FiniteDimensional ℝ (Fin 0 → ℝ) ∧ ¬ FiniteHomology ℕ :=
  ⟨⟨ChartedSpace.ofDiscreteTopology⟩, inferInstance, inferInstance,
    fun h => finbetti_not_finite_homology_zero_of_infinite_discrete ℕ (h 0)⟩

end HodgeLean.RealDefs
